   FUNCTION fu_val_clave_otp(p_cod_sesion IN BW_AUT_SESIONES.COD_SESION%TYPE,
                             p_cod_canal  IN BW_AUT_SESIONES.COD_CANAL%TYPE,
                             p_cla_token  IN VARCHAR2,
                             p_modo       IN VARCHAR2) RETURN TYP_MENSAJERESPUESTA IS
      v_cod_sesion  BW_AUT_SESIONES.COD_SESION%TYPE;
      v_cod_canal   BW_AUT_SESIONES.COD_CANAL%TYPE;
      v_sesion_info typ_validarSesion;
      v_retorno     typ_mensajeRespuesta := typ_mensajeRespuesta;
   BEGIN
      -- valida sesion del cliente
      v_cod_sesion  := depurarAlfanumerico(p_cod_sesion, 32);
      v_cod_canal   := depurarNumerico(p_cod_canal, 3);
      v_sesion_info := fu_validarSesion(v_cod_sesion, v_cod_canal);
      IF v_sesion_info.error = 'S' THEN
         v_retorno.error                := v_sesion_info.error;
         v_retorno.nombreRespuesta      := v_sesion_info.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_sesion_info.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      v_retorno := paw_seg.fu_obt_tok_validar(p_cla_token, v_sesion_info.codigoPersona, v_sesion_info.codigoEmpresa, p_modo);

      RETURN v_retorno;
   END;

   -- lista los informes semestrales existentes para el usuario
   FUNCTION fu_obtInformeSemestral(p_sesion      IN VARCHAR2,
                                   p_codigoCanal IN VARCHAR2) RETURN typ_listaEtiquetaValor IS

      v_retorno        typ_listaEtiquetaValor := typ_listaEtiquetaValor();
      v_detalle        typ_etiquetaValor :=  typ_etiquetaValor();
      retValidarSesion typ_validarSesion;
      --retError         typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_mensajeCaja    typ_mensajeCaja;
      --v_permiso        typ_obtenerPermisos;
      v_mensaje        typ_mensajerespuesta := typ_mensajeRespuesta;
      v_cod_operacion  VARCHAR2(3) := '089';
      v_anio            VARCHAR2(4);
      v_periodo        VARCHAR2(40);

      CURSOR c_extractos IS
        SELECT m.cod_persona, m.periodo, m.nom_archivo, m.titulo
          FROM bw_arc_semestral m
         WHERE m.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);

   BEGIN
      --valido la sesión del cliente
      retValidarSesion := fu_validarSesion(depurarAlfanumerico(p_sesion, 32), p_codigoCanal);
      IF retValidarSesion.error = 'S' THEN
         v_mensaje.error                := retValidarSesion.error;
         v_mensaje.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_mensaje.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- validamos la caja
      v_mensajeCaja := lf_val_caja(retValidarSesion);
      IF v_mensajeCaja.error = 'S' THEN
         v_mensaje.error                := v_mensajeCaja.error;
         v_mensaje.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_mensaje.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_mensaje.nombreRespuesta, v_mensaje.descripcionRespuesta, v_mensaje.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fu_obtInformeSemestral - ' || fu_generarBitacora(v_mensaje.error, v_mensaje.nombreRespuesta, v_mensaje.descripcionRespuesta, NULL), BITACORA_ENTRADA);

      FOR reg IN c_extractos LOOP

         v_anio := substr(reg.titulo, -8, 4);
         IF substr(reg.titulo, 1, 3) = 'Ene' THEN
            v_periodo := 'Enero a Junio';
         ELSE
            v_periodo := 'Julio a Diciembre';
         END IF;

         v_detalle.etiqueta := 'periodo';
         v_detalle.valor    := v_anio || ' - ' || v_periodo;

         v_retorno.extend;
         v_retorno(v_retorno.count) := v_detalle;

         v_detalle.etiqueta := 'nom_archivo';
         v_detalle.valor    := reg.titulo;

         v_retorno.extend;
         v_retorno(v_retorno.count) := v_detalle;

      END LOOP;

      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fu_obtInformeSemestral -  ' || fu_generarBitacora(v_mensaje.error, v_mensaje.nombreRespuesta, v_mensaje.descripcionRespuesta, NULL), BITACORA_SALIDA);

      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_mensaje.nombreRespuesta, v_mensaje.descripcionRespuesta, v_mensaje.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_mensaje.error, v_mensaje.nombreRespuesta, v_mensaje.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
   END;

FUNCTION fu_acreditacionGourmet(p_sesion                 IN VARCHAR2,
                                p_codigoCanal            IN VARCHAR2,
                                p_codigoEnte             IN NUMBER,
                                p_modoControl            IN VARCHAR2,
                                p_nroCuentaDebito        IN VARCHAR2,
                                p_canTarjetasParaCredito IN NUMBER,
                                p_canRegistrosLeidos     IN NUMBER,
                                p_montoTotal             IN ge_movimientos.monto%TYPE,
                                p_parametros             IN CLOB,
                                p_claveTransaccional     IN VARCHAR2,
                                p_claveToken             IN VARCHAR2) RETURN typ_acrGourmet IS
   v_fec_actual      DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy;
   v_session         VARCHAR2(32) := depurarAlfanumerico(p_sesion, 32);
   v_usu_sesion      typ_validarsesion;
   v_retorno       typ_acrGourmet := typ_acrGourmet();
   v_detalle       TYP_DETALLEACRGOURMET := TYP_DETALLEACRGOURMET(); -- datos de las cuentas
   v_lis_detalle   TYP_LISTAACRGOURMET := TYP_LISTAACRGOURMET();
   v_msj_respuesta   typ_MensajeRespuesta := typ_MensajeRespuesta;
   v_mensajeCaja     typ_mensajeCaja;
   v_permiso         typ_obtenerPermisos;

   v_lugar           VARCHAR2(100) := 'Declarar variables';

   v_cod_mon_debito    ba_monedas.cod_moneda%TYPE;
   v_cod_mod_debito    NUMBER;
   v_cod_mad_debito    NUMBER;
   v_cod_modulo        NUMBER;
   v_cod_modalidad     NUMBER;
   v_cod_ofi_debito    NUMBER;
   v_cta_for_debito    ge_cuentas.nro_cuenta%TYPE;
   v_cod_tra_padre     NUMBER := NVL(FUG_OBT_PARDINAMICO('GOU_CTA_PADRE'),5166);
   v_cod_tra_hijo      NUMBER := 503;
   v_cod_operacion     VARCHAR2(3) := '071';

   v_pos_nva         VARCHAR2(100); --variables auxiliares para recorrer p_parametros
   v_registro        VARCHAR2(100); --variables auxiliares para recorrer p_parametros
   v_pos_ant         VARCHAR2(100); --variables auxiliares para recorrer p_parametros
   v_pos_nvo_proc    VARCHAR2(100); --variables auxiliares para recorrer p_parametros
   v_pos_ant_proc    VARCHAR2(100); --variables auxiliares para recorrer p_parametros
   v_par_auxiliar    VARCHAR2(100); --variables auxiliares para recorrer p_parametros
   v_res_ver_tarjeta typ_mensajeRespuesta;
   v_resLimite        typ_respuestaLimite;
   --campos de la tabla
   v_nro_tarjeta     ta_acr_gourmet_tmp.nro_tarjeta%TYPE;
   v_monto           ta_acr_gourmet_tmp.monto%TYPE;
   v_nro_documento   ta_acr_gourmet_tmp.nro_documento%TYPE;
   v_msj_error              ta_acr_gourmet_tmp.msj_error%TYPE;
   v_nro_archivo            ta_acr_gourmet_tmp.nro_archivo%TYPE;
   v_sec_nro_documento      NUMBER(20);

   v_modo            VARCHAR2(1) := substr(p_modoControl, 1, 1);
   v_cod_ente        NUMBER(5) := p_codigoEnte;
   v_montoTotal      NUMBER:=nvl(p_montoTotal,0);
   v_montoVerificacion      ge_movimientos.monto%TYPE := 0;
   v_canTarjetasParaCredito NUMBER:=nvl(p_canTarjetasParaCredito,0);
   v_canRegistrosLeidos NUMBER:=nvl(p_canRegistrosLeidos,0);
   v_des_ente        ge_entes.descripcion%TYPE;
   v_dem_cta_debito         ge_cuentas.denominacion%TYPE;
   v_nro_cta_debito  ge_cuentas.nro_cuenta%TYPE; -- cuenta de debito
   v_valCuentaDebito typ_mensajeRespuesta;
   v_msj_bitacora           VARCHAR2(500) := substr('ente:' || v_cod_ente || ', modo:' || v_modo || ', mtoTot:' || p_montoTotal || ', canTarCre:' ||p_canTarjetasParaCredito || ', canReg:' || p_canRegistrosLeidos || ', fecAct:' || v_fec_actual, 1, 500);

   SAL_PER_SIN_AUT         CONSTANT VARCHAR2(15) := 'SAL_PER_SIN_AUT'; -- perfil sin autorizacion para pagos
   SAL_DAT_ENT_DUPLICADA   CONSTANT VARCHAR2(15) := 'SAL_DAT_ENT_DUP'; -- datos de ente duplicada
   SAL_ERR_OBT_DAT_ENTES   CONSTANT VARCHAR2(15) := 'SAL_ERR_DAT_ENT'; -- error al obtener datos de ente
   SAL_ERR_DATOS           CONSTANT VARCHAR2(15) := 'SAL_ERR_DATOS'; -- datos incorrectos en la carga
   OPE_NO_PERMITIDA        CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
   MSG_COD_CTA_INEXISTENTE CONSTANT VARCHAR2(15) := 'COD_CTA_INEXIST';

   GOU_ACR_NOENCON         CONSTANT VARCHAR2(15) := 'GOU_ACR_NOENCON';
   GOU_ACR_ERRTAR          CONSTANT VARCHAR2(15) := 'GOU_ACR_ERRTAR';
   GOU_ACR_NOGOUR          CONSTANT VARCHAR2(15) := 'GOU_ACR_NOGOUR';
   GOU_ACR_NOACRED         CONSTANT VARCHAR2(15) := 'GOU_ACR_NOACRED';
   GOU_ACR_DOCNOEN         CONSTANT VARCHAR2(15) := 'GOU_ACR_DOCNOEN';
   GOU_ACR_DOCERR          CONSTANT VARCHAR2(15) := 'GOU_ACR_DOCERR';
   GOU_ACR_DOCTAR          CONSTANT VARCHAR2(15) := 'GOU_ACR_DOCTAR';
   GOU_ACR_MONTOD          CONSTANT VARCHAR2(15) := 'GOU_ACR_MONTOD';
   G_CLA_OTP_INEX_PJ       CONSTANT VARCHAR(15)  := 'G_COD_TOK_IN_PJ';
   MSG_CLA_OTP_INEXISTENTE CONSTANT VARCHAR2(15) := 'G_COD_TOK_INEXI';
   GOU_ARC_MON_ERR         CONSTANT VARCHAR2(15) := 'GOU_ARC_MON_ERR';

   /*Valida que la cuenta del ente se encuentre habilitada para el servicio*/
   FUNCTION lf_val_cta_ente(p_cod_ente       IN ge_entes.cod_ente%TYPE,
                            p_nro_cta_debito IN ge_cuentas.nro_cuenta%TYPE,
                            p_sesion         IN typ_validarsesion,
                            p_mensajeCaja    IN typ_mensajeCaja,
                            p_dem_cta_debito OUT ge_cuentas.denominacion%TYPE) RETURN typ_mensajeRespuesta IS
      v_retorno typ_mensajeRespuesta := typ_MensajeRespuesta;
   BEGIN
      BEGIN
         SELECT a.cod_ente, a.descripcion
           INTO v_cod_ente, v_des_ente
           FROM ge_entes a
          WHERE a.cod_persona = nvl(p_sesion.codigoEmpresa, p_sesion.codigoPersona)
            AND a.tipo = 'AG'
               AND a.cod_ente = p_cod_ente
               AND EXISTS(SELECT 1 FROM ge_par_entes pe
                       WHERE pe.cod_ente = p_cod_ente
                       AND pe.parametro like 'NRO_CTA_DEB_PAG_GOURMET%'
                       AND pe.val_parametro = p_nro_cta_debito)
            AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO_GOU') = 'S'
            AND fug_obt_parentes(a.cod_ente, 'HAB_HOMEBANKING_GOU') = 'S';
      EXCEPTION
         WHEN too_many_rows THEN
            v_retorno.error           := 'S';
            v_retorno.nombreRespuesta := SAL_DAT_ENT_DUPLICADA;
            RETURN v_retorno;
         WHEN OTHERS THEN
            v_retorno.error                := 'S';
            v_retorno.nombreRespuesta      := SAL_ERR_OBT_DAT_ENTES;
            v_retorno.descripcionRespuesta := 'ORA-ERR: [' || substr(SQLERRM, 1, 140) || ']';
            RETURN v_retorno;
      END;
      BEGIN
         SELECT cod_modalidad, cod_modulo
           INTO v_cod_modalidad, v_cod_modulo
           FROM ge_cuentas a
          WHERE a.nro_cuenta = p_nro_cta_debito;
      EXCEPTION
         WHEN NO_DATA_FOUND THEN
            v_retorno.error           := 'S';
            v_retorno.nombreRespuesta := MSG_COD_CTA_INEXISTENTE;
            RETURN v_retorno;
      END;

      v_retorno := lf_val_cta_debito(p_nro_cta_debito, v_cod_tra_padre, v_montoTotal, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito,
                                     v_cod_ofi_debito, v_cta_for_debito, p_dem_cta_debito, p_sesion, p_mensajeCaja, v_cod_modulo, v_cod_modalidad);
      IF (v_retorno.error = 'S') THEN
         RETURN v_retorno;
      END IF;
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);



     return v_retorno;
   END;

   /*Obtiene el siguiente numero de archivo correspondiente*/
   FUNCTION lf_obt_nro_sec_archivo(p_cod_ente IN ge_entes.cod_ente%TYPE) RETURN NUMBER IS
      v_nro_archivo_tmp ta_acr_gourmet_tmp.nro_archivo%TYPE := 1;
      v_nro_archivo     ta_acr_gourmet.nro_archivo%TYPE := 0;
   BEGIN
      BEGIN
         SELECT MAX(nro_archivo + 1)
           INTO v_nro_archivo_tmp
           FROM ta_acr_gourmet_tmp
          WHERE cod_ente = p_cod_ente
            AND trunc(fec_insercion) = trunc(sysdate);
      EXCEPTION
         WHEN OTHERS THEN
            v_nro_archivo_tmp := 1;
      END;
      BEGIN
         SELECT MAX(nro_archivo + 1)
           INTO v_nro_archivo
           FROM ta_acr_gourmet
          WHERE cod_ente = p_cod_ente
            AND trunc(fec_insercion) = trunc(sysdate);
      EXCEPTION
         WHEN OTHERS THEN
            v_nro_archivo := 1;
      END;
      IF v_nro_archivo > v_nro_archivo_tmp THEN
         RETURN nvl(v_nro_archivo + 1, 1);
      END IF;
      RETURN nvl(v_nro_archivo_tmp, 1);
   END;

   /*Verifica que la tarjeta le pertenezca a la persona*/
   FUNCTION lf_val_tar_gourmet(p_nro_documento   IN ba_personas.nro_documento%TYPE,
                               p_nro_tarjeta     IN ta_tarjetas.nro_tarjeta%TYPE,
                               p_nom_titular     OUT ba_personas.nom_completo%TYPE,
                               p_des_modalidad   OUT VARCHAR2) RETURN typ_MensajeRespuesta IS
     v_retorno           typ_mensajeRespuesta := typ_MensajeRespuesta;
      v_cod_persona       ta_tarjetas.cod_persona%TYPE;
     v_cod_estado        ta_tarjetas.cod_estado%TYPE;
     v_vigente           ta_tarjetas.vigente%TYPE;
     v_es_gourmet        VARCHAR2(1);
     v_cod_per_documento ba_personas.cod_persona%TYPE;
     v_cod_tip_documento ba_personas.cod_tip_documento%TYPE; --DDSI-473
  BEGIN
     BEGIN
         SELECT ta_tarjetas.cod_persona, ta_tarjetas.cod_estado, ta_tarjetas.vigente, paw_not.lf_es_gourmet(TA_CTA_TARJETAS.COD_MODALIDAD),
                BA_PERSONAS.NOM_COMPLETO, fug_obt_des_modal(TA_CTA_TARJETAS.cod_modulo, TA_CTA_TARJETAS.cod_modalidad), BA_PERSONAS.Cod_Tip_Documento
           INTO v_cod_persona, v_cod_estado, v_vigente, v_es_gourmet, p_nom_titular, p_des_modalidad, v_cod_tip_documento
          FROM ta_tarjetas
         INNER JOIN TA_CTA_TARJETAS
            ON ta_tarjetas.NRO_CUENTA = TA_CTA_TARJETAS.NRO_CUENTA
          INNER JOIN BA_PERSONAS
             ON ta_tarjetas.COD_PERSONA = BA_PERSONAS.COD_PERSONA
         WHERE ta_tarjetas.nro_tarjeta = p_nro_tarjeta;
     EXCEPTION
        WHEN NO_DATA_FOUND THEN
           pr_mensajeUsuario(GOU_ACR_NOENCON, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           RETURN v_retorno;
        WHEN OTHERS THEN
           pr_mensajeUsuario(GOU_ACR_ERRTAR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           RETURN v_retorno;
     END;

     IF v_es_gourmet = 'N' THEN
           --La tarjeta no es de tipo gourmet
        pr_mensajeUsuario(GOU_ACR_NOGOUR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        RETURN v_retorno;
     END IF;

     IF v_cod_estado in (10,15,19,21,22,23,24) THEN
           --El estado de la tarjeta no es acreditable
        pr_mensajeUsuario(GOU_ACR_NOACRED, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        RETURN v_retorno;
     END IF;

     BEGIN
           --Busca el codigo de la persona asociada al documento y al tipo de documento
        SELECT cod_persona
          INTO v_cod_per_documento
          FROM ba_personas
         WHERE nro_documento = p_nro_documento
           AND cod_tip_documento = v_cod_tip_documento; --DDSI-473
     EXCEPTION
        WHEN NO_DATA_FOUND THEN
           pr_mensajeUsuario(GOU_ACR_DOCNOEN, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           RETURN v_retorno;
        WHEN OTHERS THEN
           pr_mensajeUsuario(GOU_ACR_DOCERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           RETURN v_retorno;
     END;
     IF v_cod_persona <> v_cod_per_documento THEN
           --El documento y la tarjeta no estan relacionados a la misma persona
        pr_mensajeUsuario(GOU_ACR_DOCTAR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        RETURN v_retorno;
     END IF;
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

     RETURN v_retorno;
  END;

BEGIN



       -- 1. Validacion de la sesion
   v_lugar      := 'Validacion de la session';
   v_usu_sesion := fu_validarSesion(v_session, p_codigoCanal);
   IF v_usu_sesion.error = 'S' THEN
      v_retorno.error                := v_usu_sesion.error;
      v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
      RETURN v_retorno;
   END IF;
       pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||
                        fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ENTRADA);
       -- 2. Validacion del canal de origen
   v_lugar       := 'Validacion de la caja';
   v_mensajeCaja := lf_val_caja(v_usu_sesion);
   IF v_mensajeCaja.error = 'S' THEN
      v_retorno.error                := v_mensajeCaja.error;
      v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar||'-'||v_msj_bitacora  || ' ' ||
                               fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
       END IF;
       --Validando cuenta debito
       v_lugar      := 'Validar cta debito';
       v_nro_cta_debito := depurarAlfanumerico(p_nroCuentaDebito, 32);
       if v_montoTotal < 1 or v_canTarjetasParaCredito < 1 or v_canRegistrosLeidos < 1 then
           pr_mensajeUsuario(SAL_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || '-' || v_msj_bitacora || ' ' ||
                           fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
      RETURN v_retorno;
   END IF;

       v_lugar := 'Validar modo';
       IF v_modo NOT IN ('V', 'C', 'A') THEN
           pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || '-' || v_msj_bitacora || ' ' ||
                               fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
       END IF;
       --3. Validacion de permisos
   v_lugar := 'Control de permisos';
   v_permiso      := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
   v_msj_bitacora := v_msj_bitacora || ', perf: ' || v_usu_sesion.codigoPerfil;
       IF v_permiso.error = 'S' THEN
      v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
      v_retorno.error                := v_permiso.error;
           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa,v_lugar||'-'|| v_msj_bitacora || ' ' ||
                           fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
      RETURN v_retorno;
   END IF;
       IF v_modo = 'V' and v_permiso.registra = FALSE THEN
      pr_mensajeUsuario(SAL_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || '-' || v_msj_bitacora || ' ' ||
                           fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
      RETURN v_retorno;
   END IF;
   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       -- 4. Validacion de la cuenta debito

       v_lugar := 'Validar cuenta debito';
       IF v_modo = 'A' THEN
          select can_aut_requeridas into v_can_aut_requeridas
          from bw_mov_pendientes where nro_documento = p_canTarjetasParaCredito;
          v_valCuentaDebito := lf_val_cta_ente(v_cod_ente, v_nro_cta_debito, v_usu_sesion, v_mensajeCaja, v_dem_cta_debito);
          IF (v_valCuentaDebito.error = 'S') THEN
             pr_mensajeUsuario(v_valCuentaDebito.nombreRespuesta, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar||'-'||v_msj_bitacora || ' ' || ' ' || v_valCuentaDebito.descripcionRespuesta || ' ' ||
                           fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
          END IF;
          RETURN v_retorno;
       END IF;
      v_valCuentaDebito := lf_val_cta_ente(v_cod_ente, v_nro_cta_debito, v_usu_sesion, v_mensajeCaja, v_dem_cta_debito);
      IF (v_valCuentaDebito.error = 'S') THEN
         pr_mensajeUsuario(v_valCuentaDebito.nombreRespuesta, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar||'-'||v_msj_bitacora || ' ' || ' ' || v_valCuentaDebito.descripcionRespuesta || ' ' ||
                              fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

         v_resLimite := fu_obtenerLimite(v_usu_sesion, v_cod_operacion, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), v_nro_cta_debito,
                                        v_cod_mon_local, v_cod_tra_padre, v_cod_tra_hijo, v_montoTotal , 'A', v_cod_ente);
         IF v_resLimite.error = 'S' THEN
             -- mostrar mensaje diferente para persona jurídica
             IF  v_resLimite.nombreRespuesta = MSG_CLA_OTP_INEXISTENTE THEN
                 pr_mensajeUsuario(G_CLA_OTP_INEX_PJ, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
             END IF;

            v_retorno.error                := 'S';
            v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
            v_retorno.nombreRespuesta      := v_resLimite.nombreRespuesta;
           RETURN v_retorno;
         END IF;
         v_retorno.respuestaLimite := v_resLimite.codRespuesta;
         v_msj_bitacora := v_msj_bitacora||', resLimite:'||v_resLimite.codRespuesta;

       --Modo C: Acciones previas
          IF v_modo IN ('C') THEN
             IF v_resLimite.codRespuesta IN ('10', '11') THEN
                  -- clave transaccional requerida
                v_msj_respuesta := lf_obt_cla_validar(p_claveTransaccional, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, 'T');
             END IF;

             IF v_msj_respuesta.error = 'N' THEN
                IF v_resLimite.codRespuesta IN ('01', '11') THEN
                     -- token requerido
                  v_msj_respuesta := paw_seg.fu_obt_tok_validar(p_claveToken, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, v_modo);
             END IF;
          END IF;

          IF v_msj_respuesta.error = 'S' THEN
             v_retorno.error := 'S';
             v_retorno.nombreRespuesta := v_msj_respuesta.nombreRespuesta;
             v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
               pr_mensajeUsuario(v_valCuentaDebito.nombreRespuesta, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar||'-'||v_msj_bitacora || ' ' || ' ' || v_valCuentaDebito.descripcionRespuesta || ' ' ||
                             fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         return v_retorno;
      END IF;
           -- Se obtiene el siguiente numero de archivo
           v_nro_archivo := lf_obt_nro_sec_archivo(v_cod_ente);
       END IF;
       --Proceso de registros
       v_lugar := 'Lectura de registros';
         v_pos_ant := 1;
       FOR i IN 1 .. p_canRegistrosLeidos LOOP
         v_detalle := typ_detalleacrgourmet();

               v_pos_nva  := instr(p_parametros, '~', v_pos_ant);
               v_registro := substr(p_parametros, v_pos_ant, v_pos_nva - v_pos_ant);
               v_pos_ant  := v_pos_nva + 1;

               v_pos_ant_proc:=1;
               v_pos_nvo_proc:= instr(v_registro, '$', v_pos_ant_proc);
               v_par_auxiliar := substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc);
               v_nro_tarjeta      := depurarTextos(v_par_auxiliar,17);

               v_pos_ant_proc     := v_pos_nvo_proc+1;
               v_pos_nvo_proc     := instr(v_registro, '$', v_pos_ant_proc);
               v_par_auxiliar     := substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc);
               v_monto            :=  v_par_auxiliar;

               v_pos_ant_proc     := v_pos_nvo_proc+1;
               v_pos_nvo_proc     := length(v_registro);
               v_par_auxiliar     := substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc+1);
               v_nro_documento    := TRIM(depurarTextos(v_par_auxiliar,15));

         v_montoVerificacion := v_montoVerificacion + v_monto;
           v_detalle.codigoMoneda := v_cod_mon_local;
           v_detalle.numeroCuenta     := v_nro_tarjeta;
           v_detalle.monto            := v_monto;
           v_detalle.numeroDocumento  := v_nro_documento;
           v_detalle.mensajeRespuesta := v_msj_error;
           v_detalle.fecha            := v_fec_actual;
           --Verificacion de pertenencia de la tarjeta al documento
         v_res_ver_tarjeta := lf_val_tar_gourmet(v_nro_documento, v_nro_tarjeta, v_detalle.nombreCuenta, v_detalle.descripcionTipoCuenta);
         v_detalle.error   := v_res_ver_tarjeta.error;
           v_detalle.mensajeRespuesta := v_res_ver_tarjeta.nombreRespuesta;
           IF v_res_ver_tarjeta.error = 'S' THEN
            v_msj_error := v_res_ver_tarjeta.nombreRespuesta;
             end if;

         IF v_monto <= 0 THEN
           pr_mensajeUsuario(GOU_ARC_MON_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || '-' || v_msj_bitacora || ' ' ||
                           fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
         END IF;

         IF v_modo = 'C' THEN
               --Se inserta en la tabla temporal
            BEGIN
               INSERT INTO ta_acr_gourmet_tmp
                  (cod_ente, nro_cta_debito, nro_archivo, nro_tarjeta, nro_documento, monto, msj_error, fec_recepcion, estado)
               VALUES
                  (v_cod_ente, v_nro_cta_debito, v_nro_archivo, v_nro_tarjeta, v_nro_documento, v_monto, v_msj_error, v_fec_actual, 'P');
            EXCEPTION
               WHEN OTHERS THEN
                  v_detalle.error := 'S';
                  v_retorno.error := 'S';
                       pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || '-' || v_msj_bitacora || ' arc:' || v_nro_archivo|| ' tar:'|| v_nro_tarjeta|| ' doc:'||v_nro_documento||
                                       fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
            END;
         END IF;
         v_lis_detalle.extend;
         v_lis_detalle(v_lis_detalle.count) := v_detalle;

         v_msj_error := NULL;
         END LOOP;
       v_retorno.cantidadCuentas := v_lis_detalle.count;
       v_retorno.listaCuentas    := v_lis_detalle;
       v_retorno.cantidadAutorizadores:= v_can_aut_requeridas;
       --Verificacion de montos totales
      v_lugar:='Verificar Montos';
      if v_montoVerificacion <> v_montoTotal then
       v_lugar:=v_lugar||'Verificacion:'||v_montoVerificacion;
       pr_mensajeUsuario(GOU_ACR_MONTOD, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || '-' || v_msj_bitacora || ' ' ||
                           fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
      RETURN v_retorno;

      end if;

       --Modo C: Acciones posteriores
       IF v_modo = 'C' THEN

            BEGIN
               v_lugar := 'Insertar movimiento pendiente';
               SELECT s_nro_documento.NEXTVAL
                 INTO v_sec_nro_documento
                 FROM dual;
               INSERT INTO bw_mov_pendientes (
                   nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cotizacion, mto_equ_local,
                   nro_cta_contra, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra, cot_contra, etiqueta, dato, etiqueta2, dato2, cantidad)
               VALUES (
                   v_sec_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito,
             v_cod_mon_debito, 'Pagos gourmet card', v_montoVerificacion, 1, v_montoVerificacion, null, 'P', v_can_aut_requeridas,
                   v_can_aut_requeridas, v_usu_sesion.codigoPersona, v_montoVerificacion, 0, 'Nro Archivo', v_nro_archivo, 'Ente', v_cod_ente,
                   v_retorno.cantidadCuentas);
       v_retorno.numeroDocumento:=v_sec_nro_documento;
            EXCEPTION
               WHEN OTHERS THEN
                   pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || '-'||'['||sqlerrm||']' || v_msj_bitacora || ' ' ||
                                       fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                   RETURN v_retorno;
            END;
     end if;

       pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||
                           fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
       RETURN v_retorno;
         exception
           when others then
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || '-'||'['||sqlerrm||']' || v_msj_bitacora || ' ' ||
                                 fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);

             end;




FUNCTION fu_acreditacionGourmetHis(p_sesion IN VARCHAR2,
                                   p_codigoCanal IN VARCHAR2,
                                   p_nro_tarjeta IN VARCHAR2,
                                   p_fechaInicial IN DATE,
                                   p_fechaFinal IN DATE,
                                   p_nroDocumento IN VARCHAR2,
                                   p_nombre IN VARCHAR2,
                                   p_nroOperacion IN VARCHAR2,
                                   p_parametro IN VARCHAR2) RETURN typ_acrGourmet IS
   v_lugar           VARCHAR2(100) := 'Declarar variables';
   v_session         VARCHAR2(32) := depurarAlfanumerico(p_sesion, 32);
   v_usu_sesion      typ_validarsesion;
   v_retorno         typ_acrGourmet := typ_acrGourmet();
   v_detalle       TYP_DETALLEACRGOURMET := TYP_DETALLEACRGOURMET();
   v_lis_detalle     TYP_LISTAACRGOURMET := TYP_LISTAACRGOURMET();
   v_permiso         typ_obtenerPermisos;
   v_nro_tarjeta     ta_tarjetas.nro_tarjeta%TYPE := NULL;
   v_cod_operacion   VARCHAR2(3) := '071';

   v_msj_bitacora  VARCHAR2(500) := substr('nro_doc' ||p_nroDocumento ||'p_nombre:'|| p_nombre|| ', p_nro_tarjeta:' || p_nro_tarjeta || ', p_fechaInicial:' || p_fechaInicial || ', p_fechaFinal:' || p_fechaFinal, 1, 500);


   CURSOR c_acreditaciones_his(p_cod_per_empresa IN VARCHAR2, pc_nro_tarjeta IN VARCHAR2,pc_fechaInicial IN DATE,
                                   pc_fechaFinal IN DATE,pc_nroDocumento IN VARCHAR2, pc_nombre IN VARCHAR2, pc_nroOperacion IN VARCHAR2) IS
      SELECT p.nom_completo, t.nro_tarjeta, g.monto, g.nro_documento, m.fec_hora as fec_recepcion , m.nro_documento as nro_operacion
        FROM bw_mov_pendientes m, ta_acr_gourmet g, ta_tarjetas t, ba_personas p
       WHERE m.cod_tip_mensaje = '071'
         AND m.estado = 'C'
         AND m.cod_per_principal = p_cod_per_empresa
         AND m.dato2 = g.cod_ente
         AND m.dato = g.nro_archivo
         AND g.nro_tarjeta LIKE '%' || nvl(pc_nro_tarjeta, g.nro_tarjeta) || '%'
         AND upper(p.nom_completo) LIKE '%' || nvl(upper(pc_nombre), upper(p.nom_completo)) || '%'
         AND p.nro_documento LIKE '%' || nvl(pc_nroDocumento, p.nro_documento) || '%'
         AND m.nro_documento LIKE '%' || nvl(pc_nroOperacion, m.nro_documento) || '%'
         and trunc(m.fec_hora)>=nvl(pc_fechaInicial,sysdate-90)
         and trunc(m.fec_hora)<=nvl(pc_fechaFinal,sysdate)
         AND t.nro_tarjeta = g.nro_tarjeta
         AND p.cod_persona = t.cod_persona
         AND trunc(m.fec_insercion) = trunc(g.fec_insercion)
         and m.fec_insercion>sysdate-90
         order by m.fec_hora desc;
   CURSOR c_acreditaciones_beneficiarios(p_cod_per_empresa IN VARCHAR2) IS
      select distinct p.nom_completo, g.nro_tarjeta, g.nro_documento
      from ta_acr_gourmet g, ta_tarjetas t, ba_personas p, bw_mov_pendientes m
      where g.nro_tarjeta = t.nro_tarjeta
      and m.cod_per_principal = p_cod_per_empresa
       AND m.dato2 = to_char(g.cod_ente)
      and t.cod_persona = p.cod_persona
      and trunc(g.fec_insercion) >= trunc(sysdate - 90);
BEGIN

   -- 1. valido la clave del cliente
   v_lugar      := 'Validacion de la session';
   v_usu_sesion := fu_validarSesion(v_session, p_codigoCanal);
   IF v_usu_sesion.error = 'S' THEN
      v_retorno.error                := v_usu_sesion.error;
      v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
      RETURN v_retorno;
   END IF;
       pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || '-' || v_msj_bitacora || ' ' ||
                        fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ENTRADA);

   -- 3. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
   v_lugar := 'Control de permisos';
   v_permiso      := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
   v_msj_bitacora := v_msj_bitacora || ', perf: ' || v_usu_sesion.codigoPerfil;
   IF (v_permiso.error = 'S') THEN
      v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
      v_retorno.error                := v_permiso.error;
           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, v_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || '-' || v_msj_bitacora || ' ' ||
                           fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
      RETURN v_retorno;
   END IF;
   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

   IF p_parametro = 'B' THEN
      FOR v_acreditacion IN c_acreditaciones_beneficiarios(v_usu_sesion.codigoEmpresa)
      LOOP
          v_detalle.nombreCuenta     := v_acreditacion.nom_completo;
          v_detalle.numeroCuenta     := v_acreditacion.nro_tarjeta;
          v_detalle.numeroDocumento  := v_acreditacion.nro_documento;
          v_detalle.mensajeRespuesta := NULL;
          v_lis_detalle.extend;
          v_lis_detalle(v_lis_detalle.count) := v_detalle;
      END LOOP;
      v_retorno.cantidadCuentas := v_lis_detalle.count;
      v_retorno.listaCuentas    := v_lis_detalle;
      RETURN v_retorno;
   ELSE
   IF (p_nro_tarjeta IS NOT NULL) THEN
      v_nro_tarjeta := depurarNumerico(p_nro_tarjeta, 20);
   END IF;
   FOR v_acreditacion IN c_acreditaciones_his(v_usu_sesion.codigoEmpresa, v_nro_tarjeta, p_fechaInicial, p_fechaFinal ,p_nroDocumento , p_nombre, p_nroOperacion)
   LOOP
      v_detalle.numeroCuenta     := v_acreditacion.nro_tarjeta;
      v_detalle.monto            := v_acreditacion.monto;
      v_detalle.numeroDocumento  := v_acreditacion.nro_documento;
      v_detalle.nombreCuenta     := v_acreditacion.nom_completo;
      v_detalle.mensajeRespuesta := NULL;
      v_detalle.fecha            := v_acreditacion.fec_recepcion;
      v_detalle.descripcionTipoCuenta := v_acreditacion.nro_operacion;
      v_lis_detalle.extend;
      v_lis_detalle(v_lis_detalle.count) := v_detalle;

   END LOOP;
   v_retorno.cantidadCuentas := v_lis_detalle.count;
   v_retorno.listaCuentas    := v_lis_detalle;
   v_retorno.cantidadAutorizadores := v_can_aut_requeridas;
   RETURN v_retorno;
   END IF;
END;

-- Retorna el listado de pizarra para el simulador de prestamos con iconos
   FUNCTION fu_simuladorPrestamo(
                                 p_codigoCanal IN VARCHAR2,
                                 p_moneda      IN VARCHAR2,
                                 p_apikey     IN VARCHAR2) RETURN TYP_SIMULADOR IS

      v_listapizarra        TYP_LISTAPIZARRA := TYP_LISTAPIZARRA();
      v_listaplazos         TYP_LISTAPIZARRAPLAZOS := TYP_LISTAPIZARRAPLAZOS();
      v_listaiconos         TYP_LISTAPIZARRAICONOS := TYP_LISTAPIZARRAICONOS();
      v_retorno             typ_simulador := typ_simulador();
      v_pizarra        typ_pizarra := typ_pizarra();
      v_plazo          typ_pizarraplazos := typ_pizarraplazos();
      v_icono          typ_pizarraiconos := typ_pizarraiconos();
      --retValidarSesion typ_validarSesion;
      --v_mensajeCaja    typ_mensajeCaja;
      v_codOperacion  VARCHAR2(3) := '031';--Prestamos
      v_contador number(4) := 0;
      v_apiTirica  ge_par_dinamicos.val_parametro%TYPE := trim(fug_obt_pardinamico('TIRICA_API_KEY'));

    CURSOR c_pizarra IS
      select p.val_parametro, p.cod_modulo, p.cod_modalidad, p.cod_sub_modalidad,
             sub.descripcion, mon.cod_moneda,
             mon.mto_desde, mon.mto_hasta
      from ge_par_dinamicos p
      inner join ge_sub_modalidades sub on sub.cod_modulo = p.cod_modulo and sub.cod_modalidad = p.cod_modalidad and sub.cod_sub_modalidad = p.cod_sub_modalidad
      inner join cr_piz_montos mon on mon.cod_modulo = p.cod_modulo and mon.cod_modalidad = p.cod_modalidad and mon.cod_sub_modalidad = p.cod_sub_modalidad
      where p.parametro = 'SIM_PRESTAMOS';

   CURSOR c_plazos IS
    select p.val_parametro, p.cod_modulo, p.cod_modalidad, p.cod_sub_modalidad, pl.cod_moneda,
       pl.plz_desde, pl.plz_hasta, pl.tas_interes
    from ge_par_dinamicos p
    inner join ge_sub_modalidades sub on sub.cod_modulo = p.cod_modulo and sub.cod_modalidad = p.cod_modalidad and sub.cod_sub_modalidad = p.cod_sub_modalidad
    inner join cr_piz_plazos pl on pl.cod_modulo = p.cod_modulo and pl.cod_modalidad = p.cod_modalidad and pl.cod_sub_modalidad = p.cod_sub_modalidad
    where p.parametro = 'SIM_PRESTAMOS';

   CURSOR c_listaiconos IS
    select p.val_parametro, p.cod_modulo, p.cod_modalidad, p.cod_sub_modalidad
    from ge_par_dinamicos p
    inner join ge_sub_modalidades sub on sub.cod_modulo = p.cod_modulo and sub.cod_modalidad = p.cod_modalidad and sub.cod_sub_modalidad = p.cod_sub_modalidad
    where p.parametro = 'SIM_PRESTAMOS_IMG';

   BEGIN

      -- validar API_CLIENT
      IF p_apikey <> v_apiTirica THEN
         v_retorno.nombreRespuesta      := 'API Client no valido';
         v_retorno.descripcionRespuesta := 'Se esperaba un key válido';
         v_retorno.error                := MSG_ERROR;
         RETURN v_retorno;
     END IF;


      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(null, p_codigoCanal, null, v_codOperacion, null, 'fu_simuladorPrestamo - '
                      || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ENTRADA);

      /**/
      FOR reg IN c_pizarra LOOP
          v_pizarra.modulo := reg.cod_modulo;
          v_pizarra.modalidad := reg.cod_modalidad;
          v_pizarra.subModalidad := reg.cod_sub_modalidad;
          v_pizarra.descripcion := reg.descripcion;
          v_pizarra.codMoneda := reg.cod_moneda;
          v_pizarra.montoDesde := reg.mto_desde;
          v_pizarra.montoHasta := reg.mto_hasta;
          v_pizarra.tipo :=  reg.val_parametro;

          v_listapizarra.extend;
          v_listapizarra(v_listapizarra.count) := v_pizarra;

          v_contador := v_contador + 1;

      END LOOP;
      v_retorno.cantDetallesPizarra := v_contador;
      --cera para contar plazos
      v_contador := 0;
      FOR reg IN c_plazos LOOP
          v_plazo.modulo := reg.cod_modulo;
          v_plazo.modalidad := reg.cod_modalidad;
          v_plazo.subModalidad := reg.cod_sub_modalidad;
          v_plazo.codMoneda := reg.cod_moneda;
          v_plazo.plzDesde := reg.plz_desde;
          v_plazo.plzhasta := reg.plz_hasta;
          v_plazo.tasInteres  :=  reg.tas_interes;
          v_plazo.tipo        := reg.val_parametro;
          v_listaplazos.extend;
          v_listaplazos(v_listaplazos.count) := v_plazo;

          v_contador := v_contador + 1;
      END LOOP;

      v_retorno.listaPizarra := v_listapizarra;
      v_retorno.listaPlazos := v_listaplazos;

      v_retorno.cantDetallesPlazos := v_contador;

      v_contador := 0;
      FOR reg IN c_listaiconos LOOP
          v_icono.modulo := reg.cod_modulo;
          v_icono.modalidad := reg.cod_modalidad;
          v_icono.subModalidad := reg.cod_sub_modalidad;
          v_icono.directorio := nvl(fug_obt_pardinamico('URL_CDN_HOMEBANKING'), 'https://desarrollo.bbva.com.py/cdn/') || 'loans/' || reg.cod_modulo|| '_' || reg.cod_modalidad || '_'|| 'loan.png';

          v_listaiconos.extend;
          v_listaiconos(v_listaiconos.count) := v_icono;

          v_contador := v_contador + 1;
      END LOOP;

      v_retorno.listaIconos := v_listaiconos;

      v_retorno.cantDetallesIconos := v_contador;

      /**/
      pr_insertarBitacora(null, p_codigoCanal, null, v_codOperacion, null, 'fu_simuladorPrestamo - '
                      || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ENTRADA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(null, p_codigoCanal, null, v_codOperacion, null,
         'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] '
         || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
   END;

     -- lista los seguros existentes para el cliente
   FUNCTION fu_obtenerSeguros(p_sesion      IN VARCHAR2,
                              p_codigoCanal IN VARCHAR2,
                              p_codigoSeguro IN VARCHAR2 DEFAULT NULL) RETURN TYP_SEGUROS IS

      v_retorno        TYP_SEGUROS := TYP_SEGUROS();
      v_seguro         TYP_SEGUROPOLIZAS := TYP_SEGUROPOLIZAS();
      v_listapolizas   TYP_LISTASEGUROSPOLIZAS := TYP_LISTASEGUROSPOLIZAS();
      v_listacuotas    TYP_LISTASEGUROSCUOTAS := TYP_LISTASEGUROSCUOTAS();
      v_permiso        typ_obtenerPermisos;
      v_cancuotasatrasadas NUMBER(2) := 0;
      v_fecProxVencimiento DATE := NULL; --fecha en que vence la sgte factura


      retValidarSesion typ_validarSesion;
      v_mensajeCaja    typ_mensajeCaja;
      v_codOperacion   VARCHAR2(3) := '042';--Seguros
      v_contador       VARCHAR2(2) := 0;-- size de listas
      v_cuotas         typ_segurocuotas := typ_segurocuotas();
      v_cuotaRow       GE_POL_CUOTAS%ROWTYPE;
      v_cuotasCont     number(2) := 0;
      v_polMadreAccidentes VARCHAR2(2000) := '';
      v_polMadreVida   VARCHAR2(2000) := '';
      
      v_msj_bitacora   VARCHAR2(800) := substr('p_sesion:' || p_sesion
                                              || ', p_codigoCanal:' || p_codigoCanal
                                              || ', p_codigoSeguro:' || p_codigoSeguro, 1, 800);
      CURSOR c_serguros IS
        SELECT s.codigo,s.cod_ente ,s.producto, TRIM(fue_obt_des_refcodes('SEC_SEGURO', s.seccion)) AS seccion,
               s.sub_seccion, s.nro_poliza, e.descripcion AS cia_seguros, s.fec_inicial,
               s.fec_final, s.mto_capital, s.can_cuota, s.cod_moneda, s.tip_movimiento,
               'N' as es_preaprobado, null as beneficiario, -99 as cod_tip_seguro,  s.fec_insercion
          FROM ge_pol_seguros s
         INNER JOIN ge_entes e ON s.cod_ente = e.cod_ente
         WHERE s.cod_persona =
               nvl(retValidarSesion.codigoEmpresa,
                   retValidarSesion.codigoPersona)
           AND s.estado = 2 -- 2 estado activo
           ANd s.mto_capital > 0
           AND s.situacion = 1 -- 1 Situacion vigente
           AND (s.codigo = p_codigoSeguro OR p_codigoSeguro IS NULL)
        UNION
        SELECT s2.nro_seguro as codigo,s2.cod_ente as cod_ente ,null as producto, null as seccion, t2.descripcion as sub_seccion,
               decode(s2.cod_tip_seguro, 2,trim(v_polMadreAccidentes),3, trim(v_polMadreVida)) || '/' || to_char(s2.nro_seguro) as nro_poliza,
               e2.descripcion as cia_seguros, s2.fec_inicio as fec_inicial, s2.fec_vencimiento as fec_final,
               s2.mto_capital as mto_capital, 1 as can_cuota, 'GS' as cod_moneda, '1' as tip_movimiento,
               'S' as es_preaprobado, s2.beneficiario, s2.cod_tip_seguro, s2.fec_insercion
          FROM ge_cli_seguros s2
         INNER JOIN ge_tip_seguros t2 ON s2.cod_tip_seguro = t2.cod_tipo
         INNER JOIN ge_entes e2 ON e2.cod_ente = t2.cod_ente
                    AND s2.estado = 'V'
                    AND s2.cod_persona = nvl(retValidarSesion.codigoEmpresa,
                                             retValidarSesion.codigoPersona)
                    AND (s2.nro_seguro = p_codigoSeguro OR p_codigoSeguro IS NULL);

      CURSOR c_cuotas(p_codigo IN ge_pol_cuotas.codigo%TYPE) IS
      select c.*
      from ge_pol_seguros s
       inner join ge_pol_cuotas c on c.codigo = s.codigo
       where c.codigo =  p_codigo
              and s.estado = 2-- 2 estado activo
              and s.mto_capital > 0;
            --  and s.cod_ente <> 130 ;-- ignorar mapfre  --> comentado DDEVOLUT-324

      CURSOR c_cuotas_preaprobados(p_codigo IN ge_cuo_seguros.nro_seguro%TYPE) IS
          SELECT sp.nro_seguro as codigo, sp.nro_cuota, sp.fec_vencimiento as fec_vencimiento,
              sp.monto as monto, null as observacion, DECODE(estado,'V','I','C','T','I') as estado,
              usu_insercion, fec_insercion, usu_modificacion, fec_insercion as fec_modificacion
          FROM ge_cuo_seguros sp
          WHERE nro_seguro = p_codigo
          and sp.estado = 'C';

      /*Retorna 'S' si el tipo de movimiento corresponde a Endoso en la tabla ba_cod_referencias*/
      FUNCTION lf_tiene_endoso(p_cod_tip_movimiento IN VARCHAR2)
        RETURN VARCHAR2 IS
        v_es_endoso NUMBER;
      BEGIN
        select count(*)
          into v_es_endoso
          from ba_cod_referencias
         where dominio = 'TIP_MOV_POLIZA'
           and val_minimo = p_cod_tip_movimiento
           and val_maximo = p_cod_tip_movimiento
           and upper(significado) like '%ENDOSO%';
        IF v_es_endoso >= 1 THEN
          RETURN 'S';
        END IF;
        RETURN 'N';
      EXCEPTION
        WHEN OTHERS THEN
          RETURN 'N';
      END;

   BEGIN
      --valido la sesión del cliente
      retValidarSesion := fu_validarSesion(depurarAlfanumerico(p_sesion, 32), p_codigoCanal);
      IF retValidarSesion.error = 'S' THEN
         pr_mensajeUsuario(MSG_ERROR, retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta, retValidarSesion.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_codOperacion, retValidarSesion.codigoEmpresa,
                'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] '
                || fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- validamos la caja
      v_mensajeCaja := lf_val_caja(retValidarSesion);
      IF v_mensajeCaja.error = 'S' THEN
         pr_mensajeUsuario(MSG_ERROR, retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta, retValidarSesion.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_codOperacion, retValidarSesion.codigoEmpresa,
               'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] '
               || fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta, NULL), BITACORA_ERROR);

         RETURN v_retorno;
      END IF;

      -- control de permisos
      v_permiso := lf_obt_permisos(retValidarSesion, v_codOperacion);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_codOperacion, retValidarSesion.codigoEmpresa, 'lf_obt_permisos - '
            || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona,
                                p_codigoCanal,
                                p_sesion,
                                v_codOperacion,
                                retValidarSesion.codigoEmpresa,
                                'fu_obtenerSeguros - params{'||v_msj_bitacora ||'} -'
                                || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                BITACORA_ENTRADA);

      v_msj_bitacora := 'Seguros retornados: ';
      --Se obtiene el valor de la poliza madre para mostrar en los seguros preaprobados contratados
      v_polMadreAccidentes := fug_obt_pardinamico('SEG_WEB_POL_ACCIDENTES');
      v_polMadreVida := fug_obt_pardinamico('SEG_WEB_POL_VIDA');
      FOR reg IN c_serguros LOOP
        v_seguro.codEnte       := reg.cod_ente;
        v_seguro.codigo        := reg.codigo;
        v_seguro.producto      := reg.producto;
        v_seguro.seccion       := reg.seccion;
        v_seguro.subSeccion    := reg.sub_seccion;
        v_seguro.nroPoliza     := reg.nro_poliza;
        v_seguro.ciaSeguros    := reg.cia_seguros;
        v_seguro.fecInicial    := reg.fec_inicial;
        v_seguro.fecFinal      := reg.fec_final;
        v_seguro.mtoCapital    := reg.mto_capital;
        v_seguro.canCuota      := reg.can_cuota;
        v_seguro.codMoneda     := reg.cod_moneda;
        v_seguro.tipMovimiento := reg.tip_movimiento;
        v_seguro.tieneEndoso   := lf_tiene_endoso(reg.tip_movimiento);
        v_seguro.beneficiario  := reg.beneficiario;
        v_seguro.esPreaprobado := reg.es_preaprobado;
        v_seguro.codTipSeguro  := reg.cod_tip_seguro;

        IF (instr(fug_obt_pardinamico('ASEG_GEN_POLIZA', null, null), reg.cod_ente) = 0) THEN
            v_seguro.generaPolizaWeb := 'N';
        ELSE
            v_seguro.generaPolizaWeb := 'S';
        END IF;

      -- obtener razon social
      v_seguro.nombreEntidad := fug_obt_dat_entidad(p_opcion => 'NOM',
                                                     p_fecha  => to_char(v_seguro.fecInicial, 'ddmmyyyy'),
                                                     p_tipo   => 'FA');

        v_msj_bitacora := v_msj_bitacora || ' {cod: '||v_seguro.codigo || ' - reg.sub_seccion: '|| v_seguro.subSeccion ||'} ' ;
        --Cargamos el detalle solo si llega el codigo del seguro solicitado
        IF p_codigoSeguro is not null THEN
            IF reg.es_preaprobado = 'N' THEN
          OPEN c_cuotas(reg.codigo);
          LOOP
          FETCH c_cuotas INTO v_cuotaRow;
              EXIT WHEN c_cuotas%NOTFOUND;
              v_cuotas.nroCuota := v_cuotaRow.nro_cuota;
              v_cuotas.fecVencimiento := v_cuotaRow.fec_vencimiento;
              v_cuotas.monto := v_cuotaRow.monto;
              v_cuotas.estado := v_cuotaRow.estado;
              v_cuotasCont := v_cuotasCont +1 ;

              -- verificar si es cuota atrasada y contar
              if trunc(sysdate) >  trunc(v_cuotas.fecVencimiento)
                 and v_cuotas.estado <> 'T'
              then
                 v_cancuotasatrasadas := v_cancuotasatrasadas + 1 ;
              end if;

              -- verificar el proximo vencimiento
              if v_fecProxVencimiento is null then
                 if trunc(sysdate) < trunc(v_cuotas.fecVencimiento)
                    and trunc(v_cuotas.fecVencimiento) < trunc(sysdate + 30) then
                    v_fecProxVencimiento := v_cuotas.fecVencimiento;
                 else
                   v_fecProxVencimiento := null;
                 end if;
              end if;
              v_listacuotas.extend;
              v_listacuotas(v_listacuotas.count) := v_cuotas;
          END LOOP;
          CLOSE c_cuotas;
            ELSE
              -- carga inicial con la fecha actual
                --v_fecProxVencimiento := NULL;

                OPEN c_cuotas_preaprobados(reg.codigo);
                LOOP
                FETCH c_cuotas_preaprobados INTO v_cuotaRow;
              EXIT WHEN c_cuotas_preaprobados%NOTFOUND;
                    v_cuotas.nroCuota       := v_cuotaRow.nro_cuota;
                    v_cuotas.fecVencimiento := v_cuotaRow.fec_vencimiento;
                    v_cuotas.monto          := v_cuotaRow.monto;
                    v_cuotas.estado         := v_cuotaRow.estado;
                    v_cuotasCont            := v_cuotasCont + 1;

                    -- verificar el proximo vencimiento
                    if v_fecProxVencimiento is null then
                       if trunc(sysdate) < trunc(v_cuotas.fecVencimiento)
                          and trunc(v_cuotas.fecVencimiento) < trunc(sysdate + 30) then
                          v_fecProxVencimiento := v_cuotas.fecVencimiento;
                       else
                          v_fecProxVencimiento := null;
                       end if;
                    end if;
                    v_listacuotas.extend;
                    v_listacuotas(v_listacuotas.count) := v_cuotas;
                END LOOP;
                CLOSE c_cuotas_preaprobados;
            END IF;

          v_seguro.fecProxVencimiento := v_fecProxVencimiento;
          v_seguro.canCuotasAtrasadas := v_cancuotasatrasadas;
          v_seguro.canCuota := v_cuotasCont;
          v_seguro.cantidad := v_cuotasCont;
          v_seguro.listaCuotas    := v_listacuotas;
          --evita null; para el caso mapfre donde no se traen cuotas
          IF(v_seguro.listaCuotas.count >0) THEN
              v_seguro.mtoCuota      := v_seguro.listaCuotas(1).monto;
          END IF;
        END IF;
        v_cuotasCont:= 0;
        v_listapolizas.extend;
        v_listapolizas(v_listapolizas.count) := v_seguro;
        v_contador := v_contador + 1 ;

      END LOOP;


      v_retorno.listaPolizas := v_listapolizas;
      v_retorno.contPolizas := v_contador;

      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_codOperacion, retValidarSesion.codigoEmpresa,
       'fu_obtenerSeguros - params{'||SUBSTR(v_msj_bitacora, 1, 200) ||'} -'
         || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_codOperacion, retValidarSesion.codigoEmpresa,
         'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] '
         || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   --
   -- Actualiza la tabla bw_pag_servicios para almacenar la factura del pago de servicio enviada por la portadora
   --
   FUNCTION fu_pagoServicioUpdateWs(p_codSesion     IN VARCHAR2,
                                    p_codCanal      IN VARCHAR2,
                                    p_modo          IN VARCHAR2 default 'F',
                                    p_ticket        IN CLOB,
                                    p_codPersona    IN VARCHAR2,
                                    p_codEmpresa    IN VARCHAR2 default NULL,
                                    p_serConcepto   IN VARCHAR2,
                                    p_codToken      IN VARCHAR2,
                                    p_montoComision IN NUMBER) RETURN typ_mensajeRespuesta IS

      v_cod_operacion      VARCHAR2(3) := '088'; --Cod Operacion de Pago de Servicios
      v_usu_sesion         typ_validarSesion;
      v_permiso            typ_obtenerPermisos;
      v_msj_caja           typ_mensajeCaja;

      v_modo               VARCHAR2(1) := substr(p_modo, 1, 1);
      v_ticket             bw_pag_servicios.ticket%TYPE := p_ticket;
      v_codPersona         bw_pag_servicios.cod_persona%TYPE := depurarTextos(p_codPersona, 10);
      v_codEmpresa         bw_pag_servicios.cod_empresa%TYPE := depurarTextos(nvl(p_codEmpresa,' '), 10);
      v_serConcepto        bw_pag_servicios.ser_concepto%TYPE := depurarTextos(p_serConcepto, 50);
      v_codToken           bw_pag_servicios.cod_ws_servicios%TYPE := depurarTextos(p_codToken, 300);
      v_montoComision      bw_pag_servicios.mto_comision%TYPE := p_montoComision;

      v_retorno            typ_mensajerespuesta := typ_mensajerespuesta;
      v_msj_bitacora       VARCHAR2(700) := substr('modo:'||v_modo||', codPersona:'||v_codPersona||
                                            ', codEmpresa:'||v_codEmpresa ||
                                            ', serConcepto:'||v_serConcepto||
                                            ', codToken:'||p_codToken, 1, 700);

      MSG_OPE_NO_PERMITIDA     CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_PAR_INCORRECTOS      CONSTANT VARCHAR2(15) := 'PARAM_INCORRECT';

    -- cambios para servicios criticos
      v_operacion VARCHAR2(3) := NULL;
      v_abre_oper ba_cod_referencias.abreviatura%TYPE := NULL;
      v_proveedor NUMBER(2) := 0;
      v_servicio  NUMBER(4) := 0;
      v_tag       VARCHAR(20) := NULL;
      v_concepto  VARCHAR(50) := NULL;

   BEGIN
      -- Verifica la sesion
      v_usu_sesion := fu_validarSesion(p_codSesion, p_codCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error := v_usu_sesion.error;
         v_retorno.nombreRespuesta := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- Inicializa mensaje de retorno e inserta bitacora inicio
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora, BITACORA_ENTRADA);

      -- Verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- Verifica el permiso
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      IF v_permiso.error = 'S' THEN
         v_retorno.error                := v_permiso.error;
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- app movil envia una pseudo sesion al API de PAGOS
      IF p_codCanal = 990 THEN
         v_codPersona := v_usu_sesion.codigoPersona;
         v_codEmpresa := v_usu_sesion.codigoEmpresa;
      END IF;

      --Validacion de datos de entrada
      IF v_ticket IS NULL OR v_codPersona IS NULL OR
         v_serConcepto IS NULL OR v_codToken IS NULL THEN
         pr_mensajeUsuario(MSG_PAR_INCORRECTOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --Validacion de seguridad: el cod de la persona/empresa que se quiere actualizar
      --debe ser el mismo que esta logueado segun fu_validar_sesion
      IF (v_usu_sesion.codigoPersona <> v_codPersona) OR
         (v_usu_sesion.codigoEmpresa is not null AND
          v_usu_sesion.codigoEmpresa <> v_codEmpresa) THEN
         pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      --Vemos que campos actualizar, si v_serConcepto es ZIMPLE
      --como ya se tienen todos los datos guardados, se actualiza solo el ticket
      IF v_serConcepto = 'ZIMPLE' THEN
        BEGIN
           UPDATE bw_pag_servicios
              SET TICKET = v_ticket
            WHERE COD_WS_SERVICIOS = v_codToken
              AND REVERSADO = 'N';
           COMMIT;
        EXCEPTION
           WHEN OTHERS THEN
              pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
        END;
      ELSE
      --Update del registro del pago para almacenar factura en el campo Ticket
      SELECT ps.cod_servicio, ps.cod_proveedor
        INTO v_servicio, v_proveedor
        FROM bw_pag_servicios ps
       WHERE ps.cod_ws_servicios = v_codToken;

      v_abre_oper := paw_uti.fu_obt_abr_refcodes('SERVICIOS_CRITICOS',
                                                 to_char(v_servicio),
                                                 to_char(v_proveedor));

      IF v_abre_oper = to_char(v_servicio) THEN
        v_operacion := '091';
        v_tag       := 'COD_WS_CRI:'; -- para diferenciar limites en los movimientos
      ELSE
        v_operacion := '088';
        v_tag       := 'COD_WS:';
      END IF;
      v_concepto := '-' || v_tag || v_serConcepto;
      BEGIN
         UPDATE bw_pag_servicios
            SET COD_PERSONA  = v_codPersona,
                COD_EMPRESA  = v_codEmpresa,
                TICKET       = v_ticket,
                SER_CONCEPTO = v_concepto,
                MTO_COMISION = v_montoComision
          WHERE COD_WS_SERVICIOS = v_codToken
            AND REVERSADO = 'N';   --DYDMR-5526 Diciembre/2016
         COMMIT;
      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END;
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', retorno: ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR :[' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   --
   -- Recupera y retorna de la tabla bw_pag_servicios el listado de facturas de pago de servicios de un cliente
   --   Si viene    p_codToken, se busca el detalle de 1 sola factura
   --   Si no viene p_codToken, se busca el listado de facturas de los ultimos 6 meses del cliente indicado
   --
   FUNCTION fu_obtFacturasPagoServiciosWs(p_codSesion      IN VARCHAR2,
                                          p_codCanal       IN VARCHAR2,
                                          p_modo           IN VARCHAR2 default 'L',
                                          p_codPersona     IN VARCHAR2,
                                          p_codToken       IN VARCHAR2 default NULL,
                                          p_codEmpresa     IN VARCHAR2 default NULL,
                                          p_numeroPagina   IN NUMBER DEFAULT NULL,
                                          p_cantidadPagina IN NUMBER DEFAULT NULL) RETURN typ_facturasServicios IS

      v_cod_operacion      VARCHAR2(3) := '088'; --Cod Operacion de Pago de Servicios
      v_usu_sesion         typ_validarSesion;
      v_permiso            typ_obtenerPermisos;
      v_msj_caja           typ_mensajeCaja;

      v_modo               VARCHAR2(1) := substr(p_modo, 1, 1);
      v_codPersona         bw_pag_servicios.cod_persona%TYPE := depurarTextos(p_codPersona, 10);
      v_cp                 bw_pag_servicios.cod_persona%TYPE;
      v_codToken           bw_pag_servicios.cod_ws_servicios%TYPE := depurarTextos(nvl(p_codToken,' '), 300);
      v_codEmpresa         bw_pag_servicios.cod_empresa%TYPE := depurarTextos(nvl(p_codEmpresa,' '), 10);
      v_ce                 bw_pag_servicios.cod_empresa%TYPE;

      v_detalle            typ_facturaServicio := typ_facturaServicio();
      v_lis_detalle        typ_listaFacturasServicios := typ_listaFacturasServicios();
      v_retorno            typ_facturasServicios := typ_facturasServicios();
      v_msj_bitacora       VARCHAR2(700) := substr('modo:'||v_modo||', codPersona:'||v_codPersona||
                                            ', codToken:'||v_codToken ||
                                            ', codEmpresa:'||v_codEmpresa||
                                            ', nroPagina:'||p_numeroPagina||
                                            ', cantPagina:'||p_cantidadPagina, 1, 700);

      MSG_OPE_NO_PERMITIDA CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_PAR_INCORRECTOS  CONSTANT VARCHAR2(15) := 'PARAM_INCORRECT';

      v_can_registros      NUMBER := 0;
      v_fec_actual DATE := sysdate; -- fecha de hoy
      v_cant_meses VARCHAR2(3) := nvl(fug_obt_pardinamico('MAX_MES_FAC_SERVICIOS'),14);

      cursor c_listaFacturasFisica(pcCodPer IN bw_pag_servicios.cod_persona%TYPE) IS
         SELECT
            ps.cod_ws_servicios,
            ps.fecha,
            ps.ser_concepto,
            CASE WHEN ps.mto_comision > 0 THEN ps.mto_comision ELSE ps.mto_debito END AS monto,
            ps.ticket,
            ps.cod_servicio,
            ps.cod_proveedor,
            ps.nro_lote
          FROM
            bw_pag_servicios ps
          WHERE
            ps.cod_persona = pcCodPer
            AND ps.cod_empresa IS NULL
            AND ps.mto_comision IS NOT NULL
            AND (ps.ticket IS NOT NULL OR ps.cod_servicio = 12) -- si es giro a billetera igual debe mostrar
            AND ps.fecha > last_day(add_months(v_fec_actual, -v_cant_meses))
            AND ps.reversado = 'N'
          ORDER BY ps.fec_modificacion desc;

      cursor c_listaFacturasEmpresa(pcCodEmp IN bw_pag_servicios.cod_empresa%TYPE) IS
         SELECT
             ps.cod_ws_servicios,
             ps.fecha,
             ps.ser_concepto,
             CASE WHEN ps.mto_comision > 0 THEN ps.mto_comision ELSE ps.mto_debito END AS monto,
             ps.ticket,
             ps.cod_servicio,
             ps.cod_proveedor,
             ps.nro_lote
           FROM bw_pag_servicios ps
          WHERE ps.cod_empresa = pcCodEmp
            AND ps.mto_comision IS NOT NULL
            AND ps.ticket IS NOT NULL
            AND ps.fecha > last_day(add_months(v_fec_actual, -v_cant_meses))
            AND ps.reversado = 'N'
          ORDER BY ps.fec_modificacion desc;
   BEGIN
      -- Verifica la sesion
      v_usu_sesion := fu_validarSesion(p_codSesion, p_codCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error := v_usu_sesion.error;
         v_retorno.nombreRespuesta := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- Inicializa mensaje de retorno e inserta bitacora inicio
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora, BITACORA_ENTRADA);

      -- Verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- Verifica el permiso
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      IF v_permiso.error = 'S' THEN
         v_retorno.error                := v_permiso.error;
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      --Validacion de datos de entrada
      IF (v_codToken IS NULL and v_codPersona IS NULL and v_codEmpresa IS NULL) THEN
         pr_mensajeUsuario(MSG_PAR_INCORRECTOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --Validacion de seguridad: el cod de la persona/empresa que se quiere recuperar
      --debe ser el mismo que esta logueado segun fu_validar_sesion
      IF (v_codPersona is not null and v_usu_sesion.codigoPersona <> v_codPersona) OR
         (v_codEmpresa is not null and v_usu_sesion.codigoEmpresa <> v_codEmpresa) THEN
         pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- setear valor por defecto de proveedor
      v_detalle.codProveedor := 0;
      --Se recuperan los datos y se retorna
      IF (v_codToken IS NOT NULL) THEN
         --Se recupera el detalle de 1 sola factura
         BEGIN
              SELECT ps.cod_ws_servicios, ps.cod_persona, ps.cod_empresa, ps.cod_proveedor, ps.fecha, ps.ser_concepto, ps.mto_comision, ps.ticket, ps.cod_servicio, ps.nro_lote
                INTO v_codToken,v_cp, v_ce, v_detalle.codProveedor, v_detalle.fecha, v_detalle.servConcepto, v_detalle.totalFactura, v_detalle.ticket, v_detalle.codServicio, v_detalle.nroLote
                FROM bw_pag_servicios ps
               WHERE ps.cod_ws_servicios = v_codToken
                 AND ps.reversado = 'N';

              --Validacion de seguridad: el cod de la persona/empresa que se quiere recuperar
              --debe ser el mismo que esta logueado segun fu_validar_sesion
              IF (v_ce is null and v_usu_sesion.codigoPersona <> v_cp) OR
                 (v_ce is not null and v_usu_sesion.codigoEmpresa <> v_ce) THEN
                 pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 RETURN v_retorno;
              END IF;

              v_lis_detalle.extend;
              v_lis_detalle(v_lis_detalle.count) := v_detalle;
              v_retorno.cantFacturas := 1;
         EXCEPTION
             WHEN NO_DATA_FOUND THEN
                v_retorno.cantFacturas := 0;
             WHEN OTHERS THEN
                pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END;
      ELSE
         --Se recupera el listado de facturas del cliente de los ultimos meses
         IF (v_codEmpresa IS NOT NULL) THEN
             FOR fac IN c_listaFacturasEmpresa(v_codEmpresa) LOOP
                v_can_registros := v_can_registros + 1;
                IF p_cantidadPagina IS NOT NULL THEN
                   IF v_can_registros > (p_cantidadPagina * p_numeroPagina) THEN
                      EXIT;
                   END IF;
                END IF;
                IF v_can_registros > (nvl(p_cantidadPagina, 1) * (nvl(p_numeroPagina, 1) - 1)) THEN
                   v_detalle.fecha        := fac.fecha;
                   v_detalle.servConcepto := fac.ser_concepto;
                   v_detalle.totalFactura := fac.monto;
                   v_detalle.ticket       := fac.ticket;
                   v_detalle.tokenCode    := fac.cod_ws_servicios;
                   v_detalle.codServicio  := fac.cod_servicio;
                   v_detalle.nroLote      := fac.nro_lote;
                   v_detalle.codProveedor := fac.cod_proveedor;
                   v_lis_detalle.extend;
                   v_lis_detalle(v_lis_detalle.count) := v_detalle;
                END IF;
             END LOOP;
         ELSE
             FOR fac IN c_listaFacturasFisica(v_codPersona) LOOP
                v_can_registros := v_can_registros + 1;
                IF p_cantidadPagina IS NOT NULL THEN
                   IF v_can_registros > (p_cantidadPagina * p_numeroPagina) THEN
                      EXIT;
                   END IF;
                END IF;
                IF v_can_registros > (nvl(p_cantidadPagina, 1) * (nvl(p_numeroPagina, 1) - 1)) THEN
                   v_detalle.fecha        := fac.fecha;
                   v_detalle.servConcepto := fac.ser_concepto;
                   v_detalle.totalFactura := fac.monto;
                   v_detalle.ticket       := fac.ticket;
                   v_detalle.tokenCode    := fac.cod_ws_servicios;
                   v_detalle.codServicio  := fac.cod_servicio;
                   v_detalle.nroLote      := fac.nro_lote;
                   v_detalle.codProveedor := fac.cod_proveedor;
                   v_lis_detalle.extend;
                   v_lis_detalle(v_lis_detalle.count) := v_detalle;
                END IF;
             END LOOP;
         END IF;
         v_retorno.cantFacturas  := v_lis_detalle.count;
      END IF;

      v_retorno.listaFacturas := v_lis_detalle;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', retCantFacturas:' || v_retorno.cantFacturas || ', retorno:' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_codSesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR :[' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   -- Validacion y confirmacion de alta de funcionarios
   FUNCTION fu_altaEmpleados(p_sesion             IN VARCHAR2,
                             p_codigoCanal        IN VARCHAR2,
                             p_modo               IN VARCHAR2,
                             p_codigoMoneda       IN VARCHAR2,
                             p_notificacionMail   IN VARCHAR2,
                             p_cantidad           IN NUMBER,
                             p_parametros         IN CLOB,
                             p_claveTransaccional IN VARCHAR2,
                             p_claveToken         IN VARCHAR2,
                             p_numeroDocumento    IN NUMBER DEFAULT NULL) RETURN typ_altaEmpleados IS
      v_detalle           typ_empleado := typ_empleado();
      v_lis_detalle       typ_listaempleados := typ_listaempleados();
      v_retorno           typ_altaEmpleados := typ_altaEmpleados();
      v_cod_operacion     VARCHAR2(3) := '130';
      v_resLimite         typ_respuestaLimite;
      v_fec_actual        DATE := pag_cal.fu_obt_fec_actual(9);
      v_usu_sesion        typ_validarsesion;
      v_msj_respuesta     typ_MensajeRespuesta := typ_MensajeRespuesta;
      v_msj_caja          typ_mensajeCaja;
      v_permiso           typ_obtenerPermisos;
      v_nro_lote          ge_pag_sue_emp.nro_lote%TYPE;
      v_nro_lote_tmp      ge_pag_sue_emp_tmp.nro_lote%TYPE;
      v_cod_moneda        ba_monedas.cod_moneda%TYPE;
      v_lugar             VARCHAR2(100);
      v_registro          VARCHAR2(4000);
      v_pos_ant           NUMBER(8);
      v_pos_nvo           NUMBER(8);
      v_fecha             VARCHAR2(8);
      v_separador         VARCHAR2(2) := ';;';
      v_item              NUMBER(2) := 2;
      v_lin_inicial       ge_archivos.lin_inicial%TYPE;
      v_des_ente          ge_entes.descripcion%TYPE;
      v_referencia        ge_arc_campos.referencia%TYPE := 'SUE_EMPLEADOS';
      v_tabla             ge_arc_campos.nom_tabla%TYPE := 'GE_PAG_SUE_EMP_TMP';
      v_nro_cta_debito    ge_cuentas.nro_cuenta%TYPE;
      v_cod_ente          ge_entes.cod_ente%TYPE;
      v_not_dir_correo    VARCHAR2(50);
      v_pos_ant_proc      NUMBER;
      v_pos_nvo_proc      NUMBER;
      v_can_registros     NUMBER;
      v_can_errores       NUMBER;
      v_can_duplicado     NUMBER;
      v_nro_documento     NUMBER(15);
      v_existe            VARCHAR2(1);
      v_meses             NUMBER;
      v_min_transaccion   VARCHAR2(1) := nvl(substr(fug_obt_pardinamico('PAW_MIN_TRANSACCION'), 1, 1), 10);
      v_msj_bitacora      VARCHAR2(800) := substr('modo:'||trim(p_modo)
                                                         ||', can:'||p_cantidad, 1, 500);
      rg_gaemp            ge_pag_sue_emp_tmp%ROWTYPE;
      v_error             bw_men_respuesta.nombre%TYPE := MSG_ERROR;

      -- funcion para limpiar los campos leidos del xls, los ultimos campos si vienen vacios
      -- no rellena con el separador '$', por lo que carga toda la fila en los campos faltantes
      procedure lp_dep_campos is
        v_number number;
      begin
         select REGEXP_COUNT(v_registro, '\$') into v_number from dual;
         -- ----------------------------------
         if v_number < 5 then rg_gaemp.tip_documento := null; end if;
         if v_number < 6 then rg_gaemp.nro_cedula := null; end if;
         if v_number < 7 then rg_gaemp.fec_vto_documento := null; end if;
         if v_number < 8 then rg_gaemp.doc_pais := null; end if;
         if v_number < 9 then rg_gaemp.pri_apellido := null; end if;
         if v_number < 10 then rg_gaemp.seg_apellido := null; end if;
         if v_number < 11 then rg_gaemp.ape_casada := null; end if;
         if v_number < 12 then rg_gaemp.pri_nombre := null; rg_gaemp.seg_nombre := null; end if;
         if v_number < 13 then rg_gaemp.fec_nacimiento := null; end if;
         if v_number < 14 then rg_gaemp.est_civil := null; end if;
         if v_number < 15 then rg_gaemp.pais := null; end if;
         if v_number < 16 then rg_gaemp.sexo := null; end if;
         if v_number < 17 then rg_gaemp.direccion := null; end if;
         if v_number < 18 then rg_gaemp.telefono := null; end if;
         if v_number < 19 then rg_gaemp.celular := null; end if;
         if v_number < 20 then rg_gaemp.ciudad := null; end if;
         if v_number < 21 then rg_gaemp.fec_ingreso := null; end if;
         if v_number < 22 then rg_gaemp.profesion := null; end if;
         if v_number < 23 then rg_gaemp.sueldo := null; end if;
         if v_number < 25 then rg_gaemp.mail := null; end if;
         if v_number < 26 then rg_gaemp.cod_pai_fatca := null; end if;
         if v_number < 27 then rg_gaemp.dir_fiscal := null; end if;
         if v_number < 28 then rg_gaemp.cod_pai_fiscal := null; end if;
         if v_number < 29 then rg_gaemp.cod_sec_contable := null; end if;
         if v_number < 30 then rg_gaemp.tip_contrato := null; end if;
         if v_number < 31 then rg_gaemp.direc_kit := null; end if;
         -- ----------------------------------
      end;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(p_sesion, p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 3. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      IF nvl(p_modo, 'x') = 'A' THEN
         -- modo A solo puede venir de fu_autorizaOperacion
         IF g_aut_operacion = FALSE THEN
            pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      ELSE
         v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
         IF (v_permiso.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
            v_retorno.error                := v_permiso.error;
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- se verifica que tenga permiso para registrar
         IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
            pr_mensajeUsuario('SAL_PER_SIN_AUT', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
      -- control de modos permitidos
      IF p_modo NOT IN ('L','V','C','A','D') THEN
         pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_cod_moneda := substr(p_codigoMoneda, 1, 3);
      v_not_dir_correo := paw_uti.depurarMail(p_notificacionMail, 50);
      v_msj_bitacora := v_msj_bitacora || ', cod_mon: ' || v_cod_moneda;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);
      -- validamos el ente a operar
      BEGIN
          --DDSI-412
         SELECT a.cod_ente, a.descripcion, trim(substr(fug_obt_parentes(a.cod_ente, 'NRO_CTA_DEBITO'), 1, 15))
           INTO v_cod_ente, v_des_ente, v_nro_cta_debito
           FROM ge_entes a, ge_cuentas c
          WHERE a.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
            AND a.tipo = 'SU'
            AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO') = 'S'
            AND fug_obt_parentes(a.cod_ente, 'HAB_HOMEBANKING') = 'S'
      AND c.nro_cuenta = trim(substr(fug_obt_parentes(a.cod_ente, 'NRO_CTA_DEBITO'), 1, 15))
            AND c.cod_moneda = v_cod_moneda;
         v_retorno.codigoEnte := v_cod_ente;
         v_msj_bitacora := v_msj_bitacora || ', ent:' || v_cod_ente;
         IF fug_obt_mon_cta(v_nro_cta_debito) <> v_cod_moneda THEN
            v_msj_bitacora := v_msj_bitacora || ', error de moneda';
            pr_mensajeUsuario('SAL_ERR_DAT_ENT', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         ELSE
            v_retorno.numeroCuenta := v_nro_cta_debito;
         END IF;
      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeUsuario('SAL_ERR_DAT_ENT', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      IF p_modo = 'D' THEN
         BEGIN
            SELECT a.not_mail
              INTO v_retorno.emailNotificacion
              FROM ge_alt_empleados a
             WHERE a.cod_ente = v_cod_ente
               AND a.fec_recepcion = (select max(e.fec_recepcion)
                                        from ge_alt_empleados e
                                       where e.cod_ente = a.cod_ente);
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               v_retorno.emailNotificacion := NULL;
         END;
         v_retorno.cantidadEmpleados := 0;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
         RETURN v_retorno;
      END IF;
      -- direccion de correo es obligatorio para la confirmacion
      IF p_modo IN ('C', 'A') AND v_not_dir_correo IS NULL THEN
         pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- obtenemos formato de archivo
      IF p_modo = 'V' THEN
         BEGIN
            SELECT nvl(a.lin_inicial, 1)
              INTO v_lin_inicial
              FROM ge_archivos a
             WHERE a.referencia = v_referencia;
         EXCEPTION
            WHEN OTHERS THEN
               v_lin_inicial := 1;
         END;
         v_error := 'SAL_FMT_INCORRE';
      END IF;
      -- numero de lote de proceso
      IF nvl(p_modo, 'x') <> 'A' THEN
         BEGIN
            SELECT nvl(MAX(a.nro_lote),0)
              INTO v_nro_lote_tmp
              FROM ge_pag_sue_emp_tmp a
             WHERE a.cod_empresa = v_cod_ente
               AND trunc(a.fec_insercion) = TRUNC(SYSDATE);

            SELECT nvl(MAX(a.nro_lote),0)
              INTO v_nro_lote
              FROM ge_alt_empleados a
             WHERE a.cod_ente = v_cod_ente;

            IF v_nro_lote_tmp > v_nro_lote THEN
               v_nro_lote := v_nro_lote_tmp;
            END IF;
            v_nro_lote := v_nro_lote + 1;
         EXCEPTION
            WHEN OTHERS THEN
               v_nro_lote := 1;
         END;

         v_pos_ant       := 1;
         v_can_registros := 0;
         v_can_errores   := 0;
         -- procesamos los parametros recibidos
         FOR i IN 1 .. nvl(p_cantidad, 0) LOOP
            v_lugar := 'Leyendo el registro Nro.' || i;
            v_pos_nvo  := instr(p_parametros, '~', v_pos_ant);
            v_registro := substr(p_parametros, v_pos_ant, v_pos_nvo - v_pos_ant);
            v_pos_ant  := v_pos_nvo + 1;

            IF length(nvl(TRIM(v_registro), ' ')) < 100 THEN
               GOTO end_alta;
            END IF;
            rg_gaemp                  := NULL;
            rg_gaemp.nro_lote         := v_nro_lote;
            rg_gaemp.usu_insercion    := user;
            rg_gaemp.usu_modificacion := user;
            rg_gaemp.fec_insercion    := sysdate;
            rg_gaemp.fec_modificacion := sysdate;
            rg_gaemp.cod_empresa      := v_cod_ente;
            rg_gaemp.estado           := 'P';

            IF p_modo <> 'V' THEN -- formato fijo
               -- los campos vienen separados por ';'
               v_lugar                := 'tipo documento';
               v_pos_ant_proc         := 1;
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.tip_documento := TRIM(substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 3)); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Numero documento';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.nro_cedula    := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 20, 'S'); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Fec. venc. documento';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               v_fecha := TRIM(substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 8)); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               IF v_fecha IS NOT NULL THEN
                  rg_gaemp.fec_vto_documento := paw_uti.fu_str_fecha(v_fecha, 1);
               END IF;
               v_lugar                := 'Pais documento';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.doc_pais      := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 35); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Primer apellido';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.pri_apellido  := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 30); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Segundo Apellido';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.seg_apellido  := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 30); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Apellido Casada';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.ape_casada    := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 15); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Primer Nombre';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.pri_nombre    := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 30); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Segundo Nombre';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.seg_nombre    := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 30); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Fec. nacimiento';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               v_fecha                := TRIM(substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 8)); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               IF v_fecha IS NOT NULL THEN
                  rg_gaemp.fec_nacimiento := paw_uti.fu_str_fecha(v_fecha, 1);
               END IF;
               v_lugar                := 'Estado civil';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.est_civil     := substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 1); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Pais origen';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.pais          := substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Sexo';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.sexo          := substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 1); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Direccion';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.direccion     := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 80); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Telefono';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.telefono      := depurarNumerico(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 20); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Celular';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.celular       := depurarNumerico(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 20); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Ciudad';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.ciudad        := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 100); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Fec. ingreso';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               v_fecha                := TRIM(substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 8)); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               IF v_fecha IS NOT NULL THEN
                  rg_gaemp.fec_ingreso := paw_uti.fu_str_fecha(v_fecha, 1);
               END IF;
               v_lugar                := 'Profesion';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.profesion     := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 35); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Sueldo';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.sueldo        := paw_uti.fu_for_number(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 18); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Dir. correo';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.mail          := paw_uti.depurarMail(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 100); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Seg. nacionalidad';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.cod_pai_fatca := depurarNumerico(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 3); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Dir. Fiscal';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.dir_fiscal    := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 80); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Pais fiscal';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.cod_pai_fiscal := depurarNumerico(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 3); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Sector Contable';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.cod_sec_contable := substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 1); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Direccionamiento';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.direc_kit     := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 100); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
               v_lugar                := 'Tipo contrato';
               v_pos_nvo_proc         := instr(v_registro, v_separador, v_pos_ant_proc);
               rg_gaemp.tip_contrato  := substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 1); v_pos_ant_proc  := v_pos_nvo_proc + v_item;
            ELSE
               -- por si se envien datos incorrectos, se omiten
               IF v_lin_inicial > i THEN
                  GOTO end_alta;
               END IF;
               -- tomo los datos segun formato de archivo
               v_lugar                := 'tipo documento';
               rg_gaemp.tip_documento := TRIM(substr(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'TIP_DOCUMENTO'), 1, 3));
               v_lugar                := 'Numero documento';
               rg_gaemp.nro_cedula    := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'NRO_CEDULA'), 20, 'S');
               v_lugar                := 'Fec. venc. documento';
               rg_gaemp.fec_vto_documento := to_date(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'FEC_VTO_DOCUMENTO'), 'dd/mm/yyyy');
               v_lugar                := 'Pais documento';
               rg_gaemp.doc_pais      := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'DOC_PAIS'), 35);
               v_lugar                := 'Primer apellido';
               rg_gaemp.pri_apellido  := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'PRI_APELLIDO'), 30);
               v_lugar                := 'Segundo Apellido';
               rg_gaemp.seg_apellido  := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'SEG_APELLIDO'), 30);
               v_lugar                := 'Apellido Casada';
               rg_gaemp.ape_casada    := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'APE_CASADA'), 15);
               v_lugar                := 'Primer Nombre';
               rg_gaemp.pri_nombre    := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'PRI_NOMBRE'), 30);
               v_lugar                := 'Seg. Nombre';
               rg_gaemp.seg_nombre    := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'SEG_NOMBRE'), 30);
               v_lugar                := 'Fec. nacimiento';
               rg_gaemp.fec_nacimiento := to_date(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'FEC_NACIMIENTO'), 'dd/mm/yyyy');
               v_lugar                := 'Estado civil';
               rg_gaemp.est_civil     := substr(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'EST_CIVIL'), 1, 1);
               v_lugar                := 'Pais origen';
               rg_gaemp.pais          := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'PAIS'), 35);
               v_lugar                := 'Sexo';
               rg_gaemp.sexo          := substr(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'SEXO'), 1, 1);
               v_lugar                := 'Direccion';
               rg_gaemp.direccion     := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'DIRECCION'), 80);
               v_lugar                := 'Telefono';
               rg_gaemp.telefono      := depurarNumerico(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'TELEFONO'), 20);
               v_lugar                := 'Celular';
               rg_gaemp.celular       := depurarNumerico(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'CELULAR'), 20);
               v_lugar                := 'Ciudad';
               rg_gaemp.ciudad        := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'CIUDAD'), 100);
               v_lugar                := 'Fec. ingreso';
               rg_gaemp.fec_ingreso   := to_date(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'FEC_INGRESO'), 'dd/mm/yyyy');
               v_lugar                := 'Profesion';
               rg_gaemp.profesion     := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'PROFESION'), 35);
               v_lugar                := 'Sueldo';
               rg_gaemp.sueldo        := paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'SUELDO');
               v_lugar                := 'Dir. correo';
               rg_gaemp.mail          := paw_uti.depurarMail(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'MAIL'), 100);
               v_lugar                := 'Seg. nacionalidad';
               rg_gaemp.cod_pai_fatca := paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'COD_PAI_FATCA');
               v_lugar                := 'Dir. Fiscal';
               rg_gaemp.dir_fiscal    := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'DIR_FISCAL'), 80);
               v_lugar                := 'Pais fiscal';
               rg_gaemp.cod_pai_fiscal := paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'COD_PAI_FISCAL');
               v_lugar                := 'Sector Contable';
               rg_gaemp.cod_sec_contable := substr(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'COD_SEC_CONTABLE'), 1, 1);
               v_lugar                := 'Direccionamiento';
               rg_gaemp.direc_kit     := depurarTextos(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'DIREC_KIT'), 100);
               v_lugar                := 'Tipo contrato';
               rg_gaemp.tip_contrato  := substr(paw_bce.fu_obt_dato(v_referencia, v_tabla, v_registro, 'TIP_CONTRATO'), 1, 1);

               -- funcion para tratar campos faltantes del excell
               lp_dep_campos;
            END IF;

            IF rg_gaemp.cod_pai_fatca = 0 THEN
               rg_gaemp.cod_pai_fatca := NULL;
            END IF;

            IF rg_gaemp.cod_pai_fiscal = 0 THEN
               rg_gaemp.cod_pai_fiscal := NULL;
            END IF;

            IF rg_gaemp.tip_documento IS NULL THEN
               rg_gaemp.tip_documento := 'CI';
            END IF;

            IF nvl(rg_gaemp.sueldo, 0) <= 0 THEN
               rg_gaemp.sueldo := 0;
            END IF;

            IF paw_uti.fu_validarMail(rg_gaemp.mail) = 'N' THEN
               rg_gaemp.mail := NULL;
            END IF;

            v_detalle.codigoProfesion     := fue_obt_cod_profesion(rg_gaemp.profesion);
            rg_gaemp.profesion            := substr(fue_obt_des_profesion(v_detalle.codigoProfesion), 1, 35);

            --emailNotificacion    VARCHAR2(100),
            v_lugar := 'poblando temporal ' || i;
            v_detalle.numeroDocumento     := substr(rg_gaemp.nro_cedula, 1, 20);
            v_detalle.tipoDocumento       := substr(rg_gaemp.tip_documento, 1, 3);
            v_detalle.fechaVencDocumento  := paw_uti.fu_fec_char(rg_gaemp.fec_vto_documento, 1);
            v_detalle.nombrePaisDocumento := substr(rg_gaemp.doc_pais, 1, 60);
            v_detalle.codigoPaisDocumento := fue_obt_cod_pais(v_detalle.nombrePaisDocumento);
            v_detalle.nombre              := substr(rg_gaemp.pri_nombre || ' ' || rg_gaemp.seg_nombre, 1, 60);
            v_detalle.primerApellido      := substr(rg_gaemp.pri_apellido, 1, 30);
            v_detalle.segundoApellido     := substr(rg_gaemp.seg_apellido, 1, 30);
            v_detalle.fechaNacimiento     := paw_uti.fu_fec_char(rg_gaemp.fec_nacimiento, 1);
            v_detalle.sexo                := rg_gaemp.sexo;
            v_detalle.estadoCivil         := rg_gaemp.est_civil;
            v_detalle.direccion           := substr(rg_gaemp.direccion, 1, 100);
            v_detalle.codigoPais          := fue_obt_cod_pais(rg_gaemp.pais);
            v_detalle.pais                := substr(rg_gaemp.pais, 1, 40);
            IF v_detalle.codigoPais = 1 THEN
               v_detalle.ciudad           := substr(rg_gaemp.ciudad, 1, 100);
            ELSE
               v_detalle.ciudad           := NULL;
            END IF;
            v_detalle.telefono            := substr(rg_gaemp.telefono, 1, 20);
            v_detalle.celular             := substr(rg_gaemp.celular, 1, 20);
            v_detalle.email               := substr(rg_gaemp.mail, 1, 100);
            v_detalle.apellidoCasada      := substr(rg_gaemp.ape_casada, 1, 15);
            v_detalle.codigoPaisFatca     := rg_gaemp.cod_pai_fatca;
            v_detalle.nombrePaisFatca     := fue_obt_des_pais(v_detalle.codigoPaisFatca);
            v_detalle.direccionFiscal     := substr(rg_gaemp.dir_fiscal, 1, 80);
            v_detalle.codigoPaisFiscal    := rg_gaemp.cod_pai_fiscal;
            v_detalle.nombrePaisFiscal    := fue_obt_des_pais(v_detalle.codigoPaisFiscal);
            v_detalle.sueldo              := rg_gaemp.sueldo;
            v_detalle.profesion           := rg_gaemp.profesion;
            v_detalle.fechaIngreso        := paw_uti.fu_fec_char(rg_gaemp.fec_ingreso, 1);
            v_detalle.tipoContrato        := rg_gaemp.tip_contrato;
            v_detalle.nombreSucursal      := substr(rg_gaemp.direc_kit, 1, 100);
            v_detalle.estado              := rg_gaemp.estado;
            v_detalle.sobregiro           := rg_gaemp.sobregiro;
            v_detalle.codigoError         := 0;
            v_detalle.error               := NULL;

            IF v_detalle.codigoPaisFatca IS NULL THEN
               v_detalle.nombrePaisFatca := NULL;
            END IF;

            IF v_detalle.codigoPaisFiscal IS NULL THEN
               v_detalle.nombrePaisFiscal := NULL;
            END IF;

            IF v_detalle.codigoProfesion IS NULL THEN
               v_detalle.profesion := NULL;
            END IF;

            IF v_detalle.numeroDocumento IS NULL THEN
               v_detalle.codigoError := 1;
               v_detalle.error := 'Numero documento requerido. ';
            END IF;
            IF paw_uti.fu_validarTipoDocumento(v_detalle.tipoDocumento) IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 2;
               v_detalle.error := v_detalle.error || 'Tipo de documento invalido. ';
            END IF;
            -- validamos los valores requeridos
            -- validacion genero
            IF paw_uti.fu_obtenerCodigoReferencia('COD_SEXO', nvl(v_detalle.sexo, 'xx')) IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 4;
               v_detalle.error := v_detalle.error || 'Favor especificar el Sexo de la persona. ';
            END IF;
            -- validacion estado civil
            IF paw_uti.fu_obtenerCodigoReferencia('COD_EST_CIVIL', nvl(v_detalle.estadoCivil, 'xx')) IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 8;
               v_detalle.error := v_detalle.error || 'Favor especificar el Estado civil de la persona. ';
            END IF;
            -- validacion fecha nacimiento
            IF v_detalle.fechaNacimiento IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 16;
               v_detalle.error := v_detalle.error || 'Fecha Nacimiento requerido. ';
            ELSE
               SELECT ceil(months_between(sysdate, paw_uti.fu_str_fecha(v_detalle.fechaNacimiento, 1))/12)
                 INTO v_meses
                 FROM dual;

               IF v_meses < 18 THEN
                  v_detalle.codigoError := v_detalle.codigoError + 16;
                  v_detalle.error := v_detalle.error || 'Menor de edad. ';
               END IF;
            END IF;
            -- validacion nombres y apellido
            IF TRIM(v_detalle.nombre) IS NULL OR v_detalle.primerApellido IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 32;
               v_detalle.error := v_detalle.error || 'Favor especificar un nombre y/o apellido. ';
            END IF;
            -- validacion pais documento
            IF fue_obt_cod_pais(nvl(v_detalle.nombrePaisDocumento, 'x')) IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 64;
               v_detalle.error := v_detalle.error || 'Favor especificar pais del documento. ';
            END IF;
            -- validacion pais
            IF v_detalle.codigoPais IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 128;
               v_detalle.error := v_detalle.error || 'Favor especificar pais de nacimiento. ';
            END IF;
            -- validacion direccion
            IF TRIM(v_detalle.direccion) IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 256;
               v_detalle.error := v_detalle.error || 'Favor especificar la direccion. ';
            END IF;
            -- validacion ciudad
            IF v_detalle.codigoPais = 1 THEN
               BEGIN
                  SELECT 'S'
                  INTO v_existe
                  FROM ba_ciudades c
                  WHERE c.cod_pais = v_detalle.codigoPais
                     AND UPPER(c.descripcion) = UPPER(nvl(v_detalle.ciudad, 'x'))
                     AND rownum=1;
               EXCEPTION
                  WHEN OTHERS THEN
                     v_detalle.codigoError := v_detalle.codigoError + 512;
                     v_detalle.error := v_detalle.error || 'Ciudad invalida. ';
               END;
            END IF;

            -- validacion fatca
            IF v_detalle.codigoPaisFatca IS NOT NULL OR
               v_detalle.direccionFiscal IS NOT NULL OR
               v_detalle.codigoPaisFiscal IS NOT NULL THEN
               IF  v_detalle.codigoPaisFatca IS NULL OR
                   v_detalle.direccionFiscal IS NULL OR
                   v_detalle.codigoPaisFiscal IS NULL THEN
                   v_detalle.codigoError := v_detalle.codigoError + 1024;
                   v_detalle.error := v_detalle.error || 'Favor especificar segunda nacionalidad, direccion y pais fiscal. ';
               END IF;
            END IF;
            -- validacion telefonos
            IF v_detalle.telefono IS NULL AND v_detalle.celular IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 2048; -- error linea baja
               v_detalle.codigoError := v_detalle.codigoError + 524288; -- error celular
               v_detalle.error := v_detalle.error || 'Favor especificar un numero de contacto. ';
            ELSE
               IF paw_uti.fu_val_telefono( nvl(v_detalle.telefono, '12345') ) = 'N' THEN
                  -- no se puede especificar celular en el campo telefono
                  v_detalle.codigoError := v_detalle.codigoError + 2048;
                  v_detalle.error := v_detalle.error || 'Numero de telefono invalido. ';
               END IF;

               IF paw_uti.fu_val_celular( nvl(v_detalle.celular, '0971555555') ) = 'N' THEN
                  -- especificar celular con prefijo
                  v_detalle.codigoError := v_detalle.codigoError + 524288;
                  v_detalle.error := v_detalle.error || 'Numero de celular invalido. ';
               END IF;
            END IF;
            -- validacion profesion
            IF v_detalle.codigoProfesion IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 4096;
               v_detalle.error := v_detalle.error || 'Favor especificar una profesion. ';
            END IF;
            -- validacion sucursal
            BEGIN
               SELECT 'S'
                 INTO v_existe
                 FROM ba_oficinas c
                WHERE c.cod_pais = 1
                  AND UPPER(c.descripcion) = UPPER(nvl(v_detalle.nombreSucursal, 'x'))
                  AND rownum=1;
            EXCEPTION
               WHEN OTHERS THEN
                  v_detalle.codigoError := v_detalle.codigoError + 8192;
                  v_detalle.nombreSucursal := NULL;
                  v_detalle.error := v_detalle.error || 'Favor especificar la sucursal de retiro. ';
            END;
            -- validacion sueldo
            IF v_detalle.sueldo = 0 THEN
               v_detalle.codigoError := v_detalle.codigoError + 16384;
               v_detalle.error := substr(v_detalle.error || 'Favor especificar el sueldo. ', 1, 1000);
            END IF;
            -- validacion fecha ingreso
            IF v_detalle.fechaIngreso IS NULL THEN
               v_detalle.codigoError := v_detalle.codigoError + 32768;
               v_detalle.error := substr(v_detalle.error || 'Fecha de ingreso requerido. ', 1, 1000);
            ELSE
               IF paw_uti.fu_str_fecha(v_detalle.fechaIngreso, 1) > trunc(sysdate)+30 THEN
                  v_detalle.codigoError := v_detalle.codigoError + 32768;
                  v_detalle.error := substr(v_detalle.error || 'Fecha de ingreso debe ser menor a ' || to_char(trunc(sysdate)+30, 'dd/mm/yyyy')  , 1, 1000);
               ELSIF v_detalle.fechaNacimiento IS NOT NULL THEN
                  IF paw_uti.fu_str_fecha(v_detalle.fechaIngreso, 1) <= paw_uti.fu_str_fecha(v_detalle.fechaNacimiento, 1) THEN
                     v_detalle.codigoError := v_detalle.codigoError + 32768;
                     v_detalle.error := substr(v_detalle.error || 'Fecha de ingreso no puede ser mayor a fecha nacimiento. ', 1, 1000);
                  END IF;
               END IF;
            END IF;
            -- se valida fecha de vencimiento valido
            IF v_detalle.fechaVencDocumento IS NOT NULL THEN
               v_existe := 'N';
               BEGIN
                  IF paw_uti.fu_str_fecha(v_detalle.fechaVencDocumento, 1) < TRUNC(SYSDATE) THEN
                     v_existe := 'S';
                  END IF;
               EXCEPTION
                  WHEN OTHERS THEN
                     v_existe := 'S';
               END;
               IF v_existe = 'S' THEN
                  v_detalle.codigoError := v_detalle.codigoError + 65536;
                  v_detalle.error := substr(v_detalle.error || 'Favor vencimiento documento invalido. ', 1, 1000);
               END IF;
            END IF;

            v_can_duplicado := 0;
            FOR j in 1..v_lis_detalle.count LOOP
               IF v_lis_detalle(j).numeroDocumento = v_detalle.numeroDocumento AND
                  v_lis_detalle(j).tipoDocumento = v_detalle.tipoDocumento THEN
                  v_can_duplicado := v_can_duplicado + 1;
                  EXIT;
               END IF;
            END LOOP;
            -- control de dato duplicado
            SELECT nvl(COUNT(0), 0) + v_can_duplicado
              INTO v_can_duplicado
              FROM ge_pag_sue_emp_tmp t
             WHERE t.cod_empresa = v_cod_ente
               AND t.nro_cedula = v_detalle.numeroDocumento
               AND t.tip_documento = v_detalle.tipoDocumento
               AND t.nro_lote <> v_nro_lote
               AND trunc(t.fec_insercion) = trunc(SYSDATE);


            IF v_can_duplicado > 0 THEN
               v_detalle.codigoError := v_detalle.codigoError + 131072;
               v_detalle.error := substr(v_detalle.error || 'Registro duplicado. ', 1, 1000);
            END IF;

            IF nvl(v_detalle.tipoContrato, 'x') NOT IN ('I','T') THEN
               v_detalle.codigoError := v_detalle.codigoError + 262144;
               v_detalle.error := substr(v_detalle.error || 'Tipo de contrato invalido. ', 1, 1000);
            END IF;

            IF v_detalle.codigoError <> 0 AND v_retorno.error = 'N' THEN
               pr_mensajeUsuario('PRO_ERR_DATOS', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;

            v_lis_detalle.extend;
            v_lis_detalle(v_lis_detalle.count) := v_detalle;
            v_can_registros := v_can_registros + 1;
            IF v_detalle.codigoError <> 0 THEN
               v_can_errores := v_can_errores + 1;
            END IF;
            -- sanitizacion de parametros
            IF v_retorno.error = 'N' THEN
               IF p_modo = 'C' THEN
                  v_lugar := 'insertando el temporal ' || i;
                  -- insertamos el temporal
                  INSERT INTO ge_pag_sue_emp_tmp VALUES rg_gaemp;
               END IF;
            END IF;
            -- tag final
            <<end_alta>> NULL;
         END LOOP;
      END IF;
      v_error := MSG_ERROR;
      v_msj_bitacora := v_msj_bitacora || ', tot_pro: ' || v_can_registros || ', tot_err: ' || v_can_errores;
      IF v_retorno.error = 'N' AND nvl(p_modo,  'x') <> 'A' THEN
         BEGIN
            SELECT 'S'
              INTO v_existe
              FROM bw_mov_pendientes p
             WHERE p.cod_per_principal = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
               AND p.cod_tip_mensaje = v_cod_operacion
               AND p.cantidad = p_cantidad
               AND p.estado <> 'E'
               AND ((SYSDATE) - fec_insercion) * 1440 <= v_min_transaccion
               AND rownum = 1;
            paw_uti.pr_mensajeUsuario('G_CODPEDDUPLICA', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         EXCEPTION
            WHEN OTHERS THEN
               NULL;
         END;
      END IF;
      -- verificacion de limites
      IF v_retorno.error = 'N' AND p_modo <> 'A' THEN
         v_resLimite := fu_obtenerLimite (v_usu_sesion,
                                          v_cod_operacion,
                                          nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona),
                                          v_nro_cta_debito,
                                          v_cod_moneda,
                                          503,
                                          303,
                                          1,
                                          p_modo);

         IF v_resLimite.error = 'S' THEN
            v_retorno.error := v_resLimite.error;
            v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
         END IF;

         IF  v_retorno.nombreRespuesta = 'G_COD_TOK_INEXI' THEN
            pr_mensajeUsuario('G_COD_TOK_IN_PJ', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END IF;
         v_msj_bitacora := v_msj_bitacora || ', resLim: ' || v_resLimite.codRespuesta;
         v_retorno.respuestaLimite := v_resLimite.codRespuesta;
      END IF;
      -- control de claves segun limites
      IF v_retorno.error = 'N' THEN
         v_msj_respuesta.error := 'N';
         IF p_modo = 'C' THEN -- modo A se controla en fu_autorizarOperacion
            IF v_resLimite.codRespuesta IN ('10', '11') THEN
               -- clave transaccional requerida
               v_msj_respuesta := lf_obt_cla_validar(p_claveTransaccional, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, 'T');
            END IF;

            IF v_msj_respuesta.error = 'N' THEN
               IF v_resLimite.codRespuesta IN ('01', '11') THEN
                  -- token requerido
                  v_msj_respuesta := paw_seg.fu_obt_tok_validar(p_claveToken, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, p_modo);
               END IF;
            END IF;

            IF v_msj_respuesta.error = 'S' THEN
               v_retorno.error                := v_msj_respuesta.error;
               v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
            END IF;
         END IF;
      END IF;
      IF v_retorno.error = 'N' THEN
         IF p_modo = 'C' THEN
            --- inserto el movimiento pendiente de autorizacion
            SELECT s_nro_documento.NEXTVAL
              INTO v_nro_documento
              FROM dual;
            INSERT INTO bw_mov_pendientes
               (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje,
                descripcion, cantidad, etiqueta, dato, estado, nro_cuenta, cod_moneda,
                can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, referencia, etiqueta2, dato2)
            VALUES
               (v_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), SYSDATE, v_cod_operacion,
                fue_obt_des_operacion(v_cod_operacion), v_can_registros, 'Ente', v_cod_ente, 'P', v_nro_cta_debito, v_cod_moneda,
                v_can_aut_requeridas, v_can_aut_requeridas, v_usu_sesion.codigoPersona, v_nro_lote, 'Dir_Correo', v_not_dir_correo);
            v_retorno.numeroDocumento := v_nro_documento;
            v_retorno.cantidadAutorizadores := v_can_aut_requeridas;
         ELSIF p_modo = 'A' THEN
            v_msj_bitacora := v_msj_bitacora || ', nro_docc:' || p_numeroDocumento;
            BEGIN
               SELECT p.referencia
                 INTO v_nro_lote
                 FROM bw_mov_pendientes p
                WHERE p.nro_documento = p_numeroDocumento
                  AND p.cod_per_principal = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
                  AND p.cod_tip_mensaje = v_cod_operacion
                  AND trunc(fec_insercion) = trunc(SYSDATE);
               -- setea el estado a confirmado para proceso ITGF
               UPDATE ge_pag_sue_emp_tmp t
                  SET t.estado = 'C'
                WHERE t.cod_empresa = v_cod_ente
                  AND t.nro_lote = v_nro_lote
                  AND t.estado = 'P'
                  AND trunc(t.fec_insercion) = trunc(SYSDATE);
               IF SQL%ROWCOUNT = 0 THEN
                  pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  v_msj_bitacora := v_msj_bitacora || ', (update temp)';
               END IF;
            EXCEPTION
               WHEN OTHERS THEN
                  pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  v_msj_bitacora := substr(v_msj_bitacora || ', ORA-ERR: [' || SQLERRM || ']', 1, 800);
            END;
            IF v_retorno.error = 'N' THEN
               -- generamos el numero para comprobante
               SELECT s_nro_ope_homebanking.nextval
                 INTO v_nro_documento
                 FROM dual;
               -- insertamos la cabecera para proceso posterior ITGF
               INSERT INTO ge_alt_empleados
                  (cod_ente, nro_documento, nro_lote, cod_moneda, fec_recepcion,
                   cantidad, estado, not_mail, fec_insercion, usu_insercion,
                   fec_modificacion, usu_modificacion)
               VALUES
                  (v_cod_ente, p_numeroDocumento, v_nro_lote, p_codigoMoneda, v_fec_actual,
                   p_cantidad, 'P', v_not_dir_correo, sysdate, user, sysdate, user);
               v_retorno.numeroDocumento := v_nro_documento;
            END IF;
         END IF;
      END IF;
      v_retorno.emailNotificacion := v_not_dir_correo;
      v_retorno.codigoMoneda := v_cod_moneda;
      v_retorno.cantidadEmpleados := v_can_registros;
      v_retorno.listaEmpleados := v_lis_detalle;
      -- registro de bitacora
      IF v_retorno.error = 'N' THEN
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      ELSE
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END IF;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(v_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', en lugar [' || v_lugar || '], ' || SQLERRM || ' ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END fu_altaEmpleados;

   -- Historico de alta de funcionarios
   FUNCTION fu_altaEmpleadosHis(p_sesion             IN VARCHAR2,
                                p_codigoCanal        IN VARCHAR2,
                                p_fechaInicio        IN DATE DEFAULT NULL,
                                p_fechaFin           IN DATE DEFAULT NULL,
                                p_nombreDocumento    IN VARCHAR2 DEFAULT NULL,
                                p_numeroOperacion    IN NUMBER DEFAULT NULL,
                                p_numeroPagina       IN NUMBER DEFAULT NULL,
                                p_cantidadPagina     IN NUMBER DEFAULT NULL) RETURN typ_altaEmpleados IS
      v_detalle           typ_empleado := typ_empleado();
      v_lis_detalle       typ_listaempleados := typ_listaempleados();
      v_retorno           typ_altaEmpleados := typ_altaEmpleados();
      v_cod_operacion     VARCHAR2(3) := '130';
      v_fec_actual        DATE := pag_cal.fu_obt_fec_actual(9);
      v_usu_sesion        typ_validarsesion;
      v_msj_caja          typ_mensajeCaja;
      v_permiso           typ_obtenerPermisos;
      v_can_registros     NUMBER := 0;
      v_fec_inicio        DATE := nvl(p_fechaInicio, v_fec_actual - 60);
      v_fec_fin           DATE := nvl(p_fechaFin, v_fec_actual);
      v_nom_documento     VARCHAR2(60);
      v_msj_bitacora      VARCHAR2(800) := substr('fec_ini: ' ||p_fechaInicio||
                                                  ', fec_fin: '||p_fechaFin||
                                                  ', nro_ope: ' || p_numeroOperacion ||
                                                  ', nro_pag: ' || p_numeroPagina ||
                                                  ', can_pag: ' || p_cantidadPagina, 1, 800);
      -- cursor de historicos
      CURSOR c_historico IS -- DYDMR-6437 -- 05/2017 -- Se modifica el cursor
         SELECT a.nro_cedula, a.tip_documento, a.pri_nombre, a.seg_nombre, a.pri_apellido,
                a.nro_lote, fec_nacimiento,
                case
                  when ( ( nvl(a.error,'x') like '%Cliente%ya%posee%CTA%asignada%Empresa%'
                         or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Ente%'
                         or a.error like '%Cliente%ya%posee%CTA%para%Sub%Modalidad%' )
                       and ( nvl(a.error,'x') not like '%Cliente inhibido para CTA CTE. Se ha creado una CTA. AV.%' ) ) then
                    null
                  else
                    a.error
                end error,
                a.fec_vto_documento, a.doc_pais,
                a.seg_apellido, a.sexo, a.est_civil, a.direccion, a.ciudad, a.pais,
                a.telefono, a.celular, a.mail, a.ape_casada, a.cod_pai_fatca, a.dir_fiscal,
                a.cod_pai_fiscal, a.sueldo, a.profesion, a.fec_ingreso,
                a.tip_contrato, a.direc_kit,
                case
                  when ( ( nvl(a.error,'x') like '%Cliente%ya%posee%CTA%asignada%Empresa%'
                         or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Ente%'
                         or a.error like '%Cliente%ya%posee%CTA%para%Sub%Modalidad%' )
                       and ( nvl(a.error,'x') not like '%Cliente inhibido para CTA CTE. Se ha creado una CTA. AV.%' ) ) then
                    'N'
                  else
                    a.estado
                end estado,
                c.nro_documento as nro_operacion,
                trunc(c.fec_insercion) as fec_insercion, a.nro_cuenta, a.fec_insercion fec_proceso
           FROM ge_pag_sue_emp a
           inner join ge_alt_empleados c on c.cod_ente = a.cod_empresa and c.nro_lote = a.nro_lote
          WHERE a.cod_empresa IN
              (
              SELECT e.cod_ente
                FROM ge_entes e
               WHERE e.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
                 AND e.tipo = 'SU'
                 AND fug_obt_parentes(e.cod_ente, 'SER_ACTIVO') = 'S'
                 AND fug_obt_parentes(e.cod_ente, 'HAB_HOMEBANKING') = 'S'
              )
            AND trunc(a.fec_insercion) between v_fec_inicio AND v_fec_fin
            AND nvl(c.nro_documento, 0) = nvl(nvl(p_numeroOperacion, c.nro_documento), 0)
            AND nvl(a.error,'x') not like '%persona%mismo%Doc%Pri%Nom%Pri%Ape%'
            AND
              (
                 a.nro_cedula = nvl(v_nom_documento, a.nro_cedula) OR
                 UPPER(a.pri_nombre) LIKE nvl(UPPER(v_nom_documento), a.pri_nombre)||'%' OR
                 UPPER(a.pri_apellido) LIKE nvl(UPPER(v_nom_documento), a.pri_apellido)||'%'
              )
            AND a.fec_insercion = (select min(fec_insercion) from ge_pag_sue_emp p
                            where p.cod_empresa = a.cod_empresa
                              and p.nro_lote = a.nro_lote
                              and p.nro_cedula = a.nro_cedula
                              and p.tip_documento = a.tip_documento
                              and p.pri_nombre = a.pri_nombre
                          )
          UNION
         SELECT a.nro_cedula, a.tip_documento, a.pri_nombre, a.seg_nombre, a.pri_apellido,
                a.nro_lote, fec_nacimiento, a.error, a.fec_vto_documento, a.doc_pais,
                a.seg_apellido, a.sexo, a.est_civil, a.direccion, a.ciudad, a.pais,
                a.telefono, a.celular, a.mail, a.ape_casada, a.cod_pai_fatca, a.dir_fiscal,
                a.cod_pai_fiscal, a.sueldo, a.profesion, a.fec_ingreso,
                a.tip_contrato, a.direc_kit,
                case
                  when ( ( nvl(a.error,'x') like '%Cliente%ya%posee%CTA%asignada%Empresa%'
                             or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Ente%'
                             or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Sub%Modalidad%' )
                          and ( nvl(a.error,'x') not like '%Cliente inhibido para CTA CTE. Se ha creado una CTA. AV.%' ) ) then
                    'C'
                  else
                    a.estado
                end estado,
                c.nro_documento as nro_operacion,
                trunc(c.fec_insercion) as fec_insercion, null as nro_cuenta, null as fec_proceso
           FROM ge_pag_sue_emp_tmp a
           inner join ge_alt_empleados c on c.cod_ente = a.cod_empresa and c.nro_lote = a.nro_lote
          WHERE a.cod_empresa IN
              (
              SELECT e.cod_ente
                FROM ge_entes e
               WHERE e.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
                 AND e.tipo = 'SU'
                 AND fug_obt_parentes(e.cod_ente, 'SER_ACTIVO') = 'S'
                 AND fug_obt_parentes(e.cod_ente, 'HAB_HOMEBANKING') = 'S'
              )
            AND trunc(a.fec_insercion) between v_fec_inicio AND v_fec_fin
            AND nvl(c.nro_documento, 0) = nvl(nvl(p_numeroOperacion, c.nro_documento), 0)

            AND (a.estado = 'C' or (a.estado = 'R' and( ( nvl(a.error,'x') like '%Cliente%ya%posee%CTA%asignada%Empresa%'
                                                          or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Ente%'
                                                          or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Sub%Modalidad%' )
                                                         and (nvl(a.error,'x') not like '%Cliente inhibido para CTA CTE. Se ha creado una CTA. AV.%')) ) )
            AND nvl(a.error,'x') not like '%persona%mismo%Doc%Pri%Nom%Pri%Ape%'
            AND
              (
                 a.nro_cedula = nvl(v_nom_documento, a.nro_cedula) OR
                 UPPER(a.pri_nombre) LIKE nvl(UPPER(v_nom_documento), a.pri_nombre)||'%' OR
                 UPPER(a.pri_apellido) LIKE nvl(UPPER(v_nom_documento), a.pri_apellido)||'%'
              )
             AND a.fec_insercion = (select min(fec_insercion) from ge_pag_sue_emp_tmp p
                            where p.cod_empresa = a.cod_empresa
                              and p.nro_lote = a.nro_lote
                              and p.nro_cedula = a.nro_cedula
                              and p.tip_documento = a.tip_documento
                              and p.pri_nombre = a.pri_nombre
                          )
              order by nro_operacion desc;
   BEGIN
      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- 4. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      v_msj_bitacora := v_msj_bitacora||', perf: ' || v_usu_sesion.codigoPerfil;
      IF v_permiso.error = 'S' THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_nom_documento := depurarTextos(p_nombreDocumento, 80);
      v_msj_bitacora := v_msj_bitacora || ', nom_doc: '||v_nom_documento;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);

      -- se controla el rando de fechas
      IF v_fec_inicio - v_fec_fin > 60 THEN
         pr_mensajeUsuario('HIS_RAN_FEC_EXE', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      ELSIF v_fec_fin < v_fec_inicio THEN
         pr_mensajeUsuario('HIS_FEC_DES_MAY', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      END IF;
      IF v_retorno.error = 'S' THEN
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      FOR c IN c_historico LOOP
         IF p_cantidadPagina IS NOT NULL THEN
            IF v_can_registros > (p_cantidadPagina * p_numeroPagina) THEN
               EXIT;
            END IF;
         END IF;
         v_can_registros := v_can_registros + 1;
         -- para logica de paginacion
         IF v_can_registros > (nvl(p_cantidadPagina, 1) * (nvl(p_numeroPagina, 1) - 1)) THEN
            v_detalle.numeroDocumento := substr(c.nro_cedula, 1, 20);
            v_detalle.tipoDocumento   := substr(c.tip_documento, 1, 3);
            v_detalle.nombre          := substr(c.pri_nombre || ' ' || c.seg_nombre, 1, 60);
            v_detalle.primerApellido  := substr(c.pri_apellido, 1, 30);
            v_detalle.estado          := c.estado;
            v_detalle.numeroSolicitud := c.nro_operacion;
            v_detalle.fechaNacimiento := paw_uti.fu_fec_char(c.fec_nacimiento, 2);
            v_detalle.codigoError     := 0;
            v_detalle.error           := substr(c.error, 1, 1000);
            IF v_detalle.error IS NOT NULL THEN
               v_detalle.estado      := 'A';
               v_detalle.codigoError := -1;
            END IF;
            v_detalle.fechaVencDocumento  := paw_uti.fu_fec_char(c.fec_vto_documento, 2);
            v_detalle.nombrePaisDocumento := substr(c.doc_pais, 1, 60);
            v_detalle.codigoPaisDocumento := fue_obt_cod_pais(v_detalle.nombrePaisDocumento);
            v_detalle.segundoApellido     := substr(c.seg_apellido, 1, 30);
            v_detalle.sexo                := c.sexo;
            v_detalle.estadoCivil         := c.est_civil;
            v_detalle.direccion           := substr(c.direccion, 1, 100);
            v_detalle.ciudad              := substr(c.ciudad, 1, 100);
            v_detalle.codigoPais          := fue_obt_cod_pais(c.pais);
            v_detalle.pais                := substr(c.pais, 1, 40);
            v_detalle.telefono            := substr(c.telefono, 1, 20);
            v_detalle.celular             := substr(c.celular, 1, 20);
            v_detalle.email               := substr(c.mail, 1, 80);
            v_detalle.apellidoCasada      := substr(c.ape_casada, 1, 15);
            v_detalle.codigoPaisFatca     := c.cod_pai_fatca;
            v_detalle.nombrePaisFatca     := fue_obt_des_pais(v_detalle.codigoPaisFatca);
            v_detalle.direccionFiscal     := substr(c.dir_fiscal, 1, 80);
            v_detalle.codigoPaisFiscal    := c.cod_pai_fiscal;
            v_detalle.nombrePaisFiscal    := fue_obt_des_pais(v_detalle.codigoPaisFiscal);
            v_detalle.sueldo              := c.sueldo;
            v_detalle.codigoProfesion     := fue_obt_cod_profesion(c.profesion);
            v_detalle.profesion           := substr(c.profesion, 1, 35);
            v_detalle.fechaIngreso        := paw_uti.fu_fec_char(c.fec_ingreso, 2);
            v_detalle.tipoContrato        := c.tip_contrato;
            v_detalle.nombreSucursal      := substr(c.direc_kit, 1, 200);
            v_detalle.fechaRecepcion      := paw_uti.fu_fec_char(c.fec_insercion, 2);
            v_detalle.cuentaAsignada      := substr(c.nro_cuenta, 1, 20);
            if c.fec_proceso is not null then
               v_detalle.fechaProceso        := paw_uti.fu_fec_char(c.fec_proceso, 2);
            end if;
            v_lis_detalle.extend;
            v_lis_detalle(v_lis_detalle.count) := v_detalle;
         END IF;
      END LOOP;
      v_msj_bitacora := v_msj_bitacora || ', can_reg: ' || v_can_registros;
      v_retorno.cantidadEmpleados := v_lis_detalle.count;
      v_retorno.listaEmpleados := v_lis_detalle;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END fu_altaEmpleadosHis;

   PROCEDURE pr_act_mov_ope_cambios(p_hora                IN ge_movimientos.hora%TYPE,
                                   p_nro_documento       IN ge_movimientos.nro_documento%TYPE,
                                   p_cod_mon_debito      IN ge_movimientos.cod_moneda%TYPE,
                                   p_cod_mon_credito     IN ge_movimientos.cod_moneda%TYPE,
                                   p_usuario             IN VARCHAR2) IS

      v_ind_inc_hbank varchar2(1) := fug_obt_pardinamico ('IND_INC_HBANK');

   BEGIN
      IF v_ind_inc_hbank = 'S' and p_cod_mon_debito <> p_cod_mon_credito THEN
         IF ((p_cod_mon_debito <> v_cod_mon_local) AND
            (p_cod_mon_credito <> v_cod_mon_local)) THEN
            --llamar compra--
            PRL_PRO_OPE_CAM_SIPAP(p_hora, p_usuario, p_nro_documento,'C');
            --llamar venta--
            PRL_PRO_OPE_CAM_SIPAP(p_hora, p_usuario, p_nro_documento,'V');
         ELSE
            IF p_cod_mon_debito = v_cod_mon_local THEN
               --llamar venta--
               PRL_PRO_OPE_CAM_SIPAP(p_hora, p_usuario, p_nro_documento,'V');
            ELSE
               --llamar compra--
               PRL_PRO_OPE_CAM_SIPAP(p_hora, p_usuario, p_nro_documento,'C');
            END IF;
         END IF;
      END IF;

   END pr_act_mov_ope_cambios;

 FUNCTION fu_val_sol_seguro(p_cod_canal      IN VARCHAR2,
                            p_cod_persona    IN VARCHAR2,
                            p_mto_asegurado  IN NUMBER,
                            p_cod_tip_seguro IN NUMBER,
                            p_mto_cuota      IN NUMBER,
                            p_cod_seguro     IN NUMBER--TIPO SEGURO GE_TIP_SEGUROS CODIGO
                            ) RETURN TYP_MENSAJERESPUESTA IS
    v_count   NUMBER := 0;
    v_retorno typ_mensajeRespuesta := typ_mensajeRespuesta;
    MSG_SEG_INV_EDAD CONSTANT VARCHAR2(15) := 'SEG_INV_EDAD';
    MSG_SEG_INV_NOEX CONSTANT VARCHAR2(15) := 'SEG_INV_NOEX';
    MSG_OPE_NO_PERMITIDA CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
    v_edad     NUMBER := 0;
    v_edad_min NUMBER;
    v_edad_max NUMBER;
    --seguros de vida
    v_eda_max_vida number;
    v_eda_min_vida number;

 BEGIN
    pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
    SELECT COUNT(*)
      INTO v_count
      FROM ge_det_seguros d
     WHERE d.cod_tipo = p_cod_tip_seguro
       AND d.mto_asegurado = p_mto_asegurado
       AND d.mto_cuota = p_mto_cuota;
    IF v_count <= 0 THEN
       pr_mensajeUsuario(MSG_SEG_INV_NOEX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       RETURN v_retorno;
    END IF;
    --verificar rango de edades
    v_edad := fu_obt_edad(p_cod_persona);

    CASE p_cod_seguro
       WHEN 2 THEN
    v_edad_min := fug_obt_pardinamico('SEG_EDA_MIN_CON');
    v_edad_max := fug_obt_pardinamico('SEG_EDA_MAX_CON');
    IF NOT (v_edad >= v_edad_min AND v_edad <= v_edad_max) THEN
       pr_mensajeUsuario(MSG_SEG_INV_EDAD, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       RETURN v_retorno;
    END IF;

       WHEN 3 THEN

         v_eda_max_vida := fug_obt_pardinamico('SEG_VID_EDA_MAX');
         v_eda_min_vida := fug_obt_pardinamico('SEG_VID_EDA_MIN');

         IF NOT (v_edad >= v_eda_min_vida AND v_edad <= v_eda_max_vida) THEN
           pr_mensajeUsuario(MSG_SEG_INV_EDAD, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       RETURN v_retorno;
    END IF;

       ELSE
         pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

    END CASE;

    --retornar
       RETURN v_retorno;
 END;

   -- insercion de solicitud de extractos digitales
   FUNCTION fu_extractoDigital(p_sesion             IN VARCHAR2,
                               p_codigoCanal        IN VARCHAR2,
                               p_modo               IN VARCHAR2,
                               p_retencionCuentas   IN VARCHAR2,
                               p_retencionTarjetas  IN VARCHAR2,
                               p_numeroTarjeta      IN VARCHAR2) RETURN typ_datoscliente IS

      v_retorno             typ_datoscliente := typ_datoscliente;
      v_lis_retorno         typ_listaresumencuenta := typ_listaresumencuenta();
      v_det_retorno         typ_resumenCuenta := typ_resumenCuenta();
      v_usu_sesion          typ_validarSesion;
      v_msj_respuesta       typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_msj_caja            typ_mensajeCaja;
      v_permiso             typ_obtenerPermisos;
      v_cod_operacion       bw_tip_mensajes.cod_tip_mensaje%TYPE := '097';
      v_nro_tarjeta         ta_tarjetas.nro_tarjeta%TYPE;
      v_nro_cuenta          ge_cuentas.nro_cuenta%TYPE := NULL;
      v_modo                VARCHAR2(1) := substr(p_modo, 1, 1);
      v_msj_bitacora        VARCHAR2(800) := 'mod: '||v_modo;
      v_ret_cuentas         VARCHAR2(1) := substr(nvl(p_retencionCuentas, 'N'), 1, 1);
      v_ret_tarjetas        VARCHAR2(1) := substr(nvl(p_retencionTarjetas, 'N'), 1, 1);
      v_can_retencion       NUMBER := 0;
      v_can_registro        NUMBER := 0;
      v_imp_extracto        VARCHAR2(1);
      v_fec_actual          DATE := pag_cal.fu_obt_fec_actual(5);
      v_es_gourmet          VARCHAR2(1);
      MSG_DAT_INVALIDO      CONSTANT VARCHAR2(15) := 'G_DATO_INV';
      MSG_PED_DUPLICADO     CONSTANT VARCHAR2(15) := 'G_CODPEDDUPLICA';
      v_msj_not_bienvenida  ge_par_dinamicos.val_parametro%type;                -- 01/2017 --
      v_mot_ret_def         ge_par_dinamicos.val_parametro%type;                -- 01/2017 --
      v_ret                 NUMBER;

      CURSOR c_ext_cuentas(p_cod_modulo IN ba_modulos.cod_modulo%TYPE,
                           p_nro_cuenta IN ge_cuentas.nro_cuenta%TYPE DEFAULT NULL) IS
         SELECT a.nro_cuenta, a.cod_modalidad cod_modalidad, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) des_tip_cuenta,
                a.cod_moneda cod_moneda, a.denominacion nom_cuenta,
                a.cod_modulo, a.estado,b.relacion, paw_bce.fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta --decode(a.cod_modulo, 5, 'TJ', decode(a.cod_modalidad, 31, 'AH', 'CC')) Tipo_cta
           FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
          WHERE b.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
            AND b.relacion = 'P'
            AND a.nro_cuenta = b.nro_cuenta
            AND a.cod_modulo = c.cod_modulo
            AND a.cod_modalidad = c.cod_modalidad
            AND a.estado = c.estado
            AND (
                   (p_cod_modulo IN (3, 4) AND c.cod_modulo IN (3,4) AND b.cod_modalidad IN (31, 41, 334)) OR
                   (p_cod_modulo = 5 AND c.cod_modulo = 5)
                )
            AND a.nro_cuenta = nvl(p_nro_cuenta, a.nro_cuenta)
            AND c.activo = 'S' -- solo cuentas activas
            AND a.estado <> 'X' -- pendiente de verificacion
          ORDER BY decode(b.cod_modalidad, 31, 1, decode(b.cod_modulo, 5, 2, decode(b.cod_modalidad, 33, 4, 34, 4, 36, 4, decode(b.cod_modulo, 4, 3, 7))));
   BEGIN
      --valido la sesion del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion, 32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- validamos la caja
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- validamos los permisos
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- se verifica que tenga permiso para registrar
      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
         pr_mensajeUsuario('PER_OPE_INVALID', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      ELSE
         IF nvl(v_modo, 'x') = 'C' AND v_can_aut_requeridas = 0 THEN
            v_modo := 'A';
         END IF;
      END IF;

      -- depuracion
      v_nro_tarjeta  := depurarAlfanumerico(p_numeroTarjeta, 16);
      v_msj_bitacora := substr(v_msj_bitacora ||
                               ', tar: [' || substr(v_nro_tarjeta, -4) || ']'||
                               ', ret_cta: ' || v_ret_cuentas ||
                               ', ret_tar: ' || v_ret_tarjetas, 1, 800);

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '|| fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ENTRADA);

      -- validar y confirmar permitido
      IF nvl(v_modo, 'x') NOT IN ('V', 'C', 'A', 'D') THEN
         pr_mensajeUsuario(MSG_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'Modo invalido - ' || v_msj_bitacora || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- verifico si tiene un destino activo
      v_retorno.direccion := substr(paw_not.fu_obt_cli_des_activo(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)), 1, 200);
      IF v_modo = 'D' THEN
         -- consulta direccion, salimos
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
         RETURN v_retorno;
      END IF;
      -- validar parametros
      IF nvl(v_ret_tarjetas, 'x') NOT IN ('S', 'N') OR nvl(v_ret_cuentas, 'x') NOT IN ('S', 'N') THEN
         pr_mensajeUsuario(MSG_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'retencion - ' || v_msj_bitacora || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- al menos un producto se debe solicitar
      IF v_ret_tarjetas = 'N' AND v_ret_cuentas = 'N' THEN
         pr_mensajeUsuario(MSG_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'retencion NN- ' || v_msj_bitacora || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF v_nro_tarjeta IS NOT NULL THEN
         IF v_ret_tarjetas <> 'S' THEN
            -- cuenta solo configurable para tarjeta
            pr_mensajeUsuario('VAL_PENTRADA', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            v_msj_bitacora := v_msj_bitacora || ', mod <> 5';
         ELSE
            -- obtenemos la cuenta asociada al plastico
            v_nro_cuenta := pat_imp.fu_obt_nro_cuenta(v_nro_tarjeta);
            v_msj_bitacora := v_msj_bitacora || ', cta_tar: ' || v_nro_cuenta;
            -- validamos que la cuenta pertenezca al cliente
            IF lf_cta_valida(v_nro_cuenta, NULL, v_usu_sesion, v_msj_respuesta) = 'N' THEN
               pr_mensajeUsuario('G_NROCTAINVALID', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            ELSE
               -- validamos que la cuenta no retenga extracto
               IF pat_imp.fu_ret_extracto(v_nro_cuenta) = 'S' THEN
                  pr_mensajeUsuario(MSG_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
         END IF;

         IF v_retorno.error = 'S' THEN
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
      -- verificamos si se solicita por modulo de ahorro o cte
      v_imp_extracto := paw_uti.fu_imp_extracto(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona));
      IF v_ret_cuentas = 'S' THEN
         BEGIN
            IF v_imp_extracto = 'S' THEN
               -- si llega aqui es porque el cliente imprime sus extractos
               FOR cu IN c_ext_cuentas(3) LOOP
                  v_det_retorno.nroCuenta := substr(cu.nro_cuenta, 1, 17);
                  v_det_retorno.tipoCuenta := substr(cu.cod_tip_cuenta,1, 2);
                  v_det_retorno.descTipoCuenta := substr(cu.des_tip_cuenta, 1, 35);
                  v_det_retorno.denominacion   := substr(cu.nom_cuenta, 1, 70);
                  v_det_retorno.codMoneda      := substr(cu.cod_moneda, 1, 3);

                  v_lis_retorno.extend;
                  v_lis_retorno(v_lis_retorno.count) := v_det_retorno;
                  v_can_retencion := v_can_retencion + 1;
               END LOOP;
            END IF;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               NULL;
         END;
      END IF;

      -- verificamos si se solicita para todas sus tarjetas o una en particular
      IF v_ret_tarjetas = 'S' THEN
         FOR cu IN c_ext_cuentas(5, v_nro_cuenta) LOOP
            v_es_gourmet := paw_not.lf_es_gourmet(cu.cod_modalidad);
            IF pat_imp.FU_RET_EXTRACTO(cu.nro_cuenta) = 'N' AND v_es_gourmet = 'N' THEN
               v_nro_tarjeta                := substr(paw_bce.fu_obt_nro_tarjeta(cu.nro_cuenta, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa), 1, 16);
               v_det_retorno.nroCuenta      := '*'||substr(v_nro_tarjeta, length(v_nro_tarjeta) - 3);
               v_det_retorno.tipoCuenta     := substr(cu.cod_tip_cuenta,1, 2);
               v_det_retorno.descTipoCuenta := substr(cu.des_tip_cuenta, 1, 35);
               v_det_retorno.denominacion   := substr(cu.nom_cuenta, 1, 70);
               v_det_retorno.codMoneda      := substr(cu.cod_moneda, 1, 3);
               v_det_retorno.saldoActual    := NULL;
               v_det_retorno.relacion       := NULL;

               v_lis_retorno.extend;
               v_lis_retorno(v_lis_retorno.count) := v_det_retorno;
               v_can_retencion := v_can_retencion + 1;
            END IF;
         END LOOP;
      END IF;
      v_msj_bitacora := v_msj_bitacora || ', can_ret:' || v_can_retencion;
      -- verificamos si existe alguna cuenta que retenga extracto
      IF v_can_retencion = 0 AND (v_imp_extracto <> 'S' OR v_nro_cuenta IS NOT NULL) THEN
         pr_mensajeUsuario(MSG_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_retorno.listaCuentas := v_lis_retorno;
      -- si es confirmacion, procesar el pedido
      IF v_modo = 'A' THEN
         -- se cambia el tipo de extracto del cliente
         IF v_ret_cuentas = 'S' THEN
            UPDATE ge_clientes c
               SET c.tip_extracto = decode(c.tip_extracto, 'C', 'N', -- de impreso a no impreso
                                                           'X', 'Z', -- de mail e impreso a mail
                                                           c.tip_extracto ) -- sino, no se modifica
             WHERE c.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
               AND c.tip_extracto IN ('C', 'X');
            v_can_registro := sql%rowcount;
            v_msj_bitacora := v_msj_bitacora || ', upd_cli: ' || v_can_registro;
         END IF;
         -- para solicitar cuentas de TC
         IF v_ret_tarjetas = 'S' THEN
            FOR ta IN c_ext_cuentas(5, v_nro_cuenta) LOOP
               BEGIN
                  IF pat_imp.FU_RET_EXTRACTO(ta.nro_cuenta) = 'N' THEN
                     v_mot_ret_def := nvl(fug_obt_pardinamico('MOT_RET_SOL_CLIENTE'),5);  -- 01/2017 --
                     -- se solicita la retencion
                     -- 01/2017
                     UPDATE ta_cta_tarjetas_nov
                        SET ret_extracto = 'S',
                            mot_ret_extracto = v_mot_ret_def
                      WHERE nro_cuenta = ta.nro_cuenta
                        AND fecha = v_fec_actual;
                     IF SQL%NOTFOUND THEN
                         INSERT INTO ta_cta_tarjetas_nov
                           (nro_cuenta, fecha, ret_extracto, mot_ret_extracto)
                         VALUES
                           (ta.nro_cuenta, v_fec_actual, 'S', v_mot_ret_def);
                     END IF;
                     --
                     UPDATE ge_cta_dat_adicionales
                        SET val_parametro = 'S'
                      WHERE nro_cuenta = ta.nro_cuenta
                        AND parametro = 'RET_EXTRACTO';
                     IF SQL%NOTFOUND THEN
                        INSERT INTO ge_cta_dat_adicionales
                          (nro_cuenta, parametro, val_parametro)
                        VALUES
                          (ta.nro_cuenta, 'RET_EXTRACTO','S');
                     END IF;
                     --
                     UPDATE ge_cta_dat_adicionales
                        SET val_parametro = v_mot_ret_def
                      WHERE nro_cuenta = ta.nro_cuenta
                        AND parametro = 'MOT_RET_EXTRACTO';
                     IF SQL%NOTFOUND THEN
                        INSERT INTO ge_cta_dat_adicionales
                          (nro_cuenta,parametro,val_parametro)
                        VALUES
                          (ta.nro_cuenta,'MOT_RET_EXTRACTO',v_mot_ret_def);
                     END IF;
                     --
                     v_can_registro := nvl(v_can_registro,0) + 1;
                  END IF;
               EXCEPTION
                  WHEN DUP_VAL_ON_INDEX THEN
                     pr_mensajeUsuario(MSG_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                     RETURN v_retorno;
               END;

            END LOOP;
         END IF;
         v_msj_bitacora := v_msj_bitacora || ', can_tar: ' || v_can_registro;
         -- validamos si hubo insercion
         IF v_can_registro = 0 THEN
            pr_mensajeUsuario(MSG_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
            RETURN v_retorno;
         ELSE
            -- si no tiene servicio de notificacion, se le adhiere de forma compulsiva
            IF paw_not.fu_obt_suscripcion(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)) = 'N' OR v_retorno.direccion IS NULL THEN
               v_ret := paw_not.fu_alt_notificacion(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), v_retorno.direccion);
               v_msj_bitacora := substr(v_msj_bitacora || ', fu_alt_notificacion: ' || v_ret, 1, 800);
            END IF;

            INSERT INTO GE_REG_TIP_EXTRACTO
               (fecha, canal, tip_novedad, cod_usuario, ret_cuenta, ret_tarjeta, nro_cuenta, cod_persona, motivo)
            VALUES
               (v_fec_actual, 'WEB', 'A', v_msj_caja.codigoUsuario, v_ret_cuentas, v_ret_tarjetas, v_nro_cuenta, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), 5);

            -- bienvenida al servicio de extractos digitales
            v_retorno.email := substr(fug_obt_dir_mail_per( nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona) ), 1, 80);
            IF v_retorno.email IS NOT NULL THEN
               v_msj_not_bienvenida := nvl(fug_obt_pardinamico('EXT_MSG_MAIL_BIENVENIDA'),'Estimado usuario, ' || fug_obt_pardinamico('NOM_BANCO') || ' le da la bienvenida al servicio de Extracto Clic');  -- 01/2017 --
               v_can_registro := paw_not.fu_env_email_prueba(v_retorno.email,
                                                             utl_url.escape(v_msj_not_bienvenida, TRUE, 'UTF-8'),
                                                             'PAW_BEL');
               v_msj_bitacora := v_msj_bitacora || ', ret_mail: ' || v_can_registro;
            END IF;
         END IF;
      END IF;

      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);

      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
   END;
   FUNCTION fu_pagoBancardWs(p_sesion             IN VARCHAR2,
                             p_codigoCanal        IN VARCHAR2,
                             p_modo               IN VARCHAR2,
                             p_cuentaDebito       IN VARCHAR2,
                             p_numeroIp           IN VARCHAR2,
                             p_sesionServicios    IN VARCHAR2,
                             p_numeroTransaccion  VARCHAR2,
                             p_servicio           IN VARCHAR2,
                             p_terminal           VARCHAR2,
                             p_moneda             NUMBER,
                             p_monto              NUMBER,
                             p_importeComision    NUMBER,
                             p_claveTransaccional IN VARCHAR2,
                             p_claveToken         IN VARCHAR2,
                             p_tokenServicios     IN VARCHAR2,
                             p_proveedor          IN NUMBER,
                             p_extra              IN VARCHAR2) RETURN typ_pagoserviciosws IS
     -- Datos Recibidos del HB
     v_nro_cta_debito VARCHAR2(16); -- nro de cuenta de debito
     v_monto          NUMBER(18, 2); -- monto a transferir
     v_modo           VARCHAR2(1); -- modo V-validacion o C-confirmacion
     v_lugar          VARCHAR2(100);
     -- Variables
     v_cta_for_debito  VARCHAR2(17); -- Cuenta Debito formateada
     v_cod_mon_debito  ge_cuentas.cod_moneda%TYPE; -- Moneda de la cuenta
     v_cod_mod_debito  ge_cuentas.cod_modulo%TYPE; -- Modulo de la cuenta
     v_cod_mad_debito  ge_cuentas.cod_modalidad%TYPE; -- Modalidad de la cuenta
     v_cod_ofi_debito  ge_cuentas.cod_oficina%TYPE; -- Oficina de la cuenta
     v_nom_cta_debito  ge_cuentas.denominacion%TYPE; -- Nombre de la cuenta
     v_nro_cta_credito ge_cuentas.nro_cuenta%TYPE := NULL; -- Numero de Cuenta Credito
     v_codCanal        NUMBER;
     v_terminal        VARCHAR2(15);
     v_sesion          VARCHAR2(32);
     v_sesionServicios VARCHAR2(32);
     v_cod_tra_padre   ge_cob_ser_parametros.cod_transaccion%TYPE := 490;
     v_nro_documento   NUMBER(15);
     v_xml             xmltype;
     v_retorno         typ_pagoserviciosws := typ_pagoserviciosws();
     v_res_limite      typ_respuestaLimite;
     v_cod_operacion   VARCHAR2(3) := '035';
     v_usuario         typ_validarSesion;
     v_error           typ_mensajeRespuesta := typ_mensajeRespuesta;
     v_men_caja        typ_mensajeCaja;
     v_permiso         typ_obtenerPermisos;
     v_horario         VARCHAR2(1);
     v_es_mov_noc      VARCHAR2(1);
     v_es_cta_noc      VARCHAR2(1);
     v_fec_actual      DATE;
     v_hor_actual      VARCHAR2(8) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
     v_msj_bitacora    VARCHAR2(800);
     v_nro_transaccion bw_pag_servicios.nro_transaccion%TYPE;
     v_mail            ba_mails.dir_correo%type;
     v_nro_lote        bw_pag_servicios.nro_lote%type;
     v_comision        NUMBER;
     v_resp_mail       NUMBER;
     v_ref_pago        bw_pag_servicios.ref_pago%type;
     v_concepto        bw_pag_cod_servicios.descripcion%type;
     rg_bpser          bw_pag_servicios%ROWTYPE;
     v_claveSesion      VARCHAR(32);
     MSG_CTA_NO_CORRESP   CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND'; --Nro. de Cuenta no corresponde al cliente
     SER_PER_SIN_AUT      CONSTANT VARCHAR2(15) := 'SER_PER_SIN_AUT';
     MSG_CTA_CONJUNTA     CONSTANT VARCHAR2(15) := 'CTA_CONJUNTA';
     MSG_MON_INVALIDA     CONSTANT VARCHAR2(15) := 'MON_DEB_INVALID';
     MSG_OPE_NO_PERM      CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
     MOV_DUP_SERVICIO     CONSTANT VARCHAR2(15) := 'MOV_DUP_SERV';
     MSG_INS_MOV_ER       CONSTANT VARCHAR2(15) := 'INS_MOV_ER';
     MSG_DAT_INVALIDO     CONSTANT VARCHAR2(15) := 'G_DATO_INV';
     FUNCTION lf_notificacion(p_servicio        IN VARCHAR2,
                              p_monto           IN NUMBER,
                              p_comision        IN NUMBER,
                              p_ref_pago        IN VARCHAR2,
                              p_nro_cta_debito  IN VARCHAR2,
                              p_nro_operacion   IN VARCHAR2,
                              p_mail            IN VARCHAR2) RETURN NUMBER IS
       v_cabecera   VARCHAR2(700)  := NULL;
       v_detalle    VARCHAR2(3300) := NULL;
       v_pie        VARCHAR2(500)  := NULL;
       v_db_name    VARCHAR2(20);
       v_tag        VARCHAR2(50);
       v_dir_correo ba_mails.dir_correo%TYPE;
       v_number     NUMBER;
       v_descripcion bw_pag_cod_servicios.descripcion%type;
       v_nombre     ba_personas.nom_completo%TYPE;
     BEGIN
        -- obtenemos el nombre de la base para control
        SELECT upper(sys_context('USERENV', 'DB_NAME'))
          INTO v_db_name
          FROM dual;
        -- se reemplaza la dirección de correo por la recibida para el envío al no cliente
        IF p_mail IS NOT NULL THEN
           v_dir_correo := p_mail;
        ELSE
           -- obtenemos la direccion de correo de la cuenta debito
           v_dir_correo := paw_seg.fu_obt_mail(fug_obt_cli_principal(p_nro_cta_debito));
           -- controlamos el envio de correo
           IF fug_ind_produccion = 'N' THEN
              v_dir_correo := fug_obt_pardinamico('TST_NOT_MAIL');
           END IF;
        END IF;
        -- obtenemos el nombre del principal de la cuenta para mostrar al beneficiario
        v_nombre := fue_obt_nom_persona(fug_obt_cli_principal(p_nro_cta_debito));
        -- obtenemos el tipo de operación realizada
        BEGIN
           SELECT descripcion
             INTO v_descripcion
             FROM bw_pag_cod_servicios
            WHERE cod_servicio = p_servicio
              AND cod_proveedor = p_proveedor;
        EXCEPTION
           WHEN NO_DATA_FOUND THEN
              v_descripcion := 'BILLETERA ZIMPLE';
           WHEN OTHERS THEN
              v_descripcion := 'BILLETERA ZIMPLE';
        END;
        -- ---------- cabecera --------------
        v_cabecera :=
              -- inicio div
              paw_pro.fu_not_inicio ||
              -- titulo
              paw_pro.fu_not_titulo(UTL_URL.ESCAPE('OPERACIÓN BILLETERA ZIMPLE', TRUE, 'UTF-8'));
        -- subtitulo
        v_cabecera := v_cabecera ||
        paw_pro.fu_not_titulo2('REALIZADA');
        v_cabecera := v_cabecera ||
              -- inicio tabla
              paw_pro.fu_not_ini_tabla ||
              -- inicio tbody
              paw_pro.fu_not_ini_tab_cuerpo;
        -- ---------- pie --------------
        -- fin tabla, fin div
        v_pie :=
              -- fin tbody
              paw_pro.fu_not_fin_tab_cuerpo ||
              -- fin table
              paw_pro.fu_not_fin_tabla;
        -- detalles
        v_detalle :=              paw_pro.fu_not_row_tag('Fecha '||v_tag, to_char(sysdate, 'dd/mm/yyyy'));
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('Hora '||v_tag, to_char(sysdate, 'hh24:mi:ss'));
        v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Número de Operación', TRUE, 'UTF-8'), p_nro_operacion);
        v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Tipo de Operación', TRUE, 'UTF-8'), v_descripcion);
        IF p_mail IS NULL THEN -- al beneficiario no se le muestra la cuenta debito
           v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Cuenta de Débito', TRUE, 'UTF-8'), p_nro_cta_debito);
        ELSE -- al beneficiario se le muestra el nombre del ordenante
           v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Ordenante', TRUE, 'UTF-8'), v_nombre);
        END IF;
        v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Número de Teléfono', TRUE, 'UTF-8'), p_ref_pago);
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('Monto', to_char(p_monto - nvl(p_comision, 0), '999G999G999G999G999'));
        IF p_mail IS NULL AND nvl(p_comision, 0) > 0 THEN -- se le muestra solo al ordenante
           v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Comisión IVA Incluído', TRUE, 'UTF-8'), to_char(p_comision, '999G999G999G999G999'));
        END IF;
        -- fin div
        v_pie := v_pie || paw_pro.fu_not_fin;
        v_number := paw_not.fu_env_email_prueba(v_dir_correo, v_cabecera || v_detalle || v_pie, 'paw_bel');
        RETURN v_number;
     EXCEPTION
        WHEN OTHERS THEN
           RETURN -99;
     END;
   /** FUNCIÓN PRINCIPAL */
   BEGIN
     -- valido la sesión del cliente
     v_usuario := fu_validarSesion(p_sesion, p_codigoCanal);
     IF v_usuario.error = 'S' THEN
       v_retorno.error                := v_usuario.error;
       v_retorno.nombreRespuesta      := v_usuario.nombreRespuesta;
       v_retorno.descripcionRespuesta := v_usuario.descripcionRespuesta;
       RETURN v_retorno;
     END IF;
     -- valido la caja
     v_men_caja := lf_val_caja(v_usuario);
     IF v_men_caja.error = 'S' THEN
       v_retorno.error                := v_men_caja.error;
       v_retorno.nombreRespuesta      := v_men_caja.nombreRespuesta;
       v_retorno.descripcionRespuesta := v_men_caja.descripcionRespuesta;
       RETURN v_retorno;
     END IF;
     v_modo            := substr(p_modo, 0, 1);
     v_monto           := depurarNumerico(p_monto, 21);
     v_codCanal        := depurarNumerico(p_codigoCanal, 3);
     v_nro_cta_debito  := depurarAlfanumerico(p_cuentaDebito, CUENTA_TAMANO);
     v_hor_actual      := to_char(sysdate, 'HH24:MI:SS');
     v_fec_actual      := pae_cnf.FU_OBT_FEC_ACTUAL(9);
     -- DDSI-265 -- 02/2018 : Se busca una hora disponible
     v_hor_actual := fug_obt_hor_disponible(v_fec_actual, v_hor_actual, user, v_es_mov_noc);
     v_terminal        := depurarAlfanumerico(p_terminal, 20);
     v_sesion          := depurarAlfanumerico(p_sesion, 32);
     v_sesionServicios := depurarAlfanumerico(p_sesionServicios, 32);
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     --mensaje con parametros
     v_msj_bitacora := substr('modo:' || v_modo || ', mto:' || v_monto || ', cta:' || v_nro_cta_debito || ', fecha:' || v_fec_actual || ', hora:' || v_hor_actual ||
                           ', term:' || v_terminal || ', mon:' || p_moneda || ', serv:' || p_servicio || ', tokSer:' ||
                           p_tokenServicios || ', provr: ' || p_proveedor || ', sesServ: ' || v_sesionServicios, 1, 600);
     v_permiso := lf_obt_permisos(v_usuario, v_cod_operacion);
     IF (v_permiso.error = 'S') THEN
       v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
       v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
       v_retorno.error                := v_permiso.error;
       pr_mensajeUsuario(SER_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion,
                           v_usuario.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,
                           v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null), BITACORA_ERROR);
       RETURN v_retorno;
     END IF;
     -- ser verifica que tiene permiso para registrar
     IF v_permiso.registra = FALSE THEN
       pr_mensajeUsuario(SER_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa,
                           v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta,
                           v_retorno.descripcionRespuesta, null), BITACORA_ERROR);
       RETURN v_retorno;
     END IF;
     pr_insertarBitacora(v_usuario.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora, BITACORA_ENTRADA);
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     -- validamos que la cuenta débito pertenezca al cliente
     IF lf_val_cta_origen(v_nro_cta_debito, nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona)) = 'N' THEN
       pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,
                         v_retorno.error);
       pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa,
                           v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                           v_retorno.descripcionRespuesta, null), BITACORA_ERROR);
       RETURN v_retorno;
     END IF;
     --Valida que la cuenta no sea conjunta
     IF PAW_BAS.fu_es_conjunta(v_nro_cta_debito, v_can_aut_requeridas) = 'S' THEN
         pr_mensajeUsuario(MSG_CTA_CONJUNTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usuario.codigoPersona, v_usuario.codigoCanal, p_sesion, v_cod_operacion,
                             v_usuario.codigoEmpresa, v_msj_bitacora || ' ' ||
                             fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
     END IF;
     IF p_extra IS NOT NULL THEN
         v_xml := xmltype.createxml(p_extra);
         -- parseamos los datos de entrada
         v_ref_pago  := v_xml.extract('/DATOS/nroTelefono/text()').getStringVal();
         v_comision  := v_xml.extract('/DATOS/comision/text()').getNumberVal();
         v_nro_lote  := v_xml.extract('/DATOS/nroTransaccion/text()').getStringVal();
         IF v_xml.extract('/DATOS/mail/text()') IS NOT NULL THEN
            v_mail := substr(TRIM(v_xml.extract('/DATOS/mail/text()').getStringVal()), 1, 320);
            -- se valida el mail
            if paw_uti.fu_validarMail(v_mail) = 'N' then
               pr_mensajeUsuario(MSG_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,
                                 v_retorno.error);
               pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa,
                                   v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, null), BITACORA_ERROR);
       RETURN v_retorno;
            end if;
         ELSE
            v_mail := null;
         END IF;
     END IF;
     IF v_modo IN ('V', 'C') THEN
       -- validamos la cuenta débito
       v_error := lf_val_cta_debito(v_nro_cta_debito,
                                    v_cod_tra_padre,
                                    v_monto,
                                    v_cod_mon_debito,
                                    v_cod_mod_debito,
                                    v_cod_mad_debito,
                                    v_cod_ofi_debito,
                                    v_cta_for_debito,
                                    v_nom_cta_debito,
                                    v_usuario,
                                    v_men_caja);
       IF v_error.error = 'S' THEN
         v_retorno.error                := v_error.error;
         v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
       END IF;
       -- validamos la moneda debito, solo se permite moneda local
       IF v_cod_mon_debito <> v_cod_mon_local THEN
          pr_mensajeUsuario(MSG_MON_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,
                            v_retorno.error);
          pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion,
                              v_usuario.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,
                              v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;
       -- control de límites y crear sesión de pago de servicios
       IF v_retorno.error = 'N' AND nvl(p_modo, 'x') <> 'G' THEN
         v_res_limite := fu_obtenerLimite(v_usuario,
                                          v_cod_operacion,
                                          nvl(v_usuario.codigoEmpresa,
                                              v_usuario.codigoPersona),
                                          v_nro_cta_debito,
                                          v_cod_mon_debito,
                                          503,
                                          v_cod_tra_padre,
                                          v_monto,
                                          v_modo);
         IF v_res_limite.error = 'S' THEN
           v_retorno.error                := v_res_limite.error;
           v_retorno.nombreRespuesta      := v_res_limite.nombreRespuesta;
           v_retorno.descripcionRespuesta := v_res_limite.descripcionRespuesta;
           pr_insertarBitacora(v_usuario.codigoPersona, v_usuario.codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa,
                               v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                               BITACORA_ERROR);
         ELSE
            -- Crea el número de sesion e inserta en bw_sesiones
            v_claveSesion := paw_bce.fu_enc_md5(p_sesion ||round(dbms_random.value(1000000, 9999999)));
            IF pag_ser.fu_ins_sesion(v_claveSesion, p_numeroIp, v_usuario.codigoPersona, v_usuario.codigoEmpresa, v_nro_cta_debito) = 'S' THEN
               v_retorno.numeroSesion := v_claveSesion;
            ELSE
               --MSG_INS_MOV_ER
               pr_mensajeUsuario(MSG_INS_MOV_ER, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usuario.codigoPersona, v_usuario.codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa,
                                   v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' ||
                                   fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                   BITACORA_ERROR);
            END IF;
         END IF;
       END IF;
       -- segun informe de fu_obt_limite, solo al confirmar o autorizar la operación
       v_error.error := 'N';
       IF v_modo = 'C' THEN
          -- clave transaccional requerida
          IF v_res_limite.codRespuesta IN ('10', '11') THEN
            v_lugar := 'lf_obt_cla_validar';
            v_error := lf_obt_cla_validar(p_claveTransaccional, v_usuario.codigoPersona, v_usuario.codigoEmpresa, 'T');
          END IF;
          -- token requerido
          IF v_error.error = 'N' THEN
            IF v_res_limite.codRespuesta IN ('01', '11') THEN
              v_lugar := 'paw_seg.fu_obt_tok_validar';
              v_error := paw_seg.fu_obt_tok_validar(p_claveToken, v_usuario.codigoPersona, v_usuario.codigoEmpresa, v_modo);
            END IF;
          END IF;
          -- controlamos si hubo error
          IF v_error.error = 'S' THEN
            v_retorno.error                := v_error.error;
            v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
          END IF;
       END IF;
     END IF;
     IF v_retorno.error = 'N' THEN
       -- no hay problemas hasta aquí
       IF v_modo = 'V' THEN
         -- validación
         v_retorno.respuestaLimite := v_res_limite.codRespuesta;
       ELSIF v_modo = 'C' THEN
         -- confirmación de la operación
         -- esta la cuenta en condiciones, verifico el horario
         v_error := lp_ver_horario(v_horario,
                                   v_es_mov_noc,
                                   v_es_cta_noc,
                                   v_men_caja.fechaUltimoCierre,
                                   v_men_caja.codigoOficinaOrigen,
                                   v_fec_actual);
         -- si hubo error, salimos
         IF v_error.error = 'S' THEN
           v_retorno.error                := v_error.error;
           v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
           v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
         END IF;
         IF v_retorno.error = 'N' THEN
           --obtener concepto
           BEGIN
              SELECT descripcion
                INTO v_concepto
                FROM bw_pag_cod_servicios
               WHERE cod_servicio = p_servicio
                 AND cod_proveedor = p_proveedor;
           EXCEPTION
              WHEN NO_DATA_FOUND THEN
                 v_concepto := null;
           END;
           BEGIN
              SELECT s_pag_servicio.NEXTVAL
                INTO v_nro_documento
                FROM dual;
              -- registramos el pago de servicios
              rg_bpser.nro_cuenta       := v_nro_cta_debito;
              rg_bpser.fecha            := v_fec_actual;
              rg_bpser.hora             := v_hor_actual;
              rg_bpser.nro_transaccion  := v_nro_transaccion;
              rg_bpser.cod_moneda       := 'GS'; -- solo guaranies, no se tiene la cuenta crédito
              rg_bpser.mto_transaccion  := v_monto;
              rg_bpser.mto_debito       := v_monto;
              rg_bpser.cod_mon_debito   := v_cod_mon_debito;
              rg_bpser.cod_mon_servicio := 1; -- moneda local
              rg_bpser.nro_sesion       := v_sesion;
              rg_bpser.cod_proveedor    := p_proveedor;
              rg_bpser.cod_ws_servicios := p_tokenServicios;
              rg_bpser.nro_documento    := v_nro_documento;
              rg_bpser.reversado        := 'S';
              rg_bpser.cod_servicio     := p_servicio;
              rg_bpser.ip_usuario       := p_numeroIp;
              rg_bpser.mto_comision     := v_comision;
              rg_bpser.ref_pago         := v_ref_pago;
              rg_bpser.nro_lote         := v_nro_lote;
              rg_bpser.cod_persona      := v_usuario.codigoPersona;
              rg_bpser.cod_empresa      := v_usuario.codigoEmpresa;
              rg_bpser.ser_concepto     := v_concepto;
              INSERT INTO bw_pag_servicios VALUES rg_bpser;
              BEGIN
                 -- registramos el movimiento
                 lp_reg_operacion(v_nro_cta_debito,
                                  v_cod_mon_debito,
                                  v_monto,
                                  v_nro_cta_credito,
                                  NULL,
                                  'Ses.Ser',
                                  p_sesionServicios,
                                  'TokenSer',
                                  p_tokenServicios,
                                  'Yaguarete - modo: ' || p_modo || ', monCre: GS',
                                  NULL,
                                  '000',
                                  v_usuario.codigoPersona,
                                  v_cod_operacion,
                                  v_nro_documento,
                                  p_codigoCanal,
                                  p_sesion,
                                  v_usuario.codigoEmpresa);
              EXCEPTION
                 WHEN OTHERS THEN
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     v_msj_bitacora := v_msj_bitacora || ', ora-err: [' || substr(sqlerrm, 1, 200) || ']';
              END;
              v_retorno.nroDocumento := v_nro_documento;
           EXCEPTION
             WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               v_msj_bitacora := v_msj_bitacora || ', ORA-ERR: [' || substr(sqlerrm, 1, 250) || '] ';
           END;
         END IF;
       ELSIF v_modo = 'G' THEN
         BEGIN
           UPDATE bw_pag_servicios
              SET cod_servicio = p_servicio, nro_transaccion = p_numeroTransaccion, nro_lote = p_numeroTransaccion, terminal = p_terminal,
                  reversado = 'N', cod_mon_servicio = p_moneda, nro_sesion = substr(trim(p_sesion), 1, 32)
            WHERE COD_WS_SERVICIOS = p_tokenServicios
              AND NRO_CUENTA = v_nro_cta_debito
              AND nvl(REVERSADO, 'N') = 'N';
           lp_act_movimiento(p_tokenServicios, null, p_numeroTransaccion, p_servicio, v_nro_cta_debito, v_men_caja);
         EXCEPTION
           WHEN DUP_VAL_ON_INDEX THEN
              pr_mensajeusuario(MOV_DUP_SERVICIO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarbitacora(v_usuario.codigoPersona, v_codCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa,
                                  v_msj_bitacora || ', DUP-VAL-ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || ']',
                                  bitacora_error);
              return v_retorno;
           WHEN OTHERS THEN
              pr_mensajeusuario(MOV_DUP_SERVICIO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarbitacora(v_usuario.codigoPersona, v_codCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa,
                                  v_msj_bitacora || ', OTHERS-ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || ']',
                                  bitacora_error);
               return v_retorno;
         END;
         -- se envían los mails correspondientes
         -- primero al cliente
         v_resp_mail:= lf_notificacion(p_servicio, p_monto, v_comision, v_ref_pago, p_cuentaDebito ,p_numeroTransaccion, null);
         v_msj_bitacora := v_msj_bitacora || 'respMail cliente: ' || v_resp_mail;
         -- segundo al de la billetera si recibimos su correo
         IF v_mail IS NOT NULL THEN
            v_resp_mail:= lf_notificacion(p_servicio, p_monto, v_comision, v_ref_pago, p_cuentaDebito ,p_numeroTransaccion, v_mail);
            v_msj_bitacora := v_msj_bitacora || 'respMail billetera: ' || v_resp_mail;
         END IF;
       ELSE
         -- No es del tipo V-validación ni C-confirmación
         pr_mensajeUsuario(MSG_OPE_NO_PERM, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       END IF;
     END IF;
     IF v_retorno.error = 'S' THEN
       pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa,
                           v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null),
                           BITACORA_ERROR);
     ELSE
       pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa,
                           v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null),
                           BITACORA_SALIDA);
     END IF;
     RETURN v_retorno;
   EXCEPTION
     WHEN OTHERS THEN
       pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa,
                           substr(v_msj_bitacora || ' En: ' || v_lugar || ' Msg: ' || SQLERRM, 1, 1000),
                           BITACORA_ERROR);
       RETURN v_retorno;
   END;
   FUNCTION fu_configurarOpSinTarjeta(p_cod_sesion         IN BW_AUT_SESIONES.COD_SESION%TYPE,
                                    p_cod_canal          IN BW_AUT_SESIONES.COD_CANAL%TYPE,
                                    p_nro_cuenta         IN BW_CTA_TELEFONOS.NRO_CUENTA%TYPE,
                                    p_nro_celular        IN BW_CTA_TELEFONOS.NRO_CELULAR%TYPE,
                                    p_modo               IN VARCHAR2,
                                    p_tip_pedido         IN VARCHAR2,
                                    p_estado             IN VARCHAR2 DEFAULT NULL) RETURN typ_solicitudClaves IS
      v_cod_sesion     BW_AUT_SESIONES.COD_SESION%TYPE;
      v_cod_canal      BW_AUT_SESIONES.COD_CANAL%TYPE;
      v_nro_celular    BW_CTA_TELEFONOS.NRO_CELULAR%TYPE;
      v_nro_cuenta     BW_CTA_TELEFONOS.NRO_CUENTA%TYPE;
      v_cod_modulo     GE_MODALIDADES.COD_MODULO%TYPE;
      v_cod_modalidad  GE_MODALIDADES.COD_MODALIDAD%TYPE;
      v_rel_cuenta     GE_CTA_CLIENTES.RELACION%TYPE;
      v_cod_moneda     GE_CUENTAS.COD_MONEDA%TYPE;
      v_est_cuenta     VARCHAR2(1);
      v_modo           VARCHAR2(1);
      v_tip_pedido     VARCHAR2(1);
      v_sesion_info    typ_validarSesion;
      v_error          typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_msj_bitacora   VARCHAR2(35) := 'fu_confOperacionesSinTarjeta : ';
      v_existe         VARCHAR2(1);
      v_est_servicio   VARCHAR2(1);
      v_retorno        typ_solicitudClaves := typ_solicitudClaves;
      v_nro_inactivo   BW_CTA_TELEFONOS.NRO_CELULAR%TYPE;
      v_nro_activo     BW_CTA_TELEFONOS.NRO_CELULAR%TYPE;
      v_resp_sus_notif NUMBER;
      v_destino        BW_NOT_CLI_DESTINO.DIRECCION%TYPE;
      --constantes
      v_cod_operacion CONSTANT VARCHAR2(3) := '235';
      v_mod_confirmacion  CONSTANT VARCHAR2(1) := 'C';
      v_mod_verificacion  CONSTANT VARCHAR2(1) := 'V';
      v_mod_actualizacion CONSTANT VARCHAR2(1) := 'A';
      v_tip_suscripcion   CONSTANT VARCHAR2(1) := 'S';
      v_tip_modificacion  CONSTANT VARCHAR2(1) := 'M';
      v_tip_bloqueo       CONSTANT VARCHAR2(1) := 'B';
      v_tip_desbloqueo    CONSTANT VARCHAR2(1) := 'D';
      v_tip_desuscripcion CONSTANT VARCHAR2(1) := 'U';
      v_tip_regeneracion  CONSTANT VARCHAR2(1) := 'R';
      OPE_NO_PERMITIDA        CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_CTA_INVALIDA        CONSTANT VARCHAR2(15) := 'G_NROCTAINVALID';
      MSG_COD_CTA_INEXISTENTE CONSTANT VARCHAR2(15) := 'COD_CTA_INEXIST';
      MSG_COD_CTA_DUPLICADA   CONSTANT VARCHAR2(15) := 'COD_CTA_DUPLIC';
      MSG_TEL_INVALIDO        CONSTANT VARCHAR2(15) := 'G_TEL_INV';
      MSG_SUS_ACTIVA          CONSTANT VARCHAR2(15) := 'OST_SUS_ACTIVA';
      MSG_CEL_VINCULADO       CONSTANT VARCHAR2(15) := 'OST_CEL_EXIS';
      MSG_SUS_INEXISTENTE     CONSTANT VARCHAR2(15) := 'OST_SUS_INEX';
      MSG_CEL_DUPLICADO       CONSTANT VARCHAR2(15) := 'OST_CEL_DUP';
   BEGIN
      --validar sesion
      v_cod_sesion  := depurarAlfanumerico(p_cod_sesion, 32);
      v_cod_canal   := depurarNumerico(p_cod_canal, 3);
      v_sesion_info := fu_validarSesion(v_cod_sesion, v_cod_canal);
      IF v_sesion_info.error = 'S' THEN
         v_retorno.error                := v_sesion_info.error;
         v_retorno.nombreRespuesta      := v_sesion_info.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_sesion_info.descripcionRespuesta;
         pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'sesion invalida', BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'inicio de funcion', BITACORA_ENTRADA);
      v_nro_celular := depurarAlfanumerico(p_nro_celular, 10);
      v_nro_cuenta  := depurarAlfanumerico(p_nro_cuenta, 15);
      v_modo        := depurarAlfanumerico(p_modo, 1);
      v_tip_pedido  := depurarAlfanumerico(p_tip_pedido, 1);
      --seteamos el nro. de celular como destino.
      v_destino := v_nro_celular;
      --validar parametros
      IF nvl(v_modo, 'x') NOT IN (v_mod_confirmacion, v_mod_verificacion, v_mod_actualizacion) THEN
         pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'parametro modo nulo o no permitido', BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF nvl(v_tip_pedido, 'x') NOT IN (v_tip_suscripcion, v_tip_modificacion, v_tip_bloqueo, v_tip_desbloqueo, v_tip_desuscripcion, v_tip_regeneracion) THEN
         pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'parametro tip_pedido nulo o no permitido', BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      --validar que la cuenta sea del cliente y de la moneda y estados correctos
      BEGIN
         SELECT ct.cod_modulo, ct.cod_modalidad, cc.estado, ct.relacion, cc.cod_moneda
           INTO v_cod_modulo, v_cod_modalidad, v_est_cuenta, v_rel_cuenta, v_cod_moneda
           FROM ge_cta_clientes ct
           JOIN ge_cuentas cc
             ON ct.nro_cuenta = cc.nro_cuenta
          WHERE ct.cod_persona = v_sesion_info.codigoPersona
                AND cc.nro_cuenta = v_nro_cuenta;
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(MSG_COD_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            RETURN v_retorno;
         WHEN too_many_rows THEN
            pr_mensajeUsuario(MSG_COD_CTA_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            RETURN v_retorno;
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            RETURN v_retorno;
      END;
      IF (v_cod_modulo NOT IN (3, 4) OR v_cod_modalidad NOT IN (31, 41, 334) OR v_est_cuenta NOT IN ('P', 'I', 'N', 'S') OR v_rel_cuenta NOT IN ('P', 'O') OR v_cod_moneda NOT IN ('GS', 'USD') OR PAW_BAS.fu_es_conjunta(v_nro_cuenta, v_can_aut_requeridas) = 'S') THEN
         pr_mensajeUsuario(MSG_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         RETURN v_retorno;
      END IF;
      --validar que el celular se encuentre en la carpeta del cliente con los tipos permitidos
      BEGIN
         SELECT 'S'
           INTO v_existe
           FROM ba_telefonos
          WHERE area || telefono = v_nro_celular
                AND cod_persona = v_sesion_info.codigoPersona
                AND tip_linea = 'C'
                AND tipo IN ('P', 'L', 'O', 'H', 'A');
      EXCEPTION
         WHEN NO_DATA_FOUND THEN
            pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'numero de celular no valido', BITACORA_ERROR);
            pr_mensajeUsuario(MSG_TEL_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            RETURN v_retorno;
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            RETURN v_retorno;
      END;
      v_existe := 'N';
      IF v_modo <> v_mod_actualizacion THEN
         CASE
            WHEN v_tip_pedido = v_tip_suscripcion THEN
               --validar que no exista una configuracion activa para esa cuenta
               BEGIN
                  SELECT 'S'
                    INTO v_existe
                    FROM bw_cta_telefonos
                   WHERE nro_cuenta = v_nro_cuenta
                         AND estado IN ('A', 'B');
               EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                     v_existe := 'N';
                  WHEN OTHERS THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'error en la validacion de suscripcion activa '  || SQLERRM, BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
               END;
               IF v_existe = 'S' THEN
                  pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'el cliente ya cuenta con una suscripcion activa', BITACORA_ERROR);
                  pr_mensajeUsuario(MSG_SUS_ACTIVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  RETURN v_retorno;
               END IF;
            WHEN v_tip_pedido = v_tip_modificacion THEN
               --validar que el celular sea distinto del activo
               BEGIN
                  SELECT nro_celular
                    INTO v_nro_activo
                    FROM bw_cta_telefonos
                   WHERE nro_cuenta = v_nro_cuenta
                     AND estado IN ('A', 'B', 'P','E');
               EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'suscripcion inexistente ', BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_SUS_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
                  WHEN OTHERS THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'error en la validacion de suscripcion activa : '  || SQLERRM, BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
               END;
               IF v_nro_activo = v_nro_celular THEN
                  pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'el número de celular debe ser distinto al actual', BITACORA_ERROR);
                  pr_mensajeUsuario(MSG_CEL_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  RETURN v_retorno;
               END IF;
            WHEN v_tip_pedido = v_tip_bloqueo THEN
               --validar que exista la configuracion en modo A o P si se solicita bloqueo
               BEGIN
                  SELECT 'S'
                    INTO v_existe
                    FROM bw_cta_telefonos
                   WHERE nro_cuenta = v_nro_cuenta
                     AND nro_celular = v_nro_celular
                     AND estado IN ('A', 'P', 'E');
               EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'suscripcion inexistente o modo incorrecto ', BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_SUS_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
                  WHEN OTHERS THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'error en la validacion de suscripcion activa : ' || SQLERRM, BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
               END;
            WHEN v_tip_pedido = v_tip_desbloqueo THEN
               --validar que exista la configuracion en modo B si se solicita desbloqueo
               BEGIN
                  SELECT 'S'
                    INTO v_existe
                    FROM bw_cta_telefonos
                   WHERE nro_cuenta = v_nro_cuenta
                         AND nro_celular = v_nro_celular
                         AND estado IN ('B');
               EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'suscripcion inexistente o modo incorrecto ', BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_SUS_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
                  WHEN OTHERS THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'error en la validacion de suscripcion activa: ' || SQLERRM, BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
               END;
            WHEN v_tip_pedido IN (v_tip_desuscripcion, v_tip_regeneracion) THEN
               --validar que exista la configuracion en modo <> 'I' si se solicita desvinculacion
               BEGIN
                  SELECT 'S'
                    INTO v_existe
                    FROM bw_cta_telefonos
                   WHERE nro_cuenta = v_nro_cuenta
                         AND nro_celular = v_nro_celular
                         AND estado <> 'I';
               EXCEPTION
                  WHEN NO_DATA_FOUND THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'suscripcion inexistente o modo incorrecto ', BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_SUS_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
                  WHEN OTHERS THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'error en la validacion de suscripcion activa ' || SQLERRM, BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
               END;
         END CASE;
         --validar que no exista una configuracion activa para ese celular
         IF v_tip_pedido IN (v_tip_suscripcion, v_tip_modificacion) THEN
            BEGIN
               SELECT 'S'
                 INTO v_existe
                 FROM bw_cta_telefonos
                WHERE nro_celular = v_nro_celular
                  AND estado IN ('A', 'B', 'P','E');
            EXCEPTION
               WHEN NO_DATA_FOUND THEN
                  v_existe := 'N';
               WHEN OTHERS THEN
                  pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'error en la validacion de suscripcion activa ' || SQLERRM, BITACORA_ERROR);
                  pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  RETURN v_retorno;
            END;
            IF v_existe = 'S' THEN
               pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'el cliente ya cuenta con una suscripcion activa', BITACORA_ERROR);
               pr_mensajeUsuario(MSG_CEL_VINCULADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               RETURN v_retorno;
            END IF;
         END IF;
      END IF;

      --insercion o actualizacion
      IF v_modo = v_mod_confirmacion THEN
         IF v_tip_pedido IN (v_tip_suscripcion, v_tip_modificacion, v_tip_regeneracion, v_tip_desbloqueo) THEN
            v_error.error := 'N';
            --suscripcion
            IF v_tip_pedido in (v_tip_suscripcion, v_tip_modificacion) THEN
              --verificar si tiene una configuracion anterior inactiva con el numero de celular solicitado
              BEGIN
                 SELECT nro_celular
                   INTO v_nro_inactivo
                   FROM bw_cta_telefonos
                  WHERE nro_celular = v_nro_celular
                        AND COD_PERSONA = v_sesion_info.codigoPersona
                        AND ESTADO = 'I';
              EXCEPTION
                 WHEN NO_DATA_FOUND THEN
                    v_nro_inactivo := NULL;
                 WHEN OTHERS THEN
                    pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'error en la validacion de celular existente : ' || SQLERRM, BITACORA_ERROR);
              END;
              IF v_nro_inactivo IS NOT NULL THEN
                 BEGIN
                    UPDATE bw_cta_telefonos
                       SET ESTADO     = 'P',
                           NRO_CUENTA = v_nro_cuenta
                       WHERE nro_celular = v_nro_celular
                       AND COD_PERSONA = v_sesion_info.codigoPersona;
                 EXCEPTION
                    WHEN OTHERS THEN
                       pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'error en la actualizacion de celular ' || SQLERRM, BITACORA_ERROR);
                       pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                       RETURN v_retorno;
                 END;
                 --desactivar la vinculacion activa si existe
                 BEGIN
                    UPDATE bw_cta_telefonos
                       SET ESTADO = 'I'
                     WHERE nro_cuenta = v_nro_cuenta
                           AND nro_celular <> v_nro_celular;
                 EXCEPTION
                    WHEN OTHERS THEN
                       pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'error en la actualizacion de celular : ' || SQLERRM, BITACORA_ERROR);
                       pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                       RETURN v_retorno;
                 END;
                 pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 RETURN v_retorno;
              END IF;
            END IF;
         END IF;
         CASE
            WHEN v_tip_pedido = v_tip_suscripcion THEN
               -- insercion en bw_cta_telefonos
               BEGIN
                  INSERT INTO BW_CTA_TELEFONOS
                     (COD_PERSONA, NRO_CUENTA, NRO_CELULAR, ESTADO)
                  VALUES
                     (v_sesion_info.codigoPersona, v_nro_cuenta, v_nro_celular, 'P');
               EXCEPTION
                  WHEN DUP_VAL_ON_INDEX THEN
                     pr_mensajeUsuario(MSG_SUS_ACTIVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
                  WHEN OTHERS THEN
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
               END;
            --alta a notificaciones
            v_resp_sus_notif := paw_not.fu_alt_notificacion(v_sesion_info.codigoPersona, v_destino);
            pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'resultado suscripcion a notificaciones : '|| v_resp_sus_notif, BITACORA_ENTRADA);
            WHEN v_tip_pedido IN (v_tip_bloqueo, v_tip_desbloqueo, v_tip_desuscripcion, v_tip_regeneracion) THEN
               BEGIN
                  --cambio de estado dependiendo del tipo de operacion
                  UPDATE BW_CTA_TELEFONOS
                     SET ESTADO = DECODE(v_tip_pedido, v_tip_bloqueo, 'B', v_tip_desbloqueo, 'A', v_tip_desuscripcion, 'I', v_tip_regeneracion, 'P', 'A')
                   WHERE COD_PERSONA = v_sesion_info.codigoPersona
                         AND NRO_CELULAR = v_nro_celular
                         AND NRO_CUENTA = v_nro_cuenta;
                  IF SQL%ROWCOUNT = 0 THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'suscripcion inexistente ', BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_SUS_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
                  END IF;
               EXCEPTION
                  WHEN DUP_VAL_ON_INDEX THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'celular o cuenta con suscripcion activa ', BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_CEL_VINCULADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
                  WHEN OTHERS THEN
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
               END;
            WHEN v_tip_pedido = v_tip_modificacion THEN
               BEGIN
                  UPDATE BW_CTA_TELEFONOS
                     SET ESTADO      = 'P',
                         NRO_CELULAR = v_nro_celular
                   WHERE COD_PERSONA = v_sesion_info.codigoPersona
                         AND NRO_CUENTA = v_nro_cuenta;
                  IF SQL%ROWCOUNT = 0 THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'suscripcion inexistente ', BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_SUS_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
                  END IF;
               EXCEPTION
                  WHEN DUP_VAL_ON_INDEX THEN
                     pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'celular o cuenta con suscripcion activa ', BITACORA_ERROR);
                     pr_mensajeUsuario(MSG_CEL_VINCULADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
                  WHEN OTHERS THEN
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     RETURN v_retorno;
               END;
         END CASE;
         pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'OK', MSG_OK);
      END IF;
      --para actualizaciones de estado inconsistentes con bancard
      IF v_modo = v_mod_actualizacion THEN
         v_est_servicio := depurarAlfanumerico(p_estado, 1);
         IF v_est_servicio IS NULL OR v_est_servicio NOT IN ('P', 'A', 'B', 'I','E') THEN
            pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'parametro estado nulo o no permitido', BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         BEGIN
            UPDATE BW_CTA_TELEFONOS
               SET ESTADO = v_est_servicio
             WHERE COD_PERSONA = v_sesion_info.codigoPersona
                   AND NRO_CUENTA = v_nro_cuenta
                   AND NRO_CELULAR = v_nro_celular;
            IF SQL%ROWCOUNT = 0 THEN
               pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora || 'suscripcion inexistente ', BITACORA_ERROR);
               pr_mensajeUsuario(MSG_SUS_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               RETURN v_retorno;
            END IF;
         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               RETURN v_retorno;
         END;
      END IF;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      RETURN v_retorno;
   END;

FUNCTION fu_ins_pol_seguros(p_cod_sesion     BW_AUT_SESIONES.COD_SESION%TYPE,
                            p_cod_canal      BW_AUT_SESIONES.COD_CANAL%TYPE,
                            p_nro_poliza     GE_POL_SEGUROS.nro_poliza%TYPE,
                            p_arc_base64     BW_POL_ARCHIVOS.ARC_BASE64%TYPE)
  RETURN typ_mensajerespuesta IS

  v_cod_sesion    bw_aut_sesiones.cod_sesion%TYPE;
  v_cod_canal     bw_aut_sesiones.cod_canal%TYPE;
  v_cod_operacion Bw_Tip_Mensajes.Cod_Tip_Mensaje%TYPE := '042';
  v_codigo       bw_pol_archivos.cod_pol_seguro%TYPE;
  v_nro_poliza ge_pol_seguros.nro_poliza%TYPE := p_nro_poliza;
  v_cod_ente      ge_pol_seguros.cod_ente%TYPE;
  v_sesion_info   typ_validarSesion;
  v_retorno       typ_mensajerespuesta := typ_mensajerespuesta();

  MSG_COD_POL_INEXISTENTE   CONSTANT varchar2(15) := 'POL_NOEXISTE';
  MSG_ENTE_NO_GENERA_POLIZA CONSTANT varchar2(15) := 'NO_GENERA_POL';

BEGIN
  pr_mensajeUsuario(MSG_OK,
                    v_retorno.nombreRespuesta,
                    v_retorno.descripcionRespuesta,
                    v_retorno.error);
  v_cod_sesion  := depurarAlfanumerico(p_cod_sesion, 32);
  v_cod_canal   := depurarNumerico(p_cod_canal, 3);
  v_sesion_info := fu_validarSesion(v_cod_sesion, v_cod_canal);

  if v_sesion_info.error = 'S' THEN
    v_retorno.error                := v_sesion_info.error;
    v_retorno.nombreRespuesta      := v_sesion_info.nombreRespuesta;
    v_retorno.descripcionRespuesta := v_sesion_info.descripcionRespuesta;
    pr_insertarBitacora(v_sesion_info.codigoPersona,
                        v_sesion_info.codigoCanal,
                        v_cod_sesion,
                        v_cod_operacion,
                        NULL,
                        'fu_ins_pol_seguros: sesion invalida',
                        BITACORA_ERROR);
    RETURN v_retorno;

  end if;
  --Validamos que la Poliza exista en GE_POL_SEGUROS
  BEGIN
  IF v_sesion_info.codigoEmpresa IS NULL THEN
    select codigo, cod_ente
      into v_codigo, v_cod_ente
      from ge_pol_seguros
     where nro_poliza = v_nro_poliza
       and cod_persona = v_sesion_info.codigoPersona;
  ELSE
    select codigo, cod_ente
      into v_codigo, v_cod_ente
      from ge_pol_seguros
     where nro_poliza = v_nro_poliza
       and cod_persona = v_sesion_info.codigoEmpresa;
  END IF;
  EXCEPTION
    WHEN no_data_found THEN
      pr_mensajeUsuario(MSG_COD_POL_INEXISTENTE,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
      return v_retorno; --- Poliza NO existente en GE_POL_SEGUROS
  END;
  --Validamos que el Ente de la Aseguradora pueda Generar Polizas(Validamos contra Par_Dinamico)
  IF (instr(fug_obt_pardinamico('ASEG_GEN_POLIZA', null, null), v_cod_ente) = 0) THEN
    pr_mensajeUsuario(MSG_ENTE_NO_GENERA_POLIZA,
                      v_retorno.nombreRespuesta,
                      v_retorno.descripcionRespuesta,
                      v_retorno.error);
    return v_retorno; -- ENTE NO GENERA POLIZA
  ELSE
    BEGIN
    INSERT INTO BW_POL_ARCHIVOS
      (COD_POL_SEGURO, ARC_BASE64)
    VALUES
      (V_CODIGO, P_ARC_BASE64);
    EXCEPTION
      WHEN OTHERS THEN
        pr_mensajeUsuario(MSG_ERROR,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,v_retorno.error);
        RETURN v_retorno;
    END;
  END IF;

  RETURN v_retorno;

END;

 FUNCTION fu_obt_pol_seguros(p_cod_sesion IN bw_aut_sesiones.cod_sesion%TYPE,
                                              p_cod_canal IN bw_aut_sesiones.cod_canal%TYPE,
                                              p_nro_poliza IN ge_pol_seguros.nro_poliza%TYPE) RETURN TYP_ARC_SEGUROS IS

v_cod_sesion        BW_AUT_SESIONES.COD_SESION%TYPE;
v_cod_canal          BW_AUT_SESIONES.COD_CANAL%TYPE;
v_sesion_info        typ_validarSesion;
v_cod_operacion   BW_TIP_MENSAJES.COD_TIP_MENSAJE%TYPE := '042';
v_retorno              typ_arc_seguros := typ_arc_seguros();

MSG_ARC_INEXISTENTE   CONSTANT varchar2(15) := 'ARC_NO_EXISTE';

BEGIN

    pr_mensajeUsuario(MSG_OK,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);

    v_cod_sesion := depurarAlfanumerico(p_cod_sesion,32);
    v_cod_canal   := depurarNumerico(p_cod_canal,3);

    v_sesion_info := fu_validarSesion(v_cod_sesion,v_cod_canal);

    IF v_sesion_info.error = 'S' THEN
        v_retorno.error := v_sesion_info.error;
        v_retorno.nombreRespuesta := v_sesion_info.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_sesion_info.descripcionRespuesta;

        pr_insertarBitacora(v_sesion_info.codigoPersona,v_sesion_info.codigoCanal,v_cod_sesion,v_cod_operacion,NULL,'fu_obt_pol_seguros: sesion invalida',BITACORA_ERROR);
        RETURN v_retorno;
    END IF;

    pr_insertarBitacora(v_sesion_info.codigoPersona,v_sesion_info.codigoCanal,v_cod_sesion,v_cod_operacion,NULL,'fu_obt_pol_seguros: p_nro_poliza=' || p_nro_poliza ,BITACORA_ENTRADA);

    BEGIN
        SELECT A.ARC_BASE64
        INTO v_retorno.arc_base64
        FROM BW_POL_ARCHIVOS A, GE_POL_SEGUROS B
        WHERE a.cod_pol_seguro = b.codigo
        AND b.nro_poliza = p_nro_poliza;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN --Si no se encuentra ningun dato, se presenta un MSG_ERROR al Cliente y se inserta en BW_Bitacora registro de Tipo ERR
             pr_mensajeUsuario(MSG_ARC_INEXISTENTE,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
             pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, 'fu_obt_pol_seguros: Datos no Encontrados',BITACORA_ERROR);
             RETURN v_retorno;
    END;

    pr_insertarBitacora(v_sesion_info.codigoPersona,v_sesion_info.codigoCanal,v_cod_sesion,v_cod_operacion,NULL,fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta),BITACORA_SALIDA);

    RETURN v_retorno;

    END;
--
FUNCTION fu_activarchequera(p_cod_sesion         IN bw_aut_sesiones.cod_sesion%TYPE,
                            p_cod_canal          IN bw_aut_sesiones.cod_canal%TYPE,
                            p_modo               IN VARCHAR2,
                            p_nro_cuenta         IN cc_chequeras.nro_cuenta%TYPE,
                            p_nro_inicial        IN cc_chequeras.nro_che_inicial%TYPE,
                            p_nro_final          IN cc_chequeras.nro_che_final%TYPE)
  RETURN typ_ActivacionChequeras IS
  v_cod_sesion       bw_aut_sesiones.cod_sesion%TYPE;
  v_cod_canal        bw_aut_sesiones.cod_canal%TYPE;
  v_sesion           typ_validarsesion;
  v_cod_operacion    bw_tip_mensajes.cod_tip_mensaje%TYPE := '101';
  v_retorno          typ_ActivacionChequeras := typ_ActivacionChequeras();
  v_mensaje          typ_mensajerespuesta;
  v_mensajeVal       typ_mensajerespuesta;
  v_permiso          typ_obtenerpermisos;
  v_nro_cuenta       cc_chequeras.nro_cuenta%TYPE := '';
  v_msj_bitacora     VARCHAR2(1000);
  v_cod_moneda       ge_cuentas.cod_moneda%type:=null;
  v_cod_tip_chequera cc_tip_chequeras.cod_transaccion%type; --Guarda la transaccion para verificar si esta prohibida
  v_cod_transaccion  cc_tip_chequeras.cod_transaccion%type;
  --
  FUNCTION lf_val_chequera(p_nro_cuenta  IN cc_chequeras.nro_cuenta%TYPE,
                           p_nro_inicial IN cc_chequeras.nro_che_inicial%TYPE,
                           p_nro_final   IN cc_chequeras.nro_che_final%TYPE)
    RETURN typ_mensajerespuesta IS
    v_retorno typ_mensajerespuesta := typ_mensajerespuesta();
    v_nro_cuenta cc_chequeras.nro_cuenta%TYPE;
    v_cod_tip_chequera cc_sol_chequeras.cod_tip_chequera%type;
    v_estado cc_chequeras.estado%type;
  BEGIN
    paw_uti.pr_mensajeusuario(paw_uti.MSG_OK, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, v_retorno.error);
    BEGIN
      SELECT s.nro_cuenta, s.cod_tip_chequera,c.estado
        INTO v_nro_cuenta, v_cod_tip_chequera,v_estado
        FROM cc_chequeras c, cc_sol_chequeras s
       WHERE s.nro_cuenta = c.nro_cuenta
         AND c.fec_solicitud = s.fecha
         AND c.hor_solicitud = s.hora
         AND s.tip_solicitud = 'C'
         AND c.cod_usuario = 'HBANK'
         AND s.nro_cuenta = p_nro_cuenta
         AND c.nro_che_inicial = p_nro_inicial
         AND c.nro_che_final = p_nro_final;
          --parche
      v_retorno.nombreRespuesta := v_cod_tip_chequera;

    IF v_estado <> 'I' THEN
       paw_uti.pr_mensajeusuario('G_DAT_DUP', v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, v_retorno.error);
    END IF;

    EXCEPTION
      WHEN no_data_found THEN
        paw_uti.pr_mensajeusuario('G_DATO_INV', v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, v_retorno.error);
      WHEN OTHERS THEN
        paw_uti.pr_mensajeusuario(paw_uti.MSG_ERROR, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, v_retorno.error);
    END;

    RETURN v_retorno;
  END;

  FUNCTION lf_obt_che_sol_transaccion(p_cod_tip_cheque IN cc_tip_chequeras.cod_tip_chequera%TYPE,
                                      p_cod_moneda     IN ba_monedas.cod_moneda%TYPE) RETURN VARCHAR2 IS
    v_cod_transaccion cc_tip_chequeras.cod_transaccion%TYPE := 0;
  BEGIN
    BEGIN
      -- busco la transaccion que corresponde para verificar prohibiciones
      SELECT a.cod_transaccion
        INTO v_cod_transaccion
        FROM cc_tip_chequeras a
       WHERE cod_tip_chequera = p_cod_tip_cheque
         AND nvl(cod_moneda, p_cod_moneda) = p_cod_moneda;
    EXCEPTION
      WHEN OTHERS THEN
        NULL;
    END;
    RETURN v_cod_transaccion;
  END;
BEGIN
  paw_uti.pr_mensajeusuario(paw_uti.MSG_OK, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, v_retorno.error);
  v_cod_sesion := paw_uti.depuraralfanumerico(p_cod_sesion, 32);
  v_nro_cuenta := paw_uti.depuraralfanumerico(p_nro_cuenta, 13);
  v_cod_canal  := paw_uti.depurarnumerico(p_cod_canal, 3);
  v_msj_bitacora := 'modo: '||p_modo || ', nro_cta:' || v_nro_cuenta || ', nro_ini:' || p_nro_inicial || ', nro_fin:' || p_nro_final;
  v_sesion       := fu_validarsesion(v_cod_sesion, v_cod_canal);
  IF v_sesion.error = 'S' THEN
    v_retorno.error                := v_sesion.error;
    v_retorno.nombrerespuesta      := v_sesion.nombrerespuesta;
    v_retorno.descripcionrespuesta := v_sesion.descripcionrespuesta;
    paw_uti.pr_insertarbitacora(v_sesion.codigopersona, v_sesion.codigocanal, v_cod_sesion, v_cod_operacion, NULL, v_msj_bitacora, paw_uti.BITACORA_ERROR);
    RETURN v_retorno;
  END IF;
  v_permiso := lf_obt_permisos(v_sesion, v_cod_operacion);
  IF (v_permiso.error = 'S') THEN
    v_retorno.nombrerespuesta      := v_permiso.nombrerespuesta;
    v_retorno.descripcionrespuesta := v_permiso.descripcionrespuesta;
    v_retorno.error                := v_permiso.error;
    paw_uti.pr_insertarbitacora(v_sesion.codigopersona, v_cod_canal, v_cod_sesion, v_cod_operacion, v_sesion.codigoempresa, v_msj_bitacora || ' ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, NULL), paw_uti.BITACORA_ERROR);
    RETURN v_retorno;
  END IF;
  paw_uti.pr_insertarbitacora(v_sesion.codigopersona, v_cod_canal, v_cod_sesion, v_cod_operacion, v_sesion.codigoempresa, v_msj_bitacora || ' ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, NULL), paw_uti.BITACORA_ENTRADA);
  -- se verifica que tenga permiso para registrar
  IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
     paw_uti.pr_mensajeusuario('SAL_PER_SIN_AUT', v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, v_retorno.error);
     paw_uti.pr_insertarbitacora(v_sesion.codigopersona, v_cod_canal, v_cod_sesion, v_cod_operacion, v_sesion.codigoempresa, v_msj_bitacora || ' ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, NULL), paw_uti.BITACORA_ERROR);
     RETURN v_retorno;
  END IF;
  --Verifico que la cuenta sea del usuario
  v_mensajeVal := paw_uti.fu_val_cuenta(nvl(v_sesion.codigoempresa, v_sesion.codigopersona), v_nro_cuenta, 4, 41, 'P');
  IF (v_mensajeVal.error = 'S') THEN
     paw_uti.pr_mensajeusuario('COD_CTA_INVALID', v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, v_retorno.error);
     paw_uti.pr_insertarbitacora(v_sesion.codigopersona, v_cod_canal, v_cod_sesion, v_cod_operacion, v_sesion.codigoempresa, v_msj_bitacora || ' ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, NULL), paw_uti.BITACORA_ERROR);
     RETURN v_retorno;
  END IF;

  --verifica que no sea inhibida
  IF NVL(fug_obt_es_per_inhi(v_sesion.codigoPersona),'X') = 'S'  THEN
     paw_uti.pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     paw_uti.pr_insertarBitacora(v_sesion.codigoPersona, p_cod_Canal, p_cod_sesion, v_cod_operacion, v_sesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
     RETURN v_retorno;
  END IF;

  --Verifica que la chequera este en el estado impreso y haya sido generada desde el HB
  v_mensaje := lf_val_chequera(v_nro_cuenta, p_nro_inicial, p_nro_final);
  IF (v_mensaje.error = 'S') THEN
     v_retorno.error := v_mensaje.error;
     v_retorno.nombreRespuesta := v_mensaje.nombreRespuesta;
     v_retorno.descripcionRespuesta := v_mensaje.descripcionRespuesta;
     paw_uti.pr_insertarbitacora(v_sesion.codigopersona, v_cod_canal, v_cod_sesion, v_cod_operacion, v_sesion.codigoempresa, v_msj_bitacora || ' ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, NULL), paw_uti.BITACORA_ERROR);
     RETURN v_retorno;
  END IF;
  --el tipo de chequera se guarda en nombreRespuesta sino ocurrio un error
  v_cod_tip_chequera := substr(v_mensaje.nombreRespuesta,1,1);
  --Valida que no sea transaccion prohibida
  v_cod_moneda := fug_obt_mon_cta(v_nro_cuenta);
  v_cod_transaccion := lf_obt_che_sol_transaccion(v_cod_tip_chequera,v_cod_moneda);
  IF pag_cta.fu_ver_tra_prohibida(v_nro_cuenta, v_cod_transaccion, 4, 41) = 'S' THEN
     paw_uti.pr_mensajeusuario('COD_TRA_PROHIB', v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, v_retorno.error);
     paw_uti.pr_insertarbitacora(v_sesion.codigopersona, v_cod_canal, v_cod_sesion, v_cod_operacion, v_sesion.codigoempresa, v_msj_bitacora || ' ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, NULL), paw_uti.BITACORA_ERROR);
     RETURN v_retorno;
  END IF;
  v_retorno.codigoMoneda := v_cod_moneda;
  v_retorno.firmasRequeridas := v_can_aut_requeridas;
  -- al confirmar y no hay errores, activamos
  IF p_modo = 'C' AND nvl(v_retorno.error, 'N') = 'N' THEN
     v_mensaje := paw_bas.fu_activarchequera(v_nro_cuenta, p_nro_inicial, p_nro_final);
     v_retorno.error := v_mensaje.error;
     v_retorno.nombreRespuesta := v_mensaje.nombreRespuesta;
     v_retorno.descripcionRespuesta := v_mensaje.descripcionRespuesta;
  END IF;
  paw_uti.pr_insertarBitacora(v_sesion.codigoPersona, v_sesion.codigoCanal, v_cod_sesion, v_cod_operacion, v_sesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);
  RETURN v_retorno;
EXCEPTION
  WHEN OTHERS THEN
     paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     paw_uti.pr_insertarBitacora(v_sesion.codigoPersona, v_sesion.codigoCanal, v_cod_sesion, v_cod_operacion, v_sesion.codigoEmpresa, v_msj_bitacora || ', ora-err:[' || SQLERRM || '] '||paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
     RETURN v_retorno;
END;

  FUNCTION fu_obtTotCuoPrestamo(p_sesion      IN VARCHAR2,
                                p_codCanal    IN VARCHAR2,
                                p_nroPrestamo IN VARCHAR2) RETURN typ_obtCuotasPrestamo IS
      v_cod_operacion   VARCHAR2(3) := '701';
      v_retorno         typ_obtCuotasPrestamo := typ_obtCuotasPrestamo;
      retValidarSesion  typ_validarSesion;
      v_mensajeCaja     typ_mensajeCaja;

   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- valida sesion del cliente
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);
      --

      pr_insertarBitacora(retValidarSesion.codigoPersona,
            p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,
            'PAW_BEL.fu_obtTotCuoPrestamo - Nro. Prestamo:' || p_nroPrestamo || ' ' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta,
            retValidarSesion.descripcionRespuesta,null ),
            BITACORA_ENTRADA);

      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      END IF;

      IF v_retorno.error <> 'S' THEN
         -- valida la caja origen
         v_mensajeCaja := lf_val_caja(retValidarSesion);
         IF v_mensajeCaja.error = 'S' THEN
            v_retorno.error                := v_mensajeCaja.error;
            v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         END IF;
      END IF;

      IF v_retorno.error <> 'S' THEN
         v_retorno := paw_bas.fu_obtTotCuoPrestamo(retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, retValidarSesion.codigoCanal, p_nroPrestamo, p_sesion);
      END IF;

      return v_retorno;
   END;

   FUNCTION fu_obt_punt_lealtad(p_sesion IN BW_AUT_SESIONES.COD_SESION%TYPE,
                              p_cod_canal  IN BW_AUT_SESIONES.COD_CANAL%TYPE) RETURN TYP_OBTPUNTOSLEALTAD IS
      retValidarSesion typ_validarSesion;
      v_mensajeCaja    typ_mensajeCaja;
      v_retorno        TYP_OBTPUNTOSLEALTAD := TYP_OBTPUNTOSLEALTAD();

   BEGIN

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- valida sesion del cliente
      retValidarSesion := fu_validarSesion(p_sesion, p_cod_canal);
      --
      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      END IF;

      IF v_retorno.error <> 'S' THEN
         -- valida la caja origen
         v_mensajeCaja := lf_val_caja(retValidarSesion);
         IF v_mensajeCaja.error = 'S' THEN
            v_retorno.error                := v_mensajeCaja.error;
            v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         END IF;
      END IF;
      IF v_retorno.error <> 'S' THEN

         --llamamos a paw_can
         v_retorno := paw_can.fu_ns_obt_punt_lealtad(retValidarSesion.codigoPersona, retValidarSesion.codigoCanal, p_sesion);
      END IF;
      RETURN v_retorno;
   END;

   FUNCTION fu_ini_sesion(p_clave          IN VARCHAR2,
                          p_cod_persona   IN VARCHAR2,
                          p_cod_dispositivo IN VARCHAR2) RETURN typ_iniciarSesion IS

      FEC_HOR_ACTUAL    CONSTANT DATE := SYSDATE;
      v_cod_operacion   CONSTANT VARCHAR2(5) := '006';
      MSG_LOGIN_ERR     CONSTANT VARCHAR2(30) := 'L_ERROR';
      CLA_PUB_EXPIRADA  CONSTANT VARCHAR2(30) := 'CLA_PUB_EXP';
      v_tip_clave       VARCHAR2(1);
      v_retorno         typ_iniciarSesion := typ_iniciarSesion;
      v_log             VARCHAR2(1000);
      v_cod_canal       VARCHAR2(4) := '994';
      v_clave           VARCHAR2(32);
      v_codUsuarioOficial ge_clientes.cod_usu_oficial%TYPE;
      v_can_intentos    NUMBER(4) := 0;
      v_tipoPersona       ba_personas.tipo%TYPE;
      v_cla_acceso      bw_cla_cli_acceso.cla_acceso%TYPE := NULL;
      v_fec_exp_clave DATE;
      v_val_exp_clave VARCHAR2(3) := NVL(fug_obt_pardinamico('EXP_CLA_ACCESO'), '90');
      v_fec_ult_acceso DATE := NULL;
      v_fec_insercion DATE := NULL;
      v_cant_dias NUMBER(2);
      v_cla_verificador VARCHAR2(20);

   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_log := substr('fu_ini_sesion(pass='||p_clave||',p_cod_persona=' || p_cod_persona || ')', 0, 999);
      pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL, v_log, BITACORA_ENTRADA);

      v_clave := depurarAlfanumerico(p_clave, 32);

      BEGIN
         SELECT b.nom_completo, a.cod_usu_oficial,
            b.cod_persona, a.can_intentos, nvl(a.tip_clave, 'C'),
            dir_correo, cod_perfil, b.tipo, a.cod_oficina
         INTO v_retorno.nombreCompleto, v_codUsuarioOficial,
            v_retorno.codigoCliente, v_can_intentos, v_tip_clave,
            v_retorno.emailCliente, v_retorno.codigoPerfil, v_tipoPersona, v_retorno.CodOficina
         FROM ge_clientes a, ba_personas b
         WHERE a.cod_persona = b.cod_persona
            AND b.tipo = 'F'
            AND a.cod_persona = p_cod_persona;
      EXCEPTION
         WHEN NO_DATA_FOUND THEN
             pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL, 'Sin datos (ge_clientes o ba_personas) ' ||
                fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL, 'Obtener datos ' ||
               fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END;

                  --Verificaion Blacklist
            if paw_seg.fu_obtenerBlacklist(v_retorno.codigoCliente)='S' then
               pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora( v_retorno.codigoCliente, v_cod_canal, NULL, '005', NULL, 'Usuario sin autorizacion definida ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            end if;
      DECLARE
         v_est_clave VARCHAR2(1);
      BEGIN
         SELECT EST_CLAVE
         INTO v_est_clave
         FROM bw_ope_claves
         WHERE cod_per_vinculada IS NULL
            AND tip_clave = 'A'
            AND cod_persona = p_cod_persona;

         IF NVL(v_est_clave, 'X') <> 'M' THEN
            pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL, 'Estado bw_ope_claves invalida ' ||
               fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END IF;
      EXCEPTION
         WHEN NO_DATA_FOUND THEN
            pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL, 'Sin datos (BW_OPE_CLAVES) ' ||
               fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL, 'Obtener datos BW_OPE_CLAVES ' ||
               fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END;

      IF v_retorno.error = 'N' THEN
         --VALIDAR CLAVE
         SELECT c.cla_acceso, c.cla_verificador, c.fec_ult_acceso, c.fec_insercion
         INTO v_cla_acceso, v_cla_verificador, v_fec_ult_acceso, v_fec_insercion
         FROM bw_cla_cli_acceso c
         WHERE c.cod_persona = p_cod_persona
            AND c.estado = 'A'
            AND c.id_dispositivo = p_cod_dispositivo;

         -- validar clave
         paw_seg.pr_val_cla_estatica(p_cod_persona, p_cod_dispositivo, v_clave, v_retorno);
         -- actualizar cantidad de acceso
         paw_seg.pr_act_visitas(p_cod_persona, p_cod_dispositivo);
      END IF;
      IF v_retorno.error = 'N' THEN
         v_fec_exp_clave := v_fec_insercion + TO_NUMBER(v_val_exp_clave);
         v_fec_ult_acceso := NVL(v_fec_ult_acceso, v_fec_insercion);
         v_cant_dias := v_fec_exp_clave - v_fec_ult_acceso;

         v_retorno.cambiarClavePublica := 'N';
         IF TRUNC(SYSDATE) >= TRUNC(v_fec_exp_clave) THEN
            IF v_cant_dias >= TO_NUMBER(v_val_exp_clave) THEN
               -- error, la clave expiro y nunca se logueo con anterioredad
               -- retornar error, invalidar claves
               pr_mensajeUsuario(CLA_PUB_EXPIRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL, 'Clave publica expirada ' ||
                  fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            ELSIF v_cant_dias < TO_NUMBER(v_val_exp_clave) THEN
               -- OK, pero en la capa de servicios se deben generar las claves
               -- retornar un estado que indique que se debe volver a generar claves
               -- invalidar clave
               v_retorno.cambiarClavePublica := 'S';
            END IF;
         END IF;

      END IF;

      --OBTENER PERMISOS
      IF v_retorno.error = 'N' THEN
         DECLARE
            v_permiso typ_obtenerPermisos;
            v_val_sesion typ_validarSesion;
         BEGIN
            v_val_sesion.error := 'N';
            v_val_sesion.codigoPersona := v_retorno.codigoCliente;
            v_val_sesion.codigoCanal := v_cod_canal;
            v_val_sesion.codigoPerfil := v_retorno.codigoPerfil;
            v_permiso := lf_obt_permisos(v_val_sesion, v_cod_operacion);

            IF v_permiso.error = 'S' THEN
               v_retorno.nombreRespuesta := v_permiso.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
               v_retorno.error := v_permiso.error;
               pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL, 'lf_obt_permisos - ' ||
                  fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            END IF;
         END;
      END IF;
      -- OBT DAT OFICIAL
      IF v_retorno.error = 'N' THEN
         BEGIN
            SELECT SUBSTR(NVL(u.nombre, ' '),1, 50), SUBSTR(NVL(u.telefono, '4176000'), 1, 10), NVL(u.dir_correo, ' ') dir_correo
            INTO v_retorno.nombreOficial, v_retorno.telefonoOficial, v_retorno.emailOficial
            FROM ba_usuarios u
            WHERE u.cod_usuario = v_codUsuarioOficial;
            v_retorno.mensaje := lf_obt_mensaje(p_cod_persona);
            v_retorno.esVip := paw_bce.fu_es_vip(p_cod_persona);
         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL, 'datos oficial - ' ||
                  fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END;
      END IF;
      -- OBT DESC PERFIL
      IF v_retorno.error = 'N' THEN
         BEGIN
            SELECT p.descripcion
            INTO v_retorno.descripcionPerfil
            FROM bw_perfiles p
            WHERE p.cod_perfil = v_retorno.codigoPerfil;

         EXCEPTION
            WHEN OTHERS THEN
               v_retorno.descripcionPerfil := 'SIN PERFIL ASIGNADO';
         END;
      END IF;
      -- ENC OPINATOR
      IF v_retorno.error = 'N' THEN
         v_retorno.veEncuesta := 'N';
         IF NVL(fug_obt_es_per_inhi(v_retorno.codigoCliente), 'X') = 'N' AND
               NVL(fug_es_empleado(v_retorno.codigoCliente), 'X') = 'N' THEN
            v_retorno.veEncuesta := 'S';
         END IF;
      END IF;
      -- RET NRO DOCUMENTO
      IF v_retorno.error = 'N' THEN
         v_retorno.nroDocumento := fue_obt_nro_doc_persona(v_retorno.codigoCliente);
      END IF;
      -- VALIDAR SESION EXISTENTE EN MISMO  CANAL
      DECLARE
         v_salt      VARCHAR2(32);
         v_authToken VARCHAR2(32);
         v_max_time     NUMBER;
         v_tie_restante VARCHAR(10);
         v_iniSesion     NUMBER:=0;
         MSG_LOGIN_SES_EXISTE         CONSTANT VARCHAR2(30) := 'L_SES_EXISTE';
      BEGIN
         --BBVAHB-750
         BEGIN
            BEGIN
               v_iniSesion := to_number(nvl(fug_obt_pardinamico('NUE_SESION_HB'), 30));
            EXCEPTION
               WHEN OTHERS THEN
                  v_iniSesion := 30;
            END;
            v_max_time  := v_iniSesion;--minutos
            v_iniSesion := v_iniSesion / 1440;
            SELECT cod_sesion
            INTO v_authToken
            FROM bw_aut_sesiones
            WHERE cod_persona = v_retorno.codigoCliente
               AND cod_canal = v_cod_canal
               AND fec_insercion > SYSDATE - v_iniSesion;

            pr_mensajeUsuario(MSG_LOGIN_SES_EXISTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

            BEGIN

               SELECT SUBSTR(to_char(((fec_ult_actividad + NUMTODSINTERVAL(fug_obt_pardinamico('NUE_SESION_HB'),'MINUTE')) -
                                         CAST(sysdate AS TIMESTAMP)), 'hh24:mi:ss'),15,5)
               INTO v_tie_restante
               FROM bw_aut_sesiones
               WHERE cod_persona = v_retorno.codigoCliente
                  AND cod_canal = v_cod_canal
                  AND (fec_ult_actividad +NUMTODSINTERVAL(fug_obt_pardinamico('NUE_SESION_HB'),'MINUTE')) > SYSDATE;

               --Redondemos para arriba para mostrar solo los minutos
                v_tie_restante := to_number(substr(v_tie_restante,0,2)) +1;
               -- Ajustamos el texto con el plazo de validez de la sesion
               v_retorno.descripcionRespuesta := replace(v_retorno.descripcionRespuesta,'%d', v_tie_restante);
            EXCEPTION
              WHEN OTHERS THEN
                 v_retorno.descripcionRespuesta := replace(v_retorno.descripcionRespuesta,'%d', v_max_time);
                 pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL, 'Error '
                    || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,
                    'Error: fec_ult_actividad '||sysdate||' -- '||SQLCODE||' => '||SUBSTR(SQLERRM, 1, 200),null),BITACORA_ERROR);
            END;
            pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL,
               'Error ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),BITACORA_ERROR);
            v_retorno.sesionUsuario := NULL;

         EXCEPTION
            WHEN OTHERS THEN
               pr_insertarBitacora(p_cod_persona, v_cod_canal, NULL, v_cod_operacion, NULL,
                  'Error ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,
                  'Error: '||SQLCODE||' => '||SUBSTR(SQLERRM, 1, 200),null), BITACORA_ERROR);
         END;
        END;

      -- GENERAR TOKEN
      IF v_retorno.error = 'N' THEN
         DECLARE
            v_salt VARCHAR2(32);
            v_authToken VARCHAR2(32);
         BEGIN
            SELECT paw_bce.fu_enc_md5(dbms_random.string('P', 20)) salt
            INTO v_salt FROM dual;
            v_authToken := paw_bce.fu_enc_md5(v_clave||v_salt||v_cod_canal);

            DELETE FROM bw_aut_sesiones
            WHERE cod_persona = v_retorno.codigoCliente AND cod_canal = v_cod_canal;

            INSERT INTO bw_aut_sesiones
               (cod_persona, cod_per_vinculada, cod_perfil, cod_canal, fec_ult_actividad, cod_sesion)
            VALUES
               (v_retorno.codigoCliente, NULL, v_retorno.codigoPerfil, v_cod_canal, FEC_HOR_ACTUAL, v_authToken);

            v_retorno.sesionUsuario := v_authToken;

            COMMIT;
            pr_insertarBitacora(p_cod_persona, v_cod_canal, v_retorno.sesionUsuario, v_cod_operacion,
              NULL, 'fu_ini_sesion' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
              v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
         END;

      END IF;
      v_retorno.estadoClaveTran := paw_seg.fu_verificarClaveTransaccional(v_retorno.codigoCliente, NULL);

      -- Registrar acceso -- 04/2018
      BEGIN
         IF NVL(v_retorno.error,'S') = 'N' THEN
            PAW_BAS.pr_reg_acc_cli_digitales(v_retorno.codigoCliente, v_cod_canal);
         END IF;
      EXCEPTION
         WHEN OTHERS THEN
            PAW_UTI.pr_insertarBitacora(v_retorno.codigoCliente, v_cod_canal, v_retorno.sesionUsuario, v_cod_operacion, NULL, 'PAW_BAS.pr_reg_acc_cli_digitales -' || SQLERRM, BITACORA_ERROR);
      END;
      --


      if(v_retorno.codigoEmpresa is null) then
         v_retorno.softoken:=paw_otp.fu_obtenerAsignacionSofttoken(v_retorno.codigoCliente,'F', null);
      else
         v_retorno.softoken:=paw_otp.fu_obtenerAsignacionSofttoken(v_retorno.codigoCliente,'J', v_retorno.codigoEmpresa);
      end if;
      --
      RETURN v_retorno;


   END;

   FUNCTION fu_reg_cla_privada(p_sesion IN BW_AUT_SESIONES.COD_SESION%TYPE,
                              p_cod_canal  IN BW_AUT_SESIONES.COD_CANAL%TYPE,
                              p_id_dispositivo IN BW_CLA_CLI_ACCESO.ID_DISPOSITIVO%TYPE,
                              p_cod_dispositivo IN BW_CLA_CLI_ACCESO.COD_DISPOSITIVO%TYPE,
                              p_cla_privada IN BW_CLA_CLI_ACCESO.CLA_PRIVADA%TYPE,
                              p_marca IN BW_CLA_CLI_ACCESO.MARCA%TYPE,
                              p_modelo IN BW_CLA_CLI_ACCESO.MODELO%TYPE,
                              p_sistema IN BW_CLA_CLI_ACCESO.SISTEMA%TYPE,
                              p_sis_version IN BW_CLA_CLI_ACCESO.SIS_VERSION%TYPE,
                              p_alias IN BW_CLA_CLI_ACCESO.ALIAS%TYPE,
                              p_modo IN VARCHAR2) RETURN typ_regclave IS

    v_cod_operacion CONSTANT VARCHAR2(3) := '007';
    v_retorno typ_regclave := typ_regclave();
    v_mensajeCaja    typ_mensajeCaja;
    retValidarSesion typ_validarSesion;
    v_id_dispositivo VARCHAR2(50);
    v_marca VARCHAR2(50);
    v_modelo VARCHAR2(50);
    v_sistema VARCHAR2(50);
    v_sis_version VARCHAR2(50);
    v_alias VARCHAR2(50);
    v_cla_privada VARCHAR2(1800);
    v_cod_dispositivo VARCHAR2(50);
    v_clave VARCHAR2(50);
    v_canal VARCHAR2(3);
    BEGIN
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       v_canal := NVL(p_cod_canal, '994');
       -- valida sesion del cliente
       retValidarSesion := fu_validarSesion(p_sesion, v_canal);
       v_id_dispositivo := depurarTextos(p_id_dispositivo, 50);
       IF p_marca IS NOT NULL THEN
          v_marca := depurarTextos(p_marca, 50);
       END IF;
       IF p_modelo IS NOT NULL THEN
          v_modelo := depurarTextos(p_modelo, 50);
       END IF;
       IF p_sistema IS NOT NULL THEN
          v_sistema := depurarTextos(p_sistema, 50);
       END IF;
       IF p_sis_version IS NOT NULL THEN
          v_sis_version := depurarTextos(p_sis_version, 50);
       END IF;
       IF p_alias IS NOT NULL THEN
          v_alias := depurarTextos(p_alias, 50);
       END IF;
       v_cla_privada := p_cla_privada;
       v_cod_dispositivo := p_cod_dispositivo;

       pr_insertarBitacora(retValidarSesion.codigoPersona,
          v_canal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,
          'reg_cla_privada:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta,
          retValidarSesion.descripcionRespuesta, null), BITACORA_ENTRADA);

       IF retValidarSesion.error = 'S' THEN
          v_retorno.error                := retValidarSesion.error;
          v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
          v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
       END IF;
       IF v_retorno.error <> 'S' THEN
          -- valida la caja origen
          v_mensajeCaja := lf_val_caja(retValidarSesion);
          IF v_mensajeCaja.error = 'S' THEN
             v_retorno.error                := v_mensajeCaja.error;
             v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
             v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
          END IF;
       END IF;
       IF v_retorno.error <> 'S' THEN
          PAW_SEG.pr_reg_cla_privada(retValidarSesion.codigoPersona,
                                     v_id_dispositivo,
                                     v_cod_dispositivo,
                                     v_cla_privada,
                                     v_marca,
                                     v_modelo,
                                     v_sistema,
                                     v_sis_version,
                                     v_alias,
                                     v_clave,
                                     v_retorno,
                                     p_modo);
       END IF;
       IF v_retorno.error <> 'S' THEN
          v_retorno.clave := v_clave;
          pr_insertarBitacora(retValidarSesion.codigoPersona, v_canal, p_sesion, v_cod_operacion, NULL, 'CLAVE PRIVADA PERSISTIDA'
             || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
       END IF;

       RETURN v_retorno;
    END;

   FUNCTION fu_reg_cla_softoken(p_sesion IN BW_AUT_SESIONES.COD_SESION%TYPE,
                              p_cod_canal  IN BW_AUT_SESIONES.COD_CANAL%TYPE,
                              p_nro_serial IN BW_SOF_SERIALES.NRO_SERIAL%TYPE,
                              p_cod_dispositivo IN BW_SOF_SERIALES.COD_DISPOSITIVO%TYPE,
                              p_cla_encriptacion IN BW_SOF_SERIALES.CLA_ENCRIPTACION%TYPE,
                              p_vec_inicializacion IN BW_SOF_SERIALES.VEC_INICIALIZACION%TYPE,
                              p_estado IN BW_SOF_SERIALES.ESTADO%TYPE)
                              RETURN typ_regsoftokenkey IS

    v_cod_operacion CONSTANT VARCHAR2(3) := '007';
    v_retorno typ_regsoftokenkey := typ_regsoftokenkey();
    v_mensajeCaja    typ_mensajeCaja;
    retValidarSesion typ_validarSesion;
    v_canal VARCHAR2(3);
    v_nro_serial VARCHAR2(20);
    v_cod_dispositivo VARCHAR2(100);
    v_cla_encriptacion VARCHAR2(24);
    v_vec_inicializacion VARCHAR2(24);
    v_estado VARCHAR2(1);

    BEGIN
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       v_canal := NVL(p_cod_canal, '994');
       -- valida sesion del cliente
       retValidarSesion := fu_validarSesion(p_sesion, v_canal);

       IF p_nro_serial IS NOT NULL THEN
          v_nro_serial := depurarTextos(p_nro_serial, 20);
       END IF;

       IF p_cod_dispositivo IS NOT NULL THEN
          v_cod_dispositivo := depurarTextos(p_cod_dispositivo, 100);
       END IF;

       v_cla_encriptacion := p_cla_encriptacion;
       v_vec_inicializacion := p_vec_inicializacion;

       IF P_estado IS NOT NULL THEN
          v_estado := depurarTextos(P_estado, 1);
       END IF;

       pr_insertarBitacora(retValidarSesion.codigoPersona,
          v_canal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,
          'reg_cla_softoken:' || fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta,
          retValidarSesion.descripcionRespuesta, null), BITACORA_ENTRADA);

       IF retValidarSesion.error = 'S' THEN
          v_retorno.error                := retValidarSesion.error;
          v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
          v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
       END IF;
       IF v_retorno.error <> 'S' THEN
          -- valida la caja origen
          v_mensajeCaja := lf_val_caja(retValidarSesion);
          IF v_mensajeCaja.error = 'S' THEN
             v_retorno.error                := v_mensajeCaja.error;
             v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
             v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
          END IF;
       END IF;
       IF v_retorno.error <> 'S' THEN
          PAW_SEG.pr_reg_cla_softoken(v_nro_serial,
                                        retValidarSesion.codigoPersona,
                                        v_cod_dispositivo,
                                        v_cla_encriptacion,
                                        v_vec_inicializacion,
                                        v_estado,
                                        v_retorno);
       END IF;
       IF v_retorno.error <> 'S' THEN
          pr_insertarBitacora(retValidarSesion.codigoPersona, v_canal, p_sesion, v_cod_operacion, NULL, 'CLAVE SOFTOKEN PERSISTIDA'
             || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
       END IF;

       RETURN v_retorno;
    END;

   FUNCTION fu_obt_tar_debito(p_sesion      IN VARCHAR2,
                              p_codCanal    IN VARCHAR2) RETURN typ_obtenerDetalleCuentas IS
   v_retorno        typ_obtenerDetalleCuentas := typ_obtenerDetalleCuentas();
   v_cod_operacion  VARCHAR2(3) := '702';
   retValidarSesion typ_validarSesion;
   v_mensajeCaja    typ_mensajeCaja;
   v_listaCuentas typ_listaDetalleCuenta := typ_listaDetalleCuenta();

   CURSOR tarjetas(p_cod_persona VARCHAR2) IS
      SELECT c.cod_persona, s.embozado embozado, s.nro_cuenta, cu.cod_modulo,cu.cod_modalidad, s.nro_tarjeta nro_tarjeta
      FROM ah_tar_debitos s, ge_cta_clientes c, ge_cuentas cu, ge_est_cuentas e
      WHERE s.fec_vencimiento > SYSDATE
         AND s.fec_cancelacion IS NULL
         AND c.cod_persona = p_cod_persona
         AND s.tar_activa = 'S'
         AND c.cod_persona = s.cod_persona
         AND c.relacion = 'P'
         AND cu.nro_cuenta = c.nro_cuenta
         AND cu.nro_cuenta = s.nro_cuenta
         AND c.cod_modulo != 7
         AND c.cod_modalidad <> 36
         AND e.cod_modulo = cu.cod_modulo
         AND e.cod_modalidad = cu.cod_modalidad
         AND e.estado = cu.estado
         AND e.activo = 'S'
         AND cu.estado <> 'X';

   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- valida sesion del cliente
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);
      --

      pr_insertarBitacora(retValidarSesion.codigoPersona,
            p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,
            'obtener tar debitos:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta,
            retValidarSesion.descripcionRespuesta, null), BITACORA_ENTRADA);

      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      END IF;

      IF v_retorno.error <> 'S' THEN
         -- valida la caja origen
         v_mensajeCaja := lf_val_caja(retValidarSesion);
         IF v_mensajeCaja.error = 'S' THEN
            v_retorno.error                := v_mensajeCaja.error;
            v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         END IF;
      END IF;
      IF v_retorno.error <> 'S' THEN
         FOR tar IN tarjetas(retValidarSesion.codigoPersona)
         LOOP
             DECLARE
                detalleCuenta typ_detalleCuenta := typ_detalleCuenta;
             BEGIN
                detalleCuenta.denominacion := tar.embozado;
                detalleCuenta.numeroTarjeta := tar.nro_tarjeta;
                v_listaCuentas.EXTEND;
                v_listaCuentas(v_listaCuentas.COUNT) := detalleCuenta;

             END;
         END LOOP;
         v_retorno.listaCuentas := v_listaCuentas;
         v_retorno.cantCuentas := v_listaCuentas.Count;
      END IF;

      RETURN v_retorno;
   END;
   FUNCTION fu_obt_cda_cupones(p_sesion      IN VARCHAR2,
                                     p_codCanal            IN VARCHAR2,
                                     p_nroCuentaEspecifica IN VARCHAR2) RETURN typ_obtenerDatosCda IS

      MSG_OBT_CTADET_CTA_INEXISTENTE CONSTANT VARCHAR2(15) := 'OBTCTADET_CTAIX';
      v_nro_cta_especifica VARCHAR2(16) := '';
      v_cod_modalidad      NUMBER(3) := 0;
      v_nro_cta_credito    VARCHAR2(18) := '';
      v_tipo_cuenta        VARCHAR2(240) := '';
      v_estado             VARCHAR2(240) := '';
      v_per_liq_intereses  VARCHAR(240) := '';
      v_cod_moneda         VARCHAR2(3) := '';
      v_desc_moneda        VARCHAR2(35) := '';
      v_total_interes      NUMBER(18,2) := 0;
      v_sucursal           VARCHAR2(35) := '';
      v_can_detalles       NUMBER(3); -- cantidad de cuentas
      v_monto1             NUMBER(18, 2) := 0; -- monto 1
      v_val_tasa           NUMBER(20, 4) := NULL;
      v_fec_inicio         DATE;
      v_fec_vencimiento    DATE;
      COD_OPERACION  VARCHAR2(3) := '020';
      v_fec_actual   DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
      userInfo       typ_validarSesion;
      v_listaCupones typ_listaDetalleCuponesCda := typ_listaDetalleCuponesCda();
      v_permiso      typ_obtenerPermisos;
      v_retorno      typ_obtenerDatosCda := typ_obtenerDatosCda;
      v_logmessage   VARCHAR(1000);
      v_plazo_dias   NUMBER(18,2);
      v_nro_certificado    NUMBER;
      v_can_cupones      NUMBER(5) := 0;
      CURSOR cdas(p_nro_cuenta IN VARCHAR2) IS
      SELECT acc.capital as capital_cab, SUM(ac.mto_interes) as int_pendiente, nvl(acc.sal_retenido, 0) as sal_retenido, 0, fug_obt_val_tasa(acc.cod_modulo, acc.cod_modalidad, acc.cod_oficina, acc.nro_cuenta, acc.cod_moneda, acc.capital, acc.tas_personalizada, acc.cod_tasa, NULL, v_fec_actual) val_tasa, acc.fec_apertura as fec_apertura_cab, acc.fec_vencimiento as fec_vencimiento_cab, 0 as monto, 'N' as estado_cab, (SELECT acc.fec_vencimiento - acc.fec_apertura FROM dual) AS plazo_dias, acc.nro_certificado as nro_certificado, ac.nro_cupon as nro_cupon, ac.fec_vencimiento as fec_vencimiento_det, ac.mto_interes as monto_interes, ac.estado as estado_det, ac.fec_pago as fec_pago_det
      FROM ah_cta_certificados acc inner join ah_cupones ac
      on acc.nro_cuenta = ac.nro_cuenta and acc.nro_cuenta = p_nroCuentaEspecifica
      GROUP BY acc.capital, acc.sal_retenido, acc.cod_modulo, acc.cod_modalidad, acc.cod_oficina, acc.cod_moneda, acc.tas_personalizada, acc.cod_tasa, acc.nro_cuenta, ac.nro_cupon, acc.fec_apertura, acc.fec_vencimiento, acc.nro_certificado, ac.nro_cupon, ac.fec_vencimiento, ac.mto_interes, ac.estado, ac.fec_pago
      ORDER BY ac.nro_cupon;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- 0. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      BEGIN
         select desc_sucursal, tipo_cuenta, cod_modalidad, fec_apertura_cab, fec_vencimiento_cab, val_tasa, plazo_dias, desc_moneda, cod_moneda, capital_cab, nro_certificado, nro_cta_credito, estado, per_liq_intereses
         into v_sucursal, v_tipo_cuenta, v_cod_modalidad, v_fec_inicio, v_fec_vencimiento, v_val_tasa, v_plazo_dias, v_desc_moneda, v_cod_moneda, v_monto1, v_nro_certificado, v_nro_cta_credito, v_estado, v_per_liq_intereses from (
            SELECT substr(fue_obt_des_oficina(acc.cod_oficina), 1, 35) as desc_sucursal, FUE_OBT_DES_REFCODES('TIP_CERTIFICADO', acc.tipo) as tipo_cuenta, acc.cod_modalidad as cod_modalidad, acc.capital as capital_cab, ac.mto_interes as int_pendiente, nvl(acc.sal_retenido, 0) as sal_retenido, 0, fug_obt_val_tasa(acc.cod_modulo, acc.cod_modalidad, acc.cod_oficina, acc.nro_cuenta, acc.cod_moneda, acc.capital, acc.tas_personalizada, acc.cod_tasa, NULL, v_fec_actual) val_tasa, acc.fec_apertura as fec_apertura_cab, acc.fec_vencimiento as fec_vencimiento_cab, (SELECT acc.fec_vencimiento - acc.fec_apertura FROM dual) AS plazo_dias, acc.nro_certificado as nro_certificado, acc.nro_cta_credito as nro_cta_credito, FUE_OBT_DES_REFCODES('EST_TITULOS', acc.estado) as estado, FUE_OBT_DES_REFCODES('TIP_CAPITALIZACION', acc.tip_capitalizacion) as per_liq_intereses, fue_obt_des_moneda(acc.cod_moneda) as desc_moneda, acc.cod_moneda as cod_moneda
            FROM ah_cta_certificados acc inner join ah_cupones ac
               on acc.nro_cuenta = ac.nro_cuenta and acc.nro_cuenta = p_nroCuentaEspecifica)
               where rownum = 1;
      EXCEPTION
         WHEN NO_DATA_FOUND THEN
             pr_mensajeUsuario(MSG_OBT_CTADET_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa,
               'Nro. CUENTA:' || p_nroCuentaEspecifica || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,
               v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         WHEN OTHERS THEN
              pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obt_cda_cupones -' || SQLERRM, BITACORA_ERROR);
      END;
      BEGIN
        select sum(mto_interes) into v_total_interes from ah_cupones ac where ac.estado = 'E' and ac.nro_cuenta = p_nroCuentaEspecifica;
      END;
      --Logear parametros
      v_logmessage := substr('obtenerDatosCda(nroCuentaEspecifica=' || p_nroCuentaEspecifica || ')',0,999);
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);
      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- control de permisos
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userinfo.codigoEmpresa, 'lf_obt_permisos - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_nro_cta_especifica := depurarAlfanumerico(p_nroCuentaEspecifica, 16);
      IF v_retorno.error = 'N' THEN
         IF lf_val_cta_origen(v_nro_cta_especifica, nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)) = 'N' THEN
              -- no es una cuenta del cliente
              pr_mensajeUsuario('CODCTA_INVAL', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'lf_val_cta_origen(nro_cta_esp) - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           END IF;
      end if;
      -- 2. busco los datos de la cuentas
      IF v_retorno.error = 'N' THEN
         v_can_detalles := 0;
               --- Debe controlar para que no muestre cuentas juridicas entre las cuentas del cliente
               IF PAW_UTI.fu_es_juridica(v_nro_cta_especifica, userInfo.codigoEmpresa, userInfo.codigoPersona) = 'N' THEN
                  v_retorno.capital           := substr(lf_for_money(v_monto1), 1, 16);
                  v_retorno.numeroCuenta      := substr(v_nro_cta_especifica, 0, 17);
                  v_retorno.numeroCertificado := v_nro_certificado;
                  v_retorno.nroCtaCredito      := v_nro_cta_credito;
                  v_retorno.estado             := v_estado;
                  v_retorno.periodoLiqInteres  := v_per_liq_intereses;
                  v_retorno.tipoCuenta     := v_tipo_cuenta;
                  v_retorno.descMoneda      := v_desc_moneda;
                  v_retorno.codMoneda       := v_cod_moneda;
                  v_retorno.fechaApertura  := v_fec_inicio;
                  v_retorno.fechaVencimiento := v_fec_vencimiento;
                  v_retorno.totalInteresACobrar := v_total_interes;
                  v_retorno.tasaInteres         := v_val_tasa;
                  v_retorno.plazoDias           := v_plazo_dias;
                  v_retorno.sucursal            := v_sucursal;
                  BEGIN
                     IF v_cod_modalidad IN (33, 34, 35, 36) THEN
                        -- cda
                        v_can_cupones := 0;
                         FOR cda IN cdas(p_nroCuentaEspecifica)
                         LOOP
                             v_can_cupones                  := v_can_cupones + 1;
                             DECLARE
                                 detalleCuponesCda typ_detalleCuponesCda := typ_detalleCuponesCda;
                             BEGIN
                                 v_can_detalles := v_can_detalles + 1;
                                 v_monto1                        := cda.capital_cab;
                                 detalleCuponesCda.nroCupon         := cda.nro_cupon;
                                 detalleCuponesCda.montoInteres     := cda.monto_interes;
                                 detalleCuponesCda.fechaVencimiento := cda.fec_vencimiento_det;
                                 detalleCuponesCda.estado           := cda.estado_det;
                                 detalleCuponesCda.fechaPago        := cda.fec_pago_det;
                                 v_listaCupones.EXTEND;
                                 v_listaCupones(v_listaCupones.COUNT) := detalleCuponesCda;
                             END;
                         END LOOP;
                         v_retorno.cantidadCupones := v_can_cupones;
                     END IF;
                  EXCEPTION
                     WHEN OTHERS THEN
                        --p_cod_respuesta := paw_bce.v_cod_cta_inexistente;
                        pr_mensajeUsuario(MSG_OBT_CTADET_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'cta: '|| v_nro_cta_especifica ||', mad:' || v_cod_modalidad || ', ORA-ERR: ' || SQLERRM || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL) || SQLERRM, BITACORA_ERROR);
                  END;
               END IF;
         IF v_can_detalles = 0 THEN
            -- no tiene detalles
            -- p_cod_respuesta  := paw_bce.v_cod_cta_inexistente;
            pr_mensajeUsuario(MSG_OBT_CTADET_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obtenerDetalleCuentas - Cuenta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) ||sqlerrm, BITACORA_ERROR);
         END IF;
      END IF;
      -- registro del movimiento
      lp_reg_operacion(v_nro_cta_especifica /*p_nro_cuenta*/, NULL /*p_cod_moneda */, NULL /*p_monto*/, NULL /*p_nro_cta_contra*/, NULL /*p_cantidad*/, /*p_dato*/ NULL, NULL, NULL, NULL, NULL, userInfo.codigoPersona, COD_OPERACION, userinfo.codigoPersona || p_codCanal, p_codCanal, p_sesion, userInfo.codigoEmpresa);
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obtenerDetalleCuentas-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      IF v_retorno.error = 'N' THEN
         -- todo ok, se arma el mensaje de respuesta
         v_retorno.listaCupones := v_listaCupones;
         RETURN v_retorno;
      ELSE
         RETURN v_retorno;
      END IF;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obt_cda_cupones -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;
   FUNCTION fu_obt_sal_por_fecha(p_sesion     IN VARCHAR2,
                               p_codCanal      IN VARCHAR2,
                               p_nroCuenta     IN VARCHAR2 DEFAULT NULL,
                               p_fechaInicial  IN DATE,
                               p_fechaFinal    IN DATE) RETURN typ_saldosdiarios IS

     v_retorno                 typ_saldosdiarios := typ_saldosdiarios;
     v_saldoAnterior           NUMBER(18,2)  := 0;
     v_saldoActual             NUMBER(18,2)  := 0;
     userInfo                  typ_validarSesion := NULL;
     v_msg_error               VARCHAR2(15) := NULL;
     COD_OPERACION             VARCHAR2(3) := '020';

     BEGIN
       -- 0. valido la clave del cliente
       userInfo := fu_validarSesion(p_sesion, p_codCanal);
       IF userInfo.error = 'N' THEN
           v_retorno.error := 'N';
           IF p_nroCuenta IS NOT NULL THEN
              select sal_tot_cap
              into v_saldoAnterior
              from ge_sal_diarios
              where nro_cuenta = p_nroCuenta
              and trunc(fecha) < p_fechaInicial
              and rownum = 1
              order by fecha desc;

              IF (v_saldoAnterior IS NULL) OR (v_saldoAnterior = '') THEN
                 v_msg_error := 'ERR_CON_SALDOS';
                 pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa,
                                 'fu_obt_sal_por_fecha - No se encontraron datos iniciales-' || fu_generarBitacora(v_retorno.error,
                                 v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) ||sqlerrm, BITACORA_ERROR);
              END IF;

              --Fecha final distinta que la de hoy el saldo se trae de sal_diarios
              --Fecha final igual que la de hoy se calcula con los movimientos
              IF p_fechaFinal != TRUNC(SYSDATE) THEN
                 select sal_tot_cap
                 into v_saldoActual
                 from ge_sal_diarios
                 where nro_cuenta = p_nroCuenta
                 and trunc(fecha) <= p_fechaFinal
                 and rownum = 1
                 order by fecha desc;

                 IF (v_saldoActual IS NULL) OR (v_saldoActual = '') THEN
                    v_msg_error := 'ERR_CON_SALDOS';
                    pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa,
                                 'fu_obt_sal_por_fecha - No se encontraron datos finales-' || fu_generarBitacora(v_retorno.error,
                                 v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) ||sqlerrm, BITACORA_ERROR);
                 END IF;

              ELSE
                 v_saldoActual := NULL;
              END IF;
           ELSE
              v_msg_error := 'CTA_INVALIDA';
              pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa,
                                 'fu_obt_sal_por_fecha - Cuenta invalida-' || fu_generarBitacora(v_retorno.error,
                                 v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) ||sqlerrm, BITACORA_ERROR);
           END IF;
       ELSE
           v_msg_error := 'L_AUTH_ERROR';
           pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa,
                                 'fu_obt_sal_por_fecha - Error de validación del cliente -' || fu_generarBitacora(v_retorno.error,
                                 v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) ||sqlerrm, BITACORA_ERROR);
       END IF;
       v_retorno.nroCuenta   := p_nroCuenta;
       v_retorno.salAnterior := v_saldoAnterior;
       v_retorno.salActual   := v_saldoActual;
       return v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
           v_msg_error := 'ERR_CON_SALDOS';
           pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa,
                                 'fu_obt_sal_por_fecha - Error -' || fu_generarBitacora(v_retorno.error,
                                 v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) ||sqlerrm, BITACORA_ERROR);
   END;
   -- FIN fu_obt_sal_por_fecha

   FUNCTION fu_solicitudPlazoFijo(p_sesion IN VARCHAR2,
                                  p_codigoCanal IN VARCHAR2,
                                  p_modo IN VARCHAR2,
                                  p_codigoModulo IN NUMBER,
                                 p_xmlData IN VARCHAR2) RETURN typ_preaprobado IS
      v_cod_persona       ba_personas.cod_persona%TYPE;
      v_nro_cuenta        ge_cuentas.nro_cuenta%TYPE := NULL;
      v_cod_moneda        ge_cuentas.cod_moneda%TYPE;
      v_cod_modulo        ba_modulos.cod_modulo%TYPE;
      v_cod_modalidad     ge_modalidades.cod_modalidad%TYPE := 37;
      v_cod_tra_padre     ge_transacciones.cod_transaccion%TYPE := NVL(fug_obt_pardinamico('COD_TRA_APE_PLZ_FIJO'),2203); -- 2203
      v_cod_mon_cuenta    ge_cuentas.cod_moneda%TYPE;
      v_cod_mod_cuenta    ge_cuentas.cod_modulo%TYPE;
      v_cod_mad_cuenta    ge_cuentas.cod_modalidad%TYPE;
      v_cod_ofi_cuenta    ge_cuentas.cod_oficina%TYPE;
      v_cta_for_credito   ge_cuentas.denominacion%TYPE;
      v_nom_cuenta        ge_cuentas.denominacion%TYPE;
      v_usu_sesion        typ_validarsesion;
      v_msj_caja          typ_mensajeCaja;
      v_retorno           typ_preaprobado := typ_preaprobado();
      v_permiso           typ_obtenerPermisos;
      v_msj_respuesta     typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_fec_proceso       ge_movimientos.fecha%TYPE := pag_cal.FU_OBT_FEC_ACTUAL(3);
      v_plazo             cr_piz_plazos.plz_desde%TYPE;
      v_plz_pago          cr_piz_plazos.plz_desde%TYPE;
      v_plazo_dias        cr_piz_plazos.plz_desde%TYPE;
      v_mto_operacion     ge_movimientos.monto%TYPE;
      v_mto_minimo        ge_movimientos.monto%TYPE;
      v_val_tasa          ah_cta_plazos.val_tasa%TYPE;
      v_mto_debito        ge_movimientos.monto%TYPE;
      v_tot_interes       ge_movimientos.monto%TYPE;
      v_observacion       bw_movimientos.observacion%TYPE;
      v_dir_ip            bw_movimientos.dir_ip%TYPE;
      v_parametros        bw_movimientos.parametros%TYPE;
      v_xml_data          xmltype;
      v_modo              VARCHAR2(1);
      v_cod_operacion     VARCHAR2(3) := '120';
      v_msj_bitacora      VARCHAR2(1000);
      v_error             VARCHAR2(1000);
      v_horario           VARCHAR2(1);
      v_es_mov_noc        VARCHAR2(1);
      v_es_cta_noc        VARCHAR2(1);
      v_cod_canal         ge_canales.cod_canal%TYPE;
      v_des_canal         ge_canales.descripcion%TYPE;
      v_est_modulo        ba_modulos.estado%TYPE;
      v_deb_cta_web       ge_par_dinamicos.val_parametro%TYPE := nvl(fug_obt_pardinamico('PLZ_FIJ_DEB_CTA_WEB'), 'N');
      v_nro_cta_plazo     ge_cuentas.nro_cuenta%TYPE;
      v_cta_generada      typ_cuentaGenerada := typ_cuentaGenerada();
      v_tip_pag_interes   VARCHAR2(1000);
      v_fec_pri_vto       ah_cupones.fec_vencimiento%TYPE;
      v_des_plz_pago      ba_cod_referencias.abreviatura%TYPE;
      v_plz_max_pfd       NUMBER;
      v_plz_min_pfd       NUMBER;
      --
      C_REF_PAG_INT       ba_cod_referencias.dominio%TYPE := 'TIP_CAPITALIZACION';
      C_PAR_MTO_MIN_PFD   ge_par_dinamicos.parametro%TYPE := 'MTO_MIN_AHO_PLZ_FIJ_DIGITAL';
      C_PAR_PLZ_MIN_PFD   ge_par_dinamicos.parametro%TYPE := 'PLZ_MIN_AHO_PLZ_FIJ_DIGITAL';
      C_PAR_PLZ_MAX_PFD   ge_par_dinamicos.parametro%TYPE := 'PLZ_MAX_AHO_PLZ_FIJ_DIGITAL';
      MSG_OPE_INVALIDA    CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_PRO_ERR_DAT_INV CONSTANT VARCHAR2(15) := 'PRO_ERR_DAT_INV';
      MSG_SIS_CIERRE      CONSTANT VARCHAR2(15) := 'HOR_SIS_CIERRE';
      MSG_ERR_MTO_MIN     CONSTANT VARCHAR2(15) := 'PFD_ERR_MTO_MIN';
      MSG_ERR_APE_CTA     CONSTANT VARCHAR2(15) := 'PFD_ERR_APE_CTA';
      MSG_ERR_GEN_MOV     CONSTANT VARCHAR2(15) := 'PFD_ERR_GEN_MOV';
      MSG_NRO_CTA_INV     CONSTANT VARCHAR2(15) := 'G_NROCTAINVALID';
      MSG_ERR_TASA        CONSTANT VARCHAR2(15) := 'PFD_ERR_TASA';
      MSG_ERR_PLZ_MIN     CONSTANT VARCHAR2(15) := 'PFD_ERR_PLZ_MIN';
      MSG_ERR_PLZ_MAX     CONSTANT VARCHAR2(15) := 'PFD_ERR_PLZ_MAX';
      --
      FUNCTION lf_val_datos RETURN typ_mensajeRespuesta IS
         v_retorno   typ_mensajeRespuesta := typ_mensajeRespuesta;
         V_EXISTE    VARCHAR2(1);
      BEGIN
         PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         IF v_nro_cuenta IS NULL OR v_mto_operacion IS NULL OR v_cod_tra_padre IS NULL OR v_plz_pago IS NULL THEN
            PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            RETURN v_retorno;
         END IF;
         IF NVL(v_mto_operacion,0) < NVL(v_mto_minimo,0) THEN --validar monto minimo
            PAW_UTI.pr_mensajeUsuario(MSG_ERR_MTO_MIN, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            RETURN v_retorno;
         END IF;
         BEGIN
           SELECT 'S'
             INTO V_EXISTE
             FROM ge_transacciones a
            WHERE a.cod_transaccion = v_cod_tra_padre
              AND ROWNUM = 1;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               RETURN v_retorno;
         END;
         IF v_plazo < TRUNC(v_plz_min_pfd/30) THEN
            PAW_UTI.pr_mensajeUsuario(MSG_ERR_PLZ_MIN, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            RETURN v_retorno;
         END IF;
         IF v_plazo > TRUNC(v_plz_max_pfd/30) THEN
            PAW_UTI.pr_mensajeUsuario(MSG_ERR_PLZ_MAX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            RETURN v_retorno;
         END IF;
          v_plazo           := depurarNumerico(v_xml_data.extract('/product/installment/text()').getNumberVal(), 3);
          v_plz_pago        := depurarNumerico(v_xml_data.extract('/product/payTerm/text()').getNumberVal(), 3);
         IF v_plz_pago != 99 AND v_plz_pago > v_plazo THEN
            PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            RETURN v_retorno;
         END IF;
         RETURN v_retorno;
      EXCEPTION
        WHEN OTHERS THEN
          PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          RETURN v_retorno;
      END;
      --
      FUNCTION lf_tip_pag_interes RETURN VARCHAR2 IS
         v_retorno VARCHAR2(4000);
         CURSOR c_tip IS
            SELECT DISTINCT p.tip_capitalizacion
              FROM cr_piz_montos m, cr_piz_plazos p
             WHERE m.cod_moneda = p.cod_moneda
               AND m.cod_moneda = v_cod_moneda
               AND m.mto_desde = p.mto_desde
               AND m.cod_modulo = p.cod_modulo
               AND m.cod_modalidad = p.cod_modalidad
               AND NVL(m.cod_sub_modalidad, -1) = NVL(p.cod_sub_modalidad, -1)
               AND m.cod_modulo = v_cod_modulo
               AND m.cod_modalidad = v_cod_modalidad
               AND (v_plazo * 30) BETWEEN p.plz_desde AND p.plz_hasta
               AND v_mto_operacion BETWEEN m.mto_desde AND m.mto_hasta
               ORDER BY 1;
      BEGIN
         FOR r IN c_tip LOOP
           IF v_retorno IS NULL THEN
              v_retorno := r.tip_capitalizacion;
           ELSE
              v_retorno := v_retorno||','||r.tip_capitalizacion;
           END IF;
         END LOOP;
         RETURN v_retorno;
      EXCEPTION
         WHEN OTHERS THEN
            RETURN NULL;
      END;
      --
      FUNCTION lf_obt_pri_vencimiento RETURN DATE IS
         v_retorno DATE;
      BEGIN
         SELECT MIN(a.fec_vencimiento)
           INTO v_retorno
           FROM ah_cupones a
          WHERE a.nro_cuenta = v_nro_cta_plazo;
         RETURN v_retorno;
      EXCEPTION
         WHEN OTHERS THEN
            RETURN NULL;
      END;
   BEGIN
      PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_retorno.listaDetalles := typ_listaEtiquetaValor();
      v_modo                  := substr(TRIM(p_modo), 1, 1);
      v_cod_modulo            := p_codigoModulo;
      v_msj_bitacora          := substr('cod_mod:' || v_cod_modulo || ', mod: ' || v_modo, 1, 700);
      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion, 32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      v_cod_persona := nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona);
      PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                  v_msj_bitacora || ' ' || PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                  PAW_UTI.BITACORA_ENTRADA);
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' || PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 3. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_permiso      := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      v_msj_bitacora := v_msj_bitacora || ', perf: ' || v_usu_sesion.codigoPerfil;
      IF v_permiso.error = 'S' THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' || PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- validamos el modulo
      IF v_cod_modulo != 3 THEN -- Modulo Ahorros
         PAW_UTI.pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' || PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- validamos el horario
      --No se puede realizar transacciones con estado distinto a 2
      v_est_modulo   := pae_cnf.FU_OBT_EST_MODULO(v_cod_modulo);
      v_msj_bitacora := v_msj_bitacora || ', est_mod: ' || v_est_modulo;
      IF v_est_modulo != 2 THEN -- En cierre.
         PAW_UTI.pr_mensajeUsuario(MSG_SIS_CIERRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', lp_ver_horario()-Sistema en cierre-', PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_msj_respuesta := lp_ver_horario(v_horario,
                                        v_es_mov_noc,
                                        v_es_cta_noc,
                                        v_msj_caja.fechaUltimoCierre, -- IN
                                        v_msj_caja.codigoOficinaOrigen, -- IN
                                        v_fec_proceso);
      IF v_msj_respuesta.error = 'S' THEN
         v_retorno.error                := v_msj_respuesta.error;
         v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' ||
                                     fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- sin problemas hasta aqui
      IF p_xmlData IS NOT NULL THEN
         -- obtenemos el canal
         SELECT decode(p_codigoCanal, 994, 30, -- mobile
                       29), -- web
                decode(p_codigoCanal, 994, 'Móvil', -- mobile
                       'Homebanking') -- web
           INTO v_cod_canal, v_des_canal
           FROM DUAL;
         -- parseamos los datos de entrada
         v_xml_data := xmltype.createxml(p_xmlData);
         -- Ver datos
         BEGIN
            BEGIN
               v_nro_cuenta := depurarAlfanumerico(v_xml_data.extract('/product/debitAccount/text()').getStringVal(), CUENTA_TAMANO);
            EXCEPTION
               WHEN OTHERS THEN
                  v_nro_cuenta := '0000000000';
            END;
            v_cod_moneda      := fug_obt_mon_cta(v_nro_cuenta); -- Obtener la Moneda de la Cuenta
            v_mto_operacion   := v_xml_data.extract('/product/amount/text()').getNumberVal();
            v_plazo           := depurarNumerico(v_xml_data.extract('/product/installment/text()').getNumberVal(), 3);
            v_plz_pago        := depurarNumerico(v_xml_data.extract('/product/payTerm/text()').getNumberVal(), 3);
            v_mto_minimo    := nvl(fug_obt_pardinamico(C_PAR_MTO_MIN_PFD,NULL,NULL,v_cod_moneda),0);
            v_plz_max_pfd   := to_number(nvl(fug_obt_pardinamico(C_PAR_PLZ_MAX_PFD), '1080'));
            v_plz_min_pfd   := to_number(nvl(fug_obt_pardinamico(C_PAR_PLZ_MIN_PFD), '90'));
            v_msj_respuesta := lf_val_datos();
            v_msj_bitacora  := v_msj_bitacora || ', cta:' || v_nro_cuenta  || ', mto:' || v_mto_operacion || ', plz:' || v_plazo || ', plz_pago:' || v_plz_pago || ', tasa:' || v_val_tasa;
            IF v_msj_respuesta.error = 'S' THEN
               v_retorno.error                := v_msj_respuesta.error;
               v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
               PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                           v_msj_bitacora || ' ' ||
                                           PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                           PAW_UTI.BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
            v_val_tasa        := PAW_BAS.fu_obt_tas_pizarra(v_plazo,v_mto_operacion,v_cod_moneda,v_cod_modulo,v_cod_modalidad,NULL,v_plz_pago);
            IF v_val_tasa IS NULL THEN
               PAW_UTI.pr_mensajeUsuario(MSG_ERR_TASA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               v_tip_pag_interes := lf_tip_pag_interes;
               IF v_tip_pag_interes IS NOT NULL THEN
                  v_retorno.descripcionRespuesta := v_retorno.descripcionRespuesta || ' - Tipo/s de Pago/s de Interes Permitido/s: '||v_tip_pag_interes;
               END IF;
               PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                           v_msj_bitacora || ' ' ||
                                           PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                           PAW_UTI.BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
         EXCEPTION
            WHEN OTHERS THEN
               PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                           'Formato parametro XML no valido - ' || v_msj_bitacora || ' ' ||
                                           PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                           PAW_UTI.BITACORA_ERROR);
               RETURN v_retorno;
         END;
      ELSE
        PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                    'Formato parametro XML no valido - ' || v_msj_bitacora || ' ' ||
                                    fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                    PAW_UTI.BITACORA_ERROR);
        RETURN v_retorno;
      END IF;
      v_retorno.codigoMoneda := v_cod_moneda;
      v_retorno.codigoModulo := v_cod_modulo;
      v_retorno.montoMinimo := v_mto_minimo;
    --Valida que la cuenta corresponda al cliente
    IF lf_val_cta_origen(v_nro_cuenta, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigopersona)) = 'N' THEN
       PAW_UTI.pr_mensajeUsuario(MSG_NRO_CTA_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' ||
                                     PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- Validar inhibidos
      IF fug_obt_inhibicion(fug_obt_pardinamico('COD_CAU_DEM_JUDICIAL'),  nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigopersona), v_nro_cuenta) THEN
         PAW_UTI.pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' ||
                                     PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- proceso segun modo
      IF v_modo = 'V' THEN
         -- Realizar Debito de Cuentas Pendientes -- Validar por parámetro dinamico
         IF NVL(v_deb_cta_web,'N') = 'S' THEN
            PAW_BAS.pr_pro_deb_automatico(v_nro_cuenta,v_mto_debito,v_error);
            IF v_error IS NOT NULL THEN
               PAW_UTI.pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                 v_msj_bitacora || ' ' || PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                 PAW_UTI.BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
            IF NVL(v_mto_debito,0)>0 THEN
               v_val_tasa      := PAW_BAS.fu_obt_tas_pizarra(v_plazo,v_mto_operacion,v_cod_moneda,v_cod_modulo,v_cod_modalidad,NULL,v_plz_pago);
               v_msj_respuesta := lf_val_datos();
               v_msj_bitacora  := v_msj_bitacora || 'lf_val_datos(), cta:' || v_nro_cuenta  || ', mto:' || v_mto_operacion || ', plz:' || v_plazo || ', plz_pago:' || v_plz_pago || ', tasa:' || v_val_tasa;
               IF v_msj_respuesta.error = 'S' THEN
                  v_retorno.error                := v_msj_respuesta.error;
                  v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
                  PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                              v_msj_bitacora || ' ' ||
                                              PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                              PAW_UTI.BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;
            END IF;
         END IF;
         -- Calculo de Pago de Intereses
         v_plazo_dias    := v_plazo*30;
         v_tot_interes   := ROUND(pag_gen.fu_cal_int_simple(v_mto_operacion,v_plazo_dias,v_val_tasa));
         v_retorno.monto := v_mto_operacion;
      ELSIF v_modo = 'C' THEN
         -- Validar Cuenta Debito
         v_msj_respuesta := lf_val_cta_debito(v_nro_cuenta,
                                              v_cod_tra_padre,
                                              v_mto_operacion,
                                              v_cod_mon_cuenta,
                                              v_cod_mod_cuenta,
                                              v_cod_mad_cuenta,
                                              v_cod_ofi_cuenta,
                                              v_cta_for_credito,
                                              v_nom_cuenta,
                                              v_usu_sesion,
                                              v_msj_caja,
                                              v_cod_modulo,
                                              v_cod_modalidad
                                              );
         IF v_msj_respuesta.error = 'S' THEN
            v_retorno.error                := v_msj_respuesta.error;
            v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
            PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                        v_msj_bitacora || ' ' ||
                                        PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                        PAW_UTI.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- Generar Cuenta de Plazo Fijo y Cupones
         v_cta_generada := PAW_BAS.fu_ape_cta_plazo(p_sesion, v_cod_persona, v_cod_canal,
                                                    p_codigoCanal, v_plz_pago, v_nro_cuenta,
                                                    v_mto_operacion, v_plazo);
         v_nro_cta_plazo := v_cta_generada.NRO_CUENTA;
         IF v_cta_generada.error = 'S' THEN
            PAW_UTI.pr_mensajeUsuario(MSG_ERR_APE_CTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                        v_msj_bitacora || ' ' ||
                                        PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                        PAW_UTI.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- Generar movimiento
         BEGIN
            pra_gen_mov_plazo(v_nro_cuenta,v_nro_cta_plazo,v_mto_operacion);
         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERR_GEN_MOV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '|| PAW_UTI.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), PAW_UTI.BITACORA_ERROR);
               RETURN v_retorno;
         END;
       v_observacion := 'Apertura de cuenta de Ahorro a Plazo Fijo';
       v_dir_ip      := SUBSTR(sys_context('USERENV', 'IP_ADDRESS'), -20);
       v_parametros  := 'cod_persona: ' || v_cod_persona || ', Moneda: ' || v_cod_moneda || ', cod_canal: ' || v_cod_canal ||
                        ', nro_cuenta: ' || v_nro_cuenta || ', modo: ' || v_modo;
         lp_reg_operacion(v_nro_cuenta,    -- p_nro_cuenta
                          v_cod_moneda,    -- p_cod_moneda
                          v_mto_operacion, -- p_monto
                          v_nro_cta_plazo, -- p_nro_cta_contra
                          1,  -- p_cantidad
                          '', -- p_etiqueta
                          '', -- p_dato
                          '', -- p_etiqueta2
                          '', -- p_dato2
                        v_observacion, -- p_observacion
                        v_dir_ip, -- p_dir_ip
                        '', -- p_cod_respuesta
                        v_cod_persona, --p_cod_persona
                        v_cod_operacion, --p_cod_operacion
                        v_nro_cta_plazo, -- p_nro_operacion
                        v_cod_canal, -- p_nro_terminal
                        p_sesion, -- p_clave
                        v_usu_sesion.codigoEmpresa, --p_cod_per_empresa
                        v_parametros,  -- p_parametros
                        '', -- p_etiqueta3
                        ''  -- p_dato3
                        );
       v_retorno.numeroDocumento := v_cta_generada.NRO_CUENTA; -- Numero de Documento
       v_retorno.codigoMoneda := v_cod_moneda;
       v_retorno.codigoModulo := v_cod_modulo;
       v_retorno.monto := v_mto_operacion;
       -- Calculo de Pago de Intereses
       v_plazo_dias    := v_plazo*30;
       v_tot_interes   := ROUND(pag_gen.fu_cal_int_simple(v_mto_operacion,v_plazo_dias,v_val_tasa));
    END IF;
    -- Cargar Datos del Plazo Fijo --
    PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'amount', NVL(v_mto_operacion,0));
    PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'debitAmount', NVL(v_mto_debito,0));
    PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'installment', v_plazo);
    PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'interestRate', v_val_tasa);
    PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'totalInterestAmount', v_tot_interes);
    PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'creditAccount', v_nro_cta_plazo);
    v_fec_pri_vto   := lf_obt_pri_vencimiento();
    PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'firstDeadline', to_char(v_fec_pri_vto, 'dd/mm/yyyy'));
    PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'payTerm', v_plz_pago); -- plazo de pago
    v_des_plz_pago  := fue_obt_des_refcodes(C_REF_PAG_INT,v_plz_pago);
    PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'payTermDesc', v_des_plz_pago); -- plazo de pago
    paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                v_msj_bitacora || ' ' ||
                                PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                paw_uti.BITACORA_SALIDA);
    RETURN v_retorno;
  EXCEPTION
     WHEN OTHERS THEN
        paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                    v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' ||
                                    PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                    paw_uti.BITACORA_ERROR);
        RETURN v_retorno;
  END;
  --
   FUNCTION fu_cancelacionPlazoFijo(p_sesion IN VARCHAR2,
                                    p_codigoCanal IN VARCHAR2,
                                    p_modo IN VARCHAR2,
                                    p_codigoModulo IN NUMBER,
                                    p_xmlData IN VARCHAR2) RETURN typ_preaprobado IS
      v_cod_persona     ba_personas.cod_persona%TYPE;
      v_nro_cuenta      ge_cuentas.nro_cuenta%TYPE := NULL;
      v_cod_moneda      ge_cuentas.cod_moneda%TYPE;
      v_cod_modulo      ba_modulos.cod_modulo%TYPE;
      v_cod_tra_padre   ge_transacciones.cod_transaccion%TYPE := NVL(fug_obt_pardinamico('COD_TRA_CAN_PLZ_FIJO'),301);
      v_usu_sesion      typ_validarsesion;
      v_msj_caja        typ_mensajeCaja;
      v_retorno         typ_preaprobado := typ_preaprobado();
      v_permiso         typ_obtenerPermisos;
      v_msj_respuesta   typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_fec_proceso     ge_movimientos.fecha%TYPE := pag_cal.FU_OBT_FEC_ACTUAL(3);
      v_plazo           cr_piz_plazos.plz_desde%TYPE;
      v_plz_pago        cr_piz_plazos.plz_desde%TYPE;
      v_plazo_dias      cr_piz_plazos.plz_desde%TYPE;
      v_mto_operacion   ge_movimientos.monto%TYPE;
      v_tot_cargo       ge_movimientos.monto%TYPE;
      v_tot_imp         ge_movimientos.monto%TYPE;
      v_val_tasa        ah_cta_plazos.val_tasa%TYPE;
      v_des_plz_pago    ba_cod_referencias.abreviatura%TYPE;
      v_xml_data        xmltype;
      v_modo            VARCHAR2(1);
      v_cod_operacion   bw_tip_mensajes.cod_tip_mensaje%TYPE := '121';
      v_msj_bitacora    VARCHAR2(4000);
      v_horario         VARCHAR2(1);
      v_es_mov_noc      VARCHAR2(1);
      v_es_cta_noc      VARCHAR2(1);
      v_cod_canal       ge_canales.cod_canal%TYPE;
      v_des_canal       ge_canales.descripcion%TYPE;
      v_est_modulo      ba_modulos.estado%TYPE;
      v_cta_plazo       ah_cta_plazos%ROWTYPE;
      v_observacion     bw_movimientos.observacion%TYPE;
      v_dir_ip          bw_movimientos.dir_ip%TYPE;
      v_parametros      bw_movimientos.parametros%TYPE;
      C_REF_PAG_INT       ba_cod_referencias.dominio%TYPE := 'TIP_CAPITALIZACION';
      MSG_OPE_INVALIDA    CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_PRO_ERR_DAT_INV CONSTANT VARCHAR2(15) := 'PRO_ERR_DAT_INV';
      MSG_SIS_CIERRE      CONSTANT VARCHAR2(15) := 'HOR_SIS_CIERRE';
      MSG_ERR_GEN_MOV     CONSTANT VARCHAR2(15) := 'PFD_ERR_GEN_MOV';
      MSG_ERR_CAL_CAN     CONSTANT VARCHAR2(15) := 'PFD_ERR_CAL_CAN';
      MSG_NRO_CTA_INV     CONSTANT VARCHAR2(15)   := 'G_NROCTAINVALID';
      --
      FUNCTION lf_obt_cta_plazo(p_nro_cuenta IN ge_cuentas.nro_cuenta%TYPE,
                                p_cta_plazo IN OUT ah_cta_plazos%ROWTYPE ) RETURN typ_mensajeRespuesta IS
         v_retorno typ_mensajeRespuesta := typ_mensajeRespuesta;
      BEGIN
         PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         SELECT *
           INTO p_cta_plazo
           FROM ah_cta_plazos
          WHERE nro_cuenta = p_nro_cuenta;
         RETURN v_retorno;
      EXCEPTION
         WHEN OTHERS THEN
            PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                    v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' ||
                                    PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                    PAW_UTI.BITACORA_ERROR);
            RETURN v_retorno;
      END;
      --
      FUNCTION lf_val_datos RETURN typ_mensajeRespuesta IS
         v_retorno   typ_mensajeRespuesta := typ_mensajeRespuesta;
         V_EXISTE    VARCHAR2(1);
      BEGIN
         PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         BEGIN
           SELECT 'S'
             INTO V_EXISTE
             FROM ge_transacciones a
            WHERE a.cod_transaccion = v_cod_tra_padre
              AND ROWNUM = 1;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'Formato parametro XML no valido - ' || v_msj_bitacora || ' ' || PAW_UTI.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), PAW_UTI.BITACORA_ERROR);
               RETURN v_retorno;
         END;
         RETURN v_retorno;
      EXCEPTION
         WHEN OTHERS THEN
            PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'Formato parametro XML no valido - ' || v_msj_bitacora || ' ' || PAW_UTI.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), PAW_UTI.BITACORA_ERROR);
            RETURN v_retorno;
      END;
      --
   BEGIN
      PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_retorno.listaDetalles := typ_listaEtiquetaValor();
      v_modo                  := substr(TRIM(p_modo), 1, 1);
      v_cod_modulo            := p_codigoModulo;
      v_msj_bitacora          := substr('cod_mod:' || v_cod_modulo || ', mod: ' || v_modo, 1, 700);
      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion, 32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      v_cod_persona := nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona);
      PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                  v_msj_bitacora || ' ' ||
                                  PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                  PAW_UTI.BITACORA_ENTRADA);
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' ||
                                     PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 3. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_permiso      := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      v_msj_bitacora := v_msj_bitacora || ', perf: ' || v_usu_sesion.codigoPerfil;
      IF v_permiso.error = 'S' THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' ||
                                     PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- validamos el modulo
      IF v_cod_modulo != 3 THEN
         -- Modulo Ahorros
         PAW_UTI.pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' ||
                                     PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- validamos el horario
      --No se puede realizar transacciones con estado distinto a 2
      v_est_modulo   := pae_cnf.FU_OBT_EST_MODULO(v_cod_modulo);
      v_msj_bitacora := v_msj_bitacora || ', est_mod: ' || v_est_modulo;
      IF v_est_modulo != 2 THEN
         -- En cierre.
         PAW_UTI.pr_mensajeUsuario(MSG_SIS_CIERRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         PAW_UTI.pr_insertarBitacora(NULL, NULL, NULL, '999', NULL, ' lp_ver_horario()-Sistema en cierre-', PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_msj_respuesta := lp_ver_horario(v_horario,
                                        v_es_mov_noc,
                                        v_es_cta_noc,
                                        v_msj_caja.fechaUltimoCierre, -- IN
                                        v_msj_caja.codigoOficinaOrigen, -- IN
                                        v_fec_proceso);
      IF v_msj_respuesta.error = 'S' THEN
         v_retorno.error                := v_msj_respuesta.error;
         v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' ||
                                     PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- sin problemas hasta aqui
      IF p_xmlData IS NOT NULL THEN
         -- obtenemos el canal
         SELECT decode(p_codigoCanal, 994, 30, -- mobile
                        29), -- web
                decode(p_codigoCanal, 994, 'Móvil', -- mobile
                        'Homebanking') -- web
           INTO v_cod_canal, v_des_canal
           FROM DUAL;
         -- parseamos los datos de entrada
         v_xml_data := xmltype.createxml(p_xmlData);
         -- Ver datos
         BEGIN
            BEGIN
               v_nro_cuenta := depurarAlfanumerico(v_xml_data.extract('/product/debitAccount/text()').getStringVal(), CUENTA_TAMANO);
            EXCEPTION
               WHEN OTHERS THEN
                  v_nro_cuenta := '0000000000';
            END;
            v_cod_moneda := fug_obt_mon_cta(v_nro_cuenta); -- Obtener la Moneda de la Cuenta
         EXCEPTION
            WHEN OTHERS THEN
               PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                           'Formato parametro XML no valido - ' || v_msj_bitacora || ' ' ||
                                           PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                           PAW_UTI.BITACORA_ERROR);
               RETURN v_retorno;
         END;
      ELSE
         PAW_UTI.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     'Formato parametro XML no valido - ' || v_msj_bitacora || ' ' ||
                                     PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_retorno.codigoMoneda := v_cod_moneda;
      v_retorno.codigoModulo := v_cod_modulo;
      v_retorno.montoMinimo  := 0;
      --Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(v_nro_cuenta, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigopersona)) = 'N' THEN
         PAW_UTI.pr_mensajeUsuario(MSG_NRO_CTA_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' ||
                                     PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- Validar inhibidos
      IF fug_obt_inhibicion(fug_obt_pardinamico('COD_CAU_DEM_JUDICIAL'),  nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigopersona), v_nro_cuenta) THEN
         PAW_UTI.pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ' ' ||
                                     PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- Obtener datos del Plazo Fijo --
      v_msj_respuesta := lf_obt_cta_plazo(v_nro_cuenta, v_cta_plazo);
      IF v_msj_respuesta.error = 'S' THEN
         v_retorno.error                := v_msj_respuesta.error;
         v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                    v_msj_bitacora || ' ' ||
                                    PAW_UTI.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                    PAW_UTI.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_val_tasa   := v_cta_plazo.val_tasa;
      v_plazo_dias := (v_cta_plazo.fec_vencimiento - v_cta_plazo.fec_apertura);
      v_plazo      := ROUND(v_plazo_dias/30);
      v_plz_pago   := v_cta_plazo.tip_capitalizacion;
      v_des_plz_pago  := fue_obt_des_refcodes(C_REF_PAG_INT,v_plz_pago);
      -- proceso segun modo
      IF v_modo = 'V' THEN
         -- Obtener el total de cargos a aplicar
         BEGIN
            PRA_CAN_AHO_PLAZO(v_nro_cuenta,v_tot_cargo,v_tot_imp);
         EXCEPTION
            WHEN OTHERS THEN
               PAW_UTI.pr_mensajeUsuario(MSG_ERR_CAL_CAN, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '|| PAW_UTI.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), PAW_UTI.BITACORA_ERROR);
               RETURN v_retorno;
         END;
      ELSIF v_modo = 'C' THEN
         -- Obtener el total de cargos a aplicar
         BEGIN
            PRA_CAN_AHO_PLAZO(v_nro_cuenta,v_tot_cargo,v_tot_imp);
         EXCEPTION
            WHEN OTHERS THEN
               PAW_UTI.pr_mensajeUsuario(MSG_ERR_CAL_CAN, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '|| PAW_UTI.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), PAW_UTI.BITACORA_ERROR);
            RETURN v_retorno;
         END;
         -- Generar movimiento de Cancelacion
         BEGIN
            -- El procedimiento realiza las validaciones para la generacion de movimientos de cancelacion --
            PRA_MOV_CAN_PLAZO(v_nro_cuenta,v_tot_cargo,v_tot_imp);
         EXCEPTION
            WHEN OTHERS THEN
               PAW_UTI.pr_mensajeUsuario(MSG_ERR_GEN_MOV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '|| PAW_UTI.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), PAW_UTI.BITACORA_ERROR);
               RETURN v_retorno;
         END;
         v_observacion := 'Cancelacion Anticipada de cuenta de Ahorro a Plazo Fijo';
         v_dir_ip      := SUBSTR(sys_context('USERENV', 'IP_ADDRESS'), -20);
         v_parametros  := 'cod_persona: ' || v_cod_persona || ', Moneda: ' || v_cod_moneda || ', cod_canal: ' || v_cod_canal || ', nro_cuenta: ' ||
                           v_nro_cuenta || ', modo: ' || v_modo;
         lp_reg_operacion(v_nro_cuenta,    -- p_nro_cuenta
                          v_cod_moneda,    -- p_cod_moneda
                          v_mto_operacion, -- p_monto
                          v_cta_plazo.nro_cta_capitalizacion, -- p_nro_cta_contra
                          1,               -- p_cantidad
                          '',              -- p_etiqueta
                          '',              -- p_dato
                          '',              -- p_etiqueta2
                          '',              -- p_dato2
                          v_observacion,   -- p_observacion
                          v_dir_ip,        -- p_dir_ip
                          '', -- p_cod_respuesta
                          v_cod_persona, --p_cod_persona
                          v_cod_operacion, --p_cod_operacion
                          v_nro_cuenta, -- p_nro_operacion
                          v_cod_canal, -- p_nro_terminal
                          p_sesion, -- p_clave
                          v_usu_sesion.codigoEmpresa, --p_cod_per_empresa
                          v_parametros,    -- p_parametros
                          '', -- p_etiqueta3
                          ''  -- p_dato3
                          );
      END IF;
      v_mto_operacion := NVL(v_cta_plazo.capital, 0) - NVL(v_tot_cargo,0) - NVL(v_tot_imp,0);
      v_retorno.numeroDocumento := v_nro_cuenta; -- Numero de Documento
      v_retorno.codigoMoneda := v_cod_moneda;
      v_retorno.codigoModulo := v_cod_modulo;
      v_retorno.monto := v_mto_operacion;
      -- Cargar Datos del Plazo Fijo --
      PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'debitAccount', v_nro_cuenta);
      PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'creditAccount', v_cta_plazo.nro_cta_capitalizacion);
      PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'amount', NVL(v_cta_plazo.capital, 0)); -- capital
      PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'interestRate',  v_val_tasa); -- tasa
      PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'installment', v_plazo); -- plazo en meses
      PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'payTerm', v_plz_pago); -- plazo de pago
      PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'payTermDesc', v_des_plz_pago); -- plazo de pago
      PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'chargeAmount', NVL(v_tot_cargo,0));  -- importe cargos (penalizacion)
      PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'taxAmount', NVL(v_tot_imp,0));  -- importe impuestos (penalizacion)
      PAW_UTI.pr_add_value(v_retorno.listaDetalles, 'creditAmount', v_mto_operacion); -- importe neto a acreditar
      paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                  v_msj_bitacora || ' ' ||
                                  PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                  paw_uti.BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                     v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' ||
                                     PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
   END;
   --
   FUNCTION fu_obt_apf_detalles(p_sesion              IN VARCHAR2,
                                p_codCanal            IN VARCHAR2,
                                p_nroCuentaEspecifica IN VARCHAR2) RETURN typ_obtenerDatosApf IS
      MSG_OBT_CTADET_CTA_INEXISTENTE CONSTANT VARCHAR2(15) := 'OBTCTADET_CTAIX';
      v_nro_cta_especifica     ah_cta_plazos.nro_cuenta%TYPE;
      v_cod_modalidad          ah_cta_plazos.cod_modalidad%TYPE;
      v_nro_cta_capitalizacion ah_cta_plazos.nro_cta_capitalizacion%TYPE;
      v_denominacion           ah_cta_plazos.denominacion%TYPE;
      v_periodo                VARCHAR2(100);
      v_estado                 VARCHAR2(240) := '';
      v_per_liq_intereses      VARCHAR(240) := '';
      v_cod_moneda             ba_monedas.cod_moneda%TYPE;
      v_des_moneda             ba_monedas.descripcion%TYPE;
      v_total_interes          NUMBER(18,2) := 0;
      v_sucursal               ba_oficinas.descripcion%TYPE;
      v_can_detalles           NUMBER(3); -- cantidad de cuentas
      v_monto1                 NUMBER(18, 2) := 0; -- monto 1
      v_val_tasa               ah_cta_plazos.val_tasa%TYPE := 0;
      v_fec_inicio             ah_cta_plazos.fec_apertura%TYPE;
      v_fec_vencimiento        ah_cta_plazos.fec_vencimiento%TYPE;
      COD_OPERACION            VARCHAR2(3) := '020';
      userInfo                 typ_validarSesion;
      v_listaDetalles          typ_listaDetallesApf := typ_listaDetallesApf();
      v_permiso                typ_obtenerPermisos;
      v_retorno                typ_obtenerDatosApf := typ_obtenerDatosApf;
      v_logmessage             VARCHAR(1000);
      v_plazo_dias             NUMBER(18,2) := 0;
      v_tot_generado           NUMBER(3) := 0;
      v_tot_pagado             NUMBER(3) := 0;
      v_tot_atrasado           NUMBER(3) := 0;
      v_mto_tot_interes        NUMBER := 0;
      v_can_cuotas             NUMBER;
      v_dev_posterior          NUMBER;
      --
      CURSOR apfs(p_nro_cuenta IN VARCHAR2) IS
         SELECT nro_cupon, mto_interes, fec_vencimiento, estado, fec_pago,
                decode(ac.estado, 'C', 'Cargado', 'V', 'Vencido', 'P', 'Pagado', 'Generado') des_estado
           FROM ah_cupones ac
          WHERE ac.nro_cuenta = p_nro_cuenta
          ORDER BY ac.nro_cupon;
      --
      CURSOR pro(p_nro_cuenta IN VARCHAR2) IS
         SELECT nro_cuota, fec_vencimiento, estado, fec_ult_pago, sal_acumulado, mto_cuota, tipo,
                decode(ac.estado, 'A', 'Atrasado', 'V', 'Vencido', 'P', 'Pagado', 'C', 'Cancelado', 'Pendiente') des_estado,
                (SELECT dev.mto_dev_acumulado
                   FROM ah_devengados dev
                  WHERE dev.nro_cuenta = ac.nro_cuenta
                    AND to_char(dev.fec_tasa, 'yyyymm') = to_char(ac.fec_vencimiento, 'yyyymm')) mto_interes
           FROM ah_pro_cuotas ac
          WHERE ac.nro_cuenta = p_nro_cuenta
          ORDER BY ac.fec_ult_pago, ac.fec_vencimiento, ac.nro_cuota;
   BEGIN
      paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_nro_cta_especifica := depurarAlfanumerico(p_nroCuentaEspecifica, 15);
      -- 0. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- control de permisos
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userinfo.codigoEmpresa, 'lf_obt_permisos - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      BEGIN
         SELECT fue_obt_des_oficina(acp.cod_oficina), acp.cod_modalidad, acp.fec_apertura, acp.fec_vencimiento,
                acp.val_tasa, (acp.fec_vencimiento - acp.fec_apertura), fue_obt_des_moneda(acp.cod_moneda), cod_moneda,
                acp.capital, acp.nro_cta_capitalizacion, fug_obt_des_est_cta(acp.cod_modulo, acp.cod_modalidad, acp.estado),
                substr(fue_obt_des_refcodes('TIP_CAPITALIZACION', acp.tip_capitalizacion), 1, 240),
                decode(nvl(acp.per_debito, 0), 0, null, substr(fue_obt_sig_refcodes('FEC_DEB_AHO_PROGRAMADO', acp.per_debito), 1, 100)), acp.denominacion
           INTO v_sucursal, v_cod_modalidad, v_fec_inicio, v_fec_vencimiento, v_val_tasa, v_plazo_dias,
                v_des_moneda, v_cod_moneda, v_monto1, v_nro_cta_capitalizacion, v_estado, v_per_liq_intereses,
                v_periodo, v_denominacion
           FROM ah_cta_plazos acp, ge_cta_clientes c
          WHERE acp.nro_cuenta = v_nro_cta_especifica
            AND acp.nro_cuenta = c.nro_cuenta
            AND c.cod_persona = nvl(userinfo.codigoEmpresa, userinfo.codigoPersona);
      EXCEPTION
         WHEN NO_DATA_FOUND THEN
            paw_uti.pr_mensajeUsuario(MSG_OBT_CTADET_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Nro. CUENTA:' || v_nro_cta_especifica || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         WHEN OTHERS THEN
            paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obt_apfd_detalles -' || SQLERRM, paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
      END;

      IF v_cod_modalidad = 37 THEN
         SELECT SUM(mto_interes)
           INTO v_total_interes
           FROM ah_cupones ac
          WHERE ac.estado = 'E'
            AND ac.nro_cuenta = v_nro_cta_especifica;
      ELSIF v_cod_modalidad = 38 THEN
         -- totales
         SELECT SUM(c.mto_interes),
                SUM(CASE WHEN c.estado = 'E' THEN 1 ELSE 0 END),
                SUM(CASE WHEN c.estado = 'P' AND c.tipo = 'C' THEN 1 ELSE 0 END),
                SUM(CASE WHEN c.estado IN ('A', 'V') THEN 1 ELSE 0 END),
                SUM(CASE WHEN c.tipo = 'C' THEN 1 ELSE 0 END)
           INTO v_total_interes, v_tot_generado, v_tot_pagado, v_tot_atrasado, v_can_cuotas
           FROM ah_pro_cuotas c
          WHERE c.nro_cuenta = v_nro_cta_especifica;
         -- buscamos si hay devengado posterior a la ultima cuota
         SELECT nvl(SUM(d.mto_dev_acumulado), 0)
           INTO v_dev_posterior
           FROM ah_devengados d, ah_pro_cuotas c
          WHERE d.nro_cuenta = c.nro_cuenta
            AND c.nro_cuota = v_can_cuotas
            AND c.nro_cuenta = v_nro_cta_especifica
            AND to_char(d.fec_tasa, 'yyyymm') > to_char(c.fec_vencimiento, 'yyyymm');
      END IF;
      --Logear parametros
      v_logmessage := substr('obtenerDatosApfd(nroCuentaEspecifica=' || v_nro_cta_especifica || ')',0,999);
      paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, paw_uti.BITACORA_ENTRADA);

      -- 2. busco los datos de la cuentas
      IF v_retorno.error = 'N' THEN
         v_can_detalles := 0;
         --- Debe controlar para que no muestre cuentas juridicas entre las cuentas del cliente
         IF PAW_UTI.fu_es_juridica(v_nro_cta_especifica, userInfo.codigoEmpresa, userInfo.codigoPersona) = 'N' THEN
            v_retorno.capital           := substr(lf_for_money(v_monto1), 1, 16);
            v_retorno.numeroCuenta      := substr(v_nro_cta_especifica, 0, 17);
            v_retorno.nroCtaCapitalizacion := v_nro_cta_capitalizacion;
            v_retorno.estado               := v_estado;
            v_retorno.periodoLiqInteres    := v_per_liq_intereses;
            v_retorno.descMoneda           := v_des_moneda;
            v_retorno.codMoneda            := v_cod_moneda;
            v_retorno.fechaApertura        := v_fec_inicio;
            v_retorno.fechaVencimiento     := v_fec_vencimiento;
            v_retorno.totalInteresACobrar  := v_total_interes;
            v_retorno.tasaInteres          := v_val_tasa;
            v_retorno.plazoDias            := v_plazo_dias;
            v_retorno.sucursal             := v_sucursal;
            v_retorno.denominacion         := v_denominacion;
            v_retorno.periodo              := substr(v_periodo, 1, 100);
            v_retorno.totalGenerado        := v_tot_generado;
            v_retorno.totalAtrasado        := v_tot_atrasado;
            v_retorno.totalCobrado         := v_tot_pagado;

            BEGIN
               IF v_cod_modalidad = 37 THEN
                  -- apfd
                  FOR apf IN apfs(v_nro_cta_especifica) LOOP
                     DECLARE
                        detalleCuponesApf typ_detallesApf := typ_detallesApf;
                     BEGIN
                        v_can_detalles                      := v_can_detalles + 1;
                        detalleCuponesApf.nroCupon          := apf.nro_cupon;
                        detalleCuponesApf.montoInteres      := apf.mto_interes;
                        detalleCuponesApf.fechaVencimiento  := apf.fec_vencimiento;
                        detalleCuponesApf.estado            := apf.estado;
                        detalleCuponesApf.descripcionEstado := substr(apf.des_estado, 1, 240);
                        detalleCuponesApf.fechaPago         := apf.fec_pago;
                        v_listaDetalles.EXTEND;
                        v_listaDetalles(v_listaDetalles.COUNT) := detalleCuponesApf;
                     END;
                  END LOOP;
               ELSIF v_cod_modalidad = 38 THEN
                  FOR ahp IN pro(v_nro_cta_especifica) LOOP
                     DECLARE
                        detalleCuponesApf typ_detallesApf := typ_detallesApf;
                     BEGIN
                        detalleCuponesApf.montoInteres := 0;
                        -- solo para cuotas
                        IF ahp.tipo = 'C' THEN
                           v_can_detalles    := v_can_detalles + 1;
                           v_mto_tot_interes := v_mto_tot_interes + nvl(ahp.mto_interes, 0);
                           -- si es la ultima cuota, puede haber un devengado en mes posterior
                           IF v_can_detalles = v_can_cuotas THEN
                              v_mto_tot_interes := v_mto_tot_interes + v_dev_posterior;
                              detalleCuponesApf.montoInteres := v_dev_posterior;
                           END IF;
                        END IF;
                        -- si no hay acumulado, aun no hay devengado
                        IF nvl(ahp.sal_acumulado, 0) = 0 THEN
                           v_mto_tot_interes := 0;
                        END IF;
                        detalleCuponesApf.nroCupon          := ahp.nro_cuota;
                        detalleCuponesApf.montoInteres      := detalleCuponesApf.montoInteres + nvl(ahp.mto_interes, 0);
                        detalleCuponesApf.fechaVencimiento  := ahp.fec_vencimiento;
                        detalleCuponesApf.estado            := ahp.estado;
                        detalleCuponesApf.descripcionEstado := substr(ahp.des_estado, 1, 240);
                        detalleCuponesApf.fechaPago         := ahp.fec_ult_pago;
                        detalleCuponesApf.montoAcumulado    := v_mto_tot_interes + nvl(ahp.sal_acumulado, 0);
                        detalleCuponesApf.monto             := nvl(ahp.mto_cuota, 0);
                        detalleCuponesApf.tipo              := ahp.tipo;

                        v_listaDetalles.EXTEND;
                        v_listaDetalles(v_listaDetalles.COUNT) := detalleCuponesApf;
                     END;
                  END LOOP;
               END IF;
               v_retorno.cantidadDetalles      := v_listaDetalles.count;
               v_logmessage                    := v_logmessage || ', tot: ' || v_can_detalles;
               v_retorno.listaDetalles         := v_listaDetalles;
            EXCEPTION
               WHEN OTHERS THEN
                  paw_uti.pr_mensajeUsuario(MSG_OBT_CTADET_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'cta: '|| v_nro_cta_especifica ||', mad:' || v_cod_modalidad || ', ORA-ERR: ' || SQLERRM || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL) || SQLERRM, paw_uti.BITACORA_ERROR);
            END;
         END IF;
         IF v_can_detalles = 0 THEN
            -- no tiene detalles
            paw_uti.pr_mensajeUsuario(MSG_OBT_CTADET_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obt_apfd_detalles - Cuenta Inexistente -' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) ||sqlerrm, paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
      -- registro del movimiento
      lp_reg_operacion(v_nro_cta_especifica, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, userInfo.codigoPersona, COD_OPERACION, userinfo.codigoPersona || p_codCanal, p_codCanal, p_sesion, userInfo.codigoEmpresa);
      paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logmessage || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obt_apfd_detalles -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;
   -- FIN fu_obt_apf_detalles

   /*Funcion que envia mail de aviso de pago con reintento*/
   FUNCTION fu_env_mail_avi_reintento(p_token     IN VARCHAR2,
                                      p_cuentaDebito IN VARCHAR2) RETURN NUMBER IS

  v_result         NUMBER := 0;
  v_ruc            ge_set_pagos.ruc%TYPE;
  v_monto          ge_set_pagos.monto%TYPE;
  v_fec_documento  ge_set_pagos.fec_documento%TYPE;
  v_nro_operacion  ge_set_pagos.nro_operacion%TYPE;
  v_mto_debito      bw_pag_servicios.mto_debito%TYPE;
  v_cod_servicio    bw_pag_servicios.cod_servicio%TYPE;
  v_cod_proveedor   bw_pag_servicios.cod_proveedor%TYPE;
  v_des_servicio    bw_pag_cod_servicios.descripcion%TYPE;
  v_fecha           bw_pag_servicios.fecha%TYPE;
  v_dir_correo     varchar2(100);
  v_cod_per_debito ba_personas.cod_persona%Type := null;
  v_nro_boleta    ge_set_pagos.nro_boleta%TYPE;
   v_cabecera   VARCHAR2(700)  := NULL;
   v_detalle    VARCHAR2(3300) := NULL;
   v_pie        VARCHAR2(500)  := NULL;
   v_tag        VARCHAR2(50);
   v_nombre     VARCHAR2(100);
     BEGIN
  --obtengo el cliente principal
  v_cod_per_debito := fug_obt_cli_principal(p_cuentaDebito);
  --obtengo la direccion de correo
  BEGIN
    v_dir_correo := paw_seg.fu_obt_mail(fug_obt_cli_principal(p_cuentaDebito));
  EXCEPTION
    when others then
      v_dir_correo := null;
  END;
  --obtenemos el nombre del cliente
    v_nombre :=  fue_obt_nom_persona(fug_obt_cli_principal(p_cuentaDebito));
 --buscamos datos del pago a la set
 BEGIN
    select s.ruc, s.monto, s.fec_documento, s.nro_operacion, s.fec_documento, s.nro_boleta
      into v_ruc, v_monto, v_fec_documento, v_nro_operacion, v_fec_documento, v_nro_boleta
      from ge_set_pagos s
     where s.cod_Token = p_token
       and s.nro_cta_debito = p_cuentaDebito;
  EXCEPTION
    WHEN OTHERS THEN
      v_nro_operacion := NULL;
  END;
  --buscamos datos el pago de servicio
   BEGIN
    select a.mto_debito, a.cod_servicio, a.cod_proveedor, b.descripcion, a.fecha
      into v_mto_debito, v_cod_servicio, v_cod_proveedor, v_des_servicio, v_fecha
      from BW_PAG_SERVICIOS a
     INNER JOIN bw_pag_cod_servicios b
            ON a.cod_servicio = b.cod_servicio
            and a.cod_proveedor = b.cod_proveedor
     where a.nro_cuenta = p_cuentaDebito
       and a.cod_ws_servicios = p_token;
   EXCEPTION
      WHEN OTHERS THEN
        v_cod_servicio := NULL;
   END;
  if v_cod_proveedor = 2 then
    if v_dir_correo is not null and v_nro_operacion is not null then
      -- ---------- cabecera --------------
        v_cabecera :=
              -- inicio div
              paw_pro.fu_not_inicio ||
              -- titulo
              paw_pro.fu_not_titulo(UTL_URL.ESCAPE('AVISO DE REINTENTO DE PAGO A LA SET', TRUE, 'UTF-8'));
        -- subtitulo
        v_cabecera := v_cabecera ||
        paw_pro.fu_not_sub_titulo(UTL_URL.ESCAPE('Estimado Cliente, su pago se encuentra pendiente de confirmación por parte de la SET. Por favor, aguarde<br> la confirmación o reversión de la operación.', TRUE, 'UTF-8'));
        v_cabecera := v_cabecera ||
              -- inicio tabla
              paw_pro.fu_not_ini_tabla ||
              -- inicio tbody
              paw_pro.fu_not_ini_tab_cuerpo;
        -- ---------- pie --------------
        -- fin tabla, fin div
        v_pie :=
              -- fin tbody
              paw_pro.fu_not_fin_tab_cuerpo ||
              -- fin table
              paw_pro.fu_not_fin_tabla;
        -- detalles
        v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Nombre del Cliente', TRUE, 'UTF-8'), v_nombre);
        v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Nro. Cuenta Débito', TRUE, 'UTF-8'), p_cuentaDebito);
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('RUC', v_ruc);
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('Nro. Boleta', v_nro_boleta);
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('Monto', to_char((v_monto), '999G999G999G999G999'));
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('Fecha'||v_tag, to_char(v_fec_documento, 'dd/mm/yyyy'));
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('Nro. Comprobante', v_nro_operacion);
        -- fin div
        v_pie := v_pie || paw_pro.fu_not_fin;
        IF fug_ind_produccion = 'S' THEN --si es produccion
             v_result := paw_not.fu_env_email_prueba(v_dir_correo,
                                             v_cabecera || v_detalle || v_pie,
                                              'PAW_BEL');
          IF v_result = 0 then
              insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
              values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_env_mail_avi_reintento'||'-'||'Mail aviso de reintento pago a la SET', 'Cliente: '||v_cod_per_debito||' Cuenta Deb.: '||p_cuentaDebito ||' - '||substr(v_detalle,1,3900), sysdate, user)  ;
               commit;
          else
              insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
              values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_env_mail_avi_reintento'||'-'||'Mail aviso de reintento pago a la SET, no enviado', 'Cliente: '||v_cod_per_debito||' Cuenta Deb.: '||p_cuentaDebito ||' - '||substr(v_detalle,1,3900), sysdate, user)  ;
               commit;
              END IF;
        ELSE -- si no corresponde al entorno de ejecucion de produccion.
               v_result := -90;

               insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
              values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_env_mail_avi_reintento'||'-'||'Mail aviso de reintento pago a la SET', 'Cliente: '||v_cod_per_debito||' Cuenta Deb.: '||p_cuentaDebito ||' - Entorno de ejecucion invalido.', sysdate, user)  ;
               commit;
                 END IF;
    else  -- si no se encontro correo
       v_result := -91;
       insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
        values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_env_mail_avi_reintento'||'-'||'Mail aviso de reintento pago a la SET', 'Cliente: '||v_cod_per_debito||' Cuenta Deb.: '||p_cuentaDebito ||' - No se encontro un correo configurado segun los criterios definidos.', sysdate, user)  ;
        commit;
              END IF;
       return v_result;
elsif v_cod_proveedor in (0,1,4) then
    if v_dir_correo is not null and v_cod_servicio is not null then
              -- ---------- cabecera --------------
              v_cabecera :=
                    -- inicio div
                    paw_pro.fu_not_inicio ||
                    -- titulo
                    paw_pro.fu_not_titulo(UTL_URL.ESCAPE('AVISO DE REINTENTO DE PAGO DE SERVICIO', TRUE, 'UTF-8'));
              -- subtitulo
              v_cabecera := v_cabecera ||
              paw_pro.fu_not_sub_titulo(UTL_URL.ESCAPE('Estimado Cliente, su pago se encuentra pendiente de confirmación con el proveedor del servicio. Por favor, <br>aguarde la confirmación o reversión de la operación.', TRUE, 'UTF-8'));
              v_cabecera := v_cabecera ||
                    -- inicio tabla
                    paw_pro.fu_not_ini_tabla ||
                    -- inicio tbody
                    paw_pro.fu_not_ini_tab_cuerpo;
              -- ---------- pie --------------
              -- fin tabla, fin div
              v_pie :=
                    -- fin tbody
                    paw_pro.fu_not_fin_tab_cuerpo ||
                    -- fin table
                    paw_pro.fu_not_fin_tabla;
              -- detalles
              v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Nombre del Cliente', TRUE, 'UTF-8'), v_nombre);
              v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Nro. Cuenta Débito', TRUE, 'UTF-8'), p_cuentaDebito);
              v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Servicio', TRUE, 'UTF-8'), v_des_servicio);
              v_detalle := v_detalle || paw_pro.fu_not_row_tag('Monto', to_char((v_mto_debito), '999G999G999G999G999'));
              v_detalle := v_detalle || paw_pro.fu_not_row_tag('Fecha'||v_tag, to_char(v_fecha, 'dd/mm/yyyy'));
              -- fin div
              v_pie := v_pie || paw_pro.fu_not_fin;
        IF fug_ind_produccion = 'S' THEN --si es produccion
            v_result := paw_not.fu_env_email_prueba(v_dir_correo,
                                            v_cabecera || v_detalle || v_pie,
                                              'PAW_BEL');
              IF v_result = 0 then
                  insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
                  values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_env_mail_avi_reintento'||'-'||'Mail aviso de reintento pago de servicio', 'Cliente: '||v_cod_per_debito||' Cuenta Deb.: '||p_cuentaDebito ||' - '||substr(v_detalle,1,3900), sysdate, user)  ;
                   commit;
           ELSE
                  insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
                  values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_env_mail_avi_reintento'||'-'||'Mail aviso de reintento pago de servicio, no enviado', 'Cliente: '||v_cod_per_debito||' Cuenta Deb.: '||p_cuentaDebito ||' - '||substr(v_detalle,1,3900), sysdate, user)  ;
                   commit;
              end if;
        ELSE -- si no corresponde al entorno de ejecucion de produccion.
             v_result := -91;
             insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
              values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_env_mail_avi_reintento'||'-'||'Mail aviso de reintento de servicio', 'Cliente: '||v_cod_per_debito||' Cuenta Deb.: '||p_cuentaDebito ||' - Entorno de ejecucion invalido.', sysdate, user)  ;
              commit;
           END IF;
    else  -- si no se encontro correo o codigo de servicio
       v_result := -92;
       insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
        values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_env_mail_avi_reintento'||'-'||'Mail aviso de reintento pago de servicio', 'Cliente: '||v_cod_per_debito||' Cuenta Deb.: '||p_cuentaDebito ||' - No se encontro un correo configurado segun los criterios definidos.', sysdate, user)  ;
        commit;
       END IF;
  end if;
     return v_result;
   EXCEPTION
      WHEN OTHERS THEN
         v_detalle := substr(sqlerrm, 1,3800);
         insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
         values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_enviarAvisoReintento'||'-'||'Mail aviso de reintento','Cliente.:'||v_cod_per_debito||'Cuenta Deb.:'||p_cuentaDebito||'-'||v_detalle, sysdate, user)  ;
          commit;
        RETURN -99;
  END;
/* Procedimiento que inserta operaciones de pago de servicio con errores con la portadora o por timeout */
PROCEDURE pr_ins_pag_ser_error( p_cod_token IN bw_pag_ser_error.cod_token%TYPE,
              p_nro_documento IN bw_pag_ser_error.nro_documento%TYPE,
              p_nro_cuenta IN bw_pag_ser_error.nro_cuenta%TYPE,
              p_descripcion IN bw_pag_ser_error.descripcion%TYPE,
              p_portadora  IN bw_pag_ser_error.portadora%TYPE,
              p_monto  IN bw_pag_ser_error.monto%TYPE,
              p_fecha  IN bw_pag_ser_error.fec_hora%TYPE,
              p_cod_sesion  IN bw_pag_ser_error.cod_sesion%TYPE) IS
   PRAGMA AUTONOMOUS_TRANSACTION;
BEGIN
   insert into bw_pag_ser_error (cod_token, nro_documento, nro_cuenta, descripcion, portadora, monto, fec_hora, cod_sesion)
   values (p_cod_token, p_nro_documento, p_nro_cuenta, p_descripcion, p_portadora, p_monto, p_fecha, p_cod_sesion);
   COMMIT;
EXCEPTION
   when others then
     null;
   END;

   -- inicio transferencias multiple
   --tipo 'E' recibido , 'S' pedido, 'D' si tiene permiso
   --estado 'P' pendientes, 'H' historial
   FUNCTION fu_obt_sol_transferencias(p_session IN VARCHAR2,
                                      p_codCanal IN VARCHAR2,
                                      p_tipo IN VARCHAR2,
                                      p_estado IN VARCHAR2) RETURN typ_obtsolmultiple IS
      v_cod_mensaje      bw_tip_mensajes.cod_tip_mensaje%TYPE := '238';
      v_retorno          typ_obtSolMultiple := typ_obtsolmultiple();
      v_permiso          typ_obtenerPermisos;
      v_nom_solicitado   VARCHAR2(200);
      v_cantidad         NUMBER(2);
      v_cod_modulo       ge_modalidades.cod_modulo%TYPE;
      v_solRes           typ_solmultiple := typ_solmultiple();
      v_listaSolicitudes typ_listasolmultiple := typ_listasolmultiple();
      v_usu_sesion       typ_validarSesion;
      v_can_dia_his      NUMBER := nvl(fug_obt_pardinamico('CAN_DIA_HIS_MULTIPLE'), 90);
      PARAM_INCORRECT    CONSTANT VARCHAR2(15) := 'PARAM_INCORRECT';
      ERR_ACT_SOL        CONSTANT VARCHAR2(15) := 'ERR_ACT_SOL';

      CURSOR c_solicitadas(p_cod_persona IN ba_personas.cod_persona%TYPE) IS
         SELECT *
           FROM bw_sol_transferencias t
          WHERE t.cod_per_solicitante = p_cod_persona
            AND t.estado = 'P'
          ORDER BY t.fec_modificacion DESC;

      CURSOR c_sol_historico(p_cod_persona IN ba_personas.cod_persona%TYPE) IS
         SELECT *
           FROM bw_sol_transferencias t
          WHERE t.cod_per_solicitante = p_cod_persona
            AND t.estado NOT IN ('P','V')
            AND t.fec_insercion > trunc(SYSDATE) - v_can_dia_his
          ORDER BY t.fec_modificacion DESC;

      CURSOR c_sol_recibidas(p_cod_persona IN ba_personas.cod_persona%TYPE) IS
         SELECT *
           FROM bw_sol_transferencias t
          WHERE t.cod_persona_solicitada = p_cod_persona
            AND t.estado = 'P'
          ORDER BY t.fec_modificacion DESC;

      CURSOR c_rec_historico(p_cod_persona IN ba_personas.cod_persona%TYPE) IS
         SELECT *
           FROM bw_sol_transferencias t
          WHERE t.cod_persona_solicitada = p_cod_persona
            AND t.estado NOT IN ('P','V')
            AND t.fec_insercion > trunc(SYSDATE) - v_can_dia_his
          ORDER BY t.fec_modificacion DESC;

      PROCEDURE lp_obt_dat_cuenta(p_cod_persona    IN ba_personas.cod_persona%TYPE,
                                  p_nro_cuenta     IN ge_cuentas.nro_cuenta%TYPE,
                                  p_nom_solicitado OUT VARCHAR2,
                                  p_cod_modulo     OUT ge_modalidades.cod_modulo%TYPE) IS
      BEGIN
         SELECT pri_nombre || ' ' || pri_apellido, ctc.cod_modulo
           INTO p_nom_solicitado, p_cod_modulo
           FROM ba_per_fisicas pf, ge_cta_clientes ctc
          WHERE pf.cod_persona = p_cod_persona
            AND ctc.nro_cuenta = p_nro_cuenta
            AND pf.cod_persona = ctc.cod_persona;
      END;
   BEGIN
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_session, 32), p_codCanal);
      paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ENTRADA);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_mensaje);
      IF v_permiso.error = 'S' THEN
         v_retorno.error                := 'S';
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, 'p_tipo: '||substr(p_tipo, 1, 3)|| paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF nvl(p_tipo, 'x') NOT IN ('E', 'S', 'D') THEN
         -- EL TIPO DESCONOCIDO
         paw_uti.pr_mensajeUsuario(PARAM_INCORRECT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, 'p_tipo: '||substr(p_tipo, 1, 3)|| paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF nvl(p_estado, 'x') NOT IN ('P', 'H') THEN
         -- ESTADO DESCONOCIDO
         paw_uti.pr_mensajeUsuario(PARAM_INCORRECT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, 'p_estado: '||substr(p_estado, 1, 3)|| paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      v_cantidad := 0;
      --las solicitudes realizadas
      -- SOLICITADAS
      IF p_tipo = 'S' THEN
         --SOLICITADAS PENDIENTES
         IF p_estado = 'P' THEN
            FOR v_dato IN c_solicitadas(v_usu_sesion.codigoPersona) LOOP
               IF v_dato.fec_vencimiento < TRUNC(SYSDATE) THEN
                  BEGIN
                     UPDATE bw_sol_transferencias s
                        SET estado = 'N'
                      WHERE s.cod_solicitud = v_dato.cod_solicitud
                        AND s.cod_per_solicitante = v_usu_sesion.codigoPersona;
                  EXCEPTION
                     WHEN OTHERS THEN
                        paw_uti.pr_mensajeUsuario(ERR_ACT_SOL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, ' ORA-ERR: [' || substr(sqlerrm, 1, 200) || '] ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                        return v_retorno;
                  END;
               ELSE
                  lp_obt_dat_cuenta(v_dato.cod_persona_solicitada, v_dato.nro_cta_debito, v_nom_solicitado, v_cod_modulo);
                  v_solRes.fecha := v_dato.fec_insercion;
                  v_solRes.nro_cta_credito := v_dato.nro_cta_credito;
                  v_solRes.nom_contacto := v_nom_solicitado;
                  v_solRes.cta_contacto := v_dato.nro_cta_debito;
                  v_solRes.estado := v_dato.estado;
                  v_solRes.monto := v_dato.monto;
                  v_solRes.concepto := v_dato.concepto;
                  v_solRes.tipo := 'S';
                  v_solRes.tipo_cta := v_cod_modulo;
                  v_solRes.uuid := v_dato.cod_solicitud;
                  v_solRes.concepto := v_dato.concepto;
                  v_solRes.moneda := v_dato.cod_moneda;

                  v_listaSolicitudes.Extend;
                  v_listaSolicitudes(v_listaSolicitudes.Count) := v_solRes;
                  v_cantidad := v_cantidad + 1;
               END IF;
            END LOOP;
         --SOLICITADAS HISTORIAL
         ELSE
            FOR v_dato IN c_sol_historico(v_usu_sesion.codigoPersona) LOOP
               lp_obt_dat_cuenta(v_dato.cod_persona_solicitada, v_dato.nro_cta_debito, v_nom_solicitado, v_cod_modulo);
               v_solRes.fecha := v_dato.fec_insercion;
               v_solRes.nro_cta_credito := v_dato.nro_cta_credito;
               v_solRes.nom_contacto := v_nom_solicitado;
               v_solRes.cta_contacto := v_dato.nro_cta_debito;
               v_solRes.estado := v_dato.estado;
               v_solRes.monto := v_dato.monto;
               v_solRes.concepto := v_dato.concepto;
               v_solRes.tipo := 'S';
               v_solRes.tipo_cta := v_cod_modulo;
               v_solRes.uuid := v_dato.cod_solicitud;
               v_solRes.concepto := v_dato.concepto;
               v_solRes.moneda := v_dato.cod_moneda;

               v_listaSolicitudes.Extend;
               v_listaSolicitudes(v_listaSolicitudes.Count) := v_solRes;
               v_cantidad := v_cantidad + 1;
            END LOOP;
         END IF;
      -- RECIBIDAS
      ELSIF p_tipo = 'E' THEN
         --RECIBIDAS PENDIENTES
         IF p_estado = 'P' THEN
            FOR v_dato IN c_sol_recibidas(v_usu_sesion.codigoPersona) LOOP
               IF v_dato.fec_vencimiento < trunc(sysdate) THEN
                  BEGIN
                     UPDATE bw_sol_transferencias s
                        SET estado = 'N'
                      WHERE s.cod_solicitud = v_dato.cod_solicitud
                        AND s.cod_persona_solicitada = v_usu_sesion.codigoPersona;
                  EXCEPTION
                     WHEN OTHERS THEN
                        paw_uti.pr_mensajeUsuario(ERR_ACT_SOL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, 800, v_usu_sesion.codigoEmpresa, ' ORA-ERR: [' || substr(sqlerrm, 1, 200) || '] ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                        return v_retorno;
                  END;
               ELSE
                  lp_obt_dat_cuenta(v_dato.cod_per_solicitante, v_dato.nro_cta_credito, v_nom_solicitado, v_cod_modulo);
                  v_solRes.fecha := v_dato.fec_insercion;
                  v_solRes.nro_cta_credito := v_dato.nro_cta_credito;
                  v_solRes.nom_contacto := v_nom_solicitado;
                  v_solRes.cta_contacto := v_dato.nro_cta_debito;
                  v_solRes.estado := v_dato.estado;
                  v_solRes.monto := v_dato.monto;
                  v_solRes.concepto := v_dato.concepto;
                  v_solRes.tipo := 'E';
                  v_solRes.tipo_cta := v_cod_modulo;
                  v_solRes.uuid := v_dato.cod_solicitud;
                  v_solRes.concepto := v_dato.concepto;
                  v_solRes.moneda := v_dato.cod_moneda;
                  v_solRes.nro_doc_beneficiario := v_dato.cod_per_solicitante;

                  v_listaSolicitudes.Extend;
                  v_listaSolicitudes(v_listaSolicitudes.Count) := v_solRes;
                  v_cantidad := v_cantidad + 1;
               END IF;
            END LOOP;
         -- RECIBIDAS HISTORIAL
         ELSE
            FOR v_dato IN c_rec_historico(v_usu_sesion.codigoPersona) LOOP
               lp_obt_dat_cuenta(v_dato.cod_per_solicitante, v_dato.nro_cta_credito, v_nom_solicitado, v_cod_modulo);
               v_solRes.fecha := v_dato.fec_insercion;
               v_solRes.nro_cta_credito := v_dato.nro_cta_credito;
               v_solRes.nom_contacto := v_nom_solicitado;
               v_solRes.cta_contacto := v_dato.nro_cta_debito;
               v_solRes.estado := v_dato.estado;
               v_solRes.monto := v_dato.monto;
               v_solRes.concepto := v_dato.concepto;
               v_solRes.tipo := 'E';
               v_solRes.tipo_cta := v_cod_modulo;
               v_solRes.uuid := v_dato.cod_solicitud;
               v_solRes.concepto := v_dato.concepto;
               v_solRes.moneda := v_dato.cod_moneda;
               v_solRes.nro_doc_beneficiario := v_dato.cod_per_solicitante;

               v_listaSolicitudes.Extend;
               v_listaSolicitudes(v_listaSolicitudes.Count) := v_solRes;
               v_cantidad := v_cantidad + 1;
            END LOOP;
         END IF;
      END IF;

      v_retorno.cantidad := v_cantidad;
      v_retorno.lista := v_listaSolicitudes;
      paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, 'fu_obt_sol_transferencias: ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, 'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_can_sol_transferencias(p_session      IN VARCHAR2,
                                      p_codCanal     IN VARCHAR2,
                                      p_codSolicitud IN VARCHAR2,
                                      p_ctaCredito   IN VARCHAR2,
                                      p_ctaDebito    IN VARCHAR2,
                                      p_modo         IN VARCHAR2) RETURN typ_solmultiple IS

      -- Solicitud no corresponde a sesion de usuario
      COD_OPE_INVALIDA CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_DAT_INVALIDO CONSTANT VARCHAR2(15) := 'ERR_SOL_INVALID';

      v_retorno      typ_solmultiple := typ_solmultiple();
      v_usu_sesion   typ_validarSesion;
      v_cod_mensaje  bw_tip_mensajes.cod_tip_mensaje%TYPE := '239';
      v_fecha        DATE;
      v_nomCredito   VARCHAR2(60);
      v_ctaCredito   VARCHAR2(16);
      v_monto        ge_movimientos.monto%TYPE;
      v_concepto     ge_movimientos.concepto%TYPE;
      v_moneda       ba_monedas.cod_moneda%TYPE;
      v_nomDebito    VARCHAR2(60);
      v_ctaDebito    ge_cuentas.nro_cuenta%TYPE;
      v_codSolicitud VARCHAR(50);
      v_modo         VARCHAR2(1);
      v_msj_bitacora VARCHAR2(1000);
      v_res_not      NUMBER;
      v_fec_solicitud bw_sol_transferencias.fec_insercion%TYPE;
   BEGIN
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_session, 32), p_codCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error               := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      v_modo := substr(TRIM(p_modo), 1, 1);
      v_retorno.error := 'S';
      v_msj_bitacora := paw_uti.depurarTextos('modo: '||v_modo || ', ctaDeb: ' || p_ctaDebito || ', ctaCre: ' || p_ctaCredito || ', codSol: ' || p_codSolicitud, 500);
      paw_uti.pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, v_msj_bitacora ||' '|| paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ENTRADA);

      FOR account IN (SELECT nro_cuenta
                        FROM ge_cta_clientes
                       WHERE cod_persona = v_usu_sesion.codigoPersona)LOOP
         IF account.nro_cuenta = p_ctaCredito OR account.nro_cuenta = p_ctaDebito THEN
            v_retorno.error := 'N';
         END IF;
      END LOOP;

      IF v_retorno.error = 'S' THEN
         paw_uti.pr_mensajeUsuario(COD_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, v_msj_bitacora ||' ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      BEGIN
         SELECT t.fec_insercion, c.pri_nombre || ' ' || c.pri_apellido, t.nro_cta_credito, t.monto, t.concepto, t.cod_moneda,
                d.pri_nombre || ' ' || d.pri_apellido, t.nro_cta_debito, t.cod_solicitud, t.fec_insercion
           INTO v_fecha, v_nomCredito, v_ctaCredito, v_monto, v_concepto, v_moneda,
                v_nomDebito, v_ctaDebito, v_codSolicitud, v_fec_solicitud
           FROM bw_sol_transferencias t
          INNER JOIN ge_cta_clientes g1 ON t.nro_cta_credito = g1.nro_cuenta
           LEFT JOIN ba_per_fisicas c ON c.cod_persona = g1.cod_persona
          INNER JOIN ge_cta_clientes g2 ON t.nro_cta_debito = g2.nro_cuenta
           LEFT JOIN ba_per_fisicas d ON d.cod_persona = g2.cod_persona
          WHERE t.nro_cta_credito = p_ctaCredito
            AND t.nro_cta_debito = p_ctaDebito
            AND t.cod_solicitud = p_codSolicitud
            AND (t.cod_persona_solicitada = v_usu_sesion.codigoPersona OR
                 t.cod_per_solicitante = v_usu_sesion.codigoPersona)
            AND t.estado = 'P'
            AND g1.relacion = 'P'
            AND ROWNUM = 1;

         IF v_modo = 'C' THEN
            UPDATE bw_sol_transferencias
               SET estado = 'R'
             WHERE nro_cta_credito = v_ctaCredito
               AND nro_cta_debito = v_ctaDebito
               AND cod_solicitud = v_codSolicitud
               AND (cod_persona_solicitada = v_usu_sesion.codigoPersona OR
                    cod_per_solicitante = v_usu_sesion.codigoPersona);
            -- se notifica el rechazo al solicitante
            v_res_not := paw_not.fu_not_rec_multiple('R', fug_obt_cli_principal(v_ctaCredito), v_moneda, v_monto, v_ctaCredito, v_fec_solicitud);
            v_msj_bitacora := substr(v_msj_bitacora ||', res_not: '||v_res_not, 1, 1000);
         END IF;
      EXCEPTION
         WHEN no_data_found THEN
            paw_uti.pr_mensajeUsuario(MSG_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, v_msj_bitacora ||' ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
      END;

      v_retorno.fecha := v_fecha;
      v_retorno.nom_beneficiario := v_nomCredito;
      v_retorno.nro_cta_credito := v_ctaCredito;
      v_retorno.monto := v_monto;
      v_retorno.concepto := v_concepto;
      v_retorno.moneda := v_moneda;
      v_retorno.nom_contacto := v_nomDebito;
      v_retorno.cta_contacto := v_ctaDebito;
      v_retorno.uuid := v_codSolicitud;

      paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_mensaje, v_usu_sesion.codigoEmpresa, v_msj_bitacora ||' ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
   END;

   /*FUNCTION fu_transferenciaEnlote(p_sesion                    IN VARCHAR2,
                                   p_codigoCanal               IN NUMBER,
                                   p_modo                      IN VARCHAR2,
                                   p_numeroLote                IN NUMBER,
                                   p_numeroCuenta              IN VARCHAR2,
                                   p_monto                     IN NUMBER,
                                   p_fechaPago                 IN DATE,
                                   p_nroCuentaCredito          IN VARCHAR2,
                                   p_CodigoSwiftBanco          IN VARCHAR2,
                                   p_nroDocumentoBeneficiario  IN VARCHAR2,
                                   p_tipoDocumentoBeneficiario IN NUMBER,
                                   p_nombreBeneficiario        IN VARCHAR2,
                                   p_codigoMonedaCredito       IN VARCHAR2,
                                   p_concepto                  IN VARCHAR2,
                                   p_tipo                      IN VARCHAR2,
                                   p_claveTransaccional        IN VARCHAR2,
                                   p_claveToken                IN VARCHAR2,
                                   p_cod_solicitud             IN VARCHAR2) RETURN TYP_TRANSFERENCIASLOTE IS

    v_cod_operacion       bw_tip_mensajes.cod_tip_mensaje%TYPE := '029';
    v_valSesion           typ_validarSesion;
    v_retorno             TYP_TRANSFERENCIASLOTE := TYP_TRANSFERENCIASLOTE;
    v_listaTransferencias typ_listatransferencialote := typ_listatransferencialote();
    v_transferencia       typ_transferencialote := typ_transferencialote;
    v_transRes            typ_transferencialote := typ_transferencialote;
    v_retError            typ_mensajeRespuesta := typ_mensajeRespuesta;
    v_mensajeCaja         typ_mensajeCaja;
    v_resLimite           typ_respuestaLimite;
    v_permiso             typ_obtenerPermisos;
    v_cod_tra_padre       ge_transacciones.cod_transaccion%TYPE := 388; -- cod. transaccion padre
    v_CodigoCanal         cj_cajas.nro_caja%TYPE;
    v_modo                VARCHAR2(1);
    v_resInsLote          NUMBER(3);
    v_numeroDocumento     NUMBER(10) := 0;
    v_cod_mod_debito      ge_modalidades.cod_modulo%TYPE;
    v_cod_mon_debito      ba_monedas.cod_moneda%TYPE;
    v_cod_mad_debito      ge_modalidades.cod_modalidad%TYPE;
    v_cod_ofi_debito      ba_oficinas.cod_oficina%TYPE;
    v_nom_cta_debito      ge_cuentas.denominacion%TYPE;
    v_cod_modulo          ge_modalidades.cod_modulo%TYPE;
    v_cod_modalidad       ge_modalidades.cod_modalidad%TYPE;
    v_nro_cuenta          VARCHAR(16);
    v_redondeo            NUMBER;
    v_monto               ge_movimientos.monto%TYPE;
    TRP_SIN_PERMISO       CONSTANT VARCHAR2(15) := 'TRP_SIN_PERMISO';
    TRA_MTO_INVALIDO      CONSTANT VARCHAR2(15) := 'TRA_MTO_INVALID';
    G_DATO_INV            CONSTANT VARCHAR2(15) := 'G_DATO_INV';
    G_DAT_DUP             CONSTANT VARCHAR2(15) := 'TRA_LOT_PAGDUP';
    ERR_SOL_CTA_INVALIDO  CONSTANT VARCHAR2(15) := 'TRA_LOT_PAGDUP';
    v_fec_valor           ge_calendarios.fec_actual%TYPE := pag_cal.fu_obt_fec_actual(9);
    v_mto_total           ge_movimientos.monto%TYPE := 0;
    v_res_not             NUMBER;
    v_msj_bitacora        VARCHAR2(1000) := substr('lote:' || nvl(p_numerolote, 0)
                                                    || ', ctaDeb' || TRIM(nvl(p_numeroCuenta, 'x'))
                                                    || ', mto:' || nvl(p_monto, 0)
                                                    || ', ctaCre:' || TRIM(nvl(p_nroCuentaCredito, 'x'))
                                                    || ', modo:' || TRIM(nvl(p_modo, 'x'))
                                                    || ', cpto:' || paw_uti.depurarTextos(nvl(p_concepto, 'x'), 35)
                                                    || ', p_CodigoSwiftBanco:' || nvl(p_CodigoSwiftBanco, 'x')
                                                    || ', p_cod_solicitud:' || nvl(p_cod_solicitud, 'x')
                                                    || ', token: [***]', 1, 1000);

    --Cursor Recupera las transferencias del lote
    CURSOR c_transferencias(p_codigoPersona VARCHAR2, p_numeroLote NUMBER) IS
       SELECT nro_lote, cod_persona, nro_cuenta, monto, fec_pago, nro_cta_credito, cod_banco,
              nro_doc_beneficiario, nom_beneficiario, cod_mon_credito, concepto, cod_estado,
              nro_referencia, tipo, cod_tip_doc_beneficiario, error, cod_respuesta
         FROM bw_lot_transferencias
        WHERE cod_persona = p_codigoPersona
          AND nro_lote = p_numeroLote
          AND tipo = 'T'; --Solo se pagan los del tipo p

    PROCEDURE lp_obt_totales(p_codPersona IN VARCHAR2,
                             p_numeroLote NUMBER,
                             p_cantidadTotal OUT NUMBER,
                             p_montoTotal OUT NUMBER) IS
    BEGIN
       SELECT nvl(COUNT(*), 0), nvl(SUM(monto), 0)
         INTO p_cantidadTotal, p_montoTotal
         FROM bw_lot_transferencias
        WHERE cod_persona = p_codPersona
          AND nro_lote = p_numeroLote;
    END;

    -- cambia el estado de una transferencia en un lote
    PROCEDURE lp_cambiarEstadoTransferencia(p_transferencia IN TYP_TRANSFERENCIALOTE,
                                            p_numeroLote    IN NUMBER,
                                            p_estado        IN VARCHAR2,
                                            p_nroReferencia IN NUMBER DEFAULT NULL) IS
    BEGIN
       UPDATE bw_lot_transferencias l
          SET l.cod_estado = p_estado, l.nro_referencia = nvl(p_nroReferencia,l.nro_referencia)
        WHERE l.cod_persona = p_transferencia.CodigoPersona
          AND l.nro_cta_credito = p_transferencia.NroCuentaCredito
          AND l.cod_banco = p_transferencia.CodigoBanco
          AND l.nro_lote = p_numeroLote;
    END;

    FUNCTION lf_ins_transferenciaLote(p_transferencia    IN TYP_TRANSFERENCIALOTE,
                                      p_numeroReferencia IN VARCHAR2,
                                      p_error            IN VARCHAR2,
                                      p_cod_respuesta    IN VARCHAR2,
                                      p_cod_canal        IN VARCHAR2) RETURN NUMBER IS
    BEGIN
       BEGIN
          INSERT INTO bw_lot_transferencias
             (nro_lote, cod_persona, nro_cuenta, monto, fec_pago, nro_cta_credito, cod_banco,
              nro_doc_beneficiario, cod_tip_doc_beneficiario, nom_beneficiario, cod_mon_credito, concepto,
              cod_estado, nro_referencia, tipo, error, cod_respuesta, cod_canal)
          VALUES
             (p_transferencia.NumeroLote, p_transferencia.CodigoPersona, p_transferencia.NumeroCuenta,
              p_transferencia.Monto, p_transferencia.FechaPago, p_transferencia.NroCuentaCredito,
              p_transferencia.CodigoBanco, p_transferencia.NumeroDocBeneficiario,
              p_transferencia.CodigoDocBeneficiario, p_transferencia.NombreBeneficiario,
              p_transferencia.CodigoMoneda, p_transferencia.Concepto, 'N', p_numeroReferencia,
              p_transferencia.Tipo, p_error, p_cod_respuesta, p_cod_canal);
       EXCEPTION
          WHEN DUP_VAL_ON_INDEX THEN
             RETURN 10;
          WHEN OTHERS THEN
             RETURN 1;
       END;
       RETURN 0;
    END;

    -- para recuperar e insertar respuestas.
    PROCEDURE lf_generarLog(p_Mensaje IN VARCHAR2,
                            p_retorno IN OUT TYP_TRANSFERENCIASLOTE,
                            p_tipo IN VARCHAR2,
                            p_codigoPersona IN VARCHAR2,
                            p_codigoEmpresa IN VARCHAR2,
                            p_adicional IN VARCHAR2) IS
    BEGIN
       pr_mensajeUsuario(p_Mensaje, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);
       pr_insertarBitacora(p_codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, p_codigoEmpresa, p_adicional || fu_generarbitacora(p_retorno.error, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, NULL), p_tipo);
    END;
  BEGIN
     --valido la sesion del cliente
     v_CodigoCanal := depurarAlfanumerico(p_CodigoCanal, 3);
     v_valSesion := fu_validarSesion(p_sesion, p_codigoCanal);
     lf_generarLog(MSG_OK, v_retorno, BITACORA_ENTRADA, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora || '. fu_transferenciaEnlote: ');
     IF v_valSesion.error = 'S' THEN
        v_retorno.error                := v_valSesion.error;
        v_retorno.nombreRespuesta      := v_valSesion.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_valSesion.descripcionRespuesta;
        RETURN v_retorno;
     END IF;
     -- validamos la caja
     v_mensajeCaja := lf_val_caja(v_valSesion);
     IF v_mensajeCaja.error = 'S' THEN
        v_retorno.error                := v_mensajeCaja.error;
        v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
        RETURN v_retorno;
     END IF;
     --Verifica los permisos
     v_permiso := lf_obt_permisos(v_valSesion, v_cod_operacion);
     IF (v_permiso.error = 'S') THEN
        lf_generarLog(v_permiso.nombreRespuesta, v_retorno, BITACORA_ERROR, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora);
        RETURN v_retorno;
     END IF;
     -- se verifica que tenga permiso para registrar
     IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
        lf_generarLog(TRP_SIN_PERMISO, v_retorno, BITACORA_ERROR, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora);
        RETURN v_retorno;
     END IF;
     -- se depuran y validan parametros

     -- Se verifica si la cuenta tiene saldo disponible
     v_nro_cuenta := trim(nvl(p_numeroCuenta, ''));
     v_monto := nvl(p_monto, 0);
     v_redondeo := fug_obt_pardinamico('VAL_RED_MON_EXTRANJERA', NULL, NULL, v_cod_mon_local, NULL, NULL);
     v_retError := lf_val_cta_debito(v_nro_cuenta, v_cod_tra_padre, v_monto, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_nro_cuenta, v_nom_cta_debito, v_valSesion, v_mensajeCaja, v_cod_modulo, v_cod_modalidad);
     IF (v_retError.error = 'S') THEN
        lf_generarLog(v_retError.nombreRespuesta, v_retorno, BITACORA_ERROR, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora);
        v_retorno.error := v_retError.error;
        v_retorno.nombreRespuesta := v_retError.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_retError.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     BEGIN
        v_modo                                := substr(p_modo, 0, 1);
        v_transferencia.NumeroCuenta          := depurarAlfanumerico(p_numeroCuenta, 16);
        v_transferencia.NroCuentaCredito      := depurarAlfanumerico(p_nroCuentaCredito, 16);
        v_transferencia.CodigoBanco           := nvl(p_CodigoSwiftBanco, 'BBVAPYPAA'); -- por defecto BBVA
        v_transferencia.Monto                 := nvl(p_monto, 0); -- monto a transferir
        v_transferencia.NumeroLote            := nvl(p_numeroLote, -1);
        v_transferencia.CodigoPersona         := v_valSesion.codigoPersona;
        v_transferencia.FechaPago             := p_fechaPago;
        v_transferencia.CodigoMoneda          := v_cod_mon_local;
        v_transferencia.CodigoMonedaCredito   := v_cod_mon_local;
        v_transferencia.CodigoDocBeneficiario := nvl(p_tipoDocumentoBeneficiario, 0);
        v_transferencia.MontoCredito          := v_transferencia.Monto;
        v_transferencia.Tipo                  := nvl(substr(p_tipo,0,1),'P');
        v_transferencia.NumeroDocBeneficiario := p_nroDocumentoBeneficiario;
        v_transferencia.NombreBeneficiario    := paw_uti.depurarTextos(p_nombreBeneficiario, 120);

        IF p_concepto IS NOT NULL THEN
           v_transferencia.Concepto := paw_uti.depurarTextos(p_concepto, 35);
        END IF;

        v_retorno.NumeroLote   := v_transferencia.NumeroLote;
        v_retorno.numeroCuenta := v_transferencia.NumeroCuenta;

        IF (v_retorno.NumeroLote < 0 AND v_modo <> 'L') THEN
           lf_generarLog(G_DATO_INV, v_retorno, BITACORA_ERROR, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora);
           RETURN v_retorno;
        END IF;

        IF (v_monto <= 0 OR v_monto <> trunc(v_monto, v_redondeo)) AND v_modo = 'N' THEN
           lf_generarLog(TRA_MTO_INVALIDO, v_retorno, BITACORA_ERROR, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora);
           RETURN v_retorno;
        END IF;
     EXCEPTION
        WHEN OTHERS THEN
           v_msj_bitacora := substr(v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ', 1, 1000);
           lf_generarLog(G_DATO_INV, v_retorno, BITACORA_ERROR, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora);
          RETURN v_retorno;
     END;
     -- Se verifica si la cuenta tiene saldo disponible
     SELECT NVL(SUM(monto), 0)
       INTO v_monto
       FROM bw_lot_transferencias b
      WHERE b.nro_lote = v_transferencia.NumeroLote;
     v_retError := lf_val_cta_debito(v_transferencia.NumeroCuenta, v_cod_tra_padre, v_monto, v_transferencia.CodigoMoneda, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_transferencia.NumeroCuenta, v_nom_cta_debito, v_valSesion, v_mensajeCaja, v_cod_modulo, v_cod_modalidad);

     IF (v_retError.error = 'S') THEN
        v_retorno.error := v_retError.error;
        v_retorno.nombreRespuesta := v_retError.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_retError.descripcionRespuesta;
        v_msj_bitacora := substr(v_msj_bitacora || ', mto_tot: '||v_monto, 1, 1000);
        lf_generarLog(v_retError.nombreRespuesta, v_retorno, BITACORA_ERROR, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora);
        RETURN v_retorno;
     END IF;

     -- Modo L, busca el ultimo nro de lote para el cod persona logueado
     IF (v_modo = 'L') THEN
        SELECT nvl(MAX(nro_lote), 0) + 1
          INTO v_retorno.NumeroLote
          FROM bw_lot_transferencias;
        RETURN v_retorno;
     END IF;

     --Inserto el pago
     IF (v_modo = 'N') THEN
        SELECT S_TRANSFERENCIALOTES.NEXTVAL
          INTO v_numeroDocumento
          FROM dual;

       \* IF (v_transferencia.CodigoBanco = 'BBVAPYPAA') THEN
           --valido el pago
           v_transRes := PAW_BAS.fu_TransferenciaLocal(v_mensajeCaja,
                                                       p_codigoCanal,
                                                       v_valSesion.codigoPersona,
                                                       v_valSesion.codigoEmpresa,
                                                       v_transferencia.FechaPago,
                                                       v_retorno.NumeroCuenta,
                                                       v_transferencia.NroCuentaCredito,
                                                       v_transferencia.Monto,
                                                       v_transferencia.Monto,
                                                       v_transferencia.Concepto,
                                                       v_cod_operacion,
                                                       p_sesion,
                                                       v_modo,
                                                       v_numeroDocumento,
                                                       p_nroDocumentoBeneficiario);
        ELSE
           v_transRes := paw_bas.fu_TransferenciaInterbancaria(v_mensajeCaja,
                                                               p_codigoCanal,
                                                               v_modo,
                                                               v_valSesion.codigoPersona,
                                                               v_valSesion.codigoEmpresa,
                                                               v_transferencia.FechaPago,
                                                               v_retorno.NumeroCuenta,
                                                               v_transferencia.NroCuentaCredito,
                                                               v_cod_mon_local,
                                                               v_transferencia.MontoCredito,
                                                               v_transferencia.Concepto,
                                                               v_transferencia.CodigoBanco,
                                                               v_transferencia.NombreBeneficiario,
                                                               NULL,
                                                               v_transferencia.CodigoDocBeneficiario,
                                                               v_transferencia.NumeroDocBeneficiario,
                                                               p_sesion,
                                                               'A',
                                                               'O',
                                                               v_can_aut_requeridas);
        END IF;*\ --verificar esta partek
        v_resInsLote := lf_ins_transferenciaLote(v_transferencia, v_numeroDocumento, v_transRes.error, v_transRes.nombreRespuesta, v_CodigoCanal);
        IF (v_resInsLote = 10) THEN
           lf_generarLog(G_DAT_DUP, v_retorno, BITACORA_ERROR, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora);
        END IF;
        IF (v_retorno.error = 'S') THEN
           RETURN v_retorno;
        END IF;
     END IF;
     --Obtiene los totales hasta ahora
     lp_obt_totales(v_valSesion.codigoPersona, v_retorno.NumeroLote, v_retorno.Cantidad, v_retorno.Total);

     -- se agrega control de limite de operaciones
     --controla los totales hasta ahora
     v_resLimite := fu_obtenerLimite(v_valSesion,
                                     v_cod_operacion,
                                     nvl(v_valSesion.codigoEmpresa, v_valSesion.codigoPersona),
                                     v_retorno.numeroCuenta,
                                     v_cod_mon_local,
                                     503,
                                     v_transferencia.NumeroLote,
                                     v_retorno.Total,
                                     v_modo);

     IF v_resLimite.error = 'S' THEN
        lf_generarLog(v_resLimite.nombreRespuesta, v_retorno, BITACORA_ERROR, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora);
        RETURN v_retorno;
     END IF;
     v_retorno.resLimite := v_resLimite.codRespuesta;
     v_msj_bitacora := substr(v_msj_bitacora || ', resLimite: ' || v_retorno.resLimite, 1, 1000);

     IF v_modo IN ('C') THEN
        v_retError.error := 'N';
        DECLARE
           v_lugar VARCHAR2(50);
        BEGIN
           IF v_resLimite.codRespuesta IN ('10', '11') THEN
              -- clave transaccional requerida
              v_lugar    := 'lf_obt_cla_validar - ';
              v_retError := lf_obt_cla_validar(p_claveTransaccional, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, 'T');
           END IF;

           IF v_retError.error = 'N' THEN
              IF v_resLimite.codRespuesta IN ('01', '11') THEN
                 -- token requerido
                 v_lugar    := ' - paw_seg.fu_obt_tok_validar - ';
                 v_retError := paw_seg.fu_obt_tok_validar(p_claveToken, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_modo);
              END IF;
           END IF;

           IF v_retError.error = 'S' THEN
              lf_generarLog(v_retError.nombreRespuesta, v_retorno, BITACORA_ERROR, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora||v_lugar);
              RETURN v_retorno;
           END IF;
        END;
     END IF;

     FOR r_transferencia IN c_transferencias(v_valSesion.codigoPersona, v_retorno.NumeroLote) LOOP
        IF (r_transferencia.Cod_Banco = 'BBVAPYPAA') THEN
           v_transferencia := paw_bas.fu_TransferenciaLocal(v_mensajeCaja,
                                                            p_codigoCanal,
                                                            v_valSesion.codigoPersona,
                                                            v_valSesion.codigoEmpresa,
                                                            r_transferencia.Fec_Pago,
                                                            v_retorno.NumeroCuenta,
                                                            r_transferencia.nro_cta_credito,
                                                            r_transferencia.Monto,
                                                            r_transferencia.Monto,
                                                            r_transferencia.Concepto,
                                                            v_cod_operacion,
                                                            p_sesion,
                                                            v_modo,
                                                            r_transferencia.nro_referencia,
                                                            p_nroDocumentoBeneficiario);
           r_transferencia.nom_beneficiario := substr(fug_obt_nom_cuenta(r_transferencia.nro_cta_credito), 1, 120);
        ELSE
           v_transferencia := paw_bas.fu_TransferenciaInterbancaria(v_mensajeCaja,
                                                                    p_codigoCanal,
                                                                    v_modo,
                                                                    v_valSesion.codigoPersona,
                                                                    v_valSesion.codigoEmpresa,
                                                                    r_transferencia.Fec_Pago,
                                                                    r_transferencia.nro_cuenta,
                                                                    r_transferencia.nro_cta_credito,
                                                                    v_cod_mon_local,
                                                                    r_transferencia.monto,
                                                                    r_transferencia.concepto,
                                                                    r_transferencia.cod_banco,
                                                                    r_transferencia.nom_beneficiario,
                                                                    NULL,
                                                                    r_transferencia.cod_tip_doc_beneficiario,
                                                                    r_transferencia.nro_doc_beneficiario,
                                                                    p_sesion,
                                                                    'A',
                                                                    'O',
                                                                    v_can_aut_requeridas);

        END IF;
        v_transferencia.CodigoBanco:=r_transferencia.Cod_Banco;
        v_transferencia.NroCuentaCredito := r_transferencia.nro_cta_credito;
        v_transferencia.NombreBeneficiario := r_transferencia.nom_beneficiario;
        IF (v_transferencia.error = 'N' AND v_modo = 'C') THEN
           v_mto_total := v_mto_total + r_transferencia.monto;
           IF (r_transferencia.Cod_Banco = 'BBVAPYPAA') THEN
              lp_cambiarEstadoTransferencia(v_transferencia, r_transferencia.nro_lote, 'C',NULL);
           ELSE
              lp_cambiarEstadoTransferencia(v_transferencia, r_transferencia.nro_lote, 'E',v_transferencia.NroReferencia);
           END IF;
           IF (p_cod_solicitud IS NOT NULL) THEN
              BEGIN
                 UPDATE bw_sol_transferencias s
                    SET s.estado = 'A',
                        s.nro_cta_debito = r_transferencia.nro_cuenta
                  WHERE s.cod_solicitud = p_cod_solicitud
                    AND s.cod_persona_solicitada = r_transferencia.cod_persona
                    AND s.nro_cta_credito = r_transferencia.nro_cta_credito;
              EXCEPTION
                 WHEN OTHERS THEN
                    pr_mensajeUsuario(ERR_SOL_CTA_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(v_valSesion.codigoPersona, v_CodigoCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, ' ORA-ERR: [' || substr(sqlerrm, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                    RETURN v_retorno;
              END;
           END IF;
        ELSIF (v_transferencia.error = 'S' AND v_modo = 'C') THEN
           lp_cambiarEstadoTransferencia(v_transferencia, r_transferencia.nro_lote, 'R', NULL);
        END IF;
        v_transferencia.NumeroLote := r_transferencia.nro_lote;
        v_listaTransferencias.Extend;
        v_listaTransferencias(v_listaTransferencias.Count) := v_Transferencia;
     END LOOP;
     -- notificamos el total de transferencia a terceros, sipap tiene su propio notificador
     IF v_modo = 'C' AND v_mto_total > 0 THEN
        BEGIN
           v_res_not := PAW_NOT.fu_not_transferencias(v_nro_cuenta, v_mto_total, v_cod_mon_local, 'D', v_fec_valor);
           v_msj_bitacora := substr(v_msj_bitacora ||', not_loc: '||v_res_not, 1, 1000);
        EXCEPTION
           WHEN OTHERS THEN
              NULL;
        END;
     END IF;
     lf_generarLog(v_retError.nombreRespuesta, v_retorno, BITACORA_SALIDA, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_msj_bitacora);
     v_retorno.ListaTransferencias := v_listaTransferencias;
     RETURN v_retorno;
  EXCEPTION
     WHEN OTHERS THEN
        pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(v_valSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, 'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
        RETURN v_retorno;
  END;*/

   FUNCTION fu_obt_cta_telefonos(p_sesion        IN VARCHAR2,
                                 p_codCanal      IN VARCHAR2,
                                 p_can_contactos IN NUMBER,
                                 p_contactos     IN CLOB) RETURN typ_obtContactosMultiple IS
     v_retorno          typ_obtcontactosmultiple := typ_obtcontactosmultiple;
     detalle            typ_contactosmultiple := typ_contactosmultiple;
     lista              typ_listacontactosmultiple := typ_listacontactosmultiple();
     v_cod_operacion    VARCHAR2(3) := '240';
     retValidarSesion   typ_validarSesion;
     v_permiso          typ_obtenerPermisos;
     v_mensajeCaja      typ_mensajeCaja;
     v_can_detalles     NUMBER := 0;
     v_dias_sync        NUMBER := to_number(fug_obt_pardinamico('SYNC_MULT_CONTACTOS'));
     v_min_sync         NUMBER := nvl(to_number(fug_obt_pardinamico('SYNC_MIN_CONTACTOS')), 20);
     v_tie_contactos    NUMBER;
     v_sincronizar      VARCHAR2(1) := 'N';
     v_pos_separador    NUMBER;
     v_cod_area         ba_telefonos.area%TYPE;
     v_nro_telefono     ba_telefonos.telefono%TYPE;
     v_cod_persona      ba_personas.cod_persona%TYPE;
     v_linea            VARCHAR2(1000);
     v_pos_anterior     NUMBER;
     v_pos_actual       NUMBER;
     v_tag              bw_bitacora.tipo%TYPE;
     --Consulta de los contactos ya existentes
     CURSOR c_consulta IS
        SELECT nom_contacto, nro_contacto, cta_contacto, ori_contacto, ban_contacto,
               cod_swift, nro_documento, tip_documento, cod_moneda, tip_cuenta, estado, mail
          FROM bw_lot_tra_contactos tc LEFT OUTER JOIN bw_tra_cta_configurado cc
            ON tc.cod_persona_contacto = cc.cod_persona
         WHERE tc.cod_persona = v_cod_persona;
   BEGIN
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);

      paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, paw_uti.fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta, null), paw_uti.BITACORA_ENTRADA);

      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      END IF;

      IF v_retorno.error <> 'S' THEN
         v_cod_persona := nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);
         v_mensajeCaja := lf_val_caja(retValidarSesion);
         IF v_mensajeCaja.error = 'S' THEN
            v_retorno.error                := v_mensajeCaja.error;
            v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         END IF;
      END IF;
       --Verifica los permisos
     v_permiso := lf_obt_permisos(retValidarSesion, v_cod_operacion);
     IF v_permiso.error = 'S' THEN
        v_retorno.error                := v_permiso.error;
        v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
     END IF;

      IF v_retorno.error <> 'S' and p_contactos IS NOT NULL THEN
         --verificar si ya tiene contactos guardados
         SELECT COUNT(1)
           INTO v_tie_contactos
           FROM bw_lot_tra_contactos
          WHERE cod_persona = v_cod_persona;
         --veriricar si debemos sincronizar
         IF v_tie_contactos > 0 THEN
            BEGIN
               SELECT 'S'
                 INTO v_sincronizar
                 FROM bw_lot_tra_contactos
                WHERE cod_persona = v_cod_persona
                  AND pag_cal.fu_obt_fec_sig_hab(fec_insercion, 7, v_dias_sync) < SYSDATE
                  AND ((SYSDATE) - fec_insercion) * 1440 > v_min_sync
                  AND ROWNUM = 1;
            EXCEPTION
               WHEN OTHERS THEN
                  v_sincronizar := 'N';
             END;
         END IF;

         detalle.ori_contacto  := 'M';
         detalle.ban_contacto  := '';
         detalle.cod_swift     := '';
         detalle.cod_moneda    := v_cod_mon_local;

         IF v_sincronizar = 'N' THEN --si no sincronizamos, Select de la tabla
            FOR contacto IN c_consulta LOOP
               --Para contactos del BBVA, deben estar activos en multiple
               IF nvl(contacto.estado, 'A') = 'A' THEN
                  v_can_detalles := v_can_detalles + 1;

                  detalle.nom_contacto  := contacto.nom_contacto;
                  detalle.nro_contacto  := contacto.nro_contacto;
                  detalle.cta_contacto  := contacto.cta_contacto;
                  detalle.nro_documento := contacto.nro_documento;
                  detalle.tip_documento := contacto.tip_documento;
                  detalle.tip_cuenta    := contacto.tip_cuenta;
                  detalle.mail          := contacto.mail;

                  lista.EXTEND;
                  lista(lista.COUNT) := detalle;
               END IF;
            END LOOP;
         END IF;
         IF v_sincronizar = 'S' OR v_tie_contactos = 0 THEN
            --Sincronizamos: Se consiguen las cuentas y se inserta en tabla
            v_pos_anterior := 1;
            FOR i IN 1 .. nvl(p_can_contactos, 0) LOOP
               detalle.nro_contacto     := NULL;
               detalle.nom_contacto     := NULL;
               detalle.cta_contacto     := NULL;
               detalle.nro_documento    := NULL;
               detalle.tip_documento    := NULL;
               detalle.tip_cuenta       := NULL;
               detalle.mail             := NULL;
               detalle.cod_per_contacto := NULL;

               v_pos_actual := instr(p_contactos, ';', v_pos_anterior);
               v_linea := trim(substr(p_contactos, v_pos_anterior, v_pos_actual - v_pos_anterior));
               v_pos_anterior  := v_pos_actual + 1;

               --Obtenemos el nombre y el numero del contacto
               v_pos_separador := instr(v_linea, ':');
               IF v_pos_separador > 0 THEN
                  detalle.nom_contacto := paw_uti.depurarTextos(substr(v_linea, 1, v_pos_separador), 30);
                  detalle.nro_contacto := fug_cel_internacional(substr(v_linea, v_pos_separador + 1, 20));
                  -- obtenemos el area y numero de la linea
                  v_cod_area := substr(detalle.nro_contacto, 1, 4);
                  v_nro_telefono := substr(detalle.nro_contacto, 5, 10);
                  -- buscamos la persona con el numero obtenido
                  detalle.cod_per_contacto := fug_obt_cli_telefono(v_cod_area, v_nro_telefono);
                  IF detalle.cod_per_contacto IS NOT NULL THEN
                     detalle.cta_contacto := fuw_obt_cta_multiple(detalle.cod_per_contacto);
                  END IF;
               END IF;

               --Si existe cuenta de contacto, entonces obtenemos otros datos
               IF detalle.cta_contacto IS NOT NULL THEN
                  BEGIN
                     SELECT b.nro_documento, b.cod_tip_documento, decode(a.cod_modulo, 3, 'AHORROS A LA VISTA', 'CUENTAS CORRIENTES'), b.dir_correo
                       INTO detalle.nro_documento, detalle.tip_documento, detalle.tip_cuenta, detalle.mail
                       FROM ge_cta_clientes a, ba_personas b
                      WHERE a.nro_cuenta = detalle.cta_contacto
                        AND a.cod_persona = detalle.cod_per_contacto
                        AND a.cod_persona = b.cod_persona
                        AND a.cod_modulo IN (3,4)
                        AND a.cod_modalidad IN (31,41,334);
                     -- Buscamos el mail si no existe en la carpeta de la persona
                     detalle.mail := nvl(detalle.mail, fug_obt_cli_correo_adi(detalle.cod_per_contacto));

                     lista.EXTEND;
                     lista(lista.COUNT) := detalle;
                     v_can_detalles := v_can_detalles + 1;
                  EXCEPTION
                     WHEN OTHERS THEN
                        NULL;
                  END;
               END IF ;
            END LOOP;
            --si se sincroniza, se borran todos los contactos anteriores
            IF v_sincronizar = 'S' THEN
               DELETE
                 FROM bw_lot_tra_contactos
                WHERE cod_persona = v_cod_persona;
            END IF;

            FOR i in 1..lista.count LOOP
               -- volvemos a insertar los contactos en la tabla
               BEGIN
                  INSERT INTO bw_lot_tra_contactos
                     (cod_persona, nom_contacto, nro_contacto, cta_contacto,
                      ori_contacto, ban_contacto, cod_swift, nro_documento,
                      tip_documento, cod_moneda, tip_cuenta, mail, cod_persona_contacto)
                  VALUES
                      (v_cod_persona, lista(i).nom_contacto, lista(i).nro_contacto, lista(i).cta_contacto,
                       lista(i).ori_contacto, lista(i).ban_contacto, lista(i).cod_swift, lista(i).nro_documento,
                       lista(i).tip_documento, lista(i).cod_moneda, lista(i).tip_cuenta, lista(i).mail, lista(i).cod_per_contacto);
               EXCEPTION
                  WHEN OTHERS THEN
                     NULL;
               END;
            END LOOP;
         END IF;
         v_retorno.lista := lista;
         v_retorno.cantidad := v_can_detalles;
      END IF;
      IF v_retorno.error = 'N' THEN
         v_tag := paw_uti.BITACORA_SALIDA;
      ELSE
         v_tag := paw_uti.BITACORA_ERROR;
      END IF;
      paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'tie: ' || v_tie_contactos || ', sincr: ' || v_sincronizar || ', par_sinc: ' || v_dias_sync || ', can_con: ' || p_can_contactos || ', con_ret: ' || v_can_detalles || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null), v_tag);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
      RETURN v_retorno;
   END; --Fin fu_obt_cta_telefonos


   FUNCTION fu_ins_sol_transferencia(p_sesion             IN VARCHAR2,
                                     p_codCanal           IN VARCHAR2,
                                     p_modo               IN VARCHAR2,
                                     p_ctaCredito         IN VARCHAR2,
                                     p_ctaDebito          IN VARCHAR2,
                                     p_monto              IN NUMBER,
                                     p_concepto           IN VARCHAR2,
                                     p_claveTransaccional IN VARCHAR2,
                                     p_claveToken         IN VARCHAR2,
                                     p_nroPedido          IN VARCHAR2,
                                     p_total              IN NUMBER) RETURN typ_transferenciaban IS
     v_retorno               typ_transferenciaban := typ_transferenciaban;
     v_mensajeCaja           typ_mensajeCaja;
     v_valSesion             typ_validarSesion;
     v_sesion                VARCHAR(32);
     v_cod_operacion         bw_tip_mensajes.cod_tip_mensaje%TYPE := '237';
     v_cod_tra_padre         ge_transacciones.cod_transaccion%TYPE := 388;
     v_CodigoCanal           cj_cajas.nro_caja%TYPE;
     v_ctaCredito            VARCHAR2(16);
     v_ctaDebito             ge_cuentas.nro_cuenta%TYPE;
     v_modo                  VARCHAR2(1);
     v_concepto              VARCHAR2(100);
     v_cod_moneda            ba_monedas.cod_moneda%TYPE := v_cod_mon_local;
     v_cod_mon_debito        ba_monedas.cod_moneda%TYPE;
     v_cod_mod_debito        ge_modalidades.cod_modulo%TYPE;
     v_cod_mad_debito        ge_modalidades.cod_modalidad%TYPE;
     v_cod_ofi_debito        ba_oficinas.cod_oficina%TYPE;
     v_cta_for_debito        VARCHAR2(17);
     v_cod_solicitud         bw_sol_transferencias.cod_solicitud%TYPE;
     v_nom_cta_debito        ge_cuentas.denominacion%TYPE;
     v_msj_bitacora          VARCHAR2(1000);
     v_res_not               NUMBER;
     v_cod_per_solicitada    ba_personas.cod_persona%TYPE;
     v_monto                 ge_movimientos.monto%TYPE;
     v_fec_actual            DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
     v_diasVencimiento       NUMBER := nvl(to_number(fug_obt_pardinamico('TRANS_MULT_DIAS_VENCIENTO')),5);
     v_fechaVencimiento      DATE;
     retError                typ_mensajeRespuesta := typ_mensajeRespuesta;
     v_resLimite             typ_respuestaLimite;
     TRA_CTA_CRE_INVALIDA    CONSTANT VARCHAR2(15) := 'CTA_CRE_INVALID';
     ERR_SOL_CTA_INVALIDO    CONSTANT VARCHAR(15) := 'ERR_SOL_CTA_INV';
     TRA_SOL_INVALID         CONSTANT VARCHAR (15) := 'TRA_SOL_INVALID';
     TRA_CTA_CRE_DEB_IGUAL   CONSTANT VARCHAR2(15) := 'CTA_CRE_DEB_IGU';
   BEGIN
      --depurar datos
      v_sesion         := paw_uti.depurarAlfanumerico(p_sesion, 32);
      v_CodigoCanal    := paw_uti.depurarAlfanumerico(p_codCanal, 3);
      v_modo           := paw_uti.depurarAlfanumerico(p_modo, 1);
      v_ctaCredito     := paw_uti.depurarAlfanumerico(p_ctaCredito, 16);
      v_ctaDebito      := paw_uti.depurarAlfanumerico(p_ctaDebito, 15);
      v_concepto       := paw_uti.depurarTextos(p_concepto, 100);
      v_cod_solicitud  := paw_uti.depurarTextos(p_nroPedido, 50);
      v_monto          := nvl(p_monto, 0);
      v_msj_bitacora   := substr('modo:'||trim(v_modo)
                                        ||', ctaCredito:'||trim(v_ctaCredito)
                                        ||', ctaDebito:'||trim(v_ctaDebito)
                                        ||', monto:'||v_monto
                                        ||', concepto:'||v_concepto
                                        ||', nroPedido:'||v_cod_solicitud
                                        ||', total:'||nvl(p_total, 0), 1, 1000);

      -- validar sesion del cliente
      v_valSesion   := fu_validarSesion(v_sesion, v_CodigoCanal);
      IF v_valSesion.error = 'S' THEN
         v_retorno.error                := v_valSesion.error;
         v_retorno.nombreRespuesta      := v_valSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_valSesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      --  validar caja
      v_mensajeCaja := lf_val_caja(v_valSesion);
      IF v_mensajeCaja.error = 'S' THEN
         v_retorno.error                := v_mensajeCaja.error;
         v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      paw_uti.pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, v_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, v_msj_bitacora || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ENTRADA);

      -- validar cuenta credito sea del propio cliente
      IF lf_val_cta_origen(v_ctaCredito, v_valSesion.codigoPersona) = 'N' THEN
         -- no es una cuenta del cliente
         paw_uti.pr_mensajeUsuario(TRA_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, 'lf_val_cta_origen ' || v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF v_ctaDebito = v_ctaCredito THEN
         paw_uti.pr_mensajeUsuario(TRA_CTA_CRE_DEB_IGUAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      BEGIN
         --validamos que la cuenta debito exista y sea correcta a un cliente subscrito a multiple
         SELECT cod_persona
           INTO v_cod_per_solicitada
           FROM bw_tra_cta_configurado c
          WHERE c.nro_cuenta = v_ctaDebito
            AND estado = 'A';
      EXCEPTION
         WHEN OTHERS THEN
            paw_uti.pr_mensajeUsuario(ERR_SOL_CTA_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, v_msj_bitacora || ' ORA-ERR: [' || substr(sqlerrm, 1, 200) || '] ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
      END;

      retError := lf_val_cta_debito(v_ctaDebito, v_cod_tra_padre, v_monto, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, v_valSesion, v_mensajeCaja);

      -- no tener en cuenta error de saldo, es una solicitud que se procesa luego
      IF retError.error = 'S' AND retError.nombreRespuesta <> 'COD_SAL_INSUF' THEN
         v_retorno.error                := retError.error;
         v_retorno.nombreRespuesta      := retError.nombreRespuesta;
         v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
         paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF v_cod_mon_debito <> v_cod_moneda THEN
         paw_uti.pr_mensajeUsuario(ERR_SOL_CTA_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, v_msj_bitacora || ', mon_deb: ' || v_cod_mon_debito || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- se verifican los limites
      IF (p_nroPedido IS NULL AND v_modo = 'V') OR v_modo = 'C' THEN
         -- luego de invocar cada solicitud, se invoca un ultimo llamado solo para control de limites
         --
         v_resLimite := fu_obtenerLimite(v_valSesion,
                                         v_cod_operacion,
                                         v_valSesion.codigoPersona,
                                         null,
                                         v_cod_moneda,
                                         503,
                                         v_cod_tra_padre,
                                         v_monto * nvl(p_total, 1),
                                         v_modo);

         IF v_resLimite.error = 'S' THEN
            v_retorno.error := v_resLimite.error;
            v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
            paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, 'err limite - ' || v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;

      IF v_modo = 'V' THEN -- si es modo verificacion
         v_fechaVencimiento := fug_obt_fec_habil(v_fec_actual, v_diasVencimiento);
         BEGIN
            IF v_cod_solicitud IS NOT NULL THEN
               INSERT INTO bw_sol_transferencias (
                 COD_SOLICITUD,
                 NRO_CTA_CREDITO,
                 ESTADO,
                 COD_PER_SOLICITANTE,
                 NRO_CTA_DEBITO,
                 COD_MONEDA,
                 CONCEPTO,
                 Fec_Vencimiento,
                 MONTO,
                 COD_PERSONA_SOLICITADA,
                 COD_CANAL)
               VALUES(
                 v_cod_solicitud,
                 v_ctaCredito,
                 'V',
                 v_valSesion.codigoPersona,
                 v_ctaDebito,
                 v_cod_moneda,
                 v_concepto,
                 v_fechaVencimiento,
                 v_monto,
                 v_cod_per_solicitada,
                 v_codigoCanal);
            END IF;
            v_retorno.monto := v_monto;
            v_retorno.ctaForDebito := substr(v_ctaDebito, 0, 17);
            v_retorno.ctaForCredito := substr(v_ctaCredito, 0, 17);
            v_retorno.tipTransferencia := '0';
            v_retorno.tipPedido := v_modo;
            v_retorno.codMonDebito:= v_cod_moneda;
            v_retorno.codMonCredito := v_cod_moneda;
            v_retorno.resLimite := v_resLimite.codRespuesta;
         END;
      ELSIF v_modo = 'C' THEN -- si es confirmacion
         -- se validan las claves segun respuesta de limites
         retError.error := 'N';
         DECLARE
            v_lugar VARCHAR2(50);
         BEGIN
            IF v_resLimite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
               v_lugar  := 'lf_obt_cla_validar - ';
               retError := lf_obt_cla_validar(p_claveTransaccional, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, 'T');
            END IF;

            IF retError.error = 'N' THEN
               IF v_resLimite.codRespuesta IN ('01', '11') THEN -- token requerido
                  v_lugar  := 'paw_seg.fu_obt_tok_validar - ';
                  retError := paw_seg.fu_obt_tok_validar(p_claveToken, v_valSesion.codigoPersona, v_valSesion.codigoEmpresa, v_modo);
               END IF;
            END IF;

            IF retError.error = 'S' THEN
               v_retorno.error                := retError.error;
               v_retorno.nombreRespuesta      := retError.nombreRespuesta;
               v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
               paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, v_msj_bitacora || ' - ' || v_lugar || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
         END;
         -- actualizamos el estado
         UPDATE bw_sol_transferencias
            SET estado = 'P'
          WHERE cod_solicitud = p_nroPedido
            AND cod_per_solicitante = v_valSesion.codigoPersona
            AND trunc(fec_insercion) = trunc(SYSDATE)
            AND estado = 'V';
         v_retorno.monto := v_monto;
         v_retorno.ctaForDebito := substr(v_ctaDebito,0, 17);
         v_retorno.ctaForCredito := substr(v_ctaCredito,0, 17);
         v_retorno.tipTransferencia := '0';
         v_retorno.tipPedido := v_modo;
         v_retorno.codMonDebito:= v_cod_moneda;
         v_retorno.codMonCredito := v_cod_moneda;

         -- se notifica la solicitud
         v_res_not := paw_not.fu_not_rec_multiple('A', v_cod_per_solicitada, v_cod_moneda, v_monto, v_ctaDebito, NULL);
         v_msj_bitacora := substr(v_msj_bitacora ||', res_not: '||v_res_not, 1, 1000);

      ELSE
         paw_uti.pr_mensajeUsuario(TRA_SOL_INVALID, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(TRA_SOL_INVALID, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_valSesion.codigoEmpresa, v_msj_bitacora || '. ORA-ERR: [' || substr(sqlerrm, 1, 200) || '] ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
   END; --Fin fu_ins_sol_multiple

   FUNCTION fu_solicitarProgramado(p_sesion IN VARCHAR2,
                                   p_codigoCanal IN VARCHAR2,
                                   p_modo IN VARCHAR2,
                                   p_tipo IN VARCHAR2,
                                   p_dato IN VARCHAR2,
                                   p_monto IN NUMBER,
                                   p_canCuotas IN NUMBER,
                                   p_descripcion IN VARCHAR2,
                                   p_rangoFecha IN VARCHAR2,
                                   p_cuentaAhorro IN VARCHAR2 DEFAULT NULL) RETURN typ_ahoProgramado IS
      v_retorno         typ_ahoProgramado := typ_ahoProgramado;
      v_error           typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_simulacion      typ_simulador;
      v_user_info       typ_validarSesion;
      v_cod_operacion   bw_tip_mensajes.cod_tip_mensaje%TYPE := '125';
      v_cod_tra_padre   ge_transacciones.cod_transaccion%TYPE := 2203;
      v_cod_mod_padre   ge_transacciones.cod_modulo%TYPE := 3;
      v_cod_mad_padre   ge_transacciones.cod_modalidad%TYPE := 38;
      v_min_pizarra     cr_piz_plazos.plz_desde%TYPE;
      v_max_pizarra     cr_piz_plazos.plz_hasta%TYPE;
      v_piz_mto_row     cr_piz_montos%ROWTYPE;
      v_msj_caja        typ_mensajeCaja;
      v_permiso         typ_obtenerPermisos;
      v_msj_bitacora    bw_bitacora.datos%TYPE;
      v_tipo            VARCHAR2(1);
      v_nro_cta_debito  ge_cuentas.nro_cuenta%TYPE;
      v_cod_mon_debito  ge_cuentas.cod_moneda%TYPE;
      v_cod_mod_debito  ge_cuentas.cod_modulo%TYPE;
      v_cod_mad_debito  ge_cuentas.cod_modalidad%TYPE;
      v_cod_ofi_debito  ge_cuentas.cod_oficina%TYPE;
      v_cta_for_debito  ge_cuentas.denominacion%TYPE;
      v_nom_cta_debito  ge_cuentas.denominacion%TYPE;
      v_mto_max_cuota   ge_movimientos.monto%TYPE;
      v_mto_min_cuota   ge_movimientos.monto%TYPE;
      v_nro_cta_ahorro  ge_cuentas.nro_cuenta%TYPE;
      v_mto_car_fijo    ge_movimientos.monto%TYPE;
      v_imp_car_fijo    ge_movimientos.monto%TYPE;
      v_mto_cargo       ge_movimientos.monto%TYPE;
      v_imp_cargo       ge_movimientos.monto%TYPE;
      v_est_cuenta      ah_cta_plazos.estado%TYPE;
      v_hab_refuerzo    ge_cta_dat_adicionales.val_parametro%TYPE;
      v_can_cta_creada  NUMBER;
      v_can_cuotas      NUMBER;
      v_ran_fecha       VARCHAR2(2);
      v_modo            VARCHAR2(1);
      v_descripcion     ge_cuentas.denominacion%TYPE;
      v_horario         VARCHAR2(1);
      v_es_mov_noc      VARCHAR2(1);
      v_es_cta_noc      VARCHAR2(1);
      v_cod_canal       NUMBER;
      v_cod_error       NUMBER;
      v_monto           NUMBER;
      v_fec_proceso     ge_movimientos.fecha%TYPE := pag_cal.FU_OBT_FEC_ACTUAL(3);

      CUO_PRO_INVAL     CONSTANT VARCHAR2(15) := 'CUO_PRO_INVAL';
      RAN_FEC_PRO_INV   CONSTANT VARCHAR2(15) := 'RANGOFEC_INVAL';
      COD_CTA_INVALID   CONSTANT VARCHAR2(15) := 'COD_CTA_INVALID';
      CTA_NO_CORRESP    CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';
      OPE_NO_PERMITIDA  CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      TIP_PRO_INVAL     CONSTANT VARCHAR2(15) := 'TIP_PRO_INVAL';
      MTO_CUO_INV       CONSTANT VARCHAR2(15) := 'MTO_CUO_PRO_INV';
      MTO_AHO_INV       CONSTANT VARCHAR2(15) := 'MTO_AHO_PRO_INV';
      REF_NO_REGISTRADA CONSTANT VARCHAR2(25) := 'Referencia no registrada';
      MTO_AHO_DESC      CONSTANT VARCHAR2(15) := 'PARAM_INCORRECT';
      MSG_MOV_INGRESADO CONSTANT VARCHAR2(15) := 'G_MOV_YA_INGRE';
      COD_MON_INVALIDA  CONSTANT VARCHAR2(15) := 'MON_DEB_INVALID';
      MTO_REF_INV       CONSTANT VARCHAR2(15) := 'MON_REF_INVALID';
      RED_MON_INV       CONSTANT VARCHAR2(15) := 'PRE_MON_LOC_INV';
      CTA_REF_INVALID   CONSTANT VARCHAR2(15) := 'CTA_REF_INVALID';
      CTA_CAN_INVALID   CONSTANT VARCHAR2(15) := 'CTA_CAN_INVALID';
      HOR_SIS_CIERRE    CONSTANT VARCHAR2(15) := 'HOR_SIS_CIERRE';
   BEGIN
      -- 1. valido la clave del cliente
      v_user_info := fu_validarSesion(p_sesion, p_codigoCanal);
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_user_info);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa,
                                     v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 3. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_permiso      := lf_obt_permisos(v_user_info, v_cod_operacion);
      v_msj_bitacora := v_msj_bitacora || 'perf: ' || v_user_info.codigoPerfil;
      IF v_permiso.error = 'S' THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa,
                                     v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_nro_cta_debito  := paw_uti.depurarAlfanumerico(p_dato, 15);
      v_modo            := substr(p_modo, 1, 1);
      v_tipo            := substr(p_tipo, 1, 1);
      v_can_cuotas      := nvl(p_canCuotas, 0);
      v_monto           := nvl(p_monto, 0);
      v_descripcion     := upper(paw_uti.depurarTextos(trim(p_descripcion), 65));
      v_ran_fecha       := substr(p_rangoFecha, 1, 2);
      v_nro_cta_ahorro  := paw_uti.depurarAlfanumerico(p_cuentaAhorro, 15);
      v_msj_bitacora    := v_msj_bitacora || ', cta.deb: ' || v_nro_cta_debito
                                          || ', modo: ' || v_modo
                                          || ', tip: ' || v_tipo
                                          || ', canCuo: ' || v_can_cuotas
                                          || ', ranFec: ' || v_ran_fecha
                                          || ', mto: ' || v_monto
                                          || ', ctaAho: ' || v_nro_cta_ahorro
                                          || ', desc: ['||v_descripcion||']';

      paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ENTRADA);
      -- 4. validar modo o parametro
      IF v_modo NOT IN ('V', 'C', 'S') OR nvl(fug_obt_pardinamico('AHO_PRO_OFE_WEB'), 'N') = 'N' THEN
         paw_uti.pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 5. validar tipo de ahorro programado
      IF v_tipo NOT IN ('M', 'T', 'R', 'U', 'C') OR (v_modo IN ('V', 'C') AND v_tipo = 'T') THEN
         paw_uti.pr_mensajeUsuario(TIP_PRO_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      SELECT decode(v_tipo, 'M', 'Ahorro Mensual',
                            'T', 'Ahorro Total',
                            'R', 'Refuerzo',
                            'U', 'Modificacion',
                            'C', 'Cancelacion')
        INTO v_retorno.tipAhorro
        FROM DUAL;

      IF v_tipo IN ('R', 'U', 'C') THEN
         DECLARE
            v_nro_cta_capitalizacion ah_cta_plazos.nro_cuenta%TYPE;
            v_per_debito             ah_cta_plazos.per_debito%TYPE;
            v_denominacion           ah_cta_plazos.denominacion%TYPE;
         BEGIN
            SELECT p.nro_cta_capitalizacion, p.per_debito, p.denominacion, p.estado
              INTO v_nro_cta_capitalizacion, v_per_debito, v_denominacion, v_est_cuenta
              FROM ge_cta_clientes c, ah_cta_plazos p, ge_est_cuentas e
             WHERE c.nro_cuenta = v_nro_cta_ahorro
               AND c.nro_cuenta = p.nro_cuenta
               AND e.estado = p.estado
               AND e.cod_modulo = p.cod_modulo
               AND e.cod_modalidad = p.cod_modalidad
               AND e.activo = 'S'
               AND c.cod_persona = nvl(v_user_info.codigoEmpresa, v_user_info.codigoPersona)
               AND p.cod_modalidad = v_cod_mad_padre;
            -- validar cuenta debito a modificar
            IF v_tipo = 'U' AND v_nro_cta_debito IS NULL AND v_descripcion IS NULL AND v_ran_fecha IS NULL THEN
               paw_uti.pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion,v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
            v_nro_cta_debito := nvl(v_nro_cta_debito, v_nro_cta_capitalizacion);
            v_ran_fecha      := nvl(v_ran_fecha, v_per_debito);
            v_descripcion    := nvl(v_descripcion, v_denominacion);
            -- si es refuerzo
            IF v_tipo = 'R' THEN
               v_hab_refuerzo := nvl(fug_obt_paradicional(v_nro_cta_ahorro, 'HAB_REFUERZO'), 'S');

               IF v_hab_refuerzo = 'N' OR v_est_cuenta <> 'N' THEN
                  -- cuenta no habilitada o en estado invalido no debe permitir un refuerzo
                  paw_uti.pr_mensajeUsuario(CTA_REF_INVALID, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion,v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;
               v_cod_tra_padre := 2204;
            END IF;
            -- si es cancelacion
            IF v_tipo = 'C' THEN
               IF v_est_cuenta <> 'N' THEN
                  -- cuenta que no este en estado normal no se puede cancelar anticipadamente
                  paw_uti.pr_mensajeUsuario(CTA_CAN_INVALID, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion,v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;
               v_monto := 0;
            END IF;
         EXCEPTION
            WHEN OTHERS THEN
               paw_uti.pr_mensajeUsuario(COD_CTA_INVALID, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion,v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
               RETURN v_retorno;
         END;
      END IF;

      IF v_modo = 'S' THEN
         v_cod_mon_debito := substr(p_dato, 1, 3);
      ELSE
         -- validamos el horario
         v_error := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                   v_msj_caja.fechaUltimoCierre, -- IN
                                   v_msj_caja.codigoOficinaOrigen, -- IN
                                   v_fec_proceso);
         IF v_error.error = 'S' OR v_es_mov_noc = 'S' THEN
            paw_uti.pr_mensajeUsuario(HOR_SIS_CIERRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- 6. validar cuenta debito
         v_error := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_monto, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, v_user_info, v_msj_caja, v_cod_mod_padre, v_cod_mad_padre);
         IF v_error.error = 'S' THEN
            v_retorno.error                := v_error.error;
            v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
            paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora|| paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- 7. validar cuenta deb pertenece a cliente
         IF lf_val_cta_origen(v_nro_cta_debito, nvl(v_user_info.codigoEmpresa, v_user_info.codigoPersona)) = 'N' THEN
            -- no es una cuenta del cliente
            paw_uti.pr_mensajeUsuario(CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion,v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' ||
                        paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                        paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
      -- 8. validar moneda
      IF v_cod_mon_debito NOT IN ('USD', 'GS') THEN
         paw_uti.pr_mensajeUsuario(COD_MON_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ', monDeb: ' || v_cod_mon_debito || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 9. validar rango de cuotas
      paa_pro.pr_obt_plz_pizarra(v_cod_mod_padre, v_cod_mad_padre, v_cod_mon_debito, null, v_min_pizarra, v_max_pizarra);
      IF v_tipo = 'M' AND NOT (v_can_cuotas * 30 BETWEEN v_min_pizarra AND v_max_pizarra) AND v_modo <> 'S' THEN
         paw_uti.pr_mensajeUsuario(CUO_PRO_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ', minPiz: ' || v_min_pizarra || ', maxPiz: ' || v_max_pizarra || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 10. validar monto minimo y maximo
      v_mto_min_cuota := nvl(paw_uti.depurarNumerico(fug_obt_pardinamico('MTO_MIN_CUO_AHO_PROGRAMADO', null, null, v_cod_mon_debito), CUENTA_TAMANO), 0);
      v_mto_max_cuota := nvl(paw_uti.depurarNumerico(fug_obt_pardinamico('MTO_MAX_CUO_AHO_PROGRAMADO', null, null, v_cod_mon_debito), CUENTA_TAMANO), 0);
      paa_pro.pr_obt_mto_pizarra(v_piz_mto_row, v_cod_mod_padre, v_cod_mad_padre, v_cod_mon_debito);
      -- monto mensual
      IF v_tipo = 'M' AND NOT (v_monto BETWEEN v_mto_min_cuota AND v_mto_max_cuota) THEN
         paw_uti.pr_mensajeUsuario(MTO_CUO_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- monto total
      IF v_tipo IN ('M', 'T') AND (v_monto NOT BETWEEN nvl(v_piz_mto_row.mto_desde, 0) AND nvl(v_piz_mto_row.mto_hasta, 0)) THEN
         paw_uti.pr_mensajeUsuario(MTO_AHO_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- validar redondeo
      IF v_tipo IN ('M', 'T', 'R') AND v_monto <> trunc(v_monto, fug_obt_pardinamico('VAL_RED_MON_EXTRANJERA',null,null,v_cod_mon_debito)) then
         paw_uti.pr_mensajeUsuario(RED_MON_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- validar monto de refuerzo para refuerzo de ahorro
      IF v_tipo = 'R' AND paa_pro.fu_val_mto_refuerzo(v_nro_cta_ahorro, v_monto) = 'N' THEN
         paw_uti.pr_mensajeUsuario(MTO_REF_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- es simulacion, se retorna los datos
      IF v_modo = 'S' THEN
         v_retorno.codigoMoneda := v_cod_mon_debito;
         v_simulacion           := paa_pro.fu_sim_aho_programado(v_monto, v_tipo, v_retorno.codigoMoneda);
         v_retorno.concepto     := 'Simulacion';
         v_retorno.listaMontos  := v_simulacion.listaPizarra;
         v_retorno.listaPlazos  := v_simulacion.listaPlazos;
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_SALIDA);
         RETURN v_retorno;
      END IF;
      -- 11. validar plazo debito
      v_retorno.rangoFechaDebito := substr(fue_obt_sig_refcodes('FEC_DEB_AHO_PROGRAMADO', v_ran_fecha), 1, 100);
      IF instr(v_retorno.rangoFechaDebito, REF_NO_REGISTRADA) > 0 AND v_tipo IN ('M','T','U') THEN
         paw_uti.pr_mensajeUsuario(RAN_FEC_PRO_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF v_modo IN ('V', 'C') AND v_tipo IN ('M','T') AND nvl(length(v_descripcion), 0) = 0 THEN
         paw_uti.pr_mensajeUsuario(MTO_AHO_DESC, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- validamos duplicados
      IF v_tipo IN ('M','T') THEN
         SELECT COUNT(0)
           INTO v_can_cta_creada
           FROM ge_cta_clientes gc
          WHERE gc.cod_persona = nvl(v_user_info.codigoEmpresa, v_user_info.codigoPersona)
            AND gc.relacion = 'P'
            AND gc.cod_modulo = v_cod_mod_padre
            AND gc.cod_modalidad = v_cod_mad_padre
            AND ((SYSDATE) - gc.fec_insercion) * 1440 <= nvl(to_number(fug_obt_pardinamico('PAW_PRO_TRANSACCION')), 10)
            AND rownum = 1;
         IF v_can_cta_creada > 0 THEN
            paw_uti.pr_mensajeUsuario(MSG_MOV_INGRESADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora||' '|| paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;

      -- validar mov. duplicado en refuerzo
      IF v_tipo = 'R' THEN
         v_error := fu_ver_transaccion(503, v_cod_tra_padre, v_nro_cta_debito, v_monto, v_msj_caja);
         IF v_error.error = 'S' THEN
            v_retorno.error                := v_error.error;
            v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
            paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora||' '|| paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
      -- cancelacion
      IF v_tipo = 'C' THEN
         paa_pro.pr_can_cal_mto_aho_pro (v_nro_cta_ahorro, v_mto_car_fijo, v_imp_car_fijo, v_mto_cargo, v_imp_cargo, v_retorno.montoOperacion);
      END IF;
      --
      SELECT decode(p_codigoCanal, '994', 30, 29)
        INTO v_cod_canal
        FROM DUAL;

      -- confirmacion, se crea la cuenta
      IF v_modo = 'C' THEN
         CASE v_tipo
            WHEN 'M' THEN -- alta
               paa_pro.pr_gen_aho_programado(v_monto, v_ran_fecha, v_can_cuotas, v_nro_cta_debito, v_descripcion, v_cod_canal, v_retorno.cuentaCreada, v_cod_error);
            WHEN 'R' THEN -- refuerzo
               paa_pro.pr_ins_ref_ahorro(v_nro_cta_ahorro, v_nro_cta_debito, v_monto);
            WHEN 'C' THEN -- cancelacion
               paa_pro.pr_can_mov_aho_pro(v_nro_cta_ahorro);
            WHEN 'U' THEN -- actualizacion
               paa_pro.pr_act_dat_ahorro(v_nro_cta_ahorro, v_descripcion, v_nro_cta_debito, v_ran_fecha);
         END CASE;
         paw_uti.lp_reg_operacion(v_nro_cta_debito, v_cod_mon_debito, v_monto, nvl(v_retorno.cuentaCreada, v_nro_cta_ahorro), 1, 'Tipo', v_tipo, NULL, NULL, NULL, NULL, v_cod_error, v_user_info.codigoPersona, v_cod_operacion, NULL, p_codigoCanal, p_sesion, v_user_info.codigoEmpresa);
      END IF;

      v_retorno.codigoMoneda    := v_cod_mon_debito;
      v_retorno.cuentaDebito    := v_nro_cta_debito;
      v_retorno.concepto        := v_descripcion;
      v_retorno.totalCuotas     := v_can_cuotas;
      v_retorno.montoSolicitado := v_monto;
      IF v_tipo IN ('M', 'T') THEN
         v_retorno.fechaVencimiento := paa_pro.fu_obt_fec_vencimiento(pag_cal.fu_obt_fec_actual(v_cod_mod_padre), v_can_cuotas, v_cod_ofi_debito);
         paa_pro.pr_cal_aho_programado(v_monto, v_can_cuotas, v_tipo, v_cod_mon_debito, v_retorno.interesMensual, v_retorno.montoOperacion);
      ELSIF v_tipo = 'C' THEN
         v_retorno.montoSolicitado := v_mto_car_fijo + v_mto_cargo;
         v_retorno.montoImpuestos  := v_imp_car_fijo + v_imp_cargo;
      END IF;
      v_retorno.cuentaCreada := nvl(v_retorno.cuentaCreada, v_nro_cta_ahorro);
      paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_user_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_user_info.codigoEmpresa, v_msj_bitacora || '[' || SQLERRM || ']' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
   END;
   --
   FUNCTION fu_solicitudTarjeta(p_sesion        IN VARCHAR2,
                                p_codigoCanal   IN VARCHAR2,
                                p_modo          IN VARCHAR2,
                                p_numeroTarjeta IN VARCHAR2,
                                p_tipoSolicitud IN NUMBER,
                                p_datosJson     IN VARCHAR2,
                                p_nombreAdjunto IN VARCHAR2,
                                p_adjunto       IN BLOB,
                                p_claveToken    IN VARCHAR2) RETURN typ_solTarjetas IS
      v_retorno typ_solTarjetas := typ_solTarjetas;
      v_usu_info typ_validarSesion;
      v_msj_caja typ_mensajeCaja;
      v_permiso typ_obtenerPermisos;
      v_error typ_mensajerespuesta;
      v_cod_operacion bw_tip_mensajes.cod_tip_mensaje%TYPE := '078';
      v_nro_doc_principal ba_personas.nro_documento%TYPE;
      v_tip_doc_principal ba_tip_documentos.abreviatura%TYPE;
      v_nro_doc_adicional ba_personas.nro_documento%TYPE;
      v_tip_doc_adicional ba_tip_documentos.abreviatura%TYPE;
      v_nro_cuenta ge_cuentas.nro_cuenta%TYPE;
      v_cod_pais ba_paises.cod_pais%TYPE;
      v_pri_nombre ba_per_fisicas.pri_nombre%TYPE;
      v_seg_nombre ba_per_fisicas.seg_nombre%TYPE;
      v_pri_apellido ba_per_fisicas.pri_apellido%TYPE;
      v_seg_apellido ba_per_fisicas.seg_apellido%TYPE;
      v_genero ba_per_fisicas.cod_sexo%TYPE;
      v_fec_nacimiento ba_per_fisicas.fec_nacimiento%TYPE;
      v_cod_est_civil ba_per_fisicas.est_civil%TYPE;
      v_nom_embozo ta_tarjetas.nom_embozar%TYPE;
      v_nom_archivo bw_archivos.nombre%TYPE;
      v_cod_canal ge_canales.cod_canal%TYPE;
      v_nro_tarjeta ta_tarjetas.nro_tarjeta%TYPE;
      v_tip_solicitud NUMBER;
      v_cod_respuesta NUMBER;
      v_nro_documento bw_archivos.nro_documento%TYPE;
      v_modo VARCHAR2(1);
      v_msj_bitacora VARCHAR2(1000);
      v_msj_error VARCHAR2(1000);

      MSG_TAR_INEXISTENTE CONSTANT VARCHAR2(15) := 'OBT_TCR_NE';
      MSG_TRA_INVALIDA    CONSTANT VARCHAR2(15) := 'TRA_INVALIDA';
      MSG_CTA_CANCELADA   CONSTANT VARCHAR2(15) := 'TAR_CTA_CANCELA';
      MSG_PAR_INCORRECTOS CONSTANT VARCHAR2(15) := 'VAL_PENTRADA';
      MSG_SOL_DUPLICADO   CONSTANT VARCHAR2(15) := 'DAT_PEN_DUP';
      MSG_ERR_LIMITE      CONSTANT VARCHAR2(15) := 'G_ERR_LIM_OPERA';

      -- registro de error y retorno
      FUNCTION lf_ret_error(p_men_respuesta IN bw_men_respuesta.nombre%TYPE DEFAULT NULL) RETURN typ_solTarjetas IS
      BEGIN
         IF p_men_respuesta IS NOT NULL THEN
            paw_uti.pr_mensajeUsuario(p_men_respuesta, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END IF;
         paw_uti.pr_insertarBitacora(v_usu_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_info.codigoEmpresa,
                                     v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                     paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END;

      PROCEDURE lp_val_sol_adicional IS
      BEGIN
        -- registro error
         IF v_cod_respuesta <> 0 THEN
            v_msj_bitacora := substr(v_msj_bitacora || ', err:[' || v_msj_error||']', 1, 1000);
         END IF;
         CASE v_cod_respuesta
            WHEN 0 THEN
               NULL;
            ELSE
               paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END CASE;
      END;
   BEGIN
       -- valido la clave del cliente
      v_usu_info := fu_validarSesion(p_sesion, p_codigoCanal);
      -- verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_info);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN lf_ret_error;
      END IF;
      -- verifica si el cliente con su perfil tendrá acceso a realizar la transacción
      v_permiso := lf_obt_permisos(v_usu_info, v_cod_operacion);
      IF v_permiso.error = 'S' THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         RETURN lf_ret_error;
      END IF;
      -- datos de entrada
      paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_modo := substr(nvl(p_modo, 'x'), 1, 1);
      v_tip_solicitud := nvl(p_tipoSolicitud, 0);
      IF v_modo <> 'G' THEN
         v_nro_tarjeta := paw_uti.depurarAlfanumerico(p_numeroTarjeta, 25);
         v_nro_cuenta := pat_imp.fu_obt_nro_cuenta(v_nro_tarjeta);
         v_msj_bitacora  := 'modo:'||v_modo||', tipSol:'||v_tip_solicitud||', tar:'||substr(v_nro_tarjeta, -4)||', cta:'||v_nro_cuenta;
      ELSE
         v_nro_documento := paw_uti.depurarNumerico(p_numeroTarjeta, 15);
         v_msj_bitacora := 'modo: '||v_modo||', nro: '||v_nro_documento;
      END IF;
      v_nom_archivo := paw_uti.depurarTextos(p_nombreAdjunto, 100);
      paw_uti.pr_insertarBitacora(v_usu_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_info.codigoEmpresa, v_msj_bitacora||' '||paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ENTRADA);
      -- validacion de modo permitido
      IF v_modo NOT IN ('V', 'C', 'G') OR v_tip_solicitud <> 1 THEN
         RETURN lf_ret_error(MSG_TRA_INVALIDA);
      END IF;
      -- modo guardar comprobante (softtoken)
      IF v_modo = 'G' THEN
         v_cod_respuesta := paw_uti.fu_ins_archivo(nvl(v_usu_info.codigoEmpresa, v_usu_info.codigoPersona),
                           v_cod_operacion, v_nro_documento, p_adjunto, v_nom_archivo);
         v_msj_bitacora := v_msj_bitacora || ', insAr: ' ||v_cod_respuesta;
         paw_uti.pr_insertarBitacora(v_usu_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_info.codigoEmpresa, v_msj_bitacora||' '||paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);
         RETURN v_retorno;
      END IF;
      -- adicional
      IF v_tip_solicitud = 1 THEN
         v_cod_respuesta := pat_sol.fu_obt_sol_adicional(
                                      nvl(v_usu_info.codigoEmpresa, v_usu_info.codigoPersona),
                                      p_datosJson,
                                      v_nro_cuenta,
                                      v_pri_nombre,
                                      v_seg_nombre,
                                      v_pri_apellido,
                                      v_seg_apellido,
                                      v_tip_doc_adicional,
                                      v_nro_doc_adicional,
                                      v_genero,
                                      v_cod_pais,
                                      v_fec_nacimiento,
                                      v_cod_est_civil,
                                      v_nom_embozo);
         v_msj_bitacora := substr(v_msj_bitacora || ', valCode:'||v_cod_respuesta
                                          || ', cta:' || v_nro_cuenta
                                          || ', nom:' || v_pri_nombre
                                          || ', ape:' || v_pri_apellido
                                          || ', tipDoc:' || v_tip_doc_adicional
                                          || ', nroDoc:' || v_nro_doc_adicional
                                          || ', gen:' || v_genero
                                          || ', pai:'||v_cod_pais
                                          || ', fec:' || to_char(v_fec_nacimiento, 'dd/mm/yyyy')
                                          || ', est:'||v_cod_est_civil
                                          || ', emb:'||v_nom_embozo, 1, 1000);
         --
         CASE v_cod_respuesta
            WHEN 0 THEN NULL;
            WHEN 1 THEN RETURN lf_ret_error(MSG_TAR_INEXISTENTE);
            WHEN 2 THEN RETURN lf_ret_error(MSG_CTA_CANCELADA);
            WHEN 3 THEN RETURN lf_ret_error(MSG_TRA_INVALIDA);
            WHEN 4 THEN RETURN lf_ret_error(MSG_PAR_INCORRECTOS);
            WHEN 5 THEN RETURN lf_ret_error(MSG_SOL_DUPLICADO);
            ELSE RETURN lf_ret_error(paw_uti.MSG_ERROR);
         END CASE;
      END IF;
      -- verificacion/envio de clave token
      v_retorno.respuestaLimite := paw_seg.fu_obt_cla_operacion('SOL_ADI_TAR_TRA', 'SOL_ADI_TAR_OTP', nvl(v_usu_info.codigoEmpresa, v_usu_info.codigoPersona));
      v_msj_bitacora := v_msj_bitacora || ', solCla: ' || v_retorno.respuestaLimite;

      IF v_retorno.respuestaLimite IN ('-1', '-2') THEN
         RETURN lf_ret_error(MSG_ERR_LIMITE);
      ELSIF v_retorno.respuestaLimite IN ('01', '11') THEN
         -- adjunto es requerido si es token en modo confirmar, si es softtoken se envia en modo G
         IF v_modo = 'C' THEN
            IF length(trim(nvl(p_nombreAdjunto, ''))) = 0 OR dbms_lob.getlength(p_adjunto) = 0 THEN
                RETURN lf_ret_error(MSG_PAR_INCORRECTOS);
            END IF;
         END IF;
         v_error := paw_seg.fu_obt_tok_validar(p_claveToken, v_usu_info.codigoPersona, v_usu_info.codigoEmpresa, v_modo);
         IF v_error.error = 'S' THEN
            v_retorno.error := v_error.error;
            v_retorno.nombreRespuesta := v_error.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
            RETURN lf_ret_error;
         END IF;
      END IF;

      -- confirmacion
      IF v_modo = 'C' AND v_retorno.error = 'N' THEN
         -- 30: mobile, 29: web
         SELECT decode(p_codigoCanal, 994, 30, 29)
           INTO v_cod_canal
           FROM dual;
         -- documento del principal
         SELECT p.nro_documento, d.abreviatura
           INTO v_nro_doc_principal, v_tip_doc_principal
           FROM ba_personas p, ba_tip_documentos d
          WHERE p.cod_persona = nvl(v_usu_info.codigoEmpresa, v_usu_info.codigoPersona)
            AND p.cod_tip_documento = d.cod_tip_documento;
         IF v_tip_solicitud = 1 THEN
            prt_sol_web(v_cod_canal,
                        v_tip_doc_principal,
                        v_nro_doc_principal,
                        v_nro_cuenta,
                        v_tip_doc_adicional,
                        v_cod_pais,
                        v_nro_doc_adicional,
                        v_pri_nombre,
                        v_seg_nombre,
                        v_pri_apellido,
                        v_seg_apellido,
                        v_genero,
                        v_fec_nacimiento,
                        v_cod_est_civil,
                        v_nom_embozo,
                        p_adjunto,
                        v_nom_archivo,
                        v_cod_respuesta,
                        v_retorno.numeroSolicitud,
                        v_msj_error);
            -- validamos v_cod_respuesta
            lp_val_sol_adicional;
            -- no continuar en caso de error
            IF v_retorno.error = 'S' THEN
               RETURN lf_ret_error;
            END IF;
            -- notificar al usuario
            v_cod_respuesta := pat_sol.fu_not_solicitud(nvl(v_usu_info.codigoEmpresa, v_usu_info.codigoPersona),
                                                        p_numeroTarjeta,
                                                        v_tip_solicitud);
            v_msj_bitacora := v_msj_bitacora || ', mail: ' || v_cod_respuesta;
         END IF;
      END IF;

      IF v_tip_solicitud = 1 AND v_retorno.error = 'N' THEN
         v_retorno.numeroDocumento := v_nro_doc_adicional;
         v_retorno.tipoDocumento := v_tip_doc_adicional;
         v_retorno.nombreCompleto := substr(v_pri_nombre||' '||v_seg_nombre||' '||v_pri_apellido||' '||v_seg_apellido, 1, 100);
      END IF;

      paw_uti.pr_insertarBitacora(v_usu_info.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_info.codigoEmpresa, v_msj_bitacora||' '||paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
        v_msj_bitacora := substr(v_msj_bitacora||', ora-err:['||sqlerrm||']', 1, 1000);
        RETURN lf_ret_error(paw_uti.MSG_ERROR);
   END;

FUNCTION fu_agregarSoftoken(p_sesion IN VARCHAR2, p_codigoCanal IN VARCHAR2, p_serial IN VARCHAR2,
                            p_modo IN VARCHAR2, p_nro_telefono IN VARCHAR2, p_can_activacion IN VARCHAR2) RETURN TYP_MENSAJESOFTOKEN IS
  v_retorno        TYP_MENSAJESOFTOKEN := TYP_MENSAJESOFTOKEN;
  v_cod_operacion  VARCHAR2(3) := '008';
  v_valSesion      typ_validarsesion;
  v_permiso        typ_obtenerPermisos;
  v_mensajeCaja    typ_mensajeCaja;
  v_tipoToken      varchar2(1);
  v_bitacoratitulo VARCHAR(100) := substr(TRIM('fu_agregarSoftoken Can:' || p_codigoCanal ||
                                               ' ,p_serial:' || p_serial || ' ,modo' || p_modo), 0,
                                          99);
  TRA_SIN_AUTORIZACION CONSTANT VARCHAR2(15) := 'SNP_SIN_AUTORIZ'; /**Sin permiso para transferencia*/

  MSG_TRA_INVALIDA CONSTANT VARCHAR2(15) := 'TRA_INVALIDA'; /** Transaccion invalida*/

BEGIN
  paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta, v_retorno.error);

  v_valSesion := fu_validarSesion(p_sesion, p_codigoCanal);

  IF v_valSesion.error = 'S' THEN
    v_retorno.error                := v_valSesion.error;
    v_retorno.nombrerespuesta      := v_valSesion.nombreRespuesta;
    v_retorno.descripcionrespuesta := v_valSesion.descripcionRespuesta;
    RETURN v_retorno;
  END IF;

  paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion,
                              v_valSesion.codigoEmpresa,
                              v_bitacoratitulo ||
                               paw_uti.fu_generarBitacora(v_valSesion.error,
                                                          v_valSesion.nombreRespuesta,
                                                          v_valSesion.descripcionRespuesta, NULL),
                              paw_uti.BITACORA_ENTRADA);

  -- Verifica el canal de origen
  v_mensajeCaja := lf_val_caja(v_valSesion);

  IF v_mensajeCaja.error = 'S' THEN
    v_retorno.error                := v_mensajeCaja.error;
    v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
    v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
    RETURN v_retorno;
  END IF;

  IF nvl(p_modo, 'x') = 'A' THEN
    IF g_aut_operacion = FALSE THEN
      paw_uti.pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta, v_retorno.error);
      paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codigoCanal, p_sesion,
                                  v_cod_operacion, v_valSesion.codigoEmpresa,
                                  v_bitacoraTitulo || ' ' ||
                                   paw_uti.fu_generarbitacora(v_retorno.error,
                                                              v_retorno.nombreRespuesta,
                                                              v_retorno.descripcionRespuesta, NULL),
                                  paw_uti.BITACORA_ERROR);
      RETURN v_retorno;
    END IF;
  ELSE
    v_permiso := lf_obt_permisos(v_valSesion, v_cod_operacion); --nvl(userinfo.codigoEmpresa, userinfo.codigoPersona), userinfo.codigoPerfil, v_cod_operacion, p_codigoCanal);
    IF v_permiso.error = 'S' THEN
      paw_uti.pr_mensajeUsuario(TRA_SIN_AUTORIZACION, v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta, v_retorno.error);
      paw_uti.pr_insertarBitacora(v_valSesion.codigoPersona, p_codigoCanal, p_sesion,
                                  v_cod_operacion, v_valSesion.codigoEmpresa,
                                  v_bitacoraTitulo || ' ' ||
                                   paw_uti.fu_generarBitacora(v_retorno.error,
                                                              v_retorno.nombreRespuesta,
                                                              v_retorno.descripcionRespuesta, NULL),
                                  paw_uti.BITACORA_ERROR);
      RETURN v_retorno;
    END IF;
    -- se verifica que tenga permiso para registrar
    IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
      paw_uti.pr_mensajeUsuario(TRA_SIN_AUTORIZACION, v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta, v_retorno.error);
      paw_uti. pr_insertarBitacora(v_valSesion.codigoPersona, p_codigoCanal, p_sesion,
                                   v_cod_operacion, v_valSesion.codigoEmpresa,
                                   v_bitacoraTitulo || ' ' ||
                                    paw_uti.fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                   paw_uti.BITACORA_ERROR);
      RETURN v_retorno;
    END IF;
  END IF;

  if(v_valSesion.codigoEmpresa is null) then
   v_tipoToken:='S';
   else
     v_tipoToken:='E';
  end if;

  v_retorno.respuesta:=Paw_Otp.fu_altaSoftoken(v_valSesion.codigoPersona,v_tipoToken, p_serial, p_nro_telefono, p_can_activacion);

  paw_uti.pr_mensajeUsuario(v_retorno.respuesta, v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta, v_retorno.error);
  RETURN v_retorno;
END;
  FUNCTION fu_pagoBancardPMWs(p_sesion             IN VARCHAR2,
                              p_codigoCanal        IN VARCHAR2,
                              p_modo               IN VARCHAR2,
                              p_cuentaDebito       IN VARCHAR2, --solo para casos con TDB
                              p_numeroIp           IN VARCHAR2,
                              p_sesionServicios    IN VARCHAR2,
                              p_numeroTransaccion  VARCHAR2,
                              p_servicio           IN VARCHAR2,
                              p_terminal           VARCHAR2,
                              p_moneda             NUMBER,
                              p_monto              NUMBER,
                              p_importeComision    NUMBER,
                              p_claveTransaccional IN VARCHAR2,
                              p_claveToken         IN VARCHAR2,
                              p_tokenServicios     IN VARCHAR2,
                              p_proveedor          IN NUMBER,
                              p_extra              IN VARCHAR2)
    RETURN typ_pagoserviciosws IS
    -- Datos Recibidos del HB-
    v_nro_cta_debito VARCHAR2(16); -- nro de cuenta de debito
    v_monto          NUMBER(18, 2); -- monto a transferir
    v_modo           VARCHAR2(1); -- modo V-validacion o C-confirmacion
    v_lugar          VARCHAR2(100);
    -- Variables
    v_cta_for_debito  VARCHAR2(17); -- Cuenta Debito formateada
    v_cod_mon_debito  ge_cuentas.cod_moneda%TYPE := 'GS'; -- Moneda de la cuenta
    v_cod_mod_debito  ge_cuentas.cod_modulo%TYPE; -- Modulo de la cuenta
    v_cod_mad_debito  ge_cuentas.cod_modalidad%TYPE; -- Modalidad de la cuenta
    v_cod_ofi_debito  ge_cuentas.cod_oficina%TYPE; -- Oficina de la cuenta
    v_nom_cta_debito  ge_cuentas.denominacion%TYPE; -- Nombre de la cuenta
    v_nro_cta_credito ge_cuentas.nro_cuenta%TYPE := NULL; -- Numero de Cuenta Credito
    v_codCanal        NUMBER;
    v_terminal        VARCHAR2(15);
    v_sesion          VARCHAR2(32);
    v_sesionServicios VARCHAR2(32);

    v_cod_operacion VARCHAR2(3) := '088'; --082 y 088 Pagos de servicios , --035 Zimple
    v_cod_tra_padre ge_cob_ser_parametros.cod_transaccion%TYPE := 485; --490 zimple;

    v_nro_documento NUMBER(15);
    v_retorno       typ_pagoserviciosws := typ_pagoserviciosws();
    v_res_limite    typ_respuestaLimite;

    v_usuario         typ_validarSesion;
    v_error           typ_mensajeRespuesta := typ_mensajeRespuesta;
    v_men_caja        typ_mensajeCaja;
    v_permiso         typ_obtenerPermisos;
    v_horario         VARCHAR2(1);
    v_es_mov_noc      VARCHAR2(1);
    v_es_cta_noc      VARCHAR2(1);
    v_fec_actual      DATE;
    v_hor_actual      VARCHAR2(8) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
    v_msj_bitacora    VARCHAR2(1000);
    v_nro_transaccion bw_pag_servicios.nro_transaccion%TYPE;
    v_nro_lote        bw_pag_servicios.nro_lote%TYPE;
    v_comision        NUMBER := p_importeComision;
    v_concepto        bw_pag_cod_servicios.descripcion%TYPE;
    rg_bpser          bw_pag_servicios%ROWTYPE;
    v_claveSesion     VARCHAR(32);

    v_extraData VARCHAR2(200);

    MSG_CTA_NO_CORRESP   CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND'; --Nro. de Cuenta no corresponde al cliente
    SER_PER_SIN_AUT      CONSTANT VARCHAR2(15) := 'SER_PER_SIN_AUT';
    MSG_CTA_CONJUNTA     CONSTANT VARCHAR2(15) := 'CTA_CONJUNTA';
    MSG_MON_INVALIDA     CONSTANT VARCHAR2(15) := 'MON_DEB_INVALID';
    MSG_OPE_NO_PERM      CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
    MOV_DUP_SERVICIO     CONSTANT VARCHAR2(15) := 'MOV_DUP_SERV';
    MSG_INS_MOV_ER       CONSTANT VARCHAR2(15) := 'INS_MOV_ER';
    MSG_COD_TRA_INVALIDA CONSTANT VARCHAR2(15) := 'COD_TRA_INVALID';
    MSG_OBT_TAR_NE       CONSTANT VARCHAR2(15) := 'OBT_TCR_NE';

    --para saber el módulo de la cuenta a debitar
    v_cod_modulo ba_modulos.cod_modulo%TYPE;

    --para verificar operaciones pendientes
    v_aut_pendientes NUMBER(3);

    v_ret NUMBER(3);

    -- cambios para servicios criticos
    v_operacion VARCHAR2(3) := NULL;
    v_proveedor VARCHAR2(10) := p_proveedor;

    v_abre_oper ba_cod_referencias.abreviatura%TYPE := NULL;
    --para identificar a servicios críticos
    v_tag VARCHAR2(20);
    v_cod_transaccion NUMBER := 503;
    v_estado bw_mov_pendientes.estado%TYPE;

    --para verificar la cantidad de firmas pendientes de la operacion
    FUNCTION lf_verificarPagoPendiente(p_token               IN VARCHAR2,
                                       p_codPersonaVinculada IN VARCHAR2)
      RETURN NUMBER IS
      v_nro_documento  bw_mov_pendientes.nro_documento%TYPE;
      v_aut_pendientes bw_mov_pendientes.can_aut_faltantes%TYPE := 0;
      v_dato2          bw_mov_pendientes.dato2%TYPE;
    BEGIN

      BEGIN
        SELECT p.nro_documento, p.can_aut_faltantes, p.estado, p.dato2
          INTO v_nro_documento, v_aut_pendientes, v_estado, v_dato2
          FROM bw_mov_pendientes p
         WHERE p.cod_tip_mensaje = v_cod_operacion
           AND p.cod_per_principal = p_codPersonaVinculada
           AND p.dato = p_token;

        IF (v_estado <> 'P') THEN
          IF v_estado IN ('C', 'E') AND v_dato2 IS NULL THEN
            -- si la operacion se confirmo pero todavia no se proceso
            RETURN - 2;
          ELSIF v_estado IN ('C', 'E') AND v_dato2 IS NOT NULL THEN
            RETURN - 3;
          END IF;
          RETURN - 1;
        END IF;

      EXCEPTION
        WHEN OTHERS THEN
          RETURN v_can_aut_requeridas;
      END;

      RETURN v_aut_pendientes;
    END;

    -- Permite Verificar Operaciones según su criticidad
    FUNCTION lf_verificarPago(p_sesion     VARCHAR2,
                              p_cuenta     VARCHAR2,
                              p_numeroIp   VARCHAR2,
                              p_monto      NUMBER,
                              p_cod_moneda VARCHAR2,
                              p_modo       VARCHAR2)
      RETURN typ_pagoServiciosWs IS
    BEGIN
      v_abre_oper := paw_uti.fu_obt_abr_refcodes('SERVICIOS_CRITICOS',
                                                 p_servicio,
                                                 v_proveedor);
      IF v_abre_oper = p_servicio THEN
        v_operacion := '091';
          v_tag       := 'COD_WS_CRI:'; -- para diferenciar limites en los movimientos
      ELSE
        v_operacion := '088';
          v_tag       := 'COD_WS:';
      END IF;
      v_res_limite := fu_obtenerLimite(v_usuario,
                                       v_operacion,
                                       nvl(v_usuario.codigoEmpresa,
                                       v_usuario.codigoPersona),
                                       v_nro_cta_debito,
                                       v_cod_mon_debito,
                                       v_cod_transaccion,
                                       v_cod_tra_padre,
                                       v_monto,
                                       v_modo);

      v_retorno.error                := v_res_limite.error;
      v_retorno.nombreRespuesta      := v_res_limite.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_res_limite.descripcionRespuesta;
      v_retorno.firmasPendientes     := v_can_aut_requeridas;

      IF v_res_limite.error = 'S' THEN
        pr_insertarBitacora(v_usuario.codigoPersona,
                            v_usuario.codigoCanal,
                            p_sesion,
                            v_operacion,
                            v_usuario.codigoEmpresa,
                            v_msj_bitacora || ' ' ||
                            fu_generarBitacora(v_retorno.error,
                                               v_retorno.nombreRespuesta,
                                               v_retorno.descripcionRespuesta,
                                               NULL),
                            BITACORA_ERROR);
        RETURN v_retorno;
      ELSE
        v_retorno.respuestaLimite := v_res_limite.codRespuesta;
      END IF;
      IF v_modo = 'V' THEN
        -- Crea el numero de sesion e insertar en bw_sesiones
        v_claveSesion := paw_bce.fu_enc_md5(p_sesion ||
                                            round(dbms_random.value(1000000,
                                                                    9999999)));

        IF pag_ser.fu_ins_sesion(v_claveSesion,
                                 p_numeroIp,
                                 v_usuario.codigoPersona,
                                 v_usuario.codigoEmpresa,
                                 p_cuenta) = 'S' THEN
          v_retorno.numeroSesion := v_claveSesion;
          pr_insertarBitacora(v_usuario.codigoPersona,
                              v_usuario.codigoCanal,
                              p_sesion,
                              v_cod_operacion,
                              v_usuario.codigoEmpresa,
                              v_msj_bitacora || ' ' ||
                              fu_generarBitacora(v_retorno.error,
                                                 v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta,
                                                 NULL),
                              BITACORA_SALIDA);
        ELSE
          --MSG_INS_MOV_ER
          pr_mensajeUsuario(MSG_INS_MOV_ER,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);
          pr_insertarBitacora(v_usuario.codigoPersona,
                              v_usuario.codigoCanal,
                              p_sesion,
                              v_cod_operacion,
                              v_usuario.codigoEmpresa,
                              v_msj_bitacora || ', ORA-ERR: [' ||
                              substr(SQLERRM, 1, 200) || '] ' ||
                              fu_generarBitacora(v_retorno.error,
                                                 v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta,
                                                 NULL),
                              BITACORA_ERROR);
        END IF;
      END IF;
      RETURN v_retorno;
    END;

    /** FUNCIÓN PRINCIPAL */
  BEGIN
    --validamos la sesión del cliente
    v_usuario := fu_validarSesion(p_sesion, p_codigoCanal);
    IF v_usuario.error = 'S' THEN
      v_retorno.error                := v_usuario.error;
      v_retorno.nombreRespuesta      := v_usuario.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_usuario.descripcionRespuesta;
      RETURN v_retorno;
    END IF;
    -- validamos la caja
    v_men_caja := lf_val_caja(v_usuario);
    IF v_men_caja.error = 'S' THEN
      v_retorno.error                := v_men_caja.error;
      v_retorno.nombreRespuesta      := v_men_caja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_men_caja.descripcionRespuesta;
      RETURN v_retorno;
    END IF;

    v_modo           := substr(p_modo, 0, 1);
    v_monto          := depurarNumerico(p_monto, 21);
    v_codCanal       := depurarNumerico(p_codigoCanal, 3);
    v_nro_cta_debito := depurarAlfanumerico(p_cuentaDebito, CUENTA_TAMANO);
    v_hor_actual     := to_char(SYSDATE, 'HH24:MI:SS');
    v_fec_actual     := pae_cnf.FU_OBT_FEC_ACTUAL(9);
    -- DDSI-265 -- 02/2018 : Se busca una hora disponible
    /*v_hor_actual      := fug_obt_hor_disponible(v_fec_actual,
                                                v_hor_actual,
                                                v_cod_usuario_hb,
                                                v_es_mov_noc);*/
    v_terminal        := depurarAlfanumerico(p_terminal, 20);
    v_sesion          := depurarAlfanumerico(p_sesion, 32);
    v_sesionServicios := depurarAlfanumerico(p_sesionServicios, 32);

    --para la referencia de pago
    v_extraData := depurarAlfanumerico(p_extra, 200);

    pr_mensajeUsuario(MSG_OK,
                      v_retorno.nombreRespuesta,
                      v_retorno.descripcionRespuesta,
                      v_retorno.error);
    --mensaje con parametros
    v_msj_bitacora := substr('modo:' || v_modo || ', mto:' || v_monto ||
                             ', cta:' || v_nro_cta_debito || ', fecha:' ||
                             v_fec_actual || ', hora:' || v_hor_actual ||
                             ', term:' || v_terminal || ', mon:' ||
                             p_moneda || ', serv:' || p_servicio ||
                             ', tokSer:' || p_tokenServicios || ', provr: ' ||
                             p_proveedor || ', sesServ: ' || v_sesionServicios ||
                             ', nroTransaccion: '||p_numeroTransaccion,
                             1,
                             1000);

    --verificamos los permisos del usuario sobre el tipo de operación
    v_permiso := lf_obt_permisos(v_usuario, v_cod_operacion);
    IF (v_permiso.error = 'S') THEN
      v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
      v_retorno.error                := v_permiso.error;
      pr_mensajeUsuario(SER_PER_SIN_AUT,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
      pr_insertarBitacora(v_usuario.codigoPersona,
                          p_codigoCanal,
                          p_sesion,
                          v_cod_operacion,
                          v_usuario.codigoEmpresa,
                          v_msj_bitacora || ' ' ||
                          fu_generarBitacora(v_retorno.error,
                                             v_retorno.nombreRespuesta,
                                             v_retorno.descripcionRespuesta,
                                             NULL),
                          BITACORA_ERROR);
      RETURN v_retorno;
    END IF;

    --verificamos que tiene permiso para registrar y autorizar
    IF v_permiso.registra = FALSE AND v_permiso.autoriza = FALSE THEN
      pr_mensajeUsuario(SER_PER_SIN_AUT,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
      pr_insertarBitacora(v_usuario.codigoPersona,
                          p_codigoCanal,
                          p_sesion,
                          v_cod_operacion,
                          v_usuario.codigoEmpresa,
                          v_msj_bitacora || ' ' ||
                          fu_generarbitacora(v_retorno.error,
                                             v_retorno.nombreRespuesta,
                                             v_retorno.descripcionRespuesta,
                                             NULL),
                          BITACORA_ERROR);
      RETURN v_retorno;
    END IF;

    --creamos la sesión en bw_sesiones
    IF v_modo <> 'G' THEN
      v_retorno := lf_verificarPago(v_sesion,
                                    v_nro_cta_debito,
                                    p_numeroIp,
                                    v_monto,
                                    v_cod_mon_debito,
                                    v_modo);
      IF v_retorno.error = 'S' THEN
        RETURN v_retorno;
      END IF;
    END IF;

    --verificamos si la operación no esta pendiente
    IF (v_can_aut_requeridas > 0) THEN

      v_aut_pendientes := lf_verificarPagoPendiente(p_tokenServicios,
                                                    v_usuario.codigoEmpresa);

      IF v_aut_pendientes = -1 THEN
        pr_mensajeusuario(SER_PER_SIN_AUT,
                          v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta,
                          v_retorno.error);

        pr_insertarbitacora(v_usuario.codigoPersona,
                            v_codCanal,
                            p_sesion,
                            v_cod_operacion,
                            v_usuario.codigoEmpresa,
                            'Operacion Ya procesada' || SQLERRM,
                            bitacora_error);
        RETURN v_retorno;
      END IF;
      IF v_aut_pendientes = -2 THEN
        v_aut_pendientes := 0;
      END IF;
    ELSE
      v_aut_pendientes := 0;
    END IF;

    --verificamos la cantidad de autorizaciones requeridas
    IF v_modo = 'C' AND v_aut_pendientes = 0 THEN
      v_modo := 'A';
    END IF;

    pr_insertarBitacora(v_usuario.codigoPersona,
                        v_codCanal,
                        v_sesion,
                        v_cod_operacion,
                        v_usuario.codigoEmpresa,
                        v_msj_bitacora,
                        BITACORA_ENTRADA);
    pr_mensajeUsuario(MSG_OK,
                      v_retorno.nombreRespuesta,
                      v_retorno.descripcionRespuesta,
                      v_retorno.error);

    IF v_monto <= 0 THEN
      pr_mensajeusuario(MSG_COD_TRA_INVALIDA,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
      pr_insertarbitacora(v_usuario.codigoPersona,
                          v_codCanal,
                          p_sesion,
                          v_cod_operacion,
                          v_usuario.codigoEmpresa,
                          v_msj_bitacora || ', mtoDebInvalido: ' || v_monto || ' ' ||
                          fu_generarBitacora(v_retorno.error,
                                             v_retorno.nombreRespuesta,
                                             v_retorno.descripcionRespuesta,
                                             NULL),
                          BITACORA_ERROR);
      RETURN v_retorno;
    END IF;

    IF v_modo IN ('V', 'C', 'A') THEN
      --obtenemos si es cuenta de TDC o CC o AH
      SELECT cod_modulo
        INTO v_cod_modulo
        FROM ge_cuentas gcc
       WHERE gcc.nro_cuenta = v_nro_cta_debito;

      IF v_retorno.error = 'N' AND nvl(p_modo, 'x') <> 'G' THEN
        -- control de límites y crear sesión de pago de servicios
        --verificamos si es servicio crítico.
        v_abre_oper := PAW_UTI.fu_obt_abr_refcodes('SERVICIOS_CRITICOS',
                                                   p_servicio,
                                                   v_proveedor);
        IF v_abre_oper = p_servicio THEN
          v_operacion := '091';
          v_tag       := 'COD_WS_CRI:'; -- para diferenciar limites en los movimientos
        ELSE
          v_operacion := '088';
          v_tag       := 'COD_WS:';
        END IF;
      END IF;

      --si no es TDC, validamos la cuenta débito
      IF v_cod_modulo != 5 THEN
        -- validamos que la cuenta débito pertenezca al cliente
        IF lf_val_cta_origen(v_nro_cta_debito,
                             nvl(v_usuario.codigoEmpresa,
                                 v_usuario.codigoPersona)) = 'N' THEN
          pr_mensajeUsuario(MSG_CTA_NO_CORRESP,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);
          pr_insertarBitacora(v_usuario.codigoPersona,
                              p_codigoCanal,
                              p_sesion,
                              v_cod_operacion,
                              v_usuario.codigoEmpresa,
                              v_msj_bitacora || ' ' ||
                              fu_generarBitacora(v_retorno.error,
                                                 v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta,
                                                 NULL),
                              BITACORA_ERROR);
          RETURN v_retorno;
        END IF;

        --Validamos que la cuenta no sea conjunta
        IF paw_bas.fu_es_conjunta(v_nro_cta_debito, v_can_aut_requeridas) = 'S' THEN
          pr_mensajeUsuario(MSG_CTA_CONJUNTA,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);
          pr_insertarBitacora(v_usuario.codigoPersona,
                              v_usuario.codigoCanal,
                              p_sesion,
                              v_cod_operacion,
                              v_usuario.codigoEmpresa,
                              v_msj_bitacora || ' ' ||
                              fu_generarBitacora(v_retorno.error,
                                                 v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta,
                                                 NULL),
                              BITACORA_ERROR);

          -- se intenta dejar en pendiente si corresponde
          IF v_usuario.codigoEmpresa IS NOT NULL AND v_modo = 'C' THEN
            paw_can.pr_act_pendiente(v_usuario.codigoPersona, v_usuario.codigoEmpresa,  v_cod_operacion, p_tokenServicios);
          END IF;
          RETURN v_retorno;
        END IF;

        -- validamos la cuenta débito
        v_error := lf_val_cta_debito(v_nro_cta_debito,
                                     v_cod_tra_padre,
                                     v_monto,
                                     v_cod_mon_debito,
                                     v_cod_mod_debito,
                                     v_cod_mad_debito,
                                     v_cod_ofi_debito,
                                     v_cta_for_debito,
                                     v_nom_cta_debito,
                                     v_usuario,
                                     v_men_caja);
        IF v_error.error = 'S' THEN
          v_retorno.error                := v_error.error;
          v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
          RETURN v_retorno;
        END IF;

        -- validamos la moneda debito, solo se permite moneda local
        IF v_cod_mon_debito <> v_cod_mon_local THEN
          pr_mensajeUsuario(MSG_MON_INVALIDA,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);
          pr_insertarBitacora(v_usuario.codigoPersona,
                              p_codigoCanal,
                              p_sesion,
                              v_cod_operacion,
                              v_usuario.codigoEmpresa,
                              v_msj_bitacora || ' ' ||
                              fu_generarBitacora(v_retorno.error,
                                                 v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta,
                                                 NULL),
                              BITACORA_ERROR);
          RETURN v_retorno;
        END IF;

      ELSE
        --validar algo de TDC
        BEGIN

          IF v_usuario.codigoEmpresa is not null THEN
            SELECT a.nro_cuenta
              INTO v_nro_cta_debito
              FROM ge_cta_clientes a, ta_tarjetas b, ge_cuentas c
             WHERE b.nro_cuenta = v_nro_cta_debito
               AND b.nro_cuenta = a.nro_cuenta
               AND a.nro_cuenta = c.nro_cuenta
               AND b.nro_cuenta = c.nro_cuenta
               AND a.cod_persona = v_usuario.codigoEmpresa
               AND b.cod_persona = v_usuario.codigoEmpresa
               AND c.estado = 'N'
               AND rownum = 1;
          ELSE
            SELECT DISTINCT (a.nro_cuenta)
              INTO v_nro_cta_debito
              FROM ge_cta_clientes a, ta_tarjetas b, ge_cuentas c
             WHERE b.nro_cuenta = v_nro_cta_debito
               AND b.nro_cuenta = a.nro_cuenta
               AND a.nro_cuenta = c.nro_cuenta
               AND b.nro_cuenta = c.nro_cuenta
               AND a.cod_persona = v_usuario.codigoPersona
               AND c.estado = 'N'
               AND rownum = 1;
          END IF;

        EXCEPTION
          WHEN no_data_found THEN
            pr_mensajeUsuario(MSG_OBT_TAR_NE,
                              v_retorno.nombreRespuesta,
                              v_retorno.descripcionRespuesta,
                              v_retorno.error);
            pr_insertarBitacora(v_usuario.codigoPersona,
                                p_codigoCanal,
                                p_sesion,
                                v_cod_operacion,
                                v_usuario.codigoEmpresa,
                                fu_generarbitacora(v_retorno.error,
                                                   v_retorno.nombreRespuesta,
                                                   v_retorno.descripcionRespuesta,
                                                   null),
                                BITACORA_ERROR);
            RETURN v_retorno;
        END;
      END IF;
    END IF;
    -- segun informe de fu_obt_limite, solo al confirmar o autorizar la operación
    IF v_modo IN ('A', 'C') AND nvl(v_estado, 'x') <> 'E' THEN
      -- clave transaccional requerida
      IF v_retorno.respuestaLimite IN ('10', '11') THEN
        v_lugar := 'lf_obt_cla_validar';
        v_error := lf_obt_cla_validar(p_claveTransaccional,
                                      v_usuario.codigoPersona,
                                      v_usuario.codigoEmpresa,
                                      'T');
      END IF;
      -- token requerido
      IF v_error.error = 'N' THEN
        IF v_retorno.respuestaLimite IN ('01', '11') THEN
          v_lugar := 'paw_seg.fu_obt_tok_validar';
          v_error := paw_seg.fu_obt_tok_validar(p_claveToken,
                                        v_usuario.codigoPersona,
                                        v_usuario.codigoEmpresa,
                                        v_modo);
        END IF;
      END IF;
      -- controlamos si hubo error
      IF v_error.error = 'S' THEN
        v_retorno.error                := v_error.error;
        v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
      END IF;
    END IF;

    IF v_retorno.error = 'N' THEN
      -- no hay problemas hasta aquí
      IF v_modo = 'V' THEN
        -- validación
        v_retorno.respuestaLimite := v_res_limite.codRespuesta;
      ELSIF v_modo = 'A' THEN
        -- confirmación de la operación
        -- esta la cuenta en condiciones, verifico el horario
        v_error := lp_ver_horario(v_horario,
                                  v_es_mov_noc,
                                  v_es_cta_noc,
                                  v_men_caja.fechaUltimoCierre,
                                  v_men_caja.codigoOficinaOrigen,
                                  v_fec_actual);
        -- si hubo error, salimos
        IF v_error.error = 'S' THEN
          v_retorno.error                := v_error.error;
          v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
        END IF;
        IF v_retorno.error = 'N' THEN

          -- seteamos cantidad de firmas pendientes para retorno
          v_retorno.firmasPendientes := v_aut_pendientes;
          --obtenemos nombre del servicio a pagar
          BEGIN
            SELECT descripcion
              INTO v_concepto
              FROM bw_pag_cod_servicios
             WHERE cod_servicio = p_servicio
               AND cod_proveedor = p_proveedor;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              v_concepto := '';
          END;

           v_abre_oper := paw_uti.fu_obt_abr_refcodes('SERVICIOS_CRITICOS',
                                                 p_servicio,
                                                 v_proveedor);
           IF v_abre_oper = p_servicio THEN
              v_operacion := '091';
              v_tag := 'COD_WS_CRI:';
           ELSE
              v_operacion := '088';
              v_tag :='COD_WS:';
           END IF;

          BEGIN

            SELECT s_pag_servicio.NEXTVAL INTO v_nro_documento FROM dual;

            v_nro_transaccion := p_numeroTransaccion;
            v_nro_lote        := p_tokenServicios;
            v_hor_actual      := fug_obt_hor_disponible(v_fec_actual, v_hor_actual, USER, v_es_mov_noc);
            -- registramos el pago de servicios
            rg_bpser.nro_cuenta       := v_nro_cta_debito;
            rg_bpser.fecha            := v_fec_actual;
            rg_bpser.hora             := v_hor_actual;
            rg_bpser.nro_transaccion  := v_nro_transaccion;
            rg_bpser.cod_moneda       := 'GS'; -- solo guaranies, Bancard Pago Móvil no soporta otra moneda
            rg_bpser.mto_transaccion  := v_monto;
            rg_bpser.mto_debito       := v_monto;
            rg_bpser.cod_mon_debito   := v_cod_mon_debito;
            rg_bpser.cod_mon_servicio := 1; -- moneda local
            rg_bpser.nro_sesion       := v_sesion;
            rg_bpser.cod_proveedor    := p_proveedor;
            rg_bpser.cod_ws_servicios := p_tokenServicios;
            rg_bpser.nro_documento    := v_nro_documento;
            rg_bpser.reversado        := 'N';
            rg_bpser.cod_servicio     := p_servicio;
            rg_bpser.ip_usuario       := p_numeroIp;
            rg_bpser.mto_comision     := v_comision;
            rg_bpser.nro_lote         := v_nro_lote;
            rg_bpser.cod_persona      := v_usuario.codigoPersona;
            rg_bpser.cod_empresa      := v_usuario.codigoEmpresa;
            rg_bpser.ser_concepto     := '-' || v_tag || v_concepto;
            rg_bpser.ref_pago         := v_extraData;

            INSERT INTO bw_pag_servicios VALUES rg_bpser;
            BEGIN
              -- registramos el movimiento
              lp_reg_operacion(v_nro_cta_debito,
                               v_cod_mon_debito,
                               v_monto,
                               v_nro_cta_credito,
                               NULL,
                               'Ses.Ser',
                               p_sesionServicios,
                               'TokenSer',
                               p_tokenServicios,
                               'Yaguarete - modo: ' || p_modo ||
                               ', monCre: GS',
                               NULL,
                               '000',
                               v_usuario.codigoPersona,
                               v_cod_operacion,
                               v_nro_documento,
                               p_codigoCanal,
                               p_sesion,
                               v_usuario.codigoEmpresa);
            EXCEPTION
              WHEN OTHERS THEN
                pr_mensajeUsuario(MSG_ERROR,
                                  v_retorno.nombreRespuesta,
                                  v_retorno.descripcionRespuesta,
                                  v_retorno.error);
                v_msj_bitacora := v_msj_bitacora || ', ora-err: [' ||
                                  substr(SQLERRM, 1, 200) || ']';
            END;
            v_retorno.nroDocumento := v_nro_documento;

            --notificamos el pago de servicio
            BEGIN
              v_ret := PAW_not.fu_not_pag_servicios(v_nro_cta_debito,
                                                    v_monto,
                                                    v_cod_mon_debito,
                                                    'P',
                                                    SYSDATE);
            EXCEPTION
              WHEN OTHERS THEN
                NULL;
            END;
          EXCEPTION
            WHEN OTHERS THEN
              pr_mensajeUsuario(MSG_ERROR,
                                v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta,
                                v_retorno.error);
              v_msj_bitacora := v_msj_bitacora || ', ORA-ERR: [' ||
                                substr(SQLERRM, 1, 250) || '] ';
          END;
        END IF;
      ELSIF v_modo = 'G' THEN
        IF v_aut_pendientes > 0 then
          pr_mensajeusuario(SER_PER_SIN_AUT,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);

          pr_insertarbitacora(v_usuario.codigoPersona,
                              v_codCanal,
                              p_sesion,
                              v_cod_operacion,
                              v_usuario.codigoEmpresa,
                              'Pago de Servicios.- UK_du' || SQLERRM,
                              bitacora_error);
          return v_retorno;
        end if;

        BEGIN
          UPDATE bw_pag_servicios
             SET nro_transaccion = v_extraData
           WHERE COD_WS_SERVICIOS = p_tokenServicios
             AND NRO_CUENTA = v_nro_cta_debito
             AND REVERSADO = 'N';
          -- actualiza dato2 si es empresa
          IF v_usuario.codigoEmpresa IS NOT NULL THEN
             UPDATE bw_mov_pendientes p
                SET p.dato2 = substr(nvl(v_extraData, p_tokenServicios), 1, 50)
              WHERE p.cod_per_principal = v_usuario.codigoEmpresa
                AND p.nro_cuenta = v_nro_cta_debito
                AND p.dato = p_tokenServicios
                AND p.cod_tip_mensaje IN ('088', '091')
                AND p.fec_insercion > TRUNC(SYSDATE);
          END IF;
          --hace falta llamar? verificar como queda el campo concepto!
          lp_act_mov_bancard(p_tokenServicios,
                             NULL,
                             v_extraData,
                             p_servicio,
                             v_nro_cta_debito,
                             v_men_caja);
        EXCEPTION
          WHEN DUP_VAL_ON_INDEX THEN
            pr_mensajeusuario(MOV_DUP_SERVICIO,
                              v_retorno.nombreRespuesta,
                              v_retorno.descripcionRespuesta,
                              v_retorno.error);
            pr_insertarbitacora(v_usuario.codigoPersona,
                                v_codCanal,
                                p_sesion,
                                v_cod_operacion,
                                v_usuario.codigoEmpresa,
                                v_msj_bitacora || ', DUP-VAL-ORA-ERR: [' ||
                                SUBSTR(SQLERRM, 1, 200) || ']',
                                bitacora_error);
            RETURN v_retorno;
          WHEN OTHERS THEN
            pr_mensajeusuario(MOV_DUP_SERVICIO,
                              v_retorno.nombreRespuesta,
                              v_retorno.descripcionRespuesta,
                              v_retorno.error);
            pr_insertarbitacora(v_usuario.codigoPersona,
                                v_codCanal,
                                p_sesion,
                                v_cod_operacion,
                                v_usuario.codigoEmpresa,
                                v_msj_bitacora || ', OTHERS-ORA-ERR: [' ||
                                SUBSTR(SQLERRM, 1, 200) || ']',
                                bitacora_error);
            RETURN v_retorno;
        END;

        pr_insertarbitacora(v_usuario.codigoPersona,
                            v_codCanal,
                            v_sesion,
                            v_cod_operacion,
                            v_usuario.codigoEmpresa,
                            v_msj_bitacora || ', SesSer:' ||
                            v_retorno.numeroSesion || ', resLim:' ||
                            v_retorno.respuestaLimite ||
                            fu_generarBitacora(v_retorno.error,
                                               v_retorno.nombreRespuesta,
                                               v_retorno.descripcionRespuesta,
                                               NULL),
                            BITACORA_SALIDA);

        ----
      ELSIF v_modo = 'C' and v_aut_pendientes > 0 then

        SELECT s_nro_documento.NEXTVAL INTO v_nro_documento FROM dual;

        INSERT INTO bw_mov_pendientes
          (nro_documento,
           cod_per_principal,
           fec_hora,
           cod_tip_mensaje,
           nro_cuenta,
           cod_moneda,
           descripcion,
           monto,
           cotizacion,
           mto_equ_local,
           nro_cta_contra,
           estado,
           can_aut_requeridas,
           can_aut_faltantes,
           cod_per_ingreso,
           mto_contra,
           cot_contra,
           etiqueta,
           dato,
           referencia)
        VALUES
          (v_nro_documento,
           nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona),
           SYSDATE,
           v_cod_operacion,
           v_nro_cta_debito,
           v_cod_mon_debito,
           'Pago Servicio',
           v_monto,
           null /*v_cot_debito*/,
           v_monto,
           '',
           'P',
           v_can_aut_requeridas,
           v_can_aut_requeridas,
           v_usuario.codigoPersona /* v_cod_persona */,
           v_monto,
           null /*v_cot_credito*/,
           'Token',
           p_tokenServicios,
           p_proveedor);

        v_retorno.firmasPendientes := v_can_aut_requeridas;
        pr_mensajeusuario(MSG_OK,
                          v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta,
                          v_retorno.error);
        v_retorno.nroDocumento := v_nro_documento;
        pr_insertarbitacora(v_usuario.codigoPersona,
                            v_codCanal,
                            v_sesion,
                            v_cod_operacion,
                            v_usuario.codigoEmpresa,
                            v_msj_bitacora || ', firReq: ' ||
                            v_can_aut_requeridas ||
                            fu_generarBitacora(v_retorno.error,
                                               v_retorno.nombreRespuesta,
                                               v_retorno.descripcionRespuesta,
                                               NULL),
                            BITACORA_SALIDA);
        RETURN v_retorno;
      ELSE
        -- No es del tipo V-validación ni C-confirmación
        pr_mensajeUsuario(MSG_OPE_NO_PERM,
                          v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta,
                          v_retorno.error);
      END IF;
    END IF;

    IF v_retorno.error = 'S' THEN
      pr_insertarBitacora(v_usuario.codigoPersona,
                          p_codigoCanal,
                          p_sesion,
                          v_cod_operacion,
                          v_usuario.codigoEmpresa,
                          v_msj_bitacora || ' ' ||
                          fu_generarBitacora(v_retorno.error,
                                             v_retorno.nombreRespuesta,
                                             v_retorno.descripcionRespuesta,
                                             NULL),
                          BITACORA_ERROR);
    ELSE
      pr_insertarBitacora(v_usuario.codigoPersona,
                          p_codigoCanal,
                          p_sesion,
                          v_cod_operacion,
                          v_usuario.codigoEmpresa,
                          v_msj_bitacora || ' ' ||
                          fu_generarBitacora(v_retorno.error,
                                             v_retorno.nombreRespuesta,
                                             v_retorno.descripcionRespuesta,
                                             NULL),
                          BITACORA_SALIDA);
    END IF;
    RETURN v_retorno;

  EXCEPTION
    WHEN OTHERS THEN
      pr_mensajeUsuario(MSG_ERROR,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
      pr_insertarBitacora(v_usuario.codigoPersona,
                          p_codigoCanal,
                          p_sesion,
                          v_cod_operacion,
                          v_usuario.codigoEmpresa,
                          substr(v_msj_bitacora || ' En: ' || v_lugar ||
                                 ' Msg: ' || SQLERRM,
                                 1,
                                 1000),
                          BITACORA_ERROR);
      RETURN v_retorno;
  END;


  FUNCTION fu_renovarPolizaSeguro(p_sesion       IN VARCHAR2,
                                 p_codigoCanal  IN VARCHAR2,
                                 p_codSeguro    IN NUMBER,
                 p_cuentaDebito IN VARCHAR2)
    RETURN typ_detallesegurorenovado IS
    v_cod_persona     ba_personas.cod_persona%TYPE;
    v_cod_moneda      ge_cuentas.cod_moneda%TYPE;



    v_nro_renovacion  NUMBER;
    v_mto_capital     NUMBER(18,2);
    v_mto_cuota       NUMBER(18,2);
    v_tipo_seguro     VARCHAR2(5);
    v_cod_ente        NUMBER(5);
    v_cod_tip_seguro  NUMBER;

    v_nro_seguro     NUMBER;
    v_cod_err_seg    NUMBER;

    v_usu_sesion      typ_validarsesion;
    v_msj_caja        typ_mensajeCaja;
    v_retorno         typ_detallesegurorenovado := typ_detallesegurorenovado();
    v_permiso         typ_obtenerPermisos;

    v_observacion     bw_movimientos.observacion%TYPE;
    v_dir_ip          bw_movimientos.dir_ip%TYPE;
    v_parametros      bw_movimientos.parametros%TYPE;

    v_cod_operacion   VARCHAR2(3) := '043';
    v_msj_bitacora    VARCHAR2(1000);

    v_cod_canal       ge_canales.cod_canal%TYPE;

    --
    MSG_OPE_INVALIDA    CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
    MSG_NRO_CTA_INV     CONSTANT VARCHAR2(15) := 'G_NROCTAINVALID';

  BEGIN
    PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK,
                              v_retorno.nombreRespuesta,
                              v_retorno.descripcionRespuesta,
                              v_retorno.error);
    v_retorno.listaDetalles := typ_listaEtiquetaValor();

    -- 1. valido la clave del cliente
    v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion, 32),
                                     p_codigoCanal);
    IF v_usu_sesion.error = 'S' THEN
      v_retorno.error                := v_usu_sesion.error;
      v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
      RETURN v_retorno;
    END IF;
    v_cod_persona := nvl(v_usu_sesion.codigoEmpresa,
                         v_usu_sesion.codigoPersona);
    PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona,
                                p_codigoCanal,
                                p_sesion,
                                v_cod_operacion,
                                v_usu_sesion.codigoEmpresa,
                                v_msj_bitacora || ' ' ||
                                PAW_UTI.fu_generarbitacora(v_retorno.error,
                                                           v_retorno.nombreRespuesta,
                                                           v_retorno.descripcionRespuesta,
                                                           NULL),
                                PAW_UTI.BITACORA_ENTRADA);
    -- 2. verifica el canal de origen
    v_msj_caja := lf_val_caja(v_usu_sesion);
    IF v_msj_caja.error = 'S' THEN
      v_retorno.error                := v_msj_caja.error;
      v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
      PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona,
                                  p_codigoCanal,
                                  p_sesion,
                                  v_cod_operacion,
                                  v_usu_sesion.codigoEmpresa,
                                  v_msj_bitacora || ' ' ||
                                  PAW_UTI.fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta,
                                                             NULL),
                                  PAW_UTI.BITACORA_ERROR);
      RETURN v_retorno;
    END IF;
    -- 3. verifico si el cliente con su perfil tendrÃ¡ acceso a realizar la transacciÃ³n
    v_permiso      := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
    v_msj_bitacora := v_msj_bitacora || ', perf: ' ||
                      v_usu_sesion.codigoPerfil;
    IF v_permiso.error = 'S' THEN
      v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
      v_retorno.error                := v_permiso.error;
      PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona,
                                  p_codigoCanal,
                                  p_sesion,
                                  v_cod_operacion,
                                  v_usu_sesion.codigoEmpresa,
                                  v_msj_bitacora || ' ' ||
                                  PAW_UTI.fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta,
                                                             NULL),
                                  PAW_UTI.BITACORA_ERROR);
      RETURN v_retorno;
    END IF;

    --Valida que la cuenta corresponda al cliente
    IF p_cuentaDebito IS NOT NULL THEN
      IF lf_val_cta_origen(p_cuentaDebito,
                           nvl(v_usu_sesion.codigoEmpresa,
                               v_usu_sesion.codigopersona)) = 'N' THEN
        PAW_UTI.pr_mensajeUsuario(MSG_NRO_CTA_INV,
                                  v_retorno.nombreRespuesta,
                                  v_retorno.descripcionRespuesta,
                                  v_retorno.error);
        PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona,
                                    p_codigoCanal,
                                    p_sesion,
                                    v_cod_operacion,
                                    v_usu_sesion.codigoEmpresa,
                                    v_msj_bitacora || ' ' ||
                                    PAW_UTI.fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta,
                                                               NULL),
                                    PAW_UTI.BITACORA_ERROR);
        RETURN v_retorno;
      END IF;
      -- Validar inhibidos
      IF fug_obt_inhibicion(fug_obt_pardinamico('COD_CAU_DEM_JUDICIAL'),
                            nvl(v_usu_sesion.codigoEmpresa,
                                v_usu_sesion.codigopersona),
                            p_cuentaDebito) THEN
        PAW_UTI.pr_mensajeUsuario(MSG_OPE_INVALIDA,
                                  v_retorno.nombreRespuesta,
                                  v_retorno.descripcionRespuesta,
                                  v_retorno.error);
        PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona,
                                    p_codigoCanal,
                                    p_sesion,
                                    v_cod_operacion,
                                    v_usu_sesion.codigoEmpresa,
                                    v_msj_bitacora || ' ' ||
                                    PAW_UTI.fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta,
                                                               NULL),
                                    PAW_UTI.BITACORA_ERROR);
        RETURN v_retorno;
      END IF;
    END IF;


    SELECT r.nro_renovacion, r.mto_capital, r.mto_cuota,
           r.cod_tip_seguro, r.cod_ente
      into v_nro_renovacion,
           v_mto_capital, v_mto_cuota, v_tipo_seguro, v_cod_ente
      FROM ge_ren_pol_seguros r
    WHERE r.nro_seg_ant = p_codSeguro;

    begin
      select val_maximo
        into v_cod_tip_seguro
        from ba_cod_referencias
       where dominio = 'REL_TIP_SEGUROS'
         and val_minimo = v_tipo_seguro;
    exception
      when others then
         raise_application_error(-20000, 'No se encuentra el código de seguro '||' - ' || SQLERRM);
    end;
         -- Llamar a prw_ins_seguros
          prw_ins_seguros(nvl(v_usu_sesion.codigoEmpresa,
                         v_usu_sesion.codigoPersona),
                        p_cuentaDebito,
                        v_mto_capital,
                        v_mto_cuota,
                        29,
                        v_cod_tip_seguro,
                        v_cod_ente,
                        v_nro_seguro,
                        v_cod_err_seg,
                        null,
                        null,
                        v_nro_renovacion,
                        'W');

        IF v_cod_err_seg <> 0 THEN
          paw_uti.pr_mensajeUsuario(MSG_ERROR,
                                    v_retorno.nombreRespuesta,
                                    v_retorno.descripcionRespuesta,
                                    v_retorno.error);
          paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona,
                                      p_codigoCanal,
                                      p_sesion,
                                      v_cod_operacion,
                                      v_usu_sesion.codigoEmpresa,
                                      v_msj_bitacora ||
                                      ' - No se pudo renovar el seguro - v_cod_err_seg: - ' ||
                                      v_cod_err_seg ||
                                      fu_generarbitacora(v_retorno.error,
                                                         v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta,
                                                         null),
                                      paw_uti.BITACORA_ERROR);
          RETURN v_retorno;
        END IF;



         v_observacion := 'Renovacion de poliza de seguro';
         v_dir_ip      := SUBSTR(sys_context('USERENV', 'IP_ADDRESS'), -20);
         v_parametros  := 'cod_persona: ' || v_cod_persona || ', cod_canal: ' || v_cod_canal ||
                       ', nro_cuenta: ' || p_cuentaDebito;
          lp_reg_operacion(p_cuentaDebito, -- p_nro_cuenta
                           v_cod_moneda, -- p_cod_moneda
                           v_mto_cuota, -- p_monto
                           v_nro_seguro, -- p_nro_cta_contra
                           1, -- p_cantidad
                           '', -- p_etiqueta
                           '', -- p_dato
                           '', -- p_etiqueta2
                           '', -- p_dato2
                           v_observacion, -- p_observacion
                           v_dir_ip, -- p_dir_ip
                           '', -- p_cod_respuesta
                           v_cod_persona, --p_cod_persona
                           v_cod_operacion, --p_cod_operacion
                           v_nro_seguro, -- p_nro_operacion
                           v_cod_canal, -- p_nro_terminal
                           p_sesion, -- p_clave
                           v_usu_sesion.codigoEmpresa, --p_cod_per_empresa
                           v_parametros, -- p_parametros
                           '', -- p_etiqueta3
                           '' -- p_dato3
                           );


      --Si no hubo error en la renovacion del seguro, se retorna el nÃºmero de seguro creado
      v_retorno.numeroDocumento := v_nro_seguro;
      v_retorno.nroCuenta := p_cuentaDebito;
      v_retorno.monto           := v_mto_capital;
      v_retorno.montoCuota      := v_mto_cuota;
      v_retorno.tipoSeguro      := v_cod_tip_seguro;

    RETURN v_retorno;
  EXCEPTION
    WHEN OTHERS THEN
      paw_uti.pr_mensajeUsuario(MSG_ERROR,
                                v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta,
                                v_retorno.error);
      paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona,
                                  p_codigoCanal,
                                  p_sesion,
                                  v_cod_operacion,
                                  v_usu_sesion.codigoEmpresa,
                                  v_msj_bitacora || ', ORA-ERR: [' ||
                                  SUBSTR(SQLERRM, 1, 200) || '] ' ||
                                  PAW_UTI.fu_generarbitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta,
                                                             NULL),
                                  paw_uti.BITACORA_ERROR);
      RETURN v_retorno;
  END;

FUNCTION fu_cambiarCanalActivSoftoken(p_sesion IN VARCHAR2, p_codigoCanal IN VARCHAR2, p_serial IN VARCHAR2,
                                 p_nue_canal IN VARCHAR2) RETURN NUMBER IS
  v_valSesion      typ_validarsesion;
  v_mensajeCaja    typ_mensajeCaja;

BEGIN

  v_valSesion := fu_validarSesion(p_sesion, p_codigoCanal);

  IF v_valSesion.error = 'S' THEN
    RETURN -1;
  END IF;

  -- Verifica el canal de origen
  v_mensajeCaja := lf_val_caja(v_valSesion);

  IF v_mensajeCaja.error = 'S' THEN
    RETURN -1;
  END IF;

  return Paw_Otp.fu_cambiarCanalActivSoftoken(p_serial, v_valSesion.codigoPersona, p_nue_canal);

END;
   --
   FUNCTION fu_asi_nro_token(p_session            IN VARCHAR2,
                             p_codCanal           IN NUMBER,
                             p_modo               IN VARCHAR2,
                             p_nro_telefono       IN VARCHAR2,
                             p_claveTransaccional IN VARCHAR2,
                             p_claveToken         IN VARCHAR2,
                             p_cod_operador       IN VARCHAR2 DEFAULT NULL) RETURN typ_regCelToken IS
      v_retorno       typ_regCelToken := typ_regCelToken();
      v_usu_sesion    typ_validarSesion;
      v_permiso       typ_obtenerPermisos;
      v_cod_operacion bw_tip_mensajes.cod_tip_mensaje%TYPE := '150';
      v_nro_telefono  VARCHAR2(20);
      v_nro_documento bw_mov_pendientes.nro_documento%TYPE;
      v_msj_bitacora  VARCHAR2(500);
      v_resLimite     typ_respuestaLimite;
      retError        typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_mod_limite    VARCHAR2(1);
      v_vinculo VARCHAR2(10);
   BEGIN
      v_nro_telefono := fug_cel_internacional(p_nro_telefono);
      v_msj_bitacora := 'modo: '||substr(p_modo, 1, 1)||', tel: '||v_nro_telefono || ', codOpe:'||p_cod_operador||', p_claveToken: ***';

      v_usu_sesion := fu_validarSesion(p_session, p_codCanal);

      paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), paw_uti.BITACORA_ENTRADA);

      v_mod_limite := p_modo;

      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      IF nvl(p_modo, 'x') = 'A' THEN
         IF g_aut_operacion = FALSE THEN
            paw_uti.pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      ELSE
         v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
         IF (v_permiso.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
            v_retorno.error                := v_permiso.error;
            paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- se verifica que tenga permiso para registrar
         IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
            paw_uti.pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;

      paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      IF p_modo = 'D' THEN
         BEGIN
            SELECT SUBSTR(TRIM(c.telefono), 1, 20)
              INTO v_retorno.numero
              FROM bw_td_configuraciones c
             WHERE c.cod_persona = v_usu_sesion.codigoEmpresa
               AND c.cod_per_vinculo = v_usu_sesion.codigoPersona;
         EXCEPTION
            WHEN OTHERS THEN
               v_retorno.numero := NULL;
         END;
         v_msj_bitacora := ', num: '||v_retorno.numero;
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);
         RETURN v_retorno;
      END IF;
      v_retorno.numero := v_nro_telefono;

      IF p_modo IN ('V','C','A') THEN
         v_resLimite := fu_obtenerLimite(v_usu_sesion, v_cod_operacion, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona),
                                         null, v_cod_mon_local, 503, 303, 1, v_mod_limite);
         IF v_resLimite.error = 'S' THEN
            v_retorno.error := v_resLimite.error;
            v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
            paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         END IF;
      END IF;

      IF v_retorno.error = 'N' THEN
         IF p_modo in ('C') THEN
            retError.error := 'N';
            DECLARE
               v_lugar VARCHAR2(50);
            BEGIN
              IF v_resLimite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
                 v_lugar  := 'lf_obt_cla_validar - ';
                 retError := lf_obt_cla_validar(p_claveTransaccional, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, 'T');
              END IF;

              IF retError.error = 'N' THEN
                 IF v_resLimite.codRespuesta IN ('01', '11') THEN -- token requerido
                    v_lugar  := 'paw_seg.fu_obt_tok_validar - ';
                    retError := paw_seg.fu_obt_tok_validar(p_claveToken, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, v_mod_limite);
                 END IF;
              END IF;

              IF retError.error = 'S' THEN
                 v_retorno.error := retError.error;
                 v_retorno.nombreRespuesta := retError.nombreRespuesta;
                 v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                 paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_lugar || v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
              END IF;
            END;
          END IF;
      END IF;

      IF v_retorno.error = 'N' THEN
         IF p_modo = 'V' THEN
            v_retorno.resLimite := v_resLimite.codRespuesta;
            v_retorno.cantAutorizadores := v_permiso.canAutRequeridas;
         ELSIF p_modo = 'C' THEN
            SELECT s_nro_documento.NEXTVAL
              INTO v_nro_documento
              FROM dual;
            INSERT INTO BW_MOV_PENDIENTES
              (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje,
              descripcion, estado, cod_per_ingreso, can_aut_requeridas,
              can_aut_faltantes, etiqueta, dato)
             VALUES
              (v_nro_documento, v_usu_sesion.codigoEmpresa, sysdate, v_cod_operacion,
              fue_obt_des_operacion(v_cod_operacion), 'P', v_usu_sesion.codigoPersona, v_permiso.canAutRequeridas,
              v_permiso.canAutRequeridas, 'NRO. TELEFONO', v_nro_telefono);

             DECLARE
                v_mail varchar2(100);
                v_res_not NUMBER;
                v_mai_text VARCHAR2(600);
                v_nom_operador VARCHAR2(100);
             BEGIN
                v_mail := FUG_OBT_DIR_MAIL_PER(v_usu_sesion.codigoPersona);
                v_nom_operador := FUE_OBT_NOM_PERSONA(v_usu_sesion.codigoPersona);
                v_mai_text := 'Estimado <b>' || v_nom_operador || '</b><br><br> ' ||
                   'Hemos registrado su solicitud de actualización de Número de teléfono para la vinculación del Token Digital Empresas. <br><br>' ||
                   'Si usted no realizó este cambio favor comunicarse al Call Center 417.6000. <br><br>' ||
                    'Gracias por utilizar nuestros canales digitales';
                v_res_not := PAW_NOT.fu_env_email_prueba(v_mail, UTL_URL.ESCAPE(v_mai_text, TRUE, 'UTF-8'), 'ACTUALIZACION NUMERO TOKEN DIGITAL');
             EXCEPTION
                WHEN OTHERS THEN
                     paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
             END;


            v_retorno.nroDocumento := v_nro_documento;
            v_retorno.cantAutorizadores := v_permiso.canAutRequeridas;
         ELSIF p_modo = 'A' THEN
            BEGIN
               SELECT v.TIPO
                 INTO v_vinculo
                 from ba_vinculos v
                where v.cod_persona = v_usu_sesion.codigoEmpresa
                  AND v.cod_per_vinculo = p_cod_operador
                  AND v.cod_perfil IS NOT NULL
                  AND v.tipo IS NOT NULL;
            EXCEPTION
               WHEN OTHERS THEN
                  paw_uti.pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
                 RETURN v_retorno;
            END;
            DECLARE
               v_mensaje    ge_par_dinamicos.val_parametro%TYPE;
               v_res_not    NUMBER;
               v_cod_perfil ba_vinculos.cod_perfil%TYPE := fuw_obt_per_empresa(v_usu_sesion.codigoEmpresa, p_cod_operador);
            BEGIN

               -- ACTUALIZAR NRO EN BW_TD_CONFIGURACIONES
               prg_td_act_datos(v_usu_sesion.codigoEmpresa, p_cod_operador, v_vinculo, v_nro_telefono,
                  'N', -- NO ENVIAR
                  NULL, NULL, 'N'); -- SIN VERIFICAR

               -- ENVIAR NOTIFICACION
               v_res_not := -1;
               v_mensaje := fug_obt_pardinamico('MSJ_UPD_TOK_DIGITAL_PJ');
               IF v_mensaje IS NOT NULL THEN
                  v_res_not := paw_not.fu_env_sms_prueba(v_nro_telefono, v_mensaje, 'PAW_BEl.fu_asi_nro_token');
               END IF;
               IF v_res_not = 0 THEN
                  UPDATE bw_td_configuraciones a
                     SET a.enviado = 'S'
                   WHERE a.cod_persona = v_usu_sesion.codigoEmpresa
                     AND a.cod_per_vinculo = p_cod_operador
                     AND a.tipo = v_vinculo;
               END IF;
               v_mensaje := fug_obt_pardinamico('MSJ_EMA_APP_STORE');
               IF v_mensaje IS NOT NULL THEN
                  v_res_not := paw_not.fu_env_sms_prueba(v_nro_telefono, v_mensaje, 'PAW_BEl.fu_asi_nro_token');
               END IF;
            EXCEPTION
               WHEN OTHERS THEN
                  paw_uti.pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || PAW_UTI.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
            END;
         ELSE
            paw_uti.pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END IF;
      END IF;

      IF v_retorno.error = 'S' THEN
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), paw_uti.BITACORA_ERROR);
      ELSE
        paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), paw_uti.BITACORA_SALIDA);
      END IF;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_session, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', ERR [' || SQLERRM || ']' ||paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
   END;

  FUNCTION fu_obt_liq_prestamo(p_sesion IN VARCHAR2,
                             p_cod_canal IN VARCHAR2,
                             p_nro_cuenta IN VARCHAR2) RETURN typ_infoLiquidacionPrestamo IS
    v_sesion      typ_validarsesion;
    v_retorno     typ_infoLiquidacionPrestamo := typ_infoLiquidacionPrestamo();
    v_cod_operacion  VARCHAR2(3) := '031'; -- ver que codigo se va a usar
    v_mensajeCaja    typ_mensajeCaja;
    v_permiso        typ_obtenerPermisos;
  BEGIN
    v_sesion := fu_validarSesion(p_sesion, p_cod_canal);
    IF v_sesion.error = 'S' THEN
       v_retorno.error := v_sesion.error;
       v_retorno.nombreRespuesta := v_sesion.nombreRespuesta;
       v_retorno.descripcionRespuesta := v_sesion.descripcionRespuesta;
       RETURN v_retorno;
    END IF;

    -- validar la caja
    v_mensajeCaja := lf_val_caja(v_sesion);
    IF v_mensajeCaja.error = 'S' THEN
       v_retorno.error                := v_mensajeCaja.error;
       v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
       v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
       RETURN v_retorno;
    END IF;
    -- validar permiso para realizar operacion
    v_permiso := lf_obt_permisos(v_sesion, v_cod_operacion);
    IF (v_permiso.error = 'S') THEN
       v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
       v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
       v_retorno.error                := v_permiso.error;
       paw_uti.pr_insertarBitacora(nvl(v_sesion.codigoEmpresa, v_sesion.codigoPersona), p_cod_canal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
       RETURN v_retorno;
    END IF;
    -- se verifica que tenga permiso para consultar
    IF v_permiso.consulta = FALSE AND instr(v_tip_mensaje, 'C') > 0 THEN
       paw_uti.pr_mensajeUsuario('P_OP_NO_PERM', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       paw_uti.pr_insertarBitacora(v_sesion.codigoPersona, p_cod_canal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
       RETURN v_retorno;
    END IF;

    paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
    paw_uti.pr_insertarBitacora(v_sesion.codigoPersona, p_cod_canal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, SQLERRM, paw_uti.BITACORA_ENTRADA);

    v_retorno := PAW_BAS.fu_obt_liq_prestamo(nvl(v_sesion.codigoEmpresa, v_sesion.codigoPersona), p_nro_cuenta);
    IF v_retorno.error = 'S' THEN
       paw_uti.pr_insertarBitacora(v_sesion.codigoPersona, p_cod_canal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
    ELSE
       paw_uti.pr_insertarBitacora(v_sesion.codigoPersona, p_cod_canal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);
    END IF;
    RETURN v_retorno;
  EXCEPTION
     WHEN OTHERS THEN
        paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        paw_uti.pr_insertarBitacora(v_sesion.codigoPersona, p_cod_canal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, SQLERRM, paw_uti.BITACORA_ERROR);
        RETURN v_retorno;
  END;

  FUNCTION lf_es_cta_elegible_bancard_qr(p_cod_persona IN ba_personas.cod_persona%TYPE,
                                         p_nro_cuenta  IN ge_cta_clientes.nro_cuenta%TYPE)
    RETURN VARCHAR2 IS
    v_es_elegible VARCHAR2(1) := 'N';

  BEGIN
    select 'S'
      into v_es_elegible
      from ge_cta_clientes cli
     inner join ba_modulos modulo
        on cli.cod_modulo = modulo.cod_modulo
     inner join ge_modalidades modalidad
        on cli.cod_modalidad = modalidad.cod_modalidad
     inner join ge_cuentas cta
        on cli.nro_cuenta = cta.nro_cuenta
     where cta.estado = 'N'
       and cli.relacion in ('P', 'O') -- relacion 'Principal' o 'Firmante individual'
       and cli.cod_persona = p_cod_persona
       and cli.nro_cuenta = p_nro_cuenta;
    RETURN v_es_elegible;

  EXCEPTION
    WHEN OTHERS THEN
      v_es_elegible := 'N';
      RETURN v_es_elegible;
  END;



  FUNCTION fu_val_ventas_qr(p_sesion      IN VARCHAR2,
                            p_cod_canal      IN VARCHAR2,
                            p_cod_persona IN ba_personas.cod_persona%TYPE,
                            p_metodo_pago IN VARCHAR,
                            p_monto       IN NUMBER,
                            p_nro_cuenta  IN VARCHAR2,
                            p_nro_tarjeta IN VARCHAR2 DEFAULT NULL)
    RETURN TYP_PAGOSERVICIOS IS

    v_retorno         TYP_PAGOSERVICIOS := TYP_PAGOSERVICIOS;
    v_usu_sesion      typ_validarsesion;
    v_permiso         typ_obtenerPermisos;
    v_msj_bitacora    VARCHAR2(500);

    v_cod_tip_mensaje BW_TIP_MENSAJES.COD_TIP_MENSAJE%TYPE;

    v_tip_msg_ventas_qr_debit  BW_TIP_MENSAJES.COD_TIP_MENSAJE%TYPE := '092';
    v_tip_msg_ventas_qr_credit BW_TIP_MENSAJES.COD_TIP_MENSAJE%TYPE := '093';

    v_res_limite       VARCHAR2(5) := 'inic';

    v_resLimite        typ_respuestaLimite;

    v_moneda           VARCHAR2(2) := 'GS';

    MSG_CTA_NO_CORRESP CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';
    MSG_CTA_CONJUNTA   CONSTANT VARCHAR2(15) := 'CTA_CONJUNTA';
    CTA_INV_BANC_QR    CONSTANT VARCHAR2(15) := 'CTA_INV_BANC_QR';

    -- utilizado en verificacion de cta. conjunta. Para PF siempre se requiere 0 firma.
    v_can_aut_requeridas NUMBER := 0;

    -- variables OUT en validacion de nro de cuenta

    v_cta_for_debito  VARCHAR2(15); -- Cuenta Debito formateada
    v_error           typ_mensajeRespuesta := typ_mensajeRespuesta;
    v_cod_mon_debito  VARCHAR2(3) := 'GS'; -- Moneda de la cuenta
    v_cod_mod_debito  NUMBER; -- Modulo de la cuenta
    v_cod_mad_debito  NUMBER; -- Modalidad de la cuenta
    v_cod_ofi_debito  NUMBER; -- Oficina de la cuenta
    v_nom_cta_debito  ge_cuentas.denominacion%TYPE; -- Nombre de la cuenta
    v_nro_cta_credito ge_cuentas.nro_cuenta%TYPE := NULL; -- Numero de Cuenta Credito
    p_validarsesion   typ_validarsesion;
    p_mensajecaja     typ_mensajecaja;

  BEGIN

    IF UPPER(p_metodo_pago) = 'DEBIT' THEN
       v_cod_tip_mensaje := v_tip_msg_ventas_qr_debit;
    ELSIF UPPER(p_metodo_pago) = 'CREDIT' THEN
       v_cod_tip_mensaje := v_tip_msg_ventas_qr_credit;
    END IF;

    -- validar sesion del cliente
    v_usu_sesion := fu_validarSesion(p_sesion, p_cod_canal);

    -- registrar en bitacora los datos de entrada
    v_msj_bitacora := 'fu_val_ventas_qr - p_cod_persona:' || p_cod_persona || ', p_metodo_pago:' || p_metodo_pago || ', p_monto:' || p_monto || ', p_nro_cuenta:' || p_nro_cuenta || ', p_nro_tarjeta:' || p_nro_tarjeta;
    paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_cod_canal, p_sesion, v_cod_tip_mensaje, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null), paw_uti.BITACORA_ENTRADA);

    IF v_usu_sesion.error = 'S' THEN
        v_retorno.error                := v_usu_sesion.error;
        v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
        RETURN v_retorno;
    END IF;

      -- control de permiso sobre cod. tip. mensaje
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_tip_mensaje);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_cod_canal, p_sesion, v_cod_tip_mensaje, v_usu_sesion.codigoEmpresa, 'lf_obt_permisos - ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

    -- validamos la cuenta débito

    IF p_metodo_pago = 'debit' THEN

      v_error := lf_val_cta_debito(
                                   p_nro_cuenta,
                                   485, -- TODO mbaez. Esto queda por definir con contabilidad, pero para la validacion se puede utilizar 485 de pago de servicios
                                   p_monto,
                                   v_cod_mon_debito,
                                   v_cod_mod_debito,
                                   v_cod_mad_debito,
                                   v_cod_ofi_debito,
                                   v_cta_for_debito,
                                   v_nom_cta_debito,
                                   v_usu_sesion,
                                   p_mensajecaja);


      IF v_error.error = 'S' THEN
        v_retorno.error                := v_error.error;
        v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
        RETURN v_retorno;
      END IF;
    END IF;

    -- Valida que la cuenta pertenezca al cliente
    IF lf_val_cta_origen(p_nro_cuenta, p_cod_persona) = 'N' THEN
      paw_uti.pr_mensajeUsuario(MSG_CTA_NO_CORRESP,
                                v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta,
                                v_retorno.error);

      paw_uti.pr_insertarBitacora(p_cod_persona,
                                  p_cod_canal,
                                  p_sesion,
                                  v_cod_tip_mensaje,
                                  null,
                                  'NRO DE CUENTA: ' || p_nro_cuenta ||
                                  ' , fu_val_ventas_qr ' ||
                                  paw_bel.fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta,
                                                             null),
                                  BITACORA_ERROR);
      RETURN v_retorno;
    END IF;

    -- Valida que la cuenta no sea conjunta
    IF PAW_BAS.fu_es_conjunta(p_nro_cuenta, v_can_aut_requeridas) = 'S' THEN
      paw_uti.pr_mensajeUsuario(MSG_CTA_CONJUNTA,
                                v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta,
                                v_retorno.error);

      paw_uti.pr_insertarBitacora(p_cod_persona,
                                  p_cod_canal,
                                  p_sesion,
                                  v_cod_tip_mensaje,
                                  null,
                                  paw_bel.fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta,
                                                             null),
                                  BITACORA_ERROR);
      RETURN v_retorno;
    END IF;

    -- Validar que la cuenta sea elegible para pagos via Bancard VentasQR
    IF lf_es_cta_elegible_bancard_qr(p_cod_persona, p_nro_cuenta) = 'N' THEN
      paw_uti.pr_mensajeUsuario(CTA_INV_BANC_QR,
                                v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta,
                                v_retorno.error);

      paw_uti.pr_insertarBitacora(p_cod_persona,
                                  p_cod_canal,
                                  p_sesion,
                                  v_cod_tip_mensaje,
                                  null,
                                  'v_msj_bitacora' || ' ' ||
                                  paw_bel.fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta,
                                                             null),
                                  BITACORA_ERROR);
      RETURN v_retorno;
    END IF;

    -- Verificar limites de cantidad y monto para la operacion y obtener clave necesaria
    v_resLimite := fu_obtenerLimite(v_usu_sesion,
                     v_cod_tip_mensaje,
                     v_usu_sesion.codigoPersona,
                     p_nro_cuenta,
                     'GS',
                     null,
                     null,
                     p_monto,
                     'V');

     IF v_resLimite.error = 'S' THEN
        v_retorno.error := v_resLimite.error;
        v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
        pr_insertarBitacora(v_usu_sesion.codigoPersona, p_cod_canal, p_sesion, v_cod_tip_mensaje, v_usu_sesion.codigoPersona, 'fu_obtenerLimite - '||v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
        RETURN v_retorno;
     END IF;

    -- validaciones superadas

    v_retorno.error           := 'N'; -- TODO mbaez. Esto está bien? hardcodear N?
    v_retorno.respuestaLimite := v_resLimite.codRespuesta;

    -- registrar resultado final
    paw_uti.pr_insertarBitacora(p_cod_persona,
                                p_cod_canal,
                                p_sesion,
                                v_cod_tip_mensaje,
                                null,
                                'fu_val_ventas_qr - Limite: ' ||
                                v_resLimite.codRespuesta || ' - ' ||
                                paw_uti.fu_generarBitacora(v_retorno.error,
                                                           v_retorno.nombreRespuesta,
                                                           v_retorno.descripcionRespuesta,
                                                           null),
                                BITACORA_SALIDA);

    RETURN v_retorno;

  EXCEPTION
    WHEN OTHERS THEN
      paw_uti.pr_mensajeUsuario('PAC_OTR_ERROR',
                                v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta,
                                v_retorno.error);

      paw_uti.pr_insertarBitacora(p_cod_persona,
                                  p_cod_canal,
                                  p_sesion,
                                  v_cod_tip_mensaje,
                                  null,
                                  'ERROR NO CONTROLADO. ORA-ERR: [' ||
                                  substr(SQLERRM, 1, 250) || '] ' ||
                                  paw_uti.fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta,
                                                             null),
                                  BITACORA_ERROR);
      RETURN v_retorno;
  END;

    FUNCTION fu_con_ventas_qr(
                            p_cod_persona IN ba_personas.cod_persona%TYPE,
                            p_metodo_pago IN VARCHAR,
                            p_monto       IN NUMBER,
                            p_nro_cuenta  IN VARCHAR2,
                            p_nro_tarjeta IN VARCHAR2,
                            p_nro_operacion IN VARCHAR2,
                            p_nro_cuotas IN NUMBER,
                            p_fecha IN DATE,
                            p_descripcion IN VARCHAR2,
                            p_ext_ticket IN VARCHAR2,
                            p_ext_cod_autorizacion IN VARCHAR2,
                            p_comercio IN VARCHAR2,
                            p_sucursal IN VARCHAR2,
                            p_estado IN VARCHAR2)
    RETURN typ_mapa IS

    v_retorno           typ_mapa := typ_mapa();
    v_datAdicionales typ_listaClaveValor := typ_listaClaveValor();
    v_cod_canal         VARCHAR2(3) := '994';
    v_result         VARCHAR2(10) := '0';
    v_nro_documento    ge_movimientos.nro_documento%TYPE;
    v_cod_tip_mensaje BW_TIP_MENSAJES.COD_TIP_MENSAJE%TYPE;
    v_tip_msg_ventas_qr_debit  BW_TIP_MENSAJES.COD_TIP_MENSAJE%TYPE := '092';
    v_tip_msg_ventas_qr_credit BW_TIP_MENSAJES.COD_TIP_MENSAJE%TYPE := '093';
    v_cabecera   VARCHAR2(700)  := NULL;
    v_detalle    VARCHAR2(3300) := NULL;
    v_pie        VARCHAR2(500)  := NULL;
    v_tag        VARCHAR2(50);
    v_nombre     VARCHAR2(100);

  BEGIN

    paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK,
                                v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta,
                                v_retorno.error);

    paw_uti.pr_insertarBitacora(p_cod_persona,
                                v_cod_canal,
                                null,
                                '0',
                                null,
                                'fu_con_ventas_qr: [p_cod_persona=' || p_cod_persona ||'][p_nro_operacion=' || p_nro_operacion || ']',
                                paw_uti.BITACORA_ENTRADA);
    IF UPPER(p_metodo_pago) = 'DEBIT' THEN
       v_cod_tip_mensaje := v_tip_msg_ventas_qr_debit;
    ELSIF UPPER(p_metodo_pago) = 'CREDIT' THEN
       v_cod_tip_mensaje := v_tip_msg_ventas_qr_credit;
    END IF;
    -- registro del movimiento
    select s_nro_documento.nextval into v_nro_documento from dual;
    lp_reg_operacion(p_nro_cuenta, 'GS' , p_monto, NULL /*p_nro_cta_contra*/,
                      NULL, -- cantidad
                      'comercio', -- etiqueta
                      SUBSTR(p_comercio || '|' ||p_sucursal, 1, 50), -- dato. limitar longitud a 50 caracteres
                      NULL, NULL,
                      'Yaguarete-QR '|| p_metodo_pago, NULL, NULL, p_cod_persona, v_cod_tip_mensaje, v_nro_documento, v_cod_canal, '--', null);

  v_nombre :=  fue_obt_nom_persona(p_cod_persona);

  -- ---------- cabecera --------------
        v_cabecera :=
              -- inicio div
              paw_pro.fu_not_inicio ||
              -- titulo
              paw_pro.fu_not_titulo(UTL_URL.ESCAPE('AVISO DE PAGOS QR', TRUE, 'UTF-8'));
        -- subtitulo
        v_cabecera := v_cabecera ||
        paw_pro.fu_not_sub_titulo(UTL_URL.ESCAPE('Estimado Cliente, se realizó la siguiente operación de Pago vía QR.', TRUE, 'UTF-8'));
        v_cabecera := v_cabecera ||
              -- inicio tabla
              paw_pro.fu_not_ini_tabla ||
              -- inicio tbody
              paw_pro.fu_not_ini_tab_cuerpo;
        -- ---------- pie --------------
        -- fin tabla, fin div
        v_pie :=
              -- fin tbody
              paw_pro.fu_not_fin_tab_cuerpo ||
              -- fin table
              paw_pro.fu_not_fin_tabla;
        -- detalles
        v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Nombre del Cliente', TRUE, 'UTF-8'), v_nombre);
        IF p_metodo_pago = 'debit' then
        v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Nro. Cuenta Débito', TRUE, 'UTF-8'), p_nro_cuenta);
        end if;
        IF p_metodo_pago = 'credit' then
           v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Nro. Tarjeta Crédito', TRUE, 'UTF-8'), p_nro_tarjeta);
        end if;
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('Monto', to_char((p_monto), '999G999G999G999G999'));
        IF p_nro_cuotas is not null AND p_nro_cuotas > 0 THEN
           v_detalle := v_detalle || paw_pro.fu_not_row_tag('Cuotas', to_char((p_nro_cuotas)));
        end if;
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('Fecha'||v_tag, to_char(p_fecha, 'dd/mm/yyyy HH24:MI'));
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('Nro. Comprobante', p_nro_operacion);
        v_detalle := v_detalle || paw_pro.fu_not_row_tag('Comercio', UTL_URL.ESCAPE(p_comercio, TRUE, 'UTF-8'));
        IF p_sucursal is not null THEN
              v_detalle := v_detalle || paw_pro.fu_not_row_tag('Sucursal', UTL_URL.ESCAPE(p_sucursal, TRUE, 'UTF-8'));
        end if;
        IF p_descripcion is not null THEN
              v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Descripción', TRUE, 'UTF-8'), UTL_URL.ESCAPE(p_descripcion, TRUE, 'UTF-8'));
        end if;
        v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Ticket Bancard', TRUE, 'UTF-8'), p_ext_ticket);
        v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Autorización Bancard', TRUE, 'UTF-8'), p_ext_cod_autorizacion);
        -- fin div

        --envio de las notificaciones
        v_result := PAW_not.fu_not_pag_ban_qr(p_cod_persona,
                                          v_cabecera || v_detalle || v_pie,
                                          p_metodo_pago,
                                          p_monto,
                                          p_nro_cuenta,
                                          p_nro_tarjeta,
                                          p_comercio,
                                          p_fecha,
                                          p_estado
                                          );

        PAW_UTI.pr_add_value(v_datAdicionales, 'RESULT_NOTIF', v_result, 'VARCHAR');

         v_retorno.cantidad := v_datAdicionales.Count;
         v_retorno.datosAdicionales := v_datAdicionales;

        paw_uti.pr_insertarBitacora(p_cod_persona,
                            v_cod_canal,
                            null,
                            '0',
                            null,
                            'fu_con_ventas_qr, [p_cod_persona=' || p_cod_persona ||'][p_nro_operacion=' || p_nro_operacion || '][mail_cliente=' || p_fecha || '][res=' || v_result || ']' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null),
                            paw_uti.BITACORA_SALIDA);
    RETURN v_retorno;
  EXCEPTION
    WHEN OTHERS THEN
        paw_uti.pr_insertarBitacora(p_cod_persona,
                                    v_cod_canal,
                                    null,
                                    '0',
                                    null,
                                    'Error fu_con_ventas_qr: [p_cod_persona=' || p_cod_persona ||'][p_nro_operacion=' || p_nro_operacion || '] ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '|| paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null),
                                    paw_uti.BITACORA_ERROR);

        paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      RETURN v_retorno;
  END;

    FUNCTION fu_obtenerTarjetasCanceladas(p_sesion              IN VARCHAR2,
                                     p_codCanal            IN VARCHAR2,
                                     p_nroCuentaEspecifica IN VARCHAR2 DEFAULT NULL) RETURN typ_obtenerDetalleCuentas IS

      COD_OPERACION  VARCHAR2(3) := '020';
      userInfo       typ_validarSesion;
      v_permiso      typ_obtenerPermisos;
      v_retorno      typ_obtenerDetalleCuentas := typ_obtenerDetalleCuentas;
      v_logmessage   VARCHAR(1000);
   BEGIN

      -- 0. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parámetros
      v_logMessage := substr('obtenerTarjetasCanceladas(nroCuentaEspecifica=' || p_nroCuentaEspecifica || ')',0,999);
      paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, paw_uti.BITACORA_ENTRADA);

      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- control de permisos
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         paw_uti.pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userinfo.codigoEmpresa, 'lf_obt_permisos - ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --llamamos a paw_can
      v_retorno := paw_can.fu_ns_obtenerCuentascancel(userinfo.codigoPersona,userinfo.codigoEmpresa,p_codCanal,p_nroCuentaEspecifica, p_sesion);
      paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, paw_uti.BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obtenerDetalleCuentas -' || SQLERRM, paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
   END;
 
 -- validacion o confirmacion de transferencia entre cuentas de diferentes titulares
FUNCTION fu_transferenciaGnb(p_sesion             IN VARCHAR2,
                             p_codCanal           IN VARCHAR2,
                             p_nroCtaDebito       IN VARCHAR2,
                             p_montoCredito       IN NUMBER,
                             p_nroCtaCredito      IN VARCHAR2,
                             p_codMonCredito      IN VARCHAR2,
                             p_modo               IN VARCHAR2,
                             p_nroDocCredito      IN VARCHAR2,
                             p_concepto           IN VARCHAR2,
                             p_nroContrato        IN NUMBER,
                             p_nombreBeneficiario IN VARCHAR2,
                             p_claveTransaccional IN VARCHAR2,
                             p_claveToken         IN VARCHAR2) RETURN typ_transferenciaban IS
   TRA_CTA_CRE_DEB_IGUAL     CONSTANT VARCHAR2(15) := 'CTA_CRE_DEB_IGU';
   TRA_CTA_DEB_INVALIDA      CONSTANT VARCHAR2(15) := 'CTA_DEB_INVALID';
   TRA_CTA_CRE_INVALIDA      CONSTANT VARCHAR2(15) := 'CTA_CRE_INVALID';
   TRA_CTA_CRE_DOC_INVA      CONSTANT VARCHAR2(15) := 'CTA_CRE_DOC_INV';
   TRA_MOV_PEND_AUTORIZACION CONSTANT VARCHAR2(15) := 'TRA_MOV_PEND_AU';
   TRA_CTA_CRE_NO_ENCONTRADA CONSTANT VARCHAR2(15) := 'CTA_CRE_NO_ENCO';
   TRA_CTA_CRE_DUPLICADA     CONSTANT VARCHAR2(15) := 'CTA_CRE_DUPLICA';
   TRT_TRA_INVALIDA          CONSTANT VARCHAR2(15) := 'TRP_TRA_INVALID';
   TRT_SIN_PERMISO           CONSTANT VARCHAR2(15) := 'TRT_SIN_PERMISO';
   MSG_HORA_INVA             CONSTANT VARCHAR2(15) := 'HORA_INVA';   -- horario cambio pre pacatado invalido
   MSG_CONCAM_INVA           CONSTANT VARCHAR2(15) := 'CONCAM_INVA'; -- contrato de Cambio invalido
   MSG_ERR_CONVERS           CONSTANT VARCHAR2(15) := 'ERR_CONVERS'; -- Error de conversion
   MSG_MTO_INVALIDO          CONSTANT VARCHAR2(15) := 'MTO_INVALIDO'; -- Monto invalido

   -- datos recibidos
   v_nro_cta_debito  ge_cuentas.nro_cuenta%TYPE;
   v_mto_debito      ge_movimientos.monto%TYPE; -- monto a transferir
   v_nro_cta_credito VARCHAR2(17); -- cuenta de credito
   v_modo            VARCHAR2(1); -- modo V-validacion o C-confirmacion
   -- variables
   v_cta_for_debito VARCHAR2(17); -- cuenta formateada
   v_cod_mon_debito ge_cuentas.cod_moneda%TYPE;
   v_cod_mod_debito ge_cuentas.cod_modulo%TYPE;
   v_cod_mad_debito ge_cuentas.cod_modalidad%TYPE;
   v_cod_ofi_debito ge_cuentas.cod_oficina%TYPE;
   v_den_cta_debito ge_modalidades.descripcion%TYPE; -- denominacion cta debito
   v_cot_debito     ge_movimientos.cotizacion%TYPE := NULL;
   v_nom_cta_debito ge_cuentas.denominacion%TYPE;

   v_cod_mon_credito ge_cuentas.cod_moneda%TYPE; -- moneda de la cuenta
   v_mto_credito     ge_movimientos.monto%TYPE := p_montoCredito;
   v_cot_credito     ge_movimientos.cotizacion%TYPE := NULL;
   v_mto_equ_local   ge_movimientos.mto_equ_local%TYPE := NULL;

   v_cod_tra_padre   ge_transacciones.cod_transaccion%TYPE := 411;
   v_nro_documento   bw_mov_pendientes.nro_documento%TYPE;
   v_nro_doc_credito ba_personas.nro_documento%TYPE := NULL; -- nro de documento del acreditado
   v_concepto        ge_movimientos.concepto%TYPE;
   v_resLimite       typ_respuestaLimite;
   v_permiso         typ_obtenerPermisos;
   --
   v_retorno         typ_transferenciaban := typ_transferenciaban;
   v_cod_operacion   bw_tip_mensajes.cod_tip_mensaje%TYPE := '055';
   retValidarSesion  typ_validarSesion;
   retError          typ_mensajeRespuesta := typ_mensajeRespuesta;
   v_mensajeCaja     typ_mensajeCaja;
   v_nro_operacion   ge_movimientos.nro_documento%TYPE; -- nro unico de operacion generado por el cliente
   v_cod_persona     ge_clientes.cod_persona%TYPE; -- codigo de cliente empresa o persona
   -- para lp_ver_operacion
   v_horario          VARCHAR2(1);
   v_es_mov_noc       VARCHAR2(1);
   v_es_cta_noc       VARCHAR2(1);
   v_fec_actual       DATE;
   v_cod_respuesta    NUMBER;
   v_des_pendiente    bw_mov_pendientes.descripcion%TYPE;
   v_error            VARCHAR2(2000);
   --
   v_nro_ope_cambio   NUMBER(15); -- nro operacion de cambio
   v_nro_con_cambio   NUMBER(7) := nvl(p_nroContrato, 0); -- contrato cambio pre pactado
   v_nom_beneficiario VARCHAR2(60);
   v_msj_bitacora     VARCHAR2(1000) := substr('ctaDebito:'||trim(p_nroCtaDebito)
                                                       ||', mto:'||v_mto_credito
                                                       ||', ctaCredito:'||trim(p_nroCtaCredito)
                                                       ||', modo:'||trim(p_modo)
                                                       ||', nroDocCredito:'||trim(p_nroDocCredito)
                                                       ||', cpto:'||depurarTextos(p_concepto, 35)
                                                       ||', nroContrato:' || nvl(p_nroContrato, 0)
                                                       ||', monCtaCred:' || nvl(p_codMonCredito, ''), 1, 200);
BEGIN
   --valido la sesión del cliente
   retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);
   IF retValidarSesion.error = 'S' THEN
      v_retorno.error                := retValidarSesion.error;
      v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      RETURN v_retorno;
   END IF;
   -- validamos la caja
   v_mensajeCaja := lf_val_caja(retValidarSesion);
   IF v_mensajeCaja.error = 'S' THEN
      v_retorno.error                := v_mensajeCaja.error;
      v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
      RETURN v_retorno;
   END IF;

   v_modo             := NVL( SUBSTR(p_modo,0,1), 'x');
   v_nom_beneficiario := paw_uti.depurarTextos(p_nombreBeneficiario, 100);
   IF nvl(p_modo, 'x') = 'A' THEN
      IF g_aut_operacion = FALSE THEN
         paw_uti.pr_mensajeUsuario(TRT_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '||paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
   ELSE
      -- controlamos los permisos
      IF nvl(p_modo, 'x') <> 'VC' THEN
         v_permiso := lf_obt_permisos(retValidarSesion, v_cod_operacion);
         IF (v_permiso.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
            v_retorno.error                := v_permiso.error;
            paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- se verifica que posea permiso para registrar
         IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
            paw_uti.pr_mensajeUsuario(TRT_SIN_PERMISO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '||paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      ELSE
         v_can_aut_requeridas := 1;
      END IF;
   END IF;

   paw_uti.pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
   paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '|| paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), paw_uti.BITACORA_ENTRADA);

   -- 0. inicializo la secuencia
   v_nro_cta_credito := depurarAlfanumerico(p_nroCtaCredito, CUENTA_TAMANO);
   v_nro_cta_debito  := depurarAlfanumerico(p_nroCtaDebito, CUENTA_TAMANO);
   v_cod_persona     := NVL(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);

   -- nro de documento del acreditado
   IF p_nroDocCredito IS NOT NULL THEN
      v_nro_doc_credito := depurarTextos(p_nroDocCredito, 20);
   ELSE
      paw_uti.pr_mensajeUsuario(TRA_CTA_CRE_DOC_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
      RETURN v_retorno;
   END IF;

   IF p_concepto IS NOT NULL THEN
      v_concepto := depurarTextos(p_concepto, 35);
   END IF;

   IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
      -- se confirma directamente la operacion, porque no requiere autorizacion
      v_modo := 'A'; -- CONFIRMACION
   END IF;

   -- 2. busco los datos de la cuentas
   IF v_retorno.error = 'N' THEN
      -- verifico cuenta de debito
      IF v_nro_cta_debito = v_nro_cta_credito THEN
         paw_uti.pr_mensajeUsuario(TRA_CTA_CRE_DEB_IGUAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora|| ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- obtenemos la cuenta debito
      BEGIN
         SELECT c.cod_moneda
           INTO v_cod_mon_debito
           FROM ge_cuentas c
          WHERE c.nro_cuenta = v_nro_cta_debito;
      EXCEPTION
         WHEN OTHERS THEN
            paw_uti.pr_mensajeUsuario(TRA_CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora|| ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
      END;

      IF v_retorno.error = 'N' THEN
         -- cuenta de credito
         BEGIN
            
            v_cod_mon_credito := p_codMonCredito;

            IF v_cod_mon_credito <> v_cod_mon_debito THEN
               IF v_nro_con_cambio <> 0 THEN -- con contrato pre pactado
                  v_cod_respuesta := paw_bas.fu_val_contrato(
                           v_cod_mon_debito, v_cod_mon_credito, v_nro_con_cambio, v_cod_persona, 45, v_nro_doc_credito,
                           v_nro_ope_cambio, v_mto_debito, v_mto_credito, v_cot_debito, v_cot_credito, v_mto_equ_local,
                           v_retorno.tipOperacion);
                  v_msj_bitacora := v_msj_bitacora || ', mtoCon:' || v_mto_debito || ', mtoCreCon:'|| v_mto_credito;
                  CASE v_cod_respuesta
                     WHEN 0 THEN
                        NULL;
                     WHEN -1 THEN
                        paw_uti.pr_mensajeUsuario(MSG_HORA_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     ELSE
                        paw_uti.pr_mensajeUsuario(MSG_CONCAM_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  END CASE;

                  IF v_cod_respuesta <> 0 THEN
                     paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' - ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;
               ELSE -- sin cambio pre practado
                  BEGIN
                     pr_con_mon_a_moneda(v_cod_mon_credito,
                                         v_cod_mon_debito,
                                         v_mto_credito,
                                         v_mto_debito,
                                         v_cot_credito,
                                         v_cot_debito,
                                         'S');-- aunque no sea transferencia sipap necesitamos que se comporte como tal
                  EXCEPTION
                     WHEN OTHERS THEN
                        paw_uti.pr_mensajeUsuario(MSG_ERR_CONVERS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' - ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
                        RETURN v_retorno;
                  END;
               END IF;
            ELSE
              v_mto_debito := v_mto_credito;
            END IF;
            v_msj_bitacora := v_msj_bitacora||', mto_deb:'||v_mto_debito;
            IF v_mto_credito <= 0 OR v_mto_debito <= 0 THEN
               paw_uti.pr_mensajeUsuario(MSG_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' - ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
            -- se valida el monto debito contra la cuenta debito
            retError := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_mto_debito, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, retValidarSesion, v_mensajeCaja);

            IF retError.error = 'S' THEN
               v_retorno.error                := retError.error;
               v_retorno.nombreRespuesta      := retError.nombreRespuesta;
               v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
               paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_debito - ' || v_msj_bitacora||' '|| paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
            IF v_retorno.error = 'N' THEN
               IF lf_val_cta_origen(v_nro_cta_debito, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)) = 'N' THEN
                  -- no es una cuenta del cliente
                  paw_uti.pr_mensajeUsuario(TRA_CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_origen(ctaDeb) - ' || v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
               ELSE
                  v_den_cta_debito := fug_obt_des_modal(v_cod_mod_debito, v_cod_mad_debito);
               END IF;
            END IF;

            IF v_retorno.error = 'N' THEN
               -- valido la duplicacion de transferencias
               DECLARE
                  v_existe VARCHAR2(1);
               BEGIN
                  -- si se autoriza desde EMA, puede ser una autorizacion multiple con mismo monto debito y cuenta,
                  -- no es necesario controlar duplicado en ese caso porque hubo una validacion previa en la carga
                  IF nvl(p_modo, 'x') <> 'A' OR fuw_obt_mov_pen_encolado(retValidarSesion.codigoEmpresa, v_cod_operacion, v_nro_cta_debito, v_mto_debito, v_nro_cta_credito) <> 'S' THEN

                     BEGIN
                        SELECT 'S'
                          INTO v_existe
                          FROM bw_mov_pendientes
                         WHERE cod_per_principal = retValidarSesion.codigoEmpresa
                           AND nro_cuenta = v_nro_cta_debito
                           AND monto = v_mto_debito
                           AND estado = 'P'
                           AND cod_tip_mensaje = v_cod_operacion
                           AND nro_cta_contra = v_nro_cta_credito
                           AND trunc(fec_insercion) = trunc(SYSDATE)
                           AND rownum = 1;
                     EXCEPTION
                        WHEN too_many_rows THEN
                           v_existe := 'S';
                        WHEN OTHERS THEN
                           v_existe := 'N';
                     END;

                     IF v_existe = 'N' THEN
                        retError := fu_ver_transaccion(503, v_cod_tra_padre, v_nro_cta_debito, v_mto_debito, v_mensajeCaja);
                        IF retError.error = 'S' THEN
                           v_retorno.error                := retError.error;
                           v_retorno.nombreRespuesta      := retError.nombreRespuesta;
                           v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                           paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                            RETURN v_retorno;
                        END IF;
                     ELSE
                        IF p_modo <> 'VC' THEN  -- modo verificar cotizacion, para actualizar cotizacion en autorizar operacion, no debe dar error por duplicado
                           paw_uti.pr_mensajeUsuario(TRA_MOV_PEND_AUTORIZACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                           RETURN v_retorno;
                        END IF;
                     END IF;
                  END IF;
               END;
            END IF;
         EXCEPTION
            WHEN no_data_found THEN
               paw_uti.pr_mensajeUsuario(TRA_CTA_CRE_NO_ENCONTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            WHEN too_many_rows THEN
               paw_uti.pr_mensajeUsuario(TRA_CTA_CRE_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            WHEN OTHERS THEN
               paw_uti.pr_mensajeUsuario(TRA_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         END;
         -- se agrega control de límite de operaciones
         IF v_retorno.error = 'N' THEN
            IF v_modo in ('C', 'V', 'A') AND nvl(p_modo,'x') <> 'A' THEN
               IF nvl(p_modo,'x') <> 'VC' THEN
                  v_resLimite := fu_obtenerLimite(retValidarSesion,
                                               v_cod_operacion,
                                               nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                                               v_nro_cta_debito,
                                               v_cod_mon_debito,
                                               503,
                                               v_cod_tra_padre,
                                               v_mto_debito,
                                               v_modo);

                  IF v_resLimite.error = 'S' THEN
                     v_retorno.error := v_resLimite.error;
                     v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                     v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                     paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora ||' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                  END IF;
               END IF;
            END IF;
         END IF;
         -- se validan las claves según respuesta de límites
         IF v_retorno.error = 'N' THEN
           IF nvl(p_modo, 'x') <> 'A' AND v_modo in ('C','A') THEN
             retError.error := 'N';
             DECLARE
               v_lugar VARCHAR2(50);
             BEGIN
               IF v_resLimite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
                  v_lugar  := 'lf_obt_cla_validar - ';
                  retError := lf_obt_cla_validar(p_claveTransaccional, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, 'T');
               END IF;

               IF retError.error = 'N' THEN
                  IF v_resLimite.codRespuesta IN ('01', '11') THEN -- token requerido
                     v_lugar  := 'paw_seg.fu_obt_tok_validar - ';
                     retError := paw_seg.fu_obt_tok_validar(p_claveToken, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, v_modo);
                  END IF;
               END IF;

            IF retError.error = 'S' THEN
               v_retorno.error                := retError.error;
               v_retorno.nombreRespuesta      := retError.nombreRespuesta;
               v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                  paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_lugar || v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
               END IF;
             END;
            END IF;
         END IF;
         v_retorno.nombreCtaDebito  := substr(v_nom_cta_debito, 1, 100);
         IF v_retorno.error = 'N' THEN
            -- no hay problemas hasta aqui
            IF v_modo = 'V' THEN
               -- validacion
               v_retorno.cotizacion       := v_cot_debito;
               v_retorno.cotizacionCredito := v_cot_credito;
               v_retorno.ctaForDebito     := substr(v_cta_for_debito,0, CUENTA_TAMANO);
               v_retorno.codMonDebito     := substr(rpad(v_cod_mon_debito, 3, ' '),0, 3);
               v_retorno.monto            := v_mto_debito;
               v_retorno.ctaForCredito    := v_nro_cta_credito;
               v_retorno.codMonCredito    := substr(rpad(v_cod_mon_credito, 3, ' '),0, 3);
               v_retorno.montoCredito     := v_mto_credito;
               v_retorno.resLimite        := v_resLimite.codRespuesta;
               v_retorno.tipTransferencia := '6';
               v_retorno.tipPedido        := v_modo;
               v_retorno.denominacionCtaDebito := substr(v_den_cta_debito, 1, 50);

               paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', resLim: ' || v_resLimite.codRespuesta || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);

               RETURN v_retorno;
               --
            ELSIF v_modo = 'C' THEN
               IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito AND v_cod_mon_credito = v_cod_mon_local THEN
                  v_mto_equ_local := v_mto_credito;
               ELSE
                  v_mto_equ_local := NULL;
               END IF;
               
               v_des_pendiente := substr(v_concepto, 1, 100);
               IF v_des_pendiente IS NULL THEN 
                  SELECT m.descripcion
                    INTO v_des_pendiente
                    FROM bw_tip_mensajes m
                   WHERE m.cod_tip_mensaje = v_cod_operacion;
               END IF;

              --- inserto el movimiento pendiente de autorizacion
              SELECT s_nro_documento.NEXTVAL
                INTO v_nro_documento
                FROM dual;
               INSERT INTO bw_mov_pendientes
                  (nro_documento, cod_per_principal, fec_hora,
                  cod_tip_mensaje, nro_cuenta, cod_moneda,
                  descripcion, monto, cotizacion,
                  mto_equ_local, nro_cta_contra, estado,
                  can_aut_requeridas, can_aut_faltantes, cod_per_ingreso,
                  mto_contra, cot_contra, etiqueta, 
                  dato, etiqueta2,  dato2, referencia)
               VALUES
                  (v_nro_documento, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), SYSDATE,
                  v_cod_operacion, v_nro_cta_debito,  v_cod_mon_debito,
                  v_des_pendiente, v_mto_debito, v_cot_debito,
                  v_mto_equ_local, v_nro_cta_credito, 'P',
                  v_can_aut_requeridas, v_can_aut_requeridas, retValidarSesion.codigoPersona,
                  v_mto_credito, v_cot_credito, 'Nro.Identificacion',
                  v_nro_doc_credito, 'Mon.Credito', v_cod_mon_credito, v_nro_con_cambio);

               v_retorno.tipPedido         := v_modo;
               v_retorno.cantAutorizadores := v_can_aut_requeridas;
               v_retorno.nroDocumento      := v_nro_documento;
               v_retorno.tipTransferencia  := '6';
               
               -- registro del movimiento
               lp_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/,
                        v_cod_mon_debito /*p_cod_moneda */,
                        v_mto_debito          /*p_monto*/,
                        v_nro_cta_credito /*p_nro_cta_contra*/,
                        NULL              /*p_cantidad*/,
                        NULL /*p_etiqueta*/,
                        v_nro_doc_credito  /*p_dato*/,
                       'Cotizacion'      /*p_etiqueta2*/,
                       v_cot_debito      /*p_dato2*/,
                       'Yaguarete'||v_cot_credito /*observacion*/,
                       NULL          /*direccion IP*/,
                       '000',
                       retValidarSesion.codigopersona,
                       v_cod_operacion,
                       v_nro_documento,
                       p_codcanal,
                       p_sesion,
                       retValidarSesion.codigoempresa,
                       v_nom_beneficiario);

               paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);

               RETURN v_retorno;
            ELSIF v_modo = 'A' THEN
               v_retorno.cotizacion       := v_cot_debito;
               v_retorno.cotizacionCredito := v_cot_credito;
               -- confirmacion de operacion
              -- esta la cuenta en condiciones, verifico el horario
               retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre, v_mensajeCaja.codigoOficinaOrigen, v_fec_actual);
               IF retError.error = 'S' THEN
                  v_retorno.error := retError.error;
                  v_retorno.nombreRespuesta := retError.nombreRespuesta;
                  v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                  paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lp_ver_horario - ' || v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;

               -- genero el numero de operacion
               SELECT s_nro_tra_gnb.NEXTVAL
                 INTO v_nro_operacion
                 FROM dual;
               --
               v_concepto := paw_uti.depurarTextos('Transf. a cta GNB '||v_cod_mon_credito||' '||v_nro_cta_credito||' '||v_nom_beneficiario||'. '||v_concepto, 100);
               retError := paw_bts.fu_pro_cta_debito(v_nro_operacion,
                             v_nro_cta_debito,
                             v_mto_debito,
                             v_mto_credito,
                             v_cod_mon_debito,
                             v_cod_mon_credito,
                             v_cot_debito,
                             v_cot_credito,
                             v_mensajeCaja.codigoUsuario,
                             v_cod_ofi_debito /*v_mensajeCaja.codigoOficinaOrigen*/,
                             v_fec_actual,
                             v_es_mov_noc,
                             v_concepto, -- nom benef
                             v_nro_ope_cambio,
                             v_error);
               IF retError.error = 'S' THEN
                  v_retorno.error := retError.error;
                  v_retorno.nombreRespuesta := retError.nombreRespuesta;
                  v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                  paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'paw_bts.fu_pro_cta_debito - ' || v_msj_bitacora || ', ERR:[' || substr(v_error, 1,500) || '] ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;
               v_retorno.nroDocumento := v_nro_operacion;
               v_retorno.codMonDebito     := substr(rpad(v_cod_mon_debito, 3, ' '),0, 3);
               v_retorno.monto            := v_mto_debito;
               -- registro del movimiento
               lp_reg_operacion(v_nro_cta_debito, v_cod_mon_debito, v_mto_debito, v_nro_cta_credito,
                        NULL, NULL, v_nro_doc_credito, 'Cotizacion', v_cot_debito, 'Yaguarete'||v_cot_credito,
                       NULL, '000', retValidarSesion.codigopersona, v_cod_operacion, v_nro_operacion,
                       p_codcanal, p_sesion, retValidarSesion.codigoempresa, v_nom_beneficiario);
            END IF;
         END IF;
      END IF;
   END IF;

   IF v_retorno.error = 'N' THEN
      paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);
   END IF;

   RETURN v_retorno;
EXCEPTION
   WHEN OTHERS THEN
      paw_uti.pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,  v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '|| paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);                         
      paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      RETURN v_retorno;
END;
-- fin de confirmacion de transferencia entre cuentas GNB Y GNB FUSION
/*
   Fu_transferenciaSipap
   */
   --Inserción de la transferencia -- HA-3690
  PROCEDURE pr_ins_snp_transferencias(p_snp in pas_snp.rg_msj) IS
    PRAGMA AUTONOMOUS_TRANSACTION;
  BEGIN
    pas_snp.pr_ins_transferencias(p_snp);
    COMMIT;
  END;
  --Eliminación de la transferencia
  PROCEDURE pr_del_snp_transferencias(p_nro_referencia in ge_snp_transferencias.nro_referencia%type) IS
    PRAGMA AUTONOMOUS_TRANSACTION;
  BEGIN
    delete from ge_snp_transferencias tra
    where tra.nro_referencia=p_nro_referencia;
    COMMIT;
  EXCEPTION
      WHEN OTHERS THEN
           NULL;
  END;
  
   FUNCTION fu_transferenciaSnp(  p_codigoPersona  IN VARCHAR2,
                                  p_codigoEmpresa  IN VARCHAR2,
                                  p_codigoCanal    IN VARCHAR2,
                                  p_modo           IN VARCHAR2,
                                  p_cuentaDebito   IN VARCHAR2,
                                  p_monedaCredito  IN VARCHAR2,
                                  p_montoCredito   IN NUMBER,
                                  p_fechaOperacion IN VARCHAR2,
                                  p_cargos         IN VARCHAR2,
                                  p_cuentaCredito  IN VARCHAR2,
                                  p_codigoSwift    IN VARCHAR2,
                                  p_documentoCredito   IN VARCHAR2,
                                  p_nombreBeneficiario IN VARCHAR2,
                                  p_direccionBeneficiario IN VARCHAR2,
                                  p_tipoDocBeneficiario   IN VARCHAR2,
                                  p_numeroContrato        IN NUMBER,
                                  p_concepto              IN VARCHAR2,
                                  p_numeroIP              IN VARCHAR2,
                                  p_cotizacion            IN NUMBER,
                                  p_tipoMensaje           IN VARCHAR2,
                                  p_matricula             IN VARCHAR2,
                                  p_motivo                IN VARCHAR2 default null,
                                  p_numeroReferencia      IN NUMBER   default null,
                                  p_claveTransaccional    IN VARCHAR2,
								  p_alias                 IN VARCHAR2 default null) RETURN typ_transferenciasSnp IS

         -- Constantes
        c_cod_operacion      constant varchar2(03) := '036';
        c_fec_invalida       constant varchar2(03) := '137';
        c_tar_invalida       constant varchar2(04) := '265';
        c_cod_mto_invalido   constant varchar2(04) := '121';
        c_fec_inv_cam_moneda constant varchar2(04) := '272';
        c_con_cambio         constant varchar2(04) := '162';
        c_con_moneda         constant varchar2(04) := '203';
        c_lim_excedido       constant varchar2(04) := '273';
        c_con_invalida       constant varchar2(04) := '274';
        c_tra_invalida       constant varchar2(04) := '109';
        c_cod_sin_autorizacion      constant varchar2(3) := '108';
		c_cta_restringida    constant varchar2(5):='143';
        c_sal_insufiente     constant varchar2(04) := '105';
        c_err_env_swift      constant varchar2(04) := '275';
        c_err_hor_cerrado    constant varchar2(04) := '100';
        c_dup_dat_adicionales constant varchar2(04):= '276';
        c_ins_dat_adicionales constant varchar2(04):= '277';
        c_err_mto_max_ach     constant varchar2(04):= '278';
        c_cta_int_invalida    constant varchar2(16) := 'COD_CTA_INVALID';
        MSG_CLA_OPE_INVALIDA   constant varchar2(15) := 'CLA_OPE_INVALID';
        c_op_error              CONSTANT VARCHAR2(15) := 'OP_ERROR';                       
        PRE_MON_LOC_INVALIDA CONSTANT VARCHAR2(15) := 'PRE_MON_LOC_INV';
        v_cod_canal          varchar2(3);
        v_sesion             bw_aut_sesiones.cod_sesion%type;
        userInfo             paw_bel.typ_validarSesion;
        v_permiso            typ_obtenerPermisos;
        v_retorno            typ_transferenciasSnp := typ_transferenciasSnp;
        v_log_mensaje        varchar2(1000);
        retError             typ_mensajeRespuesta := typ_mensajeRespuesta;
        v_ret_val_dup        typ_mensajeCaja;
        v_mensajeCaja        typ_mensajeCaja;
        retObtenerPermisos   paw_bel.typ_obtenerPermisos;
        v_error varchar(1000);


        --Variables Recibidas
        v_nro_cta_debito       varchar2(16);
        v_nro_cta_credito      varchar2(20);   -- cuenta de credito
        v_cod_mon_credito      ge_snp_transferencias.cod_moneda%type;   -- moneda de la transferencia
        v_nro_doc_credito      ba_personas.nro_documento%type := null;  -- nro de documento del acreditado
        v_concepto             ge_movimientos.concepto%type;
        v_cod_swift            ge_snp_transferencias.cod_swi_pte_beneficiario%type;
        v_cargos               varchar2(1) ;
        v_tip_cargos           ge_snp_transferencias.tip_cargo%type;
        v_nom_beneficiario     ge_snp_transferencias.nom_beneficiario%type;
        v_dir_beneficiario     ge_snp_transferencias.dir_beneficiario%type;
        v_tab_relacion         ba_tab_dat_adicionales.tab_relacion%type;
        v_nro_ip               varchar2(20);
        v_fec_operacion        date;
        v_nro_contrato         number(7); -- Nro de Contrato de Cambio
        v_tip_doc_beneficiario ge_snp_transferencias.cod_tip_doc_beneficiario%type;
        v_mto_credito          ge_movimientos.monto%type;  -- Monto de la transferencia
        v_cotizacion           ge_movimientos.monto%type := null;

        v_modo                 varchar2(1);
        v_motivo               varchar2(50) := null;-- motivo de la transferencia
        v_fondo                varchar2(1) := '1';  -- fondo
        v_financia             varchar2(1) := '1';  -- financia

       -- Variables Internas
        v_cta_for_debito      varchar2(17);  -- cuenta formateada
        v_cod_mon_debito      ge_cuentas.cod_moneda%type;   -- moneda de la cuenta
        v_nom_cta_debito      varchar2(100);
        v_cta_pte_solicitante varchar2(20); -- Nro de Cuenta Interbancaria
        v_cta_pte_sol_bcp     varchar2(20);
        v_tip_mensaje         varchar2(1) ; -- C:Transferencia; T:Pago de TC
        v_msj_swift           ge_snp_transferencias.msj_swift%type;
        v_tip_movimiento      varchar2(1) ; -- D:Débito; C: Crédito
        v_cod_mod_debito      number(4);    -- Modulo de la cuenta
        v_cod_mad_debito      number(4);    -- Modalidad de la cuenta
        v_cod_mod_padre       number(4);    -- Modulo Padre
        v_cod_mad_padre       number(4);    -- Modalidad Padre
        v_cod_ofi_debito      number(4);    -- oficina de la cuenta
        v_cot_debito          ge_movimientos.monto%type := null;
        v_mto_debito          ge_movimientos.monto%type;
        v_mto_deb_local       ge_movimientos.monto%type;
        v_cot_deb_local       ge_movimientos.monto%type;
        v_mto_contrato        ge_movimientos.monto%type; -- Monto de Contrato de Cambio
        v_cot_credito         number(18,4) := null;
        v_mto_equ_local       number(18) := null;
        v_cod_tra_padre       ge_movimientos.cod_tra_padre%type    := pas_snp.fu_obt_cod_tra_padre; -- cod. transaccion padre
        v_cod_tra_credito     ge_movimientos.cod_transaccion%type  := 196;     -- cod. transaccion hijo credito
        v_cod_tra_debito      ge_movimientos.cod_transaccion%type  := 503;     -- cod. transaccion hijo debito
        v_nro_documento       number(15);
        v_mto_limite          ge_movimientos.monto%type;  -- monto limite para transferencias
        v_tot_realizado       ge_movimientos.monto%type;
        v_mto_tot_030         ge_movimientos.monto%type;  -- Monto Total para Transferencia Entre Cuentas Normal
        v_nro_referencia      ge_snp_transferencias.nro_referencia%type;
        v_estado              ge_snp_transferencias.estado%type;
        v_situacion           ge_snp_transferencias.situacion%type;
        v_bcp_cod_swift       ge_bancos.cod_swift%type := paw_bel.lf_obt_bco_swift(1);
        v_tie_ctr_duplica     ge_par_dinamicos.val_parametro%type;
        v_cta_bcp_gs_liquidacion  ge_snp_cta_bancos.nro_cta_bancaria%type   := '';
        v_cta_bcp_usd_liquidacion ge_snp_cta_bancos.nro_cta_bancaria%type  := '';
        r_gtran               pas_snp.rg_msj;
        rg_dat_pte            pas_snp.rg_pte := null;
        v_texto               varchar2(4000);
        v_fec_sugerida        date;
        v_fec_actual          date := pag_cal.fu_obt_fec_actual(9);
        v_cod_mon_local       varchar2(3) := pag_gen.fu_obt_mon_local;
        v_mto_lim_web         ge_movimientos.monto%type;
        v_lim_excedido        boolean := false;
        v_cod_per_cumplimiento ba_personas.cod_persona%type;
        v_nro_secuencia        number(3)    := 0;
        v_cod_grupo            number(3)    := 0;--    eli ge_movimientos.cod_grupo%type := 0;
        v_hor_actual           varchar2(08) := to_char(sysdate,'HH24:MI:SS');   -- Hora actual
        v_cod_error            varchar2(20);
        v_cta_formateada       varchar2(17); -- para guardar la cuenta formateada
        v_cot_ori_detecta      ge_cotizaciones.val_compra%type;
        v_cot_des_detecta      ge_cotizaciones.val_compra%type;
        v_claveTransaccional   bw_ope_claves.clave%type;
        v_lugar                VARCHAR2(100);
        v_cotiza               ge_movimientos.monto%type := null;
        v_total                ge_movimientos.monto%type := null;
        v_monto                ge_movimientos.monto%type;
        v_monto_gs             ge_movimientos.monto%type;
        v_horario         VARCHAR2(1) := 'D'; -- Dia normal
        v_es_mov_noc      VARCHAR2(1) := 'N';
        v_es_cta_noc      VARCHAR2(1) := 'N'; -- Graba S/N ctas noctunas
        v_fec_valor          DATE := v_fec_actual;
        v_aler               varchar2(1) := 'N'; --patrocinador
        v_cod_swift_sub      ge_snp_transferencias.cod_swi_suc_beneficiario%type;
        v_cta_sub            ge_snp_transferencias.nro_cta_suc_pte_beneficiario%type;
        v_cta_limite        ge_cuentas.nro_cuenta%type;
        v_nro_cta_pte_beneficiario ge_snp_transferencias.nro_cta_pte_beneficiario%type;
        v_resultado  varchar2(4000);
        v_cod_respuesta number(10);
        v_desc_respuesta varchar2(4000);
        v_concepto_mov       ge_movimientos.concepto%type;
        --DA-7772
        v_mes_sugerida       number(2);
        v_mes_fec_cal        number(2);
        --*/
        v_cod_per            ba_personas.cod_persona%type;
		v_existe             number(10):=0;
        --DA-10340
        v_usu_mov            ba_usuarios.cod_usuario%type;
        v_hor_mov            ge_snp_transferencias.hora%type;
   BEGIN
        pre_cam_for_numerico('.,');
        v_sesion               := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
        v_cod_canal            := paw_bel.depurarAlfanumerico(p_codigoCanal,3);
        v_modo                 := paw_bel.depurarAlfanumerico(p_modo,1);
        v_nro_cta_debito       := paw_bel.depurarCuenta(p_cuentaDebito,CUENTA_TAMANO);
        v_cod_mon_credito      := paw_bel.depurarAlfanumerico(p_monedaCredito,3);
        --JCBM 10/08/24
        --v_mto_credito          := paw_bel.depurarNumerico(p_montoCredito,18);
        v_mto_credito          := paw_bel.depurarNumerico(p_montoCredito,18,'S');
        v_monto                := paw_bel.depurarNumerico(p_montoCredito,18);
        v_fec_operacion        := to_date(paw_bel.depurarAlfanumerico(p_fechaOperacion,8),'ddmmyyyy');
        v_cargos               := paw_bel.depurarAlfanumerico(p_cargos,1);
        v_nro_cta_credito      := paw_bel.depurarAlfanumerico(p_cuentaCredito,20);
		v_alias                := paw_bel.depurarAlfanumerico(p_alias,50);
        --v_cod_swift            := paw_bel.depurarAlfanumerico(p_codigoSwift,8);
        --- HA-2375 --DA-7388
        --v_nro_doc_credito      := paw_bel.depurarAlfanumerico(p_documentoCredito,20);
        IF p_tipoDocBeneficiario = 6 AND instr(p_documentoCredito,'-') != 0 then
          v_nro_doc_credito    := p_documentoCredito;
        ELSE
        v_nro_doc_credito      := paw_bel.depurarAlfanumerico(p_documentoCredito,20);
        END IF;
        ---
        v_nom_beneficiario     := paw_bel.depurarTextos(p_nombreBeneficiario,100);
        v_dir_beneficiario     := paw_bel.depurarAlfanumerico(p_direccionBeneficiario,100);
        v_nro_contrato         := paw_bel.depurarNumerico(p_numeroContrato,7);
        v_tip_doc_beneficiario := paw_bel.depurarNumerico(p_tipoDocBeneficiario,3);
        v_concepto             := paw_bel.depurarAlfanumerico(p_concepto,30);
        v_motivo               := paw_bel.depurarAlfanumerico(p_motivo,50);
        v_cotizacion           := paw_bel.depurarNumerico(p_cotizacion,18);
        v_tip_mensaje          := paw_bel.depurarAlfanumerico(p_tipoMensaje,1);
        v_nro_ip               := paw_bel.depurarAlfanumerico(p_numeroIP,20);
        v_cta_bcp_gs_liquidacion  := pas_snp.fu_obt_cta_ban_participante(v_bcp_cod_swift,pag_gen.FU_OBT_MON_LOCAL);
        v_cta_bcp_usd_liquidacion := pas_snp.fu_obt_cta_ban_participante(v_bcp_cod_swift,pag_gen.FU_OBT_MON_FUERTE);
        v_claveTransaccional  := trim(p_clavetransaccional);
        v_patrocinador        :='N'; --DA-7221


		    --TRFS-1112
        /* Validacion de moneda local con decimales */
    		IF p_monedaCredito = v_cod_mon_local AND paw_bel.depurarNumerico(p_montoCredito,18) <> v_mto_credito THEN
		       pr_mensajeUsuario(PRE_MON_LOC_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(p_codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) , BITACORA_ERROR);
           RETURN v_retorno;
        END IF;


        /* Obtiene la informacion de parámetros recibos y el return del type */
        paw_log.g_typ_transferenciasSnp := v_retorno;
        paw_log.pr_logValoresTypes('typ_transferenciasSnp',
        'fu_transferenciaSnp'||' '||p_codigoCanal  ||', '|| p_modo||', '||  p_cuentaDebito||', '||
        p_monedaCredito||', '|| p_montoCredito||', '|| p_fechaOperacion ||', '||
        p_cargos||', '|| p_cuentaCredito||', '||
        p_codigoSwift||', '|| p_documentoCredito||', '|| p_nombreBeneficiario||', '||
        p_direccionBeneficiario ||', '|| p_tipoDocBeneficiario   ||', '|| p_numeroContrato ||', '||
        p_concepto ||', '|| p_numeroIP   ||', '||  p_cotizacion ||', '||
        p_tipoMensaje ||', '|| p_matricula   ||', '||   p_motivo ||', '||p_numeroReferencia
            );
         --DA-7815 
        if v_nom_beneficiario is null then
           v_cod_per:=fue_obt_cod_persona_doc(v_tip_doc_beneficiario,v_nro_doc_credito); 
           if v_cod_per is null then
             v_nom_beneficiario:='NOMBRE DEL CLIENTE';
           else
             v_nom_beneficiario:=nvl(fue_obt_nom_persona(v_cod_per),'NOMBRE DEL CLIENTE');
           end if;
        end if;
        ------------------------------------
        -- Viene de Autorizacion y asigno los valores
       if nvl(p_modo,'X') = 'A' then
          v_nro_referencia      := p_numeroreferencia ;
       end if;

       prg_cre_savepoint('sipap');

       userInfo.error:='N';
       userInfo.codigoCanal:=v_cod_canal;
       userInfo.codigoPersona:=p_codigoPersona;
       userInfo.codigoEmpresa:=p_codigoEmpresa;
    --verificar permisos

    v_permiso := lf_obt_permisos(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona), userInfo.codigoPerfil, c_cod_operacion, v_cod_canal);
    IF v_permiso.error = 'S' THEN
       pr_mensajeUsuario(c_cod_sin_autorizacion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) , BITACORA_ERROR);
       RETURN v_retorno;
    END IF;
    --
    IF v_modo in('V','C') then
       IF v_permiso.registra = FALSE  THEN
           pr_mensajeUsuario(c_cod_sin_autorizacion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) , BITACORA_ERROR);
           RETURN v_retorno;
       end if;
    end if;
    IF v_modo in('A') then
       IF v_permiso.autoriza = FALSE  THEN
           pr_mensajeUsuario(c_cod_sin_autorizacion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) , BITACORA_ERROR);
           RETURN v_retorno;
       end if;
    end if;

         --Valido la clave transaccional en modo confirmacion
     /*
     Crear un parametro para activar la transacional
     IF nvl(v_modo, 'x') = 'C'  then
       If v_claveTransaccional is null then
           pr_mensajeUsuario(MSG_CLA_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) , BITACORA_ERROR);
           --Obtiene la informacion de parámetros recibos y el return del type 
            paw_log.g_typ_transferenciasSnp := v_retorno;
            paw_log.pr_logValoresTypes('typ_transferenciasSnp',
            'Transaferencia SNP '||' '||v_sesion||', '|| v_cod_canal||', '||  v_nro_cta_debito||', '||
            v_nro_cta_credito||', '|| v_cod_swift||', '|| v_mto_credito||', '||
            p_modo);
          RETURN v_retorno;

       end if;
       null;
     end if;

     IF (v_modo in ('C','A') AND p_claveTransaccional IS NOT NULL) THEN
        v_lugar  := 'lf_obt_cla_validar: ';
        retError := lf_obt_cla_validar(v_claveTransaccional, userInfo.codigoPersona, userInfo.codigoEmpresa,'T');
      END IF;

      IF retError.error = 'S' THEN
        v_retorno.error := retError.error;
        v_retorno.nombreRespuesta := retError.nombreRespuesta;
        v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
        pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, userInfo.codigoEmpresa, v_lugar || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
        --Obtiene la informacion de parámetros recibos y el return del type 
        paw_log.g_typ_transferenciasSnp := v_retorno;
        paw_log.pr_logValoresTypes('typ_transferenciasSnp',
        'Transaferencia SNP '||' '||v_sesion||', '|| v_cod_canal||', '||  v_nro_cta_debito||', '||
        v_nro_cta_credito||', '|| v_cod_swift||', '|| v_mto_credito||', '||
        p_modo );
       RETURN v_retorno;
      END IF;
      --fin validacion clave transaccional
*/
        --Valida Caja
        v_mensajeCaja := paw_bel.lf_val_caja(userInfo);
        IF v_mensajeCaja.error = 'S' THEN
           v_retorno.error                := v_mensajeCaja.error;
           v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
           v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
           RETURN v_retorno;
        END IF;

/*        --controla horario cierre

            reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                        v_mensajeCaja.fechaUltimoCierre \* v_ult_cierre *\,
                                        -- IN
                                        v_mensajeCaja.codigoOficinaOrigen \* v_cod_ofi_origen *\,
                                        -- IN
                                        v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

             IF reterror.error = 'S' THEN
                v_retorno.error                := reterror.error;
                v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
                v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
                RETURN v_retorno;
             END IF;



        if nvl(v_tip_mensaje,'X') not in ('B','C')  then
           paw_bel.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Tipo Mensaje no valido'||v_tip_mensaje||'-' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
           return v_retorno;
        end if ;


       paw_bel.lp_set_tip_transferencia(v_tip_mensaje, r_gtran);
*/
        --codigo swift de las cooperativas--
        --patrocinadores                  --
        
         begin
          select 'S', cod_swift_sub, cta_interna_sub,cod_swift_padre
            into v_aler, v_cod_swift_sub, v_cta_sub,v_cod_swift
            from ge_snp_patrocinador_det
           where cod_swift_sub = p_codigoSwift
             and estado = 'S';
         exception
            when no_data_found then
              v_aler := 'N';
         end;
         
         if v_cod_swift is null and v_aler='N' then
            v_cod_swift:= paw_bel.depurarAlfanumerico(p_codigoSwift,15);
         end if;
         --valida si la cuenta beneficiaria no esta inhabilitada para recibir transferencias
        select count(*)
        into v_existe
        from ge_snp_cta_restringidas re
        where instr(v_nro_cta_credito,re.nro_cuenta)>0
        and re.cod_swi_entidad=(case v_aler
                                 when 'S' then
                                     v_cod_swift_sub
                                 else
                                     v_cod_swift
                                 end)
       and re.estado='A';
       
       if v_existe>0 then
          paw_bel.pr_mensajeUsuario(c_cta_restringida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Cta. Beneficiaria'||v_tip_mensaje||'-' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
          return v_retorno;
       end if;
       --
        /*if v_cod_swift = v_bcp_cod_swift then
           r_gtran.cod_sub_tip_operacion    := '005';

           if v_cod_mon_credito = pag_gen.FU_OBT_MON_LOCAL then
              v_nro_cta_credito := v_cta_bcp_gs_liquidacion;
           elsif v_cod_mon_credito = pag_gen.FU_OBT_MON_FUERTE then
              v_nro_cta_credito := v_cta_bcp_usd_liquidacion;
           end if;
        end if;*/
       
        /*Realiza controles para identificar si corresponde a SPI*/
        if v_tip_mensaje != 'B' then
           v_tra_spi:=pas_spi.fu_obt_tra_spi(v_cod_mon_credito,v_monto,v_aler,v_cod_swift);
           if v_tra_spi ='C' then
             v_tra_spi_ind:='C';--cancelar transferencia
             v_tra_spi:='S';
           elsif v_tra_spi ='R' then
             v_tra_spi_ind:='R';--redireccionar a LBTR/ACH
              v_tra_spi:='S';
           end if;
        end if;
		
         --controla horario cierre
            reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                        v_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                        -- IN
                                        v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                        -- IN
                                        v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

             IF reterror.error = 'S' THEN
                v_retorno.error                := reterror.error;
                v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
                v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
                RETURN v_retorno;
             END IF;



        if nvl(v_tip_mensaje,'X') not in ('B','C')  then
           paw_bel.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Tipo Mensaje no valido'||v_tip_mensaje||'-' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
           return v_retorno;
        end if ;

       v_patrocinador:=v_aler; --DA-7221
       paw_bel.lp_set_tip_transferencia(v_tip_mensaje, r_gtran);
        pas_snp.pr_ini_variables ;
        paw_bel.pr_mensajeUsuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);


        --Logear parámetros
        v_log_mensaje := 'fu_transferenciaSipap ('||v_sesion||', '||v_cod_canal||', '||v_modo||', '||v_nro_cta_debito||', '||
                                                  v_cod_mon_credito||', '||v_mto_credito||', '||v_fec_operacion||', '||v_cargos||', '||
                                                  v_nro_cta_credito||', '||v_cod_swift||', '||v_nro_doc_credito||', '||v_nom_beneficiario||', '||
                                                  v_dir_beneficiario||', '||v_tip_doc_beneficiario||', '||v_nro_contrato||', '||v_concepto||', '||
                                                  v_nro_ip||', '||v_cotizacion||', '||v_tip_mensaje||')';
        paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_log_mensaje, bitacora_entrada);


       v_cta_formateada  := v_nro_cta_debito;
       v_nro_cta_debito  := paw_bel.lf_obt_cta_limpia(v_nro_cta_debito,c_cod_operacion,userInfo.codigoPersona);

       paw_bel.lp_set_tip_transferencia(v_tip_mensaje, r_gtran);

       pas_snp.pr_ini_variables ;
       v_hor_actual := fug_obt_mov_hora;
       --DA-8004-Incidencia con transferencias durante el cierre
        /*if  nvl(fug_obt_pardinamico('BWE_BLO_HOR_CIERRE'),'N') = 'S' and v_es_mov_noc='S' then--DA-7022

             paw_bel.pr_mensajeUsuario(c_op_error , v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Modulo en estado 1 o 6:' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
             prg_rol_savepoint('sipap');
             return v_retorno;
        end if;*/
        -- Valida que la fecha ingresada para la transferencia no sea menor a la fecha del sistema ni superior a los 7 días hábiles posteriores a la misma
 if r_gtran.cod_msj_swift!= fug_obt_pardinamico( 'COD_SPI_PCD' ) then--pacs.008
        if (to_char(sysdate, 'hh24:mi') >= fug_obt_pardinamico('SNP_HOR_FIN_MT102')
       and pas_snp.fu_obt_est_horario(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion) = 'A'
        and instr(','||trim(fug_obt_pardinamico('SNP_COD_MON_ULT_PERIODO'))||',', ','||v_cod_mon_credito||',') = 0)
          or (to_char(sysdate, 'hh24:mi') >= fug_obt_pardinamico('SNP_HOR_FIN_MT102')
           and pas_snp.fu_obt_est_horario(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion) = 'A'
             and instr(','||trim(fug_obt_pardinamico('SNP_COD_MON_ULT_PERIODO'))||',', ','||v_cod_mon_credito||',') > 0
             and v_mto_credito > fug_obt_pardinamico('SNP_MTO_MAX_ULT_PERIODO'))
          -- Control de Monto Total en el último Período de intercambio
          or (to_char(sysdate, 'hh24:mi') >= fug_obt_pardinamico('SNP_HOR_FIN_MT102')
            and pas_snp.fu_obt_est_horario(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion) = 'A'
              and instr(','||trim(fug_obt_pardinamico('SNP_COD_MON_ULT_PERIODO'))||',', ','||v_cod_mon_credito||',') > 0
              and fug_obt_mto_max_cli_periodo(v_nro_cta_debito, v_fec_operacion, v_cod_mon_credito, v_mto_credito) > fug_obt_pardinamico('SNP_MTO_MAX_CLI_ULT_PERIODO', NULL, NULL, v_cod_mon_credito, NULL)) then
              v_fec_sugerida := pag_cal.fu_obt_fec_sig_hab(pag_cal.fu_obt_fec_actual(1), NULL);
              v_fec_operacion := v_fec_sugerida;
    else
      v_fec_sugerida := pas_snp.fu_obt_fec_transferencia(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion, v_fec_operacion);
    end if;
    else 
       v_fec_sugerida := pas_snp.fu_obt_fec_transferencia(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion, v_fec_operacion);
       --DA-7772-cálculo de fecha_operacion (fecha valor) para las transferencias SPI 
       v_mes_sugerida        := to_number(to_char(v_fec_sugerida, 'MM'));
       v_mes_fec_cal         := to_number(to_char(v_fec_actual, 'MM'));
       if v_fec_operacion > trunc(sysdate) and v_fec_sugerida > v_fec_operacion then
       v_fec_operacion := v_fec_sugerida;
       end if;
        --DA-7772
       if v_fec_operacion < v_fec_sugerida and v_mes_sugerida <>  v_mes_fec_cal then
          v_fec_operacion:= trunc(sysdate);
       end if;
       if v_fec_operacion = v_fec_sugerida and v_mes_sugerida =  v_mes_fec_cal then
           v_fec_operacion:= trunc(sysdate);
       end if;
    end if;
    -- Valida la fecha ingresada para la transferencia
        if trunc(v_fec_operacion) <> trunc(v_fec_sugerida) and r_gtran.cod_msj_swift!= fug_obt_pardinamico( 'COD_SPI_PCD' )/*--DA-7772*/ then
            v_fec_operacion := v_fec_sugerida;
            paw_bel.pr_mensajeUsuario(c_fec_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            v_retorno.fechaSugerida    := lf_for_date(v_fec_sugerida);
            paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - FechaInvalida:'||v_fec_operacion || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            return v_retorno;
        end if;
         -- Valida cuando es tarjeta tenga 16 numeros.
         if v_modo = 'V' and v_tip_mensaje = 'T' and (length(v_nro_cta_credito) <> 16
              or translate(v_nro_cta_credito,'T 0123456789','T') is not null) then
            paw_bel.pr_mensajeUsuario(c_tar_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            return v_retorno;
         end if ;
         v_cod_mon_debito   := FUG_OBT_MON_CTA(v_nro_cta_debito) ;
         -- Inicializa las Variables del PAS_SNP
         pas_snp.pr_ini_variables;
         pas_snp.pr_ini_registros;
         -- Obtiene el nro de cuenta de participante solicitante.
         if  r_gtran.cod_msj_swift = fug_obt_pardinamico( 'COD_SPI_PCD' ) and  nvl(v_tra_spi,'N') ='S' then
            v_cta_pte_sol_bcp     :=  pas_spi.fu_obt_cta_ban_participante(pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad), v_cod_mon_credito);
         else
            v_cta_pte_sol_bcp     :=  pas_snp.fu_obt_cta_ban_participante(pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad), v_cod_mon_credito);
         end if;
         
         v_cta_pte_solicitante :=  pas_snp.fu_obt_cta_bancaria(v_cta_pte_sol_bcp ,'C');
         if pas_snp.fu_obt_cod_error <> 0 then
            paw_bel.pr_mensajeUsuario(c_cta_int_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            return v_retorno;
         end if ;
         -- Verifica el monto de la Operacion
         if nvl(v_mto_credito,0) < 1 then
            paw_bel.pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null),BITACORA_ERROR);
            return v_retorno;
         end if ;
         -- moneda diferentes sin contrato de cambio
          if v_cod_mon_credito <> v_cod_mon_debito then
             -- Verifica que no pueda realizar cambio de monedas en fecha distinta a la fecha actual
             if v_fec_operacion <> v_fec_actual then
                paw_bel.pr_mensajeUsuario(c_fec_inv_cam_moneda, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                return v_retorno;
             end if ;
             if nvl(v_nro_contrato,0) > 0 then
                -- se asigna v_cotizacion a las dos variables al correr el proceso lp_con_mon_a_moneda, una de las
                -- variables obtendrá su valor correcto (1) dependiendo de las monedas de credito y debito
                if v_cod_mon_credito <> v_cod_mon_local  and
                   v_cod_mon_debito <> v_cod_mon_local  and
                   v_cod_mon_credito <> v_cod_mon_debito then
                   begin
                      -- En Arbitraje siempre la cotizacion compra pertenece a la Cta. Debito
                      select c.cot_compra, c.cot_venta
                         into v_cot_debito, v_cot_credito
                      from lc_con_cambios c
                      where c.nro_contrato = v_nro_contrato;
                   exception
                      when others then
                         paw_bel.pr_mensajeUsuario(c_con_cambio, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                         paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                         return v_retorno;
                   end;
                else
                   v_cot_credito := v_cotizacion ;
                   v_cot_debito  := v_cotizacion ;
                end if;
             elsif v_cod_mon_credito <> v_cod_mon_local  and
                   v_cod_mon_debito <> v_cod_mon_local    then
                -- es arbitraje y no tiene contrato de cambios
                paw_bel.pr_mensajeUsuario(c_con_cambio, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                return v_retorno;
             end if;
             -- Se realiza la conversion de moneda
             Begin
                paw_bel.lp_con_mon_a_moneda(v_cod_mon_credito,
                                    v_cod_mon_debito,
                                    v_mto_credito,
                                    v_mto_debito,
                                    v_cot_credito,
                                    v_cot_debito,
                                    'S');
             Exception
                When OTHERS then
                   pr_mensajeUsuario(c_con_moneda, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   return v_retorno;
             End;
             -- Agrega el monto de cambio para verificar el Contrato
             if v_cod_mon_credito = v_cod_mon_local  and
                v_cod_mon_debito <> v_cod_mon_local then
                v_mto_contrato := v_mto_debito;
             else
                v_mto_contrato := v_mto_credito;
             end if;
             -- valido el contrato de cambio, ojo con las variables.
             if nvl(v_nro_contrato,0) > 0 then
                paw_bel.lp_val_con_cambio('V',
                                   v_nro_contrato,
                                   v_cod_mon_debito,
                                   v_cod_mon_credito,
                                   v_nro_cta_debito,
                                   v_cta_pte_solicitante,
                                   v_cotizacion,
                                   v_mto_contrato,
                                   v_cod_error);
                if v_cod_error != MSG_OK then
                   paw_bel.pr_mensajeUsuario(v_cod_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                   return v_retorno;
                end if;
             end if ;
             if v_cod_mon_debito <> v_cod_mon_local and v_cod_mon_credito = v_cod_mon_local then
                v_cotizacion := v_cot_debito;
             elsif v_cod_mon_debito = v_cod_mon_local and v_cod_mon_credito <> v_cod_mon_local then
                v_cotizacion := v_cot_credito;
             end if;
          else
             -- Valida Contrato si es moneda igual
             if nvl(v_nro_contrato,0) > 0 or nvl(v_cotizacion,1) > 1 then
                paw_bel.pr_mensajeUsuario(c_con_cambio, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                return v_retorno;
             end if ;
             -- Se iguala el monto por que la Moneda Credito y Debito es igual
             v_mto_debito := v_mto_credito ;
          end if ;

         -- Valida la cuenta debito si puede realizar la operacion
         retError := paw_bel.lf_val_cta_debito( v_nro_cta_debito,
                                  v_cod_tra_padre,
                                  v_mto_debito,
                                  v_cod_mon_debito,
                                  v_cod_mod_debito,
                                  v_cod_mad_debito,
                                  v_cod_ofi_debito,
                                  v_cta_for_debito,
                                  v_nom_cta_debito,
                                  userInfo,
                                  v_mensajeCaja);

         if retError.error = 'S' then
                v_retorno.error                := retError.error;
                v_retorno.nombreRespuesta      := retError.nombreRespuesta;
                v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_val_cta_debito - ' || v_nro_cta_debito || ')' ||' '|| paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                pr_del_snp_transferencias(v_nro_referencia); --TRFS-415 --
            return v_retorno;
         end if;


         -- agregado para control de limites diarios de transacciones (Opcional)
               if v_retorno.error = 'N' then
             if nvl(fug_obt_pardinamico('IND_LIM_CTA'),'N')='S' then
              v_mto_limite := fug_obt_paradicional(v_nro_cta_debito, 'LIM_CTA_TRA_SNP');
              v_cta_limite:=v_nro_cta_debito;
             end if;
              if nvl(v_mto_limite,0) = 0 then
                 v_mto_limite := nvl(lf_obt_lim_cliente(v_cod_canal,nvl(userInfo.codigoEmpresa, userInfo.codigoPersona),c_cod_operacion, pag_gen.FU_OBT_MON_LOCAL),0);
              end if;
                 if nvl(v_mto_limite,0) = 0 then
                  v_mto_limite := fug_obt_pardinamico('LIM_GEN_TRA_SNP',
                                                   v_cod_mod_debito,
                                                   v_cod_mad_debito,
                                                   pag_gen.FU_OBT_MON_LOCAL,
                                                   v_cod_ofi_debito);
              end if;

                                    
              v_tot_realizado := lf_obt_tot_operaciones(userInfo.codigoEmpresa, userInfo.codigoPersona,v_cta_limite,c_cod_operacion,v_cod_tra_padre);

              if v_cod_mon_credito <> v_cod_mon_local then
                v_cotiza := pag_gen.FU_OBT_COTIZACION(pag_gen.FU_OBT_MON_FUERTE,v_fec_actual);
              else
                v_cotiza := 1;
              end if;
              v_monto_gs := nvl(v_monto,0)*v_cotiza;
              v_tot_realizado := nvl(v_tot_realizado,0)+nvl(v_monto_gs,0);

              if v_tot_realizado > v_mto_limite and nvl(v_nro_contrato,0) = 0 then
               null;
                 paw_bel.pr_mensajeUsuario(c_lim_excedido , v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                 return v_retorno;
              end if;
         end if;


         -- Verifica la cuenta Interbancaria.
         if v_cta_pte_sol_bcp is null then
            paw_bel.pr_mensajeUsuario(c_cta_int_invalida , v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            return v_retorno;
         end if ;

          -- Verifica la Configuracion de la Cuenta Participante Beneficiario.
         r_gtran.nro_cta_pte_beneficiario := pas_snp.fu_obt_cta_ban_participante(v_cod_swift, v_cod_mon_credito) ;
         if pas_snp.fu_obt_cod_error <> 0 then
            paw_bel.pr_mensajeUsuario(c_cta_int_invalida , v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            return v_retorno;
         end if ;

         if v_modo = 'V'  and v_retorno.error = 'N' then
            v_retorno.fechaOperacion   := lf_for_date(v_fec_operacion);
            v_retorno.cuentaDebito     := v_cta_formateada;
            v_retorno.nombreCtaDebito  := v_nom_cta_debito;
            v_retorno.monedaDebito     := v_cod_mon_debito;
            v_retorno.montoDebito      := v_mto_debito;
            v_retorno.cuentaCredito    := v_nro_cta_credito;
            v_retorno.beneficiario     := v_nom_beneficiario;
            v_retorno.codigoSwift      := v_cod_swift;
            v_retorno.participante     := pas_snp.fu_obt_des_participante(v_cod_swift);
            v_retorno.monedaCredito    := v_cod_mon_credito;
            v_retorno.montoCredito     := v_mto_credito;
            v_retorno.cotizacion       := v_cotizacion;
            return v_retorno;
         elsif v_modo = 'C'   and v_retorno.error = 'N' then
             if v_cargos = 'O' then
                v_tip_cargos := 'OUR';
             elsif v_cargos = 'B' then
                v_tip_cargos := 'BEN';
             else
                v_tip_cargos := 'SHA';
             end if ;
             if v_retorno.error = 'N' then
                   -- manejo de campo multilínea
                  v_concepto := substr(v_concepto,1,31);--el tag 72 acepta hasta 36 caracteres
                  if (instr(v_concepto,'^',-1) = length(trim(v_concepto))) then
                     v_concepto := substr(v_concepto,1,length(trim(v_concepto))-1);
                  end if;
                  v_concepto := replace(v_concepto,'^',pas_snp.fu_obt_salto);
                  v_concepto :=  '/BNF/'||pas_snp.fu_val_cadena(v_concepto);
                  if  r_gtran.cod_msj_swift = fug_obt_pardinamico( 'COD_SPI_PCD' ) and   nvl(v_tra_spi,'N') ='S' then
                      v_nro_cta_pte_beneficiario:=pas_spi.fu_obt_cta_ban_participante(v_cod_swift, v_cod_mon_credito) ;
                  else
                     v_nro_cta_pte_beneficiario:=pas_snp.fu_obt_cta_ban_participante(v_cod_swift, v_cod_mon_credito) ;
                  end if;

                  -- Se graba la operacion como solicitado y pendiente de autorizacion
                  v_nro_referencia                 := pas_snp.fu_obt_sig_nro_referencia(v_fec_actual) ;
                  r_gtran.nro_referencia           := v_nro_referencia ;
                  r_gtran.fec_valor                := v_fec_operacion ;
                  r_gtran.nro_cta_solicitante      := v_nro_cta_debito ;
                  r_gtran.nro_cta_pte_solicitante  := v_cta_pte_sol_bcp ;
                  r_gtran.nro_cta_beneficiario     := v_nro_cta_credito ;
                  r_gtran.cod_swi_pte_beneficiario := v_cod_swift ;
                  r_gtran.cod_moneda               := v_cod_mon_credito;
                  r_gtran.monto                    := v_mto_credito ;
                  r_gtran.cod_modulo               := pas_snp.fu_obt_cod_mod_padre;
                  r_gtran.cod_modalidad            := pas_snp.fu_obt_cod_mad_padre;
                  r_gtran.cod_oficina              := v_cod_ofi_debito ;
                  --/*DA-7789-
                  if r_gtran.cod_msj_swift!= fug_obt_pardinamico( 'COD_SPI_PCD' ) then
                     r_gtran.fec_ingreso              := v_fec_actual ;
                  else
                     r_gtran.fec_ingreso              :=  trunc(sysdate);
                  end if;
                  --*/
                  r_gtran.cod_per_solicitante      := nvl(userInfo.codigoEmpresa,userInfo.codigoPersona) ;
                  r_gtran.nom_solicitante          := fue_obt_nom_persona(nvl(userInfo.codigoEmpresa,userInfo.codigoPersona)) ;
                  r_gtran.dir_solicitante          := fue_obt_dir_principa(nvl(userInfo.codigoEmpresa,userInfo.codigoPersona)) ;
                  r_gtran.cod_tip_doc_solicitante  := fue_obt_doc_principal (nvl(userInfo.codigoEmpresa,userInfo.codigoPersona)) ;
                  r_gtran.nro_doc_solicitante      := fue_obt_nro_doc_persona(nvl(userInfo.codigoEmpresa,userInfo.codigoPersona)) ;
                  r_gtran.cod_swi_pte_solicitante  := pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad);
                  r_gtran.nom_beneficiario         := v_nom_beneficiario ;
                  r_gtran.dir_beneficiario         := v_dir_beneficiario ;
                  r_gtran.cod_tip_doc_beneficiario := v_tip_doc_beneficiario ;
                  r_gtran.nro_doc_beneficiario     := v_nro_doc_credito ;
                  --r_gtran.nro_cta_pte_beneficiario := pas_snp.fu_obt_cta_ban_participante(v_cod_swift, v_cod_mon_credito) ;
                  r_gtran.nro_cta_pte_beneficiario := v_nro_cta_pte_beneficiario;

                  r_gtran.observacion              := v_concepto ;
                  r_gtran.tip_cargo                := v_tip_cargos ;
          
           if v_aler = 'S' then  --SPI fase 2
              r_gtran.cod_swi_suc_beneficiario     := v_cod_swift_sub;
              r_gtran.nro_cta_suc_pte_beneficiario := v_cta_sub;
          end if;
          
          if (v_tip_mensaje = 'C') and r_gtran.cod_msj_swift = 103 then
              if r_gtran.cod_swi_pte_beneficiario = paw_bel.lf_obt_bco_swift(1) then
                 r_gtran.cod_tip_operacion     := '001';
                 r_gtran.cod_sub_tip_operacion := '005';
              end if;    
              r_gtran.ind_valor := 'S';
            --r_gtran.prioridad := fus_snp_obt_prioridad(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion);
          elsif (v_tip_mensaje = 'C') and r_gtran.cod_msj_swift = 102
                and r_gtran.cod_moneda = PAG_GEN.FU_OBT_MON_LOCAL
            and r_gtran.monto <= fug_obt_pardinamico('MTO_MAX_ACH') then
                /*SPI 361 si el beneficiario es BCP se setean  valores 001 para tip_operacion y 005 paracod_sub_tip_operacion */
               if r_gtran.cod_swi_pte_beneficiario = paw_bel.lf_obt_bco_swift(1) then
                 r_gtran.cod_msj_swift := 103;
                 r_gtran.cod_tip_operacion     := '001';
                 r_gtran.cod_sub_tip_operacion := '005';
                 r_gtran.ind_valor := 'S';
               else
                  r_gtran.ind_valor := 'N';
               end if;

            --r_gtran.prioridad := 100;
          elsif (v_tip_mensaje = 'C') and r_gtran.cod_msj_swift = 102
                and (r_gtran.cod_moneda = PAG_GEN.FU_OBT_MON_LOCAL or r_gtran.monto > fug_obt_pardinamico('MTO_MAX_ACH')) then
            r_gtran.cod_msj_swift := 103;
            
            /*SPI 361 si el beneficiario es BCP se setean  valores 001 para tip_operacion y 005 paracod_sub_tip_operacion */
            if r_gtran.cod_swi_pte_beneficiario = paw_bel.lf_obt_bco_swift(1) then
              r_gtran.cod_tip_operacion     := '001';
             r_gtran.cod_sub_tip_operacion := '005';
            else
             r_gtran.cod_tip_operacion     := '001';
             r_gtran.cod_sub_tip_operacion := '002';
            end if;    
              r_gtran.ind_valor := 'S';
            --r_gtran.prioridad := 20;
            elsif (v_tip_mensaje = 'C') and r_gtran.cod_msj_swift = 102
                and (r_gtran.cod_moneda <> PAG_GEN.FU_OBT_MON_LOCAL
            or r_gtran.monto > fug_obt_pardinamico('MTO_MAX_ACH')) then
            r_gtran.cod_msj_swift := 103;
            /*SPI 361 si el beneficiario es BCP se setean  valores 001 para tip_operacion y 005 paracod_sub_tip_operacion */
            if r_gtran.cod_swi_pte_beneficiario = paw_bel.lf_obt_bco_swift(1) then
              r_gtran.cod_tip_operacion     := '001';
             r_gtran.cod_sub_tip_operacion := '005';
            else
             r_gtran.cod_tip_operacion     := '001';
             r_gtran.cod_sub_tip_operacion := '002';
            end if; 
              r_gtran.ind_valor := 'S';
            --r_gtran.prioridad := 20;
            elsif (v_tip_mensaje = 'B') then
                   r_gtran.ind_valor := 'N';
            --r_gtran.prioridad := 100;
            elsif (v_tip_mensaje = 'C') and r_gtran.cod_msj_swift = fug_obt_pardinamico( 'COD_SPI_PCD' ) and nvl(v_tra_spi_ind,'N') not in('R') then--(R)Redireccionar
                  r_gtran.cod_msj_swift := fug_obt_pardinamico( 'COD_SPI_PCD' );
                  
                  if nvl(v_aler,'N')='S' then --SPI Fase 2
                     r_gtran.cod_tip_operacion     := '002';
                     r_gtran.cod_sub_tip_operacion := '002';
                  else

                      if v_alias is  not null then
                         r_gtran.cod_tip_operacion     := '011';
                         r_gtran.cod_sub_tip_operacion := '002';
                      else
                         r_gtran.cod_tip_operacion     := '001';
                         r_gtran.cod_sub_tip_operacion := '002';
                      end if;
                  end if;
                  r_gtran.ind_valor := 'S';
                  r_gtran.nro_ref_externa:=pas_spi.fu_obt_sig_nro_ref_externa;

            end if;
            r_gtran.situacion                := 'P' ; -- Pendiente de Envio a BCP
            r_gtran.estado                   := 'S' ; -- Solicitado
            r_gtran.nro_operacion            := v_nro_referencia ;
            r_gtran.tip_mensaje              := 'CRED' ;
            r_gtran.origen                   := 'H';
            if  r_gtran.cod_msj_swift = fug_obt_pardinamico( 'COD_SPI_PCD' ) and   nvl(v_tra_spi,'N') ='S' then
                r_gtran.plataforma               := 'S';
                r_gtran.concepto                 := r_gtran.nro_ref_externa;
                v_concepto_mov:=r_gtran.concepto;
            else
                r_gtran.plataforma               := 'X';
                r_gtran.concepto                 := 'Trx. via BCP Nro Re'||v_nro_referencia;
                v_concepto_mov:=pas_snp.fu_obt_mov_concepto('M','H',v_nro_referencia);
            end if; 

            r_gtran.indemnizado              := 'N';
            r_gtran.prioridad                := fus_snp_obt_prioridad(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion);
                  --r_gtran.prioridad                := 20;
            
                  -- para evitar todo lo posible la duplicacion de transferencias
                  begin
                      -- valido la duplicacion de transferencias
                        -- v_mto_credito contiene el monto debitado en la cta de origen
                      If v_retorno.error = 'N' then
                            v_tie_ctr_duplica := fug_obt_pardinamico('SNP_TIE_CTR_DUPLICACION',
                                                          null,
                                                          null,
                                                          null,
                                                          null);

                          lp_val_duplicacion(v_nro_cta_debito,
                                            v_mto_credito,
                                            v_nro_cta_credito,
                                            v_cod_tra_padre,
                                            v_tie_ctr_duplica,
                                            userInfo.codigoEmpresa,
                                            userInfo.codigoPersona,
                                            v_mensajeCaja.codigoUsuario,
                                            r_gtran.cod_swi_pte_beneficiario,
                                            v_fec_actual,
                                            v_ret_val_dup
                                            );

                         if (v_ret_val_dup.error = 'S') THEN
                            v_retorno.nombreRespuesta      := v_ret_val_dup.nombreRespuesta;
                            v_retorno.descripcionRespuesta := v_ret_val_dup.descripcionRespuesta;
                            v_retorno.error                := v_ret_val_dup.error;
                            pr_insertarBitacora(userInfo.codigoPersona, p_codigoCanal,v_sesion,v_cod_operacion,userInfo.codigoEmpresa,
                            fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null),BITACORA_ERROR);
                            RETURN v_retorno;
                          end if;


                          if v_ret_val_dup.error = 'N' then
                             if v_cod_swift = v_bcp_cod_swift then
                                pas_snp.pr_obt_dat_participante(v_bcp_cod_swift, rg_dat_pte);
                                r_gtran.cod_per_beneficiario := rg_dat_pte.cod_persona;
                                r_gtran.nom_beneficiario := rg_dat_pte.nom_persona;
                                r_gtran.cod_tip_doc_beneficiario := rg_dat_pte.cod_tip_doc_persona;
                                r_gtran.nro_doc_beneficiario := rg_dat_pte.nro_doc_persona;
                                r_gtran.dir_beneficiario := rg_dat_pte.dir_persona;

                                /* spi 361
                                v_texto := '//'||v_nom_beneficiario||pas_snp.fu_obt_salto
                                  ||'//'||fue_obt_tip_doc_abreviatura(v_tip_doc_beneficiario)||'/'||v_nro_doc_credito||pas_snp.fu_obt_salto;

                                r_gtran.observacion := v_texto;*/
                             end if;
                           pr_ins_snp_transferencias(r_gtran);
                           --pas_snp.pr_ins_transferencias(r_gtran) ; --HA-3690
                           end if;
                    end if;
                 end;
              end if;

              if nvl(pas_snp.fu_obt_cod_error,1) <> 0 then
                 paw_bel.pr_mensajeUsuario(c_tra_invalida , v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null),bitacora_error);
                 prg_rol_savepoint('sipap');
                 pr_del_snp_transferencias(v_nro_referencia); --TRFS-415 --
                 return v_retorno;

              else

                 if v_cod_swift = v_bcp_cod_swift then
                            pas_snp.pr_obt_dat_participante(v_bcp_cod_swift, rg_dat_pte);
                            r_gtran.cod_per_beneficiario := rg_dat_pte.cod_persona;
                            r_gtran.nom_beneficiario := rg_dat_pte.nom_persona;
                            r_gtran.cod_tip_doc_beneficiario := rg_dat_pte.cod_tip_doc_persona;
                            r_gtran.nro_doc_beneficiario := rg_dat_pte.nro_doc_persona;
                            r_gtran.dir_beneficiario := rg_dat_pte.dir_persona;

                            /*se comenta por spi 361 
                            v_texto := '//'||v_nom_beneficiario||pas_snp.fu_obt_salto
                              ||'//'||fue_obt_tip_doc_abreviatura(v_tip_doc_beneficiario)||'/'||v_nro_doc_credito||pas_snp.fu_obt_salto
                              ;

                            r_gtran.observacion := v_texto;*/
                 end if;
              end if ;
              retObtenerPermisos := paw_bel.lf_obt_permisos(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona),
                                                                userInfo.codigoPerfil,
                                                                c_cod_operacion,
                                                                v_cod_canal);
              -- Se confirma directamente la operacion, porque no requiere autorizacion
              if nvl(retObtenerPermisos.canAutRequeridas,0) = 0 then
                 v_modo := 'A'; -- CONFIRMACION
                 -- cambio el estado del contrato de cambio
                 if nvl(v_nro_contrato,0) <> 0 then
                    paw_bel.lp_val_con_cambio('C',
                                              v_nro_contrato,
                                              null,
                                              null,
                                              null,
                                              null,
                                              null,
                                              null,
                                              v_cod_error);
                    if v_cod_error != MSG_OK then
                      paw_bel.pr_mensajeUsuario(v_cod_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                      paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                      prg_rol_savepoint('sipap');
                      pr_del_snp_transferencias(v_nro_referencia);
                      --borrar transf -- HA-3690				  
                      return v_retorno;
                    end if;
                end if;
              elsif v_modo = 'C' then -- grabacion en pendiente
                 if nvl(v_nro_contrato,0) = 0 then
                    v_mto_equ_local := null;
                    if v_cod_mon_debito <> v_cod_mon_credito then
                       if v_cod_mon_debito <> v_cod_mon_local then
                          if v_cod_mon_credito <> v_cod_mon_local then
                             v_mto_equ_local := round(v_cotizacion * v_mto_credito,0);
                          else
                             v_mto_equ_local := v_mto_credito ;
                          end if ;
                       else
                          v_mto_equ_local := v_mto_debito ;
                       end if ;
                    else
                       v_cotizacion     := null;
                       v_mto_equ_local  := null;
                    end if;
                 else
                    -- cambio el estado del contrato de cambio
                    paw_bel.lp_val_con_cambio('C',
                                              v_nro_contrato,
                                              null,
                                              null,
                                              null,
                                              null,
                                              null,
                                              null,
                                              v_cod_error);
                    if v_cod_error != msg_ok then
                      paw_bel.pr_mensajeUsuario(v_cod_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                      paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                      prg_rol_savepoint('sipap');
                      --borrar transferencia --HA-3690
                      pr_del_snp_transferencias(v_nro_referencia);					  
                      return v_retorno;
                    end if;
                 end if ;
                 --- inserto el movimiento pendiente de autorizacion
                 select s_nro_documento.nextval into v_nro_documento from dual;
                 insert into bw_mov_pendientes
                    (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda,
                     descripcion, monto, cotizacion, mto_equ_local, nro_cta_contra,
                     estado,can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra, cot_contra,
                     etiqueta, dato, etiqueta2, dato2, nro_ope_relacionada, etiqueta3, dato3,
                     etiqueta4, dato4,etiqueta5, dato5,etiqueta6, dato6)
                 values
                     (v_nro_documento,nvl(userInfo.codigoEmpresa,userInfo.codigoPersona),sysdate,'036',v_nro_cta_debito,v_cod_mon_debito,
                      'Transferencia Interbancaria',v_mto_debito, v_cot_debito, v_mto_equ_local, null,
                      'P', v_can_aut_requeridas, NVL(retObtenerPermisos.canAutRequeridas,'0'), userInfo.codigoPersona, v_mto_credito, v_cot_credito,
                      'Nro.Cta.Crédito',v_nro_cta_credito, 'Concepto',v_concepto, v_nro_referencia, 'Fecha Valor', to_char(v_fec_operacion,'DD/MM/YYYY'),
                      'Cta.Interbancaria/Moneda Cred.',v_cta_pte_solicitante||'*'||v_cod_mon_credito,'Motivo Transferencia',v_motivo,'Tipo Transferencia',v_tip_mensaje);
              end if ;

            end if;
            if v_modo = 'A' and v_retorno.error = 'N' then
                 -- Valida que la fecha ingresada para la transferencia no sea menor a la fecha del sistema ni superior a los 7 días hábiles posteriores a la misma
                 pas_snp.pr_obt_mensaje(v_nro_referencia,'N');
                 if pas_snp.fu_obt_cod_error <> 0 then
                    paw_bel.pr_mensajeUsuario(c_fec_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    v_retorno.fechaSugerida    := lf_for_date(v_fec_sugerida);
                    paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap - Referencia :'||v_nro_referencia||' '|| paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                    prg_rol_savepoint('sipap');
                    pr_del_snp_transferencias(v_nro_referencia); --TRFS-415 --
                    return v_retorno;
                 else
                    r_gtran := pas_snp.fu_obt_reg_transferencias;
                    pas_snp.pr_ini_registros;
                 end if;
                 if v_retorno.error = 'N' then
               if r_gtran.cod_msj_swift!= fug_obt_pardinamico( 'COD_SPI_PCD' ) then--pacs.008 
                        if (to_char(sysdate, 'hh24:mi') >= fug_obt_pardinamico('SNP_HOR_FIN_MT102')
                           and pas_snp.fu_obt_est_horario(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion) = 'A'
                             and instr(','||trim(fug_obt_pardinamico('SNP_COD_MON_ULT_PERIODO'))||',', ','||v_cod_mon_credito||',') = 0)
                               or (to_char(sysdate, 'hh24:mi') >= fug_obt_pardinamico('SNP_HOR_FIN_MT102')
                                 and pas_snp.fu_obt_est_horario(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion) = 'A'
                                 and instr(','||trim(fug_obt_pardinamico('SNP_COD_MON_ULT_PERIODO'))||',', ','||v_cod_mon_credito||',') > 0
                                 and v_mto_credito > fug_obt_pardinamico('SNP_MTO_MAX_ULT_PERIODO'))
                                 -- Control de Monto Total en el último Período de intercambio
                               or (to_char(sysdate, 'hh24:mi') >= fug_obt_pardinamico('SNP_HOR_FIN_MT102')
                                 and pas_snp.fu_obt_est_horario(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion) = 'A'
                                 and instr(','||trim(fug_obt_pardinamico('SNP_COD_MON_ULT_PERIODO'))||',', ','||v_cod_mon_credito||',') > 0
                                 and fug_obt_mto_max_cli_periodo(v_nro_cta_debito, v_fec_operacion, v_cod_mon_credito, v_mto_credito) > fug_obt_pardinamico('SNP_MTO_MAX_CLI_ULT_PERIODO', NULL, NULL, v_cod_mon_credito, NULL)) then
                                 v_fec_sugerida := pag_cal.fu_obt_fec_sig_hab(pag_cal.fu_obt_fec_actual(1), NULL);
                                 v_fec_operacion := v_fec_sugerida;
                        else
                            v_fec_sugerida := pas_snp.fu_obt_fec_transferencia(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion, v_fec_operacion);
                        end if;
         else 
           v_fec_sugerida := pas_snp.fu_obt_fec_transferencia(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion, v_fec_operacion);
           --DA-7772-cálculo de fecha_operacion (fecha valor) para las transferencias SPI
            v_mes_sugerida        := to_number(to_char(v_fec_sugerida, 'MM'));
            v_mes_fec_cal         := to_number(to_char(v_fec_actual, 'MM'));
           if v_fec_operacion > trunc(sysdate) and v_fec_sugerida > v_fec_operacion then
           v_fec_operacion := v_fec_sugerida;
            end if;
             --DA-7772
            if v_fec_operacion < v_fec_sugerida and v_mes_sugerida <>  v_mes_fec_cal then
               v_fec_operacion:= trunc(sysdate);
            end if;
            if v_fec_operacion = v_fec_sugerida and v_mes_sugerida =  v_mes_fec_cal then
               v_fec_operacion:= trunc(sysdate);
            end if;
         end if;
          --v_fec_sugerida := PAS_SNP.FU_OBT_FEC_TRANSFERENCIA(r_gtran.cod_msj_swift, r_gtran.cod_tip_operacion, r_gtran.cod_sub_tip_operacion, v_fec_operacion);
                   -- Valida la fecha ingresada para la transferencia
                   if v_fec_operacion <> v_fec_sugerida and r_gtran.cod_msj_swift!= fug_obt_pardinamico( 'COD_SPI_PCD' )/*DA-7772*/ then
                      paw_bel.pr_mensajeUsuario(c_fec_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                      v_retorno.fechaSugerida    := lf_for_date(v_fec_sugerida);
                      paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                      prg_rol_savepoint('sipap');
                      --borrar transf --HA-3690
                      pr_del_snp_transferencias(v_nro_referencia);					  
                      return v_retorno;
                   end if;
                  end if;

                 -- Genera el Movimiento y envía el mensaje a BCP si la fecha es actual y está activo

                  -- Genera el Mensaje Swift
                  if r_gtran.cod_msj_swift = 102 then
                     v_msj_swift := NULL;
                 elsif r_gtran.cod_msj_swift = 103 then
                     v_msj_swift := pas_snp.fu_obt_msj_mt103(v_nro_referencia, 'N') ;
                     pre_cam_for_numerico('.,');
                 end if;

                  -- Obtiene el monto límite de montos transferidos por la web
                  --v_mto_lim_web := nvl(fug_obt_pardinamico('SNP_MTO_LIM_TRANSFERENCIAS', NULL, NULL, v_cod_mon_credito),0);
                 /* if v_mto_credito > v_mto_lim_web then
                     v_lim_excedido := true;
                     -- Inicia WF si el cliente excede el monto límite de transferencias.
                     -- Al iniciar WF por límite el circuito ya controlaría además si el cliente se encuentra en lista de cumplimiento
                     -- Por tanto, si es que se inicia WF por Límite y el cliente también se encuentra en lista de cumplimiento,
                     -- solo bastará iniciar un solo circuito.
                     begin
                       pas_snp.pr_obt_mensaje(v_nro_referencia,'N');
                       if pas_snp.fu_obt_cod_error <> 0 then
                          paw_bel.pr_mensajeUsuario(c_con_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                          return v_retorno;
                       else
                         r_gtran := pas_snp.fu_obt_reg_transferencias;
                         pas_snp.pr_ini_registros;
                         pas_snp.pr_ini_workflow(r_gtran);
                       end if;
                     exception
                       when others then
                          paw_bel.pr_mensajeUsuario(c_con_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                          return v_retorno;
                     end;
                  end if;*/
                  /*If v_retorno.error = 'N' then
                     -- Actualiza el Estado y le agrega el Mensaje Swift generado
                     v_cod_per_cumplimiento := fug_snp_val_cumplimiento(v_nro_referencia);
                     if v_cod_per_cumplimiento is not null then
                        --Inicia Workflow solo si el cliente tiene cumplimiento y no haya superado el monto límite para transferencias emitidas
                        if v_retorno.error = 'N' and
                           not v_lim_excedido
                        then
                           begin
                              prs_snp_ini_cir_advertencia( v_nro_referencia );
                           exception
                             when others then
                               pr_mensajeUsuario(c_con_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                               pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                               return v_retorno;
                           end;
                        end if;
                     end if;
                   end if;*/
                   if v_retorno.error = 'N' then
                         /*Inserta el motivo, fondo y financiacion de la transferencia en BA_TAB_DAT_ADICIONALES
                         si ha iniciado circuito de workflow o no*/
                         v_tab_relacion := 'GE_SNP_TRANSFERENCIAS';
                         Begin
                            insert into ba_tab_dat_adicionales (tab_relacion, referencia,parametro,val_parametro)
                            values(v_tab_relacion, v_nro_referencia, 'SIB_TRA_MOTIVO', v_motivo);

                            insert into ba_tab_dat_adicionales (tab_relacion, referencia,parametro,val_parametro)
                            values (v_tab_relacion, v_nro_referencia, 'SIB_TRA_FINANCIACION', v_financia);

                            insert into ba_tab_dat_adicionales (tab_relacion, referencia,parametro,val_parametro)
                            values (v_tab_relacion, v_nro_referencia, 'SIB_TRA_FONDO', v_fondo);
                         exception
                           when dup_val_on_index then
                             paw_bel.pr_mensajeUsuario(c_dup_dat_adicionales, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                             paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -'|| sqlerrm || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                             prg_rol_savepoint('sipap');
                             --borrar transf --HA-3690
                             pr_del_snp_transferencias(v_nro_referencia);							 
                             return v_retorno;
                           when others then
                             paw_bel.pr_mensajeUsuario(c_ins_dat_adicionales, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                             paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || sqlerrm|| paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                             prg_rol_savepoint('sipap');
                             --borrar transf --HA-3690
                             pr_del_snp_transferencias(v_nro_referencia);							 
                             return v_retorno;
                            end;
                                           /*
                       || Aprueba Todos los de la Web
                       || en caso que no se haya iniciado circuito por cumplimiento
                       || o por exceso en monto límite de transferencias por cliente
                       */
                       v_estado := NULL;
                       /*if v_cod_per_cumplimiento is null and
                          not v_lim_excedido
                       then
                          v_estado := 'A';
                       end if;*/
                       If v_retorno.error = 'N' then
                         if  r_gtran.cod_msj_swift = fug_obt_pardinamico( 'COD_SPI_PCD' ) and   nvl(v_tra_spi,'N') = 'S' and nvl(v_tra_spi_ind,'N') = 'C'/*cancelar*/ then
                           v_estado := 'R';
                           v_situacion:='C';
                         elsif  r_gtran.cod_msj_swift = fug_obt_pardinamico( 'COD_SPI_PCD' ) and   nvl(v_tra_spi,'N') = 'S' and  v_es_mov_noc = 'N' and nvl(v_tra_spi_ind,'N') not in ('C','R')/*no sean Cancelar y redireccionar*/ AND r_gtran.fec_valor =trunc(sysdate)/*DA-7772*/ then
                           v_estado := 'U';
                         else
                           v_estado := 'A';
                         end if;

                           -- Actualiza el Estado y le agrega el Mensaje Swift generado
                         update ge_snp_transferencias gt
                            set gt.msj_swift = v_msj_swift,
                                gt.estado = nvl( v_estado, gt.estado ),
                                gt.situacion=nvl( v_situacion, gt.situacion ),
                                gt.error= CASE  WHEN v_estado='R' and v_situacion='C' THEN 
                                'Transferencia cancelada por entidad emisora fuera de SPI'
                                ELSE  gt.error END
                          where gt.nro_referencia = v_nro_referencia
                            and gt.cod_msj_swift = r_gtran.cod_msj_swift;
                         if sql%notfound then
                            paw_bel.pr_mensajeUsuario(c_con_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                            paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                            prg_rol_savepoint('sipap');
                            --borrar transf. --HA-3690
                            pr_del_snp_transferencias(v_nro_referencia);							
                            return v_retorno;
                         end if;
                     end if;
                     if v_retorno.error = 'N' then
                           pas_snp.pr_obt_mensaje( v_nro_referencia, 'N' );
                           if pag_cta.fu_obt_cod_error <> 0 then
                              paw_bel.pr_mensajeUsuario(c_con_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                              paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                              prg_rol_savepoint('sipap');
                              --borrar transf. --HA-3690	
                              pr_del_snp_transferencias(v_nro_referencia);						  
                              return v_retorno;
                           end if;
                     end if;

                   end if;
                  if pae_cnf.fu_obt_est_modulo(3) IN (1,6) then----DA-7022
                     
                       paw_bel.pr_mensajeUsuario(c_op_error , v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                       paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Modulo en estado 1 o 6:' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                       prg_rol_savepoint('sipap');
                       --borrar transf --HA-3690
                       pr_del_snp_transferencias(v_nro_referencia); 					   
                       return v_retorno;
                    end if;
                 --Graba en mov nocturno para transferencias SPI
                 if v_es_mov_noc ='S' and  r_gtran.cod_msj_swift = fug_obt_pardinamico( 'COD_SPI_PCD' ) and   nvl(v_tra_spi,'N') ='S' and  nvl(v_tra_spi_ind,'N') not in ('C','R') then-- que no sean cancelar y redireccionar
                  
                   prg_gen_mov_noc_spi(v_mto_debito,
                                       v_nro_cta_debito,
                                       v_cta_pte_solicitante,
                                       v_cod_mon_debito,
                                       r_gtran.cod_msj_swift,
                                       r_gtran.cod_tip_operacion,
                                       r_gtran.cod_sub_tip_operacion,
                                       v_nro_referencia,
                                       r_gtran.nro_ref_externa,
                                       v_cod_swift,
                                       'E',
                                       'N',
                                       null,
                                       null,
                                       null,
                                       null,
                                       null,
                                       v_cod_respuesta,
                                       v_desc_respuesta);
                         
                         
                         IF v_cod_respuesta=91 then --en cierre --DA-7022

                            paw_bel.pr_mensajeUsuario(c_op_error , v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                            paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Modulo en estado 1 o 6:' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                            prg_rol_savepoint('sipap');
                            --borrar transf --HA-3690
                            pr_del_snp_transferencias(v_nro_referencia);							
                       return v_retorno;
                         elsif v_cod_respuesta != 0 THEN
                           
                           v_retorno.nombreRespuesta:=v_desc_respuesta; 
                           v_retorno.descripcionRespuesta:=v_desc_respuesta;  
                           v_retorno.error:=v_cod_respuesta;
                           paw_bel.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error );
                           prg_rol_savepoint('sipap');
						   --borrar transf --HA-3690
                           pr_del_snp_transferencias(v_nro_referencia);
                           return v_retorno;
                         END IF;
                 elsif nvl(v_tra_spi_ind,'N') <>'C' then--que no sea cancelar la transferencia
                 -- Genera el Movimiento y envia el mensaje a BCP si la fecha es actual y esta activo
                 if v_retorno.error = 'N' and
                    r_gtran.fec_valor = r_gtran.fec_ingreso and
                   ( pas_snp.fu_obt_fec_ult_operacion = r_gtran.fec_valor and nvl(v_tra_spi,'N') <> 'S') or (v_tra_spi='S' and r_gtran.fec_valor = trunc(sysdate)) /*DA-7772*/
                 then
                    if pas_snp.fu_obt_est_horario( r_gtran.cod_msj_swift,
                                     r_gtran.cod_tip_operacion,
                                     r_gtran.cod_sub_tip_operacion
                                   ) = 'A'
                     then --Si el horario está VIGENTE en BCP

                    -- se retornará la transaccion a ser utilizada para la generacion del movimiento.
                    pas_snp.pr_obt_par_mensajes( r_gtran.cod_msj_swift,    -- Tipo MT
                                                 r_gtran.cod_tip_operacion,  -- Tipo de Operacion
                                                 r_gtran.cod_sub_tip_operacion,  -- Sub-Tipo de Operacion
                                                 'E',    -- Transferencia Enviada
                                                 v_cod_mod_padre,
                                                 v_cod_mad_padre,
                                                 v_cod_tra_credito
                                                );
                    if v_cod_mon_debito <> v_cod_mon_local then
                       if v_cod_mon_credito = v_cod_mon_local then
                          v_mto_equ_local := v_mto_credito ;
                       else
                          v_mto_equ_local := null ;
                       end if ;
                    end if ;
                    --
                    pag_cta.pr_set_cod_rubro(NULL,NULL);
                    -- Setea el Nro. Documento2 para levantar el programa asociado a la mensajería a partir del movimiento generado
                    pag_cta.pr_set_nro_documento2(r_gtran.cod_msj_swift||r_gtran.cod_tip_operacion||r_gtran.cod_sub_tip_operacion);
                    --
                    --DA-10340
                    prs_snp_obt_usu_hor_mov_env(v_mensajeCaja.codigoUsuario,
                                 v_usu_mov,
                                 v_hor_mov);
                    pag_cta.pr_set_variables(v_usu_mov,--DA-10340
                                             v_fec_actual,
                                             v_cod_tra_padre, 'N', 'N',
                                             v_nro_secuencia) ;
                    -- Setea un nuevo codigo de grupo
                    --no se va a traer eli v_cod_grupo := pag_gen.fu_sig_gru_movimiento;
                    
                    IF pae_cnf.fu_obt_est_modulo(3) IN (1,6) then--DA-7022
                      
                       paw_bel.pr_mensajeUsuario(c_op_error , v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                       paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Modulo en estado 1 o 6:' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                       prg_rol_savepoint('sipap');
                       --borrar transf --HA-3690
                       pr_del_snp_transferencias(v_nro_referencia);					   
                       return v_retorno;
                   end if;
                    -- Registrar movimientos de Débito al CLIENTE
                    pag_cta.g_horario := 'D';
                    pag_cta.pr_act_operacion(v_nro_cta_debito ,     -- Nro.Cta.
                                             /*v_hor_actual*/v_hor_mov,          -- Hora
                                             'D',                   -- Tip.Mov.
                                             v_cod_mon_debito,      -- Cod.Mon.
                                             v_mto_debito,          -- Monto
                                             v_cod_tra_padre,       -- Trx.Padre
                                             v_cod_tra_debito,      -- Trx.Hija
                                             v_nro_referencia,      -- Nro.Doc.
                                             v_cot_debito,          -- Cotizacion
                                             v_cod_ofi_debito,      -- Ofic.Orig.
                                             v_cod_mod_padre,       -- Mod.Pad.Cliente
                                             v_cod_mad_padre,       -- Mad.Pad.Cliente
                                             NULL,                  -- Cod.Tasa
                                             NULL,                  -- Val.Tasa
                                             v_concepto_mov, -- Concepto
                                             'S',                   -- Emit.Aviso
                                             v_nro_secuencia,
                                             v_fec_actual,
                                             null,   -- Cod_Banco
                                             null,   -- Cod_Causa
                                             v_mto_equ_local );
                    if pag_cta.fu_obt_cod_error = 0 then
                      
                          if v_mod_estado!=pae_cnf.fu_obt_est_modulo(3) then--DA-7022
                            paw_bel.pr_mensajeUsuario(c_op_error , v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                            paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Modulo en estado 1 o 6:' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                            prg_rol_savepoint('sipap');
                            --borrar transf --HA-3690
                            pr_del_snp_transferencias(v_nro_referencia);							
                            return v_retorno;
                           
                          end if;
                       if v_cod_mon_credito <> v_cod_mon_local then
                          if v_cod_mon_debito = v_cod_mon_local then
                             v_mto_equ_local := v_mto_debito ;
                          else
                             v_mto_equ_local := null ;
                          end if ;
                       end if ;
                       v_tip_movimiento := pas_snp.fu_obt_tip_mov_transaccion(v_cod_mod_padre,v_cod_mad_padre,v_cod_tra_credito) ;

                       if nvl(pas_snp.fu_obt_cod_error,1) <> 0 then
                          paw_bel.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error );
                          prg_rol_savepoint('sipap');
                          --borrar transf --HA-3690
                          pr_del_snp_transferencias(v_nro_referencia);						  
                          return v_retorno;
                       else
                          --
                          pag_cta.pr_set_variables(v_usu_mov,--DA-10340
                                             v_fec_actual,
                                             v_cod_tra_padre, 'N', 'N',
                                             v_nro_secuencia) ;
                          --
                          -- Setea el Tipo de Movimiento del Rubro para SNP
                          pag_cta.pr_set_cod_rubro(pac_che.fu_obt_rub_cta_ban(v_cta_pte_solicitante), v_tip_movimiento);
                          -- Setea la Referencia del Movimiento para SNP
                          pag_cta.pr_set_referencia(v_cod_swift) ;
                          -- Registrar movimientos a la Cta. Interbancaria
                          pag_cta.pr_act_operacion( v_cta_pte_solicitante, -- Nro.Cta.
                                                   /*v_hor_actual*/v_hor_mov,          -- Hora
                                                    v_tip_movimiento,      -- Tip.Mov.Cta.Corresponsal
                                                    v_cod_mon_credito,     -- Cod.Mon.
                                                    v_mto_credito,         -- Monto
                                                    v_cod_tra_padre,       -- Trx.Padre
                                                    v_cod_tra_credito,     -- Trx.Hija
                                                    v_nro_referencia,      -- Nro.Doc.
                                                    v_cot_credito,         -- Cotizacion
                                                    v_cod_ofi_debito,      -- Ofic.Orig.
                                                    v_cod_mod_padre,       -- Mod.Pad.Cliente
                                                    v_cod_mad_padre,       -- Mad.Pad.Cliente
                                                    NULL,                  -- Cod.Tasa
                                                    NULL,                  -- Val.Tasa
                                                    v_concepto_mov,
                                                    'S',                   -- Emit.Aviso
                                                    v_nro_secuencia,
                                                    v_fec_actual,
                                                    null,   -- Cod_Banco
                                                    null,   -- Cod_Causa
                                                    v_mto_equ_local );
                          if pag_cta.fu_obt_cod_error = 0 then
                             --Para las transferencias que corresponden a SNP se debe cargar este campo. No así para la generacion de cargos.
                             pag_cta.pr_set_nro_documento2 (null);
                             --
                             pas_snp.pr_obt_mensaje( v_nro_referencia, 'N' );
                             if pag_cta.fu_obt_cod_error <> 0 then
                                paw_bel.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                                prg_rol_savepoint('sipap');
								                pr_del_snp_transferencias(v_nro_referencia); --HA-3690
                                return v_retorno;
                             else -- No tuvo ERRORES
                                pas_snp.pr_gen_mov_cargo( r_gtran,
                                                          v_nro_cta_debito,
                                                          v_cta_pte_solicitante,
                                                          v_mto_credito,
                                                          v_hor_actual,
                                                          v_nro_secuencia
                                                        );
                                if pag_cta.fu_obt_cod_error <> 0 then
                                   paw_bel.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                   paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                                   prg_rol_savepoint('sipap');
                                   --borrar transf --HA-3690
                                   pr_del_snp_transferencias(v_nro_referencia);								   
                                   return v_retorno;
                                end if;

                                 BEGIN
                                    -- Actualiza la Transferencia
                                    update ge_snp_transferencias gt
                                       set gt.fecha       = v_fec_actual,
                                           gt.hora        = v_hor_mov,--v_hor_actual,
                                           gt.cod_usuario = v_usu_mov--v_mensajeCaja.codigoUsuario
                                     where gt.nro_referencia = v_nro_referencia
                                       and gt.cod_msj_swift = r_gtran.cod_msj_swift ;
                                    if sql%notfound then
                                       paw_bel.pr_mensajeUsuario(c_con_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                       paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                                       prg_rol_savepoint('sipap');
                                       --borrar transf --HA-3690
                                       pr_del_snp_transferencias(v_nro_referencia);									   
                                       return v_retorno;
                                    end if;
                                  END;

                          --registro el movimiento --HA-3690
                          --guarda el nro de referencia en bw_movimientos en dato2, para utilizarlo como join con ge_movimientos en la funcion lf_obt_tot_transacciones
                          paw_con.pr_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/,
                                            v_cod_mon_debito /*p_cod_moneda */,
                                            v_mto_debito /*p_monto*/,
                                            null /*p_nro_cta_contra*/,
                                            null,
                                            'Entidad_Destino',
                                            v_cod_swift,
                                            'Nro. Referencia',
                                            v_nro_referencia,
                                            v_concepto,
                                            v_nro_ip,
                                            v_modo||'-'||retObtenerPermisos.canAutRequeridas,
                                            userInfo.codigoPersona,
                                            c_cod_operacion,
                                            v_nro_referencia,
                                            C_COD_HOMEBANKING,
                                            v_sesion,
                                            userInfo.codigoEmpresa
                                            );                                  

                             end if;
                          else
                             paw_bel.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                             paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                             prg_rol_savepoint('sipap');
                             --borrar transf --HA-3690
                             pr_del_snp_transferencias(v_nro_referencia);							 
                             return v_retorno;
                          end if ;
                       end if ;
                    else
                       if pag_cta.fu_obt_cod_error = 31 then
                          paw_bel.pr_mensajeUsuario(c_sal_insufiente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                          prg_rol_savepoint('sipap');
                          --borrar transf --HA-3690
                          pr_del_snp_transferencias(v_nro_referencia);						  
                          return v_retorno;
                       else
                          paw_bel.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                          prg_rol_savepoint('sipap');
						              --borrar transf --HA-3690
                          pr_del_snp_transferencias(v_nro_referencia);
                          return v_retorno;
                       end if;
                    end if;
                   -- Si está todo OK envía la transferencia al Socket -- solo si no está en lista de cumplimiento
                   if v_retorno.error = 'N' and v_cod_per_cumplimiento is null and  not v_lim_excedido
                     and  r_gtran.cod_msj_swift = 103 then


                       if pas_snp.fu_obt_cod_error = 31 then
                         paw_bel.pr_mensajeUsuario(c_err_hor_cerrado, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                         paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                         prg_rol_savepoint('sipap');
                         --borrar transf --HA-3690
                         pr_del_snp_transferencias(v_nro_referencia);						 
                         return v_retorno;
                       elsif pas_snp.fu_obt_cod_error <> 0 then
                         paw_bel.pr_mensajeUsuario(c_err_env_swift, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                         paw_bel.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                         prg_rol_savepoint('sipap');
                         --borrar transf --HA-3690
                         pr_del_snp_transferencias(v_nro_referencia);						 
                         return v_retorno;
                      end if;
                       pas_snp.pr_gen_arc_swift(v_nro_referencia, 'N','A') ;
					             commit; --HA-3690
                   end if ;

                   end if;

                 end if ;
              end if ;--- ver si el registro siguiente no afectaria
              end if ;
             
             pre_cam_for_numerico('.,');
             v_retorno.nro_referencia:=v_nro_referencia;
             return v_retorno;

  EXCEPTION
        WHEN OTHERS THEN
           pre_cam_for_numerico('.,');
           v_error:=sqlerrm;
           pr_mensajeUsuario(MSG_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, null, c_cod_operacion, null, 'fuw_transferenciaSipap-' || SQLERRM || '-' || paw_bel.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
           prg_rol_savepoint('sipap');
           pr_del_snp_transferencias(v_nro_referencia); --TRFS-415 --
           RETURN v_retorno;
  END;
  /*
   Function para obtener el codigo swift.
   */
  FUNCTION lf_obt_bco_swift(p_cod_banco ge_bancos.cod_banco%TYPE)
     RETURN varchar2 IS
     vcod_swift ge_bancos.cod_swift%TYPE;
  Begin
     select cod_swift
       into vcod_swift
       from ge_bancos
      where cod_banco = p_cod_banco;
     return vcod_swift;
   exception
     when no_data_found then
       return('Banco no registrado en el Sistema');
  End lf_obt_bco_swift;
  
     /*Procesar la devolucion de transferencias SPI*/
   FUNCTION fu_DevolucionSPI (p_cod_persona   in varchar2,
                              p_ref_tra_original in varchar2,
                              p_cod_canal      in varchar2,
                              p_modo             in varchar2,
                              p_mot_devol        in varchar2,
                              p_monto            in number) 
                              return typ_devolucionSpi IS
                              
     v_retorno         typ_devolucionSpi:=typ_devolucionSpi;
     v_sesion          varchar2(32);
     v_cod_canal       varchar2(3);
     v_modo            varchar2(1);   -- modo V-validacion o C-confirmacion
     v_monto           ge_snp_transferencias.monto%type;
     v_tra_original    ge_snp_transferencias.nro_ref_externa%type;
     v_tip_mensaje     varchar2(3)    := '026';
     v_parametros      varchar2(4000);
     v_motivo          varchar2(3);
     v_cod_solicitud   ge_spi_solicitudes.cod_sol_spi%type;
     v_cod_retorno     number(5)      :=0;
     v_men_retorno     varchar2(2000);
     r_gtran           pas_snp.rg_msj;
   BEGIN
       pre_cam_for_numerico('.,');
       v_cod_canal    := depurarAlfanumerico(p_cod_canal, 3);
       v_sesion       := depurarAlfanumerico('P'||p_cod_persona,32);
       v_monto        := nvl(depurarNumerico(p_monto, 18), 0);
       v_modo         := depurarAlfanumerico(p_modo, 1);
       v_tra_original := depurarAlfanumerico(p_ref_tra_original,33);
       v_motivo       := depurarAlfanumerico(p_mot_devol, 3);
       
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,v_retorno.error);
      
       v_parametros:= 'fu_devolucionSPI' || ' ref. orig.: ' || p_ref_tra_original || ' monto: ' ||p_monto || 
                       ' persona: '||p_cod_persona||' motivo: '||p_mot_devol||
                       ' canal: ' || p_cod_canal || ' modo: ' || p_modo;
                         
       pr_insertarBitacora(p_cod_persona, v_cod_canal, v_sesion, v_tip_mensaje,
                          null,
                          v_parametros,
                          bitacora_entrada);
     if v_modo='V' then
       
         pas_spi.pr_val_dev_spi(v_tra_original,
                                v_monto,
                                'H',
                                v_cod_retorno,
                                v_men_retorno);                  
     else --modo C - V
         prg_cre_savepoint('spi');
         pas_spi.pr_pro_env_004(v_tra_original,
                                v_monto,
                                'H',
                                v_motivo,
                                'C',
                                r_gtran ,
                                v_cod_retorno,
                                v_men_retorno,
                                v_cod_solicitud,
                                user);
 
         if v_cod_retorno!=0 then        
            prg_rol_savepoint('spi');
         else
             v_retorno.numeroReferencia :=r_gtran.nro_referencia;
         end if; 
      end if;
      
      v_retorno.nombreRespuesta     :=v_cod_retorno;
      v_retorno.descripcionRespuesta:=substr(v_men_retorno,1,2000);
      
      if v_cod_retorno!=0 then
         v_retorno.error:='S';
         pr_insertarBitacora(p_cod_persona,v_cod_canal, v_sesion, v_tip_mensaje,
                             null,
                             fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);
             
      else
          v_retorno.error:='N';
          pr_insertarBitacora(p_cod_persona,v_cod_canal, v_sesion, v_tip_mensaje,
                              null,
                              case 
                              when v_modo in ('C','A') then ' Ref.: '||v_retorno.numeroReferencia||' '
                              else null
                              end ||
                              fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),
                              bitacora_salida);
                              
           if v_modo in ('C','A') then
               paw_con.pr_reg_operacion(r_gtran.nro_cta_solicitante,
                                        r_gtran.cod_moneda,
                                        r_gtran.monto,
                                        null,
                                        null,
                                        'Entidad_Destino',
                                        nvl(r_gtran.cod_swi_suc_beneficiario,r_gtran.cod_swi_pte_beneficiario),
                                        'Nro. Referencia',
                                        r_gtran.nro_referencia,
                                        r_gtran.concepto,
                                        null,
                                        v_modo,
                                        p_cod_persona,
                                        v_tip_mensaje,
                                        r_gtran.nro_referencia,
                                        v_cod_canal,
                                        v_sesion,
                                        null);
           end if;
      end if;
      paw_log.g_typ_devolucionSpi := v_retorno;
      paw_log.pr_logValoresTypes('typ_devolucionSpi','fu_DevolucionSPI '||v_parametros);
      return v_retorno;
   EXCEPTION
      WHEN others THEN
         v_retorno.nombreRespuesta     :=1;
         v_retorno.descripcionRespuesta:=substr(sqlerrm,1,2000);
         v_retorno.error               :='S';
         pr_insertarBitacora(p_cod_persona,v_cod_canal, v_sesion, v_tip_mensaje,
                             null,
                             fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);
         return v_retorno;
   END fu_DevolucionSPI;
   /*Procesar solicitudes de pago SPI*/   
   FUNCTION fu_SolicitudPagoSPI(p_cod_persona     in varchar2,
                                 p_cod_canal      in varchar2,
                                 p_modo           in varchar2,
                                 p_cod_moneda     in varchar2,--moneda
                                 p_monto          in number, --monto a solicitar
                                 p_cta_sol        in varchar2, --cuenta solicitante
                                 p_cta_rec        in varchar2, --cuenta receptora
                                 p_tip_doc_rec    in varchar2, --tipo doc. del receptor       
                                 p_doc_rec        in varchar2, --documento del receptor
                                 p_nom_rec        in varchar2, --nombre del receptor
                                 p_bic_rec        in varchar2) --cod. swift del receptor
                                 return typ_solicitudPagoSpi IS
     v_sesion          varchar2(32);
     v_cod_canal       varchar2(3);
     v_modo            varchar2(1);   -- modo V-validacion o C-confirmacion
     v_bic_receptor    ge_spi_solicitudes.cod_swi_beneficiario%type;
     v_cod_persona     ge_snp_transferencias.cod_per_solicitante%type;
     v_retorno         typ_solicitudPagoSpi:=typ_solicitudPagoSpi;
     v_sub_pte         varchar2(1):='N';
     v_cod_retorno     number(5):=0;
     v_men_retorno     varchar2(2000):='OK';
     c_tip_mensaje     constant varchar2(3):='027';
     r_pago            ge_spi_solicitudes%rowtype;
     v_parametros      varchar2(4000):=null;
   BEGIN
      --depuración de parámetros
       pre_cam_for_numerico('.,');
       v_cod_canal                    := depurarAlfanumerico(p_cod_canal, 3);
       v_sesion                       := depurarAlfanumerico('P'||p_cod_persona,32);
       r_pago.monto                   := nvl(depurarNumerico(p_monto, 18), 0);
       v_modo                         := depurarAlfanumerico(p_modo, 1);
       r_pago.cod_moneda              := depurarAlfanumerico(p_cod_moneda, 3);
       r_pago.tip_doc_beneficiario    := depurarNumerico(p_tip_doc_rec,3);
       r_pago.nom_beneficiario        := depurarTextos(p_nom_rec, 120);
       v_bic_receptor                 := depurarAlfanumerico(p_bic_rec, 20);
       v_cod_persona                  := depurarAlfanumerico(p_cod_persona,10);
       r_pago.cta_solicitante         := paw_bel.depurarCuenta(p_cta_sol,35);
       r_pago.cta_beneficiario        := paw_bel.depurarAlfanumerico(p_cta_rec,35);
       
       IF r_pago.tip_doc_beneficiario = 6 AND instr(p_doc_rec,'-') != 0 then
           r_pago.doc_beneficiario := p_doc_rec;
       ELSE
           r_pago.doc_beneficiario := paw_bel.depurarAlfanumerico(p_doc_rec,20);
       END IF;
       
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,v_retorno.error);
      
       v_parametros:= 'fu_SolicitudPagoSPI' || ' persona: ' || p_cod_persona || ' moneda: ' ||p_cod_moneda || 
                       ' monto: '||p_monto||' tip. doc. receptor: '||p_tip_doc_rec||
                       ' doc. receptor: '||p_doc_rec||' nom. receptor: '||p_nom_rec||
                       ' cta. solicitante: '||p_cta_sol||' cta. receptora: '||p_cta_rec||
                       ' BIC receptor: '||p_bic_rec||
                       ' canal: ' || p_cod_canal || ' modo: ' || p_modo;
                         
       pr_insertarBitacora(v_cod_persona, v_cod_canal, v_sesion,c_tip_mensaje,
                          null,v_parametros,bitacora_entrada);
        begin
           select cod_swift_sub,cod_swift_padre
           into r_pago.cod_swi_suc_beneficiario,r_pago.cod_swi_beneficiario
           from ge_snp_patrocinador_det
           where cod_swift_sub = v_bic_receptor
           and estado = 'S';
           
           v_sub_pte:='S';
         exception
            when no_data_found then
                 r_pago.cod_swi_beneficiario:=v_bic_receptor;
                 v_sub_pte:='N';
         end;
                    
       IF v_modo='V' THEN --verificacion
          pas_spi.pr_val_sol_pago (r_pago.cod_moneda,
                           r_pago.monto,
                           r_pago.cod_swi_beneficiario,
                           v_sub_pte,
                           r_pago.cta_solicitante,          
                           v_cod_retorno,
                           v_men_retorno);
     
       ELSE  --confirmación
           r_pago.cod_msj_swift            := fug_obt_pardinamico('COD_SPI_SOL_PAGO');
           r_pago.cod_swi_solicitante      := pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad);
           r_pago.tip_doc_solicitante      := fue_obt_doc_principal(v_cod_persona);
           r_pago.doc_solicitante          := fue_obt_nro_doc_persona(v_cod_persona);
           r_pago.nom_solicitante          := fue_obt_nom_persona(v_cod_persona);
           r_pago.est_notificacion         := 'X';
           r_pago.est_solicitud            := 'U';
           r_pago.sit_solicitud            := 'P';
           r_pago.nro_ref_externa          := PAS_SPI.fu_obt_sig_nro_ref_externa;
           r_pago.cod_tip_operacion        := '003';
           pas_spi.pr_ins_sol_spi (r_pago,r_pago.cod_sol_spi);
           
           IF r_pago.cod_sol_spi IS NULL THEN  
              v_cod_retorno :=1;
              v_men_retorno :='Error al insertar la solicitud de pago';
           ELSE
                 v_retorno.referenciaExterna :=r_pago.nro_ref_externa;
                 v_retorno.codigoSolicitud   :=r_pago.cod_sol_spi;
           END IF;
       END IF;
       
       v_retorno.nombreRespuesta     :=v_cod_retorno;
       v_retorno.descripcionRespuesta:=substr(v_men_retorno,1,2000);
      
      IF v_cod_retorno!=0 THEN
         v_retorno.error:='S';
         pr_insertarBitacora(v_cod_persona,v_cod_canal, v_sesion,c_tip_mensaje,
                             null,
                             fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);
             
      ELSE
          v_retorno.error:='N';
          pr_insertarBitacora(v_cod_persona,v_cod_canal, v_sesion,c_tip_mensaje,
                              null,
                              fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),
                              bitacora_salida);
                              
           IF v_modo in ('C','A') THEN
               paw_con.pr_reg_operacion(r_pago.cta_solicitante,
                                        r_pago.cod_moneda,
                                        r_pago.monto,
                                        null,
                                        null,
                                        'Entidad_Destino',
                                        nvl(r_pago.cod_swi_suc_beneficiario,r_pago.cod_swi_beneficiario),
                                        'Ref. Externa',
                                        r_pago.nro_ref_externa,
                                        'Solicitud de Pago',
                                        null,
                                        v_modo,
                                        v_cod_persona,
                                        c_tip_mensaje,
                                        r_pago.cod_sol_spi,
                                        v_cod_canal,
                                        v_sesion,
                                        null);
                                        
           END IF;
      END IF;
      paw_log.g_typ_solicitudPagoSpi := v_retorno;
      paw_log.pr_logValoresTypes('typ_solicitudPagoSpi','fu_SolicitudPagoSPI '||v_parametros);
      return v_retorno;
   EXCEPTION
        WHEN OTHERS THEN
          v_retorno.nombreRespuesta     :=1;
          v_retorno.descripcionRespuesta:=substr(sqlerrm,1,2000);
          v_retorno.error               :='S';
          pr_insertarBitacora(v_cod_persona,v_cod_canal, v_sesion, c_tip_mensaje,
                              null,
                              fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),
                              bitacora_error);
          return v_retorno;  
   END fu_SolicitudPagoSPI;
   /*Procesar solicitudes de Devolucion SPI*/
  FUNCTION fu_SolicitudDevolucionSPI (p_cod_persona   in varchar2,
                                      p_ref_tra_original in varchar2,
                                      p_cod_canal      in varchar2,
                                      p_modo             in varchar2,
                                      p_mot_devol        in varchar2,
                                      p_monto            in number) 
                                      return typ_solicitudDevolucionSpi IS
                              
     v_retorno         typ_solicitudDevolucionSpi:=typ_solicitudDevolucionSpi;
     v_sesion          varchar2(32);
     v_cod_canal       varchar2(3);
     v_modo            varchar2(1);   -- modo V-validacion o C-confirmacion
     v_monto           ge_snp_transferencias.monto%type;
     v_tra_original    ge_snp_transferencias.nro_ref_externa%type;
     v_tip_mensaje     varchar2(3)    := '028';
     v_parametros      varchar2(4000);
     v_motivo          varchar2(10);
     v_cod_solicitud   ge_spi_solicitudes.cod_sol_spi%type;
     v_cod_retorno     number(5)      :=0;
     v_men_retorno     varchar2(2000);
     r_gtran           pas_snp.rg_msj;
   BEGIN
       pre_cam_for_numerico('.,');
       v_cod_canal    := depurarAlfanumerico(p_cod_canal, 3);
       v_sesion       := depurarAlfanumerico('P'||p_cod_persona,32);
       v_monto        := nvl(depurarNumerico(p_monto, 18), 0);
       v_modo         := depurarAlfanumerico(p_modo, 1);
       v_tra_original := depurarAlfanumerico(p_ref_tra_original,33);
       v_motivo       := depurarAlfanumerico(p_mot_devol, 10);
       
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,v_retorno.error);
      
       v_parametros:= 'fu_SolicitudDevolucionSPI' || ' ref. orig.: ' || p_ref_tra_original || ' monto: ' ||p_monto || 
                       ' persona: '||p_cod_persona||' motivo: '||p_mot_devol||
                       ' canal: ' || p_cod_canal || ' modo: ' || p_modo;
                         
       pr_insertarBitacora(p_cod_persona, v_cod_canal, v_sesion, v_tip_mensaje,
                          null,
                          v_parametros,
                          bitacora_entrada);
     if v_modo='V' then
       
         pas_spi.pr_val_sol_dev_spi(v_tra_original,
                                    v_monto,
                                    'H',
                                    v_cod_retorno,
                                    v_men_retorno);                  
     else --modo C - V
         prg_cre_savepoint('spi');
         pas_spi.pr_pro_env_056(v_tra_original,
                                v_monto,
                                'H',
                                v_motivo,
                                'C',
                                r_gtran ,
                                v_cod_retorno,
                                v_men_retorno,
                                v_cod_solicitud,
                                user);
 
         if v_cod_retorno!=0 then        
            prg_rol_savepoint('spi');
         else
             --v_retorno.numeroReferencia :=r_gtran.nro_referencia;
             v_retorno.referenciaExterna :=r_gtran.nro_ref_externa;
         end if; 
      end if;
      
      v_retorno.nombreRespuesta     :=v_cod_retorno;
      v_retorno.descripcionRespuesta:=substr(v_men_retorno,1,2000);
      
      if v_cod_retorno!=0 then
         v_retorno.error:='S';
         pr_insertarBitacora(p_cod_persona,v_cod_canal, v_sesion, v_tip_mensaje,
                             null,
                             fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);
             
      else
          v_retorno.error:='N';
          pr_insertarBitacora(p_cod_persona,v_cod_canal, v_sesion, v_tip_mensaje,
                              null,
                              case 
                              --when v_modo in ('C','A') then ' Ref.: '||v_retorno.numeroReferencia||' '
                              when v_modo in ('C','A') then ' Ref.: '||v_retorno.referenciaExterna||' '
                              else null
                              end ||
                              fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),
                              bitacora_salida);
                              
           if v_modo in ('C','A') then
               paw_con.pr_reg_operacion(r_gtran.nro_cta_solicitante,
                                        r_gtran.cod_moneda,
                                        v_monto,--r_gtran.monto,
                                        null,
                                        null,
                                        'Entidad_Destino',
                                        nvl(r_gtran.cod_swi_suc_beneficiario,r_gtran.cod_swi_pte_beneficiario),
                                        'Nro. Referencia',
                                        null,--r_gtran.nro_referencia,
                                        'Sol. Dev. '||r_gtran.nro_ref_externa,--r_gtran.concepto,
                                        null,
                                        v_modo,
                                        p_cod_persona,
                                        v_tip_mensaje,
                                        v_cod_solicitud,--r_gtran.nro_referencia,
                                        v_cod_canal,
                                        v_sesion,
                                        null);
           end if;
      end if;
      paw_log.g_typ_solicitudDevolucionSpi := v_retorno;
      paw_log.pr_logValoresTypes('typ_solicitudDevolucionSpi','fu_SolicitudDevolucionSPI '||v_parametros);
      return v_retorno;
   EXCEPTION
      WHEN others THEN
         v_retorno.nombreRespuesta     :=1;
         v_retorno.descripcionRespuesta:=substr(sqlerrm,1,2000);
         v_retorno.error               :='S';
         pr_insertarBitacora(p_cod_persona,v_cod_canal, v_sesion, v_tip_mensaje,
                             null,
                             fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);
         return v_retorno;
   END fu_SolicitudDevolucionSPI;  


    /** Validacion y/o Confirmacion de Transferencias entre Cuentas
   * @param p_sesion Codigo de la sesion
   * @param p_codCanal Codigo del canal
   * @param p_nroCtaDebito Numero de la cuenta del cliente a la cual se realizara el debito
   * @param p_monto Monto de la transferencia a realizar
   * @param p_nroCtaCredito Numero de la cuenta del cliente a la cual se realizara el credito
   * @param p_modo Modo de la operacion <ul><il><b>V:</b> Verificacion</il><il>  <b>C:</b> Confirmacion</il></ul>
   * @param p_cotizacion Cotizacion con la cual se realiza la operacion
   * @param p_mtoCredito Monto de credito
   * @param p_concepto Descripcion de la operacion ingresada por el usuario
   * @param p_nroDocCredito Número de Documento de la Cuenta de Credito
   * @param p_conCambio Número de Contrato de Cambios
   * @param p_cotCredito Cotizacion de Credito
   * @param p_claveToken Clave Token
   * @param p_esTercero Indica si la Transferencia es a un Tercero
   * @return Informacion sobre el resultado de la Transferencia
   *
   * Productos: se comenta cod_grupo, el ajuste se realizará en otro issue
   */

  FUNCTION fu_transferencias
  (
     p_codigoPersona         IN VARCHAR2,
     p_codigoEmpresa IN VARCHAR2,
     p_codcanal           IN VARCHAR2,
     p_nroctadebito       IN VARCHAR2,
     p_monto              IN NUMBER,
     p_nroctacredito      IN VARCHAR2,
     p_modo               IN VARCHAR2,
     p_cotizacion         IN NUMBER,
     p_mtocredito         IN NUMBER,
     p_concepto           IN VARCHAR2,
     p_nrodoccredito      IN NUMBER,
     p_concambio          IN NUMBER,
     p_cotcredito         IN NUMBER,
     p_clavetransaccional IN VARCHAR2,
     p_estercero          IN VARCHAR2 DEFAULT NULL,
     p_consumidor         IN VARCHAR2 DEFAULT NULL,
     p_cod_tra_padre_d    IN NUMBER DEFAULT NULL,
     p_cod_tra_padre_c    IN NUMBER DEFAULT NULL,
     p_cod_mod_padre_d    IN NUMBER DEFAULT NULL,
     p_cod_mod_padre_c    IN NUMBER DEFAULT NULL,
     p_cod_mad_padre_d    IN NUMBER DEFAULT NULL,
     p_cod_mad_padre_c    IN NUMBER DEFAULT NULL,
     p_cod_tra_debito     IN NUMBER DEFAULT NULL,
     p_cod_tra_credito    IN NUMBER DEFAULT NULL   
    
  ) RETURN typ_transferencia IS
     c_tra_cta_cre_deb_igual CONSTANT VARCHAR2(3) := 200;
     c_tra_err_conversion    CONSTANT VARCHAR2(3) := 203;
     c_tra_mto_invalido      CONSTANT VARCHAR2(3) := 204;
     c_tra_cta_cre_error     CONSTANT VARCHAR2(3) := 212;
     c_tra_cta_deb_error     CONSTANT VARCHAR2(3) := 213;
     --
     c_cod_cta_invalida      CONSTANT VARCHAR2(3) := '114';
     c_cod_cta_doc_invalido   CONSTANT VARCHAR2(3) := '327';
     c_cod_cta_lim_permitio   CONSTANT VARCHAR2(3) := '328';
     c_cod_cta_inv_combinada CONSTANT VARCHAR2(3) := '252';
     c_cod_sin_autorizacion  CONSTANT VARCHAR2(3) := '108';
     c_cod_lim_excedido      CONSTANT VARCHAR2(3) := '136';
     c_cont_cambio_invalido  CONSTANT VARCHAR2(3) := '162';
     c_cod_mto_invalido      CONSTANT VARCHAR2(3) := '121';
     c_cod_tra_prohibida     CONSTANT VARCHAR2(3) := '110';
     c_cod_mov_ya_ingresado  CONSTANT VARCHAR2(3) := '134';
     c_cod_cta_duplicada     CONSTANT VARCHAR2(3) := '102';
     SAL_PER_SIN_AUT         CONSTANT VARCHAR2(15):= 'SAL_PER_SIN_AUT';
     MSG_COD_CTA_CONJUNTA    CONSTANT VARCHAR2(15) := 'CTA_CONJUNTA';
     c_op_error              CONSTANT VARCHAR2(15) := 'OP_ERROR';
     c_paympvu               CONSTANT VARCHAR2(20) := 'PAYMENT_SUPPLIERS';
     PRE_MON_LOC_INVALIDA CONSTANT VARCHAR2(15) := 'PRE_MON_LOC_INV';
     
     v_retorno          typ_transferencia := typ_transferencia;
     v_tip_mensaje      VARCHAR2(3) := '030';
     retValidarSesion   typ_validarsesion;
     retError           typ_mensajerespuesta := typ_mensajerespuesta;
     v_mensajeCaja      typ_mensajecaja;
     retObtenerPermisos typ_obtenerpermisos;

     v_nro_cta_debito  VARCHAR2(16);
     v_monto           NUMBER(18, 2); -- monto a transferir
     v_monto_gs        NUMBER(18, 2); -- monto a transferir
     v_nro_cta_credito VARCHAR2(17);  -- cuenta de credito
     v_modo            VARCHAR2(1);   -- modo V-validacion o C-confirmacion
     -- variables
     v_cta_for_debito  VARCHAR2(17); -- cuenta formateada
     v_cod_mon_debito  VARCHAR2(3);  -- moneda de la cuenta
     v_nom_cta_debito  VARCHAR2(100);
     v_cod_mon_credito VARCHAR2(3);  -- moneda de la cuenta
     v_cta_for_credito VARCHAR2(17); -- cuenta formateada
     v_est_cta_credito VARCHAR2(1);  -- estado de la cuenta
     v_nvo_est_credito VARCHAR2(1) := NULL; -- cambio de estado de cuenta
     v_nom_cta_credito VARCHAR2(100);
     v_procesa         VARCHAR2(1) := 'N'; -- indica si se puede o no procesar
     v_nro_doc_credito VARCHAR2(20) := NULL; -- nro de documento del acreditado
     v_concepto        VARCHAR2(35);
     v_es_tercero      VARCHAR2(1) := 'N';
     v_dir_ip          VARCHAR2(200);
     v_sesion          VARCHAR2(32);
     v_cod_respuesta   VARCHAR2(20);
     v_cod_canal       VARCHAR2(3);
     v_es_mov_noc      VARCHAR2(1) := 'N';
     v_horario         VARCHAR2(1) := 'D'; -- Dia normal
     v_hor_actual      VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
     v_es_cta_noc      VARCHAR2(1) := 'N'; -- Graba S/N ctas noctunas

     v_cod_mod_debito  NUMBER(4); -- modulo de la cuenta
     v_cod_mad_debito  NUMBER(4); -- modalidad de la cuenta
     v_cod_ofi_debito  NUMBER(4); -- oficina de la cuenta
     v_cot_debito      NUMBER(18, 4) := NULL;
     v_nro_contrato    NUMBER(7) := 0;
     v_mto_contrato    NUMBER(18, 2);
     v_cod_mod_credito NUMBER(4); -- modulo de la cuenta
     v_cod_mad_credito NUMBER(4); -- modalidad de la cuenta
     v_cod_ofi_credito NUMBER(4); -- oficina de la cuenta
     v_sal_dis_credito NUMBER(18, 2);
     v_mto_credito     NUMBER(18, 2) := v_monto;
     v_cot_credito     NUMBER(18, 4) := NULL;
     v_mto_equ_local   NUMBER(18) := NULL;
     --v_cod_tra_padre   NUMBER(4) := 388; -- cod. transaccion padre --PHT TCE-217
     v_cod_tra_padre_d NUMBER(4) := nvl(p_cod_tra_padre_d,388); --TCE-217
     v_cod_tra_padre_c NUMBER(4) := nvl(p_cod_tra_padre_c,388); --TCE-217
     v_cod_mod_padre_d NUMBER(4) := nvl(p_cod_mod_padre_d,9);  --TCE-217
     v_cod_mod_padre_c NUMBER(4) := nvl(p_cod_mod_padre_c,9);  --TCE-217
     v_cod_mad_padre_c NUMBER(4) := nvl(p_cod_mad_padre_d,91);  --TCE-217     
     v_cod_mad_padre_d NUMBER(4) := nvl(p_cod_mad_padre_c,91);  --TCE-217
     v_cod_trans_debi  NUMBER(4) := nvl(p_cod_tra_debito,503);  --TCE-217
     v_cod_trans_cred  NUMBER(4) := nvl(p_cod_tra_credito,602);  --TCE-217
     v_cotizacion      NUMBER(18, 4) := NULL;
     v_nro_documento   NUMBER(15);
     v_mto_limite      NUMBER(18, 2); -- monto limite para transferencias
     v_tot_realizado   NUMBER(18, 2); --
     v_mto_tot_036     NUMBER(18, 2); -- Monto Total de Transferencia Interbancaria
     v_con_contrato    NUMBER(5); --contador para verificar contrato valido
     v_mto_lim_canal   NUMBER(18, 2);
     v_nro_secuencia   NUMBER;
     v_nro_operacion   NUMBER;
     v_cotiza     ge_cotizaciones.val_compra%TYPE;      
     v_cot_lim_des        ge_cotizaciones.val_compra%TYPE;
     v_cod_mon_fuerte     ba_monedas.cod_moneda%TYPE := pag_gen.fu_obt_mon_fuerte;
     v_nro_telefono       bw_movimientos.nro_telefono%TYPE;
     v_claveTransaccional bw_ope_claves.clave%TYPE;

     v_fec_actual         DATE := pag_cal.fu_obt_fec_actual(9);
     v_fec_valor          DATE := v_fec_actual;
     v_fec_servidor       DATE := trunc(sysdate);
     v_cta_limite ge_cuentas.nro_cuenta%type;
     v_cod_cli_credito    ba_personas.cod_persona%type;
     v_cod_cli_debito     ba_personas.cod_persona%type;
     v_inf_deb_json long:=null;
     v_inf_cre_json long:=null;
     v_fec_hora varchar2(20);

     v_ind_usuario varchar2(1);
     v_hor_sysdate      VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS');
     --TRFS-1454
    v_cod_usuario            ba_usuarios.cod_usuario%type;
     PROCEDURE lp_obt_doc_beneficiario(p_reg_snp in out pas_snp.rg_msj, 
                                       p_cod_persona in ba_personas.cod_persona%type) IS 
     
     BEGIN
        SELECT p.cod_tip_documento, p.nro_documento
        INTO p_reg_snp.cod_tip_doc_beneficiario, p_reg_snp.nro_doc_beneficiario
        FROM ba_personas p
        WHERE p.cod_persona = p_cod_persona;
        EXCEPTION
          WHEN OTHERS THEN
            NULL;
     END;
     PROCEDURE lp_obt_doc_solicitante(p_reg_snp in out pas_snp.rg_msj, 
                                       p_cod_persona in ba_personas.cod_persona%type) IS 
     
     BEGIN
        SELECT p.cod_tip_documento, p.nro_documento
        INTO p_reg_snp.cod_tip_doc_solicitante, p_reg_snp.nro_doc_solicitante
        FROM ba_personas p
        WHERE p.cod_persona = p_cod_persona;
        EXCEPTION
          WHEN OTHERS THEN
            NULL;
     END;
  BEGIN
     pre_cam_for_numerico('.,');
     v_cod_canal := depurarAlfanumerico(p_codcanal, 3);
     v_sesion    := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
     v_cot_Credito := DepurarNumerico(p_cotcredito, 7);
     v_claveTransaccional  := trim(p_clavetransaccional);
     --valido la sesion del cliente

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,
                       v_retorno.error);
     --retValidarSesion := fu_validarSesion(v_sesion, v_cod_canal);
       retValidarSesion.error:='N';
       retValidarSesion.codigoCanal:=v_cod_canal;
       retValidarSesion.codigoPersona:=p_codigoPersona;
       retValidarSesion.codigoEmpresa:=p_codigoEmpresa;

     IF retValidarSesion.error = 'S' THEN
        v_retorno.error                := retValidarSesion.error;
        v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
        v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
        /*Obtiene la informacion de parámetros recibos y el return del type*/
        paw_log.g_typ_transferencia := v_retorno;
        paw_log.pr_logValoresTypes('typ_transferencia',
        'fu_Tranferencia Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
        p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
        p_cotizacion||', '|| p_mtocredito||', '||
        p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||v_cot_Credito);
        RETURN v_retorno;
     END IF;

    -- v_mensajeCaja := lf_val_caja(retValidarSesion);
        v_mensajeCaja := fu_obt_mov_user('TRANSFERS');
     IF v_mensajeCaja.error = 'S' THEN
        v_retorno.error                := v_mensajeCaja.error;
        v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
        /*Obtiene la informacion de parámetros recibos y el return del type*/
        paw_log.g_typ_transferencia := v_retorno;
        paw_log.pr_logValoresTypes('typ_transferencia',
        'fu_Tranferencia Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
        p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
        p_cotizacion||', '|| p_mtocredito||', '||
        p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||v_cot_Credito);
        RETURN v_retorno;
     ELSE
        v_ind_usuario:=substr(v_mensajeCaja.codigoUsuario,instr(v_mensajeCaja.codigoUsuario,'_',1)+1,1);
       
        if v_ind_usuario is null then
           v_ind_usuario:=0;
           v_mensajeCaja.codigoUsuario:='TRANSFER_0';
           v_mensajeCaja.codigoOficinaOrigen := fug_obt_ofi_usuario('TRANSFER_0');
         end if;

      --controla horario cierre
          v_tra_spi := 'S';
           --v_hor_actual:=fu_obt_hora(v_ind_usuario);
           --TCE-253  
         if p_consumidor is not null then
                 if p_consumidor =c_paympvu then
                    pr_obt_usu_hor_mov_int('PAYMPVU',
                                    v_cod_usuario,
                                    v_hor_actual);
                  else
                    pr_obt_usu_hor_mov_int('TRANINT',
                                    v_cod_usuario,
                                    v_hor_actual);
                 end if;
          else
          ---api legacy no envia consumidor
           pr_obt_usu_hor_mov_int('TRANINT',
                                    v_cod_usuario,
                                    v_hor_actual);
           end if;
          reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                      v_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                      -- IN
                                      v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                      -- IN
                                      v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

           IF reterror.error = 'S' THEN
              v_retorno.error                := reterror.error;
              v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
              v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
              RETURN v_retorno;
           END IF;
          v_tra_spi := 'N';

     END IF;

      -- verifica si tiene permiso para transferencia a otro titular
      retobtenerpermisos := lf_obt_permisos(nvl(retValidarSesion.codigoEmpresa,
                                                retValidarSesion.codigoPersona),
                                            retValidarSesion.codigoperfil /*v_cod_perfil*/, v_tip_mensaje,
                                            v_cod_canal);

      IF retobtenerpermisos.error = 'S' THEN
         pr_mensajeUsuario(SAL_PER_SIN_AUT, v_retorno.nombreRespuesta,
                           v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                             retValidarSesion.codigoEmpresa,
                             'fu_transferencias' ||
                              'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                              v_nro_cta_credito || ' ' ||
                              fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);
      END IF;

        IF retobtenerpermisos.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
          pr_mensajeUsuario(SAL_PER_SIN_AUT,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona,p_codCanal,v_sesion,v_cod_operacion,retValidarSesion.codigoEmpresa,
          fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),BITACORA_ERROR);

           /*Obtiene la informacion de parámetros recibos y el return del type*/
           paw_log.g_typ_transferencia := v_retorno;
           paw_log.pr_logValoresTypes('typ_transferencia',
           'fu_Tranferencia'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
           p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
           p_cotizacion||', '|| p_mtocredito||', '||
           p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);
          RETURN v_retorno;
        END IF;
     -- 0. inicializo la secuencia
     v_nro_secuencia   := 0;
     IF v_ind_cta_encriptada = 'S' THEN
        v_nro_cta_debito  := fu_desencriptacionCuentas(depurarCuenta(p_nroctadebito, cuenta_tamano));
     ELSE
        v_nro_cta_debito  := depurarCuenta(p_nroctadebito, cuenta_tamano);
     END IF;
     v_nro_cta_credito := depurarCuenta(p_nroctacredito, cuenta_tamano);
     v_monto           := paw_bel.depurarNumerico(p_monto, 18, 'S');
      
    --TRFS-1112
    /* Validacion de moneda local con decimales */
    IF lf_obt_moneda(v_nro_cta_debito) = pag_gen.FU_OBT_MON_LOCAL AND v_monto <> paw_bel.depurarNumerico(p_monto, 18) THEN
		   pr_mensajeUsuario(PRE_MON_LOC_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(retValidarSesion.codigoPersona,retValidarSesion.codigoCanal,v_sesion,v_cod_operacion,retValidarSesion.codigoEmpresa,
                           'fu_transferencias' || 'Cta Deb:' || v_nro_cta_debito || ' cta cre:' ||
                            v_nro_cta_credito || ' mto:' || v_monto || ' modo:' || v_modo || ' ' ||
                           fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta,retValidarSesion.descripcionRespuesta, NULL),
                           BITACORA_ERROR);

       RETURN v_retorno;
    END IF;
     
     
     v_modo            := depurarAlfanumerico(p_modo, 1);
     v_concepto        := depurarTextos(p_concepto, 35);
     -- 0. inicializo la secuencia
     v_nro_secuencia := 0;
     -- viene de confirmacion de una autorizacion
     v_mto_credito     := nvl(depurarNumerico(p_mtocredito, 18), 0);
     v_nro_doc_credito := depurarAlfanumerico(p_nrodoccredito, 20);
     v_nro_contrato    := nvl(depurarNumerico(p_concambio, 7), 0);
     v_es_tercero      := nvl(depurarAlfanumerico(p_estercero, 1), 'N');
     v_dir_ip          := NULL;
     v_nro_telefono    := v_dir_ip;
     v_cotizacion      := nvl(depurarNumerico(p_cotizacion, 7), 0);
     
      -- se busca codigo de persona para las cuentas debito y credito
     begin
     select cod_persona
     into v_cod_cli_debito
     from ge_cta_clientes
     where nro_cuenta = v_nro_cta_debito
     and relacion = 'P';
     exception
       when others then
         v_cod_cli_debito := null;
     end;
     
     begin
     select cod_persona
     into v_cod_cli_credito
     from ge_cta_clientes
     where nro_cuenta = v_nro_cta_credito
     and relacion = 'P';
     exception
       when others then
         v_cod_cli_credito := null;
     end;

     --Valida que la cuenta no sea conjunta
     IF nvl(v_modo, 'x') = 'V' THEN
        IF fu_es_conjunta(v_nro_cta_debito,retValidarSesion.codigoPersona,retValidarSesion.codigoEmpresa) = 'S'
          and nvl(p_consumidor, 'DFL') <> c_paympvu THEN --TCE-806 - Se agrego una condicion mas para que valide por consumidor
           pr_mensajeUsuario(MSG_COD_CTA_CONJUNTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona,
               retValidarSesion.codigoCanal,
               v_sesion,
               v_cod_operacion,
               retValidarSesion.codigoEmpresa,
               'fu_transferencias' || 'Cta Deb:' || v_nro_cta_debito || ' cta cre:' ||
                          v_nro_cta_credito || ' mto:' || v_monto || ' modo:' || v_modo || ' ' ||
                          fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta,
                                             retValidarSesion.descripcionRespuesta, NULL),
               BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
     END IF;

  /* No se usa transaccional
  IF nvl(v_modo, 'x') = 'C' THEN
        IF v_clavetransaccional IS  NULL THEN
            pr_mensajeUsuario(c_cod_cta_duplicada, v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, v_retorno.error);

          --Obtiene la informacion de parámetros recibos y el return del type
           paw_log.g_typ_transferencia := v_retorno;
           paw_log.pr_logValoresTypes('typ_transferencia',
           'fu_Tranferencia Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
           p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
           v_cotizacion||', '|| p_mtocredito||', '||
           p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);
           RETURN v_retorno;
        END IF;
     END IF;
*/
     IF v_es_tercero = 'N' THEN
       IF v_ind_cta_encriptada = 'S' THEN
          v_nro_cta_credito := fu_desencriptacionCuentas(v_nro_cta_credito);
       END IF;
     END IF;
     pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                         retValidarSesion.codigoEmpresa,
                         'fu_transferencias' || 'Cta Deb:' || v_nro_cta_debito || ' cta cre:' ||
                          v_nro_cta_credito || ' mto:' || v_monto || ' modo:' || v_modo || ' ' ||
                          fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta,
                                             retValidarSesion.descripcionRespuesta, NULL),
                         bitacora_entrada);

     IF nvl(v_modo, 'x') <> 'A' THEN
        DECLARE
           v_lugar VARCHAR2(50);
        BEGIN
           -- Ajuste por requerimiento de control de clave en la verificacion
           -- antes de envio a bancard, se recibe pedido en modo V para validar la clave transaccional
           IF (v_modo = 'C' AND p_clavetransaccional IS NOT NULL) THEN
              v_lugar  := 'lf_obt_cla_validar: ';
              reterror := lf_obt_cla_validar(v_claveTransaccional, retValidarSesion.codigoPersona,
                                             retValidarSesion.codigoEmpresa, 'T');
           END IF;
           IF reterror.error = 'S' THEN
              v_retorno.error                := reterror.error;
              v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
              v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codcanal, v_sesion,
                                  v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                  'fu_transferencias' || v_lugar ||
                                   fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                      v_retorno.descripcionRespuesta, NULL),
                                  bitacora_error);

              /*Obtiene la informacion de parámetros recibos y el return del type*/
              paw_log.g_typ_transferencia := v_retorno;
              paw_log.pr_logValoresTypes('typ_transferencia',
              'fu_Tranferencia Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
              p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
              v_cotizacion||', '|| p_mtocredito||', '||
              p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);

              RETURN v_retorno;
           END IF;
        END;
     END IF;

     IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
        -- se confirma directamente la operacion, porque no requiere autorizacion
        v_modo := 'A'; -- CONFIRMACION
     END IF;

     -- 1. valido la clave del cliente
     IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
        -- se confirma directamente la operacion, porque no requiere autorizacion
        v_modo := 'A'; -- CONFIRMACION
     END IF;
     -- genero el número de operacion
     SELECT s_nro_operacion.nextval INTO v_nro_operacion FROM dual;

     BEGIN
        IF nvl(v_nro_contrato, 0) = 0 THEN
           SELECT nvl(a.nro_contrato, 0)
             INTO v_nro_contrato
             FROM lc_con_cambios a, bw_mov_pendientes b
            WHERE b.nro_cuenta = a.nro_cta_debito
              AND a.estado = 'P'
              AND ((a.mto_compra = b.mto_contra) OR (a.mto_compra = b.monto) OR
                  (a.mto_venta = b.mto_contra) OR (a.mto_venta = b.monto))
              AND ((a.cot_venta = b.cot_contra) OR (a.cot_venta = b.cotizacion) OR
                  (a.cot_compra = b.cot_contra) OR (a.cot_compra = b.cotizacion))
              AND b.nro_documento = nvl(to_number(v_nro_operacion), 0)
              AND trunc(a.fec_insercion) = v_fec_servidor;
        END IF;
     EXCEPTION
        WHEN no_data_found THEN
           NULL;
     END;

     IF lf_obt_moneda(v_nro_cta_debito) IS NOT NULL AND
        lf_obt_moneda(v_nro_cta_credito) IS NOT NULL THEN
        IF fug_obt_cli_principal(v_nro_cta_debito) != fug_obt_cli_principal(v_nro_cta_credito) AND
           v_es_tercero = 'S' THEN
           BEGIN
              SELECT p.nro_documento
                INTO v_nro_doc_credito
                FROM ge_cta_clientes c, ba_personas p
               WHERE c.cod_persona = p.cod_persona
                 AND c.nro_cuenta = v_nro_cta_credito
                 AND c.relacion = 'P';
           EXCEPTION
              WHEN no_data_found THEN
                 v_nro_doc_credito := NULL;
              WHEN OTHERS THEN
                 v_nro_doc_credito := NULL;
           END;
        END IF;
     ELSE
        pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                            retValidarSesion.codigoEmpresa,
                            'fu_transferencias' ||
                             'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                             v_nro_cta_credito || ' ' ||
                             fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, NULL),
                            bitacora_error);
     END IF;
     --jclg/tys no debe validar los permisos si es aprobacion de la 039
     IF v_retorno.error = 'N' AND v_nro_doc_credito IS NOT NULL AND v_modo <> 'A' THEN
        -- verifica si tiene permiso para transferencia a otro titular
        retobtenerpermisos := lf_obt_permisos(nvl(retValidarSesion.codigoEmpresa,
                                                  retValidarSesion.codigoPersona),
                                              retValidarSesion.codigoperfil /*v_cod_perfil*/, v_tip_mensaje,
                                              v_cod_canal);

        IF retobtenerpermisos.error = 'S' THEN
           pr_mensajeUsuario(c_cod_sin_autorizacion, v_retorno.nombreRespuesta,
                             v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                               retValidarSesion.codigoEmpresa,
                               'fu_transferencias' ||
                                'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                v_nro_cta_credito || ' ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                   v_retorno.descripcionRespuesta, NULL),
                               bitacora_error);
        END IF;

        IF retobtenerpermisos.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
          pr_mensajeUsuario(SAL_PER_SIN_AUT,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona,p_codCanal,v_sesion,v_cod_operacion,retValidarSesion.codigoEmpresa,
          fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),BITACORA_ERROR);

           /*Obtiene la informacion de parámetros recibos y el return del type*/
           paw_log.g_typ_transferencia := v_retorno;
           paw_log.pr_logValoresTypes('typ_transferencia',
           'fu_Tranferencia'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
           p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
           p_cotizacion||', '|| p_mtocredito||', '||
           p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);
          RETURN v_retorno;
        END IF;


     END IF;
     -- 2. busco los datos de la cuentas

     IF v_retorno.error = 'N' THEN
        -- verifico cuenta de debito
        IF v_nro_cta_debito = v_nro_cta_credito THEN
           pr_mensajeUsuario(c_tra_cta_cre_deb_igual, v_retorno.nombreRespuesta,
                             v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                               retValidarSesion.codigoEmpresa,
                               'fu_transferencias ' || 'Transaccion invalida - cta debito:' ||
                                v_nro_cta_debito || ' - cta credito:' || v_nro_cta_credito || ' ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                   v_retorno.descripcionRespuesta, NULL),
                               bitacora_error);
        ELSE
           reterror := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre_d, v_monto,
                                         v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito,
                                         v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito,
                                         retValidarSesion, v_mensajeCaja, null, null, null, p_consumidor, c_paympvu); --TCE-806
           IF reterror.error = 'S' THEN
              v_retorno.error                := reterror.error;
              v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
              v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
              pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                  v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                  'fu_transferencias ' || 'lf_val_cta_debito - ' ||
                                   v_nro_cta_debito || ')' || ' ' ||
                                   fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                      v_retorno.descripcionRespuesta, NULL),
                                  bitacora_error);
           END IF;
           IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
              -- se confirma directamente la operacion, porque no requiere autorizacion
              v_modo := 'A'; -- CONFIRMACION
           END IF;

        END IF;

        IF v_retorno.error = 'N' THEN
           -- cuenta de credito
           BEGIN
              SELECT a.cod_moneda,
                     a.estado,
                     cod_modalidad,
                     cod_modulo,
                     cod_oficina,
                      nro_cuenta cta_formateada,
                     denominacion
                INTO v_cod_mon_credito,
                     v_est_cta_credito,
                     v_cod_mad_credito,
                     v_cod_mod_credito,
                     v_cod_ofi_credito,
                     v_cta_for_credito,
                     v_nom_cta_credito
                FROM ge_cuentas a
               WHERE a.nro_cuenta = v_nro_cta_credito -- contiene el nro de cuenta
                 AND NOT EXISTS (SELECT 0
                        FROM bw_cta_accesos p
                       WHERE p.nro_cuenta = a.nro_cuenta
                         AND p.cod_per_vinculo = retValidarSesion.codigoPersona
                         AND p.tip_acceso = 'P'
                         AND p.activo = 'S');
                         
                 -- agregado para control de limites diarios de transacciones (Opcional)--solo para terceros
           if v_retorno.error = 'N' and fug_obt_cli_principal(v_nro_cta_debito) != fug_obt_cli_principal(v_nro_cta_credito) then
            if nvl(fug_obt_pardinamico('IND_LIM_CTA'),'N') = 'S' then
              v_mto_limite := fug_obt_paradicional(v_nro_cta_debito, 'LIM_CTA_TRA_TERCEROS');
              v_cta_limite:=v_nro_cta_debito;
            end if;
            if nvl(v_mto_limite,0) = 0 then 
              v_mto_limite := nvl(lf_obt_lim_cliente(v_cod_canal,nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),'039', pag_gen.FU_OBT_MON_LOCAL),0);
           end if; 
            if nvl(v_mto_limite,0) = 0 then
                  v_mto_limite := fug_obt_pardinamico('LIM_GEN_TRA_TERCEROS',
                                                   v_cod_mod_debito,
                                                   v_cod_mad_debito,
                                                   v_cod_mon_debito,
                                                   v_cod_ofi_debito);
            end if;

                                             
              v_tot_realizado := lf_obt_tot_operaciones(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona,v_cta_limite,'039',v_cod_tra_padre_c);

              if v_cod_mon_credito <> v_cod_mon_local then
                v_cotiza := pag_gen.FU_OBT_COTIZACION(pag_gen.FU_OBT_MON_FUERTE,v_fec_actual);
              else
                v_cotiza := 1;
              end if;
              v_monto_gs := nvl(v_monto,0)*v_cotiza;
              v_tot_realizado := nvl(v_tot_realizado,0)+nvl(v_monto_gs,0);

              if v_tot_realizado > v_mto_limite and nvl(v_nro_contrato,0) = 0 then
                pr_mensajeUsuario(c_cod_lim_excedido, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias ' || 'Límite Excedido - Mto. Límite:' ||
                                      v_mto_limite || ' - Total Realizado:' || v_tot_realizado || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_error);
                 return v_retorno;
              end if;
         end if;

              -- credito
              IF v_cod_mon_credito = v_cod_mon_debito AND nvl(v_nro_contrato, 0) > 0 THEN
                 pr_mensajeUsuario(c_cont_cambio_invalido, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias ' ||
                                      'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                      v_nro_contrato || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_error);
              END IF;
              IF v_cod_mon_credito <> v_cod_mon_debito THEN
                 -- moneda diferentes
                 IF nvl(p_modo, 'x') <> 'A' THEN
                    --if v_cod_respuesta = paw_bel.v_cod_aprobado then
                    IF v_retorno.error = 'N' THEN
                       IF v_nro_contrato > 0 THEN
                          -- se asigna v_cotizacion a las dos variables
                          -- al correr el proceso lp_con_mon_a_moneda, una de las
                          -- variables obtendrá su valor correcto (1) dependiendo
                          -- de las monedas de credito y debito
                          IF v_cod_mon_credito <> v_cod_mon_local AND
                             v_cod_mon_debito <> v_cod_mon_local AND
                             v_cod_mon_credito <> v_cod_mon_debito THEN
                             BEGIN
                                -- En Arbitraje siempre la cotizacion compra pertenece a la Cta. Debito
                                SELECT c.cot_compra, c.cot_venta
                                  INTO v_cot_debito, v_cot_credito
                                  FROM lc_con_cambios c
                                 WHERE c.nro_contrato = v_nro_contrato;
                             EXCEPTION
                                WHEN no_data_found THEN
                                   v_cot_debito  := NULL;
                                   v_cot_credito := NULL;
                                WHEN OTHERS THEN
                                   pr_mensajeUsuario(c_cont_cambio_invalido,
                                                     v_retorno.nombreRespuesta,
                                                     v_retorno.descripcionRespuesta, v_retorno.error);
                                   pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal,
                                                       v_sesion, v_tip_mensaje,
                                                       retValidarSesion.codigoEmpresa,
                                                       'fu_transferencias ' ||
                                                        'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                                        v_nro_contrato || ' ' ||
                                                        fu_generarBitacora(v_retorno.error,
                                                                           v_retorno.nombreRespuesta,
                                                                           v_retorno.descripcionRespuesta,
                                                                           NULL), bitacora_error);
                             END;
                          ELSE
                             v_cot_credito := v_cotizacion;
                             v_cot_debito  := v_cotizacion;
                          END IF;
                       ELSIF v_cod_mon_credito <> v_cod_mon_local AND
                             v_cod_mon_debito <> v_cod_mon_local THEN
                          -- es arbitraje y no tiene contrato de cambios
                          pr_mensajeUsuario(c_cont_cambio_invalido, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias ' ||
                                               'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                               v_nro_contrato || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);

                       END IF;
                    END IF;
                    BEGIN
                       lp_con_mon_a_moneda(v_cod_mon_debito, v_cod_mon_credito, v_monto,
                                           v_mto_credito, v_cot_debito, v_cot_credito);
                    EXCEPTION
                       WHEN OTHERS THEN
                          pr_mensajeUsuario(c_tra_err_conversion, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias ' ||
                                               'lp_con_mon_a_moneda - moneda debito:' ||
                                               v_cod_mon_debito || ' - moneda credito:' ||
                                               v_cod_mon_credito || ' - monto:' || v_monto || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                    END;
                    IF v_cod_mon_credito = v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_local THEN
                       v_mto_contrato := v_monto;
                    ELSE
                       v_mto_contrato := v_mto_credito;
                    END IF;
                    -- valido el contrato de cambio, ojo con las variables.
                    lp_val_con_cambio('V', v_nro_contrato, v_cod_mon_debito, v_cod_mon_credito,
                                      v_nro_cta_debito, v_nro_cta_credito, v_cotizacion,
                                      v_mto_contrato, v_cod_respuesta);
                 END IF;
                 IF v_cod_respuesta != msg_ok THEN
                    pr_mensajeUsuario(v_cod_respuesta, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' ||
                                         'lp_con_mon_a_moneda - moneda debito:' || v_cod_mon_debito ||
                                         ' - moneda credito:' || v_cod_mon_credito || ' - monto:' ||
                                         v_monto || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 END IF;
                 IF v_cod_mon_credito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_local AND
                    v_cod_mon_credito <> v_cod_mon_debito AND v_nro_contrato > 0 THEN
                    NULL;
                 ELSIF v_cod_mon_debito <> v_cod_mon_local THEN
                    v_cotizacion := v_cot_debito;
                 ELSE
                    v_cotizacion := v_cot_credito;
                 END IF;
              ELSE
                 v_mto_credito := v_monto;
              END IF;

              IF v_es_tercero = 'N' AND
                 fu_es_ope_limitadas(v_tip_mensaje, v_nro_cta_debito, v_cod_canal, v_fec_actual) = 'S' AND
                 v_cod_canal IN ('993', '994') AND v_retorno.error = 'N' THEN

                 IF v_cod_mon_debito = v_cod_mon_fuerte THEN
                    v_mto_lim_canal := v_monto;
                 ELSIF v_cod_mon_credito = v_cod_mon_fuerte THEN
                    v_cot_lim_des := v_cot_credito;
                 ELSE
                    BEGIN
                       lp_con_mon_a_moneda(v_cod_mon_debito, v_cod_mon_credito, v_monto,
                                           v_mto_credito, v_cot_debito, v_cot_credito);
                    EXCEPTION
                       WHEN OTHERS THEN
                          pr_mensajeUsuario(c_tra_err_conversion, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias ' ||
                                               'lp_con_mon_a_moneda - moneda debito:' ||
                                               v_cod_mon_debito || ' - moneda credito:' ||
                                               v_cod_mon_credito || ' - monto:' || v_monto || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                    END;
                 END IF;
                 IF fu_val_monto(v_mto_lim_canal, v_cod_mon_fuerte, v_tip_mensaje, v_nro_cta_debito,
                                 v_cod_canal, v_fec_actual) = 'N' THEN
                    pr_mensajeUsuario(c_cod_lim_excedido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' || 'Límite Excedido - Mto. Límite:' ||
                                         v_mto_limite || ' - Total Realizado:' || v_tot_realizado || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error, retValidarSesion.numerotelefono, '-36');
                 ELSIF v_modo = 'A' THEN

                    pr_gen_monto('030', v_mto_lim_canal, v_cod_mon_fuerte, v_nro_cta_debito,
                                 v_fec_actual, retValidarSesion.codigocanal);
                 END IF;

              END IF;

              -- Verifico el limite por Canal. SDC
              IF v_es_tercero = 'S' AND
                 fu_es_ope_limitadas('039', v_nro_cta_debito, v_cod_canal, v_fec_actual) = 'S' AND
                 v_cod_canal IN ('993', '994') AND v_retorno.error = 'N' THEN

                 IF v_cod_mon_debito = v_cod_mon_fuerte THEN
                    v_mto_lim_canal := v_monto;
                 ELSIF v_cod_mon_credito = v_cod_mon_fuerte THEN
                    v_cot_lim_des := v_cot_credito;
                 ELSE
                    BEGIN
                       lp_con_mon_a_moneda(v_cod_mon_debito, v_cod_mon_credito, v_monto,
                                           v_mto_credito, v_cot_debito, v_cot_credito);
                    EXCEPTION
                       WHEN OTHERS THEN
                          pr_mensajeUsuario(c_tra_err_conversion, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias ' ||
                                               'lp_con_mon_a_moneda - moneda debito:' ||
                                               v_cod_mon_debito || ' - moneda credito:' ||
                                               v_cod_mon_credito || ' - monto:' || v_monto || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                    END;

                 END IF;
                 IF fu_val_monto(v_mto_lim_canal, v_cod_mon_fuerte, '039', v_nro_cta_debito,
                                 v_cod_canal, v_fec_actual) = 'N' THEN

                    pr_mensajeUsuario(c_cod_lim_excedido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' || 'Límite Excedido - Mto. Límite:' ||
                                         v_mto_limite || ' - Total Realizado:' || v_tot_realizado || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error, v_nro_telefono, '-36');

                 ELSIF v_modo = 'A' THEN

                    pr_gen_monto('039', v_mto_lim_canal, v_cod_mon_fuerte, v_nro_cta_debito,
                                 v_fec_actual, retValidarSesion.codigocanal);

                 END IF;
              END IF;
              --
              IF v_retorno.error = 'N' THEN
                 IF v_mto_credito <= 0 THEN
                    pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' || 'Monto Inválido - Monto:' ||
                                         v_mto_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 ELSIF v_cod_mad_credito NOT IN (33,31,334,38,39,41) THEN
                    pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' ||
                                         'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                         v_nro_cta_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 ELSIF v_est_cta_credito NOT IN ('A', 'I','D', 'N', 'S') THEN
                    pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' ||
                                         'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                         v_nro_cta_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 --ELSIF pag_cta.fu_ver_tra_prohibida(v_nro_cta_credito, v_cod_tra_padre, 9, 91) = 'S' THEN TCE-217
                  ELSIF pag_cta.fu_ver_tra_prohibida(v_nro_cta_credito, v_cod_tra_padre_c, v_cod_mod_padre_c, v_cod_mad_padre_c) = 'S' THEN 
                    pr_mensajeUsuario(c_cod_tra_prohibida, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' ||
                                         'Transaccion Prohibida - Nro. Cta. Crédito:' ||
                                         v_nro_cta_credito || ' - Cod. Trans. Padre:' ||
                                         v_cod_tra_padre_c || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
--TRFS-839									
/*										
                 ELSIF v_cod_mad_credito IN (31,38,39,334) AND
                       pag_cta.fu_obt_cta_cte_comb(v_nro_cta_credito) IS NOT NULL THEN
                    pr_mensajeUsuario(c_cod_cta_inv_combinada, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' ||
                                         'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                         v_nro_cta_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
*/										

                 ELSE
                    --pag_cta.pr_ver_operacion(v_nro_cta_credito, v_cod_tra_padre, 9, 91, 'C',
                    --                         v_cod_mon_credito, v_mto_credito,
                    --                         v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/,
                    --                         v_cod_mod_credito, v_cod_mad_credito, v_nvo_est_credito,
                    --                         v_sal_dis_credito, v_procesa, 602);                   
                    --TCE-217
                    pag_cta.pr_ver_operacion(v_nro_cta_credito, v_cod_tra_padre_c, v_cod_mod_padre_c, v_cod_mad_padre_c, 'C',
                                             v_cod_mon_credito, v_mto_credito,
                                             v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/,
                                             v_cod_mod_credito, v_cod_mad_credito, v_nvo_est_credito,
                                             v_sal_dis_credito, v_procesa, v_cod_trans_cred);
                    IF v_procesa = 'N' THEN
                      if pag_cta.g_cod_error = 41 then
                        -- limite permitido
                       pr_mensajeUsuario(c_cod_cta_lim_permitio, v_retorno.nombreRespuesta,
                                         v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                           v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                           'fu_transferencias ' ||
                                            'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                            v_nro_cta_credito || ' ' ||
                                            fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                           bitacora_error);
                      else
                       -- no se puede debitar
                       pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                         v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                           v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                           'fu_transferencias ' ||
                                            'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                            v_nro_cta_credito || ' ' ||
                                            fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                           bitacora_error);
                      end if;
                    ELSIF v_nro_doc_credito IS NOT NULL AND
                          lf_cta_valida(v_nro_cta_credito, v_nro_doc_credito, retValidarSesion,
                                        reterror) = 'N' THEN
                       -- no se puede acreditar a la cuenta de este nro de documento
                       IF v_retorno.error = 'N' THEN

                          pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias ' ||
                                               'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                               v_nro_cta_credito || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                       END IF;
                    END IF;
                 END IF;
                 --Monto de Cta de Debito--
                 IF ((v_cod_mon_debito = v_cod_mon_local) AND (v_monto <> trunc(v_monto))) THEN
                    pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' || 'Monto Inválido - Monto:' ||
                                         v_mto_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 END IF;
                 --Monto de Cta de Credito--
                 IF ((v_cod_mon_credito = v_cod_mon_local) AND
                    (v_mto_credito <> trunc(v_mto_credito))) THEN
                    pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' || 'Monto Inválido - Monto:' ||
                                         v_mto_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 END IF;
                 --TRFS-1299- Sacar la validación de transferencias mismo monto/misma cuenta, el control de seguridad, lo realiza la idempotencia
                 -- valido la duplicacion de transferencias
          /*       DECLARE
                    v_existe VARCHAR2(1);
                 BEGIN
                    BEGIN
                       SELECT 'S'
                         INTO v_existe
                         FROM bw_mov_pendientes
                        WHERE cod_per_principal =
                              nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona) \*v_cod_per_empresa*\
                          AND nro_cuenta = v_nro_cta_debito
                          AND monto = v_monto
                          AND estado = 'P'
                          AND cod_tip_mensaje = '030'
                          AND nro_cta_contra = v_nro_cta_credito
                          AND can_aut_faltantes > 0
                          AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                          AND rownum = 1;
                    EXCEPTION
                       WHEN no_data_found THEN
                          v_existe := 'N';
                       WHEN too_many_rows THEN
                          v_existe := 'S';
                       WHEN OTHERS THEN
                          v_existe := 'N';
                    END;
                    IF v_existe = 'N' THEN
                       IF v_es_mov_noc = 'S' THEN
                          BEGIN
                             SELECT DISTINCT 'S'
                               INTO v_existe
                               FROM ge_movimientos_noc
                              WHERE nro_cuenta = v_nro_cta_debito
                                AND cod_tra_padre = v_cod_tra_padre
                                AND monto = v_monto
                                AND reversado = 'N'
                                AND nro_secuencia = '1'
                                AND IT.FUE_OBT_DES_REFCODES('USU_MOV_SERVICIO',cod_usuario)='TRANSFERS'
                                AND (instr(concepto, v_nro_cta_credito) > 0 OR
                                    concepto = v_concepto)
                                   -- Controla que por lo menos haya pasado 10 minutos
                                AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                                AND rownum = 1;
                          EXCEPTION
                             WHEN no_data_found THEN
                                v_existe := 'N';
                          END;
                       ELSE
                          BEGIN
                             SELECT DISTINCT 'S'
                               INTO v_existe
                               FROM ge_movimientos
                              WHERE nro_cuenta = v_nro_cta_debito
                                AND cod_tra_padre = v_cod_tra_padre
                                AND monto = v_monto
                                AND reversado = 'N'
                                AND nro_secuencia = '1'
                                AND IT.FUE_OBT_DES_REFCODES('USU_MOV_SERVICIO',cod_usuario)='TRANSFERS'
                                AND (instr(concepto, v_nro_cta_credito) > 0 OR
                                    concepto = v_concepto)
                                AND fecha = v_fec_actual
                                   -- Controla que por lo menos haya pasado 10 minutos
                                AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                                AND rownum = 1;
                          EXCEPTION
                             WHEN no_data_found THEN
                                v_existe := 'N';
                          END;
                       END IF;
                    END IF;
                    IF v_existe = 'S' THEN
                       pr_mensajeUsuario(c_cod_mov_ya_ingresado, v_retorno.nombreRespuesta,
                                         v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                           v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                           'fu_transferencias ' ||
                                            'Movimiento ya ingresado - Persona Principal:' ||
                                            nvl(retValidarSesion.codigoEmpresa,
                                                retValidarSesion.codigoPersona) \*v_cod_per_empresa*\
                                            || ' - Nro. Cta. Débito:' || v_nro_cta_debito ||
                                            ' - Monto:' || v_monto || ' ' ||
                                            fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                           bitacora_error);
                    END IF;
                 EXCEPTION
                    WHEN no_data_found THEN
                       NULL;
                    WHEN too_many_rows THEN
                       pr_mensajeUsuario(c_cod_mov_ya_ingresado, v_retorno.nombreRespuesta,
                                         v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                           v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                           'fu_transferencias ' ||
                                            'Movimiento ya ingresado - Persona Principal:' ||
                                            nvl(retValidarSesion.codigoEmpresa,
                                                retValidarSesion.codigoPersona) \*v_cod_per_empresa*\
                                            || ' - Nro. Cta. Débito:' || v_nro_cta_debito ||
                                            ' - Monto:' || v_monto || ' ' ||
                                            fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                           bitacora_error);
                 END;*/
              END IF;
           EXCEPTION
              WHEN no_data_found THEN
                 pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias ' ||
                                      'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                      v_nro_cta_credito || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_error);
              WHEN too_many_rows THEN
                 pr_mensajeUsuario(c_cod_cta_duplicada, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias ' ||
                                      'Cuenta Duplicada - Nro. Cta. Crédito:' || v_nro_cta_credito || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_error);
              WHEN OTHERS THEN
                 pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias ' ||
                                      'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                      v_nro_cta_credito || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_error);
           END;

           IF v_retorno.error = 'N' THEN
              -- no hay problemas hasta aqui
              IF v_modo = 'V' THEN
                 -- validacion
                 v_retorno.error      := 'N';
                 v_retorno.cotizacion := v_cotizacion;
                 -- v_retorno.cuentaDebito     := v_cta_for_debito;
                 v_retorno.nombrectadebito := v_nom_cta_debito;
                 v_retorno.monedadebito    := v_cod_mon_debito;
                 v_retorno.monto           := v_monto;
                 -- v_retorno.cuentaCredito    := v_cta_for_credito;
                 v_retorno.nombrectacredito := v_nom_cta_credito;
                 v_retorno.monedacredito    := v_cod_mon_credito;
                 v_retorno.montocredito     := v_mto_credito;
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias ' || 'Cta deb:' || v_cta_for_debito ||
                                      ' cta cre:' || v_cta_for_credito || ' mto:' || v_monto ||
                                      ' modo:' || p_modo || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_salida);


                 /*Obtiene la informacion de parámetros recibos y el return del type*/
                 paw_log.g_typ_transferencia := v_retorno;
                 paw_log.pr_logValoresTypes('typ_transferencia',
                 'fu_Tranferencia Modo V'||' '||', '|| p_codcanal||', '||  p_nroctadebito||', '||
                 p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
                 p_cotizacion||', '|| p_mtocredito||', '||
                 p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);
                 RETURN v_retorno;

              ELSIF v_modo = 'C' THEN
                 v_retorno.cotizacion := v_cotizacion;--TRFS-1343
                 -- grabacion en pendiente
                 IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito AND
                    v_cod_mon_credito = v_cod_mon_local THEN
                    v_mto_equ_local := v_mto_credito;
                 ELSE
                    v_mto_equ_local := NULL;
                 END IF;
                 --- inserto el movimiento pendiente de autorizacion
                 SELECT s_nro_documento.nextval INTO v_nro_documento FROM dual;
                 INSERT INTO bw_mov_pendientes
                    (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta,
                     cod_moneda, descripcion, monto, cotizacion, mto_equ_local, nro_cta_contra,
                     estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra,
                     cot_contra, etiqueta, dato, etiqueta2, dato2, etiqueta3, dato3)
                 VALUES
                    (v_nro_documento,
                     nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), SYSDATE,
                     '030', v_nro_cta_debito, v_cod_mon_debito, 'Transferencia entre Cuentas',
                     v_monto, v_cot_debito, v_mto_equ_local, v_nro_cta_credito, 'P',
                     v_can_aut_requeridas, v_can_aut_requeridas, retValidarSesion.codigoPersona
                      /*v_cod_persona*/, v_mto_credito, v_cot_credito, 'Nro.Identificacion',
                     v_nro_doc_credito, 'Concepto', v_concepto, 'Contrato', nvl(v_nro_contrato, 0));

                      -- registro del movimiento
                 paw_con.pr_reg_operacion(v_nro_cta_debito, /*p_nro_cuenta*/ v_cod_mon_debito,
                                   /*p_cod_moneda */ v_monto, /*p_monto*/ v_nro_cta_credito,
                                   /*p_nro_cta_contra*/ NULL, /*p_cantidad*/ 'Contrato de cambio',
                                   /*p_etiqueta*/ v_nro_contrato, /*p_dato*/ NULL, /*p_etiqueta2*/
                                  NULL, /*p_dato2*/ NULL, /*observacion*/ v_dir_ip, /*direccion IP*/
                                  NULL, /*p_cod_respuesta*/ retValidarSesion.codigoPersona,
                                   /*cod_persona*/ v_tip_mensaje, /*cod_operacion*/ v_nro_operacion,
                                   /*nro_operacion*/ v_cod_canal, /*nro_terminal*/ v_sesion,
                                   /*clave*/
                                  nvl(retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa)); /*cod_per_empresa*/
                 v_retorno.tipoPedido := v_modo;
                 --v_retorno.tipoTransferencia  := '0';
                 v_retorno.cantidadAutorizadores := v_can_aut_requeridas;
                 v_retorno.numeroDocumento      := v_nro_documento;
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias ' || 'Cta deb:' || v_cta_for_debito ||
                                      ' cta cre:' || v_cta_for_credito || ' mto:' || v_monto ||
                                      ' modo:' || p_modo || ' Cant. Aut. Requeridas: ' ||
                                      v_can_aut_requeridas || ' Nro. Doc:' || v_nro_documento || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_salida);


                 /*Obtiene la informacion de parámetros recibos y el return del type*/
                 paw_log.g_typ_transferencia := v_retorno;
                 paw_log.pr_logValoresTypes('typ_transferencia',
                 'fu_Tranferencia Modo C'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
                 p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
                 p_cotizacion||', '|| p_mtocredito||', '||
                 p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);

                 RETURN v_retorno;
              ELSIF v_modo = 'A' THEN
                 v_retorno.cotizacion := v_cotizacion;--TRFS-1343
                 -- confirmacion de operacion
                 -- seteo las variables
                 v_nro_secuencia := 0;
                 --TCE-217
                 --pag_cta.pr_set_variables(v_cod_usuario, v_fec_actual,
                 --                        v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL,
                 --                         v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/, 9,
                 --                         91);
                 pag_cta.pr_set_variables(v_cod_usuario, v_fec_actual,
                                          v_cod_tra_padre_c, 'N', 'N', v_nro_secuencia, NULL,
                                          v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/, v_cod_mod_padre_c,
                                          v_cod_mad_padre_c);                                          
                 -- esta la cuenta en condiciones, verifico el horario
                 v_tra_spi := 'S';
                 reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                            v_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                            -- IN
                                            v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                            -- IN
                                            v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

                 IF reterror.error = 'S' THEN
                    v_retorno.error                := reterror.error;
                    v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
                    v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' || 'lp_ver_horario - Cta deb:' ||
                                         v_cta_for_debito || ' cta cre:' || v_cta_for_credito ||
                                         ' mto:' || v_monto || ' modo:' || p_modo || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);


                     /*Obtiene la informacion de parámetros recibos y el return del type*/
                     paw_log.g_typ_transferencia := v_retorno;
                     paw_log.pr_logValoresTypes('typ_transferencia',
                     'fu_Tranferencia Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
                     p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
                     p_cotizacion||', '|| p_mtocredito||', '||
                     p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);

                    RETURN v_retorno;
                 END IF;
                 v_tra_spi := 'N';
                 -- actualizo la cuenta de debito
                 IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito AND
                    v_cod_mon_credito = v_cod_mon_local THEN
                    v_cotizacion    := v_cot_debito;
                    v_mto_equ_local := v_mto_credito;
                 ELSIF v_cod_mon_debito <> v_cod_mon_local AND
                       v_cod_mon_debito <> v_cod_mon_credito AND
                       v_cod_mon_credito <> v_cod_mon_local THEN
                    -- arbitraje
                    v_cotizacion    := v_cot_debito;
                    v_mto_equ_local := round(v_monto * v_cot_debito, 0);
                 ELSE
                    v_cotizacion    := NULL;
                    v_mto_equ_local := NULL;
                 END IF;
                 --pag_cta.pr_act_operacion(v_nro_cta_debito, v_hor_actual, 'D', v_cod_mon_debito,
                 --                         v_monto, v_cod_tra_padre, 503, v_nro_operacion,
                 --                         v_cotizacion, v_mensajeCaja.codigoOficinaOrigen
                 --                         /*v_cod_ofi_origen*/, 9, 91, NULL, NULL,
                 --                         nvl(v_concepto, 'Transf. a ' || v_nro_cta_credito), 'N',
                 --                         v_nro_secuencia, v_fec_valor, NULL, NULL, v_mto_equ_local);
                 -- TCE-217
                 pag_cta.pr_act_operacion(v_nro_cta_debito, v_hor_actual, 'D', v_cod_mon_debito,
                                          v_monto, v_cod_tra_padre_d, v_cod_trans_debi, v_nro_operacion,
                                          v_cotizacion, v_mensajeCaja.codigoOficinaOrigen
                                           /*v_cod_ofi_origen*/, v_cod_mod_padre_d, v_cod_mad_padre_d, NULL, NULL,
                                          nvl(v_concepto, 'Transf. a ' || v_nro_cta_credito), 'N',
                                          v_nro_secuencia, v_fec_valor, NULL, NULL, v_mto_equ_local);
                 IF nvl(pag_cta.g_cod_error, 0) = 0 THEN
                    IF v_cod_mon_credito <> v_cod_mon_local AND
                       v_cod_mon_debito <> v_cod_mon_credito AND v_cod_mon_debito = v_cod_mon_local THEN
                       v_mto_equ_local := v_monto;
                    ELSIF v_cod_mon_debito <> v_cod_mon_local AND
                          v_cod_mon_debito <> v_cod_mon_credito AND
                          v_cod_mon_credito <> v_cod_mon_local THEN
                       -- arbitraje, el equivalente en mon.local es igual al calculado en el anterior
                       v_cotizacion := v_cot_credito;
                    ELSE
                       v_mto_equ_local := NULL;
                    END IF;
                                      
                      v_fec_hora:=to_char(v_fec_valor,'dd/mm/yyyy')|| ' ' || v_hor_sysdate;
                      
                      if v_cod_cli_debito is not null and v_cod_cli_credito is not null then 
                          v_inf_deb_json:= '{' || '"fec_transferencia":' || '"' ||
                          v_fec_hora || '"' || ',' ||
           /*TRFS-1162   '"monto":' || '"' ||ltrim(rtrim(to_char(v_monto,'999,999,999,999,999.99')))||' '||initcap(v_cod_mon_debito)||'.'||'"' || ',' ||
             TRFS-1162*/ '"monto":' || '"' ||ltrim(rtrim(to_char(v_monto,'999,999,999,999,990.00')))||' '||initcap(v_cod_mon_debito)||'.'||'"' || ',' ||
                         '"nro_transaccion":' || '"' ||v_nro_operacion || '"' || ',' ||
                         '"nom_cue_debito":' || '"' ||
                         fue_obt_nom_persona(v_cod_cli_debito)|| '"' || ',' ||
                         '"num_cue_debito":' || '"' ||
                         v_nro_cta_debito || '"' || ',' ||
                         '"nom_beneficiario":' || '"' ||
                          fue_obt_nom_persona(v_cod_cli_credito) || '"' || ',' ||
                         '"num_cue_beneficiario":' || '"' ||
                         v_nro_cta_credito || '"' || ',' ||
                         '"ban_cue_beneficiario":' || '"' ||
                        fue_obt_nom_persona(FUG_OBT_PER_ENTIDAD) || '"' || ',' ||
                         '"notas":' || '"' ||nvl(v_concepto, 'Transf. a ' || v_nro_cta_credito)|| '"' || '}';
                    end if;
                    -- seteo las variables
                    --pag_cta.pr_set_variables(v_cod_usuario, v_fec_actual,
                    --                        v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL,
                    --                        v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/, 9,
                    --                        91);                    
                    --pag_cta.pr_act_operacion(v_nro_cta_credito, v_hor_actual, 'C',
                    --                         v_cod_mon_credito, v_mto_credito, v_cod_tra_padre, 602,
                    --                         v_nro_operacion, v_cot_credito,
                    --                         v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/,
                    --                         9, 91, NULL, NULL,
                    --                         nvl(v_concepto, 'Transf. de ' || v_nro_cta_debito), 'N',
                    --                         v_nro_secuencia, v_fec_valor, NULL, NULL,
                    --                         v_mto_equ_local);
                    --TCE-217
                    pag_cta.pr_set_variables(v_cod_usuario, v_fec_actual,
                                            v_cod_tra_padre_c, 'N', 'N', v_nro_secuencia, NULL,
                                            v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/, v_cod_mod_padre_c,
                                            v_cod_mad_padre_c);                    
                    pag_cta.pr_act_operacion(v_nro_cta_credito, v_hor_actual, 'C',
                                             v_cod_mon_credito, v_mto_credito, v_cod_tra_padre_c, v_cod_trans_cred,
                                             v_nro_operacion, v_cot_credito,
                                             v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/,
                                             v_cod_mod_padre_c, v_cod_mad_padre_c, NULL, NULL,
                                             nvl(v_concepto, 'Transf. de ' || v_nro_cta_debito), 'N',
                                             v_nro_secuencia, v_fec_valor, NULL, NULL,
                                             v_mto_equ_local);
                    IF nvl(pag_cta.g_cod_error, 0) <> 0 THEN
                       -- hubo error en el credito
                       pr_mensajeUsuario(c_tra_cta_cre_error, v_retorno.nombreRespuesta,
                                         v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                           v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                           'fu_transferencias ' ||
                                            'PR_ACT_OPERACION - Cta Credito: ' || v_nro_cta_credito ||
                                            fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                           bitacora_error);

                    ELSE
                       
                      if v_cod_cli_debito is not null and v_cod_cli_credito is not null then 
                          v_inf_cre_json:= '{' || '"fec_transferencia":' || '"' ||
                          v_fec_hora || '"' || ',' ||
           /*TRFS-1162   '"monto":' || '"' ||ltrim(rtrim(to_char(v_mto_credito,'999,999,999,999,999.99')))||' '||initcap(v_cod_mon_credito)||'.'||'"' || ',' ||
             TRFS-1162*/ '"monto":' || '"' ||ltrim(rtrim(to_char(v_mto_credito,'999,999,999,999,990.00')))||' '||initcap(v_cod_mon_credito)||'.'||'"' || ',' ||
                         '"nro_transaccion":' || '"' ||v_nro_operacion || '"' || ',' ||
                         '"nom_cue_debito":' || '"' ||
                         fue_obt_nom_persona(v_cod_cli_debito)|| '"' || ',' ||
                         '"num_cue_debito":' || '"' ||
                         v_nro_cta_debito || '"' || ',' ||
                         '"ban_cue_debito":' || '"' ||
                         fue_obt_nom_persona(FUG_OBT_PER_ENTIDAD) || '"' || ',' ||
                         '"nom_beneficiario":' || '"' ||
                          fue_obt_nom_persona(v_cod_cli_credito) || '"' || ',' ||
                         '"num_cue_beneficiario":' || '"' ||
                         v_nro_cta_credito || '"' || ',' ||
                         '"ban_cue_beneficiario":' || '"' ||
                         fue_obt_nom_persona(FUG_OBT_PER_ENTIDAD) || '"' || '}';
                    end if;
                           
                    END IF;
                    -- cambio el estado del contrato de cambio
                    IF nvl(v_nro_contrato, 0) <= 0 THEN
                       BEGIN
                          SELECT nvl(a.nro_contrato, 0)
                            INTO v_nro_contrato
                            FROM lc_con_cambios a, bw_mov_pendientes b
                           WHERE b.nro_cuenta = a.nro_cta_debito
                             AND a.estado = 'P'
                             AND ((a.mto_compra = b.mto_contra) OR (a.mto_compra = b.monto) OR
                                 (a.mto_venta = b.mto_contra) OR (a.mto_venta = b.monto))
                             AND ((a.cot_venta = b.cot_contra) OR (a.cot_venta = b.cotizacion) OR
                                 (a.cot_compra = b.cot_contra) OR (a.cot_compra = b.cotizacion))
                             AND b.nro_documento = nvl(to_number(v_nro_operacion), 0)
                             AND trunc(a.fec_insercion) = v_fec_servidor;
                       EXCEPTION
                          WHEN no_data_found THEN
                             BEGIN
                                SELECT nvl(a.nro_contrato, 0)
                                  INTO v_nro_contrato
                                  FROM lc_con_cambios a, bw_mov_pendientes b
                                 WHERE b.nro_cuenta = a.nro_cta_debito
                                   AND a.estado <> 'P'
                                   AND ((a.mto_compra = b.mto_contra) OR (a.mto_compra = b.monto) OR
                                       (a.mto_venta = b.mto_contra) OR (a.mto_venta = b.monto))
                                   AND ((a.cot_venta = b.cot_contra) OR
                                       (a.cot_venta = b.cotizacion) OR
                                       (a.cot_compra = b.cot_contra) OR
                                       (a.cot_compra = b.cotizacion))
                                   AND b.nro_documento = nvl(to_number(v_nro_operacion), 0)
                                   AND trunc(a.fec_insercion) = v_fec_servidor;
                             EXCEPTION
                                WHEN no_data_found THEN
                                   NULL;
                                WHEN OTHERS THEN
                                   NULL;
                             END;
                             IF nvl(v_nro_contrato, 0) > 0 THEN
                                pr_mensajeUsuario(c_cont_cambio_invalido, v_retorno.nombreRespuesta,
                                                  v_retorno.descripcionRespuesta, v_retorno.error);
                                pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal,
                                                    v_sesion, v_tip_mensaje,
                                                    retValidarSesion.codigoEmpresa,
                                                    'fu_transferencias ' ||
                                                     'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                                     v_nro_contrato || ' ' ||
                                                     fu_generarBitacora(v_retorno.error,
                                                                        v_retorno.nombreRespuesta,
                                                                        v_retorno.descripcionRespuesta,
                                                                        NULL), bitacora_error);
                             END IF;
                          WHEN OTHERS THEN
                             NULL;

                       END;
                    END IF;
                    IF nvl(v_nro_contrato, 0) > 0 THEN
                       --volver a controlar antes de actualizar para evitar
                       --utilizar dos veces el mismo contrato
                       BEGIN
                          SELECT COUNT(*)
                            INTO v_con_contrato
                            FROM lc_con_cambios
                           WHERE nro_contrato = v_nro_contrato
                             AND estado = 'P';
                       EXCEPTION
                          WHEN OTHERS THEN
                             --v_cod_respuesta := paw_bel.v_cont_cambio_invalido;
                             pr_mensajeUsuario(c_cont_cambio_invalido, v_retorno.nombreRespuesta,
                                               v_retorno.descripcionRespuesta, v_retorno.error);
                             pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal,
                                                 v_sesion, v_tip_mensaje,
                                                 retValidarSesion.codigoEmpresa,
                                                 'fu_transferencias ' ||
                                                  'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                                  v_nro_contrato || ' ' ||
                                                  fu_generarBitacora(v_retorno.error,
                                                                     v_retorno.nombreRespuesta,
                                                                     v_retorno.descripcionRespuesta,
                                                                     NULL), bitacora_error);
                       END;
                       IF v_con_contrato = 1 THEN
                          lp_val_con_cambio('C', v_nro_contrato, NULL, NULL, NULL, NULL, NULL, NULL,
                                            v_cod_respuesta);
                       ELSE
                          --v_cod_respuesta := paw_bel.v_cont_cambio_invalido;
                          pr_mensajeUsuario(c_cont_cambio_invalido, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias ' ||
                                               'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                               v_nro_contrato || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                       END IF;
                    END IF; -- Fin
                    -- envío de SMS
                    IF v_retorno.error = 'N' THEN
                       IF v_cod_cli_debito !=
                          v_cod_cli_credito THEN
                          /*
                           pag_sms.pr_pro_servicio_014(p_nro_cuenta      => v_nro_cta_debito,
                                                       p_monto           => v_monto,
                                                       p_nro_cta_destino => v_nro_cta_credito);
                          */
                          NULL;
                       END IF;
                    END IF;
                 ELSE
                    -- hubo error en el debito
                    --v_cod_respuesta := paw_bel.v_cod_tra_invalida;
                    pr_mensajeUsuario(c_tra_cta_deb_error, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' || 'PR_ACT_OPERACION - Cta Debito: ' ||
                                         v_nro_cta_debito ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 END IF;
                 /*HA-2718 - DA-7829*/
                 IF v_retorno.error = 'N' THEN
                   DECLARE
                     reg_snp  pas_snp.rg_msj;
                   BEGIN
                     lp_obt_doc_beneficiario(reg_snp,v_cod_cli_credito);
                     lp_obt_doc_solicitante(reg_snp,v_cod_cli_debito);
                     IF reg_snp.nro_doc_beneficiario is not null and 
                        reg_snp.nro_doc_solicitante is not null then
                       reg_snp.nro_referencia               := v_nro_operacion;
                       reg_snp.nro_cta_beneficiario         := v_nro_cta_credito;
                       reg_snp.nro_cta_solicitante          := v_nro_cta_debito;
                       reg_snp.fec_recepcion                := v_fec_valor;
                       reg_snp.monto                        := v_mto_credito;
                       prg_gen_aler_tra_rrhh(reg_snp, 'I');
                     END IF;
                     EXCEPTION
                       WHEN OTHERS THEN
                         NULL;
                   END;
                 END IF;
              END IF;
           END IF;
        END IF;
     END IF;
         
     IF v_cod_cli_debito != v_cod_cli_credito THEN
       v_tip_mensaje:='039';
     END IF;
     paw_con.pr_reg_operacion(v_nro_cta_debito, /*p_nro_cuenta*/ v_cod_mon_debito, /*p_cod_moneda */
                      v_monto, /*p_monto*/ v_nro_cta_credito, /*p_nro_cta_contra*/ NULL,
                       /*p_cantidad*/ 'Contrato de cambio', /*p_etiqueta*/ v_nro_contrato, /*p_dato*/
                      NULL, /*p_etiqueta2*/ NULL, /*p_dato2*/ 'Transferencias', /*observacion*/ v_dir_ip,
                       /*direccion IP*/ NULL, /*p_cod_respuesta*/ retValidarSesion.codigoPersona,
                       /*cod_persona*/ v_tip_mensaje, /*cod_operacion*/ v_nro_operacion,
                       /*nro_operacion*/ v_cod_canal, /*nro_terminal*/ v_sesion, /*clave*/
                      nvl(retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa)); /*cod_per_empresa*/
    v_retorno.numeroDocumento:=v_nro_operacion;
     -- no se responde nada, solo la cantidad de firmas 000, solo se debe setear el v_cod_respuesta
     IF v_retorno.error = 'N' THEN
        -- si hubo error, ya se registro mas arriba
        pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                            retValidarSesion.codigoEmpresa,
                            'fu_transferencias ' || 'Cta deb:' || v_cta_for_debito || ' cta cre:' ||
                             v_cta_for_credito || ' mto:' || v_monto || ' modo:' || p_modo || ' ' ||
                             fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, NULL),
                            bitacora_salida);
      /*if nvl(pag_cta.g_cod_error, 0) = 0 then -->si se hizo correctamente el debito/credito
     
       if v_inf_deb_json is not null then
         --Insertar correo para el solicitante
          lp_env_tra_notificacion(v_cod_cli_debito,fue_obt_val_max_referencia('TIP_MAI_PRODUCTO','ENVTRA'),v_inf_deb_json,v_tip_mensaje,retError); --tipo prod 12
       end if;
         if v_inf_cre_json is not null then
          --Insertar correo para el beneficiario                    
          lp_env_tra_notificacion(v_cod_cli_credito,fue_obt_val_max_referencia('TIP_MAI_PRODUCTO','RECTRA'),v_inf_cre_json,v_tip_mensaje,retError);  --tipo prod 13
       end if;
      end if;*/ --TCE-249
     END IF;

     /*Obtiene la informacion de parámetros recibos y el return del type*/
     paw_log.g_typ_transferencia := v_retorno;
     paw_log.pr_logValoresTypes('typ_transferencia',
     'fu_Tranferencia'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
     p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
     p_cotizacion||', '|| p_mtocredito||', '||
     p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);

     RETURN v_retorno;
  EXCEPTION
     WHEN OTHERS THEN
        /*Obtiene la informacion de parámetros recibos y el return del type*/
        paw_log.g_typ_transferencia := v_retorno;
        paw_log.pr_logValoresTypes('typ_transferencia',
        'fu_Tranferencia Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
        p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
        p_cotizacion||', '|| p_mtocredito||', '||
        p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);


        pr_mensajeUsuario(c_op_error, v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                            retValidarSesion.codigoEmpresa,
                            'fu_transferencias ' || ' deb: ' || v_nro_cta_debito || ' credito: ' ||
                             v_nro_cta_credito || '-Monto:' || v_monto || ' -Modo' || v_modo ||
                             ' - ' ||
                             fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, NULL)||' '||
                            DBMS_UTILITY.format_error_stack||' - '||
                            DBMS_UTILITY.format_error_backtrace,
                            bitacora_error);
        RETURN v_retorno;
  END;
  -- fin de 030-confirmacion de transferencia entre cuentas
-------------------------------------------------------------------------------  
   --TCE-521 Inicio
  FUNCTION fu_val_transferencias
  (
               p_codigoPersona      IN VARCHAR2,
               p_codigoEmpresa      IN VARCHAR2,
               p_codcanal           IN VARCHAR2,
               p_nroctadebito       IN VARCHAR2,
               p_monto              IN NUMBER,
               p_nroctacredito      IN VARCHAR2,
               p_modo               IN VARCHAR2,
               p_cotizacion         IN NUMBER,
               p_mtocredito         IN NUMBER,
               p_concepto           IN VARCHAR2,
               p_nrodoccredito      IN NUMBER,
               p_concambio          IN NUMBER,
               p_cotcredito         IN NUMBER,
               p_clavetransaccional IN VARCHAR2,
               p_estercero          IN VARCHAR2 DEFAULT NULL,
               p_consumidor         IN VARCHAR2 DEFAULT NULL,
               p_cod_tra_padre_d    IN NUMBER DEFAULT NULL,
               p_cod_tra_padre_c    IN NUMBER DEFAULT NULL,
               p_cod_mod_padre_d    IN NUMBER DEFAULT NULL,
               p_cod_mod_padre_c    IN NUMBER DEFAULT NULL,
               p_cod_mad_padre_d    IN NUMBER DEFAULT NULL,
               p_cod_mad_padre_c    IN NUMBER DEFAULT NULL,
               p_cod_tra_debito     IN NUMBER DEFAULT NULL,
               p_cod_tra_credito    IN NUMBER DEFAULT NULL,
               --TCE-521 Parametros de Debito pag_cta.pr_act_operacion               
               p_v_nro_cta_debito_d      OUT  VARCHAR2,
               p_v_hor_actual_d          OUT  VARCHAR2,
               p_v_cod_mon_debito_d      OUT  VARCHAR2,
               p_v_monto_d               OUT  NUMBER,
               p_v_cod_tra_padre_d       OUT  NUMBER,
               p_v_cod_trans_debi_d      OUT  NUMBER,
               p_v_nro_operacion_d       OUT  NUMBER,
               p_v_cotizacion_d          OUT  NUMBER,
               p_v_codigoOficinaOrigen_d OUT  GE_MOVIMIENTOS.COD_OFI_ORIGEN%TYPE,
               p_v_cod_mod_padre_d       OUT  NUMBER,
               p_v_cod_mad_padre_d       OUT  NUMBER,
               p_v_concepto_d            OUT  VARCHAR2,
               p_v_nro_cta_credito_d     OUT  VARCHAR2,
               p_v_nro_secuencia_d       OUT  NUMBER,
               p_v_fec_valor_d           OUT  DATE,
               p_v_mto_equ_local_d       OUT  NUMBER,
               --TCE-521 Parametros de Credito pag_cta.pr_act_operacion
               p_v_nro_cta_credito_c       OUT  VARCHAR2,
               p_v_hor_actual_c            OUT  VARCHAR2,
               p_v_cod_mon_credito_c       OUT  VARCHAR2,
               p_v_mto_credito_c           OUT  NUMBER,
               p_v_cod_tra_padre_c_c       OUT  NUMBER,
               p_v_cod_trans_cred_c        OUT  NUMBER,
               p_v_nro_operacion_c         OUT  NUMBER,
               p_v_cot_credito_c           OUT  NUMBER,
               p_v_cod_ofi_origen_c        OUT  GE_MOVIMIENTOS.COD_OFI_ORIGEN%TYPE,
               p_v_cod_mod_padre_c_c       OUT  NUMBER, 
               p_v_cod_mad_padre_c_c       OUT  NUMBER,
               p_v_concepto_c              OUT  VARCHAR2,
               p_v_nro_secuencia_c         OUT  NUMBER, 
               p_v_fec_valor_c             OUT  DATE,
               p_v_mto_equ_local_c         OUT  NUMBER           
 
  ) RETURN typ_transferencia IS
     c_tra_cta_cre_deb_igual CONSTANT VARCHAR2(3) := 200;
     c_tra_err_conversion    CONSTANT VARCHAR2(3) := 203;
     c_tra_mto_invalido      CONSTANT VARCHAR2(3) := 204;
     c_tra_cta_cre_error     CONSTANT VARCHAR2(3) := 212;
     c_tra_cta_deb_error     CONSTANT VARCHAR2(3) := 213;
     --
     c_cod_cta_invalida      CONSTANT VARCHAR2(3) := '114';
     c_cod_cta_doc_invalido   CONSTANT VARCHAR2(3) := '327';
     c_cod_cta_lim_permitio   CONSTANT VARCHAR2(3) := '328';
     c_cod_cta_inv_combinada CONSTANT VARCHAR2(3) := '252';
     c_cod_sin_autorizacion  CONSTANT VARCHAR2(3) := '108';
     c_cod_lim_excedido      CONSTANT VARCHAR2(3) := '136';
     c_cont_cambio_invalido  CONSTANT VARCHAR2(3) := '162';
     c_cod_mto_invalido      CONSTANT VARCHAR2(3) := '121';
     c_cod_tra_prohibida     CONSTANT VARCHAR2(3) := '110';
     c_cod_mov_ya_ingresado  CONSTANT VARCHAR2(3) := '134';
     c_cod_cta_duplicada     CONSTANT VARCHAR2(3) := '102';
     SAL_PER_SIN_AUT         CONSTANT VARCHAR2(15):= 'SAL_PER_SIN_AUT';
     MSG_COD_CTA_CONJUNTA    CONSTANT VARCHAR2(15) := 'CTA_CONJUNTA';
     c_op_error              CONSTANT VARCHAR2(15) := 'OP_ERROR';
     c_paympvu               CONSTANT VARCHAR2(20) := 'PAYMENT_SUPPLIERS';
     PRE_MON_LOC_INVALIDA CONSTANT VARCHAR2(15) := 'PRE_MON_LOC_INV';
     
     v_retorno          typ_transferencia := typ_transferencia;
     v_tip_mensaje      VARCHAR2(3) := '030';
     retValidarSesion   typ_validarsesion;
     retError           typ_mensajerespuesta := typ_mensajerespuesta;
     v_mensajeCaja      typ_mensajecaja;
     retObtenerPermisos typ_obtenerpermisos;

     v_nro_cta_debito  VARCHAR2(16);
     v_monto           NUMBER(18, 2); -- monto a transferir
     v_monto_gs        NUMBER(18, 2); -- monto a transferir
     v_nro_cta_credito VARCHAR2(17);  -- cuenta de credito
     v_modo            VARCHAR2(1);   -- modo V-validacion o C-confirmacion
     -- variables
     v_cta_for_debito  VARCHAR2(17); -- cuenta formateada
     v_cod_mon_debito  VARCHAR2(3);  -- moneda de la cuenta
     v_nom_cta_debito  VARCHAR2(100);
     v_cod_mon_credito VARCHAR2(3);  -- moneda de la cuenta
     v_cta_for_credito VARCHAR2(17); -- cuenta formateada
     v_est_cta_credito VARCHAR2(1);  -- estado de la cuenta
     v_nvo_est_credito VARCHAR2(1) := NULL; -- cambio de estado de cuenta
     v_nom_cta_credito VARCHAR2(100);
     v_procesa         VARCHAR2(1) := 'N'; -- indica si se puede o no procesar
     v_nro_doc_credito VARCHAR2(20) := NULL; -- nro de documento del acreditado
     v_concepto        VARCHAR2(35);
     v_es_tercero      VARCHAR2(1) := 'N';
     v_dir_ip          VARCHAR2(200);
     v_sesion          VARCHAR2(32);
     v_cod_respuesta   VARCHAR2(20);
     v_cod_canal       VARCHAR2(3);
     v_es_mov_noc      VARCHAR2(1) := 'N';
     v_horario         VARCHAR2(1) := 'D'; -- Dia normal
     v_hor_actual      VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
     v_es_cta_noc      VARCHAR2(1) := 'N'; -- Graba S/N ctas noctunas

     v_cod_mod_debito  NUMBER(4); -- modulo de la cuenta
     v_cod_mad_debito  NUMBER(4); -- modalidad de la cuenta
     v_cod_ofi_debito  NUMBER(4); -- oficina de la cuenta
     v_cot_debito      NUMBER(18, 4) := NULL;
     v_nro_contrato    NUMBER(7) := 0;
     v_mto_contrato    NUMBER(18, 2);
     v_cod_mod_credito NUMBER(4); -- modulo de la cuenta
     v_cod_mad_credito NUMBER(4); -- modalidad de la cuenta
     v_cod_ofi_credito NUMBER(4); -- oficina de la cuenta
     v_sal_dis_credito NUMBER(18, 2);
     v_mto_credito     NUMBER(18, 2) := v_monto;
     v_cot_credito     NUMBER(18, 4) := NULL;
     v_mto_equ_local   NUMBER(18) := NULL;
     --v_cod_tra_padre   NUMBER(4) := 388; -- cod. transaccion padre --PHT TCE-217
     v_cod_tra_padre_d NUMBER(4) := nvl(p_cod_tra_padre_d,388); --TCE-217
     v_cod_tra_padre_c NUMBER(4) := nvl(p_cod_tra_padre_c,388); --TCE-217
     v_cod_mod_padre_d NUMBER(4) := nvl(p_cod_mod_padre_d,9);  --TCE-217
     v_cod_mod_padre_c NUMBER(4) := nvl(p_cod_mod_padre_c,9);  --TCE-217
     v_cod_mad_padre_c NUMBER(4) := nvl(p_cod_mad_padre_d,91);  --TCE-217     
     v_cod_mad_padre_d NUMBER(4) := nvl(p_cod_mad_padre_c,91);  --TCE-217
     v_cod_trans_debi  NUMBER(4) := nvl(p_cod_tra_debito,503);  --TCE-217
     v_cod_trans_cred  NUMBER(4) := nvl(p_cod_tra_credito,602);  --TCE-217
     v_cotizacion      NUMBER(18, 4) := NULL;
     v_nro_documento   NUMBER(15);
     v_mto_limite      NUMBER(18, 2); -- monto limite para transferencias
     v_tot_realizado   NUMBER(18, 2); --
     v_mto_tot_036     NUMBER(18, 2); -- Monto Total de Transferencia Interbancaria
     v_con_contrato    NUMBER(5); --contador para verificar contrato valido
     v_mto_lim_canal   NUMBER(18, 2);
     v_nro_secuencia   NUMBER;
     v_nro_operacion   NUMBER;
     v_cotiza     ge_cotizaciones.val_compra%TYPE;      
     v_cot_lim_des        ge_cotizaciones.val_compra%TYPE;
     v_cod_mon_fuerte     ba_monedas.cod_moneda%TYPE := pag_gen.fu_obt_mon_fuerte;
     v_nro_telefono       bw_movimientos.nro_telefono%TYPE;
     v_claveTransaccional bw_ope_claves.clave%TYPE;

     v_fec_actual         DATE := pag_cal.fu_obt_fec_actual(9);
     v_fec_valor          DATE := v_fec_actual;
     v_fec_servidor       DATE := trunc(sysdate);
     v_cta_limite ge_cuentas.nro_cuenta%type;
     v_cod_cli_credito    ba_personas.cod_persona%type;
     v_cod_cli_debito     ba_personas.cod_persona%type;
     v_inf_deb_json long:=null;
     v_inf_cre_json long:=null;
     v_fec_hora varchar2(20);

     v_ind_usuario varchar2(1);
     v_hor_sysdate      VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS');
     --TRFS-1454
    v_cod_usuario            ba_usuarios.cod_usuario%type;
     PROCEDURE lp_obt_doc_beneficiario(p_reg_snp in out pas_snp.rg_msj, 
                                       p_cod_persona in ba_personas.cod_persona%type) IS 
     
     BEGIN
        SELECT p.cod_tip_documento, p.nro_documento
        INTO p_reg_snp.cod_tip_doc_beneficiario, p_reg_snp.nro_doc_beneficiario
        FROM ba_personas p
        WHERE p.cod_persona = p_cod_persona;
        EXCEPTION
          WHEN OTHERS THEN
            NULL;
     END;
     PROCEDURE lp_obt_doc_solicitante(p_reg_snp in out pas_snp.rg_msj, 
                                       p_cod_persona in ba_personas.cod_persona%type) IS 
     
     BEGIN
        SELECT p.cod_tip_documento, p.nro_documento
        INTO p_reg_snp.cod_tip_doc_solicitante, p_reg_snp.nro_doc_solicitante
        FROM ba_personas p
        WHERE p.cod_persona = p_cod_persona;
        EXCEPTION
          WHEN OTHERS THEN
            NULL;
     END;
  BEGIN
     pre_cam_for_numerico('.,');
     v_cod_canal := depurarAlfanumerico(p_codcanal, 3);
     v_sesion    := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
     v_cot_Credito := DepurarNumerico(p_cotcredito, 7);
     v_claveTransaccional  := trim(p_clavetransaccional);
     --valido la sesion del cliente

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,
                       v_retorno.error);
     --retValidarSesion := fu_validarSesion(v_sesion, v_cod_canal);
       retValidarSesion.error:='N';
       retValidarSesion.codigoCanal:=v_cod_canal;
       retValidarSesion.codigoPersona:=p_codigoPersona;
       retValidarSesion.codigoEmpresa:=p_codigoEmpresa;

     IF retValidarSesion.error = 'S' THEN
        v_retorno.error                := retValidarSesion.error;
        v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
        v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
        /*Obtiene la informacion de parámetros recibos y el return del type*/
        paw_log.g_typ_transferencia := v_retorno;
        paw_log.pr_logValoresTypes('typ_transferencia',
        'fu_Tranferencia_sdc Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
        p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
        p_cotizacion||', '|| p_mtocredito||', '||
        p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||v_cot_Credito);
        RETURN v_retorno;
     END IF;

    -- v_mensajeCaja := lf_val_caja(retValidarSesion);
        v_mensajeCaja := fu_obt_mov_user('TRANSFERS');
     IF v_mensajeCaja.error = 'S' THEN
        v_retorno.error                := v_mensajeCaja.error;
        v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
        /*Obtiene la informacion de parámetros recibos y el return del type*/
        paw_log.g_typ_transferencia := v_retorno;
        paw_log.pr_logValoresTypes('typ_transferencia',
        'fu_Tranferencia_sdc Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
        p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
        p_cotizacion||', '|| p_mtocredito||', '||
        p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||v_cot_Credito);
        RETURN v_retorno;
     ELSE
        v_ind_usuario:=substr(v_mensajeCaja.codigoUsuario,instr(v_mensajeCaja.codigoUsuario,'_',1)+1,1);
       
        if v_ind_usuario is null then
           v_ind_usuario:=0;
           v_mensajeCaja.codigoUsuario:='TRANSFER_0';
           v_mensajeCaja.codigoOficinaOrigen := fug_obt_ofi_usuario('TRANSFER_0');
         end if;

      --controla horario cierre
          v_tra_spi := 'S';
           --v_hor_actual:=fu_obt_hora(v_ind_usuario);
           --TCE-253  
         if p_consumidor is not null then
                 if p_consumidor =c_paympvu then
                    pr_obt_usu_hor_mov_int('PAYMPVU',
                                    v_cod_usuario,
                                    v_hor_actual);
                  else
                    pr_obt_usu_hor_mov_int('TRANINT',
                                    v_cod_usuario,
                                    v_hor_actual);
                 end if;
          else
          ---api legacy no envia consumidor
           pr_obt_usu_hor_mov_int('TRANINT',
                                    v_cod_usuario,
                                    v_hor_actual);
           end if;
          reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                      v_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                      -- IN
                                      v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                      -- IN
                                      v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

           IF reterror.error = 'S' THEN
              v_retorno.error                := reterror.error;
              v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
              v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
              RETURN v_retorno;
           END IF;
          v_tra_spi := 'N';

     END IF;

      -- verifica si tiene permiso para transferencia a otro titular
      retobtenerpermisos := lf_obt_permisos(nvl(retValidarSesion.codigoEmpresa,
                                                retValidarSesion.codigoPersona),
                                            retValidarSesion.codigoperfil /*v_cod_perfil*/, v_tip_mensaje,
                                            v_cod_canal);

      IF retobtenerpermisos.error = 'S' THEN
         pr_mensajeUsuario(SAL_PER_SIN_AUT, v_retorno.nombreRespuesta,
                           v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                             retValidarSesion.codigoEmpresa,
                             'fu_transferencias' ||
                              'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                              v_nro_cta_credito || ' ' ||
                              fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);
      END IF;

        IF retobtenerpermisos.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
          pr_mensajeUsuario(SAL_PER_SIN_AUT,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona,p_codCanal,v_sesion,v_cod_operacion,retValidarSesion.codigoEmpresa,
          fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),BITACORA_ERROR);

           /*Obtiene la informacion de parámetros recibos y el return del type*/
           paw_log.g_typ_transferencia := v_retorno;
           paw_log.pr_logValoresTypes('typ_transferencia',
           'fu_Tranferencia_sdc'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
           p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
           p_cotizacion||', '|| p_mtocredito||', '||
           p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);
          RETURN v_retorno;
        END IF;
     -- 0. inicializo la secuencia
     v_nro_secuencia   := 0;
     IF v_ind_cta_encriptada = 'S' THEN
        v_nro_cta_debito  := fu_desencriptacionCuentas(depurarCuenta(p_nroctadebito, cuenta_tamano));
     ELSE
        v_nro_cta_debito  := depurarCuenta(p_nroctadebito, cuenta_tamano);
     END IF;
     v_nro_cta_credito := depurarCuenta(p_nroctacredito, cuenta_tamano);
     v_monto           := paw_bel.depurarNumerico(p_monto, 18, 'S');
      
    --TRFS-1112
    /* Validacion de moneda local con decimales */
    IF lf_obt_moneda(v_nro_cta_debito) = pag_gen.FU_OBT_MON_LOCAL AND v_monto <> paw_bel.depurarNumerico(p_monto, 18) THEN
       pr_mensajeUsuario(PRE_MON_LOC_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(retValidarSesion.codigoPersona,retValidarSesion.codigoCanal,v_sesion,v_cod_operacion,retValidarSesion.codigoEmpresa,
                           'fu_transferencias_sdc' || 'Cta Deb:' || v_nro_cta_debito || ' cta cre:' ||
                            v_nro_cta_credito || ' mto:' || v_monto || ' modo:' || v_modo || ' ' ||
                           fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta,retValidarSesion.descripcionRespuesta, NULL),
                           BITACORA_ERROR);

       RETURN v_retorno;
    END IF;
     
     
     v_modo            := depurarAlfanumerico(p_modo, 1);
     v_concepto        := depurarTextos(p_concepto, 35);
     -- 0. inicializo la secuencia
     v_nro_secuencia := 0;
     -- viene de confirmacion de una autorizacion
     v_mto_credito     := nvl(depurarNumerico(p_mtocredito, 18), 0);
     v_nro_doc_credito := depurarAlfanumerico(p_nrodoccredito, 20);
     v_nro_contrato    := nvl(depurarNumerico(p_concambio, 7), 0);
     v_es_tercero      := nvl(depurarAlfanumerico(p_estercero, 1), 'N');
     v_dir_ip          := NULL;
     v_nro_telefono    := v_dir_ip;
     v_cotizacion      := nvl(depurarNumerico(p_cotizacion, 7), 0);
     
      -- se busca codigo de persona para las cuentas debito y credito
     begin
     select cod_persona
     into v_cod_cli_debito
     from ge_cta_clientes
     where nro_cuenta = v_nro_cta_debito
     and relacion = 'P';
     exception
       when others then
         v_cod_cli_debito := null;
     end;
     
     begin
     select cod_persona
     into v_cod_cli_credito
     from ge_cta_clientes
     where nro_cuenta = v_nro_cta_credito
     and relacion = 'P';
     exception
       when others then
         v_cod_cli_credito := null;
     end;

     --Valida que la cuenta no sea conjunta
     IF nvl(v_modo, 'x') = 'V' THEN
        IF fu_es_conjunta(v_nro_cta_debito,retValidarSesion.codigoPersona,retValidarSesion.codigoEmpresa) = 'S' THEN
           pr_mensajeUsuario(MSG_COD_CTA_CONJUNTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona,
               retValidarSesion.codigoCanal,
               v_sesion,
               v_cod_operacion,
               retValidarSesion.codigoEmpresa,
               'fu_transferencias_sdc' || 'Cta Deb:' || v_nro_cta_debito || ' cta cre:' ||
                          v_nro_cta_credito || ' mto:' || v_monto || ' modo:' || v_modo || ' ' ||
                          fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta,
                                             retValidarSesion.descripcionRespuesta, NULL),
               BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
     END IF;

  /* No se usa transaccional
  IF nvl(v_modo, 'x') = 'C' THEN
        IF v_clavetransaccional IS  NULL THEN
            pr_mensajeUsuario(c_cod_cta_duplicada, v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, v_retorno.error);

          --Obtiene la informacion de parámetros recibos y el return del type
           paw_log.g_typ_transferencia := v_retorno;
           paw_log.pr_logValoresTypes('typ_transferencia',
           'fu_Tranferencia Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
           p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
           v_cotizacion||', '|| p_mtocredito||', '||
           p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);
           RETURN v_retorno;
        END IF;
     END IF;
*/
     IF v_es_tercero = 'N' THEN
       IF v_ind_cta_encriptada = 'S' THEN
          v_nro_cta_credito := fu_desencriptacionCuentas(v_nro_cta_credito);
       END IF;
     END IF;
     pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                         retValidarSesion.codigoEmpresa,
                         'fu_transferencias_sdc' || 'Cta Deb:' || v_nro_cta_debito || ' cta cre:' ||
                          v_nro_cta_credito || ' mto:' || v_monto || ' modo:' || v_modo || ' ' ||
                          fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta,
                                             retValidarSesion.descripcionRespuesta, NULL),
                         bitacora_entrada);

     IF nvl(v_modo, 'x') <> 'A' THEN
        DECLARE
           v_lugar VARCHAR2(50);
        BEGIN
           -- Ajuste por requerimiento de control de clave en la verificacion
           -- antes de envio a bancard, se recibe pedido en modo V para validar la clave transaccional
           IF (v_modo = 'C' AND p_clavetransaccional IS NOT NULL) THEN
              v_lugar  := 'lf_obt_cla_validar: ';
              reterror := lf_obt_cla_validar(v_claveTransaccional, retValidarSesion.codigoPersona,
                                             retValidarSesion.codigoEmpresa, 'T');
           END IF;
           IF reterror.error = 'S' THEN
              v_retorno.error                := reterror.error;
              v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
              v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codcanal, v_sesion,
                                  v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                  'fu_transferencias_sdc' || v_lugar ||
                                   fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                      v_retorno.descripcionRespuesta, NULL),
                                  bitacora_error);

              /*Obtiene la informacion de parámetros recibos y el return del type*/
              paw_log.g_typ_transferencia := v_retorno;
              paw_log.pr_logValoresTypes('typ_transferencia',
              'fu_Tranferencia_sdc Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
              p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
              v_cotizacion||', '|| p_mtocredito||', '||
              p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);

              RETURN v_retorno;
           END IF;
        END;
     END IF;

     IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
        -- se confirma directamente la operacion, porque no requiere autorizacion
        v_modo := 'A'; -- CONFIRMACION
     END IF;

     -- 1. valido la clave del cliente
     IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
        -- se confirma directamente la operacion, porque no requiere autorizacion
        v_modo := 'A'; -- CONFIRMACION
     END IF;
     -- genero el número de operacion
     SELECT s_nro_operacion.nextval INTO v_nro_operacion FROM dual;

     BEGIN
        IF nvl(v_nro_contrato, 0) = 0 THEN
           SELECT nvl(a.nro_contrato, 0)
             INTO v_nro_contrato
             FROM lc_con_cambios a, bw_mov_pendientes b
            WHERE b.nro_cuenta = a.nro_cta_debito
              AND a.estado = 'P'
              AND ((a.mto_compra = b.mto_contra) OR (a.mto_compra = b.monto) OR
                  (a.mto_venta = b.mto_contra) OR (a.mto_venta = b.monto))
              AND ((a.cot_venta = b.cot_contra) OR (a.cot_venta = b.cotizacion) OR
                  (a.cot_compra = b.cot_contra) OR (a.cot_compra = b.cotizacion))
              AND b.nro_documento = nvl(to_number(v_nro_operacion), 0)
              AND trunc(a.fec_insercion) = v_fec_servidor;
        END IF;
     EXCEPTION
        WHEN no_data_found THEN
           NULL;
     END;

     IF lf_obt_moneda(v_nro_cta_debito) IS NOT NULL AND
        lf_obt_moneda(v_nro_cta_credito) IS NOT NULL THEN
        IF fug_obt_cli_principal(v_nro_cta_debito) != fug_obt_cli_principal(v_nro_cta_credito) AND
           v_es_tercero = 'S' THEN
           BEGIN
              SELECT p.nro_documento
                INTO v_nro_doc_credito
                FROM ge_cta_clientes c, ba_personas p
               WHERE c.cod_persona = p.cod_persona
                 AND c.nro_cuenta = v_nro_cta_credito
                 AND c.relacion = 'P';
           EXCEPTION
              WHEN no_data_found THEN
                 v_nro_doc_credito := NULL;
              WHEN OTHERS THEN
                 v_nro_doc_credito := NULL;
           END;
        END IF;
     ELSE
        pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                            retValidarSesion.codigoEmpresa,
                            'fu_transferencias_sdc' ||
                             'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                             v_nro_cta_credito || ' ' ||
                             fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, NULL),
                            bitacora_error);
     END IF;
     --jclg/tys no debe validar los permisos si es aprobacion de la 039
     IF v_retorno.error = 'N' AND v_nro_doc_credito IS NOT NULL AND v_modo <> 'A' THEN
        -- verifica si tiene permiso para transferencia a otro titular
        retobtenerpermisos := lf_obt_permisos(nvl(retValidarSesion.codigoEmpresa,
                                                  retValidarSesion.codigoPersona),
                                              retValidarSesion.codigoperfil /*v_cod_perfil*/, v_tip_mensaje,
                                              v_cod_canal);

        IF retobtenerpermisos.error = 'S' THEN
           pr_mensajeUsuario(c_cod_sin_autorizacion, v_retorno.nombreRespuesta,
                             v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                               retValidarSesion.codigoEmpresa,
                               'fu_transferencias_sdc' ||
                                'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                v_nro_cta_credito || ' ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                   v_retorno.descripcionRespuesta, NULL),
                               bitacora_error);
        END IF;

        IF retobtenerpermisos.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
          pr_mensajeUsuario(SAL_PER_SIN_AUT,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona,p_codCanal,v_sesion,v_cod_operacion,retValidarSesion.codigoEmpresa,
          fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),BITACORA_ERROR);

           /*Obtiene la informacion de parámetros recibos y el return del type*/
           paw_log.g_typ_transferencia := v_retorno;
           paw_log.pr_logValoresTypes('typ_transferencia',
           'fu_Tranferencia_sdc'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
           p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
           p_cotizacion||', '|| p_mtocredito||', '||
           p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);
          RETURN v_retorno;
        END IF;


     END IF;
     -- 2. busco los datos de la cuentas

     IF v_retorno.error = 'N' THEN
        -- verifico cuenta de debito
        IF v_nro_cta_debito = v_nro_cta_credito THEN
           pr_mensajeUsuario(c_tra_cta_cre_deb_igual, v_retorno.nombreRespuesta,
                             v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                               retValidarSesion.codigoEmpresa,
                               'fu_transferencias_sdc ' || 'Transaccion invalida - cta debito:' ||
                                v_nro_cta_debito || ' - cta credito:' || v_nro_cta_credito || ' ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                   v_retorno.descripcionRespuesta, NULL),
                               bitacora_error);
        ELSE
           reterror := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre_d, v_monto,
                                         v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito,
                                         v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito,
                                         retValidarSesion, v_mensajeCaja);
           IF reterror.error = 'S' THEN
              v_retorno.error                := reterror.error;
              v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
              v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
              pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                  v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                  'fu_transferencias_sdc ' || 'lf_val_cta_debito - ' ||
                                   v_nro_cta_debito || ')' || ' ' ||
                                   fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                      v_retorno.descripcionRespuesta, NULL),
                                  bitacora_error);
           END IF;
           IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
              -- se confirma directamente la operacion, porque no requiere autorizacion
              v_modo := 'A'; -- CONFIRMACION
           END IF;

        END IF;

        IF v_retorno.error = 'N' THEN
           -- cuenta de credito
           BEGIN
              SELECT a.cod_moneda,
                     a.estado,
                     cod_modalidad,
                     cod_modulo,
                     cod_oficina,
                      nro_cuenta cta_formateada,
                     denominacion
                INTO v_cod_mon_credito,
                     v_est_cta_credito,
                     v_cod_mad_credito,
                     v_cod_mod_credito,
                     v_cod_ofi_credito,
                     v_cta_for_credito,
                     v_nom_cta_credito
                FROM ge_cuentas a
               WHERE a.nro_cuenta = v_nro_cta_credito -- contiene el nro de cuenta
                 AND NOT EXISTS (SELECT 0
                        FROM bw_cta_accesos p
                       WHERE p.nro_cuenta = a.nro_cuenta
                         AND p.cod_per_vinculo = retValidarSesion.codigoPersona
                         AND p.tip_acceso = 'P'
                         AND p.activo = 'S');
                         
                 -- agregado para control de limites diarios de transacciones (Opcional)--solo para terceros
           if v_retorno.error = 'N' and fug_obt_cli_principal(v_nro_cta_debito) != fug_obt_cli_principal(v_nro_cta_credito) then
            if nvl(fug_obt_pardinamico('IND_LIM_CTA'),'N') = 'S' then
              v_mto_limite := fug_obt_paradicional(v_nro_cta_debito, 'LIM_CTA_TRA_TERCEROS');
              v_cta_limite:=v_nro_cta_debito;
            end if;
            if nvl(v_mto_limite,0) = 0 then 
              v_mto_limite := nvl(lf_obt_lim_cliente(v_cod_canal,nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),'039', pag_gen.FU_OBT_MON_LOCAL),0);
           end if; 
            if nvl(v_mto_limite,0) = 0 then
                  v_mto_limite := fug_obt_pardinamico('LIM_GEN_TRA_TERCEROS',
                                                   v_cod_mod_debito,
                                                   v_cod_mad_debito,
                                                   v_cod_mon_debito,
                                                   v_cod_ofi_debito);
            end if;

                                             
              v_tot_realizado := lf_obt_tot_operaciones(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona,v_cta_limite,'039',v_cod_tra_padre_c);

              if v_cod_mon_credito <> v_cod_mon_local then
                v_cotiza := pag_gen.FU_OBT_COTIZACION(pag_gen.FU_OBT_MON_FUERTE,v_fec_actual);
              else
                v_cotiza := 1;
              end if;
              v_monto_gs := nvl(v_monto,0)*v_cotiza;
              v_tot_realizado := nvl(v_tot_realizado,0)+nvl(v_monto_gs,0);

              if v_tot_realizado > v_mto_limite and nvl(v_nro_contrato,0) = 0 then
                pr_mensajeUsuario(c_cod_lim_excedido, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias_sdc ' || 'Límite Excedido - Mto. Límite:' ||
                                      v_mto_limite || ' - Total Realizado:' || v_tot_realizado || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_error);
                 return v_retorno;
              end if;
         end if;

              -- credito
              IF v_cod_mon_credito = v_cod_mon_debito AND nvl(v_nro_contrato, 0) > 0 THEN
                 pr_mensajeUsuario(c_cont_cambio_invalido, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias_sdc ' ||
                                      'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                      v_nro_contrato || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_error);
              END IF;
              IF v_cod_mon_credito <> v_cod_mon_debito THEN
                 -- moneda diferentes
                 IF nvl(p_modo, 'x') <> 'A' THEN
                    --if v_cod_respuesta = paw_bel.v_cod_aprobado then
                    IF v_retorno.error = 'N' THEN
                       IF v_nro_contrato > 0 THEN
                          -- se asigna v_cotizacion a las dos variables
                          -- al correr el proceso lp_con_mon_a_moneda, una de las
                          -- variables obtendrá su valor correcto (1) dependiendo
                          -- de las monedas de credito y debito
                          IF v_cod_mon_credito <> v_cod_mon_local AND
                             v_cod_mon_debito <> v_cod_mon_local AND
                             v_cod_mon_credito <> v_cod_mon_debito THEN
                             BEGIN
                                -- En Arbitraje siempre la cotizacion compra pertenece a la Cta. Debito
                                SELECT c.cot_compra, c.cot_venta
                                  INTO v_cot_debito, v_cot_credito
                                  FROM lc_con_cambios c
                                 WHERE c.nro_contrato = v_nro_contrato;
                             EXCEPTION
                                WHEN no_data_found THEN
                                   v_cot_debito  := NULL;
                                   v_cot_credito := NULL;
                                WHEN OTHERS THEN
                                   pr_mensajeUsuario(c_cont_cambio_invalido,
                                                     v_retorno.nombreRespuesta,
                                                     v_retorno.descripcionRespuesta, v_retorno.error);
                                   pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal,
                                                       v_sesion, v_tip_mensaje,
                                                       retValidarSesion.codigoEmpresa,
                                                       'fu_transferencias ' ||
                                                        'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                                        v_nro_contrato || ' ' ||
                                                        fu_generarBitacora(v_retorno.error,
                                                                           v_retorno.nombreRespuesta,
                                                                           v_retorno.descripcionRespuesta,
                                                                           NULL), bitacora_error);
                             END;
                          ELSE
                             v_cot_credito := v_cotizacion;
                             v_cot_debito  := v_cotizacion;
                          END IF;
                       ELSIF v_cod_mon_credito <> v_cod_mon_local AND
                             v_cod_mon_debito <> v_cod_mon_local THEN
                          -- es arbitraje y no tiene contrato de cambios
                          pr_mensajeUsuario(c_cont_cambio_invalido, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias ' ||
                                               'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                               v_nro_contrato || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);

                       END IF;
                    END IF;
                    BEGIN
                       lp_con_mon_a_moneda(v_cod_mon_debito, v_cod_mon_credito, v_monto,
                                           v_mto_credito, v_cot_debito, v_cot_credito);
                    EXCEPTION
                       WHEN OTHERS THEN
                          pr_mensajeUsuario(c_tra_err_conversion, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias_sdc ' ||
                                               'lp_con_mon_a_moneda - moneda debito:' ||
                                               v_cod_mon_debito || ' - moneda credito:' ||
                                               v_cod_mon_credito || ' - monto:' || v_monto || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                    END;
                    IF v_cod_mon_credito = v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_local THEN
                       v_mto_contrato := v_monto;
                    ELSE
                       v_mto_contrato := v_mto_credito;
                    END IF;
                    -- valido el contrato de cambio, ojo con las variables.
                    lp_val_con_cambio('V', v_nro_contrato, v_cod_mon_debito, v_cod_mon_credito,
                                      v_nro_cta_debito, v_nro_cta_credito, v_cotizacion,
                                      v_mto_contrato, v_cod_respuesta);
                 END IF;
                 IF v_cod_respuesta != msg_ok THEN
                    pr_mensajeUsuario(v_cod_respuesta, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias_sdc ' ||
                                         'lp_con_mon_a_moneda - moneda debito:' || v_cod_mon_debito ||
                                         ' - moneda credito:' || v_cod_mon_credito || ' - monto:' ||
                                         v_monto || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 END IF;
                 IF v_cod_mon_credito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_local AND
                    v_cod_mon_credito <> v_cod_mon_debito AND v_nro_contrato > 0 THEN
                    NULL;
                 ELSIF v_cod_mon_debito <> v_cod_mon_local THEN
                    v_cotizacion := v_cot_debito;
                 ELSE
                    v_cotizacion := v_cot_credito;
                 END IF;
              ELSE
                 v_mto_credito := v_monto;
              END IF;

              IF v_es_tercero = 'N' AND
                 fu_es_ope_limitadas(v_tip_mensaje, v_nro_cta_debito, v_cod_canal, v_fec_actual) = 'S' AND
                 v_cod_canal IN ('993', '994') AND v_retorno.error = 'N' THEN

                 IF v_cod_mon_debito = v_cod_mon_fuerte THEN
                    v_mto_lim_canal := v_monto;
                 ELSIF v_cod_mon_credito = v_cod_mon_fuerte THEN
                    v_cot_lim_des := v_cot_credito;
                 ELSE
                    BEGIN
                       lp_con_mon_a_moneda(v_cod_mon_debito, v_cod_mon_credito, v_monto,
                                           v_mto_credito, v_cot_debito, v_cot_credito);
                    EXCEPTION
                       WHEN OTHERS THEN
                          pr_mensajeUsuario(c_tra_err_conversion, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias_sdc ' ||
                                               'lp_con_mon_a_moneda - moneda debito:' ||
                                               v_cod_mon_debito || ' - moneda credito:' ||
                                               v_cod_mon_credito || ' - monto:' || v_monto || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                    END;
                 END IF;
                 IF fu_val_monto(v_mto_lim_canal, v_cod_mon_fuerte, v_tip_mensaje, v_nro_cta_debito,
                                 v_cod_canal, v_fec_actual) = 'N' THEN
                    pr_mensajeUsuario(c_cod_lim_excedido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias_sdc ' || 'Límite Excedido - Mto. Límite:' ||
                                         v_mto_limite || ' - Total Realizado:' || v_tot_realizado || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error, retValidarSesion.numerotelefono, '-36');
                 ELSIF v_modo = 'A' THEN

                    pr_gen_monto('030', v_mto_lim_canal, v_cod_mon_fuerte, v_nro_cta_debito,
                                 v_fec_actual, retValidarSesion.codigocanal);
                 END IF;

              END IF;

              -- Verifico el limite por Canal. SDC
              IF v_es_tercero = 'S' AND
                 fu_es_ope_limitadas('039', v_nro_cta_debito, v_cod_canal, v_fec_actual) = 'S' AND
                 v_cod_canal IN ('993', '994') AND v_retorno.error = 'N' THEN

                 IF v_cod_mon_debito = v_cod_mon_fuerte THEN
                    v_mto_lim_canal := v_monto;
                 ELSIF v_cod_mon_credito = v_cod_mon_fuerte THEN
                    v_cot_lim_des := v_cot_credito;
                 ELSE
                    BEGIN
                       lp_con_mon_a_moneda(v_cod_mon_debito, v_cod_mon_credito, v_monto,
                                           v_mto_credito, v_cot_debito, v_cot_credito);
                    EXCEPTION
                       WHEN OTHERS THEN
                          pr_mensajeUsuario(c_tra_err_conversion, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias_sdc ' ||
                                               'lp_con_mon_a_moneda - moneda debito:' ||
                                               v_cod_mon_debito || ' - moneda credito:' ||
                                               v_cod_mon_credito || ' - monto:' || v_monto || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                    END;

                 END IF;
                 IF fu_val_monto(v_mto_lim_canal, v_cod_mon_fuerte, '039', v_nro_cta_debito,
                                 v_cod_canal, v_fec_actual) = 'N' THEN

                    pr_mensajeUsuario(c_cod_lim_excedido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias_sdc ' || 'Límite Excedido - Mto. Límite:' ||
                                         v_mto_limite || ' - Total Realizado:' || v_tot_realizado || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error, v_nro_telefono, '-36');

                 ELSIF v_modo = 'A' THEN

                    pr_gen_monto('039', v_mto_lim_canal, v_cod_mon_fuerte, v_nro_cta_debito,
                                 v_fec_actual, retValidarSesion.codigocanal);

                 END IF;
              END IF;
              --
              IF v_retorno.error = 'N' THEN
                 IF v_mto_credito <= 0 THEN
                    pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' || 'Monto Inválido - Monto:' ||
                                         v_mto_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 ELSIF v_cod_mad_credito NOT IN (33,31,334,38,39,41) THEN
                    pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias_sdc ' ||
                                         'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                         v_nro_cta_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 ELSIF v_est_cta_credito NOT IN ('A', 'I','D', 'N', 'S') THEN
                    pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias_sdc ' ||
                                         'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                         v_nro_cta_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 --ELSIF pag_cta.fu_ver_tra_prohibida(v_nro_cta_credito, v_cod_tra_padre, 9, 91) = 'S' THEN TCE-217
                  ELSIF pag_cta.fu_ver_tra_prohibida(v_nro_cta_credito, v_cod_tra_padre_c, v_cod_mod_padre_c, v_cod_mad_padre_c) = 'S' THEN 
                    pr_mensajeUsuario(c_cod_tra_prohibida, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias_sdc ' ||
                                         'Transaccion Prohibida - Nro. Cta. Crédito:' ||
                                         v_nro_cta_credito || ' - Cod. Trans. Padre:' ||
                                         v_cod_tra_padre_c || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
--TRFS-839                  
/*                    
                 ELSIF v_cod_mad_credito IN (31,38,39,334) AND
                       pag_cta.fu_obt_cta_cte_comb(v_nro_cta_credito) IS NOT NULL THEN
                    pr_mensajeUsuario(c_cod_cta_inv_combinada, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' ||
                                         'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                         v_nro_cta_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
*/                    

                 ELSE
                    --pag_cta.pr_ver_operacion(v_nro_cta_credito, v_cod_tra_padre, 9, 91, 'C',
                    --                         v_cod_mon_credito, v_mto_credito,
                    --                         v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/,
                    --                         v_cod_mod_credito, v_cod_mad_credito, v_nvo_est_credito,
                    --                         v_sal_dis_credito, v_procesa, 602);                   
                    --TCE-217
                    pag_cta.pr_ver_operacion(v_nro_cta_credito, v_cod_tra_padre_c, v_cod_mod_padre_c, v_cod_mad_padre_c, 'C',
                                             v_cod_mon_credito, v_mto_credito,
                                             v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/,
                                             v_cod_mod_credito, v_cod_mad_credito, v_nvo_est_credito,
                                             v_sal_dis_credito, v_procesa, v_cod_trans_cred);
                    IF v_procesa = 'N' THEN
                      if pag_cta.g_cod_error = 41 then
                        -- limite permitido
                       pr_mensajeUsuario(c_cod_cta_lim_permitio, v_retorno.nombreRespuesta,
                                         v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                           v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                           'fu_transferencias_sdc ' ||
                                            'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                            v_nro_cta_credito || ' ' ||
                                            fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                           bitacora_error);
                      else
                       -- no se puede debitar
                       pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                         v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                           v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                           'fu_transferencias_sdc ' ||
                                            'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                            v_nro_cta_credito || ' ' ||
                                            fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                           bitacora_error);
                      end if;
                    ELSIF v_nro_doc_credito IS NOT NULL AND
                          lf_cta_valida(v_nro_cta_credito, v_nro_doc_credito, retValidarSesion,
                                        reterror) = 'N' THEN
                       -- no se puede acreditar a la cuenta de este nro de documento
                       IF v_retorno.error = 'N' THEN

                          pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias_sdc ' ||
                                               'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                               v_nro_cta_credito || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                       END IF;
                    END IF;
                 END IF;
                 --Monto de Cta de Debito--
                 IF ((v_cod_mon_debito = v_cod_mon_local) AND (v_monto <> trunc(v_monto))) THEN
                    pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias_sdc ' || 'Monto Inválido - Monto:' ||
                                         v_mto_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 END IF;
                 --Monto de Cta de Credito--
                 IF ((v_cod_mon_credito = v_cod_mon_local) AND
                    (v_mto_credito <> trunc(v_mto_credito))) THEN
                    pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias_sdc ' || 'Monto Inválido - Monto:' ||
                                         v_mto_credito || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 END IF;
                 --TRFS-1299- Sacar la validación de transferencias mismo monto/misma cuenta, el control de seguridad, lo realiza la idempotencia
                 -- valido la duplicacion de transferencias
          /*       DECLARE
                    v_existe VARCHAR2(1);
                 BEGIN
                    BEGIN
                       SELECT 'S'
                         INTO v_existe
                         FROM bw_mov_pendientes
                        WHERE cod_per_principal =
                              nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona) \*v_cod_per_empresa*\
                          AND nro_cuenta = v_nro_cta_debito
                          AND monto = v_monto
                          AND estado = 'P'
                          AND cod_tip_mensaje = '030'
                          AND nro_cta_contra = v_nro_cta_credito
                          AND can_aut_faltantes > 0
                          AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                          AND rownum = 1;
                    EXCEPTION
                       WHEN no_data_found THEN
                          v_existe := 'N';
                       WHEN too_many_rows THEN
                          v_existe := 'S';
                       WHEN OTHERS THEN
                          v_existe := 'N';
                    END;
                    IF v_existe = 'N' THEN
                       IF v_es_mov_noc = 'S' THEN
                          BEGIN
                             SELECT DISTINCT 'S'
                               INTO v_existe
                               FROM ge_movimientos_noc
                              WHERE nro_cuenta = v_nro_cta_debito
                                AND cod_tra_padre = v_cod_tra_padre
                                AND monto = v_monto
                                AND reversado = 'N'
                                AND nro_secuencia = '1'
                                AND IT.FUE_OBT_DES_REFCODES('USU_MOV_SERVICIO',cod_usuario)='TRANSFERS'
                                AND (instr(concepto, v_nro_cta_credito) > 0 OR
                                    concepto = v_concepto)
                                   -- Controla que por lo menos haya pasado 10 minutos
                                AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                                AND rownum = 1;
                          EXCEPTION
                             WHEN no_data_found THEN
                                v_existe := 'N';
                          END;
                       ELSE
                          BEGIN
                             SELECT DISTINCT 'S'
                               INTO v_existe
                               FROM ge_movimientos
                              WHERE nro_cuenta = v_nro_cta_debito
                                AND cod_tra_padre = v_cod_tra_padre
                                AND monto = v_monto
                                AND reversado = 'N'
                                AND nro_secuencia = '1'
                                AND IT.FUE_OBT_DES_REFCODES('USU_MOV_SERVICIO',cod_usuario)='TRANSFERS'
                                AND (instr(concepto, v_nro_cta_credito) > 0 OR
                                    concepto = v_concepto)
                                AND fecha = v_fec_actual
                                   -- Controla que por lo menos haya pasado 10 minutos
                                AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                                AND rownum = 1;
                          EXCEPTION
                             WHEN no_data_found THEN
                                v_existe := 'N';
                          END;
                       END IF;
                    END IF;
                    IF v_existe = 'S' THEN
                       pr_mensajeUsuario(c_cod_mov_ya_ingresado, v_retorno.nombreRespuesta,
                                         v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                           v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                           'fu_transferencias ' ||
                                            'Movimiento ya ingresado - Persona Principal:' ||
                                            nvl(retValidarSesion.codigoEmpresa,
                                                retValidarSesion.codigoPersona) \*v_cod_per_empresa*\
                                            || ' - Nro. Cta. Débito:' || v_nro_cta_debito ||
                                            ' - Monto:' || v_monto || ' ' ||
                                            fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                           bitacora_error);
                    END IF;
                 EXCEPTION
                    WHEN no_data_found THEN
                       NULL;
                    WHEN too_many_rows THEN
                       pr_mensajeUsuario(c_cod_mov_ya_ingresado, v_retorno.nombreRespuesta,
                                         v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                           v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                           'fu_transferencias ' ||
                                            'Movimiento ya ingresado - Persona Principal:' ||
                                            nvl(retValidarSesion.codigoEmpresa,
                                                retValidarSesion.codigoPersona) \*v_cod_per_empresa*\
                                            || ' - Nro. Cta. Débito:' || v_nro_cta_debito ||
                                            ' - Monto:' || v_monto || ' ' ||
                                            fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                           bitacora_error);
                 END;*/
              END IF;
           EXCEPTION
              WHEN no_data_found THEN
                 pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias_sdc ' ||
                                      'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                      v_nro_cta_credito || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_error);
              WHEN too_many_rows THEN
                 pr_mensajeUsuario(c_cod_cta_duplicada, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias_sdc ' ||
                                      'Cuenta Duplicada - Nro. Cta. Crédito:' || v_nro_cta_credito || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_error);
              WHEN OTHERS THEN
                 pr_mensajeUsuario(c_cod_cta_doc_invalido, v_retorno.nombreRespuesta,
                                   v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias_sdc ' ||
                                      'Validacion de Cuenta Cliente Principal - Nro. Cta. Crédito:' ||
                                      v_nro_cta_credito || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_error);
           END;

           IF v_retorno.error = 'N' THEN
              -- no hay problemas hasta aqui
              IF v_modo = 'V' THEN
                 -- validacion
                 v_retorno.error      := 'N';
                 v_retorno.cotizacion := v_cotizacion;
                 -- v_retorno.cuentaDebito     := v_cta_for_debito;
                 v_retorno.nombrectadebito := v_nom_cta_debito;
                 v_retorno.monedadebito    := v_cod_mon_debito;
                 v_retorno.monto           := v_monto;
                 -- v_retorno.cuentaCredito    := v_cta_for_credito;
                 v_retorno.nombrectacredito := v_nom_cta_credito;
                 v_retorno.monedacredito    := v_cod_mon_credito;
                 v_retorno.montocredito     := v_mto_credito;
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias_sdc ' || 'Cta deb:' || v_cta_for_debito ||
                                      ' cta cre:' || v_cta_for_credito || ' mto:' || v_monto ||
                                      ' modo:' || p_modo || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_salida);


                 /*Obtiene la informacion de parámetros recibos y el return del type*/
                 paw_log.g_typ_transferencia := v_retorno;
                 paw_log.pr_logValoresTypes('typ_transferencia',
                 'fu_Tranferencia_sdc Modo V'||' '||', '|| p_codcanal||', '||  p_nroctadebito||', '||
                 p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
                 p_cotizacion||', '|| p_mtocredito||', '||
                 p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);
                 RETURN v_retorno;

              ELSIF v_modo = 'C' THEN
                 v_retorno.cotizacion := v_cotizacion;--TRFS-1343
                 -- grabacion en pendiente
                 IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito AND
                    v_cod_mon_credito = v_cod_mon_local THEN
                    v_mto_equ_local := v_mto_credito;
                 ELSE
                    v_mto_equ_local := NULL;
                 END IF;
                 --- inserto el movimiento pendiente de autorizacion
                 SELECT s_nro_documento.nextval INTO v_nro_documento FROM dual;
                 INSERT INTO bw_mov_pendientes
                    (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta,
                     cod_moneda, descripcion, monto, cotizacion, mto_equ_local, nro_cta_contra,
                     estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra,
                     cot_contra, etiqueta, dato, etiqueta2, dato2, etiqueta3, dato3)
                 VALUES
                    (v_nro_documento,
                     nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), SYSDATE,
                     '030', v_nro_cta_debito, v_cod_mon_debito, 'Transferencia entre Cuentas',
                     v_monto, v_cot_debito, v_mto_equ_local, v_nro_cta_credito, 'P',
                     v_can_aut_requeridas, v_can_aut_requeridas, retValidarSesion.codigoPersona
                      /*v_cod_persona*/, v_mto_credito, v_cot_credito, 'Nro.Identificacion',
                     v_nro_doc_credito, 'Concepto', v_concepto, 'Contrato', nvl(v_nro_contrato, 0));

                      -- registro del movimiento
                 paw_con.pr_reg_operacion(v_nro_cta_debito, /*p_nro_cuenta*/ v_cod_mon_debito,
                                   /*p_cod_moneda */ v_monto, /*p_monto*/ v_nro_cta_credito,
                                   /*p_nro_cta_contra*/ NULL, /*p_cantidad*/ 'Contrato de cambio',
                                   /*p_etiqueta*/ v_nro_contrato, /*p_dato*/ NULL, /*p_etiqueta2*/
                                  NULL, /*p_dato2*/ NULL, /*observacion*/ v_dir_ip, /*direccion IP*/
                                  NULL, /*p_cod_respuesta*/ retValidarSesion.codigoPersona,
                                   /*cod_persona*/ v_tip_mensaje, /*cod_operacion*/ v_nro_operacion,
                                   /*nro_operacion*/ v_cod_canal, /*nro_terminal*/ v_sesion,
                                   /*clave*/
                                  nvl(retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa)); /*cod_per_empresa*/
                 v_retorno.tipoPedido := v_modo;
                 --v_retorno.tipoTransferencia  := '0';
                 v_retorno.cantidadAutorizadores := v_can_aut_requeridas;
                 v_retorno.numeroDocumento      := v_nro_documento;
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                     v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                     'fu_transferencias ' || 'Cta deb:' || v_cta_for_debito ||
                                      ' cta cre:' || v_cta_for_credito || ' mto:' || v_monto ||
                                      ' modo:' || p_modo || ' Cant. Aut. Requeridas: ' ||
                                      v_can_aut_requeridas || ' Nro. Doc:' || v_nro_documento || ' ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                         v_retorno.descripcionRespuesta, NULL),
                                     bitacora_salida);


                 /*Obtiene la informacion de parámetros recibos y el return del type*/
                 paw_log.g_typ_transferencia := v_retorno;
                 paw_log.pr_logValoresTypes('typ_transferencia',
                 'fu_Tranferencia_sdc Modo C'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
                 p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
                 p_cotizacion||', '|| p_mtocredito||', '||
                 p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);

                 RETURN v_retorno;
              ELSIF v_modo = 'A' THEN
                 v_retorno.cotizacion := v_cotizacion;--TRFS-1343
                 -- confirmacion de operacion
                 -- seteo las variables
                 v_nro_secuencia := 0;
                 --TCE-217
                 --pag_cta.pr_set_variables(v_cod_usuario, v_fec_actual,
                 --                        v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL,
                 --                         v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/, 9,
                 --                         91);
                 pag_cta.pr_set_variables(v_cod_usuario, v_fec_actual,
                                          v_cod_tra_padre_c, 'N', 'N', v_nro_secuencia, NULL,
                                          v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/, v_cod_mod_padre_c,
                                          v_cod_mad_padre_c);                                          
                 -- esta la cuenta en condiciones, verifico el horario
                 v_tra_spi := 'S';
                 reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                            v_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                            -- IN
                                            v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                            -- IN
                                            v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

                 IF reterror.error = 'S' THEN
                    v_retorno.error                := reterror.error;
                    v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
                    v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' || 'lp_ver_horario - Cta deb:' ||
                                         v_cta_for_debito || ' cta cre:' || v_cta_for_credito ||
                                         ' mto:' || v_monto || ' modo:' || p_modo || ' ' ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);


                     /*Obtiene la informacion de parámetros recibos y el return del type*/
                     paw_log.g_typ_transferencia := v_retorno;
                     paw_log.pr_logValoresTypes('typ_transferencia',
                     'fu_Tranferencia_sdc Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
                     p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
                     p_cotizacion||', '|| p_mtocredito||', '||
                     p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);

                    RETURN v_retorno;
                 END IF;
                 v_tra_spi := 'N';
                 -- actualizo la cuenta de debito
                 IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito AND
                    v_cod_mon_credito = v_cod_mon_local THEN
                    v_cotizacion    := v_cot_debito;
                    v_mto_equ_local := v_mto_credito;
                 ELSIF v_cod_mon_debito <> v_cod_mon_local AND
                       v_cod_mon_debito <> v_cod_mon_credito AND
                       v_cod_mon_credito <> v_cod_mon_local THEN
                    -- arbitraje
                    v_cotizacion    := v_cot_debito;
                    v_mto_equ_local := round(v_monto * v_cot_debito, 0);
                 ELSE
                    v_cotizacion    := NULL;
                    v_mto_equ_local := NULL;
                 END IF;
                 --pag_cta.pr_act_operacion(v_nro_cta_debito, v_hor_actual, 'D', v_cod_mon_debito,
                 --                         v_monto, v_cod_tra_padre, 503, v_nro_operacion,
                 --                         v_cotizacion, v_mensajeCaja.codigoOficinaOrigen
                 --                         /*v_cod_ofi_origen*/, 9, 91, NULL, NULL,
                 --                         nvl(v_concepto, 'Transf. a ' || v_nro_cta_credito), 'N',
                 --                         v_nro_secuencia, v_fec_valor, NULL, NULL, v_mto_equ_local);
                 -- TCE-217
                 --TCE-521 Inicio
                 p_v_nro_cta_debito_d      := v_nro_cta_debito;
                 p_v_hor_actual_d          := v_hor_actual;
                 p_v_cod_mon_debito_d      := v_cod_mon_debito;
                 p_v_monto_d               := v_monto;
                 p_v_cod_tra_padre_d       := v_cod_tra_padre_d;
                 p_v_cod_trans_debi_d      := v_cod_trans_debi;
                 p_v_nro_operacion_d       := v_nro_operacion;
                 p_v_cotizacion_d          := v_cotizacion;
                 p_v_codigoOficinaOrigen_d := v_mensajeCaja.codigoOficinaOrigen;
                 p_v_cod_mod_padre_d       := v_cod_mod_padre_d;
                 p_v_cod_mad_padre_d       := v_cod_mad_padre_d;
                 p_v_concepto_d            := v_concepto;
                 p_v_nro_cta_credito_d     := v_nro_cta_credito;
                 p_v_nro_secuencia_d       := v_nro_secuencia;
                 p_v_fec_valor_d           := v_fec_valor;
                 p_v_mto_equ_local_d       := v_mto_equ_local;                 --------------------------------------------------------------------             
                 --pag_cta.pr_act_operacion(v_nro_cta_debito, v_hor_actual, 'D', v_cod_mon_debito,
                 --                         v_monto, v_cod_tra_padre_d, v_cod_trans_debi, v_nro_operacion,
                 --                         v_cotizacion, v_mensajeCaja.codigoOficinaOrigen
                 --                          /*v_cod_ofi_origen*/, v_cod_mod_padre_d, v_cod_mad_padre_d, NULL, NULL,
                 --                         nvl(v_concepto, 'Transf. a ' || v_nro_cta_credito), 'N',
                 --                         v_nro_secuencia, v_fec_valor, NULL, NULL, v_mto_equ_local);
                 pag_cta.g_cod_error := 0;
                 --------------------------------------------------------------------             
                 --TCE-521 Fin                                                                            
                 IF nvl(pag_cta.g_cod_error, 0) = 0 THEN
                    IF v_cod_mon_credito <> v_cod_mon_local AND
                       v_cod_mon_debito <> v_cod_mon_credito AND v_cod_mon_debito = v_cod_mon_local THEN
                       v_mto_equ_local := v_monto;
                    ELSIF v_cod_mon_debito <> v_cod_mon_local AND
                          v_cod_mon_debito <> v_cod_mon_credito AND
                          v_cod_mon_credito <> v_cod_mon_local THEN
                       -- arbitraje, el equivalente en mon.local es igual al calculado en el anterior
                       v_cotizacion := v_cot_credito;
                    ELSE
                       v_mto_equ_local := NULL;
                    END IF;
                                      
                      v_fec_hora:=to_char(v_fec_valor,'dd/mm/yyyy')|| ' ' || v_hor_sysdate;
                      
                      if v_cod_cli_debito is not null and v_cod_cli_credito is not null then 
                          v_inf_deb_json:= '{' || '"fec_transferencia":' || '"' ||
                          v_fec_hora || '"' || ',' ||
           /*TRFS-1162   '"monto":' || '"' ||ltrim(rtrim(to_char(v_monto,'999,999,999,999,999.99')))||' '||initcap(v_cod_mon_debito)||'.'||'"' || ',' ||
             TRFS-1162*/ '"monto":' || '"' ||ltrim(rtrim(to_char(v_monto,'999,999,999,999,990.00')))||' '||initcap(v_cod_mon_debito)||'.'||'"' || ',' ||
                         '"nro_transaccion":' || '"' ||v_nro_operacion || '"' || ',' ||
                         '"nom_cue_debito":' || '"' ||
                         fue_obt_nom_persona(v_cod_cli_debito)|| '"' || ',' ||
                         '"num_cue_debito":' || '"' ||
                         v_nro_cta_debito || '"' || ',' ||
                         '"nom_beneficiario":' || '"' ||
                          fue_obt_nom_persona(v_cod_cli_credito) || '"' || ',' ||
                         '"num_cue_beneficiario":' || '"' ||
                         v_nro_cta_credito || '"' || ',' ||
                         '"ban_cue_beneficiario":' || '"' ||
                        fue_obt_nom_persona(FUG_OBT_PER_ENTIDAD) || '"' || ',' ||
                         '"notas":' || '"' ||nvl(v_concepto, 'Transf. a ' || v_nro_cta_credito)|| '"' || '}';
                    end if;
                    -- seteo las variables
                    --pag_cta.pr_set_variables(v_cod_usuario, v_fec_actual,
                    --                        v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL,
                    --                        v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/, 9,
                    --                        91);                    
                    --pag_cta.pr_act_operacion(v_nro_cta_credito, v_hor_actual, 'C',
                    --                         v_cod_mon_credito, v_mto_credito, v_cod_tra_padre, 602,
                    --                         v_nro_operacion, v_cot_credito,
                    --                         v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/,
                    --                         9, 91, NULL, NULL,
                    --                         nvl(v_concepto, 'Transf. de ' || v_nro_cta_debito), 'N',
                    --                         v_nro_secuencia, v_fec_valor, NULL, NULL,
                    --                         v_mto_equ_local);
                    --TCE-217
                    pag_cta.pr_set_variables(v_cod_usuario, v_fec_actual,
                                            v_cod_tra_padre_c, 'N', 'N', v_nro_secuencia, NULL,
                                            v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/, v_cod_mod_padre_c,
                                            v_cod_mad_padre_c);                    
                    --TCE-521 Inicio
                     p_v_nro_cta_credito_c      := v_nro_cta_credito;
                     p_v_hor_actual_c           := v_hor_actual;
                     p_v_cod_mon_credito_c      := v_cod_mon_credito;
                     p_v_mto_credito_c          := v_mto_credito;
                     p_v_cod_tra_padre_c_c      := v_cod_tra_padre_c;
                     p_v_cod_trans_cred_c       := v_cod_trans_cred;
                     p_v_nro_operacion_c        := v_nro_operacion;
                     p_v_cot_credito_c          := v_cot_credito;
                     p_v_cod_ofi_origen_c       := v_mensajeCaja.codigoOficinaOrigen;
                     p_v_cod_mod_padre_c_c      := v_cod_mod_padre_c;
                     p_v_cod_mad_padre_c_c      := v_cod_mad_padre_c;
                     p_v_concepto_c             := v_concepto;
                     p_v_nro_secuencia_c        := v_nro_secuencia;
                     p_v_fec_valor_c            := v_fec_valor;
                     p_v_mto_equ_local_c        := v_mto_equ_local;
                     
                    -------------------------------------------------------------------- 
                    --pag_cta.pr_act_operacion(v_nro_cta_credito, v_hor_actual, 'C',
                    --                         v_cod_mon_credito, v_mto_credito, v_cod_tra_padre_c, v_cod_trans_cred,
                    --                         v_nro_operacion, v_cot_credito,
                    --                         v_mensajeCaja.codigoOficinaOrigen /*v_cod_ofi_origen*/,
                    --                         v_cod_mod_padre_c, v_cod_mad_padre_c, NULL, NULL,
                    --                         nvl(v_concepto, 'Transf. de ' || v_nro_cta_debito), 'N',
                    --                         v_nro_secuencia, v_fec_valor, NULL, NULL,
                    --                         v_mto_equ_local);                                             
                    pag_cta.g_cod_error := 0;
                    -------------------------------------------------------------------- 
                    --TCE-521 Fin                    
                    IF nvl(pag_cta.g_cod_error, 0) <> 0 THEN
                       -- hubo error en el credito
                       pr_mensajeUsuario(c_tra_cta_cre_error, v_retorno.nombreRespuesta,
                                         v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                           v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                           'fu_transferencias ' ||
                                            'PR_ACT_OPERACION - Cta Credito: ' || v_nro_cta_credito ||
                                            fu_generarBitacora(v_retorno.error,
                                                               v_retorno.nombreRespuesta,
                                                               v_retorno.descripcionRespuesta, NULL),
                                           bitacora_error);

                    ELSE
                       
                      if v_cod_cli_debito is not null and v_cod_cli_credito is not null then 
                          v_inf_cre_json:= '{' || '"fec_transferencia":' || '"' ||
                          v_fec_hora || '"' || ',' ||
           /*TRFS-1162   '"monto":' || '"' ||ltrim(rtrim(to_char(v_mto_credito,'999,999,999,999,999.99')))||' '||initcap(v_cod_mon_credito)||'.'||'"' || ',' ||
             TRFS-1162*/ '"monto":' || '"' ||ltrim(rtrim(to_char(v_mto_credito,'999,999,999,999,990.00')))||' '||initcap(v_cod_mon_credito)||'.'||'"' || ',' ||
                         '"nro_transaccion":' || '"' ||v_nro_operacion || '"' || ',' ||
                         '"nom_cue_debito":' || '"' ||
                         fue_obt_nom_persona(v_cod_cli_debito)|| '"' || ',' ||
                         '"num_cue_debito":' || '"' ||
                         v_nro_cta_debito || '"' || ',' ||
                         '"ban_cue_debito":' || '"' ||
                         fue_obt_nom_persona(FUG_OBT_PER_ENTIDAD) || '"' || ',' ||
                         '"nom_beneficiario":' || '"' ||
                          fue_obt_nom_persona(v_cod_cli_credito) || '"' || ',' ||
                         '"num_cue_beneficiario":' || '"' ||
                         v_nro_cta_credito || '"' || ',' ||
                         '"ban_cue_beneficiario":' || '"' ||
                         fue_obt_nom_persona(FUG_OBT_PER_ENTIDAD) || '"' || '}';
                    end if;
                           
                    END IF;
                    -- cambio el estado del contrato de cambio
                    IF nvl(v_nro_contrato, 0) <= 0 THEN
                       BEGIN
                          SELECT nvl(a.nro_contrato, 0)
                            INTO v_nro_contrato
                            FROM lc_con_cambios a, bw_mov_pendientes b
                           WHERE b.nro_cuenta = a.nro_cta_debito
                             AND a.estado = 'P'
                             AND ((a.mto_compra = b.mto_contra) OR (a.mto_compra = b.monto) OR
                                 (a.mto_venta = b.mto_contra) OR (a.mto_venta = b.monto))
                             AND ((a.cot_venta = b.cot_contra) OR (a.cot_venta = b.cotizacion) OR
                                 (a.cot_compra = b.cot_contra) OR (a.cot_compra = b.cotizacion))
                             AND b.nro_documento = nvl(to_number(v_nro_operacion), 0)
                             AND trunc(a.fec_insercion) = v_fec_servidor;
                       EXCEPTION
                          WHEN no_data_found THEN
                             BEGIN
                                SELECT nvl(a.nro_contrato, 0)
                                  INTO v_nro_contrato
                                  FROM lc_con_cambios a, bw_mov_pendientes b
                                 WHERE b.nro_cuenta = a.nro_cta_debito
                                   AND a.estado <> 'P'
                                   AND ((a.mto_compra = b.mto_contra) OR (a.mto_compra = b.monto) OR
                                       (a.mto_venta = b.mto_contra) OR (a.mto_venta = b.monto))
                                   AND ((a.cot_venta = b.cot_contra) OR
                                       (a.cot_venta = b.cotizacion) OR
                                       (a.cot_compra = b.cot_contra) OR
                                       (a.cot_compra = b.cotizacion))
                                   AND b.nro_documento = nvl(to_number(v_nro_operacion), 0)
                                   AND trunc(a.fec_insercion) = v_fec_servidor;
                             EXCEPTION
                                WHEN no_data_found THEN
                                   NULL;
                                WHEN OTHERS THEN
                                   NULL;
                             END;
                             IF nvl(v_nro_contrato, 0) > 0 THEN
                                pr_mensajeUsuario(c_cont_cambio_invalido, v_retorno.nombreRespuesta,
                                                  v_retorno.descripcionRespuesta, v_retorno.error);
                                pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal,
                                                    v_sesion, v_tip_mensaje,
                                                    retValidarSesion.codigoEmpresa,
                                                    'fu_transferencias ' ||
                                                     'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                                     v_nro_contrato || ' ' ||
                                                     fu_generarBitacora(v_retorno.error,
                                                                        v_retorno.nombreRespuesta,
                                                                        v_retorno.descripcionRespuesta,
                                                                        NULL), bitacora_error);
                             END IF;
                          WHEN OTHERS THEN
                             NULL;

                       END;
                    END IF;
                    IF nvl(v_nro_contrato, 0) > 0 THEN
                       --volver a controlar antes de actualizar para evitar
                       --utilizar dos veces el mismo contrato
                       BEGIN
                          SELECT COUNT(*)
                            INTO v_con_contrato
                            FROM lc_con_cambios
                           WHERE nro_contrato = v_nro_contrato
                             AND estado = 'P';
                       EXCEPTION
                          WHEN OTHERS THEN
                             --v_cod_respuesta := paw_bel.v_cont_cambio_invalido;
                             pr_mensajeUsuario(c_cont_cambio_invalido, v_retorno.nombreRespuesta,
                                               v_retorno.descripcionRespuesta, v_retorno.error);
                             pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal,
                                                 v_sesion, v_tip_mensaje,
                                                 retValidarSesion.codigoEmpresa,
                                                 'fu_transferencias ' ||
                                                  'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                                  v_nro_contrato || ' ' ||
                                                  fu_generarBitacora(v_retorno.error,
                                                                     v_retorno.nombreRespuesta,
                                                                     v_retorno.descripcionRespuesta,
                                                                     NULL), bitacora_error);
                       END;
                       IF v_con_contrato = 1 THEN
                          lp_val_con_cambio('C', v_nro_contrato, NULL, NULL, NULL, NULL, NULL, NULL,
                                            v_cod_respuesta);
                       ELSE
                          --v_cod_respuesta := paw_bel.v_cont_cambio_invalido;
                          pr_mensajeUsuario(c_cont_cambio_invalido, v_retorno.nombreRespuesta,
                                            v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                              v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                              'fu_transferencias ' ||
                                               'Contrato de Cambio Inválido - Nro. Contrato:' ||
                                               v_nro_contrato || ' ' ||
                                               fu_generarBitacora(v_retorno.error,
                                                                  v_retorno.nombreRespuesta,
                                                                  v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                       END IF;
                    END IF; -- Fin
                    -- envío de SMS
                    IF v_retorno.error = 'N' THEN
                       IF v_cod_cli_debito !=
                          v_cod_cli_credito THEN
                          /*
                           pag_sms.pr_pro_servicio_014(p_nro_cuenta      => v_nro_cta_debito,
                                                       p_monto           => v_monto,
                                                       p_nro_cta_destino => v_nro_cta_credito);
                          */
                          NULL;
                       END IF;
                    END IF;
                 ELSE
                    -- hubo error en el debito
                    --v_cod_respuesta := paw_bel.v_cod_tra_invalida;
                    pr_mensajeUsuario(c_tra_cta_deb_error, v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion,
                                        v_tip_mensaje, retValidarSesion.codigoEmpresa,
                                        'fu_transferencias ' || 'PR_ACT_OPERACION - Cta Debito: ' ||
                                         v_nro_cta_debito ||
                                         fu_generarBitacora(v_retorno.error,
                                                            v_retorno.nombreRespuesta,
                                                            v_retorno.descripcionRespuesta, NULL),
                                        bitacora_error);
                 END IF;
                 /*HA-2718 - DA-7829*/
                 IF v_retorno.error = 'N' THEN
                   DECLARE
                     reg_snp  pas_snp.rg_msj;
                   BEGIN
                     lp_obt_doc_beneficiario(reg_snp,v_cod_cli_credito);
                     lp_obt_doc_solicitante(reg_snp,v_cod_cli_debito);
                     IF reg_snp.nro_doc_beneficiario is not null and 
                        reg_snp.nro_doc_solicitante is not null then
                       reg_snp.nro_referencia               := v_nro_operacion;
                       reg_snp.nro_cta_beneficiario         := v_nro_cta_credito;
                       reg_snp.nro_cta_solicitante          := v_nro_cta_debito;
                       reg_snp.fec_recepcion                := v_fec_valor;
                       reg_snp.monto                        := v_mto_credito;
                       prg_gen_aler_tra_rrhh(reg_snp, 'I');
                     END IF;
                     EXCEPTION
                       WHEN OTHERS THEN
                         NULL;
                   END;
                 END IF;
              END IF;
           END IF;
        END IF;
     END IF;
         
     IF v_cod_cli_debito != v_cod_cli_credito THEN
       v_tip_mensaje:='039';
     END IF;
     paw_con.pr_reg_operacion(v_nro_cta_debito, /*p_nro_cuenta*/ v_cod_mon_debito, /*p_cod_moneda */
                      v_monto, /*p_monto*/ v_nro_cta_credito, /*p_nro_cta_contra*/ NULL,
                       /*p_cantidad*/ 'Contrato de cambio', /*p_etiqueta*/ v_nro_contrato, /*p_dato*/
                      NULL, /*p_etiqueta2*/ NULL, /*p_dato2*/ 'Transferencias', /*observacion*/ v_dir_ip,
                       /*direccion IP*/ NULL, /*p_cod_respuesta*/ retValidarSesion.codigoPersona,
                       /*cod_persona*/ v_tip_mensaje, /*cod_operacion*/ v_nro_operacion,
                       /*nro_operacion*/ v_cod_canal, /*nro_terminal*/ v_sesion, /*clave*/
                      nvl(retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa)); /*cod_per_empresa*/
    v_retorno.numeroDocumento:=v_nro_operacion;
     -- no se responde nada, solo la cantidad de firmas 000, solo se debe setear el v_cod_respuesta
     IF v_retorno.error = 'N' THEN
        -- si hubo error, ya se registro mas arriba
        pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                            retValidarSesion.codigoEmpresa,
                            'fu_transferencias ' || 'Cta deb:' || v_cta_for_debito || ' cta cre:' ||
                             v_cta_for_credito || ' mto:' || v_monto || ' modo:' || p_modo || ' ' ||
                             fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, NULL),
                            bitacora_salida);
      /*if nvl(pag_cta.g_cod_error, 0) = 0 then -->si se hizo correctamente el debito/credito
     
       if v_inf_deb_json is not null then
         --Insertar correo para el solicitante
          lp_env_tra_notificacion(v_cod_cli_debito,fue_obt_val_max_referencia('TIP_MAI_PRODUCTO','ENVTRA'),v_inf_deb_json,v_tip_mensaje,retError);--tipo de prod 12
       end if;   
         if v_inf_cre_json is not null then
          --Insertar correo para el beneficiario                    
          lp_env_tra_notificacion(v_cod_cli_credito,fue_obt_val_max_referencia('TIP_MAI_PRODUCTO','RECTRA'),v_inf_cre_json,v_tip_mensaje,retError);--tipo de prod 13
       end if;
      end if;*/--TCE-249
     END IF;

     /*Obtiene la informacion de parámetros recibos y el return del type*/
     paw_log.g_typ_transferencia := v_retorno;
     paw_log.pr_logValoresTypes('typ_transferencia',
     'fu_Tranferencia_sdc'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
     p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
     p_cotizacion||', '|| p_mtocredito||', '||
     p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);

     RETURN v_retorno;
  EXCEPTION
     WHEN OTHERS THEN
        /*Obtiene la informacion de parámetros recibos y el return del type*/
        paw_log.g_typ_transferencia := v_retorno;
        paw_log.pr_logValoresTypes('typ_transferencia',
        'fu_Tranferencia_sdc Modo V'||' '||v_sesion||', '|| p_codcanal||', '||  p_nroctadebito||', '||
        p_monto||', '|| p_nroctacredito||', '|| p_modo||', '||
        p_cotizacion||', '|| p_mtocredito||', '||
        p_concepto||', '|| p_nrodoccredito||', '|| p_concambio||', '||p_cotcredito);


        pr_mensajeUsuario(c_op_error, v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                            retValidarSesion.codigoEmpresa,
                            'fu_transferencias_sdc ' || ' deb: ' || v_nro_cta_debito || ' credito: ' ||
                             v_nro_cta_credito || '-Monto:' || v_monto || ' -Modo' || v_modo ||
                             ' - ' ||
                             fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, NULL)||' '||
                            DBMS_UTILITY.format_error_stack||' - '||
                            DBMS_UTILITY.format_error_backtrace,
                            bitacora_error);
        RETURN v_retorno;
  END;
  -- fin de 030-confirmacion de transferencia entre cuentas
   --TCE-521 Fin
-------------------------------------------------------------------------------  
  /**
   * Carga de parámetros iniciales de SNP
   * @param p_sesion
   * @param p_codigoCanal
   */
    FUNCTION fu_parametrizacionInicialSnp( p_codigoPersona IN VARCHAR2,
                                           p_codigoEmpresa IN VARCHAR2,
                                           p_codigoCanal   IN VARCHAR2)
                                         RETURN typ_parametrizacionInicialSnp IS

         c_cod_operacion      constant varchar2(03) := '036';
         v_dias               number := 7;
         v_con                number := 0;
         v_fec_actual         date := pag_cal.fu_obt_fec_actual(9);
         v_var_fecha          date;

         v_cod_canal          varchar2(3);
         v_sesion             bw_aut_sesiones.cod_sesion%type;
         userInfo             typ_validarSesion;
         v_retorno            typ_parametrizacionInicialSnp := typ_parametrizacionInicialSnp;
         v_log_mensaje        varchar2(1000);
         v_cta_bcp_gs_liquidacion  ge_snp_cta_bancos.nro_cta_bancaria%type;
         v_cta_bcp_usd_liquidacion ge_snp_cta_bancos.nro_cta_bancaria%type;
         v_bcp_cod_swift           ge_bancos.cod_swift%type := lf_obt_bco_swift(1);

         -- Variables Internas
         v_listaDocumentos         typ_listaDocumentoSnp       := typ_listaDocumentoSnp();
         v_listaEntidades          typ_listaEntidadSnp         := typ_listaEntidadSnp();
         v_listaPlanillas          typ_listaPlanillaSnp        := typ_listaPlanillaSnp();
         v_listaTipoSipap          typ_listaTipoSnp            := typ_listaTipoSnp();
         v_listaMotivosSipap       typ_listaMotivosSnp         := typ_listaMotivosSnp();
         v_listaDiasHabiles        typ_listaDiasHabiles        := typ_listaDiasHabiles();
         v_mensajeCaja             typ_mensajeCaja;

         v_horario         VARCHAR2(1) := 'D'; -- Dia normal
         v_es_mov_noc      VARCHAR2(1) := 'N';
         v_es_cta_noc      VARCHAR2(1) := 'N'; -- Graba S/N ctas noctunas
         v_fec_valor       DATE := v_fec_actual;
         retError          typ_mensajerespuesta := typ_mensajerespuesta;

         cursor entidades  is
            Select g.cod_swift, decode(g.cod_swift, 'COMAPYPA', fug_obt_pardinamico('NOM_ENT_FORM'), g.participante) participante
            from gv_snp_participantes g
            where g.ind_hab_pte_hb = 'S'
            union all
            select d.cod_swift_sub, d.subparticipante
            from ge_snp_patrocinador_det d
            where estado = 'S'
            order by 2, 1;

         cursor documentos is          
             Select a.cod_tip_documento, a.abreviatura, a.descripcion
            from ba_tip_documentos a
            where a.estado = 'A'
            and a.cod_tip_documento in  
                 (select s.val_minimo
                    from ba_cod_referencias s
                   where s.dominio = 'SNP_TIP_DOCUMENTO'
                     and nvl(s.activo, 'N') = 'S') --DA-7315
            order by 1, 2 ;

         cursor planillas is
           Select nro_plantilla, nro_cta_solicitante, cod_moneda, monto, cod_swi_pte_beneficiario,
              nro_cta_beneficiario,nom_beneficiario, dir_beneficiario, cod_tip_doc_beneficiario,
              nro_doc_beneficiario
             from ge_snp_plantillas
            where cod_persona = userInfo.codigoPersona
              and (userInfo.codigoEmpresa is null or cod_per_vinculada = userInfo.codigoEmpresa)
            order by fec_insercion desc;

         cursor motivos is
            select r.abreviatura, r.val_minimo
              from ba_cod_referencias r
             where r.dominio = 'TRA_TIP_MOTIVO'
             and r.val_minimo not in('14','17','18','0')
             order by 1;

         cursor c_tip_transferencia is
            select s.val_minimo, s.significado
              from ba_cod_referencias s
             where s.dominio = 'TIP_TRA_SIPAP';


     BEGIN
        v_sesion             := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
        v_cod_canal          := depurarAlfanumerico(p_codigoCanal,3);

        pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

        -- 1. valido la clave del cliente
        --userInfo := paw_bel.fu_validarSesion(v_sesion, v_cod_canal);
         userInfo.error:='N';
         userInfo.codigoCanal:=v_cod_canal;
         userInfo.codigoPersona:=p_codigoPersona;
         userInfo.codigoEmpresa:=p_codigoEmpresa;
         
        --Logear parámetros
        v_log_mensaje := 'fu_parametrizacionInicialSnp (sesion='||v_sesion||', codigoCanal='||v_cod_canal|| ')';
        pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_log_mensaje, BITACORA_ENTRADA);

        v_cta_bcp_gs_liquidacion  := pas_snp.fu_obt_cta_ban_participante(v_bcp_cod_swift,pag_gen.FU_OBT_MON_LOCAL);
        v_cta_bcp_usd_liquidacion := pas_snp.fu_obt_cta_ban_participante(v_bcp_cod_swift,pag_gen.FU_OBT_MON_FUERTE);

        IF (userInfo.error = 'S') THEN
           v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
           v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
           v_retorno.error                := 'S';

           /* Obtiene la informacion de parámetros recibos y el return del type */
           paw_log.g_typ_parametroInicialSnp := v_retorno;
           paw_log.pr_logValoresTypes('typ_parametrizacionInicialSnp',
           'fu_parametrizacionInicialSnp'||' '||v_sesion||', '|| p_codigoCanal);
           RETURN v_retorno;
        END IF;

          --Valida Caja
          v_mensajeCaja := lf_val_caja(userInfo);

          IF v_mensajeCaja.error = 'S' THEN
             v_retorno.error                := v_mensajeCaja.error;
             v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
             v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
             RETURN v_retorno;
          END IF;

          --controla horario cierre
          if nvl(fug_obt_pardinamico('BWE_BLO_HOR_CIERRE'),'N') = 'S' then
              reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                          v_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                          -- IN
                                          v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                          -- IN
                                          v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

               IF reterror.error = 'S' THEN
                  v_retorno.error                := reterror.error;
                  v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
                  v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
                  RETURN v_retorno;
               END IF;
          end if;

        FOR en IN entidades LOOP
           DECLARE
            v_entidades typ_entidadSnp := typ_entidadSnp;
           BEGIN
            v_entidades.codigoSwift   := en.cod_swift;
            v_entidades.participante  := en.participante;
            v_entidades.ctaBcpGsLiquidacion  := v_cta_bcp_gs_liquidacion;
            v_entidades.ctaBcpUsdLiquidacion := v_cta_bcp_usd_liquidacion;
            v_listaEntidades.extend;
            v_listaEntidades(v_listaEntidades.count) := v_entidades;
           END;
        END LOOP;


        FOR do IN documentos LOOP
           DECLARE
            v_documentos typ_documentoSnp := typ_documentoSnp;
           BEGIN
            v_documentos.codigoDocumento   := do.cod_tip_documento;
            v_documentos.abreviatura       := do.abreviatura;
            v_documentos.descripcion       := do.descripcion;
            v_listaDocumentos.extend;
            v_listaDocumentos(v_listaDocumentos.count) := v_documentos;
           END;
        END LOOP;

        FOR pl IN planillas LOOP
           DECLARE
              v_planillas typ_planillaSnp := typ_planillaSnp;
           BEGIN
              v_planillas.numeroPlanilla      := pl.nro_plantilla;
              v_planillas.cuentaSolicitante   := pl.nro_cta_solicitante;
              v_planillas.codigoMoneda        := pl.cod_moneda;
              v_planillas.monto               := pl.monto;
              v_planillas.swiftBeneficiario   := pl.cod_swi_pte_beneficiario;
              v_planillas.cuentaBeneficiario  := pl.nro_cta_beneficiario;
              v_planillas.nombreBeneficiario  := pl.nom_beneficiario;
              v_planillas.direccionBeneficiario := pl.dir_beneficiario;
              v_planillas.tipoDocBeneficiario   := pl.cod_tip_doc_beneficiario;
              v_planillas.numeroDocBeneficario  := pl.nro_doc_beneficiario;
              v_listaPlanillas.extend;
              v_listaPlanillas(v_listaPlanillas.count) := v_planillas;
           END;
        END LOOP;

        FOR mo IN motivos LOOP
          DECLARE
            v_motivos typ_motivoSnp := typ_motivoSnp;
          BEGIN
            v_motivos.codigoMotivo := mo.val_minimo;
            v_motivos.motivo       := mo.abreviatura;
            v_listaMotivosSipap.extend;
            v_listaMotivosSipap(v_listaMotivosSipap.count) := v_motivos;
          END;
        END LOOP;


        FOR ti IN c_tip_transferencia LOOP
          DECLARE
            v_tipos typ_tipoTransferenciasSnp := typ_tipoTransferenciasSnp;
          BEGIN
            v_tipos.codigoTipo := ti.val_minimo;
            v_tipos.tipo       := ti.significado;
            v_listaTipoSipap.extend;
            v_listaTipoSipap(v_listaTipoSipap.count) := v_tipos;
          END;
        END LOOP;

        FOR en IN 1 .. v_dias LOOP
          DECLARE
            v_DiasHabiles typ_diasHabiles := typ_diasHabiles;
          BEGIN
            v_con := v_con + 1;
            If v_con = 1 then
              v_DiasHabiles.fecha       := lf_for_date(v_fec_actual);
              v_var_fecha               := to_date(v_DiasHabiles.fecha,'ddmmyyyy');
            else
               v_DiasHabiles.fecha       := lf_for_date(pag_cal.fu_obt_fec_sig_hab((v_var_fecha),null));
               v_var_fecha               := to_date(v_DiasHabiles.fecha,'ddmmyyyy');
            end if;
            v_listaDiasHabiles.extend;
            v_listaDiasHabiles(v_listaDiasHabiles.count) := v_DiasHabiles;

          END;
        END LOOP;
       v_retorno.listaEntidades    := v_listaEntidades;
       v_retorno.listaDocumentos   := v_listaDocumentos;
       v_retorno.listaPlanillas    := v_listaPlanillas;
       v_retorno.listaMotivosSipap := v_listaMotivosSipap;
       v_retorno.listaTipoSipap    := v_listaTipoSipap;
       v_retorno.listaDiasHabiles  := v_listaDiasHabiles;
       RETURN v_retorno;
     EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_cargaSipap-' || SQLERRM || '-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         /* Obtiene la informacion de parámetros recibos y el return del type */
         paw_log.g_typ_parametroInicialSnp := v_retorno;
         paw_log.pr_logValoresTypes('typ_parametrizacionInicialSnp',
         'fu_parametrizacionInicialSnp'||' '||v_sesion||', '|| p_codigoCanal);
         RETURN v_retorno;
    END fu_parametrizacionInicialSnp;  
    PROCEDURE pr_obt_usu_hor_mov_int(p_usuario   in varchar2,p_usu_mov    out varchar2,p_hor_mov    out varchar2)  is
      v_tip_oper            varchar2(10):='ENV';
      v_tip_transferencia   ba_cod_referencias.val_maximo%type;
      v_val_minimo          ge_par_dinamicos.val_parametro%type;
      v_val_maximo          ge_par_dinamicos.val_parametro%type;
      v_par_min             ge_parametros.parametro%type;
      v_par_max             ge_parametros.parametro%type;
      v_can_registro        number(5):=0;
      v_secuencia           varchar2(100);
      v_nro_sec  number;
      v_can_user number;
      v_nro_user number;
      v_ind_usuario number;
      v_nro_hor     number;
      begin
          if p_usuario ='TRANINT' then                                       
             v_tip_transferencia:=FUE_OBT_VAL_MAX_REFERENCIA('TRA_INT_USUARIO',p_usuario);
             --se obtiene el nombre de los parametros de la cant. minima y maxima
            v_par_min:= v_tip_transferencia||'_CAN_MIN_USU';
            v_par_max:= v_tip_transferencia||'_CAN_MAX_USU';
            --se obtiene el valor minimo y maximo para la generacion de usuarios y secuencias
            v_val_minimo:=nvl(fug_obt_pardinamico(v_par_min),1);
            v_val_maximo:=nvl(fug_obt_pardinamico(v_par_max),5);
            ---se obtiene el usuario
            p_usu_mov:=p_usuario||'_'||round(dbms_random.value(v_val_minimo,v_val_maximo));
            --se valida si el usuario esta registrado en ba_usuarios
            select count(*)
            into v_can_registro
            from ba_usuarios us
            where us.cod_usuario=p_usu_mov;

            if v_can_registro=0 then
                p_usu_mov:=p_usuario;
                p_hor_mov:=to_char(sysdate,'HH24:MI:SS');
               return;
            end if;
            --se obtiene la secuencia para generar la hora del movimiento
             v_secuencia:='S_HOR_MOV_'||p_usu_mov;
            --se obtiene la hora en base a la secuencia
            p_hor_mov:=fuw_obt_mov_hora(v_secuencia);
            
            
            else 
              select count(*)
                into v_can_user
                from ba_cod_referencias
               where dominio = 'USU_MOV_SERVICIO'
                 and abreviatura = 'PAYMPVU';
              
              v_nro_sec  := fue_obt_sig_secuencia('S_SER_PAYMPVU');
              v_nro_user := mod(v_nro_sec, v_can_user);
              p_usu_mov  := it.FUE_OBT_VAL_USER_DOMINIO('USU_MOV_SERVICIO',
                                                        v_nro_user,
                                                        'PAYMPVU');
              
              if instr(p_usu_mov, '_', 1) = 0 then
                v_ind_usuario := 0;
              else
                --El substr tiene como valor 2 ya que el usuario puede tener más de dos caracteres _15  _11 _10
                v_ind_usuario := substr(p_usu_mov,
                                        instr(p_usu_mov, '_', 1) + 1,
                                        2);
              end if;
              
              if v_ind_usuario > 0 then
                v_nro_sec := fue_obt_sig_secuencia('s_hor_movpaympvu' /*||'_'*/
                                                   || v_ind_usuario);
              elsif v_ind_usuario = 0 then
                v_nro_sec := fue_obt_sig_secuencia('S_HOR_MOVPAYMPVU');
              end if;
              
              v_nro_hor := mod(v_nro_sec, 86400);
              
              p_hor_mov := TO_CHAR(trunc(v_nro_hor / 3600), 'FM9900') || ':' ||
                        TO_CHAR(TRUNC(MOD(v_nro_hor, 3600) / 60), 'FM00') || ':' ||
                        TO_CHAR(MOD(v_nro_hor, 60), 'FM00');
              end if;
      exception
           when others then
               p_usu_mov:=p_usuario;
               p_hor_mov:=to_char(sysdate,'HH24:MI:SS');
      end;
--inicializacion del paquete
BEGIN
   pre_cam_for_numerico('.,');
   PRE_INI_APLICACION;
   PAE_CNF.G_COD_MODULO := 9; --Modulo caja
END PAW_BEL;
/
