CREATE OR REPLACE PACKAGE BODY IT.PAW_BEL IS
  
   /** Codigo de respuesta OK generico  --*/
   MSG_OK CONSTANT VARCHAR2(30) := 'OP_APROBADA';

   /** Codigo de respuesta OK, para proceso nocturno*/
   MSG_OK_NOC CONSTANT VARCHAR2(15) := 'OP_APR_NOCTURNA';

   /** Codigo de error generico, Ej. excepciones no manejadas */
   MSG_ERROR CONSTANT VARCHAR2(30) := 'OP_ERROR';

   /** Constantes de tipo de Bitácora */

   BITACORA_ERROR   CONSTANT VARCHAR2(3) := 'ERR';
   BITACORA_ENTRADA CONSTANT VARCHAR2(3) := 'ENT';
   BITACORA_SALIDA  CONSTANT VARCHAR2(3) := 'SAL';
   c_cod_mon_fuerte CONSTANT ba_monedas.cod_moneda%type := pag_gen.fu_obt_mon_fuerte;

   CUENTA_TAMANO CONSTANT NUMBER(3) := 18;

   ---en PAW_BCE v_tip_mensaje estaba global y publica
   v_tip_mensaje        VARCHAR2(10); -- guarda el tipo IAC
   v_can_aut_requeridas NUMBER(5) := 0; -- cantidad de firmas requeridas
   v_ind_cta_encriptada VARCHAR2(1) :=  nvl(fug_obt_pardinamico('BWE_ENC_CUENTA',NULL,NULL,NULL),'N');
   --v_hor_cie_cheques    VARCHAR2(08) := '12:00:00'; -- hora de cierre fijo para cheques cargo otros bancos.

   --en el original era publica
   v_cod_mon_local VARCHAR2(3) := pag_gen.FU_OBT_MON_LOCAL;
   -- para controlar si viene de fu_autorizarOperacion
   g_aut_operacion BOOLEAN := FALSE;
   v_fec_actual         DATE:= pag_cal.fu_obt_fec_actual(9);
   /**Estructura interna para verificar el estado de la caja*/
   TYPE typ_mensajeCaja IS RECORD(
      error                VARCHAR2(1),
      nombreRespuesta      VARCHAR2(15),
      descripcionRespuesta VARCHAR2(200),
      estadoCaja           VARCHAR2(1),
      tipoCaja             VARCHAR2(1),
      codigoOficinaOrigen  NUMBER(3),
      codigoUsuario        VARCHAR2(10),
      fechaUltimoCierre    DATE,
      fechaCierre          DATE);
   FUNCTION depurarCuenta(p_string  IN VARCHAR2,
                          maxLength IN NUMBER) RETURN VARCHAR2 IS
   BEGIN
      RETURN SUBSTR(REGEXP_REPLACE(TRIM(p_string), '([^[:alnum:]*-])', ''), 1, maxLength);
   END;
   
   FUNCTION lf_obt_permisos(p_cod_persona   IN VARCHAR2,
                            p_cod_perfil    IN VARCHAR2,
                            p_cod_operacion IN VARCHAR2,
                            p_nro_terminal  IN VARCHAR2) RETURN typ_obtenerPermisos IS
      v_retorno  typ_obtenerPermisos;
      v_consulta VARCHAR(5);
      v_registra VARCHAR(5);
      v_autoriza VARCHAR(5);
      c_msg_op_no_permitida constant varchar2(15) := '135';
      c_msg_sal_per_sin_aut constant varchar2(15) := '280';
   BEGIN
     /*
      SELECT TRIM(decode(consulta, 'S', 'C', '') || decode(ingresa, 'S', 'I', '') || decode(autoriza, 'S', 'A', ''))
        INTO v_tip_mensaje
        FROM bw_tip_mensajes
       WHERE cod_tip_mensaje = p_cod_operacion;
      BEGIN
         pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         -- busco primero especifico para la empresa
         SELECT decode(consulta, 'S', 'TRUE', 'FALSE'), decode(ingresa, 'S', 'TRUE', 'FALSE'), decode(autoriza, 'S', 'TRUE', 'FALSE'), nvl(can_firmas, 0)
           INTO v_consulta, v_registra, v_autoriza, v_can_aut_requeridas
           FROM bw_rol_permisos
          WHERE cod_perfil = p_cod_perfil
            AND cod_tip_mensaje = p_cod_operacion
            AND cod_persona = p_cod_persona;
      EXCEPTION
         WHEN no_data_found THEN
            BEGIN
              -- busco los permisos generales para el perfil
                SELECT decode(consulta, 'S', 'TRUE', 'FALSE'), decode(ingresa, 'S', 'TRUE', 'FALSE'), decode(autoriza, 'S', 'TRUE', 'FALSE'), nvl(can_firmas, 0)
                  INTO v_consulta, v_registra, v_autoriza, v_can_aut_requeridas
                  FROM bw_rol_permisos
                 WHERE cod_perfil = p_cod_perfil
                   AND cod_tip_mensaje = p_cod_operacion
                   AND cod_persona IS NULL;
            EXCEPTION
               WHEN no_data_found THEN
                 pr_mensajeUsuario(c_msg_sal_per_sin_aut, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(p_cod_persona, p_nro_terminal, NULL, p_cod_operacion, NULL, 'lf_obt_permisos Permiso No encontrdo-', BITACORA_ERROR);
            END;
      END;
      IF v_can_aut_requeridas > 0 AND p_nro_terminal != C_COD_HOMEBANKING THEN
         -- operacion no permitida en autoservicios por requerir autorizacion
         pr_mensajeUsuario(c_msg_op_no_permitida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(p_cod_persona, p_nro_terminal, NULL, p_cod_operacion, NULL, 'Operacion no permitida en canal-', BITACORA_ERROR);
      END IF;

      v_retorno.autoriza         := (v_autoriza = 'TRUE');
      v_retorno.consulta         := (v_consulta = 'TRUE');
      v_retorno.registra         := (v_registra = 'TRUE');
      v_retorno.autorizacionesRequeridas := v_can_aut_requeridas;
   */
   --Inicialmente no vamos a utilizar los permisos en fielco
      v_retorno.autoriza         := TRUE;
      v_retorno.consulta         := TRUE;
      v_retorno.registra         := TRUE;
      v_retorno.canAutRequeridas := 0;

      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         RETURN v_retorno;
   END;

   /** Inserta registro en la tabla bw_bitacora
   * @param p_codigoPersona Código de persona
   * @param p_codigoCanal Código de canal
   * @param p_codSesion Código de la sesión
   * @param p_tipoMensaje Tipo de mensaje
   * @param p_codigoEmpresa Código de la persona vinculada
   * @param p_datos Información de lo realizado
   * @param p_tipo Tipo de la bitácora
   */
   PROCEDURE pr_insertarBitacora(p_codigoPersona IN VARCHAR2 DEFAULT NULL,
                                 p_codigoCanal   IN VARCHAR2 DEFAULT NULL,
                                 p_codSesion     IN VARCHAR2 DEFAULT NULL,
                                 p_tipoMensaje   IN VARCHAR2 DEFAULT NULL,
                                 p_codigoEmpresa IN VARCHAR2 DEFAULT NULL,
                                 p_datos         IN VARCHAR2 DEFAULT NULL,
                                 p_tipo                IN VARCHAR2 DEFAULT NULL,
                                 p_numeroTelefono      IN VARCHAR2 DEFAULT NULL,
                                 p_codigoError         IN VARCHAR2 DEFAULT NULL,
                                 p_observacion         IN VARCHAR2 DEFAULT NULL,
                                 p_codigoMotivo        IN VARCHAR2 DEFAULT NULL,
                                 p_numeroCuentaDebito  IN VARCHAR2 DEFAULT NULL,
                                 p_numeroCuentaCredito IN VARCHAR2 DEFAULT NULL,
                                 p_monto               IN NUMBER DEFAULT NULL,
                                 p_codigoMoneda        IN VARCHAR2 DEFAULT NULL,
                                 p_dato2               IN CLOB DEFAULT NULL
                                 ) IS
      PRAGMA AUTONOMOUS_TRANSACTION;
   BEGIN
      INSERT INTO bw_bitacoras
         (COD_PERSONA, COD_CANAL, COD_SESION, COD_TIP_MENSAJE, COD_PER_VINCULADA,
         DATO, TIPO, DATO2)
      VALUES
         (p_codigoPersona, p_codigoCanal, p_codSesion, p_tipoMensaje, p_codigoEmpresa,
         SUBSTR(p_datos, 1, 4000), p_tipo, p_dato2);

      IF p_tipo = BITACORA_ERROR and p_observacion is not null THEN
         insert into bw_log_incidencias
           (nro_telefono, cod_error, usu_insercion, fec_insercion, observacion,
            nro_caja, cod_tip_mensaje, cod_persona, nro_cta_debito,
            nro_cta_credito, monto, cod_moneda, cod_motivo)
         values
           (p_numeroTelefono,p_codigoError,user,sysdate, p_observacion,
            p_codigoCanal, p_tipoMensaje, p_codigoPersona, p_numeroCuentaDebito,
            p_numeroCuentaCredito, p_monto, p_codigoMoneda, p_codigoMotivo);
      END IF;

      COMMIT;
   EXCEPTION
      WHEN OTHERS THEN
         NULL;
   END;
   
   FUNCTION lp_ver_horario(p_horario        OUT VARCHAR2
                          ,p_es_mov_noc     OUT VARCHAR2
                          ,p_es_cta_noc     OUT VARCHAR2
                          ,p_ult_cierre     IN  DATE
                          ,p_cod_ofi_origen IN  VARCHAR2
                          ,p_fec_actual     OUT DATE
                          ,p_fec_cie_caja   IN  DATE
                          ,p_fec_valor      OUT DATE) RETURN typ_MensajeRespuesta IS

      c_msg_sis_cierre constant varchar2(15) := '106';
      v_est_modulo     ba_modulos.estado%TYPE;
      v_retorno        typ_MensajeRespuesta := typ_MensajeRespuesta;
   BEGIN
      --v_cod_respuesta := paw_bce.v_cod_aprobado;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      p_horario    := 'D'; -- Dia normal
      p_es_mov_noc := 'N'; -- Para grabar en las tablas nocturnas
      p_es_cta_noc := 'N';
      if nvl(v_tra_spi,'N') !='S' then
          p_fec_actual := pag_cal.FU_OBT_FEC_ACTUAL(9);
          v_est_modulo := pae_cnf.FU_OBT_EST_MODULO(9);
      elsif nvl(v_tra_spi,'N') ='S' then
          p_fec_actual := pag_cal.FU_OBT_FEC_ACTUAL(3);
          v_est_modulo := pae_cnf.FU_OBT_EST_MODULO(3);
      end if;
     IF v_est_modulo = 2 THEN
         -- El modulo esta abierto

         -- Verifica la hora --
         IF nvl(v_tra_spi,'N') !='S' then
           IF SYSDATE > p_ult_cierre AND trunc(p_ult_cierre) = p_fec_actual THEN
              p_horario    := 'T'; -- Tarde
              p_fec_actual := pag_cal.FU_OBT_FEC_HABIL(p_fec_actual + 1, 1, p_cod_ofi_origen);
              p_es_mov_noc := 'S'; -- Para grabar en las tablas nocturnas
           END IF;
         END IF;
      ELSE
         if nvl(fug_obt_pardinamico('BWE_BLO_HOR_CIERRE'),'N') = 'N' then
        -- En cierre.
        --  v_retorno.error := paw_bce.v_cod_sis_cierre;
           pr_mensajeUsuario(c_msg_sis_cierre, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(NULL, NULL, NULL, C_COD_HOMEBANKING, NULL, ' lp_ver_horario()-Sistema en cierre-', BITACORA_ERROR);
        else
        --
          p_horario:='N';
          p_es_mov_noc := 'S'; -- Para grabar en las tablas nocturnas
          p_es_cta_noc := 'S';
          p_fec_actual := pag_cal.FU_OBT_FEC_HABIL(p_fec_actual + 1, 1, p_cod_ofi_origen);
       end if;

      END IF;
      pag_cta.g_horario := p_horario;
      p_fec_valor:=trunc(sysdate);
      v_mod_estado := v_est_modulo;
      RETURN v_retorno;
   END;

   PROCEDURE lp_set_tip_transferencia(p_tip_valor in varchar2,
                                      r_gtran     in out pas_snp.rg_msj) is
   begin
    if p_tip_valor = 'C' then
      r_gtran.cod_msj_swift         := 103;
      r_gtran.cod_tip_operacion     := '001';
      r_gtran.cod_sub_tip_operacion := '002';
    elsif p_tip_valor = 'B' then
      r_gtran.cod_msj_swift         := 102;
      r_gtran.cod_tip_operacion     := '011';
      r_gtran.cod_sub_tip_operacion := '001';
    end if;
  -- Circular SGGOF Nº 009/2020 --
  if pas_snp.fu_obt_est_horario( r_gtran.cod_msj_swift,
                   r_gtran.cod_tip_operacion,
                   r_gtran.cod_sub_tip_operacion
                 ) = 'A' then --Si el horario está VIGENTE en BCP
       r_gtran.cod_msj_swift         := 103;
       r_gtran.cod_tip_operacion     := '001';
       r_gtran.cod_sub_tip_operacion := '002';
  elsif pas_snp.fu_obt_est_horario( r_gtran.cod_msj_swift,
                     r_gtran.cod_tip_operacion,
                     r_gtran.cod_sub_tip_operacion
                   ) <> 'A' --Si el horario está CERRADO en BCP then
            and fus_obt_cod_msj_homebanking(pag_cal.fu_obt_fec_actual(1)) = 'MT103' then -- Horario corresponde a MT103
       r_gtran.cod_msj_swift         := 103;
       r_gtran.cod_tip_operacion     := '001';
       r_gtran.cod_sub_tip_operacion := '002';
  elsif pas_snp.fu_obt_est_horario( r_gtran.cod_msj_swift,
                     r_gtran.cod_tip_operacion,
                     r_gtran.cod_sub_tip_operacion
                   ) <> 'A' --Si el horario está CERRADO en BCP then
            and fus_obt_cod_msj_homebanking(pag_cal.fu_obt_fec_actual(1)) = 'MT102' then -- Horario corresponde a MT102
              
       r_gtran.cod_msj_swift         := 102;
       r_gtran.cod_tip_operacion     := '011';
       r_gtran.cod_sub_tip_operacion := '001';
    end if;
    if nvl(v_tra_spi,'N')='S' and p_tip_valor != 'B' and nvl(v_tra_spi_ind,'N') not in ('R')then--redireccionar
       r_gtran.cod_msj_swift         := fug_obt_pardinamico( 'COD_SPI_PCD' );
       
       if nvl(v_patrocinador,'N')='S' then --SPI Fase 2
          r_gtran.cod_tip_operacion     := '002';
          r_gtran.cod_sub_tip_operacion := '002';
       else
            if v_alias is  not null then
               r_gtran.cod_tip_operacion     := '011';
               r_gtran.cod_sub_tip_operacion := '002';
            else
               r_gtran.cod_tip_operacion     := '001';
               r_gtran.cod_sub_tip_operacion := '002';
            end if;
       end if;
    end if; 
    --DA-7221 
    IF nvl(v_patrocinador,'N')='S' and nvl(v_tra_spi,'N')!='S' THEN ---si es sub-participante siempre debe ir por 103
          r_gtran.cod_msj_swift:=103;
          r_gtran.cod_tip_operacion            := '001';
          r_gtran.cod_sub_tip_operacion        := '004';
          r_gtran.tip_cargo                    := 'OUR';
    END IF;
   exception
    when others then
      r_gtran.cod_msj_swift         := 102;
      r_gtran.cod_tip_operacion     := '011';
      r_gtran.cod_sub_tip_operacion := '001';
   END lp_set_tip_transferencia;
   
   FUNCTION lf_obt_cta_limpia( p_nro_cta_especifica varchar2,
                              p_cod_operacion      varchar2,
                              p_cod_persona        varchar2)
                             RETURN VARCHAR2 IS
    v_nro_cta_especifica varchar2(30) := replace(replace(replace(trim(p_nro_cta_especifica),
                                                                  '.', '-'), ' ', '-'),'/','-');
     v_pos number;
   BEGIN
     if v_nro_cta_especifica is not null then
       if (instr(v_nro_cta_especifica, '-') > 0 or
          instr(v_nro_cta_especifica, ' ') > 0) then
         -- se extrae los guiones de la cuenta
         If p_cod_operacion = '031' then
           -- Si es pago de prestamos solo debe quitarle el guion y el espacio si tiene
           v_nro_cta_especifica := trim(replace(replace(v_nro_cta_especifica,
                                                        '-',
                                                        ''),
                                                ' ',
                                                ''));
         Else
           v_pos := instr(v_nro_cta_especifica, '-', -1);
           if v_pos > 0 then
             v_nro_cta_especifica := to_number(substr(v_nro_cta_especifica,
                                                      v_pos + 1));
           end if;
         End if;
       elsif length(v_nro_cta_especifica) = 16 then
         -- es un tarjeta de credito, busco y reemplazo el dato
         begin
           select a.nro_cuenta
             into v_nro_cta_especifica
             from ge_cta_clientes a, ta_tarjetas b
            where b.nro_tarjeta = trim(v_nro_cta_especifica)
              and b.nro_cuenta = a.nro_cuenta
              and a.cod_persona = p_cod_persona;
         exception
           when no_data_found then
             select b.nro_cuenta
               into v_nro_cta_especifica
               from ta_tarjetas b
              where b.nro_tarjeta = trim(v_nro_cta_especifica)
                and vigente = 'S'
                and rownum = 1;
         end;
       elsif substr(v_nro_cta_especifica, 1, 2) = '00' then
         v_nro_cta_especifica := to_number(v_nro_cta_especifica);
       end if;
     end if;
     return v_nro_cta_especifica;
   EXCEPTION
     WHEN OTHERS THEN
       RETURN NULL;
   END;
   
   /*VALIDA LA DUPLICACION DEL MOVIMIENTO*/
   PROCEDURE lp_val_duplicacion(p_nro_cta_debito      in varchar2,
                                 p_mto_debito          in number,
                                 p_dato                in varchar2,
                                 p_cod_tra_padre       in number,
                                 p_tie_ctr_duplicacion in number,
                                 p_cod_per_empresa     in number,
                                 p_cod_persona         in number,
                                 p_cod_usuario         in varchar2,
                                 p_cod_swi_bco_beneficiario in ge_snp_transferencias.cod_swi_pte_beneficiario%type default null,
                                 p_fec_actual          date,
                                 v_mensaje             out paw_bel.typ_mensajeCaja
                                 ) is
      v_existe     varchar2(1) := 'S';
      v_es_mov_noc varchar2(1) := 'N'; -- Graba S/N mov nocturnosc
      c_cod_mov_duplicado constant varchar2(04) := '134';
      v_snp_tra_padre ge_transacciones.cod_transaccion%type;
    BEGIN
      v_snp_tra_padre:=pas_snp.fu_obt_cod_tra_padre;
      pr_mensajeUsuario(MSG_OK, v_mensaje.nombreRespuesta, v_mensaje.descripcionRespuesta, v_mensaje.error);
      begin
        select 'S'
          into v_existe
          from bw_mov_pendientes
         where cod_per_principal = p_cod_per_empresa
           and nro_cuenta = p_nro_cta_debito
           and monto = p_mto_debito
           and estado = 'P'
           and cod_tip_mensaje = '036'
           and dato = p_dato
           and can_aut_faltantes > 0
           and (sysdate - fec_insercion) * 24 * 60 <= p_tie_ctr_duplicacion
           and rownum = 1;
      exception
        when too_many_rows then
          v_existe := 'S';
        when others then
          v_existe := 'N';
      end;
      if nvl(v_existe,'N') = 'N' and nvl(p_cod_tra_padre,0)=v_snp_tra_padre then
         begin
            select 'S'
              into v_existe
              from ge_snp_transferencias h
             where h.cod_per_solicitante =
                   nvl(p_cod_per_empresa, p_cod_persona)
               and h.nro_cta_solicitante = p_nro_cta_debito
               and h.monto = p_mto_debito
               and h.nro_cta_beneficiario = p_dato
               and h.cod_swi_pte_beneficiario=p_cod_swi_bco_beneficiario
               and (sysdate - h.fec_insercion) * 24 * 60 <= p_tie_ctr_duplicacion
               and rownum = 1;
          exception
            when too_many_rows then
              v_existe := 'S';
            when others then
              v_existe := 'N';
          end;
     end if;
      if v_existe = 'N'   then
        if v_es_mov_noc = 'S' then
          begin
            select distinct 'S'
              into v_existe
              from ge_movimientos_noc
             where nro_cuenta = p_nro_cta_debito
               and cod_tra_padre = p_cod_tra_padre
               and monto = p_mto_debito
               and reversado = 'N'
               and nro_secuencia = '1'
               and cod_usuario = p_cod_usuario
                  -- Controla que por lo menos haya pasado 10 minutos
               and (sysdate - fec_insercion) * 24 * 60 <=
                   p_tie_ctr_duplicacion
               and rownum = 1;
          exception
            when too_many_rows then
              v_existe := 'S';
            when others then
              v_existe := 'N';
          end;
        else
          begin
            select distinct 'S'
              into v_existe
              from ge_movimientos
             where nro_cuenta = p_nro_cta_debito
               and cod_tra_padre = p_cod_tra_padre
               and monto = p_mto_debito
               and reversado = 'N'
               and nro_secuencia = '1'
               and cod_usuario = p_cod_usuario
               and fecha = p_fec_actual
                  -- Controla que por lo menos haya pasado 10 minutos
               and (sysdate - fec_insercion) * 24 * 60 <= p_tie_ctr_duplicacion
               and rownum = 1;
          exception
            when too_many_rows then
              v_existe := 'S';
            when others then
              v_existe := 'N';
          end;
        end if;
      end if;  
      if nvl(v_existe, 'N') = 'S' then
        pr_mensajeUsuario(c_cod_mov_duplicado,v_mensaje.nombreRespuesta,v_mensaje.descripcionRespuesta,v_mensaje.error);
      end if;
   EXCEPTION
      WHEN NO_DATA_FOUND THEN
        null;
      WHEN TOO_MANY_ROWS then
        pr_mensajeUsuario(c_cod_mov_duplicado, v_mensaje.nombreRespuesta,v_mensaje.descripcionRespuesta,v_mensaje.error);
   END;
   
   function lf_obt_tot_operaciones(p_codEmpresa      in varchar2,
                                p_codPersona      in varchar2,
                                p_nro_cuenta      in ge_cuentas.nro_cuenta%type,
                                p_tip_mensaje     in varchar2,
                                p_cod_padre       in ge_transacciones.cod_transaccion%type)
    return number is
    v_total_gs number(18,2) := 0;
    v_total_usd number(18,2) := 0;
    v_mon_local ba_monedas.cod_moneda%type:=pag_gen.FU_OBT_MON_LOCAL;
    v_mon_fuerte ba_monedas.cod_moneda%type:=pag_gen.FU_OBT_MON_FUERTE;
    cursor c_transferecncias is 
    select monto,cod_moneda,nro_documento
    from( select nvl(j.monto, 0) monto, j.cod_moneda, j.nro_documento
          from ge_movimientos j, ge_cta_clientes c
         where j.estado = 'N'
           and j.reversado = 'N'
           and j.cod_transaccion = '503'
           and j.cod_tra_padre=p_cod_padre
           and trunc(j.fec_insercion) = trunc(sysdate)
           and j.nro_cuenta = c.nro_cuenta
           and j.nro_cuenta = nvl(p_nro_cuenta,j.nro_cuenta)
           and c.cod_persona = nvl(p_codEmpresa, p_codPersona)
        union all
        select nvl(n.monto, 0) monto, n.cod_moneda, n.nro_documento
          from ge_movimientos_noc n, ge_cta_clientes c
         where n.estado = 'N'
           and n.reversado = 'N'
           and n.cod_transaccion = '503'
           and n.cod_tra_padre=p_cod_padre
           and trunc(n.fec_insercion) = trunc(sysdate)
           and n.nro_cuenta = c.nro_cuenta
           and n.nro_cuenta = nvl(p_nro_cuenta,n.nro_cuenta)
           and c.cod_persona = nvl(p_codEmpresa, p_codPersona))
      where exists (SELECT 1
          FROM bw_movimientos h
         WHERE h.nro_documento = nro_documento
           AND h.nro_caja = C_COD_HOMEBANKING
           AND trunc(h.fec_insercion) = trunc(sysdate)
           AND h.cod_per_principal = nvl(p_codEmpresa, p_codPersona)
           AND h.nro_cuenta = nvl(p_nro_cuenta,h.nro_cuenta)
           AND h.cod_tip_mensaje = p_tip_mensaje);
      
        cursor c_tra_sipap is
        select nvl(s.monto, 0) monto, s.cod_moneda, s.nro_referencia nro_documento
          from ge_snp_transferencias s
         where s.cod_per_solicitante = nvl(p_codEmpresa, p_codPersona)
           AND s.nro_cta_solicitante=nvl(p_nro_cuenta,s.nro_cta_solicitante)
           AND trunc(s.fec_insercion) = trunc(sysdate)
           and estado not in ('C', 'E');
  
   begin
   --Esta función totaliza las transferencias sipap y terceros por persona  
   /*Suma movimientos diarios en moneda local*/
 
      if  p_tip_mensaje = '036' then --sipap
        for rec in c_tra_sipap loop
        if rec.cod_moneda = v_mon_local then
          v_total_gs:=v_total_gs+rec.monto;
        elsif rec.cod_moneda = v_mon_fuerte then
          v_total_usd:=v_total_usd+rec.monto;
        end if;
      end loop;
     else
      for rec in c_transferecncias loop
        if rec.cod_moneda = v_mon_local then
          v_total_gs:=v_total_gs+rec.monto;
        elsif rec.cod_moneda = v_mon_fuerte then
          v_total_usd:=v_total_usd+rec.monto;
        end if;
      end loop;
    end if;
       
      select nvl(v_total_gs,0) + nvl(sum(monto),0)
      into v_total_gs
      from bw_mov_pendientes p
     where p.cod_per_principal = nvl(p_codEmpresa,p_codPersona)
       and estado = 'P'
       and p.cod_moneda= v_mon_local
       and trunc(p.fec_insercion) = trunc(sysdate)
       and p.nro_cuenta=nvl(p_nro_cuenta,p.nro_cuenta)
        and p.cod_tip_mensaje=p_tip_mensaje;
                
      select nvl(v_total_usd,0) + nvl(sum(monto),0)
      into v_total_usd
      from bw_mov_pendientes p
     where p.cod_per_principal = nvl(p_codEmpresa,p_codPersona)
       and estado = 'P'
       and p.cod_moneda=v_mon_fuerte
       and trunc(p.fec_insercion) = trunc(sysdate)
       and p.nro_cuenta=nvl(p_nro_cuenta,p.nro_cuenta)
       and p.cod_tip_mensaje=p_tip_mensaje;
       
       v_total_usd := nvl(v_total_usd,0)*pag_gen.FU_OBT_COTIZACION(pag_gen.FU_OBT_MON_FUERTE,v_fec_actual);

     return nvl(v_total_gs,0)+nvl(v_total_usd,0);
   end;
   
   function lf_obt_lim_cliente(p_cod_canal in varchar2,
                               p_cod_persona in varchar2,
                               p_cod_tip_mensaje in varchar2,
                               p_cod_moneda in varchar2)
    return number is
    v_retorno number(18,2) := NULL;
   begin
      select mto_limite
        into v_retorno
        from bw_cli_limites
       where cod_canal = p_cod_canal
         and cod_persona = p_cod_persona
         and nvl(cod_tip_mensaje,'x') = nvl(p_cod_tip_mensaje,'x')
         and cod_moneda = p_cod_moneda;
      return v_retorno;
   exception
      when others then
         return null;
   end;
   
   -- procedimiento que valida el contrato de cotizacion

  procedure lp_val_con_cambio (p_operacion       in  varchar2 , -- V/C (Valida, Confirma)
                               p_nro_contrato    in  number,
                               p_cod_mon_debito  in  varchar2 default null,
                               p_cod_mon_credito in  varchar2 default null,
                               p_nro_cta_debito  in  varchar2 default null,
                               p_nro_cta_credito in  varchar2 default null,
                               p_cotizacion      in  number   default 0,
                               p_importe         in  number   default 0,
                               p_cod_mensaje     out varchar2  ) is

    v_tipo              varchar2(1);
    v_cont_mon_compra   lc_con_cambios.cod_mon_compra%TYPE;
    v_cont_cotiz_compra lc_con_cambios.Cot_Compra%TYPE;
    v_cont_mon_venta    lc_con_cambios.cod_mon_venta%TYPE;
    v_cont_cotiz_venta  lc_con_cambios.Cot_venta%TYPE;
    v_paridad           lc_con_cambios.paridad%TYPE;
    v_mto_compra        lc_con_cambios.mto_compra%TYPE;
    v_mto_venta         lc_con_cambios.mto_venta%Type;
    v_cta_debito        lc_con_cambios.nro_cta_debito%Type;
    v_cta_credito       lc_con_cambios.nro_cta_credito%Type;
    v_fec_actual        ge_calendarios.fec_actual%type:= pag_cal.FU_OBT_FEC_ACTUAL(1);
    v_fec_servidor      date := trunc(sysdate);
    c_con_cam_invalido constant varchar2(3) := '162';
    c_con_mto_invalido constant varchar2(3) := '180';
    c_con_cta_deb_inv  constant varchar2(3) := '182';
    c_con_cta_cre_inv  constant varchar2(3) := '183';
    c_cot_con_cam_inv  constant varchar2(3) := '163';

  begin
    p_cod_mensaje := MSG_OK;
    if p_nro_contrato > 0 then
      if p_operacion = 'V' then
        if p_cod_mon_debito <> v_cod_mon_local   and
          p_cod_mon_credito <> v_cod_mon_local  then
          v_tipo := 'A'; -- arbitraje
        elsif p_cod_mon_credito = v_cod_mon_local  and
          p_cod_mon_debito <> v_cod_mon_local then
          v_tipo := 'C'; -- compra
        else
          v_tipo := 'V'; -- venta
        end if;
        begin
           select cod_mon_compra,
                  cot_compra,
                  cod_mon_venta,
                  cot_venta,
                  paridad,
                  nvl(mto_compra,0),
                  nvl(mto_venta,0),
                  nro_cta_debito,
                  nro_cta_credito
             into v_cont_mon_compra,
                  v_cont_cotiz_compra,
                  v_cont_mon_venta,
                  v_cont_cotiz_venta,
                  v_paridad,
                  v_mto_compra,
                  v_mto_venta,
                  v_cta_debito,
                  v_cta_credito
             from lc_con_cambios
            where nro_contrato = p_nro_contrato
              and estado = 'P'
              and tipo = v_tipo
              and trunc(fec_insercion) = v_fec_servidor;
        exception
           when others then
             p_cod_mensaje := c_con_cam_invalido;
        end;
        if p_cod_mensaje = MSG_OK then
           if (v_mto_compra != p_importe and v_mto_venta != p_importe ) then
               p_cod_mensaje := c_con_mto_invalido;
           elsif v_cta_debito != p_nro_cta_debito then
               p_cod_mensaje := c_con_cta_deb_inv;
           elsif v_cta_credito != p_nro_cta_credito and p_nro_cta_credito is not null
                 and nvl(v_cta_credito,0) != 0 then
               p_cod_mensaje := c_con_cta_cre_inv;
           end if;
        end if;
        --valido la cotizacion recibida Vs. la cotizacion del contrato
        if (v_tipo = 'A' and p_cotizacion != v_paridad ) OR
           (v_tipo = 'V' and p_cotizacion != v_cont_cotiz_venta ) OR
           (v_tipo = 'C' and p_cotizacion != v_cont_cotiz_compra ) then
           p_cod_mensaje := c_cot_con_cam_inv;
        end if;
      else
        update lc_con_cambios
           set estado = 'C'
         where nro_contrato = p_nro_contrato;
      end if;
    end if;
  end;
  
  PROCEDURE lp_con_mon_a_moneda(p_cod_mon_original IN ba_monedas.cod_moneda%TYPE,
                                p_cod_mon_destino  IN ba_monedas.cod_moneda%TYPE,
                                p_mto_mon_original IN NUMBER,
                                p_mto_mon_destino  OUT NUMBER,
                                p_cot_mon_original IN OUT NUMBER,
                                p_cot_mon_destino  IN OUT NUMBER,
                                p_interbancaria    IN VARCHAR2 DEFAULT NULL) IS
   v_lugar           varchar2(100);
  begin
      if p_cot_mon_original <= 0 then
         p_cot_mon_original := null;
      end if;
      if p_cot_mon_destino <= 0 then
         p_cot_mon_destino := null;
      end if;
      v_lugar := 'obtener moneda base';
      if p_cod_mon_original = p_cod_mon_destino  then
          p_mto_mon_destino := p_mto_mon_original;
          if p_cod_mon_original <> v_cod_mon_local then
             p_cot_mon_destino := nvl(p_cot_mon_original,pag_gen.fu_obt_cotizacion(p_cod_mon_original));
             p_cot_mon_original := p_cot_mon_destino;
          else
             p_cot_mon_destino := 1;
             p_cot_mon_original := 1;
          end if;
      else
        if nvl(p_interbancaria,'N') = 'N' then
           if  p_cod_mon_original <> v_cod_mon_local and p_cod_mon_destino = v_cod_mon_local then
               --convertir moneda original a base o destino
               p_cot_mon_original := nvl(p_cot_mon_original,fuw_obt_cotizacion(p_cod_mon_original,'C'/*COMPRA*/,v_fec_actual));
               p_cot_mon_destino := 1;
               p_mto_mon_destino := round(p_mto_mon_original * p_cot_mon_original,0);
           elsif p_cod_mon_original = v_cod_mon_local and p_cod_mon_destino <> v_cod_mon_local then
               -- pasar moneda original a moneda base
               p_cot_mon_original := 1;
               p_cot_mon_destino := nvl(p_cot_mon_destino,fuw_obt_cotizacion(p_cod_mon_destino,'V'/*VENTA */,v_fec_actual));
               p_mto_mon_destino := round(p_mto_mon_original/p_cot_mon_destino,2);
           elsif p_cod_mon_original <> v_cod_mon_local and p_cod_mon_destino <> v_cod_mon_local then
               p_cot_mon_original := nvl(p_cot_mon_original,fuw_obt_cotizacion(p_cod_mon_original,'C'/*COMPRA*/,v_fec_actual));
               p_mto_mon_destino := p_mto_mon_original * p_cot_mon_original;
               p_cot_mon_destino := nvl(p_cot_mon_destino,fuw_obt_cotizacion(p_cod_mon_destino,'V'/*VENTA */,v_fec_actual));
               p_mto_mon_destino := round(p_mto_mon_destino/p_cot_mon_destino,2);
           end if;
        else
            if  p_cod_mon_original <> v_cod_mon_local and p_cod_mon_destino = v_cod_mon_local then
                --convertir moneda original a base o destino
                p_cot_mon_original := nvl(p_cot_mon_original,fuw_obt_cotizacion(p_cod_mon_original,'V'/*VENTA*/,v_fec_actual));
                p_cot_mon_destino := 1;
                p_mto_mon_destino := round(p_mto_mon_original * p_cot_mon_original,0);
            elsif p_cod_mon_original = v_cod_mon_local and p_cod_mon_destino <> v_cod_mon_local then
                -- pasar moneda original a moneda base
                p_cot_mon_original := 1;
                p_cot_mon_destino := nvl(p_cot_mon_destino,fuw_obt_cotizacion(p_cod_mon_destino,'C'/*COMPRA*/,v_fec_actual));
                p_mto_mon_destino := round(p_mto_mon_original/p_cot_mon_destino,2);
            elsif p_cod_mon_original <> v_cod_mon_local and p_cod_mon_destino <> v_cod_mon_local then
                p_cot_mon_original := nvl(p_cot_mon_original,fuw_obt_cotizacion(p_cod_mon_original,'V'/*VENTA*/,v_fec_actual));
                p_mto_mon_destino := p_mto_mon_original * p_cot_mon_original;
                p_cot_mon_destino := nvl(p_cot_mon_destino,fuw_obt_cotizacion(p_cod_mon_destino,'C'/*COMPRA*/,v_fec_actual));
                p_mto_mon_destino := round(p_mto_mon_destino/p_cot_mon_destino,2);
            end if;
        end if ;
      end if;
     exception
     when others then
        raise_application_error(-20000,v_lugar || ' - ' ||sqlerrm);
  end;

   /** Devuelve la moneda de una cuenta
   */
   function lf_obt_moneda(p_nro_cuenta in varchar2)
     return varchar2 is
     v_retorno varchar2(3);
   begin
     select cod_moneda
       into v_retorno
       from ge_cuentas
      where nro_cuenta = p_nro_cuenta
        and rownum = 1;
     return v_retorno;
   exception
     when others then
       return null;
   end;  

   /** Determina si la cuenta es una Cuenta Conjunta
   */
   function fu_es_conjunta(p_nro_cuenta      in varchar2
                          ,p_cod_persona     in varchar2
                          ,p_cod_per_empresa in varchar2) return varchar2 is
    v_can_conjunta  number;
    v_can_ind_pri   number; --cantidad de indistintas o principal
   begin
    /*      -- busco la relacion de la persona actual
          select count('S')
            into v_can_ind_pri
            from ge_cta_clientes
           where nro_cuenta = p_nro_cuenta
             and cod_persona = p_cod_persona
             and relacion in ('O','P');
    */
      --if nvl(v_can_ind_pri,0) = 0 then
         -- veo si la cuenta no es conjunta
         select count('S')
           into v_can_conjunta
           from ge_cta_clientes
         where nro_cuenta = p_nro_cuenta
            and relacion = 'Y'
            and rownum = 1;
      --end if;
      if p_cod_per_empresa is not null then
         return 'N';
      end if;
      if nvl(v_can_conjunta,0) > 0 and nvl(v_can_aut_requeridas, 0) = 0 then
        -- nueva condicion 17-01-2010
        /* no requiere autorizacion y la cuenta es conjunta, no debe acceder*/

        /*nueva condicion 17-01-2010
        Cuando una persona esta com ofirmante 'indistinta' de la cuenta, aunque existan
        otros firmantes que esten definidas como 'conjunta', permitir debitar  cuentas
        donde la persona este con regimen 'indistinto'.*/

        return 'S';
      else
        return 'N';
      end if;
   end;

   function fu_es_ope_limitadas(p_cod_mensaje in varchar2
                               ,p_nro_cuenta  in varchar2
                               ,p_cod_canal   in varchar2
                               ,p_fecha       in date)
    return varchar2 is
     v_lim_det        bw_limites.mto_maximo%type;
   begin
      v_lim_det :=  0;
      -- solo graba en BW_OPE_LIMITADAS si el mensaje está limitado en BW_LIMITES_DET
      select d.mto_mensaje
        into v_lim_det
        from bw_limites l, bw_limites_det d
       where l.cod_canal    = p_cod_canal
         and l.fec_inicio   <= p_fecha
         and l.cod_moneda   = c_cod_mon_fuerte
         and l.nro_secuencia   = d.nro_secuencia
         and d.cod_tip_mensaje = p_cod_mensaje
         and (l.nro_cuenta     = p_nro_cuenta
          or l.nro_cuenta is null)
         and (l.fec_vencimiento >= p_fecha
          or l.fec_vencimiento is null)
         and rownum = 1;

        if nvl(v_lim_det,0) > 0 then
           return 'S';
        else
           return 'N';
        end if;

   exception
    when no_data_found then
      return 'N';
    when others then
      return 'S';
   end;

  -- Verifica si no sobrepasa el límite de operaciones por día y semana.
  function fu_val_monto(p_monto       in number
                       ,p_cod_moneda  in varchar2
                       ,p_cod_mensaje in varchar2
                       ,p_nro_cuenta  in varchar2
                       ,p_cod_canal   in varchar2
                       ,p_fec_actual  in date)
      return varchar2 is
   v_lim_cab        bw_limites.mto_maximo%type;
   v_lim_det        bw_limites.mto_maximo%type;
   v_cod_mon_fuerte ba_monedas.cod_moneda%type := pag_gen.fu_obt_mon_fuerte;
   v_dias           bw_limites.dias%type;
   v_mto_cab        bw_limites.mto_maximo%type;
   v_mto_det        bw_limites.mto_maximo%type;
   v_control        bw_limites.dias%type;
   v_nro_secuencia  bw_limites.nro_secuencia%type;
   v_fec_servidor   date := trunc(sysdate);

   cursor c_limites is
      select l.mto_maximo, l.dias, l.nro_secuencia
        from bw_limites l
       where l.cod_canal    = p_cod_canal
         and l.fec_inicio  <= p_fec_actual
         and l.cod_moneda   = v_cod_mon_fuerte
         and (l.nro_cuenta  = p_nro_cuenta
          or l.nro_cuenta is null)
         and (l.fec_vencimiento >= v_fec_actual   -- Productos: se comenta para compilar y se reemplaza paw_bce.v_fec_actual
          or l.fec_vencimiento is null)
       order by l.nro_cuenta asc, l.fec_inicio desc, l.dias asc;

   cursor c_limites_det is
      select d.mto_mensaje
        from bw_limites l, bw_limites_det d
       where l.cod_canal    = p_cod_canal
         and l.fec_inicio  <= p_fec_actual
         and l.cod_moneda   = v_cod_mon_fuerte
         and l.nro_secuencia = d.nro_secuencia
         and l.nro_secuencia = v_nro_secuencia
         and d.cod_tip_mensaje = p_cod_mensaje
         and (l.nro_cuenta     = p_nro_cuenta
          or l.nro_cuenta is null)
          and (l.fec_vencimiento >= p_fec_actual
         or l.fec_vencimiento is null)
       order by l.nro_cuenta asc, l.fec_inicio desc;
  begin
       v_control := null;
       for i in  c_limites loop

         if v_control = i.dias then
            goto siguiente_registro;
         else
            v_control := i.dias;
         end if;

         v_lim_cab       := i.mto_maximo;
         v_lim_det       := 0;
         v_mto_cab       := 0;
         v_mto_det       := 0;
         v_dias          := i.dias - 1;
         v_nro_secuencia := i.nro_secuencia;

         begin
           select sum(nvl(a.monto,0))
             into v_mto_cab
             from bw_ope_limitadas a
            where a.cod_canal   = p_cod_canal
              and a.nro_cuenta  = p_nro_cuenta
              and trunc(a.fec_insercion) between  v_fec_servidor - v_dias  and v_fec_servidor;
         exception
           when others then
             return 'N';
         end;

         if v_lim_cab > 0
            and v_lim_cab < nvl(v_mto_cab,0) + nvl(p_monto,0) then
            return 'N';
         end if;

         if p_cod_mensaje is not null then
            if c_limites_det%isopen then
               close c_limites_det;
            end if;
            open c_limites_det;
               fetch c_limites_det into v_lim_det;
            close c_limites_det;
             begin
               select sum(nvl(a.monto,0))
                 into v_mto_det
                 from bw_ope_limitadas a
                where a.cod_canal   = p_cod_canal
                  and a.nro_cuenta  = p_nro_cuenta
                  and a.cod_tip_mensaje = p_cod_mensaje
                  and trunc(a.fec_insercion) between  v_fec_servidor - v_dias  and v_fec_servidor;
             exception
              when others then
               -- SDC v_cod_respuesta := v_cod_otr_error;
               return 'N';
             end;
             if nvl(v_lim_det,0) > 0
                and v_lim_det < nvl(v_mto_det,0) + nvl(p_monto,0) then
                return 'N';
             end if;
         end if;
         <<siguiente_registro>> null;
        end loop;
        return 'S';
  end;   
   
   FUNCTION fu_desencriptacionCuentas(p_clave  IN VARCHAR2) RETURN VARCHAR2 IS
      v_cadena           CHAR(16) := '39z06x8w74y25v1-';
      v_secuencia        CHAR(12) := '892804697513';
      v_caracter         char(01);
      v_sig_letra        varchar2(02);
      v_cad_final        varchar(12);
      v_cad_retorno      varchar(16);
      v_log_cadena       number(02);
      v_indice           number(02);
      v_aux_letra        number(02);
      v_letra            number(2);
      v_val_secuencia    number(2);
      v_nvo_valor        number(2);
      v_longitud         number(2) := 1;
      v_aux_valor        number(2);
      v_sig_valor        number(2);
      v_clave            varchar2(12);
      v_sub_cadena       varchar2(4);
   BEGIN
      IF INSTR(p_clave, '*') > 0 THEN
        v_sub_cadena := SUBSTR(p_clave, INSTR(p_clave, '*'));

        v_cad_retorno := REPLACE(v_sub_cadena, '*', '');
        RETURN v_cad_retorno;
      END IF;

      v_cad_final := null;
      v_log_cadena     := LENGTH(v_cadena);
      v_indice        := LENGTH(v_secuencia);

      v_clave := SUBSTR(lpad(p_clave, 16, '-'), 1, 12);
      v_aux_letra       := LENGTH(v_clave);
      IF v_aux_letra < v_indice + 1 THEN
        v_indice := (v_indice - v_aux_letra) + 1;
      ELSE
        v_aux_valor := MOD(v_aux_letra, v_indice);
        v_indice  := (v_indice - v_aux_valor) + 1;
        IF v_indice > LENGTH(v_secuencia) THEN
          v_indice := 1;
        END IF;
      END IF;
      LOOP
        v_caracter   := SUBSTR(v_clave, v_longitud, 1); -- Ubicar v_caracter
        v_letra := INSTR(v_cadena, v_caracter); -- v_nvo_valor de la letra
        v_val_secuencia := TO_NUMBER(SUBSTR(v_secuencia, v_indice, 1)); -- Numero en la secuencia
        IF v_longitud = v_aux_letra THEN
          v_sig_valor := 3;
        ELSE
          v_sig_letra := SUBSTR(v_clave, v_longitud + 1, 1); -- sgte. letra
          v_sig_valor := INSTR(v_cadena, v_sig_letra); -- valor sgte. letra
        END IF;
        v_nvo_valor := v_letra - (v_sig_valor + v_val_secuencia - 1); --obtener nuevo valor
        IF v_nvo_valor = 0 THEN
          v_nvo_valor := v_log_cadena;
        ELSE
          LOOP
            EXIT WHEN v_nvo_valor >= 1;
            v_nvo_valor := v_nvo_valor + v_log_cadena;
          END LOOP;
        END IF;
        IF v_cad_final IS NULL THEN
            v_cad_final := SUBSTR(v_cadena, v_nvo_valor, 1);
        ELSE
            v_cad_final := v_cad_final || SUBSTR(v_cadena, v_nvo_valor, 1);
        END IF;
        v_longitud := v_longitud + 1;
        v_indice   := v_indice + 1;
        IF v_indice > LENGTH(v_secuencia) THEN
          v_indice := 1;
        END IF;
        EXIT WHEN v_longitud >= v_aux_letra + 1;
      END LOOP;

      v_cad_retorno := v_cad_final || SUBSTR(p_clave, LENGTH(p_clave) - 3, 4);

      v_cad_retorno := REPLACE(v_cad_retorno,'-');

      Return v_cad_retorno;
   exception
      when others then
        return 0;
   END;   

  -- Graba los movimientos que operan bajo limites en Mobile Banking
  procedure pr_gen_monto(p_cod_mensaje in varchar2
                        ,p_monto       in number
                        ,p_cod_moneda  in varchar2
                        ,p_nro_cuenta  in varchar2
                        ,p_fec_actual  in date
                        ,p_cod_canal   in varchar2) is
   v_nro_secuencia number(9);

   begin
           select s_nro_operacion.nextval
             into v_nro_secuencia
             from dual;
           insert into bw_ope_limitadas
             (nro_secuencia, nro_cuenta, cod_tip_mensaje, cod_canal, fecha,  monto, cod_moneda)
           values
             (v_nro_secuencia, p_nro_cuenta, p_cod_mensaje, p_cod_canal, p_fec_actual, p_monto, p_cod_moneda);
    exception
      when others then
       null;
   end;
   
   FUNCTION depurarAlfanumerico(p_string  IN VARCHAR2,
                                maxLength IN NUMBER,
                                p_espacio IN CHAR DEFAULT 'N') RETURN VARCHAR2 IS
   BEGIN
      IF p_espacio = 'N' THEN
         RETURN SUBSTR(REGEXP_REPLACE(TRIM(p_string), '([^[:alnum:]])', ''), 1, maxLength);
      ELSE
         RETURN SUBSTR(REGEXP_REPLACE(TRIM(p_string), '([^[:alnum:][:space:]])', ''), 1, maxLength);
      END IF;
   END;
   FUNCTION depurarTextos(p_string  IN VARCHAR2,
                          maxLength IN NUMBER,
                          p_documento IN VARCHAR2 DEFAULT 'N') RETURN VARCHAR2 IS
   BEGIN
      IF p_documento = 'N' THEN --texto
         RETURN SUBSTR(REGEXP_REPLACE(TRIM(p_string), '([^0-9A-Za-z ,./_-])', ''), 1, maxLength);
      ELSE --documento
         RETURN SUBSTR(REGEXP_REPLACE(TRIM(p_string), '([^0-9A-Za-z-])', ''), 1, maxLength);
      END IF;
   END;
   FUNCTION depurarNumerico(p_string  IN VARCHAR2,
                            maxLength IN NUMBER) RETURN VARCHAR2 IS
   BEGIN
      RETURN SUBSTR(REGEXP_REPLACE(TRIM(p_string), '([^[:digit:]])', ''), 1, maxLength);
   END;

 --JCBM 10/08/2024
   FUNCTION depurarNumerico(p_string  IN VARCHAR2,
                            maxLength IN NUMBER,
							p_conDecimal IN VARCHAR2) RETURN VARCHAR2 IS
   BEGIN
      IF nvl(p_conDecimal,'N') = 'N' THEN
         RETURN SUBSTR(REGEXP_REPLACE(TRIM(p_string), '([^[:digit:]])', ''), 1, maxLength);
	  ELSE
	   RETURN SUBSTR(REGEXP_REPLACE(TRIM(p_string), '([^[:digit:].])', ''), 1, maxLength);
	  END IF; 
   END;
   --DDSI-91 OMM SEP/2017 Función para evaluar si debe o no generar movimiento por el cierre del modulo 9
   FUNCTION lf_val_gen_ope_cierre RETURN VARCHAR2 IS
    v_genera      varchar2(1) := 'S'; -- 'S' Puede Generar Operación. ('N' No Generar ninguna Operación)
    v_nro_orden   ge_par_dinamicos.val_parametro%type := Fug_Obt_Pardinamico('NRO_ORD_PROCESOS') ;
    /*NO se debe generar ningun tipo de movimientos cuando se esta corriendo alguno de estos procesos */
     BEGIN
         Select distinct('N')
           into v_genera
         from ge_procesos_det a
         where a.cod_proceso = 11
           and Instr(v_nro_orden, ','||a.nro_orden||',') > 0
           and a.hor_inicio is not null
           and a.hor_fin is null ;
         return v_genera;
      EXCEPTION
        WHEN OTHERS THEN
           RETURN v_genera ;
   end;

   /**
   * Valida si una dirección de correo es válida
   *
   * @param p_mail Dirección de correo a validar
   * @return Retorna 'S' si la dirección de correo es válida, en caso contrario retorna 'N'
   */
   FUNCTION lf_val_mail(p_mail IN VARCHAR2) RETURN VARCHAR2 IS
   BEGIN
      IF REGEXP_LIKE(p_mail, '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,5}$') THEN
         RETURN 'S';
      ELSE
         RETURN 'N';
      END IF;
   END;

   FUNCTION lf_for_date(p_dato IN DATE) RETURN CHAR IS
   BEGIN
      RETURN nvl(to_char(p_dato, 'ddmmyyyy'), ' ');
   END;

   -- devuelve el campo monto formateado
   FUNCTION lf_for_money(p_dato IN NUMBER,
                         p_longitud IN NUMBER DEFAULT NULL) RETURN VARCHAR2 IS
   BEGIN
      IF p_longitud IS NULL THEN
         RETURN ltrim(to_char(nvl(p_dato, 0), '9999999999999999.99'));
      ELSE
         RETURN lpad(ltrim(to_char(nvl(p_dato, 0), '9999999999999999.99')), p_longitud, ' ');
      END IF;
   END;

   FUNCTION fu_generarBitacora(error in varchar2, nombreRespuesta in varchar2 ,descripcionRespuesta in varchar2, mensajesAdicionales in varchar2 := NULL) RETURN VARCHAR2 IS
      v_linea    VARCHAR2(1000);
      v_paquete  VARCHAR2(1000);
      v_llamador VARCHAR2(1000);
      v_duenho   VARCHAR2(1000);
   BEGIN
      OWA_UTIL.WHO_CALLED_ME(v_duenho, v_paquete, v_linea, v_llamador);
      RETURN v_paquete || '.' || v_linea || sys_context('USERENV', 'ACTION') || ' Userid:' || sys_context('USERENV', 'SESSION_USER') || ' Ip:' || sys_context('USERENV', 'IP_ADDRESS') || ' isDBA:' || sys_context('USERENV', 'ISDBA') || ' Error:' ||(CASE error WHEN 'S' THEN 'T' WHEN 'N' THEN 'F' END) || ' nombreRespuesta:' || nombreRespuesta || ' descripcionRespuesta:' || descripcionRespuesta||' a:'||mensajesAdicionales;
   END;

   /* Función que devuelve si una cuenta tiene o no cheque devuelto
   */
   FUNCTION lf_obt_che_devuelto(p_nro_cuenta IN VARCHAR2) RETURN VARCHAR2 IS
      v_cantidad NUMBER;
   BEGIN
      SELECT COUNT(*)
        INTO v_cantidad
        FROM ge_movimientos
       WHERE nro_cuenta = p_nro_cuenta
         AND cod_mod_padre = 4
         AND cod_mad_padre = 41
         AND cod_tra_padre = 321
         AND cod_transaccion IN (522, 503, 182)
         AND reversado = 'N'
         AND estado = 'N'
         AND rownum = 1;
      IF v_cantidad > 0 THEN
         RETURN 'S';
      ELSE
         RETURN 'N';
      END IF;
   END;

   /** Devuelve el numero de tarjeta de credito de la Persona o Cuenta
   */
   FUNCTION lf_obt_nro_tarjeta(p_numeroCuenta    IN VARCHAR2,
                               p_cod_persona     IN VARCHAR2,
                               p_cod_per_empresa IN VARCHAR2) RETURN VARCHAR2 IS
   BEGIN
      RETURN paw_bce.fu_obt_nro_tarjeta(p_numeroCuenta, p_cod_persona, p_cod_per_empresa);
   END;

   FUNCTION lf_obt_mensaje(p_cod_persona VARCHAR2) RETURN VARCHAR2 IS
      v_mensaje VARCHAR2(500);
      CURSOR msjs IS
         SELECT substr(mensaje, 1, 300) mensaje
           FROM ge_msj_bca_ele
          WHERE trunc(SYSDATE) BETWEEN fec_desde AND fec_hasta
            AND (cod_persona = p_cod_persona OR cod_persona IS NULL)
          ORDER BY nvl(cod_persona, '#') DESC, fec_desde DESC;
   BEGIN
      OPEN msjs;
      FETCH msjs
         INTO v_mensaje;
      CLOSE msjs;
      RETURN v_mensaje;
   END;

   /** Obtiene un mensaje de la base de datos por el nombre del mensaje
   * @param p_mensaje Nombre del mensaje
   * @return p_nombreMensaje Nombre del mensaje
   * @return p_descripcionMensaje Descripción del mensaje
   * @return p_error Indicador de si es o no un mensaje de error
   */
   PROCEDURE pr_mensajeUsuario(mensaje            IN VARCHAR2,
                               nombreMensaje      OUT VARCHAR2,
                               descripcionMensaje OUT VARCHAR2,
                               error              OUT VARCHAR2) IS
      v_error VARCHAR2(1) /*:= 'S'*/;
   BEGIN
      BEGIN
         SELECT a.nombre, a.des_mensaje, a.error
           INTO nombreMensaje, descripcionMensaje, v_error
           FROM bw_men_respuesta a
          WHERE a.nombre = mensaje;
      EXCEPTION
         WHEN no_data_found THEN
            descripcionMensaje := 'No pudo recuperar el key de mensaje solicitado';
         WHEN OTHERS THEN
            descripcionMensaje := 'No pudo recuperar el key de mensaje solicitado';
      END;
      error := v_error;
   END;

   -- Obtiene fecha de nacimiento de persona fisica
   FUNCTION fu_obt_fec_nacimiento(p_cod_persona IN ba_personas.cod_persona%TYPE)
     RETURN VARCHAR2 IS
       v_fec_nacimiento VARCHAR2(10);
     BEGIN

       SELECT TO_CHAR(p.fec_nacimiento,'DD/MM/YYYY')
       INTO v_fec_nacimiento
       FROM BA_PER_FISICAS p
       WHERE p.cod_persona = p_cod_persona;

       RETURN v_fec_nacimiento;
     EXCEPTION
        WHEN no_data_found THEN
          -- solo para PF
          RETURN NULL;
        WHEN OTHERS THEN
          RETURN NULL;
     END;

   FUNCTION fu_obt_edad(p_cod_persona IN ba_personas.cod_persona%TYPE)
     RETURN NUMBER IS
     v_fec_nacimiento VARCHAR2(10);
     v_edad           NUMBER;
   BEGIN
      v_fec_nacimiento := fu_obt_fec_nacimiento(p_cod_persona);
      -- en caso que el resultado sea null por algun error
      if v_fec_nacimiento is null then
        return -1;
      end if;
      v_edad := floor(trunc(months_between(trunc(SYSDATE), TO_DATE(v_fec_nacimiento,'dd/MM/yyyy'))) / 12);
      RETURN v_edad;
   END;

   -- para autorizaciones
   PROCEDURE pr_set_autorizacion IS
   BEGIN
      -- para controlar el modo 'A' en las funciones que venga de autorizar
      g_aut_operacion := TRUE;
      -- esto para permitir debitar a cuentas conjuntas
      v_can_aut_requeridas := 1;
   END;

   -- funcion que obtiene la transaccion padre de acuerdo al tipo de transaccion
   FUNCTION fu_obt_tra_sueldo(p_cod_ente         IN ge_entes.cod_ente%TYPE,
                              p_tip_remuneracion IN ge_pag_sueldos_tmp.tip_remuneracion%TYPE) RETURN NUMBER IS
      v_cod_tra_padre ge_transacciones.cod_transaccion%TYPE := NULL;
   BEGIN
      IF p_tip_remuneracion = 'S' THEN
         v_cod_tra_padre := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_SUELDO');
      ELSIF p_tip_remuneracion = 'A' THEN
         v_cod_tra_padre := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_AGUINALDO');
      ELSIF p_tip_remuneracion = 'C' THEN
         v_cod_tra_padre := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_COMISION');
      ELSIF p_tip_remuneracion = 'T' THEN
         v_cod_tra_padre := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_CREDITO');
      END IF;
      RETURN v_cod_tra_padre;
   END;

   -- funcion que obtiene el tipo de proceso de sueldo
   FUNCTION fu_obt_tip_pro_sueldo(p_cod_ente IN ge_entes.cod_ente%TYPE) RETURN VARCHAR2 IS
   BEGIN
      RETURN nvl(fug_obt_parentes(p_cod_ente, 'TIP_PRO_SUELDO'), 'O');
   EXCEPTION
      WHEN OTHERS THEN
         RETURN 'O';
   END;


--Verifica que la clave transaccional sea la correcta
   --hace un substr desde p_ini_ope_clave-1 hasta p_ini_ope_clave+31
   FUNCTION lf_obt_cla_validar(p_cla_transaccional IN VARCHAR2,
                               p_cod_persona       IN VARCHAR2,
                               p_cod_per_vinculada IN VARCHAR2,
                               p_tip_clave         IN VARCHAR2) RETURN typ_mensajeRespuesta IS
   BEGIN
      RETURN paw_seg.FU_VAL_OPE_CLAVE(p_cla_transaccional, p_cod_persona, p_cod_per_vinculada, p_tip_clave, 'S');
   END;

   FUNCTION fu_validarOTP(p_cla_token         IN VARCHAR2,
                          p_cod_persona       IN VARCHAR2,
                          p_cod_per_vinculada IN VARCHAR2,
                          p_modo              IN VARCHAR2) RETURN typ_mensajeRespuesta IS
   BEGIN
      RETURN paw_seg.fu_obt_tok_validar(p_cla_token, p_cod_persona, p_cod_per_vinculada, p_modo);
   END;

   FUNCTION lp_ver_horario(p_horario        OUT VARCHAR2,
                           p_es_mov_noc     OUT VARCHAR2,
                           p_es_cta_noc     OUT VARCHAR2,
                           p_ult_cierre     IN DATE,
                           p_cod_ofi_origen IN VARCHAR2,
                           p_fec_actual     OUT DATE) RETURN typ_MensajeRespuesta IS

      MSG_SIS_CIERRE CONSTANT VARCHAR2(15) := 'HOR_SIS_CIERRE';
      v_est_modulo ba_modulos.estado%TYPE;
      v_retorno    typ_MensajeRespuesta := typ_MensajeRespuesta;
   BEGIN
      --v_cod_respuesta := paw_bce.v_cod_aprobado;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      p_horario    := 'D'; -- Dia normal
      p_es_mov_noc := 'N'; -- Para grabar en las tablas nocturnas
      p_es_cta_noc := 'N';
      p_fec_actual := pag_cal.FU_OBT_FEC_ACTUAL(3);
      v_est_modulo := pae_cnf.FU_OBT_EST_MODULO(3);

      IF v_est_modulo IN (1,6) THEN -- DDSI-29 -- 07/2017 --
         -- En cierre.
         --v_cod_respuesta := paw_bce.v_cod_sis_cierre;
         pr_mensajeUsuario(MSG_SIS_CIERRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(NULL, NULL, NULL, '999', NULL, ' lp_ver_horario()-Sistema en cierre-', BITACORA_ERROR);
      ELSIF v_est_modulo = 2 THEN
         -- El modulo esta abierto

         -- Verifica la hora --
         IF SYSDATE > p_ult_cierre AND trunc(p_ult_cierre) = p_fec_actual THEN
            p_horario    := 'T'; -- Tarde
            p_fec_actual := pag_cal.FU_OBT_FEC_HABIL(p_fec_actual + 1, 1, p_cod_ofi_origen);
            p_es_mov_noc := 'S'; -- Para grabar en las tablas nocturnas
         END IF;

      ELSE
         p_horario := 'N'; -- Noche
         IF v_est_modulo <> 1 THEN
            p_fec_actual := pag_cal.FU_OBT_FEC_HABIL(p_fec_actual + 1, 1, p_cod_ofi_origen);
         END IF;
         p_es_mov_noc := 'S'; -- Para grabar en las tablas nocturnas
         p_es_cta_noc := 'S'; -- Solo para que llavee la cuenta nocturna
      END IF;
      pag_cta.g_horario := p_horario;
      RETURN v_retorno;
   END lp_ver_horario;

   FUNCTION fu_ver_horario(p_horario        OUT VARCHAR2,
                           p_es_mov_noc     OUT VARCHAR2,
                           p_es_cta_noc     OUT VARCHAR2,
                           p_ult_cierre     IN DATE,
                           p_cod_ofi_origen IN VARCHAR2,
                           p_fec_actual     OUT DATE) RETURN typ_MensajeRespuesta IS
   BEGIN
      RETURN lp_ver_horario(p_horario, p_es_mov_noc, p_es_cta_noc,
                           p_ult_cierre, p_cod_ofi_origen, p_fec_actual);
   END;

   PROCEDURE lp_can_reg_historicos(p_nro_cuenta IN ge_cuentas.nro_cuenta%TYPE,
                                   p_fecha      IN ge_movimientos.fecha%TYPE,
                                   p_horario    OUT VARCHAR2) IS
      v_lugar         VARCHAR2(100);
      v_can_registros NUMBER(5) := 99;
   BEGIN
      v_lugar := 'obtener cantidad de registros historicos';
      BEGIN
         SELECT 1
           INTO v_can_registros
           FROM cc_movimientos_his h
          WHERE h.fecha = p_fecha
            AND h.nro_cuenta = p_nro_cuenta
            AND rownum = 1
         UNION
         SELECT 1
           FROM ah_movimientos_his h
          WHERE h.fecha = p_fecha
            AND h.nro_cuenta = p_nro_cuenta
            AND rownum = 1;
      EXCEPTION
         WHEN no_data_found THEN
            v_can_registros := 0;
      END;
      IF v_can_registros = 0 THEN
         p_horario := 'D';
      END IF;
   EXCEPTION
      WHEN OTHERS THEN
         raise_application_error(-20000, v_lugar || ' - ' || SQLERRM);
   END;
   /**
   ****  Validar la Cuenta de Debito  ***
   * @Migrado por: Christian Recalde / Sergio Ayala
   * @Fecha : 17-07-2012
   */
   FUNCTION lf_val_cta_debito(p_nro_cta_debito IN VARCHAR2,
                              p_cod_tra_padre  IN NUMBER,
                              p_monto          IN NUMBER,
                              p_cod_mon_debito OUT VARCHAR2,
                              p_cod_mod_debito OUT NUMBER,
                              p_cod_mad_debito OUT NUMBER,
                              p_cod_ofi_debito OUT NUMBER,
                              p_cta_for_debito OUT VARCHAR2,
                              p_nom_cta_debito OUT VARCHAR2,
                              p_validarSesion  IN typ_validarSesion,
                              p_mensajeCaja    IN typ_mensajeCaja,
                              p_cod_modulo     IN ge_modalidades.cod_modulo%TYPE DEFAULT NULL,
                              p_cod_modalidad  IN ge_modalidades.cod_modalidad%TYPE DEFAULT NULL,
                              p_nro_cta_credito IN VARCHAR2 default null,
                              p_consumidor_ori  IN VARCHAR2 default null, --TCE-806
                              p_ctrl_cta_conjunta IN VARCHAR2 default null --TCE-806
                              ) RETURN typ_mensajeRespuesta IS
      MSG_COD_CTA_INVALIDA    CONSTANT VARCHAR2(15) := 'COD_CTA_INVALID';
      MSG_COD_CTA_INEXISTENTE CONSTANT VARCHAR2(15) := 'COD_CTA_INEXIST';
      MSG_COD_TRA_PROHIBIDA   CONSTANT VARCHAR2(15) := 'COD_TRA_PROHIB';
      MSG_COD_SAL_INSUF       CONSTANT VARCHAR2(15) := 'COD_SAL_INSUF';
      MSG_COD_CTA_DUPLICADA   CONSTANT VARCHAR2(15) := 'COD_CTA_DUPLIC';
      MSG_COD_CTA_CONJUNTA   CONSTANT VARCHAR2(15)  := 'CTA_CONJUNTA';

      v_est_cta_debito VARCHAR2(1);
      v_nvo_estado     VARCHAR2(1) := NULL; -- cambio de estado de cuenta
      v_procesa        VARCHAR2(1) := 'N';
      v_sal_disponible NUMBER(18, 2);
      v_can_conjunta   NUMBER(7);
      v_retorno        typ_mensajeRespuesta := typ_mensajeRespuesta;
      -- verifico cuenta de debito
   BEGIN
      PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      SELECT a.cod_moneda, a.estado, cod_modalidad, cod_modulo, cod_oficina, fug_cta_formateada(cod_modulo, cod_modalidad, cod_oficina, nro_cuenta, cod_moneda) cta_formateada, denominacion
        INTO p_cod_mon_debito, v_est_cta_debito, p_cod_mad_debito, p_cod_mod_debito, p_cod_ofi_debito, p_cta_for_debito, p_nom_cta_debito
        FROM ge_cuentas a
       WHERE a.nro_cuenta = p_nro_cta_debito; -- contiene el nro de cuenta
      -- debito
      pag_cta.PR_OBT_CUENTA(p_nro_cta_debito);
      v_est_cta_debito := pag_cta.FU_OBT_EST_CUENTA;
      IF p_cod_mad_debito NOT IN (31, 41, 334) THEN
         PAW_UTI.pr_mensajeUsuario(MSG_COD_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         -- v_cod_respuesta := paw_bce.v_cod_cta_invalida;
      ELSIF v_est_cta_debito NOT IN ('P', 'I', 'N', 'S') THEN
         PAW_UTI.pr_mensajeUsuario(MSG_COD_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         -- v_cod_respuesta := paw_bce.v_cod_cta_invalida;
      ELSIF pag_cta.fu_ver_tra_prohibida(p_nro_cta_debito, p_cod_tra_padre, nvl(p_cod_modulo, 9), nvl(p_cod_modalidad, 91)) = 'S' THEN
         PAW_UTI.pr_mensajeUsuario(MSG_COD_TRA_PROHIBIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         -- v_cod_respuesta := paw_bce.v_cod_tra_prohibida;
      ELSIF paw_bas.fu_es_conjunta(p_nro_cta_debito, v_can_aut_requeridas) = 'S'
        and nvl(p_consumidor_ori, 'DFL') <> p_ctrl_cta_conjunta THEN --TCE-806 - Se agrego una condicion mas para que valide por consumidor
         PAW_UTI.pr_mensajeUsuario(MSG_COD_CTA_CONJUNTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         -- v_cod_respuesta := paw_bce.v_cod_tra_invalida;
      ELSIF p_cod_mad_debito = 41 and p_nro_cta_credito is not null Then --> No es nulo cuando es transferencia entre cuentas Propias o a Terceros
          --SDPARDEBAU-2-MB: Se envia la Cta. de Credito para validar el saldo de ambas cuentas. Si ambos son negativos (Sin Tener en cuenta la LS) detener el proceso.
      If FUC_OBT_SAL_SIN_SOBREGIRO(p_nro_cta_debito) <= 0 and FUC_OBT_SAL_SIN_SOBREGIRO(p_nro_cta_credito) <= 0 Then
             -- El destino sera Fondeado con el sobregiro del origen. No se debe permitir
             PAW_UTI.pr_mensajeUsuario(MSG_COD_SAL_INSUF, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          ElsIf FUC_OBT_SAL_SIN_SOBREGIRO(p_nro_cta_debito) > 0 and (FUC_OBT_SAL_SIN_SOBREGIRO(p_nro_cta_debito) - p_monto) < 0 then
             -- El destino sera Fondeado con un sobregiro del origen a raiz de la operacion actual. No se debe permitir
             PAW_UTI.pr_mensajeUsuario(MSG_COD_SAL_INSUF, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          End If;
    ELSE
         pag_cta.pr_ver_operacion(p_nro_cta_debito, p_cod_tra_padre, nvl(p_cod_modulo, 9), nvl(p_cod_modalidad, 91), 'D', p_cod_mon_debito, p_monto, p_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */, p_cod_mod_debito, p_cod_mad_debito, v_nvo_estado, v_sal_disponible, v_procesa, 503);
         IF v_procesa = 'N' THEN
            -- no se puede debitar
            IF instr(upper(pag_cta.G_MSJ_ERROR), 'INSUFIC') > 0 THEN
               -- saldo insuficiente
               PAW_UTI.pr_mensajeUsuario(MSG_COD_SAL_INSUF, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               -- v_cod_respuesta := paw_bce.v_cod_sal_insuficiente;
            ELSE
               PAW_UTI.pr_mensajeUsuario(MSG_COD_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               -- v_cod_respuesta := paw_bce.v_cod_cta_invalida;
            END IF;
         END IF;
      END IF;
      -- agregado para permitir a cuentas indistintas de personas fisicas grabar sin autorizacion
      IF v_retorno.error = 'N' AND p_validarSesion.codigoEmpresa IS NULL THEN
         -- veo si la cuenta no es conjunta
         SELECT COUNT(*)
           INTO v_can_conjunta
           FROM ge_cta_clientes
          WHERE nro_cuenta = p_nro_cta_debito
            AND relacion = 'Y'
            AND rownum = 1;
         IF nvl(v_can_conjunta, 0) = 0 THEN
            -- veo si es persona fisica no debe requerir autorizacion
            v_can_aut_requeridas := 0; -- no tiene autorizacion pendiente cuando es la persona fisica
         END IF;
      END IF;

      RETURN v_retorno;
   EXCEPTION
      WHEN no_data_found THEN
         PAW_UTI.pr_mensajeUsuario(MSG_COD_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         RETURN v_retorno;
      WHEN too_many_rows THEN
         PAW_UTI.pr_mensajeUsuario(MSG_COD_CTA_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         RETURN v_retorno;
      WHEN OTHERS THEN
         PAW_UTI.pr_mensajeUsuario(MSG_COD_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         RETURN v_retorno;
   END;
   -- Fin Validar Cuenta Debito
   /**
   ****  Verifica que una transacción igual no se haya realizado en los últimos minutos ***
   * @Migrado por: Christian Recalde / Sergio Ayala
   * @Fecha : 03-07-2012
   */
   FUNCTION fu_ver_transaccion(p_cod_transaccion IN ge_movimientos.cod_transaccion%TYPE,
                               p_cod_tra_padre   IN ge_movimientos.cod_tra_padre%TYPE,
                               p_nro_cuenta      IN ge_movimientos.nro_cuenta%TYPE,
                               p_monto           IN ge_movimientos.monto%TYPE,
                               p_mensajeCaja     IN typ_mensajeCaja) RETURN typ_mensajeRespuesta IS

      MSG_COD_MOV_YA_INGRESADO CONSTANT VARCHAR2(15) := 'G_MOV_YA_INGRE';
      v_existe  VARCHAR2(1);
      v_retorno typ_mensajeRespuesta := typ_mensajeRespuesta;
      -- para controlar transacciones duplicadas, default 10 minutos
      v_min_transaccion NUMBER := nvl(to_number(fug_obt_pardinamico('PAW_MIN_TRANSACCION')), 10);
      v_horario         VARCHAR2(1);
      v_es_mov_noc      VARCHAR2(1);
      v_es_cta_noc      VARCHAR2(1);
      v_fec_actual      DATE;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      v_retorno := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, p_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                  -- IN
                                  p_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                  -- IN
                                  v_fec_actual);
      IF v_retorno.error = 'S' THEN
         RETURN v_retorno;
      END IF;

      BEGIN
         IF v_es_mov_noc = 'S' THEN
            SELECT 'S'
              INTO v_existe
              FROM ge_movimientos_noc
             WHERE nro_cuenta = p_nro_cuenta
                   AND cod_transaccion = p_cod_transaccion
                   AND cod_tra_padre = p_cod_tra_padre
                   AND monto = p_monto
                   AND reversado = 'N'
                   AND cod_usuario = p_mensajeCaja.codigoUsuario /* v_cod_usuario */
                   AND ((SYSDATE) - fec_insercion) * 1440 <= v_min_transaccion
                   AND rownum = 1;
         ELSE
            SELECT 'S'
              INTO v_existe
              FROM ge_movimientos
             WHERE nro_cuenta = p_nro_cuenta
                   AND cod_transaccion = p_cod_transaccion
                   AND cod_tra_padre = p_cod_tra_padre
                   AND monto = p_monto
                   AND reversado = 'N'
                   AND cod_usuario = p_mensajeCaja.codigoUsuario /* v_cod_usuario */
                   AND ((SYSDATE) - fec_insercion) * 1440 <= v_min_transaccion
                   AND rownum = 1;
         END IF;
         -- v_respuesta := v_cod_mov_ya_ingresado;
         pr_mensajeUsuario(MSG_COD_MOV_YA_INGRESADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      EXCEPTION
         WHEN no_data_found THEN
            NULL;
         WHEN too_many_rows THEN
            --v_respuesta := v_cod_mov_ya_ingresado;
            pr_mensajeUsuario(MSG_COD_MOV_YA_INGRESADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      END;

      RETURN v_retorno;
   END;
   -- Final de fu_ver_transaccion



   -- lp_con_mon_a_moneda
  PROCEDURE pr_con_mon_a_moneda(p_cod_mon_original IN ba_monedas.cod_moneda%TYPE,
                                p_cod_mon_destino  IN ba_monedas.cod_moneda%TYPE,
                                p_mto_mon_original IN NUMBER,
                                p_mto_mon_destino  OUT NUMBER,
                                p_cot_mon_original IN OUT NUMBER,
                                p_cot_mon_destino  IN OUT NUMBER,
                                p_interbancaria    IN VARCHAR2 DEFAULT NULL) IS
     v_lugar VARCHAR2(100);
   -- obtener cotizacion para operaciones via banca electronica
     FUNCTION lf_obt_cotizacion(p_cod_moneda IN ba_monedas.cod_moneda%TYPE,
                                p_tipo       IN VARCHAR2 -- C-COMPRA o V-VENTA
                                ) RETURN NUMBER IS
        v_fec_actual DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
        v_cotizacion ge_cotizaciones.val_conversion%TYPE;
     BEGIN
        SELECT decode(p_tipo, 'C', val_com_electronica, 'V', val_ven_electronica, NULL)
          INTO v_cotizacion
          FROM ge_cotizaciones a
         WHERE fecha = (SELECT MAX(fecha)
                          FROM ge_cotizaciones
                         WHERE cod_moneda = a.cod_moneda
                               AND fecha <= v_fec_actual)
               AND cod_moneda = p_cod_moneda;
        RETURN v_cotizacion;
     EXCEPTION
        WHEN no_data_found THEN
           RETURN NULL;
        WHEN OTHERS THEN
           RETURN NULL;
     END;
     -- fin fu_obt_cotizacion
  BEGIN
     v_lugar := 'obtener moneda base';
     IF p_cod_mon_original = p_cod_mon_destino THEN
        p_mto_mon_destino := p_mto_mon_original;
        IF p_cod_mon_original <> v_cod_mon_local THEN
           p_cot_mon_destino  := nvl(p_cot_mon_original, pag_gen.fu_obt_cotizacion(p_cod_mon_original));
           p_cot_mon_original := p_cot_mon_destino;
        ELSE
           p_cot_mon_destino  := 1;
           p_cot_mon_original := 1;
        END IF;
     ELSE
        IF nvl(p_interbancaria,'N') = 'N' THEN
           IF p_cod_mon_original <> v_cod_mon_local AND p_cod_mon_destino = v_cod_mon_local THEN
              --convertir moneda original a base o destino
              p_cot_mon_original := nvl(p_cot_mon_original, lf_obt_cotizacion(p_cod_mon_original, 'C' /*COMPRA*/));
              p_cot_mon_destino  := 1;
              p_mto_mon_destino  := round(p_mto_mon_original * p_cot_mon_original, 0);
           ELSIF p_cod_mon_original = v_cod_mon_local AND p_cod_mon_destino <> v_cod_mon_local THEN
              -- pasar moneda original a moneda base
              p_cot_mon_original := 1;
              p_cot_mon_destino  := nvl(p_cot_mon_destino, lf_obt_cotizacion(p_cod_mon_destino, 'V' /*VENTA */));
              p_mto_mon_destino  := round(p_mto_mon_original / p_cot_mon_destino, 2);
           ELSIF p_cod_mon_original <> v_cod_mon_local AND p_cod_mon_destino <> v_cod_mon_local THEN
              p_cot_mon_original := nvl(p_cot_mon_original, lf_obt_cotizacion(p_cod_mon_original, 'C' /*COMPRA*/));
              p_mto_mon_destino  := p_mto_mon_original * p_cot_mon_original;
              p_cot_mon_destino  := nvl(p_cot_mon_destino, lf_obt_cotizacion(p_cod_mon_destino, 'V' /*VENTA */));
              p_mto_mon_destino  := round(p_mto_mon_destino / p_cot_mon_destino, 2);
           END IF;
        ELSE --SNP
           IF  p_cod_mon_original <> v_cod_mon_local AND p_cod_mon_destino = v_cod_mon_local THEN
              --convertir moneda original a base o destino
              p_cot_mon_original := nvl(p_cot_mon_original, paw_bce.fu_obt_cotizacion(p_cod_mon_original,'V'/*VENTA*/));
              p_cot_mon_destino := 1;
              p_mto_mon_destino := round(p_mto_mon_original * p_cot_mon_original,0);
           ELSIF p_cod_mon_original = v_cod_mon_local AND p_cod_mon_destino <> v_cod_mon_local THEN
              -- pasar moneda original a moneda base
              p_cot_mon_original := 1;
              p_cot_mon_destino := nvl(p_cot_mon_destino, paw_bce.fu_obt_cotizacion(p_cod_mon_destino,'C'/*COMPRA*/));
              p_mto_mon_destino := round(p_mto_mon_original/p_cot_mon_destino,2);
           ELSIF p_cod_mon_original <> v_cod_mon_local and p_cod_mon_destino <> v_cod_mon_local THEN
              p_cot_mon_original := nvl(p_cot_mon_original, paw_bce.fu_obt_cotizacion(p_cod_mon_original,'V'/*VENTA*/));
              p_mto_mon_destino := p_mto_mon_original * p_cot_mon_original;
              p_cot_mon_destino := nvl(p_cot_mon_destino, paw_bce.fu_obt_cotizacion(p_cod_mon_destino,'C'/*COMPRA*/));
              p_mto_mon_destino := round(p_mto_mon_destino/p_cot_mon_destino,2);
            END IF;
           --SNP
        END IF;
     END IF;
  EXCEPTION
     WHEN OTHERS THEN
        raise_application_error(-20000, v_lugar || ' - ' || SQLERRM);
  END;

  -- genera movimientos en movimientos
procedure lp_ins_movimiento
   (p_retorno           in out typ_mensajerespuesta, -- agregado
    p_nro_secuencia     in out number,               -- agregado
    p_ses_usuario       in typ_validarSesion,        -- agregado
    p_men_caja          in typ_mensajeCaja,          -- agregado
    p_fec_actual        in date,                     -- agregado
    p_hor_actual        in varchar2,                 -- agregado
    p_fec_valor         in date,                     -- agregado
    p_cod_mod_cta       in number,
    p_cod_mad_cta       in number,
    p_cod_ofi_cta       in number,
    p_nro_cuenta        in varchar2,
    p_cod_moneda        in varchar2,
    p_cod_tra_padre     in number,
    p_cod_transaccion   in number,
    p_nro_documento     in number,
    p_monto             in number,
    p_afe_caja          in varchar2,  -- E-efectivo C-Cheq.Ntro.bco O-Cheq.otro.bco N-no afecta
    p_es_mov_noc        in varchar2,
    p_cod_retencion     in number   default null,
    p_fec_fin_retencion in date     default null,
    p_concepto          in varchar2 default null,
    p_cotizacion        in number   default null,
    p_cod_mod_padre     in number   default null,
    p_cod_mad_padre     in number   default null)

 is
r_gmovi ge_movimientos%rowtype;
v_can_movimientos number(8) := 0;
cod_ped_duplicado constant varchar2(15) := 'G_COD_MOV_DUPLI';
begin
     -- veo posible duplicacion de nros de boleta
     begin
        if p_es_mov_noc = 'S' then
          select count(*)
            into v_can_movimientos
            from ge_movimientos_noc
           where nro_cuenta = p_nro_cuenta
             and cod_transaccion = p_cod_transaccion
             and nro_documento = p_nro_documento
             and cod_retencion = p_cod_retencion
             and rownum = 1;
        else
          select count(*)
            into v_can_movimientos
            from ge_movimientos
           where nro_cuenta = p_nro_cuenta
             and cod_transaccion = p_cod_transaccion
             and nro_documento = p_nro_documento
             and cod_retencion = p_cod_retencion
             and rownum = 1;
        end if;
     exception
        when others then
           v_can_movimientos := 0;
     end;
     if v_can_movimientos > 0 then
        -- ya se ingreso la boleta, se debe rechazar
        pr_mensajeUsuario(cod_ped_duplicado, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);
     else
        -- movimiento puede ser ingresado
         r_gmovi.cod_modulo      := p_cod_mod_cta;
         r_gmovi.cod_modalidad   := p_cod_mad_cta;
         r_gmovi.cod_oficina     := p_cod_ofi_cta;
         r_gmovi.nro_cuenta      := p_nro_cuenta;
         r_gmovi.cod_moneda      := p_cod_moneda;
         r_gmovi.cod_usuario     := p_men_caja.codigoUsuario; --v_cod_usuario;
         r_gmovi.hora            := p_hor_actual; --v_hor_actual;
         r_gmovi.fecha           := p_fec_actual; -- v_fec_actual;
         -- Aumento la secuencia
         -- v_nro_secuencia         := v_nro_secuencia + 1;
         p_nro_secuencia         := p_nro_secuencia + 1;
         r_gmovi.nro_secuencia   := p_nro_secuencia; -- v_nro_secuencia;
         --
         r_gmovi.fec_valor       := p_fec_valor; --v_fec_valor;
         r_gmovi.cod_tra_padre   := p_cod_tra_padre;
         r_gmovi.cod_mod_padre   := nvl(p_cod_mod_padre,9);
         r_gmovi.cod_mad_padre   := nvl(p_cod_mad_padre,91);
         r_gmovi.cod_transaccion := p_cod_transaccion;
         r_gmovi.monto           := p_monto;
         r_gmovi.nro_documento   := p_nro_documento;
         r_gmovi.cotizacion      := p_cotizacion;
         IF p_cotizacion IS NOT NULL THEN
            r_gmovi.mto_equ_local := nvl(r_gmovi.monto,0) * nvl(p_cotizacion,0);
         ELSE
            r_gmovi.mto_equ_local := null;
         END IF;
         r_gmovi.cod_ofi_origen  := p_men_caja.codigoOficinaOrigen; --v_cod_ofi_origen;
         r_gmovi.emi_aviso       := 'N';
         r_gmovi.concepto        := p_concepto;
         r_gmovi.estado          := 'N';
         r_gmovi.reversado       := 'N';
         r_gmovi.nro_caja        := p_ses_usuario.codigoCanal; --v_nro_terminal;
         --
         r_gmovi.cod_retencion     := p_cod_retencion;
         r_gmovi.fec_fin_retencion := p_fec_fin_retencion;
         PAG_GEN.PR_INS_GE_MOVIMIENTO(r_gmovi, /*nvl(*/p_es_mov_noc/*,v_es_mov_noc)*/);

         if nvl(p_afe_caja,'N') <> 'N' then
            -- genero el movimiento en caja
            if /*v_es_mov_noc*/p_es_mov_noc = 'S' then
              insert into cj_movimientos_noc
                 (fecha, hora, cod_usuario, nro_secuencia,
                  cod_tra_padre, cod_mod_padre, cod_mad_padre,
                  cod_oficina, cod_moneda, nro_caja,
                  nro_documento, nro_cuenta, monto, tip_monto, tipo)
              values
                 (p_fec_actual, p_hor_actual, p_men_caja.codigoUsuario /*v_cod_usuario*/, p_nro_secuencia, -- secuencia 1
                  p_cod_tra_padre, nvl(p_cod_mod_padre,9), nvl(p_cod_mad_padre,91),
                  p_men_caja.codigoOficinaOrigen /*v_cod_ofi_origen*/, p_cod_moneda, to_number(p_ses_usuario.codigoCanal/*v_nro_terminal*/),
                  p_nro_documento, p_nro_cuenta, p_monto, p_afe_caja, 'D');  --es debito
            else
              insert into cj_movimientos
                 (fecha, hora, cod_usuario, nro_secuencia,
                  cod_tra_padre, cod_mod_padre, cod_mad_padre,
                  cod_oficina, cod_moneda, nro_caja,
                  nro_documento, nro_cuenta, monto, tip_monto, tipo)
              values
                 (p_fec_actual, p_hor_actual, p_men_caja.codigoUsuario /*v_cod_usuario*/, p_nro_secuencia, -- secuencia 1
                  p_cod_tra_padre, nvl(p_cod_mod_padre,9), nvl(p_cod_mad_padre,91),
                  p_men_caja.codigoOficinaOrigen /*v_cod_ofi_origen*/, p_cod_moneda, to_number(p_ses_usuario.codigoCanal/*v_nro_terminal*/),
                  p_nro_documento, p_nro_cuenta, p_monto, p_afe_caja, 'D');  --es debito

            end if;
         end if;
     end if;
end;
-- fin de la insercion de movimientos

  /*VALIDA LA DUPLICACION DEL MOVIMIENTO SNP
   * @Fecha : 04-02-2013
  */
  FUNCTION lf_val_duplicacion(p_nro_cta_debito in varchar2,
                               p_mto_debito     in number,
                               p_dato           in varchar2,
                               p_cod_tra_padre  in number,
                               p_validarSesion  IN typ_validarSesion,
                               p_mensajeCaja     IN typ_mensajeCaja,
                               p_tip_mensaje in varchar2) RETURN typ_mensajeRespuesta IS

    MSG_G_MOV_YA_INGRE CONSTANT VARCHAR2(15) := 'G_MOV_YA_INGRE';
    v_existe           varchar2(1) := 'S';
    v_retorno          typ_mensajeRespuesta := typ_mensajeRespuesta;
    v_min_transaccion  NUMBER := nvl(to_number(fug_obt_pardinamico('SNP_MIN_DUPLICACION')), 10);
    v_horario          VARCHAR2(1);
    v_es_mov_noc       VARCHAR2(1);
    v_es_cta_noc       VARCHAR2(1);
    v_fec_actual       DATE;

    BEGIN
       paw_uti.pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

       v_retorno := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                    p_mensajeCaja.fechaUltimoCierre, -- IN
                                    p_mensajeCaja.codigoOficinaOrigen, -- IN
                                    v_fec_actual);
       IF v_retorno.error = 'S' THEN
          RETURN v_retorno;
       END IF;

       -- verificacion mov. pendientes
       begin
          select 'S'
            into v_existe
          from bw_mov_pendientes
          where cod_per_principal = nvl(p_validarSesion.codigoEmpresa, p_validarSesion.codigoPersona)
            and nro_cuenta = p_nro_cta_debito
            and monto = p_mto_debito
            and estado = 'P'
            and cod_tip_mensaje = p_tip_mensaje
            and dato = p_dato
            and can_aut_faltantes > 0
            and ((sysdate) -fec_insercion)*24*60 <=v_min_transaccion
            and rownum = 1;
        exception
           when too_many_rows then
              v_existe := 'S';
           when others then
              v_existe := 'N';
        end;

        if v_existe = 'N' then
          if v_es_mov_noc = 'S' then
             select distinct 'S'
               into v_existe
               from ge_movimientos_noc
              where nro_cuenta = p_nro_cta_debito
                and cod_tra_padre = p_cod_tra_padre
                and monto = p_mto_debito
                and reversado = 'N'
                and nro_secuencia = '1'
                and cod_usuario = p_mensajeCaja.codigoUsuario
                -- Controla que por lo menos haya pasado 10 minutos
                and ((sysdate) -fec_insercion)*24*60 <=v_min_transaccion
                and rownum = 1;
          else
             select distinct 'S'
               into v_existe
               from ge_movimientos
              where nro_cuenta = p_nro_cta_debito
                and cod_tra_padre = p_cod_tra_padre
                and monto = p_mto_debito
                and reversado = 'N'
                and nro_secuencia = '1'
                and cod_usuario = p_mensajeCaja.codigoUsuario
                and fecha = v_fec_actual
                -- Controla que por lo menos haya pasado 10 minutos
                and ((sysdate) -fec_insercion)*24*60 <=v_min_transaccion
                and rownum = 1;
           end if;
        end if;

        if nvl(v_existe,'N') = 'S' then
           paw_uti.pr_mensajeUsuario(MSG_G_MOV_YA_INGRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        end if ;

        RETURN v_retorno;

     EXCEPTION
       when no_data_found then
          RETURN v_retorno;
       when too_many_rows then
          paw_uti.pr_mensajeUsuario(MSG_G_MOV_YA_INGRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          RETURN v_retorno;
  END;
      /**
   ****  Funcion que controla la Cuenta Origen corresponda a la persona ***
   * @Migrado por: Sergio Ayala
   * @Fecha : 17-07-2012
   */
   FUNCTION lf_val_cta_origen(p_nro_cuenta  IN VARCHAR2,
                              p_cod_persona IN VARCHAR2) RETURN VARCHAR2 IS
      v_sino VARCHAR(1) := 'N';
   BEGIN
      SELECT 'S'
        INTO v_sino
        FROM ge_cta_clientes
       WHERE nro_cuenta = p_nro_cuenta
         AND cod_persona = p_cod_persona
         AND rownum = 1;
      RETURN v_sino;
   EXCEPTION
      WHEN OTHERS THEN
         v_sino := 'N';
         RETURN v_sino;

   END;
   -- Final de Controla la Cuenta Origen


   FUNCTION lf_obt_permisos(p_sesion        IN typ_validarSesion,
                            p_cod_operacion IN VARCHAR2) RETURN typ_obtenerPermisos IS
      v_retorno  typ_obtenerPermisos;
      v_consulta VARCHAR(5);
      v_registra VARCHAR(5);
      v_autoriza VARCHAR(5);
      p_cod_persona  ba_personas.cod_persona%TYPE := nvl(p_sesion.codigoEmpresa, p_sesion.codigoPersona);
      p_cod_perfil   bw_perfiles.cod_perfil%TYPE := p_sesion.codigoPerfil;
      p_nro_terminal cj_cajas.nro_caja%TYPE := p_sesion.codigoCanal;
      MSG_OP_NO_PERMITIDA CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_OP_INEXISTENTE  CONSTANT VARCHAR2(15) := 'PER_OPE_INVALID';
   BEGIN
      SELECT TRIM(decode(consulta, 'S', 'C', '') || decode(ingresa, 'S', 'I', '') || decode(autoriza, 'S', 'A', ''))
        INTO v_tip_mensaje
        FROM bw_tip_mensajes
       WHERE cod_tip_mensaje = p_cod_operacion;
      BEGIN
         PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         -- busco primero especifico para la empresa
         SELECT decode(consulta, 'S', 'TRUE', 'FALSE'), decode(ingresa, 'S', 'TRUE', 'FALSE'), decode(autoriza, 'S', 'TRUE', 'FALSE'), nvl(can_firmas, 0)
           INTO v_consulta, v_registra, v_autoriza, v_can_aut_requeridas
           FROM bw_rol_permisos
          WHERE cod_perfil = p_cod_perfil
            AND cod_tip_mensaje = p_cod_operacion
            AND cod_persona = p_cod_persona;
      EXCEPTION
         WHEN no_data_found THEN
            -- busco los permisos generales para el perfil
            SELECT decode(consulta, 'S', 'TRUE', 'FALSE'), decode(ingresa, 'S', 'TRUE', 'FALSE'), decode(autoriza, 'S', 'TRUE', 'FALSE'), nvl(can_firmas, 0)
              INTO v_consulta, v_registra, v_autoriza, v_can_aut_requeridas
              FROM bw_rol_permisos
             WHERE cod_perfil = p_cod_perfil
               AND cod_tip_mensaje = p_cod_operacion
               AND cod_persona IS NULL;
      END;
      IF v_can_aut_requeridas > 0 AND paw_bce.fu_caj_homebanking(p_nro_terminal) = 'N' /*p_nro_terminal != '999'*/ THEN
         -- operacion no permitida en autoservicios por requerir autorizacion
         PAW_UTI.pr_mensajeUsuario(MSG_OP_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         --pr_insertarBitacora(p_cod_persona, p_nro_terminal, NULL, p_cod_operacion, NULL, 'Operacion no permitida-', BITACORA_ERROR);
      END IF;
      v_retorno.autoriza         := (v_autoriza = 'TRUE');
      v_retorno.consulta         := (v_consulta = 'TRUE');
      v_retorno.registra         := (v_registra = 'TRUE');
      v_retorno.canAutRequeridas := v_can_aut_requeridas;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         PAW_UTI.pr_mensajeUsuario(MSG_OP_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         RETURN v_retorno;
   END;

   /**
   ****  Procedimientos de Control de Datos Recibidos ***
   * @Migrado por: Christian Recalde / Sergio Ayala
   * @Fecha : 03-07-2012
   */
   FUNCTION lf_val_caja(p_sesion IN typ_validarSesion) RETURN typ_mensajeCaja IS
      MSG_CAJ_PROHIBIDA     CONSTANT VARCHAR2(15) := 'CAJ_PROHIBIDA';
      MSG_EST_CAJ_INVALIDA  CONSTANT VARCHAR2(15) := 'EST_CAJ_INVALID';
      MSG_CAJ_NO_ENCONTRADA CONSTANT VARCHAR2(15) := 'CAJ_NO_ENCONTRA';
      -- Verifico la situacion del numero de caja
      v_est_caja       cj_cajas.estado%TYPE;
      v_tip_caja       cj_cajas.tipo%TYPE;
      v_cod_ofi_origen cj_cajas.cod_oficina%TYPE;
      v_cod_usuario    cj_cajas.cod_usuario%TYPE;
      v_ult_cierre     cj_cajas.fec_hor_cierre%TYPE;
     -- v_retorno        typ_mensajeCaja := typ_mensajeCaja;
      v_retorno        typ_mensajeCaja;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      SELECT estado, tipo, cod_oficina, cod_usuario, fec_hor_cierre
        INTO v_est_caja, v_tip_caja, v_cod_ofi_origen, v_cod_usuario, v_ult_cierre
        FROM cj_cajas
       WHERE nro_caja = to_number(p_sesion.codigoCanal);
      IF v_tip_caja NOT IN ('C', 'I', 'S') THEN
         -- tipo de caja no permitido
         -- paw_bce.v_cod_respuesta := '-20';
         pr_mensajeUsuario(MSG_CAJ_PROHIBIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      END IF;
      IF v_est_caja <> 'A' THEN
         -- paw_bce.v_cod_respuesta := '-20';
         pr_mensajeUsuario(MSG_EST_CAJ_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      END IF;

      v_retorno.estadoCaja          := v_est_caja;
      v_retorno.tipoCaja            := v_tip_caja;
      v_retorno.codigoOficinaOrigen := v_cod_ofi_origen;
      v_retorno.codigoUsuario       := v_cod_usuario;
      v_retorno.fechaUltimoCierre   := v_ult_cierre;

      RETURN v_retorno;
   EXCEPTION
      WHEN no_data_found THEN
         -- paw_bce.v_cod_respuesta := '-20'; -- con error
         pr_mensajeUsuario(MSG_CAJ_NO_ENCONTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         RETURN v_retorno;
   END;
   -- Final de lf_val_caja

   FUNCTION fu_obt_sig_nro_secuencia(p_cod_ente    IN ge_pag_sue_lotes.cod_ente%TYPE,
                                      p_fec_proceso IN ge_pag_sue_lotes.fec_proceso%TYPE)
    RETURN NUMBER IS
      v_nro_secuencia NUMBER(3);
   BEGIN
    SELECT NVL(MAX(nro_secuencia),0) + 1
      INTO v_nro_secuencia
      FROM ge_pag_sue_lotes s1
     WHERE s1.cod_ente = p_cod_ente
       AND trunc(s1.fec_proceso) = trunc(p_fec_proceso);
    RETURN v_nro_secuencia;

   EXCEPTION
     WHEN no_data_found THEN
        v_nro_secuencia := 1;
        RETURN v_nro_secuencia;
   END;
     
   FUNCTION fu_obt_mov_user(p_tip_user in ba_cod_referencias.abreviatura%type) return typ_mensajeCaja is
    v_hora ge_movimientos.hora%type;
    v_nro_sec number;
    v_can_user number;
    v_nro_user number;
    c_msg_caj_no_encontrada constant varchar2(15) := '235';
    v_user ba_usuarios.cod_usuario%type;
    v_retorno   typ_mensajeCaja;
  BEGIN
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

    BEGIN
      select count(*)
      into v_can_user
      from ba_cod_referencias
      where dominio='USU_MOV_SERVICIO'
      and abreviatura=p_tip_user;
      EXCEPTION
        WHEN OTHERS THEN
         pr_mensajeUsuario(c_msg_caj_no_encontrada, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
    END;
    
     v_nro_sec := fue_obt_sig_secuencia('S_SER_USER');
     v_nro_user:=mod(v_nro_sec,v_can_user);
     
     if v_nro_user>=v_can_user then
       v_nro_sec:=0;
     end if;
     
     v_user:=it.FUE_OBT_VAL_USER_DOMINIO('USU_MOV_SERVICIO',v_nro_user,p_tip_user);
                       
      v_retorno.codigoOficinaOrigen := fug_obt_ofi_usuario(v_user);
      v_retorno.codigoUsuario       := v_user;
    
    return v_retorno;
  EXCEPTION
    WHEN OTHERS THEN
        pr_mensajeUsuario(c_msg_caj_no_encontrada, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         return v_retorno;
  END;
  
  FUNCTION fu_obt_hora(p_ind_usuario number) return varchar2 is
    v_hora ge_movimientos.hora%type;
    v_nro_sec number;
    v_nro_hor number;
  BEGIN
    if p_ind_usuario > 0 then
      v_nro_sec := fue_obt_sig_secuencia('s_hor_mov'||p_ind_usuario);
    elsif  p_ind_usuario = 0 then
      v_nro_sec := fue_obt_sig_secuencia('s_hor_mov');
    end if;

    if v_nro_sec <= 86400 then
      v_nro_hor := v_nro_sec;
    else
      v_nro_hor := mod(v_nro_sec, 86400);
    end if;
    v_hora := TO_CHAR(trunc(v_nro_hor/3600), 'FM9900')|| ':' ||
              TO_CHAR(TRUNC(MOD(v_nro_hor,3600)/60),'FM00') || ':' ||
              TO_CHAR(MOD(v_nro_hor,60),'FM00');
    return v_hora;
  EXCEPTION
    WHEN OTHERS THEN
      raise_application_error(-20000, 'No se puede obtener la hora del movimiento. ' || sqlerrm);
  END;

  PROCEDURE lp_env_tra_notificacion (p_cod_persona in ba_personas.cod_persona%type,
                                     p_tip_producto in ge_mai_onb_templates.tip_producto%type,
                                     p_inf_json in ba_env_correos.parametros%type,
                                     p_tip_mensaje in bw_tip_mensajes.cod_tip_mensaje%type,
                                     p_retorno OUT typ_mensajerespuesta) is
     v_dir_mai_cliente ba_personas.dir_correo%type;
     --C_ERR_INS_ENV_CORREO CONSTANT VARCHAR2(10) := '400';
   begin
     p_retorno:=typ_mensajerespuesta();
     if p_cod_persona is not null then
       BEGIN
         -- Busca la direccion de Correo del Cliente y Oficial
         select b.dir_correo
           into v_dir_mai_cliente
           from ba_personas b, ge_clientes c
          where b.cod_persona = p_cod_persona
            and b.cod_persona = c.cod_persona;
       
       EXCEPTION
         when others then
           v_dir_mai_cliente     := null;
       END;
     end if;
     if v_dir_mai_cliente is not null then
     begin
       insert into it.ba_env_correos
         (cod_persona,
          tip_producto,
          estado,
          fec_registro,
          parametros,
          mai_destinatario)
       values
         (p_cod_persona,
          p_tip_producto,
          'P',
          sysdate,
          p_inf_json,
          v_dir_mai_cliente);
          
     exception
       when others then
          pr_mensajeUsuario('ERR_RG_NOT', p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);
          pr_insertarBitacora(p_cod_persona,C_COD_HOMEBANKING, NULL, p_tip_mensaje, NULL, SUBSTR('lp_env_tra_notificacion()'||SQLERRM,1,4000), BITACORA_ERROR,NULL,'ERR_RG_NOT',SUBSTR('lp_env_tra_notificacion()'||SQLERRM,1,4000));
     end;
    end if;
     
   EXCEPTION
     WHEN OTHERS THEN
      NULL;
  end;  
     
     -- valida si una cuenta pertenece a un documento dado
  FUNCTION lf_cta_valida(p_nro_cuenta    VARCHAR2,
                         p_nro_documento IN VARCHAR2,
                         p_validarSesion IN typ_validarSesion,
                         v_retError      IN OUT typ_mensajeRespuesta) RETURN VARCHAR2 IS
     v_sino          VARCHAR2(01) := 'N';
     v_tip_persona   VARCHAR2(1);
     v_cod_persona   VARCHAR2(20);
     v_nro_documento VARCHAR2(20) := p_nro_documento;
     -- v_per_otr_cta varchar2(10);
     v_per_otr_cta  typ_obtenerPermisos;
     v_can_anterior NUMBER;
     v_retorno      typ_validarSesion;
  BEGIN
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

     IF v_nro_documento IS NULL THEN
        SELECT nro_documento
          INTO v_nro_documento
          FROM ba_personas
         WHERE cod_persona = nvl(p_validarSesion.codigoEmpresa, p_validarSesion.codigoPersona);
     ELSE
        -- veo si tiene permiso para transferencia 039 a otras cuentas
        v_can_anterior := v_can_aut_requeridas;
        v_per_otr_cta  := lf_obt_permisos(p_validarSesion, '039'); --nvl(p_validarSesion.codigoEmpresa, p_validarSesion.codigoPersona), p_validarSesion.codigoPerfil, '039', p_validarSesion.codigoCanal);

        v_can_aut_requeridas := v_can_anterior;
        IF v_per_otr_cta.error = 'S' THEN
           v_retError.error                := v_per_otr_cta.error;
           v_retError.nombreRespuesta      := v_per_otr_cta.nombreRespuesta;
           v_retError.descripcionRespuesta := v_per_otr_cta.descripcionRespuesta;
           v_sino := 'N';
           RETURN v_sino;
        END IF;
     END IF;

     SELECT tipo, a.cod_persona
       INTO v_tip_persona, v_cod_persona
       FROM ba_personas b, ge_cta_clientes a
      WHERE a.nro_cuenta = p_nro_cuenta
            AND a.relacion = 'P'
            AND a.cod_persona = b.cod_persona;
     BEGIN
        IF v_tip_persona = 'J' THEN
           -- empresa
           -- busqueda por principal para ver si es el documento de la empresa
           SELECT 'S'
             INTO v_sino
             FROM ba_personas a
            WHERE a.cod_persona = v_cod_persona
                  AND a.nro_documento = v_nro_documento;
        ELSE
           -- la cuenta es de una persona fisica
           SELECT 'S'
             INTO v_sino
             FROM ba_personas b
            WHERE b.nro_documento = v_nro_documento
                  AND b.cod_persona IN (SELECT x.cod_persona
                                          FROM ge_cta_clientes x
                                         WHERE x.nro_cuenta = p_nro_cuenta
                                               AND x.cod_persona = b.cod_persona)
                  AND rownum = 1; -- primero que encuentre
        END IF;
     END;
     RETURN v_sino;
  EXCEPTION
     WHEN OTHERS THEN
        v_sino := 'N';
        RETURN v_sino;
  END;

   FUNCTION fu_val_pin_temporal(p_cod_cliente IN VARCHAR2) RETURN VARCHAR2 IS
      v_fec_hora   bw_movimientos.fec_hora%TYPE;
      v_existe     VARCHAR2(01) := 'N';
      v_fec_actual DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
   BEGIN
      -- Verifico si posee movimientos de creación de pin temporales de IVR
      BEGIN
         SELECT nvl(MAX(a.fec_hora), '')
           INTO v_fec_hora
           FROM bw_movimientos a
          WHERE a.cod_per_ingreso = p_cod_cliente
            AND trunc(a.fec_hora) = v_fec_actual
            AND a.cod_tip_mensaje = '080'
            AND a.etiqueta = 'Call Center';
      EXCEPTION
         WHEN OTHERS THEN
            v_existe := 'N';
      END;
      IF v_fec_hora IS NOT NULL THEN
         IF ((SYSDATE - v_fec_hora) * 24 * 60) <= 30 THEN
            v_existe := 'S';
         END IF;
      END IF;
      RETURN(V_EXISTE);
   END;


   /** Crea una sesion para el canal y cuenta especificada
   * @param p_password        Contraseña en texto plano
   * @param p_dato            Información de tercero que desea iniciar sesion. El tipo esta especificado en p_tipoDato
   * @param p_tipoDato        Código del tipo de cuenta que desea iniciar sesion. "D" documento, "K" codigo Persona, "C" tarjeta de credito
   * @param p_nroDocEmpresa   nro de RUC de empresa a la que esta vinculada la persona.Opcional
   * @param p_tipoDocEmpresa  Tipo de Documento de la empresa. "D" RUC
   * @param p_codCanal        Código de Canal para el cual se creará la sesion
   * @return retorna informacion de la sesion creada  e información referente a la cuenta.
   */
FUNCTION fu_iniciarsesion(p_password       IN VARCHAR2,
                          p_dato           IN VARCHAR2,
                          p_tipodato       IN VARCHAR2,
                          p_nrodocempresa  IN VARCHAR2,
                          p_tipodocempresa IN VARCHAR2,
                          p_codcanal       IN VARCHAR2)
  RETURN typ_iniciarsesion IS
  PRAGMA AUTONOMOUS_TRANSACTION;

  -- variables
  --v_est_clave       VARCHAR2(1); -- estado de la clave: N-Nueva, A-Activa- B-bloqueada I_Inactiva
  v_password     VARCHAR2(32); -- clave del cliente (plaintext)


  v_inisesion NUMBER := 0;

  --v_cod_persona       ba_personas.cod_persona%TYPE;
  v_retorno           typ_iniciarsesion := typ_iniciarsesion;
  --Codigos de error

  msg_login_ses_existe           CONSTANT VARCHAR2(30) := 'L_SES_EXISTE';
  cod_operacion                  CONSTANT VARCHAR2(5) := '005';
  fecha_hora_actual              CONSTANT DATE := SYSDATE;
BEGIN

  v_retorno := paw_seg.fu_iniciarsesion(p_password, p_dato, p_tipodato, p_nrodocempresa, p_tipodocempresa, p_codcanal);

  IF v_retorno.error = 'N' THEN
    DECLARE
      v_salt         VARCHAR2(32);
      v_authtoken    VARCHAR2(32);
      v_max_time     NUMBER;
      v_tie_restante VARCHAR(10);
    BEGIN
      -- Se crea el Token de autenticacion
      --BBVAHB-750
      BEGIN
        BEGIN
          v_inisesion := to_number(nvl(fug_obt_pardinamico('NUE_SESION_HB'), 30));
        EXCEPTION
          WHEN OTHERS THEN
            v_inisesion := 30;
        END;
        v_max_time  := v_inisesion; --minutos
        v_inisesion := v_inisesion / 1440;
        SELECT cod_sesion
          INTO v_authtoken
          FROM bw_aut_sesiones
         WHERE cod_persona = v_retorno.codigocliente
           AND cod_canal = p_codcanal
           AND fec_insercion > SYSDATE - v_inisesion;
        paw_uti.pr_mensajeusuario(msg_login_ses_existe, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, v_retorno.error);

        BEGIN

          SELECT substr(to_char(((fec_ult_actividad +
                                 numtodsinterval(fug_obt_pardinamico('NUE_SESION_HB'),
                                                   'MINUTE')) -
                                 CAST(SYSDATE AS TIMESTAMP)), 'hh24:mi:ss'),
                         15, 5)
            INTO v_tie_restante
            FROM bw_aut_sesiones
           WHERE cod_persona = v_retorno.codigocliente
             AND cod_canal = p_codcanal
             AND (fec_ult_actividad + numtodsinterval(fug_obt_pardinamico('NUE_SESION_HB'), 'MINUTE')) > SYSDATE;

          --Redondemos para arriba para mostrar solo los minutos
          v_tie_restante := to_number(substr(v_tie_restante, 0, 2)) + 1;
          -- Ajustamos el texto con el plazo de validez de la sesion
          v_retorno.descripcionrespuesta := REPLACE(v_retorno.descripcionrespuesta,
                                                    '%d', v_tie_restante);
        EXCEPTION
          WHEN OTHERS THEN
            v_retorno.descripcionrespuesta := REPLACE(v_retorno.descripcionrespuesta,
                                                      '%d', v_max_time);
            paw_uti.pr_insertarbitacora(v_retorno.codigocliente, p_codcanal, NULL, cod_operacion, v_retorno.codigoempresa, 'Error ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta,
                                                    'Error: fec_ult_actividad ' || SYSDATE || ' -- ' || SQLCODE || ' => ' || substr(SQLERRM, 1, 200), NULL), paw_uti.bitacora_error);
        END;

        paw_uti.pr_insertarbitacora(v_retorno.codigocliente, p_codcanal, v_retorno.codigocliente, cod_operacion, v_retorno.codigoempresa, 'Error ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, NULL), paw_uti.bitacora_error);
        --v_retorno.sesionusuario := NULL;
        COMMIT;
        RETURN v_retorno;
      EXCEPTION
        WHEN OTHERS THEN
          paw_uti.pr_insertarbitacora(v_retorno.codigocliente, p_codcanal, v_retorno.codigocliente, cod_operacion,  v_retorno.codigoempresa, 'Error ' || fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, 'Error: ' || SQLCODE || ' => ' ||  substr(SQLERRM, 1, 200),  NULL), paw_uti.bitacora_error);
      END;
      --BBVAHB-750

      -- Generar Salt aleatorio Salt = MD5(random_string)
      SELECT paw_bce.fu_enc_md5(dbms_random.string('P', 20)) salt
        INTO v_salt
        FROM dual;

      -- md5(pass + salt + nroTerminal)
      v_authtoken := paw_bce.fu_enc_md5(v_password || v_salt || p_codcanal);

      --Invalidar los authtokens para misma cuenta y mismo canal
      --XXX IF (FORZAR_UNICA_SESION
      DELETE FROM bw_aut_sesiones
       WHERE cod_persona = v_retorno.codigocliente
         AND cod_canal = p_codcanal;

      --  Almacenar el hash en la tabla XX_AUTH_TOKEN, junto con los datos de IP,terminal, nroCuenta y fecha acceso
      INSERT INTO bw_aut_sesiones
        (cod_persona, cod_per_vinculada, cod_perfil, cod_canal, fec_ult_actividad, cod_sesion)
      VALUES
        (v_retorno.codigocliente, v_retorno.codigoempresa, v_retorno.codigoperfil, p_codcanal, fecha_hora_actual, p_password);

      --v_retorno.sesionusuario := v_authtoken;
      v_retorno.sesionUsuario := p_password;
      
      COMMIT;
      paw_uti.pr_insertarbitacora(v_retorno.codigocliente, p_codcanal, v_retorno.sesionusuario, cod_operacion, v_retorno.codigoempresa, 'iniciarSesion' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, NULL), paw_uti.bitacora_salida);
    END;
  END IF;
  --Estado de Softoken
  IF v_retorno.codigoEmpresa IS NULL THEN
     v_retorno.softoken := paw_otp.fu_obtenerAsignacionSofttoken(v_retorno.codigoCliente,'F', null);
  ELSE
     v_retorno.softoken := paw_otp.fu_obtenerAsignacionSofttoken(v_retorno.codigoCliente,'J', v_retorno.codigoEmpresa);
  END IF;
  --
  RETURN v_retorno;
END;

   /** Verifica la validez de una sesion obtenida previamente de fu_iniciarSesion
   * @param p_sesionUsuario identificador de sesion a ser verificado
   * @param p_codCanal identificador del Canal para el cual la sesion fue obtenida
   * @return retorna información de la sesion o error si no pudo comprobarse su validez
   */
   FUNCTION fu_validarSesion(p_sesionUsuario IN VARCHAR2,
                             p_codCanal      IN VARCHAR2,
                             p_validar       IN VARCHAR DEFAULT 'S') RETURN typ_validarSesion IS
      PRAGMA AUTONOMOUS_TRANSACTION;

      MSG_AUTH_ERROR  CONSTANT VARCHAR2(15) := 'L_AUTH_ERROR';
      MSG_CAM_CLA_NUE CONSTANT VARCHAR2(15) := 'L_CAM_CLAVE_NUE';
      MSG_CAM_CLA_EXP CONSTANT VARCHAR2(15) := 'L_CAM_CLAVE_EXP';
      MSG_TK_EXPIRADO CONSTANT VARCHAR2(15) := 'L_SESSION_EXP';

      FECHA_HORA_ACTUAL             CONSTANT DATE := SYSDATE;
      MAX_TIEMPO_INACTIVIDAD_SESION CONSTANT NUMBER(3) := 30;
      COD_OPERACION                 CONSTANT VARCHAR2(5) := '005';

      v_ultimoAcceso DATE;
      v_sesion       VARCHAR2(32);
      v_retorno      typ_validarSesion;
   BEGIN
      IF length(p_sesionUsuario) = 47 THEN
         paw_seg.fu_val_ses_consumer(p_sesionUsuario, p_codCanal,
                                     v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,
                                     v_retorno.codigoPersona, v_retorno.codigoEmpresa, v_retorno.codigoPerfil);
         v_retorno.codigoCanal := p_codCanal;
         RETURN v_retorno;
      END IF;
      v_sesion := depurarAlfanumerico(p_sesionUsuario, 32);

      IF (p_codCanal IS NULL OR v_sesion IS NULL OR length(p_codCanal) = 0 OR length(v_sesion) = 0) THEN
         pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_sesion, p_codCanal, NULL, COD_OPERACION, NULL, 'fu_validarSesion- Error Canal ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      BEGIN
         SELECT cod_canal, cod_persona, cod_per_vinculada, cod_perfil, fec_ult_actividad
           INTO v_retorno.codigoCanal, v_retorno.codigoPersona, v_retorno.codigoEmpresa, v_retorno.codigoPerfil, v_ultimoAcceso
           FROM BW_AUT_SESIONES TK
          WHERE TK.cod_sesion = v_sesion;
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            --LOG "Token no existe"
            pr_insertarBitacora('0', p_codCanal, v_sesion, COD_OPERACION, NULL, 'fu_validarSesion - Token inexistente-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      -- AuthToken  NO corresponde al usuario y canal proveido?
      IF (v_retorno.codigoCanal <> p_codCanal) THEN
         --Panic!
         DELETE FROM BW_AUT_SESIONES
          WHERE cod_sesion = p_sesionUsuario;
         COMMIT;

         pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         --LOG "Token no corresponde a datos enviados"
         pr_insertarBitacora('0', p_codCanal, p_sesionUsuario, COD_OPERACION, NULL, 'fu_validarSesion - Token no corresponde a canal-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --El AuthToken  ya no es válido?
      IF ((FECHA_HORA_ACTUAL - v_ultimoAcceso) * 1440) > MAX_TIEMPO_INACTIVIDAD_SESION THEN

         DELETE FROM BW_AUT_SESIONES
          WHERE cod_sesion = p_sesionUsuario;
         COMMIT;
         pr_mensajeUsuario(MSG_TK_EXPIRADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         --LOG "Token expirado"
         pr_insertarBitacora('0', p_codCanal, p_sesionUsuario, COD_OPERACION, v_retorno.codigoEmpresa, 'fu_validarSesion Token expirado-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --Validamos si la clave de acceso es nueva o ha expirado
      IF p_validar = 'S' THEN
         DECLARE
            v_est_clave bw_ope_claves.est_clave%type;
         BEGIN
            SELECT est_clave
              INTO v_est_clave
              FROM bw_ope_claves
             WHERE cod_persona = v_retorno.codigoPersona
               AND tip_clave = 'A'
               AND (
                     (v_retorno.codigoEmpresa IS NULL AND cod_per_vinculada IS NULL) OR
                     (v_retorno.codigoEmpresa IS NOT NULL AND cod_per_vinculada = v_retorno.codigoEmpresa)
                   );
              IF v_est_clave <> 'M' THEN
                 IF v_est_clave = 'A' THEN
                    pr_mensajeUsuario(MSG_CAM_CLA_EXP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(v_sesion, p_codCanal, p_sesionUsuario, COD_OPERACION, v_retorno.codigoEmpresa, 'fu_validarSesion - Clave acceso expirada ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 ELSIF v_est_clave IN ('N', 'P') THEN
                    pr_mensajeUsuario(MSG_CAM_CLA_NUE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(v_sesion, p_codCanal, p_sesionUsuario, COD_OPERACION, v_retorno.codigoEmpresa, 'fu_validarSesion - Clave acceso expirada ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 ELSE
                    pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(v_sesion, p_codCanal, NULL, COD_OPERACION, NULL, 'fu_validarSesion- Estado clave invalida ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 END IF;
                 RETURN v_retorno;
              END IF;
         END;
      END IF;

      --todo fue ok, actualizar el ultimo acceso
      UPDATE BW_AUT_SESIONES
         SET fec_ult_actividad = FECHA_HORA_ACTUAL
       WHERE cod_sesion = p_sesionUsuario;
      COMMIT;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- pr_insertarBitacora('000', p_codCanal, p_sesionUsuario, COD_OPERACION, v_retorno.codigoEmpresa, 'validarSesion-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   END;

   /** Elimina la sesion de la lista de sesiones activas
   * @param p_sesionUsuario identificador de sesion a ser eliminado
   * @return retorna el resultado de la operacion de eliminación
   */
   FUNCTION fu_eliminarSesion(p_sesionUsuario IN VARCHAR2) RETURN typ_mensajeRespuesta IS
      PRAGMA AUTONOMOUS_TRANSACTION;
      MSG_AUTH_ERROR CONSTANT VARCHAR2(15) := 'L_AUTH_ERROR';
      COD_OPERACION  CONSTANT VARCHAR2(5) := '005';
      v_retorno typ_mensajeRespuesta := typ_mensajerespuesta;

   BEGIN

      IF length(TRIM(p_sesionUsuario)) <> 32 THEN
         pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('000', '999', p_sesionUsuario, COD_OPERACION, NULL, 'fu_eliminarSesion - Pin inválido-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --Si existe Invalidar Siempre
      DELETE FROM BW_AUT_SESIONES
       WHERE cod_sesion = p_sesionUsuario;

      IF SQL%ROWCOUNT <> 1 THEN
         --LOG intentando invalidar sesion no existente
         pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('000', '999', p_sesionUsuario, COD_OPERACION, NULL, 'fu_eliminarSesion - Pin inválido-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      ELSE
         pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('000', '999', p_sesionUsuario, COD_OPERACION, NULL, 'fu_eliminarSesion - eliminarSesion' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      END IF;
      COMMIT;
      RETURN v_retorno;
   END;

   /**Inserta registro en bw_movimientos
   * @param p_nro_cuenta Nro de cuenta
   * @param p_cod_moneda Código de moneda
   * @param p_monto monto
   * @param p_nro_cta_contra Nro de cuenta
   * @param p_cantidad Cantidad
   * @param p_etiqueta Etiqueta
   * @param p_dato Dato
   * @param p_etiqueta2 Etiqueta2
   * @param p_dato2 Dato2
   * @param p_observacion Observación
   * @param p_dir_ip Dirección ip
   * @param p_cod_respuesta Codigo de respuesta
   * @param p_cod_persona Codigo de persona
   * @param p_cod_operacion Codigo de operación
   * @param p_nro_operacion Nro de operación
   * @param p_nro_terminal Nro de terminal
   * @param p_clave Clave
   * @param p_cod_per_empresa Código de empresa
   */
   PROCEDURE lp_reg_operacion(p_nro_cuenta      IN VARCHAR2 DEFAULT NULL,
                              p_cod_moneda      IN VARCHAR2 DEFAULT NULL,
                              p_monto           IN NUMBER DEFAULT NULL,
                              p_nro_cta_contra  IN VARCHAR2 DEFAULT NULL,
                              p_cantidad        IN NUMBER DEFAULT NULL,
                              p_etiqueta        IN VARCHAR2 DEFAULT NULL,
                              p_dato            IN VARCHAR2 DEFAULT NULL,
                              p_etiqueta2       IN VARCHAR2 DEFAULT NULL,
                              p_dato2           IN VARCHAR2 DEFAULT NULL,
                              p_observacion     IN VARCHAR2 DEFAULT NULL,
                              p_dir_ip          IN VARCHAR2 DEFAULT NULL,
                              p_cod_respuesta   IN VARCHAR2 DEFAULT NULL,
                              p_cod_persona     IN VARCHAR2 DEFAULT NULL,
                              p_cod_operacion   IN VARCHAR2 DEFAULT NULL,
                              p_nro_operacion   IN VARCHAR2 DEFAULT NULL,
                              p_nro_terminal    IN VARCHAR2 DEFAULT NULL,
                              p_clave           IN VARCHAR2 DEFAULT NULL,
                              p_cod_per_empresa IN VARCHAR2 DEFAULT NULL,
                              p_parametros      IN VARCHAR2 DEFAULT NULL,
                              p_etiqueta3       IN VARCHAR2 DEFAULT NULL,
                              p_dato3           IN VARCHAR2 DEFAULT NULL) IS
      PRAGMA AUTONOMOUS_TRANSACTION; --- para que grabe solo esta transaccion
   BEGIN
      INSERT INTO bw_movimientos
         (nro_documento, cod_per_principal, cod_per_ingreso, clave, fec_hora, nro_caja, cod_tip_mensaje, dir_ip, cod_respuesta, observacion, nro_cuenta, cod_moneda, monto, nro_cta_contra, cantidad, etiqueta, dato, etiqueta2, dato2, parametros, etiqueta3, dato3)
      VALUES
         (p_nro_operacion, nvl(p_cod_per_empresa, p_cod_persona), p_cod_persona, substr(p_clave, 1, 20), SYSDATE, p_nro_terminal, p_cod_operacion, p_dir_ip, p_cod_respuesta, p_observacion, substr(REPLACE(TRIM(p_nro_cuenta), chr(13), ''),0,15), p_cod_moneda, p_monto, substr(REPLACE(TRIM(p_nro_cta_contra), chr(13), ''),0,15), p_cantidad, p_etiqueta, p_dato, p_etiqueta2, p_dato2, substr(p_parametros, 1, 1000),p_etiqueta3, p_dato3);
      COMMIT;
   EXCEPTION
      WHEN OTHERS THEN
         NULL;
   END;

   FUNCTION fu_cambiarClaveAcceso(p_sesion      IN VARCHAR2,
                                  p_codCanal    IN VARCHAR2,
                                  p_claveActual IN VARCHAR2,
                                  p_claveNueva  IN VARCHAR2) RETURN typ_mensajeRespuesta IS

      --variables
      v_cod_operacion        VARCHAR2(3) := '080';
      v_retorno              typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_permiso              typ_obtenerPermisos;
      retValidarSesion       typ_validarSesion;
      v_clave_encriptada_new BW_OPE_CLAVES.clave%TYPE; -- GE_CLIENTES.clave%TYPE;
      v_clave_encriptada_old BW_OPE_CLAVES.clave%TYPE; -- GE_CLIENTES.clave%TYPE;
      v_clave_encriptadabd   BW_OPE_CLAVES.clave%TYPE; -- GE_CLIENTES.clave%TYPE;
      v_clave                VARCHAR2(300);
      v_aux                  VARCHAR2(100);
      v_salt                 BW_OPE_CLAVES.cla_verificador%TYPE;
      v_can_intentos         BW_OPE_CLAVES.CAN_INTENTOS%TYPE;

      --Codigos de error
      MSG_LOGIN_OK    CONSTANT VARCHAR2(15) := 'OP_APROBADA';
      MSG_LOGIN_ERR   CONSTANT VARCHAR2(15) := 'L_ERROR';
      MSG_CLA_DUPLICA CONSTANT VARCHAR2(15) := 'G_CLA_DUPLICADA';
      MSG_CLA_BLOQ_ERR  CONSTANT VARCHAR2(15) := 'L_PIN_BLOQUEADO';
      MSG_CLA_BLOQ_WARN CONSTANT VARCHAR2(15) := 'L_PIN_BLOQ_WARN';
      --MSG_NUMERIC_ERR CONSTANT VARCHAR2(15) := 'G_NUMERIC_ERROR';

   BEGIN
      v_clave_encriptada_new := p_claveNueva;
      --v_clave_encriptada_old := p_claveActual;

      --valido la sesión del cliente
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal, 'N');

      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      v_permiso := lf_obt_permisos(retValidarSesion, v_cod_operacion); --nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), retValidarSesion.codigoPerfil, v_cod_operacion, p_codCanal);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, '- fu_cambiarClaveAcceso:' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF length(p_claveNueva) <> 32 THEN
        pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '- fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
        RETURN v_retorno;
      END IF;

      --valida que el parámetro "clave actual" sea el que se encuentre registrado en la base de datos
      BEGIN
         SELECT a.clave, a.cla_verificador, a.can_intentos
           INTO v_clave_encriptadabd, v_salt, v_can_intentos
           FROM bw_ope_claves a
          WHERE a.cod_persona = retValidarSesion.codigoPersona
            AND a.tip_clave = 'A'
            AND
              (
                (retValidarSesion.codigoEmpresa IS NULL AND a.cod_per_vinculada IS NULL) OR
                (retValidarSesion.codigoEmpresa IS NOT NULL AND a.cod_per_vinculada = retValidarSesion.codigoEmpresa )
              );
         IF SQL%NOTFOUND THEN
            pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null), BITACORA_ERROR);
         ELSE
           
           /* Verificar este punto
            v_clave_encriptada_old := v_salt || '|' || p_claveActual;
            v_clave_encriptada_old := rawtohex(utl_raw.cast_to_raw(dbms_obfuscation_toolkit.md5(input_string => v_clave_encriptada_old)));*/
            v_clave_encriptada_old := p_claveActual;
         END IF;
      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null), BITACORA_ERROR);
      END;

      IF (v_clave_encriptadabd <> v_clave_encriptada_old) THEN
        --issue 10622757 GMVSES-CESI-ITR-074 (PenTEST Holding 2016)
        v_retorno := paw_seg.fu_val_ope_clave(v_clave_encriptada_old, retValidarSesion.codigoPersona, null, 'A', 'N');
        v_can_intentos := v_can_intentos + 1;

        IF v_can_intentos = 4 THEN
           pr_mensajeUsuario(MSG_CLA_BLOQ_WARN, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        ELSIF v_can_intentos > 4 THEN
           pr_mensajeUsuario(MSG_CLA_BLOQ_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        ELSE
           pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        END IF;

        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null), BITACORA_ERROR);
        RETURN v_retorno;
      END IF;

      --Control de la clave nueva
      IF length(TRIM(p_claveNueva)) = 0 THEN
         -- no viene la clave nueva
         pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      ELSIF p_claveNueva = p_claveActual THEN
         -- clave igual a la anterior
         pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      ELSE
         -- aprobado
         pr_mensajeUsuario(MSG_LOGIN_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

         -- actualizo la nueva clave
         v_clave := paw_bce.fu_gen_ope_clave(v_clave_encriptada_new,
                                             retValidarSesion.codigoPersona,
                                             retValidarSesion.codigoEmpresa,
                                             'A', -- actualizar clave de acceso
                                             'A', -- tipo de clave
                                             v_aux);
         IF v_clave in ('-5', '-3') THEN
           -- v_cod_respuesta := paw_bce.v_cod_pin_invalido;
           pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
           RETURN v_retorno;
         ELSIF v_clave = '-6' THEN
           -- v_cod_respuesta := paw_bce.v_sol_cla_existe;
           pr_mensajeUsuario(MSG_CLA_DUPLICA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
           RETURN v_retorno;
         END IF;
      END IF;
      -- registro del movimiento
      lp_reg_operacion(NULL /*p_nro_cuenta*/, NULL /*p_cod_moneda */, NULL /*p_monto*/, NULL /*p_nro_cta_contra*/, NULL
                       /*p_cantidad*/, 'Clave Nueva' /*p_etiqueta*/, NULL /*p_dato*/, NULL /*p_etiqueta2*/, NULL /*p_dato2*/, NULL
                       /*p_observacion*/, NULL /*p_dir_ip*/, NULL /*p_cod_respuesta*/, retValidarSesion.codigoPersona
                       /*p_cod_persona*/, v_cod_operacion /*p_cod_operacion*/, retValidarSesion.codigoPersona /*p_nro_operacion*/, p_codCanal /*p_nro_terminal*/, p_sesion /*p_clave*/, retValidarSesion.codigoEmpresa /*p_cod_per_empresa*/);

      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, '- fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_SALIDA);
      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), NULL);
         RETURN v_retorno;
   END;

   FUNCTION fu_cambiarClaveTransaccion(p_sesion      IN VARCHAR2,
                                       p_codCanal    IN VARCHAR2,
                                       p_claveActual IN VARCHAR2,
                                       p_claveNueva  IN VARCHAR2) RETURN typ_mensajeRespuesta IS
      v_cod_operacion  VARCHAR2(3) := '219';
      v_cla_actual     VARCHAR2(100);
      v_cla_nueva      VARCHAR2(100);
      retValidarSesion typ_validarSesion;
      v_retorno        typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_permiso        typ_obtenerPermisos;
      v_clave                VARCHAR2(300);
      v_aux                  VARCHAR2(100);
      --Codigos de error
      MSG_OPE_NO_PERMITIDA CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_OPE_APROBADA     CONSTANT VARCHAR2(15) := 'OP_APROBADA';
      MSG_CLA_DUPLICA      CONSTANT VARCHAR2(15) := 'G_CLA_DUPLICADA';
     -- MSG_OPE_BLOQUEADA    CONSTANT VARCHAR2(15) := 'CLA_OPE_INTENTO';
      MSG_OPE_INVALIDA     CONSTANT VARCHAR2(15) := 'CLA_OPE_INVALID';
   BEGIN

      --controlo que la clave nueva y la actual tengan una extensión de 32
      IF length(p_claveActual) <> 32 OR length(p_claveNueva) <> 32 THEN
         pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('0', p_codCanal, p_sesion, v_tip_mensaje, NULL, 'fu_cambiarClaveTransaccion-'||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), NULL);
         RETURN v_retorno;
      END IF;

      --control de que la clave actual sea distinta a la anterior
      IF (p_claveActual = p_claveNueva) THEN
         pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('0', p_codCanal, p_sesion, v_tip_mensaje, NULL,  'fu_cambiarClaveTransaccion-'||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), NULL);
         RETURN v_retorno;
      END IF;

      --valida la sesion del usuario
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);

      IF retValidarSesion.error = 'S' THEN
         pr_insertarBitacora(retValidarSesion.codigoPersona, retValidarSesion.codigoCanal, p_sesion, v_tip_mensaje, NULL,  'fu_cambiarClaveTransaccion-'||v_retorno.descripcionRespuesta || '-' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         v_retorno.error                := retValidarSesion.error;
         RETURN v_retorno;
      END IF;

      v_permiso := lf_obt_permisos(retValidarSesion, v_cod_operacion); --nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), retValidarSesion.codigoPerfil, v_cod_operacion, p_codCanal);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fu_cambiarClaveTransaccion-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      v_cla_actual := p_claveActual;
      v_cla_nueva  := p_claveNueva;
      -- validamos la clave transaccional actual
      v_retorno := paw_seg.fu_val_ope_clave(v_cla_actual, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, 'T');
      IF v_retorno.error = 'S' THEN
         -- si es clave nueva debe cambiar
         IF v_retorno.nombreRespuesta = 'CLA_OPE_CAMBIAR' THEN
            v_retorno.error := 'N';
            v_retorno.nombreRespuesta := 'OP_APROBADA';
            v_retorno.descripcionRespuesta := '';
         ELSE
            -- pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora('0', p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,  'fu_cambiarClaveTransaccion-'||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
      -- no hubo errores hasta aquí
      -- actualizo la nueva clave
      v_clave := paw_bce.fu_gen_ope_clave(v_cla_nueva,
                                          retValidarSesion.codigoPersona,
                                          retValidarSesion.codigoEmpresa,
                                          'A', -- actualizar clave transaccional
                                          'T', -- tipo de clave
                                          v_aux);
      IF v_clave in ('-5', '-3') THEN
         pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveTransaccion:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      ELSIF v_clave = '-6' THEN
         pr_mensajeUsuario(MSG_CLA_DUPLICA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveTransaccion:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      pr_mensajeUsuario(MSG_OPE_APROBADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, retValidarSesion.codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,  'fu_cambiarClaveTransaccion-'||v_retorno.descripcionRespuesta || '-' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, retValidarSesion.codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,  'fu_cambiarClaveTransaccion-'||substr(sqlerrm, 1, 200) || '-' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerDetalleCheques(p_sesion           IN VARCHAR2,
                                     p_codCanal         IN VARCHAR2,
                                     p_nroCtaEspecifica IN VARCHAR2,
                                     p_nroInicial       IN VARCHAR2) RETURN typ_detallesChequeras IS
     CHQ_DAT_SIN_MOV   CONSTANT VARCHAR2(15) := 'CHQ_DAT_SIN_MOV';
     CHQ_ERR_OBT_DATOS CONSTANT VARCHAR2(15) := 'CHQ_ERR_OBT_DAT';
     MSG_CTA_NO_CORRESP CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';
     v_retorno         typ_detallesChequeras := typ_detallesChequeras;
     v_det_cheque      typ_DetalleChequera := typ_detalleChequera;
     v_lis_det_cheques typ_listaDetalleChequeras := typ_listaDetalleChequeras();
     v_cod_operacion   VARCHAR2(3) := '063';
     retValidarSesion  typ_validarSesion;
     v_permiso         typ_obtenerPermisos;
     v_mensajeCaja     typ_mensajeCaja;
     v_nro_cta_especifica VARCHAR2(16);
     v_nro_inicial        cc_chequeras.nro_che_inicial%TYPE := substr(p_nroInicial,0,15);
     v_nro_cheque         cc_chequeras.nro_che_final%TYPE;
     v_fec_solicitud DATE;

     v_tip_chequera cc_tip_chequeras.descripcion%TYPE;
     v_est_cheques  cc_chequeras.est_cheques%TYPE;
     v_can_cheques  cc_chequeras.can_cheques%TYPE;
     v_pos VARCHAR2(1);
     -- tipos de chequeras
  BEGIN
     -- 1. valido la clave del cliente
     --valido la sesión del cliente
     retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);

     IF retValidarSesion.error = 'S' THEN
        v_retorno.error                := retValidarSesion.error;
        v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
        v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     v_mensajeCaja := lf_val_caja(retValidarSesion);

     IF v_mensajeCaja.error = 'S' THEN
        v_retorno.error                := v_mensajeCaja.error;
        v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     -- se valida el permiso
     v_permiso := lf_obt_permisos(retValidarSesion, '061');
     IF (v_permiso.error = 'S') THEN
        v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
        v_retorno.error                := v_permiso.error;
        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
        RETURN v_retorno;
     END IF;

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fu_obtenerDetalleCheques- Cta esp:' || p_nroCtaEspecifica || ' nro ini:' || p_nroInicial || ' ' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ENTRADA);

     v_nro_cta_especifica := depurarAlfanumerico(p_nroCtaEspecifica,CUENTA_TAMANO);
     --Valida que la cuenta corresponda al cliente
     IF lf_val_cta_origen(v_nro_cta_especifica, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona)) = 'N' THEN
        pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
        RETURN v_retorno;
     END IF;
     -- 2. busco los datos de la cuentas
     IF v_retorno.error = 'N' THEN
        BEGIN
           SELECT c.fec_solicitud, t.descripcion tipo, c.est_cheques, c.can_cheques
             INTO v_fec_solicitud, v_tip_chequera, v_est_cheques, v_can_cheques
             FROM cc_tip_chequeras t, cc_chequeras c
            WHERE t.cod_tip_chequera = c.tipo
                  AND nro_cuenta = v_nro_cta_especifica
                  AND nro_che_inicial = v_nro_inicial;
        END;
        ---
        IF v_retorno.error = 'N' THEN
           v_retorno.cantChequeras := v_can_cheques;
           -- v_detalles :=  v_detalles ||lf_for_char(v_can_cheques,3);
        END IF;
        IF v_can_cheques > 0 THEN
           v_nro_cheque := v_nro_inicial;
           FOR i IN 1 .. v_can_cheques
           LOOP
              v_pos := substr(v_est_cheques, i, 1);
              --v_det_cheques := v_det_cheques||lf_for_char(v_nro_cheque,7)||lf_for_char(fue_obt_des_refcodes('EST_CHEQUE', v_pos),20);
              v_det_cheque.inicio := v_nro_cheque;
              v_det_cheque.estado := substr(fue_obt_des_refcodes('EST_CHEQUE', v_pos),0, 20);
              v_lis_det_cheques.EXTEND;
              v_lis_det_cheques(v_lis_det_cheques.COUNT) := v_det_cheque;

              v_nro_cheque := v_nro_cheque + 1;
           END LOOP;
           ---
           -- v_detalles := v_detalles||v_det_cheques;
           v_retorno.listaDetalleChequera := v_lis_det_cheques;
        ELSE
           -- v_cod_respuesta := paw_bce.v_cod_cta_sin_mov;
           pr_mensajeUsuario(CHQ_DAT_SIN_MOV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fu_obtenerDetalleCheques- Cta esp:' || p_nroCtaEspecifica || ' nro ini:' || p_nroInicial || ' ' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
        END IF;

        -- registro del movimiento
        IF v_retorno.error = 'N' THEN
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fu_obtenerDetalleCheques- Cta esp:' || p_nroCtaEspecifica || ' nro ini:' || p_nroInicial || ' ' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_SALIDA);
        END IF;
     END IF;
     RETURN v_retorno;
  EXCEPTION
     WHEN OTHERS THEN
        pr_mensajeUsuario(CHQ_ERR_OBT_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fu_obtenerDetalleCheques- Cta esp:' || p_nroCtaEspecifica || ' nro ini:' || p_nroInicial || ' ' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
        RETURN v_retorno;
  END;

   FUNCTION fu_obtenerDetalleCuentas(p_sesion              IN VARCHAR2,
                                     p_codCanal            IN VARCHAR2,
                                     p_nroCuentaEspecifica IN VARCHAR2 DEFAULT NULL) RETURN typ_obtenerDetalleCuentas IS

      COD_OPERACION  VARCHAR2(3) := '020';
      userInfo       typ_validarSesion;
      v_permiso      typ_obtenerPermisos;
      v_retorno      typ_obtenerDetalleCuentas := typ_obtenerDetalleCuentas;
      v_logmessage   VARCHAR(1000);
   BEGIN

      -- 0. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parámetros
      v_logMessage := substr('obtenerDetalleCuentas(nroCuentaEspecifica=' || p_nroCuentaEspecifica || ')',0,999);
      paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, paw_uti.BITACORA_ENTRADA);

      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- control de permisos
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         paw_uti.pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userinfo.codigoEmpresa, 'lf_obt_permisos - ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --llamamos a paw_can
      v_retorno := paw_can.fu_ns_obtenerDetalleCuentas(userinfo.codigoPersona,userinfo.codigoEmpresa,p_codCanal,p_nroCuentaEspecifica, p_sesion);
      paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, paw_uti.BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obtenerDetalleCuentas -' || SQLERRM, paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerDatosChequeCasa(p_sesion   IN VARCHAR2,
                                      p_codCanal IN VARCHAR2) RETURN typ_datosChequeCasa IS
      v_can_detalles  NUMBER(3) := 0;
      v_cod_operacion VARCHAR2(3) := '066';
      v_retorno       typ_datosChequeCasa := typ_datosChequeCasa();
      v_lis_detalle   typ_listaDatoChequeCasa := typ_listaDatoChequeCasa();
      v_detalle       typ_datoChequeCasa := typ_datoChequeCasa();
      v_usu_sesion    typ_validarSesion;
      v_msj_caja      typ_mensajeCaja;
      -- cursor para obtener direcciones
      CURSOR c_datos(p_cod_persona ba_personas.cod_persona%TYPE) IS
         SELECT c.nro_documento, c.nom_completo, c.nro_telefono, decode(c.estado, 'A', 'Activo', 'Inactvio') estado, t.abreviatura tip_documento
           FROM cc_dat_che_casa c, ba_tip_documentos t
          WHERE c.cod_per_principal = p_cod_persona
            AND c.cod_tip_documento = t.cod_tip_documento;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- 1. Valido la clave del cliente
      v_usu_sesion := fu_validarSesion(p_sesion, p_codCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- 2. Valido la caja
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- 3. busco los datos de las direcciones
      FOR ct IN c_datos(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)) LOOP
         v_can_detalles         := v_can_detalles + 1;
         v_detalle.cedula       := substr(ct.nro_documento, 1, 20);
         v_detalle.nombre        := substr(ct.nom_completo, 1, 120);
         v_detalle.estado       := substr(ct.estado, 1, 15);
         v_detalle.telefono     := substr(ct.nro_telefono, 1, 10);
         v_detalle.tipDocumento := substr(ct.tip_documento, 1, 4);

         v_lis_detalle.extend;
         v_lis_detalle(v_lis_detalle.count) := v_detalle;
      END LOOP;
      v_retorno.cantidad := v_can_detalles;
      v_retorno.listaDatos := v_lis_detalle;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'fu_obtenerDirecciones: [' || SQLERRM||']', BITACORA_ERROR);
    RETURN v_retorno;
   END;

   FUNCTION fu_obtenerResumenCuentas(p_sesion   IN VARCHAR2,
                                     p_codCanal IN VARCHAR2,
                                     p_filtro   IN VARCHAR2 DEFAULT NULL) RETURN typ_resumenCuentas IS

      MSG_LOGIN_ERR_SIN_AUTORIZACION CONSTANT VARCHAR2(30) := 'P_OP_NO_PERM';
      COD_OPERACION                  CONSTANT VARCHAR2(3) := '011';
      v_permiso                      typ_obtenerPermisos;
      -- datos recibidos
      v_ver_cuentas   VARCHAR2(1) := 'T';

      --v_cod_perfil      VARCHAR2(20);
      v_can_detalles    NUMBER;
      v_cod_persona     VARCHAR2(15);
      v_cod_per_empresa VARCHAR2(15);
      --
      userInfo         typ_validarSesion;
      v_retorno        typ_resumenCuentas := typ_resumenCuentas;
      v_logMessage     VARCHAR2(500);
      -- cursor de cuentas del cliente

   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parámetros
      v_logMessage := 'obtenerResumenCuentas(p_filtro=' || p_filtro || ')';
      if fug_obt_pardinamico('REG_BITACORA_BW') = 'S' then
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);
      end if;
      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;

      v_cod_persona     := userInfo.codigoPersona;
      v_cod_per_empresa := userInfo.codigoEmpresa;

      -- Verifico si el cliente con su perfil tendrá acceso a realizar la transaccion
      IF v_retorno.error = 'N' THEN
         DECLARE
            v_tip_consulta bw_tip_mensajes.cod_tip_mensaje%TYPE;
         BEGIN
            SELECT nvl(trim(substr(p_filtro, 1, 3)), '020')
              INTO v_tip_consulta
              FROM dual;
            v_permiso := lf_obt_permisos(userinfo, v_tip_consulta);

            IF (v_permiso.error = 'S') THEN
               v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
               v_retorno.error                := v_permiso.error;
               pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userinfo.codigoEmpresa, 'lf_obt_permisos - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
            IF not v_permiso.registra and v_ver_cuentas = 'D' THEN
               pr_mensajeUsuario(MSG_LOGIN_ERR_SIN_AUTORIZACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'obtenerResumenCuentas - Sin auth ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            END IF;
         END;
      END IF;

      -- 2. busco los datos de la cuentas
      IF v_retorno.error = 'N' THEN
         v_retorno:= paw_bas.fu_obtenerresumencuentas(v_cod_persona, v_cod_per_empresa, p_codcanal, p_sesion, v_can_aut_requeridas, p_filtro);
         if fug_obt_pardinamico('REG_BITACORA_BW') = 'S' then
                  pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'obtenerResumenCuentas- filtro: ' || p_filtro || ', canDet:' || v_can_detalles || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
         end if;
         return v_retorno;
      END IF;

      IF v_retorno.error = 'S' THEN
         v_retorno.resumenCuentas := NULL; --just in case...
         RETURN v_retorno;
      END IF;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ', canDet:' || v_can_detalles|| ' - [' || SQLERRM || ']', BITACORA_ERROR);
       RETURN v_retorno;
   END;


   FUNCTION fu_obtenerMovimientos(p_sesion              IN VARCHAR2,
                                  p_codCanal            IN VARCHAR2,
                                  p_nroCuentaEspecifica IN VARCHAR2,
                                  p_nroPagina           IN NUMBER DEFAULT NULL,
                                  p_cantItemsPagina     IN NUMBER DEFAULT NULL,
                                  p_cantDias            IN NUMBER DEFAULT NULL) RETURN typ_detalleMovimientos IS

      userInfo         typ_validarSesion;
      v_fec_actual DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
      v_fec_inicio DATE := v_fec_actual - nvl(p_cantDias, 90);
      v_fec_final  DATE := v_fec_actual;
      COD_OPERACION    VARCHAR2(3) := '021';
      v_retorno        typ_DetalleMovimientos := typ_detalleMovimientos;

   BEGIN
      v_retorno :=fu_obtenerMovimientos_por_fec(p_sesion,
                                  p_codCanal,
                                  p_nroCuentaEspecifica,
                                  p_nroPagina,
                                  p_cantItemsPagina,
                                  v_fec_inicio,
                                  v_fec_final);
      return v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obtenerMovimientos -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;


   FUNCTION fu_obtenerMovimientos_por_fec(p_sesion      IN VARCHAR2,
                                  p_codCanal            IN VARCHAR2,
                                  p_nroCuentaEspecifica IN VARCHAR2,
                                  p_nroPagina           IN NUMBER DEFAULT NULL,
                                  p_cantItemsPagina     IN NUMBER DEFAULT NULL,
                                  p_fec_inicio          IN DATE DEFAULT NULL,
                                  p_fec_fin             IN DATE DEFAULT NULL) RETURN typ_detalleMovimientos IS
      -- variables
      userInfo         typ_validarSesion;
      v_permiso        typ_obtenerPermisos;
      COD_OPERACION    VARCHAR2(3) := '021';
      v_retorno        typ_DetalleMovimientos := typ_detalleMovimientos;
      v_logmessage     VARCHAR2(1000);
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);

      --Logear parametros
      v_logMessage := 'p_nroPagina='||p_nroPagina||',p_cantItemsPagina='||p_cantItemsPagina||', nroCuentaEspecifica=' || p_nroCuentaEspecifica;

      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage ||' '||paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 2. busco los datos de la cuentas
      RETURN paw_bas.fu_obtenerMovimientos_por_fec(userInfo.codigoPersona, userInfo.codigoEmpresa, p_codCanal, p_sesion, p_nroCuentaEspecifica, p_nroPagina, p_cantItemsPagina, p_fec_inicio, p_fec_fin);
   END;

   FUNCTION fu_obtComprobanteMovAutDeb(p_sesion       IN VARCHAR2,
                                        p_codCanal     IN VARCHAR2,
                                        p_nroCuenta    IN VARCHAR2,
                                        p_fecha        IN DATE,
                                        p_nroDocumento IN NUMBER,
                                        p_monto        IN NUMBER,
                                        p_tipo         IN VARCHAR2,
                                        p_factura      IN VARCHAR2,
                                        p_nroSecuencia IN NUMBER DEFAULT NULL,
                                        p_hora         IN VARCHAR2 DEFAULT NULL)
    RETURN typ_comprobanteMovAutDeb IS
      v_retorno typ_comprobanteMovAutDeb := typ_comprobanteMovAutDeb;
      v_nro_cuenta ge_cta_clientes.nro_cuenta%TYPE;
      v_cliente varchar2(200);
      v_direccion varchar2(500);
      v_telefono varchar2(20);
      v_pri_modalidad ge_modalidades.descripcion%type;
      v_pri_cta_formateada varchar2(200);
      v_pri_moneda ba_monedas.descripcion%TYPE;
      v_oficial varchar2(200);
      v_cod_modalidad number(3);
      v_oficina varchar2(100);

    begin

      v_retorno.detalleMovimiento := fu_obtComprobanteMovimiento(p_sesion, p_codCanal, p_nroCuenta, p_fecha
                 , p_nroDocumento, p_monto, p_tipo, p_factura, p_nroSecuencia, p_hora);

      select c.nro_cuenta,
             c.cod_persona||' '||fue_obt_nom_persona(c.cod_persona) cliente,
             fue_obt_dir_principa(c.cod_persona) direccion,
             fue_obt_tel_principa(c.cod_persona) telefono,
             fug_obt_des_modal(g.cod_modulo, g.cod_modalidad) pri_modalidad,
             FUG_CTA_FORMATEADA(g.cod_modulo,g.cod_modalidad,g.cod_oficina,g.nro_cuenta,g.cod_moneda) pri_cta_formateada,
             m.descripcion pri_moneda,
             fue_obt_nom_usuario(l.cod_usu_oficial) oficial,
             initcap(fue_obt_des_oficina(g.cod_oficina)) ofi_cliente
      into v_nro_cuenta, v_cliente, v_direccion, v_telefono, v_pri_modalidad
           , v_pri_cta_formateada, v_pri_moneda, v_oficial, v_oficina
      from ge_cuentas g,
              ge_cta_clientes c,
              ge_clientes l,
               ba_monedas m
      where g.nro_cuenta = c.nro_cuenta
      and c.relacion = 'P'
      and g.cod_moneda = m.cod_moneda
      and l.cod_persona = c.cod_persona
      and g.nro_cuenta=p_nroCuenta;

      v_retorno.error := 'N';
      v_retorno.nombreRespuesta := '';
      v_retorno.descripcionRespuesta := '';
      v_retorno.cliente := v_cliente;
      v_retorno.direccion := v_direccion;
      v_retorno.nroCuenta := v_nro_cuenta;
      v_retorno.oficial := v_oficial;
      v_retorno.telefono := v_telefono;
      v_retorno.moneda := v_pri_moneda;
      v_retorno.oficina := v_oficina;
      v_retorno.tipoCuenta := p_tipo;
      v_retorno.montoLetras := fue_obt_denominacion(v_retorno.detalleMovimiento.monto);

      return v_retorno;
    end;

   FUNCTION fu_obtComprobanteMovimiento(p_sesion       IN VARCHAR2,
                                        p_codCanal     IN VARCHAR2,
                                        p_nroCuenta    IN VARCHAR2,
                                        p_fecha        IN DATE,
                                        p_nroDocumento IN NUMBER,
                                        p_monto        IN NUMBER,
                                        p_tipo         IN VARCHAR2,
                                        p_factura      IN VARCHAR2,
                                        p_nroSecuencia IN NUMBER DEFAULT NULL,
                                        p_hora         IN VARCHAR2 DEFAULT NULL)
    RETURN typ_comprobanteMovimiento IS

      COD_OPERACION CONSTANT VARCHAR2(3) := '022';

      MSG_OBTCOMPROB_TJ_INEXISTENTE  CONSTANT VARCHAR2(15) := 'OBTCOMP_TJ_NOEX';
      MSG_OBTCOMPROB_TJ_ERROR        CONSTANT VARCHAR2(15) := 'OBTCOMP_TJ_ERR';
      MSG_OBTCOMPROB_SIN_COMPROBANTE CONSTANT VARCHAR2(15) := 'OBTCOMP_SIN_COM';
      MSG_OBTCOMPROB_MULTIPLES_COMPR CONSTANT VARCHAR2(15) := 'OBTCOMP_MULT_CO';
      MSG_OBTCOMPROB_ERROR           CONSTANT VARCHAR2(15) := 'OBTCOMP_ERROR';
      MSG_CTA_NO_CORRESP             CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';
      --devuelve los datos del movimiento en formato html para imprimir el comprobante en la web
      v_des_tra_padre   ge_transacciones.descripcion%TYPE;
      v_cod_moneda      ge_movimientos.cod_moneda%TYPE;
      v_fila            VARCHAR2(200);
      v_cod_transaccion ge_movimientos.cod_transaccion%TYPE;
      v_cod_banco       ge_movimientos.cod_banco%TYPE;
      v_nro_caja        ge_movimientos.nro_caja%TYPE;
      v_concepto        ge_movimientos.concepto%TYPE;
      v_ofi_origen      ge_movimientos.cod_ofi_origen%TYPE;
      v_cod_oficina     ge_movimientos.cod_oficina%TYPE;
      v_hora            ge_movimientos.hora%TYPE;
      v_cta_formateada  VARCHAR2(20);
      v_tip_cta         ge_modalidades.descripcion%TYPE;
      v_tip_mov         VARCHAR2(10);
      v_error           VARCHAR2(1000);
      v_cod_usuario     ge_movimientos.cod_usuario%TYPE;
      v_nro_secuencia   ge_movimientos.nro_secuencia%TYPE;
      v_nro_cuenta      ge_movimientos.nro_cuenta%TYPE;
      v_nro_cta_mov     ge_movimientos.nro_cuenta%TYPE;
      v_cantidad        NUMBER;
      v_cod_tra_padre   ge_movimientos.cod_tra_padre%TYPE;
      v_cod_mad_padre   ge_movimientos.cod_mad_padre%TYPE;
      v_cod_modulo      NUMBER(5);
      v_cod_modalidad   NUMBER(5);
      v_retorno         typ_comprobanteMovimiento := typ_comprobanteMovimiento;
      v_msj_bitacora    VARCHAR2(400);
      v_nroDocumento    ge_movimientos.nro_documento%TYPE := p_nroDocumento;
      v_monto           ge_movimientos.monto%TYPE := p_monto;
      userInfo          typ_validarSesion;
      v_permiso         typ_obtenerPermisos;
      v_nroCuenta       VARCHAR2(20);
      v_nro_documento3  ge_movimientos.nro_documento3%type := null;
      -- SNP
      v_situacion       varchar2(100);
      v_estado          varchar2(100);
      v_msj_swift       varchar2(1000);
      v_tip_mt          varchar2(20);
      --v_nro_operacion   bw_movimientos.nro_documento%type;
      v_nro_factura     ge_pag_proveedores.nro_factura%TYPE;
      v_ref_factura     ge_pag_proveedores.ref_facturas%TYPE;
      v_tipo         varchar2(4);
      v_cuenta       varchar2(100);
      v_bic          varchar2(100);
      v_banco        varchar2(300);
      v_nombre       varchar2(300);
      

      --detalles del movimiento
      CURSOR detalles(p_nro_documento IN ge_movimientos.nro_documento%TYPE) IS
         SELECT decode(a.cod_tra_padre, v_cod_tra_padre, b.descripcion, c.descripcion) descripcion, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad), decode(a.nro_cuenta, NULL, nvl(a.TIP_MOV_RUBRO, fug_obt_tip_mov_contable(a.cod_modulo, a.cod_modalidad, a.cod_transaccion)), decode(a.cod_modulo, 3, b.tipo, 4, b.tipo, nvl(a.TIP_MOV_RUBRO, fug_obt_tip_mov_contable(a.cod_modulo, a.cod_modalidad, a.cod_transaccion)))) tipo, a.cod_moneda, rownum, a.cod_transaccion, a.cod_banco,
                decode(a.cod_modulo, 5, fut_obt_nro_tarjeta(a.nro_cuenta), a.nro_cuenta) nro_cuenta, a.monto, a.nro_caja, a.concepto, a.cod_ofi_origen, a.hora, cod_oficina, a.cod_modulo cod_modulo, nro_documento3, decode(a.nro_cuenta, NULL, NULL, fug_cta_formateada(a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.nro_cuenta, a.cod_moneda)) cta_formateada, a.cod_modulo modulo, a.cod_modalidad modalidad
           FROM ge_transacciones c, ge_transacciones b, gv_movimientos a
          WHERE /*a.reversado = 'N'
            AND */a.fecha = p_fecha
            AND a.hora = v_hora
            AND a.cod_usuario = v_cod_usuario
            AND a.cod_transaccion = b.cod_transaccion
            AND a.cod_modulo = b.cod_modulo
            AND a.cod_modalidad = b.cod_modalidad
            AND a.estado = 'N'
            AND b.ve_cliente = 'S'
            AND a.nro_secuencia <> v_nro_secuencia --para q no traiga el principal otra vez
            AND (a.nro_cuenta <> v_nro_cuenta OR a.nro_cuenta IS NULL) --para q no traiga otro débito o crédito a la cuenta
            AND a.monto > 0
            AND (a.nro_cuenta = v_nro_cta_mov OR v_nro_cta_mov IS NULL)
            AND a.cod_tra_padre = c.cod_transaccion
            AND a.cod_mod_padre = c.cod_modulo
            AND a.cod_mad_padre = c.cod_modalidad
            AND ((a.cod_modulo <> 4) OR (a.cod_modulo = 4 AND a.cod_modalidad = 41))
            AND ((a.cod_modulo = 6 AND a.cod_modalidad <> 68) OR a.cod_modulo <> 6)
            AND ((v_cod_tra_padre not in (360, 361, 362, 359) and a.nro_documento = p_nro_documento) OR
                 v_cod_tra_padre in (360, 361, 362, 359)
                ) -- para pagos en batch, hay movimientos con misma hora y fecha, se excluyen prestamos
                  -- que no tienen el mismo numero de documento para los movimientos registrados
          ORDER BY nro_secuencia;

      FUNCTION lf_cta_relacionadas(p_nro_Cuenta1 IN VARCHAR2,
                                   p_nro_cuenta2 IN VARCHAR2) RETURN VARCHAR2 IS
         v_sino VARCHAR2(1) := 'N';
      BEGIN
         IF p_nro_cuenta1 = v_nro_cuenta AND v_tip_mov = 'Débito' THEN
            RETURN 'S';
         ELSE
            SELECT 'S'
              INTO v_sino
              FROM ge_cta_clientes a
             WHERE a.nro_cuenta = p_nro_cuenta1
               AND EXISTS (SELECT 0
                      FROM ge_cta_clientes b
                     WHERE b.nro_cuenta = p_nro_cuenta2
                       AND b.cod_persona = a.cod_persona)
               AND rownum = 1;
         END IF;
         RETURN v_sino;
      EXCEPTION
         WHEN OTHERS THEN
            RETURN 'N';
      END;

   BEGIN

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      --Adicionar sanitización
      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parámetros
      v_nroCuenta:=depurarAlfanumerico(p_nroCuenta,CUENTA_TAMANO);
      v_msj_bitacora := substr('nroCuenta: ' || v_nroCuenta
                                             ||', fec: '||to_char(p_fecha, 'dd/mm/yyyy')
                                             ||', tip: '||substr(p_tipo, 1, 1)
                                             ||', doc: '||v_nroDocumento
                                             ||', mto: '||v_monto
                                             ||', sec: '||p_nroSecuencia
                                             ||', fac: '||p_factura,1, 400); --XXX
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);

      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;

      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --identifica si el parámetro es una cuenta o una tarjeta
      IF length(v_nroCuenta) = 16 THEN
         -- es un tarjeta de crédito
         BEGIN
            SELECT nro_cuenta
              INTO v_nro_cuenta
              FROM ta_tarjetas b
             WHERE b.nro_tarjeta = v_nroCuenta;
         EXCEPTION
            WHEN no_data_found THEN
               pr_mensajeUsuario(MSG_OBTCOMPROB_TJ_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'No existe Tarjeta-'||v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, null), BITACORA_ERROR);
               RETURN v_retorno;
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_OBTCOMPROB_TJ_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_msj_bitacora || ', ORA-ERR : [' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
         END;
      ELSE
         v_nro_cuenta := depurarAlfanumerico(v_nroCuenta,15);
      END IF;

      --Valida que la cuenta corresponda al cliente
      IF p_tipo != 'I' THEN -- Transferencia Interbancaria (envia nro. referencia)
         IF lf_val_cta_origen(v_nroCuenta, nvl(userinfo.codigoEmpresa, userinfo.codigopersona)) = 'N' THEN
            pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;

      --recupera el movimiento principal
      BEGIN
         IF p_tipo = 'I' THEN -- Transferencia Interbancaria
            SELECT decode(length(gs.nro_cta_beneficiario),16,'PAGO DE TARJETA OTROS BCOS','TRANSFERENCIA INTERBANCARIA'),
                   null, null, gs.cod_moneda, 1, null, null, gs.usu_insercion, null,
                   decode(length(gs.nro_cta_beneficiario),16,'Pago de Tarjeta Otros Bcos','Transferencia Interbancaria'),
                   gs.cod_oficina, null, gs.cod_oficina, null, gs.nro_cta_solicitante, null, null,
                   FUE_OBT_DES_REFCODES('SITUACION',gs.situacion) Situacion,
                   FUE_OBT_DES_REFCODES('EST_MSJ_SNP',gs.estado) Estado, gs.msj_swift,
                   decode(gs.ind_valor,'S','Alto Valor','Bajo Valor')
              INTO v_des_tra_padre, v_tip_cta, v_tip_mov, v_cod_moneda, v_fila, v_cod_transaccion, v_cod_banco, v_cod_usuario,
                   v_nro_caja, v_concepto, v_ofi_origen, v_hora, v_cod_oficina, v_nro_secuencia, v_cta_formateada, v_cod_tra_padre,
                   v_cod_modulo, v_situacion, v_estado, v_msj_swift, v_tip_mt
              FROM ge_snp_transferencias gs
             WHERE gs.nro_referencia = v_nro_cuenta ;
         ELSE
            SELECT c.descripcion, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad), decode(p_tipo, 'D', 'Débito', 'Crédito'), a.cod_moneda, rownum, a.cod_transaccion, a.cod_banco, cod_usuario, a.nro_caja, a.concepto, a.cod_ofi_origen, a.hora, cod_oficina, nro_secuencia, fug_cta_formateada(a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.nro_cuenta, a.cod_moneda), a.cod_tra_padre, a.cod_modulo, a.cod_modalidad, a.nro_documento3, a.cod_mad_padre
              INTO v_des_tra_padre, v_tip_cta, v_tip_mov, v_cod_moneda, v_fila, v_cod_transaccion, v_cod_banco, v_cod_usuario, v_nro_caja, v_concepto, v_ofi_origen, v_hora, v_cod_oficina, v_nro_secuencia, v_cta_formateada, v_cod_tra_padre, v_cod_modulo, v_cod_modalidad, v_nro_documento3, v_cod_mad_padre
              FROM ge_transacciones c, ge_transacciones b, gv_movimientos a
             WHERE ((a.nro_documento = v_nroDocumento OR v_nroDocumento IS NULL) OR
                    (a.COD_MAD_PADRE = 455 and substr(a.nro_documento,-7) = v_nroDocumento)) -- SNP
               AND (a.nro_secuencia = p_nroSecuencia OR p_nroSecuencia IS NULL)
             --  AND a.reversado = 'N'
               AND a.estado = 'N'
               AND a.nro_cuenta = v_nro_cuenta
               AND a.fecha = p_fecha
               AND a.monto = v_monto
               AND (a.HORA = p_hora or p_hora is null)
               AND fug_obt_tra_tipo(b.cod_transaccion, b.tipo, b.afecta) = p_tipo
               AND a.cod_transaccion = b.cod_transaccion
               AND a.cod_modulo = b.cod_modulo
               AND a.cod_modalidad = b.cod_modalidad
               AND a.cod_tra_padre = c.cod_transaccion
               AND a.cod_mod_padre = c.cod_modulo
               AND a.cod_mad_padre = c.cod_modalidad;
         END IF;
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(MSG_OBTCOMPROB_SIN_COMPROBANTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Sin.Comp- ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         WHEN too_many_rows THEN
            pr_mensajeUsuario(MSG_OBTCOMPROB_MULTIPLES_COMPR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Dup.Comp- ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_OBTCOMPROB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Err.Imp- ' || v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 250) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;
      -- se busca si hay facturas pagadas para pago a proveedores
      IF v_cod_tra_padre in (346, 348) AND p_tipo = 'C' THEN
         BEGIN
             select gpp.nro_factura, gpp.ref_facturas
              into v_nro_factura, v_ref_factura
              from ge_pag_proveedores gpp
             where gpp.cod_ente = v_nro_documento3
               and gpp.fec_pago = p_fecha
               and gpp.nro_cta_credito = v_nro_cuenta
               and gpp.monto = v_monto
               and gpp.referencia = v_nroDocumento;

             --Se toma el valor de NRO_FACTURA pero si es null se retorna REF_FACTURAS
             v_retorno.referenciaFacturas := NVL(v_nro_factura, v_ref_factura);
             if (v_retorno.referenciaFacturas <= 0) then
                --Se verifica si la factura es CERO en cuyo caso se devuelve REF_FACTURAS
                v_retorno.referenciaFacturas := v_ref_factura;
             end if;
         EXCEPTION
            WHEN OTHERS THEN
               NULL;
         END;
      END IF;

      -- se pidio no mostrar detalle de creditos en el comprobante de
      -- pago de sueldos y proveedores
      IF v_cod_tra_padre in (360, 361, 362, 359)
         AND v_cod_transaccion = 503 AND p_tipo = 'D' THEN
         v_nro_cta_mov := NULL; --tomar todos los detalles ya que son de la cuenta
      ELSIF v_cod_tra_padre = 411 THEN
         v_nro_cta_mov := v_nro_cuenta; -- occultar cta. credito puente
      ELSIF TRIM(v_concepto) LIKE 'Imp:%Desp%' THEN
         v_nro_cta_mov := v_nro_cuenta; --son mov de pago de despachos, sólo tomar el de la cuenta
      ELSE
         --busca si hay más movimientos de otras cuentas para el movimiento principal -> son movimientos masivos
         SELECT COUNT(0)
           INTO v_cantidad
           FROM (SELECT DISTINCT nro_cuenta, a.cod_transaccion
                   FROM ge_transacciones b, gv_movimientos a
                 WHERE /*a.reversado = 'N'
                      AND*/ a.fecha = p_fecha
                      AND a.hora = v_hora
                      AND a.cod_usuario = v_cod_usuario
                      AND a.cod_transaccion = b.cod_transaccion
                      AND a.cod_modulo = b.cod_modulo
                      AND a.cod_modalidad = b.cod_modalidad
                      AND a.estado = 'N'
                      AND b.ve_cliente = 'S'
                      AND a.nro_cuenta IS NOT NULL
                      AND a.nro_secuencia <> v_nro_secuencia
                      AND a.monto > 0);
         IF v_cantidad > 2 OR substr(v_cod_usuario,1,3) = 'ATM' OR
            v_cod_tra_padre IN (303, 333, 3303, -- pagos de sueldos
                             346, 348) THEN -- pagos a proveedores
            v_nro_cta_mov := v_nro_cuenta; --son movimientos masivos o por ATM, sólo tomar el de la cuenta
         ELSE
            v_nro_cta_mov := NULL; --tomar todos los detalles ya que son de la cuenta
         END IF;
      END IF;
      IF v_cta_formateada IS NOT NULL THEN
         if p_tipo = 'I' then
            pag_cta.PR_OBT_CUENTA(v_cta_formateada);
         else
            pag_cta.PR_OBT_CUENTA(v_nro_cuenta);
         end if ;

         IF PAG_CTA.FU_OBT_COD_ERROR() <> 0 THEN
            v_error := substr(pag_cta.fu_obt_msj_error(), 1, 250);
            pr_mensajeUsuario(MSG_OBTCOMPROB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_msj_bitacora || ', CTA-ERR : [' || v_error || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;

      v_retorno.descripcionMovimiento := v_des_tra_padre;

      if v_cod_tra_padre=303 then
         if v_cod_transaccion = 196 then
           v_concepto:='CARGO POR TRANS. OTROS BANCOS';
         end if;
         if v_cod_transaccion = 517 then
           v_concepto:='IVA S/COMISIONES TRANS. A OTROS BANCOS';
         end if;
      end if;

      v_retorno.nroCuenta := v_cta_formateada;
      v_retorno.descTipoCuenta := fue_obt_titulo(v_tip_cta);
      v_retorno.denominacion   := pag_cta.FU_OBT_NOM_CUENTA; --XXX

      v_retorno.codMoneda      := v_cod_moneda;
      v_retorno.oficinaDestino := fue_obt_titulo(fue_obt_des_oficina(v_cod_oficina));
      v_retorno.fecha          := lf_for_date(p_fecha);
      v_retorno.hora           := v_hora;
      v_retorno.oficinaOrigen  := fue_obt_des_oficina(v_ofi_origen); ---XXX oficina otra vez?
      v_retorno.monto          := p_monto;
      v_retorno.concepto       := v_concepto;
      v_retorno.codigoBanco    := v_cod_banco;
      v_retorno.nroCaja        := v_nro_caja;
      v_retorno.codigoModulo   := v_cod_modulo;
      v_retorno.codigoModalidad:= v_cod_modalidad;
      
       begin       
                select t.tipo,t.cuenta,t.nombre,t.bic
                into v_tipo,v_cuenta,v_nombre,v_bic 
                from     (   
                        select  decode(tip_operacion,'P','R','E') as tipo ,
                                decode(tip_operacion,'P',nro_cta_origen,g.nro_cta_receptor) as cuenta ,
                                decode(tip_operacion,'P',nom_cli_origen,nom_cli_receptor) as nombre ,
                                decode(tip_operacion,'P',bic_origen,g.bic_receptor) as bic 
                        from ge_spi_transferencias g
                        where nro_referencia=v_nroDocumento
                        union all  
                        select  decode(cod_swi_pte_solicitante,'BBVAPYPA','E','R') as tipo ,
                                decode(cod_swi_pte_solicitante,'BBVAPYPA',t.nro_cta_beneficiario,t.nro_cta_solicitante) as cuenta ,
                                decode(cod_swi_pte_solicitante,'BBVAPYPA',t.nom_beneficiario,t.nom_solicitante)as nombre,
                                decode(cod_swi_pte_solicitante,'BBVAPYPA',t.cod_swi_pte_beneficiario,t.cod_swi_pte_solicitante) as bic
                        from ge_snp_transferencias t
                        where nro_referencia=v_nroDocumento ) t;
         exception when no_data_found then
               v_tipo:='N';
               v_banco:='N';
               v_nombre:='N';
               v_cuenta:='N';
         when others then   
               v_tipo:='N';
               v_banco:='N';
               v_nombre:='N';
               v_cuenta:='N';   
         end;                

       begin
            SELECT participante
            into v_banco
            FROM gv_snp_participantes g
            WHERE g.cod_swift=v_bic;
       exception when no_data_found then
             v_banco:='N';
       when others then
              v_banco:='N';
       end;

      v_retorno.tipoDetalle   := v_tipo;
      v_retorno.bancoDetalle  := v_banco;
      v_retorno.nombreDetalle := v_nombre;
      v_retorno.cuentaDetalle := v_cuenta;
      
      --detalles del movimiento
      v_retorno.cantDetalles       := 0;
      v_retorno.detallesMovimiento := typ_listaComprobanteDetalleMov();
      IF v_cod_tra_padre IN (360, 361, 362, 359) THEN
        v_retorno.codigoDato1:='CUOTA';

      END IF;
      FOR reg IN detalles(v_nroDocumento) LOOP
         DECLARE
            v_detalleMovimiento typ_comprobanteDetalleMov := typ_comprobanteDEtalleMov;
         BEGIN
            IF lf_cta_relacionadas(v_nro_cuenta, reg.nro_cuenta) = 'S' THEN

               v_retorno.cantDetalles          := v_retorno.cantDetalles + 1;
               v_detalleMovimiento.descripcion := fue_obt_titulo(reg.descripcion);
               IF reg.cod_modulo = 5 THEN
                  --tarjeta
                  v_detalleMovimiento.cuenta := fut_for_tarjeta(reg.nro_cuenta);
               ELSE
                  v_detalleMovimiento.cuenta := reg.cta_formateada;
               END IF;

               IF v_cod_tra_padre IN (360, 361, 362, 359) THEN
                  --préstamos
                  v_detalleMovimiento.nroDocumento := reg.nro_documento3;
                  v_retorno.dato1:=reg.nro_documento3;
               END IF;
               v_detalleMovimiento.codMoneda := reg.cod_moneda;
               v_detalleMovimiento.monto := reg.monto;
               v_retorno.detallesMovimiento.extend;
               v_retorno.detallesMovimiento(v_retorno.detallesMovimiento.count) := v_detalleMovimiento;
            END IF;
         END;
      END LOOP;
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_OBTCOMPROB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Err.GEN- ' || v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 250) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerOficinas RETURN typ_informacionOficinas IS

      v_listaOficinas typ_listaOficinas := typ_listaOficinas();
      v_retorno       typ_informacionOficinas := typ_informacionOficinas;
      v_can_detalles  NUMBER(3) := 0; -- cantidad de oficinas
      COD_OPERACION   VARCHAR2(3) := '223';
      codCanal        VARCHAR2(3) := '999';
      CURSOR agencias IS
         SELECT cod_oficina, REPLACE(descripcion, 'Ñ', 'N') descripcion
           FROM ba_oficinas
          WHERE estado = 'A'
                AND cod_oficina NOT IN (FUG_OBT_OFI_MATRIZ)
          ORDER BY descripcion; -- no se toma la casa matriz para el bbva

   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      pr_insertarBitacora('0', codCanal, NULL, COD_OPERACION, NULL, 'Obtener Oficinas', BITACORA_ENTRADA);

      FOR ag IN agencias LOOP
         DECLARE
            v_detalleOficina typ_informacionOficina := typ_informacionOficina;
         BEGIN
            v_can_detalles                 := v_can_detalles + 1;
            v_detalleOficina.codigoOficina := ag.cod_oficina;
            v_detalleOficina.descripcion   := ag.descripcion;
            --detalleCuenta.chequeDevuelto  :=  lf_for_char(v_che_devuelto,1);

            v_listaOficinas.extend;
            v_listaOficinas(v_listaOficinas.count) := v_detalleOficina;

         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

               pr_insertarBitacora('0', codCanal, NULL, COD_OPERACION, NULL, 'obtenerOficinas -' || SQLERRM, BITACORA_ERROR);
         END;
      END LOOP;
      IF v_retorno.error = 'N' THEN
         v_retorno.informacionOficinas := v_listaOficinas;
         v_retorno.cantOficinas        := v_can_detalles;
      END IF;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

         pr_insertarBitacora('0', codCanal, NULL, COD_OPERACION, NULL, 'obtenerOficinas -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerChequesDevueltos(p_sesion    IN VARCHAR2,
                                       p_codCanal  IN VARCHAR2,
                                       p_nroCuenta IN VARCHAR2 DEFAULT NULL) RETURN typ_ChequesDevueltos IS
      MSG_OBTCHEQDEV_CTA_INEXISTENTE CONSTANT VARCHAR2(15) := 'OBTCTADET_CTAIX';
      COD_OPERACION                  CONSTANT VARCHAR2(3) := '040';
      v_ver_todas          VARCHAR2(1);
      v_nro_cta_especifica VARCHAR2(16);
      v_can_detalles       NUMBER(3); -- cantidad de cuentas
      v_can_movimientos    NUMBER(5);
      v_fec_actual         DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
      --Jalvaren 18/Mayo/2012
      v_logMessage VARCHAR2(1000);
      userInfo     typ_validarSesion;
      v_permiso    typ_obtenerPermisos;
      v_retorno    typ_chequesDevueltos := typ_chequesDevueltos;
      v_nroCuenta  VARCHAR(16);
      -- cursor de cuentas pasivas del cliente
      CURSOR cuentas IS
         SELECT a.nro_cuenta, a.cod_modalidad cod_modalidad, fug_cta_formateada(a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.nro_cuenta, a.cod_moneda) cta_formateada, paw_bce.fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) des_tip_cuenta, a.cod_moneda cod_moneda, a.denominacion nom_cuenta, paw_bce.fu_obt_sal_actual(a.cod_modulo, a.cod_modalidad, a.nro_cuenta) sal_actual, a.cod_modulo
           FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
          WHERE a.nro_cuenta = b.nro_cuenta
            AND b.relacion IN ('O', 'P', 'Y')
            AND b.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
            AND a.cod_modulo = c.cod_modulo
            AND a.cod_modalidad = c.cod_modalidad
            AND a.estado = c.estado
            AND c.activo = 'S' -- solo cuentas activas
            AND a.estado <> 'X' -- pendiente de verificacion
            AND b.cod_modalidad IN (31, 41, 334)
            AND (v_ver_todas = 'S' OR b.nro_cuenta = v_nro_cta_especifica); -- solo ve la cuenta recibida o todas
      -- movimientos de cheques devueltos de camara y del exterior depositados en cuenta
      CURSOR movimientos(p_nro_cuenta IN VARCHAR2) IS
         SELECT b.descripcion des_banco, a.nro_documento nro_cheque, a.monto monto, c.descripcion des_causa, a.fecha
           FROM ge_causales c, ge_bancos b, gv_movimientos a
          WHERE a.nro_cuenta = p_nro_cuenta
            AND a.cod_mod_padre = 4
            AND a.cod_mad_padre = 41
            AND a.cod_tra_padre = 321
            AND a.cod_transaccion IN (522, 503, 182)
            AND a.reversado = 'N'
            AND a.estado = 'N'
            AND a.cod_banco = b.cod_banco
            AND a.cod_causa = c.cod_causa
            AND a.fecha >= v_fec_actual - 30
          ORDER BY a.fecha DESC;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      IF (p_nroCuenta IS NULL) THEN
         v_ver_todas := 'S';
      ELSE
         v_ver_todas := 'N';
      END IF;
      v_nroCuenta:=depurarAlfanumerico(p_nroCuenta,CUENTA_TAMANO);
      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parámetros
      v_logMessage := 'nroCuenta=' || v_nroCuenta;
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
       v_nro_cta_especifica := depurarAlfanumerico(p_nroCuenta, 16);
      -- 2. busco los datos de la cuentas
      v_can_detalles                  := 0;
      v_retorno.listaChequesDevueltos := typ_listaChequesDevueltos();
      FOR ct IN cuentas LOOP
         --- Debe controlar para que no muestre cuentas juridicas entre las cuentas del cliente
         IF PAW_UTI.fu_es_juridica(ct.nro_cuenta, userInfo.codigoEmpresa, userInfo.codigoPersona) = 'N' THEN
            v_can_detalles    := v_can_detalles + 1;
            v_can_movimientos := 0;

            FOR mv IN movimientos(ct.nro_cuenta) LOOP
               DECLARE
                  v_movimiento typ_chequeDevuelto := typ_chequeDEvuelto;
               BEGIN
                  v_can_movimientos             := v_can_movimientos + 1;
                  v_movimiento.nroCuenta        := ct.nro_cuenta;
                  v_movimiento.banco            := substr(mv.des_banco,0, 35);
                  v_movimiento.nroCheque        := mv.nro_cheque;
                  v_movimiento.importe          := mv.monto;
                  v_movimiento.motivoDevolucion := substr(mv.des_causa,0, 35);
                  v_movimiento.fecha            := mv.fecha;

                  v_retorno.listaChequesDevueltos.extend;
                  v_retorno.listaChequesDevueltos(v_retorno.listaChequesDevueltos.count) := v_movimiento;
               END;
            END LOOP;
         END IF;
      END LOOP;

      IF v_can_detalles = 0 THEN
         -- no tiene detalles
         pr_mensajeUsuario(MSG_OBTCHEQDEV_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      v_retorno.cantChequesDevueltos := v_can_movimientos;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ', ORA-ERR:['|| substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerDepositosConfirmar(p_sesion    IN VARCHAR2,
                                         p_codCanal  IN VARCHAR2,
                                         p_nroCuenta IN VARCHAR2 DEFAULT NULL) RETURN typ_depositosConfirmar IS

      COD_OPERACION                CONSTANT VARCHAR2(3) := '041';
      MSG_CTA_NO_CORRESP           CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';
      MSG_SINDATOS                 CONSTANT VARCHAR2(15) := 'G_SIN_DATOS';
      -- datos recibidos
      v_ver_todas          VARCHAR2(1);
      v_nro_cta_especifica VARCHAR2(16);
      -- datos a responder
      v_can_detalles NUMBER(3); -- cantidad de cuentas
      -- variables
      --v_can_movimientos number(5);
      userInfo     typ_validarSesion;
      v_permiso    typ_obtenerPermisos;
      v_retorno    typ_depositosConfirmar := typ_depositosConfirmar;
      v_logMessage VARCHAR2(1000);

      -- cursor de cuentas pasivas del cliente
      CURSOR cuentas IS
         SELECT a.nro_cuenta, a.cod_modalidad cod_modalidad, fug_cta_formateada(a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.nro_cuenta, a.cod_moneda) cta_formateada, paw_bce.fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) des_tip_cuenta, a.cod_moneda cod_moneda, a.denominacion nom_cuenta, a.cod_modulo
           FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
          WHERE a.nro_cuenta = b.nro_cuenta
            AND b.relacion IN ('O', 'P', 'Y')
            AND b.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
            AND a.cod_modulo = c.cod_modulo
            AND a.cod_modalidad = c.cod_modalidad
            AND a.estado = c.estado
            AND c.activo = 'S' -- solo cuentas activas
            AND a.estado <> 'X' -- pendiente de verificacion
            AND b.cod_modalidad IN (31, 41, 334)
            AND (v_ver_todas = 'S' OR b.nro_cuenta = v_nro_cta_especifica); -- solo ve la cuenta recibida o todas
      -- movimientos de depositos a cofirmar por cuenta
      CURSOR movimientos(p_nro_cuenta IN VARCHAR2) IS
         SELECT nro_documento, monto, fec_inicio, fec_final
           FROM ah_retenciones
          WHERE nro_cuenta = p_nro_cuenta
            AND liberado = 'N'

          ORDER BY fec_inicio, fec_final;

   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      IF p_nroCuenta IS NULL THEN
         v_ver_todas := 'S';
      ELSE
         v_ver_todas := 'N';
      END IF;
      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parámetros
      v_logMessage := 'nroCuenta=' || p_nroCuenta;
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);

      IF (userInfo.error = 'S') THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 0. Armo el nro de cuenta
      v_nro_cta_especifica := depurarAlfanumerico(p_nroCuenta,CUENTA_TAMANO);

      --Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(v_nro_cta_especifica, nvl(userinfo.codigoEmpresa, userinfo.codigopersona)) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userinfo.codigoEmpresa, v_logMessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 2. busco los datos de la cuentas

      v_can_detalles                    := 0;
      v_retorno.listaDepositosConfirmar := typ_listaDepositosConfirmar();
      FOR ct IN cuentas LOOP
         --- Debe controlar para que no muestre cuentas juridicas entre las cuentas del cliente
         IF PAW_UTI.fu_es_juridica(ct.nro_cuenta, userInfo.codigoEmpresa, userInfo.codigoPersona) = 'N' THEN
            FOR mv IN movimientos(ct.nro_cuenta) LOOP
               DECLARE
                  v_deposito typ_depositoConfirmar := typ_depositoConfirmar;
               BEGIN
                  v_can_detalles            := v_can_detalles + 1;
                  v_deposito.nroCuenta      := ct.cta_formateada;
                  v_deposito.nroBoleta      := mv.nro_documento;
                  v_deposito.importe        := lf_for_money(mv.monto);
                  v_deposito.fechaDeposito  := lf_for_date(mv.fec_inicio);
                  v_deposito.fechaConfirmar := lf_for_date(mv.fec_final);
                  v_retorno.listaDepositosConfirmar.extend;
                  v_retorno.listaDepositosConfirmar(v_retorno.listaDepositosConfirmar.count) := v_deposito;
               END;
            END LOOP;
         END IF;
      END LOOP;

      v_retorno.cantDepositosConfirmar := v_can_detalles;
      IF v_can_detalles = 0 THEN
         -- no tiene detalles
         pr_mensajeUsuario(MSG_SINDATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END IF;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerChequeras(p_sesion    IN VARCHAR2,
                                p_codCanal  IN VARCHAR2,
                                p_nroCuenta IN VARCHAR2) RETURN typ_detallesChequeras IS

      COD_OPERACION                CONSTANT VARCHAR2(3) := '061';
      MSG_OBTCHEQUERA_CTA_INVALIDA CONSTANT VARCHAR2(15) := 'OBTCHEQ_CTAINV';
      MSG_SINDATOS                 CONSTANT VARCHAR2(15) := 'G_SIN_DATOS';
      MSG_CTA_NO_CORRESP           CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';

      v_nro_cta_especifica VARCHAR2(16) := depurarAlfanumerico(p_nroCuenta, 16);
      --
      v_cod_moneda     cc_cta_corrientes.cod_moneda%TYPE;
      v_des_cuenta     cc_cta_corrientes.denominacion%TYPE;
      v_tip_cuenta     ge_modalidades.descripcion%TYPE;
      v_cta_formateada VARCHAR2(17);
      -- tipos de chequeras
      CURSOR c_tip_cheq IS
         SELECT t.cod_tip_chequera, c.nro_che_inicial, c.nro_che_final, c.fec_solicitud, decode(c.nro_che_inicial, c.nro_che_final, 'CHEQUE VENTANILLA', t.descripcion) tipo, fue_obt_des_refcodes('EST_CHEQUE', c.estado) estado, c.est_cheques, c.can_cheques
           FROM cc_tip_chequeras t, cc_chequeras c
          WHERE t.cod_tip_chequera = c.tipo
            AND nro_cuenta = v_nro_cta_especifica
          ORDER BY fec_solicitud DESC;

      --Jalvaren 17/Mayo/2012
      v_retorno           typ_detallesChequeras := typ_detallesChequeras;
      userInfo            typ_validarSesion;
      v_permiso           typ_obtenerPermisos;
      v_detallesChequeras typ_listaDetalleChequeras := typ_listaDetalleChequeras();
      v_chequera          typ_DetalleChequera := typ_detalleChequera;
      v_cantidad          NUMBER(3) := 0;
      v_logmessage        VARCHAR2(1000) := 'nro_cta:' || v_nro_cta_especifica;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      --Adicionar sanitización

      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logeo de Parametros
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

      IF (userInfo.error = 'S') THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logmessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      v_nro_cta_especifica := depurarAlfanumerico(p_nroCuenta,CUENTA_TAMANO);
      --Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(p_nroCuenta, nvl(userinfo.codigoEmpresa, userinfo.codigopersona)) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userinfo.codigoEmpresa, v_logmessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 2. busco los datos de la cuentas
      BEGIN
         SELECT fug_cta_formateada(cod_modulo, cod_modalidad, cod_oficina, nro_cuenta, cod_moneda), cod_moneda, denominacion, fug_obt_des_modal(cod_modulo, cod_modalidad)
           INTO v_cta_formateada, v_cod_moneda, v_des_cuenta, v_tip_cuenta
           FROM cc_cta_corrientes
          WHERE nro_cuenta = v_nro_cta_especifica
            AND estado = 'N';
      EXCEPTION
         WHEN OTHERS THEN
            --retValue.codRespuesta := paw_bce.v_cod_can_invalida;
            pr_mensajeUsuario(MSG_OBTCHEQUERA_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logmessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      FOR r1 IN c_tip_cheq LOOP
         v_chequera.inicio             := substr(r1.nro_che_inicial,0, 7);
         v_chequera.fin                := substr(r1.nro_che_final,0, 7);
         v_chequera.solicitud          := lf_for_date(r1.fec_solicitud);
         v_chequera.tipo               := substr(r1.tipo,0, 20);
         v_chequera.estado             := substr(r1.estado,0, 20);
         v_chequera.codigoTipoChequera := substr(r1.cod_tip_chequera, 1, 1);

         v_detallesChequeras.extend;
         v_detallesChequeras(v_detallesChequeras.count) := v_chequera;
         v_cantidad := v_cantidad + 1;
      END LOOP;

      v_retorno.listaDetalleChequera := v_detallesChequeras;
      v_retorno.cantChequeras        := v_cantidad;

      IF (v_cantidad = 0) THEN
         pr_mensajeUsuario(MSG_SINDATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logmessage || ' ' ||  fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END IF;
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logmessage || ' ' ||  fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logmessage || ', ORA-ERR:['||substr(SQLERRM, 1, 200)|| '] ' ||  fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerCheque(p_sesion    IN VARCHAR2,
                             p_codCanal  IN VARCHAR2,
                             p_nroCuenta IN VARCHAR2,
                             p_nroCheque IN VARCHAR2) RETURN typ_detalleCheque IS
      --
      MSG_OBTCHEQ_CTA_INEXISTENTE CONSTANT VARCHAR2(15) := 'OBTCHEQ_CTAIX';
      MSG_CTA_NO_CORRESP          CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';
      COD_OPERACION               CONSTANT VARCHAR2(3) := '062';
      v_nro_cta_especifica VARCHAR2(16); -- cuenta especifica a consultar
      v_nro_cheque         cc_chequeras.nro_che_inicial%TYPE ;
      v_nro_inicial        cc_chequeras.nro_che_final%TYPE;
      v_fec_solicitud      DATE;
      v_tip_chequera       cc_tip_chequeras.descripcion%TYPE;
      v_estado             ba_cod_referencias.significado%TYPE;
      v_est_cheques        cc_chequeras.est_cheques%TYPE;
      v_can_cheques        cc_chequeras.can_cheques%TYPE;
      ---
      v_posicion NUMBER(5);
      v_pos      VARCHAR2(1);
      --- Variables
      v_fecha             DATE;
      v_hora              VARCHAR2(8);
      v_oficina           VARCHAR2(35);
      v_tipo_pago         VARCHAR2(35);
      v_cod_moneda        VARCHAR2(3);
      v_importe           NUMBER(18, 2);
      v_beneficiario      VARCHAR2(35);
      v_causa             VARCHAR2(35);
      v_fec_certificacion DATE;
      -- tipos de chequeras
      --Jalvaren 16/Mayo/2012
      userInfo     typ_validarSesion;
      v_permiso    typ_obtenerPermisos;
      v_retorno    typ_detalleCheque := typ_detalleCheque;
      v_logMessage VARCHAR2(1000);
   BEGIN

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- 1. valido la clave del cliente
      userinfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parámetros
      v_logMessage := substr('ObtenerCheque(nroCuenta=' || p_nroCuenta || ',nro_cheque=' || p_nroCheque || ')',0,1000);
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

      IF (userInfo.error = 'S') THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, '061');
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      v_nro_cta_especifica := depurarAlfanumerico(p_nroCuenta,CUENTA_TAMANO);
      v_nro_cheque:=depurarAlfanumerico(p_nroCheque, 15);
      --Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(p_nroCuenta, nvl(userinfo.codigoEmpresa, userinfo.codigopersona)) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, userinfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), NULL);
         RETURN v_retorno;
      END IF;

      -- 2. busco los datos de la cuentas
      BEGIN
         SELECT cc_chequeras.fec_solicitud, cc_chequeras.hor_solicitud, cc_tip_chequeras.descripcion tipo, cc_chequeras.est_cheques, cc_chequeras.can_cheques, cc_chequeras.nro_che_inicial, cc_cta_corrientes.cod_moneda
           INTO v_fec_solicitud, v_hora, v_tip_chequera, v_est_cheques, v_can_cheques, v_nro_inicial, v_cod_moneda
           FROM cc_cta_corrientes, cc_tip_chequeras, cc_chequeras
          WHERE cc_cta_corrientes.nro_cuenta = cc_chequeras.nro_cuenta
            AND cc_tip_chequeras.cod_tip_chequera = cc_chequeras.tipo
            AND cc_chequeras.nro_cuenta = v_nro_cta_especifica
            AND cc_chequeras.nro_che_inicial <= v_nro_cheque
            AND cc_chequeras.nro_che_final >= v_nro_cheque
            AND cc_chequeras.fec_solicitud = (SELECT MAX(t.fec_solicitud)
                                                FROM cc_chequeras t
                                               WHERE t.nro_cuenta = v_nro_cta_especifica
                                                 AND t.nro_che_inicial <= v_nro_cheque
                                                 AND t.nro_che_final >= v_nro_cheque );
         v_importe := NULL;
      EXCEPTION
         WHEN NO_DATA_FOUND THEN
            --v_cod_respuesta := paw_bce.v_cod_cta_inexistente;
            pr_mensajeUsuario(MSG_OBTCHEQ_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Cuenta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      v_posicion := v_nro_cheque - v_nro_inicial + 1;
      IF v_est_cheques IS NOT NULL THEN
         v_pos    := substr(v_est_cheques, v_posicion, 1);
         v_estado := fue_obt_des_refcodes('EST_CHEQUE', v_pos);
      END IF;
      IF v_pos = 'P' THEN
         -- Si el cheque esta pagado
         BEGIN
            SELECT fecha, hora, substr(fue_obt_des_oficina(cod_ofi_origen), 1, 35), monto, cod_moneda, substr(ge_causales.descripcion, 1, 35), substr(fug_obt_des_transaccion(cod_modulo, cod_modalidad, cod_transaccion), 1, 35)
              INTO v_fecha, v_hora, v_oficina, v_importe, v_cod_moneda, v_causa, v_tipo_pago
              FROM ge_causales, cc_che_pagados
             WHERE ge_causales.cod_causa(+) = cc_che_pagados.cod_cau_devolucion
               AND ge_causales.tipo(+) = 'D'
               AND nro_cheque = v_nro_cheque
               AND nro_cuenta = v_nro_cta_especifica
               AND cod_cau_devolucion is null;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               NULL;
         END;
      ELSIF v_pos = 'O' THEN
         -- Si el cheque tiene ONP.
         BEGIN
            SELECT fecha, hora, monto, cc_cta_corrientes.cod_moneda, substr(ge_causales.descripcion, 1, 35), substr(beneficiario, 1, 35)
              INTO v_fecha, v_hora, v_importe, v_cod_moneda, v_causa, v_beneficiario
              FROM cc_cta_corrientes, ge_causales, cc_che_ord_no_pagos
             WHERE cc_cta_corrientes.nro_cuenta = v_nro_cta_especifica
               AND cc_cta_corrientes.nro_cuenta = cc_che_ord_no_pagos.nro_cuenta
               AND ge_causales.cod_causa(+) = cc_che_ord_no_pagos.cod_causa
               AND ge_causales.tipo(+) = 'O'
               AND nro_cheque = v_nro_cheque
               AND cc_che_ord_no_pagos.nro_cuenta = v_nro_cta_especifica;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               NULL;
         END;
      ELSIF v_pos = 'C' THEN
         -- Si el cheque esta certificado.
         BEGIN
            SELECT fecha, monto, cc_cta_corrientes.cod_moneda, substr(ge_causales.descripcion, 1, 35), substr(beneficiario, 1, 35), fec_pago
              INTO v_fec_certificacion, v_importe, v_cod_moneda, v_causa, v_beneficiario, v_fecha
              FROM cc_cta_corrientes, ge_causales, cc_che_certificados
             WHERE cc_cta_corrientes.nro_cuenta = v_nro_cta_especifica
               AND cc_cta_corrientes.nro_cuenta = cc_che_certificados.nro_cuenta
               AND ge_causales.cod_causa(+) = cc_che_certificados.cod_cau_devolucion
               AND ge_causales.tipo(+) = 'D'
               AND nro_cheque = v_nro_cheque
               AND cc_che_certificados.nro_cuenta = v_nro_cta_especifica;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               NULL;
         END;
      ELSIF v_pos = 'G' THEN
         -- Si es un cheque Gerencia.
         BEGIN
            SELECT fecha, monto, cc_cta_corrientes.cod_moneda, substr(beneficiario, 1, 35), fec_pago, substr(fug_obt_des_transaccion(cc_che_ger_emitidos.cod_modulo, cc_che_ger_emitidos.cod_modalidad, cc_che_ger_emitidos.cod_transaccion), 1, 35)
              INTO v_fec_certificacion, v_importe, v_cod_moneda, v_beneficiario, v_fecha, v_tipo_pago
              FROM cc_cta_corrientes, cc_che_ger_emitidos
             WHERE cc_cta_corrientes.nro_cuenta = v_nro_cta_especifica
               AND cc_cta_corrientes.nro_cuenta = cc_che_ger_emitidos.nro_cuenta
               AND nro_cheque = v_nro_cheque
               AND cc_che_ger_emitidos.nro_cuenta = v_nro_cta_especifica;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               NULL;
         END;
      ELSIF v_pos = 'S' THEN
         -- Si es un cheque solicitado
         v_fecha := v_fec_solicitud;
      ELSIF v_pos = 'E' THEN
         -- Si es un cheque entregado.
         NULL; --no se hace nada
      ELSIF v_pos = 'A' THEN
         -- Si es un cheque Anulado
         BEGIN
            SELECT fecha, hora, cc_cta_corrientes.cod_moneda, substr(ge_causales.descripcion, 1, 35)
              INTO v_fecha, v_hora, v_cod_moneda, v_causa
              FROM cc_cta_corrientes, ge_causales, cc_che_anulados
             WHERE cc_cta_corrientes.nro_cuenta = v_nro_cta_especifica
               AND cc_cta_corrientes.nro_cuenta = cc_che_anulados.nro_cuenta
               AND ge_causales.cod_causa(+) = cc_che_anulados.cod_causa
               AND ge_causales.tipo(+) = 'A'
               AND nro_cheque = v_nro_cheque
               AND cc_che_anulados.nro_cuenta = v_nro_cta_especifica;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               NULL;
         END;
      END IF;

      ---
      v_retorno.fecha                  := lf_for_date(v_fecha);
      v_retorno.estado                 := substr(v_estado,0, 20);
      v_retorno.hora                   := substr(v_hora,0, 8);
      v_retorno.nombreSucursal         := substr(v_oficina,0, 35);
      v_retorno.descripcionTransaccion := substr(v_tipo_pago,0, 35);
      v_retorno.moneda                 := substr(v_cod_moneda,0, 3);
      v_retorno.monto                  := lf_for_money(nvl(v_importe,0));
      v_retorno.beneficiario           := substr(v_beneficiario,0, 35);
      v_retorno.causaBloqueo           := substr(v_causa,0, 35);
      v_retorno.fechaPago              := lf_for_date(v_fec_certificacion);

      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(NULL, p_codCanal, NULL, COD_OPERACION, NULL, 'obtCheque -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtDetallesChequesChequera(p_sesion           IN VARCHAR2,
                                          p_codCanal         IN VARCHAR2,
                                          p_nroCuenta        IN VARCHAR2,
                                          p_nroChequeInicial IN NUMBER,
                                          p_tipo             IN VARCHAR2) RETURN typ_Chequera IS

      COD_OPERACION         CONSTANT VARCHAR2(3) := '064';
      MSG_OBTDETCHEQ_SINMOV CONSTANT VARCHAR2(15) := 'OBTDETCHEQ_SMOV';
      MSG_OBTDETCHEQ_NOEX   CONSTANT VARCHAR2(15) := 'OBTDETCHEQ_NOEX';
      MSG_CTA_NO_CORRESP    CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';

      v_nro_inicial cc_chequeras.nro_che_inicial%TYPE := p_nroChequeInicial;
      v_nro_final   cc_chequeras.nro_che_final%TYPE;
      v_tipo        cc_chequeras.tipo%TYPE := substr(p_tipo, 1, 1);
      --
      v_tip_chequera       cc_tip_chequeras.descripcion%TYPE;
      v_estado             ba_cod_referencias.significado%TYPE;
      v_est_cheques        cc_chequeras.est_cheques%TYPE;
      v_can_cheques        cc_chequeras.can_cheques%TYPE;
      v_nro_cta_especifica VARCHAR2(16) := depurarAlfanumerico(p_nroCuenta, 16);
      v_fec_solicitud      DATE;
      v_pos                VARCHAR2(1);
      -- tipos de chequeras
      v_retorno    typ_chequera := typ_chequera;
      userInfo     typ_validarSesion;
      v_permiso    typ_obtenerPermisos;
      v_logMessage VARCHAR2(500) := 'nroCta: '||v_nro_cta_especifica||', nroIni:'||v_nro_inicial||', tip:'||v_tipo;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

      IF (userInfo.error = 'S') THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, '061');
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      --Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(v_nro_cta_especifica, nvl(userinfo.codigoEmpresa, userinfo.codigopersona)) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userinfo.codigoEmpresa, v_logMessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 2. busco los datos de la cuentas
      BEGIN
         SELECT c.nro_che_final, c.fec_solicitud, t.descripcion tipo, fue_obt_des_refcodes('EST_CHEQUE', c.estado) estado, c.est_cheques, c.can_cheques
           INTO v_nro_final, v_fec_solicitud, v_tip_chequera, v_estado, v_est_cheques, v_can_cheques
           FROM cc_tip_chequeras t, cc_chequeras c
          WHERE t.cod_tip_chequera = c.tipo
            AND nro_cuenta = v_nro_cta_especifica
            AND nro_che_inicial = v_nro_inicial
            AND c.tipo = v_tipo;
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(MSG_OBTDETCHEQ_NOEX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      v_retorno.solicitados  := 0;
      v_retorno.entregados   := 0;
      v_retorno.pagados      := 0;
      v_retorno.anulados     := 0;
      v_retorno.ordenNoPago  := 0;
      v_retorno.certificados := 0;

      IF v_can_cheques = 0 THEN
         --v_cod_respuesta := paw_bce.v_cod_cta_sin_mov;
         pr_mensajeUsuario(MSG_OBTDETCHEQ_SINMOV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      FOR i IN 1 .. v_can_cheques LOOP
         v_pos := substr(v_est_cheques, i, 1);
         IF v_pos = 'S' THEN
            v_retorno.solicitados := v_retorno.solicitados + 1;
         ELSIF v_pos = 'E' THEN
            v_retorno.entregados := v_retorno.entregados + 1;
         ELSIF v_pos = 'P' THEN
            v_retorno.pagados := v_retorno.pagados + 1;
         ELSIF v_pos = 'A' THEN
            v_retorno.anulados := v_retorno.anulados + 1;
         ELSIF v_pos = 'O' THEN
            v_retorno.ordenNoPago := v_retorno.ordenNoPago + 1;
         ELSIF v_pos = 'C' THEN
            v_retorno.certificados := v_retorno.certificados + 1;
         END IF;
      END LOOP;
      -- registro del movimiento
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage || 'ORA-ERR[' || substr(SQLERRM, 1, 250) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

  /*
  Obtiene el total de límite máximo operativo por mensaje

  Mensajes de respuesta
  TK : armado de respuesta
  ------------------------
  00 : el cliente puede operar libremente
  01 : al cliente se le pide SOLO TOKEN
  10 : al cliente se le pide SOLO Clave Transaccional
  11 : al cliente se le pide Clave Transaccional + TOKEN
  -1 : no posee autorización
  -2 : Error : no definido

  OBS: se espera que p_nro_cuenta sea una cuenta asociada a p_cod_persona
       y a cod_moneda, para no sobrecargar con controles, que ya se deberían
       de realizar antes de llamar a la función
  */
  FUNCTION fu_obtenerLimite(p_usuario                IN typ_validarSesion,
                            p_codigoTipoMensaje      IN VARCHAR2,
                            p_codigoPersona          IN VARCHAR2,
                            p_numeroCuenta           IN VARCHAR2,
                            p_codigoMoneda           IN VARCHAR2,
                            p_codigoTransaccion      IN NUMBER,
                            p_codigoTransaccionPadre IN NUMBER,
                            p_monto                  IN NUMBER,
                            p_modo                   IN VARCHAR2,
                            p_codigoEnte             IN NUMBER DEFAULT NULL,
                            p_sesion                 IN VARCHAR2 DEFAULT NULL,
                            p_numeroIp               IN VARCHAR2 DEFAULT NULL,
                            p_cantidad               IN NUMBER DEFAULT 1) RETURN typ_respuestaLimite IS
     v_resLimite         typ_respuestaLimite;
     COD_CTA_INEXISTENTE CONSTANT VARCHAR2(15) := 'G_NROCTAINVALID';
     COD_LIM_EXCEDIDO    CONSTANT VARCHAR2(15) := 'G_COD_LIM_EXCED';
     COD_LIM_INDEFINIDO  CONSTANT VARCHAR2(15) := 'G_COD_LIM_INDEF';
     COD_LIM_CAN_EXCED   CONSTANT VARCHAR2(15) := 'G_LIM_CAN_EXCED';
     COD_LIM_CAN_INDEF   CONSTANT VARCHAR2(15) := 'G_LIM_CAN_INDEF';
     CLA_OTP_INEXISTENTE CONSTANT VARCHAR2(15) := 'G_COD_TOK_INEXI';
     ERR_CON_VASCO       CONSTANT VARCHAR2(15) := 'G_COD_ERR_VASCO';
     ERR_TOK_INVALIDO    CONSTANT VARCHAR2(15) := 'G_ERR_TOK_INVAL';
     COD_TOK_INE_VASCO   CONSTANT VARCHAR2(15) := 'G_TOK_INE_VASCO';
     OPE_NO_PERMITIDA    CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
     ERR_CON_SOCKET      CONSTANT VARCHAR2(15) := 'G_ERR_SOC_VASCO';
     ERR_LIM_OPERACION   CONSTANT VARCHAR2(15) := 'G_ERR_LIM_OPERA';
     MSG_CLA_NO_TIENE    CONSTANT VARCHAR2(15) := 'CLA_OPE_N_TIENE';
     COD_PJ_SIN_CLA_OTP  CONSTANT VARCHAR2(15) := 'G_COD_TOK_IN_PJ';
   BEGIN
     paw_bce.v_cod_respuesta   := paw_bce.v_cod_aprobado;
     paw_bce.v_cod_persona     := p_usuario.codigoPersona;
     paw_bce.v_cod_per_empresa := p_usuario.codigoEmpresa;
     v_resLimite.codRespuesta  := paw_bce.fu_obt_limite(p_codigoTipoMensaje,
                                        p_usuario.codigoPersona, --p_codigoPersona,
                                        p_numeroCuenta,
                                        p_codigoMoneda,
                                        p_codigoTransaccion,
                                        p_codigoTransaccionPadre,
                                        p_monto,
                                        p_modo,
                                        p_codigoEnte,
                                        p_sesion,
                                        p_numeroIp,
                                        p_cantidad,
                                        p_usuario.codigoEmpresa);

     CASE paw_bce.v_cod_respuesta
        WHEN paw_bce.v_cod_aprobado THEN
           pr_mensajeUsuario(MSG_OK, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_cod_cta_inexistente THEN
           pr_mensajeUsuario(COD_CTA_INEXISTENTE, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_can_lim_indefinido THEN
           pr_mensajeUsuario(COD_LIM_CAN_INDEF, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_can_lim_excedido THEN
           pr_mensajeUsuario(COD_LIM_CAN_EXCED, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_cla_lim_excedido THEN
           pr_mensajeUsuario(COD_LIM_EXCEDIDO, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_cla_lim_no_definido THEN
           pr_mensajeUsuario(COD_LIM_INDEFINIDO, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_cod_err_con_vasco THEN
           pr_mensajeUsuario(ERR_CON_VASCO, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_cod_err_con_socket THEN
           pr_mensajeUsuario(ERR_CON_SOCKET, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_tok_invalido THEN
           pr_mensajeUsuario(ERR_TOK_INVALIDO, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_cod_tok_ine_vasco THEN
           pr_mensajeUsuario(COD_TOK_INE_VASCO, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_cla_otp_inexistente THEN
           IF p_usuario.codigoEmpresa is null THEN
              pr_mensajeUsuario(CLA_OTP_INEXISTENTE, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
           ELSE
              pr_mensajeUsuario(COD_PJ_SIN_CLA_OTP, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
           END IF;
        WHEN paw_bce.v_cod_ope_no_permitida THEN
           pr_mensajeUsuario(OPE_NO_PERMITIDA, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        WHEN paw_bce.v_cla_st_inexistente THEN
           pr_mensajeUsuario(MSG_CLA_NO_TIENE, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
        ELSE
           pr_mensajeUsuario(ERR_LIM_OPERACION, v_resLimite.nombreRespuesta, v_resLimite.descripcionRespuesta, v_resLimite.error);
     END CASE;

     RETURN v_resLimite;
  END;

   FUNCTION fu_obtenerCotizacion RETURN typ_detallesCotizacion IS

      COD_OPERACION CONSTANT VARCHAR2(3) := '050';
      v_can_detalles NUMBER(3) := 0; -- cantidad de cuentas
      v_retorno      typ_detallesCotizacion := typ_detallesCotizacion;
      MSG_COT_SINDET CONSTANT VARCHAR2(15) := 'OBTCOT_SINDET';
      CURSOR cotizaciones IS
         SELECT a.cod_moneda cod_moneda, c.descripcion des_moneda, val_compra, val_venta, decode(val_com_electronica, 0, val_compra, val_com_electronica) val_com_electronica, decode(val_ven_electronica, 0, val_venta, val_ven_electronica) val_ven_electronica,decode(val_ven_cheque, 0, val_venta, val_ven_cheque) val_ven_cheque,decode(val_com_cheque, 0, val_venta, val_com_cheque) val_com_cheque, val_conversion
           FROM ba_monedas c, ge_cotizaciones a
          WHERE a.cod_moneda IN ('USD', 'EUR') --,'BRL','ARS')
            AND a.cod_moneda = c.cod_moneda
            AND fecha = (SELECT MAX(fecha)
                           FROM ge_cotizaciones b
                          WHERE b.cod_moneda = a.cod_moneda)
          ORDER BY decode(a.cod_moneda, 'USD', 1, 'EUR', 2); --,'BRL',3,'ARS',4);

   BEGIN
      --pr_mensajeUsuario(MSG_OK,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
      v_retorno.listaDetalleCotizacion := typ_listaDetallesCotizacion();

      FOR ct IN cotizaciones LOOP
         DECLARE
            v_cotizacion typ_detalleCotizacion := typ_detalleCotizacion;
         BEGIN
            v_can_detalles                 := v_can_detalles + 1;
            v_cotizacion.moneda            := substr(ct.des_moneda,0, 30);
            v_cotizacion.efectivoCompra    := ct.val_compra;
            v_cotizacion.efectivoVenta     := ct.val_venta;
            v_cotizacion.electronicaCompra := ct.val_com_electronica;
            v_cotizacion.electronicaVenta  := ct.val_ven_electronica;
            v_cotizacion.chequeCompra      := ct.val_com_cheque;
            v_cotizacion.chequeVenta       := ct.val_ven_cheque;
            v_cotizacion.conversion        := ct.val_conversion;
            v_retorno.listaDetalleCotizacion.extend;
            v_retorno.listaDetalleCotizacion(v_retorno.listaDetalleCotizacion.count) := v_cotizacion;
         END;
      END LOOP;
      v_retorno.cantDetalles := v_can_detalles;

      IF v_can_detalles = 0 THEN
         -- v_cod_respuesta  := paw_bce.v_cod_cta_inexistente;
         pr_mensajeUsuario(MSG_COT_SINDET, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

         pr_insertarBitacora(' ', '999', ' ', COD_OPERACION, ' ', 'obtenerCotizacion-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
         RETURN v_retorno;
      END IF;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(' ', '999', ' ', COD_OPERACION, ' ', fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(NULL, ' ', NULL, COD_OPERACION, NULL, 'obtCheque -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerCalificacionRiesgo(p_sesion   IN VARCHAR2,
                                         p_codCanal IN VARCHAR2) RETURN typ_calificacionRiesgo IS
      -- datos a responder
      COD_OPERACION CONSTANT VARCHAR2(3) := '095';
      v_cat_riesgo VARCHAR2(3);--ge_clientes.cat_riesgo%TYPE;
      v_retorno    typ_calificacionRiesgo := typ_calificacionRiesgo;
      userInfo     typ_validarSesion;
      v_riesgo       varchar2(50) := null ; -- Categoría de Riesgo
      v_fec_riesgo   varchar2(30) := null ;  -- Fecha de Riesgo

      v_fec_clasificacion date;
      v_logMessage VARCHAR2(1000);
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- 1. valido la clave del cliente
      userinfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parámetros
      v_logMessage := 'ObtenerCalificacionRiesgo';
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

      IF (userInfo.error = 'S') THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;

      BEGIN
         SELECT pap_cat.fu_obt_cat_crc(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona), NULL, 'N')
           INTO v_cat_riesgo
           FROM ge_clientes g
          WHERE g.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona);
         -- la ultima fecha calificada, no la ultima fecha modificada
         SELECT MAX(trunc(fec_insercion))
           INTO v_fec_clasificacion
           FROM ge_cla_operaciones
          WHERE cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona);
      EXCEPTION
         WHEN no_data_found THEN
            v_cat_riesgo := NULL;
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, NULL, 'obtCalificacionRiesgo -' || SQLERRM, BITACORA_ERROR);
            RETURN v_retorno;
      END;

      v_riesgo     := fue_obt_des_refcodes('CAT_RIESGO', v_cat_riesgo);
      IF v_cat_riesgo IS NULL THEN
         v_cat_riesgo := 1;
         v_fec_riesgo := pag_cal.fu_obt_fec_actual(1);
      ELSE
         v_fec_riesgo := v_fec_clasificacion;
      END IF;

      v_retorno.calificacionRiesgo := v_cat_riesgo;
      v_retorno.fecha :=v_fec_riesgo;
      v_retorno.descripcionCalificacion:=v_riesgo;
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'ObtenerCalificacionRiesgo - cat:'|| v_cat_riesgo ||',fec:'||v_fec_riesgo ||',des:'||v_riesgo ||',' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   END;

   FUNCTION fu_obtTransInternacional(p_sesion   IN VARCHAR2,
                                     p_codCanal IN VARCHAR2,
                                     p_inicio   IN DATE,
                                     p_fin      IN DATE) RETURN typ_detalleTransInternacional IS

      --
      COD_OPERACION              CONSTANT VARCHAR2(3) := '086';
      MSG_OBTINFTRANSF_FINVALIDA CONSTANT VARCHAR2(15) := 'RANGOFEC_INVAL';
      MSG_OBTINFTRANSF_ERR_RANGO CONSTANT VARCHAR2(15) := 'RANGO_MUY_LARG';
      v_fec_desde    DATE;
      v_fec_hasta    DATE;
      v_can_detalles NUMBER(3) := 0;
      --Jalvaren 21/Mayo/2012
      userInfo     typ_ValidarSesion;
      v_permiso    typ_obtenerPermisos;
      v_retorno    typ_detalleTransInternacional := typ_detalleTransInternacional;
      v_logmessage VARCHAR2(1000);

      -- variables
      CURSOR cabecera(p_fec_desde DATE, p_fec_hasta DATE) IS
         SELECT 'ENV' Tip_trans, a.nro_ref_externa nro_ref_externa, a.nro_cta_referencia nro_cta_referencia, 'ENVIADA AL SWIFT' Estado, a.monto monto, decode(a.cod_modalidad, 72, 'E', 'R') Tipo, nvl(a.nom_beneficiario, a.nom_ordenante) Beneficiario, a.nom_solicitante Solicitante, a.nro_operacion Operacion, a.fec_operacion Fec_operacion, a.nom_banco Banco,
                nvl((SELECT gb.descripcion
                       FROM ge_bancos gb
                      WHERE gb.cod_banco = a.cod_bco_corresponsal), a.cod_bco_corresponsal) Corresponsal, a.cod_moneda Moneda, a.fec_valor Fec_valor, a.msj_swift Swift
           FROM lc_transferencias a
          WHERE a.cod_modalidad = 72 -- Solo la modalidad de Transferencia enviada
            AND a.fec_operacion >= p_fec_desde
            AND a.fec_operacion <= p_fec_hasta
            AND a.cod_per_solicitante = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
            AND a.estado = 'E' -- Solo los de estados Enviado al Swift
         UNION ALL
         SELECT 'REC' Tip_trans, a.nro_ref_externa nro_ref_externa, a.nro_cta_referencia nro_cta_referencia, 'PAGADA' Estado, a.monto monto, decode(a.cod_modalidad, 72, 'E', 'R') Tipo, nvl(a.nom_beneficiario, a.nom_ordenante) Beneficiario, a.nom_solicitante Solicitante, a.nro_operacion Operacion, a.fec_operacion Fec_operacion, a.nom_banco Banco,
                nvl((SELECT gb.descripcion
                       FROM ge_bancos gb
                      WHERE gb.cod_banco = a.cod_bco_corresponsal), a.cod_bco_corresponsal) Corresponsal, a.cod_moneda Moneda, a.fec_valor Fec_valor, a.msj_swift Swift
           FROM lc_transferencias a
          WHERE a.cod_modalidad = 75 -- Solo la modalidad de Trnasferencia Recibida
            AND a.fec_operacion >= p_fec_desde
            AND a.fec_operacion <= p_fec_hasta
            AND (a.cod_per_beneficiario = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona) OR a.nro_doc_beneficiario = (SELECT p.nro_documento
                                                                                                                             FROM ba_personas p
                                                                                                                            WHERE p.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)))
            AND a.estado = 'OK' -- Solo los de estados Pagados
          ORDER BY fec_operacion, nro_cta_referencia;

      v_fec_actual DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy

   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parámetros
      v_logMessage := 'obtInfTransfInternacionales(sesion=*,codCanal=*,fechaDesde=' || p_inicio || ',fechaHasta=' || p_fin || ')';
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

      IF (userInfo.error = 'S') THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;

      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF p_inicio IS NOT NULL THEN
         v_fec_desde := p_inicio;
      ELSE
         v_fec_desde := v_fec_actual - 30;
         v_fec_hasta := v_fec_actual;
      END IF;

      IF p_fin IS NOT NULL THEN
         v_fec_hasta := p_fin;
      END IF;

      IF v_fec_hasta < v_fec_desde THEN
         --retValue.codRespuesta:= paw_bce.v_fec_invalida ;
         pr_mensajeUsuario(MSG_OBTINFTRANSF_FINVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, ' Rango invalido -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF (v_fec_hasta - v_fec_desde) > 60 THEN
         --retValue.codRespuesta  := paw_bce.v_fec_exceso ;
         pr_mensajeUsuario(MSG_OBTINFTRANSF_ERR_RANGO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Cuenta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      v_retorno.listaTransferencias := typ_listaTransInternacional();

      FOR cb IN cabecera(v_fec_desde, v_fec_hasta) LOOP
         DECLARE
            v_transferencia typ_transferenciaInternacional := typ_transferenciaInternacional;
         BEGIN
            v_can_detalles                          := v_can_detalles + 1;
            v_transferencia.tipoTransferencia       := substr(cb.tip_trans,0, 3);
            v_transferencia.nroReferenciaExterna    := substr(cb.nro_ref_externa,0, 20);
            v_transferencia.fechaOperacion          := cb.fec_operacion;
            v_transferencia.nroCuentaReferencia     := substr(cb.nro_cta_referencia,0, 20);
            v_transferencia.estado                  := substr(cb.estado,0, 16);
            v_transferencia.codigoMoneda            := substr(cb.moneda,0, 3);
            v_transferencia.monto                   := cb.monto;
            v_transferencia.Beneficiario            := substr(cb.beneficiario,0, 100);
            v_transferencia.solicitante             := substr(cb.solicitante,0, 100);
            v_transferencia.numeroOperacion         := cb.operacion;
            v_transferencia.nombreBancoCorresponsal := substr(cb.corresponsal,0, 100);
            v_transferencia.fechaValor              := cb.fec_valor;
            v_transferencia.mensajeswift            := substr(cb.swift,0, 4000);
            v_transferencia.nombreBanco             := substr(cb.banco,0, 100);

            v_retorno.listaTransferencias.extend;
            v_retorno.listaTransferencias(v_retorno.listaTransferencias.count) := v_transferencia;
         END;
      END LOOP;
      v_retorno.cantTransferencias := v_can_detalles;

      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'canDet: ' || v_can_detalles || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'obtCheque -' || SQLERRM, BITACORA_ERROR);
     RETURN v_retorno;
   END;


   -- Guardar o actualizar Autorizadores de chequera en casa
   FUNCTION fu_autorizadorCheque(p_sesion          IN VARCHAR2,
                                 p_codCanal        IN VARCHAR2,
                                 p_modo            IN VARCHAR2,
                                 p_tipoDocumento   IN NUMBER,
                                 p_numeroDocumento IN VARCHAR2,
                                 p_nombreCompleto  IN VARCHAR2,
                                 p_tipoLinea       IN VARCHAR2,
                                 p_numeroTelefono  IN VARCHAR2,
                                 p_interno         IN VARCHAR2,
                                 p_estado          IN VARCHAR2,
                                 p_tipDocAnterior  IN NUMBER DEFAULT NULL,
                                 p_nroDocAnterior  IN VARCHAR2 DEFAULT NULL) RETURN typ_mensajerespuesta IS
      v_cod_operacion      VARCHAR2(3) := '058';
      v_usu_sesion         typ_validarSesion;
      v_retorno            typ_mensajerespuesta := typ_mensajerespuesta;
      v_permiso            typ_obtenerPermisos;
      v_msj_caja           typ_mensajeCaja;
      v_cod_per_principal  cc_dat_che_casa.cod_per_principal%TYPE;
      v_cod_per_autorizada cc_dat_che_casa.cod_per_autorizada%TYPE := NULL;
      v_cod_tip_documento  cc_dat_che_casa.cod_tip_documento%TYPE := depurarNumerico(p_tipoDocumento, 3);
      v_nro_documento      cc_dat_che_casa.nro_documento%TYPE := depurarTextos(p_numeroDocumento, 20);
      v_nom_completo       cc_dat_che_casa.nom_completo%TYPE := depurarTextos(p_nombreCompleto, 120);
      v_tip_linea          cc_dat_che_casa.tip_linea%TYPE := substr(p_tipoLinea, 1, 1);
      v_nro_telefono       cc_dat_che_casa.nro_telefono%TYPE := depurarNumerico(p_numeroTelefono, 10);
      v_interno            cc_dat_che_casa.interno%TYPE := depurarNumerico(p_interno, 5);
      v_estado             cc_dat_che_casa.estado%TYPE := substr(p_estado, 1, 1);
      v_cod_tip_doc_ant    cc_dat_che_casa.cod_tip_documento%TYPE := p_tipDocAnterior;
      v_nro_doc_anterior   cc_dat_che_casa.nro_documento%TYPE := depurarTextos(p_nroDocAnterior, 20);
      v_modo               VARCHAR2(1) := substr(p_modo, 1, 1);
      v_msj_bitacora       VARCHAR2(700) := 'modo: '||v_modo||',est: '||v_estado||
                                            ', tipDoc: '||v_cod_tip_documento ||
                                            ', or_nom:'||p_nombreCompleto||
                                            ', nom:'||v_nom_completo;
      MSG_OPE_NO_PERMITIDA     CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_PAR_INCORRECTOS      CONSTANT VARCHAR2(15) := 'PARAM_INCORRECT';
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- Verifica la sesion
      v_usu_sesion := fu_validarSesion(p_sesion, p_codCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error := v_usu_sesion.error;
         v_retorno.nombreRespuesta := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- Verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- Verifica el permiso
      v_permiso := lf_obt_permisos(v_usu_sesion, '060');
      IF v_permiso.error = 'S' THEN
         v_retorno.error                := v_permiso.error;
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      IF v_cod_tip_documento IS NULL OR v_nro_documento IS NULL OR
         v_nom_completo IS NULL OR v_tip_linea IS NULL OR
         v_nro_telefono IS NULL OR v_estado IS NULL THEN
         pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

       IF v_estado NOT IN ('A', 'I') OR v_tip_linea NOT IN ('C','B')  THEN
         pr_mensajeUsuario(MSG_PAR_INCORRECTOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- guardamos el titular
      v_cod_per_principal := nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona);
      -- buscamos si el autorizador esta registrado en el sistema
      BEGIN
         SELECT p.cod_persona
           INTO v_cod_per_autorizada
           FROM ba_personas p
           WHERE p.nro_documento = v_nro_documento
             AND p.cod_tip_documento = v_cod_tip_documento;
      EXCEPTION
         WHEN OTHERS THEN
            NULL;
      END;
      -- guardamos/actualizamos el autorizador
      IF v_modo = 'C' THEN
         BEGIN
            IF v_cod_tip_doc_ant IS NOT NULL THEN
               DELETE
                 FROM cc_dat_che_casa c
                WHERE c.cod_per_principal = v_cod_per_principal
                  AND c.nro_documento = v_nro_doc_anterior
                  AND c.cod_tip_documento = v_cod_tip_doc_ant;

               v_msj_bitacora := v_msj_bitacora ||', tipDocAnt:'||v_cod_tip_doc_ant||', docAnt:'||v_nro_doc_anterior||', tot:'|| SQL%ROWCOUNT;
               IF SQL%ROWCOUNT > 1 THEN
                  pr_mensajeUsuario(MSG_PAR_INCORRECTOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;
            END IF;

            INSERT INTO cc_dat_che_casa
               (cod_per_principal, cod_per_autorizada, cod_tip_documento, nro_documento,
                nom_completo, tip_linea, nro_telefono, interno, estado)
            VALUES
               (v_cod_per_principal, v_cod_per_autorizada, v_cod_tip_documento, v_nro_documento,
                v_nom_completo, v_tip_linea, v_nro_telefono, v_interno, v_estado);
         EXCEPTION
            WHEN DUP_VAL_ON_INDEX THEN
               UPDATE cc_dat_che_casa c
                  SET cod_per_autorizada = v_cod_per_autorizada,
                      nom_completo = v_nom_completo,
                      tip_linea = v_tip_linea,
                      nro_telefono = v_nro_telefono,
                      interno = v_interno,
                      estado = v_estado
                WHERE c.cod_per_principal = v_cod_per_principal
                  AND c.nro_documento = v_nro_documento
                  AND c.cod_tip_documento = v_cod_tip_documento;
               v_msj_bitacora := v_msj_bitacora || ', totMod: ' || sql%rowcount;
         END;
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR :[' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   -- Guardar o actualizar Direccion de chequera en casa
   FUNCTION fu_actDireccionCheque(p_sesion             IN VARCHAR2,
                                  p_codCanal           IN VARCHAR2,
                                  p_modo               IN VARCHAR2,
                                  p_direccion          IN  VARCHAR2,
                                  p_codigoCiudad       IN NUMBER,
                                  p_codigoBarrio       IN NUMBER,
                                  p_observacion        IN VARCHAR2,
                                  p_numero             IN  VARCHAR2,
                                  p_departamento       IN  VARCHAR2,
                                  p_piso               IN VARCHAR2,
                                  p_edificio           IN VARCHAR2,
                                  p_codigoPostal       IN VARCHAR2,
                                  p_claveTransaccional IN VARCHAR2,
                                  p_claveToken         IN VARCHAR2) RETURN typ_solicitudClaves IS
      v_cod_operacion    VARCHAR2(3) := '059';
      v_usu_sesion       typ_validarSesion;
      v_retorno          typ_solicitudClaves := typ_solicitudClaves;
      v_permiso          typ_obtenerPermisos;
      v_msj_caja         typ_mensajeCaja;
      v_modo             VARCHAR2(1) := substr(p_modo, 1, 1);
      v_direccion        ba_direcciones.direccion%TYPE := depurarTextos(p_direccion, 80);
      v_cod_ciudad       ba_direcciones.cod_ciudad%TYPE := replace(depurarNumerico(p_codigoCiudad, 3), 0, null);
      v_cod_barrio       ba_direcciones.cod_barrio%TYPE := replace(depurarNumerico(p_codigoBarrio, 3), 0, null);
      v_observacion      ba_direcciones.observacion%TYPE := depurarTextos(p_observacion, 1000);
      v_numero           ba_direcciones.numero%TYPE := depurarAlfanumerico(p_numero, 8);
      v_departamento     ba_direcciones.departamento%TYPE := depurarTextos(p_departamento, 8);
      v_piso             ba_direcciones.piso%TYPE := depurarAlfanumerico(p_piso, 8);
      v_edificio         ba_direcciones.edificio%TYPE := depurarTextos(p_edificio, 35);
      v_cod_postal       ba_direcciones.cod_postal%TYPE := depurarAlfanumerico(p_codigoPostal, 10);
      v_cod_direccion    ba_direcciones.cod_direccion%TYPE;
      v_cod_persona      ba_direcciones.cod_persona%TYPE;
      v_msj_bitacora     VARCHAR2(700) := 'modo: '||v_modo||
                                          ', codCiu: '||v_cod_ciudad||
                                          ', codBa: '||v_cod_barrio||
                                          ', num: '||v_numero||
                                          ', dep: '||v_departamento||
                                          ', pis: '||v_piso||
                                          ', edi: '||v_edificio||
                                          ', dir: '||v_direccion||
                                          ', or_dir:'||p_direccion;
      MSG_OPE_NO_PERMITIDA CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_PAR_INCORRECTOS  CONSTANT VARCHAR2(15) := 'PARAM_INCORRECT';
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- Verifica la sesion
      v_usu_sesion := fu_validarSesion(p_sesion, p_codCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error := v_usu_sesion.error;
         v_retorno.nombreRespuesta := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- Verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- Verifica el permiso
      v_permiso := lf_obt_permisos(v_usu_sesion, '060');
      IF v_permiso.error = 'S' THEN
         v_retorno.error                := v_permiso.error;
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      IF v_modo NOT IN ('V', 'C') THEN
         pr_mensajeUsuario(MSG_PAR_INCORRECTOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF v_usu_sesion.codigoEmpresa IS NOT NULL THEN
         pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF v_direccion IS NULL THEN
         v_msj_bitacora := v_msj_bitacora || ', direccion nula ';
         pr_mensajeUsuario(MSG_PAR_INCORRECTOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF v_modo = 'C' THEN
         v_cod_persona := nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona);
         BEGIN
            -- buscamos si existe la direccion tipo chequera en casa y actualizamos
            SELECT cod_direccion
              INTO v_cod_direccion
              FROM ba_direcciones
             WHERE cod_persona = v_cod_persona
               AND tipo = 'C';

            UPDATE ba_direcciones
               SET direccion = v_direccion, cod_ciudad = v_cod_ciudad,
                   cod_barrio = v_cod_barrio, observacion = v_observacion,
                   numero = v_numero, departamento = v_departamento,
                   piso = v_piso, edificio = v_edificio,
                   cod_postal = v_cod_postal
             WHERE cod_persona = v_cod_persona
               AND cod_direccion = v_cod_direccion
               AND tipo = 'C';
            v_msj_bitacora := v_msj_bitacora || ', mod:' || sql%rowcount;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               -- no existe, insertamos la direccion de chequera en casa
               SELECT nvl(max(cod_direccion), 0) + 1
                 INTO v_cod_direccion
                 FROM ba_direcciones
                WHERE cod_persona = v_cod_persona;

               INSERT INTO ba_direcciones
                  (cod_persona, cod_direccion, tipo, direccion,
                   cod_pais, cod_ciudad, cod_barrio, observacion,
                   numero, departamento, piso, edificio, cod_postal)
               VALUES
                  (v_cod_persona, v_cod_direccion, 'C', v_direccion,
                   1, v_cod_ciudad, v_cod_barrio, v_observacion,
                   v_numero, v_departamento, v_piso, v_edificio, v_cod_postal);
               v_msj_bitacora := v_msj_bitacora || ', codDir:' || v_cod_direccion;
            WHEN TOO_MANY_ROWS THEN
               pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(sqlerrm, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
         END;
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(sqlerrm, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_solicitarChequera(p_sesion             IN VARCHAR2,
                                 p_codCanal           IN VARCHAR2,
                                 p_nroCuenta          IN VARCHAR2,
                                 p_codigoTipoChequera IN VARCHAR2,
                                 p_canHojas           IN NUMBER,
                                 p_cantidadChequeras  IN NUMBER,
                                 p_modo               IN VARCHAR2 DEFAULT NULL,
                                 p_ofi_retencion      IN NUMBER DEFAULT NULL,
                                 p_tip_solicitud      IN VARCHAR2 DEFAULT 'M',
                                 p_claveTransaccional IN VARCHAR2,
                                 p_claveToken         IN VARCHAR2) RETURN typ_mensajeResChequera IS

      -- datos recibidos
      v_modo             VARCHAR2(1); -- V-Validacion, C-Confirmacion
      v_existe           VARCHAR2(1) := 'N';
      v_sol_ofi_ret      ba_oficinas.cod_oficina%TYPE;
      v_cod_moneda       cc_cta_corrientes.cod_moneda%TYPE;
      v_des_cuenta       cc_cta_corrientes.denominacion%TYPE;
      v_nro_cta_cte      cc_cta_corrientes.nro_cuenta%TYPE;
      v_ver_cod_moneda   cc_cta_corrientes.cod_moneda%TYPE;
      v_nro_documento    ge_movimientos.nro_documento%TYPE;
      v_des_chequera     cc_tip_chequeras.descripcion%TYPE;
      v_ver_can_cheques  cc_tip_chequeras.can_cheques%TYPE;
      v_ver_can_minima   cc_tip_chequeras.can_minima%TYPE;
      v_ver_can_maxima   cc_tip_chequeras.can_maxima%TYPE;
      v_cod_transaccion  cc_tip_chequeras.cod_transaccion%TYPE;
      v_sol_tip_che      cc_tip_chequeras.cod_tip_chequera%TYPE;
      v_sol_can_che      cc_tip_chequeras.can_minima%TYPE;
      v_etiqueta2        bw_mov_pendientes.etiqueta2%TYPE;
      v_dato2            bw_mov_pendientes.dato2%TYPE;
      v_direccion        ba_direcciones.direccion%TYPE;
      v_tip_solicitud    VARCHAR2(1) := substr(p_tip_solicitud, 1, 1);  -- M : Mostrador, C : En casa
      v_cod_operacion    VARCHAR2(3) := '060';
      v_cod_mensaje      VARCHAR2(3) := paw_bce.v_cod_aprobado;
      retValidarSesion   typ_validarSesion;
      v_retorno          typ_mensajeResChequera := typ_mensajeResChequera;
      retObtenerPermisos typ_obtenerPermisos;
      v_mensajeCaja      typ_mensajeCaja;
      v_error            typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_fec_actual       DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
      v_hor_actual       VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
      v_est_modulo       ba_modulos.estado%TYPE := pae_cnf.FU_OBT_EST_MODULO(9);
      v_mto_comision     NUMBER;
      v_msj_bitacora     VARCHAR2(400) := substr('nroCuenta:'||trim(p_nroCuenta)
                                                             ||', codTipChe:'||trim(p_codigoTipoChequera)
                                                             ||', canHojas:'||p_canHojas
                                                             ||', cantChe:'||p_cantidadChequeras
                                                             ||', modo:'||p_modo
                                                             ||', ofiRet:'||p_ofi_retencion
                                                             ||', tipSol:'||v_tip_solicitud, 1, 200);
      --Codigos de error
      MSG_OPE_NO_PERMITIDA     CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_NRO_CTA_INVALIDA     CONSTANT VARCHAR2(15) := 'G_NROCTAINVALID';
      MSG_CAN_CHE_INVALIDA     CONSTANT VARCHAR2(15) := 'G_CANCHEINVALID';
      MSG_COD_PED_DUPLICADO    CONSTANT VARCHAR2(15) := 'G_CODPEDDUPLICA';
      MSG_COD_TRA_PROHIBIDA    CONSTANT VARCHAR2(15) := 'G_CODTRAPROHIB';
      MSG_CTA_NO_CORRESP       CONSTANT VARCHAR2(15) := 'COD_CTA_INEXIST';
      MSG_VERIFICAR_PARAMETROS CONSTANT VARCHAR2(15) := 'PARAM_INCORRECT';
      MSG_SIS_CIERRE           CONSTANT VARCHAR2(15) := 'HOR_SIS_CIERRE';
      MSG_COD_CTA_CONJUNTA     CONSTANT VARCHAR2(15) := 'CTA_CONJUNTA';
      MSG_ERR_LIMITE           CONSTANT VARCHAR2(15) := 'G_ERR_LIM_OPERA';
      MSG_OTP_INEXISTENTE      CONSTANT VARCHAR2(15) := 'G_COD_TOK_INEXI';
      MSG_ERR_CON_VASCO        CONSTANT VARCHAR2(15) := 'G_COD_ERR_VASCO';

   FUNCTION lf_cal_mto_comision(p_tip_chequera  IN VARCHAR2,
                                   p_nro_cuenta    IN VARCHAR2,
                                   p_can_chequeras IN NUMBER,
                                   p_can_hojas      IN NUMBER) RETURN NUMBER IS
         v_fila     VARCHAR2(100);
         v_montimp  NUMBER(18, 2);
         v_cdmodul  cc_cta_corrientes.cod_modulo%type;
         v_cdmodal  cc_cta_corrientes.cod_modalidad%type;
         v_cdofici  cc_cta_corrientes.cod_oficina%type;
         v_nrcuent  cc_cta_corrientes.nro_cuenta%type;
         v_tpsolch  cc_chequeras.tipo%type;
         v_cdtasas  ge_movimientos.cod_tasa%type;
         v_tpvlpor  ge_tasas.tip_valor%type;
         v_imtrans  NUMBER(18, 2);
         v_vltasa   ge_tas_fechas.val_tasa%type;
         v_fcdetas  DATE;
         v_tpdetas  ge_tasas.tipo%type;
         v_montcar  NUMBER(18, 2);
         v_tra_pro  VARCHAR2(1);
         v_ctchequ  NUMBER(8);
         v_esctaol  cc_cta_corrientes.estado%type;
         v_cdmoned  cc_cta_corrientes.cod_moneda%type;
         v_tienetp  cc_cta_corrientes.tra_prohibida%type;
         v_tieneau  cc_cta_corrientes.aut_pendiente%type;
         v_fcdehoy  DATE;
         v_sltotol  cc_cta_corrientes.sal_total%type;
         v_fculmov  cc_cta_corrientes.fec_ult_movimiento%type;
         v_hrulmov  cc_cta_corrientes.hor_ult_movimiento%type;
         v_tasaper  cc_cta_corrientes.tas_personalizada%type;
         v_cdtrans  ge_movimientos.cod_transaccion%type;
         v_concepto VARCHAR2(200);
         v_redondeo NUMBER(5);

         v_cob_pri_chequera VARCHAR2(1);
         v_can_chequeras    NUMBER(8);
         v_cdsubmodal       cc_cta_corrientes.cod_sub_modalidad%TYPE;
         v_fec_inicio       DATE;

         CURSOR ctacte IS
            SELECT cod_moneda, tra_prohibida, aut_pendiente, sal_total, fec_ult_movimiento, hor_ult_movimiento, tas_personalizada, estado, ROWID fila
              FROM cc_cta_corrientes
             WHERE cod_modulo = v_cdmodul
               AND cod_modalidad = v_cdmodal
               AND cod_oficina = v_cdofici
               AND nro_cuenta = v_nrcuent
            UNION
            SELECT cod_moneda, 'N' tra_prohibida, 'N' aut_pendiente, sal_total, fec_ult_movimiento, hor_ult_movimiento, 'N' tas_personalizada, estado, ROWID fila
              FROM cc_cta_bancarias
             WHERE cod_modulo = v_cdmodul
               AND cod_modalidad = v_cdmodal
               AND cod_oficina = v_cdofici
               AND nro_cuenta = v_nrcuent;

      BEGIN
         v_fcdehoy := pag_cal.fu_obt_fec_actual(4);
         v_tra_pro := 'N';
         v_tpsolch := p_tip_chequera;
         v_ctchequ := p_can_chequeras * p_can_hojas;

         BEGIN
            SELECT cod_modulo, cod_modalidad, cod_sub_modalidad, cod_oficina, nro_cuenta
              INTO v_cdmodul, v_cdmodal, v_cdsubmodal, v_cdofici, v_nrcuent
              FROM ge_cuentas
             WHERE nro_cuenta = p_nro_cuenta;
         END;

         OPEN ctacte;
         FETCH ctacte INTO v_cdmoned,v_tienetp,v_tieneau,v_sltotol,
                           v_fculmov,v_hrulmov,v_tasaper,v_esctaol,
                           v_fila;

         v_redondeo := fug_obt_pardinamico('VAL_RED_MON_EXTRANJERA', v_cdmodul, v_cdmodal, v_cdmoned);

         IF v_tienetp = 'S' THEN
            v_tra_pro := PAG_CTA.FU_VER_TRA_PROHIBIDA(v_nrcuent, 540, v_cdmodul, v_cdmodal);
         END IF;

         --Ver si no tiene exonerado el cobro de la primera Chequera
         BEGIN
            v_cob_pri_chequera := 'S';
            SELECT COUNT(1)
              INTO v_can_chequeras
              FROM cc_chequeras
             WHERE estado = 'E'
               AND nro_cuenta = v_nrcuent;
         END;

         /*
         || Exonerar del cargo a las cuentas existentes
         || que pasan a pertenecer a un paquete de Segmento Preferetne
         || y ya se le cobró anteriormente la primera chequera.
         */
         BEGIN
            SELECT c.fec_inicio
              INTO v_fec_inicio
              FROM ge_paq_cuentas p, ge_paq_clientes c, ge_paquetes g
             WHERE p.cod_paquete = g.cod_paquete
               AND p.cod_paquete = c.cod_paquete
               AND p.cod_persona = c.cod_persona
               AND p.nro_secuencia = c.nro_secuencia
               AND g.cod_seg_preferente IS NOT NULL
               AND c.estado = 'N'
               AND p.nro_cuenta = v_nrcuent;
         EXCEPTION
            WHEN no_data_found THEN
               v_fec_inicio := NULL;
            WHEN OTHERS THEN
               v_fec_inicio := NULL;
         END;

         IF v_fec_inicio IS NOT NULL THEN
            SELECT COUNT(1)
              INTO v_can_chequeras
              FROM cc_chequeras
             WHERE estado = 'E'
               AND nro_cuenta = v_nrcuent
               AND fec_solicitud > v_fec_inicio; -- para que no se le cobre el cargo
         END IF;
         -- fin modificacion Paquete Premium - Por RABF-11/may/2011

         IF nvl(v_can_chequeras, 0) = 0 THEN
            v_cob_pri_chequera := fug_obt_pardinamico('COB_PRI_CHEQUERA', v_cdmodul, v_cdmodal, v_cdmoned, NULL, v_cdsubmodal);
         END IF;

         IF v_tra_pro = 'N' AND v_cdmodal = 41 AND nvl(v_cob_pri_chequera, 'S') = 'S' THEN
            -- solo se cobra si es cuenta corriente de clientes
            SELECT cod_tasa
              INTO v_cdtasas
              FROM cc_tip_chequeras
             WHERE cod_tip_chequera = v_tpsolch;

            v_tpvlpor := NULL;
            v_imtrans := 0;
            v_vltasa  := 0;
            v_fcdetas := NULL;
            v_tpdetas := NULL;
            PAG_GEN.PR_OBT_VAL_TASA(v_cdmodul, v_cdmodal, v_cdofici, v_nrcuent, v_cdmoned, NULL
                                    --importe
                                    , nvl(v_tasaper, 'N'), v_cdtasas, NULL
                                    -- transaccion
                                    , v_fcdehoy, v_vltasa, v_fcdetas, v_tpvlpor, v_tpdetas);
            v_montcar := 0;
            IF v_tpvlpor <> 'V' THEN
               raise_application_error(-20000, 'Cargo debe ser valor');
            ELSE
               v_montcar := NVL(to_number(v_vltasa), 0) * v_ctchequ;
               IF NVL(to_number(v_cdtasas), 0) <> 0 AND NVL(to_number(v_vltasa), 0) <> 0 THEN
                  v_montcar  := ROUND(to_number(v_montcar), v_redondeo);

                  v_imtrans := v_montcar;
                  v_cdtrans := 541;
                  v_tasaper := v_tasaper;
                  v_cdtasas := NULL;
                  v_tpvlpor := NULL;
                  v_vltasa  := 0;
                  v_fcdetas := NULL;
                  v_tpdetas := NULL;
                  SELECT descripcion
                    INTO v_concepto
                    FROM ge_transacciones
                   WHERE cod_modulo = 4
                     AND cod_modalidad = v_cdmodal
                     AND cod_transaccion = v_cdtrans;
                  PAG_GEN.PR_OBT_VAL_TASA(v_cdmodul, v_cdmodal, v_cdofici, v_nrcuent, v_cdmoned, v_imtrans,
                                           -- importe
                                           nvl(v_tasaper, 'N'), v_cdtasas,
                                           -- tasa
                                           v_cdtrans,
                                           -- Transaccion
                                           v_fcdehoy, v_vltasa, v_fcdetas, v_tpvlpor, v_tpdetas);
                  v_montimp := 0;
                  IF nvl(to_number(v_cdtasas), 0) <> 0 AND nvl(to_number(v_vltasa), 0) <> 0 THEN
                     IF v_tpvlpor = 'V' THEN
                         v_montimp := v_vltasa;
                     ELSE
                        v_montimp := to_number(v_imtrans) * to_number(v_vltasa) / 100;
                        --verificar si el monto a cobrar está limitado x el mínimo y máximo de la tasa
                        v_montimp := pag_gen.FU_OBT_VAL_FINAL(v_montimp);
                     END IF;

                     v_montimp := round(to_number(v_montimp), v_redondeo);
                     -- FB 15.06.2010 finalizo aqui el bloque, anteriormente cuando el cliente tenía tasa personalizada ya no ingresaba y saltaba la catualizacion del saldo total
                  END IF;
               END IF;
            END IF;
         END IF;

         IF ctacte%ISOPEN THEN
            CLOSE ctacte;
         END IF;

         RETURN v_montimp + v_montcar;

      EXCEPTION
         WHEN OTHERS THEN
            RETURN 0;
      END;

   BEGIN

      -- 1. valido la clave del cliente
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);
      IF retValidarSesion.error = 'S' THEN
         v_retorno.error := retValidarSesion.error;
         v_retorno.nombreRespuesta := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         --pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         --pr_insertarBitacora('0', p_codCanal, p_sesion, v_cod_operacion, NULL, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- Verifica el canal de origen
      v_mensajeCaja := lf_val_caja(retValidarSesion);
      IF v_mensajeCaja.error = 'S' THEN
         v_retorno.error                := v_mensajeCaja.error;
         v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_modo := substr(nvl(p_modo, 'x'), 1, 1);
      -- se calcula el monto de la comision
      v_mto_comision := nvl(lf_cal_mto_comision(p_codigoTipoChequera, p_nroCuenta, p_cantidadChequeras, p_canHojas ), 0);

      IF v_modo = 'A' THEN
         IF g_aut_operacion = FALSE THEN
            pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      ELSE
         retObtenerPermisos := lf_obt_permisos(retValidarSesion, v_cod_operacion); --nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), retValidarSesion.codigoPerfil, v_cod_operacion, p_codCanal);
         IF retObtenerPermisos.error = 'S' THEN
            v_retorno.error := retObtenerPermisos.error;
            v_retorno.nombreRespuesta := retObtenerPermisos.nombreRespuesta;
            v_retorno.descripcionRespuesta := retObtenerPermisos.descripcionRespuesta;
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- se verifica que tiene permiso para registrar
         IF retObtenerPermisos.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
            pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;

         IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
            -- se confirma directamente la operacion, porque no requiere autorizacion
            v_modo := 'A'; -- CONFIRMACION
         END IF;
         IF v_modo = 'V' THEN
            -- se asigna el monto de la comisión para retornar
            v_retorno.mtoComision := v_mto_comision;
         END IF;
      END IF;

      /*IF v_est_modulo <> 2 THEN
         v_msj_bitacora := v_msj_bitacora || ', estMod: ' || v_est_modulo;
         pr_mensajeUsuario(MSG_SIS_CIERRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;*/


       --verifica que no sea inhibida
        IF NVL(fug_obt_es_per_inhi(retValidarSesion.codigoPersona),'X') = 'S'  THEN
            pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
       END IF;


      -- obtenemos los parametros recibidos
      v_nro_cta_cte := depurarAlfanumerico(p_nroCuenta, 15);
      v_sol_tip_che := substr(p_codigoTipoChequera, 1, 1);
      v_sol_can_che := p_cantidadChequeras;
      v_sol_ofi_ret := p_ofi_retencion;
      -- valida que la cuenta no sea conjunta
      IF PAW_BAS.fu_es_conjunta(v_nro_cta_cte, v_can_aut_requeridas) = 'S' THEN
         pr_mensajeUsuario(MSG_COD_CTA_CONJUNTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(v_nro_cta_cte, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona)) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF v_modo <> 'V' THEN
        -- Validamos los parametros de retencion
        IF v_tip_solicitud = 'C' THEN
           -- validamos la direccion
           BEGIN
              SELECT 'S', d.direccion
                INTO v_existe, v_direccion
                FROM ba_direcciones d
               WHERE d.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                 AND d.tipo = 'C'
                 AND ROWNUM=1;
           EXCEPTION
              WHEN NO_DATA_FOUND THEN
                 v_existe := 'N';
                 v_direccion := 'cheq. en casa';
           END;
           v_msj_bitacora := v_msj_bitacora || ', dirExt:' || v_existe;
           -- si existe direccion de retiro, no se debe especifique oficina ni puede ser para empresa
           IF retValidarSesion.codigoEmpresa IS NOT NULL THEN
              pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
           END IF;
           v_sol_ofi_ret := NULL;
        ELSIF v_tip_solicitud <> 'M' THEN
           pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
      END IF;
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);

      -- 2. busco los datos de la cuentas
      BEGIN
         SELECT cod_moneda, denominacion
           INTO v_cod_moneda, v_des_cuenta
           FROM cc_cta_corrientes
          WHERE nro_cuenta = v_nro_cta_cte
            AND estado not in ('C','P','T'); --DDSI-2508 - Se iguala a la validacion en ITGF
      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_NRO_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(sqlerrm, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;
      -- Solo personas Juridicas pueden solicitar Formulario Continuo.
      IF PAW_UTI.fu_es_juridica(v_nro_cta_cte, NULL/*retValidarSesion.codigoEmpresa*/, retValidarSesion.codigoPersona) = 'N' AND v_sol_tip_che IN (5,6) THEN
         pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- validamos los parametros de entrada
      BEGIN
         -- busco la transaccion que corresponde para verificar prohibiciones
         SELECT a.cod_transaccion, a.can_cheques, nvl(a.can_minima, 1), nvl(a.can_maxima, 99999), a.cod_moneda, a.descripcion
           INTO v_cod_transaccion, v_ver_can_cheques, v_ver_can_minima, v_ver_can_maxima, v_ver_cod_moneda, v_des_chequera
           FROM cc_tip_chequeras a
          WHERE cod_tip_chequera = v_sol_tip_che
            AND (cod_moneda IS NULL OR cod_moneda = v_cod_moneda);

         IF pag_cta.fu_ver_tra_prohibida(v_nro_cta_cte, v_cod_transaccion, 4, 41) = 'N' THEN
            BEGIN
               -- Para Validar Cantidad de hojas de Formularios Continuo.
               IF v_sol_tip_che IN (5, 6) THEN
                  IF NOT (p_canHojas between v_ver_can_minima and v_ver_can_maxima) or (v_sol_can_che=0) then
                     pr_mensajeUsuario(MSG_CAN_CHE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;
                  v_des_chequera := p_canHojas || 'H ' || v_des_chequera;
               ELSE
                  -- Para Validar Cantidad de hojas de Chequeras.
                  IF NOT (v_sol_can_che BETWEEN v_ver_can_minima AND v_ver_can_maxima) OR (v_sol_can_che = 0) THEN
                     pr_mensajeUsuario(MSG_CAN_CHE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;
               END IF;
            EXCEPTION
               WHEN no_data_found THEN
                  pr_mensajeUsuario(MSG_CAN_CHE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  RETURN v_retorno;
            END;

            BEGIN
               -- Antes de insertar verifico si es que no existe un pedido similar.
               SELECT 'S'
                 INTO v_existe
                 FROM cc_sol_chequeras
                WHERE nro_cuenta = v_nro_cta_cte
                  AND cod_tip_chequera = v_sol_tip_che
                  AND cantidad = v_sol_can_che
                  AND can_hojas = p_canHojas
                  AND estado IN ('S', 'V')
                  AND rownum = 1;
            EXCEPTION
               WHEN no_data_found THEN
                  v_existe := 'N';
               WHEN too_many_rows THEN
                  v_existe := 'S';
               WHEN OTHERS THEN
                  v_existe := 'N';
            END;

            IF v_existe = 'S' THEN
               pr_mensajeUsuario(MSG_COD_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
         ELSE
            pr_mensajeUsuario(MSG_COD_TRA_PROHIBIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      -- verificamos que clave solicitar al usuario para actualizar el dato
      IF v_tip_solicitud <> 'M' THEN
         v_retorno.solicitud := paw_seg.fu_obt_cla_operacion('ACT_DIR_CHE_TRA',
                                                             'ACT_DIR_CHE_OTP',nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona));
      ELSE
         v_retorno.solicitud := '00';
      END IF;
      v_msj_bitacora := v_msj_bitacora || ', solCla: ' || v_retorno.solicitud;

      IF v_retorno.solicitud IN ('-1', '-2') THEN
         pr_mensajeUsuario(MSG_ERR_LIMITE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF v_modo = 'V' THEN
         IF v_retorno.solicitud IN ('01', '11') THEN
            -- para enviar el Challenge OTP si corresponde
            v_cod_mensaje := paw_bce.fu_obt_tok_validar(NULL, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, 0, 'V');
            v_msj_bitacora := v_msj_bitacora || ', codResOTP: ' || v_cod_mensaje;
            -- verificamos si no hubo error
            IF v_cod_mensaje = paw_bce.v_cla_otp_inexistente THEN
               pr_mensajeUsuario(MSG_OTP_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            ELSIF v_cod_mensaje <> paw_bce.v_cod_aprobado THEN
               pr_mensajeUsuario(MSG_ERR_CON_VASCO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
            -- si hay error, salimos
            IF v_retorno.error = 'S' THEN
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
          END IF;
      END IF;

      -- grabar en modo de pendientes
      IF v_modo = 'C' THEN

         --- inserto el movimiento pendiente de autorizacion
         SELECT s_nro_documento.nextval
           INTO v_nro_documento
           FROM dual;

         IF v_tip_solicitud = 'M' THEN
            v_etiqueta2 := 'Ofi.de Retencion';
            v_dato2 := substr(rpad(v_sol_ofi_ret, 4, ' ') || fue_obt_des_oficina(v_sol_ofi_ret), 1, 50);
         ELSE
            v_etiqueta2 := 'Dir.de Retencion';
            v_dato2 := substr(rpad(v_sol_ofi_ret, 4, ' ') || v_direccion, 1, 50);
         END IF;
         BEGIN
            INSERT INTO bw_mov_pendientes
               (nro_documento, cod_per_principal, fec_hora,
               cod_tip_mensaje, nro_cuenta, cod_moneda,
               descripcion, etiqueta, dato,
               cantidad, etiqueta2, dato2,
               estado, can_aut_requeridas, can_aut_faltantes,
               cod_per_ingreso, referencia, tip_pago, monto)
            VALUES
               (v_nro_documento, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), SYSDATE,
                '060', v_nro_cta_cte, v_cod_moneda,
                'Solicitud de Chequeras', 'Tipo de Chequera', substr(v_sol_tip_che||'-'||v_des_chequera, 1, 50), --substr(rpad(v_sol_tip_che, 6, ' ') || v_des_chequera, 1, 50)
                v_sol_can_che, v_etiqueta2, v_dato2, --'Ofi.de Retencion', substr(rpad(v_sol_ofi_ret, 4, ' ') || fue_obt_des_oficina(v_sol_ofi_ret), 1, 50),
                'P', retObtenerPermisos.canAutRequeridas, retObtenerPermisos.canAutRequeridas,
                retValidarSesion.codigoPersona, p_canHojas, v_tip_solicitud, v_mto_comision);
         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_VERIFICAR_PARAMETROS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(sqlerrm, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
         END;
         v_retorno.canAutRequeridas := v_can_aut_requeridas;
         v_retorno.nroDocumento     := v_nro_documento;
      ELSIF v_modo = 'A' THEN
         --control de clave según tipo de solicitud
         IF v_tip_solicitud <> 'M' THEN
            v_error.error := 'N';
            IF v_retorno.solicitud IN ('10', '11') THEN -- clave transaccional requerida
              v_error := lf_obt_cla_validar(p_claveTransaccional, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, 'T');
            END IF;

            IF v_error.error = 'N' THEN
               IF v_retorno.solicitud IN ('01', '11') THEN -- token requerido
                 v_error := paw_seg.fu_obt_tok_validar(p_claveToken, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, v_modo);
               END IF;
            END IF;

            IF v_error.error = 'S' THEN
               v_retorno.error := v_error.error;
               v_retorno.nombreRespuesta := v_error.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
         END IF;
         -- confirmacion de datos
         IF v_retorno.error = 'N' THEN
            BEGIN
               INSERT INTO cc_sol_chequeras
                  (nro_cuenta, fecha, hora, cod_usuario, cod_tip_chequera, cantidad, can_hojas, estado, cod_ofi_retiro, observacion, tip_solicitud)
               VALUES
                  (v_nro_cta_cte, v_fec_actual, v_hor_actual, substr(v_mensajeCaja.codigoUsuario, 0, 10), v_sol_tip_che, v_sol_can_che, p_canHojas, 'S', v_sol_ofi_ret, decode(paw_bce.fu_caj_homebanking(p_codCanal), 'S', 'Solicitado a traves de la Web', 'Solicitado a traves del TAS'), v_tip_solicitud);

               SELECT s_nro_documento.nextval
                 INTO v_nro_documento
                 FROM dual;
               v_retorno.nroDocumento := v_nro_documento;
               -- registro del movimiento
               lp_reg_operacion(v_nro_cta_cte /*p_nro_cuenta*/, v_cod_moneda /*p_cod_moneda */, NULL /*p_monto*/, NULL /*p_nro_cta_contra*/, v_sol_can_che /*p_cantidad*/, 'Tipo' /*p_etiqueta*/, v_sol_tip_che /*p_dato*/, 'Ofi.Retencion', v_sol_ofi_ret, 'Yaguarete', NULL, '000', retValidarSesion.codigoPersona, v_cod_operacion, v_nro_documento, p_codCanal, p_sesion, retValidarSesion.codigoEmpresa);
            EXCEPTION
               WHEN OTHERS THEN
                  pr_mensajeUsuario(MSG_NRO_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  RETURN v_retorno;
            END;
         END IF;
      END IF;
      v_retorno.codigoMoneda := v_cod_moneda;
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR : [' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerTiposChequeras(p_sesion    IN VARCHAR2,
                                     p_nroCuenta IN VARCHAR2,
                                     p_codCanal  IN VARCHAR2) RETURN typ_tiposChequeras IS
      retValidarSesion      typ_validarSesion;
      retValue              typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_tip_mensaje         VARCHAR2(3) := '230'; -- nro función origen en paw_bce
      v_nro_cta_cte         VARCHAR2(15) := substr(p_nroCuenta,0,15);
      v_retorno             typ_tiposChequeras := typ_tiposChequeras;
      v_listaTiposChequeras typ_listaTiposChequeras := typ_listaTiposChequeras();
      v_can_tip_che         NUMBER(3) := 0; -- cantidad de tipos de chequeras
      v_cantidad            VARCHAR2(5);
      v_det_tip_che         VARCHAR2(1000) := NULL; -- datos de los tipos de chequeras
      v_can_chequera        VARCHAR2(100); -- cantidad de chequeras
      v_pos                 NUMBER(5);
      v_codMoneda           VARCHAR2(3);

      --Codigos de error
      MSG_SESION_INVALIDA   CONSTANT VARCHAR2(15) := 'L_AUTH_ERROR';
      MSG_NRO_CTA_INVALIDA  CONSTANT VARCHAR2(15) := 'G_NROCTAINVALID';
      MSG_COD_TRA_PROHIBIDA CONSTANT VARCHAR2(15) := 'G_CODTRAPROHIB';
      MSG_CTA_NO_CORRESP    CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';

      -- tipos de chequeras

      CURSOR tip_cheq(p_codMoneda VARCHAR2) IS
         SELECT cod_tip_chequera, descripcion, can_cheques, tipo, can_maxima, cod_moneda, cod_transaccion
           FROM cc_tip_chequeras
          WHERE (cod_moneda IS NULL OR cod_moneda = p_codMoneda);
      -- OMM 20/01/2011 Para Formulario Continuo
      --  and can_cheques<>'1';

   BEGIN
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);
      IF retValidarSesion.error = 'S' THEN
         pr_mensajeUsuario(MSG_SESION_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         v_retorno.error                := v_retorno.error;
         v_retorno.nombreRespuesta      := v_retorno.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_retorno.descripcionRespuesta;
         pr_insertarBitacora('0', p_codCanal, p_sesion, v_tip_mensaje, NULL, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(v_nro_cta_cte, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona)) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      BEGIN
      SELECT cod_moneda
        INTO v_codMoneda
        FROM ge_cuentas
       WHERE nro_cuenta = v_nro_cta_cte;
      EXCEPTION
         WHEN no_data_found THEN
         pr_mensajeUsuario(MSG_NRO_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         v_retorno.error                := v_retorno.error;
         v_retorno.nombreRespuesta      := v_retorno.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_retorno.descripcionRespuesta;

         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL, 'obtenerTiposChequeras -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);

         RETURN v_retorno;
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL, 'obtenerTiposChequeras -' || SQLERRM, BITACORA_ERROR);
            RETURN v_retorno;
      END;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL, 'obtenerTiposChequeras - Nro Cta : ' || v_nro_cta_cte || ' - ' || v_retorno.descripcionRespuesta, BITACORA_ENTRADA);

      FOR tc IN tip_cheq(v_codMoneda) LOOP
         DECLARE
            v_detalleChequera typ_informacionTipoChequera := typ_informacionTipoChequera;
         BEGIN
            IF pag_cta.fu_ver_tra_prohibida(v_nro_cta_cte, tc.cod_transaccion, 4, 41) = 'N' THEN
               -- no tiene transaccion prohibida
               v_can_chequera := REPLACE(TRIM(tc.can_cheques), ' ', '');
               LOOP
                  -- ciclo para desmembrar el campo de cantidad posibles de chequeras
                  EXIT WHEN v_can_chequera IS NULL;
                  v_pos := instr(v_can_chequera, ',');
                  IF v_pos > 0 THEN
                     v_cantidad     := substr(v_can_chequera, 1, v_pos - 1);
                     v_can_chequera := substr(v_can_chequera, v_pos + 1);
                  ELSE
                     v_cantidad     := v_can_chequera;
                     v_can_chequera := NULL;
                  END IF;
                  v_can_tip_che := v_can_tip_che + 1;
                  v_det_tip_che := v_det_tip_che || substr(tc.cod_tip_chequera,0, 1) || substr(tc.tipo,0, 1) || substr(v_cantidad,0, 3) || substr(tc.descripcion || ' ' || v_cantidad,0, 20);
               END LOOP;

               v_detalleChequera.codigoTipoChequera := substr(tc.cod_tip_chequera,0, 1);
               v_detalleChequera.descripcion        := substr(tc.descripcion,0, 35);
               v_detalleChequera.cantidadCheques    := substr(v_cantidad,0, 3);
               v_detalleChequera.tipo               := substr(tc.tipo,0, 1);
               v_detalleChequera.cantidadMaxima     := tc.can_maxima;
               v_detalleChequera.codigoMoneda       := substr(tc.cod_moneda,0, 3);
               v_detalleChequera.codigoTransaccion  := tc.cod_transaccion;
               v_listaTiposChequeras.extend;
               v_listaTiposChequeras(v_listaTiposChequeras.count) := v_detalleChequera;
            ELSE
               pr_mensajeUsuario(MSG_COD_TRA_PROHIBIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL, 'obtenerTiposChequeras -' || v_retorno.descripcionRespuesta || '-' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);

            END IF;
         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL, 'obtenerTiposChequeras -' || SQLERRM, BITACORA_ERROR);
               RETURN v_retorno;
         END;
      END LOOP;

      IF v_retorno.error = 'N' THEN
         v_retorno.tiposChequeras := v_listaTiposChequeras;
      END IF;
      RETURN v_retorno;
   EXCEPTION

      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL, 'obtenerTiposChequeras -' || retValue.descripcionRespuesta || '-' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerSaldosCuenta(p_sesion    IN VARCHAR2,
                                   p_codCanal  IN VARCHAR2,
                                   p_nroCuenta IN VARCHAR2,
                                   p_dias      IN NUMBER) RETURN typ_saldosCuentas IS

      v_listaSaldosCuenta typ_listaSaldosCuenta := typ_listaSaldosCuenta();
      v_retorno           typ_saldosCuentas := typ_saldosCuentas;
      v_cod_operacion     VARCHAR2(3) := '300';
      retValidarSesion    typ_validarSesion;
      v_permiso           typ_obtenerPermisos;
      v_fecDesde          DATE;
      v_moneda            VARCHAR2(3);
      v_can_detalles      NUMBER(3) := 0; -- cantidad de registros
      menRespuesta        typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_nroCuenta         VARCHAR2(16);
      --Codigos de error
      MSG_CTA_INEXISTENTE CONSTANT VARCHAR2(15) := 'G_NROCTAINVALID';
      MSG_CTA_NO_CORRESP  CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';

      CURSOR ahorros(p_fecDesde DATE) IS
         SELECT nro_cuenta, ano, mes,
                SUM(CASE
                        WHEN can_dia_acumulado > 0 THEN
                         sal_acu_diario / can_dia_acumulado
                        ELSE
                         sal_acu_diario
                     END) saldoPromedio,
                SUM(nvl(sal_ult_extracto, sal_fin_mes)) saldoCierre
           FROM ah_sal_mensuales
          WHERE nro_cuenta = v_nroCuenta
            AND fec_insercion BETWEEN trunc(p_fecDesde) AND trunc(SYSDATE)
          GROUP BY nro_cuenta, ano, mes
          ORDER BY ano DESC, mes DESC;

      CURSOR tarjetas(p_fecDesde DATE) IS
         SELECT nro_cuenta, ano, mes, SUM(sal_financiado + sal_facturado + sal_facturar + sal_cuo_pendientes) saldoCierre,
                SUM(CASE
                        WHEN can_dia_acumulado > 0 THEN
                         trunc((acu_sal_financiado + acu_sal_facturado + acu_sal_facturar + acu_sal_cuo_pendiente) / can_dia_acumulado, 2)
                        ELSE
                         (acu_sal_financiado + acu_sal_facturado + acu_sal_facturar + acu_sal_cuo_pendiente)
                     END) saldoPromedio
           FROM ta_sal_mensuales
          WHERE nro_cuenta = v_nroCuenta
            AND fec_insercion BETWEEN trunc(p_fecDesde) AND trunc(SYSDATE)
          GROUP BY nro_cuenta, ano, mes
          ORDER BY ano DESC, mes DESC;

      CURSOR ctacte(p_fecDesde DATE) IS
         SELECT c.nro_cuenta, c.ano, c.mes,
                SUM(CASE
                        WHEN c.can_dia_acumulado > 0 THEN
                         c.sal_acu_diario / c.can_dia_acumulado
                        ELSE
                         c.sal_acu_diario
                     END) saldoPromedio,
                SUM(nvl(sal_ult_extracto, sal_fin_mes)) saldoCierre
           FROM cc_sal_mensuales c
          WHERE c.nro_cuenta = v_nroCuenta
            AND fec_insercion BETWEEN trunc(p_fecDesde) AND trunc(SYSDATE)
          GROUP BY c.nro_cuenta, c.ano, c.mes
          ORDER BY c.ano DESC, c.mes DESC;

   BEGIN
      --valido la sesión del cliente
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);

      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- verificacion de permisos
      v_permiso := lf_obt_permisos(retValidarSesion, '020');
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_obt_permisos - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_nroCuenta:=substr(p_nroCuenta,0,CUENTA_TAMANO);
      --Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(v_nroCuenta, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona)) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         menRespuesta.error                := v_retorno.error;
         menRespuesta.nombreRespuesta      := v_retorno.nombreRespuesta;
         menRespuesta.descripcionRespuesta := v_retorno.descripcionRespuesta;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarBitacora(menRespuesta.error,menRespuesta.nombreRespuesta, menRespuesta.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Cuenta - Nro Cta:' || p_nroCuenta || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ENTRADA);

      --obtengo la moneda del nro de cuenta
      BEGIN
         SELECT x.cod_moneda
           INTO v_moneda
           FROM ge_cuentas x
          WHERE x.nro_cuenta = v_nroCuenta;
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(MSG_CTA_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Cuenta Ahorros - Nro Cta: ' || p_nroCuenta || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
            RETURN v_retorno;
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Cuenta Ahorros - Nro Cta: ' || p_nroCuenta || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      --calculo de la fecha desde
      v_fecDesde := SYSDATE - p_Dias;

      --ahorros
      FOR ah IN ahorros(v_fecDesde) LOOP
         DECLARE
            detalleSaldoCuenta typ_SaldoCuenta := typ_saldoCuenta;
         BEGIN
            v_can_detalles                   := v_can_detalles + 1;
            detalleSaldoCuenta.saldoCierre   := ah.saldoCierre;
            detalleSaldoCuenta.saldoPromedio := ah.saldoPromedio;
            detalleSaldoCuenta.anho          := ah.ano;
            detalleSaldoCuenta.mes           := ah.mes;
            detalleSaldoCuenta.moneda        := v_moneda;

            v_listaSaldosCuenta.extend;
            v_listaSaldosCuenta(v_listaSaldosCuenta.count) := detalleSaldoCuenta;

         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Cuenta Ahorros - Nro Cta: ' || p_nroCuenta || SQLERRM || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
               RETURN v_retorno;
         END;
      END LOOP;

      --tarjetas
      FOR tj IN tarjetas(v_fecDesde) LOOP
         DECLARE
            detalleSaldoCuenta typ_SaldoCuenta := typ_saldoCuenta;
         BEGIN
            v_can_detalles                   := v_can_detalles + 1;
            detalleSaldoCuenta.saldoCierre   := tj.saldoCierre;
            detalleSaldoCuenta.saldoPromedio := tj.saldoPromedio;
            detalleSaldoCuenta.anho          := tj.ano;
            detalleSaldoCuenta.mes           := tj.mes;
            detalleSaldoCuenta.moneda        := v_moneda;

            v_listaSaldosCuenta.extend;
            v_listaSaldosCuenta(v_listaSaldosCuenta.count) := detalleSaldoCuenta;

         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Cuenta Tarjetas - Nro Cta:' || p_nroCuenta || SQLERRM || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
         END;
      END LOOP;

      --cuenta corriente
      FOR cc IN ctacte(v_fecDesde) LOOP
         DECLARE
            detalleSaldoCuenta typ_SaldoCuenta := typ_saldoCuenta;
         BEGIN
            v_can_detalles                   := v_can_detalles + 1;
            detalleSaldoCuenta.saldoCierre   := cc.saldoCierre;
            detalleSaldoCuenta.saldoPromedio := cc.saldoPromedio;
            detalleSaldoCuenta.anho          := cc.ano;
            detalleSaldoCuenta.mes           := cc.mes;
            detalleSaldoCuenta.moneda        := v_moneda;
            v_listaSaldosCuenta.extend;
            v_listaSaldosCuenta(v_listaSaldosCuenta.count) := detalleSaldoCuenta;

         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Cuenta Cta Cte - Nro Cta:' || p_nroCuenta || SQLERRM || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
               RETURN v_retorno;
         END;
      END LOOP;

      IF v_retorno.error = 'N' THEN
         v_retorno.cantidad      := v_can_detalles;
         v_retorno.saldosCuentas := v_listaSaldosCuenta;
      END IF;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Cuenta - Nro Cta:' || p_nroCuenta || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;

   /**
   ****  Pago por Despachos Aduaneros(Sofia)  ****
   * @Migrado por: Sergio Ayala
   * @Fecha : 20-07-2012
   */
   FUNCTION fu_pagoAduana(p_sesion             IN VARCHAR2,
                          p_codCanal           IN VARCHAR2,
                          p_cuentaDebito       IN VARCHAR2,
                          p_metodo             IN VARCHAR2,
                          p_monto              IN VARCHAR2,
                          p_operacion          IN VARCHAR2,
                          p_campo1             IN VARCHAR2,
                          p_campo2             IN VARCHAR2,
                          p_nombreImportador   IN VARCHAR2,
                          p_nombreDespachante  IN VARCHAR2,
                          p_claveToken         IN VARCHAR2,
                          p_claveTransaccional IN VARCHAR2) RETURN typ_pagoAduana IS

      -- Datos Recibidos del HB
      v_nro_cta_debito   VARCHAR2(16); -- nro de cuenta de debito
      v_monto            NUMBER(18, 2); -- monto a transferir
      v_campo1           VARCHAR2(18); -- Ruc Importador
      v_campo2           VARCHAR2(18); -- Ruc Despachante
      v_tip_operacion    VARCHAR2(3); -- Tipo Operacion TDA o TID
      v_nom_importador   VARCHAR(100);
      v_nom_despachante  VARCHAR(100);
      v_mto_bol_total    NUMBER(18, 2); -- monto total de ticket
      v_mto_bol_efectivo NUMBER(18, 2); -- monto efectivo de ticket
      v_mto_bol_cheque   NUMBER(18, 2); -- monto cheque de ticket
      v_etiqueta1        bw_movimientos.etiqueta%TYPE;
      v_etiqueta2        bw_movimientos.etiqueta2%TYPE;
      v_dato1            bw_movimientos.dato%TYPE;
      v_dato2            bw_movimientos.dato2%TYPE;
      v_descripcion      VARCHAR2(100);
      v_concepto         VARCHAR2(35);
      v_tip_agente       VARCHAR2(5);

      -- Variables
      v_cta_for_debito  VARCHAR2(17); -- Cuenta Debito formateada
      v_cod_mon_debito  VARCHAR2(3); -- Moneda de la cuenta
      v_cod_mod_debito  NUMBER(4); -- Modulo de la cuenta
      v_cod_mad_debito  NUMBER(4); -- Modalidad de la cuenta
      v_cod_ofi_debito  NUMBER(4); -- Oficina de la cuenta
      v_nom_cta_debito  VARCHAR2(100); -- Nombre de la cuenta
      v_cot_debito      NUMBER(18, 2) := NULL; -- Cotizacion
      v_nro_cta_credito VARCHAR2(15); -- Numero de Cuenta Credito
      v_cta_for_credito VARCHAR2(17); -- Cuenta Credito formateada
      v_cod_mon_credito VARCHAR2(3); -- Moneda de la cuenta
      v_est_cta_credito VARCHAR2(1); -- Estado de la cuenta
      v_cod_mod_credito NUMBER(4); -- Modulo de la cuenta
      v_cod_mad_credito NUMBER(4); -- Modalidad de la cuenta
      v_cod_ofi_credito NUMBER(4); -- Oficina de la cuenta
      v_nvo_est_credito VARCHAR2(1) := NULL; -- cambio de estado de cuenta
      v_nom_cta_credito VARCHAR2(100); -- Nombre de la Cta
      v_cot_credito     NUMBER(18, 4) := NULL;
      v_sal_dis_credito NUMBER(18, 2);

      -- Para Distintas monedas No habilitado todavia
      v_mto_credito   NUMBER(18, 2);
      v_mto_equ_local NUMBER(18) := NULL;
      v_cotizacion    NUMBER(18, 2) := NULL;
      v_procesa       VARCHAR2(1) := 'N'; -- indica si se puede o no procesar
      -- Cobro de servicios
      r_cobro         ge_cob_servicios%ROWTYPE;
      v_nro_ope_cxs   ge_cob_servicios.nro_operacion%TYPE;
      v_cod_servicio  NUMBER(3); -- Cod del Servicicio
      v_tip_servicio  ge_cob_ser_parametros.tip_servicio%TYPE;
      v_cod_tra_padre ge_cob_ser_parametros.cod_transaccion%TYPE; -- Cod. transaccion padre
      v_for_campo1    ge_cob_ser_parametros.for_campo1%TYPE; -- Formato campo1
      v_val_campo1    ge_cob_ser_parametros.val_campo1%TYPE; -- Valida el Campo1
      v_for_campo2    ge_cob_ser_parametros.for_campo2%TYPE; -- Formato campo2
      v_val_campo2    ge_cob_ser_parametros.val_campo2%TYPE; -- Valida el Campo2
      v_respuesta     VARCHAR2(500); -- Respuestas de la DNA y paquete de servicios
      v_nro_documento NUMBER(15);
      -- Para control de límites
      v_resLimite     typ_respuestaLimite;
      --  Tipos de Mensajes de respuestas
      msg_obt_tra_inv     CONSTANT VARCHAR2(15) := 'OBT_TRA_INV'; /** Transaccion Invalida*/
      msg_obt_cta_dup     CONSTANT VARCHAR2(15) := 'OBT_CTA_DUP'; /**Cuenta duplicada*/
      msg_obt_cta_inex    CONSTANT VARCHAR2(15) := 'OBT_CTA_INEX'; /**Cuenta inexistente*/
      msg_g_dato_inv      CONSTANT VARCHAR2(15) := 'G_DATO_INV'; /**Dato ingresado es invalido*/
      msg_g_nrocta_inv    CONSTANT VARCHAR2(15) := 'G_NROCTAINVALID'; /**Dato ingresado es invalido*/
      msg_val_fupro_r     CONSTANT VARCHAR2(15) := 'VAL_FUPRODEP_R'; /**fu_pro_deposito con error R*/
      msg_val_fupro_d     CONSTANT VARCHAR2(15) := 'VAL_FUPRODEP_D'; /**fu_pro_deposito con error D*/
      msg_val_fupro_q     CONSTANT VARCHAR2(15) := 'VAL_FUPRODEP_Q'; /**fu_pro_deposito con error Q*/
      msg_val_cta_igual   CONSTANT VARCHAR2(15) := 'VAL_CTA_IGUAL'; /**Cuenta de Crédito igual a Cuenta de Debito*/
      msg_val_mto_ticket  CONSTANT VARCHAR2(15) := 'VAL_MTO_TICKET'; /**fu_pro_deposito, Monto Total del Ticket con error. Tip_operacion TCA*/
      msg_val_mtotic_tle  CONSTANT VARCHAR2(15) := 'VAL_MTO_TIC_TLE'; /**fu_pro_dna_ticket - Monto Total del Ticket con error. Tip_operacion TLE*/
      msg_val_dna_rechazo CONSTANT VARCHAR2(15) := 'VAL_DNA_RECHAZO';
      msg_mto_invalido    CONSTANT VARCHAR2(15) := 'DNA_MTO_INVALID';
      msg_cre_mad_invalid CONSTANT VARCHAR2(15) := 'DNA_CRE_MAD_INV';
      msg_est_cre_invalid CONSTANT VARCHAR2(15) := 'DNA_EST_CRE_INV';
      msg_tra_prohibida   CONSTANT VARCHAR2(15) := 'DNA_TRA_PROHIBI';
      msg_ver_deb_error   CONSTANT VARCHAR2(15) := 'DNA_CRE_VER_OPE';
      msg_mov_pen_duplica CONSTANT VARCHAR2(15) := 'DNA_MOV_PEN_AUT';
      DNA_PER_SIN_AUT     CONSTANT VARCHAR2(15) := 'DNA_PER_SIN_AUT';

      --  ***  AGREGADOS o Modificados PARA LA NUEVA FUNCION  ***
      v_cod_operacion   VARCHAR2(3) := '033';
      v_modo            VARCHAR2(1) := p_metodo; -- modo V-validacion o C-confirmacion
      userinfo          typ_validarsesion;
      v_retorno         typ_pagoAduana := typ_pagoAduana;
      v_ver_horario     typ_mensajeRespuesta := typ_mensajeRespuesta;
      retError          typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_mensajeCaja     typ_mensajeCaja;
      v_nro_terminal  VARCHAR2(3); -- nro de terminal en el que se ingreso
      v_fec_actual    DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
      v_fec_valor     DATE := v_fec_actual;
      v_hor_actual    VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
      v_nro_secuencia NUMBER(3) := 0;
      v_horario       VARCHAR2(1);
      v_es_mov_noc    VARCHAR2(1);
      v_es_cta_noc    VARCHAR2(1);
      v_ult_cierre    DATE;
      v_permiso       typ_obtenerPermisos;
      v_msj_bitacora  VARCHAR2(200) := substr('ctaDebito:'||trim(p_cuentaDebito)
                                                          ||', modo:'||trim(p_metodo)
                                                          ||', monto:'||trim(p_monto)
                                                          ||', operacion:'||trim(p_operacion)
                                                          ||', campo1:'||trim(p_campo1)
                                                          ||', campo2:'||trim(p_campo2), 1, 200);
   BEGIN
      -- Valido la Sesión del Cliente
      userinfo := fu_validarsesion(p_sesion, p_codcanal);
      IF userinfo.error = 'S' THEN
         v_retorno.error                := userinfo.error;
         v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- validamos la caja
      v_mensajeCaja := lf_val_caja(userinfo);
      IF v_mensajeCaja.error = 'S' THEN
         v_retorno.error                := v_mensajeCaja.error;
         v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      IF nvl(p_metodo, 'x') = 'A' THEN
         -- se verifica que viene de autorizar la operacion
         IF g_aut_operacion = FALSE THEN
            pr_mensajeUsuario(msg_obt_tra_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      ELSE
         v_permiso := lf_obt_permisos(userinfo, v_cod_operacion); --nvl(userinfo.codigoEmpresa, userinfo.codigoPersona), userinfo.codigoPerfil, v_cod_operacion, userinfo.codigoCanal);
         IF (v_permiso.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
            v_retorno.error                := v_permiso.error;
            pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- se verifica que tiene permiso para registrar
         IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
            pr_mensajeUsuario(DNA_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
      pr_mensajeusuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora|| fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null ), BITACORA_ENTRADA);

      v_nro_cta_debito := depurarAlfanumerico(p_cuentadebito,CUENTA_TAMANO);
      v_monto          := to_number(p_monto);
      v_tip_operacion  := depurarAlfanumerico(p_operacion,3); -- Tipo Operacion TDA, TDI, TCA o TLE

      if v_modo = 'C' and v_can_aut_requeridas = 0 then
         -- se confirma directamente la operacion, porque no requiere autorizacion
         v_modo := 'A'; -- CONFIRMACION
      end if;

      IF v_tip_operacion IN ('TDA', 'TID') THEN
         v_campo1 :=  depurarAlfanumerico(p_campo1,18); -- Ruc Importador
         v_campo2 :=  depurarAlfanumerico(p_campo2,18); -- Ruc Despachante
      ELSIF v_tip_operacion IN ('TCA') THEN
         v_campo1 := depurarAlfanumerico(p_campo1,18); -- Nro Ticket
         v_campo2 :=  depurarAlfanumerico(p_campo2,18); -- Ruc Despachante
      ELSIF v_tip_operacion IN ('TLE') THEN
         v_campo1 := depurarAlfanumerico(p_campo1,18); -- Nro Ticket
         v_campo2 :=  depurarAlfanumerico(p_campo2,18); -- Ruc Solicitante
      END IF;

      IF v_tip_operacion = 'TDA' THEN
         v_descripcion := 'Pago de despachos aduaneros';
         v_etiqueta1   := 'Importador';
         v_etiqueta2   := 'Despachante';
      ELSIF v_tip_operacion = 'TID' THEN
         v_descripcion := 'Pago de IVA despachante';
         v_etiqueta2   := 'Despachante';
      ELSIF v_tip_operacion = 'TCA' THEN
         v_descripcion := 'Pago de canon informatico';
         v_etiqueta1   := 'Nro. Ticket';
         v_etiqueta2   := 'Despachante';
      ELSE
         -- TLE
         v_descripcion := 'Liquidacion pago de expedientes';
         v_etiqueta1   := 'Nro. Ticket';
         v_etiqueta2   := 'Solicitante';
      END IF;

      v_cod_servicio := fug_obt_pardinamico('COD_SER_SOFIA_' || v_tip_operacion);

      IF v_modo <> 'V' THEN
         v_nom_importador := depurarAlfanumerico(p_nombreImportador, 50);
         v_nom_despachante := depurarAlfanumerico(p_nombreDespachante, 50);
      END IF;

      -- 2. Busco los datos de la cuentas
      -- Busco el cobro de servicio
      BEGIN
         SELECT nro_cuenta, cod_transaccion, tip_servicio, for_campo1, val_campo1, for_campo2, val_campo2
           INTO v_nro_cta_credito, v_cod_tra_padre, v_tip_servicio, v_for_campo1, v_val_campo1, v_for_campo2, v_val_campo2
           FROM ge_cob_ser_parametros f
          WHERE cod_servicio = v_cod_servicio;
      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeusuario(msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'Error al obtener codServicio:'||v_cod_servicio||', '||v_msj_bitacora|| fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null ), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      -- Validacion de los Campos de Ruc (Importador/Despachante)
      IF v_tip_operacion = 'TDA' THEN
         pag_ser.lp_val_referencia(v_campo1, v_for_campo1, v_val_campo1);
         IF pag_ser.fu_obt_error(v_respuesta, v_respuesta) THEN
            pr_mensajeusuario(msg_g_dato_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'lp_val_referencia Campo1 - '||v_msj_bitacora||', ERR:['||substr(v_respuesta, 1, 200)||'] '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            RETURN v_retorno;
         END IF;
      END IF;
      IF v_tip_operacion IN ('TDA') THEN
         pag_ser.lp_val_referencia(v_campo2, v_for_campo2, v_val_campo2);
         IF pag_ser.fu_obt_error(v_respuesta, v_respuesta) THEN
            pr_mensajeusuario(msg_g_dato_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'lp_val_referencia Campo2 - ' ||v_msj_bitacora||', ERR:['||substr(v_respuesta, 1, 200)||'] '||fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null), bitacora_error);
            RETURN v_retorno;
         END IF;
      END IF;

      IF v_tip_operacion IN ('TID') THEN
         pag_ser.lp_val_referencia(v_campo2, v_for_campo1, v_val_campo1);
         IF pag_ser.fu_obt_error(v_respuesta, v_respuesta) THEN
            pr_mensajeusuario(msg_g_dato_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'lp_val_referencia Campo2 - ' ||v_msj_bitacora||', ERR:['||substr(v_respuesta, 1, 200)||'] '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            RETURN v_retorno;
         END IF;
      END IF;

      -- La cuenta de debito no puede ser igual a la de credito
      IF v_nro_cta_debito = v_nro_cta_credito THEN
         pr_mensajeusuario(msg_val_cta_igual, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||', ctaCredito:'||v_nro_cta_credito||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
         RETURN v_retorno;
      ELSE
         retError := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_monto, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, userinfo, v_mensajeCaja);

         IF retError.error = 'S' THEN
            v_retorno.error                := retError.error;
            v_retorno.nombreRespuesta      := retError.nombreRespuesta;
            v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
            pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'lf_val_cta_debito - ' || v_msj_bitacora|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;

      IF lf_val_cta_origen(v_nro_cta_debito, nvl(userinfo.codigoEmpresa, userinfo.codigopersona)) = 'N' THEN
         -- NO es una cuenta del cliente
         pr_mensajeusuario(msg_g_nrocta_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'lf_val_cta_origen debito - '||v_msj_bitacora|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- Si la cuenta de Debito esta Ok continuo
      -- verifico la cuenta de credito(La cuenta de la DNA)
      BEGIN
         SELECT a.cod_moneda, a.estado, cod_modalidad, cod_modulo, cod_oficina, fug_cta_formateada(cod_modulo, cod_modalidad, cod_oficina, nro_cuenta, cod_moneda) cta_formateada, denominacion
           INTO v_cod_mon_credito, v_est_cta_credito, v_cod_mad_credito, v_cod_mod_credito, v_cod_ofi_credito, v_cta_for_credito, v_nom_cta_credito
           FROM ge_cuentas a
          WHERE a.nro_cuenta = v_nro_cta_credito; -- contiene el nro de cuenta
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeusuario(msg_obt_cta_inex, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            RETURN v_retorno;
         WHEN too_many_rows THEN
            pr_mensajeusuario(msg_obt_cta_dup, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            RETURN v_retorno;
         WHEN OTHERS THEN
            pr_mensajeusuario(msg_obt_tra_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            RETURN v_retorno;
      END;

      IF v_cod_mon_credito <> v_cod_mon_debito THEN
         -- La cta de Debito debe ser la misma moneda que la cta de la DNA
         pr_mensajeusuario(msg_g_nrocta_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'Validar monedas - ' || v_msj_bitacora ||', monCredito:'||v_cod_mon_credito||', monDebito:'||v_cod_mon_debito||' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
         RETURN v_retorno;
      ELSE
         v_mto_credito := v_monto;
      END IF;

      -- Validaciones de la Cuenta de Crédito
      IF v_mto_credito <= 0 THEN
         pr_mensajeusuario(msg_mto_invalido, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'Monto Crédito Invalido - ' || v_msj_bitacora || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
         RETURN v_retorno;
      ELSIF v_cod_mad_credito NOT IN (31, 41, 334) THEN
         pr_mensajeusuario(msg_cre_mad_invalid, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||', madCredito:'||v_cod_mad_credito||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
         RETURN v_retorno;
      ELSIF v_est_cta_credito NOT IN ('A', 'I', 'N', 'S') THEN
         pr_mensajeusuario(msg_est_cre_invalid, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||', estCtaCredito:'||v_est_cta_credito||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
         RETURN v_retorno;
      ELSIF pag_cta.fu_ver_tra_prohibida(v_nro_cta_credito, v_cod_tra_padre, 9, 91) = 'S' THEN
         pr_mensajeusuario(msg_tra_prohibida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||', ctaCredito:'||v_nro_cta_credito||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
         RETURN v_retorno;
         -- elsif v_cod_mad_credito = 31 and pag_cta.fu_obt_cta_cte_comb(v_nro_cta_credito) is not null then
         -- v_cod_respuesta := paw_bce.v_cod_cta_invalida;
         -- RAMG: se anulo a pedido de L.Kublik 05/04/2010
      ELSE
         pag_cta.pr_ver_operacion(v_nro_cta_credito, v_cod_tra_padre, 9, 91, 'C', v_cod_mon_credito, v_mto_credito, v_mensajeCaja.codigoOficinaOrigen, v_cod_mod_credito, v_cod_mad_credito, v_nvo_est_credito, v_sal_dis_credito, v_procesa, 602);
         IF v_procesa = 'N' THEN
            -- no se puede debitar
            pr_mensajeusuario(msg_ver_deb_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'pr_ver_operacion - ' || v_msj_bitacora||', ctaCredito:'||v_nro_cta_credito||' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            RETURN v_retorno;
         END IF;
      END IF;

      v_campo1 := nvl(v_campo1, '0');

      -- valido la duplicacion del Pago
      DECLARE
         v_existe VARCHAR2(1);
      BEGIN
         BEGIN
            SELECT 'S'
              INTO v_existe
              FROM bw_mov_pendientes
             WHERE cod_per_principal = userinfo.codigoEmpresa
               AND nro_cuenta = v_nro_cta_debito
               AND monto = v_monto
               AND estado = 'P'
               AND cod_tip_mensaje = v_cod_operacion
               AND (dato LIKE v_campo1 || '%' OR dato2 LIKE v_campo2 || '%')
               AND trunc(fec_insercion) = trunc(SYSDATE)
               AND rownum = 1;
         EXCEPTION
            WHEN too_many_rows THEN
               v_existe := 'S';
            WHEN OTHERS THEN
               v_existe := 'N';
         END;

         IF v_existe = 'N' THEN
            -- Busca transacciones similares realizadas antes de 10 minutos
            -- Es el proceso comentado mas abajo, transformado en Función
            retError := fu_ver_transaccion(503, v_cod_tra_padre, v_nro_cta_debito, v_monto, v_mensajeCaja);
            IF retError.error = 'S' THEN
               v_retorno.error                := retError.error;
               v_retorno.nombreRespuesta      := retError.nombreRespuesta;
               v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
               pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'fu_ver_transaccion - ' ||v_msj_bitacora||', ctaCredito:'||v_nro_cta_credito||' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
         ELSE
            pr_mensajeusuario(msg_mov_pen_duplica, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'mov_pendiente - '||v_msj_bitacora||', ctaCredito:'||v_nro_cta_credito||' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            RETURN v_retorno;
         END IF;
      END;
      -- se controla el límite de operaciones
      -- no se llama en modo V para no enviar la clave dinámica si hay errores posteriores
      IF v_modo in ('C', /*'V'*/ 'A') AND nvl(p_metodo,'x') <> 'A' THEN
         v_resLimite := fu_obtenerLimite(userinfo,
                                         v_cod_operacion,
                                         nvl(userinfo.codigoEmpresa, userinfo.codigoPersona),
                                         v_nro_cta_debito,
                                         v_cod_mon_debito,
                                         503,
                                         v_cod_tra_padre,
                                         v_monto,
                                         v_modo);

         IF v_resLimite.error = 'S' THEN
            v_retorno.error := v_resLimite.error;
            v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
            pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'fu_obtenerLimite - '||v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
      -- se controlan las claves según respuesta de límites
      IF nvl(p_metodo, 'x') <> 'A' AND v_modo in ('C','A') THEN
         retError.error := 'N';
         DECLARE
            v_lugar VARCHAR2(50);
         BEGIN
            IF v_resLimite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
               v_lugar  := 'lf_obt_cla_validar - ';
               retError := lf_obt_cla_validar(p_claveTransaccional, userinfo.codigoPersona, userinfo.codigoEmpresa, 'T');
            END IF;

            IF retError.error = 'N' THEN
               IF v_resLimite.codRespuesta IN ('01', '11') THEN -- token requerido
                  v_lugar  := 'paw_seg.fu_obt_tok_validar - ';
                  retError := paw_seg.fu_obt_tok_validar(p_claveToken, userinfo.codigoPersona, userinfo.codigoEmpresa, v_modo);
               END IF;
            END IF;

            IF retError.error = 'S' THEN
               v_retorno.error := retError.error;
               v_retorno.nombreRespuesta := retError.nombreRespuesta;
               v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
               pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_lugar||v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
         END;
      END IF;

      IF v_modo = 'V' THEN
         -- validacion
         IF v_tip_operacion IN ('TDA', 'TID') THEN
            v_respuesta := pag_dna.fu_pro_deposito(v_tip_servicio, 'R', ltrim(nvl(v_nro_terminal, 999), '000'), to_number(v_nro_ope_cxs), v_campo1 /*Ruc Importador*/, v_campo2 /*Ruc Despachante*/, v_monto, v_nom_importador, v_nom_despachante);
            IF v_respuesta NOT LIKE '00-%' THEN
               -- Existe Error
               IF v_respuesta LIKE '99-%' THEN
                  pr_mensajeusuario(msg_val_fupro_r, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               ELSE
                  pr_mensajeusuario(msg_val_dna_rechazo, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
               pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'fu_pro_deposito - '||v_msj_bitacora||', resDna:'||v_respuesta, bitacora_error);
               RETURN v_retorno;
            ELSE
               pr_mensajeusuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||', resLim: ' || v_resLimite.codRespuesta || ' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);

               -- se validan los límites en modo V después del llamado a aduana, si no hay errores
               v_resLimite := fu_obtenerLimite(userinfo,
                                         v_cod_operacion,
                                         nvl(userinfo.codigoEmpresa, userinfo.codigoPersona),
                                         v_nro_cta_debito,
                                         v_cod_mon_debito,
                                         503,
                                         v_cod_tra_padre,
                                         v_monto,
                                         v_modo);

               IF v_resLimite.error = 'S' THEN
                  v_retorno.error := v_resLimite.error;
                  v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                  pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'fu_obtenerLimite - '||v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;

               v_retorno.numerocuenta      := v_nro_cta_debito;
               v_retorno.metodopedido      := v_modo;
               v_retorno.operaciondna      := v_tip_operacion;
               v_retorno.campo1            := substr(v_campo1,0, 15);
               v_retorno.campo2            := substr(v_campo2,0, 15);
               v_retorno.nombredespachante := substr(substr(v_nom_despachante, 1, 30),0, 30);
               v_retorno.nombreImportador  := substr(v_nom_importador, 1, 30);
               v_retorno.monto             := v_monto;
               -- Agregado para limites
               v_retorno.respuestalimite   := v_resLimite.codRespuesta;
               RETURN v_retorno;
            END IF;
         ELSIF v_tip_operacion = 'TCA' THEN
            v_respuesta := pag_dna.fu_pro_ticket(v_tip_servicio, 'D', ltrim(nvl(v_nro_terminal, 999), '000'), to_number(v_nro_ope_cxs), v_campo1,
                                                 -- Nro. Ticket
                                                 v_campo2,
                                                 -- Ruc Despachante
                                                 v_nom_despachante, v_mto_bol_total, v_mto_bol_efectivo, v_mto_bol_cheque);
            IF v_respuesta NOT LIKE '00-%' THEN
               -- Existe un Error
               IF v_respuesta LIKE '99-%' THEN
                  pr_mensajeusuario(msg_val_fupro_d, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               ELSE
                  pr_mensajeusuario(msg_val_dna_rechazo, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
               pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'fu_pro_ticket - '||v_msj_bitacora||', resDna:'||v_respuesta, bitacora_error);
               RETURN v_retorno;
            ELSE
               IF v_mto_bol_cheque <> 0 OR v_mto_bol_total <> v_mto_bol_efectivo THEN
                  pr_mensajeusuario(msg_val_mto_ticket, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||', mtoCheque:'||v_mto_bol_cheque||', mtoTot:'||v_mto_bol_total||', mtoEfe:'||v_mto_bol_efectivo||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                  RETURN v_retorno;
               ELSIF v_mto_bol_total <> v_monto THEN
                  pr_mensajeusuario(msg_val_mto_ticket, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||', mtoTot:'||v_mto_bol_total||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                  RETURN v_retorno;
               ELSE
                  -- se validan los límites en modo V después del llamado a aduana, si no hay errores
                  v_resLimite := fu_obtenerLimite(userinfo,
                                         v_cod_operacion,
                                         nvl(userinfo.codigoEmpresa, userinfo.codigoPersona),
                                         v_nro_cta_debito,
                                         v_cod_mon_debito,
                                         503,
                                         v_cod_tra_padre,
                                         v_monto,
                                         v_modo);

                  IF v_resLimite.error = 'S' THEN
                     v_retorno.error := v_resLimite.error;
                     v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                     v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                     pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'fu_obtenerLimite - '||v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;

                  pr_mensajeusuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);
                  v_retorno.numerocuenta := v_nro_cta_debito;
                  v_retorno.metodopedido := v_modo;
                  v_retorno.operaciondna := v_tip_operacion;
                  v_retorno.campo1       := substr(v_campo1,0, 15); -- Nro. Ticket
                  v_retorno.campo2       := substr(v_campo2,0, 15); -- Ruc Despachante

                  v_retorno.nombredespachante := substr(v_nom_despachante, 0, 30);
                  v_retorno.monto             := v_monto;
                  -- Agregado para limites
                  v_retorno.respuestalimite := v_resLimite.codRespuesta;
                  RETURN v_retorno;
               END IF;
            END IF;
         ELSE
            -- TLE
            v_respuesta := pag_dna.fu_pro_dna_ticket(v_tip_servicio, 'Q', ltrim(nvl(v_nro_terminal, 999), '000'), to_number(v_nro_ope_cxs), v_campo1,
                                                     -- Nro. Ticket
                                                     v_campo2,
                                                     -- Ruc Solicitante
                                                     v_nom_despachante, v_tip_agente, v_mto_bol_total);
            IF v_respuesta NOT LIKE '00-%' THEN
               IF v_respuesta LIKE '99-%' THEN
                  pr_mensajeusuario(msg_val_fupro_q, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               ELSE
                  pr_mensajeusuario(msg_val_dna_rechazo, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
               pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'fu_pro_dna_ticket - '||v_msj_bitacora||', resDna:'||v_respuesta, bitacora_error);
               RETURN v_retorno;
            ELSE
               IF v_mto_bol_total <> v_monto THEN
                  pr_mensajeusuario(msg_val_mtotic_tle, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||', mtoTot:'||v_mto_bol_total||' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                  RETURN v_retorno;
               ELSE
                  -- se validan los límites en modo V después del llamado a aduana, si no hay errores
                  v_resLimite := fu_obtenerLimite(userinfo,
                                         v_cod_operacion,
                                         nvl(userinfo.codigoEmpresa, userinfo.codigoPersona),
                                         v_nro_cta_debito,
                                         v_cod_mon_debito,
                                         503,
                                         v_cod_tra_padre,
                                         v_monto,
                                         v_modo);

                  IF v_resLimite.error = 'S' THEN
                     v_retorno.error := v_resLimite.error;
                     v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                     v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                     pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'fu_obtenerLimite - '||v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;

                  pr_mensajeusuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);
                  v_retorno.numerocuenta      := v_nro_cta_debito;
                  v_retorno.metodopedido      := v_modo;
                  v_retorno.operaciondna      := v_tip_operacion;
                  v_retorno.campo1            := substr(v_campo1,0, 15); -- Nro. Ticket
                  v_retorno.campo2            := substr(v_campo2,0, 15); -- Ruc Despachante
                  v_retorno.nombredespachante := substr(v_nom_despachante, 0, 30);
                  v_retorno.monto             := v_monto;
                  -- Agregado para limites
                  v_retorno.respuestalimite   := v_resLimite.codRespuesta;
                  RETURN v_retorno;
               END IF;
            END IF;
         END IF;
      ELSIF v_modo = 'C' THEN
         -- grabacion en modo pendiente
         IF v_tip_operacion IN ('TDA', 'TID') THEN
            v_dato1 := substr(v_campo1 || ' - ' || v_nom_importador, 1, 50);
            v_dato2 := substr(v_campo2 || ' - ' || v_nom_despachante, 1, 50);
         ELSIF v_tip_operacion = 'TCA' THEN
            v_dato1 := v_campo1;
            v_dato2 := substr(v_campo2 || ' - ' || v_nom_despachante, 1, 50);
         ELSE
            -- TLE
            v_dato1 := v_campo1;
            v_dato2 := substr(v_campo2 || ' - ' || v_nom_despachante, 1, 50);
         END IF;
         -- grabacion en pendiente
         --- Insertar el movimiento pendiente de autorizacion
         SELECT s_nro_documento.NEXTVAL
           INTO v_nro_documento
           FROM dual;
         INSERT INTO bw_mov_pendientes
            (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, etiqueta, dato, etiqueta2, dato2, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso/*, referencia*/)
         VALUES
            (v_nro_documento, nvl(userinfo.codigoEmpresa, userinfo.codigopersona), SYSDATE, v_cod_operacion, v_nro_cta_debito, v_cod_mon_debito, v_descripcion, v_monto, v_etiqueta1, v_dato1, v_etiqueta2, v_dato2, 'P', v_can_aut_requeridas, v_can_aut_requeridas, userinfo.codigopersona/*, v_nro_documento*/);
         v_retorno.cantAutorizadores := v_can_aut_requeridas;
         v_retorno.nroDocumento := v_nro_documento;
         -- registro del movimiento
         lp_reg_operacion(v_nro_cta_debito,
                          v_cod_mon_debito,
                          v_monto,
                          NULL,
                          NULL,
                          v_etiqueta1,
                          v_dato1,
                          v_etiqueta2,
                          v_dato2,
                          -- observacion, para que al autorizar se puedan obtener los datos
                          rpad(v_tip_operacion, 3, ' ')||rpad(v_campo1, 18, ' ')||rpad(v_campo2, 18, ' ')
                                                       ||rpad(v_nom_importador, 50, ' ')||rpad(v_nom_despachante, 50, ' '),
                          NULL, --dirIp
                          '000', -- codRespuesta
                          userinfo.codigopersona,
                          v_cod_operacion,
                          v_nro_documento,
                          p_codcanal,
                          '0',
                          userinfo.codigoempresa);
         pr_mensajeusuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);
         RETURN v_retorno;
      ELSIF v_modo = 'A' THEN
         -- confirmacion
         IF v_tip_operacion IN ('TDA', 'TID') THEN
            v_dato1    := substr(v_campo1 || ' - ' || v_nom_importador, 1, 50);
            v_dato2    := substr(v_campo2 || ' - ' || v_nom_despachante, 1, 50);
            v_concepto := 'Imp: ' || v_campo1 || ' - ' || 'Desp: ' || v_campo2;
         ELSIF v_tip_operacion = 'TCA' THEN
            v_dato1    := v_campo1;
            v_dato2    := substr(v_campo2 || ' ' || v_nom_despachante, 1, 50);
            v_concepto := 'Bol.: ' || v_campo1;
         ELSE
            -- TLE
            v_dato1    := v_campo1;
            v_dato2    := substr(v_campo2 || ' ' || v_nom_despachante, 1, 50);
            v_concepto := 'Bol.: ' || v_campo1;
         END IF;
         --- Genero el numero de operacion
         v_nro_ope_cxs := fue_obt_sig_secuencia('S_NRO_OPE_SOFIA');

         -- Cargar como cobro de servicio
         -- DDSI-265 -- 02/2018 : Se busca una hora disponible
         v_hor_actual := fug_obt_hor_disponible(v_fec_actual, v_hor_actual, user, v_es_mov_noc);

         --- Insertar el cobro del servicio
         --- cargar los datos en r_cobro antes de pasarle como parametro
         r_cobro.cod_servicio      := v_cod_servicio;
         r_cobro.tip_cobro         := 'E';
         r_cobro.nro_operacion     := v_nro_ope_cxs;
         r_cobro.fecha             := v_fec_actual;
         r_cobro.hora              := v_hor_actual;
         r_cobro.referencia1       := v_campo1;
         r_cobro.referencia2       := v_campo2;
         r_cobro.monto             := v_monto;
         r_cobro.mto_debito        := v_monto;
         r_cobro.nro_cta_debito    := v_nro_cta_debito;
         r_cobro.mto_efectivo      := 0;
         r_cobro.mto_che_nue_banco := 0;
         r_cobro.mto_che_otr_banco := 0;
         r_cobro.cod_moneda        := v_cod_mon_debito;
         r_cobro.cod_ofi_origen    := v_cod_ofi_debito;
         r_cobro.nro_caja          := to_number(v_nro_terminal);
         r_cobro.cod_usuario       := v_mensajeCaja.codigoUsuario;
         r_cobro.estado            := 'P';
         r_cobro.referencia3       := substr(v_nom_importador, 1, 50);
         r_cobro.referencia4       := substr(v_nom_despachante, 1, 50);

         --Sino hubo ERROR se arma para grabar(insertar) el cobro en ge_cob_servicios

         pag_ser.pr_ins_cobro(r_cobro, v_cod_tra_padre, 'E');

         IF pag_ser.fu_obt_error(v_respuesta, v_respuesta) THEN
            pr_mensajeusuario(msg_g_dato_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'pr_ins_cobro - ' ||v_msj_bitacora||', err:'||sqlerrm||' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            RETURN v_retorno;
         END IF;

         --Sino hubo ERROR se arma para grabar(insertar) los Mvtos
         -- seteo las variables
         v_nro_secuencia := 0;
         pag_cta.pr_set_variables(v_mensajeCaja.codigoUsuario, v_fec_valor, v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL, v_mensajeCaja.codigoOficinaOrigen, 9, 91);

         -- Esta la cuenta en condiciones, verifico el horario
         v_ver_horario := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_ult_cierre, v_mensajeCaja.codigoOficinaOrigen, v_fec_actual);

         IF (v_ver_horario.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_ver_horario.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_ver_horario.descripcionRespuesta;
            v_retorno.error                := v_ver_horario.error;
            RETURN v_retorno;
         END IF;

         -- actualizo la cuenta de debito
         IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito AND v_cod_mon_credito = v_cod_mon_local THEN
            v_cotizacion    := v_cot_debito;
            v_mto_equ_local := v_mto_credito;
         ELSE
            v_cotizacion    := NULL;
            v_mto_equ_local := NULL;
         END IF;

         pag_cta.pr_act_operacion(v_nro_cta_debito, v_hor_actual /*P_HORA*/, 'D' /*P_TIP_MOVIMIENTO*/, v_cod_mon_debito /*P_COD_MONEDA*/, v_monto /*P_MONTO*/, v_cod_tra_padre /*P_COD_TRA_PADRE*/, 503 /*P_COD_TRANSACCION*/, v_nro_ope_cxs /*P_NRO_DOCUMENTO*/, v_cotizacion /*P_COTIZACION*/, v_mensajeCaja.codigoOficinaOrigen /*P_COD_OFI_ORIGEN */, 9 /*P_COD_MOD_PADRE*/, 91 /*P_COD_MAD_PADRE*/, NULL /*P_COD_TASA*/, NULL /*P_VAL_TASA*/, v_concepto /*P_CONCEPTO*/, 'N' /*P_EMI_AVISO*/, v_nro_secuencia
                                  /*P_NRO_SECUENCIA*/, v_fec_valor /*P_FEC_VALOR*/, NULL /*P_COD_BANCO*/, NULL /*P_COD_CAUSA*/, v_mto_equ_local /*P_MTO_EQU_LOCA*/);

         IF nvl(pag_cta.g_cod_error, 0) = 0 THEN
            IF v_cod_mon_credito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito AND v_cod_mon_debito = v_cod_mon_local THEN
               v_cotizacion    := v_cot_credito;
               v_mto_equ_local := v_monto;
            ELSE
               v_cotizacion    := NULL;
               v_mto_equ_local := NULL;
            END IF;

            pag_cta.pr_act_operacion(v_nro_cta_credito /*P_NRO_CUENTA*/, v_hor_actual /*P_HORA*/, 'C' /*P_TIP_MOVIMIENTO*/, v_cod_mon_credito /*P_COD_MONEDA*/, v_mto_credito /*P_MONTO*/, v_cod_tra_padre /*P_COD_TRA_PADRE*/, 602 /*P_COD_TRANSACCION*/, v_nro_ope_cxs /*P_NRO_DOCUMENTO*/, v_cotizacion /*P_COTIZACION*/, v_mensajeCaja.codigoOficinaOrigen /*P_COD_OFI_ORIGEN*/, 9 /*P_COD_MOD_PADRE*/, 91 /*P_COD_MAD_PADRE*/, NULL /*P_COD_TASA*/, NULL /*P_VAL_TASA*/, v_concepto /*P_CONCEPTO*/, 'N' /*P_EMI_AVISO*/,
                                     v_nro_secuencia /*P_NRO_SECUENCIA*/, v_fec_valor /*P_FEC_VALOR*/, NULL /*P_COD_BANCO*/, NULL /*P_COD_CAUSA*/, v_mto_equ_local /*P_MTO_EQU_LOCA*/);

            IF nvl(pag_cta.g_cod_error, 0) <> 0 THEN
               -- hubo algun error en el credito
               pr_mensajeusuario(msg_obt_tra_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'pr_act_operacion(cre) - ' || v_msj_bitacora||', ERR:[' || substr(pag_cta.G_MSJ_ERROR, 1,200) || '] '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
               RETURN v_retorno;
            ELSE
               -- Si el Credito y el Debito fueron relizado envio a la Aduana
               IF v_tip_operacion IN ('TDA', 'TID') THEN
                  v_respuesta := pag_dna.fu_pro_deposito(v_tip_servicio, 'C', ltrim(nvl(v_nro_terminal, 999), '000'), to_number(v_nro_ope_cxs), v_campo1,
                                                         -- Ruc Importador
                                                         v_campo2,
                                                         -- Ruc Despachante
                                                         v_monto, v_nom_importador, v_nom_despachante);
                  IF v_respuesta NOT LIKE '00-%' THEN
                     -- hay error
                     pr_mensajeusuario(msg_val_dna_rechazo, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'fu_pro_deposito - ' || v_msj_bitacora||', errorDna: '||v_respuesta, bitacora_error);
                     RETURN v_retorno;
                  END IF;
               ELSIF v_tip_operacion = 'TCA' THEN
                  v_respuesta := pag_dna.fu_pro_ticket(v_tip_servicio, 'T', ltrim(nvl(v_nro_terminal, 999), '000'), to_number(v_nro_ope_cxs), v_campo1,
                                                       -- Nro. Ticket
                                                       v_campo2,
                                                       -- Ruc Despachante
                                                       v_nom_despachante, v_monto, v_mto_bol_efectivo, v_mto_bol_cheque);
                  IF v_respuesta NOT LIKE '00-%' THEN
                     -- hay error
                     pr_mensajeusuario(msg_val_dna_rechazo, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'fu_pro_ticket - ' || v_msj_bitacora||', errorDna: '||v_respuesta, bitacora_error);
                     RETURN v_retorno;
                  END IF;
               ELSE
                  -- TLE
                  v_respuesta := pag_dna.fu_pro_dna_ticket(v_tip_servicio, 'E', ltrim(nvl(v_nro_terminal, 999), '000'), to_number(v_nro_ope_cxs), v_campo1,
                                                           -- Nro. Ticket
                                                           v_campo2,
                                                           -- Ruc Solicitante
                                                           v_nom_despachante, v_tip_agente, v_monto);
                  IF v_respuesta NOT LIKE '00-%' THEN
                     -- hay error
                     pr_mensajeusuario(msg_val_dna_rechazo, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'fu_pro_dna_ticket - ' || v_msj_bitacora||', errorDna: '||v_respuesta, bitacora_error);
                     RETURN v_retorno;
                  END IF;
               END IF;
               v_retorno.nroDocumento := v_nro_ope_cxs;

               -- registro del movimiento
               lp_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/, v_cod_mon_debito /*p_cod_moneda */, v_monto /*p_monto*/, NULL /*p_nro_cta_contra*/, NULL /*p_cantidad*/, v_etiqueta1 /*p_etiqueta*/, v_dato1, /*p_dato*/ v_etiqueta2, v_dato2, 'yaguarete - aprobacion', NULL, '000', userInfo.codigoPersona, v_cod_operacion, v_nro_ope_cxs, p_codCanal, p_sesion, userInfo.codigoEmpresa);
            END IF;
         ELSE
            -- hubo algun error en el debito
            pr_mensajeusuario(msg_obt_tra_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'pr_act_operacion(deb) - ' || v_msj_bitacora|| ', ERR:[' || substr(pag_cta.G_MSJ_ERROR, 1,200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
            RETURN v_retorno;
         END IF;

      ELSE
         -- SA: 12/7/12: No es del tipo V Validacion ni C Confirmacion
         pr_mensajeusuario(msg_obt_tra_inv, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
         RETURN v_retorno;
      END IF;

      -- SA: 12/7/12: NO se responde nada, solo se debe setear el v_cod_respuesta
      pr_mensajeusuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);
      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeusuario(msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||', ERROR: '|| SQLERRM, bitacora_error);
         RETURN v_retorno;
   END;
   -- *** Pago por Despachos aduaneros(Sofia)  ***

-- validacion o confirmacion de transferencia entre cuentas
FUNCTION fu_transferenciasPropias(p_sesion             IN VARCHAR2,
                                  p_codCanal           IN VARCHAR2,
                                  p_nroCtaDebito       IN VARCHAR2,
                                  p_monto              IN NUMBER,
                                  p_nroCtaCredito      IN VARCHAR2,
                                  p_modo               IN VARCHAR2,
                                  p_concepto           IN VARCHAR2,
                                  p_cotDebito          IN NUMBER,
                                  p_cotCredito         IN NUMBER,
                                  p_mtoCredito         IN NUMBER,
                                  p_claveTransaccional IN VARCHAR2,
                                  p_claveToken         IN VARCHAR2) RETURN typ_transferenciaban IS
   TRA_CTA_CRE_DEB_IGUAL     CONSTANT VARCHAR2(15) := 'CTA_CRE_DEB_IGU';
   TRA_CTA_DEB_INVALIDA      CONSTANT VARCHAR2(15) := 'CTA_DEB_INVALID';
   TRA_CTA_CRE_INVALIDA      CONSTANT VARCHAR2(15) := 'CTA_CRE_INVALID';
   TRA_ERR_CONVERSION        CONSTANT VARCHAR2(15) := 'TRA_ERR_CONVERS';
   TRA_MTO_INVALIDO          CONSTANT VARCHAR2(15) := 'TRA_MTO_INVALID';
   TRA_MAD_CTA_CRE_INVALIDA  CONSTANT VARCHAR2(15) := 'MAD_CTA_CRE_INV';
   TRA_EST_CTA_CRE_INVALIDA  CONSTANT VARCHAR2(15) := 'EST_CTA_CRE_INV';
   TRA_CTA_CRE_PROHIBIDA     CONSTANT VARCHAR2(15) := 'CTA_CRE_PROHIBI';
   TRA_CTA_CRE_VER_OPERACION CONSTANT VARCHAR2(15) := 'CTA_CRE_VER_OPE';
   TRA_MOV_PEND_AUTORIZACION CONSTANT VARCHAR2(15) := 'TRA_MOV_PEND_AU';
   TRA_CTA_CRE_NO_ENCONTRADA CONSTANT VARCHAR2(15) := 'CTA_CRE_NO_ENCO';
   TRA_CTA_CRE_DUPLICADA     CONSTANT VARCHAR2(15) := 'CTA_CRE_DUPLICA';
   TRA_CTA_CRE_ERROR         CONSTANT VARCHAR2(15) := 'TRA_CTA_CRE_ERR';
   TRA_CTA_DEB_ERROR         CONSTANT VARCHAR2(15) := 'TRA_CTA_DEB_ERR';
   TRP_TRA_INVALIDA          CONSTANT VARCHAR2(15) := 'TRP_TRA_INVALID';
   TRP_SIN_PERMISO           CONSTANT VARCHAR2(15) := 'TRP_SIN_PERMISO';

   v_retorno        typ_transferenciaban := typ_transferenciaban;
   v_cod_operacion  VARCHAR2(3) := '030';
   retValidarSesion typ_validarSesion;
   retError         typ_mensajeRespuesta := typ_mensajeRespuesta;
   v_mensajeCaja    typ_mensajeCaja;
   v_resLimite      typ_respuestaLimite;
   v_permiso        typ_obtenerPermisos;
   -- datos recibidos
   v_nro_cta_debito  VARCHAR2(16);
   v_monto           NUMBER(18, 2); -- monto a transferir
   v_nro_cta_credito VARCHAR2(17); -- cuenta de credito
   v_modo            VARCHAR2(1); -- modo V-validacion o C-confirmacion
   -- variables
   v_cta_for_debito VARCHAR2(17); -- cuenta formateada
   v_cod_mon_debito VARCHAR2(3); -- moneda de la cuenta
   v_cod_mod_debito NUMBER(4); -- modulo de la cuenta
   v_cod_mad_debito NUMBER(4); -- modalidad de la cuenta
   v_cod_ofi_debito NUMBER(4); -- oficina de la cuenta
   v_cot_debito     ge_movimientos.cotizacion%TYPE := NULL;
   v_nom_cta_debito VARCHAR2(100);

   v_cod_mon_credito VARCHAR2(3); -- moneda de la cuenta
   v_cta_for_credito VARCHAR2(17); -- cuenta formateada
   v_est_cta_credito VARCHAR2(1); -- estado de la cuenta
   v_cod_mod_credito NUMBER(4); -- modulo de la cuenta
   v_cod_mad_credito NUMBER(4); -- modalidad de la cuenta
   v_cod_ofi_credito NUMBER(4); -- oficina de la cuenta
   v_nvo_est_credito VARCHAR2(1) := NULL; -- cambio de estado de cuenta
   v_sal_dis_credito NUMBER(18, 2);
   v_mto_credito     NUMBER(18, 2) := v_monto;
   v_cot_credito     ge_movimientos.cotizacion%TYPE := NULL;
   v_nom_cta_credito VARCHAR2(100);
   v_mto_equ_local   NUMBER(18) := NULL;

   v_cod_tra_padre   NUMBER(4) := 388; -- cod. transaccion padre
   v_procesa         VARCHAR2(1) := 'N'; -- indica si se puede o no procesar
   v_cotizacion      NUMBER(18, 2) := NULL;
   v_nro_documento   NUMBER(15);
   v_nro_doc_credito VARCHAR2(20) := NULL; -- nro de documento del acreditado
   v_concepto        VARCHAR2(100);

   -- agregados
   v_fec_valor     DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
   v_hor_actual    VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
   v_nro_operacion NUMBER(10); -- nro unico de operacion generado por el cliente
   v_nro_secuencia NUMBER(3);
   -- para lp_ver_operacion
   v_horario    VARCHAR2(1);
   v_es_mov_noc VARCHAR2(1);
   v_es_cta_noc VARCHAR2(1);
   v_res_notificacion NUMBER(3);
   v_res_noti_mail number(3);--respuesta de notificacion por mail
   v_fec_actual DATE;
   --
   v_msj_bitacora  VARCHAR2(700) := substr('ctaDebito:'||trim(p_nroCtaDebito)
                                                       ||', mto:'||p_monto
                                                       ||', ctaCredito:'||trim(p_nroCtaCredito)
                                                       ||', modo:'||trim(p_modo)
                                                       ||', cpto:'||depurarTextos(p_concepto, 35)
                                                       ||', cotDeb:'||p_cotDebito
                                                       ||', cotCre:'||p_cotCredito
                                                       ||', mtoCre:'||p_mtoCredito, 1, 200);

BEGIN
   --valido la sesión del cliente
   retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);
   IF retValidarSesion.error = 'S' THEN
      v_retorno.error                := retValidarSesion.error;
      v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      RETURN v_retorno;
   END IF;
   -- validamos la caja
   v_mensajeCaja := lf_val_caja(retValidarSesion);
   IF v_mensajeCaja.error = 'S' THEN
      v_retorno.error                := v_mensajeCaja.error;
      v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
      RETURN v_retorno;
   END IF;

   IF nvl(p_modo, 'x') = 'A' THEN
      IF g_aut_operacion = FALSE THEN
         pr_mensajeUsuario(TRP_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      v_cotizacion         := p_cotDebito;
      v_mto_credito        := p_mtoCredito;
      v_cot_debito         := p_cotDebito;
      v_cot_credito        := p_cotCredito;
   ELSE
      v_permiso := lf_obt_permisos(retValidarSesion, v_cod_operacion);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- se verifica que tenga permiso para registrar
      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
         pr_mensajeUsuario(TRP_SIN_PERMISO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
   END IF;

   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
   pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ENTRADA);

   -- 0. inicializo la secuencia
   v_nro_secuencia := 0;

   v_nro_cta_debito := depurarAlfanumerico(p_nroCtaDebito,CUENTA_TAMANO);
   v_nro_cta_credito := depurarAlfanumerico(p_nroCtaCredito,CUENTA_TAMANO);
   v_monto           := nvl(p_monto, 0); -- monto a transferir
   v_modo            := p_modo; -- modo V-validacion o C-confirmacion

   IF p_concepto IS NOT NULL THEN
      v_concepto := depurarTextos(p_concepto, 35);
   END IF;

   IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
      -- se confirma directamente la operacion, porque no requiere autorizacion
      v_modo := 'A'; -- CONFIRMACION
   END IF;

   -- 2. busco los datos de la cuentas
   IF v_retorno.error = 'N' THEN
      -- verifico cuenta de debito
      IF v_nro_cta_debito = v_nro_cta_credito THEN
         pr_mensajeUsuario(TRA_CTA_CRE_DEB_IGUAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      ELSE
       --SDPARDEBAU-2-MB: Se envia la Cta. de Credito para validar el saldo de ambas cuentas. Si ambos son negativos (Sin Tener en cuenta la LS) detener el proceso.
         retError := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_monto, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, retValidarSesion, v_mensajeCaja, null, null, v_nro_cta_credito);

         -- si es programado, no tener en cuenta error de saldo en la verificacion
         IF v_modo = 'P' AND retError.nombreRespuesta = 'COD_SAL_INSUF' THEN
            retError.error := 'N';
         END IF;

         IF retError.error = 'S' THEN
            v_retorno.error                := retError.error;
            v_retorno.nombreRespuesta      := retError.nombreRespuesta;
            v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_debito - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END IF;

         IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
            -- se confirma directamente la operacion, porque no requiere autorizacion
            v_modo := 'A'; -- CONFIRMACION
         END IF;

         IF v_retorno.error = 'N' THEN
            IF lf_val_cta_origen(v_nro_cta_debito, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)) = 'N' THEN
               -- no es una cuenta del cliente
               pr_mensajeUsuario(TRA_CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_origen(deb) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            END IF;
         END IF;

         IF v_retorno.error = 'N' THEN
            --Solamente cuentas de la misma persona
            IF lf_val_cta_origen(v_nro_cta_credito, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)) = 'N' THEN
               -- no es una cuenta del cliente
               pr_mensajeUsuario(TRA_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_origen(cre) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            END IF;
         END IF;
      END IF;

      IF v_retorno.error = 'N' THEN
         -- cuenta de credito
         BEGIN
            SELECT a.cod_moneda, a.estado, cod_modalidad, cod_modulo, cod_oficina, fug_cta_formateada(cod_modulo, cod_modalidad, cod_oficina, nro_cuenta, cod_moneda) cta_formateada, denominacion
              INTO v_cod_mon_credito, v_est_cta_credito, v_cod_mad_credito, v_cod_mod_credito, v_cod_ofi_credito, v_cta_for_credito, v_nom_cta_credito
              FROM ge_cuentas a
             WHERE a.nro_cuenta = v_nro_cta_credito; -- contiene el nro de cuenta
            -- credito
            IF v_cod_mon_credito <> v_cod_mon_debito THEN
               IF nvl(p_modo, 'x') <> 'A' THEN
                  BEGIN
                     pr_con_mon_a_moneda(v_cod_mon_debito, v_cod_mon_credito, v_monto, v_mto_credito, v_cot_debito, v_cot_credito);
                  EXCEPTION
                     WHEN OTHERS THEN
                        pr_mensajeUsuario(TRA_ERR_CONVERSION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lp_con_mon_a_moneda - ' || v_msj_bitacora || ', monDeb:' || v_cod_mon_debito || ', monCre:' || v_cod_mon_credito || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  END;
               END IF;
               IF v_cod_mon_debito <> v_cod_mon_local THEN
                  v_cotizacion := v_cot_debito;
               ELSE
                  v_cotizacion := v_cot_credito;
               END IF;
            ELSE
               v_mto_credito := v_monto;
            END IF;

            IF v_retorno.error = 'N' THEN
               IF v_mto_credito <= 0 THEN
                  pr_mensajeUsuario(TRA_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSIF v_cod_mad_credito NOT IN (31, 41, 334) THEN
                  pr_mensajeUsuario(TRA_MAD_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', madCredito: ' || v_cod_mad_credito || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSIF v_est_cta_credito NOT IN ('A', 'I', 'N', 'S') THEN
                  pr_mensajeUsuario(TRA_EST_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', estCtaCredito: ' || v_est_cta_credito || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSIF pag_cta.fu_ver_tra_prohibida(v_nro_cta_credito, v_cod_tra_padre, 9, 91) = 'S' THEN
                  pr_mensajeUsuario(TRA_CTA_CRE_PROHIBIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', codTraPadre: ' || v_cod_tra_padre || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSE
                  pag_cta.pr_ver_operacion(v_nro_cta_credito, v_cod_tra_padre, 9, 91, 'C', v_cod_mon_credito, v_mto_credito, v_mensajeCaja.codigoOficinaOrigen, v_cod_mod_credito, v_cod_mad_credito, v_nvo_est_credito, v_sal_dis_credito, v_procesa, 602);
                  IF v_procesa = 'N' THEN
                     -- no se puede debitar
                     pr_mensajeUsuario(TRA_CTA_CRE_VER_OPERACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'pr_ver_operacion(cre) - ERR: [' || substr(pag_cta.G_MSJ_ERROR, 1, 100) || ']'  || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  ELSIF v_nro_doc_credito IS NOT NULL AND lf_cta_valida(v_nro_cta_credito, v_nro_doc_credito, retValidarSesion, retError) = 'N' THEN
                     -- no se puede acreditar a la cuenta de este nro de documento
                     IF retError.error = 'S' THEN
                        v_retorno.error                := retError.error;
                        v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                        v_retorno.nombreRespuesta      := retError.nombreRespuesta;
                     ELSE
                        pr_mensajeUsuario(TRA_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     END IF;
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_cta_valida(cre) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  END IF;
               END IF;
            END IF;

            IF v_retorno.error = 'N' THEN
               -- valido la duplicacion de transferencias
               DECLARE
                  v_existe VARCHAR2(1);
               BEGIN
                  BEGIN
                     SELECT 'S'
                       INTO v_existe
                       FROM bw_mov_pendientes
                      WHERE cod_per_principal = retValidarSesion.codigoEmpresa
                        AND nro_cuenta = v_nro_cta_debito
                        AND monto = v_monto
                        AND estado = 'P'
                        AND cod_tip_mensaje = v_cod_operacion
                        AND nro_cta_contra = v_nro_cta_credito
                        AND trunc(fec_insercion) = trunc(SYSDATE)
                        AND rownum = 1;
                  EXCEPTION
                     WHEN too_many_rows THEN
                        v_existe := 'S';
                     WHEN OTHERS THEN
                        v_existe := 'N';
                  END;

                  IF v_existe = 'N' THEN
                     retError := fu_ver_transaccion(503, v_cod_tra_padre, v_nro_cta_debito, v_monto, v_mensajeCaja);

                     IF retError.error = 'S' THEN
                        v_retorno.error                := retError.error;
                        v_retorno.nombreRespuesta      := retError.nombreRespuesta;
                        v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                     END IF;
                  ELSE
                     pr_mensajeUsuario(TRA_MOV_PEND_AUTORIZACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  END IF;
               END;
            END IF;
         EXCEPTION
            WHEN no_data_found THEN
               pr_mensajeUsuario(TRA_CTA_CRE_NO_ENCONTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            WHEN too_many_rows THEN
               pr_mensajeUsuario(TRA_CTA_CRE_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            WHEN OTHERS THEN
               pr_mensajeUsuario(TRA_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END;
         -- se agrega control de límite de operaciones
         IF v_retorno.error = 'N' THEN
           IF v_modo in ('C', 'V', 'A') AND nvl(p_modo,'x') <> 'A' THEN
              v_resLimite := fu_obtenerLimite(retValidarSesion,
                                              v_cod_operacion,
                                              nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                                              v_nro_cta_debito,
                                              v_cod_mon_debito,
                                              503,
                                              v_cod_tra_padre,
                                              v_monto,
                                              v_modo);

              IF v_resLimite.error = 'S' THEN
                 v_retorno.error := v_resLimite.error;
                 v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                 v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              END IF;
           END IF;
        END IF;
        -- se validan las claves según respuesta de límites
        IF v_retorno.error = 'N' THEN
          IF nvl(p_modo, 'x') <> 'A' AND v_modo in ('C','A') THEN
            retError.error := 'N';
            DECLARE
              v_lugar VARCHAR2(50);
            BEGIN
              IF v_resLimite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
                 v_lugar  := 'lf_obt_cla_validar - ';
                 retError := lf_obt_cla_validar(p_claveTransaccional, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, 'T');
              END IF;

              IF retError.error = 'N' THEN
                 IF v_resLimite.codRespuesta IN ('01', '11') THEN -- token requerido
                    v_lugar  := 'paw_seg.fu_obt_tok_validar - ';
                    retError := paw_seg.fu_obt_tok_validar(p_claveToken, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, v_modo);
                 END IF;
              END IF;

              IF retError.error = 'S' THEN
                 v_retorno.error := retError.error;
                 v_retorno.nombreRespuesta := retError.nombreRespuesta;
                 v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_lugar || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              END IF;
            END;
          END IF;
        END IF;

         IF v_retorno.error = 'N' THEN
            -- no hay problemas hasta aquí
            IF v_modo IN ('V', 'P') THEN
               -- validación
               v_retorno.cotizacion       := v_cot_debito;
               v_retorno.cotizacionCredito:= v_cot_credito;
               v_retorno.ctaForDebito     := substr(v_cta_for_debito,0, 17);
               v_retorno.nombreCtaDebito  := substr(v_nom_cta_debito,0, 50);
               v_retorno.codMonDebito     := substr(v_cod_mon_debito,0, 3);
               v_retorno.monto            := v_monto;
               v_retorno.ctaForCredito    := substr(v_cta_for_credito,0, 17);
               v_retorno.nombreCtaCredito := substr(v_nom_cta_credito,0, 50);
               v_retorno.codMonCredito    := substr(v_cod_mon_credito,0, 3);
               v_retorno.montoCredito     := v_mto_credito;
               v_retorno.tipTransferencia := '0';
               v_retorno.tipPedido        := v_modo;
               v_retorno.resLimite        := v_resLimite.codRespuesta;

               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', resLim: ' || v_resLimite.codRespuesta || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);

               RETURN v_retorno;

            ELSIF v_modo = 'C' THEN
               -- grabacion en pendiente
               IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito AND v_cod_mon_credito = v_cod_mon_local THEN
                  v_mto_equ_local := v_mto_credito;
               ELSE
                  v_mto_equ_local := NULL;
               END IF;
               --- inserto el movimiento pendiente de autorizacion
               SELECT s_nro_documento.NEXTVAL
                 INTO v_nro_documento
                 FROM dual;
               INSERT INTO bw_mov_pendientes
                  (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cotizacion, mto_equ_local, nro_cta_contra, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra, cot_contra, etiqueta, dato, etiqueta2, dato2)
               VALUES
                  (v_nro_documento, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito, v_cod_mon_debito, 'Transferencia entre Cuentas', v_monto, v_cot_debito, v_mto_equ_local, v_nro_cta_credito, 'P', v_can_aut_requeridas, v_can_aut_requeridas, retValidarSesion.codigoPersona, v_mto_credito, v_cot_credito, 'Nro.Identificacion', v_nro_doc_credito, 'Concepto',
                   substr(v_concepto, 0, 50));
               -- registro del movimiento

               v_retorno.tipPedido         := v_modo;
               v_retorno.cantAutorizadores := v_can_aut_requeridas;
               v_retorno.nroDocumento      := v_nro_documento;
               v_retorno.tipTransferencia  := '0';

               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', autReq: ' || v_can_aut_requeridas || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);

               RETURN v_retorno;
            ELSIF v_modo = 'A' THEN
               -- confirmacion de operacion
               -- seteo las variables
               v_nro_secuencia := 0;
               pag_cta.PR_SET_VARIABLES(v_mensajeCaja.codigoUsuario, v_fec_valor, v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL, v_mensajeCaja.codigoOficinaOrigen, 9, 91);
               -- esta la cuenta en condiciones, verifico el horario
               retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre,
                                           -- IN
                                          v_mensajeCaja.codigoOficinaOrigen,
                                           -- IN
                                          v_fec_actual);

               if retError.error = 'S' then
                  v_retorno.error := retError.error;
                  v_retorno.nombreRespuesta := retError.nombreRespuesta;
                  v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lp_ver_horario - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  return v_retorno;
               end if;
               -- actualizo la cuenta de debito
               -- 10/05/2011 Ajustes segun AP-1617 Soporte IT
               v_mto_equ_local := NULL;
               IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito THEN
                  v_cotizacion := v_cot_debito;
                  IF v_cod_mon_credito = v_cod_mon_local THEN
                     v_mto_equ_local := v_mto_credito;
                  ELSE
                     v_mto_equ_local := round(v_cot_debito * v_monto, 0);
                  END IF;
               ELSE
                  v_cotizacion    := NULL;
                  v_mto_equ_local := NULL;
               END IF;
               -- genero el numero de operacion
               SELECT s_nro_ope_homebanking.NEXTVAL
                 INTO v_nro_operacion
                 FROM dual;
               --
               -- DDSI-265 -- 02/2018 : Se busca una hora disponible
               v_hor_actual := fug_obt_hor_disponible(v_fec_actual, v_hor_actual, user, v_es_mov_noc);
               pag_cta.PR_ACT_OPERACION(v_nro_cta_debito, v_hor_actual, 'D', v_cod_mon_debito, v_monto, v_cod_tra_padre, 503, v_nro_operacion, v_cotizacion, v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */, 9, 91, NULL, NULL,'Transf. entre cuentas a ' || v_nro_cta_credito || ' - ' || v_concepto, 'N', v_nro_secuencia, v_fec_valor, NULL, NULL, v_mto_equ_local);
               IF nvl(pag_cta.g_cod_error, 0) = 0 THEN
                  IF v_cod_mon_credito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito THEN

                     v_cotizacion := v_cot_credito;
                     IF v_cod_mon_debito = v_cod_mon_local THEN
                        v_mto_equ_local := v_monto;
                     ELSE
                        v_mto_equ_local := round(v_mto_credito * v_cot_credito, 0);
                     END IF;
                  ELSE
                     v_cotizacion    := NULL;
                     v_mto_equ_local := NULL;
                  END IF;
                  pag_cta.PR_ACT_OPERACION(v_nro_cta_credito, v_hor_actual, 'C', v_cod_mon_credito, v_mto_credito, v_cod_tra_padre, 602, v_nro_operacion, v_cot_credito, v_mensajeCaja.codigoOficinaOrigen, 9, 91, NULL, NULL, 'Transf. entre cuentas de ' || v_nro_cta_debito || ' - ' || v_concepto, 'N', v_nro_secuencia, v_fec_valor, NULL, NULL, v_mto_equ_local);
                  v_retorno.nroDocumento      := v_nro_operacion;

                  IF nvl(pag_cta.g_cod_error, 0) <> 0 THEN
                     -- hubo error en el credito
                     pr_mensajeUsuario(TRA_CTA_CRE_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'pr_act_operacion(cre) - ' || v_msj_bitacora || ', cot:' || v_cotizacion || ', ERR:[' || substr(pag_cta.G_MSJ_ERROR, 1,200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  ELSE
                     /*Notificar evento*/
                     -- Notificacion al debito
                     BEGIN
                        v_res_notificacion:=PAW_NOT.fu_not_transferencias(v_nro_cta_debito, v_monto, v_cod_mon_debito, 'D', v_fec_valor);
                     EXCEPTION
                        WHEN OTHERS THEN
                           NULL;
                     END;
                     --Notificacion al credito
                     BEGIN
                        v_res_notificacion:=PAW_NOT.fu_not_transferencias(v_nro_cta_credito, v_mto_credito, v_cod_mon_credito, 'C', v_fec_valor);
                     EXCEPTION
                        WHEN OTHERS THEN
                           NULL;
                     END;

                     /*
                       CANREQVAR - 612
                       Notificacion via mail a clientes BBVA por transf entre cuentas y Terceros.
                     */
                     BEGIN
                        v_res_noti_mail := paw_not.fu_not_mail_transferencias(v_nro_cta_debito,
                                                                              v_nro_cta_credito,
                                                                              v_cod_mon_debito,
                                                                              v_cod_mon_credito,
                                                                              v_cod_operacion, -- '030' = Transf. a Terceros
                                                                              v_monto,   -- monto debito
                                                                              v_mto_credito,
                                                                              v_fec_valor);
                        v_msj_bitacora := v_msj_bitacora || ', notMail:'||v_res_noti_mail;
                     EXCEPTION
                        WHEN OTHERS THEN
                           NULL;
                     END;
                     -- registro del movimiento
                     lp_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/,
                        v_cod_mon_debito /*p_cod_moneda */,
                        v_monto          /*p_monto*/,
                        v_nro_cta_credito /*p_nro_cta_contra*/,
                        NULL              /*p_cantidad*/,
                        NULL /*p_etiqueta*/,
                        v_res_notificacion   /*p_dato*/,
                       'Cotizacion'      /*p_etiqueta2*/,
                       v_cotizacion      /*p_dato2*/,
                       'Yaguarete'       /*observacion*/,
                       NULL          /*direccion IP*/,
                       '000',
                       retValidarSesion.codigopersona,
                       v_cod_operacion,
                       v_nro_operacion,
                       p_codcanal,
                       p_sesion,
                       retValidarSesion.codigoempresa);
                  END IF;
               ELSE
                  -- hubo error en el debito
                  pr_mensajeUsuario(TRA_CTA_DEB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'pr_act_operacion(deb) - ' || v_msj_bitacora || ', ERR: [' || substr(pag_cta.G_MSJ_ERROR, 1,200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               END IF;
            END IF;
         END IF;
      END IF;
   END IF;
   -- registro del movimiento

   IF v_retorno.error = 'N' THEN
      -- si hubo error, ya se registro mas arriba
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
   END IF;

   RETURN v_retorno;
EXCEPTION
   WHEN OTHERS THEN
      pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || 'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      RETURN v_retorno;
END;
-- fin validacion o confirmacion de transferencia entre cuentas

-- validacion o confirmacion de transferencia entre cuentas de diferentes titulares
FUNCTION fu_transferenciasTerceros(p_sesion             IN VARCHAR2,
                                   p_codCanal           IN VARCHAR2,
                                   p_nroCtaDebito       IN VARCHAR2,
                                   p_monto              IN NUMBER,
                                   p_nroCtaCredito      IN VARCHAR2,
                                   p_codMonCredito      IN VARCHAR2,
                                   p_modo               IN VARCHAR2,
                                   p_nroDocCredito      IN VARCHAR2,
                                   p_concepto           IN VARCHAR2,
                                   p_nroContrato        IN NUMBER,
                                   p_claveTransaccional IN VARCHAR2,
                                   p_claveToken         IN VARCHAR2) RETURN typ_transferenciaban IS
   TRA_CTA_CRE_DEB_IGUAL     CONSTANT VARCHAR2(15) := 'CTA_CRE_DEB_IGU';
   TRA_CTA_DEB_INVALIDA      CONSTANT VARCHAR2(15) := 'CTA_DEB_INVALID';
   TRA_CTA_CRE_INVALIDA      CONSTANT VARCHAR2(15) := 'CTA_CRE_INVALID';
   TRA_CTA_CRE_DOC_INVA      CONSTANT VARCHAR2(15) := 'CTA_CRE_DOC_INV';
   TRA_MTO_INVALIDO          CONSTANT VARCHAR2(15) := 'TRA_MTO_INVALID';
   TRA_MAD_CTA_CRE_INVALIDA  CONSTANT VARCHAR2(15) := 'MAD_CTA_CRE_INV';
   TRA_EST_CTA_CRE_INVALIDA  CONSTANT VARCHAR2(15) := 'EST_CTA_CRE_INV';
   TRA_CTA_CRE_PROHIBIDA     CONSTANT VARCHAR2(15) := 'CTA_CRE_PROHIBI';
   TRA_CTA_CRE_VER_OPERACION CONSTANT VARCHAR2(15) := 'CTA_CRE_VER_OPE';
   TRA_MOV_PEND_AUTORIZACION CONSTANT VARCHAR2(15) := 'TRA_MOV_PEND_AU';
   TRA_CTA_CRE_NO_ENCONTRADA CONSTANT VARCHAR2(15) := 'CTA_CRE_NO_ENCO';
   TRA_CTA_CRE_DUPLICADA     CONSTANT VARCHAR2(15) := 'CTA_CRE_DUPLICA';
   TRA_CTA_CRE_ERROR         CONSTANT VARCHAR2(15) := 'TRA_CTA_CRE_ERR';
   TRA_CTA_DEB_ERROR         CONSTANT VARCHAR2(15) := 'TRA_CTA_DEB_ERR';
   TRT_TRA_INVALIDA          CONSTANT VARCHAR2(15) := 'TRP_TRA_INVALID';
   TRT_SIN_PERMISO           CONSTANT VARCHAR2(15) := 'TRT_SIN_PERMISO';
   MSG_HORA_INVA             CONSTANT VARCHAR2(15) := 'HORA_INVA';   -- horario cambio pre pacatado invalido
   MSG_CONCAM_INVA           CONSTANT VARCHAR2(15) := 'CONCAM_INVA'; -- contrato de Cambio invalido
   MSG_ERR_CONVERS           CONSTANT VARCHAR2(15) := 'ERR_CONVERS'; -- Error de conversion
   MSG_MTO_INVALIDO          CONSTANT VARCHAR2(15) := 'MTO_INVALIDO'; -- Monto invalido
   MSG_MON_CTACRE_INVALIDA   CONSTANT VARCHAR2(15) := 'MON_CRE_INVALID'; -- cod moneda cta cre invalida
   MSG_TRA_CTA_BAS_LIM       CONSTANT VARCHAR2(15) := 'TRA_CTA_BAS_LIM'; -- mensaje cuenta basica supera el limite de credito

   -- datos recibidos
   v_nro_cta_debito  VARCHAR2(16);
   v_monto           NUMBER(18, 2); -- monto a transferir
   v_nro_cta_credito VARCHAR2(17); -- cuenta de credito
   v_modo            VARCHAR2(1); -- modo V-validacion o C-confirmacion
   -- variables
   v_cta_for_debito VARCHAR2(17); -- cuenta formateada
   v_cod_mon_debito VARCHAR2(3); -- moneda de la cuenta
   v_cod_mod_debito NUMBER(4); -- modulo de la cuenta
   v_cod_mad_debito NUMBER(4); -- modalidad de la cuenta
   v_cod_ofi_debito NUMBER(4); -- oficina de la cuenta
   v_den_cta_debito ge_modalidades.descripcion%TYPE; -- denominacion cta debito
   v_cot_debito     ge_movimientos.cotizacion%TYPE := NULL;
   v_nom_cta_debito VARCHAR2(100);

   v_cod_mon_credito VARCHAR2(3); -- moneda de la cuenta
   v_cta_for_credito VARCHAR2(17); -- cuenta formateada
   v_est_cta_credito VARCHAR2(1); -- estado de la cuenta
   v_cod_mod_credito NUMBER(4); -- modulo de la cuenta
   v_cod_mad_credito NUMBER(4); -- modalidad de la cuenta
   v_den_cta_credito ge_modalidades.descripcion%TYPE; -- denominacion cta credito
   v_cod_ofi_credito NUMBER(4); -- oficina de la cuenta
   v_nvo_est_credito VARCHAR2(1) := NULL; -- cambio de estado de cuenta
   v_sal_dis_credito NUMBER(18, 2);
   v_mto_credito     NUMBER(18, 2) := v_monto;
   v_cot_credito     ge_movimientos.cotizacion%TYPE := NULL;
   v_nom_cta_credito VARCHAR2(100);
   v_mto_equ_local   NUMBER(18) := NULL;

   v_cod_tra_padre   NUMBER(4) := 388; -- cod. transaccion padre
   v_procesa         VARCHAR2(1) := 'N'; -- indica si se puede o no procesar
   v_nro_documento   NUMBER(15);
   v_nro_doc_credito VARCHAR2(20) := NULL; -- nro de documento del acreditado
   v_concepto VARCHAR2(100);
   v_resLimite      typ_respuestaLimite;
   v_permiso        typ_obtenerPermisos;
   --
   v_retorno        typ_transferenciaban := typ_transferenciaban;
   v_cod_operacion  VARCHAR2(3) := '039';
   retValidarSesion typ_validarSesion;
   retError         typ_mensajeRespuesta := typ_mensajeRespuesta;
   v_nro_secuencia  NUMBER(3);
   v_mensajeCaja    typ_mensajeCaja;
   v_fec_valor      DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
   v_hor_actual     VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
   v_nro_operacion  NUMBER(10); -- nro unico de operacion generado por el cliente
   v_cod_persona    ge_clientes.cod_persona%TYPE; -- codigo de cliente empresa o persona

   -- para lp_ver_operacion
   v_horario    VARCHAR2(1);
   v_es_mov_noc VARCHAR2(1);
   v_es_cta_noc VARCHAR2(1);
   v_fec_actual DATE;
   v_res_notificacion NUMBER(3);
   v_res_noti_mail NUMBER(3);--respuesta de notificacion por mail
   v_cod_respuesta NUMBER;
   --
   v_nro_ope_cambio      NUMBER(15); -- nro operacion de cambio
   v_nro_contrato_cambio NUMBER(7) := nvl(p_nroContrato, 0); -- contrato cambio pre pactado

   v_msj_bitacora  VARCHAR2(1000) := substr('ctaDebito:'||trim(p_nroCtaDebito)
                                                       ||', mto:'||p_monto
                                                       ||', ctaCredito:'||trim(p_nroCtaCredito)
                                                       ||', modo:'||trim(p_modo)
                                                       ||', nroDocCredito:'||trim(p_nroDocCredito)
                                                       ||', cpto:'||depurarTextos(p_concepto, 35)
                                                       ||', nroContrato:' || nvl(p_nroContrato, 0)
                                                       ||', monCtaCred:' || nvl(p_codMonCredito, ''), 1, 200);
BEGIN
   --valido la sesión del cliente
   retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);
   IF retValidarSesion.error = 'S' THEN
      v_retorno.error                := retValidarSesion.error;
      v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      RETURN v_retorno;
   END IF;
   -- validamos la caja
   v_mensajeCaja := lf_val_caja(retValidarSesion);
   IF v_mensajeCaja.error = 'S' THEN
      v_retorno.error                := v_mensajeCaja.error;
      v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
      RETURN v_retorno;
   END IF;

   v_modo            := NVL( SUBSTR(p_modo,0,1), 'x');

   IF nvl(p_modo, 'x') = 'A' THEN
      IF g_aut_operacion = FALSE THEN
         pr_mensajeUsuario(TRT_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
   ELSE
     IF p_modo <> 'VC' THEN
        -- controlamos los permisos
        v_permiso := lf_obt_permisos(retValidarSesion, v_cod_operacion);
        IF (v_permiso.error = 'S') THEN
           v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
           v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
           v_retorno.error                := v_permiso.error;
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
        -- se verifica que posea permiso para registrar
        IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
           pr_mensajeUsuario(TRT_SIN_PERMISO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
      ELSE
        v_can_aut_requeridas := 1;  -- evita error de cta conjunta para empresas
      END IF;
   END IF;

   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
   pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '|| fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ENTRADA);

   -- 0. inicializo la secuencia
   v_nro_secuencia := 0;

   v_nro_cta_credito := depurarAlfanumerico(p_nroCtaCredito,CUENTA_TAMANO);
   v_nro_cta_debito  := depurarAlfanumerico(p_nroCtaDebito,CUENTA_TAMANO);
   v_monto           := p_monto; -- monto a transferir
   v_cod_persona     := NVL(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);

   -- nro de documento del acreditado
   IF p_nroDocCredito IS NOT NULL THEN
      v_nro_doc_credito := depurarTextos(p_nroDocCredito, 20);
   ELSE
      pr_mensajeUsuario(TRA_CTA_CRE_DOC_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
   END IF;

   IF p_concepto IS NOT NULL THEN
      v_concepto := depurarTextos(p_concepto, 35);
   END IF;

   IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
      -- se confirma directamente la operacion, porque no requiere autorizacion
      v_modo := 'A'; -- CONFIRMACION
   END IF;

   -- 2. busco los datos de la cuentas
   IF v_retorno.error = 'N' THEN
      -- verifico cuenta de debito
      IF v_nro_cta_debito = v_nro_cta_credito THEN
         pr_mensajeUsuario(TRA_CTA_CRE_DEB_IGUAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora|| ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END IF;
      BEGIN
         SELECT c.cod_moneda
           INTO v_cod_mon_debito
           FROM ge_cuentas c
          WHERE c.nro_cuenta = v_nro_cta_debito;
      END;

      IF v_retorno.error = 'N' THEN
         -- cuenta de credito
         BEGIN
            SELECT a.cod_moneda, a.estado, cod_modalidad, cod_modulo, cod_oficina, fug_cta_formateada(cod_modulo, cod_modalidad, cod_oficina, nro_cuenta, cod_moneda) cta_formateada, denominacion
              INTO v_cod_mon_credito, v_est_cta_credito, v_cod_mad_credito, v_cod_mod_credito, v_cod_ofi_credito, v_cta_for_credito, v_nom_cta_credito
              FROM ge_cuentas a
             WHERE a.nro_cuenta = v_nro_cta_credito; -- contiene el nro de cuenta
            IF v_modo IN ('V', 'P') THEN
               IF nvl(p_codMonCredito, v_cod_mon_debito) <> v_cod_mon_credito THEN
                  pr_mensajeUsuario(MSG_MON_CTACRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,
                     v_msj_bitacora || ' - ' ||
                     fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;
            END IF;

            IF v_cod_mon_credito <> v_cod_mon_debito THEN
               IF v_nro_contrato_cambio <> 0 THEN -- con contrato pre pactado
                  v_cod_respuesta := paw_bas.fu_val_contrato(
                           v_cod_mon_debito, v_cod_mon_credito, v_nro_contrato_cambio, v_cod_persona, 45, v_nro_doc_credito,
                           v_nro_ope_cambio, v_monto, v_mto_credito, v_cot_debito, v_cot_credito, v_mto_equ_local,
                           v_retorno.tipOperacion);
                  v_msj_bitacora := v_msj_bitacora || ', mtoCon:' || v_monto || ', mtoCreCon:'|| v_mto_credito;
                  CASE v_cod_respuesta
                     WHEN 0 THEN
                        NULL;
                     WHEN -1 THEN
                        pr_mensajeUsuario(MSG_HORA_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     WHEN -2 THEN
                        pr_mensajeUsuario(MSG_CONCAM_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     WHEN -3 THEN
                        pr_mensajeUsuario(MSG_CONCAM_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     WHEN -4 THEN
                        pr_mensajeUsuario(MSG_CONCAM_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     ELSE
                        pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  END CASE;

                  IF v_cod_respuesta <> 0 THEN
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,
                           v_msj_bitacora || ' - ' ||
                           fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;
               ELSE -- sin cambio pre practado
                  BEGIN
                     pr_con_mon_a_moneda(
                        v_cod_mon_debito,
                        v_cod_mon_credito,
                        v_monto,
                        v_mto_credito,
                        v_cot_debito,
                        v_cot_credito);
                  EXCEPTION
                     WHEN OTHERS THEN
                        pr_mensajeUsuario(MSG_ERR_CONVERS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,
                           v_msj_bitacora || ' - ' ||
                           fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                           BITACORA_ERROR);
                     RETURN v_retorno;
                  END;

                  IF v_mto_credito <= 0 OR v_monto <= 0 THEN
                     pr_mensajeUsuario(MSG_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,
                                     v_msj_bitacora || ' - ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;
               END IF;
            ELSE
               v_mto_credito := v_monto;
               v_den_cta_credito := fug_obt_des_modal(v_cod_mod_credito, v_cod_mad_credito);
            END IF;
            -- se valida el monto debito contra la cuenta debito
            retError := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_monto, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, retValidarSesion, v_mensajeCaja);

            -- si es programado, no tener en cuenta error de saldo en la verificacion
            IF v_modo = 'P' AND retError.nombreRespuesta = 'COD_SAL_INSUF' THEN
               retError.error := 'N';
            END IF;

            IF retError.error = 'S' THEN
               v_retorno.error                := retError.error;
               v_retorno.nombreRespuesta      := retError.nombreRespuesta;
               v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_debito - ' || v_msj_bitacora||' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            END IF;
            IF v_retorno.error = 'N' THEN
               IF lf_val_cta_origen(v_nro_cta_debito, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)) = 'N' THEN
                  -- no es una cuenta del cliente
                  pr_mensajeUsuario(TRA_CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_origen(ctaDeb) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSE
                  v_den_cta_debito := fug_obt_des_modal(v_cod_mod_debito, v_cod_mad_debito);
               END IF;
            END IF;
            IF v_retorno.error = 'N' THEN
               IF lf_val_cta_origen(v_nro_cta_credito, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)) = 'S' THEN
                  -- es una cuenta del cliente en una transferencia a terceros
                  IF PAW_UTI.fu_es_juridica(v_nro_cta_credito, retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona) = 'N' THEN
                     pr_mensajeUsuario(TRA_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_origen(ctaCre) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  END IF;
               END IF;
            END IF;
            IF v_retorno.error = 'N' THEN
               IF v_mto_credito <= 0 THEN
                  pr_mensajeUsuario(TRA_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSIF v_cod_mad_credito NOT IN (31, 41, 334) THEN
                  pr_mensajeUsuario(TRA_MAD_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', madCredito:' || v_cod_mad_credito || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSIF v_est_cta_credito NOT IN ('A', 'I', 'N', 'S') THEN
                  pr_mensajeUsuario(TRA_EST_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', estCtaCredito:' || v_est_cta_credito || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSIF pag_cta.fu_ver_tra_prohibida(v_nro_cta_credito, v_cod_tra_padre, 9, 91) = 'S' THEN
                  pr_mensajeUsuario(TRA_CTA_CRE_PROHIBIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', codTraPadre: '|| v_cod_tra_padre || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSE
                  pag_cta.pr_ver_operacion(v_nro_cta_credito, v_cod_tra_padre, 9, 91, 'C', v_cod_mon_credito, v_mto_credito, v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */, v_cod_mod_credito, v_cod_mad_credito, v_nvo_est_credito, v_sal_dis_credito, v_procesa, 602);
                  IF v_procesa = 'N' THEN
                     -- no se puede debitar
                     pr_mensajeUsuario(TRA_CTA_CRE_VER_OPERACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'pr_ver_operacion(cre) - ' || v_msj_bitacora || ', codTraPadre: ' || v_cod_tra_padre || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  ELSIF v_nro_doc_credito IS NOT NULL AND lf_cta_valida(v_nro_cta_credito, v_nro_doc_credito, retValidarSesion, retError) = 'N' THEN
                     -- no se puede acreditar a la cuenta de este nro de documento
                     IF retError.error = 'S' THEN
                        v_retorno.error                := retError.error;
                        v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                        v_retorno.nombreRespuesta      := retError.nombreRespuesta;
                     ELSE
                        pr_mensajeUsuario(TRA_CTA_CRE_DOC_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     END IF;
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_cta_valida - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  END IF;
               END IF;
            END IF;

            IF v_retorno.error = 'N' THEN
               -- valido la duplicacion de transferencias
               DECLARE
                  v_existe VARCHAR2(1);
               BEGIN
                  -- si se autoriza desde EMA, puede ser una autorizacion multiple con mismo monto debito y cuenta,
                  -- no es necesario controlar duplicado en ese caso porque hubo una validacion previa en la carga
                  IF nvl(p_modo, 'x') <> 'A' OR fuw_obt_mov_pen_encolado(retValidarSesion.codigoEmpresa, v_cod_operacion, v_nro_cta_debito, v_monto, v_nro_cta_credito) <> 'S' THEN

                     BEGIN
                        SELECT 'S'
                          INTO v_existe
                          FROM bw_mov_pendientes
                         WHERE cod_per_principal = retValidarSesion.codigoEmpresa
                           AND nro_cuenta = v_nro_cta_debito
                           AND monto = v_monto
                           AND estado = 'P'
                           AND cod_tip_mensaje = v_cod_operacion
                           AND nro_cta_contra = v_nro_cta_credito
                           AND trunc(fec_insercion) = trunc(SYSDATE)
                           AND rownum = 1;
                     EXCEPTION
                        WHEN too_many_rows THEN
                           v_existe := 'S';
                        WHEN OTHERS THEN
                           v_existe := 'N';
                     END;

                     IF v_existe = 'N' THEN
                        retError := fu_ver_transaccion(503, v_cod_tra_padre, v_nro_cta_debito, v_monto, v_mensajeCaja);
                        IF retError.error = 'S' THEN
                           v_retorno.error                := retError.error;
                           v_retorno.nombreRespuesta      := retError.nombreRespuesta;
                           v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                        END IF;
                     ELSE
                        IF p_modo <> 'VC' THEN  -- modo verificar cotizacion, para actualizar cotizacion en autorizar operacion, no debe dar error por duplicado
                           pr_mensajeUsuario(TRA_MOV_PEND_AUTORIZACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                        END IF;
                     END IF;
                  END IF;
               END;
            END IF;
         EXCEPTION
            WHEN no_data_found THEN
               pr_mensajeUsuario(TRA_CTA_CRE_NO_ENCONTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            WHEN too_many_rows THEN
               pr_mensajeUsuario(TRA_CTA_CRE_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            WHEN OTHERS THEN
               pr_mensajeUsuario(TRA_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END;

     -- validacion de cuenta basica a transferir
         IF fug_val_cta_basica(v_nro_cta_credito, v_cod_tra_padre, 9, 91, 602, v_cod_mod_credito, v_cod_mad_credito, v_mto_credito, v_cod_mon_credito) <> 0 THEN
           pr_mensajeUsuario(MSG_TRA_CTA_BAS_LIM, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fug_val_cta_basica - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END IF;

         -- se agrega control de límite de operaciones
         IF v_retorno.error = 'N' THEN
            IF v_modo in ('C', 'V', 'A') AND nvl(p_modo,'x') <> 'A' THEN
              IF nvl(p_modo,'x') <> 'VC' THEN
               v_resLimite := fu_obtenerLimite(retValidarSesion,
                                               v_cod_operacion,
                                               nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                                               v_nro_cta_debito,
                                               v_cod_mon_debito,
                                               503,
                                               v_cod_tra_padre,
                                               v_monto,
                                               v_modo);

               IF v_resLimite.error = 'S' THEN
                  v_retorno.error := v_resLimite.error;
                  v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora ||' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   END IF;
               END IF;
            END IF;
         END IF;
         -- se validan las claves según respuesta de límites
         IF v_retorno.error = 'N' THEN
           IF nvl(p_modo, 'x') <> 'A' AND v_modo in ('C','A') THEN
             retError.error := 'N';
             DECLARE
               v_lugar VARCHAR2(50);
             BEGIN
               IF v_resLimite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
                  v_lugar  := 'lf_obt_cla_validar - ';
                  retError := lf_obt_cla_validar(p_claveTransaccional, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, 'T');
               END IF;

               IF retError.error = 'N' THEN
                  IF v_resLimite.codRespuesta IN ('01', '11') THEN -- token requerido
                     v_lugar  := 'paw_seg.fu_obt_tok_validar - ';
                     retError := paw_seg.fu_obt_tok_validar(p_claveToken, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, v_modo);
                  END IF;
               END IF;

            IF retError.error = 'S' THEN
               v_retorno.error                := retError.error;
               v_retorno.nombreRespuesta      := retError.nombreRespuesta;
               v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_lugar || v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               END IF;
             END;
            END IF;
         END IF;

         IF v_retorno.error = 'N' THEN
            -- no hay problemas hasta aqui
            IF v_modo IN ('V', 'P') THEN
               -- validacion
               v_retorno.cotizacion       := v_cot_debito;
               v_retorno.cotizacionCredito := v_cot_credito;
               v_retorno.ctaForDebito     := substr(v_cta_for_debito,0, CUENTA_TAMANO);
               v_retorno.nombreCtaDebito  := substr(v_nom_cta_debito,0, 50);
               v_retorno.codMonDebito     := substr(rpad(v_cod_mon_debito, 3, ' '),0, 3);
               v_retorno.monto            := v_monto;
               v_retorno.ctaForCredito    := substr(v_cta_for_credito,0, CUENTA_TAMANO);
               v_retorno.nombreCtaCredito := substr(v_nom_cta_credito,0, 50);
               v_retorno.codMonCredito    := substr(rpad(v_cod_mon_credito, 3, ' '),0, 3);
               v_retorno.montoCredito     := v_mto_credito;
               v_retorno.resLimite        := v_resLimite.codRespuesta;
               v_retorno.tipTransferencia := '1';
               v_retorno.tipPedido        := v_modo;
               v_retorno.denominacionCtaDebito := substr(v_den_cta_debito, 1, 50);
               v_retorno.denominacionCtaCredito := substr(v_den_cta_credito, 1, 50);

               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', resLim: ' || v_resLimite.codRespuesta || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);

               RETURN v_retorno;
               --
            ELSIF v_modo = 'C' THEN
               IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito AND v_cod_mon_credito = v_cod_mon_local THEN
                  v_mto_equ_local := v_mto_credito;
               ELSE
                  v_mto_equ_local := NULL;
               END IF;
               --- inserto el movimiento pendiente de autorizacion
               SELECT s_nro_documento.NEXTVAL
                 INTO v_nro_documento
                 FROM dual;
               INSERT INTO bw_mov_pendientes
                  (nro_documento,
                  cod_per_principal,
                  fec_hora,
                  cod_tip_mensaje,
                  nro_cuenta,
                  cod_moneda,
                  descripcion,
                  monto,
                  cotizacion,
                  mto_equ_local,
                  nro_cta_contra,
                  estado,
                  can_aut_requeridas,
                  can_aut_faltantes,
                  cod_per_ingreso,
                  mto_contra,
                  cot_contra,
                  etiqueta,
                  dato,
                  etiqueta2,
                  dato2,
                  referencia)
               VALUES
                  (v_nro_documento,
                  nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                  SYSDATE,
                  v_cod_operacion,
                  v_nro_cta_debito,
                  v_cod_mon_debito,
                  'Transferencia entre Cuentas de Terceros',
                  v_monto,
                  v_cot_debito,
                  v_mto_equ_local,
                  v_nro_cta_credito,
                  'P',
                  v_can_aut_requeridas,
                  v_can_aut_requeridas,
                  retValidarSesion.codigoPersona /* v_cod_persona */,
                  v_mto_credito,
                  v_cot_credito,
                  'Nro.Identificacion',
                  v_nro_doc_credito,
                  'Concepto',
                  substr(v_concepto, 0, 50),
                  v_nro_contrato_cambio);

               v_retorno.tipPedido         := v_modo;
               v_retorno.cantAutorizadores := v_can_aut_requeridas;
               v_retorno.nroDocumento      := v_nro_documento;
               v_retorno.tipTransferencia  := '1';

               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);

               RETURN v_retorno;
            ELSIF v_modo = 'A' THEN
               v_retorno.cotizacion       := v_cot_debito;
               v_retorno.cotizacionCredito := v_cot_credito;
               -- confirmacion de operacion
               -- seteo las variables
               v_nro_secuencia := 0;
               pag_cta.PR_SET_VARIABLES(v_mensajeCaja.codigoUsuario, v_fec_valor, v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL, v_mensajeCaja.codigoOficinaOrigen, 9, 91);
               -- esta la cuenta en condiciones, verifico el horario
               retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre, v_mensajeCaja.codigoOficinaOrigen, v_fec_actual);
               if retError.error = 'S' then
                  v_retorno.error := retError.error;
                  v_retorno.nombreRespuesta := retError.nombreRespuesta;
                  v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lp_ver_horario - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  return v_retorno;
               end if;

               -- genero el numero de operacion
               SELECT s_nro_ope_homebanking.NEXTVAL
                 INTO v_nro_operacion
                 FROM dual;
               --
               IF v_cod_mon_credito <> v_cod_mon_debito THEN
                  v_mto_equ_local := NULL;
                  IF v_cod_mon_debito <> v_cod_mon_local THEN
                     IF v_cod_mon_credito = v_cod_mon_local THEN
                        v_mto_equ_local := v_mto_credito;
                     ELSE
                        v_mto_equ_local := round(v_monto * v_cot_debito, 0);
                     END IF;
                  END IF;
               END IF;

               -- DDSI-265 -- 02/2018 : Se busca una hora disponible
               v_hor_actual := fug_obt_hor_disponible(v_fec_actual, v_hor_actual, user, v_es_mov_noc);
               pag_cta.PR_ACT_OPERACION(
                  v_nro_cta_debito,
                  v_hor_actual,
                  'D',
                  v_cod_mon_debito,
                  v_monto,
                  v_cod_tra_padre,
                  503,
                  v_nro_operacion,
                  v_cot_debito,
                  v_mensajeCaja.codigoOficinaOrigen,
                  9,
                  91,
                  NULL,
                  NULL,
                  -- para limites de operaciones mantener el concepto 'Transf. a ' || nro_cuenta || ' desde '
                  'Transf. terceros a ' || v_nro_cta_credito || ' desde ' || v_nro_cta_debito || ' - ' || v_concepto,
                  'N',
                  v_nro_secuencia,
                  v_fec_valor,
                  NULL,
                  NULL,
                  v_mto_equ_local);

               IF nvl(pag_cta.g_cod_error, 0) = 0 THEN
                  IF v_cod_mon_credito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito THEN
                     IF v_cod_mon_debito = v_cod_mon_local THEN
                        v_mto_equ_local := v_monto;
                     ELSE
                        v_mto_equ_local := round(v_mto_credito * v_cot_credito, 0);
                     END IF;
                  ELSE
                     v_mto_equ_local := NULL;
                  END IF;


                  pag_cta.PR_ACT_OPERACION(
                     v_nro_cta_credito,
                     v_hor_actual,
                     'C',
                     v_cod_mon_credito,
                     v_mto_credito,
                     v_cod_tra_padre,
                     602,
                     v_nro_operacion,
                     v_cot_credito,
                     v_mensajeCaja.codigoOficinaOrigen,
                     9,
                     91,
                     NULL,
                     NULL,
                    'Transf. terceros a ' || v_nro_cta_credito || ' desde ' || v_nro_cta_debito || ' - ' || v_concepto,
                     'N',
                     v_nro_secuencia,
                     v_fec_valor,
                     NULL,
                     NULL,
                     v_mto_equ_local);

                   v_retorno.nroDocumento      := v_nro_operacion;
                  IF nvl(pag_cta.g_cod_error, 0) <> 0 THEN
                     -- hubo error en el credito
                     pr_mensajeUsuario(TRA_CTA_CRE_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'pr_act_operacion(cre) - ' || v_msj_bitacora || ', ERR:[' || substr(pag_cta.G_MSJ_ERROR, 1,200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  ELSE
                     IF v_nro_contrato_cambio <> 0 then
                         paw_bas.pr_liq_ope_cambio(v_mensajeCaja.codigoUsuario, v_nro_cta_debito, v_monto, v_cod_mon_debito, v_cod_mon_credito, v_nro_ope_cambio);
                     END IF;

                        /*Notificar evento*/
                      -- Notificacion al debito
                      BEGIN
                         v_res_notificacion:=PAW_NOT.fu_not_transferencias(v_nro_cta_debito, v_monto, v_cod_mon_debito, 'D', v_fec_valor);
                      EXCEPTION
                         WHEN OTHERS THEN
                            NULL;
                      END;
                      --Notificacion al credito
                      BEGIN
                         v_res_notificacion:=PAW_NOT.fu_not_transferencias(v_nro_cta_credito, v_mto_credito, v_cod_mon_credito, 'C', v_fec_valor);
                      EXCEPTION
                         WHEN OTHERS THEN
                            NULL;
                      END;
                      /*
                       CANREQVAR - 612
                       Notificacion via mail a clientes BBVA por transf entre cuentas y Terceros.
                      */
                      BEGIN
                        v_res_noti_mail := paw_not.fu_not_mail_transferencias(v_nro_cta_debito,
                                                                                v_nro_cta_credito,
                                                                                v_cod_mon_debito,
                                                                                v_cod_mon_credito,
                                                                                v_cod_operacion, -- 039 = Transf. a Terceros
                                                                                v_monto,   -- monto debito
                                                                                v_mto_credito,
                                                                                v_fec_valor);
                        v_msj_bitacora := v_msj_bitacora || ', notMail:' || v_res_noti_mail;
                      EXCEPTION
                        WHEN OTHERS THEN
                           NULL;
                      END;
                     -- registro del movimiento
                     lp_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/,
                        v_cod_mon_debito /*p_cod_moneda */,
                        v_monto          /*p_monto*/,
                        v_nro_cta_credito /*p_nro_cta_contra*/,
                        NULL              /*p_cantidad*/,
                        NULL /*p_etiqueta*/,
                        v_res_notificacion   /*p_dato*/,
                       'Cotizacion'      /*p_etiqueta2*/,
                       v_cot_debito      /*p_dato2*/,
                       'Yaguarete'||v_cot_credito /*observacion*/,
                       NULL          /*direccion IP*/,
                       '000',
                       retValidarSesion.codigopersona,
                       v_cod_operacion,
                       v_nro_operacion,
                       p_codcanal,
                       p_sesion,
                       retValidarSesion.codigoempresa);
                  END IF;
               ELSE
                  -- hubo error en el debito
                  pr_mensajeUsuario(TRA_CTA_DEB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'pr_act_operacion(deb) - ' || v_msj_bitacora || ', ERR:[' || substr(pag_cta.G_MSJ_ERROR, 1,200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               END IF;
            END IF;
         END IF;
      END IF;
   END IF;

   IF v_retorno.error = 'N' THEN
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
   END IF;

   RETURN v_retorno;
END;
-- fin de confirmacion de transferencia entre cuentas de diferentes titulares

-- validacion o confirmacion de transferencia entre cuentas con contrato de cambio
FUNCTION fu_transferenciasConContrato(p_sesion             IN VARCHAR2,
                                      p_codCanal           IN VARCHAR2,
                                      p_nroCtaDebito       IN VARCHAR2,
                                      p_nroCtaCredito      IN VARCHAR2,
                                      p_modo               IN VARCHAR2,
                                      p_nroContrato        IN NUMBER,
                                      p_dirIP              IN VARCHAR2,
                                      p_claveTransaccional IN VARCHAR2,
                                      p_claveToken         IN VARCHAR2) RETURN typ_transferenciaban IS
   TRA_CTA_CRE_DEB_IGUAL     CONSTANT VARCHAR2(15) := 'CTA_CRE_DEB_IGU';
   TRA_CTA_DEB_INVALIDA      CONSTANT VARCHAR2(15) := 'CTA_DEB_INVALID';
   TRA_CTA_CRE_INVALIDA      CONSTANT VARCHAR2(15) := 'CTA_CRE_INVALID';
   TRA_MAD_CTA_CRE_INVALIDA  CONSTANT VARCHAR2(15) := 'MAD_CTA_CRE_INV';
   TRA_EST_CTA_CRE_INVALIDA  CONSTANT VARCHAR2(15) := 'EST_CTA_CRE_INV';
   TRA_CTA_CRE_PROHIBIDA     CONSTANT VARCHAR2(15) := 'CTA_CRE_PROHIBI';
   TRA_CTA_CRE_VER_OPERACION CONSTANT VARCHAR2(15) := 'CTA_CRE_VER_OPE';
   TRA_CTA_CRE_ERROR         CONSTANT VARCHAR2(15) := 'TRA_CTA_CRE_ERR';
   TRA_CTA_DEB_ERROR         CONSTANT VARCHAR2(15) := 'TRA_CTA_DEB_ERR';
   TRA_SIN_AUTORIZACION      CONSTANT VARCHAR2(15) := 'TRA_SIN_AUTORIZ';
   TRA_HOR_OPE_INVAL         CONSTANT VARCHAR2(15) := 'TRA_HOR_OPE_INV';
   TRA_CONTRATO_INVALIDO     CONSTANT VARCHAR2(15) := 'TRA_CON_INVALID';
   TRC_TRA_INVALIDA          CONSTANT VARCHAR2(15) := 'TRP_TRA_INVALID';
   -- datos recibidos
   v_nro_cta_debito  VARCHAR2(16);
   v_nro_cta_credito VARCHAR2(17); -- cuenta de credito
   v_modo            VARCHAR2(1); -- modo V-validacion o C-confirmacion
   -- variables
   v_cta_for_debito  VARCHAR2(17); -- cuenta formateada
   v_cod_mon_debito  VARCHAR2(3); -- moneda de la cuenta
   v_cod_mod_debito NUMBER(4); -- modulo de la cuenta
   v_cod_mad_debito NUMBER(4); -- modalidad de la cuenta
   v_cod_ofi_debito NUMBER(4); -- oficina de la cuenta
   v_nom_cta_debito VARCHAR2(100);

   v_nro_contrato  NUMBER(10);
   v_nro_operacion NUMBER(10);
   v_cod_mon_credito  VARCHAR2(3); -- moneda de la cuenta
   v_cta_for_credito  VARCHAR2(17); -- cuenta formateada
   v_est_cta_credito  VARCHAR2(1); -- estado de la cuenta
   v_cod_mod_credito  NUMBER(4); -- modulo de la cuenta
   v_cod_mad_credito  NUMBER(4); -- modalidad de la cuenta
   v_cod_ofi_credito  NUMBER(4); -- oficina de la cuenta
   v_nvo_est_credito  VARCHAR2(1) := NULL; -- cambio de estado de cuenta
   v_sal_dis_credito  NUMBER(18, 2);
   v_mto_credito      NUMBER(18, 2);
   v_nom_cta_credito VARCHAR2(100);
   v_mto_equ_local   NUMBER(18) := NULL;
   v_mto_debito      NUMBER(18, 2);
   v_cod_tra_padre   NUMBER(4) := 388; -- cod. transaccion padre
   v_procesa         VARCHAR2(1) := 'N'; -- indica si se puede o no procesar
   v_cotizacion      ge_movimientos.cotizacion%TYPE := NULL;
   v_cot_credito     ge_movimientos.cotizacion%TYPE := NULL;
   v_nro_documento   NUMBER(15);
   v_nro_doc_credito VARCHAR2(20) := NULL; -- nro de documento del acreditado
   v_concepto        VARCHAR2(35);
   v_tip_operacion   VARCHAR2(1); -- Tipo operacion
   v_dir_ip          VARCHAR2(20);
   v_des_operacion   VARCHAR2(10);
   v_retorno          typ_transferenciaban := typ_transferenciaban;
   v_cod_operacion    VARCHAR2(3) := '214';
   retValidarSesion   typ_validarSesion;
   retError           typ_mensajeRespuesta := typ_mensajeRespuesta;
   v_nro_secuencia    NUMBER(3);
   v_mensajeCaja      typ_mensajeCaja;
   retObtenerPermisos typ_obtenerPermisos;
   v_fec_valor        DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
   v_horario          VARCHAR2(1);
   v_hor_actual       VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
   -- para lp_ver_operacion
   v_es_mov_noc       VARCHAR2(1);
   v_es_cta_noc       VARCHAR2(1);
   v_fec_actual       DATE;
   v_resLimite        typ_respuestaLimite;
   v_cod_respuesta    NUMBER;
   v_res_notificacion NUMBER(3);--respuesta de notificaciones
   v_cod_per_debito   ba_personas.cod_persona%type;
   v_cod_per_credito  ba_personas.cod_persona%type;
   v_msj_bitacora     VARCHAR2(200) := substr('ctaDebito:'||trim(p_nroCtaDebito)
                                                          ||', ctaCredito:'||trim(p_nroCtaCredito)
                                                          ||', modo:'||trim(p_modo)
                                                          ||', nroContrato:'||p_nroContrato
                                                          ||', nroIp:'||p_dirIP, 1, 200);

BEGIN
   --valido la sesión del cliente
   retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);
   IF retValidarSesion.error = 'S' THEN
      v_retorno.error                := retValidarSesion.error;
      v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      RETURN v_retorno;
   END IF;
   -- validamos la caja
   v_mensajeCaja := lf_val_caja(retValidarSesion);
   IF v_mensajeCaja.error = 'S' THEN
      v_retorno.error                := v_mensajeCaja.error;
      v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
      RETURN v_retorno;
   END IF;
   IF nvl(p_modo, 'x') = 'A' THEN
      IF g_aut_operacion = FALSE THEN
         pr_mensajeUsuario(TRC_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
   ELSE
      retObtenerPermisos := lf_obt_permisos(retValidarSesion, v_cod_operacion);
      IF retObtenerPermisos.error = 'S' THEN
         pr_mensajeUsuario(TRA_SIN_AUTORIZACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- se verifica que tenga permiso para registrar
      IF retObtenerPermisos.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
         pr_mensajeUsuario(TRA_SIN_AUTORIZACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
   END IF;

   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

   pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ENTRADA);

   -- 0. inicializo la secuencia
   v_nro_secuencia := 0;
   v_nro_cta_debito := depurarAlfanumerico(p_nroCtaDebito,CUENTA_TAMANO);
   v_nro_cta_credito := depurarAlfanumerico(p_nroCtaCredito,CUENTA_TAMANO);
   v_modo            := nvl(p_modo, 'x'); -- modo V-validacion o C-confirmacion
   v_nro_contrato    := p_nroContrato;
   v_dir_ip          := p_dirIP;

   -- 1. valido la clave del cliente
   IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
      -- se confirma directamente la operacion, porque no requiere autorizacion
      v_modo := 'A'; -- CONFIRMACION
   END IF;
   -- obtenemos los datos de la cuenta credito
   BEGIN
      SELECT a.cod_moneda, a.estado, cod_modalidad, cod_modulo, cod_oficina, fug_cta_formateada(cod_modulo, cod_modalidad, cod_oficina, nro_cuenta, cod_moneda) cta_formateada, denominacion
        INTO v_cod_mon_credito, v_est_cta_credito, v_cod_mad_credito, v_cod_mod_credito, v_cod_ofi_credito, v_cta_for_credito, v_nom_cta_credito
        FROM ge_cuentas a
       WHERE a.nro_cuenta = v_nro_cta_credito; -- contiene el nro de cuenta
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(TRA_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;
   -- obtenemos la moneda de la cuenta debito
   BEGIN
      SELECT a.cod_moneda
        INTO v_cod_mon_debito
        FROM ge_cuentas a
       WHERE a.nro_cuenta = v_nro_cta_debito;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(TRA_CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   IF v_retorno.error = 'N' THEN
      -- validar contrato de cambio
      v_cod_respuesta := paw_bas.fu_val_contrato(v_cod_mon_debito, v_cod_mon_credito, v_nro_contrato, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), 45, NULL,
                           v_nro_operacion, v_mto_debito, v_mto_credito, v_cotizacion, v_cot_credito,
                           v_mto_equ_local, v_retorno.tipOperacion);
      v_msj_bitacora := v_msj_bitacora || ', mtoCon:' || v_mto_debito || ', mtoCreCon:'|| v_mto_credito;
      IF v_cod_respuesta = -1 THEN
         pr_mensajeUsuario(TRA_HOR_OPE_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      ELSIF v_cod_respuesta <> 0 THEN
         pr_mensajeUsuario(TRA_CONTRATO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END IF;

      IF v_retorno.error = 'N' THEN
         -- verifico cuenta de debito
         IF v_nro_cta_debito = v_nro_cta_credito THEN
            pr_mensajeUsuario(TRA_CTA_CRE_DEB_IGUAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         ELSE
            retError := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_mto_debito, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, retValidarSesion, v_mensajeCaja);

            IF retError.error = 'S' AND v_retorno.error = 'N' THEN
               v_retorno.error                := retError.error;
               v_retorno.nombreRespuesta      := retError.nombreRespuesta;
               v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_debito - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            END IF;
         END IF;

         -- se valida que la cuenta debito pertenezca al cliente
         IF v_retorno.error = 'N' THEN
            IF lf_val_cta_origen(v_nro_cta_debito, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)) = 'N' THEN
               -- no es una cuenta del cliente
               pr_mensajeUsuario(TRA_CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_origen(deb) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            END IF;
         END IF;

         IF v_retorno.error = 'N' THEN
            -- se valida que la cuenta credito pertenezca al cliente
            IF v_retorno.error = 'N' THEN
               IF lf_val_cta_origen(v_nro_cta_credito, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)) = 'N' THEN
                  -- no es una cuenta del cliente
                  pr_mensajeUsuario(TRA_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_origen(cre) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               END IF;
            END IF;

            IF v_retorno.error = 'N' THEN
               IF v_cod_mad_credito NOT IN (31, 41, 334) THEN
                  pr_mensajeUsuario(TRA_MAD_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', madCredito: ' || v_cod_mad_credito || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSIF v_est_cta_credito NOT IN ('A', 'I', 'N', 'S') THEN
                  pr_mensajeUsuario(TRA_EST_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', estCre: ' || v_est_cta_credito || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSIF pag_cta.fu_ver_tra_prohibida(v_nro_cta_credito, v_cod_tra_padre, 9, 91) = 'S' THEN
                  pr_mensajeUsuario(TRA_CTA_CRE_PROHIBIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', codTraPadre: ' || v_cod_tra_padre || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               ELSE
                  pag_cta.pr_ver_operacion(v_nro_cta_credito, v_cod_tra_padre, 9, 91, 'C', v_cod_mon_credito, v_mto_credito, v_mensajeCaja.codigoOficinaOrigen, v_cod_mod_credito, v_cod_mad_credito, v_nvo_est_credito, v_sal_dis_credito, v_procesa, 602);
                  IF v_procesa = 'N' THEN
                     -- no se puede debitar
                     pr_mensajeUsuario(TRA_CTA_CRE_VER_OPERACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'pr_ver_operacion(cre) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  ELSIF v_nro_doc_credito IS NOT NULL AND lf_cta_valida(v_nro_cta_credito, v_nro_doc_credito, retValidarSesion, retError) = 'N' THEN
                     -- no se puede acreditar a la cuenta de este nro de documento
                     IF retError.error = 'S' THEN
                        v_retorno.error                := retError.error;
                        v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                        v_retorno.nombreRespuesta      := retError.nombreRespuesta;
                     ELSE
                        pr_mensajeUsuario(TRA_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     END IF;
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_cta_valida(cre) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  END IF;
               END IF;
            END IF;
         END IF;
      END IF;
   END IF;
   -- se controla el límite de operaciones
   IF v_retorno.error = 'N' THEN
      IF v_modo in ('C', 'V', 'A') AND nvl(p_modo,'x') <> 'A' THEN
         v_resLimite := fu_obtenerLimite(retValidarSesion,
                                         v_cod_operacion,
                                         nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                                         v_nro_cta_debito,
                                         v_cod_mon_debito,
                                         503,
                                         v_cod_tra_padre,
                                         v_mto_debito,
                                         v_modo);

         IF v_resLimite.error = 'S' THEN
            v_retorno.error := v_resLimite.error;
            v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fu_obtenerLimite: ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END IF;
      END IF;
   END IF;
   -- se controlan las claves según respuesta de límites
   IF v_retorno.error = 'N' THEN
      IF nvl(p_modo, 'x') <> 'A' AND v_modo in ('C','A') THEN
         retError.error := 'N';
         DECLARE
            v_lugar VARCHAR2(50);
         BEGIN
            IF v_resLimite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
               v_lugar  := 'lf_obt_cla_validar - ';
               retError := lf_obt_cla_validar(p_claveTransaccional, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, 'T');
            END IF;

            IF retError.error = 'N' THEN
               IF v_resLimite.codRespuesta IN ('01', '11') THEN -- token requerido
                  v_lugar  := 'paw_seg.fu_obt_tok_validar - ';
                  retError := paw_seg.fu_obt_tok_validar(p_claveToken, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, v_modo);
               END IF;
            END IF;

            IF retError.error = 'S' THEN
               v_retorno.error := retError.error;
               v_retorno.nombreRespuesta := retError.nombreRespuesta;
               v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_lugar || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            END IF;
         END;
      END IF;
   END IF;

   IF v_retorno.error = 'N' THEN
      -- no hay problemas hasta aqui
      IF v_modo = 'V' THEN
         -- validacion
         v_retorno.nroContrato      := v_nro_contrato;
         v_retorno.cotizacion       := v_cotizacion;
         v_retorno.cotizacionCredito:= v_cot_credito;
         v_retorno.monto            := v_mto_debito;
         v_retorno.ctaForDebito     := substr(v_cta_for_debito,0, 17);
         v_retorno.nombreCtaDebito  := substr(v_nom_cta_debito,0, 50);
         v_retorno.codMonDebito     := substr(v_cod_mon_debito,0, 3);
         v_retorno.ctaForCredito    := substr(v_cta_for_credito,0, 17);
         v_retorno.nombreCtaCredito := substr(v_nom_cta_credito,0, 50);
         v_retorno.codMonCredito    := substr(v_cod_mon_credito,0, 3);
         v_retorno.montoCredito     := v_mto_credito;
         v_retorno.tipPedido        := v_modo;
         v_retorno.tipTransferencia := '2';
         v_retorno.resLimite        := v_resLimite.codRespuesta;

         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', resLim: ' || v_resLimite.codRespuesta || ', dirIp: ' || v_dir_ip || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);

         RETURN v_retorno;
      ELSIF v_modo = 'C' THEN
         -- grabacion en pendiente
         --- inserto el movimiento pendiente de autorizacion
         SELECT s_nro_documento.NEXTVAL
           INTO v_nro_documento
           FROM dual;
         INSERT INTO bw_mov_pendientes
            (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cotizacion, mto_equ_local, nro_cta_contra, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra, cot_contra, etiqueta, dato, etiqueta2, dato2/*, referencia*/)
         VALUES
            (v_nro_documento, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), SYSDATE, v_cod_operacion /* '214' */, v_nro_cta_debito, v_cod_mon_debito, 'Transferencia de Operaciones de Cambios', v_mto_debito, v_cotizacion, v_mto_equ_local, v_nro_cta_credito, 'P', v_can_aut_requeridas, v_can_aut_requeridas, retValidarSesion.codigoPersona, v_mto_credito, v_cot_credito /*v_cotizacion*/, 'Nro. Contrato', v_nro_contrato, 'Concepto', substr(v_des_operacion, 1, 50)/*, v_nro_contrato*/);

         v_retorno.cantAutorizadores := v_can_aut_requeridas;
         v_retorno.nroDocumento      := v_nro_documento;
         v_retorno.tipPedido         := v_modo;
         v_retorno.tipTransferencia  := '2';

         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', autReq: ' || v_can_aut_requeridas || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);

         RETURN v_retorno;
      ELSIF v_modo = 'A' THEN
         -- confirmacion de operacion
         -- seteo las variables
         v_nro_secuencia := 0;
         pag_cta.PR_SET_VARIABLES(v_mensajeCaja.codigoUsuario, v_fec_valor, v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL, v_mensajeCaja.codigoOficinaOrigen, 9, 91);

         retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre,
                                    v_mensajeCaja.codigoOficinaOrigen, v_fec_actual);
         IF retError.error = 'S' THEN
            v_retorno.error := retError.error;
            v_retorno.nombreRespuesta := retError.nombreRespuesta;
            v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lp_ver_horario - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;

         -- DDSI-265 -- 02/2018 : Se busca una hora disponible
         v_hor_actual := fug_obt_hor_disponible(v_fec_actual, v_hor_actual, user, v_es_mov_noc);
         IF v_cod_mon_debito <> v_cod_mon_local THEN
            IF v_cod_mon_credito = v_cod_mon_local THEN
               v_mto_equ_local := v_mto_credito;
            ELSE
               v_mto_equ_local := round(v_mto_debito * v_cotizacion, 0);
            END IF;
         ELSE
            v_mto_equ_local := NULL;
         END IF;
         -- actualizo la cuenta de debito
         pag_cta.PR_ACT_OPERACION(v_nro_cta_debito, v_hor_actual, 'D', v_cod_mon_debito, v_mto_debito, v_cod_tra_padre, 503, v_nro_operacion, v_cotizacion, v_mensajeCaja.codigoOficinaOrigen, 9, 91, NULL, NULL, nvl(v_concepto, v_des_operacion || ' Ope. Cambio ' || v_nro_cta_credito || '-' || v_nro_contrato), 'N', v_nro_secuencia, v_fec_valor, NULL, NULL, v_mto_equ_local);
         v_retorno.nroDocumento      := v_nro_operacion;
         IF nvl(pag_cta.g_cod_error, 0) = 0 THEN
            IF v_cod_mon_credito <> v_cod_mon_local THEN
               IF v_cod_mon_debito = v_cod_mon_local THEN
                  v_mto_equ_local := v_mto_debito;
               ELSE
                  v_mto_equ_local := round(v_mto_credito * v_cot_credito, 0);
               END IF;
            ELSE
               v_mto_equ_local := NULL;
            END IF;
            pag_cta.PR_ACT_OPERACION(v_nro_cta_credito, v_hor_actual, 'C', v_cod_mon_credito, v_mto_credito, v_cod_tra_padre, 602, v_nro_operacion, v_cot_credito, v_mensajeCaja.codigoOficinaOrigen, 9, 91, NULL, NULL, nvl(v_concepto, v_des_operacion || ' Ope. Cambio ' || v_nro_cta_debito || '-' || v_nro_contrato ), 'N', v_nro_secuencia, v_fec_valor, NULL, NULL, v_mto_equ_local);
            IF nvl(pag_cta.g_cod_error, 0) <> 0 THEN
               -- hubo error en el credito
               IF v_retorno.error = 'N' THEN
                  pr_mensajeUsuario(TRA_CTA_CRE_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'pr_act_operacion(cre) - ' || v_msj_bitacora || ', MSJ-ERR: [' || substr(pag_cta.G_MSJ_ERROR, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               END IF;
            ELSE
               -- cambio el estado del contrato de cambio
               paw_bas.pr_liq_ope_cambio(v_mensajeCaja.codigoUsuario, v_nro_cta_debito, v_mto_debito, v_cod_mon_debito, v_cod_mon_credito, v_nro_operacion);

               /*Notificar evento*/
               -- Notificacion al debito
               BEGIN
                  v_res_notificacion:=PAW_NOT.fu_not_transferencias(v_nro_cta_debito, v_mto_debito, v_cod_mon_debito, 'D', v_fec_valor);
               EXCEPTION
                  WHEN OTHERS THEN
                     NULL;
               END;
               --Notificacion al credito
               BEGIN
                  v_res_notificacion:=PAW_NOT.fu_not_transferencias(v_nro_cta_credito, v_mto_credito, v_cod_mon_credito, 'C', v_fec_valor);
               EXCEPTION
                  WHEN OTHERS THEN
                     NULL;
               END;
                     /*
                       CANREQVAR - 612
                       Notificacion via mail a clientes BBVA por transf entre cuentas y Terceros.
                    */
                    -- obtenemos el codigo de persona del titular de la cuenta de debito y credito
                    v_cod_per_debito  := fug_obt_cli_principal(v_nro_cta_debito);
                    v_cod_per_credito := fug_obt_cli_principal(v_nro_cta_credito);
                    -- si ambas cuentas corresponden al mismo codigo de persona notificamos como una
                    -- transferencia entre cuentas propias. v_cod_operacion = 030
                    IF (v_cod_per_debito = v_cod_per_credito)  THEN
                      BEGIN
                        v_res_notificacion := paw_not.fu_not_mail_transferencias(v_nro_cta_debito,
                                                                                v_nro_cta_credito,
                                                                                v_cod_mon_debito,
                                                                                v_cod_mon_credito,
                                                                                '030', -- v_cod_operacion'030' = Transf. a cuentas propias
                                                                                v_mto_debito,   -- monto debito
                                                                                v_mto_credito,
                                                                                v_fec_valor);
                      EXCEPTION
                         WHEN OTHERS THEN
                            NULL;
                      END;
                    ELSE
                       BEGIN
                        v_res_notificacion := paw_not.fu_not_mail_transferencias(v_nro_cta_debito,
                                                                                v_nro_cta_credito,
                                                                                v_cod_mon_debito,
                                                                                v_cod_mon_credito,
                                                                                '039', --  v_cod_operacion '039' = Transf. a Terceros
                                                                                v_mto_debito, --v_monto,   -- monto debito
                                                                                v_mto_credito,
                                                                                v_fec_valor);
                      EXCEPTION
                         WHEN OTHERS THEN
                            NULL;
                      END;
                    END IF;
               -- registro del movimiento
               lp_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/,
                   v_cod_mon_debito /*p_cod_moneda */,
                   v_mto_debito          /*p_monto*/,
                   v_nro_cta_credito /*p_nro_cta_contra*/,
                   v_res_notificacion              /*p_cantidad*/,
                   'Tipo_Ope_Cambios'/*p_etiqueta*/,
                   v_tip_operacion   /*p_dato*/,
                   'Cotizacion'      /*p_etiqueta2*/,
                   v_cotizacion      /*p_dato2*/,
                   'Yaguarete'       /*observacion*/,
                   v_dir_ip          /*direccion IP*/,
                   '000',
                   retValidarSesion.codigopersona,
                   v_cod_operacion,
                   v_nro_operacion,
                   p_codcanal,
                   p_sesion,
                   retValidarSesion.codigoempresa);
            END IF;
         ELSE
            -- hubo error en el debito
            IF v_retorno.error = 'N' THEN
               pr_mensajeUsuario(TRA_CTA_DEB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'pr_act_operacion(deb) - ' || v_msj_bitacora || ', MSJ-ERR: [' || substr(pag_cta.G_MSJ_ERROR, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            END IF;
         END IF;
      END IF;
   END IF;

   IF v_retorno.error = 'N' THEN
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
   END IF;

   RETURN v_retorno;
END;
-- fin de confirmacion de transferencia entre cuentas con contrato de cambio

   /**Listado de Facturas  **/
   FUNCTION fu_obtenerListaFacturas(p_sesion   IN VARCHAR2,
                                    p_codCanal IN VARCHAR2) RETURN typ_resumenFacturas IS
      v_can_detalles NUMBER := 0;

      v_fec_actual DATE := sysdate; -- fecha de hoy
      v_retorno  typ_resumenFacturas := typ_resumenFacturas;
      v_detalles typ_resumenfactura := typ_resumenfactura;
      v_permiso  typ_obtenerPermisos;
      v_cod_operacion  VARCHAR2(10) := '025'; -- nro función origen en paw_bce
      userinfo       typ_validarsesion;
      v_cant_meses VARCHAR2(3):= nvl(fug_obt_pardinamico('MAX_MES_FACTURA'),14);
      ---

   CURSOR facturas IS
    SELECT nro_factura, x.fecha, decode(x.tip_comprobante,'F', 'Factura', 'N', 'Nota de Credito', NULL) tipo,
           nvl(x.cod_moneda, 'GS') cod_moneda,
           nvl(x.mto_exento, 0) + nvl(x.mto_gravado_5, 0) +
           nvl(x.mto_gravado_10, 0) tot_factura,
           nvl(x.mto_exento_gs, 0) + nvl(x.mto_gravado_5_gs, 0) +
           nvl(x.mto_gravado_10_gs, 0) tot_factura_gs,
           nvl(x.impuesto_5_gs, 0) + nvl(x.impuesto_10_gs, 0) tot_iva_gs,
           nvl(x.impuesto_5, 0) + nvl(x.impuesto_10, 0) tot_iva
      FROM cb_lib_ventas x
     WHERE x.cod_persona = nvl(userinfo.codigoEmpresa, userinfo.codigoPersona)
       AND x.fecha > last_day(add_months(v_fec_actual, -v_cant_meses))
    UNION
    SELECT nro_factura, y.fecha, 'Factura' tipo,
           'GS' cod_moneda,
           nvl(y.mto_exento, 0) + nvl(y.mto_gravado_5, 0) +
           nvl(y.mto_gravado_10, 0) tot_factura,
           nvl(y.mto_exento, 0) + nvl(y.mto_gravado_5, 0) +
           nvl(y.mto_gravado_10, 0) tot_factura_gs,
           nvl(y.impuesto_5, 0) + nvl(y.impuesto_10, 0) tot_iva_gs,
           nvl(y.impuesto_5, 0) + nvl(y.impuesto_10, 0) tot_iva
      FROM cb_lib_compras y
     WHERE y.cod_persona = nvl(userinfo.codigoEmpresa, userinfo.codigoPersona)
       AND y.fecha > last_day(add_months(v_fec_actual, -v_cant_meses))
       AND y.tip_origen = 'C'
     ORDER BY fecha;

   BEGIN
      -- 1. Valido la Sesión del Cliente
      userinfo := fu_validarsesion(p_sesion, p_codcanal);

      IF userinfo.error = 'S' THEN
         v_retorno.error                := userinfo.error;
         v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- se valida el permiso
      v_permiso := lf_obt_permisos(userinfo, v_cod_operacion);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'obtenerListaFacturas ' || fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null ), bitacora_entrada);

      -- 2. ejecuto la funcion para generar el comprobante

      v_retorno.listaFacturas := typ_listaFacturas();
      FOR ft IN facturas
      LOOP
         v_detalles.nroFactura     := ft.nro_factura;
         v_detalles.fecha          := ft.fecha;
         v_detalles.tipo           := ft.tipo;
         v_detalles.codMoneda      := ft.cod_moneda;
         v_detalles.totalFactura   := ft.tot_factura;
         v_detalles.totalFacturaGs := ft.tot_factura_gs;
         v_detalles.totalIva       := ft.tot_iva_gs;
         v_retorno.listaFacturas.EXTEND;
         v_retorno.listaFacturas(v_retorno.listaFacturas.COUNT) := v_detalles;
         v_can_detalles := v_can_detalles + 1;

      END LOOP;
      v_retorno.cantFacturas := v_can_detalles;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'obtenerListaFacturas - canDet: ' || v_can_detalles || ' ' || fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null ), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, 'obtenerListaFacturas -' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ) || SQLERRM, BITACORA_ERROR);
         return v_retorno;
   END;

   /**Obtiene una Factura con sus detalles**/
   FUNCTION fu_obtenerFactura(p_sesion     IN VARCHAR2,
                              p_codCanal   IN VARCHAR2,
                              p_nroFactura IN VARCHAR,
                              p_fecha IN DATE) RETURN typ_detallesFactura IS

      v_retorno       typ_detallesFactura := typ_detallesFactura;
      userInfo        typ_validarsesion;
      v_nro_factura   VARCHAR2(50);
      v_detalles      typ_detallefactura := typ_detallefactura;
      v_permiso       typ_obtenerPermisos;
      v_cod_operacion VARCHAR2(10) := '026'; -- nro función origen en paw_bce
      msg_g_sin_datos CONSTANT VARCHAR2(15) := 'G_SIN_DATOS';
      MSG_SIS_CIERRE  CONSTANT VARCHAR2(15) := 'HOR_SIS_CIERRE';
      v_est_modulo    ba_modulos.estado%TYPE := pae_cnf.FU_OBT_EST_MODULO(9);
      v_cantFacturas  NUMBER; --cantidad de facturas retornadas
      v_des_periodo   VARCHAR2(150);
      v_cantidad      NUMBER := 0;

      v_msj_bitacora  VARCHAR2(200) := 'nroFactura: [' || p_nroFactura ||']' || ' fecha: [' || p_fecha ||']';

      CURSOR cabecera_ventas IS
         SELECT nro_factura, nro_timbrado, nvl(tip_origen, 'N') tip_origen,
                'Válido hasta ' || fug_des_mes(a.fec_vig_timbrado) || ' de ' || to_char(a.fec_vig_timbrado, 'yyyy') mes_validez,
                fecha, c.Oficina, fecha des_fecha, tip_comprobante, b.significado des_tip_comprobante, a.tip_venta tip_venta,
                decode(dig_verificador, NULL, nro_documento, nro_documento || '-' || dig_verificador) nro_ruc, nom_completo,
                a.direccion, a.telefono, DECODE(tip_origen, 'C', mto_exento_gs, mto_exento) mto_exento,
                to_char(nvl(mto_gravado_5_gs, 0) + nvl(impuesto_5_gs, 0)) mto_gravado_5,
                to_char(nvl(mto_gravado_10_gs, 0) + nvl(impuesto_10_gs, 0)) mto_gravado_10,
                (nvl(mto_exento_gs, 0) + nvl(mto_gravado_5_gs, 0) + nvl(mto_gravado_10_gs, 0) + nvl(impuesto_5_gs, 0) + nvl(impuesto_10_gs, 0)) tot_venta,
                impuesto_5_gs impuesto_5, impuesto_10_gs impuesto_10,
                (nvl(impuesto_5_gs, 0) + nvl(impuesto_10_gs, 0)) tot_iva,
                DECODE(a.tip_comprobante, 'N', 'TOTAL A ACREDITAR  ', 'TOTAL A PAGAR  ') ||
                fue_obt_des_moneda(a.cod_moneda) || ' ' ||
                   fue_obt_denominacion
                   (
                     nvl(mto_exento_GS, 0) + nvl(mto_gravado_5_GS, 0) +
                     nvl(mto_gravado_10_GS, 0) + nvl(impuesto_5_GS, 0) + nvl(impuesto_10_GS, 0)
                   ) || '.-' des_tot_venta,
                DECODE(nro_fac_referencia, '0', NULL, nro_fac_referencia) nro_fac_referencia,
                DECODE(nro_tim_referencia, '0', NULL, nro_tim_referencia) nro_tim_referencia,
                DECODE(impreso, 'N', 'ORIGINAL', 'COPIA') tip_impresion, c.nom_entidad,
                'RUC ' || c.ruc_entidad ruc_entidad, c.matriz, c.direccion dir_oficina,
                c.telefono tel_oficina, a.cod_moneda, a.ROWID fila, a.impreso,
                a.fec_ini_timbrado, a.fec_vig_timbrado, a.nro_aut_timbrado
           FROM BA_COD_REFERENCIAS B, CB_LIB_VENTAS A,
                (SELECT b.cod_oficina cod_oficina, a.nom_entidad, c.nro_documento ruc_entidad, fue_obt_titulo(b.descripcion) Oficina, d.direccion || ' - ' || fue_obt_titulo(d.descripcion) || ' - Py.' matriz, b.direccion || ' - ' || fue_obt_titulo(b.descripcion) || ' - Py.' direccion, b.telefono
                    FROM ba_personas c, ba_oficinas d, ba_oficinas b, ge_par_generales a
                   WHERE d.cod_oficina = a.cod_ofi_matriz
                         AND c.cod_persona = a.cod_persona
                         AND b.estado = 'A') C
          WHERE b.dominio = 'TIP_COM_VENTA'
                AND a.tip_comprobante = b.val_minimo
                AND c.cod_oficina = a.cod_oficina
                AND a.nro_factura = v_nro_factura
                AND a.cod_persona = nvl(userinfo.codigoEmpresa, userinfo.codigoPersona)
                AND a.fecha = p_fecha
          ORDER BY nro_factura;
      CURSOR cabecera_compras IS
          SELECT cb.nro_factura, cb.nro_timbrado, cb.fecha, c.Oficina, nvl(tip_origen, 'C') tip_origen, cb.tipo tip_compra,
                 decode(instr(cb.nro_documento,''),0,cb.nro_documento||''||
                        fue_obt_ruc_dig_verificador(cb.nro_documento), cb.nro_documento) nro_ruc,
                 cb.raz_social, fue_obt_dir_principa(cb.cod_persona) direccion,
                 fue_obt_tel_principa(cb.cod_persona) telefono, cb.mto_exento,
                 to_char(nvl(cb.mto_gravado_10, 0) + nvl(cb.impuesto_10, 0)) mto_gravado_10,
                 to_char(nvl(cb.mto_gravado_5, 0) + nvl(cb.impuesto_5, 0)) mto_gravado_5,
                 (nvl(cb.mto_exento, 0) + nvl(cb.mto_gravado_5, 0) + nvl(cb.mto_gravado_10, 0) + nvl(cb.impuesto_5, 0) +
                 nvl(cb.impuesto_10, 0)) tot_compra_gs,
                 cb.impuesto_5 impuesto_5, cb.impuesto_10 impuesto_10,
                 (nvl(cb.impuesto_5, 0) + nvl(cb.impuesto_10, 0)) tot_iva,
                 c.nom_entidad, 'RUC ' || c.ruc_entidad ruc_entidad, c.matriz, c.direccion dir_oficina,
                 c.telefono tel_oficina, 'GS' cod_moneda, cb.ROWID fila
                 FROM CB_LIB_COMPRAS CB,
                      (SELECT b.cod_oficina cod_oficina, a.nom_entidad, c.nro_documento ruc_entidad, fue_obt_titulo(b.descripcion) Oficina, d.direccion || ' - ' || fue_obt_titulo(d.descripcion) || ' - Py.' matriz, b.direccion || ' - ' || fue_obt_titulo(b.descripcion) || ' - Py.' direccion, b.telefono
                         FROM ba_personas c, ba_oficinas d, ba_oficinas b, ge_par_generales a
                        WHERE d.cod_oficina = a.cod_ofi_matriz
                          AND c.cod_persona = a.cod_persona
                          AND b.estado = 'A') C
          WHERE c.cod_oficina = cb.cod_ofi_origen
            AND cb.nro_factura = v_nro_factura
            AND cb.cod_persona = nvl(userinfo.codigoEmpresa, userinfo.codigoPersona)
            AND CB.fecha = p_fecha
          ORDER BY nro_factura;
      -- cursor de detalles
      CURSOR detalles_ventas(p_nro_timbrado in cb_lib_ventas.nro_timbrado%TYPE) IS
         SELECT DECODE(b.tip_origen, 'C', a.mto_exento, 1) cantidad,
                DECODE(b.tip_origen, 'C', 'Operación en moneda extranjera ('||a.cod_moneda||') '|| fue_obt_titulo(descripcion),
                       fue_obt_titulo(a.descripcion)) descripcion,
                DECODE(b.tip_origen, 'C', REPLACE(TO_CHAR(a.cotizacion), ',', '.'),
                        REPLACE(TO_CHAR(nvl(a.mto_exento_gs, 0) + nvl(a.mto_gra_5_gs, 0) +
                                nvl(a.mto_gra_10_gs, 0) + nvl(a.impuesto_5_gs, 0) +
                                nvl(a.impuesto_10_gs, 0)), ',', '.')) precio,
                DECODE(b.tip_origen, 'C', REPLACE(TO_CHAR(a.mto_exento_gs), ',', '.') ,
                       REPLACE(TO_CHAR(a.mto_exento), ',', '.')) mto_exento,
                REPLACE(TO_CHAR(nvl(a.mto_gra_5_gs, 0) + nvl(a.impuesto_5_gs, 0)), ',', '.') mto_gra_5,
                REPLACE(TO_CHAR(nvl(a.mto_gra_10_gs, 0) + nvl(a.impuesto_10_gs, 0)), ',', '.') mto_gra_10,
                REPLACE(TO_CHAR(a.cotizacion), ',', '.') cotizacion,
                a.nro_factura, a.nro_timbrado, a.fecha fec_linea, a.nro_documento, a.nro_cuenta, a.cod_moneda,
                a.cod_modulo, a.cod_modalidad
           FROM cb_lib_ventas b, cb_lib_ventas_det a
          WHERE a.nro_factura = v_nro_factura
            AND b.nro_factura = a.nro_factura
            AND B.NRO_TIMBRADO = A.NRO_TIMBRADO
            AND a.nro_timbrado = p_nro_timbrado
          ORDER BY a.fecha, a.hora;

      CURSOR detalles_compras(p_nro_timbrado in cb_lib_compras.nro_timbrado%TYPE) IS
           SELECT a.mto_operacion_me cantidad,
                  'Operación en moneda extranjera ('||a.cod_moneda||') '||
                  fue_obt_titulo(substr(fug_obt_des_transaccion(cod_modulo,cod_modalidad,cod_transaccion),1,35)) descripcion_compra,
                  'Válido hasta ' || fug_des_mes(a.fec_vig_timbrado) || ' de ' || to_char(a.fec_vig_timbrado, 'yyyy') mes_validez,
                  a.tip_comprobante, c.significado des_tip_comprobante,
                  REPLACE(a.cotizacion, ',', '.') precio,
                  REPLACE(TO_CHAR(a.cotizacion), ',', '.') cotizacion,
                  a.cod_mon_operacion moneda_operacion,
                  a.mto_operacion_me total_compra_me,
                  a.nro_factura, a.nro_timbrado, b.nro_documento, a.cod_moneda,
                  a.cod_modulo, a.cod_modalidad, a.fecha, a.nro_cuenta,
                  a.fec_ini_timbrado, a.fec_vig_timbrado, a.nro_aut_timbrado
             FROM cb_lib_compras b, cb_lib_compras_det a, ba_cod_referencias c
            WHERE c.dominio = 'TIP_COM_VENTA'
              AND a.tip_comprobante = c.val_minimo
              AND a.nro_factura = v_nro_factura
              AND b.nro_factura = a.nro_factura
              AND B.NRO_TIMBRADO = A.NRO_TIMBRADO
              AND a.nro_timbrado = p_nro_timbrado
              AND b.tip_origen = 'C' -- factura de cambios
            ORDER BY a.fecha, a.hora;

      PRAGMA AUTONOMOUS_TRANSACTION; --- para que grabe solo esta transaccion
   BEGIN
      -- Valido la Sesión del Cliente
      userinfo := fu_validarsesion(p_sesion, p_codcanal);
      IF userinfo.error = 'S' THEN
         v_retorno.error                := userinfo.error;
         v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- se valida el permiso
      v_permiso := lf_obt_permisos(userinfo, '025');
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);

      IF v_est_modulo = 6 THEN
         pr_mensajeUsuario(MSG_SIS_CIERRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ', estMod: ' || v_est_modulo || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF p_nrofactura IS NULL THEN
         pab_iva.pr_gen_lib_vta_tmp(nvl(userinfo.codigoEmpresa, userinfo.codigoPersona));
         v_nro_factura := pab_iva.fu_gen_factura(nvl(userinfo.codigoEmpresa, userinfo.codigoPersona));
      ELSE
         v_nro_factura := TRIM(p_nroFactura);
         v_msj_bitacora := v_msj_bitacora || ', fac: [' || v_nro_factura || ']';
      END IF;

      v_retorno.listaDetallesFacturas := typ_listaDetalleFacturas();
      v_cantFacturas                  := 0;
      FOR c IN cabecera_ventas
      LOOP
         SELECT 'de ' || to_char(MIN(n.fecha), 'dd') || ' al ' || to_char(fug_des_fecha(MAX(n.fecha)))
           INTO v_des_periodo
           FROM cb_lib_ventas_det n
          WHERE n.nro_factura = v_nro_factura
            AND n.nro_timbrado = c.nro_timbrado;

         v_cantFacturas             := v_cantFacturas + 1;
         v_retorno.nroFactura       := c.nro_factura;
         v_retorno.nroTimbrado      := c.nro_timbrado;
         v_retorno.tipoComprobante  := c.tip_comprobante;
         v_retorno.nroRucEntidad    := c.ruc_entidad;
         v_retorno.validez          := c.fec_vig_timbrado;
         v_retorno.fecIniTimFactura := c.fec_ini_timbrado;
         v_retorno.nroAutTimbrado   := c.nro_aut_timbrado;
         v_retorno.nombreEntidad    := c.nom_entidad;
         v_retorno.direccionOficina := c.dir_oficina;
         v_retorno.direccionMatriz  := c.matriz;
         v_retorno.direccionCliente := c.direccion;
         v_retorno.fecha            := c.des_fecha;
         v_retorno.nroRucCliente    := c.nro_ruc;
         v_retorno.nombreCliente    := c.nom_completo || ' No.de Cliente: ' || nvl(userinfo.codigoEmpresa, userinfo.codigoPersona);
         v_retorno.telefono         := c.telefono;
         v_retorno.periodo          := v_des_periodo;
         v_retorno.totalExento      := c.mto_exento;
         v_retorno.gravado5         := c.mto_gravado_5;
         v_retorno.gravado10        := c.mto_gravado_10;
         v_retorno.totalVenta       := c.tot_venta;
         v_retorno.desTotVenta      := c.des_tot_venta;
         v_retorno.impuesto5        := c.impuesto_5;
         v_retorno.impuesto10       := c.impuesto_10;
         v_retorno.totalIva         := c.tot_iva;
         v_retorno.tipoImpresion    := c.tip_impresion;
         v_retorno.nroFacturaRef    := c.nro_fac_referencia;
         v_retorno.nroTimbradoRef   := c.nro_tim_referencia;
         v_retorno.tipOrigen        := c.tip_origen;

         v_retorno.tipoOperacion    := 'V'; -- venta

         IF c.tip_venta = 'CR' THEN
            v_retorno.tipoVenta := 'CR'; --'Crédito';

         ELSE
            v_retorno.tipoVenta := 'CO'; --'Contado';
         END IF;

         FOR d IN detalles_ventas(c.nro_timbrado)
         LOOP
            v_cantidad               := v_cantidad + 1;
            v_detalles.cantidad      := d.cantidad;
            v_detalles.documento     := d.nro_documento;
            v_detalles.nroCuenta     := nvl(d.nro_cuenta, ' ');
            v_detalles.fecha         := d.fec_linea;
            v_detalles.descripcion   := substr(d.descripcion, 0, 100);
            v_detalles.montoExento   := nvl(d.mto_exento, 0);
            v_detalles.gravado5      := nvl(d.mto_gra_5, 0);
            v_detalles.gravado10     := nvl(d.mto_gra_10, 0);
            v_detalles.cotizacion    := nvl(d.cotizacion, 0);
            v_detalles.codMoneda     := d.cod_moneda;
            v_retorno.cotizacion     := d.cotizacion;
            v_retorno.codMoneda      := d.cod_moneda;

            v_retorno.listaDetallesFacturas.EXTEND;
            v_retorno.listaDetallesFacturas(v_retorno.listaDetallesFacturas.COUNT) := v_detalles;
         END LOOP;

         v_retorno.cantFacturas := v_cantFacturas;

         IF c.impreso = 'N' THEN
            BEGIN
               pre_ini_aplicacion;
               pae_cnf.g_cod_modulo := 1;
            END;
            UPDATE cb_lib_ventas
               SET impreso = 'S'
             WHERE ROWID = c.fila;
         END IF;
      END LOOP;
      COMMIT;

      v_cantFacturas := 0;
      FOR ca IN cabecera_compras
      LOOP
         SELECT 'de ' || to_char(MIN(n.fecha), 'dd') || ' al ' || to_char(fug_des_fecha(MAX(n.fecha)))
           INTO v_des_periodo
           FROM cb_lib_compras_det n
          WHERE n.nro_factura = v_nro_factura
            AND n.nro_timbrado = ca.nro_timbrado;

         v_cantFacturas             := v_cantFacturas + 1;
         v_retorno.nroFactura       := ca.nro_factura;
         v_retorno.nroTimbrado      := ca.nro_timbrado;
         v_retorno.nroRucEntidad    := ca.ruc_entidad;
         v_retorno.nombreEntidad    := ca.nom_entidad;
         v_retorno.direccionOficina := ca.dir_oficina;
         v_retorno.direccionMatriz  := ca.matriz;
         v_retorno.direccionCliente := ca.direccion;
         v_retorno.fecha            := ca.fecha;
         v_retorno.nroRucCliente    := ca.nro_ruc;
         v_retorno.nombreCliente    := ca.raz_social || ' No.de Cliente: ' || nvl(userinfo.codigoEmpresa, userinfo.codigoPersona);
         v_retorno.telefono         := ca.telefono;
         v_retorno.periodo          := v_des_periodo;
         v_retorno.totalExento      := ca.mto_exento;
         v_retorno.gravado5         := ca.mto_gravado_5;
         v_retorno.gravado10        := ca.mto_gravado_10;
         v_retorno.totalVenta       := ca.tot_compra_gs;
         v_retorno.impuesto5        := ca.impuesto_5;
         v_retorno.impuesto10       := ca.impuesto_10;
         v_retorno.totalIva         := ca.tot_iva;
         v_retorno.tipoOperacion    := 'C'; -- compra
         v_retorno.tipOrigen        := ca.tip_origen;

         IF ca.tip_compra = 'CR' THEN
            v_retorno.tipoVenta := 'CR'; --'Crédito';

         ELSE
            v_retorno.tipoVenta := 'CO'; --'Contado';
         END IF;

         FOR de IN detalles_compras(ca.nro_timbrado)
         LOOP
            v_cantidad                   := v_cantidad + 1;
            v_detalles.cantidad          := de.cantidad;
            v_detalles.documento         := de.nro_documento;
            v_detalles.descripcion       := substr(de.descripcion_compra, 0, 100);
            v_detalles.montoExento       := nvl(ca.tot_compra_gs, 0);
            v_detalles.cotizacion        := nvl(de.cotizacion,0);
            v_detalles.codMoneda         := de.cod_moneda;
            v_detalles.gravado5          := 0;
            v_detalles.gravado10         := 0;
            v_detalles.fecha             := de.fecha;
            v_detalles.nroCuenta         := nvl(de.nro_cuenta, ' ');
            v_retorno.validez            := de.fec_vig_timbrado;
            v_retorno.fecIniTimFactura   := de.fec_ini_timbrado;
            v_retorno.nroAutTimbrado     := de.nro_aut_timbrado;
            v_retorno.tipoComprobante    := de.tip_comprobante;
            v_retorno.cotizacion         := de.cotizacion;
            v_retorno.codMoneda          := de.moneda_operacion;
            v_retorno.desTotVenta        := 'TOTAL A PAGAR  ' || fue_obt_des_moneda(de.cod_moneda) || ' ' ||
                                            fue_obt_denominacion (nvl(ca.mto_exento,0)) || '.-';

            v_retorno.listaDetallesFacturas.EXTEND;
            v_retorno.listaDetallesFacturas(v_retorno.listaDetallesFacturas.COUNT) := v_detalles;
         END LOOP;

         v_retorno.cantFacturas := v_cantFacturas;
      END LOOP;

      v_retorno.imagenLogo := fug_obt_dat_entidad(p_opcion => 'BW_LOGO',
                                                     p_fecha  => to_char(p_fecha, 'ddmmyyyy'),
                                                     p_tipo   => 'FA');

      -- obtener RUC
      v_retorno.nroRucEntidad := fug_obt_dat_entidad(p_opcion => 'RUC',
                                                     p_fecha  => to_char(p_fecha, 'ddmmyyyy'),
                                                     p_tipo   => 'FA');

      -- obtener razon social
      v_retorno.nombreEntidad := fug_obt_dat_entidad(p_opcion => 'NOM',
                                                     p_fecha  => to_char(p_fecha, 'ddmmyyyy'),
                                                     p_tipo   => 'FA');

      v_msj_bitacora := v_msj_bitacora || ', cant: ' || v_cantidad;
      IF v_cantidad = 0 THEN
         pr_mensajeusuario(msg_g_sin_datos, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarbitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), bitacora_error);
      ELSE
         pr_mensajeusuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarbitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), bitacora_salida);
      END IF;
      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 250) || ']', BITACORA_ERROR);
         RETURN v_retorno;
   END;


   /**
   * Extracto por cliente y cuenta
   * @Creado por: Fermín Giménez
   * @Fecha : 11-07-2012
   */
   FUNCTION fu_extractoARequerimiento
   (
      p_sesion             IN VARCHAR2,
      p_codcanal           IN VARCHAR2,
      p_nroCuenta          IN VARCHAR2,
      p_fechaHasta         IN DATE,
      p_claveToken         IN VARCHAR2,
      p_claveTransaccional IN VARCHAR2
   ) RETURN typ_extracto IS

      v_retorno typ_extracto := typ_extracto;
      userinfo  typ_validarSesion;

      v_codPersona          VARCHAR2(15);
      v_permiso             typ_obtenerPermisos;
      v_extractoCuentas     typ_extractoCuentas := typ_extractoCuentas;
      v_cuentasCliente      typ_listaExtractoCuentas := typ_listaExtractoCuentas();
      v_extractoMovimientos typ_extractoMovimientos := typ_extractoMovimientos;
      v_detallesMovimiento  typ_listaExtractoMovimientos := typ_listaExtractoMovimientos();
      v_extractoRetenciones typ_extractoRetenciones := typ_extractoRetenciones;
      v_retencionesCuenta   typ_listaExtractoRetenciones := typ_listaExtractoRetenciones();
      v_extractoResumenes   typ_extractoResumenes := typ_extractoResumenes;
      v_resumenesCuenta     typ_listaExtractoResumenes := typ_listaExtractoResumenes();
      v_extractoBloqueos    typ_extractoBloqueos := typ_extractoBloqueos;
      v_bloqueosCuenta      typ_listaExtractoBloqueos := typ_listaExtractoBloqueos();
      v_tae                 ge_ext_cli_cuentas.tas_efectiva%TYPE;
      v_tan                 ge_ext_cli_cuentas.tas_nominal%TYPE;
      v_cod_cta_banco       ge_bancos.cod_banco%TYPE;

      --  Tipos de Mensajes de respuestas
      MSG_VAL_PENTRADA CONSTANT VARCHAR2(15) := 'VAL_PENTRADA'; /**Parametros de entradas incorrectos*/
      MSG_OBT_EXT_INE  CONSTANT VARCHAR2(15) := 'OBT_EXT_INE'; /** Extracto no encontrado*/
      MSG_OBT_CTA_ER   CONSTANT VARCHAR2(15) := 'OBT_CTA_ER'; /**Error al obtener Cuentas*/
      MSG_OBT_MOV_ER   CONSTANT VARCHAR2(15) := 'OBT_MOV_ER'; /**Error al obtener Movimientos*/
      MSG_OBT_RET_ER   CONSTANT VARCHAR2(15) := 'OBT_RET_ER'; /**Error al obtener Retenciones*/
      MSG_OBT_RES_ER   CONSTANT VARCHAR2(15) := 'OBT_RES_ER'; /**Error al obtener Resumenes*/
      MSG_OBT_BLO_ER   CONSTANT VARCHAR2(15) := 'OBT_BLO_ER'; /**Error al obtener Bloqueos*/
      MSG_GEN_EXT_ER   CONSTANT VARCHAR2(15) := 'GEN_EXT_ER'; /**Error al generar Extrato*/

      v_msg_error VARCHAR2(15) := MSG_ERROR;

      cod_operacion VARCHAR2(3) := '083';

      v_anho_mes        NUMBER(6);
      v_frecuencia      VARCHAR(10) := NULL;

      v_nom_oficial     ba_usuarios.nombre%TYPE;  --JESUS OVIEDO se crea variable para guardar el nombre del oficial

      v_fec_extracto    ge_ext_clientes.fec_extracto%TYPE;
      v_fre_extracto    ge_ext_clientes.fre_extracto%TYPE;
      v_cod_extracto    ge_ext_clientes.cod_extracto%TYPE;
      v_cod_usu_oficial ge_ext_clientes.cod_usu_oficial%TYPE;
      v_saldo_anterior  ge_ext_cli_cuentas.sal_anterior%TYPE;
      v_cod_per_extracto ge_cta_clientes.cod_persona%TYPE;
      v_fec_ult_cla     ge_ext_clientes.fec_ult_clasif%TYPE;
      v_msj_bitacora    VARCHAR2(300) := substr('nroCta:'||trim(p_nroCuenta)||
                                                ', fecHasta:'||p_fechaHasta, 1, 100);


   BEGIN

      -- Valido la Sesión del Cliente
      userinfo := fu_validarSesion(p_sesion, p_codcanal);

      IF userinfo.error = 'S' THEN
         v_retorno.error                := userinfo.error;
         v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      v_codPersona := NVL(userinfo.codigoEmpresa, userinfo.codigoPersona);

      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, cod_operacion);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      paw_uti.pr_mensajeusuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      paw_uti.pr_insertarbitacora(userinfo.codigoPersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null )||p_claveToken||p_claveTransaccional, paw_uti.bitacora_entrada);

      --Validacion p.entrada
      IF (v_codPersona IS NULL OR p_nroCuenta IS NULL OR p_fechaHasta IS NULL) THEN
         v_msg_error := MSG_VAL_PENTRADA;
         raise_application_error(-20000, 'Parametros de entrada incorrecto');
      END IF;

            IF lf_val_cta_origen(p_nroCuenta, v_codPersona) = 'N' THEN
               -- no es una cuenta del cliente
               paw_uti.pr_mensajeUsuario(MSG_OBT_CTA_ER, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               paw_uti.pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
               v_retorno.error:='S';
               return v_retorno;
            END IF;

      v_anho_mes := TO_NUMBER(TO_CHAR(p_fechaHasta, 'YYYYMM'));

      --Generacion
      v_frecuencia := 'M';
      v_msg_error  := MSG_GEN_EXT_ER;

      -- Cabecera del extracto

      v_retorno.cuentasCliente     := NULL;
      v_retorno.detallesMovimiento := NULL;
      v_retorno.retencionesCuenta  := NULL;
      v_retorno.resumenesCuenta    := NULL;
      v_retorno.bloqueosCuenta     := NULL;

      v_msg_error := MSG_OBT_EXT_INE;

      -- codigo banco
      v_retorno.codigoBanco := fug_obt_cod_banco;

      -- codigo swift del banco
      SELECT substr(upper(cod_swift), 1, 9)
        INTO v_retorno.codigoSwiftBanco
        FROM ge_bancos
       WHERE cod_banco = v_retorno.codigoBanco;

      -- obtengo los datos del banco corresponsal del operante
      BEGIN
         SELECT c.cod_banco
           INTO v_cod_cta_banco
           FROM cc_cta_corrientes c
          WHERE c.nro_cuenta = p_nroCuenta;
      EXCEPTION
         WHEN NO_DATA_FOUND THEN
            BEGIN
               SELECT v.cod_banco
                 INTO v_cod_cta_banco
                 FROM ah_cta_vistas v
                WHERE v.nro_cuenta = p_nroCuenta;
            EXCEPTION
               WHEN OTHERS THEN
                  v_cod_cta_banco := NULL;
            END;
      END;
      v_retorno.codigoSwiftCuenta := NULL;
      IF v_cod_cta_banco IS NOT NULL THEN
         BEGIN
            SELECT upper(TRIM(a.cod_swift))
              INTO v_retorno.codigoSwiftCuenta
              FROM ge_bancos a
             WHERE a.cod_banco = v_cod_cta_banco;
         EXCEPTION
            WHEN OTHERS THEN
               NULL;
         END;
      END IF;

      IF userinfo.codigoEmpresa IS NOT NULL THEN
         v_cod_per_extracto := v_codPersona;
      ELSE
         SELECT cc.cod_persona
           INTO v_cod_per_extracto
           FROM ge_cta_clientes c, ge_cta_clientes cc
          WHERE c.nro_cuenta = p_nroCuenta
            AND c.cod_persona = v_codPersona
            and c.relacion in ('O','P','Y')
            and c.nro_cuenta = cc.nro_cuenta
            and cc.relacion = 'P';
      END IF;

      SELECT t.*
        INTO v_retorno.codigoCliente, v_fec_extracto, v_fre_extracto, v_cod_extracto, v_retorno.direccionCliente, v_retorno.barrio, v_retorno.descripcion, v_retorno.telefonoCliente, v_cod_usu_oficial, v_retorno.nombreCliente, v_retorno.calificacionRiesgo, v_fec_ult_cla
        FROM (SELECT e.cod_persona, e.fec_extracto, e.fre_extracto, e.cod_extracto, substr(e.direccion, 1, 150) dir_completa, e.barrio, substr(c.descripcion || decode(REPLACE(p.descripcion, 'PARAGUAY', ''), '', '', ' - ') || REPLACE(p.descripcion, 'PARAGUAY', ''), 1, 100) descripcion,
                     e.telefono telefono, e.cod_usu_oficial oficial, e.nom_cliente, e.cat_riesgo, e.fec_ult_clasif
                FROM ba_paises p, ba_ciudades c, ge_ext_clientes e
               WHERE e.cod_persona = v_cod_per_extracto
                 AND (v_frecuencia IS NULL OR e.fre_extracto = v_frecuencia)
                 AND to_number(to_char(e.fec_extracto, 'yyyymm')) = v_anho_mes
                 AND p.cod_pais(+) = e.cod_pais
                 AND c.cod_pais(+) = e.cod_pais
                 AND c.cod_ciudad(+) = e.cod_ciudad
                 AND NOT EXISTS (SELECT 1
                        FROM ge_ext_cli_cuentas_tmp
                       WHERE cod_persona = e.cod_persona
                         AND fec_extracto = e.fec_extracto
                         AND cod_extracto = e.cod_extracto
                         AND fre_extracto = e.fre_extracto
                         AND cod_per_empresa IS NOT NULL)
                 AND (EXISTS (SELECT 1
                                FROM bw_ope_claves cl
                               WHERE cl.cod_persona = userinfo.codigoPersona
                                 AND nvl(cl.cod_per_vinculada, 'x') = nvl(userinfo.codigoEmpresa, 'x')
                                 AND cl.tip_clave='A'
                                 AND cl.clave IS NOT NULL))
               ORDER BY e.fec_extracto DESC) t
       WHERE ROWNUM = 1;
       -- si tiene fecha de calificacion de riesgo
       IF v_fec_ult_cla IS NOT NULL THEN
          v_retorno.fechaUltCalificacion := substr('al '||to_char(v_fec_ult_cla, 'dd/mm/yyyy'), 1, 15);
       END IF;
       v_retorno.fechaExtracto := to_char(v_fec_extracto, 'dd/mm/yyyy');

       IF v_retorno.direccionCliente IS NULL THEN
          BEGIN
             SELECT t.*
               INTO v_retorno.direccionCliente, v_retorno.barrio
               FROM (SELECT substr(e.direccion || e.det_direccion, 1, 150) dir_completa, e.barrio
                       FROM ge_ext_clientes e, ge_ext_cli_cuentas ec
                      WHERE e.cod_persona = v_cod_per_extracto
                        AND to_number(to_char(e.fec_extracto, 'yyyymm')) = v_anho_mes
                        AND e.cod_persona = ec.cod_persona
                        AND e.fec_extracto = ec.fec_extracto
                        AND ec.nro_cuenta = p_nroCuenta
                        AND e.cod_extracto = ec.cod_extracto
                    ) t
              WHERE ROWNUM = 1;
          EXCEPTION
             WHEN OTHERS THEN
                NULL;
          END;
       END IF;

       -- completamos la calificacion de riesgo
       CASE v_retorno.calificacionRiesgo
         WHEN '1' THEN v_retorno.calificacionRiesgo := v_retorno.calificacionRiesgo || '(Uno)';
         WHEN '2' THEN v_retorno.calificacionRiesgo := v_retorno.calificacionRiesgo || '(Dos)';
         WHEN '3' THEN v_retorno.calificacionRiesgo := v_retorno.calificacionRiesgo || '(Tres)';
         WHEN '4' THEN v_retorno.calificacionRiesgo := v_retorno.calificacionRiesgo || '(Cuatro)';
         WHEN '5' THEN v_retorno.calificacionRiesgo := v_retorno.calificacionRiesgo || '(Cinco)';
         WHEN '6' THEN v_retorno.calificacionRiesgo := v_retorno.calificacionRiesgo || '(Seis)';
         ELSE NULL;
       END CASE;

      -- obtenemos el nombre del oficial y guardamos en la variable v_nom_oficial
      IF v_cod_usu_oficial IS NOT NULL THEN
           SELECT us.nombre
           INTO v_nom_oficial
           FROM ba_usuarios us
          WHERE us.cod_usuario = v_cod_usu_oficial
          and ROWNUM = 1;
      END IF;

      -- agregamos el nombre del oficial en el type para retornar los datos a la Web
      IF v_nom_oficial IS NOT NULL THEN
          v_retorno.nombreOficial := v_nom_oficial ;
      END IF;

      -- fecha ultimo extracto
      SELECT MAX(c.fec_extracto)
        INTO v_retorno.fechaExtractoAnterior
        FROM ge_ext_cli_cuentas c
       WHERE c.cod_persona = nvl(userinfo.codigoEmpresa, userinfo.codigoPersona)
         AND c.nro_cuenta = p_nroCuenta
         AND c.fec_extracto < v_fec_extracto;

      -- Obtiene Detalle de cuentas del cliente

      v_msg_error := MSG_OBT_CTA_ER;

      FOR cr IN (SELECT e.nro_cuenta, fue_obt_titulo(m.descripcion) || ' ' || e.cod_moneda des_cta,
                  nvl(e.sal_anterior, 0) sal_anterior_con, nvl(e.sal_actual, 0) sal_actual_con,
                  nvl(e.sal_bloqueado, 0) sal_actual_bloq, nvl(e.sal_anterior, 0) - nvl(e.sal_blo_anterior, 0) sal_ant_disp,
                   nvl(e.sal_actual, 0) - nvl(e.sal_bloqueado, 0) sal_actual_disp,
                   round(e.tas_nominal, 2) tas_nominal, round(e.tas_efectiva, 2) tas_efectiva, e.nro_cta_combinada,e.fec_extracto, cc.cod_modulo, cc.cod_modalidad
                   FROM ba_modulos mo, ge_modalidades m, ge_ext_cli_cuentas e, ge_cta_clientes cc
                  WHERE m.cod_modulo = to_number(substr(ltrim(to_char(e.cod_modalidad)), 1, 1))
                    AND m.cod_modulo = mo.cod_modulo
                    AND e.cod_modalidad = m.cod_modalidad
                    AND e.nro_cuenta = cc.nro_cuenta
                    AND cc.cod_persona = v_codPersona
                    AND cc.relacion IN ('O', 'P', 'Y') -- se deben podeer consultar extratos de ctas conjuntas
                    AND e.fec_extracto = v_fec_extracto
                    AND e.fre_extracto = v_fre_extracto
                    AND e.nro_cuenta = p_nroCuenta
                    AND e.tip_cuenta IS NOT NULL
                    AND mo.cod_modulo IN (3, 4)
                    AND m.cod_modalidad NOT IN (33)
                  ORDER BY e.nro_cuenta) LOOP

         -- Se evalua la tasa nominal y efectiva para Cuentas Corrientes
         v_tae := cr.tas_efectiva;
         v_tan := cr.tas_nominal;

         IF cr.cod_modulo = 4 AND cr.cod_modalidad = 41 THEN
            DECLARE
               v_tot_sobregiros NUMBER := 0;
            BEGIN
               SELECT nvl(COUNT(s.nro_cuenta), 0)
                 INTO v_tot_sobregiros
                 FROM cc_sobregiros s
                WHERE s.nro_cuenta = cr.nro_cuenta
                  AND to_char(s.fecha, 'yyyymm') = to_char(v_fec_extracto, 'yyyymm');
               IF v_tot_sobregiros = 0 THEN
                  v_tae := 0;
                  v_tan := 0;
               END IF;
            EXCEPTION
               WHEN OTHERS THEN
                  v_msj_bitacora := v_msj_bitacora || ', obtSobregiros: ' || substr(sqlerrm, 1, 100);
                  NULL;
            END;
         END IF;

         v_extractoCuentas.nroCuenta               := cr.nro_cuenta;
         v_extractoCuentas.descripcion             := cr.des_cta;
         v_extractoCuentas.saldoAnteriorContable   := cr.sal_anterior_con;
         v_extractoCuentas.saldoActualContable     := cr.sal_actual_con;
         v_extractoCuentas.saldoActualBloqueado    := cr.sal_actual_bloq;
         v_extractoCuentas.saldoAnteriorDisponible := cr.sal_ant_disp;
         v_extractoCuentas.saldoActualDisponible   := cr.sal_actual_disp;
         v_extractoCuentas.tasaNominal             := v_tan;
         v_extractoCuentas.tasaEfectiva            := v_tae;
         v_extractoCuentas.nroCuentaCombinada      :=cr.nro_cta_combinada;
         v_extractoCuentas.fechaExtracto           :=cr.fec_extracto;
         --v_extractoCuentas.
         --v_saldo_anterior := cr.sal_ant_disp; DDSI-306
         v_saldo_anterior := cr.sal_anterior_con;

         v_cuentasCliente.extend;
         v_cuentasCliente(v_cuentasCliente.count) := v_extractoCuentas;
      END LOOP;

      -- Obtiene Detalle de movimiento de la cuenta

      v_msg_error := MSG_OBT_MOV_ER;

      FOR mr IN (SELECT e.nro_cuenta nro_cuenta, e.nro_documento numero, fue_obt_titulo(nvl(t.descripcion, e.concepto)) concepto, nvl(e.fec_movimiento, SYSDATE) fecha_confirmacion, nvl(e.fec_valor, SYSDATE) fecha_transaccion, e.mto_debito monto_debito, e.mto_credito monto_credito, o.cod_oficina /*o.descripcion descripcion_oficina*/, e.cod_tra_padre,
                        e.cod_modulo, e.cod_modalidad --DDEVOLUT-363
                   FROM ge_transacciones t, ge_ext_cli_movimientos e, ba_oficinas o, ge_cta_clientes cc
                  WHERE t.cod_modulo(+) = e.cod_modulo
                    AND t.cod_modalidad(+) = e.cod_modalidad
                    AND t.cod_transaccion(+) = e.cod_tra_padre
                    AND o.cod_oficina(+) = e.cod_ofi_origen
                    AND e.nro_cuenta = cc.nro_cuenta
                    AND cc.cod_persona = v_codPersona
                    AND cc.relacion IN ('O', 'P', 'Y') -- se deben podeer consultar extratos de ctas conjuntas
                    AND e.fec_extracto = v_fec_extracto
                    AND e.nro_cuenta = p_nroCuenta
                  ORDER BY e.fec_insercion /*e.fec_movimiento, e.hor_movimiento, e.nro_secuencia*/) LOOP

         v_saldo_anterior := v_saldo_anterior + (mr.monto_credito - mr.monto_debito);

         v_extractoMovimientos.nroComprobante     := mr.numero;
         v_extractoMovimientos.descripcionOficina := mr.cod_oficina; --mr.descripcion_oficina;
         v_extractoMovimientos.concepto           := mr.concepto;
         v_extractoMovimientos.fechaTransaccion   := mr.fecha_transaccion;
         v_extractoMovimientos.fechaConfirmacion  := mr.fecha_confirmacion;
         v_extractoMovimientos.montoDebito        := mr.monto_debito;
         v_extractoMovimientos.montoCredito       := mr.monto_credito;
         v_extractoMovimientos.saldo              := v_saldo_anterior;
         v_extractoMovimientos.transaccionPadre   := mr.cod_tra_padre;
         v_extractoMovimientos.moduloPadre        := mr.Cod_Modulo;
         v_extractoMovimientos.modalidadPadre     := mr.cod_modalidad;

         v_detallesMovimiento.extend;
         v_detallesMovimiento(v_detallesMovimiento.count) := v_extractoMovimientos;
      END LOOP;

      -- Obtiene Detalle de retenciones de la cuenta

      v_msg_error := MSG_OBT_RET_ER;

      FOR retr IN (SELECT a.nro_documento, fue_obt_titulo(c.descripcion) descripcion, a.fec_movimiento, a.fec_liberacion, a.monto
                     FROM ge_retenciones c, ge_cuentas b, ge_ext_cli_mov_retenidos a, ge_cta_clientes cc
                    WHERE a.cod_retencion = c.cod_retencion
                      AND a.nro_cuenta = b.nro_cuenta(+)
                      AND a.nro_cuenta = cc.nro_cuenta
                      AND cc.cod_persona = v_codPersona
                      AND cc.relacion IN ('O', 'P', 'Y') -- se deben podeer consultar extratos de ctas conjuntas
                      AND a.nro_cuenta = p_nroCuenta
                      AND a.fec_extracto = v_fec_extracto
                      AND a.fre_extracto = v_fre_extracto
                    ORDER BY a.fec_movimiento) LOOP

         v_extractoRetenciones.nroDocumento    := retr.nro_documento;
         v_extractoRetenciones.descripcion     := retr.descripcion;
         v_extractoRetenciones.fechaMovimiento := retr.fec_movimiento;
         v_extractoRetenciones.fechaLiberacion := retr.fec_liberacion;
         v_extractoRetenciones.monto           := retr.monto;

         v_retencionesCuenta.extend;
         v_retencionesCuenta(v_retencionesCuenta.count) := v_extractoRetenciones;
      END LOOP;

      -- Obtiene Detalle de resumen de la cuenta

      v_msg_error := MSG_OBT_RES_ER;

      FOR resr IN (SELECT r.nro_cuenta,
                          'resumen de ' || decode(r.tipo, '1', 'plazo fijo', '2', 'certificado de depositos de ahorro', '3', 'prestamos', '4', 'tarjetas', '5', 'linea de sobregiro', '6', 'titulos de inversion') tipo_resumen,
                          decode(r.tipo, '3', fue_obt_titulo(m.descripcion), '4', fue_obt_titulo(m.descripcion), '5', 'Línea de Sobregiro', r.beneficiario) modalidad,
                          decode(r.tipo, '5', NULL, r.fec_inicio) fec_inicio,
                          r.fec_vencimiento,
                          r.mto_capital,
                          decode(r.tipo, '3', r.mto_interes, '4', r.mto_interes, '5', r.sal_disponible, NULL) mto_interes,
                          r.cod_moneda,
                          decode(r.tipo, '3', r.sal_disponible, '4', r.sal_disponible, r.mto_interes) saldo
                     FROM ge_modalidades m, ge_ext_resumenes r, ge_cta_clientes cc
                    WHERE m.cod_modulo = to_number(substr(ltrim(to_char(m.cod_modalidad)), 1, 1))
                      AND m.cod_modalidad = r.cod_modalidad
                      AND r.nro_cuenta = cc.nro_cuenta
                      AND cc.cod_persona = v_codPersona
                      AND cc.relacion IN ('O', 'P', 'Y') -- se deben podeer consultar extratos de ctas conjuntas
                      AND r.fec_extracto = v_fec_extracto
                      AND r.fre_extracto = v_fre_extracto
                      AND cc.nro_cuenta = nvl(p_nroCuenta, cc.nro_cuenta)
                      AND r.tipo IS NOT NULL
                    ORDER BY r.tipo, r.nro_cuenta) LOOP

         v_extractoResumenes.nroCuenta        := resr.nro_cuenta;
         v_extractoResumenes.tipoResumen      := upper(substr(resr.tipo_resumen, 1, 65));
         v_extractoResumenes.modalidad        := substr(resr.modalidad,0,100);
         v_extractoResumenes.fechaInicio      := nvl(resr.fec_inicio,sysdate);
         v_extractoResumenes.fechaVencimiento := resr.fec_vencimiento;
         v_extractoResumenes.montoCapital     := resr.mto_capital;
         v_extractoResumenes.montoInteres     := resr.mto_interes;
         v_extractoResumenes.codigoMoneda     := resr.cod_moneda;
         v_extractoResumenes.saldoDisponible  := resr.saldo;

         v_resumenesCuenta.extend;
         v_resumenesCuenta(v_resumenesCuenta.count) := v_extractoResumenes;
      END LOOP;

      -- Obtiene Detalle de bloqueo de la cuenta

      v_msg_error := MSG_OBT_BLO_ER;

      FOR blor IN (SELECT a.nro_cuenta, fue_obt_titulo(b.descripcion) des_cau_bloqueo, a.fec_inicio, a.fec_fin, a.monto, d.cod_moneda
                     FROM ge_bloqueos a, ge_causales b, ge_cta_clientes c, ge_cuentas d
                    WHERE a.cod_causa = b.cod_causa
                      AND a.cod_causa IN (SELECT cod_causa
                                            FROM ge_par_causales
                                           WHERE parametro = 'COD_CAU_BLO_EXT'
                                             AND val_parametro = 'S')
                      AND a.fec_inicio <= v_fec_extracto
                      AND (a.fec_fin IS NULL OR fec_fin >= v_fec_extracto)
                      AND c.nro_cuenta = a.nro_cuenta
                      AND d.nro_cuenta = c.nro_cuenta
                      AND c.cod_persona = v_codPersona
                      AND a.nro_cuenta = nvl(p_nroCuenta, a.nro_cuenta)) LOOP

         v_extractoBloqueos.nroCuenta    := blor.nro_cuenta;
         v_extractoBloqueos.causaBloqueo := blor.des_cau_bloqueo;
         v_extractoBloqueos.fechaInicio  := blor.fec_inicio;
         v_extractoBloqueos.fechaFin     := blor.fec_fin;
         v_extractoBloqueos.monto        := blor.monto;
         v_extractoBloqueos.codigoMoneda := blor.cod_moneda;

         v_bloqueosCuenta.extend;
         v_bloqueosCuenta(v_bloqueosCuenta.count) := v_extractoBloqueos;
      END LOOP;

      -- Carga el retorno
      v_msg_error := MSG_ERROR;

      IF v_cuentasCliente.Count > 0 THEN
         v_retorno.cuentasCliente := v_cuentasCliente;
      END IF;
      IF v_detallesMovimiento.Count > 0 THEN
         v_retorno.detallesMovimiento := v_detallesMovimiento;
      END IF;
      IF v_retencionesCuenta.Count > 0 THEN
         v_retorno.retencionesCuenta := v_retencionesCuenta;
      END IF;
      IF v_resumenesCuenta.Count > 0 THEN
         v_retorno.resumenesCuenta := v_resumenesCuenta;
      END IF;
      IF v_bloqueosCuenta.Count > 0 THEN
         v_retorno.bloqueosCuenta := v_bloqueosCuenta;
      END IF;


      v_retorno.imagenLogo := fug_obt_dat_entidad(p_opcion => 'BW_LOGO',
                                                  p_fecha  => to_char(v_fec_extracto, 'dd/mm/yyyy'),
                                                  p_tipo   => 'FA');
      v_retorno.nombreEntidad := fug_obt_dat_entidad(p_opcion => 'NOM',
                                                     p_fecha  => to_char(v_fec_extracto, 'dd/mm/yyyy'),
                                                     p_tipo   => 'FA');

      paw_uti.pr_insertarbitacora(userinfo.codigoPersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.bitacora_salida);
      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeusuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarbitacora(userinfo.codigoPersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [ ' || substr(SQLERRM, 1, 200) || ']' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.bitacora_error);
         RETURN v_retorno;
   END;

   -- Pago de Préstamos
   FUNCTION fu_pagoPrestamo(p_sesion             IN VARCHAR2,
                            p_codCanal           IN VARCHAR2,
                            p_nroPrestamo        IN VARCHAR2,
                            p_cuentaDebito       IN VARCHAR,
                            p_cantCuotas         IN VARCHAR2,
                            p_montoOperacion     IN VARCHAR2,
                            p_modo               IN VARCHAR2,
                            p_claveToken         IN VARCHAR2,
                            p_claveTransaccional IN VARCHAR2) RETURN typ_pagoPrestamo IS
   PRE_CTA_INVALIDA     CONSTANT VARCHAR2(15) := 'PRE_CTA_INVALID';
   PRE_CUO_YA_INGRESADA CONSTANT VARCHAR2(15) := 'PRE_CUO_YA_INGR';
   PRE_CUO_PEN_AUTORIZA CONSTANT VARCHAR2(15) := 'PRE_CUO_PEN_AUT';
   PRE_MON_DIFERENTES   CONSTANT VARCHAR2(15) := 'PRE_MON_DIFEREN';
   PRE_MON_LOC_INVALIDA CONSTANT VARCHAR2(15) := 'PRE_MON_LOC_INV';
   PRE_TOT_DEP_INVALIDO CONSTANT VARCHAR2(15) := 'PRE_TOT_DEP_INV';
   CTA_DEB_INVALIDA     CONSTANT VARCHAR2(15) := 'CTA_DEB_INVALID';
   PRE_MTO_INVALIDO     CONSTANT VARCHAR2(15) := 'PRE_MTO_INVALID';
   PRE_OTRO_ERROR       CONSTANT VARCHAR2(15) := 'PRE_OTRO_ERROR';
   PRE_ERROR            CONSTANT VARCHAR2(15) := 'PRE_ODB_DIS_ERR';
   PRE_CTA_DEB_ERROR    CONSTANT VARCHAR2(15) := 'PRE_CTA_DEB_ERR';
   PRE_CUO_INVALIDA     CONSTANT VARCHAR2(15) := 'PRE_CUO_INVALID';
   PRE_PAG_PENDIENTE    CONSTANT VARCHAR2(15) := 'PRE_PAG_PENDIEN';
   PRE_SIN_PERMISO      CONSTANT VARCHAR2(15) := 'PRE_SIN_PERMISO';
   PRE_TRA_INVALIDA     CONSTANT VARCHAR2(15) := 'PRE_TRA_INVALID';
   v_retorno            typ_pagoPrestamo := typ_pagoPrestamo;
   v_cod_operacion      VARCHAR2(3) := '031';
   retValidarSesion     typ_validarSesion;
   retError             typ_mensajeRespuesta := typ_mensajeRespuesta;
   v_mensajeCaja        typ_mensajeCaja;
   v_permiso            typ_obtenerPermisos;
   -- para controlar transacciones duplicadas, default 10 minutos
   v_min_transaccion NUMBER := nvl(to_number(fug_obt_pardinamico('PAW_MIN_TRANSACCION')), 10);
   -- datos recibidos
   v_nro_prestamo VARCHAR2(16); -- nro de préstamo a pagar
   v_modo         VARCHAR2(3); -- modo V/C
   -- datos a responder

   -- variables
   v_nro_cuenta     VARCHAR2(17);
   v_cta_formateada VARCHAR2(17);
   v_nom_titular    VARCHAR2(100);
   v_tip_prestamo   VARCHAR2(35);
   v_cod_moneda     VARCHAR2(3);
   --
   v_cod_mod_cta       NUMBER(4);
   v_cod_mad_cta       NUMBER(4);
   v_cod_ofi_cta       NUMBER(4);
   --
   v_cod_tra_padre   NUMBER(4) := 360;
   v_nro_cta_debito  VARCHAR2(17);
   v_cod_mon_debito  VARCHAR2(4);
   v_nro_sobre       NUMBER(10);
   v_imp_efectivo    NUMBER(18, 2) := 0; -- efectivo
   v_imp_che_n_bco   NUMBER(18, 2) := 0; -- che.ntro.bco
   v_imp_che_o_bco   NUMBER(18, 2) := 0; -- che otros bcos.
   v_imp_debito      NUMBER(18, 2) := 0; -- debito
   v_tot_pago        NUMBER(18, 2) := 0; -- total
   v_can_cuo_pagada  NUMBER(5) := 0;
   -- cuotas
   v_cantidad        NUMBER(5) := 0;
   v_nro_cuota_desde NUMBER(5) := NULL;
   v_nro_cuota_hasta NUMBER(5) := NULL;
   -- variables
   v_mto_cobrado        NUMBER(18, 2); -- Mto cobrado (no se despliega)
   v_tot_capital        NUMBER(18, 2); -- Capital (no se despliega )
   v_tot_interes        NUMBER(18, 2); -- Interés (no se despliega )
   v_tot_cap_int        NUMBER(18, 2); -- Capital + interés + int.adel (DESPLIEGA : importe )
   v_tot_int_adelantado NUMBER(18, 2); -- Interés adelantado (no despliega)
   v_tot_mora           NUMBER(18, 2); -- Mora s/capital (no despliega)
   v_tot_mora_interes   NUMBER(18, 2); -- Mora s/Interés (DESPLIEGA : Mora s/interes )
   v_tot_mora_int_adel  NUMBER(18, 2); -- Mora interés adelantado (no desp)
   v_tot_impuesto       NUMBER(18, 2); -- Total impuesto (DESPLIEGA : ley 125/91)
   v_tot_cargo          NUMBER(18, 2); -- Total cargo (DESPLIEGA : Cargo + IVA )
   v_tot_cargo_iva      NUMBER(18, 2); -- Total cargo IVA  (no desp)
   v_tot_int_descontado NUMBER(18, 2); -- Total interés descontado (no desp)
   v_tot_a_cobrar       NUMBER(18, 2); -- Total a cobrar (DESPLIEGA: cap+int+morai+morac+imp+cargo)
   v_tot_mora_cap       NUMBER(18, 2); -- Total mora s/capital (DESPLIEGA: v_tot_mora+v_tot_mora_int_adel)
   v_tot_punitorio      NUMBER(18, 2); -- Total monto punitorio (DESPLIEGA : Punitorio)
   v_cod_error          VARCHAR2(03) := '000'; -- sin errores
   v_msj_error          VARCHAR2(100) := 'OK'; -- sin errores
   v_dia_mora           NUMBER(10);
   --
   v_cta_for_debito VARCHAR2(17); -- cuenta formateada
   v_cod_mod_debito NUMBER(4); -- modulo de la cuenta
   v_cod_mad_debito NUMBER(4); -- modalidad de la cuenta
   v_cod_ofi_debito NUMBER(4); -- oficina de la cuenta
   v_nom_cta_debito VARCHAR2(100);
   v_cotizacion     NUMBER(18, 4) := NULL;
   v_nro_documento  NUMBER(15);
   -- agregados
   v_fec_valor     DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
   v_hor_actual    VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
   v_nro_operacion NUMBER(10); -- nro único de operación generado por el cliente
   v_nro_secuencia NUMBER(3) := 0;
   -- para lp_ver_horario
   v_horario        VARCHAR2(1);
   v_es_mov_noc     VARCHAR2(1);
   v_es_cta_noc     VARCHAR2(1);
   v_fec_actual     DATE;
   v_resLimite      typ_respuestaLimite;
   v_cant_cob       NUMBER;
   v_msj_bitacora  VARCHAR2(200) := substr('nroPrestamo:'||trim(p_nroPrestamo)
                                                         ||', ctaDebito:'||trim(p_cuentaDebito)
                                                         ||', canCuotas:'||trim(p_cantCuotas)
                                                         ||', mtoOperacion:'||trim(p_montoOperacion)
                                                         ||', modo:'||trim(p_modo), 1, 200);
   CURSOR cuotas(p_nro_cuenta IN VARCHAR2) IS
      SELECT a.nro_cuota,
             -- nvl(sal_capital,0) + nvl(sal_interes,0) + nvl(sal_int_documentado,0) mto_cuota,
             nvl(c.mto_capital, 0) + nvl(c.mto_interes, 0) + nvl(c.mto_int_documentado, 0) + nvl(c.mto_int_moratorio, 0) + nvl(c.mto_int_mor_interes, 0) + nvl(c.mto_int_mor_adelantado, 0) + nvl(c.mto_int_punitorio, 0) + nvl(c.mto_cargo, 0) + nvl(c.mto_impuesto, 0) mto_cuota, a.fec_vencimiento, a.fec_ult_pago,
             /*decode(sign(v_fec_actual - a.fec_vencimiento),1,
                          (v_fec_actual - a.fec_vencimiento), 0 ) se dejo en 0 a pedido de BBVA */ 0 dia_mora
        FROM pr_cobros_tmp c, pr_cuotas a
       WHERE c.nro_cuenta = a.nro_cuenta
         AND c.nro_cuota = a.nro_cuota
       ---
         AND a.nro_cuenta = p_nro_cuenta
         AND a.nro_cuota > 0
         AND a.estado <> 'N'
         AND a.fec_vencimiento <= SYSDATE + 25
    ORDER BY a.nro_cuota;
   BEGIN
   --0. valido la sesión del cliente
   retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);
   IF retValidarSesion.error = 'S' THEN
      v_retorno.error                := retValidarSesion.error;
      v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      RETURN v_retorno;
   END IF;
   --1. Valido la caja
   v_mensajeCaja := lf_val_caja(retValidarSesion);
   IF v_mensajeCaja.error = 'S' THEN
      v_retorno.error                := v_mensajeCaja.error;
      v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
      RETURN v_retorno;
   END IF;

   IF nvl(p_modo, 'x') = 'A' THEN
      -- se verifica que viene de autorizar la operacion
      IF g_aut_operacion = FALSE THEN
         pr_mensajeUsuario(PRE_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
   ELSE
      --controlamos los permisos
      v_permiso := lf_obt_permisos(retValidarSesion, v_cod_operacion); --nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), retValidarSesion.codigoPerfil, v_cod_operacion, retValidarSesion.codigoCanal);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- se verifica que tiene permiso para registrar
      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
         pr_mensajeUsuario(PRE_SIN_PERMISO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
   END IF;

   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
   pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora ||' '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null), BITACORA_ENTRADA);

   -- 2. Para operaciones de prestamo se graba el usuario con el que se conecta
   v_mensajeCaja.codigoUsuario := USER;

   v_nro_prestamo := depurarAlfanumerico(p_nroPrestamo,CUENTA_TAMANO);
   v_modo         := p_modo;

   IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
      -- se confirma directamente la operación, porque no requiere autorización
      v_modo := 'A'; -- CONFIRMACION
   END IF;

   -- 2. busco los datos de la cuentas
   IF v_retorno.error = 'N' THEN
      BEGIN
         SELECT a.nro_cuenta, fug_cta_formateada(a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.nro_cuenta, a.cod_moneda) cta_formateada, fue_obt_nom_persona(b.cod_persona) nom_titular, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) tip_prestamo, a.cod_moneda, a.cod_modulo, a.cod_modalidad, a.cod_oficina
           INTO v_nro_cuenta, v_cta_formateada, v_nom_titular, v_tip_prestamo, v_cod_moneda, v_cod_mod_cta, v_cod_mad_cta, v_cod_ofi_cta
           FROM ge_cta_clientes b, pr_cta_prestamos a
          WHERE a.nro_cuenta = v_nro_prestamo
            AND a.nro_cuenta = b.nro_cuenta
            AND a.cod_modalidad not in (62,608)
            AND b.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
            AND b.relacion = 'P';
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(PRE_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END;
   END IF;

   -- valido la duplicacion de pago de préstamos
   BEGIN
      -- se verifica si existe un pago de cuota pendiente
      SELECT COUNT(*)
        INTO v_cant_cob
        FROM pr_cobros_noc
       WHERE nro_cuenta = v_nro_cuenta
         AND estado = 'I';
      IF v_cant_cob > 0 THEN
         pr_mensajeUsuario(PRE_PAG_PENDIENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||', pr_cobros_noc: ' || v_cant_cob || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- se verifica la similitud de operacion
      SELECT COUNT(*)
        INTO v_cant_cob
        FROM pr_cobros
       WHERE nro_cuenta = v_nro_cuenta
         AND usu_insercion = v_mensajeCaja.codigoUsuario
         AND fecha = v_fec_actual
         AND ((SYSDATE) - fec_insercion) * 1440 <= v_min_transaccion; -- para poder pagar mas de una cuota en el dia

      IF v_cant_cob > 0 THEN
         pr_mensajeUsuario(PRE_CUO_YA_INGRESADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', pr_cobros: ' || v_cant_cob ||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- se verifica si existe un pago pendiente de aprobacion
      IF v_retorno.error = 'N' THEN
         SELECT COUNT(*)
           INTO v_cant_cob
           FROM bw_mov_pendientes
          WHERE nro_cta_contra = v_nro_cuenta
            AND usu_insercion = v_mensajeCaja.codigoUsuario
            AND cod_tip_mensaje = v_cod_operacion
            AND estado = 'P';
         IF v_cant_cob > 0 THEN
            pr_mensajeUsuario(PRE_CUO_PEN_AUTORIZA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', bw_mov_pend:' || v_cant_cob ||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END IF;
      END IF;
   EXCEPTION
      WHEN no_data_found THEN
         NULL;
      WHEN too_many_rows THEN
         pr_mensajeUsuario(PRE_CUO_YA_INGRESADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
   END;

   IF v_retorno.error = 'N' THEN
        -- todo ok, se arma el mensaje de respuesta
        IF v_modo = 'V' THEN
           -- validacion
           -- esta la cuenta en condiciones, verifico el horario del deposito
           retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre,
                                      v_mensajeCaja.codigoOficinaOrigen, v_fec_actual);

           IF retError.error = 'S' THEN
              v_retorno.error := retError.error;
              v_retorno.nombreRespuesta := retError.nombreRespuesta;
              v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lp_ver_horario - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              return v_retorno;
           END IF;
           --
           v_can_cuo_pagada :=  p_cantCuotas;
           v_nro_cta_debito := p_cuentaDebito;
           IF v_nro_cta_debito IS NOT NULL THEN
              IF (instr(v_nro_cta_debito, '-') > 0 OR instr(v_nro_cta_debito, ' ') > 0) THEN
                 -- se extrae los guiones de la cuenta
                 v_nro_cta_debito := to_number(substr(v_nro_cta_debito, 7));
              END IF;
           ELSE
              pr_mensajeUsuario(CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
           END IF;

           IF lf_val_cta_origen(v_nro_cta_debito, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)) = 'N' THEN
              -- no es una cuenta del cliente
              pr_mensajeUsuario(CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_origen(deb) : ' || v_msj_bitacora ||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
           END IF;

           v_nro_cuota_desde := NULL;
           v_nro_cuota_hasta := NULL;
           v_cantidad        := 0;

           pap_pre.PR_INI_AUTORIZACION;
           pap_pre.PR_OBT_DEU_PRESTAMO(v_nro_cuenta, v_fec_actual, 0, 999, v_mensajeCaja.codigoOficinaOrigen , v_mto_cobrado, v_cod_error, v_msj_error, v_tot_capital, v_tot_interes, v_tot_int_adelantado, v_tot_mora, v_tot_mora_interes, v_tot_mora_int_adel, v_tot_punitorio, v_tot_impuesto, v_tot_cargo, v_tot_cargo_iva, v_tot_int_descontado, v_dia_mora, v_cod_tra_padre,
                                  --- cod_tra_padre
                                  'N'); --- cancela

           IF v_cod_error <> 0 THEN
              IF v_cod_error = 25 THEN
                pr_mensajeUsuario(PRE_CUO_PEN_AUTORIZA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              ELSE
                 pr_mensajeUsuario(PRE_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              END IF;
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', MSJ-ERR: [' || v_msj_error || '] ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
              RETURN v_retorno;
           END IF;

           FOR cu IN cuotas(v_nro_cuenta)
           LOOP
              IF v_nro_cuota_desde IS NULL THEN
                 v_nro_cuota_desde := cu.nro_cuota;
              END IF;
              v_cantidad := v_cantidad + 1;
              IF v_cantidad >= v_can_cuo_pagada THEN
                 v_nro_cuota_hasta := cu.nro_cuota;
                 EXIT;
              END IF;
           END LOOP;

           IF v_nro_cuota_desde IS NULL OR v_nro_cuota_hasta IS NULL THEN
              pr_mensajeUsuario(PRE_CUO_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', cuoIni: ' || v_nro_cuota_desde || ', cuoFin:' || v_nro_cuota_hasta || ' ' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
              RETURN v_retorno;
           END IF;

           if v_retorno.error = 'S' then
              return v_retorno;
           end if;

           -- obtengo los datos del préstamo
           pap_pre.PR_INI_AUTORIZACION;
           pap_pre.PR_OBT_DEU_PRESTAMO(v_nro_cuenta, v_fec_actual, v_nro_cuota_desde, v_nro_cuota_hasta, v_mensajeCaja.codigoOficinaOrigen, v_mto_cobrado, v_cod_error, v_msj_error, v_tot_capital, v_tot_interes, v_tot_int_adelantado, v_tot_mora, v_tot_mora_interes, v_tot_mora_int_adel, v_tot_punitorio, v_tot_impuesto, v_tot_cargo, v_tot_cargo_iva, v_tot_int_descontado, v_dia_mora, v_cod_tra_padre,
                                        --- cod_tra_padre
                                       'N'); --- cancela
           IF v_cod_error <> 0 THEN
              pr_mensajeUsuario(PRE_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', MSJ-ERR: [' || v_msj_error ||'] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           ELSE
              -- sumo los totales
              v_tot_cap_int  := nvl(v_tot_capital, 0) + nvl(v_tot_interes, 0) + nvl(v_tot_int_adelantado, 0);
              v_tot_mora_cap := nvl(v_tot_mora, 0) + nvl(v_tot_mora_int_adel, 0);

              v_tot_a_cobrar := nvl(v_tot_cap_int, 0) + nvl(v_tot_mora_interes, 0) + nvl(v_tot_mora_cap, 0) + nvl(v_tot_punitorio, 0) + nvl(v_tot_impuesto, 0) + nvl(v_tot_cargo, 0);
              -- valido la cuenta de debito
              retError := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, nvl(v_tot_a_cobrar, 0), v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, retValidarSesion, v_mensajeCaja);

              if retError.error = 'S' then
                 v_retorno.error := retError.error;
                 v_retorno.nombreRespuesta := retError.nombreRespuesta;
                 v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_debito(deb) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              end if;

              IF v_cod_moneda <> v_cod_mon_debito AND v_retorno.error = 'N' THEN
                 -- moneda diferentes
                 pr_mensajeUsuario(PRE_MON_DIFERENTES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', codMon: ' || v_cod_moneda || ', codMonDeb:' || v_cod_mon_debito || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              END IF;
           END IF;
           -- limite por operación
           IF v_retorno.error = 'N' THEN
              IF v_modo in ('C', 'V', 'A') AND nvl(p_modo,'x') <> 'A' THEN
                 v_resLimite := fu_obtenerLimite(retValidarSesion,
                                                 v_cod_operacion,
                                                 nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                                                 v_nro_cta_debito,
                                                 v_cod_mon_debito,
                                                 503,
                                                 v_cod_tra_padre,
                                                 v_tot_a_cobrar,
                                                 v_modo);

                 IF v_resLimite.error = 'S' THEN
                    v_retorno.error := v_resLimite.error;
                    v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                    v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                    pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', totCuo:' || v_tot_a_cobrar || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                    RETURN v_retorno;
                 END IF;
              END IF;
           END IF;
           --
           IF v_retorno.error = 'N' THEN
              v_retorno.cotizacion := v_cotizacion;
              v_retorno.numeroCtaDebito := v_cta_for_debito;
              v_retorno.tipoCtaDebito := v_nom_cta_debito;
              v_retorno.codMoneda := v_cod_mon_debito;
              v_retorno.montoOperacion := v_tot_a_cobrar;
              v_retorno.nombreCtaDebito := v_nom_titular;
              v_retorno.totalInteres := nvl(v_tot_cap_int, 0);
              v_retorno.totalMora := nvl(v_tot_mora_cap, 0) + nvl(v_tot_mora_interes, 0);
              v_retorno.totalCargos := nvl(v_tot_cargo, 0) + nvl(v_tot_punitorio, 0);
              v_retorno.totalImpuestos := nvl(v_tot_impuesto, 0);
              v_retorno.numeroPrestamo := v_nro_cuenta;
              v_retorno.resLimite      := v_resLimite.codRespuesta;
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', resLim: ' || v_resLimite.codRespuesta || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
           END IF;
           return v_retorno;
        ELSIF v_modo IN ('A', 'C') THEN
           -- confirmacion de operacion
           -- esta la cuenta en condiciones, verifico el horario del deposito
           retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre,
                                           -- IN
                                          v_mensajeCaja.codigoOficinaOrigen,
                                           -- IN
                                          v_fec_actual);

           IF retError.error = 'S' THEN
              v_retorno.error := retError.error;
              v_retorno.nombreRespuesta := retError.nombreRespuesta;
              v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
              pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lp_ver_horario - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
           END IF;
           -- verifico la validez de los montos
           BEGIN
              v_can_cuo_pagada := p_cantCuotas;
              v_nro_cta_debito := p_cuentaDebito;
              IF v_nro_cta_debito IS NOT NULL THEN
                 IF (instr(v_nro_cta_debito, '-') > 0 OR instr(v_nro_cta_debito, ' ') > 0) THEN
                    -- se extrae los guiones de la cuenta
                    v_nro_cta_debito := to_number(substr(v_nro_cta_debito, 7));
                 END IF;
              ELSE
                 pr_mensajeUsuario(CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 RETURN v_retorno;
              END IF;

              v_nro_cuota_desde := NULL;
              v_nro_cuota_hasta := NULL;
              v_cantidad        := 0;
              FOR cu IN cuotas(v_nro_cuenta)
              LOOP
                 IF v_nro_cuota_desde IS NULL THEN
                    v_nro_cuota_desde := cu.nro_cuota;
                 END IF;
                 v_cantidad := v_cantidad + 1;
                 v_imp_debito := v_imp_debito + cu.mto_cuota;
                 IF v_cantidad >= v_can_cuo_pagada THEN
                    v_nro_cuota_hasta := cu.nro_cuota;
                    EXIT;
                 END IF;
              END LOOP;

              IF v_nro_cuota_desde IS NULL OR v_nro_cuota_hasta IS NULL THEN
                 pr_mensajeUsuario(PRE_CUO_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 RETURN v_retorno;
              END IF;

              v_nro_sobre     := 0;
              v_imp_efectivo  := 0;
              v_imp_che_n_bco := 0;
              v_imp_che_o_bco := 0;
              -- el importe del debito se saca del cursor de cuotas para validar el parametro p_montoOperacion
              -- v_imp_debito    := p_montoOperacion;
              v_tot_pago      := p_montoOperacion;

              IF v_cod_moneda = v_cod_mon_local THEN
                 IF v_imp_efectivo <> trunc(v_imp_efectivo) OR v_imp_che_n_bco <> trunc(v_imp_che_n_bco) OR v_imp_che_o_bco <> trunc(v_imp_che_o_bco) OR v_imp_debito <> trunc(v_imp_debito) THEN
                    -- monto con decimales y en guaranies no permite
                    pr_mensajeUsuario(PRE_MON_LOC_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 ELSIF nvl(v_imp_efectivo, 0) + nvl(v_imp_che_n_bco, 0) + nvl(v_imp_che_o_bco, 0) + nvl(v_imp_debito, 0) <> nvl(v_tot_pago, 0) THEN
                    -- total depositado invalido
                    pr_mensajeUsuario(PRE_TOT_DEP_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', impDeb: '|| v_imp_debito || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 END IF;
              END IF;
              IF v_nro_cta_debito IS NOT NULL THEN
                 -- valido la cuenta de debito
                 retError := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, nvl(v_tot_pago, 0), v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, retValidarSesion, v_mensajeCaja);
                 IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
                    -- se confirma directamente la operacion, porque no requiere autorizacion
                    v_modo := 'A'; -- CONFIRMACION
                 END IF;

                 IF v_retorno.error = 'N' AND retError.error = 'S' THEN
                    v_retorno.error := retError.error;
                    v_retorno.nombreRespuesta := retError.nombreRespuesta;
                    v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                 END IF;
              END IF;
           EXCEPTION
              WHEN OTHERS THEN
                 -- monto invalido
                 pr_mensajeUsuario(PRE_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           END;
           IF v_retorno.error = 'N' AND v_nro_cta_debito IS NOT NULL THEN
              IF lf_val_cta_origen(v_nro_cta_debito, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)) = 'N' THEN
                 -- no es una cuenta del cliente
                 pr_mensajeUsuario(CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_val_cta_origen(deb) - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              END IF;
           END IF;

           -- se agrega control de límite de operaciones
           IF v_retorno.error = 'N' THEN
              v_resLimite := fu_obtenerLimite(retValidarSesion,
                                              v_cod_operacion,
                                              nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                                              v_nro_cta_debito,
                                              v_cod_mon_debito,
                                              503,
                                              v_cod_tra_padre,
                                              v_tot_pago,
                                              v_modo);

              IF v_resLimite.error = 'S' THEN
                 v_retorno.error := v_resLimite.error;
                 v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                 v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              END IF;
           END IF;

           -- se controlan las claves según respuesta de límites
           IF v_retorno.error = 'N' THEN
              IF nvl(p_modo, 'x') <> 'A' AND v_modo in ('C','A') THEN
                 retError.error := 'N';
                 DECLARE
                    v_lugar VARCHAR2(50);
                 BEGIN
                    IF v_resLimite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
                       v_lugar  := 'lf_obt_cla_validar - ';
                       retError := lf_obt_cla_validar(p_claveTransaccional, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, 'T');
                    END IF;

                    IF retError.error = 'N' THEN
                       IF v_resLimite.codRespuesta IN ('01', '11') THEN -- token requerido
                          v_lugar  := 'paw_seg.fu_obt_tok_validar - ';
                          retError := paw_seg.fu_obt_tok_validar(p_claveToken, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, v_modo);
                       END IF;
                    END IF;

                    IF retError.error = 'S' THEN
                       v_retorno.error := retError.error;
                       v_retorno.nombreRespuesta := retError.nombreRespuesta;
                       v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                       pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_lugar || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                    END IF;
                 END;
              END IF;
           END IF;
           IF v_retorno.error = 'N' AND v_modo = 'C' THEN
              -- grabacion en pendiente
              IF v_imp_debito > 0 THEN
                 --- inserto el movimiento pendiente de autorizacion
                 SELECT s_nro_documento.NEXTVAL
                   INTO v_nro_documento
                   FROM dual;
                 INSERT INTO bw_mov_pendientes
                    (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, nro_cta_contra, etiqueta, dato, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra, etiqueta2, dato2)
                 VALUES
                    (v_nro_documento, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito, v_cod_moneda, 'Pago de Prestamos', v_imp_debito, v_nro_prestamo, 'Cant.de Cuotas', v_can_cuo_pagada, 'P', v_can_aut_requeridas, v_can_aut_requeridas, retValidarSesion.codigoPersona /* v_cod_persona */, v_imp_debito, 'Cuota Inicial', v_nro_cuota_desde);

                 -- registro el movimiento
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', autReq: '||v_can_aut_requeridas || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
                 v_retorno.cantAutorizadores := v_can_aut_requeridas;
                 v_retorno.nroDocumento := v_nro_documento;
                 RETURN v_retorno;
              ELSE
                 pr_mensajeUsuario(PRE_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              END IF;
           ELSIF v_retorno.error = 'N' AND v_modo = 'A' THEN
              -- sigue sin problemas hasta aqui, ya puedo grabar
              /*
              -- CR: Se comenta porque siempre es cero segun seteo de p_modo = 'A'
              IF v_imp_efectivo > 0 THEN
                 -- importe en efectivo
                 v_cod_transaccion := 613;
                 -- obtengo el codigo y fin de retencion
                 pag_cta.pr_obt_retencion(v_fec_actual, v_nro_cuenta, v_cod_mod_cta, v_cod_mad_cta, v_cod_transaccion, v_cod_moneda, v_cod_retencion, v_fec_fin_retencion);
                 -- genero el movimiento respectivo
                 lp_ins_movimiento(v_cod_mod_cta, v_cod_mad_cta, v_cod_ofi_cta, v_nro_cuenta, v_cod_moneda, v_cod_tra_padre, v_cod_transaccion, v_nro_sobre, v_imp_efectivo, 'E',
                                    -- EFECTIVO
                                   v_es_mov_noc, v_cod_retencion, v_fec_fin_retencion);
              END IF;


              -- CR: Se comenta porque siempre es cero segun seteo de p_modo = 'A'
              IF v_imp_che_n_bco > 0 THEN
                 -- importe en cheques ntro banco
                 v_cod_transaccion := 614;
                 -- obtengo el codigo y fin de retencion
                 pag_cta.pr_obt_retencion(v_fec_actual, v_nro_cuenta, v_cod_mod_cta, v_cod_mad_cta, v_cod_transaccion, v_cod_moneda, v_cod_retencion, v_fec_fin_retencion);
                 -- genero el movimiento respectivo
                 lp_ins_movimiento(v_cod_mod_cta, v_cod_mad_cta, v_cod_ofi_cta, v_nro_cuenta, v_cod_moneda, v_cod_tra_padre, v_cod_transaccion, v_nro_sobre, v_imp_che_n_bco, 'C',
                                    -- cheque ntro bco
                                   v_es_mov_noc, v_cod_retencion, v_fec_fin_retencion);
              END IF;

              -- CR: Se comenta porque siempre es cero segun seteo de p_modo = 'A'
              IF v_imp_che_o_bco > 0 THEN
                 -- importe en cheques otros bancos
                 v_cod_transaccion := 615;
                 v_tip_monto       := 'O';
                 IF v_horario = 'D' AND v_hor_actual > v_hor_cie_cheques THEN
                    -- se graba ya como cheques 48 hs de retencion
                    v_cod_transaccion := 610;
                    v_tip_monto       := 'T';
                 END IF;
                 -- obtengo el codigo y fin de retencion
                 pag_cta.pr_obt_retencion(v_fec_actual, v_nro_cuenta, v_cod_mod_cta, v_cod_mad_cta, v_cod_transaccion, v_cod_moneda, v_cod_retencion, v_fec_fin_retencion);
                 -- genero el movimiento respectivo
                 lp_ins_movimiento(v_cod_mod_cta, v_cod_mad_cta, v_cod_ofi_cta, v_nro_cuenta, v_cod_moneda, v_cod_tra_padre, v_cod_transaccion, v_nro_sobre, v_imp_che_o_bco, v_tip_monto,
                                    -- cheque otros bcos
                                   v_es_mov_noc, v_cod_retencion, v_fec_fin_retencion);
              END IF;
              */

              -- actualizo el control de caja
             /* UPDATE cj_controles
                 SET tot_che_nue_bco = nvl(tot_che_nue_bco, 0) + nvl(v_imp_che_n_bco, 0),
                     sal_actual      = nvl(sal_actual, 0) + nvl(v_imp_efectivo, 0),
                     tot_debitos     = nvl(tot_debitos, 0) + nvl(v_imp_efectivo, 0),
                     can_debitos     = nvl(can_debitos, 0) + decode(v_imp_efectivo, 0, 0, 1),
                     tot_che_otr_bco = nvl(tot_che_otr_bco, 0) + nvl(v_imp_che_o_bco, 0),
                     sal_che_otr_bco = nvl(sal_che_otr_bco, 0) + nvl(v_imp_che_o_bco, 0),
                     estado          = 1 -- abierto
               WHERE nro_caja = to_number(p_codCanal)
                 AND cod_moneda = v_cod_moneda
                 AND fecha = v_fec_actual;
              IF SQL%NOTFOUND THEN
                 INSERT INTO cj_controles
                    (nro_caja, cod_moneda, fecha, estado, mto_apertura, ini_che_otr_bco, cod_usu_actual, tot_che_nue_bco, sal_actual, tot_debitos, can_debitos, tot_che_otr_bco, sal_che_otr_bco)
                    SELECT p_codCanal, v_cod_moneda, v_fec_actual, 1, 0, 0, v_mensajeCaja.codigoUsuario, v_imp_che_n_bco, v_imp_efectivo, v_imp_efectivo, decode(v_imp_efectivo, 0, 0, 1), v_imp_che_o_bco, v_imp_che_o_bco
                      FROM dual;
              END IF;*/
              IF v_imp_debito > 0 THEN
                 IF v_retorno.error = 'N' THEN
                    -- valido la duplicacion de pago de préstamos
                    retError := fu_ver_transaccion(503, v_cod_tra_padre, v_nro_cta_debito, v_imp_debito, v_mensajeCaja);
                 END IF;

                 IF retError.error = 'S' THEN
                    v_retorno.error := retError.error;
                    v_retorno.nombreRespuesta := retError.nombreRespuesta;
                    v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                    pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 END IF;

                 IF v_retorno.error = 'N' THEN
                    BEGIN
                       SELECT cod_moneda
                         INTO v_cod_mon_debito
                         FROM ge_cuentas
                        WHERE nro_cuenta = v_nro_cta_debito;
                       IF v_cod_mon_debito <> v_cod_moneda THEN
                          pr_mensajeUsuario(PRE_MON_DIFERENTES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', codMon: ' || v_cod_moneda || ', codMonDeb:' || v_cod_mon_debito || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                       END IF;
                    EXCEPTION
                       WHEN OTHERS THEN
                          pr_mensajeUsuario(CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                    END;
                 END IF;
                 -- genero el movimiento respectivo
                 IF v_retorno.error = 'N' THEN
                    -- seteo las variables para el débito
                    pag_cta.PR_SET_VARIABLES(v_mensajeCaja.codigoUsuario, v_fec_valor, v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL, v_mensajeCaja.codigoOficinaOrigen, 9, 91);
                    -- esta la cuenta en condiciones, verifico el horario
                    retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre,v_mensajeCaja.codigoOficinaOrigen,v_fec_actual);

                    if retError.error = 'S' then
                       v_retorno.error := retError.error;
                       v_retorno.nombreRespuesta := retError.nombreRespuesta;
                       v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                       pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lp_ver_horario - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                       return v_retorno;
                    end if;
                    -- genero el numero de operación
                    SELECT s_nro_ope_homebanking.NEXTVAL
                      INTO v_nro_operacion
                      FROM dual;
                    -- realizo el débito respectivo
                    BEGIN
                       -- DDSI-265 -- 02/2018 : Se busca una hora disponible
                       v_hor_actual := fug_obt_hor_disponible(v_fec_actual, v_hor_actual, user, v_es_mov_noc);
                       pag_cta.PR_ACT_OPERACION(v_nro_cta_debito, v_hor_actual, 'D', v_cod_mon_debito, v_imp_debito, v_cod_tra_padre, 503, v_nro_operacion, NULL, v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */, 9, 91, NULL, NULL, 'Pago de Prestamos', 'N', v_nro_secuencia, v_fec_valor, NULL, NULL, NULL);
                    EXCEPTION
                       WHEN OTHERS THEN
                          pr_mensajeUsuario(PRE_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', pr_act_operacion: [' || SUBSTR(SQLERRM, 1, 100) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                          RETURN v_retorno;
                    END;
                    IF nvl(pag_cta.g_cod_error, 0) <> 0 THEN
                       -- hubo error en el débito
                        pr_mensajeUsuario(PRE_CTA_DEB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'pr_act_operacion(deb) - ' || v_msj_bitacora || ', MSJ-ERROR: [' || pag_cta.G_MSJ_ERROR || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                    ELSE
                       -- comprobante de la operación
                       v_retorno.nroDocumento := v_nro_operacion;
                       -- veo si el préstamo, debe quedar como pagado
                       IF v_horario IN ('T', 'N') THEN
                          -- insert into pr_cobros_noc para procesar en el inicio de dia.
                          INSERT INTO pr_cobros_noc
                             (nro_cuenta, nro_cuota_desde, nro_cuota_hasta, fecha, hora, estado, mto_cobrado, cod_ofi_origen, cod_mod_padre, cod_mad_padre, cod_tra_padre, nro_secuencia)
                          VALUES
                             (v_nro_cuenta, v_nro_cuota_desde, v_nro_cuota_hasta, v_fec_actual, v_hor_actual, 'I', v_tot_pago, v_mensajeCaja.codigoOficinaOrigen, 9, 91, v_cod_tra_padre, v_nro_secuencia);
                          --
                          pr_mensajeUsuario(MSG_OK_NOC, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                       ELSE
                          -- horario normal, se aplica el préstamo
                          BEGIN
                             pap_pre.pr_cob_prestamo(v_nro_cuenta, v_tot_pago, 'N', v_mensajeCaja.codigoOficinaOrigen, v_nro_cuota_desde, v_nro_cuota_hasta, 'Pago de Cuota',
                                                     --concepto
                                                     v_fec_actual, v_hor_actual, v_nro_secuencia, v_cod_tra_padre, 9, 91, 'N');
                          EXCEPTION
                             WHEN OTHERS THEN
                                pr_mensajeUsuario(PRE_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', pr_cob_prestamo: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                                RETURN v_retorno;
                          END;
                       END IF;
                       -- registro del movimiento
                       lp_reg_operacion(v_nro_prestamo, v_cod_moneda, v_tot_pago, v_nro_cta_debito, v_cantidad, 'Efectivo', v_imp_efectivo, 'Cheques', v_imp_che_n_bco + v_imp_che_o_bco, 'yaguarete - aprobacion', NULL, '000', retValidarSesion.codigopersona, v_cod_operacion, v_nro_operacion, p_codcanal, p_sesion, retValidarSesion.codigoempresa);
                    END IF;
                 END IF;
              END IF;
           END IF;
        END IF;
        IF v_retorno.error = 'N' THEN
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null)||' nro_sobre:'||v_nro_sobre, BITACORA_SALIDA);
        END IF;
        RETURN v_retorno;
     ELSE
        RETURN v_retorno;
     END IF;
  EXCEPTION
     WHEN OTHERS THEN
        pr_mensajeUsuario(PRE_OTRO_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || ']', BITACORA_ERROR);
        RETURN v_retorno;
  END;
  -- Fin Pago de Préstamos

   FUNCTION fu_obtenerCuotasPrestamo(p_sesion      IN VARCHAR2,
                                     p_codCanal    IN VARCHAR2,
                                     p_nroPrestamo IN VARCHAR2) RETURN typ_obtCuotasPrestamo IS
      PRE_CTA_INVALIDA  CONSTANT VARCHAR2(15) := 'PRE_CTA_INVALID';
      PRE_CUO_PEN_AUTORIZA CONSTANT VARCHAR2(15) := 'PRE_CUO_PEN_AUT';
      v_retorno        typ_obtCuotasPrestamo := typ_obtCuotasPrestamo;
      detalleCuota     typ_cuotaPrestamo := typ_cuotaPrestamo;
      listaCuotas      typ_listaCuotaPrestamo := typ_listaCuotaPrestamo();
      retValidarSesion typ_validarSesion;
      retError         typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_mensajeCaja    typ_mensajeCaja;
      -- datos recibidos
      -- variables
      v_nro_cuenta    VARCHAR2(17);
      v_cod_tra_padre NUMBER(4) := 360;
      -- cuotas
      v_can_cuotas      NUMBER(5) := 0;
      v_nro_cuota_desde NUMBER(5) := NULL;
      v_nro_cuota_hasta NUMBER(5) := NULL;
      -- variables
      v_mto_cobrado        NUMBER(18, 2); -- Mto cobrado (no se despliega)
      v_tot_capital        NUMBER(18, 2); -- Capital (no se despliega )
      v_tot_interes        NUMBER(18, 2); -- Interes (no se despliega )
      v_tot_int_adelantado NUMBER(18, 2); -- Interes adelantado (no despliega)
      v_tot_mora           NUMBER(18, 2); -- Mora s/capital (no despliega)
      v_tot_mora_interes   NUMBER(18, 2); -- Mora s/Interes (DESPLIEGA : Mora s/interes )
      v_tot_mora_int_adel  NUMBER(18, 2); -- Mora interes adelantado (no desp)
      v_tot_impuesto       NUMBER(18, 2); -- Total impuesto (DESPLIEGA : ley 125/91)
      v_tot_cargo          NUMBER(18, 2); -- Total cargo (DESPLIEGA : Cargo + IVA )
      v_tot_cargo_iva      NUMBER(18, 2); -- Total cargo IVA  (no desp)
      v_tot_int_descontado NUMBER(18, 2); -- Total interes descontado (no desp)
      v_tot_punitorio      NUMBER(18, 2); -- Total monto punitorio (DESPLIEGA : Punitorio)
      v_cod_error          VARCHAR2(03) := '000'; -- sin errores
      v_msj_error          VARCHAR2(100) := 'OK'; -- sin errores
      v_dia_mora           NUMBER(10);
      v_cod_operacion      VARCHAR2(3) := '031';
      -- para lp_ver_operacion
      v_horario            VARCHAR2(1);
      v_es_mov_noc         VARCHAR2(1);
      v_es_cta_noc         VARCHAR2(1);
      v_fec_actual         DATE;
      CURSOR cuotas(p_nro_cuenta IN VARCHAR2) IS
         SELECT a.nro_cuota,
                -- nvl(sal_capital,0) + nvl(sal_interes,0) + nvl(sal_int_documentado,0) mto_cuota,
                nvl(c.mto_capital, 0) + nvl(c.mto_interes, 0) + nvl(c.mto_int_documentado, 0) + nvl(c.mto_int_moratorio, 0) + nvl(c.mto_int_mor_interes, 0) + nvl(c.mto_int_mor_adelantado, 0) + nvl(c.mto_int_punitorio, 0) + nvl(c.mto_cargo, 0) + nvl(c.mto_impuesto, 0) mto_cuota, a.fec_vencimiento, a.fec_ult_pago,
                /* decode(sign(v_fec_actual - a.fec_vencimiento),1,
                         (v_fec_actual - a.fec_vencimiento), 0 ) se dejo en 0 a pedido de BBVA */ 0 dia_mora
           FROM pr_cobros_tmp c, pr_cuotas a
          WHERE c.nro_cuenta = a.nro_cuenta
                AND c.nro_cuota = a.nro_cuota
               ---
                AND a.nro_cuenta = p_nro_cuenta
                AND a.nro_cuota > 0
                AND a.estado <> 'N'
                AND a.fec_vencimiento <= SYSDATE + 25
          ORDER BY a.nro_cuota;

   BEGIN

      --0. valido la sesión del cliente
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);

      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      --1. Valido la caja
      v_mensajeCaja := lf_val_caja(retValidarSesion);
      IF v_mensajeCaja.error = 'S' THEN
         v_retorno.error                := v_mensajeCaja.error;
         v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:' || p_nroPrestamo || ' ' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ENTRADA);

      -- seleccion de datos
      -- esta la cuenta en condiciones, verifico el horario del deposito
      -- cuotas del prestamo
      retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre, v_mensajeCaja.codigoOficinaOrigen, v_fec_actual);

      IF retError.error = 'S' THEN
         v_retorno.error                := retError.error;
         v_retorno.nombreRespuesta      := retError.nombreRespuesta;
         v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lp_ver_horario - Nro. Prestamo:' || p_nroPrestamo || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      BEGIN
         SELECT a.nro_cuenta
           INTO v_nro_cuenta
           FROM ge_cta_clientes b, pr_cta_prestamos a
          WHERE a.nro_cuenta = p_nroPrestamo
            AND a.nro_cuenta = b.nro_cuenta
            AND b.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
            AND b.relacion = 'P';
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(PRE_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:' || p_nroPrestamo || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      v_can_cuotas := 0;
      ---- Desde aca
      v_nro_cuota_desde := 0;
      v_nro_cuota_hasta := 999;
      pap_pre.PR_INI_AUTORIZACION;
      pap_pre.PR_OBT_DEU_PRESTAMO(v_nro_cuenta, v_fec_actual, v_nro_cuota_desde, v_nro_cuota_hasta, v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */, v_mto_cobrado, v_cod_error, v_msj_error, v_tot_capital, v_tot_interes, v_tot_int_adelantado, v_tot_mora, v_tot_mora_interes, v_tot_mora_int_adel, v_tot_punitorio, v_tot_impuesto, v_tot_cargo, v_tot_cargo_iva, v_tot_int_descontado, v_dia_mora, v_cod_tra_padre,
                                  --- cod_tra_padre
                                  'N'); --- cancela

      IF v_cod_error <> 0 THEN
         IF v_cod_error = 25 THEN
            pr_mensajeUsuario(PRE_CUO_PEN_AUTORIZA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         ELSE
            pr_mensajeUsuario(PRE_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END IF;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:' || p_nroPrestamo || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- Finalmente verifico si no tiene cobros pendientes de ser aplicados...
      DECLARE
         v_can_pag_pend NUMBER(5) := 0;
      BEGIN
         v_retorno.tienePendientes := 'N';
         SELECT COUNT(0)
           INTO v_can_pag_pend
           FROM pr_cobros_noc
          WHERE nro_cuenta = v_nro_cuenta
            AND estado = 'I';
         IF v_can_pag_pend > 0 THEN
            v_retorno.tienePendientes := 'S';
         END IF;
      END;
      -- no hubo errores, obtengo los detalles de las cuotas
      IF v_retorno.error = 'N' THEN

         FOR cu IN cuotas(v_nro_cuenta)
         LOOP
            v_can_cuotas                  := v_can_cuotas + 1;
            detalleCuota.nroCuota         := cu.nro_cuota;
            detalleCuota.montoCuota       := cu.mto_cuota;
            detalleCuota.fechaVencimiento := cu.fec_vencimiento;

            listaCuotas.EXTEND;
            listaCuotas(listaCuotas.COUNT) := detalleCuota;
         END LOOP;
         v_retorno.cantidadCuotas := v_can_cuotas;
         v_retorno.listaCuotas    := listaCuotas;
         v_retorno.numeroPrestamo := v_nro_cuenta;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:' || p_nroPrestamo || ', canCuotas: '||v_can_cuotas||' '|| fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_SALIDA);
      END IF;

      RETURN v_retorno;
   END;

   /**
   *  saldo diarios
   * @Creado por: Fermín Giménez
   * @Fecha : 13-09-2012
   * @param p_sesion Código de la sesión
   * @param p_codCanal Código del canal
   * @param p_numeroCuenta Numero de cuenta
   * @param p_cantidadDias cantidad de dias.
   * @return Resultado de la operacion
   */
   FUNCTION fu_obtenerSaldosDiarios(p_sesion       IN VARCHAR2,
                                    p_codCanal     IN VARCHAR2,
                                    p_numeroCuenta IN VARCHAR2,
                                    p_cantidadDias IN NUMBER)
                                    RETURN typ_detalleSaldosDiarios IS

      v_listaSaldosDiarios typ_listaSaldosDiarios := typ_listaSaldosDiarios();
      v_retorno            typ_detalleSaldosDiarios := typ_detalleSaldosDiarios;
      saldoDiario          typ_saldoDiario := typ_saldoDiario;

      v_cod_operacion  VARCHAR2(3) := '230';
      retValidarSesion typ_validarSesion;
      v_permiso        typ_obtenerPermisos;
      v_fecDesde       DATE;
      v_moneda         VARCHAR2(3);
      v_can_detalles   NUMBER(3) := 0; -- cantidad de registros
      menRespuesta     typ_mensajeRespuesta := typ_mensajeRespuesta;

      --Codigos de error
      MSG_CODCTA_NOEX    CONSTANT VARCHAR2(15) := 'CODCTA_NOEX'; /**Codigo de Cuenta inexistente*/
      MSG_CTA_NO_CORRESP CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';

      CURSOR saldos(p_fecDesde DATE) IS
         SELECT fecha, sal_tot_cap - sal_blo_int - sal_ret_ade saldo, cat_riesgo
           FROM ge_sal_diarios
          WHERE nro_cuenta = p_numeroCuenta
            AND fecha BETWEEN trunc(p_fecDesde) AND trunc(SYSDATE)
          ORDER BY fecha DESC;

   BEGIN
      --valido la sesión del cliente
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal);

      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- verificacion de permisos
      v_permiso := lf_obt_permisos(retValidarSesion, '020');
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lf_obt_permisos - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      --Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(p_numeroCuenta, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona)) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         menRespuesta.error                := v_retorno.error;
         menRespuesta.nombreRespuesta      := v_retorno.nombreRespuesta;
         menRespuesta.descripcionRespuesta := v_retorno.descripcionRespuesta;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarBitacora(menRespuesta.error,menRespuesta.nombreRespuesta, menRespuesta.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Cuenta - Nro Cta:' || p_numeroCuenta || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ENTRADA);

      --obtengo la moneda del nro de cuenta
      BEGIN
         SELECT x.cod_moneda
           INTO v_moneda
           FROM ge_cuentas x
          WHERE x.nro_cuenta = p_numeroCuenta;
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(MSG_CODCTA_NOEX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Diarios - Nro Cta: ' || p_numeroCuenta || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
            RETURN v_retorno;
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Diarios - Nro Cta: ' || p_numeroCuenta || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      --calculo de la fecha desde
      v_fecDesde := SYSDATE - p_cantidadDias;

      --saldos
      FOR sa IN saldos(v_fecDesde) LOOP
         saldoDiario := typ_saldoDiario;

         v_can_detalles              := v_can_detalles + 1;
         saldoDiario.fecha           := sa.fecha;
         saldoDiario.saldo           := sa.saldo;
         saldoDiario.categoriaRiesgo := sa.cat_riesgo;

         v_listaSaldosDiarios.EXTEND;
         v_listaSaldosDiarios(v_listaSaldosDiarios.COUNT) := saldoDiario;

      END LOOP;

      IF v_retorno.error = 'N' THEN
         v_retorno.cantidadSaldos := v_can_detalles;
         v_retorno.codigoMoneda   := v_moneda;
         v_retorno.numeroCuenta   := p_numeroCuenta;
         v_retorno.cantidadSaldos := 0;
         v_retorno.listaSaldos    := v_listaSaldosDiarios;
         IF NOT v_listaSaldosDiarios IS NULL THEN
            v_retorno.cantidadSaldos := v_listaSaldosDiarios.COUNT;
         END IF;
      END IF;

      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Obtener Saldos Diarios - Nro Cta:' || p_numeroCuenta || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;


   /**
    * Migracion de fu_pro_operacion_032, encargada de realizar el pago de Tarjetas de Crédito
    * @Creado por: Fermín Giménez
    * @Fecha : 12-09-2012
    * @param p_sesion Código de la sesión
    * @param p_codCanal Código del canal
    * @param p_nroTarjetaCredito Numero de tarjeta de credito a pagar
    * @param p_cuentaDebito Numero de cuenta a debitar
    * @param p_modo <ul><il><b>C</b>:Confirmar</il><il><b>V</b>:Verificar</il></ul>
    * @param p_nroSobre: Compatibilidad otros canales
    * @param p_importeEfectivo: Compatibilidad otros canales
    * @param p_importeChequeBanco : Compatibilidad otros canales
    * @param p_importeChequeOtroBanco: Compatibilidad otros canales
    * @param p_importeDebito: Total a debitar de la cuenta
    * @param p_totalPago: Monto a pagar
    * @param p_claveToken  Dependiendo de la configuración de limites operativos
    * @param p_claveTransaccional  Dependiendo de la configuración de limites operativos.
    * @return Resultado de la operacion
   */
   FUNCTION fu_pagoTarjetaCredito(p_sesion                 IN VARCHAR2,
                                  p_codCanal               IN VARCHAR2,
                                  p_nroTarjetaCredito      IN VARCHAR2,
                                  p_cuentaDebito           IN VARCHAR2,
                                  p_modo                   IN VARCHAR2,
                                  p_nroSobre               IN NUMBER,
                                  p_importeEfectivo        IN NUMBER,
                                  p_importeChequeBanco     IN NUMBER,
                                  p_importeChequeOtroBanco IN NUMBER,
                                  p_importeDebito          IN NUMBER,
                                  p_totalPago              IN NUMBER,
                                  p_claveToken             IN VARCHAR2,
                                  p_claveTransaccional     IN VARCHAR2,
                                  p_pagoOnline             IN VARCHAR2)
                                  RETURN typ_pagoTarjetaCredito IS

   -- datos recibidos
       v_nro_tarjeta VARCHAR2(16); -- nro de tarjeta a pagar
       v_modo        VARCHAR2(3); -- modo S/V/C
   -- variables
       v_nro_cuenta        VARCHAR2(17);
       v_embozado          VARCHAR(35);
       --v_tip_tarjeta       VARCHAR2(35);
       v_cod_moneda        VARCHAR2(03);
       v_mto_pag_minimo    NUMBER(18, 2);
       v_deu_ult_cierre    NUMBER(18, 2);
       v_deu_actual        NUMBER(18, 2);
       v_fec_ult_cierre    DATE;
       v_cod_mod_cta       NUMBER(4);
       v_cod_mad_cta       NUMBER(4);
       v_cod_ofi_cta       NUMBER(4);
       v_cod_retencion     NUMBER(4); -- codigo de retencion
       v_fec_fin_retencion DATE; -- fecha final de la retencion
   --
       v_cod_tra_padre   NUMBER(4) := 250;
       v_cod_transaccion NUMBER(4);
       v_nro_cta_debito  VARCHAR2(17);
       v_cod_mon_debito  VARCHAR2(4);
       --v_nro_sobre       NUMBER(10);
       v_imp_efectivo    NUMBER(18, 2) := 0; -- efectivo
       v_imp_che_n_bco   NUMBER(18, 2) := 0; -- che.ntro.bco
       v_imp_che_o_bco   NUMBER(18, 2) := 0; -- che otros bcos.
       v_imp_debito      NUMBER(18, 2) := 0; -- debito
       v_tot_pago        NUMBER(18, 2) := 0; -- total
       v_cta_for_debito  VARCHAR2(17); -- cuenta formateada
       v_cod_mod_debito  NUMBER(4); -- modulo de la cuenta
       v_cod_mad_debito  NUMBER(4); -- modalidad de la cuenta
       v_cod_ofi_debito  NUMBER(4); -- oficina de la cuenta
       v_nom_cta_debito  VARCHAR2(100);
       v_nro_cta_tarjeta VARCHAR2(20);
       v_nro_documento   NUMBER(15);
       v_tip_monto       VARCHAR2(1) := 'O'; -- tipo de cheque
       v_est_envio       ta_cobros.est_envio%TYPE;
       v_afinidad        ta_cta_tarjetas.afinidad%TYPE;
       v_dato2           bw_mov_pendientes.dato2%TYPE;
       -- para control de límites
       v_resLimite       typ_respuestaLimite;
       v_nro_operacion   NUMBER(10); -- nro. único de operación generado por el cliente

       v_fec_valor       DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy;
       v_fec_actual      DATE;
       v_hor_actual      VARCHAR2(10) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
       v_hor_cie_cheques VARCHAR2(08) := '12:00:00'; -- hora de cierre fijo para cheques cargo otros bancos.

       v_horario       VARCHAR2(1);
       v_es_mov_noc    VARCHAR2(1);
       v_es_cta_noc    VARCHAR2(1);
       v_nro_secuencia NUMBER(3) := 0;

       userinfo typ_validarsesion;

       v_retorno         typ_pagoTarjetaCredito := typ_pagoTarjetaCredito();
       v_retorno_men_res typ_MensajeRespuesta := typ_MensajeRespuesta;
       v_mensajeCaja     typ_mensajeCaja;
       v_permiso         typ_obtenerPermisos;

       --  Tipos de Mensajes de respuestas
       MSG_CODCTA_NOEX    CONSTANT VARCHAR2(15) := 'CODCTA_NOEX'; /**Codigo de Cuenta inexistente*/
       MSG_OBT_TAR_NE     CONSTANT VARCHAR2(15) := 'OBT_TCR_NE'; /**Nro. tarjeta no encontrado*/
       MSG_CTA_NO_CORRESP CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND'; /**Nro. de Cuenta no corresponde al cliente*/
       MSG_TRA_INVALIDA   CONSTANT VARCHAR2(15) := 'TRA_INVALIDA'; /** Transaccion invalida*/
       MSG_MTO_INVALIDO   CONSTANT VARCHAR2(15) := 'MTO_INVALIDO'; /**Monto invalido*/
       MSG_MTO_INGRESADO  CONSTANT VARCHAR2(15) := 'MTO_INGRESADO'; /**Monto ya ingresado*/
       MSG_MTOPA_INVALIDO CONSTANT VARCHAR2(15) := 'MTOPA_INVALIDO'; /**Monto pagado invalido*/
       MSG_INS_MOV_ER     CONSTANT VARCHAR2(15) := 'INS_MOV_ER'; /**Error al insertar movimiento*/
       MSG_SIN_PERMISO    CONSTANT VARCHAR2(15) := 'TAR_SIN_PERMISO';
       MSG_CTA_CANCELADA  CONSTANT VARCHAR2(15) := 'TAR_CTA_CANCELA';
       TRA_MOV_PEND_AUT   CONSTANT VARCHAR2(15) := 'TAR_MOV_PEND_AU';

       v_msg_error        VARCHAR2(15) := MSG_ERROR;
       v_cod_operacion    VARCHAR2(3) := '032';
       v_codPersona       VARCHAR2(15);
       v_mod_limite       varchar2(3); -- para límite de operaciones
       v_msj_bitacora     VARCHAR2(200) := substr('nroTarjeta:'||trim(p_nroTarjetaCredito)
                                                               ||', modo:'||trim(p_modo)
                                                               ||', ctaDebito:'||trim(p_cuentaDebito)
                                                               ||', nroSobre:'||trim(p_nroSobre)
                                                               ||', impEfe:'||p_importeEfectivo
                                                               ||', impChqBco:'||p_importeChequeBanco
                                                               ||', impChqOtrBco:'||p_importeChequeOtroBanco
                                                               ||', impDeb:'||p_importeDebito
                                                               ||', impTot:'||p_totalPago, 1, 200);

    BEGIN
       -- Valido la Sesión del Cliente
       userinfo := fu_validarSesion(p_sesion, p_codcanal);
       IF userinfo.error = 'S' THEN
          v_retorno.error                := userinfo.error;
          v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
          v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
          RETURN v_retorno;
       END IF;
       -- Verifica el canal de origen
       v_mensajeCaja := lf_val_caja(userinfo);
       IF v_mensajeCaja.error = 'S' THEN
          v_retorno.error                := v_mensajeCaja.error;
          v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
          RETURN v_retorno;
       END IF;
       v_codPersona := NVL(userinfo.codigoEmpresa, userinfo.codigoPersona);

       -- se verifica que viene de autorizar la operacion
       IF nvl(p_modo, 'x') = 'A' THEN
          IF g_aut_operacion = FALSE THEN
             pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             RETURN v_retorno;
          END IF;
       ELSE
          v_permiso := lf_obt_permisos(userinfo, v_cod_operacion); --v_codPersona, userinfo.codigoPerfil, v_cod_operacion, userinfo.codigoCanal);
          IF (v_permiso.error = 'S') THEN
             v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
             v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
             v_retorno.error                := v_permiso.error;
             pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             RETURN v_retorno;
          END IF;
          -- ser verifica que tiene permiso para registrar
          IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
             pr_mensajeUsuario(MSG_SIN_PERMISO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             RETURN v_retorno;
          END IF;
       END IF;
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       v_nro_cta_debito := depurarAlfanumerico(trim(p_cuentaDebito),CUENTA_TAMANO);
       v_nro_tarjeta    := depurarAlfanumerico(trim(p_nroTarjetaCredito),CUENTA_TAMANO);
       v_modo           := p_modo;

       IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
          -- se confirma directamente la operación, porque no requiere autorización
          v_modo := 'A'; -- CONFIRMACION
       END IF;

       --v_nro_sobre     := p_nroSobre;
       v_imp_efectivo  := p_importeEfectivo; -- efectivo
       v_imp_che_n_bco := p_importeChequeBanco; -- che.ntro.bco
       v_imp_che_o_bco := p_importeChequeOtroBanco; -- che otros bcos.
       v_imp_debito    := p_importeDebito; -- total
       v_tot_pago      := p_totalPago; -- total

       pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||' '||fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null), BITACORA_ENTRADA);

       -- 0. Obtengo el nro de cuenta de la tarjeta
       v_msg_error := MSG_OBT_TAR_NE;
       BEGIN
          SELECT a.nro_cuenta
            INTO v_nro_cta_tarjeta
            FROM ge_cta_clientes a, ta_tarjetas b
           WHERE b.nro_tarjeta = v_nro_tarjeta
             AND b.nro_cuenta = a.nro_cuenta
             AND a.cod_persona = v_codPersona;
          -- se agrega afinidad
          SELECT t.afinidad
            INTO v_afinidad
            FROM ta_cta_tarjetas t
           WHERE t.nro_cuenta = v_nro_cta_tarjeta;
       EXCEPTION
          WHEN no_data_found THEN
             pr_mensajeUsuario(MSG_OBT_TAR_NE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             RETURN v_retorno;
       END;

       -- 2. busco los datos de la cuentas
       BEGIN
          pag_cta.pr_obt_cuenta(PAT_IMP.FU_OBT_NRO_CUENTA(v_nro_tarjeta)); -- JIRA-1717
          IF pag_cta.G_COD_ERROR <> 0 THEN
             pr_mensajeUsuario(MSG_OBT_TAR_NE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             RETURN v_retorno;
          END IF;
          IF pag_cta.g_ctas.estado NOT IN ('B','N') THEN -- JIRA-1717
             pr_mensajeUsuario(MSG_CTA_CANCELADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             RETURN v_retorno;
          END IF;
          v_nro_cuenta  := pag_cta.g_ctas.nro_cuenta;
          --v_tip_tarjeta := fug_obt_des_modalidad(pag_cta.g_ctas.cod_modalidad);
          v_cod_moneda  := pag_cta.g_ctas.cod_moneda;
          v_cod_mod_cta := pag_cta.g_ctas.cod_modulo;
          v_cod_mad_cta := pag_cta.g_ctas.cod_modalidad;
          v_cod_ofi_cta :=pag_cta.g_ctas.cod_oficina;
          PAT_IMP.PR_OBT_DEU_TARJETA(v_nro_cuenta,v_nro_tarjeta,v_mto_pag_minimo,
                     v_deu_ult_cierre,v_deu_actual,v_fec_ult_cierre,v_embozado); -- JIRA-1717
       EXCEPTION
          WHEN no_data_found THEN
             pr_mensajeUsuario(MSG_OBT_TAR_NE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             RETURN v_retorno;
       END;
       IF v_cod_mad_cta=55 THEN
          pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;
   /*BEGIN
      SELECT a.nro_cuenta, c.nro_tarjeta, c.nom_embozar, d.descripcion, a.cod_moneda, a.sal_pag_minimo, a.sal_ult_extracto, (nvl(a.sal_facturar, 0) + nvl(a.sal_facturado, 0) + nvl(a.sal_financiado, 0) + nvl(a.sal_cuo_pendientes, 0)), a.fec_ult_cierre, a.cod_modulo, a.cod_modalidad, a.cod_oficina
        INTO v_nro_cuenta, v_nro_tarjeta, v_embozado, v_tip_tarjeta, v_cod_moneda, v_mto_pag_minimo, v_deu_ult_cierre, v_deu_actual, v_fec_ult_cierre, v_cod_mod_cta, v_cod_mad_cta, v_cod_ofi_cta
        FROM ge_modalidades d, ta_tarjetas c, ge_cta_clientes b, ta_cta_tarjetas a
       WHERE a.nro_cuenta = v_nro_cta_tarjeta
             AND a.nro_cuenta = b.nro_cuenta
             AND b.relacion = 'P'
             AND c.nro_tarjeta = v_nro_tarjeta
             AND c.nro_cuenta = b.nro_cuenta
             AND c.vigente = 'S'
             AND d.cod_modulo = a.cod_modulo
             AND d.cod_modalidad = a.cod_modalidad;
   EXCEPTION
      WHEN no_data_found THEN
         pr_mensajeUsuario(MSG_CODCTA_NOEX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||', ctaTarjeta:'||v_nro_cta_tarjeta||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;*/

   -- Valida si es una cuenta del cliente
   IF v_nro_cta_debito IS NOT NULL AND lf_val_cta_origen(v_nro_cta_debito, v_codPersona) = 'N' THEN
      pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      RETURN v_retorno;
   END IF;

   -- Valida Montos
   IF v_cod_moneda = v_cod_mon_local THEN

      IF v_imp_efectivo <> trunc(v_imp_efectivo) OR v_imp_che_n_bco <> trunc(v_imp_che_n_bco) OR v_imp_che_o_bco <> trunc(v_imp_che_o_bco) OR v_imp_debito <> trunc(v_imp_debito) THEN
         -- monto con decimales y en guaranies no permite
         pr_mensajeUsuario(MSG_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF nvl(v_imp_efectivo, 0) + nvl(v_imp_che_n_bco, 0) + nvl(v_imp_che_o_bco, 0) + nvl(v_imp_debito, 0) <> nvl(v_tot_pago, 0) THEN
         -- total depositado invalido
         pr_mensajeUsuario(MSG_MTOPA_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

   END IF;

   -- todo ok, se arma el mensaje de respuesta
   IF v_modo IN ('V', 'C', 'A') THEN
      -- validacion o confirmacion O AUTORIZACION
      -- esta la cuenta en condiciones, verifico el horario del deposito

      IF v_nro_cta_debito IS NOT NULL THEN
         v_retorno_men_res := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_imp_debito,v_cod_mon_debito,
         v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito,
         userinfo, v_mensajeCaja);

         IF (v_retorno_men_res.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_retorno_men_res.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_retorno_men_res.descripcionRespuesta;
            v_retorno.error                := v_retorno_men_res.error;
            pr_insertarBitacora(userinfo.codigopersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;

         IF v_cod_moneda <> v_cod_mon_debito THEN
            -- moneda diferentes
            pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||', monTar: '||v_cod_moneda||', monDeb:'||v_cod_mon_debito||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      ELSE
         IF paw_bce.fu_caj_homebanking(p_codCanal) = 'S' /*userinfo.codigoCanal = CANAL_HB*/ THEN
            -- si el pago es por HB, debe tener una cuenta debito, si es por TAS puede o no tener
            pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
      IF v_imp_debito > 0 THEN
         DECLARE
            v_existe VARCHAR2(1) := 'N';
         BEGIN
            SELECT 'S'
              INTO v_existe
              FROM bw_mov_pendientes
             WHERE cod_per_principal = userinfo.codigoEmpresa
               AND nro_cuenta = v_nro_cta_debito
               AND monto = v_imp_debito
               AND estado = 'P'
               AND cod_tip_mensaje = v_cod_operacion
               AND nro_cta_contra = v_nro_cta_tarjeta
               AND rownum = 1;

            pr_mensajeUsuario(TRA_MOV_PEND_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         EXCEPTION
            WHEN too_many_rows THEN
               pr_mensajeUsuario(TRA_MOV_PEND_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN OTHERS THEN
               NULL;
         END;
         IF v_retorno.error = 'S' THEN
            pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
          -- verifico sino hay pagos con el mismo monto
          IF v_imp_debito > 0 THEN
--            DECLARE
--                v_existe VARCHAR2(1);
             BEGIN
                v_retorno_men_res := fu_ver_transaccion(503,
                                                        v_cod_tra_padre,
                                                        v_nro_cta_debito,
                                                        v_imp_debito,
                                                        v_mensajeCaja);
                IF v_retorno_men_res.error = 'S' THEN
                   v_retorno.error := v_retorno_men_res.error;
                   v_retorno.nombreRespuesta := v_retorno_men_res.nombreRespuesta;
                   v_retorno.descripcionRespuesta := v_retorno_men_res.descripcionRespuesta;

                   pr_mensajeUsuario(MSG_MTO_INGRESADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   RETURN v_retorno;
                END IF;
             END;
          END IF;
          -- caso especial de control de claves antes de envio a Bancard.
          -- ------------------------------------------------------------
          -- para limite de operaciones, si v_modo es 'V' y clave token no es nula se debe pasar
          -- v_modo <> 'V' a fu_obtenerLimite para que no envie devuelta el challenge OTP
          v_mod_limite := v_modo;
          IF v_mod_limite = 'V' AND (TRIM(p_claveToken) IS NOT NULL OR
                                     TRIM(p_claveTransaccional) IS NOT NULL ) THEN
            v_mod_limite := 'C';
          END IF;

          IF p_pagoOnline = 'S' THEN
             v_est_envio := 'W';
          ELSE
             v_est_envio := 'P';
          END IF;

          -- se agrega control de límite de operaciones
          IF nvl(p_modo,'x') <> 'A' AND paw_bce.fu_caj_homebanking(p_codCanal) = 'S' /*p_codCanal = CANAL_HB*/ THEN
             v_resLimite := fu_obtenerLimite(userinfo,
                                             v_cod_operacion,
                                             nvl(userinfo.codigoEmpresa, userinfo.codigoPersona),
                                             v_nro_cta_debito,
                                             v_cod_mon_debito,
                                             503,
                                             v_cod_tra_padre,
                                             v_tot_pago,
                                             v_mod_limite);

             IF v_resLimite.error = 'S' THEN
                v_retorno.error := v_resLimite.error;
                v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                RETURN v_retorno;
             END IF;
          END IF;
          -- se controlan las claves según respuesta de límites
          IF nvl(p_modo, 'x') <> 'A' THEN
             v_retorno_men_res.error := 'N';
             DECLARE
                v_lugar VARCHAR2(50);
             BEGIN
                IF v_resLimite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
                   -- Ajuste por requerimiento de control de clave en la verificación
                   -- antes de envio a bancard, se recibe pedido en modo V para validar la clave transaccional
                   IF v_modo <> 'V' OR (v_modo = 'V' AND p_claveTransaccional IS NOT NULL) THEN
                      v_lugar  := 'lf_obt_cla_validar - ';
                      v_retorno_men_res := lf_obt_cla_validar(p_claveTransaccional, userinfo.codigoPersona, userinfo.codigoEmpresa, 'T');
                   END IF;
                END IF;

                IF v_retorno_men_res.error = 'N' THEN
                   IF v_resLimite.codRespuesta IN ('01', '11') THEN -- token requerido
                      -- Ajuste por requerimiento de control de clave en la verificación,
                      -- antes de envio a bancard, se recibe pedido en modo V para validar el token
                      IF v_modo <> 'V' THEN
                         v_lugar  := 'paw_seg.fu_obt_tok_validar - ';
                         v_retorno_men_res := paw_seg.fu_obt_tok_validar(p_claveToken, userinfo.codigoPersona, userinfo.codigoEmpresa, v_mod_limite);
                      END IF;
                   END IF;
                END IF;

                IF v_retorno_men_res.error = 'S' THEN
                   v_retorno.error := v_retorno_men_res.error;
                   v_retorno.nombreRespuesta := v_retorno_men_res.nombreRespuesta;
                   v_retorno.descripcionRespuesta := v_retorno_men_res.descripcionRespuesta;
                   pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_lugar ||v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   RETURN v_retorno;
                END IF;
             END;
          END IF;

          v_retorno.numeroTarjeta := v_nro_tarjeta;
          v_retorno.nombreTarjeta := v_embozado;
          v_retorno.codigoMoneda  := v_cod_moneda;
          v_retorno.importeDebito := v_imp_debito;
          v_retorno.monedaDebito  := v_cod_mon_debito;
          --Si el modo es Verificar se retorna el resultado aca
          IF v_modo = 'V' THEN
             v_retorno.numeroOperacion:=0;
             v_retorno.respuestaLimite := v_resLimite.codRespuesta;
             pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||', resLim: ' || v_resLimite.codRespuesta || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
             RETURN v_retorno;
          END IF;

          SELECT s_nro_documento.nextval
          INTO v_nro_documento
          FROM dual;

          IF v_modo = 'C' THEN
             -- grabacion en pendiente
             -- registro del movimiento
             v_retorno.numeroOperacion:=v_nro_documento;
             v_retorno.cantidadAutorizadores := v_can_aut_requeridas;
            -- lp_reg_operacion(v_nro_cta_tarjeta, v_cod_moneda, v_tot_pago, v_nro_cta_debito, v_nro_documento, 'Efectivo', v_imp_efectivo, 'Cheques', v_imp_che_n_bco + v_imp_che_o_bco, 'Yag-Nro.Tarj: ' || v_nro_tarjeta||' Nro.Sobre: '||v_nro_sobre,null,'000',userinfo.codigoPersona,v_cod_operacion,v_nro_documento,p_codCanal,p_sesion,userinfo.codigoEmpresa);

              IF v_imp_debito > 0 THEN
                v_dato2 := substr(trim(fug_obt_des_afinidad(v_afinidad)), 1, 50);
                --- inserto el movimiento pendiente de autorizacion
                INSERT INTO bw_mov_pendientes
                   (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, nro_cta_contra, etiqueta, dato, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra, etiqueta2, dato2)
                VALUES
                   (v_nro_documento, v_codPersona, SYSDATE, '032', v_nro_cta_debito, v_cod_moneda, 'Pago de Tarjetas de Credito', v_imp_debito, v_nro_cta_tarjeta, 'Nro. de Tarjeta', v_nro_tarjeta, 'P', v_can_aut_requeridas, v_can_aut_requeridas, userinfo.codigoPersona, v_imp_debito, 'Afinidad', v_dato2);

                pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
                RETURN v_retorno;
             ELSE
                pr_mensajeUsuario(MSG_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                RETURN v_retorno;
             END IF;
          END IF;
          -- se controla ya aquí el horario
          v_retorno_men_res := lp_ver_horario(v_horario,
                                              v_es_mov_noc,
                                              v_es_cta_noc,
                                              v_mensajeCaja.fechaUltimoCierre,
                                              v_mensajeCaja.codigoOficinaOrigen,
                                              v_fec_actual);

          IF (v_retorno_men_res.error = 'S') THEN
             v_retorno.nombreRespuesta      := v_retorno_men_res.nombreRespuesta;
             v_retorno.descripcionRespuesta := v_retorno_men_res.descripcionRespuesta;
             v_retorno.error                := v_retorno_men_res.error;
             pr_insertarBitacora(userinfo.codigopersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             RETURN v_retorno;
          END IF;
          -- genero el número de operación
          SELECT s_nro_ope_homebanking.NEXTVAL
            INTO v_nro_operacion
            FROM dual;
          --
          --- ESTO PARA CONFIRMACION  cuando es el modo 'A' ----
          -- registro del movimiento
          lp_reg_operacion(v_nro_cta_tarjeta, v_cod_moneda, v_tot_pago, v_nro_cta_debito, NULL, 'Efectivo', v_imp_efectivo, 'Cheques', v_imp_che_n_bco + v_imp_che_o_bco, 'Yaguarete-Nro.Tarj: ' || v_nro_tarjeta,null,'000',userinfo.codigoPersona, v_cod_operacion,v_nro_documento,p_codCanal,p_sesion,userinfo.codigoEmpresa);

          IF v_imp_efectivo > 0 THEN
             -- importe en efectivo
             v_cod_tra_padre   := 250;
             v_cod_transaccion := 613;
             -- obtengo el codigo y fin de retencion
             pag_cta.pr_obt_retencion(v_fec_actual, v_nro_cuenta, v_cod_mod_cta, v_cod_mad_cta, v_cod_transaccion, v_cod_moneda, v_cod_retencion, v_fec_fin_retencion);
             -- genero el movimiento respectivo
             v_msg_error     := MSG_INS_MOV_ER;
         END IF;

          IF v_imp_che_n_bco > 0 THEN
             -- importe en cheques ntro banco
             v_cod_tra_padre   := 250;
             v_cod_transaccion := 614;
             -- obtengo el codigo y fin de retencion
             pag_cta.pr_obt_retencion(v_fec_actual, v_nro_cuenta, v_cod_mod_cta, v_cod_mad_cta, v_cod_transaccion, v_cod_moneda, v_cod_retencion, v_fec_fin_retencion);
             -- genero el movimiento respectivo
             v_msg_error     := MSG_INS_MOV_ER;
          END IF;

          IF v_imp_che_o_bco > 0 THEN
             -- importe en cheques otros bancos
             v_cod_tra_padre   := 250;
             v_cod_transaccion := 615;
             v_tip_monto       := 'O';
             IF v_horario = 'D' AND v_hor_actual > v_hor_cie_cheques THEN
                -- se graba ya como cheques 48 hs de retencion
                v_cod_transaccion := 610;
                v_tip_monto       := 'T';
             END IF;
             -- obtengo el codigo y fin de retencion
             pag_cta.pr_obt_retencion(v_fec_actual, v_nro_cuenta, v_cod_mod_cta, v_cod_mad_cta, v_cod_transaccion, v_cod_moneda, v_cod_retencion, v_fec_fin_retencion);
             -- genero el movimiento respectivo
             v_msg_error     := MSG_INS_MOV_ER;
          END IF;

          IF nvl(v_imp_efectivo, 0) + nvl(v_imp_che_n_bco, 0) + nvl(v_imp_che_o_bco, 0) > 0 THEN
             -- se usa para TAS
             -- actualizo el control de caja
             UPDATE cj_controles
                SET tot_che_nue_bco = nvl(tot_che_nue_bco, 0) + nvl(v_imp_che_n_bco, 0),
                    sal_actual      = nvl(sal_actual, 0) + nvl(v_imp_efectivo, 0),
                    tot_debitos     = nvl(tot_debitos, 0) + nvl(v_imp_efectivo, 0),
                    can_debitos     = nvl(can_debitos, 0) + decode(v_imp_efectivo, 0, 0, 1),
                    tot_che_otr_bco = nvl(tot_che_otr_bco, 0) + nvl(v_imp_che_o_bco, 0),
                    sal_che_otr_bco = nvl(sal_che_otr_bco, 0) + nvl(v_imp_che_o_bco, 0),
                    estado          = 1 -- abierto
              WHERE nro_caja = to_number(userinfo.codigoCanal)
                    AND cod_moneda = v_cod_moneda
                    AND fecha = v_fec_actual;
             IF SQL%NOTFOUND THEN
                INSERT INTO cj_controles
                   (nro_caja, cod_moneda, fecha, estado, mto_apertura, ini_che_otr_bco, cod_usu_actual, tot_che_nue_bco, sal_actual, tot_debitos, can_debitos, tot_che_otr_bco, sal_che_otr_bco)
                   SELECT userinfo.codigoCanal, v_cod_moneda, v_fec_actual, 1, 0, 0, v_mensajeCaja.codigoUsuario, v_imp_che_n_bco, v_imp_efectivo, v_imp_efectivo, decode(v_imp_efectivo, 0, 0, 1), v_imp_che_o_bco, v_imp_che_o_bco
                     FROM dual;
             END IF;
          END IF;

          IF v_imp_debito > 0 THEN
             -- genero el movimiento respectivo
             v_msg_error     := MSG_INS_MOV_ER;
             BEGIN
                -- DDSI-265 -- 02/2018 : Se busca una hora disponible
                v_hor_actual := fug_obt_hor_disponible(v_fec_actual, v_hor_actual, user, v_es_mov_noc);
                -- genero el movimiento respectivo
                lp_ins_movimiento( v_retorno_men_res, -- agregado
                                   v_nro_secuencia,   -- agregado
                                   userinfo,          -- agregado
                                   v_mensajeCaja,     -- agregado
                                   v_fec_actual,      -- agregado
                                   v_hor_actual,      -- agregado
                                   v_fec_valor,       -- agregado
                                   v_cod_mod_cta,
                                   v_cod_mad_cta,
                                   v_cod_ofi_cta,
                                   v_nro_cuenta,
                                   v_cod_moneda,
                                   v_cod_tra_padre,
                                   978,
                                   v_nro_operacion,
                                   v_imp_debito,
                                  'N', -- no afecta a caja,es debito
                                  v_es_mov_noc,
                                  null,
                                  null,
                                  'Debito en Tarjeta por TAS/HB '||v_tip_monto,
                                  null,
                                  5,
                                  51);
                SELECT cod_moneda
                  INTO v_cod_mon_debito
                  FROM ge_cuentas
                 WHERE nro_cuenta = v_nro_cta_debito;
                IF v_cod_mon_debito <> v_cod_moneda THEN
                  pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  RETURN v_retorno;
                END IF;
             EXCEPTION
                WHEN NO_DATA_FOUND THEN
                   pr_mensajeUsuario(MSG_CODCTA_NOEX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   RETURN v_retorno;
                WHEN TOO_MANY_ROWS THEN
                   pr_mensajeUsuario(MSG_CODCTA_NOEX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   RETURN v_retorno;
                WHEN OTHERS THEN
                   pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||', ORA-ERR:['||substr(SQLERRM, 1, 200)||']'||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   RETURN v_retorno;
             END;

             -- seteo las variables para el debito
             pag_cta.PR_SET_VARIABLES(v_mensajeCaja.codigoUsuario, v_fec_valor, v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL, v_mensajeCaja.codigoOficinaOrigen, 5, 51);
             -- esta la cuenta en condiciones, verifico el horario

         -- elimino ver_horario y controlo mas arriba

             -- realizo el debito respectivo

             pag_cta.PR_ACT_OPERACION(v_nro_cta_debito, v_hor_actual, 'D', v_cod_mon_debito, v_imp_debito, v_cod_tra_padre, 503, v_nro_operacion, NULL, v_mensajeCaja.codigoOficinaOrigen, 5, 51, NULL, NULL, 'Pago de Tarjetas', 'N', v_nro_secuencia, v_fec_valor, NULL, NULL, NULL);
             IF nvl(pag_cta.g_cod_error, 0) <> 0 THEN
                -- hubo error en el debitoMSG_INS_MOV_ER
                pr_mensajeusuario(MSG_INS_MOV_ER, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                pr_insertarbitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'pr_act_operacion(deb) - '|| v_msj_bitacora || ', ERR:[' || substr(pag_cta.G_MSJ_ERROR, 1,200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                RETURN v_retorno;

             ELSE
                INSERT INTO ta_cobros
                   (nro_cuenta, nro_tarjeta, nro_cta_debito, fec_proceso, monto, estado, fec_valor, observacion, hora, cod_usuario, est_envio)
                VALUES
                   (v_nro_cuenta, v_nro_tarjeta, v_nro_cta_debito, v_fec_actual, v_imp_debito, 'P', v_fec_actual, 'Debito en Cuenta x Bca.Electronica', v_hor_actual, v_mensajeCaja.codigoUsuario, v_est_envio);
                -- se guarda el numero de operacion
                v_retorno.numeroOperacion:=v_nro_operacion;
             END IF;
          END IF;
       END IF;
       pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
       RETURN v_retorno;

    EXCEPTION
       WHEN OTHERS THEN
          pr_mensajeusuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarbitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||', ORA_ERR:['||substr(SQLERRM, 1, 200)||'] - '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
          RETURN v_retorno;
    END; -- fin de la 032 - pago de tarjetas de credito

   /**
   * Condiciones comerciales  por cliente y cuenta
   * @Creado por: Fermín Giménez
   * @Fecha : 17-08-2012
   */
   FUNCTION fu_obtenerCondicionComercial( p_sesion    IN VARCHAR2,
                                          p_codCanal  IN VARCHAR2,
                                          p_nroCuenta IN VARCHAR2)
                                          RETURN typ_condicionComercial IS

      v_retorno typ_condicionComercial := typ_condicionComercial;
      r_tip_listaCondiciones typ_listaCondiciones := typ_listaCondiciones();
      userinfo  typ_validarsesion;
      v_codPersona VARCHAR2(15);

      --  Tipos de Mensajes de respuestas
      MSG_VAL_PENTRADA CONSTANT VARCHAR2(15) := 'VAL_PENTRADA'; /**Parametros de entradas incorrectos*/
      MSG_OBT_CTA_ER   CONSTANT VARCHAR2(15) := 'OBT_CTA_ER';   /**Error al obtener Cuentas*/
      MSG_OBT_CC_ER    CONSTANT VARCHAR2(15) := 'OBT_CC_ER';    /**Error al obtener la condicion comercial*/

      v_msg_error VARCHAR2(15) := MSG_ERROR;

      cod_operacion VARCHAR2(3) := '301';
   BEGIN

      -- Valido la Sesión del Cliente
      userinfo := fu_validarsesion(p_sesion, p_codCanal);

      IF userinfo.error = 'S' THEN
         v_retorno.error                := userinfo.error;
         v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      v_codPersona := NVL(userinfo.codigoEmpresa, userinfo.codigoPersona);

      pr_insertarbitacora(userinfo.codigopersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoempresa, 'Inicio Consulta Cond.Comercial - Cod.Cliente|Nro.Cta: ' || v_codPersona || '|' || p_nroCuenta || '|' || ' ' || fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null ), bitacora_entrada);

      --Validacion de Parámetros de entrada
      IF (p_nroCuenta IS NULL) THEN
         v_msg_error := MSG_VAL_PENTRADA;
         pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, 'fu_obtenerCondicionComercial - no cta:' || p_nroCuenta || ' - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         v_retorno.error := 'S';
      END IF;

      IF lf_val_cta_origen(p_nroCuenta, v_codPersona) = 'N' THEN
         -- no es una cuenta del cliente
         pr_mensajeUsuario(MSG_OBT_CTA_ER, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigopersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, 'fu_obtenerCondicionComercial - no cta:' || p_nroCuenta || ' - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         v_retorno.error := 'S';
         RETURN v_retorno;
      END IF;

      v_msg_error            := MSG_OBT_CC_ER;
      r_tip_listaCondiciones := fug_obt_cam_producto(p_nroCuenta);

      v_retorno.cantidad := 0;
      IF r_tip_listaCondiciones.Count > 0 THEN
         v_retorno.detallesCondicion := r_tip_listaCondiciones;
         v_retorno.cantidad          := r_tip_listaCondiciones.Count;
      END IF;

      pr_mensajeusuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarbitacora(userinfo.codigoPersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, 'Se termina Correctamente Cond.Comercial', bitacora_salida);
      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeusuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarbitacora(userinfo.codigoPersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, 'Función Cond.Comercial - ' || SQLERRM, bitacora_error);
         RETURN v_retorno;
   END;

   /**
      * Obtener Tarjetas Adicionales
      * @Fecha : 28-09-2012
      * @param p_sesion Código de la sesión
      * @param p_codCanal Código del canal
      * @param p_nroTarjetaCredito Numero de la Tarjeta Credito
      * @return Resumen de Tarjetas Adicionales
      */
      FUNCTION fu_obtenerTarjetasAdicionales(p_sesion            IN VARCHAR2,
                                             p_codCanal          IN VARCHAR2,
                                             p_nroTarjetaCredito IN VARCHAR2)
                                             RETURN typ_resumenTarjetasAdicionales IS
         v_nro_cuenta VARCHAR2(16);
         v_nroTarjetaCredito VARCHAR2(25);
         v_can_detalles NUMBER(3) := 0;
         userinfo typ_validarsesion;
         v_cod_operacion VARCHAR2(3) := '320';
         v_listaTarjetasAdicionales typ_listaTarjetasAdicionales := typ_listaTarjetasAdicionales();
         v_retorno                  typ_resumenTarjetasAdicionales := typ_resumenTarjetasAdicionales;
         v_resumenTarjetaAdicional  typ_resumenTarjetaAdicional := typ_resumenTarjetaAdicional;

         MSG_CODCTA_NOEX    CONSTANT VARCHAR2(15) := 'CODCTA_NOEX';     /**Codigo de Cuenta inexistente*/
         MSG_CTA_NO_CORRESP CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';
--         MSG_VAL_PENTRADA   CONSTANT VARCHAR2(15) := 'VAL_PENTRADA';    /**Parametros de entrada incorrectos*/
         MSG_CODCTA_NOEX    CONSTANT VARCHAR2(15) := 'CODCTA_NOEX';     /**Codigo de Cuenta inexistente*/
         MSG_OBT_TAR_NE     CONSTANT VARCHAR2(15) := 'OBT_TCR_NE';      /**Nro. tarjeta no encontrado*/
         MSG_CTA_NO_CORRESP CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND'; /**Nro. de Cuenta no corresponde al cliente*/

         CURSOR c_tarjetasAdicionales(p_numeroCuenta IN VARCHAR2, p_numeroTarjeta IN VARCHAR2) IS
            SELECT nro_tarjeta, fec_vencimiento, nom_embozar
              FROM ta_tarjetas
             WHERE nro_cuenta = p_numeroCuenta
               AND nro_tarjeta <> p_numeroTarjeta
               AND vigente = 'S'
               AND COD_ESTADO = 6;
      BEGIN

         pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

         -- Valido la Sesión del Cliente
         userinfo := fu_validarsesion(p_sesion, p_codcanal);

         IF userinfo.error = 'S' THEN
            v_retorno.error                := userinfo.error;
            v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
            v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
            RETURN v_retorno;
         END IF;
         v_nroTarjetaCredito:=depurarAlfanumerico(p_nroTarjetaCredito, 24);

         BEGIN
            SELECT a.nro_cuenta
              INTO v_nro_cuenta
              FROM ge_cta_clientes a, ta_tarjetas b
             WHERE b.nro_tarjeta = v_nroTarjetaCredito
               AND b.nro_cuenta = a.nro_cuenta
               AND a.cod_persona = NVL(userinfo.codigoEmpresa, userinfo.codigoPersona);
         EXCEPTION
            WHEN no_data_found THEN
               pr_mensajeUsuario(MSG_OBT_TAR_NE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_nroTarjetaCredito || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
               RETURN v_retorno;
         END;

         --Saldos
         FOR tarjeta IN c_tarjetasAdicionales(v_nro_cuenta,v_nroTarjetaCredito)
         LOOP
            v_resumenTarjetaAdicional := typ_resumenTarjetaAdicional;
            v_can_detalles                             := v_can_detalles + 1;
            v_resumenTarjetaAdicional.nombreEmbozado   := tarjeta.nom_embozar;
            v_resumenTarjetaAdicional.numeroTarjeta    := tarjeta.nro_tarjeta;
            v_resumenTarjetaAdicional.fechaVencimiento := tarjeta.fec_vencimiento;
            v_listaTarjetasAdicionales.EXTEND;
            v_listaTarjetasAdicionales(v_listaTarjetasAdicionales.COUNT) := v_resumenTarjetaAdicional;
         END LOOP;

         v_retorno.cantidad:=v_can_detalles;
         v_retorno.tarjetasAdicionales:=v_listaTarjetasAdicionales;
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_nroTarjetaCredito || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
         return v_retorno;
      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_nroTarjetaCredito || ', ERR :[ ' || SQLERRM || '] ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
            return v_retorno;
      END;

   /**
   * Area del Cliente
   * @Creado por: Fermín Giménez
   * @Fecha : 13-12-2012
   */
  FUNCTION fu_obtenerAreaCliente(p_sesion            IN VARCHAR2,
                                 p_codigoCanal       IN VARCHAR2
                                 ) RETURN typ_respuestaAreaCliente IS

     CURSOR c_areaCli(p_codPersona IN VARCHAR2) IS
       SELECT nom_completo,
              bd.direccion ||
              ' Nro. ' || bd.numero ||
              '. Ciudad: ' || FUE_OBT_DES_CIUDAD(bd.cod_pais, bd.cod_ciudad) ||
              '. Barrio: ' || FUE_OBT_DES_BARRIO(bd.cod_pais, bd.cod_ciudad, bd.cod_barrio) direccion,
              bt.area || '-' || bt.telefono telefono,
              bp.dir_correo
         FROM ba_personas bp, ba_direcciones bd, ba_telefonos bt
        WHERE bd.cod_persona(+) = bp.cod_persona
          AND bd.principal(+) = 'S'
          AND bt.cod_persona(+) = bp.cod_persona
          AND bt.principal(+) = 'S'
          AND bp.cod_persona = p_codPersona;

     v_tip_mensaje VARCHAR2(3) := '302';

     v_retorno                  typ_respuestaAreaCliente := typ_respuestaAreaCliente;
     v_cod_persona              VARCHAR2(10);

     MSG_G_SIN_DATOS    CONSTANT VARCHAR2(15) := 'G_SIN_DATOS'; /**No se encontraron registros*/

     v_can_detalles              NUMBER(3) := 0;
     userinfo                    typ_validarsesion;
  BEGIN

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

     -- Valido la Sesión del Cliente
     userinfo := fu_validarsesion(p_sesion, p_codigoCanal);

     IF userinfo.error = 'S' THEN
        v_retorno.error                := userinfo.error;
        v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     v_cod_persona := NVL(userinfo.codigoPersona, userinfo.codigoEmpresa);

     --datos
     FOR reg IN c_areaCli(v_cod_persona)
     LOOP
        v_can_detalles               := v_can_detalles + 1;
        v_retorno.nombreCompleto     := reg.nom_completo;
        v_retorno.direccionPrincipal := reg.direccion;
        v_retorno.telefonoPrincipal  := reg.telefono;
        v_retorno.email              := reg.dir_correo;
     END LOOP;

     -- Valida si encontro datos
     IF v_can_detalles = 0 THEN
        pr_mensajeUsuario(MSG_G_SIN_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_obtenerAreaCliente-' || MSG_G_SIN_DATOS, BITACORA_ERROR);
        RETURN v_retorno;
     END IF;

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_obtenerAreaCliente-' ||  BITACORA_SALIDA);
     return v_retorno;
  END;


  FUNCTION fu_datosCliente(p_sesion            IN VARCHAR2,
                            p_codigoCanal       IN VARCHAR2,
                            p_direccion         IN VARCHAR2 DEFAULT NULL,--No debe ser nulo para p_tipoSolicitud = B. Debe tener mayor a 10 caracteres
                            p_codCiudad         IN VARCHAR2 DEFAULT NULL,--No debe ser nulo para p_tipoSolicitud = B.
                            p_codBarrio         IN VARCHAR2 DEFAULT NULL,--No debe ser nulo para p_tipoSolicitud = B.
                            p_codNumero         IN VARCHAR2 DEFAULT NULL,--numero de casa
                            p_codEdificio       IN VARCHAR2 DEFAULT NULL,
                            p_codPiso           IN VARCHAR2 DEFAULT NULL,
                            p_codDepartamento   IN VARCHAR2 DEFAULT NULL,
                            p_codigoArea        IN VARCHAR2 DEFAULT NULL,
                            p_telefono          IN VARCHAR2 DEFAULT NULL,
                            p_email             IN VARCHAR2 DEFAULT NULL,
                            p_modo              IN VARCHAR2, --Modos-> D: Consulta Detalles, V: Verificar, C: Confirmar
                            p_tipoSolicitud     IN VARCHAR2 DEFAULT NULL--Solo puede ser nulo en el Modo D. A : Direccion, T: Telefono, E; Email, C: Celular, EC: Email Confirmado, CC: Celular Confirmado ATM, CR: Celular Rechazado ATM
                            )
                            RETURN typ_datosCliente IS


     CURSOR c_datosCli(p_codPersona IN VARCHAR2) IS
      SELECT nom_completo,
              bd.direccion direccion,
              bd.numero numero_casa,
              trim(bt.area) || '-' || trim(bt.telefono) telefono,
              bt.tipo,
              bt.tip_linea, -- tipo de linea del telefono
              bt.principal as linea_principal, --Indica si el telefono es o no el principal
              bp.dir_correo,
              bd.cod_pais,
              FUE_OBT_ISO_PAIS(NVL(bp.COD_PAI_DOCUMENTO, bp.COD_PAIS)) as cod_pai_iso,
              bp.cod_tip_documento,
              fue_obt_des_pais(bd.cod_pais),
              bd.cod_ciudad,--codigoCiudad
              FUE_OBT_DES_CIUDAD(bd.cod_pais, bd.cod_ciudad) as des_ciudad,--descripcioCiudad
              bd.cod_barrio,--codigoBarrio
              FUE_OBT_DES_BARRIO(bd.cod_pais, bd.cod_ciudad, bd.cod_barrio) as des_barrio--descripcionBarrio
         FROM ba_personas bp, ba_direcciones bd, ba_telefonos bt
        WHERE bd.cod_persona(+) = bp.cod_persona
          AND bd.principal(+) = 'S'
          AND bt.cod_persona(+) = bp.cod_persona
          AND bp.cod_persona = p_codPersona
          ORDER by bt.fec_insercion;

    v_retorno                  typ_datosCliente := typ_datosCliente;
    v_cod_persona              VARCHAR2(10);
    v_tip_linea                VARCHAR2(1);
    v_cod_pais                 NUMBER(3);
    v_estado                   VARCHAR2(1);
    userinfo                   typ_validarsesion;
    MSG_G_SIN_DATOS            CONSTANT VARCHAR2(15)  := 'G_SIN_DATOS'; /**No se encontraron registros*/
    MSG_OP_NO_PERMITIDA        CONSTANT VARCHAR2(15)  := 'P_OP_NO_PERM';
    MSG_DAT_DUP               CONSTANT VARCHAR2(15)  := 'G_DAT_DUP'; --Datos duplicados
    MSG_VAL_PENTRADA           CONSTANT VARCHAR2(15)  := 'VAL_PENTRADA'; --Formato incorrecto
    MSG_DAT_PEN_INV            CONSTANT VARCHAR2(15)  := 'DAT_PEN_INV'; --Formato incorrecto
    MSG_DAT_PEN_DUP            CONSTANT VARCHAR2(15)  := 'DAT_PEN_DUP'; --Datos pendientes de confirmacion duplicados
    MSG_PER_NO_FISICA          CONSTANT VARCHAR2(15)  := 'PER_NOFISICA';
    v_can_detalles             NUMBER(3) := 0;
    v_count_otp                NUMBER(3) :=0;
    v_can_dir                  NUMBER(3) :=0;
    v_can_tel                  NUMBER(3) :=0;
    v_can_mail                 NUMBER(3) :=0;
    v_seq_val                  NUMBER := 0;
    EX_PARAM_VACIOS            EXCEPTION;
    EX_PARAM_INCORRECTOS       EXCEPTION;
    v_fec_confirmacion         DATE:= NULL;
    v_fec_caducidad            DATE:= NULL;
    v_tip_mensaje              VARCHAR2(3) := 232;
    v_old_mail                 ba_mails.dir_correo%TYPE;
    v_return                   VARCHAR(10);
    v_men_old_mail             VARCHAR2(2000);
    BEGIN


     -- Se valida la sesion del cliente, siempre que el tipo de solicitud no sea EC (Email Confirmado), o CC (Celular Confirmado)
     IF p_tipoSolicitud is null or p_tipoSolicitud not in ('EC', 'CC','CR') THEN-- Al realizar esta confirmación el cliente no está logueado
       userinfo := fu_validarsesion(p_sesion, p_codigoCanal);
       IF userinfo.error = 'S' THEN
          v_retorno.error                := userinfo.error;
          v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
          v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
          RETURN v_retorno;
       END IF;
       if fug_obt_pardinamico('REG_BITACORA_BW') = 'S' then
       pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion,v_tip_mensaje, NULL, 'fu_datosCliente - p_codigoCanal: '
       || p_codigoCanal||' - p_direccion: '||p_direccion||' - p_codCiudad: '||p_codCiudad||' - p_codBarrio: '||p_codBarrio
       ||' -  p_codNumero: '|| p_codNumero ||' - p_codigoArea: '||p_codigoArea||' - p_telefono: '||p_telefono||' - p_email: '||p_email||' - p_modo: '
       ||p_modo||' - p_tipoSolicitud: '||p_tipoSolicitud, BITACORA_ENTRADA);
       end if;
       IF paw_bce.fu_caj_homebanking(p_codigoCanal) = 'N' THEN --Si no es persona fisica o el canal no corresponde a un canal web
            pr_mensajeUsuario(MSG_OP_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Canal no valido-'||MSG_OP_NO_PERMITIDA, BITACORA_ERROR);
            return v_retorno;
       END IF;
     END IF;

    --Se recupera el codigo de persona
     v_cod_persona := NVL(userinfo.codigoPersona, userinfo.codigoEmpresa);

     --Se verifica si el cliente es o no de nómina.
     v_retorno.esClienteNomina := fug_es_cli_nomina(v_cod_persona);

     --Se verifica si el cliente posee o no clave dinámica configurada
     select count(*) into v_count_otp from bw_otp_seriales m where m.cod_persona = v_cod_persona
            and m.cod_per_vinculada is null and m.estado = 'A';

     IF v_count_otp > 0 THEN
        v_retorno.poseeClaveDinamica := 'S';
     ELSE
        v_retorno.poseeClaveDinamica := 'N';
     END IF;

   BEGIN --Proyecto Analitica
       select pf.fec_nacimiento, pf.cod_sexo, pa.descripcion
              into v_retorno.fechaNacimiento, v_retorno.genero, v_retorno.descripcionPaisNacionalidad
                   from ba_per_fisicas pf
                        inner join ba_paises pa on (pf.cod_pai_nacionalidad = pa.cod_pais)
                              where cod_persona = v_cod_persona;

     EXCEPTION
       when others then null;
     END;

     --INICIO DE VALIDACIONES
     IF p_modo = 'V' or p_modo = 'C' THEN

        select sysdate into v_fec_confirmacion from dual;

         IF p_tipoSolicitud is null or p_tipoSolicitud not in ('A','T','C','E', 'CC','EC','CR') THEN
                 pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Tipo de Solicitud incorrecta p_TipoSolicitud: '||p_tipoSolicitud||MSG_VAL_PENTRADA, BITACORA_ERROR);
                 return v_retorno;
         END IF;
         IF pag_gen.FU_ES_PER_FISICA(v_cod_persona)= 'N'THEN --Si no es persona fisica o el canal no corresponde a un canal web
            pr_mensajeUsuario(MSG_PER_NO_FISICA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Tipo de Persona  no valido-'||MSG_OP_NO_PERMITIDA, BITACORA_ERROR);
            return v_retorno;
         END IF;

         IF p_tipoSolicitud = 'A' THEN--A=Direccion
            v_estado := 'C';
            IF trim(p_direccion) is null AND trim(p_codNumero) is null THEN
                raise EX_PARAM_VACIOS;
            ELSIF length(p_direccion) < 10 THEN
                raise EX_PARAM_INCORRECTOS;
             END IF;
            --Validacion de datos ya existentes. EN caso que la dirección ya esté catastrada, se retorna un error
            select count(*) into v_can_dir from ba_direcciones d where d.cod_persona = v_cod_persona
                   and upper(trim(d.direccion)) = upper(trim(p_direccion))
                            and (d.cod_ciudad = p_codCiudad or p_codCiudad is null)
                            and (d.cod_barrio = p_codBarrio or p_codBarrio is null) and d.principal = 'S';

            IF v_can_dir > 0 THEN
               pr_mensajeUsuario(MSG_DAT_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Datos duplicados. Los datos enviados ya se encuentran almacenados.  -'||MSG_DAT_DUP, BITACORA_ERROR);
               return v_retorno;
            END IF;

            -- Se recupera información de descripción del pais, ciudad, departamento y barrio en caso que haya odificado esos datos.
            select cod_pais, descripcion into v_cod_pais, v_retorno.descripcionPais from ba_paises where cod_pai_iso = 'PY';
            begin
              if p_codCiudad is not null then
                 select cod_ciudad, descripcion, c.cod_departamento into  v_retorno.codigoCiudad, v_retorno.descripcionCiudad, v_retorno.codigoDepartamento
                                      from ba_ciudades c where c.cod_ciudad = p_codCiudad and c.cod_pais = v_cod_pais;

                 if p_codBarrio is not null then
                    select cod_barrio, descripcion into v_retorno.codigoBarrio, v_retorno.descripcionBarrio
                                        from ba_barrios b where b.cod_pais = v_cod_pais and
                                              b.cod_ciudad = p_codCiudad and b.cod_barrio = p_codBarrio;
                 end if;
              end if;
            exception
                  when others then
                   pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'No se pudo recuperar la descripcion de ciudad/barrio. - p_codCiudad: '
                          ||p_codCiudad||' - v_cod_pais: '||v_cod_pais||' - p_codBarrio: '||p_codBarrio||SQLERRM, BITACORA_ERROR);
            end;
            begin
              if v_retorno.codigoDepartamento is not null then

                 select  d.descripcion into v_retorno.descripcionDepartamento
                                      from ba_departamentos d where d.cod_departamento = v_retorno.codigoDepartamento;
              end if;
            exception
                  when others then
                   pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'No se pudo recuperar la descripcion del departamento. -'||SQLERRM, BITACORA_ERROR);
            end;

        ELSIF p_tipoSolicitud = 'T' THEN--T=Teléfono Fijo
              v_estado := 'C';
              v_tip_linea := 'B';
              IF trim(p_telefono) is null AND trim(p_codigoArea) is null THEN
                 raise EX_PARAM_VACIOS;
              ELSIF paw_uti.fu_val_telefono(p_telefono)='N'THEN
                raise EX_PARAM_INCORRECTOS;
              END IF;

              select count(*) into v_can_tel from ba_telefonos t where t.cod_persona = v_cod_persona
                 and trim(t.telefono) = trim(p_telefono) and trim(t.area)=trim(p_codigoArea);

               IF v_can_tel > 0 THEN
                     pr_mensajeUsuario(MSG_DAT_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Datos duplicados  -'||MSG_DAT_DUP, BITACORA_ERROR);
                     return v_retorno;
               END IF;
         ELSIF p_tipoSolicitud = 'E' THEN--E=Email
              v_estado := 'P';
              v_fec_confirmacion := null;

              --Fecha de caducidad del registro, según lo parametrizado
              select (sysdate + fug_obt_pardinamico('VTO_SOL_ACT_MAIL')) into v_fec_caducidad
                               from dual;

              IF trim(p_email) is null THEN
                 raise EX_PARAM_VACIOS;
              ELSIF paw_uti.fu_validarMail(p_email)= 'N'THEN
                 pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Correo electrónico no valido. -'||p_modo||'-p_tipoSolicitud'||p_tipoSolicitud||'- p_email: '||p_email, BITACORA_ERROR);
                 return v_retorno;
              END IF;

                select count(*) into v_can_mail from ba_mails m where m.cod_persona = v_cod_persona
                        and upper(trim(m.dir_correo)) = upper(trim(p_email));

                IF v_can_mail > 0 THEN
                     pr_mensajeUsuario(MSG_DAT_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Datos duplicados  -'||MSG_DAT_DUP, BITACORA_ERROR);
                     return v_retorno;
                END IF;
         ELSIF p_tipoSolicitud = 'C' THEN--C=Celular
              v_tip_linea := 'C';
              v_estado := 'P';
              v_fec_confirmacion := null;

              --Fecha de caducidad del registro, según lo parametrizado
              select (sysdate + fug_obt_pardinamico('VTO_SOL_ACT_CELULAR')) into v_fec_caducidad
                               from dual;

              IF trim(p_telefono) is null AND trim(p_codigoArea) is null THEN
                 raise EX_PARAM_VACIOS;
              ELSIF  paw_uti.fu_val_celular(p_codigoArea||p_telefono)='N'THEN
                raise EX_PARAM_INCORRECTOS;
              END IF;

         END IF;
     ELSIF p_modo is null THEN
           RAISE EX_PARAM_VACIOS;
     END IF; --FIN DE VALIDACIONES


    IF p_modo = 'C' THEN --Confirmacion de la modificacion
          IF p_tipoSolicitud in ('A', 'T', 'C', 'E') THEN

             -- Se pasa a estado Anulado cualquier registro anterior de la persona y del mismo tipo de solicitud que se encuentre en estado Pendiente
             update ba_act_dat_clientes set estado = 'A' where cod_persona = v_cod_persona and estado = 'P' and tip_solicitud = p_tipoSolicitud;
           --Se insertan los datos en la tabla de actualización, el estado depende del dato modificado
             SELECT s_ba_act_datos.NEXTVAL  INTO v_seq_val FROM dual;
             insert into ba_act_dat_clientes (id, cod_persona, direccion, cod_ciudad, cod_barrio,
                                                numero, edificio, departamento,
                                                piso, tel_numero, tel_area, tel_tip_linea, email, estado,fec_caducidad, fec_solicitud, fec_confirmacion, tip_solicitud, migrado)
                                              values(v_seq_val, v_cod_persona, p_direccion, p_codCiudad, p_codBarrio,
                                                                p_codNumero, p_codEdificio, p_codDepartamento, p_codPiso, p_telefono,
                                                                         p_codigoArea, v_tip_linea, p_email, v_estado,v_fec_caducidad, sysdate, v_fec_confirmacion, p_tipoSolicitud, 'N');


          END IF;

          IF p_tipoSolicitud ='A' THEN -- Direccion y Telefono fijo

             BEGIN
                  --Si llego a este punto es porque los datos no son nulos.Se insertan solo si los datos no son duplicados.
                  IF v_can_dir <= 0 THEN
                     update ba_direcciones d set principal = 'N' where d.cod_persona = v_cod_persona and d.principal = 'S';
                     insert into ba_direcciones (cod_persona, cod_direccion, tipo, principal, direccion,cod_pais, cod_ciudad, cod_barrio,
                            numero, departamento, piso, edificio)
                                    values (v_cod_persona,
                                           (select max(cod_direccion)+1 from ba_direcciones where cod_persona = v_cod_persona),
                                           'H', 'S', p_direccion, v_cod_pais, p_codCiudad, p_codBarrio,
                                          p_codNumero, p_codDepartamento, p_codPiso,p_codEdificio);

                   END IF;
                   update ba_act_dat_clientes set migrado ='S', fec_confirmacion = sysdate where id = v_seq_val;
                EXCEPTION
                WHEN DUP_VAL_ON_INDEX THEN
                     update ba_act_dat_clientes set migrado ='E', fec_confirmacion = sysdate where id = v_seq_val;
                     pr_mensajeUsuario(MSG_DAT_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL,SQLERRM||'-'||MSG_DAT_DUP, BITACORA_ERROR);
                     return v_retorno;
                WHEN OTHERS THEN
                     update ba_act_dat_clientes set migrado ='E', fec_confirmacion = sysdate where id = v_seq_val;
                     RAISE;
                END;

          ELSIF p_tipoSolicitud = 'T' THEN

                BEGIN
                   IF v_can_tel <= 0 THEN--Indica que el telefono no existe en la BD aun
                      insert into ba_telefonos (cod_persona, tipo, tip_linea, telefono, principal, area, cod_telefono)
                             values(v_cod_persona, 'H','B', p_telefono, 'N', p_codigoArea,
                                   (select max(cod_telefono)+1 from ba_telefonos where cod_persona = v_cod_persona)
                                   );
                   END IF;
                   update ba_act_dat_clientes set migrado ='S', fec_confirmacion = sysdate where id = v_seq_val;
                EXCEPTION
                WHEN DUP_VAL_ON_INDEX THEN
                     update ba_act_dat_clientes set migrado ='E', fec_confirmacion = sysdate where id = v_seq_val;
                     pr_mensajeUsuario(MSG_DAT_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL,SQLERRM||'-'||MSG_DAT_DUP, BITACORA_ERROR);
                     return v_retorno;
                WHEN OTHERS THEN
                     update ba_act_dat_clientes set migrado ='E', fec_confirmacion = sysdate where id = v_seq_val;
                     RAISE;
                END;
          ELSIF p_tipoSolicitud = 'EC' THEN

                begin
                  --Se recupera el código de persona del mail que se acaba de confirmar
                  select cod_persona, id into v_cod_persona, v_seq_val from ba_act_dat_clientes
                         where upper(trim(email)) = upper(trim(p_email))
                               and estado = 'P' and trunc(fec_caducidad)>=trunc(sysdate)
                                    and tip_solicitud = 'E' and migrado = 'N';

                  -- Almacenamos el email anterior a fin de enviar el mensaje de aviso luego del cambio a esa
                  -- dirección
                  v_old_mail := fug_obt_dir_mail_per(v_cod_persona);

                  update ba_act_dat_clientes set estado = 'C', fec_confirmacion = sysdate where id = v_seq_val; --DDSI-390

                  v_men_old_mail := fug_obt_pardinamico('ACT_DAT_AVI_CAM_EMAIL');

                  v_return := paw_not.fu_env_email_prueba(v_old_mail,
                                              utl_url.escape(v_men_old_mail,
                                              TRUE,
                                              'UTF-8'),
                                              'PAW_BEL');

                  if v_return = 0 then
                     pr_insertarBitacora(v_cod_persona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - ret: '||v_return||'; EMAIL de notificacion de cambio correctamente enviado a: '||v_old_mail,BITACORA_SALIDA);
                  else
                     pr_insertarBitacora(v_cod_persona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - ret: '||v_return||'; EMAIL de notificacion de cambio NO enviado a: '||v_old_mail,BITACORA_ERROR);
                  end if;


                exception
                   when no_data_found then
                  update ba_act_dat_clientes set estado = 'C', migrado = 'E', fec_confirmacion = sysdate where id = v_seq_val;
                     pr_mensajeUsuario(MSG_DAT_PEN_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(v_cod_persona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - Error al intentar migrar datos de correo.'||SQLERRM||'-' || MSG_ERROR,BITACORA_ERROR);
                     return v_retorno;
                    when too_many_rows then
                     update ba_act_dat_clientes set estado = 'C', migrado = 'E', fec_confirmacion = sysdate where id = v_seq_val;
                     pr_mensajeUsuario(MSG_DAT_PEN_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(v_cod_persona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - Error al intentar migrar datos de correo.'||SQLERRM||'-' || MSG_ERROR,BITACORA_ERROR);
                     return v_retorno;
                    when others then
                       update ba_act_dat_clientes set estado = 'C', migrado = 'E', fec_confirmacion = sysdate where id = v_seq_val;
                       pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(v_cod_persona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - Error al intentar migrar datos de correo.'||SQLERRM||'-' || MSG_ERROR,BITACORA_ERROR);
                       return v_retorno;
                end;

          ELSIF p_tipoSolicitud = 'CC' THEN

                  --Se recupera el código de persona del número de celular que se acaba de confirmar
                  select cod_persona, id into v_cod_persona, v_seq_val from ba_act_dat_clientes
                         where trim(tel_area) = trim(p_codigoArea)  and trim(tel_numero) = trim(p_telefono)
                               and estado = 'P' and trunc(fec_caducidad)>=trunc(sysdate)
                                    and tip_solicitud = 'C' and migrado = 'N';

                update ba_act_dat_clientes set estado = 'C', fec_confirmacion = sysdate
                       where cod_persona = v_cod_persona and tip_solicitud = 'C' and estado = 'P';

          END IF;
    ELSIF p_modo = 'D' THEN --Consulta de Detalles. Retorna información del detalle de un cliente.

       FOR reg IN c_datosCli(v_cod_persona)
       LOOP
          v_can_detalles               := v_can_detalles + 1;
          v_retorno.nombreCompleto     := reg.nom_completo;
          v_retorno.direccion          := reg.direccion;
          v_retorno.email              := reg.dir_correo;
          v_retorno.codigoCiudad       := reg.cod_ciudad;
          v_retorno.descripcionCiudad  := reg.des_ciudad;
          v_retorno.codigoBarrio       := reg.cod_barrio;
          v_retorno.descripcionBarrio  := reg.des_barrio;
          v_retorno.numeroCasa         := reg.numero_casa;
          v_retorno.tipoDocumento      := reg.cod_tip_documento;
          v_retorno.codigoPaisIso        := reg.cod_pai_iso;

          --Los telefonos se reemplazan hasta encontrar el telefono principal, o el último registro modificado por el HB (tipo = H)
          IF reg.tip_linea = 'B' AND (v_retorno.tipoLineaPrincipal is null OR v_retorno.tipoLineaPrincipal != 'B' OR reg.tipo = 'H') THEN
             v_retorno.telefonoFijo  := reg.telefono;
          ELSIF reg.tip_linea = 'C' AND (v_retorno.tipoLineaPrincipal is null OR v_retorno.tipoLineaPrincipal != 'C'  OR reg.tipo = 'H') THEN
             v_retorno.celular := reg.telefono;
          END IF;

          IF reg.linea_principal = 'S' THEN
               v_retorno.tipoLineaPrincipal := reg.tip_linea;
          END IF;
       END LOOP;

       -- Valida si encontro datos
       IF v_can_detalles = 0 THEN
          pr_mensajeUsuario(MSG_G_SIN_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente-' || MSG_G_SIN_DATOS, BITACORA_ERROR);
          RETURN v_retorno;
        END IF;
      END IF; --TIPO SOLICITUD = D

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - '||MSG_OK,  BITACORA_SALIDA);
     RETURN v_retorno;
    EXCEPTION
        WHEN EX_PARAM_VACIOS THEN
             pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Parámetros obligatorios vacios. p_modo:'
                                                                          ||p_modo||'-p_tipoSolicitud'||p_tipoSolicitud||'-p_direccion: '||p_direccion||
                                                                          '-Numero: '||p_codNumero||'-p_codigoArea: '|| p_codigoArea||'- p_telefono: '|| p_telefono, BITACORA_ERROR);
             return v_retorno;
        WHEN EX_PARAM_INCORRECTOS THEN
           pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Datos a actualizar no validos-'||p_modo||'-p_tipoSolicitud'||p_tipoSolicitud||'-p_direccion: '||p_direccion||
                                                                          '- Numero: '||p_codNumero||'- p_codigoArea: '|| p_codigoArea||' - p_telefono: '|| p_telefono, BITACORA_ERROR);
                  return v_retorno;
        WHEN OTHERS THEN
             pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente-'||SQLERRM||'-' || MSG_ERROR,BITACORA_ERROR);
             return v_retorno;
    END;


FUNCTION fu_datoCliente(p_codPersona            IN VARCHAR2,
                        p_codEmpresa            IN VARCHAR2,
                            p_codigoCanal       IN VARCHAR2,
                            p_direccion         IN VARCHAR2 DEFAULT NULL,--No debe ser nulo para p_tipoSolicitud = B. Debe tener mayor a 10 caracteres
                            p_codCiudad         IN VARCHAR2 DEFAULT NULL,--No debe ser nulo para p_tipoSolicitud = B.
                            p_codBarrio         IN VARCHAR2 DEFAULT NULL,--No debe ser nulo para p_tipoSolicitud = B.
                            p_codNumero         IN VARCHAR2 DEFAULT NULL,--numero de casa
                            p_codEdificio       IN VARCHAR2 DEFAULT NULL,
                            p_codPiso           IN VARCHAR2 DEFAULT NULL,
                            p_codDepartamento   IN VARCHAR2 DEFAULT NULL,
                            p_codigoArea        IN VARCHAR2 DEFAULT NULL,
                            p_telefono          IN VARCHAR2 DEFAULT NULL,
                            p_email             IN VARCHAR2 DEFAULT NULL,
                            p_modo              IN VARCHAR2, --Modos-> D: Consulta Detalles, V: Verificar, C: Confirmar
                            p_tipoSolicitud     IN VARCHAR2 DEFAULT NULL--Solo puede ser nulo en el Modo D. A : Direccion, T: Telefono, E; Email, C: Celular, EC: Email Confirmado, CC: Celular Confirmado ATM, CR: Celular Rechazado ATM
                            )
                            RETURN typ_datosCliente IS


     CURSOR c_datosCli(p_codPersona IN VARCHAR2) IS
      SELECT nom_completo,
              bd.direccion direccion,
              bd.numero numero_casa,
              trim(bt.area) || '-' || trim(bt.telefono) telefono,
              bt.tipo,
              bt.tip_linea, -- tipo de linea del telefono
              bt.principal as linea_principal, --Indica si el telefono es o no el principal
              bp.dir_correo,
              bd.cod_pais,
              FUE_OBT_ISO_PAIS(NVL(bp.COD_PAI_DOCUMENTO, bp.COD_PAIS)) as cod_pai_iso,
              bp.cod_tip_documento,
              fue_obt_des_pais(bd.cod_pais),
              bd.cod_ciudad,--codigoCiudad
              FUE_OBT_DES_CIUDAD(bd.cod_pais, bd.cod_ciudad) as des_ciudad,--descripcioCiudad
              bd.cod_barrio,--codigoBarrio
              FUE_OBT_DES_BARRIO(bd.cod_pais, bd.cod_ciudad, bd.cod_barrio) as des_barrio--descripcionBarrio
         FROM ba_personas bp, ba_direcciones bd, ba_telefonos bt
        WHERE bd.cod_persona(+) = bp.cod_persona
          AND bd.principal(+) = 'S'
          AND bt.cod_persona(+) = bp.cod_persona
          AND bp.cod_persona = p_codPersona
          ORDER by bt.fec_insercion;

    v_retorno                  typ_datosCliente := typ_datosCliente;
    p_sesion                  VARCHAR2(10) := NULL;
    v_cod_persona              VARCHAR2(10);
    v_tip_linea                VARCHAR2(1);
    v_cod_pais                 NUMBER(3);
    v_estado                   VARCHAR2(1);
    userinfo                   typ_validarsesion;
    MSG_G_SIN_DATOS            CONSTANT VARCHAR2(15)  := 'G_SIN_DATOS'; /**No se encontraron registros*/
    MSG_OP_NO_PERMITIDA        CONSTANT VARCHAR2(15)  := 'P_OP_NO_PERM';
    MSG_DAT_DUP               CONSTANT VARCHAR2(15)  := 'G_DAT_DUP'; --Datos duplicados
    MSG_VAL_PENTRADA           CONSTANT VARCHAR2(15)  := 'VAL_PENTRADA'; --Formato incorrecto
    MSG_DAT_PEN_INV            CONSTANT VARCHAR2(15)  := 'DAT_PEN_INV'; --Formato incorrecto
    MSG_DAT_PEN_DUP            CONSTANT VARCHAR2(15)  := 'DAT_PEN_DUP'; --Datos pendientes de confirmacion duplicados
    MSG_PER_NO_FISICA          CONSTANT VARCHAR2(15)  := 'PER_NOFISICA';
    v_can_detalles             NUMBER(3) := 0;
    v_count_otp                NUMBER(3) :=0;
    v_can_dir                  NUMBER(3) :=0;
    v_can_tel                  NUMBER(3) :=0;
    v_can_mail                 NUMBER(3) :=0;
    v_seq_val                  NUMBER := 0;
    EX_PARAM_VACIOS            EXCEPTION;
    EX_PARAM_INCORRECTOS       EXCEPTION;
    v_fec_confirmacion         DATE:= NULL;
    v_fec_caducidad            DATE:= NULL;
    v_tip_mensaje              VARCHAR2(3) := 232;
    v_old_mail                 ba_mails.dir_correo%TYPE;
    v_return                   VARCHAR(10);
    v_men_old_mail             VARCHAR2(2000);
    BEGIN


     -- Se valida la sesion del cliente, siempre que el tipo de solicitud no sea EC (Email Confirmado), o CC (Celular Confirmado)
     IF p_tipoSolicitud is null or p_tipoSolicitud not in ('EC', 'CC','CR') THEN-- Al realizar esta confirmación el cliente no está logueado
       userinfo.codigoPersona := p_codPersona;
       if fug_obt_pardinamico('REG_BITACORA_BW') = 'S' then
       pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion,v_tip_mensaje, NULL, 'fu_datosCliente - p_codigoCanal: '
       || p_codigoCanal||' - p_direccion: '||p_direccion||' - p_codCiudad: '||p_codCiudad||' - p_codBarrio: '||p_codBarrio
       ||' -  p_codNumero: '|| p_codNumero ||' - p_codigoArea: '||p_codigoArea||' - p_telefono: '||p_telefono||' - p_email: '||p_email||' - p_modo: '
       ||p_modo||' - p_tipoSolicitud: '||p_tipoSolicitud, BITACORA_ENTRADA);
       end if;
       IF paw_bce.fu_caj_homebanking(p_codigoCanal) = 'N' THEN --Si no es persona fisica o el canal no corresponde a un canal web
            pr_mensajeUsuario(MSG_OP_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Canal no valido-'||MSG_OP_NO_PERMITIDA, BITACORA_ERROR);
            return v_retorno;
       END IF;
     END IF;

    --Se recupera el codigo de persona
     v_cod_persona := NVL(userinfo.codigoPersona, p_codEmpresa);

     --Se verifica si el cliente es o no de nómina.
     v_retorno.esClienteNomina := fug_es_cli_nomina(v_cod_persona);

     --Se verifica si el cliente posee o no clave dinámica configurada
     select count(*) into v_count_otp from bw_otp_seriales m where m.cod_persona = v_cod_persona
            and m.cod_per_vinculada is null and m.estado = 'A';

     IF v_count_otp > 0 THEN
        v_retorno.poseeClaveDinamica := 'S';
     ELSE
        v_retorno.poseeClaveDinamica := 'N';
     END IF;

   BEGIN --Proyecto Analitica
       select pf.fec_nacimiento, pf.cod_sexo, pa.descripcion
              into v_retorno.fechaNacimiento, v_retorno.genero, v_retorno.descripcionPaisNacionalidad
                   from ba_per_fisicas pf
                        inner join ba_paises pa on (pf.cod_pai_nacionalidad = pa.cod_pais)
                              where cod_persona = v_cod_persona;

     EXCEPTION
       when others then null;
     END;

     --INICIO DE VALIDACIONES
     IF p_modo = 'V' or p_modo = 'C' THEN

        select sysdate into v_fec_confirmacion from dual;

         IF p_tipoSolicitud is null or p_tipoSolicitud not in ('A','T','C','E', 'CC','EC','CR') THEN
                 pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Tipo de Solicitud incorrecta p_TipoSolicitud: '||p_tipoSolicitud||MSG_VAL_PENTRADA, BITACORA_ERROR);
                 return v_retorno;
         END IF;
         IF pag_gen.FU_ES_PER_FISICA(v_cod_persona)= 'N'THEN --Si no es persona fisica o el canal no corresponde a un canal web
            pr_mensajeUsuario(MSG_PER_NO_FISICA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Tipo de Persona  no valido-'||MSG_OP_NO_PERMITIDA, BITACORA_ERROR);
            return v_retorno;
         END IF;

         IF p_tipoSolicitud = 'A' THEN--A=Direccion
            v_estado := 'C';
            IF trim(p_direccion) is null AND trim(p_codNumero) is null THEN
                raise EX_PARAM_VACIOS;
            ELSIF length(p_direccion) < 10 THEN
                raise EX_PARAM_INCORRECTOS;
             END IF;
            --Validacion de datos ya existentes. EN caso que la dirección ya esté catastrada, se retorna un error
            select count(*) into v_can_dir from ba_direcciones d where d.cod_persona = v_cod_persona
                   and upper(trim(d.direccion)) = upper(trim(p_direccion))
                            and (d.cod_ciudad = p_codCiudad or p_codCiudad is null)
                            and (d.cod_barrio = p_codBarrio or p_codBarrio is null) and d.principal = 'S';

            IF v_can_dir > 0 THEN
               pr_mensajeUsuario(MSG_DAT_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Datos duplicados. Los datos enviados ya se encuentran almacenados.  -'||MSG_DAT_DUP, BITACORA_ERROR);
               return v_retorno;
            END IF;

            -- Se recupera información de descripción del pais, ciudad, departamento y barrio en caso que haya odificado esos datos.
            select cod_pais, descripcion into v_cod_pais, v_retorno.descripcionPais from ba_paises where cod_pai_iso = 'PY';
            begin
              if p_codCiudad is not null then
                 select cod_ciudad, descripcion, c.cod_departamento into  v_retorno.codigoCiudad, v_retorno.descripcionCiudad, v_retorno.codigoDepartamento
                                      from ba_ciudades c where c.cod_ciudad = p_codCiudad and c.cod_pais = v_cod_pais;

                 if p_codBarrio is not null then
                    select cod_barrio, descripcion into v_retorno.codigoBarrio, v_retorno.descripcionBarrio
                                        from ba_barrios b where b.cod_pais = v_cod_pais and
                                              b.cod_ciudad = p_codCiudad and b.cod_barrio = p_codBarrio;
                 end if;
              end if;
            exception
                  when others then
                   pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'No se pudo recuperar la descripcion de ciudad/barrio. - p_codCiudad: '
                          ||p_codCiudad||' - v_cod_pais: '||v_cod_pais||' - p_codBarrio: '||p_codBarrio||SQLERRM, BITACORA_ERROR);
            end;
            begin
              if v_retorno.codigoDepartamento is not null then

                 select  d.descripcion into v_retorno.descripcionDepartamento
                                      from ba_departamentos d where d.cod_departamento = v_retorno.codigoDepartamento;
              end if;
            exception
                  when others then
                   pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'No se pudo recuperar la descripcion del departamento. -'||SQLERRM, BITACORA_ERROR);
            end;

        ELSIF p_tipoSolicitud = 'T' THEN--T=Teléfono Fijo
              v_estado := 'C';
              v_tip_linea := 'B';
              IF trim(p_telefono) is null AND trim(p_codigoArea) is null THEN
                 raise EX_PARAM_VACIOS;
              ELSIF paw_uti.fu_val_telefono(p_telefono)='N'THEN
                raise EX_PARAM_INCORRECTOS;
              END IF;

              select count(*) into v_can_tel from ba_telefonos t where t.cod_persona = v_cod_persona
                 and trim(t.telefono) = trim(p_telefono) and trim(t.area)=trim(p_codigoArea);

               IF v_can_tel > 0 THEN
                     pr_mensajeUsuario(MSG_DAT_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Datos duplicados  -'||MSG_DAT_DUP, BITACORA_ERROR);
                     return v_retorno;
               END IF;
         ELSIF p_tipoSolicitud = 'E' THEN--E=Email
              v_estado := 'P';
              v_fec_confirmacion := null;

              --Fecha de caducidad del registro, según lo parametrizado
              select (sysdate + fug_obt_pardinamico('VTO_SOL_ACT_MAIL')) into v_fec_caducidad
                               from dual;

              IF trim(p_email) is null THEN
                 raise EX_PARAM_VACIOS;
              ELSIF paw_uti.fu_validarMail(p_email)= 'N'THEN
                 pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Correo electrónico no valido. -'||p_modo||'-p_tipoSolicitud'||p_tipoSolicitud||'- p_email: '||p_email, BITACORA_ERROR);
                 return v_retorno;
              END IF;

                select count(*) into v_can_mail from ba_mails m where m.cod_persona = v_cod_persona
                        and upper(trim(m.dir_correo)) = upper(trim(p_email));

                IF v_can_mail > 0 THEN
                     pr_mensajeUsuario(MSG_DAT_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Datos duplicados  -'||MSG_DAT_DUP, BITACORA_ERROR);
                     return v_retorno;
                END IF;
         ELSIF p_tipoSolicitud = 'C' THEN--C=Celular
              v_tip_linea := 'C';
              v_estado := 'P';
              v_fec_confirmacion := null;

              --Fecha de caducidad del registro, según lo parametrizado
              select (sysdate + fug_obt_pardinamico('VTO_SOL_ACT_CELULAR')) into v_fec_caducidad
                               from dual;

              IF trim(p_telefono) is null AND trim(p_codigoArea) is null THEN
                 raise EX_PARAM_VACIOS;
              ELSIF  paw_uti.fu_val_celular(p_codigoArea||p_telefono)='N'THEN
                raise EX_PARAM_INCORRECTOS;
              END IF;

         END IF;
     ELSIF p_modo is null THEN
           RAISE EX_PARAM_VACIOS;
     END IF; --FIN DE VALIDACIONES


    IF p_modo = 'C' THEN --Confirmacion de la modificacion
          IF p_tipoSolicitud in ('A', 'T', 'C', 'E') THEN

             -- Se pasa a estado Anulado cualquier registro anterior de la persona y del mismo tipo de solicitud que se encuentre en estado Pendiente
             update ba_act_dat_clientes set estado = 'A' where cod_persona = v_cod_persona and estado = 'P' and tip_solicitud = p_tipoSolicitud;
           --Se insertan los datos en la tabla de actualización, el estado depende del dato modificado
             SELECT s_ba_act_datos.NEXTVAL  INTO v_seq_val FROM dual;
             insert into ba_act_dat_clientes (id, cod_persona, direccion, cod_ciudad, cod_barrio,
                                                numero, edificio, departamento,
                                                piso, tel_numero, tel_area, tel_tip_linea, email, estado,fec_caducidad, fec_solicitud, fec_confirmacion, tip_solicitud, migrado)
                                              values(v_seq_val, v_cod_persona, p_direccion, p_codCiudad, p_codBarrio,
                                                                p_codNumero, p_codEdificio, p_codDepartamento, p_codPiso, p_telefono,
                                                                         p_codigoArea, v_tip_linea, p_email, v_estado,v_fec_caducidad, sysdate, v_fec_confirmacion, p_tipoSolicitud, 'N');


          END IF;

          IF p_tipoSolicitud ='A' THEN -- Direccion y Telefono fijo

             BEGIN
                  --Si llego a este punto es porque los datos no son nulos.Se insertan solo si los datos no son duplicados.
                  IF v_can_dir <= 0 THEN
                     update ba_direcciones d set principal = 'N' where d.cod_persona = v_cod_persona and d.principal = 'S';
                     insert into ba_direcciones (cod_persona, cod_direccion, tipo, principal, direccion,cod_pais, cod_ciudad, cod_barrio,
                            numero, departamento, piso, edificio)
                                    values (v_cod_persona,
                                           (select max(cod_direccion)+1 from ba_direcciones where cod_persona = v_cod_persona),
                                           'H', 'S', p_direccion, v_cod_pais, p_codCiudad, p_codBarrio,
                                          p_codNumero, p_codDepartamento, p_codPiso,p_codEdificio);

                   END IF;
                   update ba_act_dat_clientes set migrado ='S', fec_confirmacion = sysdate where id = v_seq_val;
                EXCEPTION
                WHEN DUP_VAL_ON_INDEX THEN
                     update ba_act_dat_clientes set migrado ='E', fec_confirmacion = sysdate where id = v_seq_val;
                     pr_mensajeUsuario(MSG_DAT_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL,SQLERRM||'-'||MSG_DAT_DUP, BITACORA_ERROR);
                     return v_retorno;
                WHEN OTHERS THEN
                     update ba_act_dat_clientes set migrado ='E', fec_confirmacion = sysdate where id = v_seq_val;
                     RAISE;
                END;

          ELSIF p_tipoSolicitud = 'T' THEN

                BEGIN
                   IF v_can_tel <= 0 THEN--Indica que el telefono no existe en la BD aun
                      insert into ba_telefonos (cod_persona, tipo, tip_linea, telefono, principal, area, cod_telefono)
                             values(v_cod_persona, 'H','B', p_telefono, 'N', p_codigoArea,
                                   (select max(cod_telefono)+1 from ba_telefonos where cod_persona = v_cod_persona)
                                   );
                   END IF;
                   update ba_act_dat_clientes set migrado ='S', fec_confirmacion = sysdate where id = v_seq_val;
                EXCEPTION
                WHEN DUP_VAL_ON_INDEX THEN
                     update ba_act_dat_clientes set migrado ='E', fec_confirmacion = sysdate where id = v_seq_val;
                     pr_mensajeUsuario(MSG_DAT_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL,SQLERRM||'-'||MSG_DAT_DUP, BITACORA_ERROR);
                     return v_retorno;
                WHEN OTHERS THEN
                     update ba_act_dat_clientes set migrado ='E', fec_confirmacion = sysdate where id = v_seq_val;
                     RAISE;
                END;
          ELSIF p_tipoSolicitud = 'EC' THEN

                begin
                  --Se recupera el código de persona del mail que se acaba de confirmar
                  select cod_persona, id into v_cod_persona, v_seq_val from ba_act_dat_clientes
                         where upper(trim(email)) = upper(trim(p_email))
                               and estado = 'P' and trunc(fec_caducidad)>=trunc(sysdate)
                                    and tip_solicitud = 'E' and migrado = 'N';

                  -- Almacenamos el email anterior a fin de enviar el mensaje de aviso luego del cambio a esa
                  -- dirección
                  v_old_mail := fug_obt_dir_mail_per(v_cod_persona);

                  update ba_act_dat_clientes set estado = 'C', fec_confirmacion = sysdate where id = v_seq_val; --DDSI-390

                  v_men_old_mail := fug_obt_pardinamico('ACT_DAT_AVI_CAM_EMAIL');

                  v_return := paw_not.fu_env_email_prueba(v_old_mail,
                                              utl_url.escape(v_men_old_mail,
                                              TRUE,
                                              'UTF-8'),
                                              'PAW_BEL');

                  if v_return = 0 then
                     pr_insertarBitacora(v_cod_persona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - ret: '||v_return||'; EMAIL de notificacion de cambio correctamente enviado a: '||v_old_mail,BITACORA_SALIDA);
                  else
                     pr_insertarBitacora(v_cod_persona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - ret: '||v_return||'; EMAIL de notificacion de cambio NO enviado a: '||v_old_mail,BITACORA_ERROR);
                  end if;


                exception
                   when no_data_found then
                  update ba_act_dat_clientes set estado = 'C', migrado = 'E', fec_confirmacion = sysdate where id = v_seq_val;
                     pr_mensajeUsuario(MSG_DAT_PEN_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(v_cod_persona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - Error al intentar migrar datos de correo.'||SQLERRM||'-' || MSG_ERROR,BITACORA_ERROR);
                     return v_retorno;
                    when too_many_rows then
                     update ba_act_dat_clientes set estado = 'C', migrado = 'E', fec_confirmacion = sysdate where id = v_seq_val;
                     pr_mensajeUsuario(MSG_DAT_PEN_DUP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(v_cod_persona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - Error al intentar migrar datos de correo.'||SQLERRM||'-' || MSG_ERROR,BITACORA_ERROR);
                     return v_retorno;
                    when others then
                       update ba_act_dat_clientes set estado = 'C', migrado = 'E', fec_confirmacion = sysdate where id = v_seq_val;
                       pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(v_cod_persona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - Error al intentar migrar datos de correo.'||SQLERRM||'-' || MSG_ERROR,BITACORA_ERROR);
                       return v_retorno;
                end;

          ELSIF p_tipoSolicitud = 'CC' THEN

                  --Se recupera el código de persona del número de celular que se acaba de confirmar
                  select cod_persona, id into v_cod_persona, v_seq_val from ba_act_dat_clientes
                         where trim(tel_area) = trim(p_codigoArea)  and trim(tel_numero) = trim(p_telefono)
                               and estado = 'P' and trunc(fec_caducidad)>=trunc(sysdate)
                                    and tip_solicitud = 'C' and migrado = 'N';

                update ba_act_dat_clientes set estado = 'C', fec_confirmacion = sysdate
                       where cod_persona = v_cod_persona and tip_solicitud = 'C' and estado = 'P';

          END IF;
    ELSIF p_modo = 'D' THEN --Consulta de Detalles. Retorna información del detalle de un cliente.

       FOR reg IN c_datosCli(v_cod_persona)
       LOOP
          v_can_detalles               := v_can_detalles + 1;
          v_retorno.nombreCompleto     := reg.nom_completo;
          v_retorno.direccion          := reg.direccion;
          v_retorno.email              := reg.dir_correo;
          v_retorno.codigoCiudad       := reg.cod_ciudad;
          v_retorno.descripcionCiudad  := reg.des_ciudad;
          v_retorno.codigoBarrio       := reg.cod_barrio;
          v_retorno.descripcionBarrio  := reg.des_barrio;
          v_retorno.numeroCasa         := reg.numero_casa;
          v_retorno.tipoDocumento      := reg.cod_tip_documento;
          v_retorno.codigoPaisIso        := reg.cod_pai_iso;

          --Los telefonos se reemplazan hasta encontrar el telefono principal, o el último registro modificado por el HB (tipo = H)
          IF reg.tip_linea = 'B' AND (v_retorno.tipoLineaPrincipal is null OR v_retorno.tipoLineaPrincipal != 'B' OR reg.tipo = 'H') THEN
             v_retorno.telefonoFijo  := reg.telefono;
          ELSIF reg.tip_linea = 'C' AND (v_retorno.tipoLineaPrincipal is null OR v_retorno.tipoLineaPrincipal != 'C'  OR reg.tipo = 'H') THEN
             v_retorno.celular := reg.telefono;
          END IF;

          IF reg.linea_principal = 'S' THEN
               v_retorno.tipoLineaPrincipal := reg.tip_linea;
          END IF;
       END LOOP;

       -- Valida si encontro datos
       IF v_can_detalles = 0 THEN
          pr_mensajeUsuario(MSG_G_SIN_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente-' || MSG_G_SIN_DATOS, BITACORA_ERROR);
          RETURN v_retorno;
        END IF;
      END IF; --TIPO SOLICITUD = D

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente - '||MSG_OK,  BITACORA_SALIDA);
     RETURN v_retorno;
    EXCEPTION
        WHEN EX_PARAM_VACIOS THEN
             pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Parámetros obligatorios vacios. p_modo:'
                                                                          ||p_modo||'-p_tipoSolicitud'||p_tipoSolicitud||'-p_direccion: '||p_direccion||
                                                                          '-Numero: '||p_codNumero||'-p_codigoArea: '|| p_codigoArea||'- p_telefono: '|| p_telefono, BITACORA_ERROR);
             return v_retorno;
        WHEN EX_PARAM_INCORRECTOS THEN
           pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, 'Datos a actualizar no validos-'||p_modo||'-p_tipoSolicitud'||p_tipoSolicitud||'-p_direccion: '||p_direccion||
                                                                          '- Numero: '||p_codNumero||'- p_codigoArea: '|| p_codigoArea||' - p_telefono: '|| p_telefono, BITACORA_ERROR);
                  return v_retorno;
        WHEN OTHERS THEN
             pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_datosCliente-'||SQLERRM||'-' || MSG_ERROR,BITACORA_ERROR);
             return v_retorno;
    END;



   /**
   * Historico de Cotizaciones
   * @Creado por: Fermín Giménez
   * @Fecha : 17-12-2012
   */
  FUNCTION fu_obtenerHisCotizaciones(p_sesion            IN VARCHAR2,
                                     p_codigoCanal       IN VARCHAR2,
                                     p_codigoMoneda      IN VARCHAR2,
                                     p_diasHistorico     IN NUMBER
                                     ) RETURN typ_respuestaHisCotizaciones IS

     CURSOR c_hisCot(p_codMoneda IN VARCHAR2) IS
      SELECT  a.cod_moneda cod_moneda, c.descripcion des_moneda,
             val_compra, val_venta,
             decode(val_com_electronica, 0, val_compra, val_com_electronica) val_com_electronica,
             decode(val_ven_electronica, 0, val_venta, val_ven_electronica) val_ven_electronica,
             a.fec_insercion
        FROM ba_monedas c, ge_cotizaciones a
       WHERE a.cod_moneda = c.cod_moneda
         AND TRUNC(a.fec_insercion) BETWEEN TRUNC(SYSDATE - p_diasHistorico) AND TRUNC(SYSDATE)
         AND (a.cod_moneda = p_codMoneda
              OR p_codMoneda IS NULL)
       ORDER BY a.cod_moneda, a.fec_insercion DESC;

     v_tip_mensaje VARCHAR2(3) := '303';

     v_retorno            typ_respuestaHisCotizaciones := typ_respuestaHisCotizaciones;
     v_historicoCotizaciones    typ_historicoCotizaciones := typ_historicoCotizaciones;
     v_lisHisCotizaciones typ_listaHisCotizaciones := typ_listaHisCotizaciones();

     MSG_G_SIN_DATOS    CONSTANT VARCHAR2(15) := 'G_SIN_DATOS'; /**No se encontraron registros*/

     v_can_detalles     NUMBER(3) := 0;
     userinfo           typ_validarsesion;
  BEGIN

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     v_retorno.cantidad := 0;

     -- Valido la Sesión del Cliente
     userinfo := fu_validarsesion(p_sesion, p_codigoCanal);

     IF userinfo.error = 'S' THEN
        v_retorno.error                := userinfo.error;
        v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     --datos
     FOR reg IN c_hisCot(p_codigoMoneda) LOOP
        v_can_detalles                                 := v_can_detalles + 1;
        v_historicoCotizaciones.codigoMoneda           := reg.cod_moneda;
        v_historicoCotizaciones.descripcionMoneda      := reg.des_moneda;
        v_historicoCotizaciones.compra                 := reg.val_compra;
        v_historicoCotizaciones.venta                  := reg.val_venta;
        v_historicoCotizaciones.compraBancaElectronica := reg.val_com_electronica;
        v_historicoCotizaciones.ventaBancaElectronica  := reg.val_ven_electronica;
        v_historicoCotizaciones.fecha                  := reg.fec_insercion;

        v_lisHisCotizaciones.extend;
        v_lisHisCotizaciones(v_lisHisCotizaciones.count) := v_historicoCotizaciones;
     END LOOP;

     -- Valida si encontro datos
     IF v_can_detalles = 0 THEN
        pr_mensajeUsuario(MSG_G_SIN_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_obtenerAreaCliente-' || MSG_G_SIN_DATOS, BITACORA_ERROR);
        RETURN v_retorno;
     END IF;

     IF v_lisHisCotizaciones.Count > 0 THEN
        v_retorno.historicoCotizaciones := v_lisHisCotizaciones;
     END IF;

     v_retorno.cantidad := v_lisHisCotizaciones.Count;

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_obtenerAreaCliente-' || BITACORA_SALIDA);
     RETURN v_retorno;
  END;

   /**
   * Pago de Servicios
   * @Fecha : 17-01-2013
   */
   FUNCTION fu_pagoServicios(p_sesion      IN VARCHAR2,
                             p_codigoCanal IN VARCHAR2,
                             p_modo        IN VARCHAR2,
                             p_cuenta      IN VARCHAR2,
                             p_numeroIp    IN VARCHAR2,
                             p_claveTransaccional IN VARCHAR2,
                             p_claveToken  IN VARCHAR2)
                             RETURN typ_pagoServicios IS

     userinfo        typ_validarSesion;
     v_retorno       typ_pagoServicios := typ_pagoServicios;
     v_mensajeCaja   typ_mensajeCaja;
     v_permiso       typ_obtenerPermisos;
     v_resLimite     typ_respuestaLimite;
     v_cod_operacion   VARCHAR2(3) := '087';
     v_cuenta        VARCHAR2(18);

     MSG_CTA_NO_CORRESP    CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND'; --Nro. de Cuenta no corresponde al cliente
     MSG_CTA_CONJUNTA      CONSTANT VARCHAR2(15) := 'CTA_CONJUNTA';
     MSG_INS_MOV_ER        CONSTANT VARCHAR2(15) := 'INS_MOV_ER';
     MOV_DUP_SERVICIO      CONSTANT VARCHAR2(15) := 'MOV_DUP_SERV';
     SER_PER_SIN_AUT       CONSTANT VARCHAR2(15) := 'SER_PER_SIN_AUT';
     v_msj_bitacora  VARCHAR2(200) := substr('modo:'||trim(p_modo)
                                                    ||', ctaDebito:'||trim(p_cuenta)
                                                    ||', nroIp:'||trim(p_numeroIp), 1, 200);

   -- Permite Verificar Operaciones
   PROCEDURE LP_VER_OPERACION(p_pagoServicio IN OUT typ_pagoServicios) IS
   BEGIN
        v_resLimite := fu_obtenerLimite(userinfo, '082', nvl(userinfo.codigoEmpresa, userinfo.codigoPersona), NULL, pag_gen.FU_OBT_MON_LOCAL, 503, 485, 1, 'V');

        p_pagoServicio.error                := v_resLimite.error;
        p_pagoServicio.nombreRespuesta      := v_resLimite.nombreRespuesta;
        p_pagoServicio.descripcionRespuesta := v_resLimite.descripcionRespuesta;

        IF v_resLimite.error = 'S' THEN
           pr_insertarBitacora(userinfo.codigoPersona,
                               userinfo.codigoCanal,
                               p_sesion,
                               v_cod_operacion,
                               userinfo.codigoEmpresa,
                               v_msj_bitacora || ' ' ||
                               fu_generarBitacora(p_pagoServicio.error, p_pagoServicio.nombreRespuesta, p_pagoServicio.descripcionRespuesta, NULL),
                               BITACORA_ERROR);
        ELSE
           p_pagoServicio.respuestaLimite := v_resLimite.codRespuesta;
           pr_insertarBitacora(userinfo.codigoPersona,
                               userinfo.codigoCanal,
                               p_sesion,
                               v_cod_operacion,
                               userinfo.codigoEmpresa,
                               v_msj_bitacora || ', resLim: ' || v_resLimite.codRespuesta || ' ' ||
                               fu_generarBitacora(p_pagoServicio.error, p_pagoServicio.nombreRespuesta, p_pagoServicio.descripcionRespuesta, NULL),
                               BITACORA_SALIDA);
        END IF;
   END;
   -- Fin de LP_VER_OPERACION

  -- Permite confirmar la Operación
  FUNCTION LF_CON_OPERACION(p_cuenta       IN VARCHAR2)
                            RETURN typ_pagoServicios IS

  v_claveSesion  VARCHAR(32);
  v_resLimite    typ_respuestaLimite;
  v_retError     typ_mensajeRespuesta := typ_mensajeRespuesta;
  v_pagoServicio typ_pagoServicios := typ_pagoServicios;


  BEGIN
     v_resLimite := fu_obtenerLimite(userinfo,
                                     '082',
                                     nvl(userinfo.codigoEmpresa, userinfo.codigoPersona),
                                     NULL,
                                     pag_gen.FU_OBT_MON_LOCAL,
                                     503,
                                     485,
                                     1,
                                     'C');
        v_pagoServicio.error                := v_resLimite.error;
        v_pagoServicio.nombreRespuesta      := v_resLimite.nombreRespuesta;
        v_pagoServicio.descripcionRespuesta := v_resLimite.descripcionRespuesta;

        IF v_resLimite.error = 'S' THEN
          pr_insertarBitacora(userinfo.codigoPersona,
                              userinfo.codigoCanal,
                              p_sesion,
                              v_cod_operacion,
                              userinfo.codigoEmpresa,
                              v_msj_bitacora || ' ' ||
                              fu_generarBitacora(v_pagoServicio.error, v_pagoServicio.nombreRespuesta, v_pagoServicio.descripcionRespuesta, NULL),
                              BITACORA_ERROR);
           RETURN v_pagoServicio;
        END IF;

        IF v_resLimite.codRespuesta IN ('10', '11') THEN
            -- clave transaccional requerida
            v_retError := lf_obt_cla_validar(p_claveTransaccional, userinfo.codigoPersona, userinfo.codigoEmpresa, 'T');
        END IF;

        IF nvl(v_retError.error, 'N') = 'N' THEN
           IF v_resLimite.codRespuesta IN ('01', '11') THEN
              -- token requerido
              v_retError := paw_seg.fu_obt_tok_validar(p_claveToken, userinfo.codigoPersona, userinfo.codigoEmpresa, 'C');
           END IF;
        END IF;

        IF v_retError.error = 'S' THEN
           v_pagoServicio.error                := v_retError.error;
           v_pagoServicio.nombreRespuesta      := v_retError.nombreRespuesta;
           v_pagoServicio.descripcionRespuesta := v_retError.descripcionRespuesta;
           pr_insertarBitacora(userinfo.codigoPersona,
                               p_codigoCanal,
                               p_sesion,
                               v_cod_operacion,
                               userinfo.codigoEmpresa,
                               v_msj_bitacora || ' ' ||
                               fu_generarBitacora(v_pagoServicio.error, v_pagoServicio.nombreRespuesta, v_pagoServicio.descripcionRespuesta, NULL),
                               BITACORA_ERROR);
           RETURN v_pagoServicio;
        END IF;

        -- Crea el numero de sesion e insertar en bw_sesiones
        v_claveSesion:=paw_bce.fu_enc_md5(p_sesion||round(dbms_random.value(1000000, 9999999)));

        IF pag_ser.fu_ins_sesion(v_claveSesion, p_numeroIp, userinfo.codigoPersona, userinfo.codigoEmpresa, p_cuenta) = 'S' THEN
           v_pagoServicio.numeroSesion:= v_claveSesion;
           pr_insertarBitacora(userinfo.codigoPersona,
                               userinfo.codigoCanal,
                               p_sesion,
                               v_cod_operacion,
                               userinfo.codigoEmpresa,
                               v_msj_bitacora || ' ' ||
                               fu_generarBitacora(v_pagoServicio.error, v_pagoServicio.nombreRespuesta, v_pagoServicio.descripcionRespuesta, NULL),
                               BITACORA_SALIDA);
           -- registro del movimiento
           lp_reg_operacion(p_cuenta, -- Nro cuenta
                            null,
                            null,
                            null,
                            null,
                            'Pago de Servicios',
                             p_sesion,
                             null,
                             null,
                             'Yaguarete',
                             p_numeroIp,
                             '000',
                             userinfo.codigopersona,
                             v_cod_operacion,
                             v_cod_operacion,
                             p_codigoCanal,
                             p_sesion,
                             userinfo.codigoempresa);
        ELSE
            --MSG_INS_MOV_ER
           pr_mensajeUsuario(MSG_INS_MOV_ER, v_pagoServicio.nombreRespuesta, v_pagoServicio.descripcionRespuesta, v_pagoServicio.error);
           pr_insertarBitacora(userinfo.codigoPersona,
                               userinfo.codigoCanal,
                               p_sesion,
                               v_cod_operacion,
                               userinfo.codigoEmpresa,
                               v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' ||
                               fu_generarBitacora(v_pagoServicio.error, v_pagoServicio.nombreRespuesta, v_pagoServicio.descripcionRespuesta, NULL),
                               BITACORA_ERROR);
           RETURN v_pagoServicio;
        END IF;
        RETURN v_pagoServicio;
     END;
   -- Fin de LF_CON_OPERACION

   BEGIN
     -- Valido la Sesión del Cliente
     userinfo := fu_validarsesion(p_sesion, p_codigoCanal);
     IF userinfo.error = 'S' THEN
          v_retorno.error                := userinfo.error;
          v_retorno.nombrerespuesta      := userinfo.nombreRespuesta;
          v_retorno.descripcionrespuesta := userinfo.descripcionRespuesta;
          RETURN v_retorno;
     END IF;
     -- Verifica el canal de origen
     v_mensajeCaja := lf_val_caja(userinfo);
     IF v_mensajeCaja.error = 'S' THEN
          v_retorno.error                := v_mensajeCaja.error;
          v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
          RETURN v_retorno;
     END IF;
     -- Verifica si el usuario tiene acceso a la opcion y en que condicion
     v_permiso := lf_obt_permisos(userinfo, v_cod_operacion); --NVL(userinfo.codigoEmpresa, userinfo.codigoPersona), userinfo.codigoPerfil,
                                  --v_cod_operacion, userinfo.codigoCanal);
     IF (v_permiso.error = 'S') THEN
          v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
          v_retorno.error                := v_permiso.error;
          pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
          RETURN v_retorno;
     END IF;
     -- se verifica que tiene permiso para registrar
     IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
        pr_mensajeUsuario(SER_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, NULL, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
        RETURN v_retorno;
     END IF;

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userinfo.codigoPersona, userinfo.codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora ||' '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null ), BITACORA_ENTRADA);

     -- validamos que se pueda insertar una sesion
     IF pag_ser.fu_val_ins_sesion(userinfo.codigoPersona, userinfo.codigoEmpresa) = 'N' THEN
        pr_mensajeUsuario(MOV_DUP_SERVICIO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona,
                   userinfo.codigoCanal,
                   p_sesion,
                   v_cod_operacion,
                   userinfo.codigoEmpresa,
                   v_msj_bitacora || ' '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                   BITACORA_ERROR);
        RETURN v_retorno;
     END IF;

     IF p_modo = 'V' THEN
      LP_VER_OPERACION(v_retorno);
     ELSIF p_modo = 'C' THEN
      v_cuenta := depurarAlfanumerico(p_cuenta, CUENTA_TAMANO);

      --Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(v_cuenta, nvl(userinfo.codigoEmpresa, userinfo.codigoPersona)) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona,
                   userinfo.codigoCanal,
                   p_sesion,
                   v_cod_operacion,
                   userinfo.codigoEmpresa,
                   v_msj_bitacora || ' '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                   BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      --Valida que la cuenta no sea conjunta
      IF PAW_BAS.fu_es_conjunta(v_cuenta, v_can_aut_requeridas) = 'S' THEN
         pr_mensajeUsuario(MSG_CTA_CONJUNTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona,
                   userinfo.codigoCanal,
                   p_sesion,
                   v_cod_operacion,
                   userinfo.codigoEmpresa,
                   v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                   BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      RETURN LF_CON_OPERACION(v_cuenta);
     END IF;
     RETURN v_retorno;
  END;
   /**
   * Contrato de Cambio del Cliente
   * @Creado por: Fermín Giménez
   * @Fecha : 27-02-2013
   */
   FUNCTION fu_obtenerContratoCambio( p_sesion      IN VARCHAR2,
                                      p_codigoCanal IN VARCHAR2
                                    ) RETURN typ_respuestaContratoCambio IS

     CURSOR c_contrato(p_nro_documento IN VARCHAR2) IS
       SELECT l.nro_operacion, l.cod_tip_operacion, lto.descripcion, l.cotizacion, l.cod_moneda,
              l.monto, l.mto_equ_local, l.mto_cargo1, l.mto_cargo2, l.mto_cargo3, l.mto_cargo4,
              l.cta_ref_contra3, l.mto_contra3, l.nro_diario
         FROM LC_OPE_PENDIENTES l, LC_TIP_OPERACIONES lto
        WHERE l.cod_tip_operacion = lto.cod_tip_operacion
          AND l.liquidado = 'N'
          AND l.ope_homebanking = 'S'
          AND l.nro_documento = p_nro_documento
          AND l.fec_operacion = trunc(SYSDATE)
        UNION
        -- arbitraje
       SELECT l.nro_operacion, l.cod_tip_operacion, lto.descripcion, l.cotizacion, l.cod_moneda,
              l.monto, l.mto_equ_local, l.mto_cargo1, l.mto_cargo2, l.mto_cargo3, l.mto_cargo4,
              l.cta_ref_contra3, l.mto_contra3, l.nro_diario
         FROM LC_OPE_PEN_CAMBIOS l, LC_TIP_OPERACIONES lto
        WHERE l.cod_tip_operacion = lto.cod_tip_operacion
          AND l.liquidado = 'N'
          AND l.ope_homebanking = 'S'
          AND l.nro_documento = p_nro_documento
          AND l.cod_tip_operacion = 61 -- compra debito cta cliente
          AND l.fec_operacion = trunc(SYSDATE);

     v_cod_operacion VARCHAR2(3) := '304';
     v_exonerado VARCHAR2(1);


     v_retorno                  typ_respuestaContratoCambio := typ_respuestaContratoCambio;
     v_contratoCambio           typ_contratoCambio := typ_contratoCambio;
     v_listaContratosCambio     typ_listaContratosCambio := typ_listaContratosCambio();
     v_cod_persona              VARCHAR2(10);

     MSG_G_SIN_DATOS            CONSTANT VARCHAR2(15) := 'G_SIN_DATOS'; /**No se encontraron registros*/

     v_can_detalles              NUMBER(3) := 0;
     userinfo                    typ_validarsesion;
  BEGIN

     paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

     -- Valido la Sesión del Cliente
     userinfo := fu_validarsesion(p_sesion, p_codigoCanal);

     IF userinfo.error = 'S' THEN
        v_retorno.error                := userinfo.error;
        v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     v_cod_persona := NVL(userinfo.codigoEmpresa, userinfo.codigoPersona);
     --DDSI-52 - GDF - AGO 2017
     --Verificamos si la persona tiene exoneracion de gasto OUR
     v_exonerado := pal_tra.fu_ver_gto_exonerado(v_cod_persona);

     --datos
     FOR reg IN c_contrato(FUE_OBT_NRO_DOC_PERSONA(v_cod_persona)) LOOP
        v_can_detalles                     := v_can_detalles + 1;
        v_contratoCambio.numeroContrato    := reg.nro_operacion;
        v_contratoCambio.tipoOperacion     := reg.cod_tip_operacion;
        v_contratoCambio.cotizacion        := reg.cotizacion;
        v_contratoCambio.codigoMoneda      := reg.cod_moneda;
        v_contratoCambio.monto             := reg.monto;
        v_contratoCambio.montoEqLocal      := reg.mto_equ_local;
        v_contratoCambio.montoCargo1       := reg.mto_cargo1;
        v_contratoCambio.montoCargo2       := reg.mto_cargo2;
        v_contratoCambio.montoCargo3       := reg.mto_cargo3;
        v_contratoCambio.montoCargo4       := reg.mto_cargo4;
        v_contratoCambio.cuentaReferencia3 := substr(reg.cta_ref_contra3, 15);
        v_contratoCambio.montoCargo3       := reg.mto_contra3;
        v_contratoCambio.numeroDiario      := reg.nro_diario;
        IF v_contratoCambio.montoCargo2 IS NULL AND v_exonerado = 'S' THEN
           v_contratoCambio.montoCargo2 := 0;
        END IF;

        v_listaContratosCambio.extend;
        v_listaContratosCambio(v_listaContratosCambio.count) := v_contratoCambio;
     END LOOP;

     -- Valida si encontro datos
     IF v_listaContratosCambio.Count > 0 THEN
        v_retorno.contratosCambio := v_listaContratosCambio;
     ELSE
        paw_uti.pr_mensajeUsuario(MSG_G_SIN_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        paw_uti.pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, ' fu_obtenerContratoCambio ' || paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
        RETURN v_retorno;
     END IF;

     paw_uti.pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, ' fu_obtenerContratoCambio - total: '||v_can_detalles||' '||paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null),  paw_uti.BITACORA_SALIDA);
     return v_retorno;
  END;
   /**
   * Transferencias Interbancarias SNP
   * @Creado por: Fermín Giménez
   * @Fecha : 31-01-2013
   */
FUNCTION fu_transferenciaInterbancaria(p_sesion IN VARCHAR2,
                                         p_codigoCanal IN VARCHAR2,
                                         p_modo IN VARCHAR2,
                                         p_codigoSwift IN VARCHAR2,
                                         p_numeroCuentaCredito IN VARCHAR2,
                                         p_numeroCuentaDebito IN VARCHAR2,
                                         p_codigoMonedaCredito IN VARCHAR2,
                                         p_montoCredito IN NUMBER,
                                         p_fechaOperacion IN DATE,
                                         p_cargos IN VARCHAR2,
                                         p_numeroDocumentoCredito IN VARCHAR2,
                                         p_nombreBeneficiario IN VARCHAR2,
                                         p_direccionBeneficiario IN VARCHAR2,
                                         p_numeroContrato IN NUMBER,
                                         p_concepto IN VARCHAR2,
                                         p_numeroIp IN VARCHAR2,
                                         p_tipoMensaje IN VARCHAR2,
                                         p_tipoDocumentoBeneficiario IN NUMBER,
                                         p_numeroReferencia IN NUMBER,
                                         p_montoDebito IN NUMBER,
                                         p_cotizacionDebito IN NUMBER,
                                         p_cotizacionCredito IN NUMBER,
                                         p_claveToken IN VARCHAR2,
                                         p_claveTransaccional IN VARCHAR2,
                                         p_prioridad IN VARCHAR2) RETURN typ_transferenciaInterbancaria IS

      userinfo                    typ_validarsesion;
      v_retorno                   typ_transferenciaInterbancaria := typ_transferenciaInterbancaria();
      v_retorno_men_res           typ_MensajeRespuesta := typ_MensajeRespuesta;
      v_mensajeCaja               typ_mensajeCaja;
      v_permiso                   typ_obtenerPermisos;
      v_resLimite                 typ_respuestaLimite;
      v_tipos_documentos          typ_tiposdocumentos;
      v_bancos                    typ_bancos;
      V_lista_detalles_banco      typ_listaDetalleBancos;
      v_cod_mt                    VARCHAR2(3);
      v_prioridad                 VARCHAR2(1);
      v_detalleConsultaEntes      typ_detalleConsultaEntes := typ_detalleConsultaEntes;
      v_listaConsultaEntes        typ_listaConsultaEntes := typ_listaConsultaEntes();
      v_detalleConsultaDocumentos typ_detalleConsultaDocumentos := typ_detalleConsultaDocumentos;
      v_listaConsultaDocumentos   typ_listaConsultaDocumentos := typ_listaConsultaDocumentos();

      v_cod_persona               VARCHAR2(10);
      v_cod_operacion             VARCHAR2(3) := '036';
      v_bitacora_titulo           VARCHAR2(700) := substr('modo: ' || TRIM(p_modo) || ', codSwif: ' || TRIM(p_codigoSwift) || ', ctaCre: ' ||
                                               TRIM(p_numeroCuentaCredito) || ', ctaDeb: ' || TRIM(p_numeroCuentaDebito) || ', codMonCre: ' ||
                                               TRIM(p_codigoMonedaCredito) || ', mtoCre: ' || p_montoCredito || ', fecOpe: ' ||
                                               to_char(p_fechaOperacion, 'dd/mm/yyyy') || ', car: ' || TRIM(p_cargos) || ', nroDocCre: ' ||
                                               TRIM(p_numeroDocumentoCredito) || ', nroContr: ' || p_numeroContrato || ', tipMsj: ' || TRIM(p_tipoMensaje) ||
                                               ', tipDocBen: ' || p_tipoDocumentoBeneficiario || ', nroRef: ' || p_numeroReferencia || ', mtoDeb: ' ||
                                               p_montoDebito || ', cotDeb: ' || p_cotizacionDebito || ', cotCre: ' || p_cotizacionCredito||',prioridad:'||p_prioridad, 1, 700);

      --Variables Recibidas
      v_nro_cta_debito            VARCHAR2(16);
      v_nro_cta_credito           VARCHAR2(20);   -- cuenta de credito
      v_modo                      VARCHAR2(1) := p_modo;
      v_cod_mon_credito           VARCHAR2(3);   -- moneda de la cuenta
      v_cod_swift                 VARCHAR2(20) ;
      v_nom_cliente               VARCHAR2(100);
      v_dir_cliente               VARCHAR2(100);
      v_nro_doc_credito           VARCHAR2(20) := null;  -- nro de documento del acreditado
      v_concepto                  VARCHAR2(100);
      v_cargos                    VARCHAR2(1) ;
      v_nom_beneficiario          VARCHAR2(100) ;
      v_dir_beneficiario          VARCHAR2(100) ;
      v_nro_ip                    VARCHAR2(20);
      v_nro_contrato              NUMBER(7); -- Nro de Contrato de Cambio
      v_tip_doc_beneficiario      NUMBER(3) ;
      v_mto_credito               NUMBER(18,2);
      v_fec_operacion             DATE;
      -- Variables Internas
      v_cta_for_debito            VARCHAR2(17);  -- cuenta formateada
      v_cod_mon_debito            VARCHAR2(3);   -- moneda de la cuenta
      v_nom_cta_debito            VARCHAR2(100);
      v_nro_doc_cliente           VARCHAR2(20);
      v_tip_cargos                VARCHAR2(3) ;
      v_est_periodo               VARCHAR2(1) := 'N'; -- Estado del Periodo SNP
      v_cta_pte_solicitante       VARCHAR2(20); -- Nro de Cuenta Interbancaria
      v_cta_pte_sol_bcp           VARCHAR2(20);
      v_tip_operacion             VARCHAR2(3) ;
      v_tip_movimiento            VARCHAR2(1) ; -- D:Débito; C: Crédito
      v_msj_swift                 VARCHAR2(4000) ;
      v_cod_mod_debito            NUMBER(4);     -- Modulo de la cuenta
      v_cod_mad_debito            NUMBER(4);     -- Modalidad de la cuenta
      v_cod_mod_padre             NUMBER(4);     -- Modulo Padre
      v_cod_mad_padre             NUMBER(4);     -- Modalidad Padre
      v_cod_ofi_debito            NUMBER(4);     -- oficina de la cuenta
      v_cot_debito                ge_movimientos.cotizacion%TYPE := null;
      v_mto_debito                NUMBER(18,2);
      v_cot_credito               ge_movimientos.cotizacion%TYPE := null;
      v_mto_equ_local             NUMBER(18) := null;
      v_cod_tra_padre             NUMBER(4)  := 303;     -- cod. transaccion padre
      v_cod_tra_credito           NUMBER(4)  := 196;     -- cod. transaccion hijo credito
      v_cod_tra_debito            NUMBER(4)  := 503;     -- cod. transaccion hijo debito
      v_nro_documento             NUMBER(15);
      v_nro_referencia            NUMBER(15);
      v_nro_ope_cambio            NUMBER(15);
      v_nro_secuencia             NUMBER(3) := 0 ;
      r_gtran                     pas_snp.rg_msj;
      v_fec_actual                DATE := pag_cal.fu_obt_fec_actual(9);          -- fecha de hoy
      v_fec_valor                 DATE := v_fec_actual;
      v_hor_actual                VARCHAR2(8) := to_char(sysdate,'HH24:MI:SS');   -- Hora actual
      v_hab_ach                   VARCHAR2(1) := substr(fug_obt_pardinamico('SNP_HAB_MSJ_ACH'),1,1);

      -- Variables de Salida
      v_can_detalle               NUMBER(3);
      --  Tipos de Mensajes de respuestas
      MSG_CODCTA_NOEX             CONSTANT VARCHAR2(15) := 'CODCTA_NOEX'; /**Codigo de Cuenta inexistente*/
      MSG_CTA_INT_INVA            CONSTANT VARCHAR2(15) := 'CTA_INT_INVA'; /**Cuenta Interbancaria Invalida*/
      MSG_OBT_TAR_INVA            CONSTANT VARCHAR2(15) := 'OBT_TAR_INVA'; /**Nro de Tarjeta Invalido*/
      MSG_MTO_INVALIDO            CONSTANT VARCHAR2(15) := 'MTO_INVALIDO'; /**Monto invalido*/
      MSG_FECHA_INVA              CONSTANT VARCHAR2(15) := 'FECHA_INVA'; /**Fecha Invalida*/
      MSG_ERR_CONVERS             CONSTANT VARCHAR2(15) := 'ERR_CONVERS'; /**Error de conversion*/
      MSG_HORA_INVA               CONSTANT VARCHAR2(15) := 'HORA_INVA'; /**Hora Invalida*/
      MSG_CONCAM_INVA             CONSTANT VARCHAR2(15) := 'CONCAM_INVA'; /**Contrato de Cambio invalido*/
      MSG_CODPED_DUPLI            CONSTANT VARCHAR2(15) := 'CODPED_DUPLI'; /**Codigo pedido duplicado*/
      MSG_TRA_INVALIDA            CONSTANT VARCHAR2(15) := 'TRA_INVALIDA'; /** Transaccion invalida*/
      MSG_REFTRAEX_INVA           CONSTANT VARCHAR2(15) := 'REFTRAEX_INVA'; /**Nro de Referencia Transf. exterior invalida*/
      MSG_CONFSNP_INVA            CONSTANT VARCHAR2(15) := 'CONFSNP_INVA'; /**Confirmación SNP Invalida*/
      MSG_MONEDA_ER               CONSTANT VARCHAR2(15) := 'MONEDA_ER'; /**Error al obtener moneda*/
      TRA_SIN_AUTORIZACION        CONSTANT VARCHAR2(15) := 'SNP_SIN_AUTORIZ'; /**Sin permiso para transferencia*/
      MSG_MTO_MAX_ACH             CONSTANT VARCHAR2(15) := 'SNP_MTO_MAX_ACH'; /*Limite de ach sobrepasado*/
      MSG_TIP_BCP_INV             CONSTANT VARCHAR2(15) := 'SNP_BCP_INV'; /**Tipo de envío inválido para BCP*/
      MSG_MOV_INGRESADO           CONSTANT VARCHAR2(15) := 'G_MOV_YA_INGRE';
      v_msg_error                 VARCHAR2(15) := MSG_ERROR;
      v_cod_tip_operacion         VARCHAR2(3)    := '001';
      v_cod_sub_tip_operacion     VARCHAR2(3);--    := '002';
      v_cod_sub_tip_ope103        VARCHAR2(3);
      v_mto_max_ach               NUMBER(18,2);
      v_cod_respuesta             NUMBER;
      v_cli_pue_enviar            varchar2(1);
      v_cod_swi_patrocinador      ge_snp_transferencias.Cod_Swi_Pte_Beneficiario%TYPE;
      v_sig_fec_hab_patrocinador  ge_snp_transferencias.fec_valor%type;
      v_hor_ini_snp varchar2(10);
      
      ---
      id_pago                     ge_spi_transferencias.id_pago%type;
      resultado                   ge_spi_transferencias.message_result%type;
      motivo                      varchar2(100);
      r_gtranspi                  pas_spi.rg_msj;
      P_RESULT                    ge_spi_transferencias.error%type;
      P_DET_ERROR                 ge_spi_transferencias.error%type;
      P_RESULT_PRO                ge_spi_transferencias.error%type;
      P_DET_ERROR_PRO             ge_spi_transferencias.error%type;
      tipo_transferencia          varchar2(20);
      v_bic_origen                ge_spi_transferencias.bic_origen%type;
      v_tip_doc_receptor          ge_spi_transferencias.tip_doc_receptor%type;
      v_spi_detectado             varchar2(3);
      v_cot_spi                   ge_movimientos.cotizacion%TYPE := null;
      v_err_duplicado             varchar2(3);
      v_mto_debito_spi            NUMBER(18,2);
      v_cot_credito_spi           ge_movimientos.cotizacion%TYPE := null;
      v_cot_debito_spi            ge_movimientos.cotizacion%TYPE := null;            
      v_cod_mon_debito_spi        VARCHAR2(3);
      v_mto_credito_spi           NUMBER(18,2);
      v_cod_mon_credito_spi       VARCHAR2(3);
      v_descripcion_resp          bw_men_respuesta.des_mensaje%TYPE := null;
      v_error_resp                bw_men_respuesta.error%TYPE := null;
      v_dir_correo_spi            ge_par_dinamicos.val_parametro%TYPE;
      v_spi_hab_pf                VARCHAR2(1) := fug_obt_pardinamico('SPI_HAB_PF');
      v_spi_hab_pj                VARCHAR2(1) := fug_obt_pardinamico('SPI_HAB_PJ');
      v_spi_hab_corr_ok           VARCHAR2(1) := fug_obt_pardinamico('SPI_ENV_CORR_OK');
      v_spi_hab_corr_fail         VARCHAR2(1) := fug_obt_pardinamico('SPI_ENV_CORR_FAIL');
      v_banco                     varchar2(100):=NULL;
      v_mje_mail                  LONG;
      v_texto                     varchar2(32000);
      v_texto_detalle             varchar2(32000) := null;
      v_tex_err                   varchar2(4000);
      v_membrete                  LONG := fug_gen_template('M');
      V_FIN                       LONG := fug_gen_template('F');
      V_PIE                       LONG := fug_gen_template('P');
      v_nro_notificacion          number(20);
      v_env_por                   varchar2(100):=fug_obt_pardinamico('CAM_MAR_DIR_MAI_NET');
      v_des_monto                 varchar2(100) := NULL;
      v_tipo_doc                  ba_tip_documentos.abreviatura%TYPE := null;
      v_resul_spi                 ge_spi_transferencias.error%type;
      v_existe_transaccion        varchar2(2);
   BEGIN
/*
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

     -- Valido la Sesión del Cliente
     userinfo := fu_validarsesion(p_sesion, p_codigoCanal);

     IF userinfo.error = 'S' THEN
        v_retorno.error                := userinfo.error;
        v_retorno.nombrerespuesta      := userinfo.nombreRespuesta;
        v_retorno.descripcionrespuesta := userinfo.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     -- Verifica el canal de origen
     v_mensajeCaja := lf_val_caja(userinfo);

     IF v_mensajeCaja.error = 'S' THEN
        v_retorno.error                := v_mensajeCaja.error;
        v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     IF nvl(p_modo, 'x') = 'A' THEN
        IF g_aut_operacion = FALSE THEN
           pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                               v_bitacora_titulo || ' ' ||
                                fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
     ELSE
        v_permiso := lf_obt_permisos(userinfo, v_cod_operacion);
        IF v_permiso.error = 'S' THEN
           pr_mensajeUsuario(TRA_SIN_AUTORIZACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                               v_bitacora_titulo || ' ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
        -- se verifica que tenga permiso para registrar
        IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
           pr_mensajeUsuario(TRA_SIN_AUTORIZACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                               v_bitacora_titulo || ' ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
     END IF;

     v_cod_persona := NVL(userinfo.codigoEmpresa, userinfo.codigoPersona);

     v_modo                := p_modo ;
     v_nro_referencia      := p_numeroReferencia ;
     v_nro_cta_debito      := depurarAlfanumerico(p_numeroCuentaDebito, 16);
     v_mto_debito          := p_montoDebito ;
     v_cot_debito          := p_cotizacionDebito ;
     v_cta_pte_solicitante := depurarAlfanumerico(p_numeroCuentaCredito, 20);
     v_mto_credito         := nvl(p_montoCredito, 0) ;
     v_mto_credito_spi         := nvl(p_montoCredito, 0) ;
     v_cot_credito         := p_cotizacionCredito ;
     v_cod_mon_credito     := depurarAlfanumerico(p_codigoMonedaCredito, 3);
     --v_fec_operacion       := p_fechaOperacion ;
     v_cod_swift           := depurarAlfanumerico(p_codigoSwift, 20);

     \* SPPARPAT-2 Participante patrocinador (VAE) *\
     --v_cod_swi_patrocinador := pas_snp.fu_obt_par_patrocinador(v_cod_swift);
     --VErifica si es un swift de un participante patricinado
     IF v_cod_swi_patrocinador is not null then
        v_cod_sub_tip_ope103 := '004';
     ELSE
        v_cod_sub_tip_ope103 :='002';
     END IF;
     \*FIN SPPARPAT-2 Participante patrocinador (VAE)*\


     -- Enviamos en el parametro los datos del MT103 que corresponde a tranf del clientes.
     -- si cumple con las condiciones debe ir como mt103, sino ira como MT102
     if v_modo in ('V', 'C', 'A', 'P') THEN
       v_cod_mon_debito := FUG_OBT_MON_CTA(v_nro_cta_debito);
       v_cli_pue_enviar := fug_pue_env_tra_fue_hora('103','001',v_cod_sub_tip_ope103,v_cod_tra_padre,v_mto_credito, v_cod_mon_credito, null, v_nro_cta_debito);
       IF (p_prioridad = 'A' OR p_prioridad IS NULL) and
          (paw_bas.fu_obt_tip_TransfInterbancaria('103','001',v_cod_sub_tip_ope103,v_cod_tra_padre,v_mto_credito, v_cod_mon_credito, null, v_cod_persona) ='103')
       THEN
          v_cod_mt    := '103';
          v_prioridad := 'A';
          v_cod_tip_operacion     := '001';
          v_cod_sub_tip_operacion := v_cod_sub_tip_ope103;
          if ((fug_den_per_act_snp('103','001',v_cod_sub_tip_ope103,v_cod_tra_padre,3) = 'S') and
              (v_cod_mon_credito = v_cod_mon_local) and
              (v_cod_mon_debito <> v_cod_mon_local) and
              (v_cli_pue_enviar = 'S'))
               then
               if v_cod_sub_tip_ope103 ='004' then
                 v_cod_mt     := '103';
                 v_prioridad := 'A';
                 v_cod_tip_operacion      := '001';
                 v_cod_sub_tip_operacion  := '004';
               else
                 v_cod_mt     := '102';
                 v_prioridad := 'B';
                 v_cod_tip_operacion      := '011';
                 v_cod_sub_tip_operacion  := '001';
               end if;
               if v_fec_actual = trunc(sysdate) then
                 -- seteamos para el siguiente dia
                 v_fec_valor              := pag_cal.FU_OBT_FEC_SIG_HAB(v_fec_actual,1);
               end if;
          end if;
          v_hor_ini_snp := paw_bas.fu_obt_hor_ini_snp(v_cod_mt,v_cod_tip_operacion,v_cod_sub_tip_operacion,303);

          \* SPPARPAT-2 Participante patrocinador (VAE) *\
          if v_cod_sub_tip_ope103 = '004' and v_cli_pue_enviar = 'N' then
            v_cod_mt    := '103';
            v_prioridad := 'A';
            v_cod_tip_operacion     := '001';
            if  (v_hor_actual >= v_hor_ini_snp and trunc(sysdate) = v_fec_actual) 
              or trunc(sysdate) > v_fec_actual then
              v_sig_fec_hab_patrocinador := pag_cal.FU_OBT_FEC_SIG_HAB(v_fec_actual,1);
            else
              v_sig_fec_hab_patrocinador := v_fec_actual;
            end if;
          end if;
          \*Fin SPPARPAT-2 Participante patrocinador (VAE)*\
       else
          if v_cod_sub_tip_ope103 = '004' \*and v_cli_pue_enviar = 'N'*\ then
            v_cod_mt    := '103';
            v_prioridad := 'A';
            v_cod_tip_operacion     := '001';
            v_cod_sub_tip_operacion  := '004';
            if v_cli_pue_enviar = 'N' then
               if  (v_hor_actual >= v_hor_ini_snp and trunc(sysdate) = v_fec_actual) 
                   or trunc(sysdate) > v_fec_actual then
                  v_sig_fec_hab_patrocinador := pag_cal.FU_OBT_FEC_SIG_HAB(v_fec_actual,1);
                else
                  v_sig_fec_hab_patrocinador := v_fec_actual;
                end if;
             else
                v_sig_fec_hab_patrocinador := v_fec_actual;   
             end if;
          else
            v_cod_mt    := '102';
            v_prioridad := 'B';
            v_cod_tip_operacion      := '011';
            v_cod_sub_tip_operacion  := '001';
            if v_fec_actual = trunc(sysdate) then
              -- seteamos para el siguiente dia
              v_fec_valor              := pag_cal.FU_OBT_FEC_SIG_HAB(v_fec_actual,1);
            end if;
          end if;  
       END IF;
     end if;

     if v_cod_sub_tip_operacion = '004' and v_cli_pue_enviar = 'N' then
       v_fec_operacion := v_sig_fec_hab_patrocinador;
     else
       v_fec_operacion := paw_bas.fu_obt_snp_fec_acreditacion(v_cod_mt, v_cod_mon_credito);
     end if;
     ---
      -- OMM DIC/2017 Ajuste para no generar MT102
   \*  IF p_prioridad = 'A' OR p_prioridad IS NULL OR nvl(v_hab_ach,'N') = 'N' THEN
        v_cod_mt    := '103';
        v_prioridad := 'A';
        v_cod_tip_operacion     := '001';
        v_cod_sub_tip_operacion := '002';
     ELSIF p_prioridad = 'B' THEN
        v_cod_mt    := '102';
        v_prioridad := 'B';
        v_cod_tip_operacion      := '011';
        v_cod_sub_tip_operacion  := '001';
     END IF;*\

     --  Si es BCP hay que cambiar el sub tipo de operacion a 005
     IF v_cod_swift = nvl(fug_obt_pardinamico('SNP_BIC_BCP'),'X') THEN
        v_cod_sub_tip_operacion := nvl(fug_obt_pardinamico('SNP_SUB_TIP_OPE_TRA_BCP'),'005'); -- DDSI-62
        -- No se pueden hacer transferencias por lotes al BCP
        IF v_cod_tip_operacion = '011' THEN
           pr_mensajeUsuario(MSG_TIP_BCP_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                               v_bitacora_titulo || ' - ' ||
                               fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                               BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
     END IF;

     \* Si es 102 hay que verificar que el monto debito no supere el limite en MTO_MAX_ACH y la moneda de credito tiene que ser GS*\
     IF(v_cod_mt='102') THEN
        v_mto_max_ach:=to_number(fug_obt_pardinamico('MTO_MAX_ACH'));
        IF v_cod_mon_local <> v_cod_mon_credito THEN
           pr_mensajeUsuario(MSG_ERR_CONVERS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                        v_bitacora_titulo || ' - ' ||
                                         fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                        BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
     END IF;
      \* SPPARPAT-2 Participante patrocinador (VAE) *\
     if v_modo = 'P' and v_cod_sub_tip_operacion = '004' then--no Se permite realizar transferencias de patrocinadores con fecha futura
       --generar error  COD_TRA_PROHIB
           v_retorno.nombreRespuesta      := 'FECHA_INVA';--v_retorno_men_res.nombreRespuesta;
           v_retorno.descripcionRespuesta := 'Fecha Invalida';--v_retorno_men_res.descripcionRespuesta;
           v_retorno.error                := 'S';--v_retorno_men_res.error;
           pr_insertarBitacora(userinfo.codigopersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                v_bitacora_titulo || ' - ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
     end if;
     \*fin SPPARPAT-2 Participante patrocinador (VAE)*\
     IF nvl(p_modo,'X') = 'A' THEN
        -- Valida la cuenta debito si puede realizar la operación
        v_retorno_men_res := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_mto_debito, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito,
                                               v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, userinfo, v_mensajeCaja);

        IF (v_retorno_men_res.error = 'S') THEN
           v_retorno.nombreRespuesta      := v_retorno_men_res.nombreRespuesta;
           v_retorno.descripcionRespuesta := v_retorno_men_res.descripcionRespuesta;
           v_retorno.error                := v_retorno_men_res.error;
           pr_insertarBitacora(userinfo.codigopersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                v_bitacora_titulo || ' - ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
     END IF;

     IF v_modo = 'S' THEN
          -- Consulta de Entidades Registradas.
        v_bancos := paw_gen.fu_obtenerBancos('S');
        v_lista_detalles_banco := v_bancos.listaDetalleBancos;

        IF(v_lista_detalles_banco is not null) THEN
          for i in 1..v_lista_detalles_banco.count
          LOOP
            v_can_detalle := v_can_detalle + 1;

            v_detalleConsultaEntes.codigoSwiftEntidadFinanciera := v_lista_detalles_banco(i).codigoSwift;
            v_detalleConsultaEntes.nombreEntidad := v_lista_detalles_banco(i).nombreEntidad;
            v_detalleConsultaEntes.codigoEntidad := v_lista_detalles_banco(i).codigoBanco;
            v_listaConsultaEntes.extend;
            v_listaConsultaEntes(v_listaConsultaEntes.count) := v_detalleConsultaEntes;
          END LOOP;
        END IF;

        IF v_listaConsultaEntes.Count > 0 THEN
           v_retorno.listaConsultaEntes := v_listaConsultaEntes;
        END IF;

        pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                           v_bitacora_titulo || ' - ' ||
                           fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
        RETURN v_retorno;

     ELSIF v_modo = 'T' THEN
        -- Datos de Tipos de Documentos
        v_tipos_documentos := paw_gen.fu_obtenerTiposDocumentos('TRA_INTERBANCARIA');
        v_listaConsultaDocumentos := v_tipos_documentos.listaTiposDocs;

        IF v_listaConsultaDocumentos IS NOT NULL AND v_listaConsultaDocumentos.Count > 0 THEN
           v_retorno.listaConsultaDocumentos := v_listaConsultaDocumentos;
        END IF;

        pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                            v_bitacora_titulo || ' - ' ||
                             fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
        RETURN v_retorno;

     ELSIF v_modo = 'D' THEN
        -- Datos de Transferencias anteriores
       v_cod_swift := depurarAlfanumerico(p_codigoSwift, 20); --trim(p_codigoSwift);
       v_nro_cta_credito := depurarAlfanumerico(p_numeroCuentaCredito, 20);
       BEGIN
          SELECT snp.nom_beneficiario, snp.dir_beneficiario, snp.nro_doc_beneficiario, snp.cod_tip_doc_beneficiario
            INTO v_nom_cliente, v_dir_cliente, v_nro_doc_cliente, v_tip_doc_beneficiario
            FROM (Select gs.nom_beneficiario, gs.dir_beneficiario, gs.nro_doc_beneficiario, gs.cod_tip_doc_beneficiario
                    from ge_snp_transferencias gs
                   where gs.cod_swi_pte_beneficiario = v_cod_swift
                     and gs.nro_cta_beneficiario = v_nro_cta_credito
                     and gs.cod_per_solicitante = v_cod_persona
                   order by gs.fec_insercion desc) snp
           WHERE rownum = 1;
       EXCEPTION
          WHEN OTHERS THEN
             pr_mensajeUsuario(MSG_CODCTA_NOEX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                 v_bitacora_titulo || ' - ' ||
                                 fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
             RETURN v_retorno;
       END;

       v_retorno.nombre := v_nom_cliente;
       v_retorno.direccion := v_dir_cliente;
       v_retorno.numeroDocumento := v_nro_doc_cliente;
       v_retorno.tipoDocumento := v_tip_doc_beneficiario;

       pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                          v_bitacora_titulo || ' - ' ||
                          fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
       RETURN v_retorno;
    ELSIF v_modo in ('V', 'C', 'A', 'P') THEN
       --se obtiene el nro prepactado en todos los modos.
       v_nro_contrato         := p_numeroContrato;
       IF v_modo <> 'A' THEN
         v_cargos               := substr(p_cargos, 1, 1);
         v_nro_cta_credito      := depurarAlfanumerico(p_numeroCuentaCredito, 20);
         v_cod_swift            := depurarAlfanumerico(p_codigoSwift, 20);
         v_nro_doc_credito      := depurarTextos(p_numeroDocumentoCredito, 20);
         v_nom_beneficiario     := depurarAlfanumerico(p_nombreBeneficiario, 100, 'S');
         v_dir_beneficiario     := depurarAlfanumerico(p_direccionBeneficiario, 100, 'S');
         v_concepto             := depurarAlfanumerico(p_concepto, 100, 'S');
         v_nro_ip               := p_numeroIp;
         v_tip_doc_beneficiario := p_tipoDocumentoBeneficiario;
       END IF;

        
             if ((v_nro_referencia IS NOT null AND v_modo in ('A')))   then
                 begin 
                   SELECT  v.val
                   into tipo_transferencia
                   FROM ( select 'SIPAP'  AS VAL
                          from ge_snp_transferencias gs
                          WHERE trunc(gs.nro_referencia) = trunc(v_nro_referencia)
                          UNION ALL  
                          select 'SPI' AS VAL
                          from ge_spi_transferencias gp
                          WHERE trunc(gp.nro_referencia) = trunc(v_nro_referencia)) v;
                  end; 
                  
                  IF (tipo_transferencia='SPI') THEN
                          select gpi.bic_receptor,gpi.nro_doc_receptor,gpi.nro_cta_receptor,gpi.cod_moneda,gpi.monto
                          into v_cod_swift,v_nro_doc_credito,v_nro_cta_credito,v_cod_mon_credito,v_mto_credito
                          from ge_spi_transferencias gpi
                          WHERE trunc(gpi.nro_referencia) = trunc(v_nro_referencia);  
                  END IF;
             end if;
          



       IF v_modo = 'A' THEN          
           if tipo_transferencia='SIPAP' then
                 SELECT t.nro_cta_solicitante, t.monto, t.fec_valor, substr(t.tip_cargo, 0, 1),
                       --traducir
                      t.nro_cta_beneficiario, t.cod_swi_pte_beneficiario, t.nro_doc_beneficiario,
                       --
                      t.nom_beneficiario, t.concepto, t.cod_msj_swift, t.cod_tip_doc_beneficiario
                 INTO v_nro_cta_debito, v_mto_credito, v_fec_operacion, v_cargos, v_nro_cta_credito, v_cod_swift, v_nro_doc_credito, v_nom_beneficiario,
                      v_concepto, v_cod_mt, v_tip_doc_beneficiario
                 FROM ge_snp_transferencias t
                 WHERE t.nro_referencia=v_nro_referencia;
           end if;             
       END IF;

       IF v_modo = 'V' AND p_tipoMensaje = 'T' AND (length(v_nro_cta_credito) <> 16 OR translate(v_nro_cta_credito, 'T 0123456789', 'T') IS NOT NULL) THEN
          pr_mensajeUsuario(MSG_OBT_TAR_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                               v_bitacora_titulo || ' - ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;

       -- Inicializa las Variables del PAS_SNP
       pas_snp.pr_ini_variables;
       pas_snp.pr_ini_registros;
       v_cta_pte_sol_bcp     :=  pas_snp.fu_obt_cta_ban_participante(pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad), v_cod_mon_credito);
       v_cta_pte_solicitante :=  pas_snp.fu_obt_cta_bancaria(v_cta_pte_sol_bcp ,'C');
       IF pas_snp.fu_obt_cod_error <> 0 THEN
          pr_mensajeUsuario(MSG_CTA_INT_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                              v_bitacora_titulo || ' - ' ||
                              fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;
       -- Verifica por seguridad que no se ingrese una cuenta que no sea del titular
       IF lf_val_cta_origen(v_nro_cta_debito, v_cod_persona) = 'N' THEN
          -- no es una cuenta del cliente
           pr_mensajeUsuario(MSG_CODCTA_NOEX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                               v_bitacora_titulo || ' - ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
       END IF;
       --obtiene la moneda
       v_msg_error := MSG_MONEDA_ER;
       --v_cod_mon_debito   := FUG_OBT_MON_CTA(v_nro_cta_debito);
       v_msg_error := MSG_ERROR;

       v_est_periodo := pas_snp.fu_obt_est_horario('103', '001', v_cod_sub_tip_ope103);
       if ((v_est_periodo = 'A') and
           (fug_den_per_act_snp('103','001',v_cod_sub_tip_ope103,v_cod_tra_padre,3) = 'S') and
           (v_cli_pue_enviar <> 'S')) then
            v_est_periodo := 'C';
       end if;

         
       IF v_spi_hab_pf='N' and  userinfo.codigoEmpresa is null then
             v_spi_detectado :='N';
       elsif v_spi_hab_pj='N' and  userinfo.codigoEmpresa is not null then     
             v_spi_detectado :='N';
       else 
             \*v_spi_detectado := fug_val_mx_spi( v_cod_swift, 
                                           v_nro_doc_credito,
                                           v_nro_cta_credito,
                                           v_cod_mon_credito,
                                           v_mto_credito,'E');*\
            null;
       end if;   
                                        
       -- moneda diferentes sin contrato de cambio
       if v_cod_mon_credito <> v_cod_mon_debito  then
          -- Verifica que no pueda realizar cambio de monedas en fecha distinta a la fecha actual
          if (v_spi_detectado='N' or tipo_transferencia='SIPAP')  then 
                if v_fec_operacion <> v_fec_actual then
                   pr_mensajeUsuario(MSG_FECHA_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                       '[fec_operacion <> fec_actual] - ' ||v_bitacora_titulo ||
                                       fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                   RETURN v_retorno;
                end if ;
                -- DDSI-9 Verifica que no pueda realizar cambio de monedas si el horario sipap esta cerrado.
                \*v_est_periodo := pas_snp.fu_obt_est_horario('103', '001', '002');
                if ((v_est_periodo = 'A') and
                    (fug_den_per_act_snp('103','001','002',v_cod_tra_padre,3) = 'S') and
                    (v_cli_pue_enviar <> 'S')) then
                     v_est_periodo := 'C';
                end if;*\
                if v_fec_operacion = v_fec_actual and v_est_periodo <> 'A'  then
                   pr_mensajeUsuario(MSG_HORA_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                         '[Horario sipap cerrado] - ' ||v_bitacora_titulo ||
                                         fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                   RETURN v_retorno;
                end if ;
           end if ;
          if nvl(v_nro_contrato,0) = 0 then
             BEGIN
                pr_con_mon_a_moneda(v_cod_mon_credito,
                                    v_cod_mon_debito,
                                    v_mto_credito,
                                    v_mto_debito,
                                    v_cot_credito,
                                    v_cot_debito,
                                    'S');
             EXCEPTION
                WHEN OTHERS THEN
                   pr_mensajeUsuario(MSG_ERR_CONVERS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                       v_bitacora_titulo || ' - ' ||
                                       fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                       BITACORA_ERROR);
                   RETURN v_retorno;
             END;
          else
             v_cod_respuesta := paw_bas.fu_val_contrato(v_cod_mon_debito, v_cod_mon_credito, v_nro_contrato, nvl(userinfo.codigoEmpresa, userinfo.codigoPersona), 47, v_nro_doc_credito,
                           v_nro_ope_cambio, v_mto_debito, v_mto_credito, v_cot_debito, v_cot_credito,
                           v_mto_equ_local, v_tip_operacion);
             v_bitacora_titulo := v_bitacora_titulo || ', mtoCon:' || v_mto_debito || ', mtoCreCon:'|| v_mto_credito;
             IF v_cod_respuesta = -1 THEN
                pr_mensajeUsuario(MSG_HORA_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_bitacora_titulo || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                RETURN v_retorno;
             ELSIF v_cod_respuesta <> 0 THEN
                pr_mensajeUsuario(MSG_CONCAM_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_bitacora_titulo || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                RETURN v_retorno;
             END IF;
          end if;
       else
          -- Se iguala el monto por que la Moneda Credito y Debito es igual
          v_mto_debito := v_mto_credito ;
          if nvl(v_nro_contrato, 0) > 0 then
             pr_mensajeUsuario(MSG_CONCAM_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                    v_bitacora_titulo || ' - ' ||
                                    fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
             RETURN v_retorno;
          end if;
       end if ;
       IF v_mto_credito <= 0 OR v_mto_debito <= 0 THEN
          pr_mensajeUsuario(MSG_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                              v_bitacora_titulo || ' - ' ||
                              fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;

       IF v_cod_mt = '102' AND v_mto_credito > v_mto_max_ach THEN
          pr_mensajeUsuario(MSG_MTO_MAX_ACH, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                              v_bitacora_titulo || ' - ' ||
                              fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;

       -- Valida la cuenta debito si puede realizar la operación
       v_retorno_men_res := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_mto_debito, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito,
                                              v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, userinfo, v_mensajeCaja);

         -- si es programado, no tener en cuenta error de saldo en la verificacion
         IF v_modo = 'P' AND v_retorno_men_res.nombreRespuesta = 'COD_SAL_INSUF' THEN
              v_retorno_men_res.error := 'N';
         END IF;
         IF (v_retorno_men_res.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_retorno_men_res.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_retorno_men_res.descripcionRespuesta;
            v_retorno.error                := v_retorno_men_res.error;
            pr_insertarBitacora(userinfo.codigopersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                v_bitacora_titulo || ' - ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;

         -- Valida la fecha ingresada
         IF (nvl(pas_snp.fu_val_fec_valor(v_fec_operacion), 1) <> 0 OR pag_cal.fu_obt_fec_habil(v_fec_operacion, 1, 1) <> v_fec_operacion)
           and (v_spi_detectado='N' or tipo_transferencia='SIPAP')  THEN
             pr_mensajeUsuario(MSG_FECHA_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                ', msg-snp:[' || substr(pas_snp.g_msj_error, 1, 200) || '] -** ' || v_bitacora_titulo ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
             RETURN v_retorno;
         end if ;

      IF ( v_spi_detectado ='N'  or  tipo_transferencia='SIPAP' )  then
         if v_cta_pte_sol_bcp is null then
             pr_mensajeUsuario(MSG_CTA_INT_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                v_bitacora_titulo || ' - ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
             RETURN v_retorno;
         else
            r_gtran.nro_cta_pte_beneficiario := pas_snp.fu_obt_cta_ban_participante(v_cod_swift, v_cod_mon_credito) ;
            if pas_snp.fu_obt_cod_error <> 0 then
               pr_mensajeUsuario(MSG_CTA_INT_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                  v_bitacora_titulo || ' - ' ||
                                   fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
               RETURN v_retorno;
            end if ;

            --Se Evalúa que no exista duplicaos
            r_gtran.fec_valor                := v_fec_operacion ;
            r_gtran.cod_msj_swift            := v_cod_mt;
            r_gtran.nro_cta_solicitante      := v_nro_cta_debito ;
            r_gtran.nro_cta_pte_solicitante  := v_cta_pte_sol_bcp ;
            r_gtran.nro_cta_beneficiario     := v_nro_cta_credito ;
            r_gtran.cod_swi_pte_beneficiario := v_cod_swift ;
            r_gtran.cod_moneda               := v_cod_mon_credito;
            r_gtran.monto                    := v_mto_credito ;

            if pas_snp.fu_ver_mov_duplicados(r_gtran) <> 0 then
               pr_mensajeUsuario(MSG_CODPED_DUPLI, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                   v_bitacora_titulo || ' - ' ||
                                   fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
               RETURN v_retorno;
            end if ;
         end if ;
       end if;
         -- si se autoriza desde EMA, puede ser una autorizacion multiple con mismo monto debito y cuenta,
         -- no es necesario controlar duplicado en ese caso porque hubo una validacion previa en la carga
         IF nvl(p_modo, 'x') <> 'A' OR fuw_obt_mov_pen_encolado(userinfo.codigoEmpresa, v_cod_operacion, v_nro_cta_debito, v_mto_debito, NULL, v_nro_referencia) <> 'S' THEN

            -- valido la duplicacion de transferencias
            v_retorno_men_res := lf_val_duplicacion(v_nro_cta_debito, v_mto_debito, v_nro_cta_credito, v_cod_tra_padre, userinfo, v_mensajeCaja,
                                                    v_cod_operacion);

         IF (v_retorno_men_res.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_retorno_men_res.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_retorno_men_res.descripcionRespuesta;
            v_retorno.error                := v_retorno_men_res.error;
            pr_insertarBitacora(userinfo.codigopersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                v_bitacora_titulo || ' - ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
         END IF;
         -- se agrega control de límite de operaciones
         IF v_modo <> 'P' THEN -- si no es programada

            v_resLimite := fu_obtenerLimite(userinfo, v_cod_operacion, nvl(userinfo.codigoEmpresa, userinfo.codigoPersona), v_nro_cta_debito, v_cod_mon_debito,
                                            503, v_cod_tra_padre, v_mto_debito, v_modo);

            IF v_resLimite.error = 'S' THEN
               v_retorno.error := v_resLimite.error;
               v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
               pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                               v_bitacora_titulo || ' - ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
         END IF;

         -- se verifica la clave transaccional y/o token segun informe de fu_obt_limite
         if v_modo NOT IN ('V', 'P') then
             v_retorno_men_res.error := 'N';
             DECLARE
                v_lugar VARCHAR2(50);
             BEGIN
              IF v_resLimite.codRespuesta IN ('10', '11') AND nvl(p_modo, 'X') <> 'A' THEN
                 -- clave transaccional requerida
                   v_lugar  := 'lf_obt_cla_validar: ';
                   v_retorno_men_res := lf_obt_cla_validar(p_claveTransaccional, userinfo.codigoPersona, userinfo.codigoEmpresa,'T');
                END IF;

                IF v_retorno_men_res.error = 'N' THEN
                 IF v_resLimite.codRespuesta IN ('01', '11') AND nvl(p_modo, 'X') <> 'A' THEN
                    -- token requerido
                      v_lugar  := 'paw_seg.fu_obt_tok_validar: ';
                      v_retorno_men_res := paw_seg.fu_obt_tok_validar(p_claveToken, userinfo.codigoPersona, userinfo.codigoEmpresa,'K');
                   END IF;
                END IF;

                IF v_retorno_men_res.error = 'S' THEN
                   v_retorno.error := v_retorno_men_res.error;
                   v_retorno.nombreRespuesta := v_retorno_men_res.nombreRespuesta;
                   v_retorno.descripcionRespuesta := v_retorno_men_res.descripcionRespuesta;
                   pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                     v_lugar || v_bitacora_titulo || ' - ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                   RETURN v_retorno;
                END IF;
             END;
         end if;

         if v_modo IN ('V', 'P') then
            -- Si esta todo correcto arma el mensaje de respuesta
             v_retorno.fechaOperacion := to_char(v_fec_operacion, 'ddmmyyyy');
             v_retorno.numeroCuentaDebito := v_nro_cta_debito;
             v_retorno.nombreCuentaDebito := v_nom_cta_debito;
             v_retorno.monedaCuentaDebito := v_cod_mon_debito;
             v_retorno.montoDebito := v_mto_debito;
             v_retorno.numeroCuentaCredito := v_nro_cta_credito;
             v_retorno.nombre := v_nom_beneficiario;
             v_retorno.swiftEntidadCredito := v_cod_swift;
             v_retorno.nombreEntidadCredito := substr(pas_snp.fu_obt_des_participante(v_cod_swift), 1, 100);
             v_retorno.monedaCuentaCredito := v_cod_mon_credito;
             v_retorno.montoCredito := v_mto_credito;
             v_retorno.cotizacion := v_cot_debito;
             v_retorno.cotizacionCredito := v_cot_credito;
             v_retorno.prioridad := v_prioridad;
             v_retorno.respuestaLimite := v_resLimite.codRespuesta;
             v_bitacora_titulo := v_bitacora_titulo || ', resLim:' || v_retorno.respuestaLimite;

             pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                               v_bitacora_titulo || ' - ' ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
             return v_retorno;

         elsif v_modo in ('C', 'A') then
            if v_cargos = 'O' then
               v_tip_cargos := 'OUR';
            elsif v_cargos = 'B' then
               v_tip_cargos := 'BEN';
            else
               v_tip_cargos := 'SHA';
            end if ;

           -- Se graba la operacion como solicitado y pendiente de autorización
           IF v_modo = 'C' THEN
              v_nro_referencia                 := pas_snp.fu_obt_sig_nro_referencia(v_fec_actual) ;
           END IF;
           r_gtran.nro_referencia           := v_nro_referencia ;
           r_gtran.cod_modulo               := 4 ;
           r_gtran.cod_modalidad            := 455 ;
           r_gtran.cod_oficina              := v_cod_ofi_debito ;
           r_gtran.cod_tip_operacion        := v_cod_tip_operacion;
           r_gtran.cod_sub_tip_operacion    := v_cod_sub_tip_operacion;
           r_gtran.fec_ingreso              := v_fec_actual ;
           r_gtran.cod_per_solicitante      := v_cod_persona;
           r_gtran.nom_solicitante          := fue_obt_nom_persona(v_cod_persona) ;
           r_gtran.dir_solicitante          := fue_obt_dir_principa(v_cod_persona) ;
           r_gtran.cod_tip_doc_solicitante  := fue_obt_doc_principal(v_cod_persona) ;
           r_gtran.nro_doc_solicitante      := fue_obt_nro_doc_persona(v_cod_persona) ;
           r_gtran.cod_swi_pte_solicitante  := pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad);
           r_gtran.nom_beneficiario         := v_nom_beneficiario ;
           r_gtran.dir_beneficiario         := v_dir_beneficiario ;
           r_gtran.cod_tip_doc_beneficiario := v_tip_doc_beneficiario ;
           r_gtran.nro_doc_beneficiario     := v_nro_doc_credito ;
           r_gtran.nro_cta_pte_beneficiario := pas_snp.fu_obt_cta_ban_participante(v_cod_swift, v_cod_mon_credito) ;
           r_gtran.observacion              := v_concepto ;
           r_gtran.tip_cargo                := v_tip_cargos ;
           r_gtran.cod_msj_swift            := v_cod_mt;
           --r_gtran.cod_swi_pte_intermediario := v_cod_swi_patrocinador;
           IF v_prioridad = 'A' THEN
             r_gtran.ind_valor                := 'S'; --N
             r_gtran.prioridad                := 20 ; --100
           ELSE
             r_gtran.ind_valor                := 'N';
             r_gtran.prioridad                := 100 ;
           END IF;

           r_gtran.situacion                := 'P' ; -- Pendiente de Envio a BCP
           r_gtran.estado                   := 'S' ; -- Solicitado
          -- r_gtran.tip_canal                := fug_obt_pardinamico('TIP_CANAL') ;
           r_gtran.nro_operacion            := v_nro_referencia ;
           r_gtran.tip_mensaje              := 'CRED' ;
           r_gtran.ben_dir_correo           := NULL;
           r_gtran.cod_tra_padre            := v_cod_tra_padre;
           IF v_modo = 'C' then
              r_gtran.fec_valor := paw_bas.fu_obt_snp_fec_acreditacion(v_cod_mt, r_gtran.cod_moneda);
              if v_sig_fec_hab_patrocinador is not null and v_cod_sub_tip_operacion = '004' then
                r_gtran.fec_valor := v_sig_fec_hab_patrocinador;
              end if;
                     
                      if (v_spi_detectado ='S') then              
                                begin          
                                      --v_nro_referencia :=  pas_spi.fu_obt_sig_nro_referencia(v_fec_actual);  
                                      r_gtranspi.NRO_REFERENCIA     := v_nro_referencia;      
                                      r_gtranspi.COD_MONEDA         := 'GS'; 
                                      r_gtranspi.MONTO              := v_mto_credito;
                                      --r_gtranspi.COD_TRA_PADRE      := v_cod_tra_padre;
                                      r_gtranspi.COD_OFICINA        := v_cod_ofi_debito;
                                      r_gtranspi.COD_MODULO         := 4;
                                      r_gtranspi.cod_modalidad      := 455;
                                     -- r_gtranspi.COD_MX             := 'PACS.008'; 
                                      r_gtranspi.TIP_OPERACION      := 'A';              
                                      r_gtranspi.NOM_CLI_ORIGEN     := fue_obt_nom_persona(v_cod_persona);
                                      if userinfo.codigoEmpresa is null then
                                          r_gtranspi.TIP_DOC_ORIGEN     := 'CI';
                                      else     
                                          r_gtranspi.TIP_DOC_ORIGEN     := 'RUC'; 
                                      end if;    
                                      r_gtranspi.NRO_DOC_ORIGEN     := fue_obt_nro_doc_persona(v_cod_persona);
                                      r_gtranspi.NRO_CTA_ORIGEN     := v_nro_cta_debito;
                                      r_gtranspi.BIC_ORIGEN         := pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad);
                                      r_gtranspi.COD_PER_ORIGEN     := v_cod_persona;
                                      r_gtranspi.NOM_CLI_RECEPTOR   := v_nom_beneficiario;
                                      
                                      begin
                                          select b.abreviatura
                                          into v_tipo_doc
                                          from ba_tip_documentos b
                                          where  b.cod_tip_documento=p_tipoDocumentoBeneficiario;
                                      exception when no_data_found then
                                            v_tipo_doc:='CI';
                                      end;    
                                          

                                      r_gtranspi.TIP_DOC_RECEPTOR   := v_tipo_doc;
                                      r_gtranspi.NRO_DOC_RECEPTOR   := v_nro_doc_credito;
                                      r_gtranspi.NRO_CTA_RECEPTOR   := v_nro_cta_credito;
                                      r_gtranspi.BIC_RECEPTOR       := v_cod_swift;    
                                      r_gtranspi.ESTADO             := 'P';  
                                      r_gtranspi.ORIGEN             := 'H';
                                      r_gtranspi.FEC_VALOR          := trunc(sysdate);
                                      r_gtranspi.FEC_RECEPCION      := null;
                                      r_gtranspi.FECHA              := null;
                                      r_gtranspi.HORA               := null; 
                                      r_gtranspi.COD_USUARIO        := null; 
                                      r_gtranspi.COD_MON_ORIGEN     := v_cod_mon_debito;
                                      r_gtranspi.MTO_ORIGEN         := v_mto_debito;
                                      if v_cot_debito is null or v_cot_debito='' then
                                         r_gtranspi.TIP_CAMBIO         := 1;
                                      else
                                         r_gtranspi.TIP_CAMBIO         := v_cot_debito;
                                      end if;
                                      v_cta_pte_solicitante := pas_spi.fu_obt_cta_bancaria(pas_spi.fu_obt_cta_ban_participante(p_cod_moneda => 'GS'),'X');
                                     
                                
                                           v_retorno.fechaOperacion := trunc(sysdate);
                                           v_retorno.numeroCuentaDebito := v_nro_cta_debito;
                                           v_retorno.nombreCuentaDebito := v_nom_cta_debito;
                                           v_retorno.monedaCuentaDebito := v_cod_mon_debito;
                                           v_retorno.montoDebito := v_mto_debito;
                                           v_retorno.numeroCuentaCredito := v_nro_cta_credito;
                                           v_retorno.nombre := v_nom_beneficiario;
                                           v_retorno.swiftEntidadCredito := v_cod_swift;
                                           v_retorno.nombreEntidadCredito := substr(pas_snp.fu_obt_des_participante(v_cod_swift), 1, 100);
                                           v_retorno.monedaCuentaCredito := v_cod_mon_credito;
                                           v_retorno.montoCredito := v_mto_credito;
                                           v_retorno.cotizacion := v_cot_debito;
                                           v_retorno.cotizacionCredito := v_cot_credito;
                                           v_retorno.prioridad := v_prioridad;
                                           v_retorno.respuestaLimite := v_resLimite.codRespuesta;
                                           v_bitacora_titulo := v_bitacora_titulo || ', resLim:' || v_retorno.respuestaLimite;
                                           v_retorno.numeroReferencia:=v_nro_referencia;
                                           
                                           SELECT s_nro_ope_homebanking.nextval
                                           INTO v_nro_documento
                                           FROM dual;
                                           v_retorno.numeroDocumento := v_nro_documento;
                                

                                if   pas_spi.fu_val_spi_transferencias(r_gtranspi,v_existe_transaccion)='N' then
                                      pas_spi.pr_ins_transferencias(r_gtranspi,P_RESULT,P_DET_ERROR); 
                                else
                                      pr_mensajeUsuario(MSG_MOV_INGRESADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                      pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                                          v_bitacora_titulo || ', pr_INS_transferencias_spi err : [' || substr(pas_snp.g_msj_error, 1, 200) || '] ' ||
                                                          fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta || ' DET : '|| P_DET_ERROR, NULL), BITACORA_ERROR);
                                      RETURN v_retorno;
                                end if;      
                                      

                                      if P_RESULT = 'OK' then
                                        
                                          IF v_can_aut_requeridas = 0 THEN   
                                                 pas_spi.pr_pro_transferencias(r_gtranspi,P_RESULT_PRO,P_DET_ERROR_PRO);
                                           else
                                                 P_RESULT_PRO:='OK';      
                                           END IF ;

                                        

                                           pr_insertarBitacora(userinfo.codigoPersona,p_codigoCanal, p_sesion, v_cod_operacion,  userinfo.codigoEmpresa,
                                           ' XAIX   RESPUESTA --> P_RESULT = '|| P_RESULT_PRO || ' ||  --> P_DET_ERROR = ' || P_DET_ERROR_PRO
                                           || ' NRO_REFERENCIA '|| v_nro_referencia
                                           , bitacora_error); 
                                           
                                           IF v_can_aut_requeridas = 0 THEN
                                                if P_RESULT_PRO is null or  P_RESULT_PRO =' '  then
                                                         pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                                         pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                                         v_bitacora_titulo || ', pr_INS_transferencias_spi err : [' || substr(pas_snp.g_msj_error, 1, 200) || '] ' ||
                                                                 fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta || ' DET : '|| P_DET_ERROR, NULL), BITACORA_ERROR);
                                                         RETURN v_retorno;
                                                
                                                elsif P_RESULT_PRO = 'OK' then

                                                          if v_spi_hab_corr_ok='S' then  
                                                                pas_spi.pr_notif_spi(r_gtranspi,'C',P_DET_ERROR_PRO);       
                                                          end if;    
                                                         
                                                          pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                                          pr_insertarbitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                                                          v_bitacora_titulo || ' - ' || SQLERRM, bitacora_error);
                                                                 
                                                         RETURN  v_retorno;
                                                else      

                                                          if v_spi_hab_corr_fail='S' then    
                                                               pas_spi.pr_notif_spi(r_gtranspi,'R',P_DET_ERROR_PRO);     
                                                          end if;    
                                                         pr_mensajeUsuario(P_DET_ERROR_PRO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                                         pr_insertarbitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                                                          v_bitacora_titulo || ' - ' || SQLERRM, bitacora_error);
                                                         RETURN v_retorno;      
                                                end if;
                                           end if;
                                      else

                                           pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                           pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                                                 v_bitacora_titulo || ', pr_INS_transferencias_spi err : [' || substr(pas_snp.g_msj_error, 1, 200) || '] ' ||
                                                                 fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta || ' DET : '|| P_DET_ERROR, NULL), BITACORA_ERROR);
                                           RETURN v_retorno;
                                      end if;     
                                  end;                                               
                   else
                        pas_snp.pr_ins_transferencias(r_gtran) ;             
                        if nvl(pas_snp.fu_obt_cod_error,1) <> 0 then
                           pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                               v_bitacora_titulo || ', pr_ins_transferencias : [' || substr(pas_snp.g_msj_error, 1, 200) || '] ' ||
                                               fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                           RETURN v_retorno;
                        end if ;
                   end if;   
              
                
              
              
           END IF;
           -- Se confirma directamente la operacion, porque no requiere autorizacion
           IF v_can_aut_requeridas = 0 THEN
              v_modo := 'A'; -- CONFIRMACION
           END IF ;
         END IF;

         -- Se genera la grabación pendiente de Autorización
        IF v_modo = 'C' THEN
           -- grabacion en pendiente
           IF v_cod_mon_debito <> v_cod_mon_credito THEN
              IF v_cod_mon_debito <> v_cod_mon_local THEN
                 IF v_cod_mon_credito = v_cod_mon_local THEN
                    v_mto_equ_local := nvl(v_mto_credito, 0);
                 ELSE
                    v_mto_equ_local := round(nvl(v_mto_credito, 0) * nvl(v_cot_credito, 0), 0);
                 END IF;
              ELSE
                 v_mto_equ_local := nvl(v_mto_debito, 0) ;
              END IF;
           END IF;
           --- inserto el movimiento pendiente de autorizacion
           SELECT s_nro_documento.nextval
             INTO v_nro_documento
             FROM dual;
           INSERT INTO bw_mov_pendientes
              (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cotizacion, mto_equ_local,
               nro_cta_contra, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra, cot_contra, etiqueta, dato, etiqueta2, dato2,
               referencia, Tip_Pago)
             VALUES
              (v_nro_documento, v_cod_persona, SYSDATE, '036', v_nro_cta_debito, v_cod_mon_debito, v_concepto, v_mto_debito, v_cot_debito, v_mto_equ_local,
               v_cta_pte_solicitante, 'P', v_can_aut_requeridas, v_can_aut_requeridas, userinfo.codigoPersona, v_mto_credito, v_cot_credito,
               'nro.cta.cred*mon.cred*nro.prepactado', v_nro_cta_credito || '*' || v_cod_mon_credito || '*' || nvl(v_nro_contrato, 0), 'Fecha Valor', to_char(v_fec_operacion, 'DD/MM/YYYY'),
               v_nro_referencia, v_prioridad);

          v_retorno.numeroDocumento := v_nro_documento;
          v_retorno.cantidadAutorizacion := v_can_aut_requeridas;
       END IF;
    END IF;

    v_est_periodo := pas_snp.fu_obt_est_horario(103,'001','002');
    if ((v_est_periodo = 'A') and
        (fug_den_per_act_snp('103','001','002',v_cod_tra_padre,3) = 'S') and
        (v_cli_pue_enviar <> 'S')) then
        v_est_periodo := 'C';
    end if;

    -- Valida que este abierto el periodo si es de fecha actual
    IF trunc(v_fec_operacion) = trunc(v_fec_actual) THEN
       pas_snp.pr_ini_variables ;

      \*v_est_periodo := pas_snp.fu_obt_est_horario(103,'001','002');
      if ((v_est_periodo = 'A') and
          (fug_den_per_act_snp('103','001','002',v_cod_tra_padre,3) = 'S') and
          (v_cli_pue_enviar <> 'S')) then
          v_est_periodo := 'C';
      end if; *\
      IF v_est_periodo = 'C' THEN
          v_fec_operacion := pag_cal.FU_OBT_FEC_HABIL(v_fec_operacion+1,1,1) ;
       ELSIF v_est_periodo NOT IN ('C', 'A') and v_spi_detectado='N'  THEN
          pr_mensajeUsuario(MSG_FECHA_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                               r_gtran.cod_msj_swift||','|| r_gtran.cod_tip_operacion||','|| r_gtran.cod_sub_tip_operacion||','|| v_est_periodo|| ': estado invalido - ' ||v_bitacora_titulo ||
                                fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;
    END IF;
    \*SPPARPAT-2 Participante patrocinador (VAE)*\
     v_cod_swi_patrocinador := pas_snp.fu_obt_par_patrocinador(v_cod_swift);
     --VErifica si es un swift de un participante patricinado
     IF v_cod_swi_patrocinador is not null then
        v_cod_sub_tip_ope103 := '004';
     ELSE
        v_cod_sub_tip_ope103 :='002';
     END IF;
     
    if v_modo = 'A' then                 
         if  tipo_transferencia='SPI'  THEN
           if p_codigoCanal=999 then
         
             v_retorno.fechaOperacion := to_char(v_fec_operacion, 'ddmmyyyy');
             v_retorno.numeroCuentaDebito := v_nro_cta_debito;
             v_retorno.nombreCuentaDebito := v_nom_cta_debito;
             v_retorno.monedaCuentaDebito := v_cod_mon_debito;
             v_retorno.montoDebito := v_mto_debito;
             v_retorno.numeroCuentaCredito := v_nro_cta_credito;
             v_retorno.nombre := v_nom_beneficiario;
             v_retorno.swiftEntidadCredito := v_cod_swift;
             v_retorno.nombreEntidadCredito := substr(pas_snp.fu_obt_des_participante(v_cod_swift), 1, 100);
             v_retorno.monedaCuentaCredito := v_cod_mon_credito;
             v_retorno.montoCredito := v_mto_credito;
             v_retorno.cotizacion := v_cot_debito;
             v_retorno.cotizacionCredito := v_cot_credito;
             v_retorno.prioridad := v_prioridad;
             v_retorno.respuestaLimite := v_resLimite.codRespuesta;
             v_bitacora_titulo := v_bitacora_titulo || ', resLim:' || v_retorno.respuestaLimite;
             v_retorno.numeroReferencia:=v_nro_referencia;
             
             v_resul_spi:=pas_spi.fu_envio_spi(v_nro_referencia,v_cod_persona,v_nro_documento,p_codigoCanal);
             
             if v_resul_spi='OK' then
                   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);   
             else
                   pr_mensajeUsuario(v_resul_spi, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             end if;           
             RETURN v_retorno;
        
        end if;
   ELSE
       IF v_prioridad = 'A' THEN
          -- Genera el Mensaje Swift
           v_msj_swift := pas_snp.fu_obt_msj_mt103(v_nro_referencia, 'N') ;
           -- Actualiza el Estado y le agrega el Mensaje Swift generado

           UPDATE ge_snp_transferencias gt
              SET gt.msj_swift = v_msj_swift, gt.estado = 'A'
            WHERE gt.nro_referencia = v_nro_referencia
              AND gt.cod_msj_swift = v_cod_mt;

           IF SQL%NOTFOUND THEN
              pr_mensajeUsuario(MSG_REFTRAEX_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                      v_bitacora_titulo || ' - ' ||
                                       fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
              RETURN v_retorno;
           END IF;
       ELSE
         if v_cod_mt = 102 then
            UPDATE ge_snp_transferencias gt
               SET gt.estado = 'A'
             WHERE gt.nro_referencia = v_nro_referencia
               AND gt.cod_msj_swift = v_cod_mt;
         else -- si se registro con 103 y se esta aprobando despues de cierre ya es un 102, actualizamos los datos...
           
           if v_cod_sub_tip_ope103 = '004' then   \*SPPARPAT-2 Participante patrocinador (VAE)*\
             UPDATE ge_snp_transferencias gt
                SET gt.estado               = 'A'
              WHERE gt.nro_referencia = v_nro_referencia
                AND gt.cod_msj_swift = v_cod_mt;
           ELSE
             UPDATE ge_snp_transferencias gt
               SET gt.estado               = 'A',
                   gt.cod_msj_swift        = 102,
                   gt.cod_tip_operacion    = '011',
                   gt.cod_sub_tip_operacion= '001',
                   gt.ind_valor            = 'N',
                   gt.prioridad            = 100
             WHERE gt.nro_referencia = v_nro_referencia
               AND gt.cod_msj_swift = v_cod_mt;     
           END IF;    
         end if;
       END IF;
        -- Genera el Movimiento y envia el mensaje a BCP si la fecha es actual y esta activo
        IF v_est_periodo = 'A' and
           v_prioridad = 'A' and
           r_gtran.cod_msj_swift = 103 THEN
           -- se retornara la transaccion a ser utilizada para la generacion del movimiento.
           pas_snp.pr_obt_par_mensajes(v_cod_mt,
                                        -- Tipo MT
                                       v_cod_tip_operacion,
                                        -- Tipo de Operación
                                       v_cod_sub_tip_operacion,
                                        -- Sub-Tipo de Operación
                                       'E',
                                        -- Transferencia Enviada
                                       v_cod_mod_padre, v_cod_mad_padre, v_cod_tra_credito, v_cod_tra_padre);  -- CNFPRSIP-217 --
           IF v_cod_mon_debito <> v_cod_mon_credito THEN
              IF v_cod_mon_debito <> v_cod_mon_local THEN
                 IF v_cod_mon_credito = v_cod_mon_local THEN
                    v_mto_equ_local := v_mto_credito;
                 ELSE
                    v_mto_equ_local := round(v_mto_debito * v_cot_debito, 0);
                 END IF;
              ELSE
                 v_mto_equ_local := NULL;
              END IF;
           END IF;
           pag_cta.PR_SET_VARIABLES(v_mensajeCaja.codigoUsuario, v_fec_valor, v_cod_tra_padre, 'N', 'N', v_nro_secuencia);
           pag_cta.PR_SET_NRO_DOCUMENTO3(NULL);
             -- Registrar movimientos de Debito al CLIENTE
           pag_cta.pr_set_cod_rubro(null,null);
           -- DDSI-265 -- 02/2018 : Se busca una hora disponible
           v_hor_actual := fug_obt_hor_disponible(v_fec_actual, v_hor_actual, user, 'N');
           prg_ver_mod_horario;
           pag_cta.pr_act_operacion(v_nro_cta_debito,
                                     -- Nro.Cta.
                                    v_hor_actual,
                                     -- Hora
                                    'D',
                                     -- Tip.Mov.
                                    v_cod_mon_debito,
                                     -- Cod.Mon.
                                    v_mto_debito,
                                     -- Monto
                                    v_cod_tra_padre,
                                     -- Trx.Padre
                                    v_cod_tra_debito,
                                     -- Trx.Hija
                                    v_nro_referencia,
                                     -- Nro.Doc.
                                    v_cot_debito,
                                     -- Cotizacion
                                    v_cod_ofi_debito,
                                     -- Ofic.Orig.
                                    v_cod_mod_padre,
                                     -- Mod.Pad.Cliente
                                    v_cod_mad_padre,
                                     -- Mad.Pad.Cliente
                                    NULL,
                                     -- Cod.Tasa
                                    NULL,
                                     -- Val.Tasa
                                    nvl(v_concepto, 'HB-SNP-Transf.Cta. ' || v_cta_pte_solicitante),
                                     -- Concepto
                                    'S',
                                     -- Emit.Aviso
                                    v_nro_secuencia, v_fec_actual, NULL,
                                     -- Cod_Banco
                                    NULL,
                                     -- Cod_Causa
                                      v_mto_equ_local );
             IF nvl(pag_cta.fu_obt_cod_error,1) <> 0 THEN
                pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                  v_bitacora_titulo || ', debito : [' || substr(pag_cta.G_MSJ_ERROR, 1, 100) || '] ' ||
                                   fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                RETURN v_retorno;
             ELSE
                IF v_cod_mon_debito <> v_cod_mon_credito THEN
                   IF v_cod_mon_credito <> v_cod_mon_local THEN
                      IF v_cod_mon_debito = v_cod_mon_local THEN
                         v_mto_equ_local := v_mto_debito;
                      ELSE
                         v_mto_equ_local := round(v_mto_credito * v_cot_credito, 0);
                      END IF;
                   ELSE
                      v_mto_equ_local := NULL;
                   END IF;
                END IF;
                v_tip_movimiento := pas_snp.fu_obt_tip_mov_transaccion(v_cod_mod_padre,v_cod_mad_padre,v_cod_tra_credito) ;
                IF nvl(pas_snp.fu_obt_cod_error,1) <> 0 THEN
                   pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                     v_bitacora_titulo || ', fu_obt_tip_mov_transaccion : [' || substr(pas_snp.g_msj_error, 1, 100) || '] ' ||
                                      fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                   RETURN v_retorno;
                ELSE
                   -- Setea el Tipo de Movimiento del Rubro para SNP
                   pag_cta.pr_set_cod_rubro(pac_che.fu_obt_rub_cta_ban(v_cta_pte_solicitante), v_tip_movimiento);
                   -- Setea la Referencia del Movimiento para SNP
                   pag_cta.pr_set_referencia(v_cod_swift) ;
                   -- Registrar movimientos a la Cta. Interbancaria
                   prg_ver_mod_horario;
                   pag_cta.pr_act_operacion(v_cta_pte_solicitante,
                                            -- Nro.Cta.
                                            v_hor_actual,
                                            -- Hora
                                            v_tip_movimiento,
                                            -- Tip.Mov.
                                            v_cod_mon_credito,
                                            -- Cod.Mon.
                                            v_mto_credito,
                                            -- Monto
                                            v_cod_tra_padre,
                                            -- Trx.Padre
                                            v_cod_tra_credito,
                                            -- Trx.Hija
                                            v_nro_referencia,
                                            -- Nro.Doc.
                                            v_cot_credito,
                                            -- Cotizacion
                                            v_cod_ofi_debito,
                                            -- Ofic.Orig.
                                            v_cod_mod_padre,
                                            -- Mod.Pad.Cliente
                                            v_cod_mad_padre,
                                            -- Mad.Pad.Cliente
                                            NULL,
                                            -- Cod.Tasa
                                            NULL,
                                            -- Val.Tasa
                                            nvl(v_concepto, 'HB-SNP-Transf.Cta. ' || v_nro_cta_debito),
                                            -- Concepto
                                            'S',
                                            -- Emit.Aviso
                                            v_nro_secuencia, v_fec_actual, NULL,
                                            -- Cod_Banco
                                            NULL,
                                            -- Cod_Causa
                                            v_mto_equ_local );

                   --DYDMR-5272  Nov/2016
                   pag_cta.pr_set_cod_rubro(null, null);
                   pag_cta.pr_set_referencia(null);

                   if pag_cta.fu_obt_cod_error = 0 then
                      pas_snp.pr_gen_mov_cargo(r_gtran, v_nro_cta_debito, v_cta_pte_solicitante, v_mto_credito, v_hor_actual, v_nro_secuencia, 'W');
                   end if;

                   IF nvl(pag_cta.fu_obt_cod_error,1) <> 0 THEN
                     pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                        v_bitacora_titulo || ', pr_act_operacion(' || v_tip_movimiento || ') : [' || substr(pag_cta.G_MSJ_ERROR, 1, 100) || '] ' ||
                                         fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                        BITACORA_ERROR);
                     RETURN v_retorno;
                   ELSE
                      BEGIN
                         -- Actualiza la Transferencia
                         UPDATE ge_snp_transferencias gt
                            SET gt.fecha = v_fec_actual, gt.hora = v_hor_actual, gt.cod_usuario = v_mensajeCaja.codigoUsuario
                          WHERE gt.nro_referencia = v_nro_referencia
                            AND gt.cod_msj_swift = v_cod_mt;

                         IF SQL%NOTFOUND THEN
                            pr_mensajeUsuario(MSG_CONFSNP_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                            pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                                              v_bitacora_titulo || ' - ' ||
                                               fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                              BITACORA_ERROR);
                            RETURN v_retorno;
                         END IF;
                      END;
                      -- cambio el estado del contrato de cambio
                      IF nvl(v_nro_contrato,0) <> 0 THEN
                         paw_bas.pr_liq_ope_cambio(v_mensajeCaja.codigoUsuario, v_nro_cta_debito, v_mto_debito, v_cod_mon_debito, v_cod_mon_credito, v_nro_ope_cambio);
                      END IF;
                      --GENERAR MOVIMIENTO DE POSICIÓN DE CAMBIOS
                      paw_bel.pr_act_mov_ope_cambios(v_hor_actual, v_nro_referencia, v_cod_mon_debito, v_cod_mon_credito, v_mensajeCaja.codigoUsuario);
                   END IF;
                END IF;
             END IF;
          END IF;

          -- Si esta todo OK envia la transferencia al Socket
        IF v_est_periodo = 'A' THEN
             commit ; -- Commitea antes de intentar enviar al socket
             pas_snp.pr_gen_arc_swift(v_nro_referencia, 'N') ;
            \* if nvl(pas_snp.g_cod_error,0) <> 0 then
                pr_mensajeUsuario(MSG_SOKBCP_ER, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_bitacora_titulo || ' - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                RETURN v_retorno;
             end if ;*\
          end if ;
    end if ;
end if ;
    -- registro del movimiento

     SELECT s_nro_ope_homebanking.nextval
       INTO v_nro_documento
       FROM dual;

    IF nvl(p_modo, 'X') <> 'A' THEN

      -- Responde para el modo 'C'
      v_retorno.fechaOperacion := to_char(v_fec_operacion, 'ddmmyyyy');
      v_retorno.numeroCuentaDebito := v_nro_cta_debito;
      v_retorno.nombreCuentaDebito := v_nom_cta_debito;
      v_retorno.monedaCuentaDebito := v_cod_mon_debito;
      v_retorno.montoDebito := v_mto_debito;
      v_retorno.numeroCuentaCredito := v_nro_cta_credito;
      v_retorno.nombreCuentaCredito := v_nom_beneficiario;
      v_retorno.swiftEntidadCredito := v_cod_swift;
      v_retorno.nombreEntidadCredito := pas_snp.fu_obt_des_participante(v_cod_swift);
      v_retorno.monedaCuentaCredito := v_cod_mon_credito;
      --v_retorno.monedaCredito := v_cod_mon_credito; -- duplicado, eliminar si se corrige el AT
      v_retorno.montoCredito := v_mto_credito;
      v_retorno.cotizacion := v_cot_debito;
      v_retorno.cotizacionCredito := v_cot_credito;
      v_retorno.prioridad        := v_prioridad;
      v_retorno.numeroReferencia := v_nro_referencia;
    end if ;
    IF nvl(v_modo, 'X') = 'A' THEN
       v_retorno.numeroDocumento := v_nro_documento;
    END IF;
    
    if tipo_transferencia='SIPAP' THEN
              lp_reg_operacion(v_nro_cta_debito \*p_nro_cuenta*\, v_cod_mon_debito \*p_cod_moneda *\, v_mto_debito \*p_monto*\, NULL \*p_nro_cta_contra*\, NULL,
                      'Entidad_Destino', v_cod_swift, 'Cta. Destino', v_nro_cta_credito, v_concepto, v_nro_ip, NULL \*p_cod_respuesta*\
                       \*v_modo || '-' || v_can_aut_requeridas*\, userinfo.codigoPersona, v_cod_operacion, v_nro_documento, p_codigoCanal, p_sesion,
                      userinfo.codigoEmpresa, NULL, 'Nro. referencia', to_char(v_nro_referencia));
    END IF;  
   -- no se responde nada, solo se debe setear el v_cod_respuesta
     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                         v_bitacora_titulo || ', nroIp: ' || v_nro_ip || ', ' ||
                          fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
     RETURN v_retorno;

*/
return null;
    EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeusuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarbitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa,
                            v_bitacora_titulo || ' - ' || SQLERRM, bitacora_error);

         RETURN v_retorno;
  END;


   /**
   * Consulta de Transferencia Interbancaria SNP
   * @Creado por: Fermín Giménez
   * @Fecha : 05-02-2013
   */
   FUNCTION fu_consultarTransferenciaSnp
                    (
                       p_sesion           IN VARCHAR2,
                       p_codigoCanal      IN VARCHAR2,
                       p_fechaDesde       IN DATE,
                       p_fechaHasta       IN DATE,
                       p_numeroPagina     IN NUMBER,
                       p_transaccion      IN NUMBER DEFAULT NULL,
                       p_numeroCuenta     IN VARCHAR2 DEFAULT NULL,
                       p_montoDesde       IN NUMBER DEFAULT NULL,
                       p_montoHasta       IN NUMBER DEFAULT NULL
                    ) RETURN typ_consultarTransferenciaSnp IS

     v_cod_operacion      VARCHAR2(3) := '037';
     v_retorno            typ_consultarTransferenciaSnp := typ_consultarTransferenciaSnp;
     v_detalleConsultaSnp typ_detalleConsultaSnp := typ_detalleConsultaSnp;
     v_listaConsultaSnp   typ_listaConsultaSnp := typ_listaConsultaSnp();
     userinfo             typ_validarsesion;
     v_permiso            typ_obtenerPermisos;
     v_fec_actual         DATE   := pag_cal.fu_obt_fec_actual(9);          -- fecha de hoy
     v_nro_documento      NUMBER(15);
    -- Variables Recibidas
    v_fec_desde           DATE;
    v_fec_hasta           DATE;
    v_transaccion         NUMBER := p_transaccion;
    --v_can_items           NUMBER := 10;
    v_can_detalles        NUMBER := 0;
    v_nro_cuenta          VARCHAR2(16) := depurarAlfanumerico(p_numeroCuenta, 16);
    v_mto_desde           ge_snp_transferencias.monto%TYPE;
    v_mto_hasta           ge_snp_transferencias.monto%TYPE;
    v_msj_bitacora        VARCHAR2(800) := substr('fec_des:'   ||p_fechaDesde||
                                                  ', fec_has:' ||p_fechaHasta||
                                                  ', nro_cta:' ||v_nro_cuenta||
                                                  ', nro_pag:' ||p_numeroPagina||
                                                  ', nro_tra:' ||p_transaccion||
                                                  ', mto_des:' ||p_montoDesde||
                                                  ', mto_has:' ||p_montoHasta
                                                  ,1, 800);

    -- Variables Internas
    v_cod_cliente         VARCHAR2(10) ;
    v_can_transferencias  NUMBER(8) := 0;

    cursor cabecera (p_cod_persona in varchar2, p_fec_desde in date, p_fec_hasta in date) is
       SELECT *
         FROM (SELECT rownum rowb, d.*
                 FROM (Select 'E' Tipo, a.nro_referencia, a.nro_sec_lote, a.fec_valor, a.hora,
                              a.nro_cta_beneficiario, a.nro_cta_solicitante, a.nom_beneficiario,
                              pas_snp.fu_obt_des_participante(a.cod_swi_pte_beneficiario) Entidad,
                              FUE_OBT_DES_MONEDA(a.cod_moneda) moneda, a.monto,
                              FUE_OBT_DES_REFCODES('SITUACION',a.situacion) Situacion,
                              FUE_OBT_DES_REFCODES('EST_MSJ_SNP',a.estado) Estado, a.msj_swift,
                              decode(a.nro_ref_externa, null, a.cod_swi_pte_beneficiario, a.cod_swi_pte_solicitante) Cod_swift
                         from ge_snp_transferencias a
                        where a.fec_valor between p_fec_desde and p_fec_hasta
                        and
                        /*(
                           (*/a.cod_per_solicitante = p_cod_persona/*) or
                           (a.cod_per_solicitante in (select c.cod_persona
                                                        from ge_cta_clientes c
                                                       where c.nro_cuenta=a.nro_cta_solicitante)
                                                         and p_cod_persona in (select c.cod_persona
                                                                                 from ge_cta_clientes c
                                                                                where c.nro_cuenta=a.nro_cta_solicitante)
                           )
                        )*/
                          and a.nro_cta_solicitante is not null
                          and a.cod_swi_pte_solicitante = pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)
                          and a.nro_cta_solicitante = nvl(v_nro_cuenta, a.nro_cta_solicitante)
                          and a.cod_tra_padre = v_transaccion
                          and a.monto >= nvl(v_mto_desde, a.monto)
                          and a.monto <= nvl(v_mto_hasta, a.monto)
                      ) d
                UNION
               SELECT rownum rowb, d.*
                 FROM (Select 'R' Tipo, a.nro_referencia, a.nro_sec_lote, a.fec_valor, a.hora,
                              a.nro_cta_beneficiario, a.nro_cta_solicitante, a.nom_solicitante,
                              pas_snp.fu_obt_des_participante(a.cod_swi_pte_solicitante) Entidad,
                              FUE_OBT_DES_MONEDA(a.cod_moneda) moneda, a.monto,
                              FUE_OBT_DES_REFCODES('SITUACION',a.situacion) Situacion,
                              FUE_OBT_DES_REFCODES('EST_MSJ_SNP',a.estado) Estado, a.msj_swift,
                              decode(a.nro_ref_externa, null, a.cod_swi_pte_beneficiario, a.cod_swi_pte_solicitante) Cod_swift
                         from ge_snp_transferencias a
                        where a.fec_valor between p_fec_desde and p_fec_hasta
                          and
                          /*(
                           (*/a.cod_per_beneficiario= p_cod_persona/*) or
                           (a.cod_per_beneficiario in (select c.cod_persona
                                                         from ge_cta_clientes  c
                                                        where c.nro_cuenta=a.nro_cta_beneficiario)
                                                          and p_cod_persona in (select c.cod_persona
                                                                                  from ge_cta_clientes  c
                                                                                 where c.nro_cuenta=a.nro_cta_beneficiario)
                           )
                          )*/
                          and a.nro_cta_beneficiario is not null
                          and a.cod_swi_pte_beneficiario = pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)
                          and a.nro_cta_beneficiario = nvl(v_nro_cuenta, a.nro_cta_beneficiario)
                          and a.nro_ref_externa is not null
                          and a.cod_tra_padre = v_transaccion
                          and a.monto >= nvl(v_mto_desde, a.monto)
                          and a.monto <= nvl(v_mto_hasta, a.monto)
                      ) d
        UNION
        SELECT rownum rowb, d.*
                FROM (Select 'E' Tipo, a.nro_referencia, a.nro_sec_lote, a.fec_valor, a.hora,
                              a.nro_cta_beneficiario, a.nro_cta_solicitante, a.nom_beneficiario,
                              pas_snp.fu_obt_des_participante(a.cod_swi_pte_beneficiario) Entidad,
                              FUE_OBT_DES_MONEDA(a.cod_moneda) moneda, a.monto,
                              FUE_OBT_DES_REFCODES('SITUACION',a.situacion) Situacion,
                              FUE_OBT_DES_REFCODES('EST_MSJ_SNP',a.estado) Estado, a.msj_swift,
                              decode(a.nro_ref_externa, null, a.cod_swi_pte_beneficiario, a.cod_swi_pte_solicitante) Cod_swift
                         from ge_snp_transferencias_his a
                        where a.fec_valor between p_fec_desde and p_fec_hasta
                          and a.cod_per_solicitante = p_cod_persona
                          and a.nro_cta_solicitante is not null
                          and a.cod_swi_pte_solicitante = pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)
                          and a.nro_cta_solicitante = nvl(v_nro_cuenta, a.nro_cta_solicitante)
                          and a.cod_tra_padre = v_transaccion
                          and a.monto >= nvl(v_mto_desde, a.monto)
                          and a.monto <= nvl(v_mto_hasta, a.monto)
                      ) d
        UNION
               SELECT rownum rowb, d.*
                 FROM (Select 'R' Tipo, a.nro_referencia, a.nro_sec_lote, a.fec_valor, a.hora,
                              a.nro_cta_beneficiario, a.nro_cta_solicitante, a.nom_solicitante,
                              pas_snp.fu_obt_des_participante(a.cod_swi_pte_solicitante) Entidad,
                              FUE_OBT_DES_MONEDA(a.cod_moneda) moneda, a.monto,
                              FUE_OBT_DES_REFCODES('SITUACION',a.situacion) Situacion,
                              FUE_OBT_DES_REFCODES('EST_MSJ_SNP',a.estado) Estado, a.msj_swift,
                              decode(a.nro_ref_externa, null, a.cod_swi_pte_beneficiario, a.cod_swi_pte_solicitante) Cod_swift
                         from ge_snp_transferencias_his a
                        where a.fec_valor between p_fec_desde and p_fec_hasta
                          and a.cod_per_beneficiario= p_cod_persona
                          and a.nro_cta_beneficiario is not null
                          and a.cod_swi_pte_beneficiario = pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)
                          and a.nro_cta_beneficiario = nvl(v_nro_cuenta, a.nro_cta_beneficiario)
                          and a.nro_ref_externa is not null
                          and a.cod_tra_padre = v_transaccion
                          and a.monto >= nvl(v_mto_desde, a.monto)
                          and a.monto <= nvl(v_mto_hasta, a.monto)
                      ) d
              ) e
        ORDER BY e.fec_valor DESC, e.hora DESC;
    BEGIN

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     v_retorno.cantidadConsultas := 0;

     -- Valido la Sesión del Cliente
     userinfo := fu_validarsesion(p_sesion, p_codigoCanal);

     IF userinfo.error = 'S' THEN
        v_retorno.error                := userinfo.error;
        v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     v_permiso := lf_obt_permisos(userinfo, v_cod_operacion);
     IF v_permiso.error = 'S' THEN
        v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
        v_retorno.error                := v_permiso.error;
        RETURN v_retorno;
     END IF;
     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) , BITACORA_ENTRADA);

     v_cod_cliente := NVL(userinfo.codigoEmpresa, userinfo.codigoPersona);

      -- sanitizacion de parametros
      v_fec_desde := p_fechaDesde;
      v_fec_hasta := p_fechaHasta;
      v_mto_desde := p_montoDesde;
      v_mto_hasta := p_montoHasta;

      IF v_fec_hasta = v_fec_actual then
         v_fec_hasta := pag_cal.fu_obt_fec_fin_ret( v_fec_hasta, NULL, nvl( fug_obt_pardinamico ( 'SNP_RAN_DIA_FEC_VALOR'),0 )) ;
      end if ;
      -- por defecto transferencia SNP
      IF nvl(v_transaccion, 0 ) = 0 THEN
         v_transaccion := 303;
      END IF;
      -- si no se recibe monto inicio
      IF nvl(v_mto_desde, 0) = 0 THEN
         v_mto_desde := NULL;
      END IF;
      -- si no se recibe monto hasta
      IF nvl(v_mto_hasta, 0) = 0 THEN
         v_mto_hasta := NULL;
      END IF;
      -- 2. busco los datos del Cliente
      FOR cab in cabecera(v_cod_cliente, v_fec_desde, v_fec_hasta)  LOOP
         v_can_detalles := v_can_detalles + 1;

        /* IF v_can_detalles > (v_can_items * p_numeroPagina) THEN
            EXIT;
         END IF;*/

         -- para logica de paginacion
         --IF v_can_detalles > (v_can_items * (nvl(p_numeroPagina, 1) - 1)) THEN
            v_can_transferencias := v_can_transferencias + 1;
            v_detalleConsultaSnp.tipoMovimiento := substr(cab.tipo, 1, 1);
            v_detalleConsultaSnp.numeroReferencia := cab.nro_referencia;
            v_detalleConsultaSnp.numeroLote := substr(cab.nro_sec_lote, 1, 20);
            v_detalleConsultaSnp.fechaOperacion := substr(to_char(cab.fec_valor, 'ddmmyyyy'), 1, 10);
            v_detalleConsultaSnp.nombre := substr(cab.nom_beneficiario, 1, 80);
            v_detalleConsultaSnp.entidadFinanciera := substr(cab.entidad, 1, 60);
            v_detalleConsultaSnp.moneda := substr(cab.moneda, 1, 30);
            v_detalleConsultaSnp.monto := substr(cab.monto, 1, 17);
            v_detalleConsultaSnp.situacion := substr(cab.situacion, 1, 30);
            v_detalleConsultaSnp.estado := substr(cab.estado, 1, 100);
            v_detalleConsultaSnp.numeroCuentaCredito := substr(cab.nro_cta_beneficiario, 1, 35);
            v_detalleConsultaSnp.numeroCuentaDebito := substr(cab.nro_cta_solicitante, 1, 35);
            v_detalleConsultaSnp.swiftEntidad := substr(cab.cod_swift, 1, 20);
            v_detalleConsultaSnp.mensajeMt := nvl(REPLACE(REPLACE(cab.msj_swift,chr(10),' '), chr(13), ''),'~');

             v_listaConsultaSnp.extend;
             v_listaConsultaSnp(v_listaConsultaSnp.count) := v_detalleConsultaSnp;
          --END IF;
      END LOOP;
      -- registro del movimiento
      SELECT s_nro_documento.nextval INTO v_nro_documento FROM dual;
      lp_reg_operacion(NULL /*p_nro_cuenta*/, null /*p_cod_moneda */, null /*p_monto*/, NULL /*p_nro_cta_contra*/,
                       NULL, 'Tipo Consulta', /*p_tipoMensaje*/NULL, 'Cantidad Msj', v_listaConsultaSnp.Count,
                       NULL, NULL, NULL, userinfo.codigoPersona, v_cod_operacion, v_nro_documento, p_codigoCanal, p_sesion, userinfo.codigoEmpresa);

      IF v_listaConsultaSnp.Count > 0 THEN
         v_retorno.listaConsultas := v_listaConsultaSnp;
      END IF;

      v_retorno.cantidadConsultas := v_listaConsultaSnp.Count;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) , BITACORA_SALIDA);
      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeusuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarbitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;


   /**
   * Cancelación de Transferencia Interbancaria SNP
   * @Creado por: Fermín Giménez
   * @Fecha : 06-02-2013
   */
   FUNCTION fu_cancelarTransferenciaSnp
                    (
                       p_sesion           IN VARCHAR2,
                       p_codigoCanal      IN VARCHAR2,
                       p_modo             IN VARCHAR2,
                       p_numeroReferencia IN VARCHAR2
                    ) RETURN typ_cancelarTransferenciaSnp IS

     v_cod_operacion VARCHAR2(3) := '038';

     v_retorno                 typ_cancelarTransferenciaSnp := typ_cancelarTransferenciaSnp;
     v_detalleCancelacion      typ_detalleCancelacionSnp := typ_detalleCancelacionSnp;
     v_listaCancelacionesSnp   typ_listaCancelacionesSnp := typ_listaCancelacionesSnp();
     v_comprobanteMovimiento   typ_comprobanteMovimiento;

     v_bitacora_titulo  VARCHAR2(150) := 'modo: ' ||p_modo || ', nro.ref: ' || p_numeroReferencia;

     MSG_VAL_PENTRADA    CONSTANT VARCHAR2(15) := 'VAL_PENTRADA'; /**Parametros de entradas incorrectos*/
     MSG_NROREF_INVA     CONSTANT VARCHAR2(15) := 'NROREF_INVA'; /**Nro. Referencia invalida*/
     MSG_CTA_SMOV        CONSTANT VARCHAR2(15) := 'CTA_SMOV'; /**Cuenta sin movimiento*/
     MSG_TRA_INVALIDA    CONSTANT VARCHAR2(15) := 'TRA_INVALIDA'; /** Transaccion invalida*/
     SNP_SIN_AUT_CANCELA CONSTANT VARCHAR2(15) := 'SNP_AUT_CANCELA';
     userinfo            typ_validarsesion;
     v_permiso           typ_obtenerPermisos;

     v_fec_actual          DATE   := pag_cal.fu_obt_fec_actual(9);          -- fecha de hoy

    --Variables Recibidas
    v_modo                 VARCHAR2(1) := p_modo; -- C(Cabecera), D(Detalle)
    v_nro_referencia       NUMBER(20) ;
    v_nro_documento        NUMBER(15);
    --Variables Locales
    v_nro_cta_debito       VARCHAR2(20);
    v_nro_cta_credito      VARCHAR2(20);
    v_cod_moneda           VARCHAR2(3) ;
    v_monto                NUMBER(18,2);
    v_fec_operacion        DATE;
    v_cod_persona          VARCHAR2(10);

    cursor cabecera (p_cod_persona in varchar2) is
       Select a.nro_referencia, a.nro_sec_lote, a.fec_valor,
          a.nro_cta_beneficiario, a.nom_beneficiario,
          pas_snp.fu_obt_des_participante(a.cod_swi_pte_beneficiario) Entidad,
          FUE_OBT_DES_MONEDA(a.cod_moneda) moneda, a.monto
       from ge_snp_transferencias a
       where a.cod_per_solicitante = p_cod_persona
          and a.nro_cta_beneficiario is not null
          and a.fec_valor >= v_fec_actual
          and a.situacion = 'P' -- Solo los que estan Pendiente de Envío.
          and a.estado not in ('C', 'E')
          and a.fecha is null -- Solo los que no tienen movimiento asociado (Fecha Futura)
          and a.cod_swi_pte_solicitante = pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)
          -- Para no mostrar las transferencias solicitadas para cancelar - Empresas
          and not exists ( Select 1 from bw_mov_pendientes b
                           where b.cod_per_principal = p_cod_persona
                             and trunc(b.fec_hora) = trunc(sysdate)
                             and b.estado = 'P'
                             and b.cod_tip_mensaje = '038'
                             and b.referencia = a.nro_referencia)
      order by fec_valor desc;

    BEGIN

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     v_retorno.cantidadCancelaciones := 0;

     -- Valido la Sesión del Cliente
     userinfo := fu_validarsesion(p_sesion, p_codigoCanal);

     IF userinfo.error = 'S' THEN
        v_retorno.error                := userinfo.error;
        v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

      --Validacion p.entrada
     IF (p_numeroReferencia IS NULL OR p_modo IS NULL) THEN
        pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_bitacora_titulo || ' - ' || MSG_VAL_PENTRADA, BITACORA_ERROR);
        RETURN v_retorno;
     END IF;
     v_cod_persona := NVL(userinfo.codigoEmpresa, userinfo.codigoPersona);

     v_nro_referencia      := p_numeroReferencia;
     IF nvl(p_modo,'X') = 'A' THEN
        -- controlamos que venga de autorizar
        IF g_aut_operacion = FALSE THEN
           pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_bitacora_titulo||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;

        v_modo := 'E';
     ELSE
        v_permiso := lf_obt_permisos(userinfo, v_cod_operacion); --v_cod_persona, userinfo.codigoPerfil, v_cod_operacion, p_codigoCanal);
        IF v_permiso.error = 'S' THEN
           v_retorno.error := v_permiso.error;
           v_retorno.nombreRespuesta := v_permiso.nombreRespuesta;
           v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
           pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_bitacora_titulo || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
        -- se verifica que tenga permiso para registrar
        IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
           pr_mensajeUsuario(SNP_SIN_AUT_CANCELA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_bitacora_titulo || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
     END IF;

    if v_modo = 'C' then -- Consulta de Entidades Registradas.
       for cb in cabecera(v_cod_persona)  loop
          v_detalleCancelacion.numeroReferencia := cb.nro_referencia;
          v_detalleCancelacion.numeroSecuenciaLote := cb.nro_sec_lote;
          v_detalleCancelacion.fechaValor := cb.fec_valor;
          v_detalleCancelacion.numeroCuentaBeneficiario := cb.nro_cta_beneficiario;
          v_detalleCancelacion.nombreBeneficiario := cb.nom_beneficiario;
          v_detalleCancelacion.entidad := cb.entidad;
          v_detalleCancelacion.moneda := cb.moneda;
          v_detalleCancelacion.monto := cb.monto;

          v_listaCancelacionesSnp.extend;
          v_listaCancelacionesSnp(v_listaCancelacionesSnp.count) := v_detalleCancelacion;
       end loop ;

    elsif v_modo = 'D' then -- Datos de Transferencias anteriores
       v_comprobanteMovimiento := fu_obtComprobanteMovimiento(p_sesion,
                                                              p_codigoCanal,
                                                              v_nro_referencia,
                                                              v_fec_actual,
                                                              v_nro_referencia,
                                                              NULL,
                                                              'I',
                                                              NULL,
                                                              NULL);

       IF v_comprobanteMovimiento.error = 'S' THEN
          v_retorno.error                := v_comprobanteMovimiento.error;
          v_retorno.nombreRespuesta      := v_comprobanteMovimiento.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_comprobanteMovimiento.descripcionRespuesta;
          RETURN v_retorno;
       END IF;

       v_retorno.comprobanteMovimiento := v_comprobanteMovimiento;

    elsif v_modo = 'E' then -- Cancelación
       if nvl(p_modo,'X') = 'A' or v_can_aut_requeridas = 0 then
          pas_snp.pr_obt_mensaje(v_nro_referencia, 'N') ;
          pas_snp.g_msj.estado := 'C' ;
          PAS_SNP.PR_SET_TRANSFERENCIAS(pas_snp.fu_obt_reg_transferencias) ;
          if pas_snp.g_cod_error <> 0 then
            pr_mensajeUsuario(MSG_NROREF_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_bitacora_titulo || ' - ' || MSG_NROREF_INVA, BITACORA_ERROR);
            RETURN v_retorno;
          end if ;
       else
          Begin
             Select t.nro_cta_solicitante, t.monto, t.cod_moneda, t.nro_cta_beneficiario, t.fec_valor
               into v_nro_cta_debito, v_monto, v_cod_moneda, v_nro_cta_credito, v_fec_operacion
             from ge_snp_transferencias t
             where t.nro_referencia = v_nro_referencia ;
          exception
             when others then
                pr_mensajeUsuario(MSG_CTA_SMOV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                pr_insertarBitacora(userinfo.codigoPersona, p_codigocanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_bitacora_titulo || ' - ' || MSG_CTA_SMOV, BITACORA_ERROR);
                RETURN v_retorno;
          end;

          -- Se inserta el movimiento pendiente de autorizacion si encontro el registro
           select s_nro_documento.nextval into v_nro_documento from dual;
           insert into bw_mov_pendientes(
              nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta,
              descripcion, estado, can_aut_requeridas, can_aut_faltantes,
              cod_per_ingreso, monto, etiqueta, dato,
              etiqueta2, dato2, referencia, cod_moneda)
           values
              (v_nro_documento,v_cod_persona,sysdate,'038', v_nro_cta_debito,
               'Cancelación de Operación', 'P', v_can_aut_requeridas, v_can_aut_requeridas,
               v_cod_persona, v_monto, 'Nro.Cta.Crédito/Moneda', v_nro_cta_credito||' / '||v_cod_moneda,
               'Fecha Valor',v_fec_operacion, v_nro_referencia, v_cod_moneda);

           v_retorno.autorizacionesRequeridas := v_can_aut_requeridas;
       end if;
    end if ;

     -- registro del movimiento
     select s_nro_documento.nextval into v_nro_documento from dual;
     lp_reg_operacion(NULL /*p_nro_cuenta*/, null /*p_cod_moneda */, null /*p_monto*/, NULL /*p_nro_cta_contra*/,
                      NULL, 'Cancelacion', v_modo, 'Nro de Referencia', v_nro_referencia,
                      NULL, NULL, NULL, userinfo.codigoPersona, v_cod_operacion, v_nro_documento, p_codigoCanal, p_sesion, userinfo.codigoEmpresa);

     IF v_listaCancelacionesSnp.Count > 0 THEN
        v_retorno.listaCancelaciones := v_listaCancelacionesSnp;
     END IF;

     v_retorno.cantidadCancelaciones := v_listaCancelacionesSnp.Count;

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, ' fu_cancelarTransferenciaSnp-' || BITACORA_SALIDA);
     RETURN v_retorno;

    EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeusuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarbitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'Función de Extracto a Req. - ' || SQLERRM, bitacora_error);

         RETURN v_retorno;
    END;

    FUNCTION fu_obtenerConfiguracion(p_parametro IN VARCHAR2,
                                     p_cod_modulo IN NUMBER DEFAULT NULL,
                                     p_cod_modalidad IN NUMBER DEFAULT NULL,
                                     p_cod_moneda IN VARCHAR2 DEFAULT NULL,
                                     p_cod_oficina IN NUMBER  DEFAULT NULL,
                                     p_cod_sub_modalidad IN VARCHAR2 DEFAULT NULL)
                                     RETURN typ_parametrosConfiguracion IS
       MSG_SINDATOS CONSTANT VARCHAR2(15) := 'G_SIN_DATOS';
       v_retorno       typ_parametrosConfiguracion := typ_parametrosConfiguracion;
       v_parametro     GE_PAR_DINAMICOS.Parametro%TYPE := substr(p_parametro, 1, 30);
    BEGIN
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       v_retorno.valor := fug_obt_pardinamico(v_parametro,
                                              p_cod_modulo,
                                              p_cod_modalidad,
                                              p_cod_moneda,
                                              p_cod_oficina,
                                              p_cod_sub_modalidad);
       IF v_retorno.valor IS NULL THEN
          pr_mensajeUsuario(MSG_SINDATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       END IF;
       RETURN v_retorno;
    EXCEPTION
       WHEN OTHERS THEN
          pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          RETURN v_retorno;
    END;


 FUNCTION fu_obtenerSnpHorarios(p_sesion IN VARCHAR2, p_codigoCanal IN VARCHAR2) RETURN typ_SnpPeriodos IS
    v_sesion           typ_validarSesion;
    v_retorno          typ_SnpPeriodos:=typ_SnpPeriodos();
    v_cod_operacion    VARCHAR2(3) := '411';
    v_msj_bitacora     VARCHAR(1500) := 'fu_obtenerSnpPeriodos ';
    v_cantidadPeriodos NUMBER(3) := 0;
    listaPeriodos      typ_ListaSnpPeriodos := typ_ListaSnpPeriodos();
    CURSOR periodos IS
       SELECT COD_PERIODO, DESCRIPCION, ESTADO, FECHA, HOR_INICIO, HOR_FIN
         FROM ge_snp_horarios;
 BEGIN
    pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

    --se valida la sesión del cliente
    v_sesion := fu_validarSesion(p_sesion, p_codigoCanal);
    IF v_sesion.error = 'S' THEN
       v_retorno.error                := v_sesion.error;
       v_retorno.nombreRespuesta      := v_sesion.nombreRespuesta;
       v_retorno.descripcionRespuesta := v_sesion.descripcionRespuesta;
       RETURN v_retorno;
    END IF;
    pr_insertarBitacora(v_sesion.codigoPersona,
                        p_codigoCanal,
                        p_sesion,
                        v_cod_operacion,
                        v_sesion.codigoEmpresa,
                        'fu_obtenerSnpHorarios ' ||
                        fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                        BITACORA_ENTRADA);

    FOR pe IN periodos
    LOOP
       DECLARE
          snpPeriodo typ_SnpPeriodo := typ_SnpPeriodo();
       BEGIN
          snpPeriodo.codigoPeriodo := pe.cod_periodo;
          snpPeriodo.descripcion   := pe.descripcion;
          snpPeriodo.estado        := pe.estado;
          snpPeriodo.fecha         := pe.fecha;
          snpPeriodo.horaInicio    := pe.hor_inicio;
          snpPeriodo.horaFin       := pe.hor_fin;
          v_cantidadPeriodos       := v_cantidadPeriodos + 1;
          listaPeriodos.EXTEND;
          listaPeriodos(listaPeriodos.COUNT) := snpPeriodo;
       END;
    END LOOP;
    v_retorno.cantidadPeriodos:=v_cantidadPeriodos;
    v_retorno.lista:= listaPeriodos;
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(v_sesion.codigoPersona, v_sesion.codigoCanal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, ' fu_obtenerSnpPeriodos-' || BITACORA_SALIDA);
     RETURN v_retorno;

 EXCEPTION
    WHEN OTHERS THEN
       v_msj_bitacora := ' ORA-ERR: [' || substr(SQLERRM, 1, 200) || ']';
       pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(v_sesion.codigoPersona,
                           p_codigoCanal,
                           p_sesion,
                           v_cod_operacion,
                           v_sesion.codigoEmpresa,
                           v_msj_bitacora || ' ' ||
                           fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                           BITACORA_ERROR);
       RETURN v_retorno;
 END;

   -- Adhesión Débito Automático para Préstamo o Tarjeta
   FUNCTION fu_adhesionDebitoAutomatico(p_sesion       IN VARCHAR2,
                                        p_codigoCanal  IN VARCHAR2,
                                        p_numeroCuenta IN VARCHAR2,
                                        p_cuentaDebito IN VARCHAR2,
                                        p_tipoAdhesion IN VARCHAR2,
                                        p_tipoCobro    IN VARCHAR2) RETURN typ_mensajerespuesta IS
      -- parametros de entrada
      v_tipo            VARCHAR2(1)  := nvl(depurarAlfanumerico(p_tipoAdhesion, 1), 'x');  -- P: Préstamo, T: Tarjeta
      v_nro_cuenta      VARCHAR2(16) := depurarAlfanumerico(p_numeroCuenta, 16); -- Cuenta préstamo o tarjeta
      v_nro_cta_debito  VARCHAR2(15) := depurarAlfanumerico(p_cuentaDebito, 15); -- Cuenta a debitar
      v_tip_cobro       VARCHAR2(1)  := nvl(depurarAlfanumerico(p_tipoCobro, 1), 'x');  -- Tipo de débito para tarjetas M: minimo, T: Total
      -- para validar cuenta débito
      v_cod_mon_debito  ge_cuentas.cod_moneda%TYPE;
      v_cod_mod_debito  ge_cuentas.cod_modulo%TYPE;
      v_cod_mad_debito  ge_cuentas.cod_modalidad%TYPE;
      v_cod_ofi_debito  ge_cuentas.cod_oficina%TYPE;
      v_cta_for_debito  ge_cuentas.nro_cuenta%TYPE;
      v_nom_cta_debito  ge_cuentas.denominacion%TYPE;
      -- moneda del préstamo o tarjeta
      v_cod_moneda      ba_monedas.cod_moneda%TYPE;
      v_nro_cta_tarjeta ta_tarjetas.nro_cuenta%TYPE;
      v_cod_tra_padre   ge_transacciones.cod_transaccion%TYPE;
      -- auxiliares
      v_deb_automatico  VARCHAR2(1);
      v_retorno         typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_cod_operacion   VARCHAR2(3) := '114';
      v_sesion          typ_validarSesion;
      v_error           typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_msj_caja        typ_mensajeCaja;
      v_msj_bitacora    VARCHAR2(400) := 'cta:'||v_nro_cuenta
                                               ||', ctaDeb:'||v_nro_cta_debito
                                               ||', tipAd:'||v_tipo
                                               ||', tipCob:'||v_tip_cobro;
      -- horario
      v_horario         VARCHAR2(1);
      v_es_mov_noc      VARCHAR2(1);
      v_es_cta_noc      VARCHAR2(1);
      v_fec_actual      DATE;
      -- Errores
      MSG_CTA_TERCERO   CONSTANT VARCHAR2(15) := 'CTA_DEB_INVALID';
      MSG_TRA_INVALIDA  CONSTANT VARCHAR2(15) := 'OBT_TRA_INV';
      MSG_CTA_INVALIDA  CONSTANT VARCHAR2(15) := 'G_NROCTAINVALID';
      MSG_DEB_ASOCIADO  CONSTANT VARCHAR2(15) := 'CTA_ASO_DEB_AUT';
      MSG_MON_DIFERENTE CONSTANT VARCHAR2(15) := 'MON_DEB_INVALID';
      MSG_OPE_INVALIDA  CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      --se valida la sesión del cliente
      v_sesion := fu_validarSesion(p_sesion, p_codigoCanal);
      IF v_sesion.error = 'S' THEN
         v_retorno.error                := v_sesion.error;
         v_retorno.nombreRespuesta      := v_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- se valida la caja
      v_msj_caja := lf_val_caja(v_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(v_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ENTRADA);
      -- verificamos el horario
      v_error := lp_ver_horario(v_horario,
                                v_es_mov_noc,
                                v_es_cta_noc,
                                v_msj_caja.fechaUltimoCierre, -- IN
                                v_msj_caja.codigoOficinaOrigen, -- IN
                                v_fec_actual);

      IF v_error.error = 'S' THEN
         v_retorno := v_error;
      END IF;
      -- verificamos que la cuenta débito pertenezca al cliente
      IF v_retorno.error = 'N' THEN
         IF lf_val_cta_origen(v_nro_cta_debito, nvl(v_sesion.codigoEmpresa, v_sesion.codigoPersona)) = 'N' THEN
            pr_mensajeUsuario(MSG_CTA_TERCERO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END IF;
      END IF;
      -- verificamos que solo sean personas físicas
      IF v_retorno.error = 'N' THEN
         IF v_sesion.codigoEmpresa IS NOT NULL THEN
            pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END IF;
      END IF;
      -- verificamos que la cuenta débito
      IF v_retorno.error = 'N' THEN
         -- para verificar transacciones prohibidas en la validación de cta. débito
         IF v_tipo = 'T' THEN
            v_cod_tra_padre := 250;
         ELSE
            v_cod_tra_padre := 360;
         END IF;
         v_error := lf_val_cta_debito(v_nro_cta_debito,
                           v_cod_tra_padre,
                           0, -- no importa el monto
                           v_cod_mon_debito,
                           v_cod_mod_debito,
                           v_cod_mad_debito,
                           v_cod_ofi_debito,
                           v_cta_for_debito,
                           v_nom_cta_debito,
                           v_sesion,
                           v_msj_caja);
         IF v_error.error = 'S' THEN
            v_retorno := v_error;
         END IF;
      END IF;
      -- no hubo errores hasta aquí
      IF v_retorno.error = 'N' THEN
         CASE v_tipo
         -- tarjeta de crédito
         WHEN 'T' THEN
            -- obtenemos los datos de la cuenta
            BEGIN
               SELECT nvl(ct.deb_automatico, 'N'), ct.cod_moneda, ta.nro_cuenta
                 INTO v_deb_automatico, v_cod_moneda, v_nro_cta_tarjeta
                 FROM ta_tarjetas ta, ta_cta_tarjetas ct, ge_cta_clientes cc
                WHERE ta.cod_persona = nvl(v_sesion.codigoEmpresa, v_sesion.codigoPersona)
                  AND ta.nro_cuenta = ct.nro_cuenta
                  AND ta.nro_cuenta = cc.nro_cuenta
                  AND cc.relacion = 'P'
                  AND ta.nro_tarjeta = v_nro_cuenta;
               -- verificamos si ya esta asociado a débito automatico
               IF v_deb_automatico = 'S' THEN
                  pr_mensajeUsuario(MSG_DEB_ASOCIADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
               -- validamos que el tipo sea T o M
               IF v_tip_cobro NOT IN ('M', 'T') THEN
                  pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            EXCEPTION
               WHEN OTHERS THEN
                  v_msj_bitacora := v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || ']';
                  pr_mensajeUsuario(MSG_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END;
            -- validamos las monedas
            IF v_retorno.error = 'N' THEN
               IF v_cod_moneda <> v_cod_mon_debito THEN
                  v_msj_bitacora := v_msj_bitacora || ', monDeb:' || v_cod_mon_debito || ', monCta:' || v_cod_moneda;
                  pr_mensajeUsuario(MSG_MON_DIFERENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
            -- no hubo problemas, aderimos al servicio de debito automático
            IF v_retorno.error = 'N' THEN
               UPDATE ta_cta_tarjetas t
                  SET t.deb_automatico = 'S',
                      t.nro_cta_debito = v_nro_cta_debito,
                      t.tip_cobro      = v_tip_cobro
                WHERE t.nro_cuenta = v_nro_cta_tarjeta;
               -- verificamos si se agregó al débito
               IF SQL%ROWCOUNT <> 1 THEN
                  v_msj_bitacora := v_msj_bitacora || ', filAfe:' ||SQL%ROWCOUNT;
                  pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
         -- préstamo
         WHEN 'P' THEN
            -- obtenemos los datos de la cuenta
            BEGIN
               SELECT pr.cob_automatico, pr.cod_moneda
                 INTO v_deb_automatico, v_cod_moneda
                 FROM pr_cta_prestamos pr, ge_cta_clientes gc
                WHERE pr.nro_cuenta = gc.nro_cuenta
                  AND pr.nro_cuenta = v_nro_cuenta
                  AND gc.relacion = 'P'
                  AND gc.cod_persona = nvl(v_sesion.codigoEmpresa, v_sesion.codigoPersona);
            EXCEPTION
               WHEN OTHERS THEN
                  v_msj_bitacora := v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || ']';
                  pr_mensajeUsuario(MSG_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END;
            -- validamos si ya tiene asociado débito automático
            IF v_retorno.error = 'N' THEN
               IF v_deb_automatico = 'S' THEN
                  pr_mensajeUsuario(MSG_DEB_ASOCIADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
            -- validamos las monedas
            IF v_retorno.error = 'N' THEN
               IF v_cod_mon_debito <> v_cod_moneda THEN
                  v_msj_bitacora := v_msj_bitacora || ', monDeb:' || v_cod_mon_debito || ', monCta:' || v_cod_moneda;
                  pr_mensajeUsuario(MSG_MON_DIFERENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
            -- no hubo problemas, aderimos al servicio de débito automático
            IF v_retorno.error = 'N' THEN
               UPDATE pr_cta_prestamos p
                  SET p.cob_automatico = 'S',
                      p.nro_cta_debito = v_nro_cta_debito
                WHERE p.nro_cuenta = v_nro_cuenta;
               -- verificamos si se agregó al débito
               IF SQL%ROWCOUNT <> 1 THEN
                  v_msj_bitacora := v_msj_bitacora || ', filAfe:' ||SQL%ROWCOUNT;
                  pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
         ELSE
            pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END CASE;
      END IF;
      -- registro el movimiento
      IF v_retorno.error = 'S' THEN
         pr_insertarBitacora(v_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
      ELSE
         pr_insertarBitacora(v_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_SALIDA);
      END IF;

      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         v_msj_bitacora := v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || ']';
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
   END;

--Cta:0102061367-Lote:2829-Tran:661978-DB Pag.Serv:1529 via HB
  PROCEDURE lp_act_mov_bancard(p_cod_ws_servicios IN VARCHAR2,
                               p_nro_lote         IN VARCHAR2,
                               p_nro_transaccion  IN VARCHAR2,
                               p_servicio         IN VARCHAR2,
                               p_cuentaDebito     IN VARCHAR2,
                               p_mensajeCaja      IN typ_mensajeCaja) IS

    v_horario     VARCHAR2(1);
    v_es_mov_noc  VARCHAR2(1);
    v_es_cta_noc  VARCHAR2(1);
    v_fec_actual  DATE;
    v_ret_horario typ_mensajerespuesta;
    --servicios criticos
    v_tag       VARCHAR2(20);
    v_abre_oper ba_cod_referencias.abreviatura%TYPE := NULL;
    v_proveedor bw_pag_servicios.cod_proveedor%TYPE := NULL;

  BEGIN
    v_ret_horario := lp_ver_horario(v_horario,
                                    v_es_mov_noc,
                                    v_es_cta_noc,
                                    p_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                    -- IN
                                    p_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                    -- IN
                                    v_fec_actual);

    SELECT bws.cod_proveedor
      INTO v_proveedor
      FROM bw_pag_servicios bws
     WHERE bws.cod_ws_servicios = p_cod_ws_servicios
       AND bws.reversado = 'N';

    v_abre_oper := paw_uti.fu_obt_abr_refcodes('SERVICIOS_CRITICOS',
                                               p_servicio,
                                               to_char(v_proveedor));
    IF v_abre_oper = p_servicio THEN
      v_tag := 'COD_WS_CRI:'; -- para diferenciar limites en los movimientos
    ELSE
      v_tag := 'COD_WS:'; -- para diferenciar limites en los movimientos
    END IF;
    IF v_ret_horario.error = 'N' THEN
      IF v_es_mov_noc = 'S' THEN
        UPDATE ge_movimientos_noc
           SET concepto = 'Cta:' || p_cuentaDebito || '-' || v_tag ||
                          '-Lote:' || p_nro_lote || '-' || 'Tran:' ||
                          p_nro_transaccion || '-' || 'DB Pag.Serv:' ||
                          p_servicio || ' via YG'

         WHERE cod_tra_padre = 488
           AND cod_transaccion = 503
           AND nro_documento3 = p_nro_transaccion;
      ELSE
        UPDATE ge_movimientos
           SET concepto = 'Cta:' || p_cuentaDebito || '-' || v_tag ||
                          '-Lote:' || p_nro_lote || '-' || 'Tran:' ||
                          p_nro_transaccion || '-' || 'DB Pag.Serv:' ||
                          p_servicio || ' via YG'
         WHERE cod_tra_padre = 488
           AND cod_transaccion = 503
           AND nro_documento3 = p_nro_transaccion;
      END IF;
    END IF;
  END;
PROCEDURE lp_act_movimiento(p_cod_ws_servicios IN VARCHAR2,
                            p_nro_lote         IN VARCHAR2,
                            p_nro_transaccion  IN VARCHAR2,
                            p_servicio         IN VARCHAR2,
                            p_cuentaDebito     IN VARCHAR2,
                            p_mensajeCaja      IN typ_mensajeCaja) IS
   v_horario     VARCHAR2(1);
   v_es_mov_noc  VARCHAR2(1);
   v_es_cta_noc  VARCHAR2(1);
   v_fec_actual  DATE;
   v_ret_horario typ_mensajerespuesta;
   --servicios criticos
   v_tag         VARCHAR2(20);
   v_abre_oper   ba_cod_referencias.abreviatura%TYPE :=NULL;
   v_proveedor bw_pag_servicios.cod_proveedor%TYPE := NULL;
BEGIN
   v_ret_horario := lp_ver_horario(v_horario,
                                   v_es_mov_noc,
                                   v_es_cta_noc,
                                   p_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                   -- IN
                                   p_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                   -- IN
                                   v_fec_actual);
  SELECT bws.cod_proveedor
      INTO v_proveedor
      FROM bw_pag_servicios bws
    WHERE bws.cod_ws_servicios = p_cod_ws_servicios;
    v_abre_oper := paw_uti.fu_obt_abr_refcodes('SERVICIOS_CRITICOS', p_servicio, to_char(v_proveedor));
    IF v_abre_oper = p_servicio THEN
       v_tag := 'COD_WS_CRI:'; -- para diferenciar limites en los movimientos
    ELSE
       v_tag := 'COD_WS:'; -- para diferenciar limites en los movimientos

    END IF;
   IF v_ret_horario.error = 'N' THEN
      IF v_es_mov_noc = 'S' THEN
         UPDATE ge_movimientos_noc
            SET concepto = 'Cta:' || p_cuentaDebito || '-' || v_tag || '-Lote:' || p_nro_lote || '-' || 'Tran:' || p_nro_transaccion || '-' || 'DB Pag.Serv:' ||
                            p_servicio || ' via YG',
                nro_documento2 = p_nro_transaccion
                /*nro_documento = p_nro_transaccion*/ --DDSI-325
          WHERE concepto LIKE '%' || p_cod_ws_servicios || '%'
            AND cod_transaccion = 503;

         UPDATE ge_movimientos_noc
            SET concepto = 'Cta:' || p_cuentaDebito || '-' || 'Lote:' || p_nro_lote || '-' || 'Tran:' || p_nro_transaccion || '-' || 'CR Pag.Serv:' ||
                            p_servicio || ' via YG',
                nro_documento2 = p_nro_transaccion
                /*nro_documento = p_nro_transaccion*/ --DDSI-325
          WHERE concepto LIKE '%' || p_cod_ws_servicios || '%'
            AND cod_transaccion = 602;

      ELSE
         UPDATE ge_movimientos
            SET concepto = 'Cta:' || p_cuentaDebito || '-' || v_tag || '-Lote:' || p_nro_lote || '-' || 'Tran:' || p_nro_transaccion || '-' || 'DB Pag.Serv:' ||
                            p_servicio || ' via YG',
                nro_documento2 = p_nro_transaccion
                /*nro_documento = p_nro_transaccion*/ --DDSI-325
          WHERE concepto LIKE '%' || p_cod_ws_servicios || '%'
            AND cod_transaccion = 503;

         UPDATE ge_movimientos
            SET concepto = 'Cta:' || p_cuentaDebito || '-' || 'Lote:' || p_nro_lote || '-' || 'Tran:' || p_nro_transaccion || '-' || 'CR Pag.Serv:' ||
                            p_servicio || ' via YG',
                nro_documento2 = p_nro_transaccion
                /*nro_documento = p_nro_transaccion*/ --DDSI-325
          WHERE concepto LIKE '%' || p_cod_ws_servicios || '%'
            AND cod_transaccion = 602;
      END IF;
   END IF;
END;

FUNCTION fu_pagoServiciosWs(p_sesion             IN VARCHAR2,
                            p_codigoCanal        IN VARCHAR2,
                            p_modo               IN VARCHAR2,
                            p_cuentaDebito       IN VARCHAR2,
                            p_numeroIp           IN VARCHAR2,
                            p_sesionServicios    IN VARCHAR2,
                            p_servicio           IN VARCHAR2,
                            p_numeroTransaccion  VARCHAR2,
                            p_numeroLote         VARCHAR2,
                            p_terminal           VARCHAR2,
                            p_moneda             NUMBER,
                            p_monto              NUMBER,
                            p_importeComision    NUMBER,
                            p_importeMora        NUMBER,
                            p_importeInteres     NUMBER,
                            p_claveTransaccional IN VARCHAR2,
                            p_claveToken         IN VARCHAR2,
                            p_tokenServicios     IN VARCHAR2,
                            p_proveedor          IN NUMBER,
                            p_extra              IN VARCHAR2)

  RETURN typ_pagoServiciosWs IS
  -- datos a responder
  userinfo          typ_validarSesion;
  v_retorno         typ_pagoServiciosWs := typ_pagoServiciosWs;
  v_mensajeCaja     typ_mensajeCaja;
  v_retError        typ_mensajerespuesta;
  v_permiso         typ_obtenerPermisos;
  v_resLimite       typ_respuestaLimite;
  v_cod_operacion   VARCHAR2(3) := '088';
  v_cuentaAux       VARCHAR2(18);
  v_nro_cta_debito  VARCHAR2(20);
  v_cod_transaccion NUMBER := 503; --débito en caja de ahorros
  v_cod_tra_padre   NUMBER := 485;
  v_codCanal        NUMBER;
  v_modo            VARCHAR2(1);
  --v_monto           NUMBER(18, 2) := p_monto;
  v_hora            VARCHAR2(10);
  v_fecha           VARCHAR2(18);
  v_terminal        VARCHAR2(15);
  v_moneda          NUMBER := p_moneda;
  v_claveSesion     VARCHAR2(32);
  v_sesionServicios VARCHAR2(32);
  v_pagServicios    number(3);
  v_msj_bitacora    VARCHAR2(600);
  v_ser_respuesta   VARCHAR2(20);
  v_nro_documento   NUMBER(15);
  v_aut_pendientes   number(3);
  v_cod_mon_servicio ba_monedas.cod_moneda%TYPE := NULL;
  v_mto_debito       ge_movimientos.monto%TYPE := NULL;
  v_cod_mon_debito   ba_monedas.cod_moneda%TYPE := NULL;
  v_mto_credito      ge_movimientos.monto%TYPE := p_monto;
  v_mto_equ_local    ge_movimientos.mto_equ_local%TYPE;
  v_cot_debito       ge_movimientos.cotizacion%TYPE := NULL;
  v_cot_credito      ge_movimientos.cotizacion%TYPE := NULL;
  v_nro_cta_credito  ge_cuentas.nro_cuenta%TYPE := NULL;
  v_cod_mon_credito  ba_monedas.cod_moneda%TYPE := NULL;
  v_ref_pago         bw_pag_servicios.ref_pago%TYPE := NULL;
  v_xml             xmltype;
  -- cambios para servicios criticos
  v_operacion   VARCHAR2(3) := NULL;
  v_abre_oper   ba_cod_referencias.abreviatura%TYPE :=NULL;
  v_proveedor VARCHAR2(10) := p_proveedor;

  v_estado         bw_mov_pendientes.estado%TYPE;
 -- v_fec_actual      DATE:= pag_cal.fu_obt_fec_actual(3);
  MSG_CTA_NO_CORRESP   CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND'; --Nro. de Cuenta no corresponde al cliente
  MSG_INS_MOV_ER       CONSTANT VARCHAR2(15) := 'INS_MOV_ER';
  SER_CTA_DEB_INVALID  CONSTANT VARCHAR2(15) := 'CTA_DEB_INVALID';
  MSG_COD_TRA_INVALIDA CONSTANT VARCHAR2(15) := 'COD_TRA_INVALID';
  MOV_DUP_SERVICIO     CONSTANT VARCHAR2(15) := 'MOV_DUP_SERV';
  SER_PER_SIN_AUT      CONSTANT VARCHAR2(15) := 'SER_PER_SIN_AUT';
  MSG_CTA_CONJUNTA     CONSTANT VARCHAR2(15) := 'CTA_CONJUNTA';

  FUNCTION lf_verificarPagoPendiente(p_token IN VARCHAR2, p_codPersonaVinculada IN VARCHAR2) RETURN NUMBER IS
     --v_ret            NUMBER(2) := 0;
     v_nro_documento  bw_mov_pendientes.nro_documento%TYPE;
     v_aut_pendientes bw_mov_pendientes.can_aut_faltantes%TYPE := 0;
     v_dato2          bw_mov_pendientes.dato2%TYPE;
  BEGIN

     BEGIN
        SELECT p.nro_documento, p.can_aut_faltantes,p.estado,p.dato2
          INTO v_nro_documento, v_aut_pendientes,v_estado,v_dato2
          FROM bw_mov_pendientes p
         WHERE p.cod_tip_mensaje = v_cod_operacion
           AND p.cod_per_principal = p_codPersonaVinculada
           AND p.dato = p_token;

         if(v_estado<>'P') then
            if v_estado in ('C', 'E') and v_dato2 is null then -- si la operacion se confirmo pero todavia no se proceso
               return -2;
            elsif v_estado in ('C', 'E') and v_dato2 is not null then
               return -3;
            end if;
            return -1;
         end if;

     EXCEPTION
        WHEN OTHERS THEN
           return v_can_aut_requeridas;
     END;

     RETURN v_aut_pendientes;
  END;

  -- Permite Verificar Operaciones
   FUNCTION lf_verificarPago(p_sesion VARCHAR2, p_cuenta VARCHAR2, p_numeroIp VARCHAR2, p_monto NUMBER, p_cod_moneda VARCHAR2, p_modo VARCHAR2)
      RETURN typ_pagoServiciosWs IS
    v_pagoServicio typ_pagoServiciosWs := typ_pagoServiciosWs;
  BEGIN
    v_abre_oper := paw_uti.fu_obt_abr_refcodes('SERVICIOS_CRITICOS', p_servicio, v_proveedor);
    IF v_abre_oper = p_servicio THEN
       v_operacion := '091';
    ELSE
       v_operacion := '088';
    END IF;
    v_resLimite := fu_obtenerLimite(userinfo,
                                    v_operacion,
                                    nvl(userinfo.codigoEmpresa, userinfo.codigoPersona),
                                    p_cuenta,
                                    p_cod_moneda,
                                    v_cod_transaccion,
                                    v_cod_tra_padre,
                                    p_monto,
                                    p_modo);

    v_pagoServicio.error                := v_resLimite.error;
    v_pagoServicio.nombreRespuesta      := v_resLimite.nombreRespuesta;
    v_pagoServicio.descripcionRespuesta := v_resLimite.descripcionRespuesta;
    v_pagoServicio.firmasPendientes:=v_can_aut_requeridas;
    IF v_resLimite.error = 'S' THEN
      pr_insertarBitacora(userinfo.codigoPersona,
                          userinfo.codigoCanal,
                          p_sesion,
                          v_operacion,
                          userinfo.codigoEmpresa,
                          v_msj_bitacora || ' ' ||
                          fu_generarBitacora(v_pagoServicio.error, v_pagoServicio.nombreRespuesta, v_pagoServicio.descripcionRespuesta, NULL),
                          BITACORA_ERROR);
      return v_pagoServicio;
    ELSE
      v_pagoServicio.respuestaLimite := v_resLimite.codRespuesta;
    END IF;
    IF v_modo = 'V' THEN
       -- Crea el numero de sesion e insertar en bw_sesiones
       v_claveSesion := paw_bce.fu_enc_md5(p_sesion ||round(dbms_random.value(1000000, 9999999)));

       IF pag_ser.fu_ins_sesion(v_claveSesion, p_numeroIp, userinfo.codigoPersona, userinfo.codigoEmpresa, p_cuenta) = 'S' THEN
          v_pagoServicio.numeroSesion := v_claveSesion;
          pr_insertarBitacora(userinfo.codigoPersona,
                            userinfo.codigoCanal,
                            p_sesion,
                            v_cod_operacion,
                            userinfo.codigoEmpresa,
                            v_msj_bitacora || ' '||fu_generarBitacora(v_pagoServicio.error, v_pagoServicio.nombreRespuesta, v_pagoServicio.descripcionRespuesta, NULL),
                            BITACORA_SALIDA);
       ELSE
          --MSG_INS_MOV_ER
          pr_mensajeUsuario(MSG_INS_MOV_ER, v_pagoServicio.nombreRespuesta, v_pagoServicio.descripcionRespuesta, v_pagoServicio.error);
          pr_insertarBitacora(userinfo.codigoPersona,
                             userinfo.codigoCanal,
                             p_sesion,
                             v_cod_operacion,
                             userinfo.codigoEmpresa,
                             v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' ||
                             fu_generarBitacora(v_pagoServicio.error, v_pagoServicio.nombreRespuesta, v_pagoServicio.descripcionRespuesta, NULL),
                             BITACORA_ERROR);
       END IF;
    END IF;
    RETURN v_pagoServicio;
  END;
  -- Fin de LP_VER_OPERACION

BEGIN
  IF p_proveedor = 2 THEN -- SET
     RETURN fu_pagoSet(p_sesion,
                       p_codigoCanal,
                       p_modo,
                       p_cuentaDebito,
                       p_numeroTransaccion,
                       p_extra,  -- XML boleta de pago SET
                       p_claveTransaccional,
                       p_claveToken);
  ELSIF p_proveedor = 3 THEN -- Bancard
     RETURN fu_pagoBancardWs(p_sesion,
                             p_codigoCanal,
                             p_modo,
                             p_cuentaDebito,
                             p_numeroIp,
                             p_sesionServicios,
                             p_numeroTransaccion,
                             p_servicio,
                             p_terminal,
                             p_moneda,
                             p_monto,
                             p_importeComision,
                             p_claveTransaccional,
                             p_claveToken,
                             p_tokenServicios,
                             p_proveedor,
                             p_extra);
  ELSIF p_proveedor = 4 THEN
      -- BancardPM
      RETURN fu_pagoBancardPMWs(p_sesion,
                                p_codigoCanal,
                                p_modo,
                                p_cuentaDebito,
                                p_numeroIp,
                                p_sesionServicios,
                                p_numeroTransaccion,
                                p_servicio,
                                p_terminal,
                                p_moneda,
                                p_monto,
                                p_importeComision,
                                p_claveTransaccional,
                                p_claveToken,
                                p_tokenServicios,
                                p_proveedor,
                                p_extra);
  END IF;
  v_modo           := substr(p_modo, 0, 1);
  v_mto_credito    := depurarNumerico(p_monto, 21);
  v_codCanal       := depurarNumerico(p_codigoCanal, 3);
  v_nro_cta_debito := depurarAlfanumerico(p_cuentaDebito, CUENTA_TAMANO);
  v_hora           := to_char(systimestamp, 'HH:mi:ss');
  v_fecha          := to_char(systimestamp, 'dd/MM/yyyy');
  v_terminal       := depurarAlfanumerico(p_terminal, 20);
  v_sesionServicios := depurarAlfanumerico(p_sesionServicios, 32);
  pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
  --mensaje con parametros
  v_msj_bitacora := substr('modo:' || v_modo || ', mto:' || v_mto_credito || ', cta:' || v_nro_cta_debito || ', fecha:' || v_fecha || ', hora:' || v_hora ||
                           ', term:' || v_terminal || ', mon:' || v_moneda || ', serv:' || p_servicio || ', nroTran:' || p_numeroTransaccion ||
                           ', nroLote:' || p_numeroLote || ', impCom:' ||
                           p_importeComision || ' impMora:' || p_importeMora || ', impInt:' || p_importeInteres || ', tokSer:' ||
                           p_tokenServicios || ', provr: ' || p_proveedor || ', sesServ: ' || v_sesionServicios, 1, 600);

  -- 1. valido la clave del cliente
  userinfo := fu_validarSesion(p_sesion, v_codCanal);
  --Logear parámetros
  IF (userInfo.error = 'S') THEN
    v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
    v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
    v_retorno.error                := 'S';
    RETURN v_retorno;
  END IF;

  -- Verifica si el usuario tiene acceso a la opcion y en que condicion
   v_permiso := lf_obt_permisos(userinfo, v_cod_operacion);

  IF (v_permiso.error = 'S') THEN
    v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
    v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
    v_retorno.error                := v_permiso.error;
    RETURN v_retorno;
  END IF;

  IF v_permiso.registra = FALSE AND v_permiso.autoriza = FALSE THEN
     pr_mensajeUsuario(SER_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userInfo.codigoPersona,
                          p_codigoCanal,
                          p_sesion,
                          v_cod_operacion,
                          userInfo.codigoEmpresa,
                          v_msj_bitacora || ' ' ||
                          fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                          BITACORA_ERROR);
     RETURN v_retorno;
  END IF;


  -- Verifica el canal de origen
  v_mensajeCaja := lf_val_caja(userinfo);

  IF v_mensajeCaja.error = 'S' THEN
    v_retorno.error                := v_mensajeCaja.error;
    v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
    v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
    RETURN v_retorno;
  END IF;

   pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, p_sesion, v_cod_operacion, userInfo.codigoEmpresa, v_msj_bitacora, BITACORA_ENTRADA);

  --Validar cuenta debito

  IF lf_val_cta_origen(v_nro_cta_debito, nvl(userinfo.codigoEmpresa, userinfo.codigoPersona)) = 'N' THEN
    -- no es una cuenta del cliente
    pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
    pr_insertarBitacora(userinfo.codigoPersona,
                        v_codCanal,
                        p_sesion,
                        v_cod_operacion,
                        userinfo.codigoEmpresa,
                        'lf_val_cta_origen(deb) - ' || v_nro_cta_debito || ' ' ||
                          fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                        BITACORA_ERROR);
  END IF;
  BEGIN

    --Verifica que se pueda debitar de la cuenta
    SELECT a.nro_cuenta, a.cod_moneda
      into v_cuentaAux, v_cod_mon_debito
      FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
     WHERE a.nro_cuenta = b.nro_cuenta
       AND b.relacion IN ('O', 'P')
       AND b.cod_persona = nvl(userinfo.codigoEmpresa, userinfo.codigoPersona)
       and a.nro_cuenta = v_nro_cta_debito
       AND a.cod_modulo = c.cod_modulo
       AND a.cod_modalidad = c.cod_modalidad
       AND b.cod_modulo != 7
       and b.cod_modalidad IN (31, 41, 334)
       AND c.activo = 'S' -- solo cuentas activas
       AND a.estado not in ('X', 'A', 'T', 'D', 'C', 'V', 'P', 'B')
       AND a.estado = c.estado;

      --Valida que la cuenta no sea conjunta
      IF PAW_BAS.fu_es_conjunta(v_cuentaAux, v_can_aut_requeridas) = 'S' THEN
         pr_mensajeUsuario(MSG_CTA_CONJUNTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona,
                   userinfo.codigoCanal,
                   p_sesion,
                   v_cod_operacion,
                   userinfo.codigoEmpresa,
                   v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                   BITACORA_ERROR);
         -- se intenta dejar en pendiente si corresponde
         IF userinfo.codigoEmpresa IS NOT NULL AND v_modo = 'C' THEN
            paw_can.pr_act_pendiente(userinfo.codigoPersona, userinfo.codigoEmpresa, v_cod_operacion, p_tokenServicios);
         END IF;
         RETURN v_retorno;
      END IF;
  EXCEPTION
    WHEN OTHERS THEN
       pr_mensajeusuario(SER_CTA_DEB_INVALID, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarbitacora(userinfo.codigoPersona,
                          v_codCanal,
                          p_sesion,
                          v_cod_operacion,
                          userinfo.codigoEmpresa,
                          'Pago de Servicios. - ' || SQLERRM,
                          bitacora_error);

      RETURN v_retorno;
  END;
  -- obtenemos la moneda del servicio a pagar
  IF pag_ser.fu_obt_cta_credito(p_proveedor, p_moneda, v_nro_cta_credito, v_cod_mon_servicio) <> 0 THEN
     pr_mensajeusuario(MSG_COD_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarbitacora(userinfo.codigoPersona,
                         v_codCanal,
                         p_sesion,
                         v_cod_operacion,
                         userinfo.codigoEmpresa,
                         'Moneda inv - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                         BITACORA_ERROR);

      RETURN v_retorno;
  END IF;

  BEGIN
     SELECT a.cod_moneda
       INTO v_cod_mon_credito
       FROM ge_cuentas a
      WHERE a.nro_cuenta = v_nro_cta_credito;
      IF v_cod_mon_credito <> v_cod_mon_servicio THEN
         pr_mensajeusuario('CTA_CRE_VER_OPE', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarbitacora(userinfo.codigoPersona,
                         v_codCanal,
                         p_sesion,
                         v_cod_operacion,
                         userinfo.codigoEmpresa,
                         v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                         BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
  EXCEPTION
     WHEN OTHERS THEN
        pr_mensajeusuario('OBT_CTA_ER', v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarbitacora(userinfo.codigoPersona,
                         v_codCanal,
                         p_sesion,
                         v_cod_operacion,
                         userinfo.codigoEmpresa,
                         v_msj_bitacora || ', ORA-ERR:[' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                         BITACORA_ERROR);
        RETURN v_retorno;
  END;

  -- moneda diferentes
  IF v_cod_mon_servicio <> v_cod_mon_debito THEN
     -- Verifica que no pueda realizar cambio de monedas en fecha distinta a la fecha actual
     BEGIN
        pr_con_mon_a_moneda(v_cod_mon_servicio,
                            v_cod_mon_debito,
                            v_mto_credito,
                            v_mto_debito,
                            v_cot_credito,
                            v_cot_debito,
                            'S'); -- VENTA
      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeusuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarbitacora(userinfo.codigoPersona,
                         v_codCanal,
                         p_sesion,
                         v_cod_operacion,
                         userinfo.codigoEmpresa,
                         v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                         BITACORA_ERROR);

            RETURN v_retorno;
      END;

      IF v_mto_credito <= 0 OR v_mto_debito <= 0 THEN
         pr_mensajeusuario(MSG_COD_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarbitacora(userinfo.codigoPersona,
                         v_codCanal,
                         p_sesion,
                         v_cod_operacion,
                         userinfo.codigoEmpresa,
                         v_msj_bitacora || ', mtoDebInvalido: ' || v_mto_debito || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                         BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
   ELSE
      -- Se iguala el monto por que la Moneda Credito y Debito es igual
      v_mto_debito := v_mto_credito;
   END IF;

  --Fin Validar cuenta debito
  --verificar limites y/o crear sesion
   IF v_modo <> 'G' THEN
      v_retorno := lf_verificarPago(p_sesion, v_nro_cta_debito, p_numeroIp, v_mto_debito, v_cod_mon_debito, v_modo);

      IF v_retorno.error = 'S' THEN
         RETURN v_retorno;
      END IF;
   END IF;

   if(v_can_aut_requeridas>0) then
     v_aut_pendientes:=lf_verificarPagoPendiente(p_tokenServicios, userInfo.codigoEmpresa);
     if v_aut_pendientes=-1 then
             pr_mensajeusuario(SER_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

               pr_insertarbitacora(userinfo.codigoPersona,
                          v_codCanal,
                          p_sesion,
                          v_cod_operacion,
                          userinfo.codigoEmpresa,
                          'Operacion Ya procesada' || SQLERRM,
                          bitacora_error);
             return v_retorno;
   END IF;
    if v_aut_pendientes=-2 then
    v_aut_pendientes:=0;
    end if;
   else
     v_aut_pendientes:=0;
   end if;

  --Verificar limites
  IF v_modo = 'V' THEN
    return v_retorno;
  END IF;

   IF v_modo = 'G' THEN
      IF v_aut_pendientes > 0 then
             pr_mensajeusuario(SER_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

               pr_insertarbitacora(userinfo.codigoPersona,
                          v_codCanal,
                          p_sesion,
                          v_cod_operacion,
                          userinfo.codigoEmpresa,
                          'Pago de Servicios.- UK_du' || SQLERRM,
                          bitacora_error);
             return v_retorno;
      end if;
      --cambiar a update
      --pr_mensajeusuario(v_ser_respuesta,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
      BEGIN
         UPDATE bw_pag_servicios
            SET cod_servicio = p_servicio, nro_transaccion = p_numeroTransaccion, nro_lote = p_numeroLote, terminal = p_terminal,
                /*cod_moneda = pag_gen.fu_obt_mon_local,*/ mto_comision = p_importeComision, mto_mora = p_importeMora, mto_interes = p_importeInteres,
                reversado = 'N', cod_mon_servicio = p_moneda, nro_sesion = substr(trim(p_sesion), 1, 32)
          WHERE COD_WS_SERVICIOS = p_tokenServicios
            AND NRO_CUENTA=v_nro_cta_debito
            AND nvl(reversado, 'N') = 'N';
         lp_act_movimiento(p_tokenServicios,p_numeroLote, p_numeroTransaccion, p_servicio, v_nro_cta_debito, v_mensajeCaja);
      EXCEPTION
      /*Ini - Captura pago duplicado*/
      /*10/01/2014*/
         WHEN DUP_VAL_ON_INDEX THEN
            pr_mensajeusuario(MOV_DUP_SERVICIO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarbitacora(userinfo.codigoPersona,
                          v_codCanal,
                          p_sesion,
                          v_cod_operacion,
                          userinfo.codigoEmpresa,
                          v_msj_bitacora || ', DUP-VAL-ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || ']',
                          bitacora_error);
             return v_retorno;
         WHEN OTHERS THEN
            pr_mensajeusuario(MOV_DUP_SERVICIO,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);

            pr_insertarbitacora(userinfo.codigoPersona,
                          v_codCanal,
                          p_sesion,
                          v_cod_operacion,
                          userinfo.codigoEmpresa,
                          v_msj_bitacora || ', OTHERS-ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || ']',
                          bitacora_error);
             return v_retorno;

      END;
      /*Fin - Captura pago duplicado*/
      pr_insertarbitacora(userinfo.codigoPersona,
                          v_codCanal,
                          p_sesion,
                          v_cod_operacion,
                          userinfo.codigoEmpresa,
                          v_msj_bitacora||', SesSer:' || v_retorno.numeroSesion || ', resLim:' || v_retorno.respuestaLimite ||
                          fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                          BITACORA_SALIDA);
    return v_retorno;
  END IF;

/*
En modo C tiene que insertar en movimientos pendientes no en bw_pag_servicios
*/
  IF v_retorno.respuestaLimite IN ('10', '11') AND nvl(v_estado, 'x') <> 'E' THEN
     -- clave transaccional requerida
     v_retError := lf_obt_cla_validar(p_claveTransaccional, userinfo.codigoPersona, userinfo.codigoEmpresa, 'T');
  END IF;

  IF nvl(v_retError.error, 'N') = 'N' THEN
      IF v_retorno.respuestaLimite IN ('01', '11') AND nvl(v_estado, 'x') <> 'E' THEN
      -- token requerido
         v_retError := paw_seg.fu_obt_tok_validar(p_claveToken, userinfo.codigoPersona, userinfo.codigoEmpresa, 'C');
    END IF;
  END IF;
  IF v_retError.error = 'S' THEN
    -- fallo en la confirmacion por clave invalida, volver a dejar pendiente la operacion
    IF v_modo = 'C' AND v_aut_pendientes = 0 AND userinfo.codigoEmpresa IS NOT NULL THEN
       paw_can.pr_act_pendiente(userinfo.codigoPersona, userinfo.codigoEmpresa, v_cod_operacion, p_tokenServicios);
    END IF;

    v_retorno.error                := v_retError.error;
    v_retorno.nombreRespuesta      := v_retError.nombreRespuesta;
    v_retorno.descripcionRespuesta := v_retError.descripcionRespuesta;
    pr_insertarBitacora(userinfo.codigoPersona,
                        v_codCanal,
                        p_sesion,
                        v_cod_operacion,
                        userinfo.codigoEmpresa,
                        v_msj_bitacora || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                        BITACORA_ERROR);
    RETURN v_retorno;
  END IF;
  IF v_modo='C' and v_aut_pendientes > 0 then
    IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_servicio
       AND v_cod_mon_servicio = v_cod_mon_local THEN
       v_mto_equ_local := v_mto_credito;
    ELSE
       v_mto_equ_local  := null;
    END IF;

     SELECT s_nro_documento.NEXTVAL
       INTO v_nro_documento
       FROM dual;

    INSERT INTO bw_mov_pendientes
       (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje,
        nro_cuenta, cod_moneda, descripcion, monto, cotizacion, mto_equ_local,
        nro_cta_contra, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso,
        mto_contra, cot_contra, etiqueta, dato, referencia)
    VALUES
       (v_nro_documento, nvl(userinfo.codigoEmpresa, userinfo.codigoPersona), SYSDATE, v_cod_operacion,
        v_nro_cta_debito, v_cod_mon_debito, 'Pago Servicio', v_mto_debito, v_cot_debito, v_mto_equ_local,
        '', 'P', v_can_aut_requeridas, v_can_aut_requeridas, userinfo.codigoPersona /* v_cod_persona */,
        v_mto_credito, v_cot_credito, 'Token', p_tokenServicios, p_proveedor);

    v_retorno.firmasPendientes:=v_can_aut_requeridas;
    pr_mensajeusuario(MSG_OK,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
    v_retorno.nroDocumento:=v_nro_documento;
    pr_insertarbitacora(userinfo.codigoPersona,
                        v_codCanal,
                        p_sesion,
                        v_cod_operacion,
                        userinfo.codigoEmpresa,
                        v_msj_bitacora || ', firReq: ' || v_can_aut_requeridas ||
                            fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                        BITACORA_SALIDA);
    RETURN v_retorno;
  END IF;
  IF p_extra IS NOT NULL THEN
       v_xml := xmltype.createxml(p_extra);
       -- parseamos los datos de entrada
       v_ref_pago  := v_xml.extract('/DATOS/nroTelefono/text()').getStringVal();
  ELSE
       v_ref_pago := null;
  END IF;

  --Fin Verificar limites
  IF v_modo = 'C' AND v_aut_pendientes = 0 THEN
     -- se confirma directamente la operacion, porque no requiere autorizacion
     v_modo := 'A'; -- CONFIRMACION
  END IF;

  IF v_modo = 'A' THEN
     --Vino como confirmar y tiene 0 firmas pendientes
     --Pagar el servicio
     SELECT s_pag_servicio.NEXTVAL
       INTO v_nro_documento
       FROM dual;

     v_pagServicios := PAG_SER.fu_PagoServicios(userinfo.codigoPersona,
                                                userinfo.codigoEmpresa,
                                                v_sesionServicios,
                                                p_servicio,
                                                v_nro_cta_debito,
                                                p_numeroTransaccion,
                                                p_numeroLote,
                                                p_numeroIp,
                                                v_terminal,
                                                v_moneda,
                                                v_mto_credito,
                                                p_importeComision,
                                                p_importeMora,
                                                p_importeInteres,
                                                p_tokenServicios,
                                                p_proveedor,
                                                v_mto_debito,
                                                v_cot_debito,
                                                v_cot_credito,
                                                v_nro_documento,
                                                v_ref_pago);


     CASE
        WHEN v_pagServicios = 0 THEN
           v_ser_respuesta := 'OP_APROBADA';
           UPDATE bw_pag_servicios SET COD_PERSONA = userinfo.codigoPersona, COD_EMPRESA = userinfo.codigoEmpresa  WHERE COD_WS_SERVICIOS = p_tokenServicios;
        WHEN v_pagServicios = 1 THEN
           v_ser_respuesta := 'CTA_DEB_INVALID';
        WHEN v_pagServicios = 2 THEN
           v_ser_respuesta := 'G_CODTRAPROHIB';
        WHEN v_pagServicios = 3 THEN
           v_ser_respuesta := 'COD_SAL_INSUF';
        WHEN v_pagServicios = 4 THEN
           v_ser_respuesta := 'OBT_CTA_ER';
        WHEN v_pagServicios = 5 THEN
           v_ser_respuesta := 'SER_PAG_DUP';
        WHEN v_pagServicios = 6 THEN
           v_ser_respuesta := 'G_ERR_LIM_OPERA';
        WHEN v_pagServicios = 7 THEN
           v_ser_respuesta := 'CTA_CRE_VER_OPE';
        WHEN v_pagServicios = 8 THEN
           v_ser_respuesta := 'CTA_CRE_VER_OPE';
        WHEN v_pagServicios = 11 THEN
           v_ser_respuesta := 'SER_PAG_DUP';
        WHEN v_pagServicios = 12 THEN
           v_ser_respuesta := 'HOR_SIS_CIERRE';
        ELSE
           v_ser_respuesta := 'OP_ERROR';
     END CASE;

     pr_mensajeusuario(v_ser_respuesta,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
     IF v_pagServicios = 0 THEN
        BEGIN
           UPDATE bw_mov_pendientes p
              SET dato2 = p_tokenServicios
            WHERE p.cod_tip_mensaje = v_cod_operacion
              AND p.cod_per_principal = userinfo.codigoEmpresa
              AND p.dato = p_tokenServicios
              AND p.estado IN ('C', 'E');
        EXCEPTION
           WHEN OTHERS THEN
              NULL;
        END;
        v_retorno.firmasPendientes:=0;
        v_retorno.nroDocumento := v_nro_documento;
     ELSE
        -- volvemos a dejar pendiente para intentar reautorizar mas tarde
        IF userinfo.codigoEmpresa IS NOT NULL THEN
           paw_can.pr_act_pendiente(userinfo.codigoPersona, userinfo.codigoEmpresa, v_cod_operacion, p_tokenServicios);
        END IF;
     END IF;

     IF v_pagServicios = 0 THEN
         lp_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/,
                          v_cod_mon_debito /*p_cod_moneda */,
                          v_mto_debito /*p_monto*/,
                          v_nro_cta_credito /*p_nro_cta_contra*/,
                          NULL /*p_cantidad*/,
                          'Ses.Ser' /*p_etiqueta*/,
                          p_sesionServicios /*p_dato*/,
                          'TokenSer',
                          p_tokenServicios ,
                          'Yaguarete - modo' || p_modo || ', monCre: '||v_cod_mon_credito,
                          NULL,
                          '000',
                          userinfo.codigoPersona,
                          v_cod_operacion,
                          v_nro_documento,
                          p_codigoCanal,
                          p_sesion,
                          userinfo.codigoEmpresa);
     END IF;
  END IF;

  v_msj_bitacora := substr(v_msj_bitacora || ', cotDeb: ' || v_cot_debito
                                          || ', cotCre: '||v_cot_credito
                                          || ', mtoDeb: ' || v_mto_debito
                                          || ', aut_pen: ' || v_aut_pendientes
                                          || ', ser_code: '||v_pagServicios
                                          || ', fPen: ' || v_retorno.firmasPendientes
                                          || ', nroDoc: ' || v_retorno.nroDocumento, 1, 600);

  IF v_retorno.error = 'N' THEN
     pr_insertarbitacora(userinfo.codigoPersona, v_codCanal, p_sesion, v_cod_operacion,
                         userinfo.codigoEmpresa, v_msj_bitacora || ' '||
                         fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                         BITACORA_SALIDA);
  ELSE
     pr_insertarbitacora(userinfo.codigoPersona, v_codCanal, p_sesion, v_cod_operacion,
                         userinfo.codigoEmpresa, v_msj_bitacora || ' '|| ', PAG_SER :[' || nvl(substr(PAG_ser.v_msj_respuesta, 1, 200), ' ') || '] ' ||
                         fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                         BITACORA_ERROR);
  END IF;
  RETURN v_retorno;
EXCEPTION
   WHEN OTHERS THEN
      pr_mensajeusuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarbitacora(userinfo.codigoPersona,
                         v_codCanal,
                         p_sesion,
                         v_cod_operacion,
                         userinfo.codigoEmpresa,
                         v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                         BITACORA_ERROR);
      RETURN v_retorno;
END;

FUNCTION fu_reversarPagoServiciosWs(p_sesion IN VARCHAR2, p_codigoCanal IN VARCHAR2, p_sesionServicios IN VARCHAR2, p_tokenServicios VARCHAR2) RETURN typ_mensajerespuesta IS
   v_msj_bitacora  VARCHAR2(200);
   v_cod_operacion VARCHAR2(3) := '088';
   userinfo        typ_validarSesion;
   v_retorno       typ_mensajerespuesta := typ_mensajerespuesta;
   v_mensajeCaja   typ_mensajeCaja;
   --v_retError      typ_mensajerespuesta;
   v_permiso       typ_obtenerPermisos;
   v_sesion        VARCHAR2(32);
   v_codCanal      VARCHAR2(3) := depurarNumerico(p_codigoCanal, 3);
   v_mensajePago   VARCHAR2(300);
   v_respuestaRev  NUMBER(3);
   v_nro_documento bw_movimientos.nro_documento%TYPE;
   SER_REV_EXPIRO CONSTANT VARCHAR2(15) := 'SER_REV_EXPIRO';
   SER_REV_CIERRE CONSTANT VARCHAR2(15) := 'SER_REV_CIERRE';
   SER_REV_NOOPE  CONSTANT VARCHAR2(15) := 'SER_REV_NOOPE';
   --SER_REV_OTRO   CONSTANT VARCHAR2(15) := 'SER_REV_OTRO';
   v_respuesta VARCHAR2(15) := '';
   v_cod_proveedor bw_pag_servicios.cod_proveedor%TYPE;
   v_horario      VARCHAR2(1) := 'S';
BEGIN
   v_msj_bitacora := substr('reversa sesion:' || p_sesionServicios || ' tokenServicios:' || p_tokenServicios , 1, 200);
   v_sesion       := depurarAlfanumerico(p_sesion, 32);
   -- 1. valido la clave del cliente
   userinfo := fu_validarSesion(p_sesion, v_codCanal);
   --Logear parámetros
   IF (userInfo.error = 'S') THEN
      -- verificamos si no es la reversa del reintento del API de pagos
      IF p_sesion <> trim(fug_obt_pardinamico('SET_GATEWAY_API')) THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      ELSE -- se reversa porque no se pudo reintentar el pago con el proveedor
         SELECT a.cod_persona
           INTO userinfo.codigoPersona
           FROM ge_par_generales a
          WHERE rownum = 1;
         userinfo.codigoEmpresa := NULL;
         userinfo.codigoCanal   := '999';
         userinfo.error := 'N';
         v_horario := 'N';
         v_sesion  := 'xxxxxxxxxx';
      END IF;
   END IF;

   -- Verifica si el usuario tiene acceso a la opcion y en que condicion
   v_permiso := lf_obt_permisos(userinfo, v_cod_operacion);

   IF (v_permiso.error = 'S') THEN
      IF p_sesion <> trim(fug_obt_pardinamico('SET_GATEWAY_API')) THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         RETURN v_retorno;
      END IF;
   END IF;

   -- Verifica el canal de origen
   v_mensajeCaja := lf_val_caja(userinfo);

   IF v_mensajeCaja.error = 'S' THEN
      v_retorno.error                := v_mensajeCaja.error;
      v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
      RETURN v_retorno;
   END IF;

   -- valido el proveedor
   SELECT s.cod_proveedor
     INTO v_cod_proveedor
     FROM bw_pag_servicios s
    WHERE s.cod_ws_servicios = p_tokenServicios
      AND rownum = 1;

    --guardamos en la bitácora
    pr_insertarBitacora(userInfo.codigoPersona,
                        v_codCanal,
                        v_sesion,
                        v_cod_operacion,
                        userInfo.codigoEmpresa,
                        v_msj_bitacora,
                        BITACORA_ENTRADA);

    --si es pago a Bancard Pago Móvil solo se marca como reversado bw_pag_servicios
    -- ya que la reversa se hace a pedido de bancard y no a traves de pag_ser.fu_PagoServiciosReversa
    IF v_cod_proveedor = 4 THEN
      BEGIN
        --actualizar registro del pago de servicio
        UPDATE bw_pag_servicios s
           SET s.reversado = 'S'
         WHERE s.cod_ws_servicios = p_tokenServicios
           AND s.reversado = 'N';
        -- si es empresa, se disponibiliza el documento
        IF userInfo.codigoEmpresa IS NOT NULL THEN
           paw_can.pr_act_pendiente(userinfo.codigoPersona, userinfo.codigoEmpresa, v_cod_operacion, p_tokenServicios, v_cod_proveedor);
        END IF;
        pr_mensajeUsuario(MSG_OK,
                          v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta,
                          v_retorno.error);
        return v_retorno;
      END;
   --si es pago a la SET
   ELSIF v_cod_proveedor = 2 THEN
      v_cod_operacion := '034';
   END IF;

   pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, v_msj_bitacora, BITACORA_ENTRADA);
   --- Hacer la reversion
   v_respuestaRev := PAG_SER.fu_PagoServiciosReversa(p_tokenServicios, v_mensajePago, v_horario);
   CASE
      WHEN v_respuestaRev = 0 THEN
         v_respuesta := 'OP_APROBADA';

         -- si es empresa, se disponibiliza el documento
         IF userInfo.codigoEmpresa IS NOT NULL THEN
            paw_can.pr_act_pendiente(userinfo.codigoPersona, userinfo.codigoEmpresa, v_cod_operacion, p_tokenServicios, v_cod_proveedor);
         END IF;
      WHEN v_respuestaRev = 12 THEN
         v_respuesta := SER_REV_CIERRE;
      WHEN v_respuestaRev = 11 THEN
         v_respuesta := SER_REV_EXPIRO;
      WHEN v_respuestaRev = -2 THEN
         v_respuesta := SER_REV_NOOPE;
      WHEN v_respuestaRev = -3 THEN
         v_respuesta := MSG_ERROR;
      WHEN v_respuestaRev = -4 THEN
         v_respuesta := MSG_ERROR;
      WHEN v_respuestaRev = -5 THEN
         v_respuesta := MSG_ERROR;
   END CASE;
   v_msj_bitacora := substr(' v_respuestaRev:' || v_respuestaRev || ' v_mensajePago:' || v_mensajePago || ' v_respuesta:' || v_respuesta, 1, 200);
   IF v_respuestaRev <> 0 THEN
       pr_mensajeUsuario(v_respuesta, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || ']', BITACORA_ERROR);
       RETURN v_retorno;
   END IF;
   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
   pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, v_msj_bitacora, BITACORA_SALIDA);
   SELECT s_nro_ope_homebanking.Nextval
     INTO v_nro_documento
     FROM dual;
   lp_reg_operacion(NULL /*p_nro_cuenta*/,
                    NULL /*p_cod_moneda */,
                    NULL /*p_monto*/,
                    NULL /*p_nro_cta_contra*/,
                    NULL /*p_cantidad*/,
                    'Ses.Ser' /*p_etiqueta*/,
                    p_sesionServicios /*p_dato*/,
                    'TokenSer',
                    p_tokenServicios ,
                    'Reversion ',
                    NULL,
                    '000',
                    userinfo.codigoPersona,
                    v_cod_operacion,
                    v_nro_documento,
                    p_codigoCanal,
                    v_sesion,
                    userinfo.codigoEmpresa);
   RETURN v_retorno;
EXCEPTION
   WHEN OTHERS THEN
      pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, v_msj_bitacora  || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || ']', BITACORA_SALIDA);
END;

   -- Obtencion de linea de credito
   FUNCTION fu_obtenerLineaCredito(p_sesion      IN VARCHAR2,
                                   p_codigoCanal IN VARCHAR2) RETURN typ_lineaCredito IS
      v_usu_sesion       typ_validarsesion;
      v_retorno          typ_lineaCredito := typ_lineaCredito();
      v_permiso          typ_obtenerPermisos;
      v_msj_caja         typ_mensajeCaja;
      v_cod_operacion    VARCHAR2(3) := '305';
      G_SIN_DATOS        VARCHAR2(20):='G_SIN_DATOS';
   BEGIN
      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- verificacion de permisos
      v_permiso := lf_obt_permisos(v_usu_sesion, '020');
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'lf_obt_permisos - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- buscamos la linea de credito
      BEGIN
         SELECT p.cod_moneda, p.monto, p.fec_vencimiento, p.fec_otorgamiento,
                p.fec_aprobacion, p.mto_aplicado, p.descripcion, p.cotizacion
           INTO v_retorno.codigoMoneda, v_retorno.monto, v_retorno.fechaVencimiento,
                v_retorno.fechaOtorgada, v_retorno.fechaAprobada, v_retorno.montoAplicado,
                v_retorno.descripcion, v_retorno.cotizacion
           FROM pr_lineas p
          WHERE p.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
            AND p.estado = 'A';
      EXCEPTION
         WHEN NO_DATA_FOUND THEN

            pr_mensajeUsuario(G_SIN_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, SUBSTR(SQLERRM, 1, 200)||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);

         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, SUBSTR(SQLERRM, 1, 200)||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END;
      RETURN v_retorno;
   END;

   -- Validacion y confirmacion de pago de salarios
   FUNCTION fu_pagoSalarios(p_sesion                 IN VARCHAR2,
                            p_codigoCanal            IN VARCHAR2,
                            p_codigoEnte             IN NUMBER,
                            p_modoControl            IN VARCHAR2,
                            p_codigoMoneda           IN VARCHAR2,
                            p_montoTotal             IN NUMBER,
                            p_tipoRemuneracion       IN VARCHAR2,
                            p_cantCuentasParaCredito IN NUMBER,
                            p_canRegistrosLeidos     IN NUMBER,
                            p_parametros             IN CLOB,
                            p_claveTransaccional     IN VARCHAR2,
                            p_claveToken             IN VARCHAR2,
                            p_fecPago                IN DATE) RETURN typ_pagoSalarios IS
      -- datos recibidos
      p_modo             VARCHAR2(1) := substr(p_modoControl, 1, 1); -- modo de control L:ABM V:ARCHIVO
      p_cod_ente         NUMBER(5);
      p_cod_moneda       VARCHAR2(3); -- moneda
      -- comentado por aguara, no se puede obtener este detalle por archivos
      p_tip_remuneracion VARCHAR2(1); -- Tipo de remuneracion
      --comentado por aguara, no se puede obtener este detalle por archivos
      p_can_registros    NUMBER(5); -- cantidad de registros leidos
      v_cta_formateada   VARCHAR2(17); -- cuenta formateada
      v_cod_tip_cuenta   VARCHAR2(2); -- codigo del tipo de cuenta
      v_des_tip_cuenta   VARCHAR2(35); -- descripcion del tipo de cuenta
      v_cod_moneda       VARCHAR2(3); -- moneda de la cuenta
      v_nom_cuenta       VARCHAR2(100); -- nombre de la cuenta
      v_cod_res_cta      VARCHAR2(3); -- respuesta por cada cuenta
      v_nro_cuenta       VARCHAR2(17); -- contiene los numeros de cuentas
      v_monto            NUMBER(16, 2); -- monto del credito
      v_tot_detalles     NUMBER(16, 2) := 0; -- total a debitar
      v_can_detalles     NUMBER := 0; -- cantidad de cuentas
      v_cod_ente         NUMBER(6); -- codigo del ente
      v_des_ente         VARCHAR2(100); -- descripcion del ente
      v_nro_cta_debito   VARCHAR2(17); -- cuenta de debito
      v_registro         VARCHAR2(200);
      v_for_archivo      VARCHAR2(100);
      v_tipo             VARCHAR2(10);
      v_can_creditos     NUMBER(5) := 0; -- Cantidad de Creditos
      v_can_errores      NUMBER(5) := 0;
      v_lon_registro     NUMBER(3) := 102; -- longitud de registro fijo
      v_nro_documento    VARCHAR2(15);
      v_nro_archivo      NUMBER(10); -- Nro de archivo a agrupar
      --v_nro_archivo_tmp  NUMBER(10); -- Nro de archivo auxiliar
      v_redondeo         NUMBER;
      v_can_cta_debito   NUMBER := 0; -- Cantidad de cuentas para débito
      v_dir_correo       ge_par_dinamicos.val_parametro%TYPE;
      v_cod_transaccion  ge_transacciones.cod_transaccion%TYPE;
      v_cod_tra_padre    ge_transacciones.cod_transaccion%TYPE;
      v_cod_operacion    VARCHAR2(3) := '070';
      v_lugar            VARCHAR2(100);
      v_resLimite        typ_respuestaLimite;
      v_fec_actual       DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy;
      v_mensaje          VARCHAR2(100);
      v_usu_sesion       typ_validarsesion;
      v_retorno          typ_pagoSalarios := typ_pagoSalarios();
      v_detalle          typ_detalleSalario := typ_detalleSalario(); -- datos de las cuentas
      v_lis_detalle      typ_listadetallesalario := typ_listadetallesalario();
      v_msj_respuesta    typ_MensajeRespuesta := typ_MensajeRespuesta;
      v_msj_caja         typ_mensajeCaja;
      v_permiso          typ_obtenerPermisos;
      v_nom_beneficiario VARCHAR2(50);
      v_cod_modulo       ge_cuentas.cod_modulo%TYPE;
      v_sal_disponible   ge_cuentas.sal_promedio%TYPE;
      v_traspaso         ge_par_dinamicos.val_parametro%TYPE := 'N';
      v_pos_ant          NUMBER;
      v_pos_nvo          NUMBER;
      v_val_nro_doc      ge_par_entes.val_parametro%TYPE;
      v_nro_doc_credito  ba_personas.nro_documento%TYPE;
      v_nro_doc_generico ge_par_dinamicos.val_parametro%TYPE;
      v_cod_error        NUMBER := 0; -- 0: Ok, 1: Error en cuenta, 2: Error en monto, 3: error en cuenta y monto
      v_mon_debito       NUMBER(16, 2) := 0;

      v_msj_bitacora     VARCHAR2(500) := substr('ente:'||trim(p_codigoEnte)
                                                        ||', modo:'||trim(p_modoControl)
                                                        ||', codMon:'||trim(p_codigoMoneda)
                                                        ||', mtoTot:'||trim(p_montoTotal)
                                                        ||', tipRem:'||p_tipoRemuneracion
                                                        ||', canCtaCre:'||p_cantCuentasParaCredito
                                                        ||', canReg:'||p_canRegistrosLeidos
                                                        ||', fecAct:'||v_fec_actual
                                                        ||', fecPago:'||p_fecPago, 1, 500);

      SAL_PER_SIN_AUT       CONSTANT VARCHAR2(15) := 'SAL_PER_SIN_AUT'; -- perfil sin autorizacion para pagos
      SAL_DAT_ENT_DUPLICADA CONSTANT VARCHAR2(15) := 'SAL_DAT_ENT_DUP'; -- datos de ente duplicada
      SAL_ERR_OBT_DAT_ENTES CONSTANT VARCHAR2(15) := 'SAL_ERR_DAT_ENT'; -- error al obtener datos de ente
      SAL_CTA_INSUFICIENTE  CONSTANT VARCHAR2(15) := 'SAL_CTA_INSUFIC'; -- la cuenta debito no cuenta con fondos
      SAL_ERR_DATOS         CONSTANT VARCHAR2(15) := 'SAL_ERR_DATOS';   -- datos incorrectos en la carga
      SAL_ERR_CTA_DEB_INVAL CONSTANT VARCHAR2(15) := 'SAL_CTA_DEB_INV'; -- cuenta debito invalida
      SAL_CAN_CTA_DEB_INVAL CONSTANT VARCHAR2(15) := 'SAL_CAN_CTA_DEB'; -- cantidad de ctas debito invalida
      SAL_MAX_CAN_CRE_INVAL CONSTANT VARCHAR2(15) := 'SAL_MAX_CRE_INV'; -- cantidad de creditos excedido
      SAL_PED_DUPLICADO     CONSTANT VARCHAR2(15) := 'SAL_PED_DUPLICA'; -- pedido duplicado, aviso
      SAL_CTA_DEB_TERCERO   CONSTANT VARCHAR2(15) := 'SAL_CTA_DEB_TER'; -- cta debito no pertenece al ente
      OPE_NO_PERMITIDA      CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      SAL_FMT_INCORRECTO    CONSTANT VARCHAR2(15) := 'SAL_FMT_INCORRE';
      FEC_PAGO_INVALIDO     CONSTANT VARCHAR2(15) := 'FEC_PAGO_INVAL';
      FEC_AGUINALDO_INVAL   CONSTANT VARCHAR2(15) := 'FEC_AGUINA_INV';
      SAL_MTO_TOT_INVAL     CONSTANT VARCHAR2(15) := 'SAL_MTO_TOT_INV';

   BEGIN
      IF p_modo NOT IN ('L', 'C', 'V') THEN
         pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('xxxxx', p_codigoCanal, p_sesion, v_cod_operacion, NULL, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 1. valido la clave del cliente
      v_lugar := 'Validacion de la clave';
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);

      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);


      -- 2. validacion fecha de pago
      IF p_fecPago IS NULL OR TRUNC(p_fecPago) > TRUNC((SYSDATE + NVL(fug_obt_pardinamico('FEC_PAGO_LIM_NOMINA'), 180))) OR TRUNC(p_fecPago) < trunc(SYSDATE) THEN
         pr_mensajeUsuario(FEC_PAGO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('xxxxx', p_codigoCanal, p_sesion, v_cod_operacion, NULL, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 3. validacion de aguinaldo, no se puede realizar con fecha futura
      IF depurarTextos(p_tipoRemuneracion, 1) = 'A' AND TRUNC(SYSDATE) < TRUNC(p_fecPago) THEN
         pr_mensajeUsuario(FEC_AGUINALDO_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('xxxxx', p_codigoCanal, p_sesion, v_cod_operacion, NULL, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 4. verifica el canal de origen
      v_lugar := 'Validacion de la caja';
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- 5. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_lugar := 'Control de permisos';
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion); --nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), v_usu_sesion.codigoPerfil, v_cod_operacion, v_usu_sesion.codigoCanal);
      v_msj_bitacora := v_msj_bitacora||', perf: ' || v_usu_sesion.codigoPerfil;
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
         pr_mensajeUsuario(SAL_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- 6. Se cargan los parametros recibidos
      v_lugar            := 'Datos del parametro';
      p_cod_ente         := depurarNumerico(p_codigoEnte, 5);
      p_cod_moneda       := depurarTextos(p_codigoMoneda, 3); -- moneda
      --p_tot_debito       := p_montoTotal; -- monto total sueldos
      p_tip_remuneracion := depurarTextos(p_tipoRemuneracion, 1); -- Tipo de remuneracion
      --p_can_cuentas      := p_cantCuentasParaCredito; -- cantidad de cuentas
      p_can_registros    := p_canRegistrosLeidos; -- cantidad de registros leidos
      v_redondeo         := fug_obt_pardinamico('VAL_RED_MON_EXTRANJERA', NULL, NULL, p_cod_moneda, NULL, NULL);
      v_msj_bitacora     := v_msj_bitacora||', red: ' || v_redondeo;

      /*
      IF p_modo <> 'V' THEN
         -- formato fijo, porque se cargo por la pantalla
         v_lon_registro := 102; -- denominacion 50, cuenta 15, monto 16, Tipo Cta (C,D), documento 20
      END IF;
      v_msj_bitacora     := v_msj_bitacora||', lon: ' || v_lon_registro;  */

      -- 7. Verifico si la persona tiene el servicio de pago de sueldos
      v_lugar := 'Datos del Ente';
      IF v_retorno.error = 'N' THEN
         BEGIN
            SELECT a.cod_ente, a.descripcion, fug_obt_parentes(a.cod_ente, 'NRO_CTA_DEBITO'), fug_obt_parentes(a.cod_ente, 'REFERENCIA_TXT_SUELDO'), TRIM(fug_obt_parentes(a.cod_ente, 'VAL_NRO_DOCUMENTO'))
              INTO v_cod_ente, v_des_ente, v_nro_cta_debito, v_for_archivo, v_val_nro_doc
              FROM ge_entes a
             WHERE a.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
               AND a.tipo = 'SU'
               AND a.cod_ente = p_cod_ente
               AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO') = 'S'
               AND fug_obt_parentes(a.cod_ente, 'HAB_HOMEBANKING') = 'S';
         EXCEPTION
            WHEN too_many_rows THEN
               pr_mensajeUsuario(SAL_DAT_ENT_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            WHEN OTHERS THEN
               v_msj_bitacora := v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 100) || ']';
               pr_mensajeUsuario(SAL_ERR_OBT_DAT_ENTES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
         END;
         /* OMM 13/01/2011 --Se agrego esta validaciòn solo para el BBVA por mala
            configuraciòn del OAS de Produccion en ITGF (el parametro "NLS_NUMERIC_CHARACTER" no estaba
            configurado en el OAS por esto se procesa con otro tipo de archivo en USD)   */
         IF v_for_archivo = 'PAG_SUELDOS_USD' THEN
            v_for_archivo := 'PAG_SUELDOS';
         END IF;
      END IF;

      -- 8. Tomo la cantidad de cuentas recibidas
      IF v_retorno.error = 'N' THEN
         IF p_modo = 'C' THEN
            -- obtenemos la secuencia del pago
            v_nro_archivo := paw_bce.fu_obt_nro_sec_sueldo(v_cod_ente, TRUNC(p_fecPago));
            /*IF v_fec_actual <> trunc(SYSDATE) THEN
               v_nro_archivo_tmp := paw_bce.fu_obt_nro_sec_sueldo(v_cod_ente, trunc(sysdate));

               IF v_nro_archivo_tmp > v_nro_archivo THEN
                  v_nro_archivo := v_nro_archivo_tmp;
               END IF;
            END IF;*/
            v_msj_bitacora := v_msj_bitacora || ', nroArc:' || v_nro_archivo;
         END IF;
         -- obtenemos si el ente tiene traspaso de aguinaldo
         IF p_tip_remuneracion = 'A' THEN
            v_traspaso := nvl(fug_obt_parentes(p_cod_ente, 'PAG_TRA_AGUINALDO'), 'N');
         END IF;
         -- obtenemos la transacción padre
         v_cod_tra_padre := fu_obt_tra_sueldo(v_cod_ente, p_tip_remuneracion);
         ---
         v_nro_doc_generico := fug_obt_pardinamico('NRO_DOC_GEN_PAG_SAL');
         v_lugar := 'leyendo los registros';
         v_pos_ant := 1;
         FOR i IN 1 .. p_can_registros
         LOOP
            IF p_modo <> 'V' THEN
               v_registro := substr(p_parametros, 1 + ((i - 1) * v_lon_registro), v_lon_registro);
               -- formato fijo
               v_nom_beneficiario := depurarTextos(substr(v_registro, 1, 50), 50);
               v_nro_cuenta       := depurarTextos(substr(v_registro, 51, 15), 15);
               v_monto            := nvl(to_number(REPLACE(TRIM(substr(v_registro, 66, 16)), ',', '.')), 0);
               v_tipo             := substr(v_registro, 82, 1);
               v_nro_doc_credito  := TRIM(depurarTextos(substr(v_registro, 83), 20));
            ELSE
               v_pos_nvo  := instr(p_parametros, '~', v_pos_ant);
               v_registro := substr(p_parametros, v_pos_ant, v_pos_nvo - v_pos_ant);
               v_pos_ant  := v_pos_nvo + 1;
               -- formato segun archivo
               v_nro_cuenta       := depurarTextos(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_SUELDOS_TMP', v_registro, 'NRO_CUENTA'),15);
               v_monto            := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_SUELDOS_TMP', v_registro, 'MONTO');
               v_tipo             := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_SUELDOS_TMP', v_registro, 'TIPO');
               v_nom_beneficiario := substr(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_SUELDOS_TMP', v_registro, 'NOMBRE'), 1, 50);
               v_nro_doc_credito    := TRIM(depurarTextos(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_SUELDOS_TMP', v_registro, 'NRO_DOCUMENTO'), 20));
            END IF;
            -- OMM 07/10/2010
            IF v_tipo IS NULL OR v_tipo NOT IN ('C', 'D') THEN
               IF v_nro_cuenta = v_nro_cta_debito THEN
                  v_tipo := 'D';
               ELSE
                  v_tipo := 'C';
               END IF;
            END IF;
            IF v_tipo = 'C' THEN
               v_tot_detalles := v_tot_detalles + v_monto;
               v_can_creditos := v_can_creditos + 1;
               --  v_can_detalles   := v_can_detalles + 1; OMM 07/10/2010
            ELSE
               v_mon_debito := v_monto;
               v_nro_cta_debito := v_nro_cuenta;
               v_can_cta_debito := v_can_cta_debito + 1; -- para validar que solo exista una cuenta débito
            END IF;
            v_can_detalles := v_can_detalles + 1;
            -- OMM 06/10/2010
            v_cod_error   := 0;
            v_cod_res_cta := paw_bce.v_cod_aprobado;
            IF v_tipo IN ('C', 'D') THEN
               -- valido la cuenta recibida
               BEGIN
                  v_cta_formateada := NULL;
                  v_cod_tip_cuenta := NULL;
                  v_des_tip_cuenta := NULL;
                  v_nom_cuenta     := NULL;
                  v_cod_moneda     := NULL;
                  v_cod_modulo     := NULL;
                  SELECT fug_cta_formateada(a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.nro_cuenta, a.cod_moneda) cta_formateada, paw_bce.fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) des_tip_cuenta, a.denominacion nom_cuenta, a.cod_moneda cod_moneda, a.cod_modulo
                    INTO v_cta_formateada, v_cod_tip_cuenta, v_des_tip_cuenta, v_nom_cuenta, v_cod_moneda, v_cod_modulo
                    FROM ge_est_cuentas c, ge_cuentas a
                   WHERE a.nro_cuenta = TRIM(v_nro_cuenta)
                     AND a.cod_modulo = c.cod_modulo
                     AND a.cod_modalidad = c.cod_modalidad
                     AND a.estado = c.estado
                     AND c.activo = 'S' -- solo cuentas activas
                     AND a.estado NOT IN ('X', 'C', 'P') -- se controla los estados cerrado y pend. de cancelación
                     AND a.cod_modalidad IN (31, 41, 334); -- solo cuentas de ahorros y cuentas corrientes
                  IF p_cod_moneda <> v_cod_moneda THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_invalida; -- moneda diferente
                     v_mensaje     := 'La moneda de la cuenta es invalida';
                     v_cod_error   := 1;
                  ELSE
                     v_cod_res_cta := paw_bce.v_cod_aprobado;
                     v_mensaje     := 'Aprobado';
                  END IF;
               EXCEPTION
                  WHEN no_data_found THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_inexistente;
                     v_mensaje     := 'Cuenta inexistente';
                     v_cod_error   := 1;
                  WHEN too_many_rows THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_duplicada;
                     v_mensaje     := 'Cuenta duplicada';
                     v_cod_error   := 1;
                  WHEN OTHERS THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                     v_mensaje     := 'Cuenta invalida';
                     v_cod_error   := 1;
               END;
               -- valido que no acredita a cuenta propia
               IF v_cod_res_cta = paw_bce.v_cod_aprobado AND v_tipo = 'C' THEN
                  IF lf_val_cta_origen(v_nro_cuenta, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)) = 'S' THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                     v_mensaje     := 'La cuenta pertenece al ente';
                     v_cod_error   := 1;
                  END IF;
               END IF;

               IF v_traspaso = 'S' AND v_cod_res_cta = paw_bce.v_cod_aprobado AND v_tipo = 'C' THEN
                  -- validamos cuentas de aguinaldo
                  paw_bce.pr_ver_cta_aguinaldo(v_nro_cuenta, v_traspaso, v_cod_error, v_mensaje, 40);
                  IF v_cod_error <> 0 THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                  END IF;
               END IF;

               IF v_monto <= 0 THEN
                  IF v_cod_res_cta = paw_bce.v_cod_aprobado THEN
                     -- monto inválido
                     v_cod_res_cta := paw_bce.v_cod_mto_invalido;
                     v_mensaje     := 'Monto invalido';
                     v_cod_error   := 2;
                  ELSE
                     v_cod_error   := 3;
                     v_mensaje     := v_mensaje || '. Monto Invalido';
                  END IF;
               END IF;
               -- valido los decimales
               IF v_monto > 0 AND v_monto <> trunc(v_monto, v_redondeo) THEN
                  IF v_cod_res_cta = paw_bce.v_cod_aprobado THEN
                     v_cod_res_cta := paw_bce.v_mon_dec_invalida;
                     v_mensaje     := 'La cuenta no admite decimal';
                     v_cod_error   := 2;
                  ELSE
                     v_cod_error   := 3;
                     v_mensaje     := v_mensaje || '. La cuenta no admite decimal';
                  END IF;
               END IF;
                -- se valida el documento con la cuenta si se recibe
               IF v_tipo = 'C' AND v_val_nro_doc = 'S' THEN
                  IF v_nro_doc_generico <> nvl(v_nro_doc_credito, '0') AND pag_sue.fu_ver_cta_documento(v_nro_doc_credito, v_nro_cuenta) = 'N' THEN
                     IF v_cod_res_cta = paw_bce.v_cod_aprobado THEN
                        v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                        v_mensaje   := 'Documento no pertenece a cuenta';
                        v_cod_error := 4;
                     ELSE
                        v_cod_error := v_cod_error + 4;
                        v_mensaje   := substr(v_mensaje || '. Documento no pertenece a cuenta', 1, 100);
                     END IF;
                  END IF;
               END IF;

               -- verificamos si se puede realizar la operación de débito/crédito
               IF v_cod_res_cta = paw_bce.v_cod_aprobado THEN
                  -- obtenemos el codigo de transacción
                  IF v_tipo = 'D' THEN
                     v_cod_transaccion := 503;
                  ELSE
                     v_cod_transaccion := 602;
                  END IF;

                  -- verificamos si se puede realizar la operacion, para fecha futura no debe validar saldo disponible
                  IF paw_bce.fu_ver_operacion(v_nro_cuenta, v_monto, v_cod_transaccion, v_cod_tra_padre, v_tipo) = 'N' THEN

                     IF pag_cta.g_cod_error <> 0 THEN
                        IF v_tipo = 'D' THEN
                           v_msj_bitacora := v_msj_bitacora || ', cta-deb: ' || v_nro_cuenta || ', cta-err: [' || substr(pag_cta.g_msj_error, 1, 150) || ']';
                        END IF;
                        -- controlamos si dispone de saldo suficiente
                        IF pag_cta.g_cod_error IN (25, 29, 31, 36)  THEN
                          IF v_tipo = 'D' AND TRUNC(p_fecPago) = TRUNC(SYSDATE) THEN
                             pr_mensajeUsuario(SAL_CTA_INSUFICIENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          END IF;
                        ELSE
                           -- hubo otro error
                           v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                           v_mensaje     := 'Cuenta invalida';
                           v_cod_error   := 1;
                        END IF;
                     END IF;
                  END IF;
                  -- verificamos el sobregiro
                  IF v_cod_res_cta = paw_bce.v_cod_aprobado AND v_tipo = 'C' AND (v_cod_modulo = 4 OR v_cod_modulo = 3) AND v_traspaso = 'S' THEN
                     v_sal_disponible := pag_cta.fu_sal_dis_combinada + pag_cta.FU_OBT_LIN_SOBREGIRO(v_nro_cuenta);
                     IF v_sal_disponible < 0 THEN
                        v_cod_error   := 1;
                        v_mensaje     := 'Cuenta no permite credito p/ Aguinaldo. Se encuentra en Sobregiro la cta combinada';
                        v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                     END IF;
                  END IF;
               END IF;
               -- armo el detalle por cuenta
               v_detalle.numeroCuenta          := substr(v_nro_cuenta, 1, 15);
               v_detalle.tipo                  := v_tipo;
               v_detalle.descripcionTipoCuenta := substr(v_des_tip_cuenta, 1, 35);
               v_detalle.nombreCuenta          := substr(nvl(v_nom_cuenta, v_nom_beneficiario), 1, 50);
               v_detalle.codigoMoneda          := substr(v_cod_moneda, 1, 3);
               v_detalle.monto                 := v_monto;
               v_detalle.error                 := 'N';
               v_detalle.mensajeRespuesta      := v_cod_error || ' - ' || v_mensaje;
               v_detalle.numeroDocumento       := v_nro_doc_credito;
               IF v_cod_res_cta <> paw_bce.v_cod_aprobado THEN
                  v_detalle.error := 'S';
                  v_can_errores := v_can_errores + 1;
               END IF;
               v_lis_detalle.extend;
               v_lis_detalle(v_lis_detalle.count) := v_detalle;

               -- registro el codigo de respuesta general, si hay errores en el detalle
               IF v_cod_res_cta <> paw_bce.v_cod_aprobado THEN
                  IF v_tipo = 'D' THEN
                     IF v_cod_res_cta = paw_bce.v_mon_dec_invalida THEN
                        IF v_retorno.error = 'N' THEN
                           -- para que pueda editar el monto del débito importado
                           pr_mensajeUsuario(SAL_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        END IF;
                     ELSE
                        IF v_retorno.error <> 'SAL_CTA_INSUFIC' THEN
                           pr_mensajeUsuario(SAL_ERR_CTA_DEB_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        END IF;
                     END IF;
                  ELSE
                     IF v_retorno.error = 'N' THEN
                        pr_mensajeUsuario(SAL_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     END IF;
                  END IF;
               END IF;
               -- Es confirmacion y no hubo errores... OMM 07/10/2010
               IF p_modo = 'C' AND v_retorno.error = 'N' THEN
                  IF v_tipo = 'D' THEN
                     v_nro_cta_debito := v_nro_cuenta;
                  ELSE
                     INSERT INTO ge_pag_sueldos_tmp
                        (cod_ente, nro_cuenta, fec_envio, fec_proceso, tipo, monto, estado, nro_archivo, tip_remuneracion, nro_documento)
                     VALUES
                        (v_cod_ente, v_nro_cuenta, sysdate, trunc(p_fecPago), 'C', v_monto, 'H', v_nro_archivo, p_tip_remuneracion, v_nro_doc_credito);
                  END IF;
               END IF;
            END IF;
         END LOOP;
         v_lugar := 'Fin del ciclo Cantidad leidos: ' || v_can_detalles;
      END IF;
      v_retorno.cantidadCuentas := v_can_detalles;
      v_retorno.listaCuentas := v_lis_detalle;
      v_msj_bitacora := v_msj_bitacora || ', canDet:' || v_can_detalles || ', canCreLei:' || v_can_creditos|| ', totDetLei:' || v_tot_detalles;
      -- no puede haber más de una cuenta débito
    -- valida que el monto total sea igual al registrado en el archivo
      IF v_can_cta_debito > 1 THEN
         v_msj_bitacora := v_msj_bitacora || ', canCtaDeb:' || v_can_cta_debito;
         pr_mensajeUsuario(SAL_CAN_CTA_DEB_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      ELSIF v_can_creditos > paw_bce.v_max_imp_archivo THEN
         pr_mensajeUsuario(SAL_MAX_CAN_CRE_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      ELSIF v_mon_debito <> v_tot_detalles THEN
         pr_mensajeUsuario(SAL_MTO_TOT_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
    END IF;

      -- validar siempre que la cuenta debito pertenezca al ente
      -- OMM 07/10/2010 Valida q la Cta debito sea de la empresa.
      IF lf_cta_valida(v_nro_cta_debito, NULL, v_usu_sesion, v_msj_respuesta) = 'N' THEN
         v_msj_bitacora := v_msj_bitacora || 'nro_cta: [' ||v_nro_cta_debito|| ']';
         IF nvl(v_msj_respuesta.error, 'N') = 'N' THEN
            pr_mensajeUsuario(SAL_CTA_DEB_TERCERO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         ELSE
            v_retorno.error                := v_msj_respuesta.error;
            v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
            v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
         END IF;
        /*
         ELSIF v_tot_detalles <> p_tot_debito THEN
            pr_mensajeUsuario(SAL_MTO_TOT_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         ELSIF v_can_creditos <> p_can_cuentas THEN
            pr_mensajeUsuario(SAL_CAN_CRE_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         */
      END IF;
      IF v_retorno.error = 'S' THEN
         IF p_modo = 'C' THEN
         -- En caso de error al confirmar se debe eliminar los registros del temporal
            v_lugar := 'borrando datos temporales';
            pag_sue.LP_DEL_DATOS_TEMPORA(v_cod_ente, p_fecPago, v_lugar, v_nro_archivo);
         END IF;
      ELSE
         IF p_modo IN ('V', 'L') THEN
            -- OMM 19/07/2011 Verificación de Duplicacion
            DECLARE
               v_can_duplicado NUMBER(6) := 0;
            BEGIN
               SELECT COUNT(*)
                 INTO v_can_duplicado
                 FROM ge_pag_sueldos_tmp a
                WHERE a.cod_ente = v_cod_ente
                  AND a.nro_cuenta = v_nro_cta_debito
                  AND a.fec_envio = v_fec_actual
                  AND a.tipo = 'D'
                  AND a.monto = v_tot_detalles --p_tot_debito
                  AND a.estado = 'H'
                  AND a.tip_remuneracion = p_tip_remuneracion
                  AND a.nro_archivo IS NOT NULL;
               IF v_can_duplicado > 0 THEN
                  pr_mensajeUsuario(SAL_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            EXCEPTION
               WHEN OTHERS THEN
                  NULL;
            END;
         END IF;
         -- 20/04/2012 : Verifico que la cta de débito tenga límite para la operación
         --              se agrega monitoreo de limite global de pago de salarios
         IF v_retorno.error = 'N' OR v_retorno.nombreRespuesta = 'SAL_PED_DUPLICA' THEN
            IF p_modo <> 'I' THEN
               v_resLimite := fu_obtenerLimite(v_usu_sesion, v_cod_operacion, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), v_nro_cta_debito, p_cod_moneda, 503, 303, v_tot_detalles/*p_tot_debito*/, p_modo, p_cod_ente);
               IF v_resLimite.error = 'S' THEN
                  v_retorno.error                := 'S';
                  v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                  v_retorno.nombreRespuesta      := v_resLimite.nombreRespuesta;
               END IF;
               v_retorno.respuestaLimite := v_resLimite.codRespuesta;
               v_msj_bitacora := v_msj_bitacora||', resLimite:'||v_resLimite.codRespuesta;
            END IF;
         END IF;
         IF v_retorno.error = 'N' THEN
            v_msj_respuesta.error := 'N';
            IF p_modo IN ('C', 'A') THEN
               IF v_resLimite.codRespuesta IN ('10', '11') THEN
                  -- clave transaccional requerida
                  v_msj_respuesta := lf_obt_cla_validar(p_claveTransaccional, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, 'T');
               END IF;

               IF v_msj_respuesta.error = 'N' THEN
                  IF v_resLimite.codRespuesta IN ('01', '11') THEN
                     -- token requerido
                     v_msj_respuesta := paw_seg.fu_obt_tok_validar(p_claveToken, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, p_modo);
                  END IF;
               END IF;

               IF v_msj_respuesta.error = 'S' THEN
                  v_retorno.error := 'S';
                  v_retorno.nombreRespuesta := v_msj_respuesta.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
               END IF;
            END IF;
         END IF;
         IF p_modo = 'C' AND v_retorno.error = 'N' THEN
            -- Es confirmacion y no hubo errores...
            v_lugar := 'Insertando datos de sueldos';
            INSERT INTO ge_pag_sueldos_tmp
               (cod_ente, nro_cuenta, fec_envio, fec_proceso, tipo, monto, estado, tip_remuneracion, nro_archivo)
            VALUES
               (v_cod_ente, v_nro_cta_debito, sysdate, trunc(p_fecPago), 'D', v_tot_detalles /*p_tot_debito*/, 'H', p_tip_remuneracion, v_nro_archivo);
            --
            IF v_can_aut_requeridas > 0 THEN
               --- inserto el movimiento pendiente de autorizacion
               SELECT s_nro_documento.NEXTVAL
                 INTO v_nro_documento
                 FROM dual;
               INSERT INTO bw_mov_pendientes
                  (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda,
                    descripcion, monto, cantidad, etiqueta, dato, etiqueta2,
                    dato2, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, referencia, tip_pago)
               VALUES
                  (v_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), sysdate, '070', v_nro_cta_debito, p_cod_moneda,
                   'Pago de Salarios', v_tot_detalles, v_can_creditos, 'Ente', p_cod_ente, 'Fecha Pago',
                    to_char(p_fecPago, 'DD/MM/YYYY'), 'P', v_can_aut_requeridas, v_can_aut_requeridas, v_usu_sesion.codigoPersona, v_nro_archivo, p_tip_remuneracion);

               v_retorno.numeroDocumento := v_nro_documento;
               v_retorno.cantidadAutorizadores := v_can_aut_requeridas;
            ELSE
               ----

               v_dir_correo := fug_obt_pardinamico('SUE_DIR_CORREO');

               IF v_retorno.error = 'N' THEN
                  v_lugar := 'Enviando mail';
                  it_mail.mail(fug_obt_dir_correo, v_dir_correo, 'Pago de Sueldos Pendiente', 'Pago de Sueldos ingresado por HomeBanking pendientes ' || chr(10) || 'Codigo  : ' || v_cod_ente || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Monto   : ' || lf_for_money(v_tot_detalles/*p_tot_debito*/, 16) || chr(10) || 'Cantidad: ' || to_char(v_can_creditos) || chr(10) || 'Atentamente. ');
               END IF;
            END IF;
         END IF;
      END IF;
      v_lugar := 'Registrando operacion';
      -- registro del movimiento
      IF v_retorno.error = 'S' THEN
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', canErr:' || v_can_errores || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      ELSE
         IF p_modo = 'C' THEN
            lp_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/,
                          p_cod_moneda /*p_cod_moneda */,
                          v_tot_detalles /*p_monto*/,
                          NULL /*p_nro_cta_contra*/,
                          v_can_creditos /*p_cantidad*/,
                          'Ente' /*p_etiqueta*/,
                          v_cod_ente /*p_dato*/,
                          'Tip.Rem',
                          p_tipoRemuneracion,
                          'Yaguarete',
                          NULL,
                          '000',
                          v_usu_sesion.codigoPersona,
                          v_cod_operacion,
                          v_nro_documento,
                          p_codigoCanal,
                          p_sesion,
                          v_usu_sesion.codigoEmpresa);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
         END IF;
      END IF;
      -- siempre se responde con los detalles, sea o no sea con errores
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(SAL_FMT_INCORRECTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', lug: ' || v_lugar || ', Cant.Reg.:' || v_can_detalles || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 100) || '] ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
         --raise_application_error(-20005, SQLERRM || ' En: ' || v_lugar || ' Cant.Reg ' || v_can_detalles);
   END; -- Pago de Sueldos

   FUNCTION lf_obt_bco_snp(p_codigo IN NUMBER) RETURN VARCHAR2 IS
      v_retorno gv_snp_participantes.participante%TYPE := NULL;
   BEGIN
      IF nvl(p_codigo, 0) = 0 THEN
         v_retorno := fug_obt_pardinamico('NOM_BANCO');
      ELSE
         BEGIN
            SELECT a.participante
              INTO v_retorno
              FROM gv_snp_participantes a
             WHERE a.cod_banco = p_codigo;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               SELECT b.participante
                 INTO v_retorno
                 FROM gv_snp_participantes b
                WHERE b.cod_ente = p_codigo;
         END;
         v_retorno := initCap(v_retorno);
      END IF;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         RETURN NULL;
   END;
   -- Validacion y confirmacion de pago a proveedores
   FUNCTION fu_pagoProveedores(p_sesion                 IN VARCHAR2,
                               p_codigoCanal            IN VARCHAR2,
                               p_codigoEnte             IN NUMBER,
                               p_modoControl            IN VARCHAR2,
                               p_cuentaDebito           IN VARCHAR2,
                               p_fechaPago              IN DATE,
                               p_tipoPago               IN VARCHAR2,
                               p_cantOrdenes            IN NUMBER,
                               p_cantFacturas           IN NUMBER,
                               p_parametros             IN CLOB,
                               p_par_errores            IN CLOB,
                               p_claveTransaccional     IN VARCHAR2,
                               p_claveToken             IN VARCHAR2) RETURN typ_pagoProveedores IS
      -- datos recibidos
      p_modo              VARCHAR2(1) := substr(trim(p_modoControl), 1, 1); -- modo de control C-CONFIRMA
      p_cod_ente          NUMBER(5) := p_codigoEnte;
      p_can_orden         NUMBER(5) := p_cantOrdenes;
      v_registro          VARCHAR2(4000);
      v_arc_mon_local     VARCHAR2(100);
      v_arc_mon_fuerte    VARCHAR2(100);
      v_for_archivo       VARCHAR2(100);
      v_detalle           typ_detalleProveedor := typ_detalleProveedor(); -- datos de las cuentas
      v_lis_detalle       typ_listadetalleproveedor := typ_listadetalleproveedor();
      v_cod_ente          NUMBER(6); -- codigo del ente
      v_des_ente          VARCHAR2(100); -- descripcion del ente
      v_tip_comprobante   ge_pag_proveedores_tmp.tip_comprobante%TYPE;
      v_mod_reg_pago      ge_par_dinamicos.val_parametro%TYPE;
      r_orden             ge_pag_proveedores_tmp%ROWTYPE;
      v_pos_ant           NUMBER(8);
      v_pos_nvo           NUMBER(8);
      v_nro_documento     NUMBER(20);
      v_tot_debito        ge_movimientos.monto%TYPE;
      v_mto_debito        ge_movimientos.monto%TYPE;
      v_cot_credito       ge_movimientos.cotizacion%TYPE;
      v_cot_debito        ge_movimientos.cotizacion%TYPE;
      v_cod_moneda        ge_cuentas.cod_moneda%TYPE;
      v_cta_for_debito    VARCHAR2(17);
      v_nom_cta_debito    VARCHAR2(100);
      v_nro_cta_debito    ge_cuentas.nro_cuenta%TYPE;
      v_error             VARCHAR2(2000);
      p_fec_pago1         DATE := p_fechaPago;
      v_err_pago          VARCHAR2(2) := '00';
      v_cod_modulo        ge_movimientos.cod_modulo%TYPE;
      v_cod_modalidad     ge_movimientos.cod_modalidad %TYPE;
      v_cod_oficina       ge_movimientos.cod_oficina%TYPE;
      v_tra_pad_proveedor ge_movimientos.cod_tra_padre%TYPE := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_PPROV');
      v_tra_pad_credito   ge_movimientos.cod_tra_padre%TYPE := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_PRV_CREDITO');
      v_prioridad         VARCHAR2(1);
      v_cod_tra_padre     ge_movimientos.cod_tra_padre%TYPE;
      v_lin_inicial       ge_archivos.lin_inicial%TYPE;
      v_pos_ant_proc      NUMBER;
      v_pos_nvo_proc      NUMBER;
      v_tip_pago          VARCHAR2(1); -- P: Pago a proveedores, C: Crédito en cuenta
      v_des_pendiente     bw_mov_pendientes.descripcion%TYPE;
      v_can_ordenes       NUMBER := 0; -- cantidad de ordenes para crédito
      v_dir_correo        ba_personas.dir_correo%TYPE;
      v_lugar             VARCHAR2(100);
      v_cod_operacion     VARCHAR2(3) := '075';
      v_resLimite         typ_respuestaLimite;
      v_fec_actual        DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy;
      v_retorno           typ_pagoProveedores := typ_pagoProveedores();
      v_usu_sesion        typ_validarsesion;
      v_msj_respuesta     typ_MensajeRespuesta := typ_MensajeRespuesta;
      v_msj_caja          typ_mensajeCaja;
      v_permiso           typ_obtenerPermisos;
      v_nro_archivo       ge_pag_proveedores_tmp.nro_archivo%type;
      v_can_ord_sipap     NUMBER := 0;
      v_can_ord_bbva      NUMBER := 0;
      v_can_limite        NUMBER := 0;
      v_cam_fecha         BOOLEAN;
      v_est_periodo       ge_snp_horarios.estado%TYPE;
      v_fec_snp_hor       ge_snp_horarios.fecha%TYPE;
      v_cantidad          NUMBER;
      v_hab_ach           varchar2(1) := substr(fug_obt_pardinamico('SNP_HAB_MSJ_ACH'),1,1);
      v_hora_fin          ge_snp_horarios.hor_fin%TYPE;
      v_hora_pro          ge_snp_horarios.hor_fin%TYPE;
      v_msj_bitacora      VARCHAR2(800) := substr('ente:'||trim(p_codigoEnte)
                                                         ||', modo:'||trim(p_modoControl)
                                                         ||', ctaDeb:'||trim(p_cuentaDebito)
                                                         ||', fecPag:'||p_fechaPago
                                                         ||', tipPag:'||p_tipoPago
                                                         ||', canOrd:'||p_cantOrdenes
                                                         ||', canFac:'||p_cantFacturas, 1, 500);
      PRO_PER_SIN_AUT         CONSTANT VARCHAR2(15) := 'PRO_PER_SIN_AUT';
      PRO_FEC_PAG_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_FEC_PAG_INV';
      PRO_TRA_PAD_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_TRA_PAD_INV';
      PRO_CTA_DEB_TERCERO     CONSTANT VARCHAR2(15) := 'PRO_CTA_DEB_TER';
      PRO_MON_PAG_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_MON_PAG_INV';
      PRO_FMT_ARC_INDEFINIDO  CONSTANT VARCHAR2(15) := 'PRO_FMT_ARC_IND';
      PRO_CTA_DEB_INEXISTENTE CONSTANT VARCHAR2(15) := 'PRO_CTA_DEB_INE';
      PRO_CTA_DEB_DUPLICADA   CONSTANT VARCHAR2(15) := 'PRO_CTA_DEB_DUP';
      PRO_OBT_ERR_CTA_DEBITO  CONSTANT VARCHAR2(15) := 'PRO_OBT_CTA_DEB';
      PRO_FEC_PAG_NOHABIL     CONSTANT VARCHAR2(15) := 'FEC_PAG_NOHABIL';
      OPE_NO_PERMITIDA        CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      PRO_ERR_DATOS           CONSTANT VARCHAR2(15) := 'PRO_ERR_DATOS';
      PRO_MAX_CRE_EXCEDIDO    CONSTANT VARCHAR2(15) := 'PRO_MAX_CRE_EXE';
      PRO_ERR_SIPAP           CONSTANT VARCHAR2(15) := 'PRO_ERR_SIPAP';
      PRO_ERR_VER_PAGO        CONSTANT VARCHAR2(15) := 'PRO_ERR_VER_PAG';
      PRO_ERR_PRO_PAGO        CONSTANT VARCHAR2(15) := 'PRO_ERR_PRO_PAG';
      PRO_CAN_ORD_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_CAN_ORD_INV';
      PRO_ERR_DAT_INVALIDOS   CONSTANT VARCHAR2(15) := 'PRO_ERR_DAT_INV';
      -- registro de detalles
      CURSOR c_detalle(p_nro_archivo in number) IS
         SELECT nro_orden, nro_factura, tip_comprobante, for_pago, nro_cheque, nro_cta_credito,
                fec_ingreso, fec_pago, monto, nro_recibo, beneficiario,
                decode(cod_proceso, 0, concepto, InitCap(concepto)) concepto, estado,
                cod_usu_operador, a.cod_ente, cod_proceso, cod_moneda, tip_carga,
                nvl(f_cantidad, 0) f_cantidad, ref_facturas, ent_bca_beneficiario,
                nro_doc_beneficiario, cod_tip_doc_beneficiario, nro_cta_beneficiario,
                ind_valor, nro_con_cambio, ben_dir_correo
           FROM ge_pag_proveedores_tmp a,
                (SELECT cod_ente f_cod_ente, nro_orden f_nro_orden, COUNT(*) f_cantidad
                   FROM ge_pag_pro_facturas_tmp
                   WHERE cod_ente = p_cod_ente
                      AND trunc(fec_insercion) = trunc(SYSDATE)
                      AND usu_insercion = USER
                 GROUP BY cod_ente, nro_orden)
          WHERE a.cod_ente = p_cod_ente
             AND f_cod_ente(+) = a.cod_ente
             AND f_nro_orden(+) = nro_orden
             AND usu_insercion = USER
             AND tip_carga = 'H'
             AND nro_archivo = p_nro_archivo
             AND trunc(fec_insercion) = trunc(sysdate)
       ORDER BY nro_ord_archivo asc;
      -- cuentas proveedores
      CURSOR c_cta_bbva IS
      SELECT DISTINCT (TRIM(a.beneficiario)) beneficiario, (TRIM(decode(a.nro_cta_credito, '0', ' ', NULL, ' ', a.nro_cta_credito))) cta_credito, g.cod_moneda
        FROM ge_cuentas g,
             (SELECT DISTINCT (TRIM(beneficiario)) beneficiario, MAX(TRIM(nro_cta_credito)) nro_cta_credito
                 FROM ge_pag_proveedores
                WHERE cod_ente = p_cod_ente
                  AND fec_pago > SYSDATE - 90
                  AND for_pago = 'C'
                  AND estado IN ('C', 'N')
                GROUP BY beneficiario
               /*UNION
               SELECT DISTINCT (TRIM(beneficiario)), MAX(TRIM(nro_cta_credito)) nro_cta_credito
                 FROM ge_pag_proveedores_tmp
                WHERE cod_ente = p_cod_ente
                  AND ent_bca_beneficiario IS NULL
                GROUP BY beneficiario*/) a
       WHERE g.nro_cuenta(+) = a.nro_cta_credito
         AND nvl(g.estado, 'A') IN ('A', 'N', 'I');

     CURSOR c_cta_sipap IS
        SELECT DISTINCT (TRIM(beneficiario)) beneficiario, ent_bca_beneficiario,
               nro_doc_beneficiario, cod_tip_doc_beneficiario, cod_moneda,  MAX(TRIM(nro_cta_beneficiario)) nro_cta_beneficiario
          FROM ge_pag_proveedores
         WHERE cod_ente = p_cod_ente
           AND fec_pago > SYSDATE - 90
           AND for_pago = 'I'
           AND estado IN ('C','N')
         GROUP BY beneficiario, ent_bca_beneficiario, nro_doc_beneficiario, cod_tip_doc_beneficiario, cod_moneda;

      FUNCTION lf_obt_con_cambio(p_nro_contrato IN NUMBER) RETURN NUMBER IS
         v_retorno lc_ope_pendientes.nro_diario%TYPE := NULL;
      BEGIN
         IF p_nro_contrato IS NOT NULL THEN
           SELECT l.nro_diario
             INTO v_retorno
             FROM lc_ope_pendientes l
            WHERE l.nro_operacion = p_nro_contrato
              AND l.liquidado = 'N'
              AND l.ope_homebanking = 'S'
              AND l.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
              AND TRUNC(l.fec_operacion) = TRUNC(SYSDATE);
         END IF;
         RETURN v_retorno;
      EXCEPTION
         WHEN OTHERS THEN
            RETURN NULL;
      END;
     /* Obtiene la hora fin snp de un periodo */
     FUNCTION LF_OBT_HOR_FIN_SNP(P_COD_PERIODO IN GE_SNP_HORARIOS.COD_PERIODO%TYPE) RETURN VARCHAR2 IS
        v_retorno ge_snp_horarios.hor_fin%TYPE;
     BEGIN
        SELECT h.hor_fin
          INTO v_retorno
          FROM ge_snp_horarios h
         WHERE h.cod_periodo = p_cod_periodo;

        RETURN v_retorno;

     EXCEPTION
        WHEN OTHERS THEN
           RETURN NULL;
     END LF_OBT_HOR_FIN_SNP;
     --
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- 1. valido la clave del cliente
      v_lugar := 'Validacion de la clave';
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 2. verifica el canal de origen
      v_lugar := 'Validacion de la caja';
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 3. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_lugar := 'Control de permisos';
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
         pr_mensajeUsuario(PRO_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);

      v_lugar := 'Tomando las fechas';
      IF p_fec_pago1 IS NOT NULL THEN
         BEGIN

            IF p_fec_pago1 < v_fec_actual OR p_fec_pago1 < trunc(SYSDATE) THEN
               pr_mensajeUsuario(PRO_FEC_PAG_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            ELSE
               IF pag_cal.fu_obt_fec_habil(p_fec_pago1, 1, v_msj_caja.codigoOficinaOrigen) != p_fec_pago1 THEN
                  pr_mensajeUsuario(PRO_FEC_PAG_NOHABIL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(PRO_FEC_PAG_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END;
      END IF;

      -- 4. Verifico si la persona tiene el servicio de pago a proveedores
      IF v_retorno.error = 'N' THEN
         v_lugar := 'Datos del ente';
         BEGIN
            -- se elimina cta_debito porque ahora se recibe en la mensajería,
            -- se agrega el formato de archivo para pagos en USD
            SELECT a.cod_ente, a.descripcion, fug_obt_parentes(a.cod_ente, 'TIP_COB_PPROV'), fug_obt_parentes(a.cod_ente, 'REF_TXT_PPROV'), fug_obt_parentes(a.cod_ente, 'REF_TXT_PPROV_USD'), nvl(fug_obt_parentes(a.cod_ente, 'SNP_TIP_PRIORIDAD'), 'A')
              INTO v_cod_ente, v_des_ente, v_tip_comprobante, v_arc_mon_local, v_arc_mon_fuerte, v_prioridad
              FROM ge_entes a
             WHERE a.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
               AND a.tipo = 'PR'
               AND (p_modo = 'D' OR (p_modo <> 'D' AND a.cod_ente = p_cod_ente))
               AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO_PRV') = 'S'
               AND fug_obt_parentes(a.cod_ente, 'HAB_HOMEBANKING_PRV') = 'S';
            -- a veces en el modo D no se puede obtener el codigo ente desde aguara
            IF p_modo = 'D' THEN
               p_cod_ente := v_cod_ente;
            END IF;
            ---
            -- CR 03/09/2012 - La cuenta de débito ahora se recibe como parámetro en la mensajería
            -- validamos la misma y verificamos si pertenece al ente
            IF p_modo IN ('L', 'D', 'C', 'V') THEN
               v_nro_cta_debito := TRIM(substr(p_cuentaDebito, 1, 15));
               v_tip_pago       := TRIM(substr(p_tipoPago, 1, 1));

               IF v_tip_pago = 'P' THEN
                  v_cod_tra_padre := v_tra_pad_proveedor; -- transacción padre para pago a proveedores
                  v_des_pendiente := 'Proveedores';
               ELSIF v_tip_pago = 'C' THEN
                  v_cod_tra_padre := v_tra_pad_credito; -- transacción padre para crédito en cuenta
                  v_des_pendiente := 'Crédito en Cuenta';
               ELSE
                  pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
               -- si no existe transacción padre, retornamos el error
               IF p_modo <> 'D' AND v_cod_tra_padre IS NULL AND v_retorno.error = 'N' THEN
                  pr_mensajeUsuario(PRO_TRA_PAD_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            ELSE
               pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
            -- validamos si la cuenta pertenece al cliente
            IF v_retorno.error = 'N' and p_modo <> 'D' THEN
               IF lf_val_cta_origen(v_nro_cta_debito, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)) = 'N' THEN
                  -- no es una cuenta del cliente
                  pr_mensajeUsuario(PRO_CTA_DEB_TERCERO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
            IF p_modo <> 'D' AND v_retorno.error = 'N' THEN
               SELECT cod_moneda
                 INTO v_cod_moneda
                 FROM ge_cuentas
                WHERE nro_cuenta = v_nro_cta_debito;

               -- CR: de acuerdo a la moneda, se elige el formato de archivo
               IF v_cod_moneda = paw_bce.v_cod_mon_local THEN
                  v_for_archivo := v_arc_mon_local;
               ELSIF v_cod_moneda = pag_gen.FU_OBT_MON_FUERTE THEN
                  v_for_archivo := v_arc_mon_fuerte;
               ELSE
                 --v_cod_respuesta := paw_bce.v_cod_tra_invalida;s
                 v_msj_bitacora := v_msj_bitacora || ', monDeb:' || v_cod_moneda;
                 pr_mensajeUsuario(PRO_MON_PAG_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;

               -- CR: Si no tiene definido el formato de importación
               -- para archivos, debe dar error
               IF v_retorno.error = 'N' AND v_for_archivo IS NULL AND p_modo = 'L' THEN
                  pr_mensajeUsuario(PRO_FMT_ARC_INDEFINIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
         EXCEPTION
            WHEN no_data_found THEN
               pr_mensajeUsuario(PRO_CTA_DEB_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN too_many_rows THEN
               pr_mensajeUsuario(PRO_CTA_DEB_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN OTHERS THEN
               pr_mensajeUsuario(PRO_OBT_ERR_CTA_DEBITO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END;
      END IF;

      IF p_modo = 'D' AND v_retorno.error = 'N' THEN
         FOR reg IN c_cta_bbva
         LOOP
            --v_can_detalles := v_can_detalles + 1;
            v_can_ordenes := v_can_ordenes + 1;

            -- armo el detalle de las cuentas a acreditar
            v_detalle.numeroOrden          := NULL;
            v_detalle.numeroFactura        := NULL;
            v_detalle.formaPago            := 'C';
            v_detalle.numeroCuentaCredito  := reg.cta_credito;
            v_detalle.montoCredito         := 0;
            v_detalle.nombreBeneficiario   := substr(reg.beneficiario, 1, 60);
            v_detalle.codigoMoneda         := reg.cod_moneda;
            v_detalle.concepto             := NULL;
            v_detalle.codigoProceso        := NULL;
            v_detalle.numeroBanco          := NULL;
            v_detalle.descripcionBanco     := fug_obt_pardinamico('NOM_BANCO');
            v_lis_detalle.extend;
            v_lis_detalle(v_lis_detalle.count) := v_detalle;
         END LOOP;
         FOR reg IN c_cta_sipap
         LOOP
            --v_can_detalles := v_can_detalles + 1;
            v_can_ordenes := v_can_ordenes + 1;

            -- armo el detalle de las cuentas a acreditar
            v_detalle.numeroOrden          := NULL;
            v_detalle.numeroFactura        := NULL;
            v_detalle.formaPago            := 'I';
            v_detalle.numeroCuentaCredito  := NULL;
            v_detalle.montoCredito         := 0;
            v_detalle.nombreBeneficiario   := substr(reg.beneficiario, 1, 60);
            v_detalle.codigoMoneda         := reg.cod_moneda;
            v_detalle.concepto             := NULL;
            v_detalle.codigoProceso        := NULL;
            v_detalle.numeroBanco          := reg.ent_bca_beneficiario;
            v_detalle.numeroCuentaBeneficiario := substr(reg.nro_cta_beneficiario, 1, 35);
            v_detalle.tipoDocumento        := substr(reg.cod_tip_doc_beneficiario, 1, 3);
            v_detalle.numeroDocumento      := substr(reg.nro_doc_beneficiario, 1, 20);
            v_detalle.descripcionBanco     := substr(lf_obt_bco_snp(reg.ent_bca_beneficiario), 1, 60);
            v_lis_detalle.extend;
            v_lis_detalle(v_lis_detalle.count) := v_detalle;
         END LOOP;
         v_retorno.listaProveedores := v_lis_detalle;
      ELSE
         -- 4. Tomo la cantidad de cuentas recibidas
         IF v_retorno.error = 'N' THEN
            IF v_for_archivo IS NOT NULL THEN
               BEGIN
                  SELECT nvl(a.lin_inicial, 1)
                    INTO v_lin_inicial
                    FROM ge_archivos a
                   WHERE a.referencia = TRIM(v_for_archivo);
               EXCEPTION
                  WHEN OTHERS THEN
                     v_lin_inicial := 1;
               END;
            END IF;
            v_tip_comprobante := fug_obt_parentes(p_cod_ente, 'TIP_COB_PPROV');
            v_mod_reg_pago := nvl(TRIM(fug_obt_parentes(p_cod_ente, 'MOD_REG_PAG_PRV')), 'N'); /* N=Normal, P=Por operación*/

            v_pos_ant    := 1;
            v_tot_debito := 0;
            v_cam_fecha := paw_bce.fu_ver_hor_cie_proveedor(p_fec_pago1);
            IF v_cam_fecha THEN
               v_msj_bitacora := v_msj_bitacora || ', camFec';
            END IF;
            v_nro_archivo := pag_prv.fu_obt_nro_secuencia(p_cod_ente, p_fec_pago1);
            v_msj_bitacora := v_msj_bitacora || ', nro_arc: ' ||v_nro_archivo;
            IF p_can_orden > 0 THEN
               v_can_ordenes := 0; -- para contar el total de créditos, no puede super paw_bce.v_max_imp_archivo
               -- CR 03/09/2012 se eliminó control de valor decimal
               -- ya que la misma se hace en pag_prv.pr_ver_dat_tmp
               FOR i IN 1 .. p_can_orden
               LOOP
                  ----
                  v_lugar := 'Leyendo el registro Nro.' || i;
                  v_pos_nvo  := instr(p_parametros, '~', v_pos_ant);
                  v_registro := substr(p_parametros, v_pos_ant, v_pos_nvo - v_pos_ant);
                  v_pos_ant  := v_pos_nvo + 1;

                  r_orden             := NULL;
                  r_orden.cod_ente    := p_cod_ente;

                  r_orden.tip_comprobante  := v_tip_comprobante; -- Toma del parametro del Ente....
                  r_orden.estado           := 'C';
                  r_orden.tip_carga        := 'H';
                  r_orden.nro_archivo      := v_nro_archivo;
                  r_orden.cod_usu_operador := USER;
                  r_orden.nro_cheque       := NULL;
                  r_orden.fec_ingreso      := trunc(sysdate); --v_fec_actual;
                  r_orden.cod_ente         := p_cod_ente;
                  r_orden.cod_proceso      := NULL;
                  r_orden.fec_pago         := p_fec_pago1;

                  IF p_modo <> 'L' THEN
                     -- formato fijo

                     IF v_registro IS NULL OR length(TRIM(v_registro)) < 30 THEN
                        GOTO end_loop;
                     END IF;

                     -- los campos vienen separados por ';'
                     v_pos_ant_proc := 1;
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);

                     -- CR: se agrega validación de dato ingresado
                     v_lugar                 := 'nro orden';
                     BEGIN
                        r_orden.nro_orden := substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc);
                     EXCEPTION
                        WHEN OTHERS THEN
                           r_orden.nro_orden := i;
                     END;
                     v_pos_ant_proc  := v_pos_nvo_proc + 1;

                     v_lugar                 := 'nro factura';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.nro_factura := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 20); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'tipo pago';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.for_pago := TRIM(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc)); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'cuenta beneficiario';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.nro_cta_credito  := depurarAlfanumerico(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 15); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'monto';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.monto := to_number(replace(trim(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc)), ',', '.')); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'beneficiario';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.beneficiario := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 60); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'codigo moneda';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.cod_moneda := TRIM(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc)); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'ref facturas';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.ref_facturas := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 300); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'tipo documento';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.cod_tip_doc_beneficiario := substr(TRIM(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc)), 1, 3); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'Entidad beneficiaria';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.ent_bca_beneficiario := TRIM(substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 5)); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'Documento beneficiario';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.nro_doc_beneficiario := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 20); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'Nro cta credito Sipap';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.nro_cta_beneficiario := depurarAlfanumerico(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 35); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'concepto';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.concepto := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 35); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'indice valor';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.ind_valor := substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 1); v_pos_ant_proc := v_pos_nvo_proc + 1;
                     --- OMM Dic/2017 Ajuste para no generar MT102
                     -- MTOP Jun/2020 Ajuste para generar MT102 luego del corte
                     if  nvl(r_orden.ind_valor, 'A') = 'A' and --nvl(v_hab_ach,'N') = 'N'
                         paw_bas.fu_obt_tip_TransfInterbancaria('103','001','002', 302, r_orden.monto, r_orden.cod_moneda, null, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona))  = '103' then
                         r_orden.ind_valor := 'A' ;
                     else
                         r_orden.ind_valor := 'B' ;
                     end if ;

                     v_lugar                 := 'contrato cambio';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.nro_con_cambio := substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 3); v_pos_ant_proc := v_pos_nvo_proc + 1;

                     v_lugar                 := 'mail beneficiario';
                     v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
                     r_orden.ben_dir_correo := substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 80); v_pos_ant_proc := v_pos_nvo_proc + 1;
                  ELSE
                     -- por si se envien datos incorrectos, se omiten
                     IF v_lin_inicial > i OR v_registro IS NULL OR length(TRIM(v_registro)) < 30 THEN
                        GOTO end_loop;
                     END IF;

                     -- tomo los datos segun formato de archivo
                     v_lugar             := 'Nro de orden';
                     r_orden.nro_orden   := NVL(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_ORDEN'), i);
                     v_lugar             := 'Nro de Factura';
                     r_orden.nro_factura := depurarTextos(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_FACTURA'), 20);
                     v_lugar             := 'Forma de pago';
                     r_orden.for_pago    := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'FOR_PAGO');
                     v_lugar                 := 'Nro de cta credito';
                     r_orden.nro_cta_credito := depurarAlfanumerico(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_CTA_CREDITO'), 15);
                     v_lugar                 := 'monto';
                     r_orden.monto           := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'MONTO');
                     v_lugar                 := 'Beneficiario';
                     r_orden.beneficiario    := depurarTextos(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'BENEFICIARIO'), 60);
                     v_lugar                 := 'Moneda';
                     r_orden.cod_moneda      := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'COD_MONEDA');
                     v_lugar                 := 'Ref_factura';
                     r_orden.ref_facturas    := depurarTextos(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'REF_FACTURAS'), 300);
                     v_lugar                 := 'tipo documento';
                     r_orden.cod_tip_doc_beneficiario := substr(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'COD_TIP_DOC_BENEFICIARIO'), 1, 3);
                     v_lugar                 := 'Entidad beneficiaria';
                     r_orden.ent_bca_beneficiario := TRIM(substr(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'ENT_BCA_BENEFICIARIO'), 1, 5));
                     v_lugar                 := 'Documento beneficiario';
                     r_orden.nro_doc_beneficiario := depurarTextos(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_DOC_BENEFICIARIO'), 20);
                     v_lugar                 := 'Nro de cta sipap';
                     r_orden.nro_cta_beneficiario := depurarAlfanumerico(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_CTA_BENEFICIARIO'), 35);
                     v_lugar                 := 'concepto';
                     r_orden.concepto        := depurarTextos(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'CONCEPTO'), 35);
                     v_lugar                 := 'indice valor';
                     r_orden.ind_valor       := v_prioridad;
                     --- OMM Dic/2017 Ajuste para no generar MT102
                     -- MTOP Jun/2020 Ajuste para generar MT102 luego del corte
                     if nvl(r_orden.ind_valor, 'A') = 'A' and  --nvl(v_hab_ach,'N') = 'N')
                        paw_bas.fu_obt_tip_TransfInterbancaria('103','001','002', 302, r_orden.monto, r_orden.cod_moneda, null, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona))  = '103' then
                         r_orden.ind_valor := 'A' ;
                     else
                         r_orden.ind_valor := 'B' ;
                     end if ;
                     v_lugar                 := 'nro contrato';
                     r_orden.nro_con_cambio  := NULL;
                     v_lugar                 := 'correo beneficiario';
                     r_orden.ben_dir_correo  := substr(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'BEN_DIR_CORREO'), 1, 80);
                  END IF;
                  IF r_orden.for_pago IS NULL THEN
                     r_orden.for_pago := 'C';
                  END IF;
                  IF r_orden.nro_factura IS NULL THEN
                     r_orden.nro_factura := 0;
                  END IF;
                  IF r_orden.nro_orden = 0 THEN
                     r_orden.nro_orden := i;
                  END IF;
                  IF r_orden.ent_bca_beneficiario = 0 THEN
                     r_orden.ent_bca_beneficiario := NULL;
                  END IF;
                  IF r_orden.cod_tip_doc_beneficiario = 0 THEN
                     r_orden.cod_tip_doc_beneficiario := NULL;
                  END IF;
                  IF r_orden.nro_con_cambio = 0 THEN
                     r_orden.nro_con_cambio := NULL;
                  END IF;
                  IF r_orden.cod_moneda IS NULL AND r_orden.for_pago = 'C' THEN
                     r_orden.cod_moneda := v_cod_moneda;
                  END IF;
                  IF paw_uti.fu_validarMail(nvl(r_orden.ben_dir_correo, fug_obt_dir_correo)) = 'N' THEN
                     r_orden.ben_dir_correo := NULL;
                  END IF;
                  -- CR aumentamos el contador de créditos
                  v_can_ordenes := v_can_ordenes + 1;
                  IF r_orden.for_pago = 'I' THEN
                     v_can_ord_sipap := v_can_ord_sipap + 1;
                  ELSE
                     v_can_ord_bbva := v_can_ord_bbva + 1;
                     r_orden.cod_tip_doc_beneficiario := NULL;
                     r_orden.ent_bca_beneficiario := NULL;
                     r_orden.nro_doc_beneficiario := NULL;
                     r_orden.nro_cta_beneficiario := NULL;
                     r_orden.concepto             := NULL;
                     r_orden.ind_valor            := NULL;
                     r_orden.nro_con_cambio       := NULL;
                  END IF;
                  -- CR 03/09/2012 se sumariza solo si el monto es válido
                  IF r_orden.monto > 0 THEN
                     IF r_orden.cod_moneda = v_cod_moneda THEN
                        v_tot_debito := v_tot_debito + r_orden.monto;
                     ELSE
                        v_mto_debito := 0;
                        IF r_orden.nro_con_cambio IS NOT NULL THEN
                           pag_prv.pr_val_nro_contrato(r_orden.nro_con_cambio, -- IN OUT
                                                       nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona),
                                                       r_orden.monto, -- monto credito
                                                       v_cod_moneda,  -- moneda debito
                                                       r_orden.cod_moneda,-- moneda credito
                                                       'S',
                                                       r_orden.cod_proceso,
                                                       r_orden.concepto,
                                                       v_mto_debito);
                        ELSE
                           BEGIN
                              pr_con_mon_a_moneda(r_orden.cod_moneda, v_cod_moneda, r_orden.monto, v_mto_debito, v_cot_credito, v_cot_debito, 'S');
                           EXCEPTION
                              WHEN OTHERS THEN
                                 r_orden.concepto    := 'Error de conversion de monedas';
                                 r_orden.cod_proceso := 64;
                           END;
                        END IF;
                        IF nvl(v_mto_debito, 0) > 0 THEN
                           v_tot_debito := v_tot_debito + v_mto_debito;
                        END IF;
                     END IF;
                  END IF;
                  ----
                  v_lugar := 'Insertando en temporales';
                  IF r_orden.for_pago IN ('C', 'G', 'I') THEN
                     INSERT INTO ge_pag_proveedores_tmp
                        (nro_orden, nro_factura, tip_comprobante, for_pago, nro_cheque, nro_cta_credito, fec_ingreso,
                         fec_pago, monto, nro_recibo, beneficiario, concepto, estado, cod_usu_operador, cod_ente, cod_proceso,
                         cod_moneda, tip_carga, nro_archivo, ref_facturas, cod_tip_doc_beneficiario, nro_doc_beneficiario,
                         nro_cta_beneficiario, ent_bca_beneficiario, ind_valor, nro_con_cambio, ben_dir_correo, nro_ord_archivo)
                     VALUES
                        (r_orden.nro_orden, r_orden.nro_factura, r_orden.tip_comprobante, r_orden.for_pago, r_orden.nro_cheque, r_orden.nro_cta_credito, r_orden.fec_ingreso,
                         r_orden.fec_pago, r_orden.monto, r_orden.nro_recibo, r_orden.beneficiario, r_orden.concepto, r_orden.estado, r_orden.cod_usu_operador, r_orden.cod_ente, r_orden.cod_proceso,
                         r_orden.cod_moneda, r_orden.tip_carga, r_orden.nro_archivo, r_orden.ref_facturas, r_orden.cod_tip_doc_beneficiario, r_orden.nro_doc_beneficiario,
                         r_orden.nro_cta_beneficiario, r_orden.ent_bca_beneficiario, r_orden.ind_valor,
                         r_orden.nro_con_cambio, r_orden.ben_dir_correo, i);
                  END IF;

                  <<end_loop>> NULL;
               END LOOP;
               v_msj_bitacora := v_msj_bitacora || ', ordLei:' || v_can_ordenes || ', can_snp:' || v_can_ord_sipap || ', can_bbva' ||v_can_ord_bbva;
               -- CR: se controla que el total de créditos no supere el máximo permitido
               v_lugar := 'Validando el total de creditos';
               IF v_can_ordenes > paw_bce.v_max_imp_archivo THEN
                  pr_mensajeUsuario(PRO_MAX_CRE_EXCEDIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
               -- CR: se valida la cuenta de débito
               v_lugar := 'Validando la cuenta del cliente';
               IF v_retorno.error = 'N' THEN
                  v_msj_respuesta := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_tot_debito,
                                                       v_cod_moneda, v_cod_modulo, v_cod_modalidad,
                                                       v_cod_oficina, v_cta_for_debito, v_nom_cta_debito,
                                                       v_usu_sesion, v_msj_caja);

                  -- solo debe tener en cuenta el saldo si la fecha de pago es al dia
                  IF v_msj_respuesta.nombreRespuesta = 'COD_SAL_INSUF' AND p_fec_pago1 <> trunc(SYSDATE) THEN
                     v_msj_respuesta.error := 'N';
                  END IF;

                  IF v_msj_respuesta.error = 'S' THEN
                     v_msj_bitacora := v_msj_bitacora || ', total:' || v_tot_debito;
                     -- para poder corregir los decimales en los detalles
                     IF instr(pag_cta.G_MSJ_ERROR, 'Decimales no permitidos') > 0 THEN
                        pr_mensajeUsuario(PRO_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     ELSE
                        v_retorno.error                := v_msj_respuesta.error;
                        v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
                     END IF;
                     v_msj_bitacora := v_msj_bitacora || ', CTA-ERR:[' || substr(pag_cta.g_msj_error, 1, 80)||']';
                  END IF;
               END IF;
               IF v_retorno.error = 'N' OR v_retorno.nombreRespuesta = 'PRO_ERR_DATOS' THEN
                  v_lugar := 'Verificando datos temporales';
                  --- Una vez que carga todo va a validar....
                  pag_prv.PR_VER_DAT_TMP(p_cod_ente, p_fec_pago1, NULL, v_error, 'N', NULL, v_nro_cta_debito, v_nro_archivo);
                  IF v_error IS NOT NULL THEN
                     IF v_can_ordenes = 0 AND p_modo = 'L' THEN
                        pr_mensajeUsuario(PRO_ERR_DAT_INVALIDOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     ELSIF instr(v_error, 'Horario SIPAP Cerrado') > 0 THEN
                        pr_mensajeUsuario(PRO_ERR_SIPAP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     ELSIF v_retorno.error = 'N' THEN
                        pr_mensajeUsuario(PRO_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     END IF;
                     v_msj_bitacora := v_msj_bitacora || ', CTA-ERR:[' || substr(v_error, 1, 50)||']';
                  END IF;
                  --v_detalles     := NULL;
                  v_lugar        := 'Generando salida';
                  FOR r1 IN c_detalle(v_nro_archivo)
                  LOOP
                     v_detalle.numeroOrden          := r1.nro_orden;
                     v_detalle.numeroFactura        := substr(r1.nro_factura, 1, 20);
                     v_detalle.formaPago            := r1.for_pago;
                     v_detalle.numeroCuentaCredito  := substr(r1.nro_cta_credito, 1, 15);
                     v_detalle.montoCredito         := r1.monto;
                     v_detalle.nombreBeneficiario   := substr(r1.beneficiario, 1, 60);
                     v_detalle.codigoMoneda         := TRIM(r1.cod_moneda);
                     v_detalle.concepto             := substr(TRIM(r1.concepto), 1, 40);
                     v_detalle.codigoProceso        := r1.cod_proceso;
                     v_detalle.referenciaFacturas   := substr(r1.ref_facturas, 1, 300);
                     v_detalle.tipoDocumento := r1.cod_tip_doc_beneficiario;
                     v_detalle.numeroDocumento := substr(r1.nro_doc_beneficiario, 1, 20);
                     v_detalle.numeroBanco := r1.ent_bca_beneficiario;
                     v_detalle.descripcionBanco := substr(lf_obt_bco_snp(r1.ent_bca_beneficiario), 1, 60);
                     v_detalle.tipoMT := substr(r1.ind_valor, 1, 1);
                     v_detalle.numeroCuentaBeneficiario := substr(r1.nro_cta_beneficiario, 1, 35);
                     v_detalle.numeroContrato       := lf_obt_con_cambio(r1.nro_con_cambio);
                     v_detalle.mailBeneficiario     := substr(r1.ben_dir_correo, 1, 80);
                     v_lis_detalle.extend;
                     v_lis_detalle(v_lis_detalle.count) := v_detalle;
                  END LOOP;
                  v_retorno.listaProveedores := v_lis_detalle;
               END IF;
               -- control de cambio de fecha para pagos sipap fuera de hora de corte
               IF v_retorno.error = 'N' AND v_can_ord_bbva = 0 AND v_can_ord_sipap > 0 THEN
                  IF trunc(p_fec_pago1) = trunc(SYSDATE) THEN
                     v_est_periodo := pas_snp.fu_obt_est_horario('103', '001', '002');
                     if ((v_est_periodo = 'A') and
                         (fug_den_per_act_snp('103','001','002',302,3) = 'S')) then
                        --No se evalua si el cliente puede enviar para no separa las transf--
                        v_est_periodo := 'C';
                     end if;
                     IF v_est_periodo <> 'A' THEN -- hora sipap cerrada
                        v_fec_snp_hor := pag_prv.fu_obt_fec_snp(1);

                        -- si llego hasta aca es porque el lote no es mixto
                        IF v_fec_snp_hor = p_fec_pago1 THEN
                           -- si se cambia la fecha hay que ver si hay monedas distintas
                           v_cantidad := pag_prv.fu_obt_can_ope_cambio(v_cod_ente, p_fec_pago1, v_cod_moneda, v_nro_archivo, 'S');

                           IF v_cantidad > 0 THEN -- hora cerrada no permite operacion de cambio
                              pr_mensajeusuario(PRO_ERR_SIPAP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           ELSE
                           v_hora_fin := LF_OBT_HOR_FIN_SNP(1);
                           v_hora_pro := TO_CHAR(SYSDATE,'HH24MI');
                             if TO_NUMBER(v_hora_pro) >= TO_NUMBER(v_hora_fin) then
                                -- se cambia fecha de pago por hora cerrada, solo pagos SIPAP si llego hasta aca
                                v_cam_fecha := pag_prv.fu_cam_fec_pago(v_cod_ente, p_fec_pago1, v_nro_archivo, 'S');
                             end if;
                              IF v_cam_fecha THEN
                                 v_msj_bitacora := v_msj_bitacora || ', cam_hor_snp: '||to_char(p_fec_pago1, 'dd/mm/yyyy');
                              END IF;
                           END IF;
                        END IF;
                     END IF;
                  END IF;
               END IF;
               -- 03/05/2012 : Verifico que la cta de débito tenga límite para la operación
               -- se agrega monitoreo de límite global de pago a proveedores
               IF v_retorno.error = 'N' THEN
                  IF p_modo <> 'I' THEN
                     IF v_mod_reg_pago = 'N' THEN
                        v_can_limite := v_can_ord_sipap;
                        IF v_can_ord_bbva > 0 THEN
                           v_can_limite := v_can_limite + 1;
                        END IF;
                     ELSE
                        v_can_limite := v_can_ordenes;
                     END IF;
                     v_lugar      := 'Verificando limites';
                     v_resLimite := fu_obtenerLimite (v_usu_sesion,
                                                      v_cod_operacion,
                                                      nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona),
                                                      v_nro_cta_debito,
                                                      v_cod_moneda,
                                                      503,
                                                      v_cod_tra_padre,
                                                      v_tot_debito,
                                                      p_modo,
                                                      p_cod_ente,
                                                      null,
                                                      null,
                                                      v_can_limite);
                     IF v_resLimite.error = 'S' THEN
                        v_retorno.error := v_resLimite.error;
                        v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                     END IF;
                     v_msj_bitacora := v_msj_bitacora || ', resLim: ' || v_resLimite.codRespuesta;
                  END IF;
               END IF;
               v_retorno.respuestaLimite := v_resLimite.codRespuesta;
               v_lugar    := 'Verificando claves';
               IF v_retorno.error = 'N' THEN
                  v_msj_respuesta.error := 'N';
                  IF p_modo IN ('C', 'A') THEN

                     IF v_resLimite.codRespuesta IN ('10', '11') THEN
                        -- clave transaccional requerida
                        v_msj_respuesta := lf_obt_cla_validar(p_claveTransaccional, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, 'T');
                     END IF;

                     IF v_msj_respuesta.error = 'N' THEN
                        IF v_resLimite.codRespuesta IN ('01', '11') THEN
                           -- token requerido
                           v_msj_respuesta := paw_seg.fu_obt_tok_validar(p_claveToken, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, p_modo);
                        END IF;
                     END IF;

                     IF v_msj_respuesta.error = 'S' THEN
                        v_retorno.error                := v_msj_respuesta.error;
                        v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
                     END IF;
                  END IF;
               END IF;
               --
               ---
               IF p_modo <> 'C' OR v_retorno.error = 'S' THEN
                  v_lugar := 'Borrando pendientes 2';
                  pag_prv.PR_ELI_PROV_TMP(p_cod_ente, SYSDATE, v_nro_archivo);
                  v_lugar := 'Borrando pendientes 3';
                  pag_prv.PR_ELI_FAC_TMP(p_cod_ente, SYSDATE, v_nro_archivo);
               END IF;
               IF v_retorno.error = 'N' AND p_modo = 'C' THEN
                  --
                  SELECT s_nro_documento.NEXTVAL
                    INTO v_nro_documento
                    FROM dual;

                  v_retorno.numeroDocumento := v_nro_documento;
                  v_retorno.cantidadAutorizadores := v_can_aut_requeridas;

                  IF v_can_aut_requeridas > 0 THEN
                     v_lugar := 'Insertando mov pendiente';
                     --- inserto el movimiento pendiente de autorización

                     INSERT INTO bw_mov_pendientes
                        (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cantidad, etiqueta, dato, etiqueta2, dato2, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, referencia, tip_pago)
                     VALUES
                        (v_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito, v_cod_moneda, v_des_pendiente, v_tot_debito, v_can_ordenes, 'Ente', p_cod_ente, 'Fechas de Pago', to_char(p_fec_pago1, 'dd/mm/yyyy'), 'P', v_can_aut_requeridas, v_can_aut_requeridas, v_usu_sesion.codigoPersona, v_nro_archivo, v_tip_pago);
                  ELSE
                     /* OMM 03/05/2011 Se inserta como movimiento pendiente solo para agrupar
                     para el procedimiento de generacion de movimientos*/
                     INSERT INTO bw_mov_pendientes
                        (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cantidad, etiqueta, dato, etiqueta2, dato2, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, referencia, tip_pago)
                     VALUES
                        (v_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito, v_cod_moneda, v_des_pendiente, v_tot_debito, v_can_ordenes /*p_can_orden*/, 'Ente', p_cod_ente, 'Fechas de Pago', to_char(p_fec_pago1, 'dd/mm/yyyy') /*|| ' ' || to_char(p_fec_pago2, 'dd/mm/yyyy')*/, 'C', 0, 0, v_usu_sesion.codigoPersona, v_nro_archivo, v_tip_pago);

                     pag_prv.PR_VER_DAT_TMP(p_cod_ente, p_fec_pago1, NULL, v_error, 'S', v_nro_documento, v_nro_cta_debito, v_nro_archivo);

                     IF v_error IS NOT NULL THEN
                        pr_mensajeUsuario(PRO_ERR_VER_PAGO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        v_msj_bitacora := v_msj_bitacora || ', err: [' || substr(v_error, 1, 50) || ']';
                     ELSE
                        -- OMM 02/05/2011 Se generan los movimientos automáticamente
                        IF to_char(p_fec_pago1, 'DD/MM/YYYY') = trunc(SYSDATE) THEN
                           pag_prv.PR_PRO_PAGO(p_cod_ente, v_nro_documento, v_err_pago);
                           IF v_err_pago <> '00' THEN
                              pr_mensajeUsuario(PRO_ERR_PRO_PAGO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           ELSE
                              it_mail.mail(fug_obt_dir_correo, fug_obt_pardinamico('SUE_DIR_CORREO'), 'Pago a Proveedores en Linea',
                                           'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) || 'Codigo  : ' || p_cod_ente || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Monto   : ' || to_char(v_tot_debito, '999G999G999G999D99') || ' ' || v_cod_moneda || chr(10) || 'Cantidad: ' || to_char(p_can_orden) || chr(10) || 'Fecha de Pago: ' || to_char(p_fec_pago1) || chr(10) || chr(10) || 'Atentamente. ');
                           END IF;
                        ELSE
                           it_mail.mail(fug_obt_dir_correo, fug_obt_pardinamico('SUE_DIR_CORREO'), 'Pago a Proveedores Fecha Futura',
                                        'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) || 'Codigo  : ' || p_cod_ente || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Monto   : ' || to_char(v_tot_debito, '999G999G999G999D99') || ' ' || v_cod_moneda || chr(10) || 'Cantidad: ' || to_char(p_can_orden) || chr(10) || 'Fecha de Pago: ' || to_char(p_fec_pago1) || chr(10) || chr(10) || 'Atentamente. ');
                        END IF;
                     END IF;
                  END IF;

                  v_lugar := 'Enviando correo incorrecto';
                  -- si hubieron registros eliminados por el usuario se envía para conocimiento del ente
                  IF (v_error IS NULL AND length(p_par_errores) > 0) THEN
                     -- obtenemos la direccion de correo de la empresa
                     BEGIN
                        v_dir_correo := fug_obt_dir_mail_per(v_usu_sesion.codigoEmpresa);
                     EXCEPTION
                        WHEN OTHERS THEN
                           v_dir_correo := fug_obt_pardinamico('SUE_DIR_CORREO');
                     END;
                     it_mail.mail_attach(fug_obt_dir_correo,
                                         v_dir_correo,
                                         'Pago a Proveedores - Registros No Procesados',
                                         'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) ||
                                         'Codigo  : ' || p_cod_ente || chr(10) ||
                                         'Empresa : ' || v_des_ente || chr(10) ||
                                         'Moneda  : ' || v_cod_moneda || chr(10) ||
                                         'Fecha de Pago: ' || to_char(p_fec_pago1) || chr(10) || chr(10) ||
                                         'Se envia adjunto los registros no acreditados' || chr(10) || chr(10) ||
                                         'Atentamente. ',
                                         RPAD('CUENTA', 15) || RPAD('BENEFICIARIO', 50) || RPAD('MONTO', 18)
                                                            || RPAD('MOTIVO', 40) || chr(13) || chr(10) || RPAD('-', 123, '-')
                                                            || REPLACE(p_par_errores, '*', chr(13) || chr(10)),
                                        p_cod_ente || '_' || v_cod_moneda || '_reg_eli_' || to_char(SYSDATE, 'yyyymmddhh24miss') || '.txt');
                  END IF;
               END IF;
            ELSE
               pr_mensajeUsuario(PRO_CAN_ORD_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;

         END IF;
      END IF;
      v_lugar := 'Registrando log';
      v_retorno.cantidadProveedores := v_can_ordenes;
      v_retorno.montoTotal := v_tot_debito;
      IF v_retorno.error = 'S' THEN
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      ELSE
         IF p_modo = 'C' THEN
            lp_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/,
                          v_cod_moneda /*p_cod_moneda */,
                          v_tot_debito /*p_monto*/,
                          NULL /*p_nro_cta_contra*/,
                          p_can_orden /*p_cantidad*/,
                          'Ente' /*p_etiqueta*/,
                          p_cod_ente /*p_dato*/,
                          'Fec.Pago',
                          to_char(p_fec_pago1) ,
                          'Yaguarete',
                          NULL,
                          '000',
                          v_usu_sesion.codigoPersona,
                          v_cod_operacion,
                          v_nro_documento,
                          p_codigoCanal,
                          p_sesion,
                          v_usu_sesion.codigoEmpresa);
         END IF;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      END IF;
      -- siempre se responde con los detalles, sea o no sea con errores
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(PRO_ERR_DAT_INVALIDOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', lug: ' || v_lugar || ', cantReg: ' || v_can_ordenes/*v_can_detalles*/ || ', ORA-ERR: [' ||substr(SQLERRM, 1, 200) ||'] '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END; -- Pago a Proveedores.


   -- Historico de pago a proveedores (60 dias a partir de la fecha)
   FUNCTION fu_obtenerHistoricoProveedores(p_sesion             IN VARCHAR2,
                                           p_codigoCanal        IN VARCHAR2,
                                           p_fechaInicial       IN DATE DEFAULT NULL,
                                           p_fechaFinal         IN DATE DEFAULT NULL,
                                           p_cuentaBeneficiario IN VARCHAR2 DEFAULT NULL,
                                           p_nombreEntidad      IN VARCHAR2 DEFAULT NULL) RETURN typ_pagoProveedores IS
      v_cod_ente         ge_entes.cod_ente%TYPE; -- código del ente
      v_can_detalles     NUMBER(10) := 0; -- cantidad de cuentas
      v_fec_desde        DATE := p_fechaInicial;
      v_fec_hasta        DATE := p_fechaFinal;
      v_cta_beneficiario VARCHAR2(35); -- cta. o nombre del beneficiario
      v_des_entidad      gv_snp_participantes.participante%TYPE;
      v_nom_entidad      gv_snp_participantes.participante%TYPE;
      v_cod_operacion    VARCHAR2(3) := '225';
      v_fec_actual       DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy;
      v_retorno          typ_pagoProveedores := typ_pagoProveedores();
      v_detalle          typ_detalleProveedor := typ_detalleProveedor();
      v_lis_detalle      typ_listadetalleproveedor := typ_listadetalleproveedor();
      v_usu_sesion       typ_validarsesion;
      v_msj_caja         typ_mensajeCaja;
      v_permiso          typ_obtenerPermisos;
      v_lugar            VARCHAR2(100);
      v_carga            VARCHAR2(1);
      v_msj_bitacora     VARCHAR2(500);
      v_snp_estado       ge_snp_transferencias.estado%TYPE;
      v_snp_situacion    ge_snp_transferencias.situacion%TYPE;
      HIS_PRO_RAN_FEC_INVALIDA CONSTANT VARCHAR2(15) := 'HIS_RAN_FEC_INV';
      HIS_PRO_RAN_FEC_EXCEDIDO CONSTANT VARCHAR2(15) := 'HIS_RAN_FEC_EXE';
      HIS_PRO_FEC_DES_MAYOR    CONSTANT VARCHAR2(15) := 'HIS_FEC_DES_MAY';
      HIS_PRO_FEC_EXCESO       CONSTANT VARCHAR2(15) := 'HIS_PRO_FEC_EXE';
      HIS_PRO_ERR_OBT_DATOS    CONSTANT VARCHAR2(15) := 'HIS_PRO_OBT_DAT';
      -- movimientos de pago a proveedores por ente
      CURSOR c_mov_proveedores(p_cod_ente         IN ge_entes.cod_ente%TYPE,
                               p_fec_desde        IN ge_pag_proveedores.fec_pago%TYPE,
                               p_fec_hasta        IN ge_pag_proveedores.fec_pago%TYPE,
                               p_cta_beneficiario IN VARCHAR2) IS
         SELECT gp.nro_cta_credito, gp.cod_moneda, gp.fec_pago, gp.monto,
                gp.referencia, gp.beneficiario, gp.cod_ente, gp.nro_orden,
                gp.nro_factura, gp.for_pago, gp.ref_facturas, gp.concepto,
                mp.cod_per_ingreso, mp.nro_documento, mp.fec_insercion pen_fec,
                gp.nro_cta_beneficiario, gp.ind_valor, gp.nro_doc_beneficiario,
                gp.cod_tip_doc_beneficiario, gp.ent_bca_beneficiario,gp.nro_con_cambio,
                gp.estado, gp.fec_insercion prv_fec, gp.nro_referencia
           FROM ge_pag_proveedores gp, bw_mov_pendientes mp
          WHERE gp.cod_ente = p_cod_ente
            AND mp.cod_per_principal = v_usu_sesion.codigoEmpresa
            AND mp.cod_tip_mensaje = '075'
            AND gp.referencia = mp.nro_documento
            AND to_char(gp.cod_ente) = mp.dato
            --AND gp.estado = 'N'
            AND gp.monto <> 0
            AND ( -- para buscar por cta. crédito o beneficiario
                  p_cta_beneficiario IS NULL OR gp.nro_cta_credito = p_cta_beneficiario
                  OR gp.nro_cta_beneficiario = p_cta_beneficiario
                  OR lower(gp.beneficiario) LIKE '%' || lower(p_cta_beneficiario) || '%')
            AND gp.fec_pago >= p_fec_desde
            AND gp.fec_pago <= p_fec_hasta
       ORDER BY gp.fec_pago DESC;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- obtenemos los parametros recibidos para búsqueda
      v_lugar            := 'Obteniendo parametros';
      v_cta_beneficiario := depurarAlfanumerico(p_cuentaBeneficiario, 35);
      v_nom_entidad      := lower(depurarTextos(p_nombreEntidad, 60));
      v_msj_bitacora     := substr('fecIni:'||p_fechaInicial
                                            ||', fecFin:'||p_fechaFinal
                                            ||', ctaBen:'||v_cta_beneficiario
                                            ||', ent: '||v_nom_entidad, 1, 500);

      -- 1. valido la clave del cliente
      v_lugar := 'Validacion de la clave';
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);
      -- 2. verifica el canal de origen
      v_lugar := 'Validacion de la caja';
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 3. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_lugar := 'Control de permisos';
      v_permiso := lf_obt_permisos(v_usu_sesion, '075');
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --2. Obtengo el histórico de pagos
      IF v_retorno.error = 'N' THEN
         BEGIN
            BEGIN
               -- obtenemos la fecha inicial, por defecto 60 días
               v_lugar := 'Obteniendo fecha inicial';
               IF p_fechaInicial IS NULL THEN
                  v_fec_desde := v_fec_actual - 60;
               ELSE
                  v_fec_desde := p_fechaInicial;
               END IF;
               -- obtenemos la fecha final, por defecto fecha de hoy
               v_lugar := 'Obteniendo fecha final';
               IF p_fechaFinal IS NULL THEN
                  v_fec_hasta := v_fec_actual;
               ELSE
                  v_fec_hasta := p_fechaFinal;
               END IF;
            EXCEPTION
               WHEN OTHERS THEN
                  pr_mensajeUsuario(HIS_PRO_RAN_FEC_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || 'ORA-ERR: [' || substr(SQLERRM, 1, 100) ||'] '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  RETURN v_retorno;
            END;
            -- la fecha inicial no puede exceder los 60 días
            IF v_retorno.error = 'N' AND (v_fec_actual - v_fec_desde) > 60 OR (v_fec_actual - v_fec_hasta) > 60 THEN
               pr_mensajeUsuario(HIS_PRO_RAN_FEC_EXCEDIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
            -- se valida el rango de fechas
            IF v_retorno.error = 'N' AND v_fec_hasta < v_fec_desde THEN
               pr_mensajeUsuario(HIS_PRO_FEC_DES_MAYOR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
            -- el rango no puede exceder 60 días
            IF v_retorno.error = 'N' AND (v_fec_hasta - v_fec_desde) > 60 THEN
               pr_mensajeUsuario(HIS_PRO_FEC_EXCESO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
            -- las fechas son válidas, continuamos
            IF v_retorno.error = 'N' THEN
               -- obtenemos el código del ente para pago a proveedores
               v_lugar := 'Obteniendo codigo del ente';
               SELECT ge.cod_ente
                 INTO v_cod_ente
                 FROM ge_entes ge
                WHERE ge.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
                  AND ge.tipo = 'PR';
               -- armamos el detalle
               v_lugar := 'armando el detalle';
               FOR mv IN c_mov_proveedores(v_cod_ente, v_fec_desde, v_fec_hasta, v_cta_beneficiario)
               LOOP
                  v_carga := 'S';

                  -- si el usuario no registro, verificamos si autorizo/rechazo
                  IF mv.cod_per_ingreso <> v_usu_sesion.codigoPersona THEN
                     IF paw_can.fu_ver_autorizacion(mv.nro_documento, v_usu_sesion.codigoPersona) = 'N' THEN
                        v_carga := 'N';
                     END IF;
                  END IF;
                  v_des_entidad := lf_obt_bco_snp(mv.ent_bca_beneficiario);
                  IF v_nom_entidad IS NOT NULL THEN
                     IF instr(lower(v_des_entidad), v_nom_entidad) = 0 THEN
                        v_carga := 'N';
                     END IF;
                  END IF;

                  IF v_carga = 'S' THEN
                     v_can_detalles := v_can_detalles + 1;
                     v_detalle.numeroOrden          := mv.nro_orden;
                     v_detalle.numeroFactura        := substr(mv.nro_factura, 1, 20);
                     v_detalle.formaPago            := mv.for_pago;
                     v_detalle.fechaPago            := mv.fec_pago;
                     v_detalle.numeroComprobante    := mv.referencia;
                     v_detalle.numeroCuentaCredito  := mv.nro_cta_credito;
                     v_detalle.montoCredito         := mv.monto;
                     v_detalle.nombreBeneficiario   := substr(mv.beneficiario, 1, 60);
                     v_detalle.codigoMoneda         := mv.cod_moneda;
                     v_detalle.concepto             := substr(mv.concepto, 1, 40);
                     v_detalle.codigoProceso        := NULL;
                     v_detalle.referenciaFacturas   := substr(mv.ref_facturas, 1, 300);
                     v_detalle.numeroBanco          := mv.ent_bca_beneficiario;
                     v_detalle.descripcionBanco     := v_des_entidad;
                     v_detalle.tipoDocumento        := substr(mv.cod_tip_doc_beneficiario, 1, 3);
                     v_detalle.numeroDocumento      := substr(mv.nro_doc_beneficiario, 1, 20);
                     v_detalle.tipoMT               := mv.ind_valor;
                     v_detalle.numeroContrato       := mv.nro_con_cambio;
                     v_detalle.numeroCuentaBeneficiario := substr(mv.nro_cta_beneficiario, 1 ,35);

                     IF mv.estado = 'C' THEN -- pendiente
                        v_detalle.codigoProceso := '1';
                     ELSIF mv.estado = 'N' THEN -- confirmado
                        IF mv.for_pago = 'I' THEN --  chequear los pagos SIPAP
                           BEGIN
                              BEGIN
                              SELECT t.estado, t.situacion
                                INTO v_snp_estado, v_snp_situacion
                                FROM ge_snp_transferencias t
                               WHERE t.nro_referencia = mv.nro_referencia
                                 AND trunc(t.fec_insercion) = trunc(mv.prv_fec);
                                EXCEPTION
                                  WHEN NO_DATA_FOUND THEN
                                    SELECT t.estado, t.situacion
                                    INTO v_snp_estado, v_snp_situacion
                                    FROM ge_snp_transferencias_his t
                                    WHERE t.nro_referencia = mv.nro_referencia
                                    AND trunc(t.fec_insercion) = trunc(mv.prv_fec);
                                END;
                              IF v_snp_estado IN ('C','E','R') OR v_snp_situacion IN ('C','E','T') THEN
                                 v_detalle.codigoProceso := '2';
                              ELSIF v_snp_situacion = 'L' AND v_snp_estado = 'A' THEN
                                 v_detalle.codigoProceso := '0';
                              ELSE
                                 v_detalle.codigoProceso := '1';
                              END IF;
                           EXCEPTION
                              WHEN OTHERS THEN
                                 v_detalle.codigoProceso := '2';
                           END;
                        ELSE
                           v_detalle.codigoProceso := '0';
                        END IF;
                     ELSE
                        v_detalle.codigoProceso := '2'; -- rechazado
                     END IF;

                     v_lis_detalle.extend;
                     v_lis_detalle(v_lis_detalle.count) := v_detalle;
                  END IF;
               END LOOP;
               v_retorno.cantidadProveedores   := v_can_detalles;
               v_retorno.listaProveedores      := v_lis_detalle;
               v_retorno.respuestaLimite       := NULL;
               v_retorno.cantidadAutorizadores := 0;
               v_retorno.numeroDocumento       := NULL;
               v_retorno.montoTotal            := NULL;
            END IF;
         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(HIS_PRO_ERR_OBT_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || 'ORA-ERR: [' || substr(SQLERRM, 1, 100) ||'] '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
         END;
      END IF;
      v_lugar := 'retornando respuesta';
      IF v_retorno.error = 'N' THEN
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      ELSE
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', lug: ' || v_lugar || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END IF;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', lug: ' || v_lugar || ', canReg: ' || v_can_detalles || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' ||fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;
   -- Funcion para obtener los movimientos de la banca empresas del dia
   FUNCTION fu_obtenerAutorizacionesDelDia(p_sesion      IN VARCHAR2,
                                           p_codigoCanal IN VARCHAR2,
                                           p_estado      IN VARCHAR2 DEFAULT NULL,
                                           p_permiso     IN VARCHAR2 DEFAULT 'N',
                                           p_rango       IN NUMBER DEFAULT 0,
                                           p_canItems    IN NUMBER DEFAULT NULL,
                                           p_nroPagina   IN NUMBER DEFAULT NULL ) RETURN typ_autorizacionesDelDia IS
      v_can_detalles   NUMBER := 0;
      v_cod_operacion  VARCHAR2(3) := '024';
      v_cta_formateada VARCHAR2(17);
      v_usu_sesion     typ_validarSesion;
      v_msj_caja       typ_mensajeCaja;
      v_permiso        typ_obtenerPermisos;
      v_retorno        typ_autorizacionesDelDia := typ_autorizacionesDelDia();
      v_lis_detalle    typ_listadetallependiente := typ_listadetallependiente();
      v_detalle        typ_detallePendiente := typ_detallePendiente();
      v_carga          VARCHAR2(1);
      v_rango          NUMBER := nvl(p_rango, 0);
      v_tkd_admin      VARCHAR2(1);
      v_msj_bitacora   VARCHAR2(500) := 'est: '||p_estado||', canItem:'||p_canItems||', nroPag:'||p_nroPagina;
      -- detalle de movimientos pendientes, anulados o confirmados
      CURSOR c_ope_pendientes(p_cod_per_empresa IN ba_personas.cod_persona%TYPE) IS
         SELECT * FROM (
         SELECT rownum rowb, d.*
           FROM (SELECT a.nro_documento, a.fec_hora, b.descripcion, a.cod_tip_mensaje,
                        fug_cta_formateada(c.cod_modulo, c.cod_modalidad, c.cod_oficina,
                        c.nro_cuenta, c.cod_moneda) cta_formateada, dato2, dato,
                        a.nro_cuenta, a.cod_moneda, a.monto, c.cod_modulo, a.estado est_mov,
                        decode(a.estado, 'A', 'Anulada', 'C', 'Confirmada', 'P', 'Pendiente', 'E', 'Encolado', 'B', 'Eliminado') estado,
                        a.referencia, a.can_aut_requeridas, a.can_aut_faltantes, a.cod_per_ingreso, a.fec_insercion
                   FROM ge_cuentas c, bw_tip_mensajes b, bw_mov_pendientes a
                  WHERE a.cod_per_principal = p_cod_per_empresa
                    AND c.nro_cuenta = a.nro_cuenta
                    AND (nvl(p_estado, 'T') = 'T' /*IS NULL*/ OR a.estado = p_estado)
                    AND b.cod_tip_mensaje = a.cod_tip_mensaje
                    AND a.cod_tip_mensaje NOT IN ('070', '075')
                    AND trunc(a.fec_insercion) >= trunc(SYSDATE - v_rango)
                 -- ORDER BY TRUNC(a.fec_insercion) DESC, DECODE(a.estado, 'P', 0, 'C', 1, 2) ASC
                ) d
         union
         SELECT rownum rowb, d.*
           FROM (SELECT a.nro_documento, a.fec_hora, b.descripcion, a.cod_tip_mensaje,
                        fug_cta_formateada(c.cod_modulo, c.cod_modalidad, c.cod_oficina,
                        c.nro_cuenta, c.cod_moneda) cta_formateada, dato2, dato,
                        a.nro_cuenta, a.cod_moneda, a.monto, c.cod_modulo, a.estado est_mov,
                        decode(a.estado, 'A', 'Anulada', 'C', 'Confirmada', 'P', 'Pendiente', 'E', 'Encolado', 'B', 'Eliminado') estado,
                        a.referencia, a.can_aut_requeridas, a.can_aut_faltantes, a.cod_per_ingreso, a.fec_insercion
                   FROM ge_cuentas c, bw_tip_mensajes b, bw_mov_pendientes a
                  WHERE a.cod_per_principal = p_cod_per_empresa
                    AND c.nro_cuenta = a.nro_cuenta
                    AND (nvl(p_estado, 'T') = 'T' /*IS NULL*/ OR a.estado = p_estado)
                    AND b.cod_tip_mensaje = a.cod_tip_mensaje
                    AND a.cod_tip_mensaje IN ('070','075')
                    AND  trunc(SYSDATE - v_rango)<=to_date(a.dato2,'DD/MM/YYYY')
                  --ORDER BY TRUNC(a.fec_insercion) DESC, DECODE(a.estado, 'P', 0, 'C', 1, 2) ASC
                ) d
         union
         SELECT rownum rowb, d.*
         FROM (SELECT a.nro_documento, a.fec_hora, b.descripcion,
                      a.cod_tip_mensaje, null cta_formateada, a.dato2, dato,
                      a.nro_cuenta, a.cod_moneda, a.monto,
                      null cod_modulo, a.estado est_mov,
                      decode(a.estado, 'A', 'Anulada', 'C', 'Confirmada', 'P', 'Pendiente', 'E', 'Encolado', 'B', 'Eliminado') estado,
                      a.referencia, a.can_aut_requeridas,
                      a.can_aut_faltantes, a.cod_per_ingreso, a.fec_insercion
                 FROM bw_tip_mensajes b, bw_mov_pendientes a
                WHERE a.cod_per_principal = p_cod_per_empresa
                  AND (nvl(p_estado, 'T') = 'T' /*IS NULL*/ OR a.estado = p_estado)
                  AND b.cod_tip_mensaje = a.cod_tip_mensaje
                  AND a.cod_tip_mensaje IN ('008','150')
                  AND TRUNC(SYSDATE - nvl(p_rango, 10)) <= TRUNC(a.fec_insercion)
         ) d) e ORDER BY TRUNC(e.fec_insercion) DESC, DECODE(e.estado, 'P', 0, 'C', 1, 2) ASC ;
   BEGIN
      -- Valido la Sesión del Cliente
      v_usu_sesion := fu_validarsesion(p_sesion, p_codigoCanal);

      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombrerespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionrespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- Verifica si el usuario tiene acceso a la opcion y en que condicion
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);

      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'est: ' || p_estado || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- Verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);

      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora|| ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ENTRADA);

      v_tkd_admin := paw_otp.fu_es_aut_softoken(v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa);

      -- selecciona los movimientos pendientes
      FOR mp IN c_ope_pendientes(v_usu_sesion.codigoEmpresa)
      LOOP

         IF mp.cod_tip_mensaje = '008' AND v_tkd_admin = 'N' THEN
            CONTINUE;
         END IF;
         v_carga := 'S';
         v_permiso := lf_obt_permisos(v_usu_sesion, mp.cod_tip_mensaje);
         IF p_permiso = 'S' THEN
            -- hay error para consultar el mensaje para la persona, no puede verificar
            IF v_permiso.error = 'S' THEN
               v_carga := 'N';
            ELSE
               -- si un usuario no tiene permiso para autorizar, pero el movimiento aun esta pendiente
               -- y sin ninguna firma, el usuario que cargo tiene que poder ver para poder eliminar
               IF v_permiso.autoriza = FALSE AND (mp.est_mov = 'P' OR v_permiso.registra = FALSE) THEN
                  IF mp.cod_per_ingreso <> v_usu_sesion.codigoPersona OR mp.can_aut_requeridas <> mp.can_aut_faltantes THEN
                     v_carga := 'N';
                  END IF;
               END IF;
            END IF;
         END IF;
         -- verificamos si el usuario ya autorizo el movimiento pendiente,
         -- solo para operaciones del dia, en el historico siempre se debe mostrar
         IF v_carga = 'S' AND mp.est_mov = 'P' AND v_rango = 0 THEN
            IF paw_can.fu_ver_mov_autorizado(mp.nro_documento, v_usu_sesion.codigoPersona) = 'S' THEN
               v_carga := 'N';
            END IF;
         END IF;
         -- verificar si el usuario participo en la operacion para el historico
         IF v_carga = 'S' AND v_rango > 0 THEN
            -- si el usuario no registro, verificamos si autorizo/rechazo
            IF mp.cod_per_ingreso <> v_usu_sesion.codigoPersona THEN
               IF paw_can.fu_ver_autorizacion(mp.nro_documento, v_usu_sesion.codigoPersona) = 'N' THEN
                  -- si el documento esta eliminado, verificar si tiene perfil autorizador
                  IF mp.est_mov <> 'B' OR v_permiso.autoriza = FALSE THEN
                     v_carga := 'N';
                  END IF;
               END IF;
            END IF;
         END IF;

         IF v_carga = 'S' THEN
            v_can_detalles := v_can_detalles + 1;
            IF nvl(p_estado, 'x') <> 'T' THEN
               -- para logica de paginacion. si p_canItems es null, no se pagina
               IF p_canItems IS NOT NULL THEN
                  IF v_can_detalles > (p_canItems * p_nroPagina) THEN
                     EXIT;
                  END IF;
               END IF;

               -- para logica de paginacion
               IF v_can_detalles > (nvl(p_canItems, 1) * (nvl(p_nroPagina, 1) - 1)) THEN
                  IF mp.cod_modulo = 5 THEN
                     v_cta_formateada := lf_obt_nro_tarjeta(mp.nro_cuenta, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa);
                  ELSE
                     v_cta_formateada := mp.cta_formateada;
                  END IF;
                  v_detalle.numeroDocumento := mp.nro_documento;
                  v_detalle.fechaHora       := mp.fec_hora;
                  v_detalle.descripcion     := substr(mp.descripcion, 1, 60);
                  v_detalle.numeroCuenta    := substr(v_cta_formateada, 1, 17);
                  v_detalle.codigoMoneda    := mp.cod_moneda;
                  v_detalle.monto           := mp.monto;
                  v_detalle.estado          := substr(mp.estado, 1, 10);
                  v_detalle.codModulo       := mp.cod_modulo;
                  IF mp.est_mov = 'C' AND mp.cod_tip_mensaje IN ('088','034') AND mp.dato2 IS NULL THEN
                     v_detalle.estado := 'Anulada';
                  END IF;
                  v_detalle.dato := NULL;
                  IF mp.cod_tip_mensaje = '008' THEN
                     v_detalle.dato := substr('ALTA OPERADOR ' || fue_obt_nom_persona(mp.cod_per_ingreso), 1, 50);
                  END IF;
                  IF mp.cod_tip_mensaje = '150' THEN
                     v_detalle.dato := substr(mp.dato||' '|| fue_obt_nom_per_corto(mp.cod_per_ingreso), 1, 50);
                  END IF;
                  v_detalle.autorizacionesRequeridas := mp.can_aut_requeridas;
                  v_detalle.autorizacionesFaltantes := mp.can_aut_faltantes;

                  v_lis_detalle.extend;
                  v_lis_detalle(v_lis_detalle.count) := v_detalle;
               END IF;
            END IF;
         END IF;
      END LOOP;
      IF nvl(p_estado, 'x') <> 'T' THEN
         v_retorno.cantidadDetalles := v_lis_detalle.count;
      ELSE
         v_retorno.cantidadDetalles   := v_can_detalles;
      END IF;
      v_retorno.listaDetalles      := v_lis_detalle;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora|| ', canDet:' || v_can_detalles || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora|| ', ORA-ERR: [' || substr(SQLERRM, 1, 300) || ']' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
         RETURN v_retorno;
   END;

   PROCEDURE lp_obt_sue_errores(p_cod_ente            IN ge_entes.cod_ente%TYPE,
                                p_referencia          IN ge_pag_sueldos.nro_secuencia%TYPE,
                                p_listaDetalleSalario IN OUT typ_listaDetalleSalario,
                                p_fecha               IN DATE DEFAULT NULL) IS
      v_can_sue_errores NUMBER;
      v_det_salario     typ_detalleSalario := typ_detalleSalario();
      v_fec_actual      DATE := nvl(p_fecha, pag_cal.fu_obt_fec_actual(9)); -- fecha de hoy;
      CURSOR c_sue_error IS
         SELECT x.nro_cuenta, substr(z.denominacion, 1, 40) denominacion, x.cod_moneda cod_moneda, x.monto, x.msj_error
           FROM ge_cuentas z, ge_pag_sueldos_err x
          WHERE x.cod_ente = p_cod_ente
            AND x.fec_proceso = v_fec_actual
            AND nvl(x.nro_secuencia, 0) = nvl(p_referencia, 0)
            AND to_char(x.nro_cuenta) = z.nro_cuenta;
   BEGIN
      -- buscamos si hubieron registros con error
      SELECT nvl(COUNT(0), 0)
        INTO v_can_sue_errores
        FROM ge_pag_sueldos_err x
       WHERE x.cod_ente = p_cod_ente
         AND x.fec_proceso = v_fec_actual
         AND nvl(x.nro_secuencia, 0) = nvl(p_referencia, 0);
      -- desplegamos informacion de errores si las hubo
      IF v_can_sue_errores > 0 THEN
         FOR reg IN c_sue_error
         LOOP
            v_det_salario.numeroCuenta := reg.nro_cuenta;
            v_det_salario.tipo := 'C';
            v_det_salario.descripcionTipoCuenta := NULL;
            v_det_salario.nombreCuenta := substr(reg.denominacion, 1, 50);
            v_det_salario.codigoMoneda := reg.cod_moneda;
            v_det_salario.monto := reg.monto;
            v_det_salario.error := 'S';
            v_det_salario.mensajeRespuesta := substr(reg.msj_error, 1, 200);
            p_listaDetalleSalario.extend;
            p_listaDetalleSalario(p_listaDetalleSalario.count) := v_det_salario;
         END LOOP;
      END IF;
   END;

   FUNCTION lf_obt_dat_extra(p_cod_per_principal IN bw_mov_pendientes.cod_per_principal%TYPE,
                             p_nro_documento     IN bw_mov_pendientes.nro_documento%TYPE,
                             p_cod_tip_mensaje   IN bw_mov_pendientes.cod_tip_mensaje%TYPE) RETURN VARCHAR2 IS
      v_retorno VARCHAR2(2000) := '{' || chr(10)|| '  "valores" : [ ' || chr(10);
      rg_mpen   bw_mov_pendientes%ROWTYPE;
   BEGIN
      SELECT *
        INTO rg_mpen
        FROM bw_mov_pendientes p
       WHERE p.nro_documento = p_nro_documento
         AND p.cod_per_principal = p_cod_per_principal
         AND p.cod_tip_mensaje = p_cod_tip_mensaje;

      -- datos extras para transferencias SNP
      IF p_cod_tip_mensaje = '036' THEN
         DECLARE
            v_nom_beneficiario ge_snp_transferencias.nom_beneficiario%TYPE;
         BEGIN
            select transf.nombre
            INTO v_nom_beneficiario
            from (SELECT t.nom_beneficiario as nombre
                  FROM ge_snp_transferencias t
                  WHERE t.nro_referencia = rg_mpen.referencia
                  union all 
                  SELECT p.nom_cli_receptor as nombre
                  FROM ge_spi_transferencias p
                  WHERE p.nro_referencia = rg_mpen.referencia) transf;

            v_retorno := v_retorno || '    { "etiqueta" : "Nombre Beneficiario", "valor" : "' || v_nom_beneficiario || '" } ';
         EXCEPTION
            WHEN OTHERS THEN
               NULL;
         END;
      ELSIF p_cod_tip_mensaje = '039' THEN
         v_retorno := v_retorno || '    { "etiqueta" : "Nro contrato", "valor" : "' || rg_mpen.referencia || '" } ';
      ELSIF p_cod_tip_mensaje = '055' THEN
         v_retorno := v_retorno || '{ "etiqueta" : "Nombre Beneficiario", "valor" : "' || fuw_nom_cre_tra_gnb(p_nro_documento,p_cod_per_principal) || '"';
         
         IF fuw_obt_bts_pendiente(p_nro_documento, 'P') = 'S' THEN
            v_retorno := substr(v_retorno || ', "etiqueta" : "pendingConfirm", "valor" : "' || fug_obt_pardinamico('MSJ_TIMEOUT') || '"', 1, 2000);
         END IF;
         v_retorno := substr(v_retorno ||' }', 1, 2000); 
      ELSIF p_cod_tip_mensaje = '150' THEN
         v_retorno := v_retorno || '{ "etiqueta" : "Empresa", "valor" : "' || fue_obt_nom_persona(rg_mpen.cod_per_principal) || '" } ';
      ELSE
         RETURN NULL;
      END IF;
      v_retorno := v_retorno || chr(10) || '  ]' || chr(10) || '}';
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         RETURN NULL;
   END;

   FUNCTION fu_obtenerDetalleAutorizacion(p_sesion          IN VARCHAR2,
                                          p_codigoCanal     IN VARCHAR2,
                                          p_numeroDocumento IN bw_mov_pendientes.nro_documento%TYPE,
                                          p_estado          IN VARCHAR2 DEFAULT 'P',
                                          p_fecha           IN DATE DEFAULT NULL) RETURN typ_detalleAutorizacion IS
      --devuelve los datos del movimiento pendiente de autorizar en formato html para imprimir en la web
      v_cod_per_principal     bw_mov_pendientes.cod_per_principal%TYPE;
      v_fec_hora              bw_mov_pendientes.fec_hora%TYPE;
      v_cod_tip_mensaje       bw_mov_pendientes.cod_tip_mensaje%TYPE;
      v_descripcion           bw_mov_pendientes.descripcion%TYPE;
      v_monto                 bw_mov_pendientes.monto%TYPE;
      v_mto_cargo             bw_mov_pendientes.mto_cargo%TYPE;
      v_mto_iva               bw_mov_pendientes.mto_iva%TYPE;
      v_cotizacion            bw_mov_pendientes.cotizacion%TYPE;
      v_equ_local             bw_mov_pendientes.mto_equ_local%TYPE;
      v_cot_contra            bw_mov_pendientes.cot_contra%TYPE;
      v_mto_contra            bw_mov_pendientes.mto_contra%TYPE;
      v_estado                bw_mov_pendientes.estado%TYPE;
      v_can_aut_requeridas    bw_mov_pendientes.can_aut_requeridas%TYPE;
      v_can_aut_faltantes     bw_mov_pendientes.can_aut_faltantes%TYPE;
      v_etiqueta              bw_mov_pendientes.etiqueta%TYPE;
      v_dato                  bw_mov_pendientes.dato%TYPE;
      v_etiqueta2             bw_mov_pendientes.etiqueta2%TYPE;
      v_dato2                 bw_mov_pendientes.dato2%TYPE;
      v_cod_per_ingreso       bw_mov_pendientes.cod_per_ingreso%TYPE;
      v_tip_pago              bw_mov_pendientes.tip_pago%TYPE;
      v_fec_insercion         bw_mov_pendientes.fec_insercion%TYPE;
      v_cod_moneda            ge_movimientos.cod_moneda%TYPE;
      v_cta_formateada        VARCHAR2(20);
      v_cta_contra_formateada bw_mov_pendientes.nro_cta_contra%TYPE;
      v_nro_cuenta            ge_movimientos.nro_cuenta%TYPE;
      v_cta_contra            bw_mov_pendientes.nro_cta_contra%TYPE;
      v_cantidad              bw_mov_pendientes.cantidad%TYPE; --NUMBER;
      --v_existe                VARCHAR2(1);
      v_des_tip_mensaje       bw_tip_mensajes.descripcion%TYPE;
      v_nro_tarjeta           ta_tarjetas.nro_tarjeta%TYPE;
      v_nro_tar_contra        ta_tarjetas.nro_tarjeta%TYPE;
      v_cod_mod_contra        ge_cuentas.cod_modulo%TYPE;
      v_cod_mad_contra        ge_cuentas.cod_modalidad%TYPE;
      v_cod_ofi_contra        ge_cuentas.cod_oficina%TYPE;
      v_cod_mon_contra        ge_cuentas.cod_moneda%TYPE;
      v_denominacion          ge_cuentas.denominacion%TYPE;
      v_tip_pro_sueldo        VARCHAR2(1) := NULL;
      v_referencia            bw_mov_pendientes.referencia%TYPE;
      v_fec_actual            DATE; -- fecha de hoy;
      v_fec_ins_movimiento    date;
      v_retorno               typ_detalleAutorizacion := typ_detalleAutorizacion();
      v_usu_sesion            typ_validarSesion;
      v_msj_caja              typ_mensajeCaja;
      v_permiso               typ_obtenerPermisos;
      v_fec_proceso           DATE;
      v_est_periodo           ge_snp_horarios.estado%TYPE;

      -- movimientos pendientes de sueldos
      CURSOR c_sue_pendientes(p_cod_ente IN NUMBER, p_nro_archivo IN NUMBER, p_fec_pago IN DATE) IS
         SELECT x.nro_cuenta, substr(z.denominacion, 1, 40) denominacion, nvl(x.cod_moneda, v_cod_moneda) cod_moneda, x.monto, x.fec_proceso
           FROM ge_cuentas z, ge_pag_sueldos_tmp x
          WHERE x.cod_ente = p_cod_ente
            AND trunc(x.fec_proceso) = trunc(p_fec_pago)
            AND x.estado = 'H'
            AND x.tipo = 'C'
            AND nvl(x.nro_archivo, 0) = nvl(p_nro_archivo, 0)
            AND to_char(x.nro_cuenta) = z.nro_cuenta;
      -- movimientos confirmados de sueldos
      CURSOR c_sue_confirmados(p_cod_ente IN NUMBER, p_nro_archivo IN NUMBER, p_fec_proceso IN DATE) IS
         SELECT x.nro_cuenta, substr(z.denominacion, 1, 40) denominacion, nvl(x.cod_moneda, v_cod_moneda) cod_moneda, x.monto, x.fec_proceso
           FROM ge_cuentas z, ge_pag_sueldos x
          WHERE x.cod_ente = p_cod_ente
            AND trunc(x.fec_proceso) = trunc(p_fec_proceso)
            AND x.estado = 'N'
            AND x.tipo = 'C'
            AND x.procesado = 'S'
            AND nvl(x.nro_secuencia, 0) = nvl(p_nro_archivo, 0)
            AND to_char(x.nro_cuenta) = z.nro_cuenta;
      -- movimientos pendientes de proveedores
      CURSOR c_pro_pendientes(p_cod_ente IN NUMBER, p_nro_archivo in number, p_fec_insercion in date) IS
         SELECT x.nro_orden, x.nro_factura, x.ref_facturas, x.for_pago, nvl(substr(z.denominacion, 1, 40), x.beneficiario) denominacion, nvl(x.cod_moneda, v_cod_moneda) cod_moneda, x.monto, x.nro_cta_credito,
                x.cod_tip_doc_beneficiario, x.nro_doc_beneficiario, x.nro_cta_beneficiario, x.ent_bca_beneficiario, x.ind_valor, x.fec_pago
           FROM ge_cuentas z, ge_pag_proveedores_tmp x
          WHERE x.cod_ente = p_cod_ente
            AND trunc(x.fec_insercion) = trunc(p_fec_insercion)
            AND x.tip_carga = 'H'
            AND x.cod_usu_operador IN (v_msj_caja.codigoUsuario,'BBVAAPIUSR')
            AND x.nro_cta_credito = z.nro_cuenta(+)
            and nvl(x.nro_archivo, 0) = nvl(p_nro_archivo, 0)
            order by x.nro_ord_archivo asc;
      -- movimientos confirmados de proveedores
      CURSOR c_pro_pagados(p_cod_ente IN ge_pag_proveedores.cod_ente%TYPE, p_nro_archivo in number, p_fec_pago in date) IS
         SELECT x.nro_orden, x.nro_factura, x.ref_facturas, x.for_pago, nvl(substr(z.denominacion, 1, 40), x.beneficiario) denominacion, nvl(x.cod_moneda, v_cod_moneda) cod_moneda, x.monto, x.nro_cta_credito,
                x.cod_tip_doc_beneficiario, x.nro_doc_beneficiario, x.nro_cta_beneficiario, x.ent_bca_beneficiario, x.ind_valor, x.fec_pago
           FROM ge_cuentas z, ge_pag_proveedores x
          WHERE x.cod_ente = p_cod_ente
            --AND trunc(x.fec_ingreso) = trunc(v_fec_actual)
            AND x.fec_pago = p_fec_pago
            AND x.tip_carga = 'H'
            AND x.cod_usu_operador IN (v_msj_caja.codigoUsuario,'BBVAAPIUSR')
            AND x.nro_cta_credito = z.nro_cuenta(+)
            AND x.referencia = p_numeroDocumento
            and nvl(x.nro_archivo, 0) = nvl(p_nro_archivo, 0)
      order by x.nro_ord_archivo asc;
      -- recaudaciones temporales
      CURSOR c_rec_pendientes(p_cod_ente IN NUMBER, p_nro_archivo IN NUMBER) IS
         SELECT t.fec_operacion, t.nro_cta_debito, t.denominacion, t.nro_cta_credito, t.monto,
                t.nro_factura, t.tip_cobranza, NULL descripcion, 0 cod_error, 'Aprobado' msj_error, nvl(t.estado, 'P') estado
           FROM ge_pag_recaudaciones_tmp t
          WHERE t.cod_ente = p_cod_ente
            AND t.nro_archivo = p_nro_archivo
            AND nvl(t.estado, 'x') <> 'E'
            AND trunc(t.fec_insercion) = trunc(SYSDATE)
          UNION
         SELECT t.fec_operacion, t.nro_cta_debito, t.denominacion, t.nro_cta_credito, t.monto,
                t.nro_factura, t.tip_cobranza, NULL descripcion, e.cod_error, e.msj_error, t.estado
           FROM ge_pag_recaudaciones_tmp t, ge_pag_recaudaciones_err e
          WHERE t.cod_ente = p_cod_ente
            AND t.nro_archivo = p_nro_archivo
            AND nvl(t.estado, 'x') = 'E'
            AND trunc(t.fec_insercion) = trunc(SYSDATE)
            AND e.cod_ente = t.cod_ente
            AND e.nro_archivo = t.nro_archivo
            AND e.nro_cta_debito = t.nro_cta_debito
            AND e.nro_cta_credito = t.nro_cta_credito
            AND e.monto = t.monto
            AND trunc(e.fec_insercion) = trunc(t.fec_insercion);
      -- recaudaciones confirmadas
      CURSOR c_rec_procesadas(p_cod_ente IN NUMBER, p_nro_archivo IN NUMBER) IS
         SELECT t.fec_operacion, t.nro_cta_debito, t.denominacion, t.nro_cta_credito, t.monto, t.nro_documento,
                t.nro_factura, t.tip_cobranza, NULL descripcion, 0 cod_error, 'Aprobado' msj_error, t.estado
           FROM ge_pag_recaudaciones t
          WHERE t.cod_ente = p_cod_ente
            AND t.nro_archivo = p_nro_archivo
            AND nvl(t.estado, 'x') <> 'E'
            AND trunc(t.fec_insercion) = trunc(v_fec_actual)
          UNION
         SELECT t.fec_operacion, t.nro_cta_debito, t.denominacion, t.nro_cta_credito, t.monto, t.nro_documento,
                t.nro_factura, t.tip_cobranza, NULL descripcion, e.cod_error, e.msj_error, t.estado
           FROM ge_pag_recaudaciones t, ge_pag_recaudaciones_err e
          WHERE t.cod_ente = p_cod_ente
            AND t.nro_archivo = p_nro_archivo
            AND nvl(t.estado, 'x') = 'E'
            AND trunc(t.fec_insercion) = trunc(v_fec_actual)
            AND e.cod_ente = t.cod_ente
            AND e.nro_archivo = t.nro_archivo
            AND e.nro_cta_debito = t.nro_cta_debito
            AND e.nro_cta_credito = t.nro_cta_credito
            AND e.monto = t.monto
            AND trunc(e.fec_operacion) = trunc(t.fec_operacion);

     --Pendientes de Gourmet Card
     CURSOR c_acr_gourmet(p_cod_per_empresa IN VARCHAR2,p_nro_archivo in VARCHAR2) IS
       SELECT p.nom_completo, t.nro_tarjeta, g.monto, g.nro_documento, g.fec_recepcion
        FROM bw_mov_pendientes m, ta_acr_gourmet_tmp g, ta_tarjetas t, ba_personas p
       WHERE m.cod_tip_mensaje = '071'
         AND m.cod_per_principal = p_cod_per_empresa
         AND m.dato2 = g.cod_ente
         AND m.dato = g.nro_archivo
         AND m.nro_documento = p_numeroDocumento
         AND t.nro_tarjeta = g.nro_tarjeta
         AND p.cod_persona = t.cod_persona
         AND trunc(m.fec_insercion) = trunc(g.fec_insercion)
         AND trunc(g.fec_insercion)=trunc(sysdate);

     --Procesados de Gourmet Card
     CURSOR c_acr_gourmet_proc(p_cod_per_empresa IN VARCHAR2,p_nro_archivo in VARCHAR2) IS
     SELECT p.nom_completo, t.nro_tarjeta, g.monto, g.nro_documento, g.fec_recepcion
        FROM bw_mov_pendientes m, ta_acr_gourmet g, ta_tarjetas t, ba_personas p
       WHERE m.cod_tip_mensaje = '071'
         AND m.cod_per_principal = p_cod_per_empresa
         AND m.dato2 = g.cod_ente
         AND m.dato = g.nro_archivo
         AND m.nro_documento = p_numeroDocumento
         AND t.nro_tarjeta = g.nro_tarjeta
         AND trunc(m.fec_insercion) = trunc(g.fec_insercion)
         AND p.cod_persona = t.cod_persona;

      --detalle altas -- DYDMR-6437 -- 05/2017 -- Se modifica el cursor
      CURSOR c_alt_empleados(p_cod_ente IN NUMBER, p_nro_archivo IN NUMBER) IS
         SELECT distinct a.nro_cedula, a.tip_documento, a.pri_nombre, a.seg_nombre, a.pri_apellido,
                a.nro_lote, fec_nacimiento,
                case
                  when ( ( nvl(a.error,'x') like '%Cliente%ya%posee%CTA%asignada%Empresa%'
                         or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Ente%'
                         or a.error like '%Cliente%ya%posee%CTA%para%Sub%Modalidad%' )
                       and ( nvl(a.error,'x') not like '%Cliente inhibido para CTA CTE. Se ha creado una CTA. AV.%' ) ) then
                    null
                  else
                    a.error
                end error,
                a.fec_vto_documento, a.doc_pais,
                a.seg_apellido, a.sexo, a.est_civil, a.direccion, a.ciudad, a.pais,
                a.telefono, a.celular, a.mail, a.ape_casada, a.cod_pai_fatca, a.dir_fiscal,
                a.cod_pai_fiscal, a.sueldo, a.profesion, a.fec_ingreso,
                a.tip_contrato, a.direc_kit,
                case
                  when ( ( nvl(a.error,'x') like '%Cliente%ya%posee%CTA%asignada%Empresa%'
                         or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Ente%'
                         or a.error like '%Cliente%ya%posee%CTA%para%Sub%Modalidad%' )
                       and ( nvl(a.error,'x') not like '%Cliente inhibido para CTA CTE. Se ha creado una CTA. AV.%' ) ) then
                    'N'
                  else
                    a.estado
                end estado,
                c.nro_documento as nro_operacion,
                trunc(c.fec_insercion) as fec_insercion, a.nro_cuenta, a.fec_insercion fec_proceso
           FROM ge_pag_sue_emp a
           inner join ge_alt_empleados c on c.cod_ente = a.cod_empresa and c.nro_lote = a.nro_lote
          WHERE a.cod_empresa = p_cod_ente
            AND a.nro_lote = p_nro_archivo
            AND a.fec_insercion = (select min(fec_insercion) from ge_pag_sue_emp p
                            where p.cod_empresa = a.cod_empresa
                              and p.nro_lote = a.nro_lote
                              and p.nro_cedula = a.nro_cedula
                              and p.tip_documento = a.tip_documento
                              and p.pri_nombre = a.pri_nombre
                          )
            AND nvl(a.error,'x') not like '%persona%mismo%Doc%Pri%Nom%Pri%Ape%'
          UNION
         SELECT distinct a.nro_cedula, a.tip_documento, a.pri_nombre, a.seg_nombre, a.pri_apellido,
                a.nro_lote, fec_nacimiento, a.error, a.fec_vto_documento, a.doc_pais,
                a.seg_apellido, a.sexo, a.est_civil, a.direccion, a.ciudad, a.pais,
                a.telefono, a.celular, a.mail, a.ape_casada, a.cod_pai_fatca, a.dir_fiscal,
                a.cod_pai_fiscal, a.sueldo, a.profesion, a.fec_ingreso,
                a.tip_contrato, a.direc_kit,
                case
                  when ( ( nvl(a.error,'x') like '%Cliente%ya%posee%CTA%asignada%Empresa%'
                             or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Ente%'
                             or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Sub%Modalidad%' )
                          and ( nvl(a.error,'x') not like '%Cliente inhibido para CTA CTE. Se ha creado una CTA. AV.%' ) ) then
                    'C'
                  else
                    a.estado
                end estado,
                c.nro_documento as nro_operacion,
                trunc(c.fec_insercion) as fec_insercion, null as nro_cuenta, null as fec_proceso
           FROM ge_pag_sue_emp_tmp a
           LEFT JOIN ge_alt_empleados c on (c.cod_ente = a.cod_empresa and c.nro_lote = a.nro_lote)
          WHERE a.cod_empresa = p_cod_ente
            AND a.nro_lote = p_nro_archivo
            AND a.fec_insercion = (select min(fec_insercion) from ge_pag_sue_emp_tmp p
                            where p.cod_empresa = a.cod_empresa
                              and p.nro_lote = a.nro_lote
                              and p.nro_cedula = a.nro_cedula
                              and p.tip_documento = a.tip_documento
                              and p.pri_nombre = a.pri_nombre
                          )
            AND nvl(a.error,'x') not like '%persona%mismo%Doc%Pri%Nom%Pri%Ape%';
      --detalles de autorizaciones
      CURSOR detalles IS
         SELECT a.cod_persona, a.fec_hora, decode(a.accion, 'A', 'Autorizado', 'B', 'Eliminado', 'Rechazado') accion, a.observacion, b.nom_completo nombre
           FROM ba_personas b, bw_autorizaciones a
          WHERE a.nro_documento = p_numeroDocumento
            AND a.cod_persona = b.cod_persona
       ORDER BY fec_hora;
   BEGIN
      v_retorno.error := 'N';
      v_fec_actual := nvl(p_fecha, trunc(sysdate));--pag_cal.fu_obt_fec_actual(9));
      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error := 'S';
         v_retorno.descripcionError := 'Sesion invalida';
         RETURN v_retorno;
      END IF;
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error := 'S';
         v_retorno.descripcionError := 'Terminal invalida';
         RETURN v_retorno;
      END IF;
      -- 3. verifico si el cliente con su perfil tendrá acceso a consultar el detalle
      v_permiso := lf_obt_permisos(v_usu_sesion, '024');
      IF (v_permiso.error = 'S') THEN
         v_retorno.descripcionError := v_permiso.descripcionRespuesta;
         v_retorno.error            := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, '024', v_usu_sesion.codigoEmpresa, 'obtenerDetalleAutorizacion ', BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      DECLARE
        v_sino VARCHAR2(1);
      BEGIN
         SELECT 'S'
           INTO v_sino
           FROM bw_mov_pendientes p
          WHERE p.nro_documento = p_numeroDocumento
            AND p.cod_per_principal = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona);
      EXCEPTION
         WHEN TOO_MANY_ROWS THEN
            NULL;
         WHEN OTHERS THEN
            v_retorno.error := 'S';
            v_retorno.descripcionError := 'Documento invalido';
            RETURN v_retorno;
      END;
      --recupera el movimiento principal
      BEGIN
         SELECT a.tip_pago, a.fec_insercion, cod_per_principal, fec_hora, a.cod_tip_mensaje, b.descripcion, nro_cuenta, cod_moneda, a.descripcion, monto, nvl(mto_cargo, 0), nvl(mto_iva, 0), cotizacion, mto_equ_local, cantidad, nro_cta_contra, estado, can_aut_requeridas, can_aut_faltantes, etiqueta, dato, cod_per_ingreso, decode(a.nro_cuenta, NULL, NULL, fug_cta_formateada(NULL, NULL, NULL, a.nro_cuenta, a.cod_moneda)), decode(a.nro_cta_contra, NULL, NULL, fug_cta_formateada(NULL, NULL, NULL, a.nro_cta_contra, NULL)),
                a.cot_contra, a.mto_contra, a.etiqueta2, a.dato2, a.referencia,a.fec_insercion
           INTO v_tip_pago, v_fec_insercion, v_cod_per_principal, v_fec_hora, v_cod_tip_mensaje, v_des_tip_mensaje, v_nro_cuenta, v_cod_moneda, v_descripcion, v_monto, v_mto_cargo, v_mto_iva, v_cotizacion, v_equ_local, v_cantidad, v_cta_contra, v_estado, v_can_aut_requeridas, v_can_aut_faltantes, v_etiqueta, v_dato, v_cod_per_ingreso, v_cta_formateada, v_cta_contra_formateada, v_cot_contra, v_mto_contra, v_etiqueta2, v_dato2, v_referencia,v_fec_ins_movimiento
           FROM bw_tip_mensajes b, bw_mov_pendientes a
          WHERE a.nro_documento = p_numeroDocumento
            AND a.cod_tip_mensaje = b.cod_tip_mensaje;
      EXCEPTION
         WHEN no_data_found THEN
            v_retorno.error := 'S';
            v_retorno.descripcionError := 'No existe Movimiento Pendiente. Avise al Oficial';
            -- v_error := 'No existe Movimiento Pendiente. Avise al Oficial.';
         WHEN too_many_rows THEN
            v_retorno.error := 'S';
            v_retorno.descripcionError := 'Varios Movimientos con el mismo criterio. Avise al Oficial';
            -- v_error := 'Varios Movimientos con el mismo criterio. Avise al Oficial.';
         WHEN OTHERS THEN
            v_retorno.error := 'S';
            v_retorno.descripcionError := 'No se puede recuperar Mov.Pendiente ' || p_numeroDocumento;
            --v_error := 'No se puede recuperar Mov.Pendiente ' || p_nro_documento || SQLERRM;
      END;

      IF v_nro_cuenta IS NOT NULL THEN
         --recuperar datos de la cuenta, pag_cta porque es 3 o 4
         pag_cta.PR_OBT_CUENTA(v_nro_cuenta);
         IF PAG_CTA.FU_OBT_COD_ERROR() <> 0 THEN
            v_retorno.error := 'S';
            v_retorno.descripcionError := substr('Recup.Cta ' || pag_cta.fu_obt_msj_error(), 1, 200);
            -- v_error := 'Recup.Cta ' || pag_cta.fu_obt_msj_error();
         END IF;
         IF pag_cta.G_CTAS.cod_modulo = 5 THEN
            --tarjeta
            v_nro_tarjeta := fut_for_tarjeta(fut_obt_nro_tarjeta(v_nro_cuenta));
         ELSE
            v_nro_tarjeta := NULL;
         END IF;
      END IF;
      --recuperar datos de la cuenta contrapartida, no usa pag_cta porque puede ser préstamo
      --se excluyen las transferencias internacionales porque el dato ahí es solo informativo
      IF v_cta_contra IS NOT NULL AND v_cod_tip_mensaje <> '227' AND v_cod_tip_mensaje <> '055' THEN
         BEGIN
            SELECT a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.cod_moneda, denominacion
              INTO v_cod_mod_contra, v_cod_mad_contra, v_cod_ofi_contra, v_cod_mon_contra, v_denominacion
              FROM ge_cuentas a
             WHERE a.nro_cuenta = v_cta_contra;
         EXCEPTION
            WHEN OTHERS THEN
               v_retorno.error := 'S';
               v_retorno.descripcionError := substr('Error al recuperar cuentra contraparte ' || v_cta_contra, 1, 200);
               -- v_error := 'Recup.Cta Contrap. ' || SQLERRM;
         END;
      END IF;
      --BBVADES-2376
      IF v_cod_tip_mensaje = '070' THEN
         v_tip_pro_sueldo := nvl(fug_obt_parentes(v_dato, 'TIP_PRO_SUELDO'), 'O');

         -- si el pago es con fecha futura el pago sera tipo BATCH, independiente de la configuracion del ente
         IF TRUNC(to_date(v_dato2,'DD/MM/YYYY')) > TRUNC(v_fec_actual) THEN
            v_tip_pro_sueldo := 'B';
         END IF;

         IF v_tip_pago = 'A' THEN
            -- pagos de aguinaldo siempre online independientemente
            -- de la configuracion del ente
            v_tip_pro_sueldo := 'O';
         END IF;
      END IF;
      --Fin BBVADES-2376

      --si hubo error devolver el msj de error, sino imprimir comprobante
      IF v_retorno.error = 'N' THEN
         v_retorno.descripcionMensaje := substr(v_des_tip_mensaje, 1, 100);
         v_retorno.numeroComprobante := p_numeroDocumento;
         v_retorno.fechaOperacion := v_fec_hora;
         v_retorno.monedaPrincipal := substr(FUE_OBT_DES_MONEDA(v_cod_moneda), 1, 50);
         v_retorno.codigoMonedaPrincipal := substr(v_cod_moneda, 1, 3);

         IF v_nro_cuenta IS NOT NULL THEN
            v_retorno.cuentaPrincipal := substr(nvl(v_nro_tarjeta, v_cta_formateada) || ' - ' || pag_cta.FU_OBT_NOM_CUENTA, 1, 300);
            v_retorno.tipoCuenta := substr(fue_obt_titulo(fug_obt_des_modal(pag_cta.G_CTAS.cod_modulo, pag_cta.g_ctas.cod_modalidad)), 1, 50);
            v_retorno.oficinaPrincipal := substr(fue_obt_titulo(fue_obt_des_oficina(pag_cta.G_CTAS.COD_OFICINA)), 1, 100);
         END IF;
         v_retorno.montoPrincipal := v_monto;
         v_retorno.montoCargo := v_mto_cargo;
         v_retorno.montoIva := v_mto_iva;
         v_retorno.cotizacion := v_cotizacion;
         v_retorno.montoEquLocal := v_equ_local;
         v_retorno.codigoMovimiento := substr(v_cod_tip_mensaje, 1, 3);
         v_retorno.descripcionMovimiento := substr(v_descripcion, 1, 100);
         v_retorno.cantidad := v_cantidad;
         v_retorno.etiqueta := v_etiqueta;
         v_retorno.dato     := v_dato;
         v_retorno.etiqueta2 := v_etiqueta2;
         v_retorno.dato2     := v_dato2;
         v_retorno.tipPago     := v_tip_pago;
         --se excluyen las transferencias internacionales porque el dato ahí es solo informativo
   IF v_cta_contra IS NOT NULL AND v_cod_tip_mensaje <> '227' and v_cod_tip_mensaje <> '055' THEN
            IF v_cod_mod_contra = 5 THEN
               --tarjeta
               v_nro_tar_contra := trim(fut_for_tarjeta(fut_obt_nro_tarjeta(v_cta_contra)));
            ELSE
               v_nro_tar_contra := NULL;
            END IF;
            IF v_cod_mod_contra = 6 THEN
               v_retorno.etiquetaContra := substr('Nro. de Préstamo / Titular', 1, 100);
            ELSIF v_cod_mod_contra = 5 THEN
               v_retorno.etiquetaContra := substr('Nro. Cta. Tarjeta', 1, 100);
            ELSE
               v_retorno.etiquetaContra := substr('Cta. Contraparte', 1, 100);
            END IF;
            v_retorno.cuentaContra := substr(nvl(v_nro_tar_contra, v_cta_contra_formateada) || ' - ' || v_denominacion, 1, 300);
            v_retorno.tipoCuentaContra := substr(fue_obt_titulo(fug_obt_des_modal(v_cod_mod_contra, v_cod_mad_contra)), 1, 50);
            v_retorno.cotizacionContra   := v_cot_contra;
            v_retorno.codigoMonedaContra := substr(v_cod_mon_contra, 1, 3);
            v_retorno.montoContra        := v_mto_contra;
         ELSIF v_cod_tip_mensaje = '227' THEN
            DECLARE
               v_parametros bw_movimientos.parametros%TYPE;
            BEGIN
               SELECT parametros
                 INTO v_parametros
                 FROM bw_movimientos
                WHERE nro_documento = p_numeroDocumento
                  AND trunc(fec_hora) = trunc(v_fec_hora)
                  AND cod_per_principal = v_cod_per_principal
                  AND cod_tip_mensaje = v_cod_tip_mensaje;
               v_retorno.etiquetaContra := 'Beneficiario';
               v_retorno.cuentaContra := TRIM(substr(v_parametros, 421, 30)) || ' ~ ' || TRIM(substr(v_parametros, 1, 120));
               v_retorno.codigoMonedaContra := substr(v_parametros, 471, 3);
            EXCEPTION
               WHEN NO_DATA_FOUND THEN
                  NULL;
               WHEN OTHERS THEN
                  v_retorno.error := 'S';
                  v_retorno.descripcionError := substr('Error al recuperar cuentra contraparte ' || v_cta_contra, 1, 200);
            END;
            v_retorno.montoContra        := v_mto_contra;
            v_retorno.cotizacionContra   := v_cot_contra;
          ELSIF v_cod_tip_mensaje = '055' THEN
            v_retorno.cuentaContra := v_cta_contra;
            v_retorno.codigoMonedaContra := substr(trim(v_dato2), 1, 3);
            v_retorno.montoContra        := v_mto_contra;
            v_retorno.cotizacionContra   := v_cot_contra;
         END IF;
         v_retorno.nombreIngreso := substr(fue_obt_nom_persona(v_cod_per_ingreso), 1, 100);
         v_retorno.cantidadAutRequeridas := v_can_aut_requeridas;
         v_retorno.cantidadAutFaltantes := v_can_aut_faltantes;
         --detalles del movimiento
         IF v_cod_tip_mensaje = '070' AND (v_estado <> 'A' or p_estado IN ('P', 'E')) THEN
            --hay detalles de sueldos
            DECLARE
               v_lis_salario typ_listaDetalleSalario := typ_listaDetalleSalario();
               v_det_salario typ_detalleSalario      := typ_detalleSalario();
               v_pendiente      VARCHAR2(1)          := 'N';
            BEGIN
               v_retorno.tipoEnteSalario := v_tip_pro_sueldo;
               -- Movimientos confirmados para entes de tipo Batch y a Requerimiento aun puede estar en la
               -- tabla de temporales ya que pudo no procesarse aun el pago
               IF p_estado <> 'P' THEN
                  IF v_tip_pro_sueldo IN ('B', 'R') AND v_estado = 'C' THEN
                     FOR reg IN c_sue_pendientes(v_dato, v_referencia, to_date(v_dato2, 'DD/MM/YYYY')) LOOP
                        v_pendiente := 'S';
                        EXIT;
                     END LOOP;
                  END IF;
               ELSE
                  v_pendiente := 'S';
               END IF;

               IF v_estado IN ('P', 'E') OR v_pendiente = 'S' THEN
                  v_retorno.estadoSalario := v_estado;
                  FOR reg IN c_sue_pendientes(v_dato, v_referencia, to_date(v_dato2, 'DD/MM/YYYY'))
                  LOOP
                     v_fec_proceso := reg.fec_proceso;
                     v_det_salario.numeroCuenta := reg.nro_cuenta;
                     v_det_salario.tipo := 'C';
                     v_det_salario.descripcionTipoCuenta := NULL;
                     v_det_salario.nombreCuenta := substr(reg.denominacion, 1, 50);
                     v_det_salario.codigoMoneda := reg.cod_moneda;
                     v_det_salario.monto := reg.monto;
                     v_det_salario.error := NULL;
                     v_det_salario.mensajeRespuesta := NULL;
                     v_lis_salario.extend;
                     v_lis_salario(v_lis_salario.count) := v_det_salario;
                  END LOOP;
               ELSIF v_estado = 'C' THEN
                  v_retorno.estadoSalario := 'C';
                  FOR reg IN c_sue_confirmados(v_dato, v_referencia, TO_DATE(v_dato2,'DD/MM/YYYY') )
                  LOOP
                     v_fec_proceso := reg.fec_proceso;
                     v_det_salario.numeroCuenta := reg.nro_cuenta;
                     v_det_salario.tipo := 'C';
                     v_det_salario.descripcionTipoCuenta := NULL;
                     v_det_salario.nombreCuenta := substr(reg.denominacion, 1, 50);
                     v_det_salario.codigoMoneda := reg.cod_moneda;
                     v_det_salario.monto := reg.monto;
                     v_det_salario.error := NULL;
                     v_det_salario.mensajeRespuesta := NULL;
                     v_lis_salario.extend;
                     v_lis_salario(v_lis_salario.count) := v_det_salario;
                  END LOOP;
               END IF;
               lp_obt_sue_errores(v_dato, v_referencia, v_lis_salario, v_fec_proceso);
               v_retorno.listaDetalleSalario := v_lis_salario;
               v_retorno.cantidadDetallesSalario := v_lis_salario.count;
            EXCEPTION
               WHEN OTHERS THEN
                  v_retorno.error := 'S';
                  v_retorno.descripcionError := 'Error al obtener detalles de creditos para salarios';
            END;
         END IF; -- find detalles
         --detalles del movimiento
         IF v_cod_tip_mensaje = '071' THEN
           DECLARE
               --Se reutilizan los types de salario para la respuesta de Gourmet Card
               v_lis_salario typ_listaDetalleSalario := typ_listaDetalleSalario();
               v_det_salario typ_detalleSalario      := typ_detalleSalario();
               v_pendiente      VARCHAR2(1)          := 'N';
            BEGIN
               IF p_estado IN ('P', 'E') THEN
                  FOR c_gourmet IN c_acr_gourmet(v_usu_sesion.codigoEmpresa, v_dato)
                  LOOP
                      v_det_salario.fecha := c_gourmet.fec_recepcion;
                      v_det_salario.numeroCuenta := substr(c_gourmet.nro_tarjeta,4,16);
                      v_det_salario.tipo := 'C';
                      v_det_salario.descripcionTipoCuenta := c_gourmet.nro_tarjeta;
                      v_det_salario.nombreCuenta := substr(c_gourmet.nom_completo, 1, 50);
                      v_det_salario.monto := c_gourmet.monto;
                      v_det_salario.codigoMoneda := v_cod_mon_local;
                      v_det_salario.error := NULL;
                      v_det_salario.mensajeRespuesta := NULL;
                      v_lis_salario.extend;
                      v_lis_salario(v_lis_salario.count) := v_det_salario;
                  END LOOP;
               ELSE
                  FOR c_gourmet IN c_acr_gourmet_proc(v_usu_sesion.codigoEmpresa, v_dato)
                  LOOP
                      v_det_salario.fecha := c_gourmet.fec_recepcion;
                      v_det_salario.numeroCuenta := substr(c_gourmet.nro_tarjeta,4,16);
                      v_det_salario.tipo := 'C';
                      v_det_salario.descripcionTipoCuenta := c_gourmet.nro_tarjeta;
                      v_det_salario.nombreCuenta := substr(c_gourmet.nom_completo, 1, 50);
                      v_det_salario.monto := c_gourmet.monto;
                      v_det_salario.codigoMoneda := v_cod_mon_local;
                      v_det_salario.error := NULL;
                      v_det_salario.mensajeRespuesta := NULL;
                      v_lis_salario.extend;
                      v_lis_salario(v_lis_salario.count) := v_det_salario;
                  END LOOP;
               END IF;

              v_retorno.descripcionMensaje := substr(v_des_tip_mensaje, 1, 100);
               --pag_htm.PR_COLUMNA(v_des_tip_mensaje, NULL, 'center', 'S'); -- agrego la columna etiqueta
               v_retorno.numeroComprobante := p_numeroDocumento;
               --pag_htm.PR_COLUMNA(p_nro_documento); -- agrego la columna del nro de cuenta
               v_retorno.fechaOperacion := v_fec_hora;
               --pag_htm.PR_COLUMNA('Fecha:', 120, 'left', 'S'); -- agrego la columna etiqueta
               --pag_htm.PR_COLUMNA(to_char(v_fec_hora, 'dd/mm/yyyy - hh24:mi:ss')); -- agrego la columna del nro de cuenta
               v_retorno.cuentaPrincipal := substr(nvl(v_nro_tarjeta, v_cta_formateada) || ' - ' || pag_cta.FU_OBT_NOM_CUENTA, 1, 300);
               --pag_htm.PR_COLUMNA('Cuenta:', 120, 'left', 'S'); -- agrego la columna etiqueta
               --pag_htm.PR_COLUMNA(nvl(v_nro_tarjeta, v_cta_formateada) || ' - ' || pag_cta.FU_OBT_NOM_CUENTA, 310); -- agrego la columna del nro de cuenta
               v_retorno.tipoCuenta := substr(fue_obt_titulo(fug_obt_des_modal(pag_cta.G_CTAS.cod_modulo, pag_cta.g_ctas.cod_modalidad)), 1, 50);
               --pag_htm.PR_COLUMNA('Tipo:', 10, 'left', 'S');
               --pag_htm.PR_COLUMNA(fue_obt_titulo(fug_obt_des_modal(pag_cta.G_CTAS.cod_modulo, pag_cta.g_ctas.cod_modalidad)), NULL, 'left');
               v_retorno.monedaPrincipal := substr(FUE_OBT_DES_MONEDA(v_cod_moneda), 1, 50);
               v_retorno.oficinaPrincipal := substr(fue_obt_titulo(fue_obt_des_oficina(pag_cta.G_CTAS.COD_OFICINA)), 1, 100);
               v_retorno.codigoMonedaPrincipal := substr(v_cod_moneda, 1, 3);
               v_retorno.montoPrincipal := v_monto;
               v_retorno.montoCargo := v_mto_cargo;
               v_retorno.montoIva := v_mto_iva;
               v_retorno.cotizacion := v_cotizacion;
               v_retorno.montoEquLocal := v_equ_local;
               v_retorno.codigoMovimiento := substr(v_cod_tip_mensaje, 1, 3);
               v_retorno.descripcionMovimiento := substr(v_descripcion, 1, 100);
               v_retorno.cantidad := v_cantidad;
               v_retorno.etiqueta := v_etiqueta;
               v_retorno.dato     := v_dato;
               v_retorno.etiqueta2 := v_etiqueta2;
               v_retorno.dato2     := v_dato2;

               v_retorno.listaDetalleSalario := v_lis_salario;
               v_retorno.cantidadDetallesSalario := v_lis_salario.count;

           EXCEPTION
               WHEN OTHERS THEN
                  v_retorno.error := 'S';
                  v_retorno.descripcionError := 'Error al obtener detalles de creditos gourmet.';

            END;
         END IF;

         IF v_cod_tip_mensaje = '075' AND (v_estado <> 'A' or p_estado IN ('P', 'E')) THEN
            --hay detalles de proveedores
            DECLARE
               v_lis_proveedor typ_listadetalleproveedor := typ_listadetalleproveedor();
               v_det_proveedor typ_detalleproveedor := typ_detalleproveedor();
               v_fec_pago      DATE := to_date(substr(v_dato2, 1, 10), 'dd/mm/yyyy');
               v_cam_fecha     BOOLEAN := FALSE;
               v_cta_snp       VARCHAR2(1) := 'N';
               v_cta_bbva      VARCHAR2(1) := 'N';
            BEGIN
               IF v_estado = 'P' OR p_estado IN ('P', 'E') THEN
                  v_retorno.estadoProveedor := v_estado;
                  FOR reg IN c_pro_pendientes(v_dato, v_referencia,v_fec_ins_movimiento)
                  LOOP
                     v_det_proveedor.numeroOrden := reg.nro_orden;
                     v_det_proveedor.numeroFactura := substr(reg.nro_factura, 1, 20);
                     v_det_proveedor.formaPago := reg.for_pago;
                     v_det_proveedor.fechaPago := reg.fec_pago;
                     v_det_proveedor.numeroComprobante := NULL;
                     v_det_proveedor.numeroCuentaCredito := reg.nro_cta_credito;
                     v_det_proveedor.montoCredito := reg.monto;
                     v_det_proveedor.nombreBeneficiario := substr(reg.denominacion, 1, 60);
                     v_det_proveedor.codigoMoneda := reg.cod_moneda;
                     v_det_proveedor.concepto := NULL;
                     v_det_proveedor.codigoProceso := NULL;
                     v_det_proveedor.referenciaFacturas := substr(reg.ref_facturas, 1, 300);
                     v_det_proveedor.numeroBanco := reg.ent_bca_beneficiario;
                     v_det_proveedor.descripcionBanco := lf_obt_bco_snp(reg.ent_bca_beneficiario);
                     v_det_proveedor.tipoDocumento := reg.cod_tip_doc_beneficiario;
                     v_det_proveedor.numeroDocumento := reg.nro_doc_beneficiario;
                     v_det_proveedor.tipoMT := reg.ind_valor;
                     v_det_proveedor.numeroCuentaBeneficiario := reg.nro_cta_beneficiario;

                     IF v_det_proveedor.formaPago = 'I' THEN
                        v_cta_snp := 'S';
                     END IF;

                     IF v_det_proveedor.formaPago = 'C' THEN
                        v_cta_bbva := 'S';
                     END IF;

                     v_lis_proveedor.extend;
                     v_lis_proveedor(v_lis_proveedor.count) := v_det_proveedor;
                  END LOOP;
                  IF TRUNC(v_fec_pago) = TRUNC(SYSDATE) THEN
                     v_cam_fecha := paw_bce.fu_ver_hor_cie_proveedor(v_fec_pago);
                     IF v_cam_fecha = TRUE THEN
                        v_retorno.estadoProveedor := 'B'; -- para indicar proceso fecha posterior
                     ELSE
                        v_est_periodo := pas_snp.fu_obt_est_horario('103', '001', '002');
                        if ((v_est_periodo = 'A') and
                            (fug_den_per_act_snp('103','001','002',302,3) = 'S')) then
                            v_est_periodo := 'C';
                        end if;
                        IF v_est_periodo <> 'A' THEN
                           -- hora sipap cerrada, ver si el lote es solo sipap
                           IF v_cta_snp = 'S' AND v_cta_bbva = 'N' THEN
                              v_retorno.estadoProveedor := 'B';
                           END IF;
                        END IF;
                     END IF;
                  END IF;
               ELSIF v_estado = 'C' THEN
                  v_retorno.estadoProveedor := 'C';
                  FOR reg IN c_pro_pagados(v_dato, v_referencia, v_fec_pago)
                  LOOP
                     v_det_proveedor.numeroOrden := reg.nro_orden;
                     v_det_proveedor.numeroFactura := substr(reg.nro_factura, 1, 20);
                     v_det_proveedor.formaPago := reg.for_pago;
                     v_det_proveedor.fechaPago := reg.fec_pago;
                     v_det_proveedor.numeroComprobante := NULL;
                     v_det_proveedor.numeroCuentaCredito := reg.nro_cta_credito;
                     v_det_proveedor.montoCredito := reg.monto;
                     v_det_proveedor.nombreBeneficiario := substr(reg.denominacion, 1, 60);
                     v_det_proveedor.codigoMoneda := reg.cod_moneda;
                     v_det_proveedor.concepto := NULL;
                     v_det_proveedor.codigoProceso := NULL;
                     v_det_proveedor.referenciaFacturas := substr(reg.ref_facturas, 1, 300);
                     v_det_proveedor.numeroBanco := reg.ent_bca_beneficiario;
                     v_det_proveedor.descripcionBanco := lf_obt_bco_snp(reg.ent_bca_beneficiario);
                     v_det_proveedor.tipoDocumento := reg.cod_tip_doc_beneficiario;
                     v_det_proveedor.numeroDocumento := reg.nro_doc_beneficiario;
                     v_det_proveedor.tipoMT := reg.ind_valor;
                     v_det_proveedor.numeroCuentaBeneficiario := reg.nro_cta_beneficiario;

                     v_lis_proveedor.extend;
                     v_lis_proveedor(v_lis_proveedor.count) := v_det_proveedor;
                  END LOOP;
               END IF;
               v_retorno.listaDetalleProveedor := v_lis_proveedor;
               v_retorno.cantidadDetallesProveedor := v_lis_proveedor.count;
            EXCEPTION
               WHEN OTHERS THEN
                  v_retorno.error := 'S';
                  v_retorno.descripcionError := 'Error al obtener detalles de creditos para proveedores';
            END;
         END IF; -- find detalles
         --ver si hay detalles
         --detalles de recaudacion
         IF v_cod_tip_mensaje = '090' AND (v_estado <> 'A' or p_estado IN ('P', 'E')) THEN
            --hay detalles de proveedores
            DECLARE
               v_lis_recaudacion typ_listadetallerecaudacion := typ_listadetallerecaudacion();
               v_det_recaudacion typ_detallerecaudacion := typ_detallerecaudacion();
            BEGIN
               IF v_estado = 'P' OR p_estado IN ('P', 'E') THEN
                  v_retorno.estadoRecaudador := v_estado;
                  FOR rec IN c_rec_pendientes(v_dato, v_referencia)
                  LOOP
                     v_det_recaudacion.numeroCuentaDebito := substr(rec.nro_cta_debito, 1, 15);
                     v_det_recaudacion.denominacion := substr(rec.denominacion, 1, 100);
                     v_det_recaudacion.descripcionCuenta := substr(rec.descripcion, 1, 35);
                     v_det_recaudacion.monto := rec.monto;
                     v_det_recaudacion.estado := rec.estado;
                     v_det_recaudacion.descripcionEstado := fue_obt_des_refcodes('EST_SER_RECAUDACIONES', rec.estado);
                     v_det_recaudacion.numeroFactura := substr(rec.nro_factura, 1, 60);
                     v_det_recaudacion.tipoCobranza := substr(rec.tip_cobranza, 1, 3);
                     v_det_recaudacion.descripcionCobranza := fue_obt_des_refcodes('TIP_COB_RECAUDACION', rec.tip_cobranza);
                     v_det_recaudacion.numeroDocumento := NULL;
                     v_det_recaudacion.codigoRespuesta := rec.cod_error;
                     v_det_recaudacion.mensajeRespuesta := substr(rec.msj_error, 1, 400);
                     v_lis_recaudacion.extend;
                     v_lis_recaudacion(v_lis_recaudacion.count) := v_det_recaudacion;
                  END LOOP;
               ELSIF v_estado = 'C' THEN
                  v_retorno.estadoRecaudador := 'C';
                  IF to_date(v_dato2, 'dd/mm/yyyy') > trunc(sysdate) THEN
                     v_retorno.estadoRecaudador := 'B';
                  END IF;
                  FOR rec IN c_rec_procesadas(v_dato, v_referencia)
                  LOOP
                     v_det_recaudacion.numeroCuentaDebito := substr(rec.nro_cta_debito, 1, 15);
                     v_det_recaudacion.denominacion := substr(rec.denominacion, 1, 100);
                     v_det_recaudacion.descripcionCuenta := substr(rec.descripcion, 1, 35);
                     v_det_recaudacion.monto := rec.monto;
                     v_det_recaudacion.estado := rec.estado;
                     v_det_recaudacion.descripcionEstado := fue_obt_des_refcodes('EST_SER_RECAUDACIONES', rec.estado);
                     v_det_recaudacion.numeroFactura := substr(rec.nro_factura, 1, 60);
                     v_det_recaudacion.tipoCobranza := substr(rec.tip_cobranza, 1, 3);
                     v_det_recaudacion.descripcionCobranza := fue_obt_des_refcodes('TIP_COB_RECAUDACION', rec.tip_cobranza);
                     v_det_recaudacion.numeroDocumento := rec.nro_documento;
                     v_det_recaudacion.codigoRespuesta := rec.cod_error;
                     v_det_recaudacion.mensajeRespuesta := substr(rec.msj_error, 1, 400);
                     v_lis_recaudacion.extend;
                     v_lis_recaudacion(v_lis_recaudacion.count) := v_det_recaudacion;
                  END LOOP;
               END IF;
               v_retorno.listaRecaudacion := v_lis_recaudacion;
               v_retorno.cantidadRecaudacion := v_lis_recaudacion.count;
            EXCEPTION
               WHEN OTHERS THEN
                  v_retorno.error := 'S';
                  v_retorno.descripcionError := 'Error al obtener detalles de creditos para proveedores';
            END;
         END IF; -- fin detalles recaudacion
         -- detalles altas
         IF v_cod_tip_mensaje = '130' AND v_estado <> 'A' THEN
            DECLARE
               v_pendiente VARCHAR2(1) := 'N';
               v_lis_alta typ_listaempleados := typ_listaempleados();
               v_det_alta typ_empleado := typ_empleado();
            BEGIN
               FOR c IN c_alt_empleados(v_dato, v_referencia) LOOP
                  v_det_alta.numeroDocumento := substr(c.nro_cedula, 1, 20);
                  v_det_alta.tipoDocumento   := substr(c.tip_documento, 1, 3);
                  v_det_alta.nombre          := substr(c.pri_nombre ||' '||c.seg_nombre, 1, 60);
                  v_det_alta.primerApellido  := substr(c.pri_apellido, 1, 30);
                  v_det_alta.segundoApellido := substr(c.seg_apellido, 1, 30);
                  v_det_alta.estado          := c.estado;
                  v_det_alta.numeroSolicitud := c.nro_operacion;
                  v_det_alta.fechaNacimiento := lf_for_date(c.fec_nacimiento);
                  v_det_alta.codigoError     := 0;
                  v_det_alta.estadoCivil     := substr(c.est_civil, 1, 1);
                  v_det_alta.sexo            := c.sexo;
                  v_det_alta.error           := substr(c.error, 1, 1000);
                  v_det_alta.ciudad          := substr(c.ciudad, 1, 100);
                  v_det_alta.direccion       := substr(c.direccion, 1, 100);
                  v_det_alta.nombrePaisDocumento := substr(c.doc_pais, 1, 60);
                  v_det_alta.codigoPaisDocumento := fue_obt_cod_pais(c.doc_pais);
                  v_det_alta.pais            := substr(c.pais, 1, 40);
                  v_det_alta.codigoPais      := fue_obt_cod_pais(c.pais);
                  v_det_alta.fechaIngreso    := lf_for_date(c.fec_ingreso);
                  v_det_alta.profesion       := substr(c.profesion, 1, 35);
                  v_det_alta.codigoProfesion := fue_obt_cod_profesion(c.profesion);
                  v_det_alta.tipoContrato    := substr(c.tip_contrato,1,1);
                  v_det_alta.nombreSucursal  := substr(c.direc_kit, 1, 200);
                  v_det_alta.fechaRecepcion  := paw_uti.fu_fec_char(c.fec_insercion, 2);
                  v_det_alta.cuentaAsignada  := substr(c.nro_cuenta, 1, 20);
                  if c.fec_proceso is not null then
                     v_det_alta.fechaProceso := lf_for_date(c.fec_proceso);
                  end if;
                  IF v_det_alta.error IS NOT NULL THEN
                     v_det_alta.codigoError := -1;
                  END IF;
                  v_lis_alta.extend;
                  v_lis_alta(v_lis_alta.count) := v_det_alta;
               END LOOP;
               v_retorno.listaAltaEmpleados := v_lis_alta;
               v_retorno.cantidadAlta := v_lis_alta.count;
            END;
         END IF;
         -- fin detalles de altas
         --IF v_existe = 'S' THEN
         DECLARE
            v_lis_autorizador  typ_listadetalleautorizador := typ_listadetalleautorizador();
            v_autorizador      typ_detalleAutorizador := typ_detalleAutorizador();
         BEGIN
            FOR reg IN detalles
            LOOP
               v_autorizador.nombre     := substr(fue_obt_titulo(reg.nombre), 1, 240);
               v_autorizador.fechaHora  := reg.fec_hora;
               v_autorizador.comentario := substr(reg.observacion, 1, 250);
               v_autorizador.estado     := substr(reg.accion, 1, 20);
               v_lis_autorizador.extend;
               v_lis_autorizador(v_lis_autorizador.count) := v_autorizador;
            END LOOP;
            IF v_lis_autorizador.count > 0 THEN
               v_retorno.listaAutorizadores := v_lis_autorizador;
               v_retorno.cantidadAutorizadores := v_lis_autorizador.count;
            END IF;
         EXCEPTION
            WHEN OTHERS THEN
               v_retorno.error := 'S';
               v_retorno.descripcionError := 'Error al obtener detalle de autorizadores';
         END;
         v_retorno.extraData := lf_obt_dat_extra(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), p_numeroDocumento, v_cod_tip_mensaje);
         -- END IF; -- fin detalles
      END IF; -- sin error

      RETURN v_retorno;
   END;

   -- Funcion para detallar, imprimir, autorizar o rechazar una operacion
   FUNCTION fu_autorizarOperacion(p_sesion             IN VARCHAR2,
                                  p_codigoCanal        IN VARCHAR2,
                                  p_modo               IN VARCHAR2,
                                  p_numeroDocumento    IN NUMBER,
                                  p_comentario         IN VARCHAR2,
                                  p_online             IN VARCHAR2,
                                  p_claveTransaccional IN VARCHAR2,
                                  p_claveToken         IN VARCHAR2) RETURN typ_autorizaOperacion IS
      PRO_AUT_SIN_PERMISO         CONSTANT VARCHAR2(15) := 'PRO_AUT_SIN_PER';
      PRO_AUT_DOC_INEXISTENTE     CONSTANT VARCHAR2(15) := 'PRO_AUT_DOC_INE';
      PRO_AUT_ERR_OBT_PENDIENTE   CONSTANT VARCHAR2(15) := 'PRO_AUT_ERR_PEN';
      PRO_AUT_SAL_INSUFICIENTE    CONSTANT VARCHAR2(15) := 'SAL_CTA_INSUFIC';
      PRO_AUT_CTA_DEB_INV         CONSTANT VARCHAR2(15) := 'SAL_CTA_DEB_INV';
      PRO_AUT_PED_DUPLICADO       CONSTANT VARCHAR2(15) := 'PRO_AUT_DUPLICA';
      PRO_AUT_ERR_INS_DAT_SALARIO CONSTANT VARCHAR2(15) := 'PRO_AUT_DAT_SAL';
      PRO_AUT_ERR_PAG_SALARIO     CONSTANT VARCHAR2(15) := 'PRO_AUT_PAG_SAL';
      PRO_AUT_ERR_SAL_LOTES       CONSTANT VARCHAR2(15) := 'PRO_AUT_SAL_LOT';
      PRO_AUT_ERR_DAT_PROVEEDORES CONSTANT VARCHAR2(15) := 'PRO_ERR_VER_PAG';
      PRO_AUT_ERR_PAG_PROVEEDORES CONSTANT VARCHAR2(15) := 'PRO_ERR_PRO_PAG';
      PRO_AUT_ERR_DNA_MOVIMIENTO  CONSTANT VARCHAR2(15) := 'PRO_AUT_DNA_MOV';
      PRO_AUT_SOL_CHEQUERA        CONSTANT VARCHAR2(15) := 'PRO_AUT_SOL_CHE';
      PRO_AUT_ERR_SNP_CANCELA     CONSTANT VARCHAR2(15) := 'PRO_AUT_SNP_CAN';
      ERR_LIM_OPERACION           CONSTANT VARCHAR2(15) := 'G_ERR_LIM_OPERA';
      PRO_AUT_OBT_DET_ERROR       CONSTANT VARCHAR2(15) := 'PRO_AUT_OBT_DET';
      PRO_AUT_ERR_RECAUDACIONES   CONSTANT VARCHAR2(15) := 'PRO_ERR_REC_PAG';
      PRO_ERR_SIPAP               CONSTANT VARCHAR2(15) := 'PRO_ERR_SIPAP';
      PRO_AUT_CTA_MON_CRED_INVA   CONSTANT VARCHAR2(15) := 'MON_DEB_INVALID';
      MSG_MOD_CIERRE              CONSTANT VARCHAR2(15) := 'MOD_SIS_CIERRE';
      -- datos recibidos
      v_modo           VARCHAR2(1) := substr(p_modo, 1, 1); -- modo D,A,R,I
      v_nro_documento  bw_mov_pendientes.nro_documento%TYPE;
      v_comentario     VARCHAR(50) := depurarAlfanumerico(p_comentario, 50, 'S'); -- permite espacion
      v_nro_secuencia  NUMBER;

      -- cursor para confirmacion de datos
      mp bw_mov_pendientes%ROWTYPE;
      -- datos a responder
      v_can_aut_faltantes NUMBER(3) := 0;
      v_cod_operacion     VARCHAR2(3) := '023';
      v_fec_actual        DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy;
      v_retorno          typ_autorizaOperacion := typ_autorizaOperacion();
      v_detalles         typ_detalleautorizacion := typ_detalleautorizacion();

      v_usu_sesion       typ_validarsesion;
      v_msj_caja         typ_mensajeCaja;
      v_msj_respuesta    typ_mensajeRespuesta := typ_mensajeRespuesta();
      v_permiso          typ_obtenerPermisos;
      v_cod_per_empresa  ba_personas.cod_persona%TYPE;
      v_aut_semilla      bw_aut_semillas.nro_semilla%TYPE := 0;
      --- pago de sueldos
      v_cod_tra_padre    ge_transacciones.cod_transaccion%TYPE;
      v_lugar           VARCHAR2(4000);
      v_cant_error      NUMBER(8);
      v_TCreCab         NUMBER;
      v_TCreDet         NUMBER;
      v_TDebDet         NUMBER;
      v_cCreDet         NUMBER;
      v_verificacion_ok VARCHAR2(10);
      v_error           VARCHAR2(4000);
      v_Reprocesa       VARCHAR2(1) := 'N';
      v_secuencia       NUMBER(10) := 1;
      v_err_pago        VARCHAR2(2) := '00';
      v_res_limite      VARCHAR2(2); -- para límite de operaciones
      v_tip_pro_sueldo  VARCHAR2(1);
      v_pro_con_errores VARCHAR2(1);
      v_cod_tip_mensaje_per bw_tip_mensajes.cod_tip_mensaje%type;
      v_monto           ge_movimientos.monto%TYPE;
      v_des_monto       VARCHAR2(100);
      v_dir_correo      ge_par_dinamicos.val_parametro%TYPE;
      v_des_ente        ge_entes.descripcion%TYPE;
      v_nro_pre_pactado NUMBER;
      v_cod_mon_credito VARCHAR2(5);
      v_hora_fin        ge_snp_horarios.hor_fin%TYPE;
      v_hora_pro        ge_snp_horarios.hor_fin%TYPE;
      v_tkd_admin       VARCHAR2(1) := 'N';
      v_per_autorizador VARCHAR2(1) := 'S';
      v_msj_bitacora    VARCHAR2(1000) := substr('modo:'||trim(p_modo)
                                                       ||', nroDoc:'||p_numeroDocumento
                                                       ||', com:'||v_comentario, 1, 1000);
      v_nro_cta_contra  VARCHAR2(20);
      v_cod_mon_cred varchar2(3);
      tipo_transferencia varchar2(10);
      --
   BEGIN
      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

       v_nro_documento := p_numeroDocumento;
       v_cod_per_empresa := v_usu_sesion.codigoEmpresa;

       IF v_retorno.error = 'N' THEN
            -- 1. busco los datos de la operacion pendiente
            BEGIN
               SELECT *
                 INTO mp
                 FROM bw_mov_pendientes
                WHERE nro_documento = v_nro_documento
                  AND cod_per_principal = v_cod_per_empresa
                  AND ((cod_tip_mensaje not in ('070','075') and trunc(sysdate - 10) <= trunc(fec_insercion)) -- pago salarios, pago proveedores
                        OR (cod_tip_mensaje in ('070','075') and trunc(SYSDATE) <= TRUNC(to_date(dato2,'DD/MM/YYYY')))
                      );
               v_msj_bitacora := v_msj_bitacora || ', cod_tip:' ||mp.cod_tip_mensaje;
               -- verificar si tiene permiso para autorizar esa operacion
               v_cod_tip_mensaje_per:=mp.cod_tip_mensaje;
               if v_cod_tip_mensaje_per='071' then
                 v_cod_tip_mensaje_per:='070';
                 --acreditacion gourmet usa los mismos permisos que pago de salarios
               end if;
               v_permiso := lf_obt_permisos(v_usu_sesion,v_cod_tip_mensaje_per );
               IF (v_permiso.error = 'S') THEN
                  v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
                  v_retorno.error                := v_permiso.error;
                  pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;
               -- si no tiene permiso para autorizar, chequeamos que no haya registrado el documento
               -- si el usuario cargo el movimiento, puede eliminar siempre y cuando no se haya firmado
               IF v_permiso.autoriza = FALSE THEN
                  v_per_autorizador := 'N';
                  IF v_permiso.registra = FALSE OR mp.cod_per_ingreso <> v_usu_sesion.codigoPersona OR
                     p_modo = 'A' OR mp.can_aut_faltantes <> mp.can_aut_requeridas THEN
                     pr_mensajeUsuario(PRO_AUT_SIN_PERMISO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;
               END IF;
               v_msj_bitacora := v_msj_bitacora || ', es_aut: ' || v_per_autorizador;
            EXCEPTION
               WHEN OTHERS THEN
                  pr_mensajeusuario(PRO_AUT_DOC_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  v_msj_bitacora := substr(v_msj_bitacora || ', ORA-ERR:['||SQLERRM ||']', 1, 1000);
                  RETURN v_retorno;
            END;
         END IF;
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- si es adminitrador token digital
      v_tkd_admin := paw_otp.fu_es_aut_softoken(v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa);
      v_msj_bitacora := v_msj_bitacora || ', st_adm: ' || v_tkd_admin;

      -- DDSI-238 -- 01/2018 -- Verificar estado del modulo
      IF pae_cnf.FU_OBT_EST_MODULO(3) IN (1,6) THEN
         pr_mensajeUsuario(MSG_MOD_CIERRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF NVL(lf_val_gen_ope_cierre, 'S') = 'N' THEN
         pr_mensajeUsuario(MSG_MOD_CIERRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      IF v_per_autorizador = 'N' THEN
         v_retorno.nombreRespuesta := PRO_AUT_SIN_PERMISO; -- puede eliminar, se marca para token digital habilite solo eliminar
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ENTRADA);

      -- 2. verifico la accion
      IF v_retorno.error = 'N' THEN
         IF v_cod_per_empresa IS NULL THEN
            BEGIN
               SELECT MIN(cod_per_principal)
                 INTO v_cod_per_empresa -- esta es una solucion para que los clientes fisicos de cuentas conjuntas puedan autorizarse
                 FROM bw_mov_pendientes a
                WHERE estado = 'P'
                  AND pag_gen.FU_ES_PER_FISICA(cod_per_principal) = 'S'
                  AND cod_per_principal <> v_usu_sesion.codigoPersona
                  AND EXISTS (SELECT 0
                                FROM ge_cta_clientes b
                               WHERE b.nro_cuenta = a.nro_cuenta
                                 AND b.cod_persona = v_usu_sesion.codigoPersona);
            EXCEPTION
               WHEN OTHERS THEN
                  v_cod_per_empresa := NULL;
            END;
         END IF;
         IF v_modo IN ('D', 'A', 'R', 'I') THEN
            -- D-DETALLE, A-AUTORIZAR, R-RECHAZAR OPERACION, 'I-IMPRIMIR'
            -- modo visualizar detalles
            -- controlo que el número de documento pertenezca a la empresa
            IF paw_bce.fu_val_per_pendiente(v_nro_documento, v_cod_per_empresa) = 'N' AND mp.cod_tip_mensaje <> '008' THEN
               pr_mensajeusuario(PRO_AUT_SIN_PERMISO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
            -- controlo el limite de operacion
            IF v_retorno.error = 'N' and v_modo in ('D', 'A', 'R') AND mp.cod_tip_mensaje <> '008' THEN
               paw_bce.v_cod_respuesta := paw_bce.v_cod_aprobado;
               v_res_limite := paw_bce.fu_obt_aut_limite(v_cod_per_empresa, v_nro_documento, v_usu_sesion.codigoPersona);
               v_msj_bitacora := v_msj_bitacora || ', resLim:' || v_res_limite;

               IF paw_bce.v_cod_aprobado <> paw_bce.v_cod_respuesta THEN
                  IF paw_bce.v_cod_respuesta = paw_bce.v_cod_cta_sin_mov THEN
                     pr_mensajeusuario(PRO_AUT_DOC_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  ELSIF paw_bce.v_cod_respuesta = paw_bce.v_cod_ped_duplicado THEN
                     pr_mensajeusuario(PRO_AUT_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  ELSE
                     pr_mensajeusuario(ERR_LIM_OPERACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  END IF;
                  v_msj_bitacora := v_msj_bitacora || ', codRes: ' || paw_bce.v_cod_respuesta || ', ORA-ERR: ['||substr(sqlerrm, 1, 100)||']';
               ELSE
                  v_retorno.respuestaLimite := v_res_limite;
               END IF;
            END IF;
            IF mp.cod_tip_mensaje = '008' THEN
               v_res_limite := '02';
               v_retorno.respuestaLimite := v_res_limite;
            END IF;

            IF v_retorno.error = 'N' THEN
               IF v_res_limite = '02' AND v_modo IN('D') THEN
                  -- Requiere SoftToken y es modo detalle.
                  -- Generar semilla para la autorizacion o rechazo, o actualizarla en caso de ya existir
                   v_aut_semilla := paw_seg.fu_gen_semilla_autorizacion(v_nro_documento, v_usu_sesion.codigoPersona);
               END IF;
            END IF;
         END IF;

         -- si no hubo errores se consultan los límites o el detalle
         IF v_retorno.error = 'N' THEN
            v_retorno.fechaInsercion := mp.fec_insercion;
            IF v_modo = 'D' THEN
               -- v_detalles   := fuw_imp_mov_pendiente(v_nro_documento, 'S'); -- con el campo comentario
               IF mp.cod_tip_mensaje <> '008' THEN
                  v_retorno.detalles := fu_obtenerDetalleAutorizacion(p_sesion, p_codigoCanal, v_nro_documento);
                  IF v_retorno.detalles.error = 'S' THEN
                     pr_mensajeUsuario(PRO_AUT_OBT_DET_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', det-err: [' || substr(v_retorno.detalles.descripcionError, 1, 200) || ']' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;
               ELSE
                  paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK,v_detalles.descripcionError, v_detalles.descripcionMensaje, v_detalles.error);
                  v_detalles.fechaOperacion :=  mp.fec_hora;
                  v_detalles.codigoMovimiento := mp.cod_tip_mensaje;
                  v_detalles.descripcionMensaje := mp.descripcion;
                  v_detalles.cantidadAutRequeridas := mp.can_aut_requeridas;
                  v_detalles.cantidadAutFaltantes := mp.can_aut_faltantes;
                  v_detalles.nombreIngreso := fue_obt_nom_persona(mp.cod_per_ingreso);
                  v_detalles.dato := substr('OPERADOR ' || fue_obt_nom_persona(mp.cod_per_ingreso), 1, 50);
                  v_detalles.descripcionMovimiento := mp.descripcion;
                  v_detalles.numeroComprobante := mp.nro_documento;
                  v_retorno.detalles := v_detalles;
                  --
                  v_retorno.numeroDocumento := mp.nro_documento;
                  v_retorno.respuestaLimite := '02'; -- siempre softoken

               END IF;
               v_retorno.detalles.semillaAutorizacion := v_aut_semilla;

            ELSIF v_modo IN ('R', 'I') THEN
               v_retorno.detalles := fu_obtenerDetalleAutorizacion(p_sesion, p_codigoCanal, v_nro_documento, 'N');
               IF v_retorno.detalles.error = 'S' THEN
                  pr_mensajeUsuario(PRO_AUT_OBT_DET_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', det-err: [' || substr(v_retorno.detalles.descripcionError, 1, 200) || ']' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;
            END IF;
         END IF;

         IF v_retorno.error = 'N' AND v_modo IN ('A', 'R') THEN
            -- controlo las claves segun limites
            IF v_retorno.error = 'N' AND v_res_limite IN ('10', '11') THEN
               -- se debe controlar la clave transaccioanl
               v_msj_respuesta := lf_obt_cla_validar(p_claveTransaccional, v_usu_sesion.codigoPersona, v_cod_per_empresa, 'T');
               IF v_msj_respuesta.error = 'S' THEN
                  v_retorno.error                := v_msj_respuesta.error;
                  v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
               END IF;
            END IF;
            IF v_retorno.error = 'N' AND v_res_limite IN ('01', '11') THEN
               -- se debe controlar la clave token
               if  not (mp.cod_tip_mensaje in ('088', '034') and mp.can_aut_faltantes=1) then
                 --En pago de servicio al autorizar, no se tiene que verificar el token del ultimo firmante
                 v_msj_respuesta := paw_seg.fu_obt_tok_validar(p_claveToken, v_usu_sesion.codigoPersona, v_cod_per_empresa, 'A');
                 IF v_msj_respuesta.error = 'S' THEN
                    v_retorno.error                := v_msj_respuesta.error;
                    v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
                    v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
                 END IF;
                end if;
            END IF;
            -- 1. busco los datos de la operacion pendiente
            IF v_retorno.error = 'N' THEN
               BEGIN
                  SELECT *
                    INTO mp
                    FROM bw_mov_pendientes
                   WHERE nro_documento = v_nro_documento
                     AND cod_per_principal = v_cod_per_empresa
                     AND estado = 'P';
               EXCEPTION
                  WHEN no_data_found THEN
                     pr_mensajeusuario(PRO_AUT_DOC_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  WHEN OTHERS THEN
                     pr_mensajeusuario(PRO_AUT_ERR_OBT_PENDIENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200)||']';
               END;
            END IF;
         END IF;

         IF v_retorno.error = 'N' and mp.cod_tip_mensaje = 039 and v_modo IN ('A', 'D') THEN
            DECLARE
               v_transferencia typ_transferenciaban;
               v_cod_mon_cred varchar2(3);
               BEGIN
                  SELECT cod_moneda
                    INTO v_cod_mon_cred
                    FROM ge_cuentas
                   WHERE nro_cuenta = mp.nro_cta_contra;


                  v_transferencia := fu_transferenciasTerceros(p_sesion,
                                   p_codigoCanal,
                                   mp.nro_cuenta, -- cuenta debito
                                   mp.monto,      -- monto de la operacion
                                   mp.nro_cta_contra, -- cuenta credito
                                   v_cod_mon_cred, -- cod_mon_credito
                                   'VC', -- ACTUALIZACION DE COTIZACION
                                   mp.dato, -- documento credito
                                   mp.dato2, -- concepto
                                   nvl(mp.referencia, 0), --nro_contrato
                                   NULL,
                                   NULL);

                  IF v_transferencia.error = 'S' THEN
                     v_retorno.error                := v_transferencia.error;
                     v_retorno.nombreRespuesta      := v_transferencia.nombreRespuesta;
                     v_retorno.descripcionRespuesta := v_transferencia.descripcionRespuesta;
                  ELSE
                     UPDATE bw_mov_pendientes
                        SET cotizacion = v_transferencia.cotizacion,
                            cot_contra = v_transferencia.cotizacionCredito,
                            monto = v_transferencia.monto,
                            mto_contra = v_transferencia.montoCredito
                      WHERE nro_documento = v_nro_documento;
                  END IF;
               EXCEPTION
                  WHEN OTHERS THEN
                  pr_mensajeusuario(PRO_AUT_CTA_MON_CRED_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200)||']';
               END;


         END IF;
         
         
         IF v_retorno.error = 'N' and mp.cod_tip_mensaje = 055 and v_modo IN ('A', 'D') THEN
            DECLARE
               v_transferencia typ_transferenciaban;
               BEGIN
                  v_transferencia := fu_transferenciaGnb(p_sesion,
                                   p_codigoCanal,
                                   mp.nro_cuenta, -- cuenta debito
                                   mp.mto_contra,      -- monto credito
                                   mp.nro_cta_contra, -- cuenta credito
                                   mp.dato2, -- cod_mon_credito
                                   'VC', -- ACTUALIZACION DE COTIZACION
                                   mp.dato, -- documento credito
                                   mp.descripcion, -- concepto
                                   nvl(mp.referencia, 0), --nro_contrato
                                   NULL,
                                   NULL,
                                   NULL);

                  IF v_transferencia.error = 'S' THEN
                     v_retorno.error                := v_transferencia.error;
                     v_retorno.nombreRespuesta      := v_transferencia.nombreRespuesta;
                     v_retorno.descripcionRespuesta := v_transferencia.descripcionRespuesta;
                  ELSE
                     UPDATE bw_mov_pendientes
                        SET cotizacion = v_transferencia.cotizacion,
                            cot_contra = v_transferencia.cotizacionCredito,
                            monto = v_transferencia.monto,
                            mto_contra = v_transferencia.montoCredito
                      WHERE nro_documento = v_nro_documento;
                  END IF;
               EXCEPTION
                  WHEN OTHERS THEN
                  pr_mensajeusuario(PRO_AUT_CTA_MON_CRED_INVA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200)||']';
               END;


         END IF;
         
         -- si no hubo errores y es mensaje para autorizar
         IF v_modo = 'A' AND v_retorno.error = 'N' THEN
            -- actualizo el movimiento pendiente
            UPDATE bw_mov_pendientes
               SET can_aut_faltantes = nvl(can_aut_faltantes, 0) - 1,
                   estado            = decode(can_aut_faltantes, 1, 'C', estado)
             WHERE nro_documento = v_nro_documento
               AND cod_per_principal = v_cod_per_empresa
               RETURNING can_aut_faltantes INTO v_can_aut_faltantes;

            -- verificamos el saldo disponible para pago de salarios
            IF v_retorno.error = 'N' THEN
               -- inserto el movimiento de autorización
               BEGIN
                  INSERT INTO bw_autorizaciones
                     (cod_persona, nro_documento, fec_hora, accion, observacion)
                  VALUES
                     (v_usu_sesion.codigoPersona, v_nro_documento, SYSDATE, 'A', v_comentario);
               EXCEPTION
                  WHEN dup_val_on_index THEN
                     pr_mensajeusuario(PRO_AUT_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END;
            END IF;
            -- se controla por autorizante el saldo de la cuenta para pago de sueldos
            IF v_retorno.error = 'N' AND mp.cod_tip_mensaje = '070' THEN
               -- obtenemos la transacción padre
               v_cod_tra_padre := fu_obt_tra_sueldo(mp.dato, mp.tip_pago);

               -- obtenemos el tipo de proceso de sueldo para el ente
               v_tip_pro_sueldo  := fu_obt_tip_pro_sueldo(mp.dato);
               v_pro_con_errores := nvl(fug_obt_parentes(mp.dato, 'PRO_CON_ERRORES'), 'N');

               IF TRUNC(TO_DATE(mp.dato2, 'DD/MM/YYYY')) > TRUNC(mp.fec_insercion) THEN
                  v_tip_pro_sueldo := 'B';
               END IF;

               -- pagos de aguinalo seran Online y Cancelar con errores independientemente de
               -- la configuracion del ente
               IF mp.tip_pago = 'A' THEN
                  v_tip_pro_sueldo  := 'O';
                  v_pro_con_errores := 'C';
               END IF;

               v_msj_bitacora := v_msj_bitacora || ', codEn:' || mp.dato || ', tipRe:' || mp.dato2
                                                || ', proSue:' || v_tip_pro_sueldo
                                                || ', traPa:'  || v_cod_tra_padre
                                                || ', proErr: ' ||v_pro_con_errores;
            END IF;
            IF mp.cod_tip_mensaje in ('070', '071') THEN
               IF mp.cod_tip_mensaje = '071' THEN
                  --Si el servicio es Gourmet, se trae la cuenta padre
                  v_cod_tra_padre := NVL(FUG_OBT_PARDINAMICO('GOU_CTA_PADRE'),5166);
               END IF;
               -- verificamos si se puede realizar la operación de débito
               IF paw_bce.fu_ver_operacion(mp.nro_cuenta, mp.monto, 503, v_cod_tra_padre, 'D') = 'N' THEN
                  IF pag_cta.g_cod_error <> 0 THEN
                     --Verificacion de la operacion retorna error. Se verifica si corresponde a insuficiencia de fondos
                     IF pag_cta.g_cod_error IN (25, 29, 31, 36) THEN
                        IF mp.cod_tip_mensaje = '070' THEN
                          -- En el caso de Pago de salarios se verifica saldo solo si es pago online
                        IF v_tip_pro_sueldo = 'O' OR (v_tip_pro_sueldo = 'B' AND TRUNC(SYSDATE) = TRUNC(TO_DATE(mp.dato2, 'DD/MM/YYYY'))) THEN
                              pr_mensajeusuario(PRO_AUT_SAL_INSUFICIENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           END IF;
                        ELSE
                           -- La cuenta no tiene saldo suficiente
                           pr_mensajeusuario(PRO_AUT_SAL_INSUFICIENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        END IF;
                     ELSE
                        -- Ocurrio un error distinto a insuficiencia de fondos
                        pr_mensajeusuario(PRO_AUT_CTA_DEB_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        v_msj_bitacora := v_msj_bitacora || ', CTA-ERR:[' || SUBSTR(pag_cta.G_MSJ_ERROR, 1, 200)||']';
                     END IF;
                  END IF;
               END IF;
            END IF;

            -->rbenitez, se agrega esto aquí de nuevo para que haga un refresh de la cantidad de autorizaciones
            --registradas, pues en el momento en el que se autoriza por primera vez no refresca y sale 0

            IF v_retorno.error = 'N' THEN
               v_retorno.detalles := fu_obtenerDetalleAutorizacion(p_sesion, p_codigoCanal, v_nro_documento);

               IF v_retorno.detalles.error = 'S' THEN
                  pr_mensajeUsuario(PRO_AUT_OBT_DET_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', det-err: [' || substr(v_retorno.detalles.descripcionError, 1, 200) || ']' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;
            END IF;
            --- VERIFICO QUE TIPO DE OPERACION ES LA QUE SE CONFIRMA
            IF v_retorno.error = 'N' AND v_can_aut_faltantes = 0 THEN
               v_can_aut_requeridas := 1; -- esto para permitir debitar a cuentas conjuntas
               g_aut_operacion := TRUE; -- para controlar el modo 'A' en las funciones que venga de autorizar

               -- DDSI-238 -- 01/2018 -- Verificar estado del modulo
               IF pae_cnf.FU_OBT_EST_MODULO(3) IN (1,6) THEN
                  pr_mensajeUsuario(MSG_MOD_CIERRE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;

               IF mp.cod_tip_mensaje = '030' THEN -- transferencias propias
                  --v_nro_operacion    := mp.nro_documento; -- cambio el nro de operacion
                  DECLARE
                     v_transferencia typ_transferenciaban;
                  BEGIN
                     v_transferencia := fu_transferenciasPropias(p_sesion,
                                                                 p_codigoCanal,
                                                                 mp.nro_cuenta, -- cuenta debito
                                                                 mp.monto,      -- monto operacion
                                                                 mp.nro_cta_contra, -- cuentra credito
                                                                 'A',           -- autorizar
                                                                 mp.dato2,  -- concepto
                                                                 mp.cotizacion, -- cotizacion debito
                                                                 mp.cot_contra, -- cotizacion credito
                                                                 mp.mto_contra, -- monto credito
                                                                 NULL,
                                                                 NULL);
                     IF v_transferencia.error = 'S' THEN
                        v_retorno.error                := v_transferencia.error;
                        v_retorno.nombreRespuesta      := v_transferencia.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_transferencia.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := v_transferencia.nroDocumento;
                     END IF;
                  END;
               ELSIF mp.cod_tip_mensaje = '031' THEN -- pago de prestamos
                  DECLARE
                     v_prestamo typ_pagoprestamo;
                  --v_nro_operacion    := mp.nro_documento; -- cambio el nro de operacion
                  BEGIN
                     v_prestamo := fu_pagoPrestamo(p_sesion,
                                                   p_codigoCanal,
                                                   mp.nro_cta_contra, -- numero prestamo
                                                   mp.nro_cuenta,     -- cuenta debito
                                                   mp.dato,           -- cantidad de cuotas
                                                   mp.monto,          -- monto del prestamo
                                                   'A',               -- autorizar
                                                   NULL,
                                                   NULL);
                     v_retorno.error                := v_prestamo.error;
                     v_retorno.nombreRespuesta      := v_prestamo.nombreRespuesta;
                     v_retorno.descripcionRespuesta := v_prestamo.descripcionRespuesta;
                     v_retorno.numeroDocumento      := v_prestamo.nroDocumento;
                  END;
               ELSIF mp.cod_tip_mensaje = '032' THEN -- tarjeta credito
                  --v_nro_operacion    := mp.nro_documento; -- cambio el nro de operacion
                  DECLARE
                     v_pagotarjeta typ_pagoTarjetaCredito;
                  BEGIN
                     v_pagotarjeta := fu_pagoTarjetaCredito(p_sesion,
                                                            p_codigoCanal,
                                                            mp.dato, -- numero tarjeta
                                                            mp.nro_cuenta, -- cuenta debito
                                                            'A', -- autorizar
                                                            NULL, -- numero sobre
                                                            0, -- importe efectivo
                                                            0, -- cheque nuestro banco
                                                            0, -- cheque otro banco
                                                            mp.monto, -- importe debito
                                                            mp.monto, -- total pago
                                                            NULL,
                                                            NULL,
                                                            p_online);
                     IF v_pagotarjeta.error = 'S' THEN
                        v_retorno.error                := v_pagotarjeta.error;
                        v_retorno.nombreRespuesta      := v_pagotarjeta.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_pagotarjeta.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := v_pagotarjeta.numeroOperacion;
                     END IF;
                  END;
               ELSIF mp.cod_tip_mensaje = '033' THEN
                  -- invoco al pago de despachos aduaneros
                  -- obtiene el mensaje original de la operacion (
                  DECLARE
                     v_msj_original bw_movimientos.observacion%TYPE;
                     v_aduana       typ_pagoAduana;
                  BEGIN
                     SELECT observacion
                       INTO v_msj_original
                       FROM bw_movimientos
                      WHERE nro_documento = mp.nro_documento --mp.referencia
                        AND trunc(fec_hora) = trunc(mp.fec_hora)
                        AND cod_tip_mensaje = '033'; -- BBVASOP-1357

                     v_msj_bitacora := v_msj_bitacora ||', mto:'||mp.monto
                                                      ||', codOpe: '||trim(substr(v_msj_original, 1, 3))
                                                      ||', cpo1: '|| trim(substr(v_msj_original, 4, 18))
                                                      ||', cpo2: '||trim(substr(v_msj_original, 22, 18));

                     v_aduana := fu_pagoAduana(p_sesion,
                                               p_codigoCanal,
                                               mp.nro_cuenta,  -- cuenta debito
                                               'A',            -- autorizacion
                                               mp.monto,       -- monto
                                               trim(substr(v_msj_original, 1, 3)),   -- TID, TCA, TLE, TDA
                                               trim(substr(v_msj_original, 4, 18)),  -- campo1
                                               trim(substr(v_msj_original, 22, 18)), -- campo2
                                               trim(substr(v_msj_original, 40, 50)),  -- nombre importador
                                               trim(substr(v_msj_original, 90, 50)), -- nombre despachante
                                               NULL,
                                               NULL);
                     IF v_aduana.error = 'S' THEN
                        v_retorno.error                := v_aduana.error;
                        v_retorno.nombreRespuesta      := v_aduana.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_aduana.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := v_aduana.nroDocumento;
                     END IF;
                  EXCEPTION
                     WHEN OTHERS THEN
                        -- v_msj_original := NULL;
                        pr_mensajeusuario(PRO_AUT_ERR_DNA_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200)||']';
                  END;

                  -- v_nro_operacion    := mp.nro_documento; -- cambio el nro de operacion
               ELSIF mp.cod_tip_mensaje = '036' THEN
                  DECLARE
                     v_tra_interbancaria typ_transferenciainterbancaria;
                     v_fec_operacion     date := to_date(mp.dato2,'dd/mm/yyyy');
                  BEGIN
                     v_msj_bitacora := v_msj_bitacora ||', ref:'||mp.referencia;
                     v_cod_mon_credito := REGEXP_REPLACE(mp.dato,'([[:print:]]+)\*([[:print:]]+)\*([[:print:]]+)','\2');
                     v_nro_pre_pactado := REGEXP_REPLACE(mp.dato,'([[:print:]]+)\*([[:print:]]+)\*([[:print:]]+)','\3');

                     v_msj_bitacora := v_msj_bitacora ||', monCre:'||v_cod_mon_credito ||', nroPrePac:'||v_nro_pre_pactado;


                    if (mp.referencia IS NOT null) then
                       begin 
                         SELECT  v.val
                         into tipo_transferencia
                         FROM ( select 'SIPAP'  AS VAL
                                from ge_snp_transferencias gs
                                WHERE trunc(gs.nro_referencia) = trunc(mp.referencia)
                                UNION ALL  
                                select 'SPI' AS VAL
                                from ge_spi_transferencias gp
                                WHERE trunc(gp.nro_referencia) = trunc(mp.referencia)) v;
                        end; 
                   end if;

                  if(tipo_transferencia='SIPAP') THEN
                     -- si se esta aprobando despues de hora de cierre, cambiamos la fecha valor
                     IF TRUNC(v_fec_operacion) = TRUNC(SYSDATE) THEN
                         v_hora_fin := paw_bas.fu_obt_hor_fin_snp(1);
                         v_hora_pro := TO_CHAR(SYSDATE, 'HH24MI');
                         IF TO_NUMBER(v_hora_pro) >= TO_NUMBER(v_hora_fin) THEN
                            v_fec_operacion := pag_cal.FU_OBT_FEC_HABIL(v_fec_operacion + 1,1,1);
                            -- cambiamos la fecha de pago en el pendiente
                            paw_bce.pr_act_fec_pag_pendiente(mp.nro_documento, mp.cod_per_principal, to_char(v_fec_operacion, 'DD/MM/YYYY'));
                            -- modificamos la fecha valor
                            UPDATE ge_snp_transferencias s
                               SET s.fec_valor = v_fec_operacion
                             WHERE s.nro_referencia = mp.referencia;
                         END IF;
                     END IF;
                  end if;  
                 

                     -- Invoco a la Transferencia Interbancaria
                     /*v_tra_interbancaria :=  fu_transferenciaInterbancaria
                              (
                                 p_sesion,
                                 p_codigoCanal,
                                 'A',
                                 NULL, -- p_codigoSwift
                                 mp.nro_cta_contra, --p_numeroCuentaCredito
                                 mp.nro_cuenta, --p_numeroCuentaDebito
                                 v_cod_mon_credito, --p_codigoMonedaCredito
                                 mp.mto_contra, --p_montoCredito
                                 v_fec_operacion, --to_date(mp.dato2, 'DD/MM/YYYY'), --p_fechaOperacion
                                 NULL, --p_cargos
                                 NULL, --p_numeroDocumentoCredito
                                 NULL, --p_nombreBeneficiario
                                 NULL, --p_direccionBeneficiario
                                 nvl(v_nro_pre_pactado, 0), --p_numeroContrato
                                 v_comentario, --p_concepto
                                 NULL, --p_numeroIp
                                 NULL, --p_tipoMensaje
                                 NULL, --p_tipoDocumentoBeneficiario
                                 mp.referencia, --p_numeroReferencia
                                 mp.monto, --p_montoDebito
                                 mp.cotizacion, --p_cotizacionDebito
                                 mp.cot_contra, --p_cotizacionCredito
                                 NULL,
                                 NULL,
                                 mp.tip_pago);*/
                     IF v_tra_interbancaria.error = 'S' THEN
                        v_retorno.error                := v_tra_interbancaria.error;
                        v_retorno.nombreRespuesta      := v_tra_interbancaria.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_tra_interbancaria.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := substr(v_tra_interbancaria.numeroDocumento, 1, 15);
                     END IF;
                  END;
               ELSIF mp.cod_tip_mensaje = '038' THEN -- OMM 30/07/2012 Cancelacion de Transferencia Interbancaria
                  DECLARE
                     v_can_tra_interbancaria typ_cancelarTransferenciaSnp;
                  BEGIN
                     v_msj_bitacora := v_msj_bitacora ||', ref:'||mp.referencia;
                     -- Invoco a la Transferencia Interbancaria
                     v_can_tra_interbancaria := fu_cancelarTransferenciaSnp(p_sesion,
                                                                            p_codigoCanal,
                                                                            'A',
                                                                            mp.referencia);
                     IF v_can_tra_interbancaria.error = 'S' THEN
                        v_retorno.error                := v_can_tra_interbancaria.error;
                        v_retorno.nombreRespuesta      := v_can_tra_interbancaria.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_can_tra_interbancaria.descripcionRespuesta;
                     END IF;
                  END;
               ELSIF mp.cod_tip_mensaje = '039' THEN -- transferencia terceros
                  --v_nro_operacion    := mp.nro_documento; -- cambio el nro de operacion
                  DECLARE
                     v_transferencia typ_transferenciaban;
                  BEGIN
                     v_transferencia := fu_transferenciasTerceros(p_sesion,
                                   p_codigoCanal,
                                   mp.nro_cuenta, -- cuenta debito
                                   mp.monto,      -- monto de la operacion
                                   mp.nro_cta_contra, -- cuenta credito
                                   NULL, -- cod_mon_credito
                                   'A', -- autorizar
                                   mp.dato, -- documento credito
                                   mp.dato2, -- concepto
                                   nvl(mp.referencia, 0), --nro_contrato
                                   NULL,
                                   NULL);

                     IF v_transferencia.error = 'S' THEN
                        v_retorno.error                := v_transferencia.error;
                        v_retorno.nombreRespuesta      := v_transferencia.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_transferencia.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := v_transferencia.nroDocumento;
                     END IF;
                  END;
                  
                ELSIF mp.cod_tip_mensaje = '055' THEN -- transferencia internas GNB
                  --v_nro_operacion    := mp.nro_documento; -- cambio el nro de operacion
                  DECLARE
                     v_transferencia    typ_transferenciaban;
                     v_nom_beneficiario VARCHAR2(100);
                  BEGIN
                     v_nom_beneficiario := fuw_nom_cre_tra_gnb(mp.nro_documento, mp.cod_per_principal);
                     v_transferencia := fu_transferenciaGnb(p_sesion,
                                   p_codigoCanal,
                                   mp.nro_cuenta, -- cuenta debito
                                   mp.mto_contra,      -- monto credito
                                   mp.nro_cta_contra, -- cuenta credito
                                   mp.dato2, -- cod_mon_credito
                                   'A', -- autorizar
                                   mp.dato, -- documento credito
                                   mp.descripcion, -- concepto
                                   nvl(mp.referencia, 0), --nro_contrato
                                   v_nom_beneficiario,
                                   NULL,
                                   NULL);

                     IF v_transferencia.error = 'S' THEN
                        v_retorno.error                := v_transferencia.error;
                        v_retorno.nombreRespuesta      := v_transferencia.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_transferencia.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := v_transferencia.nroDocumento;
                     END IF;
                  END;
               ELSIF mp.cod_tip_mensaje = '060' THEN -- solicitud de chequeres
                  --v_nro_operacion    := mp.nro_documento; -- cambio el nro de operacion
                  DECLARE
                     v_chequeras typ_mensajeResChequera;
                     --p_canHojas  number := to_number(substr(mp.dato, 2, 5));
                  BEGIN
                     v_msj_bitacora := v_msj_bitacora || ', tipChq:' || substr(mp.dato, 1, 1)
                                                      || ', can:' || mp.cantidad
                                                      || ', ofi:' || substr(mp.dato2, 1, 3)
                                                      || ', ref:' || mp.referencia
                                                      || ', cta:' || mp.nro_cuenta;
                     v_chequeras := fu_solicitarChequera(p_sesion,
                                                         p_codigoCanal,
                                                         mp.nro_cuenta,  -- cuenta corriente
                                                         substr(mp.dato, 1, 1), -- tipo chequera
                                                         mp.referencia, -- cant hojas
                                                         mp.cantidad,  -- cantidad de chequeras
                                                         'A', -- autorizar
                                                         substr(mp.dato2, 1, 3), --oficina retencion
                                                         'M', --Mostrador
                                                         p_claveTransaccional,
                                                         p_claveToken);
                     IF v_chequeras.error = 'S' THEN
                        v_retorno.error                := v_chequeras.error;
                        v_retorno.nombreRespuesta      := v_chequeras.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_chequeras.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := v_chequeras.nroDocumento;
                     END IF;
                  EXCEPTION
                     WHEN OTHERS THEN
                        pr_mensajeusuario(PRO_AUT_SOL_CHEQUERA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200)||']';
                  END;

               ELSIF mp.cod_tip_mensaje = '214' THEN -- transferencias con contrato de cambio
                  --v_nro_operacion    := mp.nro_documento; -- cambio el nro de operacion
                  DECLARE
                     v_transferencia typ_transferenciaban;
                  BEGIN
                     v_transferencia := fu_transferenciasConContrato(p_sesion,
                                                                     p_codigoCanal,
                                                                     mp.nro_cuenta,     -- cuenta debito
                                                                     mp.nro_cta_contra, -- cuenta credito
                                                                     'A',               -- autorizar
                                                                     to_number(mp.dato)/*mp.referencia*/,     -- numero contrato
                                                                     NULL,              -- dirIP
                                                                     NULL,
                                                                     NULL);
                     IF v_transferencia.error = 'S' THEN
                        v_retorno.error                := v_transferencia.error;
                        v_retorno.nombreRespuesta      := v_transferencia.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_transferencia.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := v_transferencia.nroDocumento;
                     END IF;
                  END;
               ELSIF mp.cod_tip_mensaje = '070' THEN -- pago de salarios
                  IF v_tip_pro_sueldo = 'O' THEN
                     PAG_SUE.PR_INS_GE_PAG_SUELDO(
                     v_verificacion_ok,
                     mp.dato,
                     mp.nro_cuenta,
                     v_cod_tra_padre,
                     /*v_fec_actual*/ NVL(TO_DATE(mp.dato2, 'DD/MM/YYYY'), v_fec_actual ),
                     v_lugar,
                     v_cant_error,
                     v_TCreCab,
                     v_TCreDet,
                     v_TDebDet,
                     v_cCreDet,
                     mp.referencia,
                     user,--v_msj_caja.codigoUsuario, --VERIFICA ESTA MODIFICACION V.A
                     /*v_fec_actual*/ NVL(TO_DATE(mp.dato2, 'DD/MM/YYYY'), v_fec_actual ),
                     mp.tip_pago);

                     IF NVL(v_Cant_Error, 0) <> 0 THEN
                        SELECT SUM(monto)
                          INTO v_monto
                          FROM ge_pag_sueldos_tmp
                         WHERE cod_ente = mp.dato
                           AND usu_insercion = v_msj_caja.codigoUsuario
                           AND trunc(fec_insercion) = v_fec_actual
                           AND tipo = 'C'
                           AND nro_archivo = mp.referencia;
                        -- verificamos si el ente puede procesar pagos con error
                        IF NVL(v_monto, 0) <> NVL(v_TDebDet, 0) AND v_pro_con_errores = 'C' THEN
                           pr_mensajeusuario(PRO_AUT_ERR_PAG_SALARIO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        END IF;
                     END IF;
                     -- IF  NVL(v_Cant_Error,0) = 0 and v_verificacion_ok = 'S' THEN
                     IF v_retorno.error = 'N' THEN
                        -- no bubo errores
                        v_secuencia := mp.referencia; -- JIRA 2376
                        PAG_SUE.LP_INS_TABLA(
                        mp.dato,
                        v_lugar,
                        v_secuencia,
                        v_error,
                        mp.referencia,
                        user,--v_msj_caja.codigoUsuario,  --VERIFICAR ESTA MODIFICACION V.A
                        /*v_fec_actual*/ NVL(TO_DATE(mp.dato2, 'DD/MM/YYYY'), v_fec_actual ),
                        /*v_fec_actual*/ NVL(TO_DATE(mp.dato2, 'DD/MM/YYYY'), v_fec_actual ),
                        'N');

                        IF V_ERROR IN ('X', 'S') THEN
                           pr_mensajeusuario(PRO_AUT_ERR_INS_DAT_SALARIO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           v_msj_bitacora := v_msj_bitacora || ', lugar: [' || substr(v_lugar, 1, 200) || ']';
                        ELSE
                           v_nro_secuencia := 0;
                           pag_cta.PR_SET_VARIABLES(v_msj_caja.codigoUsuario, v_fec_actual, v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL, v_msj_caja.codigoOficinaOrigen, 3, 31);
                           v_secuencia := mp.referencia; -- JIRA 2376
                           -- se puede hacer el credito
                           PAG_SUE.PR_ACT_CRED_EMPLEADO(
                           v_Reprocesa,
                           mp.dato,
                           v_secuencia,
                           v_msj_caja.codigoOficinaOrigen,
                           /*v_fec_actual*/ NVL(TO_DATE(mp.dato2, 'DD/MM/YYYY'), v_fec_actual ),
                           v_msj_caja.codigoUsuario,
                           v_lugar,
                           v_error,
                           mp.tip_pago);
                        END IF;
                     ELSE
                        -- hubo error en la verificacion
                        pr_mensajeusuario(PRO_AUT_ERR_PAG_SALARIO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     END IF;
                  ELSE
                     v_nro_secuencia := mp.referencia;
                     BEGIN
                        INSERT INTO ge_pag_sue_lotes
                           (cod_ente, fec_proceso, nro_secuencia, nro_cta_debito, mto_credito, mto_debito, cod_moneda, cantidad, estado, tip_pago, tip_ingreso, tip_proceso)
                        VALUES
                           (mp.dato, TO_DATE(mp.dato2, 'DD/MM/YYYY'), v_nro_secuencia, mp.nro_cuenta, mp.monto, mp.monto, mp.cod_moneda, mp.cantidad, 'P', mp.tip_pago, 'H', v_tip_pro_sueldo);


                        -- si la ultima autorizacion se realiza en la fecha de pago llamamos al procedimiento que ejecuta el pago en lotes
                        -- con el parametro del ente, para que se realice el pago 'online'
                        IF TRUNC(SYSDATE) = TRUNC(TO_DATE(mp.dato2, 'DD/MM/YYYY')) AND TRUNC(SYSDATE) > TRUNC(mp.fec_insercion) THEN
                           pag_sue.pr_pag_sue_lotes('B', mp.dato, mp.referencia);
                        END IF;

                     EXCEPTION
                        WHEN OTHERS THEN
                           pr_mensajeusuario(PRO_AUT_ERR_SAL_LOTES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           v_error         := 'S';
                           v_msj_bitacora := v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || ']';
                           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', det-err: [' || substr(v_retorno.detalles.descripcionError, 1, 200) || ']' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
                     END;
                  END IF;
                  IF V_ERROR IN ('X', 'S') THEN
                     IF v_retorno.error = 'N' THEN
                        pr_mensajeusuario(PRO_AUT_ERR_PAG_SALARIO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     END IF;
                  ELSE
                     BEGIN

                        v_dir_correo := fug_obt_pardinamico('SUE_DIR_CORREO');

                        v_des_ente := fue_obt_nom_ente(mp.dato);

                        IF NVL(v_monto, 0) <> NVL(V_TDEBDET, 0) AND v_pro_con_errores = 'N' THEN
                           v_des_monto := 'Monto: ' || lf_for_money(nvl(V_TDEBDET, mp.monto), 16) || chr(10);
                           -- obtenemos los registros con error para mostrar en el detalle
                           lp_obt_sue_errores(mp.dato, mp.referencia, v_retorno.detalles.listaDetalleSalario);
                        ELSE
                           v_des_monto := 'Monto   : ' || lf_for_money(mp.monto, 16);
                        END IF;

                        IF TRUNC(to_date(mp.dato2, 'DD/MM/YYYY')) = TRUNC(SYSDATE) THEN
                           it_mail.mail(fug_obt_dir_correo, v_dir_correo, 'Pago de Sueldos Confirmado', 'Pago de Sueldos ingresado por HomeBanking ha sido confirmado por el Cliente ' || chr(10) ||
                           'Codigo  : ' || mp.dato || chr(10) ||
                           'Empresa : ' || v_des_ente || chr(10) ||
                           v_des_monto || chr(10)
                           || 'Cantidad: ' || to_char(mp.cantidad) || chr(10) ||
                            'Atentamente. ');
                        ELSE
                           it_mail.mail(fug_obt_dir_correo, v_dir_correo, 'Pago de Sueldos Autorizado', 'Pago de Sueldos ingresado con fecha Futura por HomeBanking'
                           || chr(10) ||  'Codigo  : ' || mp.dato || chr(10) ||
                            'Empresa : ' || v_des_ente || chr(10) ||
                            v_des_monto || chr(10) ||
                            'Cantidad: ' || to_char(mp.cantidad) || chr(10) ||
                            'Fecha de pago: ' || mp.dato2 || chr(10) ||
                            'Atentamente. ');
                        END IF;



                     EXCEPTION
                        WHEN OTHERS THEN
                           v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200)||']';
                     END;
                  END IF;
               ELSIF mp.cod_tip_mensaje = '071' THEN -- Acreditaciones Gourmet
                   DECLARE
                      v_acrgourmet typ_acrgourmet;
                   BEGIN
                      v_acrgourmet := fu_acreditacionGourmet(p_sesion,
                                           p_codigoCanal,
                                           mp.dato2,
                                           'A',
                                           mp.nro_cuenta,
                                           mp.nro_documento,
                                           mp.nro_documento,
                                           mp.monto,
                                           null,
                                           null,
                                           null);
                      IF v_acrgourmet.error = 'S' THEN
                         v_retorno.error                := v_acrgourmet.error;
                         v_retorno.nombreRespuesta      := v_acrgourmet.nombreRespuesta;
                         v_retorno.descripcionRespuesta := v_acrgourmet.descripcionRespuesta;
                         v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200)||']';
                      ELSE
                   --Se actualizan los datos en el temporal
                   UPDATE ta_acr_gourmet_tmp SET estado = 'C', fec_proceso = trunc(sysdate)
                   WHERE cod_ente = mp.dato2
                   AND nro_archivo = mp.dato
                   AND trunc(fec_insercion) = trunc(sysdate);
                   --Se invoca al proceso que realiza las acreditaciones online
                       prt_gen_acr_gourmet(mp.dato,mp.dato2);
                      END IF;
                   EXCEPTION
                       WHEN OTHERS THEN
                           pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200)||']';

                     end;
               ELSIF mp.cod_tip_mensaje = '075' THEN -- pago a proveedores
                  DECLARE
                     v_fec_pago1   DATE := to_date(substr(mp.dato2, 1, 10), 'dd/mm/yyyy');
                     v_cam_fecha   BOOLEAN := FALSE;
                     v_est_periodo ge_snp_horarios.estado%TYPE;
                     v_fec_snp_hor DATE;
                     v_cantidad    NUMBER;
                     v_nro_archivo NUMBER := mp.referencia;
                  BEGIN
                     v_msj_bitacora := v_msj_bitacora || ', fecPag:' || v_fec_pago1 || ', codEnt:' || mp.dato;
                     -- CR verifico la hora de cierre
                     IF trunc(v_fec_pago1) = TRUNC(SYSDATE) THEN
                        v_cam_fecha := paw_bce.fu_ver_hor_cie_proveedor(v_fec_pago1);
                        -- verificar si el horario sipap esta cerrado y tiene pagos sipap, cambiar la fecha
                        IF v_cam_fecha = FALSE THEN
                           v_cantidad := paw_can.fu_obt_pag_snp_proveedores(mp.dato, v_fec_pago1, v_nro_archivo);
                           v_hora_fin := paw_bas.fu_obt_hor_fin_snp(1);
                           v_hora_pro := TO_CHAR(SYSDATE,'HH24MI');
                           IF TO_NUMBER(v_hora_pro) >= TO_NUMBER(v_hora_fin) AND v_cantidad > 0 THEN
                              -- sipap cerrado, se debe cambiar la fecha de pago
                              v_cam_fecha := TRUE;
                           END IF;
                        END IF;
                        IF v_cam_fecha THEN
                           v_fec_pago1 := trunc(SYSDATE);
                           v_cam_fecha := pag_prv.fu_cam_fec_pago(mp.dato, v_fec_pago1, v_nro_archivo, 'S', mp.fec_insercion); -- modificamos el temporal
                        END IF;
                     END IF;

                     pag_prv.PR_VER_DAT_TMP(mp.dato, v_fec_pago1, NULL, v_error, 'S', mp.nro_documento, mp.nro_cuenta, v_nro_archivo /* mp.referencia*/,mp.fec_insercion);
                     IF v_error IS NOT NULL THEN
                        IF instr(v_error, 'Horario SIPAP Cerrado') > 0 THEN
                           pr_mensajeUsuario(PRO_ERR_SIPAP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        ELSE
                           pr_mensajeusuario(PRO_AUT_ERR_DAT_PROVEEDORES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        END IF;
                        v_msj_bitacora := v_msj_bitacora || ', PRV-ERR:[' || SUBSTR(v_error, 1, 150)||']';
                     ELSE
                        BEGIN
                           v_des_ente := fue_obt_nom_ente(mp.dato);
                           IF v_fec_pago1 = trunc(SYSDATE) THEN
                              pag_prv.PR_PRO_PAGO(to_number(mp.dato), mp.nro_documento, v_err_pago);
                              IF v_err_pago <> '00' THEN
                                 pr_mensajeusuario(PRO_AUT_ERR_PAG_PROVEEDORES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                 v_msj_bitacora := v_msj_bitacora || ', pr_pro_pago:[' || SUBSTR(v_err_pago, 1, 100)||']';
                              ELSE
                                 -- controlamos el horario sipap
                                 v_hora_fin := paw_bas.fu_obt_hor_fin_snp(1);
                                 v_hora_pro := TO_CHAR(SYSDATE,'HH24MI');
                                 -- DDSI-153 Se valida el horario sipap para cambiar o no la fecha.
                                 -- DDSI-1234: no se usa estado, solo hora fin
                                 IF TO_NUMBER(v_hora_pro) >= TO_NUMBER(v_hora_fin) THEN -- hora sipap cerrada
                                     v_fec_snp_hor := pag_prv.fu_obt_fec_snp(1);

                                    -- si llego hasta aca es porque el lote no es mixto
                                    IF v_fec_snp_hor = v_fec_pago1 THEN
                                        -- si se cambia la fecha hay que ver si hay monedas distintas
                                       v_cantidad := pag_prv.fu_obt_can_ope_cambio(mp.dato, v_fec_pago1, mp.cod_moneda, v_nro_archivo);

                                       IF v_cantidad > 0 THEN -- hora cerrada no permite operacion de cambio
                                          pr_mensajeusuario(PRO_ERR_SIPAP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                       ELSE
                                          -- se cambia fecha de pago por hora cerrada, solo pagos SIPAP si llego hasta aca
                                          v_cam_fecha := pag_prv.fu_cam_fec_pago(mp.dato, v_fec_pago1, v_nro_archivo);
                                     END IF;
                                    END IF;
                                 END IF;
                              END IF;
                           ELSE
                              v_cantidad := pag_prv.fu_obt_can_ope_cambio(mp.dato, v_fec_pago1, mp.cod_moneda, v_nro_archivo);
                              IF v_cantidad > 0 THEN -- hora cerrada no permite operacion de cambio
                                 pr_mensajeusuario(PRO_ERR_SIPAP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                              ELSE
                                 it_mail.mail(fug_obt_dir_correo, fug_obt_pardinamico('SUE_DIR_CORREO'), 'Pago a Proveedores en Fecha Futura', 'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) || 'Codigo  : ' || mp.dato || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Monto   : ' || lf_for_money(mp.monto, 16) || chr(10) || 'Cantidad: ' || to_char(mp.cantidad) || chr(10) || 'Fecha de Pago: ' || to_char(v_fec_pago1, 'dd/mm/yyyy') || chr(10) || chr(10) || 'Atentamente. ');
                              END IF;
                           END IF;
                           IF v_retorno.error = 'N' THEN
                              IF v_cam_fecha THEN
                                 v_msj_bitacora := v_msj_bitacora || ', cam_hor_snp: '||to_char(v_fec_pago1, 'dd/mm/yyyy');
                                 -- posible cambio de nro_archivo por cambio de fecha de pago
                                 IF v_nro_archivo <> mp.referencia THEN
                                    UPDATE bw_mov_pendientes
                                       SET referencia = v_nro_archivo
                                     WHERE nro_documento = v_nro_documento
                                       AND cod_per_principal = v_cod_per_empresa;
                                 END IF;
                              END IF;
                              v_error := NULL;
                              pag_prv.pr_pro_pag_snp (mp.dato, user, v_error, v_fec_pago1, v_nro_archivo);
                              IF v_error IS NOT NULL THEN
                                 pr_mensajeusuario(PRO_AUT_ERR_PAG_PROVEEDORES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                 v_msj_bitacora := v_msj_bitacora || ', pr_pro_pag_snp:[' || SUBSTR(v_error, 1, 150)||']';
                              ELSE
                                 IF v_fec_pago1 = TRUNC(SYSDATE) THEN
                                    it_mail.mail(fug_obt_dir_correo, fug_obt_pardinamico('SUE_DIR_CORREO'), 'Pago a Proveedores en Linea', 'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) || 'Codigo  : ' || mp.dato || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Monto   : ' || lf_for_money(mp.monto, 16) || chr(10) || 'Cantidad: ' || to_char(mp.cantidad) || chr(10) || 'Fecha de Pago: ' || to_char(v_fec_pago1, 'dd/mm/yyyy') || chr(10) || chr(10) || 'Atentamente. ');
                                 END IF;
                              END IF;
                           END IF;

                           -- CR actualizamos el cambio de fecha en la tabla de movimientos pendientes
                           IF v_cam_fecha = TRUE AND v_retorno.error = 'N' THEN
                              paw_bce.pr_act_fec_pag_pendiente(v_nro_documento, v_cod_per_empresa, to_char(v_fec_pago1, 'dd/mm/yyyy') /*|| ' ' || substr(mp.dato2, 12, 10)*/);
                              v_msj_bitacora := v_msj_bitacora || ', fecNue:' || v_fec_pago1;
                           END IF;

                           IF v_retorno.error = 'N' THEN
                             pag_prv.PR_ELI_PROV_TMP(mp.dato, mp.fec_insercion, v_nro_archivo /*mp.referencia*/);
                             pag_prv.PR_ELI_FAC_TMP(mp.dato, mp.fec_insercion, v_nro_archivo /*mp.referencia*/);
                           END IF;
                           --
                        EXCEPTION
                           WHEN OTHERS THEN
                              v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200)||']';
                              pr_mensajeusuario(PRO_AUT_ERR_PAG_PROVEEDORES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        END;
                     END IF;
                  END;
               ELSIF mp.cod_tip_mensaje = '090' THEN -- recaudaciones
                  DECLARE
                     v_fec_operacion     DATE := to_date(substr(mp.dato2, 1, 10), 'dd/mm/yyyy');
                     v_hor_cierre        VARCHAR2(19) := to_char(sysdate,'dd/mm/yyyy')||' '||nvl(substr(trim(fug_obt_pardinamico('HOR_CIE_PAG_SER_RECAUDACION')),1,5),'18:00')||':00';
                     v_cam_fec_operacion DATE;
                     v_cam_nro_archivo   NUMBER;
                     v_nro_archivo       ge_pag_recaudaciones.nro_archivo%TYPE := mp.referencia;
                     v_tip_proceso       VARCHAR2(1) := nvl(fug_obt_parentes(mp.dato, 'TIP_PRO_RECAUDACION'), 'O');
                  BEGIN
                     v_msj_bitacora := v_msj_bitacora || ', fec_ope:' || substr(mp.dato2, 1, 10);
                     IF v_fec_operacion = trunc(SYSDATE) THEN
                        IF SYSDATE > to_date(v_hor_cierre, 'dd/mm/yyyy hh24:mi:ss') THEN
                           -- se cambia la fecha de proceso por autorizacion fuera del horario de corte
                           v_cam_fec_operacion := pag_cal.fu_obt_fec_habil(v_fec_operacion + 1, 1, v_msj_caja.codigoOficinaOrigen);
                           v_msj_bitacora := v_msj_bitacora || ', cam_fec_ope:' || to_char(v_cam_fec_operacion, 'dd/mm/yyyy');
                           -- se reverifica el numero de archivo por cambio de fecha de operacion
                           v_cam_nro_archivo := pag_rec.FU_OBT_SIG_NUM_ARCHIVO(mp.dato, v_cam_fec_operacion);
                           v_msj_bitacora := v_msj_bitacora || ', cam_nro_arc:' || v_cam_nro_archivo;
                           -- se cambia la fecha operacion y nro_secuencia del proceso pendiente
                           UPDATE bw_mov_pendientes p
                              SET p.dato2 = to_char(v_cam_fec_operacion, 'dd/mm/yyyy'),
                                  p.referencia = v_cam_nro_archivo
                            WHERE p.nro_documento = mp.nro_documento
                              AND p.cod_per_principal = mp.cod_per_principal
                              AND p.cod_tip_mensaje = mp.cod_tip_mensaje
                              AND trunc(p.fec_insercion) = trunc(SYSDATE);
                           -- se cambia la fecha operacion y nro_secuencia de los detalles
                           UPDATE ge_pag_recaudaciones_tmp t
                              SET t.fec_operacion = v_cam_fec_operacion,
                                  t.nro_archivo = v_cam_nro_archivo
                            WHERE t.cod_ente = mp.dato
                              AND t.fec_operacion = v_fec_operacion
                              AND t.nro_archivo = v_nro_archivo
                              AND trunc(t.fec_insercion) = trunc(SYSDATE);

                           -- actualizamos los nuevos valores de nro_archivo y fecha operacion
                           v_fec_operacion := v_cam_fec_operacion;
                           v_nro_archivo := v_cam_nro_archivo;
                        END IF;
                     END IF;
                     pag_rec.pr_ins_ge_pag_recaudaciones(mp.dato, v_nro_archivo, v_fec_operacion, v_error);

                     IF v_error IS NOT NULL THEN
                        pr_mensajeusuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        v_msj_bitacora := v_msj_bitacora || ', pag_rec:[' || SUBSTR(v_error, 1, 100)||']';
                     ELSE
                        v_msj_bitacora := v_msj_bitacora || ', eli_tmp:' || pag_rec.fu_eli_temporal(mp.dato, v_nro_archivo, v_fec_operacion);
                        v_msj_bitacora := v_msj_bitacora || ', eli_err:' || pag_rec.fu_eli_errores(mp.dato, v_nro_archivo, v_fec_operacion);
                        --pag_rec.pr_val_datos(mp.dato, v_fec_operacion, v_nro_archivo, 'S', 'S');
                        pag_rec.pr_val_temporal(mp.dato, v_fec_operacion, v_nro_archivo, 'S');
                        v_msj_bitacora := v_msj_bitacora || ', est_act:' || pag_rec.fu_act_est_recaudacion(mp.dato, v_nro_archivo, v_fec_operacion, 'A');
                     END IF;
                     -- si es online y no hay errores, procesar
                     IF v_fec_operacion = trunc(SYSDATE) AND v_retorno.error = 'N' AND v_tip_proceso = 'O' THEN
                        pag_rec.PR_COB_SER_REC('N', NULL, mp.dato);
                        IF v_error IS NOT NULL THEN
                           pr_mensajeusuario(PRO_AUT_ERR_RECAUDACIONES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           v_msj_bitacora := v_msj_bitacora || ', PAG_REC:[' || SUBSTR(v_error, 1, 200)||']';
                        END IF;
                     END IF;
                  EXCEPTION
                     WHEN OTHERS THEN
                        v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200)||']';
                        pr_mensajeusuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  END;
               ELSIF mp.cod_tip_mensaje = '130' THEN -- alta de empleados
                  DECLARE
                     v_alta typ_altaEmpleados;
                  BEGIN
                     v_alta := fu_altaEmpleados(p_sesion,
                                                p_codigoCanal,
                                                'A',
                                                mp.cod_moneda,
                                                mp.dato2,
                                                mp.cantidad,
                                                NULL,
                                                NULL,
                                                NULL,
                                                mp.nro_documento);
                      IF v_alta.error = 'S' THEN
                        v_retorno.error                := v_alta.error;
                        v_retorno.nombreRespuesta      := v_alta.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_alta.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := v_alta.numeroDocumento;
                     END IF;
                  END;
               ELSIF mp.cod_tip_mensaje = '227' THEN -- transferencias internacionales
                  DECLARE
                     v_transferencia        typ_transferenciaban;
                     v_nom_beneficiario     lc_transferencias.nom_beneficiario%TYPE;
                     v_dir_beneficiario     lc_transferencias.dir_beneficiario%TYPE;
                     v_nro_cta_referencia   lc_transferencias.nro_cta_referencia%TYPE;
                     v_nom_banco            lc_transferencias.nom_banco%TYPE;
                     v_cod_pais             ba_paises.cod_pais%TYPE;
                     v_cod_ciudad           ba_ciudades.cod_ciudad%TYPE;
                     v_cod_bco_corresponsal lc_transferencias.cod_bco_corresponsal%TYPE;
                     v_nom_bco_corresponsal lc_transferencias.nom_bco_cor_contra%TYPE;
                     v_swi_bco_corresponsal lc_transferencias.cod_swi_bco_contra%TYPE;
                     v_pai_bco_corresponsal lc_transferencias.cod_pai_bco_contra%TYPE;
                     v_ciu_bco_corresponsal lc_transferencias.cod_ciu_bco_contra%TYPE;
                     v_cod_mon_credito      ba_monedas.cod_moneda%TYPE;
                     v_nro_contrato         lc_ope_pendientes.nro_diario%TYPE;
                     v_tip_cargo            VARCHAR2(3);
                     v_plazo                NUMBER(3);
                     v_tip_motivo           lc_transferencias.tip_motivo%TYPE;
                     v_tip_fondo            lc_transferencias.tip_fondo%TYPE;
                     v_tip_financiacion     lc_transferencias.tip_financiacion%TYPE;
                     v_cod_swift            lc_transferencias.cod_swi_banco%TYPE;
                     v_ref_beneficiario     lc_transferencias.referencia%TYPE;
                     v_observacion          lc_transferencias.observacion%TYPE;
                     v_cod_pai_beneficiario lc_transferencias.cod_pai_beneficiario%TYPE;
                     v_cod_ciu_beneficiario lc_transferencias.cod_ciu_beneficiario%TYPE;
                     v_parametros           bw_movimientos.parametros%TYPE;
                     v_ord_pago             VARCHAR2(20);
                     v_indice               NUMBER := 1;
                  BEGIN
                     -- obtenemos parametros adicionales
                     SELECT observacion, parametros
                       INTO v_observacion, v_parametros
                       FROM bw_movimientos
                      WHERE nro_documento = mp.nro_documento
                        AND trunc(fec_hora) = trunc(mp.fec_hora)
                        AND cod_per_principal = mp.cod_per_principal
                        AND cod_tip_mensaje = mp.cod_tip_mensaje;

                     v_nom_beneficiario := TRIM(substr(v_parametros, v_indice, 120)); v_indice := v_indice + 120;
                     v_dir_beneficiario := TRIM(substr(v_parametros, v_indice, 100)); v_indice := v_indice + 100;
                     v_nom_banco := TRIM(substr(v_parametros, v_indice, 100)); v_indice := v_indice + 100;
                     v_nom_bco_corresponsal := TRIM(substr(v_parametros, v_indice, 100)); v_indice := v_indice + 100;
                     v_nro_cta_referencia := TRIM(substr(v_parametros, v_indice, 30)); v_indice := v_indice + 30;
                     v_cod_pais := TRIM(substr(v_parametros, v_indice, 3)); v_indice := v_indice + 5;
                     v_cod_ciudad := TRIM(substr(v_parametros, v_indice, 3)); v_indice := v_indice + 5;
                     v_cod_bco_corresponsal := TRIM(substr(v_parametros, v_indice, 3)); v_indice := v_indice + 5;
                     v_pai_bco_corresponsal := TRIM(substr(v_parametros, v_indice, 3)); v_indice := v_indice + 5;
                     v_cod_mon_credito := TRIM(substr(v_parametros, v_indice, 3)); v_indice := v_indice + 5;
                     v_nro_contrato := TRIM(substr(v_parametros, v_indice, 3)); v_indice := v_indice + 10;
                     v_tip_cargo := TRIM(substr(v_parametros, v_indice, 3)); v_indice := v_indice + 5;
                     v_plazo := TRIM(substr(v_parametros, v_indice, 3)); v_indice := v_indice + 5;
                     v_tip_motivo := TRIM(substr(v_parametros, v_indice, 2)); v_indice := v_indice + 5;
                     v_tip_fondo := TRIM(substr(v_parametros, v_indice, 2)); v_indice := v_indice + 5;
                     v_tip_financiacion := TRIM(substr(v_parametros, v_indice, 2)); v_indice := v_indice + 5;
                     v_cod_swift := TRIM(substr(v_parametros, v_indice, 20)); v_indice := v_indice + 20;
                     v_cod_pai_beneficiario := TRIM(substr(v_parametros, v_indice, 3)); v_indice := v_indice + 5;
                     v_cod_ciu_beneficiario := TRIM(substr(v_parametros, v_indice, 3)); v_indice := v_indice + 5;
                     v_ref_beneficiario := TRIM(substr(v_parametros, v_indice, 300)); v_indice := v_indice + 300;
                     v_swi_bco_corresponsal := TRIM(substr(v_parametros, v_indice, 20)); v_indice := v_indice + 20;
                     v_ciu_bco_corresponsal := TRIM(substr(v_parametros, v_indice, 3));  v_indice := v_indice + 3;
                     v_ord_pago := TRIM(substr(v_parametros, v_indice, 20));  v_indice := v_indice + 20;

                     SELECT decode(v_nro_contrato, 0, NULL, v_nro_contrato),
                            decode(v_cod_bco_corresponsal, 0, NULL, v_cod_bco_corresponsal),
                            decode(v_cod_pai_beneficiario, 0, NULL, v_cod_pai_beneficiario),
                            decode(v_cod_ciu_beneficiario, 0, NULL, v_cod_ciu_beneficiario),
                            decode(v_pai_bco_corresponsal, 0, NULL, v_pai_bco_corresponsal),
                            decode(v_ciu_bco_corresponsal, 0, NULL, v_ciu_bco_corresponsal)
                       INTO v_nro_contrato, v_cod_bco_corresponsal, v_cod_pai_beneficiario,
                            v_cod_ciu_beneficiario, v_pai_bco_corresponsal, v_ciu_bco_corresponsal
                       FROM DUAL;

                     v_transferencia := fu_transferenciaInternacional
                                           (p_sesion,
                                            p_codigoCanal,
                                            'A', -- modo
                                            v_nom_beneficiario,
                                            v_dir_beneficiario,
                                            v_nro_cta_referencia, -- p_cuentaCredito
                                            mp.dato2, -- p_codigoBanco
                                            v_nom_banco, --p_nombreBanco
                                            v_cod_swift,  -- p_codigoSwift
                                            v_cod_pais,
                                            v_cod_ciudad,
                                            v_cod_bco_corresponsal, --p_codBancoCorresponsal
                                            v_nom_bco_corresponsal,
                                            v_swi_bco_corresponsal,
                                            v_ciu_bco_corresponsal,
                                            v_pai_bco_corresponsal,
                                            v_cod_mon_credito,
                                            mp.mto_contra, -- p_montoCredito
                                            v_nro_contrato,
                                            mp.nro_cuenta, -- p_cuentaDebito
                                            v_tip_cargo,
                                            v_plazo,
                                            v_tip_motivo,
                                            v_tip_fondo,
                                            v_tip_financiacion,
                                            v_ref_beneficiario,
                                            v_observacion,
                                            p_claveTransaccional,
                                            p_claveToken,
                                            v_cod_pai_beneficiario,
                                            v_cod_ciu_beneficiario,
                                            NULL,
                                            NULL,
                                            mp.referencia,
                                            v_ord_pago);
                     IF v_transferencia.error = 'S' THEN
                        v_retorno.error                := v_transferencia.error;
                        v_retorno.nombreRespuesta      := v_transferencia.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_transferencia.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := v_transferencia.nroDocumento;
                     END IF;
                  EXCEPTION
                     WHEN OTHERS THEN
                        v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 250)||']';
                        pr_mensajeusuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  END;
               ELSIF mp.cod_tip_mensaje = '008' THEN
                  DECLARE
                     v_sof_data typ_mensajerespuesta;
                  BEGIN
                     v_sof_data := PAW_SEG.fu_act_est_softoken(mp.cod_per_ingreso, v_usu_sesion.codigoEmpresa, 'A');
                     paw_otp.pr_SoftokenNotifEmpre(v_usu_sesion.codigoEmpresa, mp.cod_per_ingreso, 'A');
                  EXCEPTION
                     WHEN OTHERS THEN
                        v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 250)||']';
                        pr_mensajeusuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  END;
               ELSIF mp.cod_tip_mensaje = '150' THEN
                  DECLARE
                     v_ret_data   typ_regceltoken;
                  BEGIN
                     v_ret_data := fu_asi_nro_token(p_sesion, p_codigoCanal, 'A', mp.dato, null, null, mp.cod_per_ingreso);

                     IF v_ret_data.error = 'S' THEN
                        v_retorno.error                := v_ret_data.error;
                        v_retorno.nombreRespuesta      := v_ret_data.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_ret_data.descripcionRespuesta;
                     ELSE
                        v_retorno.numeroDocumento      := v_ret_data.nroDocumento;
                     END IF;
                  END;

               END IF;
            END IF;
            -- fin de la confirmacion de operaciones
         ELSIF v_modo = 'R' AND v_retorno.error = 'N' THEN
            -- si no hubo errores, elimino los temporales
            IF mp.cod_tip_mensaje = '036' THEN
               BEGIN
                  UPDATE ge_snp_transferencias gs
                     SET gs.estado = 'C'
                   WHERE gs.nro_referencia = mp.referencia ;
               EXCEPTION
                  WHEN OTHERS THEN
                     pr_mensajeusuario(PRO_AUT_ERR_SNP_CANCELA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END;
            ELSIF mp.cod_tip_mensaje = '070' THEN
               -- Al anular debe borrar en ge_pag_sueldos_tmp.
               pag_sue.LP_DEL_DATOS_TEMPORA(mp.dato, to_date(mp.dato2, 'DD/MM/YYYY'), v_lugar, mp.referencia);
            ELSIF mp.cod_tip_mensaje = '075' THEN
               -- borro los movimientos pendientes
               pag_prv.PR_ELI_PROV_TMP(mp.dato, mp.fec_insercion, mp.referencia);
               pag_prv.PR_ELI_FAC_TMP(mp.dato, mp.fec_insercion, mp.referencia);
            ELSIF mp.cod_tip_mensaje = '090' THEN
               v_msj_bitacora := v_msj_bitacora || ', eli_tmp:' || pag_rec.fu_eli_temporal(mp.dato, mp.referencia, to_date(mp.dato2, 'dd/mm/yyyy'));
               v_msj_bitacora := v_msj_bitacora || ', eli_err:' || pag_rec.fu_eli_errores(mp.dato, mp.referencia, to_date(mp.dato2, 'dd/mm/yyyy'));
            ELSIF mp.cod_tip_mensaje = '130' THEN
               DELETE FROM ge_pag_sue_emp_tmp t
                WHERE t.cod_empresa = mp.dato
                  AND t.nro_lote = mp.referencia
                  AND trunc(mp.fec_insercion) = trunc(SYSDATE);
               v_msj_bitacora := v_msj_bitacora || ', eli_tmp:' || sql%rowcount;

            ELSIF mp.cod_tip_mensaje = '008' THEN
               DECLARE
                  v_sof_data typ_mensajerespuesta;
               BEGIN
                  v_sof_data := PAW_SEG.fu_act_est_softoken(mp.cod_per_ingreso,
                                                            v_usu_sesion.codigoEmpresa,
                                                           'R');
                  paw_otp.pr_SoftokenNotifEmpre(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona, 'A');
               EXCEPTION
                  WHEN OTHERS THEN
                     v_msj_bitacora := v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 250)||']';
                     pr_mensajeusuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END;
            END IF;

            -- actualizo a anulada/eliminada la operacion pendiente
            UPDATE bw_mov_pendientes
               SET estado = decode(v_per_autorizador, 'S', 'A'  -- ANULADA
                                                         , 'B') -- ELIMINADA
             WHERE nro_documento = v_nro_documento
               AND cod_per_principal = v_cod_per_empresa;

            -- si no hubo errores
            IF v_retorno.error = 'N' THEN
               BEGIN
                  -- inserto el movimiento por la anulacion
                  INSERT INTO bw_autorizaciones
                     (cod_persona, nro_documento, fec_hora, accion, observacion)
                  VALUES
                     (v_usu_sesion.codigoPersona, v_nro_documento, SYSDATE, decode(v_per_autorizador, 'S', 'R', 'B'), v_comentario);
               EXCEPTION
                  WHEN dup_val_on_index THEN
                     pr_mensajeusuario(PRO_AUT_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END;
            END IF;
            -- fin de la anulacion
         END IF;
      END IF;

      IF v_retorno.error = 'N' THEN
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_SALIDA);
      ELSE
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
      END IF;

      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', ORA-ERR:[' || SUBSTR(SQLERRM, 1, 200) || '] ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
   END;
   -- fin fu_autorizarOperacion

   -- Que operaciones tiene configurado el usuario
   FUNCTION fu_obtenerPermisos(p_sesion      IN VARCHAR2,
                               p_codigoCanal IN VARCHAR2) RETURN typ_permisosUsuarios IS
      v_retorno       typ_permisosUsuarios := typ_permisosUsuarios();
      v_sesion        typ_validarSesion;
      v_msj_caja      typ_mensajeCaja;
      v_cantidad      NUMBER := 0;
      v_lis_permisos  typ_listaPermisoUsuario := typ_listaPermisoUsuario();
      v_per_usuario   typ_permisoUsuario := typ_permisoUsuario();
      v_mensajes      VARCHAR2(300) := NULL;
      v_cod_operacion VARCHAR2(3) := '200';
      -- esquema clave administrador
      /*CURSOR c_rol_vinculos IS
         SELECT p.cod_tip_mensaje, p.consulta, p.ingresa, p.autoriza
           FROM bw_rol_vinculos p
          WHERE p.cod_persona = v_sesion.codigoPersona
            AND nvl(p.cod_per_vinculada, 'x') = nvl(v_sesion.codigoEmpresa, 'x');*/
      -- permiso del perfil especifico para la empresa
      CURSOR c_per_empresa IS
         SELECT p.cod_tip_mensaje, p.consulta, p.ingresa, p.autoriza
           FROM bw_rol_permisos p
          WHERE cod_perfil = v_sesion.codigoPerfil
            AND cod_persona = nvl(v_sesion.codigoEmpresa, v_sesion.codigoPersona);
      -- permiso del perfil general
      CURSOR c_per_ferfil IS
         SELECT p.cod_tip_mensaje, p.consulta, p.ingresa, p.autoriza
           FROM bw_rol_permisos p
          WHERE cod_perfil = v_sesion.codigoPerfil
            AND cod_persona IS NULL;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      --se valida la sesión del cliente
      v_sesion := fu_validarSesion(p_sesion, p_codigoCanal);
      IF v_sesion.error = 'S' THEN
         v_retorno.error                := v_sesion.error;
         v_retorno.nombreRespuesta      := v_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- se valida la caja
      v_msj_caja := lf_val_caja(v_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      pr_insertarBitacora(v_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_sesion.codigoEmpresa, 'obtenerPermisos - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);


     /* IF v_sesion.operadorHomebanking = 'S' THEN
         FOR per IN c_rol_vinculos LOOP
            v_cantidad := v_cantidad + 1;
            v_per_usuario.codigoMensaje := per.cod_tip_mensaje;
            v_per_usuario.descripcionMensaje := NULL;
            v_per_usuario.consulta := per.consulta;
            v_per_usuario.ingresa := per.ingresa;
            v_per_usuario.autoriza := per.autoriza;
            v_lis_permisos.extend;
            v_lis_permisos(v_lis_permisos.count) := v_per_usuario;
         END LOOP;
      ELSE*/
         FOR per IN c_per_empresa LOOP
            v_cantidad := v_cantidad + 1;
            v_mensajes := v_mensajes || per.cod_tip_mensaje || ',';
            v_per_usuario.codigoMensaje := per.cod_tip_mensaje;
            v_per_usuario.descripcionMensaje := NULL;
            v_per_usuario.consulta := per.consulta;
            v_per_usuario.ingresa := per.ingresa;
            v_per_usuario.autoriza := per.autoriza;
            v_lis_permisos.extend;
            v_lis_permisos(v_lis_permisos.count) := v_per_usuario;
         END LOOP;
         FOR per IN c_per_ferfil LOOP
            IF v_mensajes IS NULL OR instr(v_mensajes, per.cod_tip_mensaje||',') = 0 THEN
               v_cantidad := v_cantidad + 1;
               v_per_usuario.codigoMensaje := per.cod_tip_mensaje;
               v_per_usuario.descripcionMensaje := NULL;
               v_per_usuario.consulta := per.consulta;
               v_per_usuario.ingresa := per.ingresa;
               v_per_usuario.autoriza := per.autoriza;
               v_lis_permisos.extend;

               v_per_usuario.codigoMensaje := per.cod_tip_mensaje;

                 /* permisos especiales por persona, que no forman parte de la
                  definida con rol_permisos
                */
               -- autorizador de softtoken para empresas: 008
               IF v_per_usuario.codigoMensaje = '008' THEN
                   v_per_usuario.autoriza := paw_otp.fu_es_aut_softoken(v_sesion.codigoPersona, v_sesion.codigoEmpresa);
               END IF;


               v_lis_permisos(v_lis_permisos.count) := v_per_usuario;
            END IF;
         END LOOP;
      --END IF;
      v_retorno.cantidad := v_cantidad;
      v_retorno.listaPermisos := v_lis_permisos;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_sesion.codigoPersona, p_codigoCanal, p_sesion, '200', v_sesion.codigoEmpresa, 'permiso user logion - ['||SUBSTR(SQLERRM, 1, 400) || '] ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
   END;


  FUNCTION fu_obtenerHisPagoNomina(p_sesion IN VARCHAR2,
                                 p_codigoCanal IN VARCHAR2,
                                 p_fec_ini IN DATE DEFAULT NULL,
                                 p_fec_fin IN DATE DEFAULT NULL,
                                 p_nro_cuenta IN VARCHAR2 DEFAULT NULL,
                                 p_beneficiario IN VARCHAR2 DEFAULT NULL,
                                 p_parametro IN VARCHAR2 DEFAULT 'H') RETURN typ_pagosalarios IS
   v_nro_cuenta   VARCHAR2(15);
   v_fec_ini      DATE;
   v_fec_fin      DATE;
   v_cod_ente     ge_entes.cod_ente%TYPE;
   v_beneficiario VARCHAR2(200);
   userinfo       typ_validarsesion;
   --Cursor entes
   CURSOR c_entes IS
      select a.cod_ente
        from ge_entes a
       where a.cod_persona = userinfo.codigoEmpresa
         and a.tipo = 'SU'
       order by a.cod_ente;
   --Cursor datos historicos
   CURSOR c_datos(v_nro_cuenta varchar2, v_cod_ente number, v_fec_ini DATE, v_fec_fin DATE, v_beneficiario varchar2) IS
      (SELECT
         'REALIZADO' estado, g.nro_cuenta cuenta, c.denominacion beneficiario, g.cod_moneda moneda, g.monto monto,
         g.fec_proceso fecha, g.tipo tipo, paw_bce.fu_tip_cuenta(c.cod_modulo, c.cod_modalidad) cod_tip_cuenta,
         mp.nro_documento, mp.cod_per_ingreso, mp.fec_insercion, g.nro_documento nro_doc_credito
      FROM
         ge_pag_sueldos g, ge_cuentas c, bw_mov_pendientes mp--, ge_cta_clientes a
      WHERE
         g.cod_ente = v_cod_ente
         AND g.fec_proceso between v_fec_ini and v_fec_fin
         AND mp.cod_per_principal = userinfo.codigoEmpresa
         AND mp.cod_tip_mensaje = '070'
         AND mp.estado = 'C'
         AND g.nro_secuencia = mp.referencia
         AND to_char(g.cod_ente) = mp.dato
         AND trunc(g.fec_proceso) = trunc(to_date(mp.dato2, 'DD/MM/YYYY'))
         AND g.nro_cuenta = c.nro_cuenta
         AND g.procesado = 'S'
         AND g.nro_cuenta = nvl(v_nro_cuenta, g.nro_cuenta)
         AND g.tipo <> 'D'
         AND upper(c.denominacion) like '%' || nvl(upper(v_beneficiario), upper(c.denominacion)) || '%')
      UNION ALL
      (SELECT
         'A CONFIRMAR' estado, tmp.nro_cuenta cuenta, c.denominacion beneficiario, mp.cod_moneda moneda, tmp.monto monto,
         tmp.fec_proceso fecha, tmp.tipo tipo, paw_bce.fu_tip_cuenta(c.cod_modulo, c.cod_modalidad) cod_tip_cuenta,
         mp.nro_documento, mp.cod_per_ingreso, mp.fec_insercion, tmp.nro_documento nro_doc_credito
      FROM
         GE_PAG_SUELDOS_TMP tmp, ge_cuentas c, bw_mov_pendientes mp
      WHERE
         tmp.COD_ENTE = v_cod_ente
         AND mp.COD_TIP_MENSAJE = '070'
         AND mp.can_aut_faltantes = 0
         AND mp.COD_PER_PRINCIPAL = userinfo.codigoEmpresa
         AND tmp.nro_archivo = mp.referencia
         AND to_char(tmp.cod_ente) = mp.dato
         AND TRUNC(to_date(mp.dato2, 'DD/MM/YYYY')) = TRUNC(tmp.fec_proceso)
         AND tmp.nro_cuenta = c.nro_cuenta
         AND tmp.nro_cuenta = nvl(v_nro_cuenta, tmp.nro_cuenta)
         AND tmp.tipo <> 'D'
         AND (( v_fec_ini is not null and v_fec_fin is not null and trunc(tmp.fec_proceso) between trunc(v_fec_ini) and trunc(v_fec_fin) ) or
                 (trunc(tmp.fec_proceso) >= TRUNC(SYSDATE) and p_fec_ini is null  and p_fec_fin is null ))
       )
       UNION ALL
       (SELECT
         'CANCELADO' estado, err.nro_cuenta cuenta, c.denominacion beneficiario, err.cod_moneda moneda, err.monto monto,
         err.fec_proceso fecha, err.tipo tipo, paw_bce.fu_tip_cuenta(c.cod_modulo, c.cod_modalidad) cod_tip_cuenta,
         null, null, null, null
        FROM
           ge_pag_sueldos_err err, ge_cuentas c
        WHERE
         err.COD_ENTE = v_cod_ente
         AND err.nro_cuenta = c.nro_cuenta
         AND err.nro_cuenta = nvl(v_nro_cuenta, err.nro_cuenta)
         AND err.tipo <> 'D'
         AND TRUNC(err.fec_proceso) between trunc(v_fec_ini) and trunc(v_fec_fin))
      ORDER BY fecha DESC, cuenta;
    -- Cursor lista de beneficiarios

   CURSOR c_beneficiarios(v_cod_ente number) IS
      SELECT distinct c.nro_cuenta cuenta, c.denominacion beneficiario, g.cod_moneda moneda,
             fu_obt_ult_salario(g.nro_cuenta, v_cod_ente, max(g.fec_proceso)) monto ,
             max(g.fec_proceso) fecha, g.tipo tipo,
             paw_bce.fu_tip_cuenta(c.cod_modulo, c.cod_modalidad) cod_tip_cuenta
        FROM ge_pag_sueldos g, ge_cuentas c--, ge_cta_clientes a
       WHERE g.cod_ente = v_cod_ente
         AND g.fec_proceso > trunc(sysdate-180)
         AND g.nro_cuenta = c.nro_cuenta
         AND g.procesado = 'S'
         AND g.tipo <> 'D'
        -- AND a.nro_cuenta = c.nro_cuenta
         --AND a.nro_cuenta = g.nro_cuenta
         AND upper(c.denominacion) like '%' || nvl(upper(v_beneficiario), upper(c.denominacion)) || '%'
         GROUP BY c.nro_cuenta , c.denominacion , g.cod_moneda, g.nro_cuenta, g.tipo, c.cod_modulo, c.cod_modalidad
       ORDER BY c.denominacion;
   v_cod_operacion       VARCHAR2(3) := '470';
   v_msj_bitacora        VARCHAR2(500);
   v_permiso             typ_obtenerPermisos;
   v_msj_caja            typ_mensajeCaja;
   v_retorno             typ_pagosalarios := typ_pagosalarios;
   v_historicoConSalario typ_detallesalario := typ_detallesalario;
   v_lisHisDetalleSal    typ_listadetallesalario := typ_listaDetalleSalario();
   MSG_G_SIN_DATOS       CONSTANT VARCHAR2(15) := 'G_SIN_DATOS'; /**No se encontraron registros*/
   MSG_OPE_NO_PERMITIDA  CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
   v_can_detalles        NUMBER(5) := 0;
   v_carga               VARCHAR2(1);
BEGIN
   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
   v_retorno.cantidadCuentas := 0;
   -- 1. Valido la Sesión del Cliente
   userinfo := fu_validarsesion(p_sesion, p_codigoCanal);
   IF userinfo.error = 'S' THEN
      v_retorno.error                := userinfo.error;
      v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
      v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
      RETURN v_retorno;
   END IF;
   -- 2. verifica el canal de origen
   v_msj_caja := lf_val_caja(userinfo);
   IF v_msj_caja.error = 'S' THEN
      v_retorno.error                := v_msj_caja.error;
      v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
      RETURN v_retorno;
   END IF;
   -- 3. Verifico si el cliente con su perfil tendrá acceso a realizar la transacción
   v_permiso := lf_obt_permisos(userinfo, '070');
   IF (v_permiso.error = 'S') THEN
      v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
      v_retorno.error                := v_permiso.error;
      pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      RETURN v_retorno;
   END IF;

   -- solo puede consultar beneficiarios aquellos con permiso para cargar el pago
   IF p_parametro = 'B' AND v_permiso.registra = FALSE THEN
      pr_mensajeUsuario(MSG_OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, 'B sin registra ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      RETURN v_retorno;
   END IF;

   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

   -- Sanitizar variables
   v_nro_cuenta   := paw_bel.depurarAlfanumerico(p_nro_cuenta, 15);
   v_beneficiario := paw_bel.depurarAlfanumerico(p_beneficiario, 100);
   v_msj_bitacora := v_msj_bitacora || 'cta: '||p_nro_cuenta||', benef: '||p_beneficiario||', fecIn:'||p_fec_ini||', fecFi:'||p_fec_fin;

   -- Fechas Fin e Inicio
   IF p_fec_fin is null then
      v_fec_fin := (last_day(sysdate));
   ELSE
      v_fec_fin := p_fec_fin;
   END IF;
   IF p_fec_ini is null THEN
      IF p_fec_fin is not null THEN
         v_fec_ini := add_months(last_day(to_date(v_fec_fin, 'dd/mm/yyyy')), -3);
      ELSE
         v_fec_ini := add_months(last_day(sysdate), -3);
      END IF;
   ELSE
      v_fec_ini := p_fec_ini;
   END IF;

   IF p_parametro = 'B' then -- Lista de beneficiarios
     FOR I IN c_entes
         LOOP
            v_cod_ente := I.cod_ente;
            FOR reg IN c_beneficiarios (v_cod_ente)
            LOOP
               v_can_detalles                     := v_can_detalles + 1;
               v_historicoConSalario.fecha        := reg.fecha;
               v_historicoConSalario.numeroCuenta := substr(TRIM(reg.cuenta), 1, 15);
               v_historicoConSalario.nombreCuenta := substr(TRIM(reg.beneficiario), 1, 50);
               v_historicoConSalario.codigoMoneda := substr(reg.moneda, 1, 3);
               v_historicoConSalario.monto        := reg.monto;
               v_historicoConSalario.tipo         := substr(reg.tipo, 1, 1);
               v_historicoConSalario.descripcionTipoCuenta := substr(TRIM(reg.cod_tip_cuenta), 1, 35);

               v_lisHisDetalleSal.extend;
               v_lisHisDetalleSal(v_lisHisDetalleSal.count) := v_historicoConSalario;
            END LOOP;
         END LOOP;
   ELSE
   --datos
       FOR r IN c_entes
       LOOP
          v_cod_ente := r.cod_ente; --lista de histórico
          FOR reg IN c_datos(v_nro_cuenta, v_cod_ente, v_fec_ini, v_fec_fin, v_beneficiario)
          LOOP
             v_carga := 'S';
             -- si el usuario no registro, verificamos si autorizo/rechazo
             IF reg.cod_per_ingreso <> userinfo.codigoPersona THEN
                IF paw_can.fu_ver_autorizacion(reg.nro_documento, userinfo.codigoPersona) = 'N' THEN
                   v_carga := 'N';
                END IF;
             END IF;

             IF v_carga = 'S' THEN
                v_can_detalles                     := v_can_detalles + 1;
                v_historicoConSalario.fecha        := reg.fecha;
                v_historicoConSalario.numeroCuenta := substr(TRIM(reg.cuenta), 1, 15);
                v_historicoConSalario.nombreCuenta := substr(TRIM(reg.beneficiario), 1, 50);
                v_historicoConSalario.codigoMoneda := substr(reg.moneda, 1, 3);
                v_historicoConSalario.monto        := reg.monto;
                v_historicoConSalario.tipo         := substr(reg.tipo, 1, 1);
                v_historicoConSalario.descripcionTipoCuenta := substr(TRIM(reg.cod_tip_cuenta), 1, 35);
                v_historicoConSalario.numeroDocumento := substr(reg.nro_doc_credito, 1, 20);
                v_historicoConSalario.estado := reg.estado;
                v_lisHisDetalleSal.extend;
                v_lisHisDetalleSal(v_lisHisDetalleSal.count) := v_historicoConSalario;
             END IF;
          END LOOP;
       END LOOP;
   END IF;
   -- Valida si encontró datos
   IF v_can_detalles = 0 THEN
      pr_mensajeUsuario(MSG_G_SIN_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userinfo.codigoPersona,
                          p_codigoCanal,
                          p_sesion,
                          v_cod_operacion,
                          userinfo.codigoEmpresa,
                          v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ),
                          BITACORA_ERROR);
      RETURN v_retorno;
   END IF;
   IF v_lisHisDetalleSal.Count > 0 THEN
      v_retorno.listaCuentas := v_lisHisDetalleSal;
   END IF;
   v_retorno.cantidadCuentas := v_lisHisDetalleSal.Count;
   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
   pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
   RETURN v_retorno;
EXCEPTION
   WHEN OTHERS THEN
      pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora||', cant: '||v_can_detalles||', ORA-ERR: ['||substr(SQLERRM, 1, 250)||'] '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_SALIDA);
      RETURN v_retorno;
END;
   FUNCTION fu_obt_ult_salario(p_nro_cuenta IN VARCHAR2, p_cod_ente IN NUMBER, p_fec IN DATE) RETURN NUMBER IS
      v_monto NUMBER;
   BEGIN
      SELECT g.monto
        INTO v_monto
        FROM ge_pag_sueldos g, ge_cuentas c
       WHERE g.nro_cuenta = c.nro_cuenta
         AND g.procesado = 'S'
         AND g.cod_ente = p_cod_ente
         AND g.fec_proceso = p_fec
         AND g.tipo <> 'D'
         AND g.nro_cuenta = p_nro_cuenta
         AND ROWNUM= 1;
         RETURN v_monto;
   END;

   -- validar actividad de sesion
   FUNCTION fu_validarActividad(p_sesion   IN VARCHAR2,
                                p_codCanal IN VARCHAR2) RETURN typ_mensajerespuesta IS
      v_retorno typ_mensajerespuesta := typ_mensajerespuesta();
      v_sesion typ_validarSesion;
   BEGIN
      v_sesion := fu_validarSesion(p_sesion, p_codCanal);
      v_retorno.error                := v_sesion.error;
      v_retorno.nombreRespuesta      := v_sesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_sesion.descripcionRespuesta;
      RETURN v_retorno;
   END;
FUNCTION fu_valAdelantoFacil(p_sesion IN VARCHAR2,p_codCanal IN VARCHAR2,p_nroTarjetaCredito IN VARCHAR2, p_monto IN NUMBER, p_plazo IN NUMBER) RETURN typ_valadelantofacil is
       v_nro_tarjeta     VARCHAR2(32);
       v_sesion          VARCHAR2(32);
       v_codCanal        VARCHAR2(3) := depurarNumerico(p_codCanal, 3);
       userinfo          typ_validarsesion;
       v_retorno         typ_valadelantofacil := typ_valadelantofacil();
       v_mensajeCaja     typ_mensajeCaja;
       v_permiso         typ_obtenerPermisos;
       v_resultado       VARCHAR2(500);
       v_plazo           NUMBER(2);
       v_existe          VARCHAR2(1);
       --v_monto_min       NUMBER;

       /**Variables globales*/
      g_monto_min VARCHAR2(150) := fug_obt_parentes(6331, 'G_ADEL_MONT_MIN');
       --  Tipos de Mensajes de respuestas
       MSG_ADF_TAR_INV    CONSTANT VARCHAR2(15) := 'ADF_TAR_INV'; --Error nuevo
       MSG_ADF_TAR_NOP    CONSTANT VARCHAR2(15) := 'ADF_TAR_NOP'; --Error nuevo
       MSG_ADF_TAR_GS     CONSTANT VARCHAR2(15) := 'ADF_TAR_GS'; --Error nuevo
       MSG_ADF_TAR_TITU   CONSTANT VARCHAR2(15) := 'ADF_TAR_TITU'; --Error nuevo
       MSG_ADF_MON_CERO   CONSTANT VARCHAR2(15) := 'ADF_MON_CERO'; --Error nuevo
       MSG_ADF_SUP_SALDO  CONSTANT VARCHAR2(15) := 'ADF_SUP_SALDO'; --Error nuevo
       MSG_ADF_PLZ_MCERO  CONSTANT VARCHAR2(15) := 'ADF_PLZ_MCERO'; --Error nuevo
       MSG_ADF_SUP_MOD    CONSTANT VARCHAR2(15) := 'ADF_SUP_MOD'; --Error nuevo
       MSG_SINDATOS       CONSTANT VARCHAR2(15) := 'G_SIN_DATOS';
       MSG_OBT_TAR_NE     CONSTANT VARCHAR2(15) := 'OBT_TCR_NE';
       MSG_ADF_INV_MONTO  CONSTANT VARCHAR2(15) := 'ADF_INV_MONTO'; --Error nuevo
       MSG_ADF_INV_PLAZO  CONSTANT VARCHAR2(15) := 'ADF_INV_PLAZO'; --Error nuevo
       MSG_ADF_TARJ_NO    CONSTANT VARCHAR2(15) := 'ADF_TARJ_NO'; --Error nuevo
       MSG_ADF_MONT_EXCE  CONSTANT VARCHAR2(15) := 'ADF_MONT_EXC'; --Error nuevo

       v_cod_operacion    VARCHAR2(3) := '226';
       --v_codPersona       VARCHAR2(15);
       v_monto_limite     NUMBER(18,2); -- para monto límite de realizar adelanto fácil
   BEGIN
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       -- Valido la Sesión del Cliente
       userinfo := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codcanal);

       IF userinfo.error = 'S' THEN
          v_retorno.error                := userinfo.error;
          v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
          v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
          RETURN v_retorno;
       END IF;

       --v_codPersona := NVL(userinfo.codigoEmpresa, userinfo.codigoPersona);

       -- Verifica si el usuario tiene acceso a la opcion y en que condicion
       v_permiso := lf_obt_permisos(userinfo, v_cod_operacion);

       IF (v_permiso.error = 'S') THEN
          v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
          v_retorno.error                := v_permiso.error;
          RETURN v_retorno;
       END IF;

       -- Verifica el canal de origen
       v_mensajeCaja := lf_val_caja(userinfo);

       IF v_mensajeCaja.error = 'S' THEN
          v_retorno.error                := v_mensajeCaja.error;
          v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
          RETURN v_retorno;
       END IF;

       v_nro_tarjeta := depurarAlfanumerico(trim(p_nroTarjetaCredito),25);
       v_plazo := depurarNumerico(p_plazo,2);
       pr_insertarBitacora(userinfo.codigopersona, p_codcanal, p_sesion, v_cod_operacion, userinfo.codigoempresa, fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null), BITACORA_ENTRADA);

       --Verifica si se ingresó número de tarjeta de crédito
       IF p_nroTarjetaCredito IS NULL THEN
          pr_mensajeUsuario(MSG_OBT_TAR_NE,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null), BITACORA_ERROR);
          RETURN v_retorno;
       ELSE
          BEGIN
           SELECT 'X'
             INTO v_existe
             FROM ta_tarjetas f
            WHERE f.nro_tarjeta = v_nro_tarjeta
              AND f.cod_persona = nvl(userinfo.codigoPersona, userinfo.codigoEmpresa);
           EXCEPTION
              WHEN NO_DATA_FOUND THEN
               pr_mensajeUsuario(MSG_ADF_TARJ_NO,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
               pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
              WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
               pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'OTHERS'|| fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
           END;
       END IF;

       --Verifica si se ingresó monto
       IF p_nroTarjetaCredito IS NULL THEN
          pr_mensajeUsuario(MSG_ADF_INV_MONTO,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;

       --Verifica si se ingresó plazo
       IF p_nroTarjetaCredito IS NULL THEN
          pr_mensajeUsuario(MSG_ADF_INV_PLAZO,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;

      -- Validar monto mínimo -14-08-2014
      IF p_monto < to_number(g_monto_min) THEN
         pr_mensajeUsuario(MSG_ADF_MONT_EXCE,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'El monto ingresado es inferior al minimo definido.', BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- Validar el adelanto

      v_resultado:= fug_val_tar_adelanto(v_nro_tarjeta, p_monto, v_plazo);
        --1
      IF v_resultado = 'S-Tarjeta Inexistente o con Estado Inválido' THEN
         pr_mensajeUsuario(MSG_ADF_TAR_INV,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'Tarjeta Inexistente o con Estado Inválido', BITACORA_ERROR);
        --2
        ELSIF v_resultado = 'S-Número de Tarjeta Inexistente.' THEN
         pr_mensajeUsuario(MSG_ADF_TAR_INV,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'Número de Tarjeta Inexistente.', BITACORA_ERROR);
        --3
        ELSIF v_resultado = 'S-Modalidad de la Tarjeta no permite esta Operación.' THEN
         pr_mensajeUsuario(MSG_ADF_TAR_NOP,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'Modalidad de la Tarjeta no permite esta Operación.', BITACORA_ERROR);
        --4
        ELSIF v_resultado = 'S-Operación no permitida. La moneda debe ser GS.' THEN
         pr_mensajeUsuario(MSG_ADF_TAR_GS,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'Operación no permitida. La moneda debe ser GS.', BITACORA_ERROR);
        --5
        ELSIF v_resultado = 'S-Sólo el titutar de la cuenta puede realizar esta operación.' THEN
         pr_mensajeUsuario(MSG_ADF_TAR_TITU,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'Sólo el titutar de la cuenta puede realizar esta operación.', BITACORA_ERROR);
        --6
        ELSIF v_resultado = 'S-El Monto debe ser Mayor que 0.' THEN
         pr_mensajeUsuario(MSG_ADF_MON_CERO,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'El Monto debe ser Mayor que 0.', BITACORA_ERROR);
        --7
        ELSIF v_resultado = 'S-Monto supera al Saldo Disponible.' THEN
         pr_mensajeUsuario(MSG_ADF_SUP_SALDO,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'Monto supera al Saldo Disponible.', BITACORA_ERROR);
         --8
        ELSIF v_resultado = 'S-Plazo debe ser mayor que 0.' THEN
         pr_mensajeUsuario(MSG_ADF_PLZ_MCERO,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'Plazo debe ser mayor que 0.', BITACORA_ERROR);
         --8
        ELSIF v_resultado = 'S-Plazo supera el máximo permitido para esta Modalidad.' THEN
         pr_mensajeUsuario(MSG_ADF_SUP_MOD,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'Plazo supera el máximo permitido para esta Modalidad.', BITACORA_ERROR);
        ELSE
         pr_mensajeUsuario(MSG_OK,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa,'Validación correcta.', BITACORA_SALIDA);
        END IF;

      -- Recuperar monto límite
      BEGIN
         SELECT nvl(a.lin_credito, 0) - (nvl(a.sal_facturar, 0) + nvl(a.sal_financiado, 0) + nvl(a.sal_facturado, 0) + nvl(a.sal_cuo_pendientes, 0))
           INTO v_monto_limite
           FROM ta_cta_tarjetas a, ta_tarjetas b
          WHERE a.nro_cuenta = b.nro_cuenta
            AND b.nro_tarjeta = v_nro_tarjeta
            AND b.vigente = 'S'
            AND b.cod_estado = 6; --sólo activas

       v_retorno.montoLimite := (v_monto_limite * 1.1);

       EXCEPTION
        WHEN NO_DATA_FOUND THEN
        pr_mensajeUsuario(MSG_SINDATOS,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
        pr_insertarBitacora(userInfo.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, fu_generarbitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null), BITACORA_ERROR);
        v_retorno.montoLimite := 0;
       RETURN V_RETORNO;
       END;
    RETURN V_RETORNO;
END;
-- validacion o confirmacion de adelanto de clientes
FUNCTION fu_solicitarAdelanto(p_sesion             IN VARCHAR2,
                              p_codCanal           IN VARCHAR2,
                              p_modo               IN VARCHAR2  DEFAULT NULL,
                              p_nroTarjetaCredito  IN VARCHAR2,
                              p_monto              IN NUMBER,
                              p_plazo              IN NUMBER,
                              p_nro_cta_credito    IN VARCHAR2,
                              p_claveTransaccional IN VARCHAR2,
                              p_claveToken         IN VARCHAR2) RETURN typ_adelanto IS
   v_retorno        typ_adelanto := typ_adelanto;
   v_cod_operacion  VARCHAR2(3) := '226';
   retValidarSesion typ_validarSesion;
   retError         typ_mensajeRespuesta := typ_mensajeRespuesta;
   v_mensajeCaja    typ_mensajeCaja;
   v_resLimite      typ_respuestaLimite;
   v_permiso        typ_obtenerPermisos;
   v_valAdelanto    typ_valadelantofacil;
   -- datos recibidos
   v_plazo           NUMBER(16);
   v_monto           NUMBER(18, 2); -- monto a transferir
   v_nro_cta_credito VARCHAR2(17); -- cuenta de credito
   v_modo            VARCHAR2(1); -- modo V-validacion o C-confirmacion
   v_cod_modalidad   NUMBER(3);
   v_cod_oficina     NUMBER(3);
   v_tar_fec_venc    DATE;
-- para control de límites
   v_mod_limite       varchar2(3); -- para límite de operaciones
   v_cod_tra_padre   NUMBER(4) := 5160; -- cod. transaccion padre
   --v_cotizacion      NUMBER(18, 2) := NULL;
   --v_nro_documento   NUMBER(15);
   --v_nro_doc_credito VARCHAR2(20) := NULL; -- nro de documento del acreditado
   --v_concepto        VARCHAR2(100);
   -- agregados
   v_fec_valor       DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
   --v_hor_actual      VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
   v_nro_operacion   NUMBER(10); -- nro unico de operacion generado por el cliente
   v_nro_secuencia   NUMBER(3);
   --v_msg_error       VARCHAR2(15) := MSG_ERROR;
   v_nro_cta_tarjeta VARCHAR2(20);
   -- para lp_ver_operacion
   v_horario    VARCHAR2(1);
   v_es_mov_noc VARCHAR2(1);
   v_es_cta_noc VARCHAR2(1);
   v_fec_actual      DATE;
   v_nro_tarjeta     VARCHAR2(16);
   v_mto_min_com     NUMBER := fug_obt_pardinamico('MTO_MIN_POR_ADELANTO');
   v_mto_comision    NUMBER := fug_obt_pardinamico('MTO_COM_ADELANTO');
   v_por_comision    NUMBER := fug_obt_pardinamico('POR_COM_ADELANTO');
   v_comision        NUMBER;
   --v_nro_cta_debito  VARCHAR2(17);
--  Tipos de Mensajes de respuestas
   MSG_OBT_TAR_NE     CONSTANT VARCHAR2(15) := 'OBT_TCR_NE'; /**Nro. tarjeta no encontrado*/
   MSG_TRA_INVALIDA   CONSTANT VARCHAR2(15) := 'TRA_INVALIDA'; /** Transaccion invalida*/
   --MSG_MTOPA_INVALIDO CONSTANT VARCHAR2(15) := 'MTOPA_INVALIDO'; /**Monto pagado invalido*/
   MSG_CTA_CANCELADA  CONSTANT VARCHAR2(15) := 'TAR_CTA_CANCELA';

BEGIN
    --valido la sesión del cliente
     retValidarSesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codCanal);
     IF retValidarSesion.error = 'S' THEN
        v_retorno.error                := retValidarSesion.error;
        v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
        v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
        RETURN v_retorno;
     END IF;
   -- validamos la caja
     v_mensajeCaja := lf_val_caja(retValidarSesion);
     IF v_mensajeCaja.error = 'S' THEN
        v_retorno.error                := v_mensajeCaja.error;
        v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
        RETURN v_retorno;
     END IF;
       -- se verifica que viene de autorizar la operacion
     IF nvl(p_modo, 'x') = 'A' THEN
        IF g_aut_operacion = FALSE THEN
           pr_mensajeUsuario(MSG_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
     ELSE
        v_permiso := lf_obt_permisos(retValidarSesion, v_cod_operacion);
        IF (v_permiso.error = 'S') THEN
           v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
           v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
           v_retorno.error                := v_permiso.error;
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           RETURN v_retorno;
        END IF;

      -- se verifica que tenga permiso para registrar
      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      /*IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
         -- se confirma directamente la operacion, porque no requiere autorizacion
         v_modo := 'A'; -- CONFIRMACION
      END IF;*/
    END IF;

   pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
   pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ENTRADA);

   v_nro_tarjeta     := depurarAlfanumerico(trim(p_nroTarjetaCredito),CUENTA_TAMANO);
   v_nro_cta_credito := depurarAlfanumerico(p_nro_cta_credito,CUENTA_TAMANO);
   v_monto           := p_monto;
   v_plazo           := p_plazo;
   v_modo            := p_modo; -- modo V-validacion o C-confirmacion


  IF v_modo = 'V' THEN
     if p_nroTarjetaCredito is null then
        pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,'Nro de cuenta de crédito no puede ser nulo. '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
        return v_retorno;
     end if;
     if p_monto is null then
        pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,'Monto no puede ser nulo. '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
        return v_retorno;
     end if;
     if p_plazo is null then
        pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,'Plazo no puede ser nulo. '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
        return v_retorno;
     end if;
     -- Se valida si el cliente está habilitado para realizar el adelanto
     v_valAdelanto:= fu_valAdelantoFacil(p_sesion,
                                         p_codCanal,
                                         v_nro_tarjeta,
                                         v_monto,
                                         v_plazo);

     v_retorno.error                := v_valAdelanto.error;
     v_retorno.nombreRespuesta      := v_valAdelanto.nombreRespuesta;
     v_retorno.descripcionRespuesta := v_valAdelanto.descripcionRespuesta;

     end if;
    -- caso especial de control de claves antes de envio a Bancard.
    -- ------------------------------------------------------------
    -- para limite de operaciones, si v_modo es 'V' y clave token no es nula se debe pasar
    -- v_modo <> 'V' a fu_obtenerLimite para que no envie devuelta el challenge OTP
    v_mod_limite := v_modo;
    IF v_mod_limite = 'V' AND (TRIM(p_claveToken) IS NOT NULL OR
                               TRIM(p_claveTransaccional) IS NOT NULL ) THEN
      v_mod_limite := 'C';
    END IF;
    -- se agrega control de límite de operaciones
         IF v_retorno.error = 'N' THEN
           IF v_modo in ('C', 'V', 'A') AND nvl(p_modo,'x') <> 'A' THEN
              v_resLimite := fu_obtenerLimite(retValidarSesion,
                                              v_cod_operacion,
                                              nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                                              v_nro_cta_credito,--v_nro_cta_debito,
                                              'GS',--v_cod_mon_debito,
                                              5154,
                                              5160,--v_cod_tra_padre,
                                              v_monto,
                                              v_mod_limite);

              IF v_resLimite.error = 'S' THEN
                 v_retorno.error := v_resLimite.error;
                 v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
                 v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              END IF;
           END IF;
        END IF;

        -- se validan las claves según respuesta de límites
        IF v_retorno.error = 'N' THEN
          IF nvl(p_modo, 'x') <> 'A' AND v_modo in ('C','A') THEN
            DECLARE
              v_lugar VARCHAR2(50);
            BEGIN
              retError.error := 'N';
              IF v_resLimite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
                 v_lugar  := 'lf_obt_cla_validar - ';
                 retError := lf_obt_cla_validar(p_claveTransaccional, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, 'T');
              END IF;

              IF retError.error = 'N' THEN
                 IF v_resLimite.codRespuesta IN ('01', '11') THEN -- token requerido
                    v_lugar  := 'paw_seg.fu_obt_tok_validar - ';
                    retError := paw_seg.fu_obt_tok_validar(p_claveToken, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, v_modo);
                 END IF;
              END IF;

              IF retError.error = 'S' THEN
                 v_retorno.error := retError.error;
                 v_retorno.nombreRespuesta := retError.nombreRespuesta;
                 v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                 pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_lugar || ' '|| fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 return v_retorno;
              END IF;
            END;
          END IF;
        END IF;

        -- calcular y agregar el monto de la comisión
        IF v_monto > v_mto_min_com THEN
           v_comision := round(v_monto * v_por_comision / 100, 0);
        ELSE
           v_comision := v_mto_comision;
        END IF;

        v_retorno.mtoComAplicada := v_comision;

         IF v_retorno.error = 'N' THEN
            -- no hay problemas hasta aquí
            IF v_modo = 'V' THEN
               v_retorno.resLimite        := v_resLimite.codRespuesta;
               v_retorno.nroOperacion     := null;
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'resLim: ' || v_resLimite.codRespuesta || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);

               RETURN v_retorno;

            ELSIF v_modo = 'C' THEN
              -- 0. Obtengo el nro de cuenta de la tarjeta
                 --v_msg_error := MSG_OBT_TAR_NE;
                 BEGIN
                    SELECT a.nro_cuenta, c.cod_modalidad , c.cod_oficina, b.fec_vencimiento
                      INTO v_nro_cta_tarjeta, v_cod_modalidad , v_cod_oficina, v_tar_fec_venc
                      FROM ge_cta_clientes a, ta_tarjetas b, ge_cuentas c
                     WHERE b.nro_tarjeta = v_nro_tarjeta
                       AND b.nro_cuenta = a.nro_cuenta
                       AND a.nro_cuenta = c.nro_cuenta
                       AND b.nro_cuenta = c.nro_cuenta
                       AND a.cod_persona = retValidarSesion.codigoPersona;

                       v_retorno.tarfecvencimiento := v_tar_fec_venc;
                 EXCEPTION
                    WHEN no_data_found THEN
                       pr_mensajeUsuario(MSG_OBT_TAR_NE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(retValidarSesion.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                       RETURN v_retorno;
                 END;

               -- 2. busco los datos de la cuentas
               BEGIN
                  pag_cta.pr_obt_cuenta(PAT_IMP.FU_OBT_NRO_CUENTA(v_nro_tarjeta)); -- JIRA-1717
                  IF pag_cta.G_COD_ERROR <> 0 THEN
                     pr_mensajeUsuario(MSG_OBT_TAR_NE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;
                  IF pag_cta.g_ctas.estado NOT IN ('B','N') THEN -- JIRA-1717
                     pr_mensajeUsuario(MSG_CTA_CANCELADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                     RETURN v_retorno;
                  END IF;
               EXCEPTION
                  WHEN no_data_found THEN
                     pr_mensajeUsuario(MSG_OBT_TAR_NE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, p_codcanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                     RETURN v_retorno;
               END;

               -- registro del movimiento

               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, ' autReq: ' || v_can_aut_requeridas || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);

               -- confirmacion de operacion
               -- seteo las variables
               v_nro_secuencia := 0;
               pag_cta.PR_SET_VARIABLES(v_mensajeCaja.codigoUsuario, v_fec_valor, v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL, v_mensajeCaja.codigoOficinaOrigen, 9, 91);
               -- esta la cuenta en condiciones, verifico el horario
               -- lp_ver_horario;
               retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre,
                                           -- IN
                                          v_mensajeCaja.codigoOficinaOrigen,
                                           -- IN
                                          v_fec_actual);

               if retError.error = 'S' then
                  v_retorno.error := retError.error;
                  v_retorno.nombreRespuesta := retError.nombreRespuesta;
                  v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'lp_ver_horario - ' || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  return v_retorno;
               end if;

              begin
               -- genero el numero de operacion
               SELECT s_nro_ope_homebanking.NEXTVAL
                 INTO v_nro_operacion
                 FROM dual;
                  -- registro del movimiento
                     prt_tar_adelanto(retValidarSesion.codigoPersona,
                                      v_nro_cta_tarjeta, --nro de cuenta de la tarjeta crédito
                                      'GS',
                                      v_nro_tarjeta,--nro de la tarjeta crédito
                                      v_cod_modalidad,
                                      v_cod_oficina,
                                      v_monto,
                                      v_nro_operacion,--p_nro_autorizacion,
                                      v_nro_cta_credito,
                                      'GS',
                                      v_mensajeCaja.codigoUsuario,
                                      v_plazo,
                                      'N',
                                       p_codCanal);

                     v_retorno.nroOperacion := v_nro_operacion;

                     -- Registro del movimiento
                  pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Se guardó el correctamente el movimiento. ' || ', ERR: ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);

  /*LA 29/12/2014. Se agrega el registro de Adelanto Fácil en la tabla bw_movimientos, Mirar REQ. DE-26*/
  --INICIO - Registro del movimiento en homebanking
    BEGIN
        IF v_retorno.nombreRespuesta = 'OP_APROBADA' THEN
            lp_reg_operacion(v_nro_cta_tarjeta,
                             v_cod_mon_local,
                             v_monto,
                             v_nro_cta_credito,
                             null,
                             null,
                             null,
                             null,
                             null,
                             'Adelanto facil',
                             null,
                             '000',
                             retValidarSesion.codigoPersona,
                             v_cod_operacion,
                             v_nro_operacion,
                             p_codCanal,
                             p_sesion,
                             retValidarSesion.codigoEmpresa);
             pr_insertarBitacora(retValidarSesion.codigoPersona,
                                  p_codCanal,
                                  p_sesion,
                                  v_cod_operacion,
                                  retValidarSesion.codigoEmpresa,
                                  fu_generarbitacora(v_retorno.error,
                                                     v_retorno.nombreRespuesta,
                                                     v_retorno.descripcionRespuesta,
                                                     null),
                                  BITACORA_SALIDA);
      END IF;
    END;
    --FIN - Registro del movimiento en homebanking
                  return v_retorno;
                EXCEPTION
                    WHEN others THEN
                  -- hubo error en el registro del movimiento
                  pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'No se guardó el movimiento. ' || ', ERR: ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  return v_retorno;
                  end;
               END IF;
            END IF;

   RETURN v_retorno;
EXCEPTION
   WHEN OTHERS THEN
      pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa,  'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      RETURN v_retorno;
END;
-- fin validacion o confirmacion de adelantos

FUNCTION fu_obtTasasAdelanto RETURN typ_datostasas IS
   v_codCanal         VARCHAR2(3) := '999';
   v_retorno          typ_datosTasas := typ_datosTasas;
   --v_cod_aux          VARCHAR2(3);
   --v_descripcion      VARCHAR2(35);
   v_listaDatosTasas typ_listaTasasAdelanto := typ_listaTasasAdelanto();
   v_tip_mensaje      VARCHAR2(3) := '011';
   v_retMenRespuesta  typ_mensajeRespuesta := typ_mensajeRespuesta;
   v_detalle          typ_detalleTasasAdelanto := typ_detalleTasasAdelanto;
   v_can_detalles     NUMBER(3) := 0;
   v_mto_min_com      NUMBER := fug_obt_pardinamico('MTO_MIN_POR_ADELANTO');
   v_mto_comision     NUMBER := fug_obt_pardinamico('MTO_COM_ADELANTO');
   v_por_comision     NUMBER := fug_obt_pardinamico('POR_COM_ADELANTO');

   --Errores
   MSG_SINDATOS CONSTANT VARCHAR2(15) := 'G_SIN_DATOS';

   FUNCTION lf_obt_tasas RETURN typ_datostasas IS
      v_ret typ_datostasas := typ_datostasas;
      CURSOR tasas_cur IS
         SELECT val_minimo, val_maximo, abreviatura
           FROM BA_COD_REFERENCIAS
          WHERE DOMINIO = 'POR_FIN_CRE_TARJETA'
       ORDER BY ABREVIATURA, VAL_MAXIMO;
   BEGIN
      -- se agregan los valores de los parámetros dinámicos
      v_ret.mtoComision    := v_mto_comision;
      v_ret.mtoLimComision := v_mto_min_com;
      v_ret.porComision    := v_por_comision;

      FOR t IN tasas_cur
      LOOP
         BEGIN
            v_can_detalles            := v_can_detalles + 1;
            --v_cod_aux                 := t.codigo;
            --v_descripcion             := t.descripcion;
            v_detalle.valminimo       := t.val_minimo;
            v_detalle.valmaximo       := t.val_maximo;
            v_detalle.abreviatura     := t.abreviatura;
            v_listaDatosTasas.EXTEND;
            v_listaDatosTasas(v_listaDatosTasas.COUNT) := v_detalle;
         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_SINDATOS, v_ret.nombreRespuesta, v_ret.descripcionRespuesta, v_ret.error);
               v_retMenRespuesta.error                := v_ret.error;
               v_retMenRespuesta.nombreRespuesta      := v_ret.nombreRespuesta;
               v_retMenRespuesta.descripcionRespuesta := v_ret.descripcionRespuesta;
               pr_insertarBitacora('0',
                                   v_codCanal,
                                   NULL,
                                   v_tip_mensaje,
                                   NULL,
                                   SQLERRM || 'Obtener Tasas Adelanto: ' || fu_generarBitacora(v_retMenRespuesta.error,
                                                                                       v_retMenRespuesta.nombreRespuesta,
                                                                                       v_retMenRespuesta.descripcionRespuesta,
                                                                                       null),
                                   BITACORA_ERROR);
               RETURN v_ret;
         END;
      END LOOP;
      v_ret.cantDatos          := v_can_detalles;
      v_ret.listaDatosTasas  := v_listaDatosTasas;
      RETURN v_ret;
   END;
BEGIN
   v_retorno := lf_obt_tasas;
   IF v_retorno.cantDatos = 0 OR v_retorno.cantDatos IS NULL THEN
      pr_mensajeUsuario(MSG_SINDATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
   ELSE
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
   END IF;

   v_retMenRespuesta.error                := v_retorno.error;
   v_retMenRespuesta.nombreRespuesta      := v_retorno.nombreRespuesta;
   v_retMenRespuesta.descripcionRespuesta := v_retorno.descripcionRespuesta;
   pr_insertarBitacora('0',
                       v_codCanal,
                       NULL,
                       v_tip_mensaje,
                       NULL,
                       'Obtener Tasas: ' ||
                       fu_generarBitacora(v_retMenRespuesta.error, v_retMenRespuesta.nombreRespuesta, v_retMenRespuesta.descripcionRespuesta, null),
                       BITACORA_ENTRADA);
   RETURN v_retorno;
EXCEPTION
   WHEN OTHERS THEN
      pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_retMenRespuesta.error                := v_retorno.error;
      v_retMenRespuesta.nombreRespuesta      := v_retorno.nombreRespuesta;
      v_retMenRespuesta.descripcionRespuesta := v_retorno.descripcionRespuesta;
      pr_insertarBitacora('0',
                          v_codCanal,
                          NULL,
                          v_tip_mensaje,
                          NULL,
                          SQLERRM || 'Obtener Tasas ' ||
                          fu_generarBitacora(v_retMenRespuesta.error, v_retMenRespuesta.nombreRespuesta, v_retMenRespuesta.descripcionRespuesta, null),
                          BITACORA_ERROR);
      RETURN v_retorno;
END;

   -- Pagos a la SET
   FUNCTION fu_pagoSet(p_sesion              IN VARCHAR2,
                       p_codigoCanal         IN VARCHAR2,
                       p_modo                IN VARCHAR2,
                       p_cuentaDebito        IN VARCHAR2,
                       p_numeroTransaccion   IN VARCHAR2,
                       p_xml_boleta          IN VARCHAR2,
                       p_claveTransaccional  IN VARCHAR2,
                       p_claveToken          IN VARCHAR2) RETURN typ_pagoServiciosWs IS
      -- errores
      SET_ERR_DAT_INVALIDO      CONSTANT VARCHAR2(15) := 'SET_DAT_INVALID';
      SET_CTA_DEB_INVALIDA      CONSTANT VARCHAR2(15) := 'SET_CTA_DEB_INV';
      SET_CRE_DEB_IGUAL         CONSTANT VARCHAR2(15) := 'SET_CRE_DEB_IGU';
      SET_CTA_CRE_INEXISTENTE   CONSTANT VARCHAR2(15) := 'SET_CTA_CRE_INE';
      SET_CTA_CRE_DUPLICADA     CONSTANT VARCHAR2(15) := 'SET_CTA_CRE_DUP';
      SET_CTA_CRE_INVALIDA      CONSTANT VARCHAR2(15) := 'SET_CTA_CRE_INV';
      SET_MTO_INVALIDO          CONSTANT VARCHAR2(15) := 'SET_MTO_INVALID';
      SET_EST_CTA_CRE_INVALIDA  CONSTANT VARCHAR2(15) := 'SET_EST_CRE_INV';
      SET_CTA_CRE_PROHIBIDA     CONSTANT VARCHAR2(15) := 'SET_CTA_CRE_PRO';
      SET_COD_MON_INVALIDA      CONSTANT VARCHAR2(15) := 'SET_COD_MON_INV';
      SET_CTA_CRE_VER_OPERACION CONSTANT VARCHAR2(15) := 'SET_CRE_VER_OPE';
      SET_COD_SER_INEXISTENTE   CONSTANT VARCHAR2(15) := 'SET_COD_SER_INE';
      SET_TOT_MTO_INVALIDO      CONSTANT VARCHAR2(15) := 'SET_TOT_MTO_INV';
      SET_PAG_PENDIENTE         CONSTANT VARCHAR2(15) := 'SET_PAG_PENDIEN';
      SET_ERR_CREDITO           CONSTANT VARCHAR2(15) := 'SET_ERR_CREDITO';
      SET_ERR_DEBITO            CONSTANT VARCHAR2(15) := 'SET_ERR_DEBITO';
      SET_TRA_INVALIDA          CONSTANT VARCHAR2(15) := 'SET_TRA_INVALID';
      SET_SIN_PERMISO           CONSTANT VARCHAR2(15) := 'SET_SIN_PERMISO';
      SET_PAG_DUPLICADO         CONSTANT VARCHAR2(15) := 'SET_PAG_DUPLICA';

      -- Datos Recibidos del HB
      v_nro_cta_debito  VARCHAR2(16); -- nro de cuenta de debito
      v_monto           NUMBER(18, 2); -- monto a transferir
      v_modo            VARCHAR2(1); -- modo V-validacion o C-confirmacion
      v_descripcion     VARCHAR2(100);
      v_lugar           VARCHAR2(100);
      -- Variables
      v_cta_for_debito  VARCHAR2(17); -- Cuenta Debito formateada
      v_cod_mon_debito  ge_cuentas.cod_moneda%TYPE; -- Moneda de la cuenta
      v_cod_mod_debito  ge_cuentas.cod_modulo%TYPE; -- Modulo de la cuenta
      v_cod_mad_debito  ge_cuentas.cod_modalidad%TYPE; -- Modalidad de la cuenta
      v_cod_ofi_debito  ge_cuentas.cod_oficina%TYPE; -- Oficina de la cuenta
      v_nom_cta_debito  ge_cuentas.denominacion%TYPE; -- Nombre de la cuenta
      v_nro_cta_credito ge_cuentas.nro_cuenta%TYPE := NULL; -- Numero de Cuenta Credito
      v_cod_mon_credito ge_cuentas.cod_moneda%TYPE; -- Moneda de la cuenta
      v_est_cta_credito ge_cuentas.estado%TYPE; -- Estado de la cuenta
      v_cod_mod_credito ge_cuentas.cod_modulo%TYPE; -- Modulo de la cuenta
      v_cod_mad_credito ge_cuentas.cod_modalidad%TYPE; -- Modalidad de la cuenta
      v_cod_ofi_credito ge_cuentas.cod_oficina%TYPE; -- Oficina de la cuenta
      v_nvo_est_credito ge_cuentas.estado%TYPE := NULL; -- cambio de estado de cuenta
      v_concepto        ge_movimientos.concepto%TYPE := NULL;
      v_aut_pendientes  bw_mov_pendientes.can_aut_faltantes%TYPE;
      v_numero_ot       ge_set_pagos.nro_orden%TYPE;
      v_sal_dis_credito NUMBER(18, 2);
      --Para Distintas monedas No habilitado todavia
      v_mto_credito     NUMBER(18, 2);
      v_procesa         VARCHAR2(1) := 'N'; -- indica si se puede o no procesar
      -- Cobro de servicios
      v_nro_ope_cxs     ge_cob_servicios.nro_operacion%TYPE;
      v_cod_servicio    NUMBER(3); -- Cod del Servicicio
      v_cod_tra_padre   ge_cob_ser_parametros.cod_transaccion%TYPE; -- Cod. transaccion padre
      v_ruc             VARCHAR2(16);
      v_nro_documento   NUMBER(15);
      -- Campos de la boleta
      v_nro_boleta      NUMBER(13);
      v_fec_boleta      DATE;
      v_can_det_impuesto NUMBER(3);
      v_tot_monto       NUMBER(18, 2) := 0;
      v_retorno         typ_pagoserviciosws := typ_pagoserviciosws();
      v_res_limite      typ_respuestaLimite;
      v_cod_operacion   VARCHAR2(3) := '034';
      v_existe          VARCHAR2(1);
      v_usuario         typ_validarSesion;
      v_error           typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_men_caja        typ_mensajeCaja;
      v_permiso         typ_obtenerPermisos;
      v_impuesto        typ_impuesto := typ_impuesto();
      v_lis_impuesto    typ_listaImpuestos := typ_listaImpuestos();
      v_xml             xmltype;
      v_horario         VARCHAR2(1);
      v_es_mov_noc      VARCHAR2(1);
      v_es_cta_noc      VARCHAR2(1);
      v_fec_actual      DATE;
      v_hor_actual      VARCHAR2(8) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
      v_msj_bitacora    VARCHAR2(800);
      v_raz_social      VARCHAR2(60);
      v_dig_verificador ge_set_pagos.dig_verificador%TYPE;
      v_observacion     bw_movimientos.observacion%TYPE;
      v_nro_secuencia   NUMBER;
      v_consecutivo     ge_set_pagos.nro_consecutivo%TYPE;
      v_fec_documento   ge_set_pagos.fec_documento%TYPE;
      v_cod_token       bw_pag_servicios.cod_ws_servicios%TYPE;
      v_nro_transaccion bw_pag_servicios.nro_transaccion%TYPE;
      rg_gspag          ge_set_pagos%ROWTYPE;
      rg_bpser          bw_pag_servicios%ROWTYPE;
      v_act_pen         BOOLEAN := FALSE;
      v_afectados       NUMBER;
      v_estado bw_mov_pendientes.estado%TYPE;
      v_cod_canal       ge_canales.cod_canal%type; -- DDEVOLUT-86 -- 04/2017 --
   BEGIN
      -- valido la sesión del cliente
      v_usuario := fu_validarSesion(p_sesion, p_codigoCanal);

      IF v_usuario.error = 'S' THEN
         v_retorno.error                := v_usuario.error;
         v_retorno.nombreRespuesta      := v_usuario.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usuario.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- valido la caja
      v_men_caja := lf_val_caja(v_usuario);
      IF v_men_caja.error = 'S' THEN
         v_retorno.error                := v_men_caja.error;
         v_retorno.nombreRespuesta      := v_men_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_men_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- obtengo los parametros recibidos
      v_nro_cta_debito  := depurarAlfanumerico(p_cuentaDebito, 16);
      v_modo            := substr(p_modo, 1, 1);
      v_nro_transaccion := depurarAlfanumerico(p_numeroTransaccion, 32);
      v_msj_bitacora := 'cta.deb: ' || v_nro_cta_debito || ', modo: ' || v_modo;

      -- parseo el xml
      v_xml             := xmltype.createxml(p_xml_boleta);

      IF v_modo <> 'G' THEN
         v_ruc             := substr(TRIM(v_xml.extract('/SET/Consulta/Deuda/ruc/text()').getStringVal()), 1, 15);
         v_dig_verificador := v_xml.extract('/SET/Consulta/Deuda/dv/text()').getNumberVal();
         v_raz_social      := substr(TRIM(v_xml.extract('/SET/Consulta/Deuda/nombreRazonSocial/text()').getStringVal()), 1, 60);
         v_nro_boleta      := v_xml.extract('/SET/Consulta/Deuda/Boleta/numero/text()').getNumberVal();
         v_monto           := v_xml.extract('/SET/Consulta/Deuda/Boleta/total_a_pagar/text()').getNumberVal();
         v_fec_boleta      := to_date(v_xml.extract('/SET/Consulta/Deuda/Boleta/fecha/text()').getStringVal(), 'dd/mm/yyyy');
      ELSE
         v_ruc             := substr(TRIM(v_xml.extract('/SET/Pago/ruc/text()').getStringVal()), 1, 15);
         v_dig_verificador := v_xml.extract('/SET/Pago/dv/text()').getNumberVal();
         v_nro_boleta      := v_xml.extract('/SET/Pago/numeroDocumento/text()').getNumberVal();
         v_monto           := v_xml.extract('/SET/Pago/valorPagado/text()').getNumberVal();
         v_fec_documento   := to_date(v_xml.extract('/SET/Pago/@fechaDocumento').getStringVal(), 'dd/mm/yyyy');
      END IF;
      IF v_xml.extract('/SET/token/text()') IS NOT NULL THEN
         v_cod_token := v_xml.extract('/SET/token/text()').getStringVal();
      END IF;
      v_msj_bitacora := v_msj_bitacora || ', totBol: ' || v_monto ||
                        ', ruc: ' || v_ruc ||
                        ', fecBol: ' || v_fec_boleta ||
                        ', dv: ' || v_dig_verificador;

      -- se verifica que viene de autorizar la operacion
      IF nvl(p_modo, 'x') = 'A' THEN
         IF g_aut_operacion = FALSE THEN
            pr_mensajeUsuario(SET_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      ELSE
         v_permiso := lf_obt_permisos(v_usuario, v_cod_operacion);
         IF (v_permiso.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
            v_retorno.error                := v_permiso.error;
            pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- ser verifica que tiene permiso para registrar
         IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
            IF v_permiso.autoriza = FALSE THEN
               pr_mensajeUsuario(SET_SIN_PERMISO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
         END IF;
      END IF;

      IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
         v_modo := 'A';
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- validamos que la cuenta débito pertenezca al cliente
      IF lf_val_cta_origen(v_nro_cta_debito, nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona)) = 'N' THEN
         pr_mensajeUsuario(SET_CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- validamos la moneda debito
      IF v_cod_mon_debito <> v_cod_mon_local THEN
         pr_mensajeUsuario(SET_COD_MON_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF v_modo IN ('V', 'C', 'A') THEN
         v_concepto := 'Boleta: '||v_nro_boleta||', Ruc:'||v_ruc || ', Impuesto(s): ';
         -- recorremos el detalle de impuestos para validar los campos
         FOR c IN (SELECT codigo, descripcion, nro_resolucion, monto, periodo
                     FROM xmltable('/Impuesto' passing (SELECT cells
                                                                 FROM xmltable('/SET/Consulta/Deuda/Boleta' passing v_xml columns CELLS  XMLTYPE PATH './Impuesto')
                                                               )
                                                      columns CODIGO         VARCHAR(5) PATH './codigo',
                                                              DESCRIPCION    VARCHAR(100) PATH './descripcion',
                                                              NRO_RESOLUCION VARCHAR(20) PATH './numero_resolucion',
                                                              MONTO          VARCHAR(19) PATH './monto',
                                                              PERIODO        VARCHAR(10) PATH './periodo'
                                  )
                  )
         LOOP
            v_can_det_impuesto          := v_can_det_impuesto + 1;
            v_impuesto.codigo           := substr(trim(c.codigo), 1, 5);
            v_impuesto.descripcion      := substr(trim(c.descripcion), 1, 100);
            v_impuesto.numeroResolucion := substr(trim(c.nro_resolucion), 1, 20);
            v_impuesto.monto            := to_number(c.monto);
            v_impuesto.periodo          := substr(trim(c.periodo), 1, 10);
            v_tot_monto                 := v_tot_monto + v_impuesto.monto;
            v_concepto                  := substr(v_concepto || c.codigo || '- ', 1, 100);
            v_observacion               := substr(v_observacion || 'Impuesto '||v_can_det_impuesto||': ' || c.codigo || ' - ' || c.descripcion || ' - ' || c.monto || 'Gs.', 1, 1000);
            IF c.periodo IS NOT NULL THEN
               v_observacion := substr(v_observacion || ' - Periodo: ' || c.periodo || chr(10) || chr(13), 1, 1000);
            ELSE
               v_observacion := substr(v_observacion || chr(10) || chr(13), 1, 1000);
            END IF;

            v_lis_impuesto.extend;
            v_lis_impuesto(v_lis_impuesto.count) := v_impuesto;
         END LOOP;
         -- control de montos
         IF v_monto <> v_tot_monto THEN
            v_msj_bitacora := v_msj_bitacora || ', totDet:' || v_tot_monto;
            pr_mensajeUsuario(SET_TOT_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- obtenemos el codigo de serivicio
         -- una boleta contiene impuestos que van siempre a la misma cuenta
         v_msj_bitacora := v_msj_bitacora || ', codImp: ' || v_lis_impuesto(1).codigo || ', codCta: ' || pag_set.fu_obt_cod_cuenta(v_lis_impuesto(1).codigo);
         v_lugar := 'Leyendo el codigo servicio';
         v_cod_servicio := trim(fug_obt_pardinamico('COD_SET_PAGO_' || pag_set.fu_obt_cod_cuenta(v_lis_impuesto(1).codigo)));
         v_msj_bitacora := v_msj_bitacora || ', codSer: ' || v_cod_servicio;
         BEGIN
            -- obtenemos los parametros asociados al servicio
            SELECT nro_cuenta, cod_transaccion, substr(descripcion || '. ' || v_concepto, 1, 100), descripcion
              INTO v_nro_cta_credito, v_cod_tra_padre, v_concepto, v_descripcion
              FROM ge_cob_ser_parametros
             WHERE cod_servicio = v_cod_servicio;

            -- la cta debito no puede ser igual a la cta credito
            IF v_nro_cta_debito = v_nro_cta_credito THEN
               pr_mensajeUsuario(SET_CRE_DEB_IGUAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
            -- verifico la cuenta de credito(La cuenta de la SET)
            IF v_retorno.error = 'N' THEN
               BEGIN
                  SELECT a.cod_moneda, a.estado, cod_modalidad, cod_modulo, cod_oficina
                    INTO v_cod_mon_credito, v_est_cta_credito, v_cod_mad_credito, v_cod_mod_credito, v_cod_ofi_credito
                    FROM ge_cuentas a
                   WHERE a.nro_cuenta = v_nro_cta_credito; -- contiene el nro de cuenta
               EXCEPTION
                  WHEN no_data_found THEN
                     pr_mensajeUsuario(SET_CTA_CRE_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 WHEN too_many_rows THEN
                     pr_mensajeUsuario(SET_CTA_CRE_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 WHEN OTHERS THEN
                     pr_mensajeUsuario(SET_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              END;
            END IF;
            -- La cta de Debito debe ser la misma moneda que la cta de la SET
            IF v_retorno.error = 'N' THEN
               IF v_cod_mon_credito <> v_cod_mon_local THEN
                  pr_mensajeUsuario(SET_COD_MON_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               ELSE
                  v_mto_credito := v_tot_monto;
               END IF;
            END IF;
            -- Validaciones de la Cuenta de Credito
            IF v_retorno.error = 'N' THEN
               IF v_mto_credito <= 0 THEN
                  pr_mensajeUsuario(SET_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               ELSIF v_cod_mad_credito NOT IN (31, 41, 47, 334) THEN
                  pr_mensajeUsuario(SET_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               ELSIF v_est_cta_credito NOT IN ('A', 'I', 'N', 'S') THEN
                  pr_mensajeUsuario(SET_EST_CTA_CRE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               ELSIF pag_cta.fu_ver_tra_prohibida(v_nro_cta_credito, v_cod_tra_padre, 9, 91) = 'S' THEN
                  pr_mensajeUsuario(SET_CTA_CRE_PROHIBIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               ELSE
                  pag_cta.pr_ver_operacion(v_nro_cta_credito, v_cod_tra_padre, 9, 91, 'C', v_cod_mon_credito, v_mto_credito, v_men_caja.codigoOficinaOrigen, v_cod_mod_credito, v_cod_mad_credito, v_nvo_est_credito, v_sal_dis_credito, v_procesa, 602);
                  IF v_procesa = 'N' THEN
                     pr_mensajeUsuario(SET_CTA_CRE_VER_OPERACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  END IF;
               END IF;
            END IF;
         EXCEPTION
            WHEN no_data_found THEN
               pr_mensajeUsuario(SET_COD_SER_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN OTHERS THEN
               pr_mensajeUsuario(SET_ERR_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END;

         -- validamos la cuenta débito
         v_error := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_monto, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, v_usuario, v_men_caja);
         IF v_error.error = 'S' THEN
            v_retorno.error := v_error.error;
            v_retorno.nombreRespuesta := v_error.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
         END IF;

         IF v_retorno.error = 'N' THEN
            -- si no esta pendiente
            BEGIN
               SELECT 'S'
                 INTO v_existe
                 FROM bw_mov_pendientes
                WHERE cod_per_principal = v_usuario.codigoEmpresa
                  --AND nro_cuenta = v_nro_cta_debito
                  AND referencia = v_nro_boleta
                  AND monto = v_monto
                  AND estado = 'P'
                  AND cod_tip_mensaje = v_cod_operacion
                  AND rownum = 1;

               pr_mensajeUsuario(SET_PAG_PENDIENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            EXCEPTION
               WHEN too_many_rows THEN
                  pr_mensajeUsuario(SET_PAG_PENDIENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN OTHERS THEN
                  NULL;
            END;
         END IF;
         -- valido la duplicacion del Pago
         IF v_retorno.error = 'N' THEN
            v_error := fu_ver_transaccion(503, v_cod_tra_padre, v_nro_cta_debito, v_monto, v_men_caja);
            IF v_error.error = 'S' THEN
               v_retorno.error                := v_error.error;
               v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
            END IF;
         END IF;
         -- para que no se pueda pagar boletas conciliadas, pagadas
         -- o pendientes de confirmacion en la SET
         IF v_retorno.error = 'N' THEN
            BEGIN
               SELECT 'S'
                 INTO v_existe
                 FROM ge_set_pagos sp
                WHERE sp.ruc = v_ruc
                  AND sp.nro_boleta = v_nro_boleta
                  AND sp.monto = v_monto
                  AND sp.fec_documento = v_fec_boleta
                  AND (
                         sp.estado IN ('P', 'C') OR
                         (sp.estado = 'E' AND sp.est_respuesta = 'TIMEOUT')
                      )
                  AND rownum = 1;
               v_msj_bitacora := v_msj_bitacora || ', cod_token';
               pr_mensajeUsuario(SET_PAG_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            EXCEPTION
               WHEN OTHERS THEN
                  NULL;
            END;
         END IF;
      END IF;

      IF v_retorno.error = 'N' THEN
         -- controlar estado pendiente, si es E ya se valida en app movil empresa
         v_estado := 'X';
         IF v_can_aut_requeridas > 0 THEN
            DECLARE
               v_dato2  bw_mov_pendientes.dato2%TYPE;
            BEGIN
               SELECT p.can_aut_faltantes, p.estado, p.dato2
                 INTO v_aut_pendientes, v_estado, v_dato2
                 FROM bw_mov_pendientes p
                WHERE p.cod_tip_mensaje = v_cod_operacion
                  AND p.cod_per_principal = v_usuario.codigoEmpresa
                  AND p.dato = v_cod_token
                  AND p.referencia = v_nro_boleta
                  AND trunc(p.fec_insercion) = trunc(sysdate);
                  -- todavia no se debito al cliente, el API roshka invoca en modo C
                  -- antes de avisar a la SET
                  IF v_estado IN ('C', 'E') AND v_dato2 IS NULL AND v_modo = 'C' THEN
                     v_modo := 'A';
                     v_aut_pendientes := 0;
                  END IF;
            EXCEPTION
               WHEN OTHERS THEN
                  v_aut_pendientes := v_can_aut_requeridas;
                  v_estado := 'X';
            END;
         END IF;

         -- control de límites
         IF v_retorno.error = 'N' AND v_estado <> 'E' AND nvl(p_modo, 'x') <> 'A' THEN
            v_res_limite := fu_obtenerLimite(v_usuario,
                                             v_cod_operacion,
                                             nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona),
                                             v_nro_cta_debito,
                                             v_cod_mon_debito,
                                             503,
                                             v_cod_tra_padre,
                                             v_monto,
                                             v_modo);

            IF v_res_limite.error = 'S' THEN
               v_retorno.error := v_res_limite.error;
               v_retorno.nombreRespuesta := v_res_limite.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_res_limite.descripcionRespuesta;
            END IF;
         END IF;
         -- segun informe de fu_obt_limite, solo al confirmar o autorizar la operación
         IF v_retorno.error = 'N' AND v_estado <> 'E' AND nvl(p_modo, 'x') <> 'A' THEN
            v_error.error := 'N';
            IF v_modo <> 'V' THEN
               -- clave transaccional requerida
               IF v_res_limite.codRespuesta IN ('10', '11') THEN
                  v_lugar := 'lf_obt_cla_validar';
                  v_error := lf_obt_cla_validar(p_claveTransaccional, v_usuario.codigoPersona, v_usuario.codigoEmpresa, 'T');
               END IF;
               -- token requerido
               IF v_error.error = 'N' THEN
                  IF v_res_limite.codRespuesta IN ('01', '11') THEN
                     v_lugar := 'paw_seg.fu_obt_tok_validar';
                     v_error := paw_seg.fu_obt_tok_validar(p_claveToken, v_usuario.codigoPersona, v_usuario.codigoEmpresa, v_modo);
                  END IF;
               END IF;
               -- controlamos si hubo error
               IF v_error.error = 'S' THEN
                  v_retorno.error := v_error.error;
                  v_retorno.nombreRespuesta := v_error.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
               END IF;
            END IF;
         END IF;

         -- no hay problemas hasta aquí
         IF v_modo = 'V' THEN -- validación
            v_retorno.respuestaLimite := v_res_limite.codRespuesta;
         ELSIF v_modo = 'C' THEN -- grabación en modo pendiente
            --- inserto el movimiento pendiente de autorización
            SELECT s_nro_documento.NEXTVAL
              INTO v_nro_documento
              FROM dual;

            INSERT INTO bw_mov_pendientes
               (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, etiqueta, dato, etiqueta2,/* dato2,*/ referencia)
            VALUES
               (v_nro_documento, nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito, v_cod_mon_debito, v_descripcion, v_monto, 'P', v_can_aut_requeridas, v_can_aut_requeridas, v_usuario.codigoPersona, 'Sesion Pago', v_cod_token, 'Fecha Boleta', /*v_fec_boleta,*/ v_nro_boleta);

            -- registro del movimiento
            --lp_reg_operacion(v_nro_cta_debito, v_cod_mon_debito, v_monto, NULL, NULL, 'RUC', v_ruc, 'Razon Social', v_raz_social, v_observacion, NULL, '000', v_usuario.codigopersona, v_cod_operacion, v_nro_documento, 0, '000', v_usuario.codigoempresa);

            v_retorno.nroDocumento := v_nro_documento;
            v_retorno.firmasPendientes := v_can_aut_requeridas;
         ELSIF v_modo = 'A' THEN -- confirmación
            --Vino como confirmar y tiene 0 firmas pendientes
            v_numero_ot     := substr(trim(v_xml.extract('/SET/Pago/numeroOt/text()').getStringVal()), 1, 15);--pag_set.fu_generar_ot;
            v_consecutivo   := v_xml.extract('/SET/Pago/@consecutivo').getNumberVal();
            v_fec_documento := to_date(v_xml.extract('/SET/Pago/@fechaDocumento').getStringVal(), 'dd/mm/yyyy');
            --v_cod_ws_serv := paw_bce.fu_enc_md5(v_ruc||v_nro_boleta||v_fec_boleta||to_char(sysdate, 'hh24:mi'));
            --v_retorno.numeroSesion := v_numero_ot;

            -- esta la cuenta en condiciones, verifico el horario
            v_error := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_men_caja.fechaUltimoCierre, v_men_caja.codigoOficinaOrigen, v_fec_actual);
            -- si hubo error, salimos
            IF v_error.error = 'S' THEN
               v_retorno.error                := v_error.error;
               v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
            END IF;

            -- realizamos el debito y credito de la operacion
            -- todavia no se paga en la SET
            IF v_retorno.error = 'N' THEN
               BEGIN
                  v_nro_ope_cxs := fue_obt_sig_secuencia('S_SET_NRO_SEC_PAGO');
                  v_nro_documento := fue_obt_sig_secuencia('S_NRO_OPE_HOMEBANKING');

                  v_nro_secuencia := 0;
                  pag_cta.PR_SET_NRO_DOCUMENTO3(v_nro_ope_cxs);
                  pag_cta.PR_SET_VARIABLES(v_men_caja.codigoUsuario, v_fec_actual, v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL, v_men_caja.codigoOficinaOrigen, 9, 91);

                  -- DDSI-265 -- 02/2018 : Se busca una hora disponible
                  v_hor_actual := fug_obt_hor_disponible(v_fec_actual, v_hor_actual, user, v_es_mov_noc);
                  pag_cta.PR_ACT_OPERACION(v_nro_cta_debito, v_hor_actual, 'D', v_cod_mon_debito, v_monto,
                                           v_cod_tra_padre, 503, v_nro_documento, NULL,
                                           v_men_caja.codigoOficinaOrigen, 9, 91, NULL, NULL,
                                           v_concepto, 'N', v_nro_secuencia, v_fec_actual, NULL, NULL, NULL);

                  IF nvl(pag_cta.g_cod_error, 0) = 0 THEN

                    if (pag_bat.fu_act_sal_bat_estado(2) = 'S') then
                           v_nro_secuencia:= v_nro_secuencia+1;
                           pag_bat.PR_ACT_OPERACION(v_nro_cta_credito,
                                                       v_fec_actual,
                                                       v_hor_actual,
                                                       'C',
                                                       v_cod_mon_credito, --pag_cta.g_ctas.cod_moneda
                                                       v_mto_credito, --v_monto
                                                       v_cod_tra_padre,
                                                       602,
                                                       v_nro_documento,
                                                       null,
                                                       v_men_caja.codigoOficinaOrigen,
                                                       9,
                                                       91,
                                                       NULL, -- codigo tasa
                                                       NULL, -- valor tasa
                                                       v_concepto,
                                                       'N', -- emitir aviso
                                                       v_nro_secuencia,
                                                       v_fec_actual,
                                                       NULL, --codigo banco
                                                       NULL, --codigo causa
                                                       NULL,'N');
                       else
                           pag_cta.PR_ACT_OPERACION(v_nro_cta_credito, v_hor_actual, 'C', v_cod_mon_credito, v_mto_credito,
                                                    v_cod_tra_padre, 602, v_nro_documento, null, v_men_caja.codigoOficinaOrigen, 9, 91,
                                                    NULL, NULL, v_concepto, 'N', v_nro_secuencia, v_fec_actual, NULL, NULL, NULL);
                       end if;

                     IF nvl(pag_cta.g_cod_error, 0) <> 0 THEN
                        -- hubo error en el credito
                        pr_mensajeUsuario(SET_ERR_CREDITO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     ELSE
                        v_act_pen := TRUE;

                        -- registramos el pago de servicios
                        rg_bpser.nro_cuenta       := v_nro_cta_debito;
                        rg_bpser.cod_servicio     := 55;
                        rg_bpser.fecha            := v_fec_actual;
                        rg_bpser.hora             := v_hor_actual;
                        rg_bpser.nro_transaccion  := v_nro_transaccion;
                        rg_bpser.nro_lote         := v_cod_token;
                        rg_bpser.cod_moneda       := v_cod_mon_credito;
                        rg_bpser.mto_transaccion  := v_monto;
                        rg_bpser.mto_debito       := v_monto;
                        rg_bpser.cod_mon_debito   := v_cod_mon_debito;
                        rg_bpser.cod_mon_servicio := 1; -- moneda local
                        rg_bpser.nro_sesion       := substr(p_sesion, 1, 32);
                        rg_bpser.cod_proveedor    := 2;
                        rg_bpser.cod_ws_servicios := v_cod_token;
                        rg_bpser.nro_documento    := v_nro_documento;
                        rg_bpser.reversado        := 'N';

                        INSERT INTO bw_pag_servicios VALUES rg_bpser;

                        -- insertamos el pago, aun pendiente de proceso en la SET
                        rg_gspag.nro_secuencia   := v_nro_ope_cxs;
                        rg_gspag.fec_pago        := v_fec_actual;
                        rg_gspag.fec_documento   := v_fec_documento;
                        rg_gspag.ruc             := v_ruc;
                        rg_gspag.dig_verificador := v_dig_verificador;
                        rg_gspag.hora            := v_hor_actual;
                        rg_gspag.tip_orden       := pag_set.fu_obt_tip_ot(v_lis_impuesto(1).codigo);
                        rg_gspag.nro_operacion   := v_nro_documento;
                        rg_gspag.nro_boleta      := v_nro_boleta;
                        rg_gspag.monto           := v_monto;
                        rg_gspag.nro_cta_debito  := v_nro_cta_debito;
                        IF v_lis_impuesto.count > 1 THEN
                           rg_gspag.nro_impuesto := 0;
                        ELSE
                           rg_gspag.nro_impuesto   := v_lis_impuesto(1).codigo;
                        END IF;
                        rg_gspag.cod_token       := v_cod_token;
                        rg_gspag.nro_resolucion  := v_lis_impuesto(1).numeroResolucion;
                        rg_gspag.periodo         := v_lis_impuesto(1).periodo;
                        rg_gspag.nro_consecutivo := v_consecutivo;
                        rg_gspag.nro_orden       := v_numero_ot;
                        rg_gspag.estado          := 'N';
                        -- DDEVOLUT-86 -- 04/2017 --
                        SELECT decode( p_codigoCanal, 994, 30, -- mobile
                                       29 ) -- web
                          INTO v_cod_canal
                          FROM DUAL;
                        rg_gspag.cod_canal := v_cod_canal;
                        --
                        BEGIN
                           INSERT INTO ge_set_pagos VALUES rg_gspag;

                           -- registramos el movimiento
                           lp_reg_operacion(v_nro_cta_debito, v_cod_mon_debito, v_monto, v_nro_cta_credito, NULL, 'RUC', v_ruc, 'Boleta', v_nro_boleta, 'Razon Social ' || v_raz_social, NULL, '000', v_usuario.codigoPersona, v_cod_operacion, v_nro_documento, p_codigoCanal, p_sesion, v_usuario.codigoEmpresa);
                        EXCEPTION
                           WHEN DUP_VAL_ON_INDEX THEN
                              v_afectados := 0;
                              v_msj_bitacora := v_msj_bitacora || ', dup_val_on_index';
                              -- si reintenta autorizar una boleta previa con error
                              IF v_usuario.codigoEmpresa IS NOT NULL THEN
                                 UPDATE ge_set_pagos p
                                    SET p.estado = 'N', p.cant_renvio = nvl(p.cant_renvio, 0) + 1
                                  WHERE p.ruc = v_ruc
                                    AND p.nro_boleta = v_nro_boleta
                                    AND p.cod_token = v_cod_token
                                    AND p.estado = 'E'
                                    AND p.est_respuesta <> 'TIMEOUT'
                                    AND TRUNC(p.fec_insercion) = trunc(SYSDATE);
                                 v_afectados := SQL%ROWCOUNT;
                              END IF;
                              v_msj_bitacora := v_msj_bitacora || '(' || v_afectados || ')';
                              IF v_afectados = 0 THEN
                                 pr_mensajeUsuario(SET_PAG_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                              END IF;
                           WHEN OTHERS THEN
                              pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                              v_msj_bitacora := v_msj_bitacora || ', ora-err: [' || substr(sqlerrm, 1, 200) || ']';
                        END;
                     END IF;
                  ELSE
                     -- hubo error en el debito
                     pr_mensajeUsuario(SET_ERR_DEBITO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  END IF;
                  pag_cta.PR_SET_NRO_DOCUMENTO3(NULL);
                  v_retorno.nroDocumento := v_nro_documento;
               EXCEPTION
                  WHEN OTHERS THEN
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     v_msj_bitacora := v_msj_bitacora || ', ORA-ERR: [' || substr(sqlerrm, 1, 250) || '] ';
               END;
            END IF;
            -- Si el crédito y el débito fueron relizados, envío a la SET
         ELSIF v_modo = 'G' THEN
            -- El Api roshka proceso en la SET, actualizamos el pago
            IF v_aut_pendientes > 0 then -- para controlar que solo una vez se actualice
               pr_mensajeusuario(SET_SIN_PERMISO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            ELSE
               pag_set.pr_act_estado(v_ruc, v_nro_boleta, v_fec_documento, 'P', v_xml);
            END IF;
         ELSE
            -- No es del tipo V-validación ni C-confirmación
            pr_mensajeUsuario(SET_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END IF;
      END IF;

      IF v_retorno.error = 'S' THEN
         -- volvemos a dejar pendiente la operacion para empresas por error
         IF v_modo IN ('C', 'A') AND v_usuario.codigoEmpresa IS NOT NULL THEN
            paw_can.pr_act_pendiente(v_usuario.codigoPersona, v_usuario.codigoEmpresa, v_cod_operacion, v_cod_token);
         END IF;
         pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
      ELSE
         IF v_act_pen = TRUE THEN
            IF v_usuario.codigoEmpresa IS NOT NULL THEN
               -- para que se pueda invocar en modo G
               UPDATE bw_mov_pendientes p
                  SET p.dato2 = v_fec_boleta
                WHERE p.cod_per_principal = v_usuario.codigoEmpresa
                  AND p.cod_tip_mensaje = v_cod_operacion
                  AND p.estado IN ('C', 'E')
                  AND p.dato = v_cod_token
                  AND p.referencia = v_nro_boleta
                  AND trunc(p.fec_insercion) = trunc(sysdate);
            END IF;
         END IF;
         pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_SALIDA);
      END IF;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, substr(v_msj_bitacora || ' En: ' || v_lugar || ' Msg: '|| SQLERRM, 1, 1000), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   -- function utilizada por el API para actualizar el estado del reenvio
   -- de pagos de servicios con reintentos
   FUNCTION fu_pagoServicioWsActualizar(p_xml IN VARCHAR2) RETURN NUMBER IS
      v_xml              xmltype;
      v_retorno          NUMBER;
      v_token            bw_pag_servicios.cod_ws_servicios%type;
      v_nro_transaccion  bw_pag_servicios.nro_transaccion%type;
      v_nro_lote         bw_pag_servicios.nro_lote%type;
      v_terminal         bw_pag_servicios.terminal%type;
      v_nro_cta_debito   bw_pag_servicios.nro_cuenta%type;
      v_ip_usuario       bw_pag_servicios.ip_usuario%type;
      v_cod_servicio     bw_pag_servicios.cod_servicio%type;
      v_cod_mon_servicio bw_pag_servicios.cod_mon_servicio%type;
      v_fecha            bw_pag_servicios.fecha%type;
      v_cod_proveedor    bw_pag_servicios.cod_proveedor%type;
      v_api_key          ge_par_dinamicos.val_parametro%TYPE;
      v_usuario          typ_validarSesion;
      v_men_caja         typ_mensajeCaja;
      v_msj_bitacora  VARCHAR2(400) := 'WsUpdate - ';
      v_cod_operacion VARCHAR2(3) := '088';
      v_sesion        VARCHAR2(32);
      v_codCanal      bw_movimientos.nro_caja%type;
      v_ticket        VARCHAR2(2000) DEFAULT NULL;
      v_comision      NUMBER(18,2);
      v_concepto      VARCHAR2(60) DEFAULT NULL;
      v_dir_correo    VARCHAR2(100);
      v_mto_debito    bw_pag_servicios.mto_debito%type;
      v_cod_per_debito ba_personas.cod_persona%Type := null;
      v_result        NUMBER;
      v_cabecera   VARCHAR2(2000)  := NULL;
      v_detalle    VARCHAR2(3300) := NULL;
      v_pie        VARCHAR2(500)  := NULL;
      v_tag        VARCHAR2(50);
      v_nombre     VARCHAR2(100);
      v_empresa    bw_pag_servicios.cod_empresa%type;
      v_texto      VARCHAR2(2000);
      -- cambios para servicios criticos
      v_operacion VARCHAR2(3) := NULL;
      v_abre_oper ba_cod_referencias.abreviatura%TYPE := NULL;
      v_tag_lim   VARCHAR(20) := NULL;
      v_nomCanal  VARCHAR2(100) := NULL;
   BEGIN
      SELECT a.cod_persona
        INTO v_usuario.codigoPersona
        FROM ge_par_generales a
       WHERE rownum = 1;
      v_usuario.codigoEmpresa := NULL;
      v_usuario.error := 'N';
      v_sesion  := 'xxxxxxxxxx';
      v_xml := xmltype.createxml(p_xml);

      IF v_xml.extract('/PORTADORA/paymentSupplier/text()') IS NOT NULL THEN
         v_api_key := TRIM(v_xml.extract('/PORTADORA/apiKey/text()').getStringVal());
         IF v_api_key <> 'N' THEN
         IF pag_set.fu_val_api(v_api_key) = 'N' THEN
            raise_application_error(-20000, 'Apikey invalido - Servicio');
           END IF;
         END IF;
         --Token
         IF v_xml.extract('/PORTADORA/token/text()') IS NOT NULL THEN
         v_token   := TRIM(substr(v_xml.extract('/PORTADORA/token/text()').getStringVal(), 1, 100));
         END IF;
         --Nro Transaccion
         IF v_xml.extract('/PORTADORA/transactionNumber/text()') IS NOT NULL THEN
         v_nro_transaccion := paw_bel.depurarAlfanumerico(v_xml.extract('/PORTADORA/transactionNumber/text()').getStringVal(), 250);
         END IF;
         --Nro Lote
         IF v_xml.extract('/PORTADORA/lotNumber/text()') IS NOT NULL THEN
         v_nro_lote := paw_bel.depurarAlfanumerico(v_xml.extract('/PORTADORA/lotNumber/text()').getStringVal(), 250);
         END IF;
         --Terminal
         IF v_xml.extract('/PORTADORA/terminal/text()') IS NOT NULL THEN
         v_terminal := paw_bel.depurarAlfanumerico(v_xml.extract('/PORTADORA/terminal/text()').getStringVal(), 25);
         END IF;
         --Cuenta Debito
         IF v_xml.extract('/PORTADORA/debitAccountNumber/text()') IS NOT NULL THEN
         v_nro_cta_debito := paw_bel.depurarAlfanumerico(v_xml.extract('/PORTADORA/debitAccountNumber/text()').getStringVal(),  15);
         END IF;
         --IP Usuario
         IF v_xml.extract('/PORTADORA/ipNumber/text()') IS NOT NULL THEN
         v_ip_usuario := depurarTextos(v_xml.extract('/PORTADORA/ipNumber/text()').getStringVal(), 20);
         END IF;
         --Cod Servicio
         IF v_xml.extract('/PORTADORA/service/text()') IS NOT NULL THEN
         v_cod_servicio := v_xml.extract('/PORTADORA/service/text()').getNumberVal();
         END IF;
         --Moneda Servicio
         IF v_xml.extract('/PORTADORA/currencyCode/text()') IS NOT NULL THEN
         v_cod_mon_servicio := v_xml.extract('/PORTADORA/currencyCode/text()').getNumberVal();
         END IF;
         --Fecha
         IF v_xml.extract('/PORTADORA/date/text()') IS NOT NULL THEN
         v_fecha := to_date(v_xml.extract('/PORTADORA/date/text()').getStringVal(), 'yyyy-mm-dd');
         END IF;
         --Cod Proveedor
         IF v_xml.extract('/PORTADORA/paymentSupplier/text()') IS NOT NULL THEN
         v_cod_proveedor := v_xml.extract('/PORTADORA/paymentSupplier/text()').getNumberVal();
         END IF;
         --Comision
         IF v_xml.extract('/PORTADORA/commissionAmount/text()') IS NOT NULL THEN
         v_comision := v_xml.extract('/PORTADORA/commissionAmount/text()').getNumberVal();
         END IF;
         /*Ticket con saltos de linea en html (chr(10) a <br />)*/
         IF v_xml.extract('/PORTADORA/ticket/text()') IS NOT NULL THEN
         v_ticket :=  SUBSTR(REGEXP_REPLACE(TRIM(v_xml.extract('/PORTADORA/ticket/text()').getStringVal()), chr(13) || chr(10), '<br>'), 1, 2000);
         END IF;
         --Concepto
         IF v_xml.extract('/PORTADORA/concepto/text()') IS NOT NULL THEN
         v_concepto := v_xml.extract('/PORTADORA/concepto/text()').getStringVal();
         END IF;
         v_msj_bitacora := substr(v_msj_bitacora || 'tok: ' || v_token ||', lote:'||v_nro_lote
                                          ||', nroTra:'||v_nro_transaccion||', fec:'||v_fecha
                                          ||', ctaDeb:'||v_nro_cta_debito||', codMonSer:'||v_cod_mon_servicio ||' comision: ' || v_comision ,  1, 400);
        IF v_api_key <> 'N' THEN
        -- ajustes para limites de servicios criticos
        v_abre_oper := paw_uti.fu_obt_abr_refcodes('SERVICIOS_CRITICOS',
                                                   to_char(v_cod_servicio),
                                                   to_char(v_cod_proveedor));

        IF v_abre_oper = to_char(v_cod_servicio) THEN
           v_operacion := '091';
           v_tag_lim   := 'COD_WS_CRI:'; -- para diferenciar limites en los movimientos
        ELSE
           v_operacion := '088';
           v_tag_lim   := 'COD_WS:';
        END IF;
        v_concepto := '-' || v_tag_lim || v_concepto;
         UPDATE bw_pag_servicios s
            SET s.nro_transaccion = v_nro_transaccion,
                s.nro_lote = v_nro_lote,
                s.terminal = v_terminal,
                s.ip_usuario = v_ip_usuario,
                s.mto_comision = v_comision,
                s.ticket = v_ticket,
                s.ser_concepto = v_concepto
          WHERE s.cod_ws_servicios = v_token
            --AND s.fecha = v_fecha
            AND s.cod_mon_servicio = v_cod_mon_servicio
            AND s.nro_cuenta = v_nro_cta_debito
            AND s.cod_proveedor = v_cod_proveedor
            AND s.cod_servicio = v_cod_servicio
            AND s.reversado = 'N';

         IF SQL%ROWCOUNT = 1 THEN
            lp_act_movimiento(v_token, v_nro_lote, v_nro_transaccion, v_cod_servicio, v_nro_cta_debito, v_men_caja);
            IF SQL%ROWCOUNT > 2 THEN
               raise_application_error(-20000, v_msj_bitacora || 'lp_act_movimiento (' ||SQL%ROWCOUNT||')');
            END IF;

            v_retorno := SQL%ROWCOUNT + 1; -- tres filas en total se deberian de actualizar
         ELSE
            raise_application_error(-20000, v_msj_bitacora ||', codSer:'||v_cod_servicio
                                               ||', codPro:'||v_cod_proveedor ||', bw_pag_servicios (' ||SQL%ROWCOUNT||')');
         END IF;
         END IF;
        IF v_api_key = 'N' THEN
         --obtengo el cliente principal
           v_cod_per_debito := fug_obt_cli_principal(v_nro_cta_debito);
         --obtenemos el nombre del cliente
           v_nombre :=  fue_obt_nom_persona(fug_obt_cli_principal(v_nro_cta_debito));
         --obtengo email del cliente
          BEGIN
           v_dir_correo := paw_seg.fu_obt_mail(fug_obt_cli_principal(v_nro_cta_debito));
          EXCEPTION
            when others then
              v_dir_correo := null;
          END;
          BEGIN
          select a.mto_debito, a.cod_empresa
            into v_mto_debito, v_empresa
            from BW_PAG_SERVICIOS a
           where a.nro_cuenta = v_nro_cta_debito
             and a.cod_ws_servicios = v_token
             and a.reversado = 'N'
             and a.cod_proveedor = v_cod_proveedor
             and a.cod_servicio = v_cod_servicio;
          EXCEPTION
            when others then
              v_mto_debito := null;
          END;
         --obtenemos el canal
          BEGIN
            select a.nro_caja
              into v_codCanal
              from bw_movimientos a
             where a.nro_cuenta = v_nro_cta_debito
               and a.dato2 = v_token
               and a.monto = v_mto_debito
               and trunc(a.fec_insercion)= trunc(sysdate);
            EXCEPTION
              when others then
               null;
            END;
           IF v_codCanal = 999 THEN
             v_nomCanal := 'Home Banking';
             ELSE
             v_nomCanal := 'Aplicaci&oacute;n M&oacute;vil';
           END IF;
         if v_empresa is null then
           if v_cod_servicio in (128) then
             v_texto := 'Estimado Cliente, le informamos que la siguiente operaci&oacute;n de Pago de Servicio, realizada desde '||v_nomCanal||', fue procesada. Le sugerimos que confirme el pago del extracto, accediendo al portal <b><a href="https://servicios.ips.gov.py/newrei/rei/">REI del IPS</a></b>. Podr&aacute; consultar las facturas emitidas por Pago de Servicios realizados desde el Home Banking y/o aplicaci&oacute;n m&oacute;vil en la secci&oacute;n <b>Impresi&oacute;n de facturas</b>.';
           elsif v_cod_servicio not in (128) and v_ticket is not null then
             v_texto := 'Estimado Cliente, le informamos que la siguiente operaci&oacute;n de Pago de Servicio, realizada desde '||v_nomCanal||', fue procesada. Podr&aacute; consultar las facturas emitidas por Pago de Servicios realizados desde el Home Banking y/o aplicaci&oacute;n m&oacute;vil en la secci&oacute;n <b>Impresi&oacute;n de facturas</b>.';
           elsif v_cod_servicio not in (128) and v_ticket is null then
             v_texto := 'Estimado Cliente, le informamos que la siguiente operaci&oacute;n de Pago de Servicio, realizada desde '||v_nomCanal||', fue procesada.';
           end if;
         else
            if v_cod_servicio in (128) then
             v_texto := 'Estimado Cliente, le informamos que la siguiente operaci&oacute;n de Pago de Servicio, realizada desde '||v_nomCanal||', fue procesada. Le sugerimos que confirme el pago del extracto, accediendo al portal <b><a href="https://servicios.ips.gov.py/newrei/rei/">REI del IPS</a></b>. Podr&aacute; consultar las facturas emitidas por Pago de Servicios realizados desde el Home Banking en la secci&oacute;n <b>Impresi&oacute;n de facturas</b>.';
           elsif v_cod_servicio not in (128) and v_ticket is not null then
             v_texto := 'Estimado Cliente, le informamos que la siguiente operaci&oacute;n de Pago de Servicio, realizada desde '||v_nomCanal||', fue procesada. Podr&aacute; consultar las facturas emitidas por Pago de Servicios realizados desde el Home Banking en la secci&oacute;n <b>Impresi&oacute;n de facturas</b>.';
           elsif v_cod_servicio not in (128) and v_ticket is null then
             v_texto := 'Estimado Cliente, le informamos que la siguiente operaci&oacute;n de Pago de Servicio, realizada desde '||v_nomCanal||', fue procesada.';
           end if;
         end if;
         if v_dir_correo is not null and v_cod_proveedor in (0,1,4)
           and v_mto_debito is not null and v_codCanal is not null then
             -- ---------- cabecera --------------
              v_cabecera :=
                    -- inicio div
                    paw_pro.fu_not_inicio ||
                    -- titulo
                    paw_pro.fu_not_titulo(UTL_URL.ESCAPE('PAGO DE SERVICIO PROCESADO', TRUE, 'UTF-8'));
              -- subtitulo
              v_cabecera := v_cabecera ||
              paw_pro.fu_not_sub_titulo(UTL_URL.ESCAPE(v_texto, TRUE, 'UTF-8'));
              v_cabecera := v_cabecera ||
                    -- inicio tabla
                    paw_pro.fu_not_ini_tabla ||
                    -- inicio tbody
                    paw_pro.fu_not_ini_tab_cuerpo;
              -- ---------- pie --------------
              -- fin tabla, fin div
              v_pie :=
                    -- fin tbody
                    paw_pro.fu_not_fin_tab_cuerpo ||
                    -- fin table
                    paw_pro.fu_not_fin_tabla;
              -- detalles
              v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Nombre del Cliente', TRUE, 'UTF-8'), v_nombre);
              v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Nro. Cuenta Débito', TRUE, 'UTF-8'), v_nro_cta_debito);
              v_detalle := v_detalle || paw_pro.fu_not_row_tag(UTL_URL.ESCAPE('Servicio', TRUE, 'UTF-8'), v_concepto);
              v_detalle := v_detalle || paw_pro.fu_not_row_tag('Monto', to_char((v_mto_debito), '999G999G999G999G999'));
              v_detalle := v_detalle || paw_pro.fu_not_row_tag('Fecha'||v_tag, to_char(v_fecha, 'dd/mm/yyyy'));
              -- fin div
              v_pie := v_pie || paw_pro.fu_not_fin;
        IF fug_ind_produccion = 'S' THEN --si es produccion
             v_result := paw_not.fu_env_email_prueba(v_dir_correo,
                                              v_cabecera || v_detalle || v_pie,
                                              'PAW_BEL');
          IF v_result = 0 then
              insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
              values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_pagoServicioWsActualizar'||'-'||'Mail pago servicio exitoso', 'Cliente: '||v_cod_per_debito||' Cuenta Déb.: '||v_nro_cta_debito ||' - '||substr(v_detalle,1,3900), sysdate, user)  ;
          else
              insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
              values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_pagoServicioWsActualizar'||'-'||'Mail pago servicio exitoso, no enviado', 'Cliente: '||v_cod_per_debito||' Cuenta Déb.: '||v_nro_cta_debito ||' - '||substr(v_detalle,1,3900), sysdate, user)  ;
          end if;
        ELSE -- si no corresponde al entorno de ejecucion de produccion.
             insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
              values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_pagoServicioWsActualizar'||'-'||'Mail pago servicio exitoso', 'Cliente: '||v_cod_per_debito||' Cuenta Déb.: '||v_nro_cta_debito ||' - Entorno de ejecucion invalido.', sysdate, user)  ;
        END IF;
    ELSE
             insert into tm_mails (env_por, env_para, asunto, detalles, fec_sistema, cod_usuario)
              values (fug_obt_dir_correo, v_dir_correo, 'PAW_BEL.fu_pagoServicioWsActualizar'||'-'||'Mail pago servicio, sin datos', 'Cliente: '||v_cod_per_debito||' Cuenta Déb.: '||v_nro_cta_debito ||' - Sin datos para envio de mail.', sysdate, user)  ;
        END IF;
         END IF;
      ELSE
         v_api_key := TRIM(v_xml.extract('/SET/apiKey/text()').getStringVal());
         IF pag_set.fu_val_api(v_api_key) = 'N' THEN
            raise_application_error(-20000, 'Apikey invalido - SET');
         END IF;
         v_token   := depurarTextos(v_xml.extract('/SET/token/text()').getStringVal(), 100);
         pag_set.pr_act_estado(NULL, NULL, NULL, 'P', v_xml, 1);
         v_retorno := SQL%ROWCOUNT;
         v_msj_bitacora := v_msj_bitacora || 'SET: ' || v_token;
      END IF;
      pr_insertarBitacora(v_usuario.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora || ', retorno: ' || v_retorno, BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_insertarBitacora(v_usuario.codigoPersona, v_codCanal, v_sesion, v_cod_operacion, v_usuario.codigoEmpresa, substr('ERR: ['||SQLERRM||']', 1, 300), BITACORA_ERROR);
         RETURN -1;
   END;

   -- Obtencion de feriados
   FUNCTION fu_obtenerFeriados(p_sesion      IN VARCHAR2,
                               p_codigoCanal IN VARCHAR2,
                               p_fechaInicio IN DATE,
                               p_fechaFin    IN DATE) RETURN typ_listaFeriados IS
      v_detalle  typ_detalleFeriado := typ_detalleFeriado();
      v_lista    typ_listaFeriados := typ_listaFeriados();
      v_usu_info typ_validarsesion;
      v_msj_caja typ_mensajeCaja;
      CURSOR c_feriados IS
         SELECT *
           FROM ba_feriados b
          WHERE b.fecha BETWEEN p_fechaInicio AND p_fechaFin
            AND b.cod_oficina IS NULL;
   BEGIN
      -- 1. Valido la Sesión del Cliente
      v_usu_info := fu_validarsesion(p_sesion, p_codigoCanal);
      IF v_usu_info.error = 'S' THEN
         RETURN NULL;
      END IF;
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_info);
      IF v_msj_caja.error = 'S' THEN
         RETURN NULL;
      END IF;
      FOR fe IN c_feriados LOOP
         v_detalle.fecha         := fe.fecha;
         v_detalle.codigoOficina := fe.cod_oficina;
         v_detalle.motivo        := substr(fe.motivo, 1, 35);
         v_lista.extend;
         v_lista(v_lista.count) := v_detalle;
      END LOOP;
      RETURN v_lista;
   EXCEPTION
      WHEN OTHERS THEN
         RETURN NULL;
   END;

   --Obtener bancos para transferencias internacionales
   FUNCTION fu_obtenerBancos(p_sesion      IN VARCHAR2,
                             p_codigoCanal IN VARCHAR2,
                             p_tipo        IN VARCHAR2 DEFAULT 'B',
                             p_codigoSwift IN VARCHAR2 DEFAULT NULL,
                             p_banco       IN VARCHAR2 DEFAULT NULL,
                             p_pais        IN VARCHAR2 DEFAULT NULL)
    RETURN typ_bancos IS

      v_tipo      VARCHAR2(1);
      userinfo    typ_validarsesion;
      v_cod_operacion       VARCHAR2(3) := '227';
      v_msj_bitacora        VARCHAR2(800) := 'obtBancos: ';
      v_permiso             typ_obtenerPermisos;
      v_msj_caja            typ_mensajeCaja;
      v_retorno             typ_bancos := typ_bancos;
   BEGIN
      paw_uti.pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_retorno.cantidad := 0;
      -- 1. Valido la Sesión del Cliente
      userinfo := fu_validarsesion(p_sesion, p_codigoCanal);
      IF userinfo.error = 'S' THEN
         v_retorno.error                := userinfo.error;
         v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(userinfo);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 3. Verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_permiso := lf_obt_permisos(userinfo, v_cod_operacion);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         paw_uti.pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      v_retorno:= paw_gen.fu_obtenerBancos(p_tipo,p_codigoSwift ,p_banco,null ,p_pais,null);
      paw_uti.pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);

      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   -- Validacion y Confirmacion de Transferencias Internacionales
   FUNCTION fu_transferenciaInternacional(p_sesion                  IN VARCHAR2,
                                          p_codigoCanal             IN VARCHAR2,
                                          p_modo                    IN VARCHAR2,
                                          p_nombreBeneficiario      IN VARCHAR2,
                                          p_direccionBeneficiario   IN VARCHAR2,
                                          p_cuentaCredito           IN VARCHAR2,
                                          p_codigoBanco             IN VARCHAR2,
                                          p_nombreBanco             IN VARCHAR2,
                                          p_codigoSwift             IN VARCHAR2,
                                          p_codigoPais              IN VARCHAR2,
                                          p_codigoCiudad            IN VARCHAR2,
                                          p_codBancoCorresponsal    IN VARCHAR2,
                                          p_nombreBancoCorresponsal IN VARCHAR2,
                                          p_swiftBancoCorresponsal  IN VARCHAR2,
                                          p_codCiudadBcoCorresponsal IN NUMBER,
                                          p_codPaisBcoCorresponsal  IN NUMBER,
                                          p_codigoMonedaCredito     IN VARCHAR2,
                                          p_montoCredito            IN NUMBER,
                                          p_numeroContrato          IN VARCHAR2,
                                          p_cuentaDebito            IN VARCHAR2,
                                          p_tipoCargo               IN VARCHAR2,
                                          p_plazo                   IN VARCHAR2,
                                          p_tipoMotivo              IN VARCHAR2,
                                          p_tipoFondo               IN VARCHAR2,
                                          p_tipoFinanciacion        IN VARCHAR2,
                                          p_referenciaBeneficiario  IN VARCHAR2,
                                          p_observaciones           IN VARCHAR2,
                                          p_claveTransaccional      IN VARCHAR2,
                                          p_claveToken              IN VARCHAR2,
                                          p_codPaisBeneficiario     IN NUMBER DEFAULT NULL,
                                          p_codCiudadBeneficiario   IN NUMBER DEFAULT NULL,
                                          p_comprobante             IN BLOB DEFAULT NULL,
                                          p_nombreComprobante       IN VARCHAR2 DEFAULT NULL,
                                          p_numeroReferencia        IN NUMBER DEFAULT NULL,
                                          p_ordenPago               IN VARCHAR2 DEFAULT NULL) RETURN typ_transferenciaban IS
      v_cod_operacion        VARCHAR2(3) := '227';
      v_permiso              typ_obtenerPermisos;
      v_msj_caja             typ_mensajeCaja;
      v_retorno              typ_transferenciaban := typ_transferenciaban;
      v_error                typ_mensajerespuesta := typ_mensajerespuesta;
      v_res_limite           typ_respuestaLimite;
      v_usuario              typ_validarsesion;
      v_nro_cta_debito       ge_cuentas.nro_cuenta%TYPE := depurarAlfanumerico(p_cuentaDebito, 15);
      v_cod_tra_padre        ge_transacciones.cod_transaccion%TYPE;
      v_cod_mon_debito       ge_cuentas.cod_moneda%TYPE;
      v_cod_mod_debito       ge_cuentas.cod_modulo%TYPE;
      v_cod_mad_debito       ge_cuentas.cod_modalidad%TYPE;
      v_cod_ofi_debito       ge_cuentas.cod_oficina%TYPE;
      v_cta_for_debito       VARCHAR2(20);
      v_nom_cta_debito       ge_cuentas.denominacion%TYPE;
      v_cod_mon_credito      ge_cuentas.cod_moneda%TYPE := substr(p_codigoMonedaCredito, 1, 3);
      v_plazo                NUMBER := depurarNumerico(p_plazo, 2);
      v_modo                 VARCHAR2(1) := nvl(TRIM(SUBSTR(p_modo, 1, 1)), 'X');
      v_nom_beneficiario     lc_transferencias.nom_beneficiario%TYPE := UPPER(depurarTextos(p_nombreBeneficiario, 120));
      v_dir_beneficiario     lc_transferencias.dir_beneficiario%TYPE := UPPER(depurarTextos(p_direccionBeneficiario, 100));
      v_nro_cta_referencia   lc_transferencias.nro_cta_referencia%TYPE := depurarTextos(p_cuentaCredito, 30);
      v_cod_banco            lc_transferencias.cod_banco%TYPE := depurarNumerico(p_codigoBanco, 3);
      v_nom_banco            lc_transferencias.nom_banco%TYPE := depurarTextos(p_nombreBanco, 100);
      v_cod_swift            lc_transferencias.cod_swi_banco%TYPE := depurarTextos(p_codigoSwift, 20);
      v_cod_pais             lc_transferencias.cod_pai_banco%TYPE := depurarNumerico(p_codigoPais, 3);
      v_cod_ciudad           lc_transferencias.cod_ciu_banco%TYPE := depurarNumerico(p_codigoCiudad, 3);
      v_cod_bco_corresponsal lc_transferencias.cod_bco_corresponsal%TYPE := p_codBancoCorresponsal;
      v_nom_bco_corresponsal lc_transferencias.nom_bco_cor_contra%TYPE := UPPER(depurarTextos(p_nombreBancoCorresponsal, 100));
      v_swi_bco_corresponsal lc_transferencias.cod_swi_bco_contra%TYPE := depurarTextos(p_swiftBancoCorresponsal, 20);
      v_ciu_bco_corresponsal lc_transferencias.cod_ciu_bco_contra%TYPE := p_codCiudadBcoCorresponsal;
      v_pai_bco_corresponsal lc_transferencias.cod_pai_bco_contra%TYPE := p_codPaisBcoCorresponsal;
      v_tip_cargo            lc_transferencias.tip_cargo%TYPE := substr(p_tipoCargo, 1, 3);
      v_tip_motivo           lc_transferencias.tip_motivo%TYPE := TRIM(substr(p_tipoMotivo, 1, 2));
      v_tip_fondo            lc_transferencias.tip_fondo%TYPE := TRIM(substr(p_tipoFondo, 1, 2));
      v_tip_financiacion     lc_transferencias.tip_financiacion%TYPE := TRIM(substr(p_tipoFinanciacion, 1, 2));
      v_nro_referencia       lc_transferencias.nro_referencia%TYPE := p_numeroReferencia;
      v_nom_solicitante      lc_transferencias.nom_solicitante%TYPE;
      v_dir_solicitante      lc_transferencias.dir_solicitante%TYPE;
      v_tel_solicitante      lc_transferencias.tel_solicitante%TYPE;
      v_cod_pai_solicitante  lc_transferencias.cod_pai_solicitante%TYPE;
      v_des_pai_solicitante  ba_paises.descripcion%TYPE;
      v_cod_ciu_solicitante  lc_transferencias.cod_ciu_solicitante%TYPE;
      v_nom_ciu_solicitante  lc_transferencias.nom_ciu_solicitante%TYPE;
      v_cod_pai_beneficiario lc_transferencias.cod_pai_beneficiario%TYPE := p_codPaisBeneficiario;
      v_cod_ciu_beneficiario lc_transferencias.cod_ciu_beneficiario%TYPE := p_codCiudadBeneficiario;
      v_nro_contrato         lc_ope_pendientes.nro_diario%TYPE := depurarNumerico(p_numeroContrato, 3);
      v_cto_cod_moneda       lc_ope_pendientes.cod_moneda%TYPE;
      v_cto_mto_cargo2       lc_ope_pendientes.mto_cargo2%TYPE;
      v_cto_monto            lc_ope_pendientes.monto%TYPE;
      v_cto_tip_operacion    lc_ope_pendientes.cod_tip_operacion%TYPE;
      v_mto_credito          ge_movimientos.monto%TYPE := p_montoCredito;
      v_mto_equ_local        ge_movimientos.mto_equ_local%TYPE;
      v_mto_debito           ge_movimientos.monto%TYPE;
      v_cot_debito           ge_movimientos.cotizacion%TYPE;
      v_cot_credito          ge_movimientos.cotizacion%TYPE;
      v_nro_documento        ge_movimientos.nro_documento%TYPE;
      v_nro_documento2       ge_movimientos.nro_documento%TYPE;
      v_den_cta_debito       ge_modalidades.descripcion%TYPE;
      v_mto_cargo            bw_mov_pendientes.mto_cargo%TYPE;
      v_cod_tip_operacion    lc_tip_ope_oficinas.cod_tip_operacion%TYPE;
      v_cod_tip_referencia   lc_tip_ope_oficinas.cod_tip_referencia%TYPE;
      v_parametros           bw_movimientos.parametros%TYPE;
      v_ref_beneficiario     lc_transferencias.referencia%TYPE := depurarTextos(p_referenciaBeneficiario, 300);
      v_observaciones        bw_movimientos.observacion%TYPE := depurarTextos(p_observaciones, 1000);
      v_cod_tra_modulo       ge_transacciones.cod_modulo%TYPE;
      v_cod_tra_modalidad    ge_transacciones.cod_modalidad%TYPE;
      v_nro_doc_persona      ba_personas.nro_documento%TYPE;
      v_tip_doc_persona      ba_personas.cod_tip_documento%TYPE;
      v_ord_pago             VARCHAR2(20) := depurarTextos(p_ordenPago, 20);
      v_val_dna              VARCHAR2(1);
      v_res_notificacion     NUMBER(3);
      v_exonerado            VARCHAR2(1);
      v_msj_bitacora         VARCHAR2(1000) := substr('modo:' || v_modo
                                                             || ', ctaDeb:' || v_nro_cta_debito
                                                             || ', monCre:' || v_cod_mon_credito
                                                             || ', ctaRef:' || v_nro_cta_referencia
                                                             || ', mtoCred:' || v_mto_credito
                                                             || ', codBan:' || v_cod_banco
                                                             || ', codSwif:' || v_cod_swift
                                                             || ', codPai:' || v_cod_pais
                                                             || ', codCiu:' || v_cod_ciudad
                                                             || ', bcoCorresp:' || v_cod_bco_corresponsal
                                                             || ', swiBcoCor:' || v_swi_bco_corresponsal
                                                             || ', ciuBcoCor:' || v_ciu_bco_corresponsal
                                                             || ', paiBcoCor:' || v_pai_bco_corresponsal
                                                             || ', nroCon:' || v_nro_contrato
                                                             || ', plazo:' || v_plazo
                                                             || ', tipCarg:' || v_tip_cargo
                                                             || ', tipMot:' || v_tip_motivo
                                                             || ', tipFon:' || v_tip_fondo
                                                             || ', tipFin:' || v_tip_financiacion
                                                             || ', refBen: '||substr(v_ref_beneficiario, 1, 15)
                                                             || ', obs: ' || substr(v_observaciones, 1, 15)
                                                             || ', dna: ' || v_ord_pago, 1, 900);
      v_salida              VARCHAR2(3);
      v_existe              VARCHAR2(1);
      v_msj_error           VARCHAR2(300);
      TRI_OPE_INVALIDA      CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      TRI_SIN_PERMISO       CONSTANT VARCHAR2(15) := 'TRP_SIN_PERMISO';
      TRI_CTA_DEB_INVALIDA  CONSTANT VARCHAR2(15) := 'CTA_DEB_INVALID';
      TRI_MTO_INVALIDO      CONSTANT VARCHAR2(15) := 'MTO_INVALIDO';
      TRI_MOV_PEND_AUTORIZA CONSTANT VARCHAR2(15) := 'TRA_MOV_PEND_AU';
      TRI_HOR_OPE_INVAL     CONSTANT VARCHAR2(15) := 'TRA_HOR_OPE_INV';
      TRI_CONTRATO_INVALIDO CONSTANT VARCHAR2(15) := 'TRA_CON_INVALID';
      TRI_MON_INVALIDA      CONSTANT VARCHAR2(15) := 'TRI_MON_INVALID';
      TRI_TIP_CAR_INVALIDO  CONSTANT VARCHAR2(15) := 'TRI_TIP_CAR_INV';
      TRI_TIP_PLZ_INVALIDO  CONSTANT VARCHAR2(15) := 'TRI_TIP_PLZ_INV';
      TRI_CTA_CAM_INVALIDA  CONSTANT VARCHAR2(15) := 'TRI_CTA_CAM_INV';
      TRI_TIP_OPE_INVALIDA  CONSTANT VARCHAR2(15) := 'TRI_OPE_INVALID';
      TRI_ERR_OBT_CARGOS    CONSTANT VARCHAR2(15) := 'TRI_ERR_OBT_CAR';
      TRI_ERR_OBT_IMPUESTOS CONSTANT VARCHAR2(15) := 'TRI_ERR_OBT_IMP';
      TRI_ERR_GEN_OPERACION CONSTANT VARCHAR2(15) := 'TRI_ERR_GEN_OPE';
      TRI_ERR_INS_MOVIMIENTO CONSTANT VARCHAR2(15) :='TRI_ERR_INS_MOV';
      TRI_ERR_LIM_CAMBIO    CONSTANT VARCHAR2(15) := 'TRI_ERR_LIM_CAM';
      TRI_ACT_NRO_CONTRATO  CONSTANT VARCHAR2(15) := 'TRI_ACT_NRO_CON';
      TRI_COD_BCO_INVALIDO  CONSTANT VARCHAR2(15) := 'TRI_COD_BCO_INV';
      TRI_CTO_MON_INVALIDA  CONSTANT VARCHAR2(15) := 'TRI_CTO_MON_INV';
      TRI_CTO_MTO_INVALIDO  CONSTANT VARCHAR2(15) := 'TRI_CTO_MTO_INV';
      TRI_CTO_CTA_INVALIDO  CONSTANT VARCHAR2(15) := 'TRI_CTO_CTA_INV';
      TRI_CTO_PLZ_INVALIDO  CONSTANT VARCHAR2(15) := 'TRI_CTO_PLZ_INV';
      TRI_BCO_INT_INEXISTE  CONSTANT VARCHAR2(15) := 'TRI_BCO_INT_INE';
      TRI_BCO_BEN_INEXISTE  CONSTANT VARCHAR2(15) := 'TRI_BCO_BEN_INE';
      TRI_CTO_TTE_INVALIDO  CONSTANT VARCHAR2(15) := 'TRI_CTO_TTE_INV';
      TRI_BCO_PAI_INEXISTE  CONSTANT VARCHAR2(15) := 'TRI_BCO_PAI_INE';
      TRI_BCO_CIU_INEXISTE  CONSTANT VARCHAR2(15) := 'TRI_BCO_CIU_INE';
      TRI_TIP_CAR_PREPACTA  CONSTANT VARCHAR2(15) := 'TRI_TIP_CAR_PRE';
      TRI_PAI_COR_INVALIDO  CONSTANT VARCHAR2(15) := 'TRI_PAI_COR_INV';
      TRI_CIU_COR_INVALIDO  CONSTANT VARCHAR2(15) := 'TRI_CIU_COR_INV';
      TRI_DNA_FEC_INVALIDA CONSTANT VARCHAR2(15) := 'TRI_DNA_FEC_INV';
      TRI_DNA_EST_ANULADO  CONSTANT VARCHAR2(15) := 'TRI_DNA_EST_ANU';
      TRI_DNA_EST_VENCIDO  CONSTANT VARCHAR2(15) := 'TRI_DNA_EST_VEN';
      TRI_DNA_MON_INVALIDA CONSTANT VARCHAR2(15) := 'TRI_DNA_MON_INV';
      TRI_DNA_MTO_INVALIDO CONSTANT VARCHAR2(15) := 'TRI_DNA_MTO_INV';
      TRI_DNA_ERR_INTERNO  CONSTANT VARCHAR2(15) := 'TRI_DNA_ERR_INT';
      TRI_DNA_DAT_INEX     CONSTANT VARCHAR2(15) := 'TRI_DNA_DAT_INE';
      TRI_DNA_ORD_INVALIDA CONSTANT VARCHAR2(15) := 'TRI_DNA_ORD_INV';
      TRI_DNA_INHABILITADO CONSTANT VARCHAR2(15) := 'TRI_DNA_INHABIL';

       -- para lp_ver_operacion
      v_horario             VARCHAR2(1);
      v_es_mov_noc          VARCHAR2(1);
      v_es_cta_noc          VARCHAR2(1);
      v_fec_actual          DATE;
      v_fec_operacion       DATE;
      v_cod_respuesta       NUMBER;
      v_fec_proceso         DATE := sysdate;

      -- manejo de errores de pal_tra.pr_obt_tot_tra_hb
      PROCEDURE lp_err_totales IS
      BEGIN
         CASE v_cod_respuesta
            WHEN  0 THEN -- OK
               NULL;
            WHEN -1 THEN -- TTE habilitado para Euros y Dolares
               paw_uti.pr_mensajeUsuario(TRI_MON_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -2 THEN -- Monto de Operacion debe ser mayor a Cero
               paw_uti.pr_mensajeUsuario(TRI_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -3 THEN -- El tipo de Cargo debe ser OUR o BEN
               paw_uti.pr_mensajeUsuario(TRI_TIP_CAR_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -4 THEN -- Plazo debe ser 0(0 horas)/1(24 horas)/2(48 horas)
               paw_uti.pr_mensajeUsuario(TRI_TIP_PLZ_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -5 THEN -- Obtener Cta de Debito
               paw_uti.pr_mensajeUsuario(TRI_CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -6 THEN -- No se encuentra Op. de Venta Prepactada
               paw_uti.pr_mensajeUsuario(TRI_CONTRATO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -7 THEN -- La Moneda de la Transf. y de la Operac.Prepactada son distintas
               paw_uti.pr_mensajeUsuario(TRI_CTO_MON_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -8 THEN -- El Monto de la Transf. y de la Operac.Prepactada son distintos
               paw_uti.pr_mensajeUsuario(TRI_CTO_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -9 THEN -- No se encuentra Op. de Compra Prepactada
               paw_uti.pr_mensajeUsuario(TRI_CONTRATO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -10 THEN -- El Nro de Cuenta de la Transf. y de la Operac.Prepactada son distintas
               paw_uti.pr_mensajeUsuario(TRI_CTO_CTA_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -11 THEN -- Al Obt.Cta.Limite de Cambios
               paw_uti.pr_mensajeUsuario(TRI_CTA_CAM_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -12 THEN -- Tipo de Operacion invalida
               paw_uti.pr_mensajeUsuario(TRI_TIP_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -13 THEN -- Recuperar Cargo Inicial a Cobrar
               paw_uti.pr_mensajeUsuario(TRI_ERR_OBT_CARGOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -14 THEN -- Recuperar Impuesto Inicial a Cobrar
               paw_uti.pr_mensajeUsuario(TRI_ERR_OBT_IMPUESTOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -15 THEN -- Recuperar Cargo Posterior a Cobrar
               paw_uti.pr_mensajeUsuario(TRI_ERR_OBT_CARGOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -16 THEN -- Recuperar Impuesto Posterior a Cobrar
               paw_uti.pr_mensajeUsuario(TRI_ERR_OBT_IMPUESTOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -31 THEN -- El plazo especificado y el de la Operac.Prepactada son distintas
               paw_uti.pr_mensajeUsuario(TRI_CTO_PLZ_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -32 THEN -- Tipo de Operacion Prepactada no es de TTE
               paw_uti.pr_mensajeUsuario(TRI_CTO_TTE_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -33 THEN -- Tipo de Cargo Prepactado Invalido
               paw_uti.pr_mensajeUsuario(TRI_TIP_CAR_PREPACTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -34 THEN -- Banco Intermediario Inexistente
               paw_uti.pr_mensajeUsuario(TRI_BCO_INT_INEXISTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -35 THEN -- Pais de Banco del Intermediario no corresponde
               paw_uti.pr_mensajeUsuario(TRI_PAI_COR_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -36 THEN -- Ciudad de Banco del Intermediario no corresponde
               paw_uti.pr_mensajeUsuario(TRI_CIU_COR_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           ELSE
               paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END CASE;
      END;
      -- manejo de errores de pal_tra.pr_ins_mov_tra_hb
      PROCEDURE lp_err_movimientos IS
      BEGIN
         lp_err_totales;
         IF v_retorno.error = 'S' AND v_retorno.nombreRespuesta = 'OP_ERROR' THEN
            CASE v_cod_respuesta
               WHEN -17 THEN -- Asignar Nro de Operacion
                  paw_uti.pr_mensajeUsuario(TRI_ERR_GEN_OPERACION, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -18 THEN -- Insertar Movimiento 1
                  paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -19 THEN -- Insertar Movimiento 2
                  paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -20 THEN -- Actualiza Limite de Cambios
                  paw_uti.pr_mensajeUsuario(TRI_ERR_LIM_CAMBIO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -21 THEN -- Insertar Movimiento 3
                  paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -22 THEN -- Insertar Movimiento 4
                  paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -23 THEN -- Insertar Movimiento 5
                  paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -24 THEN -- Insertar Movimiento 6
                  paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -25 THEN -- Insertar Movimiento 7
                  paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -26 THEN -- Insertar Movimiento 8
                  paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -27 THEN -- Insertar Movimiento 9
                  paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -28 THEN -- Insertar Movimiento 10
                  paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               WHEN -29 THEN -- Act.Estado Prepactada
                  paw_uti.pr_mensajeUsuario(TRI_ACT_NRO_CONTRATO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

            END CASE;
         END IF;
         RETURN;
      END;
      -- manejo de errores de pal_tra.pr_ins_tra_hb
      PROCEDURE lp_err_transferencias IS
      BEGIN
         CASE v_cod_respuesta
            WHEN  0 THEN -- OK
               NULL;
            WHEN -1 THEN -- TTE habilitado para Euros y Dolares
               paw_uti.pr_mensajeUsuario(TRI_MON_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -2 THEN -- Monto de Operacion debe ser mayor a Cero
               paw_uti.pr_mensajeUsuario(TRI_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -3 THEN -- El tipo de Cargo debe ser OUR o BEN
               paw_uti.pr_mensajeUsuario(TRI_TIP_CAR_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -4 THEN -- Plazo debe ser 0(0 horas)/1(24 horas)/2(48 horas)
               paw_uti.pr_mensajeUsuario(TRI_TIP_PLZ_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -5 THEN -- Obtener Banco Corresponsal
               paw_uti.pr_mensajeUsuario(TRI_COD_BCO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -7 THEN -- Insertar Tranferencia
               paw_uti.pr_mensajeUsuario(TRI_ERR_INS_MOVIMIENTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -8 THEN -- Banco Intermediario Inexistente
               paw_uti.pr_mensajeUsuario(TRI_BCO_INT_INEXISTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -9 THEN -- Banco del Beneficiario Inexistente
               paw_uti.pr_mensajeUsuario(TRI_BCO_BEN_INEXISTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -10 THEN -- Pais de Banco del Beneficiario no corresponde
               paw_uti.pr_mensajeUsuario(TRI_BCO_PAI_INEXISTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -11 THEN -- Ciudad de Banco del Beneficiario no corresponde
               paw_uti.pr_mensajeUsuario(TRI_BCO_CIU_INEXISTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -12 THEN -- Pais de Banco del Intermediario no corresponde
               paw_uti.pr_mensajeUsuario(TRI_PAI_COR_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -13 THEN -- Ciudad de Banco del Intermediario no corresponde
               paw_uti.pr_mensajeUsuario(TRI_CIU_COR_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            ELSE
               paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END CASE;
      END;
      -- validar retorno de DNA/BCP
      PROCEDURE lp_err_dna IS
      BEGIN
         CASE v_cod_respuesta
            WHEN 0 THEN
               NULL; -- OK
            WHEN -1 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_FEC_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -2 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_EST_ANULADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -3 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_EST_VENCIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -4 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_MON_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN -5 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN 3 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_ERR_INTERNO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN 4 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_DAT_INEX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN 10 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_ORD_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN 11 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_EST_VENCIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN 12 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_INHABILITADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN 20 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_ORD_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN 21 THEN
               paw_uti.pr_mensajeUsuario(TRI_DNA_ORD_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            ELSE
               paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END CASE;
      END;
      -- validar dominio, ojo: no trata exception
      FUNCTION lf_ref_existe(p_dominio    IN ba_cod_referencias.dominio%TYPE,
                             p_val_minimo IN ba_cod_referencias.val_minimo%TYPE) RETURN VARCHAR2 IS
         v_existe VARCHAR2(1);
      BEGIN
         SELECT 'S'
           INTO v_existe
           FROM ba_cod_referencias r
          WHERE r.dominio = p_dominio
            AND r.val_minimo = p_val_minimo;
         RETURN v_existe;
      END;

      -- insertar documento de transferencia
      PROCEDURE lp_ins_archivo IS
         v_size NUMBER;
      BEGIN
         v_size := paw_uti.fu_ins_archivo(nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona),
                                   v_cod_operacion,
                                   nvl(v_nro_documento2,v_nro_documento),
                                   p_comprobante,
                                   p_nombreComprobante);
         IF v_size < 0 THEN
            raise_application_error(-20001, 'no se pudo guardar el archivo '||p_nombreComprobante);
         END IF;
         v_msj_bitacora := v_msj_bitacora || ', con_size:' || v_size;
      END;
   BEGIN
      paw_uti.pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- 1. Valido la Sesión del Cliente
      v_usuario := fu_validarsesion(p_sesion, p_codigoCanal);
      IF v_usuario.error = 'S' THEN
         v_retorno.error                := v_usuario.error;
         v_retorno.nombreRespuesta      := v_usuario.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usuario.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 2. valida el numero de caja
      v_msj_caja := lf_val_caja(v_usuario);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      paw_uti.pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora||' '|| paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ENTRADA);
      IF v_modo = 'A' THEN
         IF g_aut_operacion = FALSE THEN
            paw_uti.pr_mensajeUsuario(TRI_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora||' '||paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      ELSE
         v_permiso := lf_obt_permisos(v_usuario, v_cod_operacion);
         IF (v_permiso.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
            v_retorno.error                := v_permiso.error;
            paw_uti.pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- se verifica que tenga permiso para registrar
         IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
            paw_uti.pr_mensajeUsuario(TRI_SIN_PERMISO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora || ' ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;

         IF v_modo = 'C' AND v_can_aut_requeridas = 0 THEN
            -- se confirma directamente la operacion, porque no requiere autorizacion
            v_modo := 'A';
         END IF;
      END IF;

      IF v_modo IN ('V', 'C', 'A') THEN
         SELECT decode(v_cod_bco_corresponsal, 0, NULL, v_cod_bco_corresponsal),
                decode(v_ciu_bco_corresponsal, 0, NULL, v_ciu_bco_corresponsal),
                decode(v_pai_bco_corresponsal, 0, NULL, v_pai_bco_corresponsal)
           INTO v_cod_bco_corresponsal, v_ciu_bco_corresponsal, v_pai_bco_corresponsal
           FROM DUAL;

         -- se valida el horario
         IF v_retorno.error = 'N' THEN
            v_error := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                      v_msj_caja.fechaUltimoCierre, -- IN
                                      v_msj_caja.codigoOficinaOrigen, -- IN
                                      v_fec_actual);

            IF v_error.error = 'S' THEN
               v_retorno.error := v_error.error;
               v_retorno.nombreRespuesta := v_error.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
            END IF;
         END IF;
         -- obtenemos la moneda debito
         SELECT cod_moneda
           INTO v_cod_mon_debito
           FROM ge_cuentas
          WHERE nro_cuenta = v_nro_cta_debito;
         -- Se verifica el horario de Operaciones de Cambio
         IF v_retorno.error = 'N' AND nvl(v_nro_contrato, 0) <> 0 THEN
            v_cod_respuesta := pal_tra.fu_val_contrato(nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona),
                                                       v_cod_mon_debito,
                                                       v_nro_contrato,
                                                       v_cto_cod_moneda,
                                                       v_cto_mto_cargo2,
                                                       v_cto_monto,
                                                       v_cto_tip_operacion);
            v_msj_bitacora := substr(v_msj_bitacora || ', valCon: ' || v_cod_respuesta, 1, 900);
            IF v_cod_respuesta = -1 THEN
               paw_uti.pr_mensajeUsuario(TRI_HOR_OPE_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            ELSIF v_cod_respuesta <> 0 THEN
               paw_uti.pr_mensajeUsuario(TRI_CONTRATO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            ELSE
               -- obtenemos la moneda
               v_cod_mon_credito := nvl(v_cod_mon_credito, v_cto_cod_moneda);

               -- obtenemos el plazo
               IF v_plazo IS NULL THEN
                  SELECT decode(v_cto_tip_operacion,
                                          29, 0,  74, 0,  44, 0, -- 0hrs.
                                         292, 1, 742, 1, 442, 1, -- 24hrs.
                                         293, 2, 743, 2, 443, 2, -- 48hrs.
                                         -1)                    -- invalido
                    INTO v_plazo
                    FROM DUAL;
               END IF;
               -- obtenemos el monto de operacion
               v_mto_credito := nvl(v_mto_credito, v_cto_monto);
               --DDSI-52 - GDF - AGO 2017
               --Verificamos si la persona tiene exoneracion por gasto OUR
               v_exonerado   := pal_tra.fu_ver_gto_exonerado(nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona));
               -- obtenemos el tipo de cargo
               IF v_tip_cargo IS NULL THEN
                  IF v_cto_mto_cargo2 > 0 THEN
                     v_tip_cargo := 'OUR';
                  ELSE
                     v_tip_cargo := 'BEN';
                  END IF;
                  --DDSI-52 - GDF - AGO 2017
                  IF v_cto_mto_cargo2 = 0 and v_exonerado = 'S' THEN
                     v_tip_cargo := 'OUR';
                  END IF;
               END IF;
            END IF;
         END IF;
         -- importe,plazo,tipo de gastos y moneda
         IF v_retorno.error = 'N' THEN
            DECLARE
               v_lugar   VARCHAR2(20);
               v_existe VARCHAR2(1);
            BEGIN
               -- validamos el tipo de cargo
               v_lugar := 'cargo';
               v_existe := lf_ref_existe('TIP_CAR_SWIFT', v_tip_cargo);
               -- validamos el motivo
               v_lugar := 'motivo';
               v_existe := lf_ref_existe('TRA_TIP_MOTIVO', v_tip_motivo);
               -- validamos el fondo
               v_lugar := 'fondo';
               v_existe := lf_ref_existe('TRA_TIP_FONDO', v_tip_fondo);
               -- validamos la financiacion
               v_lugar := 'financiacion';
               v_existe := lf_ref_existe('TRA_TIP_FINANCIACION', v_tip_financiacion);
            EXCEPTION
               WHEN NO_DATA_FOUND THEN
                  paw_uti.pr_mensajeUsuario(TRI_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  v_msj_bitacora := v_msj_bitacora || ', en: ' || v_lugar;
               WHEN OTHERS THEN
                  paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  v_msj_bitacora := substr(v_msj_bitacora || ', en: ' || v_lugar || ', BA-COD-REF: [' || SQLERRM || ']', 1, 800);
            END;
         END IF;
         -- verifica si el motivo es necesario para validar con DNA/BCP
         IF v_retorno.error = 'N' THEN
            BEGIN
               v_val_dna := lf_ref_existe('TRA_TIP_MOT_DNA', v_tip_motivo);
               SELECT p.nro_documento, p.cod_tip_documento
                 INTO v_nro_doc_persona, v_tip_doc_persona
                 FROM ba_personas p
                WHERE p.cod_persona = nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona);
            EXCEPTION
               WHEN OTHERS THEN
                  v_val_dna := 'N';
            END;
         END IF;
         -- validamos el plazo
         IF v_retorno.error = 'N' AND nvl(v_plazo, -1) NOT IN (0, 1, 2) THEN
            paw_uti.pr_mensajeUsuario(TRI_TIP_PLZ_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END IF;
         -- validamos las monedas
         IF v_retorno.error = 'N' THEN
            IF v_cod_mon_credito = v_cod_mon_local THEN
               -- no se puede transferir en moneda local
               paw_uti.pr_mensajeUsuario(TRI_MON_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      ELSE
        -- obtenemos la moneda debito
        SELECT cod_moneda
        INTO v_cod_mon_debito
        FROM ge_cuentas
         WHERE nro_cuenta = v_nro_cta_debito;
            END IF;
         END IF;
         -- se validan las conversiones y transaccion padre
         IF v_retorno.error = 'N' THEN
            pal_tra.pr_obt_tot_tra_hb(v_nro_cta_debito,
                                      v_cod_mon_credito, --Moneda Transferencia
                                      v_plazo,           --Plazo de La Transferencia
                                      v_mto_credito,     --Monto de la Transferencia
                                      v_nro_contrato,    --Nro de Operación Pre-pactada
                                      v_tip_cargo,       --'OUR'/'BEN'
                                      v_exonerado,       --'S'/'N'
                                      v_cod_bco_corresponsal, -- p_cod_bco_cor_contra
                                      v_nom_bco_corresponsal, -- p_nom_bco_cor_contra
                                      v_swi_bco_corresponsal, -- p_cod_swi_bco_contra
                                      v_pai_bco_corresponsal, -- p_cod_pai_bco_contra
                                      v_ciu_bco_corresponsal, -- p_cod_ciu_bco_contra
                                      v_mto_debito,      --Importe de la Operación
                                      v_mto_cargo,       --Importe del Cargo
                                      v_cot_credito,     --Cotización de Moneda de Transferencia
                                      v_cot_debito,      --Cotización de Moneda de contra partida
                                      v_cod_tra_padre,   --Transaccion padre
                                      v_fec_operacion,   --Fecha de Operación
                                      v_fec_actual,      --Fecha de Valor
                                      v_cod_tip_operacion, -- codigo de operacion de venta/canje
                                      v_cod_respuesta);  --Respuesta 0 sino hubo errores

            IF v_cod_respuesta <> 0 THEN
               lp_err_totales;
               v_msj_bitacora := substr(v_msj_bitacora || ', pr_obt_tot_tra_hb: [' || v_cod_respuesta || ']', 1, 900);
            END IF;
         END IF;
         -- validamos los montos de la operacion
         IF v_retorno.error = 'N' THEN
            v_msj_bitacora := v_msj_bitacora || ', mtoDeb: ' || v_mto_debito  || ', traPad:' || v_cod_tra_padre || ', fecAc:' || v_fec_actual || ', fecOpe:' || v_fec_operacion;
            IF v_mto_credito <= 0 OR v_mto_debito <= 0 THEN
               paw_uti.pr_mensajeUsuario(TRI_MTO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
         END IF;


         -- validamos la cuenta debito
         IF v_retorno.error = 'N' THEN
            SELECT t.cod_modulo, t.cod_modalidad
              INTO v_cod_tra_modulo, v_cod_tra_modalidad
              FROM ge_transacciones t
             WHERE t.cod_transaccion = v_cod_tra_padre
               AND ROWNUM = 1;

            v_error := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_mto_debito, v_cod_mon_debito, v_cod_mod_debito, v_cod_mad_debito, v_cod_ofi_debito, v_cta_for_debito, v_nom_cta_debito, v_usuario, v_msj_caja, v_cod_tra_modulo, v_cod_tra_modalidad);
            IF v_error.error = 'S' THEN
               v_retorno.error                := v_error.error;
               v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
            ELSE
               v_den_cta_debito := fug_obt_des_modal(v_cod_mod_debito, v_cod_mad_debito);
            END IF;
         END IF;
         -- validamos si la cuenta pertenece al cliente
         IF v_retorno.error = 'N' THEN
            IF lf_val_cta_origen(v_nro_cta_debito, nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona)) = 'N' THEN
               paw_uti.pr_mensajeUsuario(TRI_CTA_DEB_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
         END IF;
         -- valido la duplicacion de transferencias
         IF v_retorno.error = 'N' THEN
            BEGIN
               SELECT 'S'
                 INTO v_existe
                 FROM bw_mov_pendientes
                WHERE cod_per_principal = v_usuario.codigoEmpresa
                  AND nro_cuenta = v_nro_cta_debito
                  AND monto = v_mto_debito
                  AND estado = 'P'
                  AND cod_tip_mensaje = v_cod_operacion
                  AND nro_cta_contra = v_nro_cta_referencia
                  AND trunc(fec_insercion) = trunc(SYSDATE)
                  AND rownum = 1;
            EXCEPTION
               WHEN too_many_rows THEN
                  v_existe := 'S';
               WHEN OTHERS THEN
                  v_existe := 'N';
            END;
            IF v_existe = 'N' THEN
               v_error := fu_ver_transaccion(503, v_cod_tra_padre, v_nro_cta_debito, v_mto_debito, v_msj_caja);

               IF v_error.error = 'S' THEN
                  v_retorno.error                := v_error.error;
                  v_retorno.nombreRespuesta      := v_error.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
               END IF;
            ELSE
               paw_uti.pr_mensajeUsuario(TRI_MOV_PEND_AUTORIZA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
         END IF;
         -- validar bancos
         IF v_retorno.error = 'N' THEN
            v_cod_respuesta := pal_tra.fu_val_banco(v_cod_banco, v_cod_pais, v_cod_ciudad);
            IF v_cod_respuesta = 0 THEN
               v_cod_respuesta := pal_tra.fu_val_bco_corresponsal(v_cod_bco_corresponsal, v_pai_bco_corresponsal, v_ciu_bco_corresponsal);
            END IF;
            lp_err_transferencias;
         END IF;
         -- validar nro. de orden de pago con DNA en caso que corresponda
         IF v_retorno.error = 'N' AND v_val_dna = 'S' THEN
            DECLARE
               v_dna_fec_creacion DATE;
               v_dna_fec_vencimiento DATE;
               v_dna_cod_mon_origen VARCHAR2(50);
               v_dna_sal_origen NUMBER;
               v_dna_cotizacion NUMBER;
            BEGIN
               pal_tra.pr_con_bol_pag_dna(v_ord_pago,
                                          v_cod_mon_credito,
                                          v_mto_credito,
                                          v_nro_doc_persona,
                                          v_tip_doc_persona,
                                          --respuesta DNA
                                          v_dna_cod_mon_origen,
                                          v_dna_fec_creacion,
                                          v_dna_fec_vencimiento,
                                          v_dna_sal_origen,
                                          v_dna_cotizacion,
                                          v_cod_respuesta, -- 0 sino hubo errores
                                          v_msj_error);
               -- verificar v_cod_respuesta
               IF v_cod_respuesta <> 0 THEN
                  v_msj_bitacora := substr(v_msj_bitacora|| 'conDna:['||v_cod_respuesta||'-'||v_msj_error||']', 1, 1000);
               END IF;
               lp_err_dna;
            END;
         END IF;
         -- se verifica el límite de operaciones
         IF v_retorno.error = 'N' THEN
            IF v_modo in ('C', 'V', 'A') AND nvl(p_modo,'x') <> 'A' THEN
               v_res_limite := fu_obtenerLimite(v_usuario,
                                                v_cod_operacion,
                                                nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona),
                                                v_nro_cta_debito,
                                                v_cod_mon_debito,
                                                503,
                                                v_cod_tra_padre,
                                                v_mto_debito,
                                                v_modo);
               v_msj_bitacora := v_msj_bitacora || ', resLim:' || v_res_limite.codRespuesta;
               IF v_res_limite.error = 'S' THEN
                  v_retorno.error := v_res_limite.error;
                  v_retorno.nombreRespuesta := v_res_limite.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_res_limite.descripcionRespuesta;
               END IF;
            END IF;
         END IF;
         -- se validan las claves según respuesta de límites
         IF v_retorno.error = 'N' THEN
            IF nvl(p_modo, 'x') <> 'A' AND v_modo in ('C','A') THEN
               v_error.error := 'N';
               IF v_res_limite.codRespuesta IN ('10', '11') THEN -- clave transaccional requerida
                  v_error := lf_obt_cla_validar(p_claveTransaccional, v_usuario.codigoPersona, v_usuario.codigoEmpresa, 'T');
               END IF;

               IF v_error.error = 'N' THEN
                  IF v_res_limite.codRespuesta IN ('01', '11') THEN -- token requerido
                     v_error := paw_seg.fu_obt_tok_validar(p_claveToken, v_usuario.codigoPersona, v_usuario.codigoEmpresa, v_modo);
                  END IF;
               END IF;

               IF v_error.error = 'S' THEN
                  v_retorno.error := v_error.error;
                  v_retorno.nombreRespuesta := v_error.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_error.descripcionRespuesta;
               END IF;
            END IF;
         END IF;
         v_retorno.tipPedido        := v_modo;
         v_retorno.tipTransferencia := '4';
         IF v_retorno.error = 'N' THEN
            /*
               29 - VENTA TRANSFERENCIA - 0 HS
              292 - VENTA TRANSFERENCIA - 24 HS
              293 - VENTA TRANSFERENCIA - 48 HS
               74 - CANJE VENTA DE TRANSFERENCIA - 0 HS
              742 - CANJE VENTA DE TRANSFERENCIA - 24 HS
              743 - CANJE VENTA DE TRANSFERENCIA - 48 HS
             */
            SELECT cod_tip_referencia
              INTO v_cod_tip_referencia
              FROM lc_tip_ope_oficinas lp
             WHERE lp.cod_oficina = v_msj_caja.codigoOficinaOrigen
               AND lp.cod_tip_operacion = v_cod_tip_operacion
               AND lp.cod_moneda = v_cod_mon_credito;
            v_msj_bitacora := v_msj_bitacora || ', codTipRef: ' || v_cod_tip_referencia;

            -- no hay problemas hasta aquí
            -- calculamos el numero de referencia para transferencia a enviar
            IF v_nro_referencia IS NULL AND v_modo IN ('C','A') THEN
               v_nro_referencia := fue_obt_sig_secuencia('S_NRO_REF_'||lpad(v_cod_tip_referencia, 3, '0'));
            END IF;
            v_msj_bitacora := substr(v_msj_bitacora || ', codTipOpe:' || v_cod_tip_operacion || ', nroRefe:' || v_nro_referencia || ', codTipRef:' || v_cod_tip_referencia, 1, 1000);
            -- validación
            v_retorno.cotizacion             := v_cot_credito;
            v_retorno.ctaForDebito           := substr(v_cta_for_debito,0, 17);
            v_retorno.nombreCtaDebito        := substr(v_nom_cta_debito,0, 100);
            v_retorno.codMonDebito           := substr(v_cod_mon_debito,0, 3);
            v_retorno.monto                  := v_mto_debito;
            v_retorno.ctaForCredito          := substr(v_tip_cargo||'-'||v_plazo, 1, 17);
            v_retorno.nombreCtaCredito       := substr(v_nom_beneficiario,0, 100);
            v_retorno.codMonCredito          := substr(v_cod_mon_credito,0, 3);
            v_retorno.montoCredito           := v_mto_credito;
            v_retorno.resLimite              := v_res_limite.codRespuesta;
            v_retorno.denominacionCtaDebito  := substr(v_den_cta_debito, 1, 50);
            v_retorno.denominacionCtaCredito := substr(v_nro_cta_referencia, 0, 50);
            v_retorno.montoCargo             := v_mto_cargo;
            v_retorno.cotizacionContra       := v_cot_debito;
            v_retorno.fechaOperacion         := v_fec_operacion;
            v_retorno.fechaValor             := v_fec_actual;

            IF v_modo = 'C' THEN
               -- grabacion en pendiente
               IF v_cod_mon_debito <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_credito AND v_cod_mon_credito = v_cod_mon_local THEN
                  v_mto_equ_local := v_mto_credito;
               ELSE
                  v_mto_equ_local := NULL;
               END IF;
               --- inserto el movimiento pendiente de autorizacion
               SELECT s_nro_documento.NEXTVAL
                 INTO v_nro_documento
                 FROM dual;
               INSERT INTO bw_mov_pendientes
                  (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta,
                   cod_moneda, descripcion, monto, mto_cargo, cotizacion, mto_equ_local,
                   nro_cta_contra, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso,
                   mto_contra, cot_contra, etiqueta, dato, etiqueta2,
                   dato2, referencia)
               VALUES
                  (v_nro_documento, nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito,
                   v_cod_mon_debito, 'Transferencia Internacional', v_mto_debito, v_mto_cargo, v_cot_debito,
                   v_mto_equ_local, v_nro_cta_referencia, 'P', v_can_aut_requeridas, v_can_aut_requeridas, v_usuario.codigoPersona,
                   v_mto_credito, v_cot_credito, 'Fecha Valor', to_char(v_fec_actual, 'dd/mm/yyyy'), 'Cod.Banco',
                   v_cod_banco, v_nro_referencia);

               v_retorno.cantAutorizadores := v_can_aut_requeridas;
               v_retorno.nroDocumento      := v_nro_documento;

               -- archivo adjunto
               lp_ins_archivo;

               -- guardamos para obtener datos en la autorizacion
               -- OJO para agregar mas parametros, solo contamos con 1000 caracteres
               v_parametros := rpad(nvl(v_nom_beneficiario, ' '), 120) ||
                               rpad(nvl(v_dir_beneficiario, ' '), 100) ||
                               rpad(nvl(v_nom_banco, ' '), 100)||
                               rpad(nvl(v_nom_bco_corresponsal, ' '), 100) ||
                               rpad(nvl(v_nro_cta_referencia, ' '), 30) ||
                               rpad(nvl(v_cod_pais, 0), 5) ||
                               rpad(nvl(v_cod_ciudad, 0), 5) ||
                               rpad(nvl(v_cod_bco_corresponsal, 0), 5) ||
                               rpad(nvl(v_pai_bco_corresponsal, 0), 5) ||
                               rpad(nvl(v_cod_mon_credito, ' '), 5) ||
                               rpad(nvl(v_nro_contrato, 0), 10) ||
                               rpad(nvl(v_tip_cargo, ' '), 5) ||
                               rpad(nvl(v_plazo, 0), 5) ||
                               rpad(nvl(v_tip_motivo, ' '), 5) ||
                               rpad(nvl(v_tip_fondo, ' '), 5) ||
                               rpad(nvl(v_tip_financiacion, ' '), 5)||
                               rpad(nvl(v_cod_swift, ' '), 20)||
                               rpad(nvl(v_cod_pai_beneficiario, 0), 5)||
                               rpad(nvl(v_cod_ciu_beneficiario, 0), 5)||
                               rpad(nvl(v_ref_beneficiario,' '), 300)||
                               rpad(nvl(v_swi_bco_corresponsal, ' '), 20) ||
                               rpad(nvl(v_ciu_bco_corresponsal, 0), 5) ||
                               rpad(nvl(v_ord_pago, ' '), 20);

               lp_reg_operacion(v_nro_cta_debito,
                                v_cod_mon_debito,
                                v_mto_debito,
                                NULL,
                                NULL,
                                'Cod.Swift',
                                v_cod_swift,
                                'Cod.Banco',
                                v_cod_banco,
                                v_observaciones,
                                NULL, --dirIp
                                '000', -- codRespuesta
                                v_usuario.codigopersona,
                                v_cod_operacion,
                                v_nro_documento,
                                p_codigoCanal,
                                '0',
                                v_usuario.codigoempresa,
                                v_parametros);
            ELSIF v_modo = 'A' THEN
               pal_tra.pr_ins_mov_tra_hb(v_nro_cta_debito,
                                         v_cod_mon_credito, --Moneda Transferencia
                                         v_plazo,           --Plazo de La Transferencia
                                         v_mto_credito,     --Monto de la Transferencia
                                         v_nro_contrato,    --Nro de Operación Pre-pactada
                                         v_tip_cargo,       --'OUR'/'BEN'
                                         v_exonerado,       --'S'/'N'
                                         v_cot_credito,     --Cotización de Moneda de Transferencia
                                         v_cot_debito,      --Cotización de Moneda de contra partida
                                         v_es_mov_noc,      --Si es movimiento nocturno
                                         v_nro_documento,   --numero de documento del movimiento
                                         v_nro_documento2,  --numero de documento para el Movimiento
                                         v_cod_respuesta,
                                         v_msj_error);  --Respuesta 0 sino hubo errores
               IF v_cod_respuesta <> 0 THEN
                  lp_err_movimientos;
                  v_msj_bitacora := substr(v_msj_bitacora || ', pr_ins_mov_tra_hb: [' || v_msj_error || ']', 1, 1000);
               END IF;

               IF v_retorno.error = 'N' THEN
                  v_nom_solicitante := TRIM(fue_obt_nom_persona(nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona)));
                  v_dir_solicitante := TRIM(fue_obt_dir_principa(nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona)));
                  v_tel_solicitante := TRIM(fue_obt_tel_principa(nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona)));
                  pre_obt_ciu_pais(nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona),
                                   v_cod_pai_solicitante,
                                   v_des_pai_solicitante,
                                   v_cod_ciu_solicitante,
                                   v_nom_ciu_solicitante);

                  IF nvl(v_cod_banco, 0) <> 0 THEN
                     v_nom_banco := substr(TRIM(fug_obt_des_banco(v_cod_banco)), 1, 100);
                  END IF;

                  -- archivo adjunto
                  lp_ins_archivo;

                  pal_tra.pr_ins_tra_hb(v_nro_referencia,
                                        v_nro_documento,
                                        v_cod_ofi_debito, --p_cod_oficina
                                        v_fec_operacion, --p_fec_operacion
                                        v_cod_mon_credito, --p_cod_moneda,
                                        v_mto_credito, --p_monto
                                        v_cod_banco, -- p_cod_banco
                                        v_nom_banco, --p_nom_banco
                                        v_cod_pais, --p_cod_pai_banco
                                        v_cod_ciudad, --p_cod_ciu_banco
                                        null, --p_cod_aba_banco
                                        v_cod_swift, --p_cod_swi_banco
                                        nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona), --p_cod_per_solicitante
                                        v_nom_solicitante, --p_nom_solicitante
                                        v_dir_solicitante, --p_dir_solicitante
                                        v_tel_solicitante, --p_tel_solicitante
                                        v_cod_pai_solicitante, --p_cod_pai_solicitante
                                        v_cod_ciu_solicitante, --p_cod_ciu_solicitante
                                        null, --p_cod_per_beneficiario
                                        v_nom_beneficiario, --p_nom_beneficiario
                                        v_dir_beneficiario, --p_dir_beneficiario
                                        null, --p_tel_beneficiario
                                        v_cod_pai_beneficiario, -- p_cod_pai_beneficiario
                                        v_cod_ciu_beneficiario, --p_cod_ciu_beneficiario
                                        v_nro_cta_referencia, --p_nro_cta_referencia
                                        null, --p_fec_recepcion
                                        null, --p_cod_rubro
                                        v_plazo, --p_plazo
                                        v_ref_beneficiario,
                                        null, --p_cod_uid_banco
                                        v_tip_cargo, --p_tip_cargo
                                        v_cod_bco_corresponsal, --p_cod_bco_cor_contra
                                        v_nom_bco_corresponsal, --p_nom_bco_cor_contra
                                        v_swi_bco_corresponsal, --p_cod_swi_bco_contra
                                        v_pai_bco_corresponsal, --p_cod_pai_bco_contra
                                        v_ciu_bco_corresponsal, --p_cod_ciu_bco_contra
                                        null, --p_nom_ciu_beneficiario
                                        v_nom_ciu_solicitante, --p_nom_ciu_solicitante
                                        null, --p_nro_doc_beneficiario
                                        v_fec_actual, --p_fec_valor
                                        v_tip_fondo,
                                        v_tip_motivo,
                                        v_tip_financiacion,
                                        v_cod_tip_referencia,
                                        v_observaciones,
                                        v_mto_cargo,
                                        v_nro_documento2,
                                        v_ord_pago,
                                        v_nro_cta_debito,
                                        v_cod_respuesta);
                  IF v_cod_respuesta <> 0 THEN
                     lp_err_transferencias;
                     v_msj_bitacora := substr(v_msj_bitacora || ', pr_ins_tra_hb: [' || v_cod_respuesta || ']', 1, 800);
                  END IF;
                  -- si no hubo errores y es un motivo a notificar a DNA
                  IF v_retorno.error = 'N' AND v_val_dna = 'S' THEN
                     pal_tra.pr_env_reg_tra_dna(v_nro_referencia,
                                                v_cod_tip_referencia,
                                                null, -- ref. externa IT
                                                v_cod_respuesta,
                                                v_msj_error);
                     -- validamos la respuesta
                     v_msj_bitacora := substr(v_msj_bitacora || ', envdna:['||v_cod_respuesta||'-'||v_msj_error||']', 1, 1000);
                     lp_err_dna;
                  END IF;

                  IF v_retorno.error = 'N' THEN
                       /*Notificar evento*/
                      -- Notificacion al debito
                      BEGIN
                         v_res_notificacion:=PAW_NOT.fu_not_transferencias(v_nro_cta_debito, v_mto_debito, v_cod_mon_debito, 'D', v_fec_proceso);
                      EXCEPTION
                         WHEN OTHERS THEN
                            NULL;
                      END;
                     lp_reg_operacion(v_nro_cta_debito,
                                      v_cod_mon_debito,
                                      v_mto_debito,
                                      NULL,
                                      1,
                                      'Cod.Swift',
                                      v_cod_swift,
                                      'Cargo',
                                      v_mto_cargo,
                                      'Pagado - Yaguarete',
                                      v_res_notificacion, --dirIp
                                      '000', -- codRespuesta
                                      v_usuario.codigopersona,
                                      v_cod_operacion,
                                      v_nro_documento,
                                      p_codigoCanal,
                                      '0',
                                      v_usuario.codigoempresa);
                     v_retorno.nroDocumento := v_nro_documento;
                  END IF;
               END IF;
            ELSIF v_modo <> 'V' THEN
               paw_uti.pr_mensajeUsuario(TRI_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
         END IF;
      ELSIF v_modo = 'G' THEN
         -- guardar comprobante, soft-token
         v_nro_documento2 := paw_uti.depurarNumerico(p_ordenPago, 15);
         lp_ins_archivo;
         IF pag_gen.FU_ES_PER_FISICA(nvl(v_usuario.codigoEmpresa, v_usuario.codigoPersona)) = 'S' THEN
           --llamar a la funcion aqui
           PRG_ENV_MAIL_TRA_INT(v_nro_documento2);
         END IF;
      ELSE
         paw_uti.pr_mensajeUsuario(TRI_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      END IF;

      IF v_retorno.error = 'S' THEN
         v_salida := paw_uti.BITACORA_ERROR;
      ELSE
         v_salida := paw_uti.BITACORA_SALIDA;
      END IF;
      paw_uti.pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora||' '||paw_uti.fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), v_salida);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(paw_uti.MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usuario.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usuario.codigoEmpresa, v_msj_bitacora || ', ORA: [' || SQLERRM || '] ' || paw_uti.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
   END;

   -- Validacion y confirmacion de recaudaciones
   FUNCTION fu_recaudaciones(p_sesion                 IN VARCHAR2,
                             p_codigoCanal            IN VARCHAR2,
                             p_modo                   IN VARCHAR2,
                             p_cuentaCredito          IN VARCHAR2,
                             p_fechaOperacion         IN DATE,
                             p_cantidad               IN NUMBER,
                             p_cuentasDebito          IN CLOB,
                             p_claveTransaccional     IN VARCHAR2,
                             p_claveToken             IN VARCHAR2) RETURN typ_recaudaciones IS
      -- datos recibidos
      v_modo             VARCHAR2(1) := substr(p_modo, 1, 1); -- modo de control L:ABM V:ARCHIVO
      v_cod_ente         ge_entes.cod_ente%type;
      v_cantidad         NUMBER;
      v_lugar            VARCHAR2(100);
      v_cod_operacion    VARCHAR2(3) := '090';
      v_usu_sesion       typ_validarsesion;
      v_msj_caja         typ_mensajeCaja;
      v_retorno          typ_recaudaciones := typ_recaudaciones();
      v_detalle          typ_detalleRecaudacion := typ_detalleRecaudacion();
      v_lista            typ_listaDetalleRecaudacion := typ_listaDetalleRecaudacion();
      v_permiso          typ_obtenerPermisos;
      v_can_creditos     NUMBER := 0;
      v_msj_bitacora     VARCHAR2(500) := 'modo:'||v_modo||', cant:'||p_cantidad;
      v_dir_correo       ge_par_dinamicos.val_parametro%TYPE;
      v_cod_tra_padre    ge_transacciones.cod_transaccion%TYPE;
      v_nro_archivo      NUMBER(10); -- Nro de archivo a agrupar
      v_pos_ant          NUMBER(8) := 1;
      v_pos_ant_proc     NUMBER(8);
      v_pos_nvo          NUMBER(8);
      v_pos_nvo_proc     NUMBER(8);
      v_registro         VARCHAR2(350);
      v_for_archivo      VARCHAR2(100);
      v_fec_operacion    ge_pag_recaudaciones.fec_operacion%TYPE;
      v_nro_cta_debito   ge_pag_recaudaciones.nro_cta_debito%TYPE;
      v_denominacion     ge_pag_recaudaciones.denominacion%TYPE;
      v_nro_cta_credito  ge_pag_recaudaciones.nro_cta_credito%TYPE;
      v_cod_moneda       ge_pag_recaudaciones.cod_moneda%TYPE;
      v_monto            ge_pag_recaudaciones.monto%TYPE;
      v_nro_factura      ge_pag_recaudaciones.nro_factura%TYPE;
      v_tip_cobranza     ge_pag_recaudaciones.tip_cobranza%TYPE;
      v_errores          NUMBER := 0;
      v_msj_respuesta    typ_mensajerespuesta := typ_mensajerespuesta;
      v_tot_credito      bw_mov_pendientes.monto%TYPE := 0;
      v_nro_documento    VARCHAR2(15);
      v_cod_error        NUMBER;

      PRO_FEC_PAG_INV       CONSTANT VARCHAR2(15) := 'PRO_FEC_PAG_INV';
      FEC_PAG_EXCEDID       CONSTANT VARCHAR2(15) := 'FEC_PAG_EXCEDID';
      FEC_PAG_NOHABIL       CONSTANT VARCHAR2(15) := 'FEC_NOHABIL';
      SAL_PER_SIN_AUT       CONSTANT VARCHAR2(15) := 'SAL_PER_SIN_AUT'; -- perfil sin autorizacion para pagos
      SAL_ERR_DATOS         CONSTANT VARCHAR2(15) := 'SAL_ERR_DATOS';   -- datos incorrectos en la carga
      SAL_DAT_ENT_DUPLICADA CONSTANT VARCHAR2(15) := 'SAL_DAT_ENT_DUP'; -- datos de ente duplicada
      SAL_ERR_OBT_DAT_ENTES CONSTANT VARCHAR2(15) := 'SAL_ERR_DAT_ENT'; -- error al obtener datos de ente
      SAL_MAX_CAN_DEB_INVAL CONSTANT VARCHAR2(15) := 'SAL_MAX_CRE_INV'; -- cantidad de creditos excedido
      SAL_CTA_CRE_TERCERO   CONSTANT VARCHAR2(15) := 'CTA_CRE_INVALID'; -- cta credito invalida
      SAL_PAR_INVALIDO      CONSTANT VARCHAR2(15) := 'VAL_PENTRADA';
      SAL_PED_DUPLICADO     CONSTANT VARCHAR2(15) := 'SAL_PED_DUPLICA'; -- pedido duplicado, aviso
      OPE_NO_PERMITIDA      CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      SAL_FMT_INCORRECTO    CONSTANT VARCHAR2(15) := 'SAL_FMT_INCORRE';
      v_mensaje             VARCHAR2(15) := MSG_ERROR;

      -- monedas disponibles para recaudacion por ente
      CURSOR c_monedas(p_cod_persona IN ba_personas.cod_persona%TYPE,
                       p_cod_ente    IN ge_entes.cod_ente%TYPE,
                       p_nro_cuenta  IN ge_cuentas.nro_cuenta%TYPE) IS
         SELECT c.cod_moneda
           FROM ge_par_entes a, ge_cuentas c, ge_cta_clientes b
          WHERE a.cod_ente = p_cod_ente
            AND b.cod_persona = p_cod_persona
            AND c.cod_modulo IN (3, 4)
            AND c.cod_modalidad IN (31, 41, 334)
            AND c.nro_cuenta = TRIM(a.val_parametro)
            AND c.nro_cuenta = b.nro_cuenta
            AND b.relacion = 'P'
            AND c.nro_cuenta = nvl(p_nro_cuenta, c.nro_cuenta)
            AND a.parametro LIKE 'NRO_CTA_RECAUDADORA_%'
            AND c.estado NOT IN ('X', 'C', 'P')
            AND a.val_parametro IS NOT NULL;
      -- detalles de cuentas a debitar
      CURSOR c_cta_recaudaciones(p_cod_moneda IN ba_monedas.cod_moneda%type) IS
         SELECT t.nro_cta_debito, c.denominacion
           FROM ge_cta_deb_recaudaciones t, ge_cuentas c
          WHERE t.cod_ente = v_cod_ente
            AND t.cod_moneda = p_cod_moneda
            AND t.activo = 'S'
            AND t.nro_cta_debito = c.nro_cuenta;

      -- detalles de pago
      CURSOR c_recaudaciones_tmp(p_nro_archivo IN NUMBER) IS
         SELECT t.fec_operacion, t.nro_cta_debito, t.denominacion, t.nro_cta_credito, t.monto,
                t.nro_factura, t.tip_cobranza, m.descripcion, 0 cod_error, 'Aprobado' msj_error
           FROM ge_pag_recaudaciones_tmp t, ge_cuentas c, ge_modalidades m
          WHERE t.cod_ente = v_cod_ente
            AND t.nro_archivo = p_nro_archivo
            AND nvl(t.estado, 'x') <> 'E'
            AND trunc(t.fec_insercion) = trunc(SYSDATE)
            AND t.nro_cta_debito = c.nro_cuenta
            AND c.cod_modulo = m.cod_modulo
            AND c.cod_modalidad = m.cod_modalidad
          UNION
         SELECT t.fec_operacion, t.nro_cta_debito, t.denominacion, t.nro_cta_credito, t.monto,
                t.nro_factura, t.tip_cobranza, NULL descripcion, e.cod_error, e.msj_error
           FROM ge_pag_recaudaciones_tmp t, ge_pag_recaudaciones_err e
          WHERE t.cod_ente = v_cod_ente
            AND t.nro_archivo = p_nro_archivo
            AND nvl(t.estado, 'x') = 'E'
            AND trunc(t.fec_insercion) = trunc(SYSDATE)
            AND e.cod_ente = t.cod_ente
            AND e.nro_archivo = t.nro_archivo
            AND e.nro_cta_debito = t.nro_cta_debito
            AND e.nro_cta_credito = t.nro_cta_credito
            AND e.monto = t.monto
            AND trunc(e.fec_insercion) = trunc(t.fec_insercion);
   BEGIN
      -- 1. valido la clave del cliente
      v_lugar := 'Validacion de la clave';
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);
      -- 2. verifica el canal de origen
      v_lugar := 'Validacion de la caja';
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- 3. Validamos los modos
      v_lugar := 'Validacion de modo';
      IF v_modo NOT IN ('C', 'V', 'L', 'D') THEN
         pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 4. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_lugar := 'Control de permisos';
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      v_msj_bitacora := v_msj_bitacora||', perf: ' || v_usu_sesion.codigoPerfil;
      IF v_permiso.error = 'S' THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
         pr_mensajeUsuario(SAL_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- 5. Se cargan los parametros recibidos
      v_lugar    := 'Datos del parametro';
      v_cantidad := p_cantidad;

      IF v_cantidad > paw_bce.v_max_imp_archivo THEN
         pr_mensajeUsuario(SAL_MAX_CAN_DEB_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 6. Verifico si la persona tiene el servicio de recaudaciones
      v_lugar := 'Datos del Ente';
      IF v_retorno.error = 'N' THEN
         BEGIN
            SELECT a.cod_ente, fug_obt_parentes(a.cod_ente, 'COD_TRA_PADRE'), fug_obt_parentes(a.cod_ente, 'DIR_MAIL_SR'),
                   nvl(fug_obt_parentes(a.cod_ente, 'REFERENCIA_TXT_REC'), 'PAG_SER_RECAUDACIONES')
              INTO v_cod_ente, v_cod_tra_padre, v_dir_correo, v_for_archivo
              FROM ge_entes a
             WHERE a.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
               AND a.tipo = 'SR'
               AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO_SR') = 'S'
               AND fug_obt_parentes(a.cod_ente, 'HAB_HOMEBANKING_SR') = 'S';
            v_msj_bitacora :=  v_msj_bitacora || ', codEnte:' || v_cod_ente;
         EXCEPTION
            WHEN too_many_rows THEN
               pr_mensajeUsuario(SAL_DAT_ENT_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            WHEN OTHERS THEN
               pr_mensajeUsuario(SAL_ERR_OBT_DAT_ENTES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
         END;
      END IF;

      IF v_modo NOT IN ('V', 'D') THEN
         v_nro_cta_credito := depurarAlfanumerico(p_cuentaCredito, 15);
         v_fec_operacion   := p_fechaOperacion;
         BEGIN
            SELECT c.cod_moneda
              INTO v_cod_moneda
              FROM ge_cuentas c
             WHERE c.nro_cuenta = v_nro_cta_credito;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               pr_mensajeUsuario(SAL_PAR_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora|| ', cta_cre: ' || v_nro_cta_credito||' ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora|| ', cta_cre: ' || v_nro_cta_credito||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
         END;
      END IF;
      -- lista de cuentas debitables (para carga manual)
      IF v_modo = 'D' THEN
         v_nro_cta_credito := depurarAlfanumerico(p_cuentaCredito, 15);
         FOR ct IN c_monedas(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), v_cod_ente, v_nro_cta_credito) LOOP
            FOR de IN c_cta_recaudaciones(ct.cod_moneda) LOOP
               v_can_creditos := v_can_creditos + 1;
               v_lugar := 'Cargando detalle ' || v_can_creditos || ', mon' || v_cod_moneda;
               v_detalle.numeroCuentaDebito  := substr(de.nro_cta_debito, 1, 15);
               v_detalle.denominacion        := substr(de.denominacion, 1, 100);
               v_detalle.descripcionCuenta   := NULL;
               v_detalle.monto               := NULL;
               v_detalle.estado              := NULL;
               v_detalle.descripcionEstado   := NULL;
               v_detalle.numeroFactura       := NULL;
               v_detalle.tipoCobranza        := NULL;
               v_detalle.descripcionCobranza := NULL;
               v_detalle.numeroDocumento     := NULL;
               v_detalle.codigoRespuesta     := NULL;
               v_detalle.mensajeRespuesta    := NULL;
               v_detalle.fechaOperacion      := NULL;
               v_detalle.numeroCuentaCredito := NULL;
               v_detalle.codigoMoneda        := ct.cod_moneda;

               v_lista.extend;
               v_lista(v_lista.count) := v_detalle;
            END LOOP;
         END LOOP;
         v_retorno.cantidadCuentas    := v_can_creditos;
         v_retorno.listaCuentasDebito := v_lista;
         v_msj_bitacora := v_msj_bitacora || ', can_cre:' || v_can_creditos;

         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora|| ', cta_cre: ' || v_nro_cta_credito||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
         RETURN v_retorno;
      END IF;
      v_mensaje  := SAL_FMT_INCORRECTO;
      FOR i IN 1 .. v_cantidad LOOP
         v_lugar := 'leyendo los registro ' || i;
         v_pos_nvo  := instr(p_cuentasDebito, '~', 1, i);
         v_registro := substr(p_cuentasDebito, v_pos_ant, v_pos_nvo - v_pos_ant);
         v_pos_ant  := v_pos_nvo + 1;
         v_pos_ant_proc := 1;
         IF p_modo <> 'V' THEN -- formato fijo
            v_pos_nvo_proc     := instr(v_registro, ';', 1, 1);
            v_nro_cta_debito   := substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc); v_pos_ant_proc  := v_pos_nvo_proc + 1;
            v_pos_nvo_proc     := instr(v_registro, ';', 1, 2);
            v_denominacion     := substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc); v_pos_ant_proc  := v_pos_nvo_proc + 1;
            v_pos_nvo_proc     := instr(v_registro, ';', 1, 3);
            v_monto            := nvl(to_number(REPLACE(TRIM(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc)), ',', '.')), 0); v_pos_ant_proc  := v_pos_nvo_proc + 1;
            v_pos_nvo_proc     := instr(v_registro, ';', 1, 4);
            v_nro_factura      := substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc); v_pos_ant_proc  := v_pos_nvo_proc + 1;
            v_pos_nvo_proc     := instr(v_registro, ';', 1, 5);
            v_tip_cobranza     := substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc); v_pos_ant_proc  := v_pos_nvo_proc + 1;
         ELSE -- formato segun archivo
            IF i = 1 THEN
               -- datos repetitivos, solo se leen de la primera linea
               v_fec_operacion    := to_date(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_RECAUDACIONES_TMP', v_registro, 'FEC_OPERACION'), 'dd/mm/yyyy');
               v_nro_cta_credito  := depurarAlfanumerico(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_RECAUDACIONES_TMP', v_registro, 'NRO_CTA_CREDITO'), 15);
               v_cod_moneda       := depurarAlfanumerico(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_RECAUDACIONES_TMP', v_registro, 'COD_MONEDA'), 3);
            END IF;
            v_nro_cta_debito   := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_RECAUDACIONES_TMP', v_registro, 'NRO_CTA_DEBITO');
            v_denominacion     := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_RECAUDACIONES_TMP', v_registro, 'DENOMINACION');
            v_monto            := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_RECAUDACIONES_TMP', v_registro, 'MONTO');
            v_nro_factura      := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_RECAUDACIONES_TMP', v_registro, 'NRO_FACTURA');
            v_tip_cobranza     := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_RECAUDACIONES_TMP', v_registro, 'TIP_COBRANZA');
         END IF;

         IF i = 1 THEN
            -- validamos la fecha de pago
            BEGIN
               v_cod_error := pag_rec.fu_val_fec_pago(v_cod_ente, v_fec_operacion);
            EXCEPTION
               WHEN OTHERS THEN
                  v_msj_bitacora := v_msj_bitacora || ', ORA [' || SUBSTR(SQLERRM, 1, 200)||']';
                  v_cod_error := -99;
            END;
            IF v_cod_error <> 0 THEN -- fecha invalida, dejamos de reccorrer
               CASE v_cod_error
                  WHEN -1 THEN
                     pr_mensajeUsuario(FEC_PAG_EXCEDID, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  WHEN -2 THEN
                     pr_mensajeUsuario(PRO_FEC_PAG_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  WHEN -3 THEN
                     pr_mensajeUsuario(FEC_PAG_NOHABIL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  ELSE
                     pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END CASE;
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', fu_val_fec_pago: '||v_cod_error|| ', fecOpe: ' || v_fec_operacion||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
            -- obtenemos la secuencia de archivo a procesar
            v_nro_archivo := pag_rec.fu_obt_sig_num_archivo(v_cod_ente, v_fec_operacion);
            v_msj_bitacora := v_msj_bitacora || ', nro_arc:' || v_nro_archivo;
         END IF;
         -- depuracion de lineas
         v_denominacion   := depurarTextos(v_denominacion, 100);
         v_nro_factura    := depurarTextos(v_nro_factura, 60);
         v_nro_cta_debito := depurarAlfanumerico(v_nro_cta_debito, 15);
         v_tip_cobranza   := depurarAlfanumerico(v_tip_cobranza, 3);

         INSERT INTO ge_pag_recaudaciones_tmp
            (cod_ente, fec_operacion, nro_archivo, nro_cta_debito,
             denominacion, nro_cta_credito, cod_moneda, monto,
             nro_factura, tip_cobranza)
         VALUES
            (v_cod_ente, v_fec_operacion, v_nro_archivo, v_nro_cta_debito,
            v_denominacion, v_nro_cta_credito, v_cod_moneda, v_monto,
            v_nro_factura, v_tip_cobranza);
      END LOOP; -- end (FOR i IN 1 .. v_cantidad)
      v_mensaje := MSG_ERROR;
      v_msj_bitacora := v_msj_bitacora || ', nro_cta: ' ||v_nro_cta_credito||', mon:'||v_cod_moneda||', fec_ope:'||to_char(v_fec_operacion, 'dd/mm/yyyy');
      -- validar que la cuenta credito pertenezca al ente
      IF lf_cta_valida(v_nro_cta_credito, NULL, v_usu_sesion, v_msj_respuesta) = 'N' THEN
         IF nvl(v_msj_respuesta.error, 'N') = 'N' THEN
            pr_mensajeUsuario(SAL_CTA_CRE_TERCERO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         ELSE
            v_retorno.error                := v_msj_respuesta.error;
            v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
            v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
         END IF;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora|| ' ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- se validan los datos temporales
      v_lugar := 'validando datos temporales';
      pag_rec.pr_val_temporal(v_cod_ente, v_fec_operacion, v_nro_archivo, 'N');

      -- se verifican si existen errores para el numero de archivo
      v_lugar := 'verificacion errores';
      SELECT COUNT(0)
        INTO v_errores
        FROM ge_pag_recaudaciones_tmp t
       WHERE t.cod_ente = v_cod_ente
         AND t.nro_archivo = v_nro_archivo
         AND nvl(t.estado, 'x') = 'E'
         AND trunc(t.fec_operacion) = trunc(v_fec_operacion);
      v_msj_bitacora := v_msj_bitacora || ', can_err:' || v_errores;
      IF v_errores > 0 THEN
         pr_mensajeUsuario(SAL_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      END IF;

      v_retorno.codigoMoneda   := v_cod_moneda;
      v_retorno.fechaOperacion := v_fec_operacion;
      v_retorno.numeroCuenta   := v_nro_cta_credito;
      v_retorno.codigoEnte     := v_cod_ente;

      v_lugar := 'detalle cuenta credito';
      SELECT substr(c.denominacion, 1, 100), substr(m.descripcion, 1, 35)
        INTO v_retorno.denominacionCuenta, v_retorno.descripcionCuenta
        FROM ge_cuentas c, ge_modalidades m
       WHERE c.nro_cuenta = v_nro_cta_credito
         AND c.cod_modulo = m.cod_modulo
         AND c.cod_modalidad = m.cod_modalidad;

      FOR de IN c_recaudaciones_tmp(v_nro_archivo) LOOP
         v_can_creditos := v_can_creditos + 1;
         v_lugar := 'Registrando registro ' || v_can_creditos;
         -- armo el detalle por cuenta
         v_detalle.numeroCuentaDebito  := substr(de.nro_cta_debito, 1, 15);
         v_detalle.denominacion        := substr(de.denominacion, 1, 100);
         v_detalle.descripcionCuenta   := substr(de.descripcion, 1, 35);
         v_detalle.monto               := de.monto;
         v_detalle.estado              := NULL;
         v_detalle.descripcionEstado   := 'Pendiente';
         v_detalle.numeroFactura       := substr(de.nro_factura, 1, 60);
         v_detalle.tipoCobranza        := substr(de.tip_cobranza, 1, 3);
         v_detalle.descripcionCobranza := fue_obt_des_refcodes('TIP_COB_RECAUDACION', de.tip_cobranza);
         v_detalle.numeroDocumento     := NULL;
         v_detalle.codigoRespuesta     := de.cod_error;
         v_detalle.mensajeRespuesta    := substr(de.msj_error, 1, 400);
         v_tot_credito                 := v_tot_credito + de.monto;

         v_lista.extend;
         v_lista(v_lista.count) := v_detalle;
      END LOOP;
      v_retorno.cantidadCuentas    := v_can_creditos;
      v_retorno.listaCuentasDebito := v_lista;
      v_msj_bitacora := v_msj_bitacora || ', can_cre:' || v_can_creditos;

      IF v_modo <> 'C' OR v_retorno.error = 'S' THEN
         DECLARE
            v_total NUMBER;
         BEGIN
            v_total := pag_rec.FU_ELI_TEMPORAL(v_cod_ente, v_nro_archivo, v_fec_operacion);
            v_msj_bitacora := v_msj_bitacora || ', eli_tmp:' || v_total;
            v_total := pag_rec.FU_ELI_ERRORES(v_cod_ente, v_nro_archivo, v_fec_operacion);
            v_msj_bitacora := v_msj_bitacora || ', eli_err:' || v_total;
         END;
      END IF;

      IF p_modo IN ('V', 'L') AND v_retorno.error = 'N' THEN
         DECLARE
            v_can_duplicado NUMBER(6) := 0;
         BEGIN
            SELECT COUNT(*)
              INTO v_can_duplicado
              FROM bw_mov_pendientes a
             WHERE a.cod_per_principal = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
               AND a.nro_cuenta = v_nro_cta_credito
               AND a.monto = v_tot_credito
               AND a.cantidad = v_can_creditos
               AND a.estado IN ('P', 'C')
               AND a.cod_tip_mensaje = v_cod_operacion
               AND trunc(a.fec_insercion) = trunc(SYSDATE);

            IF v_can_duplicado > 0 THEN
               pr_mensajeUsuario(SAL_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
         EXCEPTION
            WHEN OTHERS THEN
               NULL;
         END;
      END IF;
      /*
      -- control de limites
      IF v_retorno.error = 'N' OR v_retorno.nombreRespuesta = 'SAL_PED_DUPLICA' THEN
         v_resLimite := fu_obtenerLimite(v_usu_sesion, v_cod_operacion, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), v_nro_cta_credito, v_cod_moneda, 503, v_cod_tra_padre, v_tot_credito, v_modo, v_cod_ente);
         IF v_resLimite.error = 'S' THEN
            v_retorno.error                := 'S';
            v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
            v_retorno.nombreRespuesta      := v_resLimite.nombreRespuesta;
         END IF;
         v_retorno.respuestaLimite := v_resLimite.codRespuesta;
         v_msj_bitacora := v_msj_bitacora||', resLimite:'||v_resLimite.codRespuesta;
      END IF;
      -- validacion de claves segun limite
      IF v_retorno.error = 'N' THEN
         v_msj_respuesta.error := 'N';
         IF v_modo IN ('C', 'A') THEN
            IF v_resLimite.codRespuesta IN ('10', '11') THEN
               -- clave transaccional requerida
               v_msj_respuesta := lf_obt_cla_validar(p_claveTransaccional, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, 'T');
            END IF;

            IF v_msj_respuesta.error = 'N' THEN
               IF v_resLimite.codRespuesta IN ('01', '11') THEN
                  -- token requerido
                  v_msj_respuesta := paw_seg.fu_obt_tok_validar(p_claveToken, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, p_modo);
               END IF;
            END IF;

            IF v_msj_respuesta.error = 'S' THEN
               v_retorno.error := 'S';
               v_retorno.nombreRespuesta := v_msj_respuesta.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
            END IF;
         END IF;
      END IF;*/

      IF p_modo = 'C' AND v_retorno.error = 'N' THEN -- es confirmacion
         v_lugar := 'Insertando operacion pendiente';
         -- si no hubo errores...
         --- inserto el movimiento pendiente de autorizacion
         SELECT s_nro_documento.NEXTVAL
           INTO v_nro_documento
           FROM dual;

         INSERT INTO bw_mov_pendientes
            (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cantidad, etiqueta, dato, etiqueta2, dato2, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, referencia)
         VALUES
            (v_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_credito, v_cod_moneda, 'Servicio de Recaudaciones', v_tot_credito, v_can_creditos, 'Ente', v_cod_ente, 'Fecha Pago', to_char(v_fec_operacion, 'dd/mm/yyyy'), 'P', v_can_aut_requeridas, v_can_aut_requeridas, v_usu_sesion.codigoPersona, v_nro_archivo);

         v_retorno.numeroDocumento := v_nro_documento;
         v_retorno.cantidadAutorizadores := v_can_aut_requeridas;

         v_lugar := 'Registrando operacion';
         lp_reg_operacion(v_nro_cta_credito, --p_nro_cuenta
                          v_cod_moneda, --p_cod_moneda
                          v_tot_credito, --p_monto
                          NULL, --p_nro_cta_contra
                          v_can_creditos, --p_cantidad
                          'Ente', --p_etiqueta
                          v_cod_ente, --p_dato
                          'Fecha Operacion',
                          v_fec_operacion,
                          'Yaguarete',
                          NULL,
                          '000',
                          v_usu_sesion.codigoPersona,
                          v_cod_operacion,
                          v_nro_documento,
                          p_codigoCanal,
                          p_sesion,
                          v_usu_sesion.codigoEmpresa);
      END IF;

      -- registro del movimiento
      IF v_retorno.error = 'S' THEN
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      ELSE
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      END IF;
      -- siempre se responde con los detalles, sea o no sea con errores
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(v_mensaje, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', lug: ' || v_lugar || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 100) || '] ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END; -- recaudaciones

   FUNCTION fu_obtenerHisRecaudaciones(p_sesion        IN VARCHAR2,
                                       p_codigoCanal   IN VARCHAR2,
                                       p_cuentaCredito IN VARCHAR2 DEFAULT NULL,
                                       p_cuentaDebito  IN VARCHAR2 DEFAULT NULL,
                                       p_numeroFactura IN VARCHAR2 DEFAULT NULL,
                                       p_fechaInicial  IN DATE DEFAULT NULL,
                                       p_fechaFinal    IN DATE DEFAULT NULL,
                                       p_estado        IN VARCHAR2 DEFAULT NULL) RETURN typ_recaudaciones IS
      -- datos recibidos
      v_cod_ente         ge_entes.cod_ente%type;
      v_cod_operacion    VARCHAR2(3) := '090';
      v_usu_sesion       typ_validarsesion;
      v_msj_caja         typ_mensajeCaja;
      v_retorno          typ_recaudaciones := typ_recaudaciones();
      v_detalle          typ_detalleRecaudacion := typ_detalleRecaudacion();
      v_lista            typ_listaDetalleRecaudacion := typ_listaDetalleRecaudacion();
      v_permiso          typ_obtenerPermisos;
      v_can_detalles     NUMBER := 0;
      v_msj_bitacora     VARCHAR2(500) := 'historico - fec_ini:' || p_fechaInicial ||', fec_fin:'||p_fechaFinal;
      v_nro_cta_debito   ge_pag_recaudaciones.nro_cta_debito%TYPE;
      v_nro_cta_credito  ge_pag_recaudaciones.nro_cta_credito%TYPE;
      v_nro_factura      ge_pag_recaudaciones.nro_factura%TYPE;
      v_fec_inicial      DATE := nvl(p_fechaInicial, pag_cal.fu_obt_fec_actual(9)-90);
      v_fec_final        DATE := nvl(p_fechaFinal, pag_cal.fu_obt_fec_actual(9));

      SAL_PER_SIN_AUT       CONSTANT VARCHAR2(15) := 'SAL_PER_SIN_AUT'; -- perfil sin autorizacion para pagos

      -- detalles de pago
      CURSOR c_recaudaciones(p_cod_ente    IN NUMBER,
                             p_cta_debito  IN VARCHAR2,
                             p_cta_credito IN VARCHAR2,
                             p_fec_inicial IN DATE,
                             p_fec_final   IN DATE,
                             p_nro_factura IN VARCHAR2) IS
         SELECT t.fec_operacion, t.nro_cta_debito, c.denominacion, t.nro_cta_credito, t.monto, t.nro_documento,
                t.nro_factura, t.tip_cobranza, 0 cod_error, 'Aprobado' msj_error, t.cod_moneda, t.estado
           FROM ge_pag_recaudaciones t, ge_cuentas c
          WHERE t.cod_ente = p_cod_ente
            AND nvl(t.estado, 'x') <> 'E'
            --AND t.nro_cta_debito = nvl(p_cta_debito, t.nro_cta_debito)
            AND
              (
               p_cta_debito is null or t.nro_cta_debito = p_cta_debito or t.nro_cta_debito LIKE '%'||p_cta_debito||'%' OR
                 c.denominacion LIKE '%'||p_cta_debito||'%'
              )
            AND (p_cta_credito IS NULL OR t.nro_cta_credito = nvl(p_cta_credito, t.nro_cta_credito))
            AND (p_nro_factura IS NULL OR t.nro_factura LIKE '%'||p_nro_factura||'%')
            AND t.nro_cta_debito = c.nro_cuenta
            AND t.fec_operacion between p_fec_inicial and p_fec_final
          UNION
         SELECT t.fec_operacion, t.nro_cta_debito, c.denominacion, t.nro_cta_credito, t.monto, t.nro_documento,
                t.nro_factura, t.tip_cobranza, e.cod_error, e.msj_error, t.cod_moneda, t.estado
           FROM ge_pag_recaudaciones t, ge_pag_recaudaciones_err e, ge_cuentas c
          WHERE t.cod_ente = p_cod_ente
            AND nvl(t.estado, 'x') = 'E'
            AND e.cod_ente = t.cod_ente
            AND e.nro_archivo = t.nro_archivo
            AND e.nro_cta_debito = t.nro_cta_debito
            AND e.nro_cta_credito = t.nro_cta_credito
            AND e.monto = t.monto
            AND e.fec_operacion = t.fec_operacion
            --AND t.nro_cta_debito = nvl(p_cta_debito, t.nro_cta_debito)
            AND
            (
               p_cta_debito is null or t.nro_cta_debito = p_cta_debito or t.nro_cta_debito LIKE '%'||p_cta_debito||'%' OR
               c.denominacion LIKE '%'||p_cta_debito||'%'
            )
            AND (p_cta_credito IS NULL OR  t.nro_cta_credito = nvl(p_cta_credito, t.nro_cta_credito))
            AND (p_nro_factura IS NULL OR t.nro_factura LIKE '%'||p_nro_factura||'%')
            AND t.nro_cta_debito = c.nro_cuenta
            AND e.nro_cta_debito = c.nro_cuenta
            AND t.fec_operacion between p_fec_inicial and p_fec_final
            order by 1 desc; -- DDEVOLUT-103 -- 06/2017 --
   BEGIN
      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- 4. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      v_msj_bitacora := v_msj_bitacora||', perf: ' || v_usu_sesion.codigoPerfil;
      IF v_permiso.error = 'S' THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      v_nro_cta_credito := depurarAlfanumerico(p_cuentaCredito, 15);
      v_nro_cta_debito  := depurarTextos(p_cuentaDebito, 15);
      v_nro_factura     := depurarTextos(p_numeroFactura, 60);
      v_msj_bitacora    := v_msj_bitacora || ', cta_deb:'||v_nro_cta_debito||', cta_cre:'||v_nro_cta_credito||', nro_fac:'||v_nro_factura;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);
      BEGIN
         SELECT a.cod_ente
           INTO v_cod_ente
           FROM ge_entes a
          WHERE a.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
            AND a.tipo = 'SR'
            AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO_SR') = 'S'
            AND fug_obt_parentes(a.cod_ente, 'HAB_HOMEBANKING_SR') = 'S';
            v_msj_bitacora :=  v_msj_bitacora || ', codEnte:' || v_cod_ente;
      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeUsuario(SAL_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;
      FOR re IN c_recaudaciones(v_cod_ente, v_nro_cta_debito, v_nro_cta_credito,
                                v_fec_inicial, v_fec_final, v_nro_factura) LOOP
         IF nvl(p_estado, re.estado) = re.estado THEN
            v_can_detalles := v_can_detalles + 1;

            -- armo el detalle por cuenta
            v_detalle.numeroCuentaDebito  := substr(re.nro_cta_debito, 1, 15);
            v_detalle.denominacion        := substr(re.denominacion, 1, 100);
            v_detalle.descripcionCuenta   := NULL;
            v_detalle.monto               := re.monto;
            v_detalle.estado              := re.estado;
            v_detalle.descripcionEstado   := substr(TRIM(fue_obt_des_refcodes('EST_SER_RECAUDACIONES', re.estado)), 1, 100);
            v_detalle.numeroFactura       := substr(re.nro_factura, 1, 60);
            v_detalle.tipoCobranza        := substr(re.tip_cobranza, 1, 3);
            v_detalle.descripcionCobranza := substr(TRIM(fue_obt_des_refcodes('TIP_COB_RECAUDACION', re.tip_cobranza)), 1, 100);
            v_detalle.numeroDocumento     := re.nro_documento;
            v_detalle.codigoRespuesta     := re.cod_error;
            v_detalle.mensajeRespuesta    := substr(re.msj_error, 1, 400);
            v_detalle.fechaOperacion      := re.fec_operacion;
            v_detalle.codigoMoneda        := substr(re.cod_moneda, 1, 3);
            v_detalle.numeroCuentaCredito := substr(re.nro_cta_credito, 1, 15);

            v_lista.extend;
            v_lista(v_lista.count) := v_detalle;
         END IF;
      END LOOP;
      v_retorno.listaCuentasDebito := v_lista;
      v_retorno.codigoEnte         := v_cod_ente;
      v_retorno.cantidadCuentas    := v_lista.count;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', can_det: '||v_can_detalles ||' '|| fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION lf_tieneProrrogaPrestamo(p_cod_persona  IN VARCHAR2,
                                     p_cod_canal    IN NUMBER,
                                     p_lis_etiqueta IN OUT typ_listaetiquetavalor) RETURN VARCHAR2 IS
      v_retorno      VARCHAR2(1)  := 'N';
      v_fec_inicio   DATE;
      v_cantidad     NUMBER;
      v_hab_prorroga VARCHAR2(1)  :=  nvl(fug_obt_pardinamico('PRO_PRE_HABILITADO'), 'S'); -- si esta habilitado la funcionalidad de prorroga de cuota de prestamo
      v_can_cuentas  NUMBER := 0;

      CURSOR c_ctas IS
         SELECT cta.nro_cuenta, pp.mto_capital, pp.cod_moneda
           FROM ge_cta_clientes cc, pr_cta_pre_can_res4 cta, pr_cta_prestamos pp
          WHERE cc.cod_persona = p_cod_persona
            AND cc.relacion = 'P'
            AND cc.cod_modulo = 6
            AND cc.nro_cuenta = cta.nro_cuenta
            AND cc.nro_cuenta = pp.nro_cuenta
            AND cta.reversado = 'N';
   BEGIN
      IF v_hab_prorroga <> 'S' OR nvl(p_cod_canal, 0) <> 999 THEN
         RETURN 'N';
      END IF;

      BEGIN
         v_fec_inicio := TO_DATE(nvl(fug_obt_pardinamico('FEC_INI_PRO_PRESTAMO'), '19/03/2020'), 'DD/MM/YYYY');
      EXCEPTION
         WHEN OTHERS THEN
            v_fec_inicio := TO_DATE('19/03/2020', 'DD/MM/YYYY');
      END;
      --BEGIN
      FOR cta IN c_ctas LOOP
         v_can_cuentas := v_can_cuentas + 1;
         paw_uti.pr_add_value(p_lis_etiqueta, 'nro_cta_'||v_can_cuentas, cta.nro_cuenta);
         paw_uti.pr_add_value(p_lis_etiqueta, 'mto_cap_'||v_can_cuentas, cta.mto_capital);
         paw_uti.pr_add_value(p_lis_etiqueta, 'cod_mon_'||v_can_cuentas, cta.cod_moneda);
      END LOOP;
      IF v_can_cuentas = 0 THEN
         v_retorno := 'N';
      ELSE
         v_retorno := 'S';
         paw_uti.pr_add_value(p_lis_etiqueta, 'tot_cuentas', v_can_cuentas);
      END IF;
      RETURN v_retorno;
   END;
   --
   FUNCTION fu_obtenerPreaprobados(p_sesion      IN VARCHAR2,
                                   p_codigoCanal IN VARCHAR2) RETURN typ_listapreaprobado IS
      v_usu_sesion       typ_validarsesion;
      v_msj_caja         typ_mensajeCaja;
      v_retorno          typ_listapreaprobado := typ_listapreaprobado();
      v_permiso          typ_obtenerPermisos;
      v_cod_operacion    VARCHAR2(3) := '100';
      v_msj_bitacora     VARCHAR2(700) := 'obtenerPreaprobados - ';
      v_pro_preaprobado  typ_preaprobado := typ_preaprobado();
      v_cod_persona      ba_personas.cod_persona%TYPE;
      v_lis_etiqueta     typ_listaEtiquetaValor := typ_listaEtiquetaValor();
      v_cod_moneda       ba_monedas.cod_moneda%TYPE;
      v_mto_maximo       ge_pro_pre_aprobados.max_monto%TYPE;
      v_val_tasa         ge_pro_pre_aprobados.val_max_tasa%TYPE;
      v_nombre           ba_cod_referencias.significado%TYPE;
      v_afinidad         ge_cli_aprobados_atm_tmp.afinidad%TYPE;
      v_sub_afinidad     ge_cli_aprobados_atm_tmp.clase%TYPE;
      v_cod_modalidad    ge_modalidades.cod_modalidad%TYPE;
      v_afi_tipos        ta_tipos.afinidad%TYPE;
      v_sub_afi_tipos    ta_tipos.sub_afinidad%TYPE;
      v_significado      ba_cod_referencias.significado%TYPE;
      v_datos            pag_pre.tp_datosCuota;
      v_cdn_url          ge_par_dinamicos.val_parametro%TYPE := nvl(fug_obt_pardinamico('URL_CDN_HOMEBANKING'), 'https://www.bbva.com.py/cdn/');
      v_listaSeguros     pag_pre.tp_lista_seguros;
      v_tmp_id_seguro    NUMBER;
      v_tmp_id_plan      NUMBER;
      v_est_modulo       ba_modulos.estado%type;
      v_tie_pre_apr      NUMBER;
      -- CN: COREDPLFD-1: 08/2016 --
      v_ofe_pla_fijo_web ge_par_dinamicos.val_parametro%TYPE := nvl(fug_obt_pardinamico('PLZ_FIJ_OFE_WEB'), 'N');
      v_ofe_pla_fijo_mob ge_par_dinamicos.val_parametro%TYPE := nvl(fug_obt_pardinamico('PLZ_FIJ_OFE_MOB'), 'N');
      v_ofe_aho_pro_web  ge_par_dinamicos.val_parametro%TYPE := nvl(fug_obt_pardinamico('AHO_PRO_OFE_WEB'), 'N');
      v_ofe_aho_pro_mob  ge_par_dinamicos.val_parametro%TYPE := nvl(fug_obt_pardinamico('AHO_PRO_OFE_MOB'), 'N');
      v_plz_max_pfd      NUMBER;
      v_plz_min_pfd      NUMBER;
      C_REF_PAG_INT      ba_cod_referencias.dominio%TYPE := 'TIP_CAPITALIZACION';
      C_PAR_MTO_MIN_PFD  ge_par_dinamicos.parametro%TYPE := 'MTO_MIN_AHO_PLZ_FIJ_DIGITAL';
      C_PAR_PLZ_MIN_PFD  ge_par_dinamicos.parametro%TYPE := 'PLZ_MIN_AHO_PLZ_FIJ_DIGITAL';
      C_PAR_PLZ_MAX_PFD  ge_par_dinamicos.parametro%TYPE := 'PLZ_MAX_AHO_PLZ_FIJ_DIGITAL';
      C_MAD_PFD          ge_modalidades.cod_modalidad%TYPE := 37;
      v_cuentas          typ_resumenCuentas;
      v_piz_mto_row      cr_piz_montos%ROWTYPE;
      v_tie_prorroga     VARCHAR2(1) := 'N';
      v_cli_residente     VARCHAR2(1);
      --
      CURSOR c_per(p_dominio IN ba_cod_referencias.dominio%TYPE) IS
        SELECT INITCAP(nvl(a.abreviatura, a.significado)) descripcion,
               to_number(a.val_minimo) codigo, a.significado
          FROM ba_cod_referencias a
         WHERE a.dominio = p_dominio
         ORDER BY 2;
   BEGIN
      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         RETURN v_retorno;
      END IF;
      v_cod_persona := nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona);
      if fug_obt_pardinamico('REG_BITACORA_BW') = 'S' then
            PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' ', BITACORA_ENTRADA);
      end if;
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
        if fug_obt_pardinamico('REG_BITACORA_BW') = 'S' then
           PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_msj_caja.error,v_msj_caja.nombreRespuesta, v_msj_caja.descripcionRespuesta,null), BITACORA_ERROR);
        end if;
         RETURN v_retorno;
      END IF;
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      v_msj_bitacora := v_msj_bitacora||', perf: ' || v_usu_sesion.codigoPerfil;
      IF v_permiso.error = 'S' THEN
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_permiso.error,v_permiso.nombreRespuesta, v_permiso.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --solo para moneda local
      v_cod_moneda := v_cod_mon_local;

     -- todo: obtener par dinamico
      v_tie_prorroga := lf_tieneProrrogaPrestamo(v_cod_persona, p_codigoCanal, v_lis_etiqueta);
      IF v_tie_prorroga = 'S' THEN
         PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_pro_preaprobado.nombreRespuesta, v_pro_preaprobado.descripcionRespuesta, v_pro_preaprobado.error);
         v_pro_preaprobado.codigoMoneda   := substr(v_cod_moneda, 1, 3);
         v_pro_preaprobado.monto          := 0;
         v_pro_preaprobado.montoMinimo    := 0;
         v_pro_preaprobado.codigoModulo   := 10;
         paw_uti.pr_add_value(v_lis_etiqueta, 'TITULO', 'EXCLUSION PROROGA');--TODO: CARGAR EN PAR DINAMICO
         v_pro_preaprobado.listaDetalles := v_lis_etiqueta;
         -- agregamos el producto al retorno
         v_retorno.extend;
         v_retorno(v_retorno.count) := v_pro_preaprobado;
      END IF;
      IF v_lis_etiqueta.count > 0 THEN
         v_lis_etiqueta.delete;
      END IF;

      -- validamos que los modulos esten abiertos
      -- 06/2017 -- Verificar que modulo no este en 1=INICIO ó 6=COPIA ATM
      v_est_modulo := pae_cnf.FU_OBT_EST_MODULO(3);
      v_msj_bitacora := v_msj_bitacora || ', est_modulo: ' || v_est_modulo;
      IF v_est_modulo NOT IN(1,6) THEN
         v_tie_pre_apr := pag_pre.fu_tie_pre_aprobado(v_cod_persona, 6, 68, 'S', v_datos);
         v_msj_bitacora := v_msj_bitacora || ', tie_pre_apr: ' || v_tie_pre_apr;
         IF v_tie_pre_apr > 0 THEN
            PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_pro_preaprobado.nombreRespuesta, v_pro_preaprobado.descripcionRespuesta, v_pro_preaprobado.error);
            v_cod_modalidad := 68;
            -- Agregamos los datos del producto
            v_pro_preaprobado.codigoMoneda   := substr(v_cod_moneda, 1, 3);
            v_pro_preaprobado.monto          := v_datos.montoMaximo;
            v_pro_preaprobado.montoMinimo    := v_datos.montoMinimo;
            v_pro_preaprobado.codigoModulo   := 6;
            --PCCFPPTC-1 Flexibilidad 16_05
            v_val_tasa := pag_pre.fu_obt_tas_interes(v_cod_moneda, 68, v_datos.plazoMinimo, v_datos.CodSubModalidad);
            paw_uti.pr_add_value(v_lis_etiqueta, 'firstInstallment', v_datos.plazoMinimo);
            paw_uti.pr_add_value(v_lis_etiqueta, 'lastInstallment', v_datos.plazoMaximo);
            paw_uti.pr_add_value(v_lis_etiqueta, 'modalityCode', 68);
            paw_uti.pr_add_value(v_lis_etiqueta, 'rate', v_val_tasa);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plz_12', v_datos.plazo12);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plz_18', v_datos.plazo18);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plz_24', v_datos.plazo24);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plz_30', v_datos.plazo30);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plz_36', v_datos.plazo36);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plz_42', v_datos.plazo42);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plz_48', v_datos.plazo48);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plz_54', v_datos.plazo54);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plz_60', v_datos.plazo60);
            paw_uti.pr_add_value(v_lis_etiqueta, 'maxFee', v_datos.montoMaxCuota);
            paw_uti.pr_add_value(v_lis_etiqueta, 'img', v_cdn_url||'loans/'||v_pro_preaprobado.codigoModulo
                  ||'_'||v_cod_modalidad||'_'||'loan.png');
            paw_uti.pr_add_value(v_lis_etiqueta, 'title', fug_obt_pardinamico('TITULO_PRODUCTO', v_pro_preaprobado.codigoModulo) ||
               ' '|| v_cod_moneda || '. '|| TRIM(REPLACE(TO_CHAR(v_datos.montoMaximo, '999,999,999,999,999'), ',', '.')));
            paw_uti.pr_add_value(v_lis_etiqueta, 'colorFuente', fug_obt_pardinamico('COLOR_FUENTE_PRODUCTO', v_pro_preaprobado.codigoModulo));
            paw_uti.pr_add_value(v_lis_etiqueta, 'colorFondo', fug_obt_pardinamico('COLOR_FONDO_PRODUCTO', v_pro_preaprobado.codigoModulo));
            paw_uti.pr_add_value(v_lis_etiqueta, 'serializacionApplication', '004');
            paw_uti.pr_add_value(v_lis_etiqueta, 'serializacionProduct', 'ppp');
            paw_uti.pr_add_value(v_lis_etiqueta, 'startDebitDays', nvl(trim(fug_obt_pardinamico('CAN_INI_DEB_PREAPROBADO', 6, 68)), '30'));
            paw_uti.pr_add_value(v_lis_etiqueta, 'endDebitDays', nvl(trim(fug_obt_pardinamico('CAN_FIN_DEB_PREAPROBADO', 6, 68)), '30'));

            v_pro_preaprobado.listaDetalles := v_lis_etiqueta;

            -- agregamos el producto al retorno
            v_retorno.extend;
            v_retorno(v_retorno.count) := v_pro_preaprobado;

            v_lis_etiqueta.delete;
         END IF;
      END IF;
      -- buscamos si tiene tarjeta preaprobada
      IF pag_pre.fu_tie_tar_aprobada(v_cod_persona, v_mto_maximo, v_afinidad, v_sub_afinidad, v_cod_moneda) = 0 THEN
         PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_pro_preaprobado.nombreRespuesta, v_pro_preaprobado.descripcionRespuesta, v_pro_preaprobado.error);

         pag_pre.pr_obt_tar_afinidad(v_sub_afinidad,
                                  v_afinidad,
                                  v_afi_tipos,
                                  v_sub_afi_tipos,
                                  v_significado);

         -- obtener la descripcion de la afinidad y la tasa nominal
         v_cod_modalidad := pag_pre.fu_obt_mad_tarjeta(v_afi_tipos, v_sub_afi_tipos);
         v_msj_bitacora := v_msj_bitacora || ', cod_mad: ' || v_cod_modalidad;
         pag_pre.pr_obt_tar_nom_tasa(v_cod_modalidad, v_afinidad, v_sub_afinidad, v_val_tasa, v_nombre);

         -- Agregamos los datos del producto
         v_pro_preaprobado.codigoMoneda   := substr(v_cod_moneda, 1, 3);
         v_pro_preaprobado.monto          := v_mto_maximo;
         v_pro_preaprobado.montoMinimo    := v_mto_maximo;
         v_pro_preaprobado.codigoModulo   := 5;

         paw_uti.pr_add_value(v_lis_etiqueta, 'afinity', v_nombre);
         paw_uti.pr_add_value(v_lis_etiqueta, 'codeAfinity', v_afinidad);
         paw_uti.pr_add_value(v_lis_etiqueta, 'subAfinity', v_sub_afinidad);
         paw_uti.pr_add_value(v_lis_etiqueta, 'rate', v_val_tasa);
         paw_uti.pr_add_value(v_lis_etiqueta, 'cardUrl', v_cdn_url||'cards/'||v_sub_afinidad||'_'||v_afinidad||'_'||'card.png');
         paw_uti.pr_add_value(v_lis_etiqueta, 'img', v_cdn_url||'cards/5_cards.png');
         paw_uti.pr_add_value(v_lis_etiqueta, 'benefUrl', fug_obt_pardinamico('BENEF_'||v_sub_afinidad||'_'||v_afinidad));
         paw_uti.pr_add_value(v_lis_etiqueta, 'title',  fug_obt_pardinamico('TITULO_PRODUCTO',  v_pro_preaprobado.codigoModulo));
         paw_uti.pr_add_value(v_lis_etiqueta, 'colorFuente', fug_obt_pardinamico('COLOR_FUENTE_PRODUCTO', v_pro_preaprobado.codigoModulo));
         paw_uti.pr_add_value(v_lis_etiqueta, 'colorFondo', fug_obt_pardinamico('COLOR_FONDO_PRODUCTO', v_pro_preaprobado.codigoModulo));
         paw_uti.pr_add_value(v_lis_etiqueta, 'serializacionApplication', '003');
         paw_uti.pr_add_value(v_lis_etiqueta, 'serializacionProduct', 'tcl');

         v_pro_preaprobado.listaDetalles := v_lis_etiqueta;

         -- agregamos el producto al retorno
         v_retorno.extend;
         v_retorno(v_retorno.count) := v_pro_preaprobado;

         v_lis_etiqueta.delete;
      END IF;

      -- adelanto efectivo
      IF pag_pre.fu_obt_tar_adelanto(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona),
                                         v_cod_moneda,
                                         v_mto_maximo) = 'S' THEN
         BEGIN
            v_pro_preaprobado.codigoMoneda   := substr(v_cod_moneda, 1, 3);
            v_pro_preaprobado.monto          := v_mto_maximo;
            v_pro_preaprobado.montoMinimo    := v_mto_maximo;
            v_pro_preaprobado.codigoModulo   := 51;
            paw_uti.pr_add_value(v_lis_etiqueta, 'img',  v_cdn_url||'cards/'||v_pro_preaprobado.codigoModulo ||'_advance.png' );
            paw_uti.pr_add_value(v_lis_etiqueta, 'title',  fug_obt_pardinamico('TITULO_PRODUCTO'));
            paw_uti.pr_add_value(v_lis_etiqueta, 'colorFuente', fug_obt_pardinamico('COLOR_FUENTE_PRODUCTO'));
            paw_uti.pr_add_value(v_lis_etiqueta, 'colorFondo', fug_obt_pardinamico('COLOR_FONDO_PRODUCTO'));
            paw_uti.pr_add_value(v_lis_etiqueta, 'serializacionApplication', '005');
            paw_uti.pr_add_value(v_lis_etiqueta, 'serializacionProduct', 'ttc');
            v_pro_preaprobado.listaDetalles := v_lis_etiqueta;
            -- agregamos el producto al retorno
            v_retorno.extend;
            v_retorno(v_retorno.count) := v_pro_preaprobado;

            v_lis_etiqueta.delete;
         EXCEPTION
            WHEN OTHERS THEN
               NULL;
         END;
      END IF;
      -- Verificacion de seguros preaprobados
      IF pag_pre.fu_tie_seguro_hb(v_usu_sesion.codigoPersona, v_listaSeguros, p_codigoCanal) >= 1 THEN
         DECLARE
            v_tip_seg NUMBER := 1;
         BEGIN
            v_pro_preaprobado.codigoModulo := 1;
            v_pro_preaprobado.codigoMoneda := v_cod_mon_local;
            v_pro_preaprobado.monto        := 1;
            v_pro_preaprobado.montoMinimo  := 1;
            -- Se setea -1 para identificar el primer bucle.
            v_tmp_id_seguro := -1;
            v_tmp_id_plan := 1;
            FOR i IN v_listaSeguros.FIRST..v_listaSeguros.LAST LOOP
               IF v_tmp_id_seguro <> v_listaSeguros(i).codigoSeguro THEN
                  IF v_tmp_id_seguro <> -1 THEN
                     --No es el primer bucle y se debe insertar el nuevo producto
                     v_retorno.extend;
                     v_retorno(v_retorno.count) := v_pro_preaprobado;
                     --Se debe resetar el detalle del producto anterior
                     v_lis_etiqueta.delete;
                  END IF;
                  IF v_listaSeguros(i).codigoSeguro = 2 THEN
                     v_tip_seg := 2;
                  ELSE
                     v_tip_seg := 1;
                  END IF;
                  --se agregan los datos generales del seguro
                  paw_uti.pr_add_value(v_lis_etiqueta, 'tipSeguro', v_listaSeguros(i).texto);
                  paw_uti.pr_add_value(v_lis_etiqueta, 'codSeguro', v_listaSeguros(i).codigoSeguro);
                  paw_uti.pr_add_value(v_lis_etiqueta, 'nombreEnte', v_listaSeguros(i).nombreEnte);
                  paw_uti.pr_add_value(v_lis_etiqueta, 'img', v_cdn_url||'insurance/'||v_pro_preaprobado.codigoModulo||
                        '_'||v_listaSeguros(i).codigoSeguro||'_insurance.png' );
                  paw_uti.pr_add_value(v_lis_etiqueta, 'title',  fug_obt_pardinamico('TITULO_PRODUCTO',1, v_tip_seg));
                  paw_uti.pr_add_value(v_lis_etiqueta, 'colorFuente', fug_obt_pardinamico('COLOR_FUENTE_PRODUCTO',1));
                  paw_uti.pr_add_value(v_lis_etiqueta, 'colorFondo', fug_obt_pardinamico('COLOR_FONDO_PRODUCTO',1));
                  paw_uti.pr_add_value(v_lis_etiqueta, 'edadMinima', fug_obt_pardinamico('SEG_EDA_MIN_CON'));
                  paw_uti.pr_add_value(v_lis_etiqueta, 'edadMaxima', fug_obt_pardinamico('SEG_EDA_MAX_CON'));
                  paw_uti.pr_add_value(v_lis_etiqueta, 'serializacionApplication', '001');
                  paw_uti.pr_add_value(v_lis_etiqueta, 'serializacionProduct', 'sap');
                  --actualiza la referencia al seguro actual
                  v_tmp_id_seguro := v_listaSeguros(i).codigoSeguro;
                  v_tmp_id_plan := 1;
               END IF;
               --Se agrega un plan del seguro.
               paw_uti.pr_add_value(v_lis_etiqueta, 'montoAsegurado_' || v_tmp_id_plan, v_listaSeguros(i).montoAsegurado);
               paw_uti.pr_add_value(v_lis_etiqueta, 'montoCuota_' || v_tmp_id_plan, v_listaSeguros(i).montoCuota);
               v_tmp_id_plan := v_tmp_id_plan + 1;
               v_pro_preaprobado.listaDetalles := v_lis_etiqueta;
            END LOOP;
            IF v_listaSeguros.count > 1 THEN
               --Se agrega el ultimo producto
               v_retorno.extend;
               v_retorno(v_retorno.count) := v_pro_preaprobado;
            END IF;
         EXCEPTION
            WHEN OTHERS THEN
               NULL;
         END;
      END IF; -- fin si tiene seguro

      BEGIN
         v_cli_residente := NVL(fug_obt_res_cliente(v_cod_persona), 'S');
      EXCEPTION
         WHEN OTHERS THEN
           v_cli_residente := 'S';
      END;
      --Incluir la oferta de Plazo Fijo en el canal WEB
      IF (p_codigoCanal = '999' and v_ofe_pla_fijo_web = 'S') or (p_codigoCanal = '994' and v_ofe_pla_fijo_mob = 'S') THEN
         -- Verificar que el modulo este abierto -- 2=ABIERTO
         IF v_est_modulo = 2 THEN
            PAW_UTI.pr_mensajeUsuario(PAW_UTI.MSG_OK, v_pro_preaprobado.nombreRespuesta, v_pro_preaprobado.descripcionRespuesta, v_pro_preaprobado.error);
            v_msj_bitacora := v_msj_bitacora || ', ofe_plz_fijo: ' || '1';
            v_pro_preaprobado.codigoMoneda   := v_cod_mon_local;
            v_pro_preaprobado.monto          := 0;
            v_pro_preaprobado.montoMinimo    := nvl(fug_obt_pardinamico(C_PAR_MTO_MIN_PFD,NULL,NULL,v_cod_mon_local),0);
            v_pro_preaprobado.codigoModulo   := 3;
            --Se debe resetar el detalle del producto anterior
            v_lis_etiqueta.delete;
            --se agregan los datos generales del producto
            v_plz_max_pfd := to_number(nvl(fug_obt_pardinamico(C_PAR_PLZ_MAX_PFD), '1080'));
            v_plz_min_pfd := to_number(nvl(fug_obt_pardinamico(C_PAR_PLZ_MIN_PFD), '90'));
            paw_uti.pr_add_value(v_lis_etiqueta, 'modalidad', C_MAD_PFD);
            paw_uti.pr_add_value(v_lis_etiqueta, 'montoMinimoGS', nvl(fug_obt_pardinamico(C_PAR_MTO_MIN_PFD,NULL,NULL,'GS'),0));
            paw_uti.pr_add_value(v_lis_etiqueta, 'montoMinimoUSD', nvl(fug_obt_pardinamico(C_PAR_MTO_MIN_PFD,NULL,NULL,'USD'),0));
            paw_uti.pr_add_value(v_lis_etiqueta, 'plazoMinimo', v_plz_min_pfd);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plazoMinimoMeses', ROUND(v_plz_min_pfd/30));
            paw_uti.pr_add_value(v_lis_etiqueta, 'plazoMaximo', v_plz_max_pfd);
            paw_uti.pr_add_value(v_lis_etiqueta, 'plazoMaximoMeses', ROUND(v_plz_max_pfd/30));
            paw_uti.pr_add_value(v_lis_etiqueta, 'img',  v_cdn_url||'ahorros/plazoFijo.png' );
            paw_uti.pr_add_value(v_lis_etiqueta, 'title',  fug_obt_pardinamico('TITULO_PRODUCTO', v_pro_preaprobado.codigoModulo,37));
            paw_uti.pr_add_value(v_lis_etiqueta, 'colorFuente', fug_obt_pardinamico('COLOR_FUENTE_PRODUCTO', v_pro_preaprobado.codigoModulo,37));
            paw_uti.pr_add_value(v_lis_etiqueta, 'colorFondo', fug_obt_pardinamico('COLOR_FONDO_PRODUCTO', v_pro_preaprobado.codigoModulo,37));
            paw_uti.pr_add_value(v_lis_etiqueta, 'esResidente', v_cli_residente);
            FOR r IN c_per(C_REF_PAG_INT) LOOP
              paw_uti.pr_add_value(v_lis_etiqueta, 'pagoInteres_'||r.codigo, nvl(r.descripcion,'SD'));
              paw_uti.pr_add_value(v_lis_etiqueta, 'plazoPago_'||r.codigo, nvl(r.codigo,'0'));
            END LOOP;
            v_pro_preaprobado.listaDetalles := v_lis_etiqueta;
            -- agregamos el producto al retorno
            v_retorno.extend;
            v_retorno(v_retorno.count) := v_pro_preaprobado;
         END IF;
      END IF;
      v_cuentas := fu_obtenerResumenCuentas(p_sesion, p_codigoCanal, '125D');
      IF ((v_ofe_aho_pro_web = 'S' AND p_codigoCanal = '999') OR (v_ofe_aho_pro_mob = 'S' AND p_codigoCanal = '994'))
         AND v_est_modulo = 2 AND v_cuentas.cantCuentas > 0 THEN
         paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_pro_preaprobado.nombreRespuesta, v_pro_preaprobado.descripcionRespuesta, v_pro_preaprobado.error);
         v_lis_etiqueta.delete;
         v_pro_preaprobado.codigoModulo := 38;
         v_pro_preaprobado.codigoMoneda := v_cod_mon_local;
         paa_pro.pr_obt_mto_pizarra(v_piz_mto_row, 3, 38, v_cod_mon_local);
         v_pro_preaprobado.monto        := nvl(v_piz_mto_row.mto_hasta,0);
         v_pro_preaprobado.montoMinimo  := nvl(v_piz_mto_row.mto_desde,0);
         paa_pro.pr_obt_mto_pizarra(v_piz_mto_row, 3, 38, 'USD');
         paw_uti.pr_add_value(v_lis_etiqueta, 'montoUSD', nvl(v_piz_mto_row.mto_hasta,0));
         paw_uti.pr_add_value(v_lis_etiqueta, 'montoMinimoUSD', nvl(v_piz_mto_row.mto_desde,0));
         paw_uti.pr_add_value(v_lis_etiqueta, 'montoMinCuotaUSD', nvl(fug_obt_pardinamico('MTO_MIN_CUO_AHO_PROGRAMADO',NULL,NULL,'USD'),0));
         paw_uti.pr_add_value(v_lis_etiqueta, 'montoMaxCuotaUSD', nvl(fug_obt_pardinamico('MTO_MAX_CUO_AHO_PROGRAMADO',NULL,NULL,'USD'),0));
         paw_uti.pr_add_value(v_lis_etiqueta, 'montoMinCuotaGS', nvl(fug_obt_pardinamico('MTO_MIN_CUO_AHO_PROGRAMADO',NULL,NULL,'GS'),0));
         paw_uti.pr_add_value(v_lis_etiqueta, 'montoMaxCuotaGS', nvl(fug_obt_pardinamico('MTO_MAX_CUO_AHO_PROGRAMADO',NULL,NULL,'GS'),0));
         paa_pro.pr_obt_plz_pizarra(3, 38, 'GS', NULL, v_plz_min_pfd, v_plz_max_pfd);
         paw_uti.pr_add_value(v_lis_etiqueta, 'plazoMinGS', v_plz_min_pfd / 30);
         paw_uti.pr_add_value(v_lis_etiqueta, 'plazoMaxGS', v_plz_max_pfd / 30);
         paa_pro.pr_obt_plz_pizarra(3, 38, 'USD', NULL, v_plz_min_pfd, v_plz_max_pfd);
         paw_uti.pr_add_value(v_lis_etiqueta, 'plazoMinUSD', v_plz_min_pfd / 30);
         paw_uti.pr_add_value(v_lis_etiqueta, 'plazoMaxUSD', v_plz_max_pfd / 30);
         paw_uti.pr_add_value(v_lis_etiqueta, 'img',   v_cdn_url||'ahorros/misMetas.png' );
         paw_uti.pr_add_value(v_lis_etiqueta, 'img_0', v_cdn_url||'misMetas/ap-viajar.png');
         paw_uti.pr_add_value(v_lis_etiqueta, 'img_1', v_cdn_url||'misMetas/ap-estudiar.png');
         paw_uti.pr_add_value(v_lis_etiqueta, 'img_2', v_cdn_url||'misMetas/ap-auto.png');
         paw_uti.pr_add_value(v_lis_etiqueta, 'img_3', v_cdn_url||'misMetas/ap-hogar.png');
         paw_uti.pr_add_value(v_lis_etiqueta, 'img_4', v_cdn_url||'misMetas/ap-otros.png');
         paw_uti.pr_add_value(v_lis_etiqueta, 'name_0', 'Viajar');
         paw_uti.pr_add_value(v_lis_etiqueta, 'name_1', 'Estudiar');
         paw_uti.pr_add_value(v_lis_etiqueta, 'name_2', 'Auto');
         paw_uti.pr_add_value(v_lis_etiqueta, 'name_3', 'Hogar');
         paw_uti.pr_add_value(v_lis_etiqueta, 'name_4', 'Otros');
         paw_uti.pr_add_value(v_lis_etiqueta, 'title', fug_obt_pardinamico('TITULO_PRODUCTO',3,38));
         paw_uti.pr_add_value(v_lis_etiqueta, 'colorFuente', fug_obt_pardinamico('COLOR_FUENTE_PRODUCTO', 3, 38));
         paw_uti.pr_add_value(v_lis_etiqueta, 'colorFondo', fug_obt_pardinamico('COLOR_FONDO_PRODUCTO', 3, 38));
         paw_uti.pr_add_value(v_lis_etiqueta, 'esResidente', v_cli_residente);

         FOR r IN c_per('FEC_DEB_AHO_PROGRAMADO') LOOP
            paw_uti.pr_add_value(v_lis_etiqueta, 'fecDeb_'||r.codigo, nvl(r.significado, ''));
         END LOOP;
         v_pro_preaprobado.listaDetalles := v_lis_etiqueta;
         -- agregamos el producto al retorno
         v_retorno.extend;
         v_retorno(v_retorno.count) := v_pro_preaprobado;
      END IF;
      if fug_obt_pardinamico('REG_BITACORA_BW') = 'S' then
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora, BITACORA_SALIDA);
      end if;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         PAW_UTI.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ora-err: '||SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_solicitudPreaprobados(p_sesion         IN VARCHAR2,
                                     p_codigoCanal    IN VARCHAR2,
                                     p_modo           IN VARCHAR2,
                                     p_codigoModulo   IN NUMBER,
                                     p_xmlData        IN VARCHAR2) RETURN typ_preaprobado IS
      v_cod_persona      ba_personas.cod_persona%TYPE;
      v_nro_cuenta       ge_cuentas.nro_cuenta%TYPE := NULL;
      v_cod_moneda       ge_cuentas.cod_moneda%TYPE;
      v_cod_modulo       ba_modulos.cod_modulo%TYPE;
      v_cod_modalidad    ge_modalidades.cod_modalidad%TYPE := 68;
      v_cod_tra_padre    ge_transacciones.cod_transaccion%TYPE := 358;
      v_cod_mon_cuenta   ge_cuentas.cod_moneda%TYPE;
      v_cod_mod_cuenta   ge_cuentas.cod_modulo%TYPE;
      v_cod_mad_cuenta   ge_cuentas.cod_modalidad%TYPE;
      v_cod_ofi_cuenta   ge_cuentas.cod_oficina%TYPE;
      /*datos para apertura de cuenta*/
      ty_cta_generada typ_cuentaGenerada;
      v_cuentas         typ_resumenCuentas;
      v_email_cli VARCHAR2(100);
      v_res_noti_mail number;
      v_send_noti_mail boolean;
      v_val_cta boolean := true; /* validar cuenta para desembolso de prestamo */
      /*datos para apertura de cuenta*/
      v_cta_for_credito  ge_cuentas.denominacion%TYPE;
      v_nom_cuenta       ge_cuentas.denominacion%TYPE;
      v_usu_sesion       typ_validarsesion;
      v_msj_caja         typ_mensajeCaja;
      v_retorno          typ_preaprobado := typ_preaprobado();
      v_tip_monto        VARCHAR2(50);
      v_mto_edilicio     pr_simulaciones.mto_edilicio%TYPE;
      v_tip_interes      ba_cod_referencias.significado%TYPE;
      v_can_dias         NUMBER := 0;
      v_permiso          typ_obtenerPermisos;
      v_msj_error        typ_mensajerespuesta := typ_mensajerespuesta();
      v_cuota            pr_sim_cuotas.mto_capital%TYPE;
      v_nro_simulacion   pr_simulaciones.nro_simulacion%TYPE;
      v_nro_solicitud    pr_solicitudes.nro_solicitud%TYPE;
      v_fec_proceso      ge_movimientos.fecha%TYPE := pag_cal.FU_OBT_FEC_ACTUAL(3);
      v_can_cuotas       pr_simulaciones.can_cuotas%TYPE;
      v_mto_maximo       pr_simulaciones.monto%TYPE;
      v_mto_operacion    pr_simulaciones.monto%TYPE;
      v_val_tasa         pr_simulaciones.val_tasa%TYPE;
      v_fec_pri_vencimiento pr_simulaciones.fec_pri_vencimiento%TYPE := NULL;
      v_fec_pri_ven      varchar2(20);
      v_nro_sim_digital  number;
      v_des_comision     pr_simulaciones.tot_interes%TYPE;
      v_fec_inicio       pr_simulaciones.fec_inicio%TYPE;
      v_cotizacion       pr_simulaciones.cotizacion%TYPE;
      v_tot_interes      pr_simulaciones.tot_interes%TYPE;
      v_tot_cargos       pr_simulaciones.tot_cargos%TYPE;
      v_tas_impuesto     pr_sim_cargos.val_tasa%TYPE;
      v_tas_seg_vida     ge_tas_fechas.val_tasa%type;
      v_dir_correo       ba_mails.dir_correo%TYPE;
      v_xml_data         xmltype;
      v_modo             VARCHAR2(1);
      v_plazo            NUMBER;
      v_cod_operacion    VARCHAR2(3) := '100';
      v_mensaje          VARCHAR2(4000);
      v_msj_bitacora     VARCHAR2(700);
      v_horario          VARCHAR2(1);
      v_es_mov_noc       VARCHAR2(1);
      v_es_cta_noc       VARCHAR2(1);
      v_afinidad         ge_cli_aprobados_atm_tmp.afinidad%type;
      v_sub_afinidad     ge_cli_aprobados_atm_tmp.clase%type;
      v_cod_direccion    ba_direcciones.cod_direccion%type;
      v_direccion        ba_direcciones.direccion%type;
      v_tipo             ba_direcciones.tipo%type;
      v_cod_ciudad       ba_direcciones.cod_ciudad%type;
      v_telefono         VARCHAR2(20);
      v_nom_oficial      ba_personas.nom_completo%type;
      v_es_nomina        VARCHAR2(1);
      v_tipo_seguro       NUMBER;
      v_mto_asegurado    NUMBER(18,2);
      v_mto_debito       NUMBER(18,2):= 0;
      v_beneficiario     ge_cli_seguros.beneficiario%TYPE;
      v_cla_token        VARCHAR2(40);
      v_cla_trans        VARCHAR2(40);
      v_descripcion      VARCHAR2(60);
      v_cod_ente         NUMBER;
      v_cod_err_seg      NUMBER := 0;
      v_nro_seguro       NUMBER := 0;
      v_resLimite        typ_respuestaLimite;
      v_msj_respuesta    typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_mto_cargo        pr_sim_cuotas.mto_refuerzo%type;
      v_datos            pag_pre.tp_datosCuota;
      v_cod_canal        ge_canales.cod_canal%TYPE;
      v_des_canal        ge_canales.descripcion%TYPE;
      v_est_modulo       ba_modulos.estado%type;
      v_tie_pre_apr      NUMBER;
      v_nro_doc_beneficiario ge_cli_seguros.nro_doc_beneficiario%TYPE;
      NO_EXI_TRANSACCION    EXCEPTION;-- NO EXISTE, la transaccion debe ser creada
      EST_MOD_INVALIDO      EXCEPTION;-- modulo en estado 1 o 6
      V_RET_NOTIFICACION    NUMBER;
      v_error               NUMBER := 0;

      MSG_OPE_INVALIDA   CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      MSG_CTA_INVALIDA   CONSTANT VARCHAR2(15) := 'CTA_INVALIDA';
      MSG_CTA_DEB_INVAL  CONSTANT VARCHAR2(15) := 'CTA_DEB_INVALID';
      MSG_DES_PRE_INVAL  CONSTANT VARCHAR2(15) := 'G_DES_PRE_ERROR';
      MSG_PRE_SIN_DATOS  CONSTANT VARCHAR2(15) := 'PRE_PRE_SIN_DAT';
      MSG_TAR_SIN_DATOS  CONSTANT VARCHAR2(15) := 'PRE_TAR_SIN_DAT';
      MSG_DAT_INVALID    CONSTANT VARCHAR2(15) := 'MTO_CUO_INVALID';
      MSG_DES_MOD_ERROR  CONSTANT VARCHAR2(15) := 'PRE_MOD_ERROR';
      MSG_PRO_ERR_DAT_INV CONSTANT VARCHAR2(15) := 'PRO_ERR_DAT_INV';
      MSG_SEG_SAL_INSUF   CONSTANT VARCHAR2(15) := 'SEG_SAL_INSUF';
      MSG_SEG_ERR_DEBITO  CONSTANT VARCHAR2(15) := 'SEG_ERR_DEBITO';
      MSG_CTA_APE_INVALID  CONSTANT VARCHAR2(15) := 'CTA_APE_INVALID';
      -- eliminar simulaciones del dia para el usuario de caja
      PROCEDURE lp_eli_simulaciones(p_nro_simulacion IN pr_simulaciones.nro_simulacion%TYPE) IS
      BEGIN
         -- eliminamos la simulacion de cargos
         DELETE FROM pr_sim_cargos WHERE nro_simulacion = p_nro_simulacion;

         -- eliminamos la simulacion de cuotas
         DELETE FROM pr_sim_cuotas WHERE nro_simulacion = p_nro_simulacion;

         -- eliminamos las simulaciones
         DELETE FROM pr_simulaciones WHERE nro_simulacion = p_nro_simulacion;
      END;

      PROCEDURE lp_enviarEmailSeguros(p_cod_persona in varchar2, p_nro_operacion IN VARCHAR2, p_tipoSeguro in varchar2,
                                      p_monto IN VARCHAR2, p_mensualidad IN VARCHAR2,
                                      p_ctaDebito IN VARCHAR2) IS
        v_mensaje VARCHAR2(4000);
        v_descripcion varchar2(400);
   BEGIN
                        SELECT descripcion INTO v_descripcion FROM ge_tip_seguros
                                        WHERE cod_tipo = p_tipoSeguro AND activo = 'S';

        v_mensaje := '
                        <h2 style="color:#074CA9; font-family: Helvetica Neue, Helvetica, Arial, sans-serif; margin-top:0px">RESUMEN DEL SEGURO CONTRATADO</h2>';
        v_mensaje := v_mensaje || '
                     <table width="500"; style="font-family: Helvetica Neue, Helvetica, Arial, sans-serif; font-size:14px;">
                       <tbody>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Fecha/Hora: </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' ||
                     TO_CHAR(SYSDATE, 'DD/MM/YYYY HH:mm') ||
                     '</td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> ' ||
                     UTL_URL.ESCAPE('Número', TRUE, 'UTF-8') || ' de ' || UTL_URL.ESCAPE('Operación', TRUE, 'UTF-8') ||
                     ': </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' ||
                     p_nro_operacion ||
                     '</td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Tipo de ' ||
                     UTL_URL.ESCAPE('Operación', TRUE, 'UTF-8') ||
                     ': </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;"> Cobertura de Seguro  </td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>Cobertura:</b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;"> ' ||
                     v_descripcion ||
                     ' </td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Monto Asegurado: </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;"> Gs.' ||
                     p_monto ||
                     ' </td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Plan Mensual: </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">  ' ||
                     p_mensualidad ||
                     ' </td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Duracion: </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">  12 meses </td>
                          </tr>
                        </tbody></table><br/>';
        v_mensaje := v_mensaje || '
                        <p style="font-family: Helvetica Neue, Helvetica, Arial, sans-serif; font-size:14px"> Las cuotas sera debitadas automaticamente de la Cuenta Nro. '|| p_ctaDebito || '</p>';

        v_res_noti_mail := paw_not.fu_env_email_prueba(paw_seg.fu_obt_mail(p_cod_persona), v_mensaje, 'SOLPREAS');
      END;

   BEGIN
      paw_uti.pr_mensajeUsuario(paw_uti.MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_retorno.listaDetalles := typ_listaEtiquetaValor();
      ty_cta_generada := typ_cuentaGenerada();
      v_modo         := substr(TRIM(p_modo), 1, 1);
      v_cod_modulo   := p_codigoModulo;
      --v_nro_cuenta   := depurarAlfanumerico(p_cuentaCredito, 15);
      IF v_cod_modulo = 1 THEN --Se cambia el codigo de tipo de mensaje para especificar que es Contratacion de Seguros
        v_cod_operacion := '043';
      END IF;
      v_msj_bitacora := substr('cod_mod:'||v_cod_modulo||', mod: '||v_modo, 1, 700);

      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      v_cod_persona := nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona);
      if fug_obt_pardinamico('REG_BITACORA_BW') = 'S' then
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ENTRADA);
      end if;
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 3. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      v_msj_bitacora := v_msj_bitacora||', perf: ' || v_usu_sesion.codigoPerfil;
      IF v_permiso.error = 'S' THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- validamos el modulo
      IF v_cod_modulo NOT IN (5, 6, 1, 10) THEN
         paw_uti.pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- valido según módulo
      IF v_cod_modulo = 6 THEN
        -- obtengo si es un cliente nomina
        v_es_nomina := pag_pre.fu_es_cli_nomina(v_cod_persona);
        -- validamos que posea un préstamo preaprobado
        v_cod_moneda := v_cod_mon_local;
        -- 06/2017 --
        v_tie_pre_apr := pag_pre.fu_tie_pre_aprobado(v_cod_persona, 6, 68, 'S', v_datos);
        v_msj_bitacora := v_msj_bitacora||', tie_pre_apr: ' || v_tie_pre_apr;
        IF v_tie_pre_apr <= 0 THEN
           paw_uti.pr_mensajeUsuario(MSG_PRE_SIN_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           if fug_obt_pardinamico('REG_BITACORA_BW') = 'S' then
              paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
           end if;
           RETURN v_retorno;
        END IF;
      ELSIF v_cod_modulo = 5 THEN
        -- validamos que poseea una tarjeta preaprobada
        IF pag_pre.fu_tie_tar_aprobada(v_cod_persona, v_mto_maximo, v_afinidad, v_sub_afinidad, v_cod_moneda) <> 0 THEN
           paw_uti.pr_mensajeUsuario(MSG_TAR_SIN_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           if fug_obt_pardinamico('REG_BITACORA_BW') = 'S' then
              paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
           end if;
           RETURN v_retorno;
        END IF;
      END IF;

      -- validamos el horario
      IF v_cod_modulo NOT IN (5, 10) THEN -- DDSI-29 -- 07/2017 -- No tener en cuenta para solicitud de tarjetas debido a que no genera movimientos
         v_msj_error := lp_ver_horario(v_horario,
                                       v_es_mov_noc,
                                       v_es_cta_noc,
                                       v_msj_caja.fechaUltimoCierre,   -- IN
                                       v_msj_caja.codigoOficinaOrigen, -- IN
                                       v_fec_proceso);
         IF v_msj_error.error = 'S' THEN
            v_retorno.error                := v_msj_error.error;
            v_retorno.nombreRespuesta      := v_msj_error.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_msj_error.descripcionRespuesta;
            paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;
      -- sin problemas hasta aqui
      IF p_xmlData IS NOT NULL THEN
         -- obtenemos el canal de preaprobados
         SELECT decode(p_codigoCanal, 994, 30, -- mobile
                                      29),     -- web
                decode(p_codigoCanal, 994, 'Móvil',   -- mobile
                                      'Homebanking')  -- web
           INTO v_cod_canal, v_des_canal
           FROM DUAL;

         -- parseamos los datos de entrada
         v_xml_data := xmltype.createxml(p_xmlData);
         IF v_cod_modulo = 6 THEN
            v_can_cuotas    := depurarNumerico(v_xml_data.extract('/product/installment/text()').getNumberVal(), 3);
            BEGIN
            v_nro_cuenta    := depurarAlfanumerico(v_xml_data.extract('/product/creditAccount/text()').getStringVal(), CUENTA_TAMANO);
            EXCEPTION
               WHEN OTHERS THEN
                  v_nro_cuenta := '0000000000';
            END;
            v_mto_operacion := v_xml_data.extract('/product/amount/text()').getNumberVal();
            IF v_modo = 'C' THEN
               v_val_tasa := v_xml_data.extract('/product/interestRate/text()').getNumberVal();
            END IF;

     --Ajuste para fecha de primer vencimiento
           BEGIN
           v_fec_pri_vencimiento :=v_xml_data.extract('/product/transactionDate/text()').getStringVal();
           v_fec_pri_ven := null;
            if v_fec_pri_vencimiento is not null then
               v_fec_pri_ven :=   v_xml_data.extract('/product/transactionDate/text()').getStringVal();
            end if;
           v_fec_pri_vencimiento:= null;
           EXCEPTION
               WHEN OTHERS THEN
                 v_fec_pri_vencimiento:= null;
           END;
           v_msj_bitacora  := v_msj_bitacora || ', can_cuo:' || v_can_cuotas || ', cta:' || v_nro_cuenta || ', mto:' || v_mto_operacion || ', fec_ven: ' || to_char(v_fec_pri_vencimiento, 'ddmmyyyy');
         ELSIF v_cod_modulo = 5 THEN
            IF v_xml_data.extract('/product/addressCode/text()') IS NOT NULL THEN
               v_cod_direccion := v_xml_data.extract('/product/addressCode/text()').getNumberVal();
               IF v_cod_direccion = -1 THEN
                  v_tipo        := depurarAlfanumerico(v_xml_data.extract('/product/addressType/text()').getStringVal(), 1);
                  v_direccion   := depurarTextos(v_xml_data.extract('/product/addressName/text()').getStringVal(), 80);
                  IF v_xml_data.extract('/product/addressCityCode/text()') IS NOT NULL THEN
                     v_cod_ciudad  := depurarNumerico(v_xml_data.extract('/product/addressCityCode/text()').getNumberVal(), 3);
                  END IF;
               END IF;
            END IF;
            -- campos opcionales de teléfono
            IF v_xml_data.extract('/product/phone/text()') IS NOT NULL THEN
               v_telefono  := to_char(depurarNumerico(v_xml_data.extract('/product/phone/text()').getNumberVal(), 10));
            END IF;
         v_msj_bitacora  := v_msj_bitacora || ', cod_direccion:' || v_cod_direccion || ', direccion: ' || v_direccion || ', tipo: ' || v_tipo || ', ciudad: ' || v_cod_ciudad || ', telefono: ' || v_telefono;
         ELSIF v_cod_modulo = 1 THEN
             BEGIN
               v_tipo_seguro    := depurarNumerico(v_xml_data.extract('/product/insuranceTypeCode/text()').getNumberVal(), 18);
               v_mto_operacion := v_xml_data.extract('/product/amount/text()').getNumberVal();
               v_mto_asegurado := v_xml_data.extract('/product/amountInsured/text()').getNumberVal();
               v_nro_cuenta    := depurarAlfanumerico(v_xml_data.extract('/product/debitAccount/text()').getStringVal(), CUENTA_TAMANO);
               IF v_xml_data.extract('/product/beneficiary/text()') IS NOT NULL THEN
                  v_beneficiario  := depurarAlfanumerico(v_xml_data.extract('/product/beneficiary/text()').getStringVal(),100,'S');
               END IF;

               IF v_xml_data.extract('/product/beneficiaryDocNum/text()') IS NOT NULL THEN
                  v_nro_doc_beneficiario  := depurarTextos(v_xml_data.extract('/product/beneficiaryDocNum/text()').getStringVal(),15);
               END IF;

               IF v_xml_data.extract('/product/claveToken/text()') IS NOT NULL THEN
                  v_cla_token     := depurarAlfanumerico(v_xml_data.extract('/product/claveToken/text()').getStringVal(), 40);
               END IF;
               IF v_xml_data.extract('/product/claveTransaccional/text()') IS NOT NULL THEN
                   v_cla_trans     := depurarAlfanumerico(v_xml_data.extract('/product/claveTransaccional/text()').getStringVal(), 40);
               END IF;
               v_mto_debito := v_mto_operacion;

               --Obtenemos el cod padre de transaccion del par dinamico dependiendo del seguro solic.
               IF v_tipo_seguro = 2 THEN
                   v_cod_tra_padre := fug_obt_pardinamico('COD_TRA_SEGUROS_WEB');
               ELSIF v_tipo_seguro = 3 THEN
                   v_cod_tra_padre := fug_obt_pardinamico('COD_TRA_SEG_VIDA');
               ELSE
                   RAISE NO_EXI_TRANSACCION;
               END IF;
               v_msj_error := fu_val_sol_seguro(p_codigoCanal,v_cod_persona,v_mto_asegurado,v_tipo_seguro,v_mto_operacion,v_tipo_seguro);
               IF v_msj_error.error = 'S' THEN
                  v_retorno.error                := v_msj_error.error;
                  v_retorno.nombreRespuesta      := v_msj_error.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_msj_error.descripcionRespuesta;
                  paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
               END IF;
            EXCEPTION
                WHEN NO_EXI_TRANSACCION THEN
                  paw_uti.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'Formato parametro XML no valido - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
                WHEN OTHERS THEN
                  paw_uti.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'Formato parametro XML no valido - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
            END;
         ELSIF v_cod_modulo = 10 THEN
            BEGIN
               v_val_cta    := FALSE; -- para que no controle saldo
               v_nro_cuenta := depurarAlfanumerico(v_xml_data.extract('/product/loanAccount/text()').getStringVal(), CUENTA_TAMANO);
            EXCEPTION
               WHEN OTHERS THEN
                  paw_uti.pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', sin cuenta prestamo' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
            END;
         END IF;
      END IF;
      IF v_cod_modulo = 6 THEN
         IF v_nro_cuenta IS NULL OR LENGTH(v_nro_cuenta) < 10 or v_nro_cuenta = '0000000000' then
        v_cuentas := typ_resumenCuentas();
        IF fug_obt_pardinamico('ACT_CTA_PRESTAMOS') = 'S' THEN
             BEGIN /* se verifica si tiene cuentas en estado 'A' */
                v_cuentas := paw_bel.fu_obtenerResumenCuentas(p_sesion, p_codigoCanal,'110DGS'); -- COD 110, OBTENER CUENTAS APTAS PARA DESEMBOLSO EN ESTADO 'A'

             EXCEPTION
                WHEN OTHERS THEN
                 paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'Error al obtener resumen de cuentas.', paw_uti.BITACORA_ERROR);
                 ty_cta_generada.error := 'S';
             END;
             IF v_cuentas.cantCuentas > 0 THEN /* si tiene cuentas en estado 'A', se utiliza una de ellas */
                 ty_cta_generada.NRO_CUENTA := v_cuentas.resumenCuentas(1).nrocuenta;
                  select a.fec_insercion, a.estado, a.cod_modulo, a.cod_modalidad
                  into ty_cta_generada.FECHA_APERTURA, ty_cta_generada.ESTADO, ty_cta_generada.COD_MODULO, ty_cta_generada.COD_MODALIDAD
                  from ge_cuentas a
                  where a.nro_cuenta = ty_cta_generada.NRO_CUENTA;
                   if trunc(ty_cta_generada.FECHA_APERTURA) = trunc(sysdate) and ty_cta_generada.ESTADO = 'A' and ty_cta_generada.COD_MODULO = 3 and ty_cta_generada.COD_MODALIDAD in (31,334) then
                      v_val_cta := false; /* no se valida la cuenta si la misma fue generada para el desembolso */
                   end if;
             ELSE /*si no tiene cuentas en estdo 'A', se crea una */
                 ty_cta_generada := paw_uti.fu_apertura_cuenta_pre(p_sesion, v_cod_persona,v_cod_canal);
                 v_val_cta := false; /* no se valida la cuenta si la misma fue generada para el desembolso */
             END IF;
        ELSE
            paw_uti.pr_mensajeUsuario(MSG_CTA_APE_INVALID, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'No es posible la apertura de cuenta para desembolso, estado ACT_CTA_PRESTAMOS =  '|| fug_obt_pardinamico('ACT_CTA_PRESTAMOS') || ' ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
        END IF;
        v_nro_cuenta := ty_cta_generada.NRO_CUENTA;
           IF nvl(trim(v_nro_cuenta), 'x') <> 'x' THEN
                   lp_reg_operacion(v_nro_cuenta,
                              pag_gen.fu_obt_mon_local,
                              0,
                              v_nro_cuenta,
                              0,
                              '',
                              '',
                              '',
                              '',
                              'Apertura de cuenta para desembolso de prestamo',
                              '',
                              '',
                              v_cod_persona,
                              v_cod_operacion,
                              '',
                              v_cod_canal,
                              '',
                              v_usu_sesion.codigoEmpresa,
                              'cod_persona: ' || v_cod_persona || ', Moneda: ' || pag_gen.fu_obt_mon_local || ', cod_canal: ' || v_cod_canal || ', nro_cuenta: ' || v_nro_cuenta || ', modo: '||v_modo,
                              '',
                              '');
             END IF;
        ELSE
               ty_cta_generada.NRO_CUENTA := v_nro_cuenta;
               select a.fec_insercion, a.estado, a.cod_modulo, a.cod_modalidad
               into ty_cta_generada.FECHA_APERTURA, ty_cta_generada.ESTADO, ty_cta_generada.COD_MODULO, ty_cta_generada.COD_MODALIDAD
               from ge_cuentas a
               where a.nro_cuenta = ty_cta_generada.NRO_CUENTA;
               if trunc(ty_cta_generada.FECHA_APERTURA) = trunc(sysdate) and ty_cta_generada.ESTADO = 'A' and ty_cta_generada.COD_MODULO = 3 and ty_cta_generada.COD_MODALIDAD in (31,334) then
                  v_val_cta := false; /* no se valida la cuenta si la misma fue generada para el desembolso */
               end if;
         end if;
      end if;
      IF v_nro_cuenta IS NOT NULL THEN
         -- controlamos la cuenta
         if v_val_cta then
         v_msj_error := lf_val_cta_debito(v_nro_cuenta, v_cod_tra_padre, v_mto_debito, v_cod_mon_cuenta, v_cod_mod_cuenta, v_cod_mad_cuenta, v_cod_ofi_cuenta, v_cta_for_credito, v_nom_cuenta, v_usu_sesion, v_msj_caja);
         end if;
         IF v_msj_error.error = 'S' AND (v_msj_error.nombreRespuesta <> 'COD_SAL_INSUF' OR v_cod_modulo = 1)  THEN
            -- no se tiene en cuenta error de saldo
            v_retorno.error                := v_msj_error.error;
            v_retorno.nombreRespuesta      := v_msj_error.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_msj_error.descripcionRespuesta;
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'lf_val_cta_debito - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;

         IF lf_val_cta_origen(v_nro_cuenta, v_cod_persona) = 'N' THEN
            -- no es una cuenta del cliente
            IF v_cod_modulo = 10 THEN
               paw_uti.pr_mensajeUsuario(MSG_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            ELSE
               paw_uti.pr_mensajeUsuario(MSG_CTA_DEB_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
            paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'lf_val_cta_origen - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- controlamos la moneda
         IF v_cod_mon_cuenta <> v_cod_moneda THEN
            v_msj_bitacora := v_msj_bitacora || ', cod_mon:' || v_cod_moneda || ', cod_mon_cta:' || v_cod_mon_cuenta;
            paw_uti.pr_mensajeUsuario(MSG_CTA_DEB_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
         -- si el cliente es nomina, validamos que la cuenta sea nomina
         IF v_es_nomina = 'S' AND pag_pre.fu_es_cta_nomina(v_cod_persona, v_nro_cuenta, v_cod_mad_cuenta) = 'N' THEN
            v_msj_bitacora := v_msj_bitacora || ', nro_cuenta: ' || v_nro_cuenta;
            paw_uti.pr_mensajeUsuario(MSG_CTA_DEB_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;

      v_retorno.codigoMoneda := v_cod_moneda;
      v_retorno.codigoModulo := v_cod_modulo;

      -- validamos que el modulo se encuentre abierto
      IF v_cod_modulo = 6 THEN
         -- Verificar que modulo no este en 1=INICIO ó 6=COPIA ATM
         v_est_modulo := pae_cnf.FU_OBT_EST_MODULO(3);
         v_msj_bitacora := v_msj_bitacora || ', est_modulo: ' || v_est_modulo;
   --11/2020 Para PP CIERRE
         IF v_est_modulo IN(1,6/*,4*/) THEN
            pr_mensajeUsuario(MSG_DES_MOD_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      ELSIF v_cod_modulo = 1 THEN -- DDSI-29 -- 07/2017 --
         --No se puede realizar transacciones con estado 1 o 6
         v_est_modulo := pae_cnf.FU_OBT_EST_MODULO(v_cod_modulo);
         v_msj_bitacora := v_msj_bitacora||', est_modulo: ' || v_est_modulo;
         IF v_est_modulo IN(1,6) THEN
            RAISE EST_MOD_INVALIDO;
         END IF;
      END IF;

      -- proceso segun modo
      IF v_modo = 'V' THEN
         IF v_cod_modulo = 6 THEN
            -- simular prestamo para calculo de cuotas
            BEGIN
              /*prw_gen_atm_simulacion(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), -- codigo de la persona,
                                 v_cod_modalidad, -- tipo de credito
                                 --v_cod_mon_cuenta, -- moneda
                                 pag_gen.fu_obt_mon_local,
                                 v_mto_operacion, -- monto del credito
                                 v_can_cuotas, -- nro de cuotas
                                 'B',  -- tipo de monto B-BRUTO o N-NETO
                                 null, -- inicio del credito
                                 nvl(v_fec_pri_ven,null),--null, -- primer vencimiento
                                 null, -- valor de la tasa
                                 v_cod_canal, -- codigo del canal
                                 null, -- código de campaña
                                 null, -- descripcion de la oper.
                                 v_nro_cuenta,
                                 v_mensaje,
                                 v_nro_sim_digital,
                                 v_error);*/--se agrega la version de uenocore
                                 null;
             EXCEPTION
              WHEN OTHERS THEN
                if sqlcode = -20000 then
                   paw_uti.pr_mensajeUsuario(MSG_DAT_INVALID, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                   RETURN v_retorno;
                else
                   paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                   RETURN v_retorno;
                end if;
            END;
            IF v_mensaje IS NOT NULL AND v_error = -1 THEN
               v_retorno.error := 'S';
               v_retorno.nombreRespuesta := 'ERR_MON_MIN_PRE';
               v_retorno.descripcionRespuesta := substr(v_mensaje, 1, 200);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', prw_gen_atm_simulacion ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            ELSIF v_mensaje IS NOT NULL AND v_error = -2 THEN
               v_retorno.error := 'S';
               v_retorno.nombreRespuesta := 'ERR_MON_MAX_APR';
               v_retorno.descripcionRespuesta := substr(v_mensaje, 1, 200);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', prw_gen_atm_simulacion ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            ELSIF v_mensaje IS NOT NULL THEN
               v_retorno.error := 'S';
               v_retorno.nombreRespuesta := 'ERR_SIM_PRE_APR';
               v_retorno.descripcionRespuesta := substr(v_mensaje, 1, 200);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', prw_gen_atm_simulacion ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
            -- obtenemos el numero de simulacion
            v_nro_simulacion:= v_nro_sim_digital;
            -- obtenemos los datos de la simulacion
            pag_pre.pr_obt_dat_simulacion(v_nro_simulacion,
                                          v_mto_maximo,
                                          v_plazo,
                                          v_cuota,
                                          v_cod_moneda,
                                          v_val_tasa,
                                          v_fec_pri_vencimiento,
                                          v_des_comision,
                                          v_fec_inicio,
                                          v_cotizacion,
                                          v_tot_interes,
                                          v_tot_cargos,
                                          v_tip_monto,
                                          v_mto_edilicio,
                                          v_tip_interes);

            pag_pre.pr_obt_sim_cargos(v_nro_simulacion, v_des_comision, v_tas_impuesto);
            v_tas_seg_vida := pag_pre.fu_obt_tas_seg_vida(68, v_cod_moneda);

      --Solo si es mobile se mostramos sumado el cargo, sino no
            v_mto_cargo := 0;
            if v_cod_canal= 30 then
               v_mto_cargo := pag_pre.fu_obt_mto_cargo(v_nro_simulacion, 2);
            end if;

            -- cargamos los datos faltantes
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'amount', v_mto_maximo);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'feeAmount', v_cuota+ nvl(v_mto_cargo,0));
            IF v_val_cta THEN
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'validAccount', 't');
            ELSE
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'validAccount', 'f');
            END IF;
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'creditAccount', v_nro_cuenta);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'denominationAccount', v_nom_cuenta);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'installment', v_plazo);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'interestRate', v_val_tasa);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'firstDeadline', to_char(v_fec_pri_vencimiento, 'dd/MM/yyyy'));
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'comissionDiscount', v_des_comision);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'beginDate', to_char(v_fec_inicio, 'dd/MM/yyyy'));
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'quotation', v_cotizacion);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'totalInterestAmount', v_tot_interes);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'totalChargeAmount', v_tot_cargos);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'taxRate', v_tas_impuesto);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'lifeInsuranceFee', v_tas_seg_vida);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'creditAmount', (v_mto_maximo - v_tot_cargos) );
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'amountType', v_tip_monto );
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'urbanAmount', v_mto_edilicio );
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'rateType', v_tip_interes );
            -- cargamos las cuotas simuladas
      v_mto_cargo := 0;
            FOR cuo IN pag_pre.gc_sim_cuotas( v_nro_simulacion ) LOOP
               v_can_dias := v_can_dias + cuo.per_dias;
               v_mto_cargo := pag_pre.fu_obt_mto_cargo(v_nro_simulacion, cuo.nro_cuota - 1);
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'feeAmount_'||cuo.nro_cuota, cuo.mto_cuota + v_mto_cargo);
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'dueDate_'||cuo.nro_cuota, to_char(cuo.fec_vencimiento, 'dd/mm/yyyy'));
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'capAmount_'||cuo.nro_cuota, nvl(cuo.mto_capital, 0) );
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'rateAmount_'||cuo.nro_cuota, nvl(cuo.mto_interes, 0) );
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'feeCharge_'||cuo.nro_cuota, v_mto_cargo );
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'perDays_'||cuo.nro_cuota, nvl(cuo.per_dias, 0) );
            END LOOP;
            -- cargamos los cargos a cobrar
            v_tot_cargos := 0;
            FOR car IN pag_pre.gc_sim_cargos( v_nro_simulacion ) LOOP
               v_tot_cargos := v_tot_cargos + 1;
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'chargeName_'||car.nro, car.cargo);
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'chargeInsurance_'||car.nro, car.seguro);
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'chargeRate_'||car.nro, car.tasa);
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'chargeAmount_'||car.nro, car.importe);
            END LOOP;
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'termDays', v_can_dias);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'totalCharges', v_tot_cargos);
            v_retorno.monto := v_mto_operacion;
            lp_eli_simulaciones( v_nro_simulacion );
         ELSIF v_cod_modulo = 5 THEN
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'currency', v_cod_moneda);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'amount', v_mto_maximo);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'addressCode', v_cod_direccion);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'addressType', v_tipo);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'addressCityCode', v_cod_ciudad);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'addressName', v_direccion);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'phone', v_telefono);
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'managerName', v_nom_oficial);


            v_retorno.monto := v_mto_maximo;
         ELSIF v_cod_modulo = 1 THEN
               v_resLimite := fu_obtenerLimite(  v_usu_sesion, --typ_validarSesion
                                                v_cod_operacion, --tipo mensaje 043
                                                v_usu_sesion.codigoPersona, -- Esta entrega solo para PF
                                                v_nro_cuenta,
                                                v_cod_mon_cuenta,
                                                503, -- código de transaccion para debito en AH o CC
                                                null, -- código de transacción.
                                                v_mto_operacion, -- monto a debitar o 1ra cuota.
                                                v_modo -- modo V
                                                );
            IF v_resLimite.error = 'S' THEN
              v_retorno.error := v_resLimite.error;
              v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
              v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
              pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'fu_obtenerLimite - '||v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
            END IF;
            BEGIN
                SELECT descripcion INTO v_descripcion FROM ge_tip_seguros
                                        WHERE cod_tipo = v_tipo_seguro AND activo = 'S';
            EXCEPTION
                WHEN OTHERS THEN
                    paw_uti.pr_mensajeUsuario(MSG_PRO_ERR_DAT_INV, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'No se pudo recuperar la descripción asociada al tipo de seguro: '||v_tipo_seguro||v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                    RETURN v_retorno;
            END;
            v_retorno.resLimite   := v_resLimite.codRespuesta;
            --Cargamos los datos de respuesta
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'amount', v_mto_operacion); --Monto de la cuota
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'amountInsured', v_mto_asegurado);--Capital asegurado
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'coverageStartDate', lf_for_date(sysdate));--Fecha de inicio de la cobertura
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'debitAccount', v_nro_cuenta);--Numero de la cuenta debito
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'insuranceTypeCode', v_tipo_seguro);--Codigo del tipo de seguro
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'operationDescription', v_descripcion);--Descripcion de la operacion
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'beneficiary', v_beneficiario);--Nombre del beneficiario del asegurado.
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'beneficiaryDocNum', v_nro_doc_beneficiario);--Numero de documento del beneficiario del asegurado.

            v_retorno.codigoMoneda := v_cod_mon_cuenta;
            v_retorno.monto := v_mto_operacion;
         ELSIF v_cod_modulo = 10 THEN
            BEGIN
               SELECT cta.cod_moneda, p.mto_capital
                 INTO v_retorno.codigoMoneda, v_retorno.monto
                 FROM pr_cta_pre_can_res4 cta, pr_cta_prestamos p
                WHERE cta.cod_persona = v_usu_sesion.codigoPersona
                  AND cta.nro_cuenta = v_nro_cuenta
                  AND cta.reversado = 'N'
                  AND p.nro_cuenta = cta.nro_cuenta;
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'loanAccount', v_nro_cuenta );
            EXCEPTION
               WHEN OTHERS THEN
                  paw_uti.pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
            END;
         END IF;
      ELSIF v_modo = 'C' THEN
         IF v_cod_modulo = 6 THEN
            --generar solicitud de prestamo
            BEGIN
                  v_send_noti_mail:= true;
                  V_email_cli := paw_seg.fu_obt_mail(v_cod_persona);
                   if V_email_cli = ' ' THEN
                     pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '|| 'No se encontro dirección de email para el usuario '||v_cod_persona, BITACORA_ERROR);
                     v_send_noti_mail:= false;
                   END IF;
              --Recuperamos el firstDeadline
              --Ajuste para fecha de primer vencimiento
               BEGIN
                 v_fec_pri_vencimiento := null;
                 v_fec_pri_ven := null;
                 v_fec_pri_vencimiento :=v_xml_data.extract('/product/firstDeadline/text()').getStringVal();
                 if v_fec_pri_vencimiento is not null then
                    v_fec_pri_ven :=   v_xml_data.extract('/product/firstDeadline/text()').getStringVal();
                 end if;
               EXCEPTION
                   WHEN OTHERS THEN
                     v_fec_pri_vencimiento:= null;
         v_fec_pri_ven := null;
               END;
              --Si el módulo esta cerrado, se cambia a siguiente fecha para generar correctamente
              --11/2020
              if v_est_modulo=4 then
                 v_fec_proceso  := pag_cal.FU_OBT_FEC_PROXIMA(6);
              end if;
              /*prp_gen_atm_solicitud(v_cod_persona,
                                    v_cod_modalidad,
                                    v_cod_moneda,
                                    v_mto_operacion,--monto
                                    v_can_cuotas,--cuota
                                    'S',--grabar
                                    'B', --B-BRUTO o N-NETO
                                    v_fec_proceso,
                                    nvl(v_fec_pri_ven,null),--null,--primer vencimiento
                                    null,--tasa
                                    v_cod_canal,--canal
                                    null,--campaña
                                    'Prestamo Aprobado ' || v_des_canal,
                                    null,
                                    null,
                                    null,
                                    null,
                                    v_nro_cuenta,
                                    v_nro_solicitud);*/--se agrega la version de uenocore
            EXCEPTION
              WHEN OTHERS THEN
                if sqlcode = -20000 then
                   paw_uti.pr_mensajeUsuario(MSG_DAT_INVALID, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                   RETURN v_retorno;
                else
                   paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                   RETURN v_retorno;
                end if;
            END;
            -- Desembolso de Préstamo
            --acepta la solicitud, generar la cuenta de prestamo
            BEGIN
               prp_des_atm_prestamo(v_cod_persona, v_mto_operacion, v_nro_cuenta, v_nro_solicitud);
               --11/2020 Para cierre
               IF v_est_modulo IN (4,3) THEN
                 --Cambiamos el estado de su cuenta para que el cliente pueda Visualizar
                  update ah_cta_vistas a
                    set a.estado='N'
                     where a.nro_cuenta=v_nro_cuenta
                       and a.estado='A';

                end if;

            EXCEPTION
               WHEN OTHERS THEN
                  pr_mensajeUsuario(MSG_DES_PRE_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  RETURN v_retorno;
            END;
            BEGIN
                    lp_reg_operacion(v_nro_cuenta,
                              pag_gen.fu_obt_mon_local,
                              0,
                              v_nro_cuenta,
                              0,
                              '',
                              '',
                              '',
                              '',
                              'Apertura de cuenta para desembolso de prestamo',
                              '',
                              '',
                              v_cod_persona,
                              v_cod_operacion,
                              '',
                              v_cod_canal,
                              '',
                              v_usu_sesion.codigoEmpresa,
                              'cod_persona: ' || v_cod_persona || ', Moneda: ' || pag_gen.fu_obt_mon_local || ', cod_canal: ' || v_cod_canal || ', nro_cuenta: ' || v_nro_cuenta|| ', modo: '||v_modo,
                              '',
                              '');
               IF v_send_noti_mail THEN
                  v_mensaje := '
                        <h2 style="color:#074CA9; font-family: Helvetica Neue, Helvetica, Arial, sans-serif; margin-top:0px">DESEMBOLSO DE ' || UTL_URL.ESCAPE('PRÉSTAMO', TRUE, 'UTF-8') || '</h2>
                        <h2 style="font-family: Helvetica Neue, Helvetica, Arial, sans-serif; margin-top:0px"> REALIZADO </h2>';
                  v_mensaje := v_mensaje || '
                     <table width="500"; style="font-family: Helvetica Neue, Helvetica, Arial, sans-serif; font-size:14px;">
                       <tbody>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Fecha/Hora: </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || TO_CHAR(sysdate, 'DD/MM/YYYY HH:mm')|| '</td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> ' || UTL_URL.ESCAPE('Número', TRUE, 'UTF-8') || ' de ' || UTL_URL.ESCAPE('Operación', TRUE, 'UTF-8') || ': </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || v_nro_solicitud || '</td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Tipo de ' || UTL_URL.ESCAPE('Operación', TRUE, 'UTF-8') || ': </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;"> ' || UTL_URL.ESCAPE('Préstamo', TRUE, 'UTF-8') || ' Personal </td>
                          </tr>
                          <tr>

                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>Cuenta ' || UTL_URL.ESCAPE('Número', TRUE, 'UTF-8') || ':</b></td>

                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;"> ' ||  v_nro_cuenta || ' </td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Monto: </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;"> Gs.' ||  v_mto_operacion || ' </td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Tasa: </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">  ' || v_val_tasa  || ' </td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Plazo: </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">  ' ||  v_can_cuotas || ' </td>
                          </tr>
                        </tbody></table>';
                        v_mensaje := v_mensaje || '
                        <p style="font-family: Helvetica Neue, Helvetica, Arial, sans-serif; font-size:14px">';
                        if v_val_cta = false then
                          v_mensaje := v_mensaje||'<b>Para el desembolso del ' || UTL_URL.ESCAPE('préstamo', TRUE, 'UTF-8') || ' se le ha asignado la Cuenta Nro. '
                          ||v_nro_cuenta||'. Las cuotas se ' || UTL_URL.ESCAPE('pagarán', TRUE, 'UTF-8') || ' por ' || UTL_URL.ESCAPE('débito automático', TRUE, 'UTF-8') || ' desde esta misma cuenta</b></p>';
                        else
                           v_mensaje := v_mensaje||'<b>Las cuotas del ' || UTL_URL.ESCAPE('préstamo', TRUE, 'UTF-8') || ' se ' || UTL_URL.ESCAPE('pagarán', TRUE, 'UTF-8') || ' por ' || UTL_URL.ESCAPE('débito automático', TRUE, 'UTF-8') || ' en la Cuenta Nro. '
                          ||v_nro_cuenta||'. </b></p>';
                        end if;
                 v_res_noti_mail := paw_not.fu_env_email_prueba(V_email_cli, v_mensaje, 'SOLPREAP');
               END IF;
            END;
            v_retorno.numeroDocumento := v_nro_solicitud;

            -- envia notificacion
            v_ret_notificacion := paw_not.fu_not_pre_apr(v_cod_persona, v_nro_cuenta);

            --obtener nro de cuenta del prestamo desembolsado
            DECLARE
               v_nroPrestamo  pr_cta_prestamos.nro_cuenta%TYPE;
               BEGIN
               SELECT p.nro_cuenta
               INTO v_nroPrestamo
               FROM pr_cta_prestamos p
               WHERE p.nro_solicitud = v_nro_solicitud
                  AND p.nro_cta_debito = v_nro_cuenta
                  AND TRUNC(p.fec_insercion) = TRUNC(SYSDATE);
               paw_uti.pr_add_value(v_retorno.listaDetalles, 'nroCuentaPrestamo', v_nroPrestamo );
               EXCEPTION
                 WHEN OTHERS THEN
                  paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora
                  ||',' || SUBSTR(SQLERRM, 1, 200)||
                  fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
              END;
         ELSIF v_cod_modulo = 5 THEN

            -- insertar solicitud de tarjeta preaprobada
            prt_act_tar_atm(v_cod_persona, '#DS#', v_cod_canal);
            v_send_noti_mail:= true;
            v_email_cli := paw_seg.fu_obt_mail(v_cod_persona);
            if v_email_cli = ' ' THEN
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] '|| 'No se encontro dirección de email para el usuario '||v_cod_persona, BITACORA_ERROR);
               v_send_noti_mail:= false;
            END IF;

            DECLARE
            BEGIN
            --   select g.nro_solicitud into v_nro_solicitud from ge_cli_aprobados_atm g where g.cod_persona = v_cod_persona and to_date(g.fec_insercion) = trunc(sysdate);
              SELECT  a.afinidad, a.nro_solicitud, a.nro_cta_debito
                  into v_afinidad,v_nro_solicitud,v_nro_cuenta
                  FROM ge_cli_aprobados_atm a
                  WHERE a.cod_persona = v_cod_persona
                  AND trunc(a.fec_insercion) = trunc(SYSDATE)
                  and rownum=1
                  order by a.fec_insercion desc;


            END;

            IF v_send_noti_mail THEN
                  v_mensaje := '
                        <h2 style="color:#074CA9; font-family: Helvetica Neue, Helvetica, Arial, sans-serif; margin-top:0px"> TARJETA DE ' || UTL_URL.ESCAPE('CRÉDITO', TRUE, 'UTF-8') || ' PRE APROBADA</h2>
                        <h2 style="font-family: Helvetica Neue, Helvetica, Arial, sans-serif; margin-top:0px"> SOLICITADA </h2>';

                  v_mensaje := v_mensaje || '
                     <table width="500"; style="font-family: Helvetica Neue, Helvetica, Arial, sans-serif; font-size:14px;">
                       <tbody>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Fecha/Hora: </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || TO_CHAR(sysdate, 'DD/MM/YYYY HH:mm')|| '</td>
                          </tr>
                          <tr>
                             <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b> Tipo de' || UTL_URL.ESCAPE('Operación', TRUE, 'UTF-8') || ': </b></td>
                             <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">Tarjeta de ' || UTL_URL.ESCAPE('crédito', TRUE, 'UTF-8') || ' preaprobada</td>
                          </tr>
                        </tbody></table>';

                        v_mensaje := v_mensaje || '
                        <p style="font-family: Helvetica Neue, Helvetica, Arial, sans-serif; font-size:14px"><b>Las cuotas se ' || UTL_URL.ESCAPE('pagarán', TRUE, 'UTF-8') || ' por ' || UTL_URL.ESCAPE('débito automático', TRUE, 'UTF-8') || '</b></p>';

                 v_res_noti_mail := paw_not.fu_env_email_prueba(V_email_cli, v_mensaje, 'PAW_BEL');
               END IF;



         ELSIF v_cod_modulo = 1 THEN
            v_resLimite := fu_obtenerLimite(  v_usu_sesion, --typ_validarSesion
                                                v_cod_operacion, --tipo mensaje 043
                                                v_usu_sesion.codigoPersona, -- Esta entrega solo para PF
                                                v_nro_cuenta,
                                                v_cod_mon_cuenta,
                                                503, -- código de transaccion para debito en AH o CC
                                                null, -- código de transacción.
                                                v_mto_operacion, -- monto a debitar o 1ra cuota.
                                                v_modo -- modo V
                                                );
            IF v_resLimite.error = 'S' THEN
              v_retorno.error := v_resLimite.error;
              v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
              v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
              paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'fu_obtenerLimite - '||v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
              RETURN v_retorno;
            END IF;
            -- Validar la clave
            IF v_resLimite.codRespuesta IN ('10', '11') THEN
               -- clave transaccional requerida
               v_msj_respuesta := lf_obt_cla_validar(v_cla_trans, v_usu_sesion.codigoPersona,v_usu_sesion.codigoEmpresa, 'T');
            END IF;
            IF v_msj_respuesta.error = 'N' THEN
               IF v_resLimite.codRespuesta IN ('01', '11') THEN
                  -- token requerido
                  v_msj_respuesta := paw_seg.fu_obt_tok_validar(v_cla_token, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, v_modo);
                END IF;
            END IF;
            IF v_msj_respuesta.error = 'S' THEN
               v_retorno.error := v_msj_respuesta.error;
               v_retorno.nombreRespuesta := v_msj_respuesta.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
               paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'Error al validar la clave '||v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
               RETURN v_retorno;
            END IF;
            --Se recupera el ente al que corresponde el tipo de seguro
            BEGIN
               SELECT cod_ente
                 INTO v_cod_ente
                 FROM ge_tip_seguros ts
                WHERE ts.cod_tipo = v_tipo_seguro;
            EXCEPTION
               WHEN OTHERS THEN
                  paw_uti.pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' - Ente Inexistente - ' || fu_generarbitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), paw_uti.BITACORA_ERROR);
                  RETURN v_retorno;
            END;
            prw_ins_seguros(nvl(v_usu_sesion.codigoEmpresa,
                            v_usu_sesion.codigoPersona),
                            v_nro_cuenta,
                            v_mto_asegurado,
                            v_mto_operacion,
                            v_cod_canal,
                            v_tipo_seguro,
                            v_cod_ente,
                            v_nro_seguro,
                            v_cod_err_seg,
                            v_beneficiario,
                            v_nro_doc_beneficiario,
                            0,
                            'W');
            --Se crea el seguro
            IF v_cod_err_seg <> 0 THEN
                   paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' - No se pudo crear el seguro - v_cod_err_seg: - '||v_cod_err_seg||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                IF v_cod_err_seg in (25, 29, 31) THEN
                   paw_uti.pr_mensajeUsuario(MSG_SEG_SAL_INSUF, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                ELSE
                   paw_uti.pr_mensajeUsuario(MSG_SEG_ERR_DEBITO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                END IF;
                   RETURN v_retorno;
            END IF;
            --Si no hubo error en la creación del seguro, se retorna el número de seguro creado
            v_retorno.numeroDocumento := v_nro_seguro;

            --retorna el cod_tip_seguro como extradata y beneficiario
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'insuranceTypeCode', v_tipo_seguro);--Codigo del tipo de seguro
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'beneficiary', v_beneficiario);--nombre completo del beneficiario
            paw_uti.pr_add_value(v_retorno.listaDetalles, 'beneficiaryDocNum', v_nro_doc_beneficiario);--documento del beneficiario


            lp_enviarEmailSeguros( v_usu_sesion.codigoPersona,v_nro_seguro,v_tipo_seguro,v_mto_asegurado,v_mto_operacion, v_nro_cuenta);

         ELSIF v_cod_modulo = 10 THEN -- prorroga prestamo COVID-19
            DECLARE
               v_mto_formateado VARCHAR2(100);
               v_num_moneda NUMBER := 1;
            BEGIN
               SELECT p.mto_capital, p.cod_moneda
                 INTO v_retorno.monto, v_cod_moneda
                 FROM pr_cta_prestamos p
                WHERE p.nro_cuenta = v_nro_cuenta;

               UPDATE pr_cta_pre_can_res4 ct
                  SET ct.reversado = 'R',
                      ct.fec_sol_reversa = SYSDATE
                WHERE ct.cod_persona = v_usu_sesion.codigoPersona
                  AND ct.nro_cuenta = v_nro_cuenta
                  AND ct.reversado = 'N';

               IF v_cod_moneda = 'GS' THEN
                  v_num_moneda := 600;
               END IF;
               v_mto_formateado := paw_not.lf_obt_mto_formateado(v_retorno.monto, v_num_moneda);
               v_dir_correo := fug_obt_dir_mail_per(v_usu_sesion.codigoPersona);
               IF v_dir_correo IS NOT NULL THEN
                  v_ret_notificacion := paw_not.fu_env_email_prueba(v_dir_correo,
                  'Hemos recibido tu solicitud de exclusion del prestamo '||v_cod_moneda||' '||v_mto_formateado||' (cta.'||v_nro_cuenta||').<br>
                  Se procedera a evaluarla y te contactaremos durante los proximos dias para confirmar
                  si hemos podido cumplir tu solicitud.
                  <br><br>Muchas gracias por utilizar nuestros Canales Digitales #QuedateEnCasaPy',
                  'PAW_BEL');
               END IF;
            EXCEPTION
               WHEN OTHERS THEN
                   paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
                   RETURN v_retorno;
            END;
         END IF;
      ELSE
         paw_uti.pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora ||' '|| fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN EST_MOD_INVALIDO THEN
         paw_uti.pr_mensajeUsuario(MSG_DES_MOD_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      WHEN OTHERS THEN
         paw_uti.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_uti.pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obtenerDirecciones(p_sesion   IN VARCHAR2,
                                  p_codigoCanal IN VARCHAR2) RETURN typ_direcciones IS
      v_can_detalles  NUMBER(3) := 0;
      v_cod_operacion VARCHAR2(3) := '065';
      v_retorno       typ_direcciones := typ_direcciones();
      v_detalle       typ_detalleDireccion := typ_detalleDireccion();
      v_lis_detalle   typ_listaDirecciones := typ_listaDirecciones();
      v_usu_sesion    typ_validarSesion;
      v_msj_caja      typ_mensajeCaja;
      -- cursor para obtener direcciones
      CURSOR c_direcciones(p_cod_persona ba_personas.cod_persona%TYPE) IS
         SELECT pa.descripcion nom_pais, c.descripcion nom_ciudad,
                b.descripcion nom_barrio, p.*
           FROM ba_direcciones p, ba_paises pa, ba_ciudades c, ba_barrios b
          WHERE p.cod_persona = p_cod_persona
            AND p.cod_pais = pa.cod_pais
            AND c.cod_ciudad(+) = p.cod_ciudad
            AND c.cod_pais(+) = p.cod_pais
            AND b.cod_pais(+) = p.cod_pais
            AND b.cod_ciudad(+) = p.cod_ciudad
            AND b.cod_barrio(+) = p.cod_barrio;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- 1. Valido la clave del cliente
      v_usu_sesion := fu_validarSesion(p_sesion, p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- 2. Valido la caja
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- 3. busco los datos de las direcciones
      FOR ct IN c_direcciones(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)) LOOP
         v_can_detalles := v_can_detalles + 1;
         v_detalle.codigo := ct.cod_direccion;
         v_detalle.tipo := substr(ct.tipo, 1, 1);
         v_detalle.principal := substr(ct.principal, 1, 1);
         v_detalle.direccion := substr(ct.direccion, 1, 80);
         v_detalle.codigoPais := ct.cod_pais;
         v_detalle.nombrePais := substr(ct.nom_pais, 1, 35);
         v_detalle.codigoCiudad := ct.cod_ciudad;
         v_detalle.nombreCiudad := substr(ct.nom_ciudad, 1, 35);
         v_detalle.codigoBarrio := ct.cod_barrio;
         v_detalle.nombreBarrio := substr(ct.nom_barrio, 1, 40);
         v_detalle.numero       := substr(ct.numero, 1, 8);
         v_detalle.departamento := substr(ct.departamento, 1, 8);
         v_detalle.piso         := substr(ct.piso, 1, 8);
         v_detalle.edificio      := substr(ct.edificio, 1, 35);
         v_detalle.codigoPostal := substr(ct.cod_postal, 1, 10);

         v_lis_detalle.extend;
         v_lis_detalle(v_lis_detalle.count) := v_detalle;
      END LOOP;
      v_retorno.cantidad := v_can_detalles;
      v_retorno.listaDirecciones := v_lis_detalle;
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'fu_obtenerDirecciones: [' || SQLERRM||']', BITACORA_ERROR);
    RETURN v_retorno;
   END;

   -- inserción de solicitud de cancelación de productos
   FUNCTION fu_solCancelacionProductos(p_sesion             IN VARCHAR2,
                                       p_codigoCanal        IN VARCHAR2,
                                       p_tip_producto       IN VARCHAR2,
                                       p_nro_producto       IN VARCHAR2,
                                       p_mot_cancelacion    IN VARCHAR2,
                                       p_comentario         IN VARCHAR2 DEFAULT NULL,
                                       p_tel_contacto       IN VARCHAR2,
                                       p_mail_contacto      IN VARCHAR2,
                                       p_cel_contacto       IN VARCHAR2) RETURN typ_mensajerespuesta IS

      v_retorno        typ_mensajerespuesta := typ_mensajerespuesta;
      retValidarSesion typ_validarSesion;
      v_mensajeCaja    typ_mensajeCaja;
      v_cod_operacion  VARCHAR2(3) := '229';
      v_existe         VARCHAR2(1);
      v_enviado        VARCHAR2(1) := 'N';
      v_mensaje        VARCHAR2(3500);
      v_dir_correo     VARCHAR2(2000);
      v_number         NUMBER;
      v_fec_solicitud  DATE := pag_cal.fu_obt_fec_actual(1);
    v_msj_bitacora     VARCHAR2(700);
      -- datos recibidos
      v_tip_producto    bw_sol_can_productos.tip_producto%TYPE;
      v_cod_persona     bw_sol_can_productos.cod_persona%TYPE;
      v_nro_producto    bw_sol_can_productos.nro_producto%TYPE;
      v_mot_cancelacion bw_sol_can_productos.mot_cancelacion%TYPE;
      v_comentario      bw_sol_can_productos.comentarios%TYPE;
      v_tel_contacto    bw_sol_can_productos.tel_contacto%TYPE;
      v_mail_contacto   bw_sol_can_productos.mail_contacto%TYPE;
      v_cel_contacto    bw_sol_can_productos.cel_contacto%TYPE;

      SOL_CAN_DUPLICADA CONSTANT VARCHAR2(15) := 'SOL_CAN_DUPLI'; -- solicitud de cancelación duplicada
      MSG_DAT_INVALIDO  CONSTANT VARCHAR2(15) := 'G_DATO_INV';

      -- reemplaza los acentos para envío de mails
      FUNCTION lf_reemplazoAcentos(p_texto IN VARCHAR2) RETURN VARCHAR2 IS
         v_retorno    VARCHAR2(3000);
      BEGIN
         SELECT translate(p_texto,
                          'áéíóúàèìòùãõâêîôôäëïöüçñÁÉÍÓÚÀÈÌÒÙÃÕÂÊÎÔÛÄËÏÖÜÇÑ',
                          'aeiouaeiouaoaeiooaeioucnAEIOUAEIOUAOAEIOOAEIOUCN')
           INTO v_retorno
           FROM dual;
         RETURN v_retorno;
      END;
   BEGIN
      --valido la sesión del cliente
      retValidarSesion := fu_validarSesion(depurarAlfanumerico(p_sesion, 32), p_codigoCanal);
      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- validamos la caja
      v_mensajeCaja := lf_val_caja(retValidarSesion);
      IF v_mensajeCaja.error = 'S' THEN
         v_retorno.error                := v_mensajeCaja.error;
         v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      v_cod_persona := retValidarSesion.codigoPersona;

      -- depuración de datos de entrada
      v_tip_producto    := depurarTextos(p_tip_producto, 100);
      v_nro_producto    := p_nro_producto;
      v_comentario      := depurarTextos(p_comentario, 300);
      v_mot_cancelacion := depurarTextos(p_mot_cancelacion, 100);
      v_tel_contacto    := depurarNumerico(p_tel_contacto, 20);
      v_mail_contacto   := p_mail_contacto;
      v_cel_contacto    := depurarNumerico(p_cel_contacto, 20);

      v_msj_bitacora := ' tip_producto: ' || v_tip_producto || ' nro_producto: ' || v_nro_producto || ' v_comentario: ' || v_comentario ||
                        ' mot_cancelacion: ' || v_mot_cancelacion || ' tel_contacto: ' || v_tel_contacto || ' mail_contacto: ' || v_mail_contacto ||
                        ' cel_contacto: ' || v_cel_contacto;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora||' '|| fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ENTRADA);

      IF p_tip_producto IS NULL THEN
         pr_mensajeUsuario(MSG_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Tipo de producto no puede ser nulo. ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF p_nro_producto IS NULL THEN
         pr_mensajeUsuario(MSG_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Número de Producto no puede ser nulo. ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF p_mot_cancelacion IS NULL THEN
         pr_mensajeUsuario(MSG_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Motivo de la cancelación no puede ser nulo. ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF p_cel_contacto IS NULL AND p_tel_contacto IS NULL THEN
         pr_mensajeUsuario(MSG_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'El nro de teléfono y celular no pueden ser nulos, debe enviar al menos 1. ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF p_mail_contacto IS NULL THEN
         pr_mensajeUsuario(MSG_DAT_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'La dirección de correo electrónico no puede ser nula. ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- buscamos solicitudes duplicadas
      BEGIN
         SELECT 'S'
           INTO v_existe
           FROM bw_sol_can_productos p
          WHERE p.cod_persona = v_cod_persona
            AND p.tip_producto = v_tip_producto
            AND p.nro_producto = v_nro_producto
            AND p.fec_solicitud = pag_cal.fu_obt_fec_actual(1);
      EXCEPTION
         WHEN NO_DATA_FOUND THEN
            v_existe := 'N';
      END;

      IF v_existe = 'S' THEN
         pr_mensajeUsuario(SOL_CAN_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'Solicitud Duplicada.' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF v_retorno.error = 'N' THEN
         -- no hay problemas hasta aquí
         -- se registra la solicitud
         BEGIN
            INSERT INTO bw_sol_can_productos
               (cod_persona, tip_producto, nro_producto, fec_solicitud, mot_cancelacion, comentarios, tel_contacto, mail_contacto, cel_contacto)
            VALUES
               (v_cod_persona, v_tip_producto, v_nro_producto, v_fec_solicitud, v_mot_cancelacion, v_comentario, v_tel_contacto, v_mail_contacto, v_cel_contacto);

         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'ERROR AL INSERTAR - ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         END;

         -- enviar mail con la solicitud
         BEGIN
            v_mensaje := '<h2 style="color:#074CA9; font-family: ' || chr(39) || 'Helvetica Neue' || chr(39) || ', Helvetica, Arial, sans-serif; margin-top:0px">SOLICITUD DE ' || UTL_URL.ESCAPE('CANCELACIÓN', TRUE, 'UTF-8') || ' DE PRODUCTOS Y/O SERVICIOS CONTRATADOS EN CANALES</h2>';
            v_mensaje := v_mensaje || '
             <table width="500"; style="font-family: ' || chr(39) || 'Helvetica Neue' || chr(39) || ', Helvetica, Arial, sans-serif; font-size:14px;">
              <tbody >
                 <tr>
                    <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>Nombre del Cliente:</b></td>
                    <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || UTL_URL.ESCAPE(fue_obt_nom_persona(v_cod_persona), TRUE, 'UTF-8') || '</td>
                 </tr>
                  <tr>
                    <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>Nro. Cliente:</b></td>
                    <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || v_cod_persona || '</td>
                 </tr>
                 <tr>
                    <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>Tipo de Producto o Servicio:</b></td>
                    <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || UTL_URL.ESCAPE(v_tip_producto, TRUE, 'UTF-8') || '</td>
                 </tr>
                 <tr>
                    <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>Nro. del Producto o Servicio:</b></td>
                    <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || UTL_URL.ESCAPE(v_nro_producto, TRUE, 'UTF-8') || '</td>
                 </tr>
                 <tr>
                    <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>Motivo de la ' || UTL_URL.ESCAPE('Cancelación', TRUE, 'UTF-8') || ' :</b></td>
                    <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || UTL_URL.ESCAPE(v_mot_cancelacion, TRUE, 'UTF-8') || '</td>
                 </tr>
                 <tr>
                    <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>Comentarios del Cliente:</b></td>
                    <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || UTL_URL.ESCAPE(v_comentario, TRUE, 'UTF-8') || '</td>
                 </tr>
                 <tr>
                    <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>' || UTL_URL.ESCAPE('Teléfono', TRUE, 'UTF-8') || ' de Contacto:</b></td>
                    <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || UTL_URL.ESCAPE(v_tel_contacto, TRUE, 'UTF-8') || '</td>
                 </tr>
                 <tr>
                    <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>Celular de Contacto:</b></td>
                    <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || UTL_URL.ESCAPE(v_cel_contacto, TRUE, 'UTF-8') || '</td>
                 </tr>
                 <tr>
                    <td width="150"; style="border-bottom:thin #AFD48B solid; padding:6px 0px;"><b>Email de Contacto:</b></td>
                    <td style="border-bottom:thin #AFD48B solid; padding:6px 0px;">' || UTL_URL.ESCAPE(v_mail_contacto, TRUE, 'UTF-8') || '</td>
                 </tr>
              </tbody>
             </table>';
            v_mensaje := '<div style="padding:20px 20px">' || v_mensaje || '</div>';

            IF trim(v_tip_producto) = 'Extracto Clic' THEN
               v_msj_bitacora := v_msj_bitacora || ' - CRM ECO';
               prg_env_mail(fug_obt_dir_correo, -- from
                             trim(fug_obt_pardinamico('MAIL_EXT_ECO_CRM')), -- to
                             -- subject
                             fue_obt_nro_doc_persona(retValidarSesion.codigoPersona)||'|'||to_char(sysdate, 'yyyymmddhh24miss') || '- EXTRACTO ECOLOGICO',
                             --
                             v_mensaje);

               -- notificar la recepcion de cancelar la baja de impresion de extractos
               v_dir_correo := fug_obt_dir_mail_per( nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona) );
               IF v_dir_correo IS NOT NULL THEN
                  v_number := paw_not.fu_env_email_prueba(v_dir_correo,
                                                          utl_url.escape('Estimado usuario, acorde a su solicitud, ' || fug_obt_pardinamico('NOM_BANCO') || ' le confirma que procederá a reactivar el servicio de impresión de su/s Extracto/s en papel.', TRUE, 'UTF-8'),
                                                          'PAW_BEL');
                  v_msj_bitacora := v_msj_bitacora || ', ret_mail: ' || v_number;
               END IF;
            ELSE
               v_msj_bitacora := v_msj_bitacora || ' - CRM NORMAL';
               v_dir_correo := fug_obt_pardinamico('MAIL_CAN_PROD_HB');
               v_number := paw_not.fu_env_email_prueba(v_dir_correo, v_mensaje, 'Yaguarete');
            END IF;

         EXCEPTION
            WHEN OTHERS THEN
               v_number := -99;
        END;
      END IF;

      IF v_number = -99 THEN
         v_enviado := 'N';
      ELSE
         v_enviado := 'S';
      END IF;

      -- actualizar el estado del envío del mail
      UPDATE bw_sol_can_productos
        SET enviado = v_enviado
      WHERE cod_persona = v_cod_persona
        AND tip_producto = v_tip_producto
        AND nro_producto = v_nro_producto
        AND fec_solicitud = v_fec_solicitud;

      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_msj_bitacora || ' ' ||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);

      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   -- lista todas las tarjetas asociadas al usuario
   FUNCTION fu_obtenerTarjetas(p_sesion      IN VARCHAR2,
                               p_codigoCanal IN VARCHAR2,
                               p_relacion    IN VARCHAR2 DEFAULT NULL) RETURN typ_resumentarjetas IS

      v_retorno        typ_resumentarjetas := typ_resumentarjetas();
      v_lista          typ_listaresumentarjeta := typ_listaresumentarjeta();
      v_detalle        typ_detalletarjeta :=  typ_detalletarjeta();
      retValidarSesion typ_validarSesion;
      --retError         typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_mensajeCaja    typ_mensajeCaja;
      v_permiso        typ_obtenerPermisos;
      v_cod_operacion  VARCHAR2(3) := '012';
      v_can            NUMBER := 0;

      CURSOR c_tarjetas(p_cod_persona IN ba_personas.cod_persona%type) IS
         -- persona física
         SELECT ta.nom_embozar, ta.nro_tarjeta, ta.fec_vencimiento, decode(ta.cod_persona, cc.cod_persona, 'P', 'A') relacion,
                ta.cod_persona, cc.nro_cuenta, cta.afinidad, cta.sub_afinidad, cta.cod_moneda
           FROM ba_personas p, ge_cta_clientes cc, ta_tarjetas ta, ta_cta_tarjetas cta
          WHERE cc.nro_cuenta =  ta.nro_cuenta
            AND p.cod_persona = cc.cod_persona
            AND cta.nro_cuenta = cc.nro_cuenta
            AND cc.relacion = 'P'
            AND p.tipo = 'F'
            AND ta.vigente = 'S'
            AND ta.cod_estado = 6
            AND cc.cod_persona = p_cod_persona
            AND (p_relacion is null
                OR (p_relacion = 'P' and ta.cod_persona = cc.cod_persona)
                OR (p_relacion = 'A' and ta.cod_persona <> cc.cod_persona))
         UNION
         -- persona juridica
         SELECT ta.nom_embozar, ta.nro_tarjeta, ta.fec_vencimiento, decode(ta.cod_persona, cc.cod_persona, 'P', 'A'),
                ta.cod_persona, cc.nro_cuenta,  cta.afinidad, cta.sub_afinidad, cta.cod_moneda
           FROM ba_personas p, ge_cta_clientes cc, ta_tarjetas ta, ta_cta_tarjetas cta
          WHERE cc.nro_cuenta =  ta.nro_cuenta
            AND p.cod_persona = cc.cod_persona
            AND cta.nro_cuenta = cc.nro_cuenta
            AND p.tipo = 'J'
            AND ta.vigente = 'S'
            AND ta.cod_estado = 6
            AND cc.cod_persona = p_cod_persona
            AND (p_relacion is null
                OR (p_relacion = 'P' and ta.cod_persona = cc.cod_persona)
                OR (p_relacion = 'A' and ta.cod_persona <> cc.cod_persona));

   BEGIN
      --valido la sesión del cliente
      retValidarSesion := fu_validarSesion(depurarAlfanumerico(p_sesion, 32), p_codigoCanal);
      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- validamos la caja
      v_mensajeCaja := lf_val_caja(retValidarSesion);
      IF v_mensajeCaja.error = 'S' THEN
         v_retorno.error                := v_mensajeCaja.error;
         v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      -- validación de permisos
      v_permiso := lf_obt_permisos(retValidarSesion, v_cod_operacion);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fu_obtenerTarjetas(p_relacion: ' || p_relacion || ' )' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ENTRADA);

      FOR reg IN c_tarjetas(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)) LOOP
         v_detalle.nombreEmbozado    := reg.nom_embozar;
         v_detalle.numeroTarjeta     := reg.nro_tarjeta;
         v_detalle.fechaVencimiento  := reg.fec_vencimiento;
         v_detalle.tipoRelacion      := reg.relacion;
         v_detalle.codPersona        := reg.cod_persona;
         v_detalle.nroCuenta         := reg.nro_cuenta;
         v_detalle.codMoneda         := reg.cod_moneda;

         -- obtener afinidad
         BEGIN
            select upper(c.significado)
              into v_detalle.afinidad
              from ba_cod_referencias c
             where c.dominio = 'AFINIDAD'
               and c.val_minimo = reg.afinidad;
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               v_detalle.afinidad := null;
            WHEN OTHERS THEN
               v_detalle.afinidad := null;
         END;

         -- obtener tipo
         BEGIN
            select t.descripcion
              into v_detalle.descripcion
              from ta_tipos t
             where t.afinidad = reg.afinidad
               and (t.sub_afinidad = reg.sub_afinidad or reg.sub_afinidad is null);
         EXCEPTION
            WHEN NO_DATA_FOUND THEN
               v_detalle.descripcion := v_detalle.afinidad;
            WHEN OTHERS THEN
               v_detalle.descripcion := v_detalle.afinidad;
         END;

         v_can := v_can + 1;
         v_lista.extend;
         v_lista(v_lista.count) := v_detalle;
      END LOOP;

      v_retorno.listaTarjetas := v_lista;
      v_retorno.canTarjetas   := v_can;

      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'fu_obtenerTarjetas(p_relacion: ' || p_relacion || ' )' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);

      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, 'ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_ins_can_puntos(p_cod_sesion           IN BW_AUT_SESIONES.COD_SESION%TYPE,
                              p_cod_canal            IN BW_AUT_SESIONES.COD_CANAL%TYPE,
                              p_nro_tarjeta          IN BW_CANJES.NRO_TARJETA%TYPE DEFAULT NULL,
                              p_cat_producto         IN BW_CANJES.CAT_PRODUCTO%TYPE,
                              p_nom_producto         IN BW_CANJES.NOM_PRODUCTO%TYPE,
                              p_des_producto         IN BW_CANJES.DES_PRODUCTO%TYPE,
                              p_tel_contacto         IN BW_CANJES.TEL_CONTACTO%TYPE,
                              p_ema_contacto         IN BW_CANJES.EMA_CONTACTO%TYPE,
                              p_ema_des_notificacion IN BW_CANJES.EMA_DES_NOTIFICACION%TYPE,
                              p_cantidad             IN BW_CANJES.CANTIDAD%TYPE DEFAULT NULL,
                              p_puntos               IN BW_CANJES.PUNTOS%TYPE DEFAULT NULL,
                              p_tel_proveedor        IN BW_CANJES.TEL_PROVEEDOR%TYPE DEFAULT NULL,
                              p_showroom             IN BW_CANJES.SHOWROOM%TYPE DEFAULT NULL,
                              p_direccion            IN BW_CANJES.DIRECCION%TYPE DEFAULT NULL,
                              p_rec_autorizada       IN BW_CANJES.REC_AUTORIZADA%TYPE DEFAULT NULL,
                              p_per_autorizada       IN BW_CANJES.PER_AUTORIZADA%TYPE DEFAULT NULL,
                              p_cod_tip_autorizado   IN BW_CANJES.COD_TIP_AUTORIZADO%TYPE DEFAULT NULL,
                              p_nro_doc_autorizado   IN BW_CANJES.NRO_DOC_AUTORIZADO%TYPE DEFAULT NULL,
                              p_hor_inicio           IN BW_CANJES.HOR_INICIO%TYPE DEFAULT NULL,
                              p_hor_fin              IN BW_CANJES.HOR_FIN%TYPE DEFAULT NULL,
                              p_ben_titular          IN BW_CANJES.BEN_TITULAR%TYPE DEFAULT NULL,
                              p_beneficiario         IN BW_CANJES.BENEFICIARIO%TYPE DEFAULT NULL,
                              p_turno                IN BW_CANJES.TURNO%TYPE DEFAULT NULL,
                              p_sol_ida              IN BW_CANJES.SOL_IDA%TYPE DEFAULT NULL,
                              p_fec_salida           IN BW_CANJES.FEC_SALIDA%TYPE DEFAULT NULL,
                              p_fec_retorno          IN BW_CANJES.FEC_RETORNO%TYPE DEFAULT NULL,
                              p_fec_flexible         IN BW_CANJES.FEC_FLEXIBLE%TYPE DEFAULT NULL,
                              p_cla_servicio         IN BW_CANJES.CLA_SERVICIO%TYPE DEFAULT NULL,
                              p_can_ninos            IN BW_CANJES.CAN_NINOS%TYPE DEFAULT NULL,
                              p_can_adultos          IN BW_CANJES.CAN_ADULTOS%TYPE DEFAULT NULL,
                              p_lin_aerea            IN BW_CANJES.LIN_AEREA%TYPE DEFAULT NULL,
                              p_nro_doc_beneficiario IN Bw_Canjes.NRO_DOC_BENEFICIARIO%TYPE DEFAULT NULL,
                              p_fec_entrada          IN BW_CANJES.FEC_ENTRADA%TYPE DEFAULT NULL,
                              p_cod_verificador      IN BW_CANJES.COD_VERIFICADOR%TYPE DEFAULT NULL,
                              p_condiciones          IN VARCHAR2 DEFAULT NULL,
                              p_detalles             IN TYP_LISTADETALLECANJE DEFAULT NULL,
                              p_est_canje            IN BW_CANJES.ESTADO%TYPE,
                              p_nom_proveedor        IN BW_CANJES.COMERCIO%TYPE DEFAULT NULL,
                              p_cod_producto         IN BW_CANJES.COD_PRODUCTO%TYPE DEFAULT NULL
                              ) RETURN TYP_CANJE IS
      v_log_datos               BW_BITACORA.DATOS%TYPE;
      v_cod_sesion              BW_AUT_SESIONES.COD_SESION%TYPE;
      v_cod_canal               BW_AUT_SESIONES.COD_CANAL%TYPE;
      v_sesion_info             typ_validarSesion;
      v_cod_operacion           VARCHAR2(3) := '228';
      v_retorno                 typ_canje := typ_canje();

   BEGIN

      -- valida sesion del cliente
      v_cod_sesion  := depurarAlfanumerico(p_cod_sesion, 32);
      v_cod_canal   := depurarNumerico(p_cod_canal, 3);
      v_sesion_info := fu_validarSesion(v_cod_sesion, v_cod_canal);
      IF v_sesion_info.error = 'S' THEN
         v_retorno.error                := v_sesion_info.error;
         v_retorno.nombreRespuesta      := v_sesion_info.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_sesion_info.descripcionRespuesta;
         pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, 'fu_ins_can_puntos: [sesion invalida]', BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      v_log_datos := 'fu_ins_can_puntos: inicio de funcion';
      pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, v_log_datos, BITACORA_ENTRADA);

      --llamamos a paw_can
      v_retorno := paw_can.fu_ns_ins_can_puntos(
                              v_sesion_info.codigoPersona,
                              v_sesion_info.codigoCanal,
                              p_nro_tarjeta          ,
                              p_cat_producto         ,
                              p_nom_producto         ,
                              p_des_producto         ,
                              p_tel_contacto         ,
                              p_ema_contacto         ,
                              p_ema_des_notificacion ,
                              p_cantidad             ,
                              p_puntos               ,
                              p_tel_proveedor        ,
                              p_showroom             ,
                              p_direccion            ,
                              p_rec_autorizada       ,
                              p_per_autorizada       ,
                              p_cod_tip_autorizado   ,
                              p_nro_doc_autorizado   ,
                              p_hor_inicio           ,
                              p_hor_fin              ,
                              p_ben_titular          ,
                              p_beneficiario         ,
                              p_turno                ,
                              p_sol_ida              ,
                              p_fec_salida           ,
                              p_fec_retorno          ,
                              p_fec_flexible         ,
                              p_cla_servicio         ,
                              p_can_ninos            ,
                              p_can_adultos          ,
                              p_lin_aerea            ,
                              p_nro_doc_beneficiario ,
                              p_fec_entrada          ,
                              p_cod_verificador      ,
                              p_condiciones          ,
                              p_detalles             ,
                              p_est_canje            ,
                              p_nom_proveedor        ,
                              p_cod_producto         ,
                              v_cod_sesion
                              );

      pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, v_sesion_info.codigoEmpresa,'fu_ins_can_puntos: '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta), BITACORA_SALIDA);

      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, v_sesion_info.codigoEmpresa, 'fu_ins_can_puntos: ORA-ERR:[' || SQLERRM || '] '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta), BITACORA_ERROR);
         RETURN v_retorno;
   END;

   FUNCTION fu_obt_can_puntos(p_cod_sesion IN BW_AUT_SESIONES.COD_SESION%TYPE,
                              p_cod_canal  IN BW_AUT_SESIONES.COD_CANAL%TYPE,
                              p_nro_canje  IN BW_CANJES.NRO_CANJE%TYPE) RETURN TYP_CANJE IS
      v_cod_sesion    BW_AUT_SESIONES.COD_SESION%TYPE;
      v_cod_canal     BW_AUT_SESIONES.COD_CANAL%TYPE;
      v_sesion_info   typ_validarSesion;
      v_cod_operacion VARCHAR2(3) := '230';
      v_retorno       typ_canje := typ_canje();
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- valida sesion del cliente
      v_cod_sesion  := depurarAlfanumerico(p_cod_sesion, 32);
      v_cod_canal   := depurarNumerico(p_cod_canal, 3);
      v_sesion_info := fu_validarSesion(v_cod_sesion, v_cod_canal);

      IF v_sesion_info.error = 'S' THEN
         v_retorno.error                := v_sesion_info.error;
         v_retorno.nombreRespuesta      := v_sesion_info.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_sesion_info.descripcionRespuesta;
         pr_insertarBitacora(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal, v_cod_sesion, v_cod_operacion, NULL, 'fu_obt_can_puntos: [sesion invalida]', BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --llamamos a paw_can
      v_retorno := paw_can.fu_ns_obt_can_puntos(v_sesion_info.codigoPersona, v_sesion_info.codigoCanal,p_nro_canje,v_cod_sesion);

      RETURN v_retorno;

   END;

