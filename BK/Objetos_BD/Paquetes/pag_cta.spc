CREATE OR REPLACE PACKAGE IT.PAG_CTA IS

TYPE RG_MOVS IS RECORD
 (HORA GE_MOVIMIENTOS.HORA%TYPE
 ,FECHA GE_MOVIMIENTOS.FECHA%TYPE
 ,FEC_VALOR GE_MOVIMIENTOS.FEC_VALOR%TYPE
 ,COD_USUARIO GE_MOVIMIENTOS.COD_USUARIO%TYPE
 ,NRO_SECUENCIA GE_MOVIMIENTOS.NRO_SECUENCIA%TYPE
 ,NRO_CUENTA GE_MOVIMIENTOS.NRO_CUENTA%TYPE
 ,COD_MONEDA GE_MOVIMIENTOS.COD_MONEDA%TYPE
 ,MONTO GE_MOVIMIENTOS.MONTO%TYPE
 ,EMI_AVISO GE_MOVIMIENTOS.EMI_AVISO%TYPE
 ,ESTADO VARCHAR2(1) default 'N'
 ,CONCEPTO GE_MOVIMIENTOS.CONCEPTO%TYPE
 ,COD_OFI_ORIGEN GE_MOVIMIENTOS.COD_OFI_ORIGEN%TYPE
 ,COD_TRA_PADRE GE_MOVIMIENTOS.COD_TRA_PADRE%TYPE
 ,COD_MOD_PADRE GE_MOVIMIENTOS.COD_MOD_PADRE%TYPE
 ,COD_MAD_PADRE GE_MOVIMIENTOS.COD_MAD_PADRE%TYPE
 ,COD_TRANSACCION GE_MOVIMIENTOS.COD_TRANSACCION%TYPE
 ,REVERSADO VARCHAR2(1) default 'N'
 ,NRO_CAJA GE_MOVIMIENTOS.NRO_CAJA%TYPE := NULL
 ,COTIZACION GE_MOVIMIENTOS.COTIZACION%TYPE
 ,PROTEGIDO VARCHAR2(1) default 'N'
 ,COD_TASA GE_MOVIMIENTOS.COD_TASA%TYPE
 ,VAL_TASA GE_MOVIMIENTOS.VAL_TASA%TYPE
 ,NRO_DOCUMENTO GE_MOVIMIENTOS.NRO_DOCUMENTO%TYPE
 ,NRO_DOCUMENTO2 GE_MOVIMIENTOS.NRO_DOCUMENTO2%TYPE 
 ,NRO_DOCUMENTO3 GE_MOVIMIENTOS.NRO_DOCUMENTO3%TYPE 
 ,TIP_MOVIMIENTO VARCHAR2(1)
 ,AFECTA VARCHAR2(1) default 'S'
 ,COD_BANCO GE_BANCOS.COD_BANCO%TYPE
 ,COD_CAUSA GE_CAUSALES.COD_CAUSA%TYPE
 ,COD_RUBRO GE_MOVIMIENTOS.COD_RUBRO%TYPE
 ,TIP_MOV_RUBRO GE_MOVIMIENTOS.TIP_MOV_RUBRO%TYPE
 ,MTO_EQU_LOCAL GE_MOVIMIENTOS.MTO_EQU_LOCAL%TYPE
 ,REFERENCIA GE_MOVIMIENTOS.REFERENCIA%TYPE default null
);
TYPE RG_CTAS IS RECORD
 (NRO_CUENTA AH_CTA_VISTAS.NRO_CUENTA%TYPE
 ,COD_CLIENTE GE_CLIENTES.COD_PERSONA%TYPE
 ,COD_MODULO BA_MODULOS.COD_MODULO%TYPE
 ,COD_MODALIDAD GE_MODALIDADES.COD_MODALIDAD%TYPE
 ,COD_OFICINA BA_OFICINAS.COD_OFICINA%TYPE
 ,DIG_VERIFICADOR GE_CUENTAS.DIG_VERIFICADOR%TYPE
 ,COD_MONEDA BA_MONEDAS.COD_MONEDA%TYPE
 ,DENOMINACION GE_CUENTAS.DENOMINACION%TYPE
 ,ACUERDO VARCHAR2(1) default 'N'
 ,AUTORIZADO VARCHAR2(1) default 'N'
 ,COD_USU_AUTORIZADOR GE_AUTORIZACIONES.COD_USU_AUTORIZADOR%TYPE
 ,COD_AUTORIZACION GE_AUTORIZACIONES.COD_AUTORIZACION%TYPE
 ,TRA_PROHIBIDA VARCHAR2(1) default 'N'
 ,RET_PERSONALIZADA VARCHAR2(1) default 'N'
 ,CTA_COMBINADA VARCHAR2(1) default 'N'
 ,CTA_CTE_COMBINADA GE_CUENTAS.NRO_CUENTA%TYPE
 ,COD_USU_OFICIAL BA_USUARIOS.COD_USUARIO%TYPE
 ,EST_BATCH AH_CTA_VISTAS.EST_BATCH%TYPE
 ,ESTADO GE_CUENTAS.ESTADO%TYPE
 ,NVO_ESTADO GE_CUENTAS.ESTADO%TYPE
 ,FEC_APERTURA AH_CTA_VISTAS.FEC_APERTURA%TYPE
 ,SAL_RET_BATCH AH_CTA_VISTAS.SAL_RET_BATCH%TYPE
 ,SAL_RETENIDO AH_CTA_VISTAS.SAL_RETENIDO%TYPE
 ,SAL_BLO_BATCH AH_CTA_VISTAS.SAL_BLO_BATCH%TYPE
 ,SAL_BLOQUEADO AH_CTA_VISTAS.SAL_BLOQUEADO%TYPE
 ,SAL_TOT_BATCH AH_CTA_VISTAS.SAL_TOT_BATCH%TYPE
 ,SAL_TOTAL AH_CTA_VISTAS.SAL_TOTAL%TYPE
 ,MTO_DEB_PENDIENTES AH_CTA_VISTAS.MTO_DEB_PENDIENTES%TYPE
 ,MTO_CRE_A_CONFIRMAR AH_CTA_VISTAS.MTO_CRE_A_CONFIRMAR%TYPE
 ,MTO_CRE_PENDIENTES AH_CTA_VISTAS.MTO_CRE_PENDIENTES%TYPE
 ,MTO_APERTURA AH_CTA_VISTAS.MTO_APERTURA%TYPE default 0
 ,CAPITAL AH_CTA_CERTIFICADOS.CAPITAL%TYPE default 0
 ,COD_ENTE AH_CTA_VISTAS.COD_ENTE%TYPE
 ,SAL_ACTUAL NUMBER default 0
 ,SAL_DISPONIBLE NUMBER(18, 2) default 0
 ,TAS_PERSONALIZADA GE_CUENTAS.TAS_PERSONALIZADA%TYPE
 ,COD_TASA GE_TASAS.COD_TASA%TYPE
 ,SAL_MINIMO AH_CTA_VISTAS.SAL_MINIMO%TYPE
 ,VAL_TASA GE_TAS_FECHAS.VAL_TASA%TYPE
 ,FEC_VENCIMIENTO GE_CUENTAS.FEC_VENCIMIENTO%TYPE
 ,ACT_ULT_MOVIMIENTO VARCHAR2(1) default 'S'
 ,FEC_CAM_ESTADO GE_CUENTAS.FEC_CAM_ESTADO%TYPE
 ,FEC_ULT_MOVIMIENTO GE_MOVIMIENTOS.FECHA%TYPE
 ,HOR_ULT_MOVIMIENTO GE_MOVIMIENTOS.HORA%TYPE
 ,FEC_ULT_CAPITALIZACION AH_CTA_VISTAS.FEC_ULT_CAPITALIZACION%TYPE
 ,EST_CERTIFICADO AH_CTA_CERTIFICADOS.EST_CERTIFICADO%TYPE
 ,BLOQUEADO AH_CTA_CERTIFICADOS.BLOQUEADO%TYPE default 'N'
 ,COD_SEG_CLIENTE GE_SEG_CLIENTES.COD_SEG_CLIENTE%TYPE
 ,SAL_DIS_COMBINADA NUMBER(18,2) := 0
 ,NRO_CTA_COMBINADA varchar2(20) := ''
);

G_LUGAR VARCHAR2(250);
G_MSJ_ERROR VARCHAR2(1000);--(250);
G_COD_ERROR NUMBER(3) default 0;
G_OK_PROCESAR VARCHAR2(1) default 'N';
G_CTAS PAG_CTA.RG_CTAS;
G_HORARIO   VARCHAR2(1) default 'D';
g_sobregira varchar2(1) := 'N'; --indicador para permitir sobregirar cuentas

/* Obtiene La linea total de Sobregiro vigente */
FUNCTION FU_OBT_LIN_SOBREGIRO
 (P_NRO_CUENTA IN GE_CUENTAS.NRO_CUENTA%TYPE
 ,P_FEC_ACTUAL IN DATE default Null
 )
 RETURN NUMBER;
/* Ver transaccion prohibida. */
FUNCTION FU_VER_TRA_PROHIBIDA
 (P_NRO_CUENTA IN GE_CUENTAS.NRO_CUENTA%TYPE
 ,P_COD_TRANSACCION IN GE_TRANSACCIONES.COD_TRANSACCION%TYPE
 ,P_COD_MODULO IN NUMBER default NULL
 ,P_COD_MODALIDAD IN NUMBER default NULL
 )
 RETURN VARCHAR2;
/* Obtiene la Cta Cte si es una Cuenta Combinada. */
FUNCTION FU_OBT_CTA_CTE_COMB
 (P_NRO_CUENTA IN AH_CTA_VISTAS.NRO_CUENTA%TYPE
 )
 RETURN VARCHAR2;
/* Obtiene la moneda que contiene el registro del paquete. */
FUNCTION FU_OBT_MON_CUENTA
 RETURN VARCHAR2;
/* Retorna el nombre de la cuenta contenida en el registro del paquete. */
FUNCTION FU_OBT_NOM_CUENTA
 RETURN VARCHAR2;
/* Obtiene el saldo total almacenado en el registro del paquete. */
FUNCTION FU_SAL_TOTAL
 RETURN NUMBER;
/* Obtiene la transaccion prohibida del registro almacenado en el paq. */
FUNCTION FU_TRA_PROHIBIDA
 RETURN VARCHAR2;
/* Obtiene el saldo retenido almacenado en el registro del paquete. */
FUNCTION FU_SAL_RETENIDO
 RETURN NUMBER;
/* Obtiene el saldo disponible almacenado en el registro del paquete. */
FUNCTION FU_SAL_DISPONIBLE
 RETURN NUMBER;
/* Obtiene el saldo bloqueado almacenado en el registro del paquete. */
FUNCTION FU_SAL_BLOQUEADO
 RETURN NUMBER;
/* Obtiene la modalidad de la cuenta contenida en el registro. */
FUNCTION FU_OBT_MAD_CUENTA
 RETURN NUMBER;
/* Obtiene el datos de acuerdo de sobregiro almacenado en el registro. */
FUNCTION FU_ACU_SOBREGIRO
 RETURN VARCHAR2;
/* Obtiene el dato de autorizacion almacenado en el registro. */
FUNCTION FU_OBT_AUTORIZADO
 RETURN VARCHAR2;
/* Retorna es la transaccion puede ser vista o no por el cliente. */
FUNCTION FU_VE_CLIENTE
 (P_COD_TRANSACCION IN GE_TRANSACCIONES.COD_TRANSACCION%TYPE
 )
 RETURN VARCHAR2;
/* Obtiene el siguiente numero de cuenta. */
FUNCTION FU_OBT_SIG_CTA
