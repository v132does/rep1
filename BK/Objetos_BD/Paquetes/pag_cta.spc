 )
 RETURN VARCHAR2;
/* Calcula el digito verificador. */
FUNCTION FU_CAL_DIG_VERIFICA
 (P_NRO_CUENTA IN GE_CUENTAS.NRO_CUENTA%TYPE
 )
 RETURN NUMBER;
