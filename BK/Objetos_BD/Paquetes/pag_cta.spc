 ,P_SAL_DISPONIBLE IN OUT NUMBER
 ,P_PROCESA IN OUT VARCHAR2
 ,P_COD_TRANSACCION IN GE_MOVIMIENTOS.COD_TRANSACCION%TYPE default null
 );
