CREATE OR REPLACE PACKAGE IT.PAC_MES IS

--Variables Globales.
V_CONCEPTO        GE_MOVIMIENTOS.CONCEPTO%TYPE;
V_EST_CUENTA      CC_CTA_CORRIENTES.ESTADO%TYPE;
V_COTIZACION      GE_COTIZACIONES.VAL_COMPRA%TYPE;
V_COD_MODULO      BA_MODULOS.COD_MODULO%TYPE;
V_COD_MODALIDAD   GE_MODALIDADES.COD_MODALIDAD%TYPE;
V_COD_OFICINA     BA_OFICINAS.COD_OFICINA%TYPE;
V_SAL_CAPITAL     CC_CTA_CORRIENTES.SAL_TOTAL%TYPE;
V_SECUENCIA       GE_MOVIMIENTOS.NRO_SECUENCIA%TYPE;
V_COD_TRA_PADRE   GE_MOVIMIENTOS.COD_TRA_PADRE%TYPE;
V_COD_TRA_HIJO    GE_MOVIMIENTOS.COD_TRA_PADRE%TYPE;
V_MTO_TRANSACCION GE_MOVIMIENTOS.MONTO%TYPE;
RV_CTACTE         CC_CTA_CORRIENTES%ROWTYPE;
V_IMPORTE         CC_CTA_CORRIENTES.SAL_TOTAL%TYPE;
V_MONE_LOCAL      BA_MONEDAS.COD_MONEDA%TYPE;
V_HORAMOVIM       GE_MOVIMIENTOS.HORA%TYPE;
V_NRO_CUENTA      CC_CTA_CORRIENTES.NRO_CUENTA%TYPE;
V_CATEGORIA       GE_CLIENTES.CAT_AUTOMATICA%TYPE;
V_TRANSACCION     GE_MOVIMIENTOS.COD_TRANSACCION%TYPE;
WLUGAR            VARCHAR2(100);
V_FCDEHOY         DATE;
V_FCVENCI         DATE;

/* Cambio de Situación */
PROCEDURE PR_CAM_SITUACION
 (P_COD_MODULO     IN CC_CTA_CORRIENTES.COD_MODULO%TYPE
 ,P_COD_MODALIDAD  IN CC_CTA_CORRIENTES.COD_MODALIDAD%TYPE
 ,P_COD_OFICINA    IN CC_CTA_CORRIENTES.COD_OFICINA%TYPE
 ,P_NRO_CUENTA     IN CC_CTA_CORRIENTES.NRO_CUENTA%TYPE
 ,P_CATEGORIA      IN GE_CLIENTES.CAT_AUTOMATICA%TYPE
 ,P_FECHA          IN GE_MOVIMIENTOS.FECHA%TYPE
 ,P_SITUACION      IN CC_SOBREGIROS_RES.SIT_DEUDA%TYPE
 ,P_HORA           IN OUT GE_MOVIMIENTOS.HORA%TYPE
 ,P_NRO_SECUENCIA  IN OUT GE_MOVIMIENTOS.NRO_SECUENCIA%TYPE
 );
/* Realizar asientos contables por el cambio de estado del operación vencida. */
PROCEDURE PR_INS_ASI_CAM_ESTADOS
 (P_COD_TRA_PADRE IN GE_MOVIMIENTOS.COD_TRA_PADRE%TYPE
 ,P_COD_TRANSACCION IN GE_MOVIMIENTOS.COD_TRANSACCION%TYPE
 ,P_MONTO IN GE_MOVIMIENTOS.MONTO%TYPE
 ,P_CONCEPTO IN GE_MOVIMIENTOS.CONCEPTO%TYPE
 ,P_ESTADO IN GE_MOVIMIENTOS.EST_CUENTA%TYPE
 );

/* Proceso de cambio de estado de las cuentas corrientes. */
PROCEDURE PR_PRO_CAM_ESTADO;

/* Recupera monto previsión de ge_cla_operaciones. */
FUNCTION FU_OBT_PREVISION
 (P_NRO_CUENTA IN CC_CTA_CORRIENTES.NRO_CUENTA%TYPE
 )
 RETURN NUMBER;
/* Recupera monto valuación de cc_valuaciones. */
FUNCTION FU_OBT_VALUACION
 (P_NRO_CUENTA IN CC_CTA_CORRIENTES.NRO_CUENTA%TYPE)
 RETURN NUMBER;
 
/* Permite obtener los datos de las cuentas corrientes. */
PROCEDURE PR_OBT_DAT_CTA_CORRIENTES
  (P_NRO_CUENTA     IN CC_CTA_CORRIENTES.NRO_CUENTA%TYPE,
   RG_CTA_CORRIENTE IN OUT CC_CTA_CORRIENTES%ROWTYPE);
   
/* Obtener la situación del sobregiro. */
FUNCTION FU_OBT_EST_SOBREGIRO(P_NRO_CUENTA IN CC_CTA_CORRIENTES.NRO_CUENTA%TYPE)
RETURN VARCHAR2; 
   
END PAC_MES;
/

