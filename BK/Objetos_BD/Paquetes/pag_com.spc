                           P_REGISTRO IN VARCHAR2) RETURN DATE;

PROCEDURE PR_INS_CTA_DEBITO(P_COD_ENTE IN NUMBER,
                            P_CTA_DEBITO IN VARCHAR2,
                            P_ERROR OUT VARCHAR2);

END PAG_COM;
