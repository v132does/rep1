   /* FUNCTION fu_cargarTransferencias(p_sesion                IN VARCHAR2,
                                     p_codigoCanal           IN VARCHAR2,
                                     p_modo                  IN VARCHAR2,
                                     p_cuentaDebito          IN VARCHAR2 DEFAULT NULL,
                                     p_monedaCredito         IN VARCHAR2 DEFAULT NULL,
                                     p_montoCredito          IN NUMBER DEFAULT NULL,
                                     p_cuentaCredito         IN VARCHAR2 DEFAULT NULL,
                                     p_documentoCredito      IN VARCHAR2 DEFAULT NULL,
                                     p_nombreBeneficiario    IN VARCHAR2 DEFAULT NULL,
                                     p_direccionBeneficiario IN VARCHAR2 DEFAULT NULL,
                                     p_tipoDocBeneficiario   IN VARCHAR2 DEFAULT NULL,
                                     p_numeroTransferencia   IN NUMBER DEFAULT 0)
      RETURN typ_mensajeRespuesta IS

      c_cod_operacion      CONSTANT VARCHAR2(03) := '230';
      c_dup_transferencias CONSTANT VARCHAR2(04) := '303';
      c_err_transferencias CONSTANT VARCHAR2(04) := '304';
      c_eli_transferencias CONSTANT VARCHAR2(04) := '305';

      v_cod_canal   VARCHAR2(3);
      v_log_mensaje VARCHAR2(1000);
      v_sesion      bw_aut_sesiones.cod_sesion%TYPE;
      userInfo      paw_bem.typ_validarSesion;
      v_retorno     typ_mensajeRespuesta := typ_mensajeRespuesta;

      -- Variables Internas
      v_nro_cta_debito       VARCHAR2(16);
      v_nro_cta_credito      VARCHAR2(20); -- cuenta de credito
      v_modo                 VARCHAR2(1);
      v_cod_mon_credito      bw_tra_frecuentes.cod_moneda%TYPE; -- moneda de la transferencia
      v_nro_doc_credito      bw_tra_frecuentes.nro_cta_solicitante%TYPE := null; -- nro de documento del acreditado
      v_nom_beneficiario     bw_tra_frecuentes.nom_beneficiario%TYPE;
      v_dir_beneficiario     bw_tra_frecuentes.dir_beneficiario%TYPE;
      v_tip_doc_beneficiario bw_tra_frecuentes.cod_tip_doc_beneficiario%TYPE;
      v_mto_credito          ge_movimientos.monto%TYPE; -- Monto de la transferencia
      v_nro_transferencia    bw_tra_frecuentes.nro_transferencia %TYPE;

    BEGIN
      v_sesion               := paw_bem.depurarAlfanumerico(p_sesion, 32);
      v_cod_canal            := paw_bem.depurarAlfanumerico(p_codigoCanal,3);
      v_modo                 := paw_bem.depurarAlfanumerico(p_modo, 1);
      v_nro_cta_debito       := paw_bem.depurarCuenta(p_cuentaDebito, paw_bem.CUENTA_TAMANO);
      v_cod_mon_credito      := paw_bem.depurarAlfanumerico(p_monedaCredito, 3);
      v_mto_credito          := paw_bem.depurarNumerico(p_montoCredito, 18);
      v_nro_cta_credito      := paw_bem.depurarAlfanumerico(p_cuentaCredito,20);
      v_nro_doc_credito      := paw_bem.depurarAlfanumerico(p_documentoCredito,                                                            20);
      v_nom_beneficiario     := paw_bem.depurarTextos(p_nombreBeneficiario,100);
      v_dir_beneficiario     := paw_bem.depurarAlfanumerico(p_direccionBeneficiario,100);
      v_tip_doc_beneficiario := paw_bem.depurarAlfanumerico(p_tipoDocBeneficiario,3);
      v_nro_transferencia    := paw_bem.depurarNumerico(p_numeroTransferencia,10);

      paw_bem.pr_mensajeUsuario(msg_ok,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);

      \* Obtiene la informacion de parametros recibos y el return del TYPE *\
      paw_log.g_typ_mensajeRespuesta := v_retorno;
      paw_log.pr_logValoresTypes('typ_mensajeRespuesta','fu_cargarTransferencias' || ' ' ||p_sesion || ', ' || p_codigoCanal || ', ' ||
                                 p_modo || ', ' || p_cuentaDebito || ', ' ||p_monedaCredito || ', ' || p_montoCredito || ', ' ||p_cuentaCredito || ', ' ||p_documentoCredito || ', ' ||
                                 p_nombreBeneficiario || ', ' ||p_direccionBeneficiario || ', ' ||p_tipoDocBeneficiario || ', ' ||
                                 p_numeroTransferencia);

      -- 1. valido la clave del cliente
      userInfo := paw_bem.fu_validarSesion(v_sesion, v_cod_canal);

      --Logear parametros
      v_log_mensaje := 'fu_cargarTransferencias (sesion=' || v_sesion ||', codigoCanal=' || v_cod_canal || ',modo=' ||v_modo || ', cuentaCredio=' || v_nro_cta_debito || ' ,moneda=' || p_monedaCredito || ',montoCredito=' || p_montoCredito || ' )';
      paw_bem.pr_insertarBitacora(userInfo.codigoPersona,v_cod_canal, v_sesion, c_cod_operacion,userInfo.codigoEmpresa,v_log_mensaje, bitacora_entrada);

      IF (userInfo.error = 'S') THEN
        v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
        v_retorno.error                := 'S';
        RETURN v_retorno;
      END IF;
      if v_modo = 'G' then
        begin
          select s_transferencia.nextval
            into v_nro_transferencia
            from dual;

          insert into bw_tra_frecuentes (nro_transferencia,  cod_persona,  cod_per_vinculada,
             nro_cta_solicitante, cod_moneda, monto, nro_cta_beneficiario,
             nom_beneficiario, dir_beneficiario, cod_tip_doc_beneficiario, nro_doc_beneficiario)
          values
            (v_nro_transferencia,userInfo.codigoPersona,userInfo.codigoEmpresa,
             v_nro_cta_debito,v_cod_mon_credito,v_mto_credito,v_nro_cta_credito,v_nom_beneficiario,
             v_dir_beneficiario,v_tip_doc_beneficiario,v_nro_doc_credito);

        exception
          when dup_val_on_index then
            paw_bem.pr_mensajeUsuario(c_dup_transferencias,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
            paw_bem.pr_insertarBitacora(userInfo.codigoPersona,v_cod_canal,v_sesion,c_cod_operacion, userInfo.codigoEmpresa,'fu_frecuenteSipap -' ||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),bitacora_error);
            RETURN V_RETORNO;
          when others then
            paw_bem.pr_mensajeUsuario(c_err_transferencias,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,v_retorno.error);
            paw_bem.pr_insertarBitacora(userInfo.codigoPersona,v_cod_canal, v_sesion,c_cod_operacion,userInfo.codigoEmpresa,'fu_frecuenteSipap- ' || SQLERRM || '-' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, null),bitacora_error);
            RETURN V_RETORNO;
        end;
      elsif v_modo = 'E' then
        if nvl(v_nro_transferencia, 0) = 0 then
          paw_bem.pr_mensajeUsuario(c_eli_transferencias,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          paw_bem.pr_insertarBitacora(userInfo.codigoPersona,v_cod_canal, v_sesion,c_cod_operacion,userInfo.codigoEmpresa, 'fu_frecuenteTransferencia -' ||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, null),bitacora_error);
        else
          delete from bw_tra_frecuentes
           where nro_transferencia = v_nro_transferencia;
        end if;
      end if;

      RETURN v_retorno;
    EXCEPTION
      WHEN OTHERS THEN
        paw_bem.pr_mensajeUsuario(msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        paw_bem.pr_insertarBitacora(userInfo.codigoPersona,v_cod_canal,v_sesion, c_cod_operacion, userInfo.codigoEmpresa,'fu_frecuenteTransferencias-' || SQLERRM || '-' ||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),bitacora_error);
        RETURN v_retorno;
    END fu_cargarTransferencias;*/

 /* FUNCTION fu_obtenerTransferencias(p_sesion      IN VARCHAR2,
                                      p_codigoCanal IN VARCHAR2)
      RETURN typ_TransFrecuentes IS

      c_cod_operacion CONSTANT VARCHAR2(03) := '231';
      v_dias       NUMBER := 7;
      v_con        NUMBER := 0;
      v_fec_actual DATE := pag_cal.fu_obt_fec_actual(9);
      v_var_fecha  DATE;

      v_cod_canal               VARCHAR2(3);
      v_log_mensaje             VARCHAR2(1000);
      v_sesion                  bw_aut_sesiones.cod_sesion%TYPE;
      userInfo                  typ_validarSesion;
      v_retorno                 typ_TransFrecuentes := typ_TransFrecuentes;
      v_cta_bcp_gs_liquidacion  ge_snp_cta_bancos.nro_cta_bancaria%TYPE;
      v_cta_bcp_usd_liquidacion ge_snp_cta_bancos.nro_cta_bancaria%TYPE;
      v_bcp_cod_swift           ge_bancos.cod_swift%TYPE := paw_bem.lf_obt_bco_swift(1);

      -- Variables Internas
      v_listaTransferencias typ_listaTransferencias := typ_listaTransferencias();

      cursor transferencias is
        Select nro_transferencia,
               nro_cta_solicitante,
               cod_moneda,
               monto,
               nro_cta_beneficiario,
               nom_beneficiario,
               dir_beneficiario,
               cod_tip_doc_beneficiario,
               nro_doc_beneficiario
          from bw_tra_frecuentes
         where cod_persona = userInfo.codigoPersona
           and (userInfo.codigoEmpresa is null or
               cod_per_vinculada = userInfo.codigoEmpresa)
         order by fec_insercion desc;

    BEGIN
      v_sesion    := paw_bem.depurarAlfanumerico(p_sesion, 32);
      v_cod_canal := paw_bem.depurarAlfanumerico(p_codigoCanal, 3);

      paw_bem.pr_mensajeUsuario(MSG_OK,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- 1. valido la clave del cliente
      userInfo := paw_bem.fu_validarSesion(v_sesion, v_cod_canal);

      --Logear parametros
      v_log_mensaje := 'fu_obtenerTransferencias (sesion=' || v_sesion ||
                       ', codigoCanal=' || v_cod_canal || ')';
      paw_bem.pr_insertarBitacora(userInfo.codigoPersona,v_cod_canal,v_sesion,c_cod_operacion, userInfo.codigoEmpresa, v_log_mensaje,BITACORA_ENTRADA);

      IF (userInfo.error = 'S') THEN
        v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
        v_retorno.error                := 'S';

        \* Obtiene la informacion de parametros recibos y el return del type *\
        paw_log.g_typ_TransFrecuentes := v_retorno;
        paw_log.pr_logValoresTypes('typ_TransFrecuentes', 'fu_obtenerTransferencias' || ' ' || p_sesion || ', ' || p_codigoCanal);
        RETURN V_RETORNO;
      END IF;
      FOR pl IN transferencias LOOP
        DECLARE
          v_frecuente typ_TransFrecuente := typ_TransFrecuente;
        BEGIN
          v_frecuente.numeroTransferencia   := pl.nro_transferencia;
          v_frecuente.cuentaSolicitante     := pl.nro_cta_solicitante;
          v_frecuente.codigoMoneda          := pl.cod_moneda;
          v_frecuente.monto                 := pl.monto;
          v_frecuente.cuentaBeneficiario    := pl.nro_cta_beneficiario;
          v_frecuente.nombreBeneficiario    := pl.nom_beneficiario;
          v_frecuente.direccionBeneficiario := pl.dir_beneficiario;
          v_frecuente.tipoDocBeneficiario   := pl.cod_tip_doc_beneficiario;
          v_frecuente.numeroDocBeneficario  := pl.nro_doc_beneficiario;
          v_listaTransferencias.extend;
          v_listaTransferencias(v_listaTransferencias.count) := v_frecuente;
        END;
      END LOOP;

      v_retorno.listatransferencias := v_listaTransferencias;
      RETURN v_retorno;
    EXCEPTION
      WHEN OTHERS THEN
        pr_mensajeUsuario(MSG_ERROR,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
        pr_insertarBitacora(userInfo.codigoPersona,v_cod_canal,v_sesion,c_cod_operacion,userInfo.codigoEmpresa,'fu_obtenerTransferencias-' || SQLERRM || '-' ||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),BITACORA_ERROR);
        \* Obtiene la informacion de parametros recibos y el return del type *\
        paw_log.g_typ_TransFrecuentes := v_retorno;
        paw_log.pr_logValoresTypes('typ_TransFrecuentes', 'fu_obtenerTransferencias' || ' ' || p_sesion || ', ' || p_codigoCanal);
        RETURN v_retorno;
    END fu_obtenerTransferencias;
*/
    FUNCTION fu_obtenerDesCuenta(p_numeroCuenta in varchar2,
                                 p_tipoDocumento in varchar2,
                                 p_numeroDocumento in varchar2
       ) RETURN VARCHAR2 IS

      v_descripcion ge_cuentas.denominacion%type := null;
      v_cod_persona ba_personas.cod_persona%type := null;

    BEGIN

        SELECT g.cod_persona
           into v_cod_persona
           FROM ge_cta_clientes g, ge_clientes gg, ba_personas p
          WHERE g.nro_cuenta = p_numeroCuenta
            AND g.cod_persona = gg.cod_persona
            AND relacion = 'P'
            AND gg.cod_persona = p.cod_persona
            AND p.cod_tip_documento = p_tipoDocumento
            AND p.nro_documento = p_numeroDocumento;

          pag_cta.pr_obt_cuenta(p_numeroCuenta);
          IF pag_cta.G_COD_ERROR = 0 THEN
            v_descripcion := pag_cta.G_CTAS.DENOMINACION;
          ELSE
            RETURN pag_cta.G_COD_ERROR || ' - ' || pag_cta.G_MSJ_ERROR;
          END IF;
          RETURN v_descripcion;
    EXCEPTION
       WHEN OTHERS THEN
          RETURN '12 - Cuenta Inexistente!!!';
    END;

    FUNCTION lf_obt_cod_entidad RETURN VARCHAR2 IS

    result GE_PAR_GENERALES.COD_ENTIDAD%TYPE;
    BEGIN
       -- Obtiene el tipo de entidad de la empresa
       SELECT COD_ENTIDAD
         INTO result
         FROM GE_PAR_GENERALES
        WHERE rownum = 1;
       RETURN(result);
    EXCEPTION
       WHEN OTHERS THEN
          RETURN '0';
    END;

   /* FUNCTION fu_obtenerMovimientosPrestamos(p_sesion              IN VARCHAR2,
                                            p_codCanal            IN VARCHAR2,
                                            p_nroCuentaEspecifica IN VARCHAR2,
                                            p_nroPagina           IN NUMBER DEFAULT NULL,
                                            p_cantItemsPagina     IN NUMBER DEFAULT NULL )
                            RETURN typ_detalleMovimientos IS

       c_men_cta_inexistente CONSTANT VARCHAR2(15) := '101';
       c_sin_movimientos     CONSTANT VARCHAR2(15) := '107';
       c_cod_operacion VARCHAR2(3) := '021';
       -- datos recibidos
       v_nro_pagina         NUMBER(3); -- nro de pagina
       v_ver_todas          VARCHAR2(3);
       v_nro_cta_especifica VARCHAR2(16);
       --datos a responder
       v_can_cuentas  NUMBER(3); -- cantidad de Cuentas
       v_can_detalles NUMBER(3) := 0; -- cantidad de cuentas
       -- variables
       v_monto1          NUMBER(18, 2) := 0; -- monto 1
       v_can_movimientos NUMBER(8) := 0;
       v_saldo           NUMBER(18, 2) := 0;
       v_dummy           NUMBER(2) := 0;
       v_fec_actual      DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy

       v_dia_movimiento NUMBER(3) := 89;
       v_fec_inicio     DATE := to_date('01' || to_char(v_fec_actual - v_dia_movimiento, 'mmyyyy'), 'ddmmyyyy');

       v_reg_inicial  NUMBER(10);
       v_reg_final    NUMBER(10);
       v_can_pagina   NUMBER(5); -- movimientos por pagina
       userInfo       typ_validarSesion;
       v_cod_canal    VARCHAR2(3);
       v_retorno      typ_detalleMovimientos := typ_detalleMovimientos;
       v_log_mensaje  VARCHAR2(1000);
       v_can_registro NUMBER(4) := 9999;
       v_sesion       bw_aut_sesiones.cod_sesion%TYPE;

       -- cursor de cuentas pasivas del cliente
       CURSOR cuentas IS
          SELECT a.nro_cuenta, a.cod_modalidad cod_modalidad, a.nro_cuenta cta_formateada, fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) des_tip_cuenta, a.cod_moneda cod_moneda, a.denominacion nom_cuenta, a.cod_modulo, decode(a.cod_moneda, 'GS', 'PYG', a.cod_moneda) swi_moneda, b.relacion
            FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
           WHERE a.nro_cuenta = b.nro_cuenta
             AND b.relacion IN ('O', 'P', 'Y', 'A')
             AND b.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
             AND a.cod_modulo = c.cod_modulo
             AND a.cod_modalidad = c.cod_modalidad
             AND a.estado = c.estado
             AND c.activo = 'S' -- solo cuentas activas
             AND a.estado <> 'X' -- pendiente de verificacion
             AND b.cod_modulo = 6
             AND (v_ver_todas = 'S' OR b.nro_cuenta = v_nro_cta_especifica) -- solo ve la cuenta recibida o todas
             AND NOT EXISTS (SELECT 0
                    FROM bw_cta_accesos p
                   WHERE p.nro_cuenta = b.nro_cuenta
                     AND p.cod_per_vinculo = userInfo.codigoPersona
                     AND p.tip_acceso = 'P'
                     AND p.activo = 'S');

       -- movimientos por cuenta
       CURSOR movimientos
       (
          p_nro_cuenta    IN VARCHAR2,
          p_can_registros IN NUMBER
       ) IS
        SELECT * FROM (
SELECT SUM(monto) monto, fecha, fec_valor, nro_documento,
             upper(decode(nvl(c.tip_despliegue, 'D'),
                            -- Si no tiene nada se asigna D para Descripcion
                           'C', concepto,
                            -- Si es C es Concepto
                           'A', c.abreviatura || ' ' || concepto,
                            -- Si es A es Abreviatura y Concepto
                           c.descripcion)) des_tra_padre,
              -- Si no es C o A entonces es Descripcion
             decode(C_COD_HOMEBANKING, '999', REPLACE(a.hora, ':', ''), '998', REPLACE(a.hora, ':', ''), abr_tra_padre) abr_tra_padre,  hora
        FROM ge_transacciones b, gv_movimientos a, ge_transacciones c
       WHERE nro_cuenta = p_nro_cuenta
         AND estado = 'N'
         AND reversado = 'N'
         AND monto <> 0
         AND cod_tip_movimiento in ('D', 'C')
         AND fecha >= v_fec_inicio
         AND a.cod_modulo = b.cod_modulo
         AND a.cod_modalidad = b.cod_modalidad
         AND a.cod_transaccion = b.cod_transaccion
         AND a.cod_mod_padre = c.cod_modulo
         AND a.cod_mad_padre = c.cod_modalidad
         AND a.cod_tra_padre = c.cod_transaccion
         AND b.ve_cliente = 'S'
         AND a.cod_modulo <> 5
         AND NOT EXISTS (SELECT 0
                FROM ah_retenciones x
               WHERE x.nro_cuenta = a.nro_cuenta
                 AND x.nro_documento = a.nro_documento
                 AND x.cod_retencion = a.cod_retencion
                 AND x.fec_final = a.fec_fin_retencion
                 AND x.liberado = 'N')
        GROUP BY fecha, fec_valor, nro_documento,
                upper(decode(nvl(c.tip_despliegue, 'D'),
                               -- Si no tiene nada se asigna D para Descripcion
                              'C', concepto,
                               -- Si es C es Concepto
                              'A', c.abreviatura || ' ' || concepto,
                               -- Si es A es Abreviatura y Concepto
                              c.descripcion)),
                 -- Si no es C o A entonces es Descripcion
                decode(C_COD_HOMEBANKING, '999', REPLACE(a.hora, ':', ''), '998', REPLACE(a.hora, ':', ''), abr_tra_padre),hora

                )
           WHERE  ROWNUM <= p_can_registros;


    BEGIN
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       \* Obtiene la informacion de parametros recibos y el return del type*\
      paw_log.g_typ_detalleMovimientos := v_retorno;
      paw_log.pr_logValoresTypes('g_typ_detalleMovimientos',
      'MovimientosPrestamos'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuentaEspecifica
      ||', '||p_nroPagina||', '||p_cantItemsPagina);

       v_sesion             := depurarAlfanumerico(p_sesion, 32);
       v_cod_canal          := depurarAlfanumerico(p_codCanal, 3);
       v_nro_pagina         := depurarNumerico(p_nroPagina, 4);
       v_can_pagina         := depurarNumerico(p_cantItemsPagina, 4);
       v_nro_cta_especifica := depurarCuenta(p_nroCuentaEspecifica, CUENTA_TAMANO);
       v_ver_todas          := 'N';
       -- Fecha de Inicio Parametrizado para los movimientos
       v_dia_movimiento := NVL(fug_obt_pardinamico('BWE_DIA_MOVIMIENTOS'), v_dia_movimiento);
       v_fec_inicio     := v_fec_actual - v_dia_movimiento;

       IF v_nro_pagina IS NOT NULL AND v_can_pagina IS NOT NULL THEN
          v_reg_inicial := (v_nro_pagina * v_can_pagina) - (v_can_pagina - 1);
          v_reg_final   := (v_nro_pagina * v_can_pagina);
       END IF;

       -- 1. valido la clave del cliente
       userInfo := fu_validarSesion(v_sesion, v_cod_canal);
       --Logear parametros
       v_log_mensaje := 'obtenerMovimientos(p_nroPagina= ' || v_nro_pagina || ',p_cantItemsPagina= ' || v_can_pagina || ' p_nroCuentaEspecifica=' || v_nro_cta_especifica || ' p_codCanal= ' || v_cod_canal || ')';
       pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_log_mensaje, BITACORA_ENTRADA);

       IF userInfo.error = 'S' THEN
          v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
          v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
          v_retorno.error                := 'S';
          RETURN v_retorno;
       END IF;

       --Cantidad de movimientos a desplegar
       IF v_cod_canal = C_COD_HOMEBANKING THEN
          v_can_registro := NVL(fug_obt_pardinamico('BWE_MAX_MOVIMIENTOS'), v_can_registro);
          IF v_nro_cta_especifica IS NOT NULL THEN
             IF v_ind_cta_encriptada = 'S' THEN
                v_nro_cta_especifica := fu_desencriptacionCuentas(v_nro_cta_especifica);
             END IF;
             IF length(v_nro_cta_especifica) = 16 THEN
                v_nro_cta_especifica := lf_obt_cta_tarjeta(v_nro_cta_especifica, userInfo.codigoEmpresa, userInfo.codigoPersona);
             END IF;
          ELSE
             v_ver_todas := 'S';
          END IF;
       END IF;
       -- 1.1. Armo el nro de cuenta
       IF v_nro_cta_especifica IS NULL THEN
          pr_mensajeUsuario(c_men_cta_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Cta Inexistente -' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;

       -- 2. busco los datos de la cuentas
       IF v_retorno.error = 'N' THEN
          v_can_cuentas := 0;
          FOR ct IN cuentas LOOP
             DECLARE
                detalleMovimiento typ_movimiento := typ_movimiento;
                listaMovimientos  typ_listaMovimientos;
             BEGIN
                --- Debe controlar para que no muestre cuentas juridicas entre las cuentas del cliente
                IF fu_es_juridica(ct.nro_cuenta, userInfo.codigoEmpresa, userInfo.codigoPersona) = 'N' AND lf_ver_adicional(ct.cod_modulo, ct.relacion, ct.nro_cuenta, nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)) IN ('S', 'T') THEN
                   v_can_cuentas     := v_can_cuentas + 1;
                   v_can_movimientos := 0;
                   -- busco los demas datos de las cuentas
                   BEGIN
                      pag_cta.PR_OBT_CUENTA(ct.nro_cuenta);
                   EXCEPTION
                      WHEN OTHERS THEN
                         pr_mensajeUsuario(c_men_cta_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                         pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Cta Inexistente -' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                         RETURN v_retorno;
                   END;

                   listaMovimientos := typ_listaMovimientos();
                   --V_monto1 = al saldo disponible de la cuenta pero sin considerar el Bloqueado
                   v_monto1 := fu_obt_sal_actual(ct.cod_modulo, ct.cod_modalidad, ct.nro_cuenta);
                   --Saldo disponibles + el Saldo bloqueado que resto en el package
                   v_saldo           := v_monto1;
                   v_can_movimientos := 0;

                   -- Ciclo para obtener el movimientos
                   FOR mv IN movimientos(ct.nro_cuenta, v_can_registro) LOOP
                      v_can_movimientos := v_can_movimientos + 1;

                      IF (v_reg_inicial IS NULL) OR (v_can_movimientos >= v_reg_inicial) THEN
                         -- es un registro que debo mostrar
                         detalleMovimiento.fecha                       := lf_for_date(mv.fecha);
                         detalleMovimiento.fechaValor                  := lf_for_date(mv.fecha);
                         detalleMovimiento.numeroDocumento             := substr(mv.nro_documento, 0, 15);
                         detalleMovimiento.descripcionTransaccionPadre := substr(mv.des_tra_padre, 0, 35);
                         detalleMovimiento.abreviaturaTransaccionPadre := substr(mv.abr_tra_padre, 0, 10);
                         detalleMovimiento.tipoMovimiento              := 'C';
                         detalleMovimiento.monto                       := mv.monto;
                         detalleMovimiento.saldo                       := v_saldo;
                         detalleMovimiento.hora                        := mv.hora;
                         listaMovimientos.extend;
                         v_can_detalles := v_can_detalles + 1;
                         listaMovimientos(listaMovimientos.count) := detalleMovimiento;
                      END IF;
                         v_saldo := nvl(v_saldo, 0) - nvl(mv.monto, 0);

                      IF (v_reg_final IS NOT NULL) AND (v_can_movimientos >= v_reg_final) THEN
                         EXIT;
                      END IF;
                   END LOOP;
                   --
                   v_monto1 := v_saldo;
                   IF v_retorno.error = 'N' THEN
                      -- esta bien el dato se carga el detalle
                      v_retorno.cantidadMovimientos := v_can_detalles; --v_can_movimientos;
                      v_retorno.listaMovimientos    := listaMovimientos;
                   END IF;
                END IF;
             END;
          END LOOP;
          IF v_can_cuentas = 0 THEN
             -- no tiene detalles
             pr_mensajeUsuario(c_men_cta_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_obtenerMovimientos - Cta Inexistente -' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
          END IF;
          IF v_can_movimientos = 0 THEN
             -- no tiene detalles
             pr_mensajeUsuario(c_sin_movimientos, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_obtenerMovimientos - Cta Inexistente -' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
          END IF;
       END IF;
       -- registro del movimiento
       paw_con.pr_reg_operacion(substr(v_nro_cta_especifica, 0, 15) \*p_nro_cuenta*\, NULL \*p_cod_moneda *\, NULL \*p_monto*\, NULL \*p_nro_cta_contra*\, NULL \*p_cantidad*\, 'Ver Todas' \*p_etiqueta*\, v_ver_todas, \*p_dato*\ NULL, NULL, NULL, NULL, NULL, userInfo.codigoPersona, c_cod_operacion, userinfo.codigoPersona || v_cod_canal, v_cod_canal, v_sesion, userInfo.codigoEmpresa);
       pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerMovimientos-' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);
       RETURN v_retorno;
    EXCEPTION
       WHEN OTHERS THEN
          pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, NULL, 'fu_obtenerMovimientos -' || SQLERRM, BITACORA_ERROR);
          RETURN v_retorno;
    END fu_obtenerMovimientosPrestamos;
*/
  /*FUNCTION fu_obtenerMovimientosTarjetas (p_sesion        IN VARCHAR2,
                                          p_codigoCanal   IN VARCHAR2,
                                          p_numeroTarjeta IN VARCHAR2,
                                          p_mes           IN VARCHAR2,
                                          p_anho          IN VARCHAR2,
                                          p_tipoExtracto  IN VARCHAR2) RETURN typ_movimientosTarjeta IS

     c_men_cta_inexistente CONSTANT VARCHAR2(15) := '101';
     c_err_ver_tarjeta     CONSTANT VARCHAR2(15) := '1274';
     c_cod_operacion       CONSTANT VARCHAR2(3) := '213';

     -- datos recibidos
     v_ver_todas   VARCHAR2(3);
     v_nro_tarjeta VARCHAR2(16);
     --datos a responder

     v_can_detalles NUMBER(3) := 0; -- cantidad de cuentas

     -- variables
     v_can_movimientos NUMBER(8) := 0;
     v_fecha           DATE;
     v_fec_actual      DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
     v_error           VARCHAR2(1000);
     v_tip_extracto    VARCHAR2(1);
     v_reg_inicial     NUMBER(10);
     userInfo          paw_bem.typ_validarSesion;
     v_cod_canal       VARCHAR2(3);
     v_retorno         typ_movimientosTarjeta := typ_movimientosTarjeta;
     v_log_mensaje     VARCHAR2(1000);
     v_sesion          bw_aut_sesiones.cod_sesion%TYPE;
     v_mes             NUMBER(2);
     v_anho            NUMBER(4);
     v_nro_cuenta      ge_cuentas.nro_cuenta%TYPE;
     v_relacion        ge_cta_clientes.relacion%TYPE;
     v_cod_modulo      ba_modulos.cod_modulo%TYPE;
     v_nombre          ta_tarjetas.nom_embozar%TYPE;
     v_cod_persona     ba_personas.cod_persona%TYPE;
     v_direccion       ba_direcciones.direccion%TYPE;
     v_localidad       VARCHAR2(100);
     v_cod_moneda      ba_monedas.cod_moneda%TYPE;

     FUNCTION lf_for_tarjeta(p_nro_tarjeta IN VARCHAR2) RETURN VARCHAR2 IS
     BEGIN
        IF length(p_nro_tarjeta) = 16 THEN
           RETURN substr(p_nro_Tarjeta, 1, 4) || ' ' || substr(p_nro_Tarjeta, 5, 4) || ' ' || substr(p_nro_Tarjeta, 9, 4) || ' ' || substr(p_nro_Tarjeta, 13, 4);
        ELSE
           RETURN p_nro_Tarjeta;
        END IF;
     END;

  BEGIN
     pr_mensajeUsuario(MSG_OK, v_retorno.error, v_retorno.descripcionRespuesta, v_retorno.error);
     v_sesion       := paw_bem.depurarAlfanumerico(p_sesion, 32);
     v_cod_canal    := paw_bem.depurarAlfanumerico(p_codigoCanal, 3);
     v_nro_tarjeta  := paw_bem.depurarCuenta(p_numeroTarjeta, 30);
     v_ver_todas    := 'N';
     v_mes          := paw_bem.depurarNumerico(p_mes, 2);
     v_anho         := paw_bem.depurarAlfanumerico(p_anho, 4);
     v_tip_extracto := paw_bem.depurarAlfanumerico(p_tipoExtracto, 1);

     -- 1. valido la clave del cliente
     userInfo := paw_bem.fu_validarSesion(v_sesion, v_cod_canal);
     --Logear parametros
     v_log_mensaje := 'Fu_obtenerMovimientosTarjetas(p_sesion= ' || v_sesion || ',p_codigoCanal= ' || v_cod_canal || ' ,p_numeroTarjeta= ' || v_nro_tarjeta || ' ,p_mes= ' || v_mes || ' ,p_ano = ' || v_anho || ')';
     paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_log_mensaje, bitacora_entrada);
     \* Obtiene la informacion de parametros recibos y el return del type *\
     paw_log.g_typ_movimientosTarjeta := v_retorno;
     paw_log.pr_logValoresTypes('typ_movimientosTarjeta',
     'Fu_obtenerMovimientosTarjetas'||' '||p_numeroTarjeta||', '|| p_mes||', '||  p_anho||', '||
     p_tipoExtracto);


     IF userInfo.error = 'S' THEN
        v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
        v_retorno.error                := 'S';
        RETURN v_retorno;
     END IF;

     -- 2. ejecuto la funcion para generar el comprobante
     BEGIN
        SELECT nro_cuenta, nom_embozar
          INTO v_nro_cuenta, v_nombre
          FROM ta_tarjetas b
         WHERE b.nro_tarjeta = v_nro_tarjeta;
     EXCEPTION
        WHEN OTHERS THEN
           paw_bem.pr_mensajeUsuario(c_men_cta_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Cta Inexistente -' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
     END;
     BEGIN
        SELECT b.relacion, b.cod_modulo, a.cod_moneda
          INTO v_relacion, v_cod_modulo, v_cod_moneda
          FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
         WHERE a.nro_cuenta = b.nro_cuenta
           AND b.relacion IN ('O', 'P', 'Y', 'A')
           AND b.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
           AND a.cod_modulo = c.cod_modulo
           AND a.cod_modalidad = c.cod_modalidad
           AND a.estado = c.estado
           AND c.activo = 'S' -- solo cuentas activas
           AND a.estado <> 'X' -- pendiente de verificacion
           AND b.cod_modulo = 5
           AND b.nro_cuenta = v_nro_cuenta
           AND NOT EXISTS (SELECT 'S'
                  FROM bw_cta_accesos p
                 WHERE p.nro_cuenta = a.nro_cuenta
                   AND p.cod_per_vinculo = userInfo.codigoPersona
                   AND p.tip_acceso = 'P'
                   AND p.activo = 'S');
     EXCEPTION
        WHEN OTHERS THEN
           paw_bem.pr_mensajeUsuario(c_err_ver_tarjeta, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Error al obtener datos de la cuenta -' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), bitacora_error);
           RETURN v_retorno;
     END;

     IF paw_bem.fu_es_juridica(v_nro_cuenta, userInfo.codigoEmpresa, userInfo.codigoPersona) = 'N' AND paw_bem.lf_ver_adicional(v_cod_modulo, v_relacion, v_nro_cuenta, userInfo.codigoPersona) IN ('S', 'T') THEN
        v_ver_todas := paw_bem.lf_ver_adicional(v_cod_modulo, v_relacion, v_nro_cuenta, userInfo.codigoPersona);
     END IF;
     IF v_retorno.error = 'N' AND v_ver_todas != 'N' THEN
        pag_cta.pr_obt_cuenta(v_nro_cuenta);
        IF pag_cta.fu_obt_cod_error() <> 0 THEN
           paw_bem.pr_mensajeUsuario(c_err_ver_tarjeta, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Recup.Cta ' || pag_cta.fu_obt_msj_error() || ' ' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), bitacora_error);
           RETURN v_retorno;
        ELSE
           v_fecha := to_date('01/' || ltrim(to_Char(v_mes, '00')) || '/' || ltrim(to_char(v_anho, '0000')), 'dd/mm/yyyy');

           IF (to_char(v_fecha, 'mmyyyy') = to_char(v_fec_actual, 'mmyyyy')) AND v_tip_extracto = 'D' THEN
              pag_ban.pr_ext_actual(v_nro_tarjeta);
           ELSE
              pag_ban.pr_ext_anterior(v_nro_tarjeta, v_fecha);
           END IF;
           IF pag_ban.fu_obt_cod_error() != '00' THEN
              v_error := pag_ban.fu_obt_cod_error() || ' - ' || pag_ban.fu_obt_msj_error();
              paw_bem.pr_mensajeUsuario(c_err_ver_tarjeta, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_error || ' ' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), bitacora_error);
              RETURN v_retorno;
           END IF;
        END IF;
     END IF;

     BEGIN
        --
        SELECT cod_persona
          INTO v_cod_persona
          FROM ge_cta_clientes
         WHERE nro_cuenta = v_nro_cuenta
           AND relacion = 'P';
        --Obtiene el Nombre del tipo de retencion
        SELECT a.direccion, b.descripcion
          INTO v_direccion, v_localidad
          FROM ba_ciudades b, ba_direcciones a
         WHERE a.cod_persona = v_cod_persona
           AND a.principal = 'S'
           AND a.cod_pais = b.cod_pais
           AND a.cod_ciudad = b.cod_ciudad;
     EXCEPTION
        WHEN OTHERS THEN
           v_direccion := NULL;
           v_localidad := NULL;
     END;

     IF v_retorno.error != 'S' THEN
        v_retorno.tarjeta           := lf_for_tarjeta(v_nro_tarjeta) || ' - ' || v_nombre;
        v_retorno.tipo              := fug_obt_des_modal(pag_cta.g_ctas.cod_modulo, pag_cta.g_ctas.cod_modalidad);
        v_retorno.codigoMoneda      := v_cod_moneda;
        v_retorno.moneda            := fue_obt_titulo(fue_obt_des_moneda(pag_cta.g_ctas.cod_moneda));
        v_retorno.numeroCuenta      := v_nro_cuenta;
        v_retorno.localidad         := v_localidad;
        v_retorno.direccion         := v_direccion;
        v_retorno.nombreCliente     := pag_ban.fu_nom_cliente();
        v_retorno.pagoMinimo        := pag_ban.fu_Pago_min_pendiente();
        v_retorno.vencimientoActual := paw_bem.lf_for_date(pag_ban.fu_Fec_ven_pag_minimo());
        v_retorno.limiteCredito     := pag_ban.fu_Lin_credito();
        v_retorno.fechaProximoCierre  := paw_bem.lf_for_date(pag_ban.fu_Fec_pro_cierre);
        v_retorno.disponible          := pag_ban.fu_Dis_com_normal();
        v_retorno.deudaCierreAnterior := pag_ban.fu_deu_cie_anterior();
        v_retorno.totalDebitos        := pag_ban.fu_tot_deb_mes();
        v_retorno.totalCreditos       := pag_ban.fu_tot_cre_mes();
        v_retorno.gastosFinancieros   := pag_ban.fu_gas_financiero();
        v_retorno.deudaCuota          := pag_ban.fu_Deu_com_cuotas();
        v_retorno.deudaTotal          := pag_ban.fu_Deu_total();
        v_retorno.deudaTotal          := pag_ban.fu_Deu_total();
     END IF;

     -- 2. busco los datos de la cuentas
     IF v_retorno.error = 'N' THEN
        DECLARE
           detalleMovimiento typ_tarjetas := typ_tarjetas;
           listaMovimientos  typ_listaTarjetas := typ_listaTarjetas();

        BEGIN

           -- Ciclo para obtener el movimientos
           FOR i IN 1 .. pag_ban.g_can_movimientos LOOP
              v_can_movimientos := v_can_movimientos + 1;

              IF (v_reg_inicial IS NULL) OR (v_can_movimientos >= v_reg_inicial) THEN
                 -- es un registro que debo mostrar
                 detalleMovimiento.numeroTarjeta  := pag_ban.t_movimientos(i).nroTarjeta;
                 detalleMovimiento.descripcion    := pag_ban.t_movimientos(i).descripcion;
                 detalleMovimiento.fechaOperacion := paw_bem.lf_for_date(pag_ban.t_movimientos(i).FechaOperacion);
                 detalleMovimiento.importe        := pag_ban.t_movimientos(i).importe;
                 detalleMovimiento.impuesto       := pag_ban.t_movimientos(i).impuesto;
                 listaMovimientos.extend;
                 v_can_detalles := v_can_detalles + 1;
                 listaMovimientos(listaMovimientos.count) := detalleMovimiento;
              END IF;

           END LOOP; --end loop movimientos

           IF v_retorno.error = 'N' THEN
              v_retorno.listaMovimientos := listaMovimientos;
           END IF;
        END;

     END IF;
     -- registro del movimiento
     paw_con.pr_reg_operacion(substr(v_nro_cuenta, 0, 15) \*p_nro_cuenta*\, NULL \*p_cod_moneda *\, NULL \*p_monto*\, NULL \*p_nro_cta_contra*\, NULL \*p_cantidad*\, 'Ver Todas' \*p_etiqueta*\, v_ver_todas, \*p_dato*\ NULL, NULL, NULL, NULL, NULL, userInfo.codigoPersona, c_cod_operacion, userinfo.codigoPersona || v_cod_canal, v_cod_canal, v_sesion, userInfo.codigoEmpresa);
     paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerMovimientos-' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), bitacora_salida);
     RETURN v_retorno;
  EXCEPTION
     WHEN OTHERS THEN
        paw_log.g_typ_movimientosTarjeta := v_retorno;
        paw_log.pr_logValoresTypes('typ_movimientosTarjeta',
        'Fu_obtenerMovimientosTarjetas'||' '||p_numeroTarjeta||', '|| p_mes||', '||  p_anho||', '||
        p_tipoExtracto);
        paw_bem.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        paw_bem.pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, NULL, 'fu_obtenerMovimientos -' || SQLERRM, BITACORA_ERROR);
        RETURN v_retorno;
  END;*/
  -- Procedimiento que Inserta las Direcciones.
  PROCEDURE lp_ins_dir_personas
   (
      p_cod_persona         IN VARCHAR2,
      p_dir_particular      IN ba_direcciones.direccion%TYPE,
      p_pais_dir_particular IN ba_direcciones.cod_pais%TYPE,
      p_ciu_dir_part        IN ba_direcciones.cod_ciudad%TYPE,
      p_bar_dir_particular  IN ba_direcciones.cod_barrio%TYPE,
      p_nro_dir_particular  IN ba_direcciones.numero%TYPE,
      p_obs_dir_particular  IN ba_direcciones.observacion%TYPE,
      p_latitud             IN ba_direcciones.latitud%TYPE,
      p_longitud            IN ba_direcciones.longitud%TYPE,
      p_retorno             IN OUT typ_mensajerespuesta
   ) IS
      --PRAGMA AUTONOMOUS_TRANSACTION;
      C_ERR_REGISTRO CONSTANT VARCHAR2(10) := '293';
      v_cod_direccion ba_direcciones.cod_direccion%TYPE := 0;
      v_principal     ba_direcciones.principal%TYPE := 'N';

   BEGIN
      pr_mensajeUsuario(MSG_OK, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);
      --si no tiene direccion principal.
      IF p_dir_particular IS NOT NULL THEN
         BEGIN
            SELECT cod_direccion
              INTO v_cod_direccion
              FROM ba_direcciones d
             WHERE d.cod_persona = p_cod_persona
               AND d.cod_direccion = (SELECT MAX(cod_direccion)
                                        FROM ba_direcciones dd
                                       WHERE dd.cod_persona = d.cod_persona);

            v_cod_direccion := v_cod_direccion + 1;

         EXCEPTION
            WHEN no_data_found THEN
               v_cod_direccion := 1;
               v_principal     := 'S';
         END;

         INSERT INTO ba_direcciones
            (cod_persona, cod_direccion, direccion, tipo, principal, observacion, cod_pais, cod_ciudad, cod_barrio, numero, latitud, longitud)
         VALUES
            (p_cod_persona, v_cod_direccion, p_dir_particular, 'P', v_principal, p_obs_dir_particular, p_pais_dir_particular, p_ciu_dir_part, p_bar_dir_particular, p_nro_dir_particular, p_latitud, p_longitud);

      END IF;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(C_ERR_REGISTRO, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);
         pr_insertarBitacora(NULL, NULL, NULL, C_COD_HOMEBANKING, NULL, ' lp_ins_dir_personas()Alta de personas' || SQLERRM, BITACORA_ERROR);

   END;

  PROCEDURE lp_ins_telefono
   (
      p_cod_persona     IN VARCHAR2,
      p_tel_particular  IN ba_telefonos.telefono%TYPE,
      p_area_particular IN ba_telefonos.area%TYPE,
      p_tip_linea       IN ba_telefonos.tip_linea%TYPE,
      p_retorno         IN OUT typ_mensajerespuesta
   ) IS
      C_ERR_REGISTRO CONSTANT VARCHAR2(10) := '293';
      v_cod_telefono ba_telefonos.cod_telefono%TYPE := 0;
      v_principal    VARCHAR2(1) := 'N';

      --PRAGMA AUTONOMOUS_TRANSACTION;
   BEGIN
      pr_mensajeUsuario(MSG_OK, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);

      BEGIN

         IF p_tel_particular IS NOT NULL THEN

            BEGIN

               SELECT cod_telefono
                 INTO v_cod_telefono
                 FROM ba_telefonos d
                WHERE d.cod_persona = p_cod_persona
                  AND d.cod_telefono = (SELECT MAX(cod_telefono)
                                          FROM ba_telefonos dd
                                         WHERE dd.cod_persona = d.cod_persona);

               v_cod_telefono := v_cod_telefono + 1;

            EXCEPTION
               WHEN no_data_found THEN
                  v_cod_telefono := 1;
                  v_principal    := 'S';
            END;

            INSERT INTO ba_telefonos
               (cod_persona, cod_telefono, area, telefono, interno, observacion, tipo, tip_linea, principal)
            VALUES
               (p_cod_persona, v_cod_telefono, p_area_particular, substr(REPLACE(REPLACE(p_tel_particular, ' ', ''), '-', ''), 1, 10), NULL, NULL, 'P', p_tip_linea, v_principal);

         END IF;

      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeUsuario(C_ERR_REGISTRO, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);
            pr_insertarBitacora(NULL, NULL, NULL, C_COD_HOMEBANKING, NULL, ' lp_ins_telefonos()Alta de personas' || SQLERRM, BITACORA_ERROR);

      END;

   END;

   PROCEDURE lp_ins_cliente
  (
    p_cod_persona     IN VARCHAR2,
    p_cod_oficina     IN ge_clientes.cod_oficina%TYPE,
    p_cod_oficial     IN ge_clientes.cod_usu_oficial%TYPE,
    p_retorno         IN OUT typ_mensajerespuesta
  ) IS
    c_err_registro    CONSTANT VARCHAR2(10) := '293';
    c_err_persona     CONSTANT VARCHAR2(3) := '323';
    v_existe          VARCHAR2(1) := 'N';

    --PRAGMA AUTONOMOUS_TRANSACTION;
  BEGIN
    pr_mensajeUsuario(MSG_OK, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);

     BEGIN

        SELECT 'S'
          INTO v_existe
          FROM ge_clientes
         WHERE cod_persona = p_cod_persona;
     EXCEPTION
        WHEN no_data_found THEN
           BEGIN
              INSERT INTO ge_clientes
                 (cod_persona, cod_oficina, cod_usu_oficial, exo_impuestos, cli_especial, cod_seg_cliente, cod_tip_deudor, residente, cod_departamento, tip_extracto, cod_sec_contable, cli_confidencial)
              VALUES
                 (p_cod_persona, p_cod_oficina, p_cod_oficial, 'N', 'N', '2', '2', 'S', '11', 'C', 'N', 'N');
           EXCEPTION
              WHEN OTHERS THEN
                 paw_bem.pr_mensajeUsuario(c_err_persona, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);
                 paw_bem.pr_insertarBitacora(NULL, NULL, NULL, NULL, NULL, 'Alta de personas/clientes -' || paw_bem.fu_generarBitacora(p_retorno.error, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);

           END;

     END;

    EXCEPTION
       WHEN OTHERS THEN
          pr_mensajeUsuario(c_err_registro, p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);
          pr_insertarBitacora(NULL, NULL, NULL, C_COD_HOMEBANKING, NULL, ' lp_ins_telefonos()Alta de personas' || SQLERRM, BITACORA_ERROR);
  END;

