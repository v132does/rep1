          BEGIN

            v_detalleBarrios.codigoBarrio := substr(c.cod_barrio, 0, 3);
            v_detalleBarrios.descripcion  := substr(c.descripcion, 0, 40);
            v_listaBarrios.extend;
            v_listaBarrios(v_listaBarrios.count) := v_detalleBarrios;
            v_can_barrios := v_can_barrios + 1;
          EXCEPTION
            WHEN OTHERS THEN
              pr_mensajeUsuario(MSG_ERROR,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(retValidarSesion.codigoPersona,v_cod_canal,v_sesion,c_cod_operacion, NULL, 'obtenerBarrios -' || SQLERRM,BITACORA_ERROR);
              RETURN v_retorno;
          END;
        END LOOP;

        v_retorno.listaBarrios := v_listaBarrios;
        IF v_can_barrios = 0 THEN
          pr_mensajeUsuario(c_sin_barrios,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona,v_cod_canal,v_sesion, c_cod_operacion,NULL,v_bitacora,bitacora_salida);
          RETURN v_retorno;
        ELSE
          pr_mensajeUsuario(MSG_OK,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona,v_cod_canal,v_sesion, c_cod_operacion,NULL, v_bitacora,bitacora_salida);
          RETURN v_retorno;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          pr_mensajeUsuario(MSG_ERROR,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona,v_cod_canal,v_sesion,c_cod_operacion,NULL,'obtenerBarrios -' ||retValue.descripcionRespuesta || '-' ||
          fu_generarBitacora(retValidarSesion.error, retValidarSesion.nombreRespuesta,retValidarSesion.descripcionRespuesta,null),BITACORA_ERROR);
          RETURN v_retorno;
      END;
*/

