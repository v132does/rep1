         return v_retorno;
   END;*/

   /**Obtiene una Factura con sus detalles**/
   FUNCTION fu_obtenerFactura(p_sesion     IN VARCHAR2,
                              p_codCanal   IN VARCHAR2,
                              p_nroFactura IN VARCHAR,
                              p_fechaFactura IN DATE) RETURN typ_detallesFactura_hb IS--NVB-2232

      msg_g_sin_datos CONSTANT VARCHAR2(15) := 'G_SIN_DATOS';
      v_retorno      typ_detallesFactura_hb := typ_detallesFactura_hb;--NVB-2232
      v_retornoError typ_MensajeRespuesta := typ_MensajeRespuesta;
      v_detalles    typ_detalleFactura_hb := typ_detalleFactura_hb;--NVB-2232
      userInfo       typ_validarsesion;
      v_sesion       bw_aut_sesiones.cod_sesion%type;
      v_codcanal     ge_canales.cod_canal%type;
      v_nro_factura VARCHAR2(50);
      v_tip_mensaje VARCHAR2(10) := '026';
      v_des_periodo VARCHAR2(150);
      v_cantFacturas NUMBER; --cantidad de facturas retornadas
      v_cantidad    NUMBER := 0;
      v_fechaFactura DATE := p_fechaFactura;

      CURSOR cabecera IS
         SELECT nro_factura, nro_timbrado, 'Valido hasta ' || fug_des_mes(a.fec_vig_timbrado) || ' de ' || to_char(a.fec_vig_timbrado, 'yyyy') mes_validez, fecha, c.Oficina, fecha des_fecha, tip_comprobante, b.significado des_tip_comprobante, a.tip_venta tip_venta, decode(dig_verificador, NULL, nro_documento, nro_documento || '-' || dig_verificador) nro_ruc, nom_completo, a.direccion,a.telefono, c.telefono tel_oficina, mto_exento,
                --(DECODE(a.cod_moneda, 'GS', to_char(nvl(mto_gravado_5_gs, 0) + nvl(impuesto_5_gs, 0)), to_char(nvl(mto_gravado_5, 0) + nvl(impuesto_5, 0)))) mto_gravado_5, (DECODE(a.cod_moneda, 'GS', to_char(nvl(mto_gravado_10_gs, 0) + nvl(impuesto_10_gs, 0)), to_char(nvl(mto_gravado_10, 0) + nvl(impuesto_10, 0)))) mto_gravado_10, (nvl(mto_exento, 0) + nvl(mto_gravado_5, 0) + nvl(mto_gravado_10, 0) + nvl(impuesto_5, 0) + nvl(impuesto_10, 0)) tot_venta, impuesto_5_gs impuesto_5,
                (DECODE(a.cod_moneda, 'GS', to_char(nvl(mto_gravado_5_gs, 0) + nvl(impuesto_5_gs, 0)), to_char(nvl(mto_gravado_5, 0) + nvl(impuesto_5, 0)))) mto_gravado_5, (DECODE(a.cod_moneda, 'GS', to_char(nvl(mto_gravado_10_gs, 0) + nvl(impuesto_10_gs, 0)), to_char(nvl(mto_gravado_10, 0) + nvl(impuesto_10, 0)))) mto_gravado_10, (DECODE(a.cod_moneda, 'GS', nvl(mto_gravado_5_gs, 0) + nvl(impuesto_5_gs, 0)+ nvl(mto_gravado_10_gs, 0) + nvl(impuesto_10_gs, 0),nvl(mto_gravado_5, 0) + nvl(impuesto_5, 0)+nvl(mto_gravado_10, 0) + nvl(impuesto_10, 0))) tot_venta, impuesto_5_gs impuesto_5,
                impuesto_10_gs impuesto_10, (nvl(impuesto_5_gs, 0) + nvl(impuesto_10_gs, 0)) tot_iva,
                --DECODE(a.tip_comprobante, 'N', 'TOTAL A ACREDITAR  ', 'TOTAL A PAGAR  ') || fue_obt_des_moneda(a.cod_moneda) || ' ' || fue_obt_denominacion(decode(a.cod_moneda, 'GS', nvl(mto_exento_GS, 0) + nvl(mto_gravado_5_GS, 0) + nvl(mto_gravado_10_GS, 0) + nvl(impuesto_5_GS, 0) + nvl(impuesto_10_GS, 0), nvl(mto_exento, 0) + nvl(mto_gravado_5, 0) + nvl(mto_gravado_10, 0) + nvl(impuesto_5, 0) + nvl(impuesto_10, 0))) || '.-' des_tot_venta,
                'TOTAL A PAGAR '||fue_obt_des_moneda(a.cod_moneda)||' '||fue_obt_denominacion((DECODE(a.cod_moneda, 'GS', to_char(nvl(mto_gravado_5_gs, 0) + nvl(impuesto_5_gs, 0)+ nvl(mto_gravado_10_gs, 0) + nvl(impuesto_10_gs, 0)), to_char(nvl(mto_gravado_5, 0) + nvl(impuesto_5, 0)+nvl(mto_gravado_10, 0) + nvl(impuesto_10, 0))))) des_tot_venta,
                DECODE(nro_fac_referencia, '0', NULL, nro_fac_referencia) nro_fac_referencia, DECODE(nro_tim_referencia, '0', NULL, nro_tim_referencia) nro_tim_referencia, DECODE(impreso, 'N', 'ORIGINAL', 'COPIA') tip_impresion, c.nom_entidad, 'RUC ' || c.ruc_entidad ruc_entidad, c.matriz, c.direccion dir_oficina,
                a.cod_moneda, a.ROWID fila, a.impreso, d.direccion cli_direccion
           FROM BA_COD_REFERENCIAS B, CB_LIB_VENTAS A,
                (SELECT b.cod_oficina cod_oficina, a.nom_entidad, c.nro_documento ruc_entidad, fue_obt_titulo(b.descripcion) Oficina, d.direccion || ' - ' || fue_obt_titulo(d.descripcion) || ' - Py.' matriz, b.direccion || ' - ' || fue_obt_titulo(b.descripcion) || ' - Py.' direccion,
                 b.telefono
                    FROM ba_personas c, ba_oficinas d, ba_oficinas b, ge_par_generales a
                   WHERE d.cod_oficina = a.cod_ofi_matriz
                         AND c.cod_persona = a.cod_persona
                         AND b.estado = 'A'
                         ) C,
                 ba_direcciones d
          WHERE b.dominio = 'TIP_COM_VENTA'
                AND a.tip_comprobante = b.val_minimo
                AND c.cod_oficina = a.cod_oficina
                AND a.cod_persona = d.cod_persona
                AND d.principal = 'S'
                AND a.nro_factura = v_nro_factura
                AND a.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
                AND a.fecha = v_fechaFactura
          ORDER BY nro_factura;
      -- cursor de detalles
      CURSOR detalles IS
         SELECT 1 cantidad, fue_obt_titulo(a.descripcion) descripcion,
                REPLACE(decode(b.cod_moneda, 'GS', TO_CHAR(nvl(a.mto_exento_gs, 0) + nvl(a.mto_gra_5_gs, 0) + nvl(a.mto_gra_10_gs, 0) + nvl(a.impuesto_5_gs, 0) + nvl(a.impuesto_10_gs, 0)), TO_CHAR(nvl(a.mto_exento_gs, 0) + nvl(a.mto_gravado_5, 0) + nvl(a.mto_gravado_10, 0) + nvl(a.impuesto_5, 0) + nvl(a.impuesto_10, 0))), ',', '.') precio,
                REPLACE(decode(b.cod_moneda, 'GS', TO_CHAR(a.mto_exento_gs), TO_CHAR(a.mto_exento)), ',', '.') mto_exento, REPLACE(DECODE(b.cod_moneda, 'GS', TO_CHAR(nvl(a.mto_gra_5_gs, 0) + nvl(a.impuesto_5_gs, 0)), TO_CHAR(nvl(a.mto_gravado_5, 0) + nvl(a.impuesto_5, 0))), ',', '.') mto_gra_5, REPLACE(DECODE(b.cod_moneda, 'GS', TO_CHAR(nvl(a.mto_gra_10_gs, 0) + nvl(a.impuesto_10_gs, 0)), TO_CHAR(nvl(a.mto_gravado_10, 0) + nvl(a.impuesto_10, 0))), ',', '.') mto_gra_10, a.nro_factura,
                a.nro_timbrado, to_char(a.fecha, 'dd/mm/yy') fec_linea, a.nro_documento, a.nro_cuenta
           FROM cb_lib_ventas b, cb_lib_ventas_det a
          WHERE a.nro_factura = v_nro_factura
                and B.COD_PERSONA = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
                and b.fecha = v_fechaFactura
                AND b.nro_factura = a.nro_factura
                AND B.NRO_TIMBRADO = A.NRO_TIMBRADO
          ORDER BY a.fecha, a.hora;

      PRAGMA AUTONOMOUS_TRANSACTION; --- para que grabe solo esta transaccion
   BEGIN
     v_sesion    := depurarAlfanumerico(p_sesion,32);
     v_codcanal := depurarAlfanumerico(p_codCanal,3);
      -- Valido la Sesion del Cliente
      userinfo := fu_validarSesion(v_sesion, v_codcanal);
      IF userinfo.error = 'S' THEN
         v_retorno.error                := userinfo.error;
         v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, userinfo.codigoEmpresa, 'obtDetalleFactura:' || p_nroFactura, BITACORA_ENTRADA);

      IF p_nrofactura IS NULL THEN
         pab_iva.pr_gen_lib_vta_tmp(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona));
         v_nro_factura := pab_iva.fu_gen_factura(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona));
      ELSE
         v_nro_factura := TRIM(p_nroFactura);
      END IF;

      SELECT 'de ' || to_char(MIN(n.fecha), 'dd') || ' al ' || to_char(fug_des_fecha(MAX(n.fecha)))
        INTO v_des_periodo
        FROM cb_lib_ventas_det n
       WHERE n.nro_factura = v_nro_factura;

      v_retorno.listaDetallesFacturas := typ_listaDetalleFacturas_hb();--NVB-2232
      v_cantFacturas                  := 0;
      FOR c IN cabecera

      LOOP
         v_cantFacturas                 := v_cantFacturas + 1;
         v_retorno.numeroFactura        := c.nro_factura;
         v_retorno.numeroTimbrado       := c.nro_timbrado;
         v_retorno.tipoComprobante      := c.tip_comprobante;
         v_retorno.numeroRucEntidad     := c.ruc_entidad;
         v_retorno.validez              := c.mes_validez;
         v_retorno.nombreEntidad        := c.nom_entidad;
         v_retorno.direccionOficina     := c.dir_oficina;
         v_retorno.direccionMatriz      := c.oficina;
         v_retorno.direccionCliente     := c.cli_direccion; --c.dir_cliente;
         v_retorno.fecha                := c.des_fecha;
         v_retorno.numeroRucCliente     := c.nro_ruc;
         v_retorno.nombreCliente        := c.nom_completo;

         v_retorno.numeroCliente        := userinfo.codigoPersona;
         v_retorno.telefono             := c.tel_oficina;--c.telefono;

         v_retorno.periodo              := v_des_periodo;
         v_retorno.totalExento          := c.mto_exento;
         v_retorno.gravado5             := c.mto_gravado_5;
         v_retorno.gravado10            := c.mto_gravado_10;
         v_retorno.totalVenta           := c.tot_venta;
         v_retorno.descuentoTotalVenta  := c.des_tot_venta;
         v_retorno.codigoMoneda         := c.cod_moneda;

         v_retorno.impuesto5            := c.impuesto_5;
         v_retorno.impuesto10           := c.impuesto_10;
         v_retorno.totalIva             := c.tot_iva;
         v_retorno.tipoImpresion        := c.tip_impresion;
         v_retorno.numeroFacturaReferencia     := c.nro_fac_referencia;
         v_retorno.numeroTimbradoReferencia    := c.nro_tim_referencia;

         IF c.tip_venta = 'CR' THEN
            v_retorno.tipoVenta := 'CR'; --'Credito';

         ELSE
            v_retorno.tipoVenta := 'CO'; --'Contado';

         END IF;

         FOR d IN detalles
         LOOP
            v_cantidad             := v_cantidad + 1;
            v_detalles.cantidad    := d.cantidad;
            v_detalles.precioUnitario := d.precio;
            v_detalles.documento   := d.nro_documento;
            v_detalles.numeroCuenta:= d.nro_cuenta;
            v_detalles.fecha       := d.fec_linea;
            v_detalles.descripcion := substr(d.descripcion, 0, 30);
            v_detalles.montoExento := d.mto_exento;
            v_detalles.gravado5    := d.mto_gra_5;
            v_detalles.gravado10   := d.mto_gra_10;
            v_retorno.listaDetallesFacturas.EXTEND;
            v_retorno.listaDetallesFacturas(v_retorno.listaDetallesFacturas.COUNT) := v_detalles;
         END LOOP;

         v_retorno.cantidadFacturas := v_cantFacturas;

         IF c.impreso = 'N' THEN
            BEGIN
               pre_ini_aplicacion;
               pae_cnf.g_cod_modulo := 1;
            END;
            UPDATE cb_lib_ventas
               SET impreso = 'S'
             WHERE ROWID = c.fila;
         END IF;
      END LOOP;
      COMMIT;

      IF v_cantidad = 0 THEN
         pr_mensajeUsuario(msg_g_sin_datos, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      ELSE
         pr_mensajeUsuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      END IF;
      v_retornoError.error                := v_retorno.error;
      v_retornoError.nombreRespuesta      := v_retorno.nombreRespuesta;
      v_retornoError.descripcionRespuesta := v_retorno.descripcionRespuesta;
      pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, p_sesion, NULL, userinfo.codigoEmpresa, 'Inicio Obtener Factura ' || fu_generarBitacora(v_retornoError.error,v_retornoError.nombreRespuesta, v_retornoError.descripcionRespuesta,null ), bitacora_entrada);

     /* Obtiene la informacion de parametros recibos y el return del type*/
      paw_log.g_typ_detallesFactura_hb := v_retorno;--NVB-2232
      paw_log.pr_logValoresTypes('typ_detallesFactura',
      'fu_obtenerFactura'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroFactura);
      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, userinfo.codigoEmpresa, 'obtDetalleFactura -' || SQLERRM, BITACORA_ERROR);
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         v_retornoError.error                := v_retorno.error;
         v_retornoError.nombreRespuesta      := v_retorno.nombreRespuesta;
         v_retornoError.descripcionRespuesta := v_retorno.descripcionRespuesta;
         RETURN v_retorno;
   END;

   FUNCTION fu_obt_sal_retenido
   (
      p_nro_cuenta    IN ge_cuentas.nro_cuenta%type,
      p_cod_modulo    IN ge_cuentas.cod_modulo%type,
      p_cod_modalidad IN ge_cuentas.cod_modalidad%type
   ) RETURN NUMBER IS
      v_importe NUMBER(18,2) := 0;

   BEGIN
      SELECT SUM(monto)
        INTO v_importe
        FROM ge_ext_cli_mov_retenidos_tmp
       WHERE nro_cuenta = p_nro_cuenta
         AND cod_modulo = p_cod_modulo
         AND cod_modalidad = p_cod_modalidad;
      RETURN v_importe;
   END;

   FUNCTION fu_obt_sal_bloqueado
   (
      p_nro_cuenta    IN ge_cuentas.nro_cuenta%type,
      p_fecha         IN DATE
   ) RETURN NUMBER IS
      v_importe NUMBER(18,2) := 0;

   BEGIN
      SELECT sal_blo_int
        INTO v_importe
        FROM ge_sal_diarios
       WHERE nro_cuenta = p_nro_cuenta
         AND fecha = (SELECT MAX(fecha)
                        FROM ge_sal_diarios
                       WHERE nro_cuenta = p_nro_cuenta
                         AND fecha <= p_fecha);
      RETURN v_importe;
    EXCEPTION
      WHEN OTHERS THEN
        return 0;
    END;

  /* FUNCTION fu_extRequerimientoActual(p_sesion             IN VARCHAR2,
                                       p_codcanal           IN VARCHAR2,
                                       p_fechaHasta         IN DATE,
                                       p_numeroCuenta       IN VARCHAR2,
                                       p_claveToken         IN VARCHAR2,
                                       p_claveTransaccional IN VARCHAR2 )
      RETURN typ_extracto IS

      v_retorno    typ_extracto := typ_extracto;
      userinfo     typ_validarSesion;
      v_codPersona ba_personas.cod_persona%type;
      v_claveTransaccional bw_ope_claves.clave%TYPE;

      v_extractoCuentas     typ_extractoCuentas := typ_extractoCuentas;
      v_cuentasCliente      typ_listaExtractoCuentas := typ_listaExtractoCuentas();
      v_extractoMovimientos typ_extractoMovimientos := typ_extractoMovimientos;
      v_detallesMovimiento  typ_listaExtractoMovimientos := typ_listaExtractoMovimientos();
      v_extractoRetenciones typ_extractoRetenciones := typ_extractoRetenciones;
      v_retencionesCuenta   typ_listaExtractoRetenciones := typ_listaExtractoRetenciones();
      v_extractoResumenes   typ_extractoResumenes := typ_extractoResumenes;
      v_resumenesCuenta     typ_listaExtractoResumenes := typ_listaExtractoResumenes();
      v_extractoBloqueos    typ_extractoBloqueos := typ_extractoBloqueos;
      v_bloqueosCuenta      typ_listaExtractoBloqueos := typ_listaExtractoBloqueos();
      retError              typ_mensajeRespuesta := typ_mensajeRespuesta;
      retValidarSesion      typ_validarSesion;

      --Tipos de Mensajes de respuestas
      MSG_OBT_EXT_INE     CONSTANT VARCHAR2(15) := 'OBT_EXT_INE'; \** Extracto no encontrado*\
      MSG_OBT_CTA_ER      CONSTANT VARCHAR2(15) := 'OBT_CTA_ER'; \**Error al obtener Cuentas*\
      MSG_OBT_MOV_ER      CONSTANT VARCHAR2(15) := 'OBT_MOV_ER'; \**Error al obtener Movimientos*\
      MSG_OBT_RET_ER      CONSTANT VARCHAR2(15) := 'OBT_RET_ER'; \**Error al obtener Retenciones*\
      MSG_OBT_RES_ER      CONSTANT VARCHAR2(15) := 'OBT_RES_ER'; \**Error al obtener Resumenes*\
      MSG_OBT_BLO_ER      CONSTANT VARCHAR2(15) := 'OBT_BLO_ER'; \**Error al obtener Bloqueos*\
      MSG_GEN_EXT_ER      CONSTANT VARCHAR2(15) := 'GEN_EXT_ER'; \**Error al generar Extrato*\
      MSG_PARAM_INCORRECT CONSTANT VARCHAR2(15) := 'PARAM_INCORRECT';

      v_msg_error VARCHAR2(15) := MSG_ERROR;
      v_frecuencia      VARCHAR(10) := NULL;
       cod_operacion VARCHAR2(3) := '300';
      v_fechaHasta date;
      v_anho_mes        VARCHAR2(6);
      v_fec_extracto    ge_ext_clientes.fec_extracto%TYPE;
      v_fre_extracto    ge_ext_clientes.fre_extracto%TYPE;
      v_cod_extracto    ge_ext_clientes.cod_extracto%TYPE;
      v_cod_usu_oficial ge_ext_clientes.cod_usu_oficial%TYPE;
      v_saldo_anterior  ge_ext_cli_cuentas.sal_anterior%TYPE;
      v_sesion          bw_aut_sesiones.cod_sesion%type;
      v_codcanal        ge_canales.cod_canal%type;
      v_nroCuenta       ge_cta_clientes.nro_cuenta%type;
      v_ext_anterior    varchar2(1):='S';
      FUNCTION fu_obtenerUltimoSaldo(p_nroCuenta IN VARCHAR2) RETURN NUMBER IS
        vfec        DATE;
        vsal_actual NUMBER;
        vind        NUMBER DEFAULT 0;
        vnro_cuenta VARCHAR2(100);
      BEGIN
        BEGIN
          SELECT MAX(fec_extracto)
            INTO vfec
            FROM ge_ext_cli_cuentas
           WHERE cod_persona = v_codPersona
             AND nro_cuenta = p_nroCuenta;
        EXCEPTION
          WHEN no_data_found THEN
            vind := 1;
            BEGIN
              SELECT MAX(fec_extracto)
                INTO vfec
                FROM ge_ext_cli_cuentas
               WHERE cod_persona = v_codPersona
                 AND nro_cuenta = p_nroCuenta;
            EXCEPTION
              WHEN no_data_found THEN
                vind := 2;
                BEGIN
                  SELECT MAX(fec_extracto)
                    INTO vfec
                    FROM ge_ext_cli_cuentas
                   WHERE cod_persona = v_codPersona
                     AND nro_cuenta = p_nroCuenta;
                EXCEPTION
                  WHEN no_data_found THEN
                    vind := 3;
                    vfec := NULL;
                  WHEN OTHERS THEN
                    vfec := NULL;
                END;
              WHEN OTHERS THEN
                vfec := NULL;
            END;
          WHEN OTHERS THEN
            vfec := NULL;
        END;
        IF vfec IS NOT NULL THEN
          BEGIN
            IF vind = 0 THEN
              vnro_cuenta := v_codPersona;
            ELSIF vind = 1 THEN
              vnro_cuenta := substr(v_codPersona, 5, 6);
            ELSIF vind = 2 THEN
              vnro_cuenta := substr(v_codPersona, 5, 5);
            ELSE
              vnro_cuenta := NULL;
            END IF;
            SELECT nvl(sal_actual, 0)
              INTO vsal_actual
              FROM ge_ext_cli_cuentas
             WHERE cod_persona = v_codPersona
               AND nro_cuenta = vnro_cuenta
               AND fec_extracto = vfec;
            IF (vsal_actual IS NOT NULL) THEN
              RETURN vsal_actual;
            ELSE
              RETURN 0;
            END IF;
          EXCEPTION
            WHEN no_data_found THEN
              RETURN 0;
            WHEN OTHERS THEN
              RETURN 0;
          END;
        ELSE
          RETURN 0;
        END IF;
      END;

    BEGIN
      v_codcanal      := depurarAlfanumerico(p_codCanal,3);
      v_sesion        := depurarAlfanumerico(p_sesion,32);
      v_claveTransaccional  := trim(p_clavetransaccional);
      v_nroCuenta           := trim(p_numeroCuenta);
      v_fechaHasta := p_fechaHasta;
      -- Valido la Sesion del Cliente
      userinfo := fu_validarSesion(v_sesion, v_codcanal);

      IF userinfo.error = 'S' THEN
        v_retorno.error                := userinfo.error;
        v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
        \* Obtiene la informacion de parametros recibos y el return del type *\
        paw_log.g_typ_extracto := v_retorno;
        paw_log.pr_logValoresTypes('typ_extracto',
       'Extracto a Requerimiento'||'-'|| p_sesion||', '|| p_codcanal||', '|| p_fechaHasta||', '||P_NUMEROCUENTA );
        RETURN v_retorno;
      END IF;

      v_codPersona := NVL(userinfo.codigoEmpresa, userinfo.codigoPersona);
      If v_fechaHasta is null then
        v_fechaHasta := v_fec_actual;
      end if;

      pr_insertarBitacora(userinfo.codigoPersona,p_codCanal,p_sesion,cod_operacion,userinfo.codigoEmpresa,
                          'Inicio Consulta Extracto - Cod.Cliente|Nro.Cta| ' ||
                          v_codPersona || '|' || ' ' || '|fec.Hasta:' || v_fechaHasta || ' ' ||
                          fu_generarBitacora(userinfo.error,userinfo.nombreRespuesta,userinfo.descripcionRespuesta, null),
                          bitacora_entrada);

       --Validacion p.entrada
      IF (v_codPersona IS NULL OR v_fechaHasta IS NULL) THEN
        pr_mensajeUsuario(MSG_PARAM_INCORRECT,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
        retError.error                := v_retorno.error;
        retError.nombreRespuesta      := v_retorno.nombreRespuesta;
        retError.descripcionRespuesta := v_retorno.descripcionRespuesta;
        pr_insertarBitacora(retValidarSesion.codigoPersona,p_codCanal, p_sesion, v_tip_mensaje,retValidarSesion.codigoEmpresa,'Extracto A Requerimiento' || ' ' || ' - ' ||
        fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta,retValidarSesion.descripcionRespuesta,null),BITACORA_ERROR);
         paw_log.g_typ_extracto := v_retorno;
         paw_log.pr_logValoresTypes('typ_extracto',
         'Extracto a Requerimiento'||'-'|| p_sesion||', '|| p_codcanal||', '|| p_fechaHasta||'# '||v_anho_mes );
        RETURN v_retorno;
      END IF;

      --Generacion
      v_frecuencia := 'D';
      v_msg_error  := MSG_GEN_EXT_ER;
      PRG_GEN_EXTRACTO_TMP(v_codPersona);
        -- Cabecera del extracto
       v_retorno.cuentasCliente     := NULL;
       v_retorno.detallesMovimiento := NULL;
       v_retorno.retencionesCuenta  := NULL;
       v_retorno.resumenesCuenta    := NULL;
       v_retorno.bloqueosCuenta     := NULL;
       v_msg_error := MSG_OBT_EXT_INE;


          --cabecera del informe
          SELECT t.*
            INTO v_retorno.codigoCliente,
                 v_fec_extracto,
                 v_fre_extracto,
                 v_cod_extracto,
                 v_retorno.direccionCliente,
                 v_retorno.telefonoCliente,
                 v_cod_usu_oficial,
                 v_retorno.nombreCliente
            FROM (SELECT e.cod_persona,
                         e.fec_extracto,
                         e.fre_extracto,
                         e.cod_extracto,
                         e.direccion || e.det_direccion || ' ' || e.barrio || ' ' ||
                         c.descripcion ||
                         decode(REPLACE(p.descripcion, 'paraguay', ''),
                                '',
                                '',
                                ' - ') ||
                         REPLACE(p.descripcion, 'paraguay', '') dir_completa,
                         e.telefono telefono,
                         e.cod_usu_oficial oficial,
                         e.nom_cliente
                    FROM ba_paises p, ba_ciudades c, ge_ext_clientes_tmp e
                   WHERE e.cod_persona = v_codPersona
                     AND (v_frecuencia IS NULL OR
                         e.fre_extracto = v_frecuencia)
                     AND to_char(e.fec_extracto, 'yyyymm') =
                         to_char(v_fechaHasta, 'yyyymm')
                     AND p.cod_pais(+) = e.cod_pais
                     AND c.cod_pais(+) = e.cod_pais
                     AND c.cod_ciudad(+) = e.cod_ciudad
                     AND (EXISTS (SELECT 1
                                    FROM ge_clientes cl
                                   WHERE cl.cod_persona = e.cod_persona
                                  UNION ALL
                                  SELECT 1
                                    FROM ge_clientes x, ba_vinculos y
                                   WHERE x.cod_persona = y.cod_per_vinculo
                                     AND y.cod_persona = e.cod_persona))
                   ORDER BY e.fec_extracto DESC) t
           WHERE ROWNUM = 1;
        -- Obtiene Detalle de cuentas del cliente
        v_msg_error := MSG_OBT_CTA_ER;

        FOR cr IN (SELECT e.nro_cuenta,
                          fue_obt_titulo(m.descripcion) || ' ' || e.cod_moneda des_cta,
                          0 sal_anterior_con,
                          nvl(e.sal_actual, 0) sal_actual_con,
                          0 sal_actual_bloq,
                          nvl(e.sal_anterior, 0) sal_ant_disp,
                          nvl(e.sal_actual, 0),
                          0 sal_actual_disp,
                          e.cod_modulo,
                          e.cod_modalidad
                     FROM ba_modulos             mo,
                          ge_modalidades         m,
                          ge_ext_cli_cuentas_tmp e
                    WHERE m.cod_modulo = to_number(substr(ltrim(to_char(e.cod_modalidad)),
                                                          1,
                                                          1))
                      AND m.cod_modulo = mo.cod_modulo
                      AND e.cod_modalidad = m.cod_modalidad
                      AND e.cod_persona = v_codPersona
                      AND e.cod_extracto = v_cod_extracto
                      AND e.fec_extracto = v_fec_extracto
                      AND e.fre_extracto = v_fre_extracto
                      AND ( e.nro_cuenta = v_nroCuenta
                      OR   v_nroCuenta IS NULL
                      OR   e.nro_cuenta = FUT_OBT_NRO_TARJETA(v_nroCuenta))
                      AND e.tip_cuenta IS NOT NULL
                      AND mo.cod_modulo IN (3, 4)
                      AND m.cod_modalidad NOT IN (33)
                    ORDER BY e.nro_cuenta) LOOP

          v_extractoCuentas.numeroCuenta            := cr.nro_cuenta;
          v_extractoCuentas.descripcion             := cr.des_cta;
          v_extractoCuentas.saldoAnteriorContable   := cr.sal_anterior_con;

          v_extractoCuentas.saldoAnteriorDisponible := cr.sal_ant_disp;

          --Calcula el saldo Retenido
          v_extractoCuentas.saldoActualRetenido     := nvl(fu_obt_sal_retenido(cr.nro_cuenta, cr.cod_modulo, cr.cod_modalidad),0);

          --Calcula el saldo Bloqueado
          v_extractoCuentas.saldoActualBloqueado    := fu_obt_sal_bloqueado(cr.nro_cuenta, v_fechaHasta);

          v_extractoCuentas.saldoActualContable     := cr.sal_actual_con+v_extractoCuentas.saldoActualRetenido;

          v_extractoCuentas.saldoActualDisponible   := v_extractoCuentas.saldoActualContable-v_extractoCuentas.saldoActualBloqueado-v_extractoCuentas.saldoActualRetenido;

          v_saldo_anterior := cr.sal_ant_disp;

          v_cuentasCliente.extend;
          v_cuentasCliente(v_cuentasCliente.count) := v_extractoCuentas;
        END LOOP;

        -- Obtiene Detalle de movimientos de la cuenta
        v_msg_error := MSG_OBT_MOV_ER;

        FOR mr IN (SELECT e.nro_cuenta nro_cuenta,
                          e.nro_documento numero,
                          fue_obt_titulo(nvl(e.concepto, t.descripcion)) concepto,
                          to_char(nvl(e.fec_movimiento, SYSDATE), 'dd/mm') fecha_confirmacion,
                          to_char(nvl(e.fec_valor, SYSDATE), 'dd/mm') fecha_transaccion,
                          e.mto_debito monto_debito,
                          e.mto_credito monto_credito,
                          o.descripcion descripcion_oficina
                     FROM ge_transacciones           t,
                          ge_ext_cli_movimientos_tmp e,
                          ba_oficinas                o
                    WHERE t.cod_modulo(+) = e.cod_modulo
                      AND t.cod_modalidad(+) = e.cod_modalidad
                      AND t.cod_transaccion(+) = e.cod_tra_padre
                      AND o.cod_oficina(+) = e.cod_ofi_origen
                      AND e.cod_persona = v_codPersona
                      AND e.cod_extracto = v_cod_extracto
                      AND e.fec_extracto = v_fec_extracto
                      AND (e.nro_cuenta = v_nroCuenta
                      OR  v_nroCuenta IS NULL
                      OR  e.nro_cuenta = FUT_OBT_NRO_TARJETA(v_nroCuenta)
                      )
                    ORDER BY e.fec_insercion) LOOP

          v_saldo_anterior := v_saldo_anterior + (mr.monto_credito - mr.monto_debito);
          v_extractoMovimientos.numeroComprobante  := mr.numero;
          v_extractoMovimientos.descripcionOficina := mr.descripcion_oficina;
          v_extractoMovimientos.concepto           := mr.concepto;
          v_extractoMovimientos.fechaTransaccion   := mr.fecha_transaccion;
          v_extractoMovimientos.fechaConfirmacion  := mr.fecha_confirmacion;
          v_extractoMovimientos.montoDebito        := mr.monto_debito;
          v_extractoMovimientos.montoCredito       := mr.monto_credito;
          v_extractoMovimientos.saldo              := v_saldo_anterior;
          v_detallesMovimiento.extend;
          v_detallesMovimiento(v_detallesMovimiento.count) := v_extractoMovimientos;
        END LOOP;
        -- Obtiene Detalle de retenciones de la cuenta
        v_msg_error := MSG_OBT_RET_ER;
        FOR retr IN (SELECT a.nro_documento,
                            fue_obt_titulo(c.descripcion) descripcion,
                            a.fec_movimiento,
                            a.fec_liberacion,
                            a.monto,
                            b.nro_cuenta
                       FROM ge_retenciones               c,
                            ge_cuentas                   b,
                            ge_ext_cli_mov_retenidos_tmp a
                      WHERE a.cod_retencion = c.cod_retencion
                        AND a.nro_cuenta = b.nro_cuenta(+)
                        AND a.cod_persona = v_codPersona
                        AND (a.nro_cuenta = v_nroCuenta
                        OR   v_nroCuenta IS NULL
                        OR  a.nro_cuenta = FUT_OBT_NRO_TARJETA(v_nroCuenta))
                        AND a.fec_extracto = v_fec_extracto
                        AND a.fre_extracto = v_fre_extracto
                        AND a.cod_extracto = v_cod_extracto
                      ORDER BY a.fec_movimiento) LOOP
          v_extractoRetenciones.numeroDocumento := retr.nro_documento;
          v_extractoRetenciones.descripcion     := retr.descripcion;
          v_extractoRetenciones.fechaMovimiento := retr.fec_movimiento;
          v_extractoRetenciones.fechaLiberacion := retr.fec_liberacion;
          v_extractoRetenciones.monto           := retr.monto;
          v_extractoRetenciones.numeroCuenta    := retr.nro_cuenta;
          v_retencionesCuenta.extend;
          v_retencionesCuenta(v_retencionesCuenta.count) := v_extractoRetenciones;
        END LOOP;
        -- Obtiene Detalle de resumen de la cuenta
        v_msg_error := MSG_OBT_RES_ER;
        FOR resr IN (SELECT r.nro_cuenta,

                            decode(r.tipo,
                                   '1',
                                   'PF',
                                   '2',
                                   'CDA',
                                   '3',
                                   'PR',
                                   '4',
                                   'TA',
                                   '5',
                                   'LS',
                                   '6',
                                   'TI') tipo_resumen,
                            decode(r.tipo,
                                   '2',
                                   fue_obt_titulo(m.descripcion),
                                   '3',
                                   fue_obt_titulo(m.descripcion),
                                   '4',
                                   fue_obt_titulo(m.descripcion),
                                   '5',
                                   'lInea de sobregiro',
                                   r.beneficiario) modalidad,
                            decode(r.tipo,
                                   '5',
                                   NULL,
                                   to_char(r.fec_inicio, 'dd/mm/yyyy')) fec_inicio,
                            r.fec_vencimiento,
                            r.mto_capital,
                            decode(r.tipo,
                                   '3',
                                   r.mto_interes,
                                   '4',
                                   r.mto_interes,
                                   '5',
                                   r.sal_disponible,
                                   NULL) mto_interes,
                            r.cod_moneda,
                            decode(r.tipo,
                                   '3',
                                   r.sal_disponible,
                                   '4',
                                   r.sal_disponible,
                                   r.mto_interes) saldo
                       FROM ge_modalidades m, ge_ext_resumenes_tmp r
                      WHERE m.cod_modulo = to_number(substr(ltrim(to_char(m.cod_modalidad)),1,1))
                        AND m.cod_modalidad = r.cod_modalidad
                        AND r.cod_persona = v_codPersona
                        AND r.cod_extracto = v_cod_extracto
                        AND r.fec_extracto = v_fec_extracto
                        AND r.fre_extracto = v_fre_extracto
                        AND r.tipo IS NOT NULL
                        AND (r.nro_cuenta = v_nroCuenta
                        OR   v_nroCuenta IS NULL
                        OR  r.nro_cuenta = FUT_OBT_NRO_TARJETA(v_nroCuenta))
                      ORDER BY r.tipo, r.nro_cuenta) LOOP

          v_extractoResumenes.numeroCuenta     := resr.nro_cuenta;
          v_extractoResumenes.tipoResumen      := substr(resr.tipo_resumen,1,50);
          v_extractoResumenes.modalidad        := resr.modalidad;
          v_extractoResumenes.fechaInicio      := resr.fec_inicio;
          v_extractoResumenes.fechaVencimiento := resr.fec_vencimiento;
          v_extractoResumenes.montoCapital     := resr.mto_capital;
          v_extractoResumenes.montoInteres     := nvl(resr.mto_interes,0);
          v_extractoResumenes.codigoMoneda     := resr.cod_moneda;
          v_extractoResumenes.saldoDisponible  := resr.saldo;

          v_resumenesCuenta.extend;
          v_resumenesCuenta(v_resumenesCuenta.count) := v_extractoResumenes;
        END LOOP;
        -- Obtiene Detalle de bloqueo de la cuenta
        v_msg_error := MSG_OBT_BLO_ER;
        FOR blor IN (SELECT a.nro_cuenta,
                            fue_obt_titulo(b.descripcion) des_cau_bloqueo,
                            a.fec_inicio,
                            a.fec_fin,
                            a.monto,
                            d.cod_moneda
                       FROM ge_bloqueos     a,
                            ge_causales     b,
                            ge_cta_clientes c,
                            ge_cuentas      d
                      WHERE a.cod_causa = b.cod_causa
\*                        AND a.cod_causa IN
                            (SELECT cod_causa
                               FROM ge_par_causales
                              WHERE parametro = 'COD_CAU_BLO_EXT'
                                AND val_parametro = 'S')*\
                        AND a.fec_inicio <= v_fec_extracto
                        AND (a.fec_fin IS NULL OR fec_fin >= v_fec_extracto)
                        AND c.nro_cuenta = a.nro_cuenta
                        AND d.nro_cuenta = c.nro_cuenta
                        AND( d.nro_cuenta = v_nroCuenta
                        OR   v_nroCuenta IS NULL
                        OR d.nro_cuenta = FUT_OBT_NRO_TARJETA(v_nroCuenta))
                        AND c.cod_persona = v_codPersona) LOOP

          v_extractoBloqueos.numeroCuenta := nvl(blor.nro_cuenta,'');
          v_extractoBloqueos.causaBloqueo := nvl(blor.des_cau_bloqueo,'');
          v_extractoBloqueos.fechaInicio  := nvl(blor.fec_inicio,'');
          v_extractoBloqueos.fechaFin     := nvl(blor.fec_fin,'');
          v_extractoBloqueos.monto        := nvl(blor.monto,0);
          v_extractoBloqueos.codigoMoneda := nvl(blor.cod_moneda,'');
          v_bloqueosCuenta.extend;
          v_bloqueosCuenta(v_bloqueosCuenta.count) := v_extractoBloqueos;
        END LOOP;
      -- Carga el retorno
      v_msg_error := MSG_ERROR;
      IF v_cuentasCliente.Count > 0 THEN
        v_retorno.cuentasCliente := v_cuentasCliente;
      END IF;
      IF v_detallesMovimiento.Count > 0 THEN
        v_retorno.detallesMovimiento := v_detallesMovimiento;
      END IF;
      IF v_retencionesCuenta.Count > 0 THEN
        v_retorno.retencionesCuenta := v_retencionesCuenta;
      END IF;
      IF v_resumenesCuenta.Count > 0 THEN
        v_retorno.resumenesCuenta := v_resumenesCuenta;
      END IF;
      IF v_bloqueosCuenta.Count > 0 THEN
        v_retorno.bloqueosCuenta := v_bloqueosCuenta;
      END IF;

      pr_mensajeUsuario(MSG_OK,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
      pr_insertarBitacora(userinfo.codigoPersona,p_codCanal,p_sesion,cod_operacion,userinfo.codigoEmpresa,'Se termina Correctamente el extracto',bitacora_salida);
      \* Obtiene la informacion de parametros recibos y el return del type *\
      paw_log.g_typ_extracto := v_retorno;
      paw_log.pr_logValoresTypes('typ_extracto',
     'Extracto a Requerimiento'||'-'|| p_sesion||', '|| p_codcanal||', '|| p_fechaHasta );
      RETURN v_retorno;

    EXCEPTION
      WHEN OTHERS THEN
        paw_log.g_typ_extracto := v_retorno;
        paw_log.pr_logValoresTypes('typ_extracto',
        'Extracto a Requerimiento'||'-'|| p_sesion||', '|| p_codcanal||', '|| p_fechaHasta );
        pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona,p_codCanal,p_sesion,cod_operacion,userinfo.codigoEmpresa,'Funcion de Extracto a Req. - ' || SQLERRM,bitacora_error);
        RETURN v_retorno;
    END;--fin*/

  
   
    /** Pago de Prestamo
    * @param p_sesion Codigo de la sesion
    * @param p_codCanal Codigo del canal
    * @param p_nroPrestamo Numero de Prestamo
    * @param p_cuentaDebito Cuenta de Debito
    * @param p_cantCuotas Cantidad de Cuotas a Pagar
    * @param p_montoOperacion Monto de la Operacion
    * @param p_modo Modo
    * @param p_claveToken Clave de Token
    * @return Resultado de la operacion de Pago de Prestamo
    */
   /*FUNCTION fu_pagoPrestamo(p_codigoPersona          IN VARCHAR2,
                            p_codigoEmpresa          IN VARCHAR2,
                            p_codCanal           IN VARCHAR2,
                            p_nroPrestamo        IN VARCHAR2,
                            p_cuentaDebito       IN VARCHAR,
                            p_cantCuotas         IN VARCHAR2,
                            p_montoOperacion     IN NUMBER,
                            p_modo               IN VARCHAR2,
                            p_claveToken         IN VARCHAR2,
                            p_claveTransaccional IN VARCHAR2) RETURN typ_pagoPrestamo IS
   c_pre_cta_invalida     constant varchar2(15) := '216';
   c_pre_cuo_ya_ingresada constant varchar2(15) := '217';
   c_pre_mon_diferentes   constant varchar2(15) := '219';
   c_pre_mon_loc_invalida constant varchar2(15) := '220';
   c_pre_tot_dep_invalido constant varchar2(15) := '221';
   c_cta_deb_invalida     constant varchar2(15) := '222';
   c_pre_mto_invalido     constant varchar2(15) := '223';
   c_pre_cta_deb_error    constant varchar2(15) := '225';
   c_pre_cuo_invalida     constant varchar2(15) := '226';
   c_en_juicio            constant varchar2(15) := '166';
   c_can_cuotas           constant varchar2(15) := '251';
   c_val_cuotas           constant varchar2(15) := '262';
   MSG_CLA_OPE_INVALIDA   constant varchar2(15) := 'CLA_OPE_INVALID';
   SAL_PER_SIN_AUT        constant varchar2(15) := 'SAL_PER_SIN_AUT';
   c_sin_movimiento       constant varchar2(15) := 'OBTDETCHEQ_SMOV';

   v_tip_mensaje          varchar2(3) := '031';
   retValidarSesion       typ_validarSesion;
   v_permiso              typ_obtenerPermisos;
   retError               typ_mensajeRespuesta := typ_mensajeRespuesta;
   v_mensajeCaja          typ_mensajeCaja;
   v_resLimite            typ_respuestaLimite;
   v_retorno              typ_pagoPrestamo := typ_pagoPrestamo;
   v_sesion               bw_aut_sesiones.cod_sesion%type;
   v_cod_canal            ge_canales.cod_canal%type;
   -- para controlar transacciones duplicadas, default 10 minutos
   v_min_transaccion number := nvl(to_number(fug_obt_pardinamico('PAW_MIN_TRANSACCION')), 10);
   -- datos recibidos
   v_nro_prestamo    varchar2(16); -- nro de tarjeta a pagar
   v_modo            varchar2(3);   -- modo S/V/C
   -- datos a responder
   -- variables
   v_nro_cuenta      varchar2(17);
   v_nom_titular     varchar2(100);
   v_tip_prestamo    varchar2(35);
   v_cod_moneda      varchar2(3);
   v_nro_cta_debito  varchar2(17);
   v_cod_mon_debito  varchar2(4);
   --
   v_cod_mod_cta     number(4);
   v_cod_mad_cta     number(4);
   v_cod_ofi_cta     number(4);
   v_cod_retencion   number(4);     -- codigo de retencion
   v_fec_fin_retencion date;        -- fecha final de la retencion
   v_cod_tra_padre   number(4) := 360;
   v_cod_transaccion number(4);
   v_nro_sobre       number(10);
   v_imp_efectivo    number(18,2) := 0;   -- efectivo
   v_imp_che_n_bco   number(18,2) := 0;  -- che.ntro.bco
   v_imp_che_o_bco   number(18,2) := 0; -- che otros bcos.
   v_imp_debito      number(18,2) := 0;   -- debito
   v_tot_pago        number(18,2) := 0;   -- total
   v_can_cuo_pagada  number(5)    := 0;
   -- cuotas
   v_cantidad        number(5) := 0;
   v_nro_cuota_desde number(5) := null;
   v_nro_cuota_hasta number(5) := null;
   -- variables
   v_mto_cobrado        number(18,2);      -- Mto cobrado (no se despliega)
   v_tot_capital        number(18,2);      -- Capital (no se despliega )
   v_tot_interes        number(18,2);      -- Interes (no se despliega )
   v_tot_cap_int        number(18,2);      -- Capital + interes + int.adel (DESPLIEGA : importe )
   v_tot_int_adelantado number(18,2);      -- Interes adelantado (no despliega)
   v_tot_mora           number(18,2);      -- Mora s/capital (no despliega)
   v_tot_mora_interes   number(18,2);      -- Mora s/Interes (DESPLIEGA : Mora s/interes )
   v_tot_mora_int_adel  number(18,2);      -- Mora interes adelantado (no desp)
   v_tot_impuesto       number(18,2);      -- Total impuesto (DESPLIEGA : ley 125/91)
   v_tot_cargo          number(18,2);      -- Total cargo (DESPLIEGA : Cargo + IVA )
   v_tot_cargo_iva      number(18,2);      -- Total cargo IVA  (no desp)
   v_tot_int_descontado number(18,2);      -- Total interes descontado (no desp)
   v_tot_a_cobrar       number(18,2);      -- Total a cobrar (DESPLIEGA: cap+int+morai+morac+imp+cargo)
   v_tot_mora_cap       number(18,2);      -- Total mora s/capital (DESPLIEGA: v_tot_mora+v_tot_mora_int_adel)
   v_tot_punitorio      number(18,2);      -- Total monto punitorio (DESPLIEGA : Punitorio)
   v_cod_error          varchar2(03)  := '000'; -- sin errores
   v_msj_error          varchar2(100) := 'OK'; -- sin errores
   v_dia_mora           number(10);
   v_cant               number := 0;
   --
   v_cta_for_debito  varchar2(17);  -- cuenta formateada
   v_cod_mod_debito  number(4);     -- modulo de la cuenta
   v_cod_mad_debito  number(4);     -- modalidad de la cuenta
   v_cod_ofi_debito  number(4);     -- oficina de la cuenta
   v_nom_cta_debito  varchar2(100);
   v_cotizacion      number(18,4) := null;
   v_nro_documento   number(15);
   v_en_juicio       pr_cta_prestamos.en_juicio%type;
   v_nro_telefono    bw_movimientos.nro_telefono%type;
   -- agregados
   v_fec_valor       date := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
   v_hor_actual      varchar2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
   v_nro_operacion   number(10); -- nro unico de operacion generado por el cliente
   v_nro_secuencia   number(3) := 0;
   -- para lp_ver_horario
   v_horario         varchar2(1) := 'D'; -- Dia normal
   v_es_mov_noc      varchar2(1) := 'N';
   v_es_cta_noc      varchar2(1) := 'N'; -- Graba S/N ctas noctunas
   v_fec_actual      date := pag_cal.fu_obt_fec_actual(9);
   v_claveTransaccional bw_ope_claves.clave%type;

   v_cuota              pr_cobros.mto_capital%TYPE;
   v_int_mor_cap        pr_cobros.mto_int_moratorio%TYPE := 0;
   v_int_mor_int        pr_cobros.mto_int_mor_int_des%TYPE := 0;
   v_int_mor_ade        pr_cobros.mto_int_mor_adelantado%TYPE := 0;
   v_int_punitorio      pr_cobros.mto_int_punitorio%TYPE := 0;
   v_impuesto           pr_cobros.mto_impuesto%TYPE := 0;
   v_cargo              pr_cobros.mto_cargo%TYPE := 0;
   v_iva                pr_cobros.mto_cargo_iva%TYPE := 0;
   v_mto_capital        pr_cobros.mto_capital%TYPE := 0;
   v_mto_interes        pr_cobros.mto_interes%TYPE := 0;
   v_saldo_capital      pr_cobros.sal_capital_cuo%TYPE := 0;
   v_saldo_interes      pr_cobros.sal_interes_cuo%TYPE := 0;
   v_mto_descontado     pr_cobros.mto_int_descontado%TYPE := 0;
   v_iva5               pr_cobros.mto_cargo_iva%TYPE := 0;
   v_mora               pr_cobros.mto_int_mor_int_des%TYPE := 0;
   v_nro_factura        varchar2(30);
   CURSOR cuotas(p_nro_cuenta IN VARCHAR2) IS
      select  a.nro_cuota,
              nvl(c.mto_capital,0) + nvl(c.mto_interes,0) + nvl(c.mto_int_documentado, 0) +
              nvl(c.mto_int_moratorio, 0) + nvl(c.mto_int_mor_interes, 0) + nvl(c.mto_int_mor_adelantado, 0) +
              nvl(c.mto_int_punitorio, 0) + nvl(c.mto_cargo, 0) + nvl(c.mto_impuesto, 0) mto_cuota,
              a.fec_vencimiento, a.fec_ult_pago,
              decode(sign(v_fec_actual - a.fec_vencimiento),1,
                     (v_fec_actual - a.fec_vencimiento), 0 ) dia_mora
        from pr_cobros_tmp c, pr_cuotas a
       where c.nro_cuenta = a.nro_cuenta
         and c.nro_cuota  = a.nro_cuota
         and a.nro_cuenta = p_nro_cuenta
         and a.nro_cuota > 0
         and a.estado <> 'N'
       order by a.nro_cuota;

   BEGIN
     pre_cam_for_numerico('.,');
     --0. valido la sesion del cliente
     v_sesion    := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
     v_cod_canal := depurarAlfanumerico(p_codCanal,3);
     v_claveTransaccional  := trim(p_clavetransaccional);

     IF v_ind_cta_encriptada = 'S' THEN
        v_nro_prestamo   := fu_desencriptacionCuentas(depurarCuenta( trim(p_nroPrestamo),CUENTA_TAMANO));
     ELSE
       v_nro_prestamo   := depurarCuenta(trim(p_nroPrestamo),CUENTA_TAMANO);
     END IF;
     v_modo           := depurarAlfanumerico(p_modo,1);
     v_can_cuo_pagada := depurarNumerico (p_cantCuotas,5);
     --Valido la clave transaccional en modo confirmacion
     IF nvl(v_modo, 'x') = 'C'  then
       If v_claveTransaccional is null then
           pr_mensajeUsuario(MSG_CLA_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            \*Obtiene la informacion de parametros recibos y el return del type *\
            paw_log.g_typ_pagoPrestamo := v_retorno;
            paw_log.pr_logValoresTypes('typ_pagoPrestamo',
            'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
            p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
            p_modo
            );
          RETURN v_retorno;

       end if;
     end if;

     --valido la cantidad de cuotas ingresadas
     begin
       select count(nro_cuenta)
         into v_cant
         from pr_cuotas
        where nro_cuenta = v_nro_prestamo
          and estado != 'N'
          and nro_cuota != 0;
     exception
        when no_data_found then
           v_cant := 0;
     end;
     If v_can_cuo_pagada > v_cant then
       pr_mensajeUsuario(c_val_cuotas,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
       pr_insertarBitacora(retValidarSesion.codigoPersona,v_cod_canal,v_sesion,
                          v_tip_mensaje,retValidarSesion.codigoEmpresa,'Nro. Prestamo:' || v_nro_prestamo || ' modo:' ||
                          v_modo || ' Cant. cuotas:' || v_can_cuo_pagada || ' ' ||
                          fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,
                          null),BITACORA_ERROR);

        \*Obtiene la informacion de parametros recibos y el return del type*\
        paw_log.g_typ_pagoPrestamo := v_retorno;
        paw_log.pr_logValoresTypes('typ_pagoPrestamo',
        'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
        p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
        p_modo
        );

       RETURN v_retorno;
     end if;

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     --retValidarSesion := fu_validarSesion(v_sesion, v_cod_canal);
     retValidarSesion.error:='N';
     retValidarSesion.codigoCanal:=v_cod_canal;
     retValidarSesion.codigoPersona:=p_codigoPersona;
     retValidarSesion.codigoEmpresa:=p_codigoEmpresa;
     pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ENTRADA);
     v_nro_telefono   := retValidarSesion.numeroTelefono;

     IF retValidarSesion.error = 'S' THEN
        v_retorno.error                := retValidarSesion.error;
        v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
        v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
        \*Obtiene la informacion de parametros recibos y el return del type *\
        paw_log.g_typ_pagoPrestamo := v_retorno;
        paw_log.pr_logValoresTypes('typ_pagoPrestamo',
        'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
        p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
        p_modo );
        RETURN v_retorno;
     END IF;

     --1. Valido la caja
     v_mensajeCaja := lf_val_caja(retValidarSesion);
     IF v_mensajeCaja.error = 'S' THEN
        v_retorno.error                := v_mensajeCaja.error;
        v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;

        \*Obtiene la informacion de parametros recibos y el return del type *\
        paw_log.g_typ_pagoPrestamo := v_retorno;
        paw_log.pr_logValoresTypes('typ_pagoPrestamo',
        'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
        p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
        p_modo );
        RETURN v_retorno;
     END IF;

      --controla horario cierre
      if nvl(fug_obt_pardinamico('BWE_BLO_HOR_CIERRE'),'N') = 'S' then
          reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                      v_mensajeCaja.fechaUltimoCierre \* v_ult_cierre *\,
                                      -- IN
                                      v_mensajeCaja.codigoOficinaOrigen \* v_cod_ofi_origen *\,
                                      -- IN
                                      v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

           IF reterror.error = 'S' THEN
              v_retorno.error                := reterror.error;
              v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
              v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
              RETURN v_retorno;
           END IF;
      end if;

        -- . verifico si el cliente con su perfil tendra acceso a realizar la transaccion
      v_permiso := lf_obt_permisos(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), retValidarSesion.codigoPerfil,v_tip_mensaje,retValidarSesion.codigoCanal);

      IF (v_permiso.error = 'S') THEN
        v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
        v_retorno.error                := v_permiso.error;
        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal,v_sesion,v_tip_mensaje,retValidarSesion.codigoEmpresa,
        fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null),BITACORA_ERROR);
        \*Obtiene la informacion de parametros recibos y el return del type *\
        paw_log.g_typ_pagoPrestamo := v_retorno;
        paw_log.pr_logValoresTypes('typ_pagoPrestamo',
        'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
        p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
        p_modo );
        RETURN v_retorno;
      END IF;

      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
        pr_mensajeUsuario(SAL_PER_SIN_AUT,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona,p_codCanal,v_sesion,v_cod_operacion,retValidarSesion.codigoEmpresa,
        fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),BITACORA_ERROR);

        \*Obtiene la informacion de parametros recibos y el return del type *\
        paw_log.g_typ_pagoPrestamo := v_retorno;
        paw_log.pr_logValoresTypes('typ_pagoPrestamo',
        'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
        p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
        p_modo );
        RETURN v_retorno;
      END IF;
     -- 2. Para operaciones de prestamo se graba el usuario con el que se conecta
      v_mensajeCaja := lf_val_caja(retValidarSesion);

      IF nvl(v_modo, 'x') <> 'A' THEN
      DECLARE
      v_lugar VARCHAR2(50);
        BEGIN
          -- Ajuste por requerimiento de control de clave en la verificacion
          -- antes de envio a bancard, se recibe pedido en modo V para validar la clave transaccional
          IF (v_modo = 'C'  AND p_claveTransaccional IS NOT NULL) THEN
            v_lugar  := 'lf_obt_cla_validar: ';
            retError := lf_obt_cla_validar(v_claveTransaccional, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa,'T');
          END IF;
          IF retError.error = 'S' THEN
            v_retorno.error := retError.error;
            v_retorno.nombreRespuesta := retError.nombreRespuesta;
            v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, v_lugar || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            \*Obtiene la informacion de parametros recibos y el return del type *\
            paw_log.g_typ_pagoPrestamo := v_retorno;
            paw_log.pr_logValoresTypes('typ_pagoPrestamo',
            'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
            p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
            p_modo );
           RETURN v_retorno;
          END IF;
        END;
      END IF;

     IF v_modo = 'C' AND nvl(v_can_aut_requeridas,0) = 0 THEN
        -- se confirma directamente la operacion, porque no requiere autorizacion
        v_modo := 'A'; -- CONFIRMACION
     END IF;

     -- 2. busco los datos de la cuentas
     IF v_retorno.error = 'N' THEN
        BEGIN
         select a.nro_cuenta,
                fue_obt_nom_persona(b.cod_persona) nom_titular,
                fug_obt_des_modal(a.cod_modulo,a.cod_modalidad) tip_prestamo,
                a.cod_moneda,
                a.cod_modulo,
                a.cod_modalidad,
                a.cod_oficina,
                a.en_juicio
          into v_nro_cuenta,
               v_nom_titular,
               v_tip_prestamo,
               v_cod_moneda,
               v_cod_mod_cta,
               v_cod_mad_cta,
               v_cod_ofi_cta,
               v_en_juicio
          from ge_cta_clientes b, pr_cta_prestamos a
         where a.nro_cuenta = v_nro_prestamo
           and a.nro_cuenta = b.nro_cuenta
           and b.relacion = 'P';
        EXCEPTION
           WHEN no_data_found THEN
              pr_mensajeUsuario(c_pre_cta_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
        END;

     END IF;

     IF v_retorno.error = 'N' THEN
          if nvl(v_can_cuo_pagada,0) = 0 then
             pr_mensajeUsuario(c_can_cuotas, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             \*Obtiene la informacion de parametros recibos y el return del type *\
             paw_log.g_typ_pagoPrestamo := v_retorno;
             paw_log.pr_logValoresTypes('typ_pagoPrestamo',
             'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
             p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
             p_modo );

             RETURN v_retorno;
          end if;
          -- todo ok, se arma el mensaje de respuesta
          if v_modo = 'V' then -- validacion
            -- esta la cuenta en condiciones, verifico el horario del deposito
            -- validacion
             retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre,
                                        v_mensajeCaja.codigoOficinaOrigen, v_fec_actual,v_mensajeCaja.fechaCierre, v_fec_valor);

             IF retError.error = 'S' THEN
                v_retorno.error := retError.error;
                v_retorno.nombreRespuesta := retError.nombreRespuesta;
                v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'lp_ver_horario - Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                \*Obtiene la informacion de parametros recibos y el return del type *\
                paw_log.g_typ_pagoPrestamo := v_retorno;
                paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                p_modo );

                return v_retorno;
             END IF;
            --
            v_can_cuo_pagada := depurarNumerico (p_cantCuotas,5);
            IF v_ind_cta_encriptada = 'S' THEN
               v_nro_cta_debito := fu_desencriptacionCuentas(depurarCuenta(p_cuentaDebito,CUENTA_TAMANO));
            ELSE
               v_nro_cta_debito := depurarCuenta(p_cuentaDebito,CUENTA_TAMANO);
            END IF;

            if v_nro_cta_debito is not null then
              if (instr(v_nro_cta_debito,'-') > 0 or instr(v_nro_cta_debito,' ') > 0) then
                 -- se extrae los guiones de la cuenta
                 v_nro_cta_debito := to_number(substr(v_nro_cta_debito,7));
              end if;
            else
                 pr_mensajeUsuario(c_cta_deb_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 \*Obtiene la informacion de parametros recibos y el return del type *\
                  paw_log.g_typ_pagoPrestamo := v_retorno;
                  paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                  'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                  p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                  p_modo );
                 RETURN v_retorno;
            end if;

            v_nro_cuota_desde := null;
            v_nro_cuota_hasta := null;
            v_cantidad := 0;
            pap_pre.PR_INI_AUTORIZACION;
            pap_pre.PR_OBT_DEU_PRESTAMO(v_nro_cuenta
                               ,v_fec_actual
                               ,0
                               ,999
                               ,v_mensajeCaja.codigoOficinaOrigen \* v_cod_ofi_origen *\
                               ,v_mto_cobrado
                               ,v_cod_error
                               ,v_msj_error
                               ,v_tot_capital
                               ,v_tot_interes
                               ,v_tot_int_adelantado
                               ,v_tot_mora
                               ,v_tot_mora_interes
                               ,v_tot_mora_int_adel
                               ,v_tot_punitorio
                               ,v_tot_impuesto
                               ,v_tot_cargo
                               ,v_tot_cargo_iva
                               ,v_tot_int_descontado
                               ,v_dia_mora
                               ,v_cod_tra_padre
                               ,'N'); --- cancela

            if v_cod_error <> 0 then
                  pr_mensajeUsuario(c_pre_cta_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:' || v_nro_prestamo || ' ' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
                  \*Obtiene la informacion de parametros recibos y el return del type *\
                  paw_log.g_typ_pagoPrestamo := v_retorno;
                  paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                  'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                  p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                  p_modo );

                  RETURN v_retorno;
            end if;

            for cu in cuotas(v_nro_cuenta) loop
                if v_nro_cuota_desde is null then
                   v_nro_cuota_desde := cu.nro_cuota;
                end if;
                v_cantidad := v_cantidad + 1;
                if v_cantidad >= v_can_cuo_pagada then
                   v_nro_cuota_hasta := cu.nro_cuota;
                   exit;
                end if;
            end loop;

            IF v_nro_cuota_desde IS NULL OR v_nro_cuota_hasta IS NULL THEN
                  pr_mensajeUsuario(c_pre_cuo_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:' || v_nro_prestamo || ' ' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
                  \*Obtiene la informacion de parametros recibos y el return del type *\
                  paw_log.g_typ_pagoPrestamo := v_retorno;
                  paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                  'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                  p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                  p_modo );

                 RETURN v_retorno;
            END IF;

            -- valido la duplicacion de pago de prestamos
             declare
                 v_cant_cob number(5);
             begin
                select count('S')
                  into v_cant_cob
                  from pr_cobros
                 where nro_cuenta = v_nro_cuenta
                   and usu_insercion = v_mensajeCaja.codigoUsuario
                   and fecha = v_fec_actual
                   and ((sysdate) -fec_insercion)* 1440 <= v_min_transaccion;

                If v_cant_cob > 0 Then
                   pr_mensajeUsuario(c_pre_cuo_ya_ingresada, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   \*Obtiene la informacion de parametros recibos y el return del type *\
                   paw_log.g_typ_pagoPrestamo := v_retorno;
                   paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                   'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                   p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                   p_modo );
                   return v_retorno;
                end if;

                select count('*')
                  into v_cant_cob
                  from bw_mov_pendientes
                 where nro_cta_contra = v_nro_cuenta
                   and usu_insercion = v_mensajeCaja.codigoUsuario
                   and cod_tip_mensaje = '031'
                   and ((sysdate) -fec_insercion)* 1440 <= v_min_transaccion
                   and estado = 'P';

                If v_cant_cob > 0 Then
                   pr_mensajeUsuario(c_pre_cuo_ya_ingresada, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   \*Obtiene la informacion de parametros recibos y el return del type *\
                   paw_log.g_typ_pagoPrestamo := v_retorno;
                   paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                   'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                   p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                   p_modo );
                  return v_retorno;
                end if;
             exception
                when no_data_found then
                   null;
                when too_many_rows then
                   pr_mensajeUsuario(c_pre_cuo_ya_ingresada, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             end;

            -- obtengo los datos del prestamos
            pap_pre.PR_INI_AUTORIZACION;
            pap_pre.PR_OBT_DEU_PRESTAMO(v_nro_cuenta,
                         v_fec_actual,
                         v_nro_cuota_desde,
                         v_nro_cuota_hasta,
                         v_mensajeCaja.codigoOficinaOrigen,
                         v_mto_cobrado,
                         v_cod_error,
                         v_msj_error,
                         v_tot_capital,
                         v_tot_interes,
                         v_tot_int_adelantado,
                         v_tot_mora,
                         v_tot_mora_interes,
                         v_tot_mora_int_adel,
                         v_tot_punitorio,
                         v_tot_impuesto,
                         v_tot_cargo,
                         v_tot_cargo_iva,
                         v_tot_int_descontado,
                         v_dia_mora,
                         v_cod_tra_padre,  --- cod_tra_padre
                         'N'); --- cancela
            if v_cod_error <> 0 then
               pr_mensajeUsuario(c_pre_cta_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               \*Obtiene la informacion de parametros recibos y el return del type *\
               paw_log.g_typ_pagoPrestamo := v_retorno;
               paw_log.pr_logValoresTypes('typ_pagoPrestamo',
               'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
               p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
               p_modo );

               return v_retorno;
            else
                -- sumo los totales
                v_tot_cap_int  := nvl(v_tot_capital,0) + nvl(v_tot_interes,0)+ nvl(v_tot_int_adelantado,0);
                v_tot_mora_cap := nvl(v_tot_mora,0) + nvl(v_tot_mora_int_adel,0);

                v_tot_a_cobrar:= nvl(v_tot_cap_int,0) +
                               nvl(v_tot_mora_interes,0) +
                               nvl(v_tot_mora_cap,0) +
                               nvl(v_tot_punitorio,0) +
                               nvl(v_tot_impuesto,0) +
                               nvl(v_tot_cargo,0) ;


                 retError := lf_val_cta_debito(v_nro_cta_debito
                                              ,v_cod_tra_padre
                                              ,nvl(v_tot_a_cobrar,0)
                                              ,v_cod_mon_debito
                                              ,v_cod_mod_debito
                                              ,v_cod_mad_debito
                                              ,v_cod_ofi_debito
                                              ,v_cta_for_debito
                                              ,v_nom_cta_debito
                                              ,retValidarSesion
                                              ,v_mensajeCaja);

                  if retError.error = 'S' then
                     v_retorno.error := retError.error;
                     v_retorno.nombreRespuesta := retError.nombreRespuesta;
                     v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                     pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'lf_val_cta_debito - Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  end if;

                if v_cod_moneda <> v_cod_mon_debito and v_retorno.error = 'N'then
                  -- moneda diferentes
                  pr_mensajeUsuario(c_pre_mon_diferentes, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                end if;
            end if;
            --
            if v_en_juicio = 'S' THEN -- Valida si el prestamo esta en Juicio
               pr_mensajeUsuario(c_en_juicio, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            end if;
            --
            if  v_retorno.error != 'N' then
                return v_retorno;
            else
                  v_retorno.cotizacion := v_cotizacion;
                  v_retorno.numeroCtaDebito := v_nro_cta_debito;
                  v_retorno.montoCapital := v_tot_capital;
                  v_retorno.tipoCtaDebito := v_nom_cta_debito;
                  v_retorno.codigoMoneda := v_cod_mon_debito;
                  v_retorno.montoOperacion := v_tot_a_cobrar;
                  v_retorno.nombreCtaDebito := v_nom_titular;
                  v_retorno.totalInteres :=  nvl(v_tot_interes,0)+ nvl(v_tot_int_adelantado,0);
                  v_retorno.totalMora := nvl(v_tot_mora_cap, 0) + nvl(v_tot_mora_interes, 0);
                  v_retorno.totalCargos := nvl(v_tot_cargo, 0) + nvl(v_tot_punitorio, 0);
                  v_retorno.totalImpuestos := nvl(v_tot_impuesto, 0);
                  v_retorno.numeroPrestamo := v_nro_cuenta;
                  v_retorno.respuestaLimite      := v_resLimite.codRespuesta;
                  pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
            end if;
            \*Obtiene la informacion de parametros recibos y el return del type
            *\
            paw_log.g_typ_pagoPrestamo := v_retorno;
            paw_log.pr_logValoresTypes('typ_pagoPrestamo',
            'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
            p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
            p_modo
            );
            return v_retorno;
         elsif v_modo in ('A','C') then
          -- confirmacion de operacion
          -- esta la cuenta en condiciones, verifico el horario del deposito
          retError := lp_ver_horario(v_horario
                                    ,v_es_mov_noc
                                    ,v_es_cta_noc
                                    ,v_mensajeCaja.fechaUltimoCierre
                                    ,v_mensajeCaja.codigoOficinaOrigen
                                    ,v_fec_actual
                                    ,v_mensajeCaja.fechaCierre
                                    ,v_fec_valor);

          IF retError.error = 'S' THEN
             v_retorno.error := retError.error;
             v_retorno.nombreRespuesta := retError.nombreRespuesta;
             v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
             pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'lp_ver_horario - Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             \*Obtiene la informacion de parametros recibos y el return del type *\
             paw_log.g_typ_pagoPrestamo := v_retorno;
             paw_log.pr_logValoresTypes('typ_pagoPrestamo',
             'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
             p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
             p_modo );

             RETURN v_retorno;
          END IF;

          -- verifico la validez de los montos
          begin
            v_can_cuo_pagada := depurarNumerico (p_cantCuotas,5);
            IF v_ind_cta_encriptada = 'S' THEN
               v_nro_cta_debito := fu_desencriptacionCuentas(depurarCuenta (p_cuentaDebito,CUENTA_TAMANO));
            ELSE
               v_nro_cta_debito := depurarCuenta(p_cuentaDebito,CUENTA_TAMANO);
            END IF;

              if v_nro_cta_debito is not null then
              if (instr(v_nro_cta_debito,'-') > 0 or instr(v_nro_cta_debito,' ') > 0) then
                 -- se extrae los guiones de la cuenta
                  v_nro_cta_debito := to_number(substr(v_nro_cta_debito,7));
              end if;
            else
              pr_mensajeUsuario(c_cta_deb_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              \*Obtiene la informacion de parametros recibos y el return del type *\
              paw_log.g_typ_pagoPrestamo := v_retorno;
              paw_log.pr_logValoresTypes('typ_pagoPrestamo',
              'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
              p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
              p_modo );
              RETURN v_retorno;
            end if;


            v_nro_cuota_desde := null;
            v_nro_cuota_hasta := null;
            v_cantidad := 0;
            for cu in cuotas(v_nro_cuenta) loop
                if v_nro_cuota_desde is null then
                   v_nro_cuota_desde := cu.nro_cuota;
                end if;
                v_cantidad := v_cantidad + 1;
                if v_cantidad >= v_can_cuo_pagada then
                   v_nro_cuota_hasta := cu.nro_cuota;
                   exit;
                end if;
            end loop;

            if v_nro_cuota_desde is null or v_nro_cuota_hasta is null then
                   pr_mensajeUsuario(c_pre_cuo_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   \*Obtiene la informacion de parametros recibos y el return del type *\
                   paw_log.g_typ_pagoPrestamo := v_retorno;
                   paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                   'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                   p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                   p_modo );
                   return v_retorno;
            end if;

             if nvl(v_modo,'x') = 'A' then -- ya vienen los datos como parametros
                v_nro_sobre     := 0;
                v_imp_efectivo  := 0;
                v_imp_che_n_bco := 0;
                v_imp_che_o_bco := 0;
                v_imp_debito    := depurarNumerico(p_montoOperacion,18);
                v_tot_pago      := depurarNumerico(p_montoOperacion,18);
            end if;

            if v_cod_moneda = v_cod_mon_local then
               if v_imp_efectivo <> trunc(v_imp_efectivo) or
                  v_imp_che_n_bco <> trunc(v_imp_che_n_bco) or
                  v_imp_che_o_bco <> trunc(v_imp_che_o_bco)  or
                  v_imp_debito <> trunc(v_imp_debito) then
                  -- monto con decimales y en guaranies no permite
                  pr_mensajeUsuario(c_pre_mon_loc_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  return v_retorno;
               elsif nvl(v_imp_efectivo,0) + nvl(v_imp_che_n_bco,0) +
                     nvl(v_imp_che_o_bco,0) + nvl(v_imp_debito,0) <> nvl(v_tot_pago,0) then
                     -- total depositado invalido
                     pr_mensajeUsuario(c_pre_tot_dep_invalido, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                     \*Obtiene la informacion de parametros recibos y el return del type *\
                     paw_log.g_typ_pagoPrestamo := v_retorno;
                     paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                     'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                     p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                     p_modo );
                    return v_retorno;
               end if;
            end if;
            if v_nro_cta_debito is not null then
                -- valido la cuenta de debito
                retError := lf_val_cta_debito(v_nro_cta_debito
                                             ,v_cod_tra_padre
                                             ,nvl(v_tot_pago, 0)
                                             ,v_cod_mon_debito
                                             ,v_cod_mod_debito
                                             ,v_cod_mad_debito
                                             ,v_cod_ofi_debito
                                             ,v_cta_for_debito
                                             ,v_nom_cta_debito
                                             ,retValidarSesion
                                             ,v_mensajeCaja);


                if v_modo = 'C' and v_can_aut_requeridas = 0 then
                   -- se confirma directamente la operacion, porque no requiere autorizacion
                   v_modo := 'A'; -- CONFIRMACION
                end if;
                if v_retorno.error = 'N' and retError.error = 'S' then
                   v_retorno.error := retError.error;
                   v_retorno.nombreRespuesta := retError.nombreRespuesta;
                   v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                   \*Obtiene la informacion de parametros recibos y el return del type *\
                   paw_log.g_typ_pagoPrestamo := v_retorno;
                   paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                   'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                   p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                   p_modo );

                   return v_retorno;
                end if;
            end if;
          exception
            when others then
               -- monto invalido
               pr_mensajeUsuario(c_pre_mto_invalido, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
          end;
          if v_retorno.error = 'N' and v_modo = 'C' then
             -- grabacion en pendiente
             -- registro del movimiento
                v_imp_debito    := depurarNumerico(p_montoOperacion,18);
                paw_con.pr_reg_operacion(v_nro_prestamo \*p_nro_cuenta*\,
                                 v_cod_moneda   \*p_cod_moneda *\,
                                 v_tot_a_cobrar     \*p_monto*\,
                                 v_nro_cta_debito \*p_nro_cta_contra*\,
                                 v_cantidad     \*p_cantidad*\,
                                'Efectivo'     \*p_etiqueta*\,
                                v_imp_efectivo \*p_dato*\,
                                'Cheques'      \*p_etiqueta2*\,
                                v_imp_che_n_bco + v_imp_che_o_bco \*p_dato2*\,
                               'PagoPrestamo Operacion'    \*observacion*\,
                                null           \*direccion IP*\,
                               'Grabacion en Pendiente - Modo:'||' '||v_modo  \*p_mensaje*\,
                               retValidarSesion.codigoPersona \*p_cotizacion*\,
                               v_tip_mensaje ,
                               v_nro_prestamo,
                               C_COD_HOMEBANKING,
                               v_sesion,
                               retValidarSesion.codigoEmpresa);
              if v_imp_debito > 0 then
                --- inserto el movimiento pendiente de autorizacion
                select s_nro_documento.nextval into v_nro_documento from dual;
                insert into bw_mov_pendientes
                  (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda,
                   descripcion, monto, nro_cta_contra,etiqueta, dato,
                   estado,can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra)
                values
                   (v_nro_documento, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),sysdate,'031',v_nro_cta_debito,v_cod_moneda,
                    'Pago de Prestamos',v_imp_debito, v_nro_prestamo,'Cant.de Cuotas',v_can_cuo_pagada,
                    'P', v_can_aut_requeridas, v_can_aut_requeridas, retValidarSesion.codigoPersona, v_imp_debito
                   );
                   pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa,'Cant. Aut. Req:'||v_can_aut_requeridas||' Nro. documento: '||v_nro_documento||' Nro. Prestamo:'||v_nro_prestamo||' mon:'||v_cod_moneda||' Tot. pago:'||v_tot_pago||' cta. deb:'||v_nro_cta_debito||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
                   v_retorno.cantidadAutorizadores := v_can_aut_requeridas;
                   v_retorno.numeroDocumento := v_nro_documento;
                  \*Obtiene la informacion de parametros recibos y el return del type
                  *\
                  paw_log.g_typ_pagoPrestamo := v_retorno;
                  paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                  'PagoPrestamo Modo C'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                  p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                  p_modo
                  );
                  RETURN v_retorno;
              else
                 pr_mensajeUsuario(c_pre_mto_invalido, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              end if;
          elsif v_retorno.error = 'N'  and v_modo = 'A' then
                 paw_con.pr_reg_operacion(v_nro_prestamo \*p_nro_cuenta*\,
                                   v_cod_moneda   \*p_cod_moneda *\,
                                   v_tot_a_cobrar \*p_monto*\,
                                   v_nro_cta_debito \*p_nro_cta_contra*\,
                                   v_cantidad     \*p_cantidad*\,
                                   'Efectivo'     \*p_etiqueta*\,
                                   v_imp_efectivo \*p_dato*\,
                                   'Cheques'      \*p_etiqueta2*\,
                                   v_imp_che_n_bco + v_imp_che_o_bco \*p_dato2*\,
                                   'PagoPrestamo Operacion'\*observacion*\,
                                   null           \*direccion IP*\,
                                   'Movimiento confirmado Modo:'||' '||v_modo \*p_mensaje*\,
                                   retValidarSesion.codigoPersona \*p_cotizacion*\,
                                   v_tip_mensaje,
                                   v_nro_prestamo,
                                   C_COD_HOMEBANKING,
                                   v_sesion,
                                   retValidarSesion.codigoEmpresa);

            if v_retorno.error = 'N' and retError.error = 'S' then
               v_retorno.error := retError.error;
               v_retorno.nombreRespuesta := retError.nombreRespuesta;
               v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
               \*Obtiene la informacion de parametros recibos y el return del type *\
                paw_log.g_typ_pagoPrestamo := v_retorno;
                paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                p_modo );
              return v_retorno;
            end if;

            -- sigue sin problemas hasta aqui, ya puedo grabar
            if v_imp_efectivo > 0 then
               -- importe en efectivo
                v_cod_transaccion := 613;
                -- obtengo el codigo y fin de retencion
                pag_cta.pr_obt_retencion(v_fec_actual,
                                         v_nro_cuenta,
                                         v_cod_mod_cta,
                                         v_cod_mad_cta,
                                         v_cod_transaccion,
                                         v_cod_moneda,
                                         v_cod_retencion,
                                         v_fec_fin_retencion);
                  -- genero el movimiento respectivo
                  lp_ins_movimiento( retError,          -- agregado
                                     v_nro_secuencia,   -- agregado
                                     retValidarSesion,  -- agregado
                                     v_mensajeCaja,     -- agregado
                                     v_fec_actual,      -- agregado
                                     v_hor_actual,      -- agregado
                                     v_fec_valor,       -- agregado
                                     v_cod_mod_cta,
                                     v_cod_mad_cta,
                                     v_cod_ofi_cta,
                                     v_nro_cuenta,
                                     v_cod_moneda,
                                     v_cod_tra_padre,
                                     v_cod_transaccion,
                                     v_nro_sobre,
                                     v_imp_efectivo,
                                     'E', -- EFECTIVO
                                     v_es_mov_noc,
                                     v_cod_retencion,
                                     v_fec_fin_retencion);
            end if;
            if v_imp_che_n_bco > 0 then
               -- importe en cheques ntro banco
                v_cod_transaccion := 614;
                -- obtengo el codigo y fin de retencion
                pag_cta.pr_obt_retencion(v_fec_actual,
                                         v_nro_cuenta,
                                         v_cod_mod_cta,
                                         v_cod_mad_cta,
                                         v_cod_transaccion,
                                         v_cod_moneda,
                                         v_cod_retencion,
                                         v_fec_fin_retencion);
                -- genero el movimiento respectivo
                lp_ins_movimiento( retError,          -- agregado
                                   v_nro_secuencia,   -- agregado
                                   retValidarSesion,  -- agregado
                                   v_mensajeCaja,     -- agregado
                                   v_fec_actual,      -- agregado
                                   v_hor_actual,      -- agregado
                                   v_fec_valor,       -- agregado
                                   v_cod_mod_cta,
                                   v_cod_mad_cta,
                                   v_cod_ofi_cta,
                                   v_nro_cuenta,
                                   v_cod_moneda,
                                   v_cod_tra_padre,
                                   v_cod_transaccion,
                                   v_nro_sobre,
                                   v_imp_che_n_bco,
                                   'C', -- cheque ntro bco
                                   v_es_mov_noc,
                                   v_cod_retencion,
                                   v_fec_fin_retencion);
            end if;
            if v_imp_che_o_bco > 0 then
               -- importe en cheques otros bancos
                v_cod_transaccion := 615;
                -- obtengo el codigo y fin de retencion
                pag_cta.pr_obt_retencion(v_fec_actual,
                                         v_nro_cuenta,
                                         v_cod_mod_cta,
                                         v_cod_mad_cta,
                                         v_cod_transaccion,
                                         v_cod_moneda,
                                         v_cod_retencion,
                                         v_fec_fin_retencion);
                -- genero el movimiento respectivo
                lp_ins_movimiento( retError,          -- agregado
                                   v_nro_secuencia,   -- agregado
                                   retValidarSesion,  -- agregado
                                   v_mensajeCaja,     -- agregado
                                   v_fec_actual,      -- agregado
                                   v_hor_actual,      -- agregado
                                   v_fec_valor,       -- agregado
                                   v_cod_mod_cta,
                                   v_cod_mad_cta,
                                   v_cod_ofi_cta,
                                   v_nro_cuenta,
                                   v_cod_moneda,
                                   v_cod_tra_padre,
                                   v_cod_transaccion,
                                   v_nro_sobre,
                                   v_imp_che_o_bco,
                                   'O', -- cheque otros bcos
                                   v_es_mov_noc,
                                   v_cod_retencion,
                                   v_fec_fin_retencion);
            end if;

            -- actualizo el control de caja
            update cj_controles
               set tot_che_nue_bco = nvl(tot_che_nue_bco,0) + nvl(v_imp_che_n_bco,0),
                   sal_actual = nvl(sal_actual,0) + nvl(v_imp_efectivo,0),
                   tot_debitos = nvl(tot_debitos,0) + nvl(v_imp_efectivo,0),
                   can_debitos = nvl(can_debitos,0) + decode(v_imp_efectivo,0,0,1),
                   tot_che_otr_bco = nvl(tot_che_otr_bco,0) + nvl(v_imp_che_o_bco,0),
                   sal_che_otr_bco = nvl(sal_che_otr_bco,0) + nvl(v_imp_che_o_bco,0)\*,
                   estado = 1*\ -- abierto
             where nro_caja = v_cod_canal
               and cod_moneda = v_cod_moneda
               and fecha = v_fec_actual;
            if sql%notfound then
               insert into cj_controles
                 (nro_caja, cod_moneda, fecha, estado,
                  mto_apertura, ini_che_otr_bco, cod_usu_actual,
                  tot_che_nue_bco, sal_actual, tot_debitos,
                  can_debitos, tot_che_otr_bco, sal_che_otr_bco)
               select
                  v_cod_canal, v_cod_moneda, v_fec_actual, 1,
                  0, 0, v_mensajeCaja.codigoUsuario,
                  v_imp_che_n_bco, v_imp_efectivo, v_imp_efectivo,
                  decode(v_imp_efectivo,0,0,1), v_imp_che_o_bco,
                  v_imp_che_o_bco from dual;
            end if;
            if v_imp_debito > 0 then
               -- valido la duplicacion de pago de Prestamos
               retError := fu_ver_transaccion(503
                                             ,v_cod_tra_padre
                                             ,v_nro_cta_debito
                                             ,v_imp_debito
                                             ,v_mensajeCaja);

               if retError.error = 'S' then
                  v_retorno.error := retError.error;
                  v_retorno.nombreRespuesta := retError.nombreRespuesta;
                  v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                  pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'fu_ver_transaccion - Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  \*Obtiene la informacion de parametros recibos y el return del type *\
                  paw_log.g_typ_pagoPrestamo := v_retorno;
                  paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                  'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                  p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                  p_modo );
                 return v_retorno;
               end if;

               -- genero el movimiento respectivo
                begin
                  select cod_moneda
                    into v_cod_mon_debito
                    from ge_cuentas
                   where nro_cuenta = v_nro_cta_debito;
                  if v_cod_mon_debito <> v_cod_moneda then
                     pr_mensajeUsuario(c_pre_mon_diferentes, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                  end if;
                exception
                   when no_data_found then
                      v_cod_mon_debito := null;
                   when others then
                      pr_mensajeUsuario(c_cta_deb_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                      pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                end;
                if v_retorno.error = 'N' then
                    -- seteo las variables para el debito
                    pag_cta.PR_SET_VARIABLES(v_mensajeCaja.codigoUsuario,
                                             v_fec_valor,
                                             v_cod_tra_padre, 'N', 'N',
                                             v_nro_secuencia,
                                             null,
                                             v_mensajeCaja.codigoOficinaOrigen,
                                             9,
                                             91);
                    -- esta la cuenta en condiciones, verifico el horario
                    retError := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc, v_mensajeCaja.fechaUltimoCierre,v_mensajeCaja.codigoOficinaOrigen,
                                               v_fec_actual, v_mensajeCaja.fechaCierre, v_fec_valor);
                    -- para evitar la repeticion de la hora en los movimientos
                    v_hor_actual := fug_obt_hor_disponible(v_fec_actual,v_hor_actual,user,v_es_mov_noc);
                    if retError.error = 'S' then
                         v_retorno.error := retError.error;
                         v_retorno.nombreRespuesta := retError.nombreRespuesta;
                         v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
                         pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'lp_ver_horario - Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                         \*Obtiene la informacion de parametros recibos y el return del type *\
                         paw_log.g_typ_pagoPrestamo := v_retorno;
                         paw_log.pr_logValoresTypes('typ_pagoPrestamo',
                         'PagoPrestamo Operacion'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
                         p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
                         p_modo );

                         return v_retorno;
                    end if;
                    -- genero el numero de operacion
                    SELECT s_nro_operacion.NEXTVAL
                      INTO v_nro_operacion
                      FROM dual;
                    -- realizo el debito respectivo
                    pag_cta.PR_ACT_OPERACION(v_nro_cta_debito, v_hor_actual,'D',
                                             v_cod_mon_debito, v_imp_debito,
                                             v_cod_tra_padre, 503, v_nro_operacion,
                                             null, v_mensajeCaja.codigoOficinaOrigen, 9, 91,
                                             null, null, 'Pago de Prestamos',
                                             'N', v_nro_secuencia, v_fec_valor,
                                             null, null, null);
                   if nvl(pag_cta.g_cod_error,0) <> 0 then
                      -- hubo error en el debito
                      pr_mensajeUsuario(c_pre_cta_deb_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                      pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'PR_ACT_OPERACION - Cta Debito: ' || v_nro_cta_debito || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                   else
                      -- veo si el prestamo, debe quedar como pagado
                      if v_horario in ('T','N') then
                         -- insert into pr_cobros_noc para procesar en el inicio de dia.
                         insert into pr_cobros_noc
                         (nro_cuenta, nro_cuota_desde, nro_cuota_hasta,
                          fecha, hora, estado, mto_cobrado, cod_ofi_origen,
                          cod_mod_padre, cod_mad_padre, cod_tra_padre,
                          nro_secuencia)
                         values
                         (v_nro_cuenta, v_nro_cuota_desde, v_nro_cuota_hasta,
                          v_fec_actual, v_hor_actual, 'I', v_tot_pago, v_mensajeCaja.codigoOficinaOrigen,
                          9, 91, v_cod_tra_padre, v_nro_secuencia);
                         --
                      else
                         -- horario normal, se aplica el prestamo
                         pap_pre.pr_cob_prestamo(v_nro_cuenta,
                                                 v_tot_pago,
                                                 'N',
                                                 v_mensajeCaja.codigoOficinaOrigen,
                                                 v_nro_cuota_desde,
                                                 v_nro_cuota_hasta,
                                                'Pago de Cuota', --concepto
                                                 v_fec_actual,
                                                 v_hor_actual,
                                                 v_nro_secuencia,
                                                 v_cod_tra_padre,
                                                 9,
                                                 91,
                                                 'N');
                        BEGIN
                             SELECT SUM(nvl(a.mto_capital, 0) + nvl(a.mto_interes, 0) +
                                        nvl(a.mto_int_documentado, 0)),
                                    SUM(nvl(a.mto_int_moratorio, 0)),
                                    SUM(nvl(a.mto_int_mor_interes, 0)),
                                    SUM(nvl(a.mto_int_mor_adelantado, 0)),
                                    SUM(nvl(a.mto_int_punitorio, 0)),
                                    SUM(nvl(a.mto_impuesto, 0)),
                                    SUM(nvl(a.mto_cargo, 0) - nvl(a.mto_cargo_iva, 0)),
                                    SUM(nvl(a.mto_cargo_iva, 0)),
                                    SUM(nvl(a.mto_capital, 0)),
                                    SUM((nvl(a.mto_interes, 0) + nvl(a.mto_int_documentado, 0))),
                                    SUM(nvl(a.sal_capital_cuo, 0) - nvl(a.mto_capital, 0)),
                                    SUM((nvl(a.sal_interes_cuo, 0) + nvl(a.sal_int_documentado, 0)) -
                                        (nvl(a.mto_interes, 0) + nvl(a.mto_int_documentado, 0))),
                                    SUM(nvl(a.mto_int_descontado, 0))
                               INTO v_cuota,
                                    v_int_mor_cap,
                                    v_int_mor_int,
                                    v_int_mor_ade,
                                    v_int_punitorio,
                                    v_impuesto,
                                    v_cargo,
                                    v_iva,
                                    v_mto_capital,
                                    v_mto_interes,
                                    v_saldo_capital,
                                    v_saldo_interes,
                                    v_mto_descontado
                               FROM ba_personas       c,
                                    ge_cta_clientes   b,
                                    pr_cobros         a,
                                    pr_cta_prestamos  p,
                                    ba_tip_documentos d
                              WHERE a.nro_cuenta = b.nro_cuenta
                                AND p.nro_cuenta = a.nro_cuenta
                                AND b.relacion = 'P'
                                AND c.cod_persona = b.cod_persona
                                AND a.nro_cuenta = p_nroPrestamo
                                AND d.cod_tip_documento = c.cod_tip_documento
                                AND a.fecha = v_fec_actual
                                AND a.hora = v_hor_actual
                              GROUP BY c.nro_documento;

                              v_mora := v_int_mor_cap + v_int_mor_int + v_int_mor_ade + v_int_punitorio;
                              if v_mora > 0 then
                                 pab_iva.pr_gen_lib_vta_tmp(retValidarSesion.codigoPersona, v_fec_actual, v_hor_actual, v_mensajeCaja.codigoUsuario);
                                 v_nro_factura := pab_iva.fu_gen_factura(retValidarSesion.codigoPersona, v_fec_actual, v_hor_actual, v_mensajeCaja.codigoUsuario);

                              end if;
                          EXCEPTION
                             WHEN OTHERS THEN
                                pr_mensajeUsuario(c_sin_movimiento, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'PR_ACT_OPERACION - Cta Debito: ' || v_nro_cta_debito || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                          END;

                      end if;
                   end if ;
                end if;
            end if;
         end if;
       end if;
      --dato para impresion de comprobantes en estado A.
       v_retorno.numeroDocumento := v_nro_operacion;
      \*Obtiene la informacion de parametros recibos y el return del type
      *\
      paw_log.g_typ_pagoPrestamo := v_retorno;
      paw_log.pr_logValoresTypes('typ_pagoPrestamo',
      'PagoPrestamo Salida'||' '||v_sesion||', '|| p_codCanal||', '||  p_nroPrestamo||', '||
      p_cuentaDebito||', '|| p_cantCuotas||', '|| p_montoOperacion||', '||
      p_modo
      );

      pre_cam_for_numerico('.,');

      IF v_retorno.error = 'N' THEN
             pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
       END IF;
          commit;
          RETURN v_retorno;
       ELSE
          RETURN v_retorno;
       END IF;
   EXCEPTION
    WHEN OTHERS THEN
        pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Nro. Prestamo:'||sqlerrm||v_nro_prestamo||' modo:'||v_modo||' Cant. cuotas:'||v_can_cuo_pagada||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      RETURN v_retorno;
   END;
  -- Fin Pago de Prestamos*/

   /**
   * @Creado por: Samuel da Costa
   * @Fecha : 16-04-2013
   * @param p_sesion Codigo de la sesion
   * @param p_codCanal Codigo del canal
   * @param p_numeroCuenta Numero de cuenta del Prestamo
   * @return Retorna las cuotas del Prestamo
   */
    FUNCTION fu_obtenerCuotasPrestamo(p_sesion      IN VARCHAR2,
                                      p_codCanal    IN VARCHAR2,
                                      p_nroPrestamo IN VARCHAR2)
    RETURN typ_obtCuotasPrestamo IS

    MSG_PRE_CTA_INVALIDA  constant varchar2(15) := '214';
    MSG_PRE_PAG_PENDIENTE constant varchar2(15) := '215';
    MSG_NROPRE_NOEX       constant varchar2(15) := 'NROPRE_NOEX';
    v_retorno             typ_obtCuotasPrestamo := typ_obtCuotasPrestamo;
    detalleCuota          typ_cuotaPrestamo := typ_cuotaPrestamo;
    listaCuotas           typ_listaCuotaPrestamo := typ_listaCuotaPrestamo();
    retValidarSesion      typ_validarSesion;
    retError              typ_mensajeRespuesta := typ_mensajeRespuesta;
    v_mensajeCaja         typ_mensajeCaja;
    v_sesion              bw_aut_sesiones.cod_sesion%type;
    v_cod_canal           ge_canales.cod_canal%type;
    v_tip_mensaje         varchar2(3) := '031';

    -- datos recibidos
    -- variables
    v_nro_cuenta    varchar2(17);
    v_nro_prestamo  varchar2(17); -- ge_cuentas.nro_cuenta%type;
    v_cod_tra_padre number(4) := 360;
    -- cuotas
    v_can_cuotas      number(5) := 0;
    v_nro_cuota_desde number(5) := null;
    v_nro_cuota_hasta number(5) := null;
    -- variables
    v_mto_cobrado        number(18, 2); -- Mto cobrado (no se despliega)
    v_tot_capital        number(18, 2); -- Capital (no se despliega )
    v_tot_interes        number(18, 2); -- Interes (no se despliega )
    v_tot_int_adelantado number(18, 2); -- Interes adelantado (no despliega)
    v_tot_mora           number(18, 2); -- Mora s/capital (no despliega)
    v_tot_mora_interes   number(18, 2); -- Mora s/Interes (DESPLIEGA : Mora s/interes )
    v_tot_mora_int_adel  number(18, 2); -- Mora interes adelantado (no desp)
    v_tot_impuesto       number(18, 2); -- Total impuesto (DESPLIEGA : ley 125/91)
    v_tot_cargo          number(18, 2); -- Total cargo (DESPLIEGA : Cargo + IVA )
    v_tot_cargo_iva      number(18, 2); -- Total cargo IVA  (no desp)
    v_tot_int_descontado number(18, 2); -- Total interes descontado (no desp)
    v_tot_punitorio      number(18, 2); -- Total monto punitorio (DESPLIEGA : Punitorio)
    v_cod_error          varchar2(03) := '000'; -- sin errores
    v_msj_error          varchar2(100) := 'OK'; -- sin errores
    v_dia_mora           number(10);
    -- para lp_ver_operacion
    v_horario    varchar2(1);
    v_es_mov_noc varchar2(1);
    v_es_cta_noc varchar2(1);
    v_fec_actual date;
    v_fec_valor  date;

    CURSOR cuotas(p_nro_cuenta IN VARCHAR2) IS
      select a.nro_cuota,
             nvl(c.mto_capital, 0) + nvl(c.mto_interes, 0) +
             nvl(c.mto_int_documentado, 0) + nvl(c.mto_int_moratorio, 0) +
             nvl(c.mto_int_mor_interes, 0) +
             nvl(c.mto_int_mor_adelantado, 0) + nvl(c.mto_int_punitorio, 0) +
             nvl(c.mto_cargo, 0) + nvl(c.mto_impuesto, 0) mto_cuota,
             a.fec_vencimiento,
             a.fec_ult_pago,
             decode(sign(v_fec_actual - a.fec_vencimiento),
                    1,
                    (v_fec_actual - a.fec_vencimiento),
                    0) dia_mora
        from pr_cobros_tmp c, pr_cuotas a
       where c.nro_cuenta = a.nro_cuenta
         and c.nro_cuota = a.nro_cuota
         and a.nro_cuenta = p_nro_cuenta
         and a.nro_cuota > 0
         and a.estado <> 'N'
         AND a.fec_vencimiento <= SYSDATE + 25
       order by a.nro_cuota;

  BEGIN

   If nvl(p_nroPrestamo, 'X') = 'X' Then

      pr_mensajeUsuario(MSG_NROPRE_NOEX,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
      retError.error                := v_retorno.error;
      retError.nombreRespuesta      := v_retorno.nombreRespuesta;
      retError.descripcionRespuesta := v_retorno.descripcionRespuesta;
      pr_insertarBitacora(retValidarSesion.codigoPersona,
                          p_codCanal,
                          p_sesion,
                          v_tip_mensaje,
                          retValidarSesion.codigoEmpresa,
                          'Obtener Cuotas Prestamo - Nro Prestamo: ' ||
                          p_nroPrestamo ||
                          fu_generarBitacora(retValidarSesion.error,
                                             retValidarSesion.nombreRespuesta,
                                             retValidarSesion.descripcionRespuesta,
                                             null),
                          BITACORA_ERROR);

     /* Obtiene la informacion de parametros recibos y el return del type
     */
     paw_log.g_typ_obtCuotasPrestamo := v_retorno;
     paw_log.pr_logValoresTypes('typ_obtCuotasPrestamo',
     'ObtCuotasPrestamo'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroPrestamo);
     RETURN v_retorno;
   end if;

    --0. valido la sesion del cliente
    v_sesion    := depurarAlfanumerico(p_sesion, 32);
    v_cod_canal := depurarAlfanumerico(p_codCanal, 3);

    retValidarSesion := fu_validarSesion(v_sesion, v_cod_canal);
    IF v_ind_cta_encriptada = 'S' THEN
       v_nro_prestamo   := fu_desencriptacionCuentas(depurarCuenta(p_nroPrestamo,
                                                                CUENTA_TAMANO));
    ELSE
       v_nro_prestamo   := depurarCuenta(p_nroPrestamo,CUENTA_TAMANO);
    END IF;


    IF retValidarSesion.error = 'S' THEN
      v_retorno.error                := retValidarSesion.error;
      v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      /* Obtiene la informacion de parametros recibos y el return del type
      */
      paw_log.g_typ_obtCuotasPrestamo := v_retorno;
      paw_log.pr_logValoresTypes('typ_obtCuotasPrestamo',
      'ObtCuotasPrestamo'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroPrestamo);

      RETURN v_retorno;
    END IF;



    --1. Valido la caja
    v_mensajeCaja := lf_val_caja(retValidarSesion);
    IF v_mensajeCaja.error = 'S' THEN
      v_retorno.error                := v_mensajeCaja.error;
      v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
      v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
      /* Obtiene la informacion de parametros recibos y el return del type
      */
      paw_log.g_typ_obtCuotasPrestamo := v_retorno;
      paw_log.pr_logValoresTypes('typ_obtCuotasPrestamo',
      'ObtCuotasPrestamo'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroPrestamo);
      RETURN v_retorno;
    END IF;

    pr_mensajeUsuario(MSG_OK,
                      v_retorno.nombreRespuesta,
                      v_retorno.descripcionRespuesta,
                      v_retorno.error);
    pr_insertarBitacora(retValidarSesion.codigoPersona,
                        v_cod_canal,
                        v_sesion,
                        v_tip_mensaje,
                        retValidarSesion.codigoEmpresa,
                        'Nro. Prestamo:' || v_nro_prestamo || ' ' ||
                        fu_generarBitacora(retValidarSesion.error,
                                           retValidarSesion.nombreRespuesta,
                                           retValidarSesion.descripcionRespuesta,
                                           null),
                        BITACORA_ENTRADA);

    -- seleccion de datos
    -- esta la cuenta en condiciones, verifico el horario del deposito
    -- cuotas del prestamo
    retError := lp_ver_horario(v_horario,
                               v_es_mov_noc,
                               v_es_cta_noc,
                               v_mensajeCaja.fechaUltimoCierre,
                               v_mensajeCaja.codigoOficinaOrigen,
                               v_fec_actual,
                               v_mensajeCaja.fechaCierre,
                               v_fec_valor);

    IF retError.error = 'S' THEN
      v_retorno.error                := retError.error;
      v_retorno.nombreRespuesta      := retError.nombreRespuesta;
      v_retorno.descripcionRespuesta := retError.descripcionRespuesta;
      pr_insertarBitacora(retValidarSesion.codigoPersona,
                          v_cod_canal,
                          v_sesion,
                          v_tip_mensaje,
                          retValidarSesion.codigoEmpresa,
                          'lp_ver_horario - Nro. Prestamo:' ||
                          v_nro_prestamo || ' ' ||
                          fu_generarBitacora(retValidarSesion.error,
                                             retValidarSesion.nombreRespuesta,
                                             retValidarSesion.descripcionRespuesta,
                                             null),
                          BITACORA_ERROR);

     /* Obtiene la informacion de parametros recibos y el return del type
     */
     paw_log.g_typ_obtCuotasPrestamo := v_retorno;
     paw_log.pr_logValoresTypes('typ_obtCuotasPrestamo',
     'ObtCuotasPrestamo'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroPrestamo);

      RETURN v_retorno;
    END IF;

    BEGIN
      /*glopez - Agregamos para que retorne el nroCtaDebito*/
      SELECT a.nro_cuenta, a.nro_cta_debito
        INTO v_nro_cuenta, v_retorno.nroCtaDebito
        FROM ge_cta_clientes b, pr_cta_prestamos a
       WHERE a.nro_cuenta = v_nro_prestamo
         AND a.nro_cuenta = b.nro_cuenta
         AND b.relacion = 'P';
    EXCEPTION
      WHEN no_data_found THEN
        pr_mensajeUsuario(MSG_PRE_CTA_INVALIDA,
                          v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta,
                          v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona,
                            v_cod_canal,
                            v_sesion,
                            v_tip_mensaje,
                            retValidarSesion.codigoEmpresa,
                            'Nro. Prestamo:' || v_nro_prestamo || ' ' ||
                            fu_generarBitacora(v_retorno.error,
                                               v_retorno.nombreRespuesta,
                                               v_retorno.descripcionRespuesta,
                                               null),
                            BITACORA_ERROR);

        /* Obtiene la informacion de parametros recibos y el return del type
        */
        paw_log.g_typ_obtCuotasPrestamo := v_retorno;
        paw_log.pr_logValoresTypes('typ_obtCuotasPrestamo',
        'ObtCuotasPrestamo'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroPrestamo);

        RETURN v_retorno;
    END;

    v_can_cuotas := 0;
    v_nro_cuota_desde := 0;
    v_nro_cuota_hasta := 999;
    pap_pre.PR_INI_AUTORIZACION;
    pap_pre.PR_OBT_DEU_PRESTAMO(v_nro_cuenta,
                                v_fec_actual,
                                v_nro_cuota_desde,
                                v_nro_cuota_hasta,
                                v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                v_mto_cobrado,
                                v_cod_error,
                                v_msj_error,
                                v_tot_capital,
                                v_tot_interes,
                                v_tot_int_adelantado,
                                v_tot_mora,
                                v_tot_mora_interes,
                                v_tot_mora_int_adel,
                                v_tot_punitorio,
                                v_tot_impuesto,
                                v_tot_cargo,
                                v_tot_cargo_iva,
                                v_tot_int_descontado,
                                v_dia_mora,
                                v_cod_tra_padre,
                                'N'); --- cancela

    IF v_cod_error <> 0 THEN
      pr_mensajeUsuario(MSG_PRE_CTA_INVALIDA,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona,
                          v_cod_canal,
                          v_sesion,
                          v_tip_mensaje,
                          retValidarSesion.codigoEmpresa,
                          'Nro. Prestamo:' || v_nro_prestamo || ' ' ||
                          fu_generarBitacora(retValidarSesion.error,
                                             retValidarSesion.nombreRespuesta,
                                             retValidarSesion.descripcionRespuesta,
                                             null),
                          BITACORA_ERROR);

      /* Obtiene la informacion de parametros recibos y el return del type
      */
      paw_log.g_typ_obtCuotasPrestamo := v_retorno;
      paw_log.pr_logValoresTypes('typ_obtCuotasPrestamo',
      'ObtCuotasPrestamo'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroPrestamo);

      RETURN v_retorno;
    END IF;

    -- Finalmente verifico si no tiene cobros pendientes de ser aplicados...
    DECLARE
      v_can_pag_pend NUMBER(5) := 0;
    BEGIN
      SELECT COUNT('S')
        INTO v_can_pag_pend
        FROM pr_cobros_noc
       WHERE nro_cuenta = v_nro_cuenta
         AND estado = 'I';
      IF v_can_pag_pend > 0 THEN
        pr_mensajeUsuario(MSG_PRE_PAG_PENDIENTE,
                          v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta,
                          v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona,
                            v_cod_canal,
                            v_sesion,
                            v_tip_mensaje,
                            retValidarSesion.codigoEmpresa,
                            'Nro. Prestamo:' || v_nro_prestamo || ' ' ||
                            fu_generarBitacora(retValidarSesion.error,
                                               retValidarSesion.nombreRespuesta,
                                               retValidarSesion.descripcionRespuesta,
                                               null),
                            BITACORA_ERROR);
      END IF;
    END;
    -- no hubo errores, obtengo los detalles de las cuotas
    IF v_retorno.error = 'N' THEN

      FOR cu IN cuotas(v_nro_cuenta) LOOP
        v_can_cuotas                  := v_can_cuotas + 1;
        detalleCuota.nroCuota         := cu.nro_cuota;
        detalleCuota.montoCuota       := cu.mto_cuota;
        detalleCuota.fechaVencimiento := to_date(to_char(cu.fec_vencimiento,
                                                 'ddmmyyyy'), 'ddmmyyyy');

        listaCuotas.EXTEND;
        listaCuotas(listaCuotas.COUNT) := detalleCuota;
      END LOOP;
      v_retorno.cantidadCuotas := v_can_cuotas;
      v_retorno.listaCuotas    := listaCuotas;
      IF v_ind_cta_encriptada = 'S' THEN
         v_retorno.numeroPrestamo := fu_encriptacioncuentas(v_nro_cuenta);
      ELSE
         v_retorno.numeroPrestamo := v_nro_cuenta;
      END IF;
      pr_insertarBitacora(retValidarSesion.codigoPersona,
                          v_cod_canal,
                          v_sesion,
                          v_tip_mensaje,
                          retValidarSesion.codigoEmpresa,
                          'Nro. Prestamo:' || v_nro_prestamo || ' ' ||
                          fu_generarBitacora(retValidarSesion.error,
                                             retValidarSesion.nombreRespuesta,
                                             retValidarSesion.descripcionRespuesta,
                                             null),
                          BITACORA_SALIDA);
    END IF;


   /* Obtiene la informacion de parametros recibos y el return del type
    */
 --  paw_log.g_typ_obtCuotasPrestamo := v_retorno;
   paw_log.pr_logValoresTypes('typ_obtCuotasPrestamo',
   'ObtCuotasPrestamo'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroPrestamo);

    RETURN v_retorno;
  END;

   /**
   *  saldo diarios
   * @Creado por: Fermin Gimenez
   * @Fecha : 13-09-2012
   * @param p_sesion Codigo de la sesion
   * @param p_codCanal Codigo del canal
   * @param p_numeroCuenta Numero de cuenta
   * @param p_cantidadDias cantidad de dias.
   * @return Resultado de la operacion
   */
   FUNCTION fu_obtenerSaldosDiarios(p_sesion       IN VARCHAR2,
                                    p_codCanal     IN VARCHAR2,
                                    p_numeroCuenta IN VARCHAR2,
                                    p_cantidadDias IN NUMBER)
                                    RETURN typ_detalleSaldosDiarios IS

      v_listaSaldosDiarios typ_listaSaldosDiarios := typ_listaSaldosDiarios();
      v_retorno            typ_detalleSaldosDiarios := typ_detalleSaldosDiarios;
      saldoDiario          typ_saldoDiario := typ_saldoDiario;
      retValidarSesion     typ_validarSesion;
      menRespuesta         typ_mensajeRespuesta := typ_mensajeRespuesta;

      v_codCanal           bw_aut_sesiones.cod_canal%type;
      v_sesion             bw_aut_sesiones.cod_sesion%type;
      v_tip_mensaje        VARCHAR2(3) := '230';
      v_moneda             VARCHAR2(3);
      v_nro_cuenta         VARCHAR2(20);
      v_can_detalles       NUMBER(3) := 0; -- cantidad de registros
      v_cant_dias          NUMBER(3):=0;
      v_fecDesde           DATE;
      v_cod_modulo         ge_cuentas.cod_modulo%type;
      v_cod_persona        ba_personas.cod_persona%type;

      --Codigos de error
      MSG_CODCTA_NOEX    CONSTANT VARCHAR2(15) := 'CODCTA_NOEX'; /**Codigo de Cuenta inexistente*/
      MSG_CTA_NO_CORRESP CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';

      CURSOR saldos(p_fecDesde DATE) IS
         SELECT fecha, sal_tot_cap - sal_blo_int - sal_ret_ade saldo, cat_riesgo
           FROM ge_sal_diarios
          WHERE nro_cuenta = p_numeroCuenta
            AND fecha BETWEEN trunc(p_fecDesde) AND trunc(SYSDATE)
          ORDER BY fecha DESC;

      CURSOR saldosTarjetas(p_fecDesde DATE) IS
        select pag_cal.fu_obt_fec_ant_hab(fecha, cod_oficina, 1) fechaSaldo,
               tot_deu_real saldo
          from ge_cla_operaciones_his
         WHERE nro_cuenta = p_numeroCuenta
           AND pag_cal.fu_obt_fec_ant_hab(fecha, cod_oficina, 1) BETWEEN
               trunc(p_fecDesde) AND trunc(SYSDATE)
         ORDER BY fecha DESC;

   BEGIN
      v_sesion     := depurarAlfanumerico(p_sesion,32);
      v_codCanal   :=  depurarAlfanumerico(p_codCanal,3);
      v_nro_cuenta := depurarCuenta(p_numeroCuenta, CUENTA_TAMANO);
      v_cant_dias  := depurarNumerico(p_cantidadDias,3);
      --valido la sesion del cliente
      retValidarSesion := fu_validarSesion(v_sesion, v_codCanal);

      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      v_cod_persona := nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);
      --Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(v_nro_cuenta, v_cod_persona) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         menRespuesta.error                := v_retorno.error;
         menRespuesta.nombreRespuesta      := v_retorno.nombreRespuesta;
         menRespuesta.descripcionRespuesta := v_retorno.descripcionRespuesta;
         pr_insertarBitacora(v_cod_persona, p_codCanal, p_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, fu_generarBitacora(menRespuesta.error,menRespuesta.nombreRespuesta, menRespuesta.descripcionRespuesta,null ), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(v_cod_persona, p_codCanal, p_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Obtener Saldos Cuenta - Nro Cta:' || p_numeroCuenta || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ENTRADA);

      --obtengo la moneda del nro de cuenta
      BEGIN
         SELECT x.cod_moneda, x.cod_modulo
           INTO v_moneda, v_cod_modulo
           FROM ge_cuentas x
          WHERE x.nro_cuenta = v_nro_cuenta;
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(MSG_CODCTA_NOEX, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_cod_persona, p_codCanal, p_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Obtener Saldos Diarios - Nro Cta: ' || p_numeroCuenta || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
            RETURN v_retorno;
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(v_cod_persona, p_codCanal, p_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa, 'Obtener Saldos Diarios - Nro Cta: ' || p_numeroCuenta || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      --calculo de la fecha desde
      v_fecDesde := SYSDATE - v_cant_dias;

      --saldos
      if v_cod_modulo = 5 then
        FOR sat IN saldosTarjetas(v_fecDesde) LOOP
           saldoDiario := typ_saldoDiario;

           v_can_detalles              := v_can_detalles + 1;
           saldoDiario.fecha           := sat.fechaSaldo;
           saldoDiario.saldo           := sat.saldo;

           v_listaSaldosDiarios.EXTEND;
           v_listaSaldosDiarios(v_listaSaldosDiarios.COUNT) := saldoDiario;

        END LOOP;
      else
        FOR sa IN saldos(v_fecDesde) LOOP
           saldoDiario := typ_saldoDiario;

           v_can_detalles              := v_can_detalles + 1;
           saldoDiario.fecha           := sa.fecha;
           saldoDiario.saldo           := sa.saldo;
           saldoDiario.categoriaRiesgo := sa.cat_riesgo;

           v_listaSaldosDiarios.EXTEND;
           v_listaSaldosDiarios(v_listaSaldosDiarios.COUNT) := saldoDiario;

        END LOOP;
      end if;



      IF v_retorno.error = 'N' THEN
         v_retorno.cantidadSaldos := v_can_detalles;
         v_retorno.codigoMoneda   := v_moneda;
         v_retorno.numeroCuenta   := p_numeroCuenta;
         v_retorno.cantidadSaldos := 0;
         v_retorno.listaSaldos    := v_listaSaldosDiarios;
         IF NOT v_listaSaldosDiarios IS NULL THEN
            v_retorno.cantidadSaldos := v_listaSaldosDiarios.COUNT;
         END IF;
      END IF;

      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL, 'Obtener Saldos Diarios - Nro Cta:' || p_numeroCuenta || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;
      /**
    * Migracion de fu_pro_operacion_032, encargada de realizar el pago de Tarjetas de Credito
    * @param p_sesion Codigo de la sesion
    * @param p_codCanal Codigo del canal
    * @param p_nroTarjetaCredito Numero de tarjeta de credito a pagar
    * @param p_cuentaDebito Numero de cuenta a debitar
    * @param p_modo <ul><il><b>C</b>:Confirmar</il><il><b>V</b>:Verificar</il></ul>
    * @param p_nroSobre: Compatibilidad otros canales
    * @param p_importeEfectivo: Compatibilidad otros canales
    * @param p_importeChequeBanco : Compatibilidad otros canales
    * @param p_importeChequeOtroBanco: Compatibilidad otros canales
    * @param p_importeDebito: Total a debitar de la cuenta
    * @param p_totalPago: Monto a pagar
    * @param p_claveToken  Dependiendo de la configuracion de limites operativos
    * @param p_numeroContrato Numero de Contrato de Cambios
    * @param p_esTercero Indica si la Transferencia es a un Tercero
    * @return Resultado de la operacion

    Productos: se comenta v_cod_grupo       ge_movimientos.cod_grupo%type :=0;

   */
  /* FUNCTION fu_pagoTarjetaCredito
   (  p_codigoPersona          IN VARCHAR2,
      p_codigoEmpresa          IN VARCHAR2,
      p_codcanal               IN VARCHAR2,
      p_nrotarjetacredito      IN VARCHAR2,
      p_cuentadebito           IN VARCHAR2,
      p_modo                   IN VARCHAR2,
      p_nrosobre               IN NUMBER,
      p_importeefectivo        IN NUMBER,
      p_importechequebanco     IN NUMBER,
      p_importechequeotrobanco IN NUMBER,
      p_importedebito          IN NUMBER,
      p_totalpago              IN NUMBER,
      p_clavetoken             IN VARCHAR2,
      p_numerocontrato         IN VARCHAR2,
      p_estercero              IN VARCHAR2 DEFAULT NULL,
      p_clavetransaccional     IN VARCHAR2
   ) RETURN typ_pagotarjetacredito IS

      -- datos recibidos
      v_nro_tarjeta VARCHAR2(16); -- nro de tarjeta a pagar
      v_modo        VARCHAR2(3); -- modo S/V/C
      -- variables
      v_nro_cuenta        VARCHAR2(17);
      v_embozado          VARCHAR(35);
      v_tip_tarjeta       VARCHAR2(35);
      v_cod_moneda        VARCHAR2(03);
      v_nro_cta_debito    VARCHAR2(17);
      v_cod_mon_debito    VARCHAR2(4);
      v_nom_cta_debito    VARCHAR2(100);
      v_es_ope_vencida    VARCHAR2(1) := 'N';
      v_nro_cta_tarjeta   VARCHAR2(20);
      v_cta_for_debito     VARCHAR2(17); -- cuenta formateada
      v_horario            VARCHAR2(1) := 'D'; -- Dia normal
      v_es_mov_noc         VARCHAR2(1) := 'N';
      v_es_cta_noc         VARCHAR2(1) := 'N'; -- Graba S/N ctas noctunas
      v_hor_actual         VARCHAR2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
      v_men_con_cam        VARCHAR2(30);
      v_es_tercero         VARCHAR2(1) := 'N';


      v_fec_ult_cierre     DATE;
      v_fec_fin_retencion  DATE; -- fecha final de la retencion
      v_fec_actual         DATE := pag_cal.fu_obt_fec_actual(9);
      v_fec_valor          DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy

      v_dia_mora          ta_cta_tarjetas.dia_mora%TYPE;
      v_est_cuenta        ge_cuentas.estado%TYPE;
      v_exi_cta           BOOLEAN;

      v_mto_pag_minimo    NUMBER(18, 2);
      v_deu_ult_cierre    NUMBER(18, 2);
      v_deu_actual        NUMBER(18, 2);
      v_cod_mod_cta       NUMBER(4);
      v_cod_mad_cta       NUMBER(4);
      v_cod_ofi_cta       NUMBER(4);
      v_cod_retencion     NUMBER(4); -- codigo de retencion
      v_cod_tra_padre      NUMBER(4) := 250;
      v_cod_transaccion    NUMBER(4);
      v_nro_sobre          NUMBER(10);
      v_imp_efectivo       NUMBER(18, 2) := 0; -- efectivo
      v_imp_che_n_bco      NUMBER(18, 2) := 0; -- che.ntro.bco
      v_imp_che_o_bco      NUMBER(18, 2) := 0; -- che otros bcos.
      v_imp_debito         NUMBER(18, 2) := 0; -- debito
      v_tot_pago           NUMBER(18, 2) := 0; -- total
      v_mto_equivalente    NUMBER(18, 2) := NULL;
      v_nro_contrato       NUMBER(10);
      v_cotizacion         NUMBER(18, 4);
      v_imp_deb_cotizado   NUMBER(18, 2) := 0; -- debito
      v_cot_tarjeta        NUMBER(18, 4) := NULL;
      v_cot_imp_deb        NUMBER(18, 4) := NULL;
      v_cod_mod_debito     NUMBER(4); -- modulo de la cuenta
      v_cod_mad_debito     NUMBER(4); -- modalidad de la cuenta
      v_cod_ofi_debito     NUMBER(4); -- oficina de la cuenta
      v_nro_documento      NUMBER(15);
      v_lin_credito        NUMBER(18, 2) := 0;
      v_con_contrato       NUMBER(5); --contador para verificar contrato valido
      v_mto_lim_canal      NUMBER(18, 2);
      v_nro_secuencia      NUMBER(3) := 0;
      v_nro_operacion      NUMBER(10);

      v_cod_mon_fuerte     ba_monedas.cod_moneda%TYPE := pag_gen.fu_obt_mon_fuerte;
      v_cot_lim_ori        ge_cotizaciones.val_compra%TYPE;
      v_cot_lim_des        ge_cotizaciones.val_compra%TYPE;
      v_nro_telefono       bw_movimientos.nro_telefono%TYPE;
      v_claveTransaccional bw_ope_claves.clave%TYPE;
      v_sesion             bw_aut_sesiones.cod_sesion%TYPE;
      v_cod_canal          ge_canales.cod_canal%TYPE;

      userinfo             typ_validarsesion;
      v_retorno            typ_pagotarjetacredito := typ_pagotarjetacredito();
      v_ret_mensaje        typ_mensajerespuesta := typ_mensajerespuesta;
      v_ret_horario        typ_mensajerespuesta := typ_mensajerespuesta;
      v_mensajeCaja        typ_mensajecaja;
      v_permiso            typ_obtenerpermisos;
      --Tipos de Mensajes de respuestas
      c_cod_cta_inexistente  CONSTANT VARCHAR2(15) := '233'; \** Codigo de Cuenta inexistente*\
      c_msg_tar_no_enc       CONSTANT VARCHAR2(15) := '232'; \** Nro. tarjeta no encontrado*\
      c_cod_cta_invalida     CONSTANT VARCHAR2(15) := '114'; \** Numero de Cuenta invalida*\
      c_cod_cta_cancelada    CONSTANT VARCHAR2(15) := '112'; \** Numero de Cuenta Cancelada*\
      c_mon_sin_decimal      CONSTANT VARCHAR2(15) := '220'; \** La Moneda no soporta Decimales*\
      c_cod_tot_invalido     CONSTANT VARCHAR2(15) := '122'; \** Monto total invalido*\
      c_cod_mto_invalido     CONSTANT VARCHAR2(15) := '264'; \** Monto pago minimo invalido*\
      c_cod_tra_invalida     CONSTANT VARCHAR2(15) := '109'; \** Transaccion invalida*\
      c_tra_err_conversion   CONSTANT VARCHAR2(15) := '203'; \** Error de conversion de moneda*\
      c_con_cam_invalido     CONSTANT VARCHAR2(15) := '162'; \** Contrato de Cambio invalido*\
      c_cod_lim_excedido     CONSTANT VARCHAR2(15) := '136'; \** Limite excedido*\
      c_cod_mto_no_existe    CONSTANT VARCHAR2(15) := '116'; \** No existe Monto a Pagar. Utilizado solo para la 032 y Mobile Banking*\
      c_mov_ya_ingresado     CONSTANT VARCHAR2(15) := '134'; \** Movimiento ya Ingresado*\
      c_cod_deb_monto        CONSTANT VARCHAR2(15) := '234'; \** Error al debitar el monto*\
      c_mto_cero             CONSTANT VARCHAR2(15) := '253'; \** El monto debe ser mayor a cero*\
      c_msg_mto_invalido     CONSTANT VARCHAR2(15) := '253'; \** El monto a pagar debe ser mayor a cero*\
      c_msg_sal_insuficiente CONSTANT VARCHAR2(15) := '105';
      msg_cla_ope_invalida   CONSTANT VARCHAR2(15) := 'CLA_OPE_INVALID';
      SAL_PER_SIN_AUT        CONSTANT VARCHAR2(15) := 'SAL_PER_SIN_AUT'; -- perfil sin autorizacion para pagos

      v_msg_error   VARCHAR2(15) := msg_error;
      v_tip_mensaje VARCHAR2(3) := '032';
      v_codpersona  VARCHAR2(15);
      v_log_mensaje VARCHAR2(1000);
      v_lugar      VARCHAR2(200);

      -- funcion que retorna si una tarjeta es o no prepaga
      FUNCTION lf_es_prepaga RETURN VARCHAR2 IS
      BEGIN
         IF v_cod_canal = c_cod_homebanking THEN
            IF v_lin_credito <= 1 THEN
               RETURN 'S';
            ELSE
               RETURN 'N';
            END IF;
         ELSE
            RETURN NULL; -- para los demas no se modifica la mensajeria
         END IF;
      END;

   BEGIN
      pre_cam_for_numerico('.,');
      v_sesion    := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
      v_cod_canal        := depurarAlfanumerico(p_codcanal, 32);
      v_claveTransaccional  := trim(p_clavetransaccional);
      IF v_ind_cta_encriptada = 'S' THEN
         v_nro_cta_debito   := fu_desencriptacionCuentas(depurarCuenta(TRIM(p_cuentadebito),
                                                                    cuenta_tamano));
      ELSE
         v_nro_cta_debito   := depurarCuenta(TRIM(p_cuentadebito),cuenta_tamano);
      END IF;

      v_nro_tarjeta      := depurarCuenta(TRIM(p_nrotarjetacredito), cuenta_tamano);
      v_modo             := depurarAlfanumerico(p_modo, 1);
      v_imp_debito       := depurarNumerico(p_importedebito, 18);
      v_imp_deb_cotizado := depurarAlfanumerico(p_importedebito, 18);
      v_nro_contrato     := depurarNumerico(p_numerocontrato, 7);
      v_es_tercero       := nvl(depurarAlfanumerico(p_estercero, 1), 'N');

      IF nvl(v_es_tercero, 'N') = 'N' THEN
         IF v_ind_cta_encriptada = 'S' THEN
            v_nro_tarjeta := fu_desencriptacionCuentas(v_nro_tarjeta);
         END IF;
      END IF;

      pr_mensajeUsuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,
                        v_retorno.error);
      --valida la clave transaccional en modo confirmacion
      IF nvl(v_modo, 'x') = 'C' THEN
         IF v_clavetransaccional IS NULL THEN
             pr_mensajeUsuario(msg_cla_ope_invalida, v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, v_retorno.error);
           \* Obtiene la informacion de parametros recibos y el return del type*\
            paw_log.g_typ_pagoTarjetaCredito := v_retorno;
            paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
            'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
            p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
            p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
            p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);
           RETURN v_retorno;
         END IF;
         null;
      END IF;

      -- Valido la Sesion del Cliente
      --userinfo      := fu_validarsesion(v_sesion, v_cod_canal);
       userinfo.error:='N';
       userinfo.codigoCanal:=v_cod_canal;
       userinfo.codigoPersona:=p_codigoPersona;
       userinfo.codigoEmpresa:=p_codigoEmpresa;
      v_codpersona  := nvl(userinfo.codigoEmpresa, userinfo.codigoPersona);
      v_log_mensaje := 'pagoTarjetaCredito - |Cta.Deb.: ' || v_nro_cta_debito || '| TC:' ||
                       v_nro_tarjeta || '| Monto:' || v_imp_debito || ' | Modo: ' || v_modo || '|';

      pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                          userinfo.codigoEmpresa,
                          v_log_mensaje || ' ' ||
                           fu_generarBitacora(userinfo.error, userinfo.nombreRespuesta,
                                              userinfo.descripcionRespuesta, NULL), bitacora_entrada);

      IF userinfo.error = 'S' THEN
         v_retorno.error                := userinfo.error;
         v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);
         RETURN v_retorno;
      END IF;

      -- Verifica si el usuario tiene acceso a la opcion y en que condicion
      v_permiso := lf_obt_permisos(v_codpersona, userinfo.codigoperfil, v_tip_mensaje,
                                   userinfo.codigocanal);

      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);
        RETURN v_retorno;
      END IF;

      -- Verifica el canal de origen
      v_mensajeCaja := lf_val_caja(userinfo);

      IF v_mensajeCaja.error = 'S' THEN
         v_retorno.error                := v_mensajeCaja.error;
         v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);
         RETURN v_retorno;
      END IF;

      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
        pr_mensajeUsuario(SAL_PER_SIN_AUT,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona,p_codCanal,v_sesion,v_cod_operacion,userinfo.codigoEmpresa,
        fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),BITACORA_ERROR);

         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);
        RETURN v_retorno;
      END IF;

      IF nvl(v_imp_debito, 0) <= 0 THEN
         pr_mensajeUsuario(c_mto_cero, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,
                           v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, NULL,
                             ' fu_pagoTarjetaCredito- ' || c_mto_cero || ' ' ||
                              fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);
        \* Obtiene la informacion de parametros recibos y el return del type *\
        paw_log.g_typ_pagoTarjetaCredito := v_retorno;
        paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
        'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
        p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
        p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
        p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);
        RETURN v_retorno;
      END IF;

      IF v_modo = 'C' AND v_permiso.autorizacionesRequeridas = 0 THEN
         -- se confirma directamente la operacion, porque no requiere autorizacion
         v_modo := 'A'; -- CONFIRMACION
      END IF;

      -- 0. Obtengo el nro de cuenta de la tarjeta
      BEGIN
         SELECT a.nro_cuenta
           INTO v_nro_cta_tarjeta
           FROM ge_cta_clientes a, ta_tarjetas b
          WHERE b.nro_tarjeta = v_nro_tarjeta
            AND b.nro_cuenta = a.nro_cuenta
            AND a.cod_persona = v_codpersona;
         v_exi_cta := TRUE;
      EXCEPTION
         WHEN no_data_found THEN
            v_exi_cta := FALSE;
      END;
      -- Si no existe el nro de cuenta, entonces puede ser el caso que un tercero este
      -- queriendo pagar la tarjeta o que  se haya enviado el nro de cuenta.

      IF NOT v_exi_cta THEN
         --primero busca por el nro de la tarjeta
         BEGIN
            SELECT DISTINCT nro_cuenta
              INTO v_nro_cta_tarjeta
              FROM ta_tarjetas
             WHERE nro_tarjeta = v_nro_tarjeta;
            v_exi_cta := TRUE;
         EXCEPTION
            WHEN OTHERS THEN
               v_exi_cta := FALSE;
         END;
         --luego busca por el nro de la cuenta
         IF NOT v_exi_cta THEN
            v_nro_cta_tarjeta := v_nro_tarjeta; -- en este caso se esta enviado el numero de la cuenta directamente en la variable de nro de tarjeta
            BEGIN
               SELECT nro_tarjeta
                 INTO v_nro_tarjeta
                 FROM ta_tarjetas
                WHERE nro_cuenta = v_nro_cta_tarjeta
                  AND rownum = 1;
               v_exi_cta := TRUE;
            EXCEPTION
               WHEN no_data_found THEN
                  v_exi_cta := FALSE;
            END;
         END IF;
      END IF;

      --si todavia no encontro la cuenta o tarjeta devuelve un error
      IF NOT v_exi_cta THEN
         pr_mensajeUsuario(c_msg_tar_no_enc, v_retorno.nombreRespuesta,
                           v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, NULL,
                             ' fu_pagoTarjetaCredito-' || c_msg_tar_no_enc || ' ' ||
                              fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);

         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

         RETURN v_retorno;
      END IF;

      -- El monto a pagar debe ser mayor a cero
      IF v_imp_debito <= 0 THEN
         pr_mensajeUsuario(c_msg_mto_invalido, v_retorno.nombreRespuesta,
                           v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, NULL,
                             ' fu_pagoTarjetaCredito-' || c_msg_tar_no_enc || ' ' ||
                              fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);
         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

         RETURN v_retorno;
      END IF;
      -- 2. busco los datos de la cuentas
      IF v_retorno.error = 'N' THEN
         BEGIN
            SELECT a.nro_cuenta,
                   c.nro_tarjeta,
                   c.nom_embozar,
                   d.descripcion,
                   a.cod_moneda,
                   decode(nvl(a.sal_pag_minimo, 0), 0, nvl(a.mto_mora, 0), nvl(a.sal_pag_minimo, 0)),
                   a.sal_ult_extracto,
                   (nvl(a.sal_facturar, 0) + nvl(a.sal_facturado, 0) + nvl(a.sal_financiado, 0) +
                   nvl(a.sal_cuo_pendientes, 0)),
                   a.fec_ult_cierre,
                   a.cod_modulo,
                   a.cod_modalidad,
                   a.cod_oficina,
                   q.estado,
                   a.lin_credito,
                   a.dia_mora
              INTO v_nro_cuenta,
                   v_nro_tarjeta,
                   v_embozado,
                   v_tip_tarjeta,
                   v_cod_moneda,
                   v_mto_pag_minimo,
                   v_deu_ult_cierre,
                   v_deu_actual,
                   v_fec_ult_cierre,
                   v_cod_mod_cta,
                   v_cod_mad_cta,
                   v_cod_ofi_cta,
                   v_est_cuenta,
                   v_lin_credito,
                   v_dia_mora
              FROM ge_modalidades  d,
                   ta_tarjetas     c,
                   ge_cta_clientes b,
                   ta_cta_tarjetas a,
                   ge_cuentas      q
             WHERE a.nro_cuenta = v_nro_cta_tarjeta
               AND a.nro_cuenta = b.nro_cuenta
               AND b.relacion = 'P'
               AND c.nro_tarjeta = v_nro_tarjeta
               AND c.nro_cuenta = b.nro_cuenta
               AND d.cod_modulo = a.cod_modulo
               AND d.cod_modalidad = a.cod_modalidad
               AND q.nro_cuenta = b.nro_cuenta;
         EXCEPTION
            WHEN no_data_found THEN
               pr_mensajeUsuario(c_cod_cta_inexistente, v_retorno.nombreRespuesta,
                                 v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                                   NULL,
                                   ' fu_pagoTarjetaCredito-' || c_cod_cta_inexistente || ' ' ||
                                    fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                       v_retorno.descripcionRespuesta, NULL),
                                   bitacora_error);

               \* Obtiene la informacion de parametros recibos y el return del type *\
               paw_log.g_typ_pagoTarjetaCredito := v_retorno;
               paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
               'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
               p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
               p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
               p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

               RETURN v_retorno;
         END;

         --controla el pago minimo
         IF nvl(v_imp_debito, 0) < nvl(v_mto_pag_minimo, 0) THEN
            pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                              v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, NULL,
                                ' fu_pagoTarjetaCredito-' || c_cod_mto_invalido || ' ' ||
                                 fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                    v_retorno.descripcionRespuesta, NULL),
                                bitacora_error);

            \* Obtiene la informacion de parametros recibos y el return del type *\
            paw_log.g_typ_pagoTarjetaCredito := v_retorno;
            paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
            'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
            p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
            p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
            p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

            RETURN v_retorno;
         END IF;

         -- Controla que la Cuenta no haya pasado a vencida
         BEGIN
            SELECT 'S'
              INTO v_es_ope_vencida
              FROM ov_cta_vencidas b
             WHERE b.nro_cta_origen = v_nro_cta_tarjeta;
            IF nvl(v_es_ope_vencida, 'N') = 'S' THEN
               pr_mensajeUsuario(c_cod_cta_invalida, v_retorno.nombreRespuesta,
                                 v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                                   NULL,
                                   ' fu_pagoTarjetaCredito-' || c_cod_cta_invalida || ' ' ||
                                    fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                       v_retorno.descripcionRespuesta, NULL),
                                   bitacora_error);
               \* Obtiene la informacion de parametros recibos y el return del type *\
               paw_log.g_typ_pagoTarjetaCredito := v_retorno;
               paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
               'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
               p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
               p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
               p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

               RETURN v_retorno;
            END IF;
         EXCEPTION
            WHEN no_data_found THEN
               v_es_ope_vencida := NULL;
            WHEN OTHERS THEN
               NULL; --por exception no hacer nada, solo importa si encuenta el registro
         END;
         --
      END IF;
      IF v_est_cuenta = 'C' THEN
         pr_mensajeUsuario(c_cod_cta_cancelada, v_retorno.nombreRespuesta,
                           v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, NULL,
                             ' fu_pagoTarjetaCredito-' || c_cod_cta_cancelada || ' ' ||
                              fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta, NULL),
                             bitacora_error);

         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

         RETURN v_retorno;
      END IF;
      IF v_retorno.error = 'N' THEN
         -- todo ok, se arma el mensaje de respuesta
         IF v_modo = 'S' THEN
            -- seleccion de datos
            -- busco las cuentas de debito
            -- En lugar de llamar en modo S se debe llamar antes a fu_obtenerDetalleCuentas
            NULL;
         ELSIF v_modo IN ('V', 'C', 'A') THEN
            -- validacion o confirmacion O AUTORIZACION
            -- esta la cuenta en condiciones, verifico el horario del deposito

            v_ret_horario := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                            v_mensajeCaja.fechaUltimoCierre,
                                            v_mensajeCaja.codigoOficinaOrigen, v_fec_actual,
                                            v_mensajeCaja.fechacierre, v_fec_valor);

            IF v_ret_horario.error = 'S' THEN
               v_retorno.error                := v_ret_horario.error;
               v_retorno.nombreRespuesta      := v_ret_horario.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_ret_horario.descripcionRespuesta;
               pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                                   userinfo.codigoEmpresa,
                                   'lp_ver_horario - Nro. Tarjeta: ' || v_nro_tarjeta || ' - ' ||
                                    fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                       v_retorno.descripcionRespuesta, NULL),
                                   bitacora_error);

               \* Obtiene la informacion de parametros recibos y el return del type *\
               paw_log.g_typ_pagoTarjetaCredito := v_retorno;
               paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
               'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
               p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
               p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
               p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

               RETURN v_retorno;
            END IF;

            IF nvl(v_modo, 'x') <> 'A' THEN
               -- verifico la validez de los montos
               BEGIN
                  v_nro_sobre     := depurarNumerico(p_nrosobre, 10);
                  v_imp_efectivo  := depurarNumerico(p_importeefectivo, 18); -- efectivo
                  v_imp_che_n_bco := depurarNumerico(p_importechequebanco, 18); -- che.ntro.bco
                  v_imp_che_o_bco := depurarNumerico(p_importechequeotrobanco, 18); -- che otros bcos.
                  v_tot_pago      := depurarNumerico(p_totalpago, 18); -- total
                  IF v_cod_moneda = v_cod_mon_local THEN
                     IF v_imp_efectivo <> trunc(v_imp_efectivo) OR
                        v_imp_che_n_bco <> trunc(v_imp_che_n_bco) OR
                        v_imp_che_o_bco <> trunc(v_imp_che_o_bco) OR
                        v_imp_debito <> trunc(v_imp_debito) THEN
                        -- monto con decimales y en guaranies no permite
                        pr_mensajeUsuario(c_mon_sin_decimal, v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                            v_tip_mensaje, NULL,
                                            ' fu_pagoTarjetaCredito-' || c_mon_sin_decimal || ' ' ||
                                             fu_generarBitacora(v_retorno.error,
                                                                v_retorno.nombreRespuesta,
                                                                v_retorno.descripcionRespuesta, NULL),
                                            bitacora_error);
                         \* Obtiene la informacion de parametros recibos y el return del type *\
                         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
                         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                        RETURN v_retorno;
                     ELSIF nvl(v_imp_efectivo, 0) + nvl(v_imp_che_n_bco, 0) +
                           nvl(v_imp_che_o_bco, 0) + nvl(v_imp_debito, 0) <> nvl(v_tot_pago, 0) THEN
                        -- total depositado invalido
                        pr_mensajeUsuario(c_cod_tot_invalido, v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                            v_tip_mensaje, NULL,
                                            ' fu_pagoTarjetaCredito-' || c_cod_tot_invalido || ' ' ||
                                             fu_generarBitacora(v_retorno.error,
                                                                v_retorno.nombreRespuesta,
                                                                v_retorno.descripcionRespuesta, NULL),
                                            bitacora_error);

                         \* Obtiene la informacion de parametros recibos y el return del type *\
                         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
                         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                        RETURN v_retorno;
                     END IF;
                  END IF;
               EXCEPTION
                  WHEN OTHERS THEN
                     -- monto invalido
                     pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                       v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                         v_tip_mensaje, NULL,
                                         ' fu_pagoTarjetaCredito-' || c_cod_mto_invalido || ' ' ||
                                          fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta, NULL),
                                         bitacora_error);

                      \* Obtiene la informacion de parametros recibos y el return del type *\
                      paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                      paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                      'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
                      p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                      p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                      p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                     RETURN v_retorno;
               END;

            ELSE
               -- en p_modo a, se carga directamente los datos
               v_nro_sobre     := 0;
               v_imp_efectivo  := 0;
               v_imp_che_n_bco := 0;
               v_imp_che_o_bco := 0;
               v_tot_pago      := v_imp_debito;
            END IF;
            IF v_retorno.error = 'N' THEN
               --

               IF v_nro_cta_debito IS NOT NULL THEN
                  -- tengo q buscar la moneda de la cuenta para hacer la conversion y no uso pr_val_cta_debito
                  -- porq la validacion se tiene que hacer despues de la conversion
                  BEGIN
                     SELECT cod_moneda
                       INTO v_cod_mon_debito
                       FROM ge_cuentas
                      WHERE nro_cuenta = v_nro_cta_debito;

                  EXCEPTION
                     WHEN no_data_found THEN
                        v_cod_mon_debito := NULL;
                     WHEN OTHERS THEN
                        pr_mensajeUsuario(c_cod_cta_inexistente, v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                            v_tip_mensaje, NULL,
                                            ' fu_pagoTarjetaCredito-' || c_cod_cta_inexistente || ' ' ||
                                             fu_generarBitacora(v_retorno.error,
                                                                v_retorno.nombreRespuesta,
                                                                v_retorno.descripcionRespuesta, NULL),
                                            bitacora_error);
                         \* Obtiene la informacion de parametros recibos y el return del type *\
                         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
                         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);


                        RETURN v_retorno;
                  END;
                  IF v_cod_moneda <> v_cod_mon_debito THEN
                     -- moneda diferentes
                     IF v_cod_moneda <> v_cod_mon_local AND v_cod_mon_debito <> v_cod_mon_local THEN
                        -- valida que por lo menos una moneda sea Guaranies
                        pr_mensajeUsuario(c_cod_tra_invalida, v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                            v_tip_mensaje, NULL,
                                            ' fu_pagoTarjetaCredito-' || c_cod_tra_invalida || ' ' ||
                                             fu_generarBitacora(v_retorno.error,
                                                                v_retorno.nombreRespuesta,
                                                                v_retorno.descripcionRespuesta, NULL),
                                            bitacora_error);

                         \* Obtiene la informacion de parametros recibos y el return del type *\
                         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
                         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                        RETURN v_retorno;
                     ELSE
                        -- se hace la conversion
                        --if nvl(v_modo,'x') <> 'A' then
                        -- valido el contrato de cambio si tiene uno
                        IF v_retorno.error = 'N' AND nvl(v_nro_contrato, 0) > 0 THEN
                           -- le asigno v_cotizacion a las 2 variables porque al hacer la conversion con lp_con_mon_a_moneda
                           -- una de las variables si o si devuelve como 1 dependiendo de la moneda de la tarjeta y la cta de debito
                           v_cot_tarjeta := v_cotizacion;
                           v_cot_imp_deb := v_cotizacion;
                        END IF;
                        BEGIN
                           lp_con_mon_a_moneda(v_cod_moneda, v_cod_mon_debito, v_imp_debito,
                                                --monto origen        v_monto_de_la_tarjeta
                                               v_imp_deb_cotizado,
                                                --monto destino       v_monto_cotizado_a_debitar
                                               v_cot_tarjeta,
                                                --cotizacion origen   de la tarjeta
                                               v_cot_imp_deb, 'S'); --cotizacion destino  del importe a debitar
                        EXCEPTION
                           WHEN OTHERS THEN
                              pr_mensajeUsuario(c_tra_err_conversion, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, v_retorno.error);
                              pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                                  v_tip_mensaje, NULL,
                                                  ' fu_pagoTarjetaCredito-' || c_tra_err_conversion || ' ' ||
                                                   fu_generarBitacora(v_retorno.error,
                                                                      v_retorno.nombreRespuesta,
                                                                      v_retorno.descripcionRespuesta,
                                                                      NULL), bitacora_error);

                            \* Obtiene la informacion de parametros recibos y el return del type *\
                            paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                            paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                            'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
                            p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                            p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                            p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);
                            RETURN v_retorno;
                        END;
                        lp_val_con_cambio('V', v_nro_contrato, v_cod_mon_debito, v_cod_moneda,
                                          v_nro_cta_debito, v_nro_cta_tarjeta, v_cotizacion,
                                          v_imp_deb_cotizado, v_men_con_cam);
                        IF v_cod_moneda <> v_cod_mon_local THEN
                           v_cotizacion := v_cot_tarjeta;
                        ELSE
                           v_cotizacion := v_cot_imp_deb;
                        END IF;
                     END IF;
                  ELSE
                     -- si ambas cuentas son de la misma moneda no debe haber contrato de cotizacion
                     IF nvl(v_nro_contrato, 0) > 0 THEN
                        pr_mensajeUsuario(c_con_cam_invalido, v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                            v_tip_mensaje, NULL,
                                            ' fu_pagoTarjetaCredito-' || c_con_cam_invalido || ' ' ||
                                             fu_generarBitacora(v_retorno.error,
                                                                v_retorno.nombreRespuesta,
                                                                v_retorno.descripcionRespuesta, NULL),
                                            bitacora_error);

                         \* Obtiene la informacion de parametros recibos y el return del type *\
                         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
                         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                        RETURN v_retorno;
                     END IF;
                     v_imp_deb_cotizado := v_imp_debito;
                     v_cotizacion       := nvl(v_cotizacion, 1);
                  END IF;

                  v_ret_mensaje := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre,
                                                     v_imp_deb_cotizado, v_cod_mon_debito,
                                                     v_cod_mod_debito, v_cod_mad_debito,
                                                     v_cod_ofi_debito, v_cta_for_debito,
                                                     v_nom_cta_debito, userinfo, v_mensajeCaja);

                  if v_ret_mensaje.error = 'S' then
                    v_retorno.error := v_ret_mensaje.error;
                    v_retorno.nombreRespuesta := v_ret_mensaje.nombreRespuesta;
                    v_retorno.descripcionRespuesta := v_ret_mensaje.descripcionRespuesta;
                    pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, userinfo.codigoEmpresa, 'cuenta Debito:'||v_nro_cta_debito||' modo:'||v_modo||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);

                    paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                    paw_log.pr_logValoresTypes('typ_pagotarjetacredito',
                    'PagoTarjetaCredito '||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
                    p_totalpago||', '||p_modo );
                    return v_retorno;
                  end if;

                  IF  v_clavetransaccional IS NOT NULL THEN
                           v_lugar       := 'lf_obt_cla_validar: ';
                           v_ret_mensaje := lf_obt_cla_validar(v_claveTransaccional,userinfo.codigoPersona,userinfo.codigoEmpresa, 'T');

                        IF v_ret_mensaje.error = 'S' THEN
                           v_retorno.error                := v_ret_mensaje.error;
                           v_retorno.nombreRespuesta      := v_ret_mensaje.nombreRespuesta;
                           v_retorno.descripcionRespuesta := v_ret_mensaje.descripcionRespuesta;
                           pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, v_sesion,v_tip_mensaje, userinfo.codigoEmpresa,
                                               v_lugar || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,NULL), bitacora_error);
                            \* Obtiene la informacion de parametros recibos y el return del type *\
                            paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                            paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                            'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codcanal||', '||  p_nrotarjetacredito||', '||
                            p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                            p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                            p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                         RETURN v_retorno;
                        END IF;
                  END IF;

                  IF v_modo = 'C' AND nvl(v_permiso.autorizacionesRequeridas, 0) = 0 THEN
                     -- se vuelve a verificar para el caso de personas fisicas, ya que pr_val_cta_debito, cambia a cero la variable cant_aut_requerida. 02/09/2011.
                     v_modo := 'A'; -- CONFIRMACION
                  END IF;

                  --Monto de la Tarjeta--
                  IF ((v_cod_moneda = v_cod_mon_local) AND (v_imp_debito <> trunc(v_imp_debito))) THEN
                     pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                       v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                         v_tip_mensaje, NULL,
                                         ' fu_pagoTarjetaCredito-' || c_cod_mto_invalido || ' ' ||
                                          fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta, NULL),
                                         bitacora_error);

                     \* Obtiene la informacion de parametros recibos y el return del type *\
                     paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                     paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                     'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                     p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                     p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                     p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                     RETURN v_retorno;
                  END IF;
                  --Monto de Cta de Debito--
                  IF ((v_cod_mon_debito = v_cod_mon_local) AND
                     (v_imp_deb_cotizado <> trunc(v_imp_deb_cotizado))) THEN
                     pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                       v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                         v_tip_mensaje, NULL,
                                         ' fu_pagoTarjetaCredito-' || c_cod_mto_invalido || ' ' ||
                                          fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta, NULL),
                                         bitacora_error);

                     \* Obtiene la informacion de parametros recibos y el return del type *\
                     paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                     paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                     'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                     p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                     p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                     p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                     RETURN v_retorno;
                  END IF;

                  IF v_es_tercero = 'N' AND v_cod_canal IN ('993', '994') AND
                     fu_es_ope_limitadas('032', v_nro_cta_debito, v_cod_canal, v_fec_actual) = 'S' AND
                     v_retorno.error = 'N' THEN
                     IF v_cod_moneda = v_cod_mon_fuerte THEN
                        v_mto_lim_canal := v_imp_debito;

                     END IF;

                     IF fu_val_monto(v_mto_lim_canal, v_cod_mon_fuerte, '032', v_nro_cta_debito,
                                     v_cod_canal, v_fec_actual) = 'N' THEN
                        pr_mensajeUsuario(c_cod_lim_excedido, v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                            v_tip_mensaje, NULL,
                                            ' fu_pagoTarjetaCredito-' || c_cod_lim_excedido || ' ' ||
                                             fu_generarBitacora(v_retorno.error,
                                                                v_retorno.nombreRespuesta,
                                                                v_retorno.descripcionRespuesta, NULL),
                                            bitacora_error, v_nro_telefono, '-36', NULL, NULL,
                                            v_nro_cta_debito, v_nro_cta_tarjeta, v_mto_lim_canal,
                                            v_cod_mon_fuerte);

                         \* Obtiene la informacion de parametros recibos y el return del type *\
                         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                        RETURN v_retorno;
                     ELSIF v_modo = 'A' THEN
                        pr_gen_monto('032', v_mto_lim_canal, v_cod_mon_fuerte, v_nro_cta_debito,
                                     v_fec_actual, v_cod_canal);
                     END IF;

                  END IF;

                  -- Verifico el limite por Canal. SDC

                  IF v_es_tercero = 'S' AND v_cod_canal IN ('993', '994') AND
                     fu_es_ope_limitadas('220', v_nro_cta_debito, v_cod_canal, v_fec_actual) = 'S' AND
                     v_retorno.error = 'N' THEN
                     IF v_cod_moneda = v_cod_mon_fuerte THEN
                        v_mto_lim_canal := v_imp_debito;
                     ELSE
                        BEGIN
                           lp_con_mon_a_moneda(v_cod_moneda, v_cod_mon_fuerte, v_imp_debito,
                                               v_mto_lim_canal, v_cot_lim_ori, v_cot_lim_des);
                        EXCEPTION
                           WHEN OTHERS THEN
                              pr_mensajeUsuario(c_tra_err_conversion, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, v_retorno.error);
                              pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                                  v_tip_mensaje, NULL,
                                                  ' fu_pagoTarjetaCredito-' || c_tra_err_conversion || ' ' ||
                                                   fu_generarBitacora(v_retorno.error,
                                                                      v_retorno.nombreRespuesta,
                                                                      v_retorno.descripcionRespuesta,
                                                                      NULL), bitacora_error);

                               \* Obtiene la informacion de parametros recibos y el return del type *\
                               paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                               paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                               'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                               p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                               p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                               p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                              RETURN v_retorno;
                        END;
                     END IF;

                     IF fu_val_monto(v_mto_lim_canal, v_cod_mon_fuerte, '220', v_nro_cta_debito,
                                     v_cod_canal, v_fec_actual) = 'N' THEN
                        pr_mensajeUsuario(c_cod_lim_excedido, v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, '220',
                                            NULL,
                                            ' fu_pagoTarjetaCredito-' || c_cod_lim_excedido || ' ' ||
                                             fu_generarBitacora(v_retorno.error,
                                                                v_retorno.nombreRespuesta,
                                                                v_retorno.descripcionRespuesta, NULL),
                                            bitacora_error, v_nro_telefono, '-36', NULL, NULL,
                                            v_nro_cta_debito, v_nro_cta_tarjeta, v_mto_lim_canal,
                                            v_cod_mon_fuerte);

                         \* Obtiene la informacion de parametros recibos y el return del type *\
                         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                        RETURN v_retorno;
                     ELSIF v_modo = 'A' THEN
                        pr_gen_monto('220', v_mto_lim_canal, v_cod_mon_fuerte, v_nro_cta_debito,
                                     v_fec_actual, v_cod_canal);
                     END IF;
                  END IF;
                  --
               END IF;

               IF (v_cod_canal = c_cod_homebanking AND nvl(v_nro_cta_debito, '0') = '0') OR
                  (nvl(v_tot_pago, 0) = 0 AND v_cod_canal NOT IN ('993', '994')) THEN
                  pr_mensajeUsuario(c_cod_tra_invalida, v_retorno.nombreRespuesta,
                                    v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                                      NULL,
                                      ' fu_pagoTarjetaCredito-' || c_cod_tra_invalida || ' ' ||
                                       fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                          v_retorno.descripcionRespuesta, NULL),
                                      bitacora_error);

                   \* Obtiene la informacion de parametros recibos y el return del type *\
                   paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                   paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                   'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                   p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                   p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                   p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                  RETURN v_retorno;
               ELSIF nvl(v_tot_pago, 0) = 0 AND v_cod_canal = '993' THEN
                  \* En RM el cliente puede selecciona pago minimo o deuda total y estas pueden ser
                  cero, la solucion temporal fue mostrar un msj mas explicito*\
                  pr_mensajeUsuario(c_cod_mto_no_existe, v_retorno.nombreRespuesta,
                                    v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                                      NULL,
                                      ' fu_pagoTarjetaCredito-' || c_cod_mto_no_existe || ' ' ||
                                       fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                          v_retorno.descripcionRespuesta, NULL),
                                              bitacora_error);
                  \* Obtiene la informacion de parametros recibos y el return del type *\
                  paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                  paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                  'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                  p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                  p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                  p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                  RETURN v_retorno;
               END IF;
               IF v_modo = 'V' THEN
                  -- solo se valida
                  IF v_retorno.error = 'N' THEN
                     DECLARE
                        v_existe VARCHAR2(1);
                     BEGIN
                        BEGIN
                           SELECT 'S'
                             INTO v_existe
                             FROM bw_mov_pendientes
                            WHERE cod_per_principal = userinfo.codigoEmpresa
                              AND nro_cuenta = v_nro_cta_debito
                              AND monto = v_imp_deb_cotizado --v_imp_debito
                              AND estado = 'P'
                              AND cod_tip_mensaje = '032'
                              AND nro_cta_contra = v_nro_cta_tarjeta
                              AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                              AND rownum = 1;
                        EXCEPTION
                           WHEN no_data_found THEN
                              v_existe := 'N';
                           WHEN too_many_rows THEN
                              v_existe := 'S';
                           WHEN OTHERS THEN
                              v_existe := 'N';
                        END;
                        IF v_existe = 'N' THEN
                           IF v_es_mov_noc = 'S' THEN
                              SELECT 'S'
                                INTO v_existe
                                FROM ge_movimientos_noc
                               WHERE nro_cuenta = v_nro_cta_debito
                                 AND cod_tra_padre = v_cod_tra_padre
                                 AND monto = v_imp_deb_cotizado --v_imp_debito
                                 AND reversado = 'N'
                                 AND cod_usuario = v_mensajeCaja.codigoUsuario
                                 AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                                 AND rownum = 1;
                           ELSE
                              SELECT 'S'
                                INTO v_existe
                                FROM ge_movimientos
                               WHERE nro_cuenta = v_nro_cta_debito
                                 AND cod_tra_padre = v_cod_tra_padre
                                 AND monto = v_imp_deb_cotizado --v_imp_debito
                                 AND reversado = 'N'
                                 AND cod_usuario = v_mensajeCaja.codigoUsuario
                                 AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                                 AND rownum = 1;
                           END IF;
                        END IF;
                        pr_mensajeUsuario(c_mov_ya_ingresado, v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                            v_tip_mensaje, NULL,
                                            ' fu_pagoTarjetaCredito-' || c_mov_ya_ingresado || ' ' ||
                                             fu_generarBitacora(v_retorno.error,
                                                                v_retorno.nombreRespuesta,
                                                                v_retorno.descripcionRespuesta, NULL),
                                            bitacora_error);

                         \* Obtiene la informacion de parametros recibos y el return del type *\
                         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                        RETURN v_retorno;
                     EXCEPTION
                        WHEN no_data_found THEN
                           NULL;
                        WHEN too_many_rows THEN
                           pr_mensajeUsuario(c_mov_ya_ingresado, v_retorno.nombreRespuesta,
                                             v_retorno.descripcionRespuesta, v_retorno.error);
                           pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                               v_tip_mensaje, NULL,
                                               ' fu_pagoTarjetaCredito-' || c_mov_ya_ingresado || ' ' ||
                                                fu_generarBitacora(v_retorno.error,
                                                                   v_retorno.nombreRespuesta,
                                                                   v_retorno.descripcionRespuesta,
                                                                   NULL), bitacora_error);

                           \* Obtiene la informacion de parametros recibos y el return del type *\
                           paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                           paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                           'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                           p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                           p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                           p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                           RETURN v_retorno;
                     END;
                  END IF;

                  v_retorno.numerotarjeta   := v_nro_tarjeta;
                  v_retorno.nombretarjeta   := v_embozado;
                  v_retorno.codigomoneda    := v_cod_moneda;
                  v_retorno.montopagominimo := v_mto_pag_minimo;

                  IF v_cod_mon_debito <> v_cod_mon_local THEN
                     v_retorno.importedebito := v_imp_deb_cotizado;
                  ELSE
                     v_retorno.importedebito := v_imp_debito;
                  END IF;
                  v_retorno.monedadebito       := v_cod_mon_debito;
                  v_retorno.denominacioncuenta := substr(v_nom_cta_debito, 1, 50);
                  v_retorno.numerocuentadebito := v_cta_for_debito;
                  v_retorno.cotizacion         := v_cotizacion;

               ELSIF v_modo = 'C' AND v_retorno.error = 'N' THEN
                  -- grabacion en pendiente

                  -- registro del movimiento
                  paw_con.pr_reg_operacion(v_nro_cta_tarjeta \*p_nro_cuenta*\, v_cod_moneda
                                    \*p_cod_moneda *\, v_tot_pago \*p_monto*\, v_nro_cta_debito
                                    \*p_nro_cta_contra*\, NULL, 'Efectivo', v_imp_efectivo,
                                   'Cheques', v_imp_che_n_bco + v_imp_che_o_bco,
                                   'Nro.Tarj: ' || v_nro_tarjeta, NULL, NULL, NULL, v_nro_telefono);

                  IF v_imp_deb_cotizado > 0 THEN
                     --- inserto el movimiento pendiente de autorizacion
                     SELECT s_nro_documento.nextval INTO v_nro_documento FROM dual;

                     INSERT INTO bw_mov_pendientes
                        (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta,
                         cod_moneda, descripcion, monto, nro_cta_contra, etiqueta, dato, estado,
                         can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra)
                     VALUES
                        (v_nro_documento, nvl(userinfo.codigoEmpresa, userinfo.codigoPersona),
                         SYSDATE, '032', v_nro_cta_debito, v_cod_mon_debito,
                          --v_cod_moneda,
                         'Pago de Tarjetas de Credito', v_imp_deb_cotizado, v_nro_cta_tarjeta,
                         'Nro. de Tarjeta', v_nro_tarjeta, 'P', v_permiso.autorizacionesRequeridas,
                         v_can_aut_requeridas, userinfo.codigoPersona, v_imp_debito);

                     v_retorno.autorizacionesRequeridas := v_permiso.autorizacionesRequeridas;
                     v_retorno.numerodocumento     := v_nro_documento;

                     pr_mensajeUsuario(msg_ok, v_retorno.nombreRespuesta,
                                       v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                         v_tip_mensaje, NULL, ' fu_pagoTarjetaCredito-' || msg_ok,
                                         bitacora_error);

                    \* Obtiene la informacion de parametros recibos y el return del type *\
                    paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                    paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                    'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                    p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                    p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                    p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);
                    RETURN v_retorno;

                  ELSE
                     pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                       v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                         v_tip_mensaje, NULL,
                                         ' fu_pagoTarjetaCredito-' || c_cod_mto_invalido || ' ' ||
                                          fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta, NULL),
                                         bitacora_error);

                     \* Obtiene la informacion de parametros recibos y el return del type *\
                     paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                     paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                     'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                     p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                     p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                     p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                     RETURN v_retorno;
                  END IF;
               END IF;
               IF v_modo = 'V' THEN
                  -- solo se valida

                  IF v_retorno.error = 'N' THEN
                     DECLARE
                        v_existe VARCHAR2(1);
                     BEGIN
                        BEGIN
                           SELECT 'S'
                             INTO v_existe
                             FROM bw_mov_pendientes
                            WHERE cod_per_principal = userinfo.codigoEmpresa
                              AND nro_cuenta = v_nro_cta_debito
                              AND monto = v_imp_deb_cotizado --v_imp_debito
                              AND estado = 'P'
                              AND cod_tip_mensaje = '032'
                              AND nro_cta_contra = v_nro_cta_tarjeta
                              AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                              AND rownum = 1;
                        EXCEPTION
                           WHEN no_data_found THEN
                              v_existe := 'N';
                           WHEN too_many_rows THEN
                              v_existe := 'S';
                           WHEN OTHERS THEN
                              v_existe := 'N';
                        END;
                        IF v_existe = 'N' THEN
                           IF v_es_mov_noc = 'S' THEN
                              SELECT 'S'
                                INTO v_existe
                                FROM ge_movimientos_noc
                               WHERE nro_cuenta = v_nro_cta_debito
                                 AND cod_tra_padre = v_cod_tra_padre
                                 AND monto = v_imp_deb_cotizado --v_imp_debito
                                 AND reversado = 'N'
                                 AND cod_usuario = v_mensajeCaja.codigoUsuario
                                 AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                                 AND rownum = 1;
                           ELSE
                              SELECT 'S'
                                INTO v_existe
                                FROM ge_movimientos
                               WHERE nro_cuenta = v_nro_cta_debito
                                 AND cod_tra_padre = v_cod_tra_padre
                                 AND monto = v_imp_deb_cotizado -- v_imp_debito
                                 AND reversado = 'N'
                                 AND cod_usuario = v_mensajeCaja.codigoUsuario
                                 AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                                 AND rownum = 1;
                           END IF;
                        END IF;
                        pr_mensajeUsuario(c_mov_ya_ingresado, v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                            v_tip_mensaje, NULL,
                                            ' fu_pagoTarjetaCredito-' || c_mov_ya_ingresado || ' ' ||
                                             fu_generarBitacora(v_retorno.error,
                                                                v_retorno.nombreRespuesta,
                                                                v_retorno.descripcionRespuesta, NULL),
                                            bitacora_error);

                         \* Obtiene la informacion de parametros recibos y el return del type *\
                         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                        RETURN v_retorno;
                     EXCEPTION
                        WHEN no_data_found THEN
                           NULL;
                        WHEN too_many_rows THEN
                           pr_mensajeUsuario(c_mov_ya_ingresado, v_retorno.nombreRespuesta,
                                             v_retorno.descripcionRespuesta, v_retorno.error);
                           pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                               v_tip_mensaje, NULL,
                                               ' fu_pagoTarjetaCredito-' || c_mov_ya_ingresado || ' ' ||
                                                fu_generarBitacora(v_retorno.error,
                                                                   v_retorno.nombreRespuesta,
                                                                   v_retorno.descripcionRespuesta,
                                                                   NULL), bitacora_error);

                           \* Obtiene la informacion de parametros recibos y el return del type *\
                           paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                           paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                           'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                           p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                           p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                           p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                           RETURN v_retorno;
                     END;

                     v_retorno.numerotarjeta   := v_nro_tarjeta;
                     v_retorno.nombretarjeta   := v_embozado;
                     v_retorno.codigomoneda    := v_cod_moneda;
                     v_retorno.importedebito   := v_imp_debito;
                     v_retorno.monedadebito    := v_cod_mon_debito;
                     v_retorno.montopagominimo := v_mto_pag_minimo;

                  END IF;

                  pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                                      userinfo.codigoEmpresa,
                                      'pagoTarjetaCredito - |Cta.Deb.: ' || '|' || v_nro_cta_debito ||
                                       '| TC:' || v_nro_tarjeta || '| Monto:' || v_imp_debito || '|' || ' ' ||
                                       fu_generarBitacora(userinfo.error, userinfo.nombreRespuesta,
                                                          userinfo.descripcionRespuesta, NULL),
                                      bitacora_salida);

                   \* Obtiene la informacion de parametros recibos y el return del type *\
                   paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                   paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                   'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                   p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                   p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                   p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                   RETURN v_retorno;
               ELSIF v_modo = 'C' AND v_retorno.error = 'N' THEN
                  -- registro del movimiento
                  paw_con.pr_reg_operacion(v_nro_cta_tarjeta \*p_nro_cuenta*\, v_cod_moneda
                                    \*p_cod_moneda *\, v_tot_pago \*p_monto*\, v_nro_cta_debito
                                    \*p_nro_cta_contra*\, NULL, 'Efectivo', v_imp_efectivo,
                                   'Cheques', v_imp_che_n_bco + v_imp_che_o_bco,
                                   'Nro.Tarj: ' || v_nro_tarjeta, NULL, NULL, NULL, v_nro_telefono);
                  IF v_imp_debito > 0 THEN
                     --- inserto el movimiento pendiente de autorizacion
                     SELECT s_nro_documento.nextval INTO v_nro_documento FROM dual;
                     INSERT INTO bw_mov_pendientes
                        (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta,
                         cod_moneda, descripcion, monto, nro_cta_contra, etiqueta, dato, estado,
                         can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, mto_contra)
                     VALUES
                        (v_nro_documento, nvl(userinfo.codigoEmpresa, userinfo.codigoPersona),
                         SYSDATE, '032', v_nro_cta_debito, v_cod_moneda,
                         'Pago de Tarjetas de Credito', v_imp_debito, v_nro_cta_tarjeta,
                         'Nro. de Tarjeta', v_nro_tarjeta, 'P', v_can_aut_requeridas,
                         v_can_aut_requeridas, userinfo.codigoPersona, v_imp_debito);

                     v_retorno.autorizacionesRequeridas := v_permiso.autorizacionesRequeridas;
                     v_retorno.numeroDocumento  := v_nro_documento;

                     pr_mensajeUsuario(msg_ok, v_retorno.nombreRespuesta,
                                       v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                         v_tip_mensaje, NULL, ' fu_pagoTarjetaCredito-' || msg_ok,
                                         bitacora_error);

                     \* Obtiene la informacion de parametros recibos y el return del type *\
                     paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                     paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                     'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                     p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                     p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                     p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                     RETURN v_retorno;

                  ELSE
                     pr_mensajeUsuario(c_cod_mto_invalido, v_retorno.nombreRespuesta,
                                       v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                         v_tip_mensaje, NULL,
                                         ' fu_pagoTarjetaCredito-' || c_cod_mto_invalido || ' ' ||
                                          fu_generarBitacora(v_retorno.error,
                                                             v_retorno.nombreRespuesta,
                                                             v_retorno.descripcionRespuesta, NULL),
                                         bitacora_error);

                    \* Obtiene la informacion de parametros recibos y el return del type *\
                    paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                    paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                    'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                    p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                    p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                    p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                    RETURN v_retorno;
                  END IF;
               END IF;

               --- ESTO PARA CONFIRMACION  cuando es el modo 'A' ----
               IF v_retorno.error = 'N' THEN
                  -- registro del movimiento
                   paw_con.pr_reg_operacion(v_nro_cta_tarjeta \*p_nro_cuenta*\, v_cod_moneda
                                    \*p_cod_moneda *\, v_tot_pago \*p_monto*\, v_nro_cta_debito
                                    \*p_nro_cta_contra*\, NULL, 'Efectivo', v_imp_efectivo,
                                   'Cheques', v_imp_che_n_bco + v_imp_che_o_bco,
                                   'Nro.Tarj: ' || v_nro_tarjeta, NULL, NULL, NULL, v_nro_telefono);
                  -- sigue sin problemas hasta aqui, ya puedo grabar
                  IF v_imp_efectivo > 0 THEN
                     -- importe en efectivo
                     v_cod_tra_padre   := 250;
                     v_cod_transaccion := 613;
                     -- obtengo el codigo y fin de retencion
                     pag_cta.pr_obt_retencion(v_fec_actual, v_nro_cuenta, v_cod_mod_cta,
                                              v_cod_mad_cta, v_cod_transaccion, v_cod_moneda,
                                              v_cod_retencion, v_fec_fin_retencion);
                     -- genero el movimiento respectivo
                     lp_ins_movimiento(v_ret_mensaje, v_nro_secuencia, userinfo, v_mensajeCaja,
                                       v_fec_actual, v_hor_actual, v_fec_valor, v_cod_mod_cta,
                                       v_cod_mad_cta, v_cod_ofi_cta, v_nro_cuenta, v_cod_moneda,
                                       v_cod_tra_padre, v_cod_transaccion, v_nro_sobre,
                                       v_imp_efectivo, 'E',
                                        -- EFECTIVO
                                       v_es_mov_noc, v_cod_retencion, v_fec_fin_retencion);
                  END IF;
                  IF v_imp_che_n_bco > 0 THEN
                     -- importe en cheques ntro banco
                     v_cod_tra_padre   := 250;
                     v_cod_transaccion := 614;
                     -- obtengo el codigo y fin de retencion
                     pag_cta.pr_obt_retencion(v_fec_actual, v_nro_cuenta, v_cod_mod_cta,
                                              v_cod_mad_cta, v_cod_transaccion, v_cod_moneda,
                                              v_cod_retencion, v_fec_fin_retencion);
                     -- genero el movimiento respectivo
                     lp_ins_movimiento(v_ret_mensaje, v_nro_secuencia, userinfo, v_mensajeCaja,
                                       v_fec_actual, v_hor_actual, v_fec_valor, v_cod_mod_cta,
                                       v_cod_mad_cta, v_cod_ofi_cta, v_nro_cuenta, v_cod_moneda,
                                       v_cod_tra_padre, v_cod_transaccion, v_nro_sobre,
                                       v_imp_che_n_bco, 'C',
                                        -- cheque ntro bco
                                       v_es_mov_noc, v_cod_retencion, v_fec_fin_retencion);
                  END IF;
                  IF v_imp_che_o_bco > 0 THEN
                     -- importe en cheques otros bancos
                     v_cod_tra_padre   := 250;
                     v_cod_transaccion := 615;
                     -- obtengo el codigo y fin de retencion
                     pag_cta.pr_obt_retencion(v_fec_actual, v_nro_cuenta, v_cod_mod_cta,
                                              v_cod_mad_cta, v_cod_transaccion, v_cod_moneda,
                                              v_cod_retencion, v_fec_fin_retencion);
                     -- genero el movimiento respectivo
                     lp_ins_movimiento(v_ret_mensaje, v_nro_secuencia, userinfo, v_mensajeCaja,
                                       v_fec_actual, v_hor_actual, v_fec_valor, v_cod_mod_cta,
                                       v_cod_mad_cta, v_cod_ofi_cta, v_nro_cuenta, v_cod_moneda,
                                       v_cod_tra_padre, v_cod_transaccion, v_nro_sobre,
                                       v_imp_che_o_bco, 'O',
                                        -- cheque otros bcos
                                       v_es_mov_noc, v_cod_retencion, v_fec_fin_retencion);
                  END IF;
                  IF nvl(v_imp_efectivo, 0) + nvl(v_imp_che_n_bco, 0) + nvl(v_imp_che_o_bco, 0) > 0 THEN
                     -- actualizo el control de caja
                     UPDATE cj_controles
                        SET tot_che_nue_bco = nvl(tot_che_nue_bco, 0) + nvl(v_imp_che_n_bco, 0),
                            sal_actual      = nvl(sal_actual, 0) + nvl(v_imp_efectivo, 0),
                            tot_debitos     = nvl(tot_debitos, 0) + nvl(v_imp_efectivo, 0),
                            can_debitos     = nvl(can_debitos, 0) + decode(v_imp_efectivo, 0, 0, 1),
                            tot_che_otr_bco = nvl(tot_che_otr_bco, 0) + nvl(v_imp_che_o_bco, 0),
                            sal_che_otr_bco = nvl(sal_che_otr_bco, 0) + nvl(v_imp_che_o_bco, 0),
                            estado          = 1 -- abierto
                      WHERE nro_caja = to_number(v_cod_canal)
                        AND cod_moneda = v_cod_moneda
                        AND fecha = v_fec_actual;
                     IF SQL%NOTFOUND THEN
                        INSERT INTO cj_controles
                           (nro_caja, cod_moneda, fecha, estado, mto_apertura, ini_che_otr_bco,
                            cod_usu_actual, tot_che_nue_bco, sal_actual, tot_debitos, can_debitos,
                            tot_che_otr_bco, sal_che_otr_bco)
                           SELECT v_cod_canal,
                                  v_cod_moneda,
                                  v_fec_actual,
                                  1,
                                  0,
                                  0,
                                  v_mensajeCaja.codigoUsuario,
                                  v_imp_che_n_bco,
                                  v_imp_efectivo,
                                  v_imp_efectivo,
                                  decode(v_imp_efectivo, 0, 0, 1),
                                  v_imp_che_o_bco,
                                  v_imp_che_o_bco
                             FROM dual;
                     END IF;
                  END IF;

                  IF v_imp_deb_cotizado > 0 THEN
                     -- verifico sino hay pagos con el mismo monto
                     DECLARE
                        v_existe VARCHAR2(1);
                     BEGIN
                        IF v_es_mov_noc = 'S' THEN
                           SELECT 'S'
                             INTO v_existe
                             FROM ge_movimientos_noc
                            WHERE nro_cuenta = v_nro_cta_debito
                              AND cod_tra_padre = v_cod_tra_padre
                              AND monto = v_imp_deb_cotizado
                              AND reversado = 'N'
                              AND cod_usuario = v_mensajeCaja.codigoUsuario
                              AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                              AND rownum = 1;
                        ELSE
                           SELECT 'S'
                             INTO v_existe
                             FROM ge_movimientos
                            WHERE nro_cuenta = v_nro_cta_debito
                              AND cod_tra_padre = v_cod_tra_padre
                              AND monto = v_imp_deb_cotizado
                              AND reversado = 'N'
                              AND cod_usuario = v_mensajeCaja.codigoUsuario
                              AND ((SYSDATE) - fec_insercion) * 24 * 60 <= 10
                              AND rownum = 1;
                        END IF;
                        pr_mensajeUsuario(c_mov_ya_ingresado, v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                            v_tip_mensaje, NULL,
                                            ' fu_pagoTarjetaCredito-' || c_mov_ya_ingresado || ' ' ||
                                             fu_generarBitacora(v_retorno.error,
                                                                v_retorno.nombreRespuesta,
                                                                v_retorno.descripcionRespuesta, NULL),
                                            bitacora_error);

                        \* Obtiene la informacion de parametros recibos y el return del type *\
                        paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                        paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                        'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                        p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                        p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                        p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);
                        RETURN v_retorno;
                     EXCEPTION
                        WHEN no_data_found THEN
                           NULL;
                        WHEN too_many_rows THEN
                           pr_mensajeUsuario(c_mov_ya_ingresado, v_retorno.nombreRespuesta,
                                             v_retorno.descripcionRespuesta, v_retorno.error);
                           pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                               v_tip_mensaje, NULL,
                                               ' fu_pagoTarjetaCredito-' || c_mov_ya_ingresado || ' ' ||
                                                fu_generarBitacora(v_retorno.error,
                                                                   v_retorno.nombreRespuesta,
                                                                   v_retorno.descripcionRespuesta,
                                                                   NULL), bitacora_error);

                           \* Obtiene la informacion de parametros recibos y el return del type *\
                           paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                           paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                           'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                           p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                           p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                           p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                           RETURN v_retorno;
                     END;

                     -- genero el numero de operacion
                     SELECT s_nro_operacion.nextval INTO v_nro_operacion FROM dual;

                     IF v_retorno.error = 'N' THEN
                        -- genero el movimiento respectivo
                        lp_ins_movimiento(v_ret_mensaje, v_nro_secuencia, userinfo, v_mensajeCaja,
                                          v_fec_actual, v_hor_actual, v_fec_valor, v_cod_mod_cta,
                                          v_cod_mad_cta, v_cod_ofi_cta, v_nro_cuenta, v_cod_moneda,
                                          v_cod_tra_padre, 978, v_nro_operacion, v_imp_debito,
                                           --v_imp_deb_cotizado
                                          'N',
                                           -- no afecta a caja,es debito
                                          v_es_mov_noc, NULL, NULL, 'Debito en Tarjeta por TAS/HB',
                                          v_cotizacion, 5, 51);
                        BEGIN
                           SELECT cod_moneda
                             INTO v_cod_mon_debito
                             FROM ge_cuentas
                            WHERE nro_cuenta = v_nro_cta_debito;
                        EXCEPTION
                           WHEN no_data_found THEN
                              v_cod_mon_debito := NULL;
                           WHEN OTHERS THEN
                              pr_mensajeUsuario(c_cod_cta_inexistente, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, v_retorno.error);
                              pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                                  v_tip_mensaje, NULL,
                                                  ' fu_pagoTarjetaCredito-' ||
                                                   c_cod_cta_inexistente || ' ' ||
                                                   fu_generarBitacora(v_retorno.error,
                                                                      v_retorno.nombreRespuesta,
                                                                      v_retorno.descripcionRespuesta,
                                                                      NULL), bitacora_error);

                              \* Obtiene la informacion de parametros recibos y el return del type *\
                              paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                              paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                              'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                              p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                              p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                              p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                              RETURN v_retorno;
                        END;
                     END IF;

                     IF v_retorno.error = 'N' THEN
                        -- seteo las variables para el debito
                        pag_cta.pr_set_variables(v_mensajeCaja.codigoUsuario, v_fec_valor,
                                                 v_cod_tra_padre, 'N', 'N', v_nro_secuencia, NULL,
                                                 v_mensajeCaja.codigoOficinaOrigen, 5, 51);
                        -- esta la cuenta en condiciones, verifico el horario
                        -- realizo el debito respectivo
                        IF v_cod_moneda <> v_cod_mon_debito THEN
                           v_mto_equivalente := v_imp_debito;
                        ELSE
                           v_mto_equivalente := NULL;
                           v_cotizacion      := NULL;
                        END IF;

                        pag_cta.pr_act_operacion(v_nro_cta_debito, v_hor_actual, 'D',
                                                 v_cod_mon_debito, v_imp_deb_cotizado,
                                                  --v_imp_debito,
                                                 v_cod_tra_padre, 503, v_nro_operacion, v_cotizacion,
                                                 v_mensajeCaja.codigoOficinaOrigen, 5, 51, NULL,
                                                 NULL, 'Pago de Tarjetas', 'N', v_nro_secuencia,
                                                 v_fec_valor, NULL, NULL, v_mto_equivalente);

                        IF nvl(pag_cta.g_cod_error, 0) <> 0 THEN
                           -- hubo error en el debito
                           IF instr(upper(pag_cta.g_msj_error), 'INSUFIC') > 0 THEN
                              pr_mensajeUsuario(c_msg_sal_insuficiente, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, v_retorno.error);
                              pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                                  v_tip_mensaje, NULL,
                                                  ' fu_pagoTarjetaCredito-' ||
                                                   c_msg_sal_insuficiente || ' ' ||
                                                   fu_generarBitacora(v_retorno.error,
                                                                      v_retorno.nombreRespuesta,
                                                                      v_retorno.descripcionRespuesta,
                                                                      NULL), bitacora_error);
                              ROLLBACK;
                              \* Obtiene la informacion de parametros recibos y el return del type *\
                              paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                              paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                              'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                              p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                              p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                              p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);
                              RETURN v_retorno;
                           ELSE
                              pr_mensajeUsuario(c_cod_deb_monto, v_retorno.nombreRespuesta,
                                                v_retorno.descripcionRespuesta, v_retorno.error);
                              pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                                  v_tip_mensaje, NULL,
                                                  ' fu_pagoTarjetaCredito-' || c_cod_deb_monto || ' ' ||
                                                   fu_generarBitacora(v_retorno.error,
                                                                      v_retorno.nombreRespuesta,
                                                                      v_retorno.descripcionRespuesta,
                                                                      NULL), bitacora_error);
                              ROLLBACK;

                             \* Obtiene la informacion de parametros recibos y el return del type *\
                              paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                              paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                              'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                              p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                              p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                              p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                              RETURN v_retorno;
                           END IF;
                        ELSE

                           INSERT INTO ta_cobros
                              (nro_cuenta, nro_tarjeta, nro_cta_debito, fec_proceso, monto, estado,
                               fec_valor, observacion, hora, cod_usuario, tip_envio, dia_mora, tipo)
                           VALUES
                              (v_nro_cuenta, v_nro_tarjeta, v_nro_cta_debito, v_fec_actual,
                               v_imp_debito,
                                --v_imp_deb_cotizado,
                               'P', v_fec_actual, 'Debito en Cuenta x Bca.Electronica', v_hor_actual,
                               v_mensajeCaja.codigoUsuario, 'O', v_dia_mora, 'P');

                           -- cambio el estado del contrato de cambio
                           --verifico antes para no permitir confirmar dos veces el mismo contrato
                           IF nvl(v_nro_contrato, 0) <> 0 THEN
                              BEGIN
                                 SELECT COUNT(*)
                                   INTO v_con_contrato
                                   FROM lc_con_cambios
                                  WHERE nro_contrato = v_nro_contrato
                                    AND estado = 'P';
                              EXCEPTION
                                 WHEN no_data_found THEN
                                    v_con_contrato := NULL;
                                 WHEN OTHERS THEN
                                    pr_mensajeUsuario(c_con_cam_invalido, v_retorno.nombreRespuesta,
                                                      v_retorno.descripcionRespuesta,
                                                      v_retorno.error);
                                    pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal,
                                                        v_sesion, v_tip_mensaje, NULL,
                                                        ' fu_pagoTarjetaCredito-' ||
                                                         c_con_cam_invalido || ' ' ||
                                                         fu_generarBitacora(v_retorno.error,
                                                                            v_retorno.nombreRespuesta,
                                                                            v_retorno.descripcionRespuesta,
                                                                            NULL), bitacora_error);

                                   \* Obtiene la informacion de parametros recibos y el return del type *\
                                    paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                                    paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                                    'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                                    p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                                    p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                                    p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                                    RETURN v_retorno;
                              END;
                              IF v_con_contrato = 1 THEN
                                 lp_val_con_cambio('C', v_nro_contrato, NULL, NULL, NULL, NULL,
                                                   NULL, NULL, v_men_con_cam);
                              ELSE
                                 pr_mensajeUsuario(c_con_cam_invalido, v_retorno.nombreRespuesta,
                                                   v_retorno.descripcionRespuesta, v_retorno.error);
                                 pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion,
                                                     v_tip_mensaje, NULL,
                                                     ' fu_pagoTarjetaCredito-' ||
                                                      c_con_cam_invalido || ' ' ||
                                                      fu_generarBitacora(v_retorno.error,
                                                                         v_retorno.nombreRespuesta,
                                                                         v_retorno.descripcionRespuesta,
                                                                         NULL), bitacora_error);

                                  \* Obtiene la informacion de parametros recibos y el return del type *\
                                  paw_log.g_typ_pagoTarjetaCredito := v_retorno;
                                  paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
                                  'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
                                  p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
                                  p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
                                  p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

                                 RETURN v_retorno;
                              END IF;
                           END IF;
                        END IF;
                     END IF;
                  END IF;
               END IF;
            END IF;
            IF v_retorno.error = 'N' THEN
                 -- registro del movimiento
        paw_con.pr_reg_operacion(v_nro_cta_tarjeta \*p_nro_cuenta*\,
            v_cod_moneda\*p_cod_moneda *\,
            v_tot_pago \*p_monto*\,
            v_nro_cta_debito\*p_nro_cta_contra*\,
            NULL,
            'Efectivo',
            v_imp_efectivo,
            'Cheques',
            v_imp_che_n_bco + v_imp_che_o_bco,
            'Nro.Tarj: ' || v_nro_tarjeta,
            NULL,
            NULL,
            userinfo.codigoPersona,
            v_tip_mensaje,
            v_nro_operacion,
            v_cod_canal,
            v_sesion,
            v_nro_telefono);


         pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje,
                                   userinfo.codigoEmpresa,
                                   'pagoTarjetaCredito - |Cta.Deb.: ' || '|' || v_nro_cta_debito ||
                                    '| TC:' || v_nro_tarjeta || '| Monto:' || v_imp_debito || '|' || ' ' ||
                                    fu_generarBitacora(userinfo.error, userinfo.nombreRespuesta,
                                                       userinfo.descripcionRespuesta, NULL),
                                   bitacora_salida);
               COMMIT;
              --Dato para impresion de comprobantes
              v_retorno.numeroDocumento := v_nro_operacion;

              \* Obtiene la informacion de parametros recibos y el return del type *\
              paw_log.g_typ_pagoTarjetaCredito := v_retorno;
              paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
              'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
              p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
              p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
              p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

            RETURN v_retorno;
            END IF;
         ELSE
            pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta,
                              v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, v_sesion, v_tip_mensaje,
                                userinfo.codigoEmpresa, 'pagoTarjeta. - ' || SQLERRM, bitacora_error);

            \* Obtiene la informacion de parametros recibos y el return del type *\
            paw_log.g_typ_pagoTarjetaCredito := v_retorno;
            paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
            'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
            p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
            p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
            p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

            RETURN v_retorno;
         END IF;
        RETURN v_retorno;
      END IF;
   EXCEPTION
      WHEN OTHERS THEN

         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoTarjetaCredito := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoTarjetaCredito',
         'fu_pagoTarjetaCredito'||' '||v_sesion||', '|| p_codCanal||', '||  p_nrotarjetacredito||', '||
         p_cuentadebito||', '|| p_modo||', '|| p_nrosobre||', '||
         p_importeefectivo||', '|| p_importechequebanco||', '||p_importechequeotrobanco||', '||
         p_importedebito||', '||p_totalpago||', '||p_numerocontrato||', '||p_estercero);

         pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,
                           v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codcanal, v_sesion, v_tip_mensaje,
                             userinfo.codigoEmpresa, 'pagoTarjeta. - ' || SQLERRM, bitacora_error);
         RETURN v_retorno;
   END; -- fin de la 032 - pago de tarjetas de credito*/

   /**
   * Condiciones comerciales  por cliente y cuenta
   * @Creado por: Fermin Gimenez
   * @Fecha : 17-08-2012
   */
   FUNCTION fu_obtenerCondicionComercial( p_sesion    IN VARCHAR2,
                                          p_codCanal  IN VARCHAR2,
                                          p_nroCuenta IN VARCHAR2)
                                          RETURN typ_condicionComercial IS

      v_retorno typ_condicionComercial := typ_condicionComercial;
      r_tip_listaCondiciones typ_listaCondiciones := typ_listaCondiciones();
      userinfo  typ_validarsesion;
      v_codPersona VARCHAR2(15);

      --  Tipos de Mensajes de respuestas
      MSG_VAL_PENTRADA CONSTANT VARCHAR2(15) := 'VAL_PENTRADA'; /**Parametros de entradas incorrectos*/
      MSG_OBT_CTA_ER   CONSTANT VARCHAR2(15) := 'OBT_CTA_ER';   /**Error al obtener Cuentas*/
      MSG_OBT_CC_ER    CONSTANT VARCHAR2(15) := 'OBT_CC_ER';    /**Error al obtener la condicion comercial*/

      v_msg_error VARCHAR2(15) := MSG_ERROR;

      cod_operacion VARCHAR2(3) := '301';
   BEGIN

      -- Valido la Sesion del Cliente
      userinfo := fu_validarsesion(p_sesion, p_codCanal);

      IF userinfo.error = 'S' THEN
         v_retorno.error                := userinfo.error;
         v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      v_codPersona := NVL(userinfo.codigoPersona, userinfo.codigoEmpresa);

      pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, 'Inicio Consulta Cond.Comercial - Cod.Cliente|Nro.Cta: ' || v_codPersona || '|' || p_nroCuenta || '|' || ' ' || fu_generarBitacora(userinfo.error,userinfo.nombreRespuesta, userinfo.descripcionRespuesta,null ), bitacora_entrada);

      --Validacion de parametros de entrada
      IF (p_nroCuenta IS NULL) THEN
         v_msg_error := MSG_VAL_PENTRADA;
         pr_mensajeUsuario(MSG_VAL_PENTRADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, userinfo.codigoEmpresa, 'fu_obtenerCondicionComercial - no cta:' || p_nroCuenta || ' - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         v_retorno.error := 'S';
      END IF;

      IF lf_val_cta_origen(p_nroCuenta, v_codPersona) = 'N' THEN
         -- no es una cuenta del cliente
         pr_mensajeUsuario(MSG_OBT_CTA_ER, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, userinfo.codigoEmpresa, 'fu_obtenerCondicionComercial - no cta:' || p_nroCuenta || ' - ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         v_retorno.error := 'S';
         RETURN v_retorno;
      END IF;

      v_msg_error            := MSG_OBT_CC_ER;
      r_tip_listaCondiciones := fug_obt_cam_producto(p_nroCuenta);

      v_retorno.cantidad := 0;
      IF r_tip_listaCondiciones.Count > 0 THEN
         v_retorno.detallesCondicion := r_tip_listaCondiciones;
         v_retorno.cantidad          := r_tip_listaCondiciones.Count;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, 'Se termina Correctamente Cond.Comercial', bitacora_salida);
      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(v_msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, cod_operacion, userinfo.codigoEmpresa, 'Funcion Cond.Comercial - ' || SQLERRM, bitacora_error);
         RETURN v_retorno;
   END;

   /**
      * Obtener Tarjetas Adicionales
      * @Fecha : 28-09-2012
      * @param p_sesion Codigo de la sesion
      * @param p_codCanal Codigo del canal
      * @param p_nroTarjetaCredito Numero de la Tarjeta Credito
      * @return Resumen de Tarjetas Adicionales
      */
   FUNCTION fu_obtenerTarjetasAdicionales(p_sesion            IN VARCHAR2,
                                           p_codCanal          IN VARCHAR2,
                                           p_nroCuenta         IN VARCHAR2)
                                           RETURN typ_resumenTarjetasAdicionales IS
       v_nro_cuenta VARCHAR2(16);
       v_can_detalles NUMBER(3) := 0;
       userinfo typ_validarsesion;

       v_listaTarjetasAdicionales typ_listaTarjetasAdicionales := typ_listaTarjetasAdicionales();
       v_retorno                  typ_resumenTarjetasAdicionales := typ_resumenTarjetasAdicionales;
       v_resumenTarjetaAdicional  typ_resumenTarjetaAdicional := typ_resumenTarjetaAdicional;

       v_sesion        bw_aut_sesiones.cod_sesion%type;
       v_cod_canal     ge_canales.cod_canal%type;

       MSG_CODCTA_NOEX    CONSTANT VARCHAR2(15) := 'CODCTA_NOEX';     /**Codigo de Cuenta inexistente*/
       MSG_CTA_NO_CORRESP CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';
       MSG_CODCTA_NOEX    CONSTANT VARCHAR2(15) := 'CODCTA_NOEX';     /**Codigo de Cuenta inexistente*/
       MSG_OBT_TAR_NE     CONSTANT VARCHAR2(15) := 'OBT_TCR_NE';      /**Nro. tarjeta no encontrado*/
       MSG_CTA_NO_CORRESP CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND'; /**Nro. de Cuenta no corresponde al cliente*/

       CURSOR c_tarjetasAdicionales(p_numeroCuenta IN VARCHAR2, p_codPersona in varchar2) IS
          SELECT nro_tarjeta, fec_vencimiento, nom_embozar
            FROM ta_tarjetas
           WHERE nro_cuenta = p_numeroCuenta
                 --AND nvl(rel_tarjeta,0) != 0
                 and cod_persona<>p_codPersona
                 AND vigente = 'S'
                 AND COD_ESTADO = 6;
    BEGIN
      v_cod_canal     := depurarAlfanumerico(p_codCanal,3);
      v_sesion        := depurarAlfanumerico(p_sesion,32);

       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

       -- Valido la Sesion del Cliente
       userinfo := fu_validarsesion(p_sesion, p_codcanal);

       IF userinfo.error = 'S' THEN
          v_retorno.error                := userinfo.error;
          v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
          v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
          RETURN v_retorno;
       END IF;
       IF v_ind_cta_encriptada = 'S' THEN
          v_nro_cuenta:= fu_desencriptacionCuentas(p_nroCuenta);
       ELSE
          v_nro_cuenta:= trim(p_nroCuenta);
       END IF;
       BEGIN
          SELECT a.nro_cuenta
            INTO v_nro_cuenta
            FROM ge_cta_clientes a, ta_tarjetas b
           WHERE b.nro_cuenta = v_nro_cuenta
                 and nvl(b.rel_tarjeta,0) = 0
                 AND b.nro_cuenta = a.nro_cuenta
                 AND a.cod_persona = NVL(userinfo.codigoPersona, userinfo.codigoEmpresa)
                 and rownum=1;
       EXCEPTION
          WHEN no_data_found THEN
             pr_mensajeUsuario(MSG_OBT_TAR_NE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL,
             ' fu_ObtenerTarjetasAdicionales-' || MSG_OBT_TAR_NE|| fu_generarBitacora(v_retorno.error,  v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,NULL),
             BITACORA_ERROR);

       RETURN v_retorno;
       END;

       --Saldos
       FOR tarjeta IN c_tarjetasAdicionales(v_nro_cuenta,userinfo.codigoPersona)
       LOOP
          v_resumenTarjetaAdicional := typ_resumenTarjetaAdicional;
          v_can_detalles                             := v_can_detalles + 1;
          v_resumenTarjetaAdicional.nombreEmbozado   := tarjeta.nom_embozar;
          v_resumenTarjetaAdicional.numeroTarjeta    := fu_encriptacionCuentas(tarjeta.nro_tarjeta);
          v_resumenTarjetaAdicional.fechaVencimiento := to_char(tarjeta.fec_vencimiento,'ddmmyyyy');
          v_listaTarjetasAdicionales.EXTEND;
          v_listaTarjetasAdicionales(v_listaTarjetasAdicionales.COUNT) := v_resumenTarjetaAdicional;
       END LOOP;

       v_retorno.cantidad:=v_can_detalles;
       v_retorno.tarjetasAdicionales:=v_listaTarjetasAdicionales;
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL,
       ' fu_ObtenerTarjetasAdicionales-' ||fu_generarBitacora(v_retorno.error,  v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,NULL)||  BITACORA_SALIDA);
       return v_retorno;
    END;

   /**
   * Area del Cliente
   * @Creado por: Fermin Gimenez
   * @Fecha : 13-12-2012
   */
  FUNCTION fu_obtenerAreaCliente(p_sesion            IN VARCHAR2,
                                 p_codigoCanal       IN VARCHAR2
                                 ) RETURN typ_respuestaAreaCliente IS

     CURSOR c_areaCli(p_codPersona IN VARCHAR2) IS
       SELECT nom_completo,
              bd.direccion ||
              ' Nro. ' || bd.numero ||
              '. Ciudad: ' || FUE_OBT_DES_CIUDAD(bd.cod_pais, bd.cod_ciudad) ||
              '. Barrio: ' || FUE_OBT_DES_BARRIO(bd.cod_pais, bd.cod_ciudad, bd.cod_barrio) direccion,
              bt.area || '-' || bt.telefono telefono,
              bp.dir_correo, bp.cod_tip_documento, bp.nro_documento,fue_obt_tip_doc_abreviatura(bp.cod_tip_documento)abreviatura
         FROM ba_personas bp, ba_direcciones bd, ba_telefonos bt
        WHERE bd.cod_persona(+) = bp.cod_persona
          AND bd.principal(+) = 'S'
          AND bt.cod_persona(+) = bp.cod_persona
          AND bt.principal(+) = 'S'
          AND bp.cod_persona = p_codPersona;

     v_tip_mensaje        VARCHAR2(3) := '302';
     v_cod_persona        VARCHAR2(10);
     v_can_detalles       NUMBER(3) := 0;
     userinfo             typ_validarsesion;
     v_retorno            typ_respuestaAreaCliente := typ_respuestaAreaCliente;
     v_sesion             bw_aut_sesiones.cod_sesion%type;
     v_codigoCanal          ge_canales.cod_canal%type;
     MSG_G_SIN_DATOS      CONSTANT VARCHAR2(15) := 'G_SIN_DATOS'; --No se encontraron registros
  BEGIN

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     v_codigoCanal     := depurarAlfanumerico(p_codigoCanal,3);
     v_sesion        := depurarAlfanumerico(p_sesion,32);
     -- Valido la Sesion del Cliente
     userinfo := fu_validarsesion(v_sesion, v_codigoCanal);

     IF userinfo.error = 'S' THEN
        v_retorno.error                := userinfo.error;
        v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     v_cod_persona := NVL(userinfo.codigoPersona, userinfo.codigoEmpresa);

     --datos
     FOR reg IN c_areaCli(v_cod_persona)
     LOOP
        v_can_detalles               := v_can_detalles + 1;
        v_retorno.nombreCompleto     := reg.nom_completo;
        v_retorno.direccionPrincipal := reg.direccion;
        v_retorno.telefonoPrincipal  := reg.telefono;
        v_retorno.email              := reg.dir_correo;
        v_retorno.documento          := reg.nro_documento;
        v_retorno.tipoDocumento      := reg.cod_tip_documento;
        v_retorno.abreviaturaDocumento := reg.abreviatura;
     END LOOP;

     -- Valida si encontro datos
     IF v_can_detalles = 0 THEN
        pr_mensajeUsuario(MSG_G_SIN_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_obtenerAreaCliente- ' || MSG_G_SIN_DATOS|| fu_generarBitacora(v_retorno.error,
                                             v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,NULL) , BITACORA_ERROR);
        RETURN v_retorno;
     END IF;

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, NULL, ' fu_obtenerAreaCliente- ' ||  BITACORA_SALIDA||  fu_generarBitacora(v_retorno.error,
                                             v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,NULL));
     return v_retorno;
  END;
   /**
   * Consulta de Autorizaciones Pendientes
   * @Fecha : 15-09-2014
   */

  FUNCTION fu_obtenerAutorizaciones( p_sesion      IN VARCHAR2,
                                      p_codigoCanal IN VARCHAR2,
                                      p_estado      IN VARCHAR2 DEFAULT NULL )
                    RETURN typ_consultaAutorizaciones IS

      v_cod_operacion        VARCHAR2(3) := '024';
      v_cta_formateada       VARCHAR2(17);
      v_estado               VARCHAR2(3);
      v_can_autorizaciones   NUMBER := 0;
      userInfo               typ_validarSesion;
      v_mensajeCaja          typ_mensajeCaja;
      v_retorno              typ_consultaAutorizaciones := typ_consultaAutorizaciones();
      v_lis_detalle          typ_listaAutorizaciones := typ_listaAutorizaciones();
      v_res_autorizacion     typ_resumenAutorizacion := typ_resumenAutorizacion();
      v_sesion               bw_aut_sesiones.cod_sesion%type;
      v_codigoCanal          ge_canales.cod_canal%type;


      -- detalle de movimientos pendientes, anulados o confirmados
      CURSOR c_ope_pendientes(p_cod_per_empresa IN ba_personas.cod_persona%TYPE ) IS

         SELECT a.nro_documento, a.fec_hora, b.descripcion, a.cod_tip_mensaje,
                c.nro_cuenta cta_formateada,
                a.nro_cuenta, a.cod_moneda, a.monto, c.cod_modulo, a.estado est_mov,
                decode(a.estado, 'A', 'Anulada', 'C', 'Confirmada', 'P', 'Pendiente') estado,
                a.referencia, a.can_aut_requeridas, a.can_aut_faltantes, a.cod_per_ingreso, a.fec_insercion
           FROM ge_cuentas c, bw_tip_mensajes b, bw_mov_pendientes a
          WHERE a.cod_per_principal = p_cod_per_empresa
            AND c.nro_cuenta = a.nro_cuenta
            AND (v_estado IS NULL OR a.estado = v_estado)
            AND b.cod_tip_mensaje = a.cod_tip_mensaje
            AND trunc(a.fec_insercion) >= trunc(SYSDATE)
            ORDER BY TRUNC(a.fec_insercion) DESC, DECODE(a.estado, 'P', 0, 'C', 1, 2) ASC;

   BEGIN
      v_codigoCanal     := depurarAlfanumerico(p_codigoCanal,3);
      v_sesion          := depurarAlfanumerico(p_sesion,32);
      v_estado          := TRIM(p_estado);
      -- Valido la Sesion del Cliente
      userInfo := fu_validarSesion(v_sesion, v_codigoCanal);

      IF userInfo.error = 'S' THEN
         v_retorno.error                := userInfo.error;
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;

        /* Obtiene la informacion de parametros recibos y el return del type */
        paw_log.g_typ_consultaAutorizaciones := v_retorno;
        paw_log.pr_logValoresTypes('typ_consultaAutorizaciones',
        'ConsultaAutorizaciones'||' '||p_sesion||', '|| p_codigoCanal||', '||  p_estado);
        RETURN v_retorno;
      END IF;
      pr_insertarBitacora(userinfo.codigoPersona,p_codigoCanal,p_sesion,v_tip_mensaje,userinfo.codigoEmpresa,
                          'obtenerAutorizaciones. Estado' || v_estado|| fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),BITACORA_ENTRADA);


     -- Verifica el canal de origen
      v_mensajeCaja := lf_val_caja(userInfo);

      IF v_mensajeCaja.error = 'S' THEN
         v_retorno.error                := v_mensajeCaja.error;
         v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;

        /* Obtiene la informacion de parametros recibos y el return del type */
        paw_log.g_typ_consultaAutorizaciones := v_retorno;
        paw_log.pr_logValoresTypes('typ_consultaAutorizaciones',
        'ConsultaAutorizaciones'||' '||p_sesion||', '|| p_codigoCanal||', '||  p_estado);
        RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,v_retorno.error);

      -- Selecciona los Movimientos Pendientes
      FOR mp IN c_ope_pendientes(userInfo.codigoEmpresa )
      LOOP
            v_can_autorizaciones := v_can_autorizaciones + 1;

            IF mp.cod_modulo = 5 THEN
               v_cta_formateada := lf_obt_nro_tarjeta(mp.nro_cuenta, userInfo.codigoPersona, userInfo.codigoEmpresa);
            ELSE
               v_cta_formateada := mp.cta_formateada;
            END IF;

            v_res_autorizacion.numeroDocumento := mp.nro_documento;
            v_res_autorizacion.fecha           := mp.fec_hora;
            v_res_autorizacion.descripcion     := substr(mp.descripcion, 1, 60);
            v_res_autorizacion.numeroCuenta    := substr(v_cta_formateada, 1, 17);
            v_res_autorizacion.moneda          := mp.cod_moneda;
            v_res_autorizacion.monto           := mp.monto;
            v_res_autorizacion.estado          := substr(mp.estado, 1, 10);
            v_res_autorizacion.autorizacionesRequeridas := mp.can_aut_requeridas;
            v_res_autorizacion.autorizacionesFaltantes := mp.can_aut_faltantes;

            v_lis_detalle.extend;
            v_lis_detalle(v_lis_detalle.count) := v_res_autorizacion;

      END LOOP;

      v_retorno.cantidadAutorizaciones   := v_can_autorizaciones;
      v_retorno.listaAutorizaciones      := v_lis_detalle;
      pr_insertarBitacora(userInfo.codigoPersona,p_codigoCanal,p_sesion,v_cod_operacion,userInfo.codigoEmpresa,
                          'obtenerAutorizaciones'||'est: ' || p_estado || ',canDet:' || v_can_autorizaciones || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),BITACORA_SALIDA);


      /* Obtiene la informacion de parametros recibos y el return del type */
      paw_log.g_typ_consultaAutorizaciones := v_retorno;
      paw_log.pr_logValoresTypes('typ_consultaAutorizaciones',
      'ConsultaAutorizaciones'||' '||p_sesion||', '|| p_codigoCanal||', '||  p_estado);


      RETURN v_retorno;

   END;

 -- Validacion y confirmacion de pago de salarios
  FUNCTION fu_pagoSalarios(p_sesion                 IN VARCHAR2,
                            p_codigoCanal            IN VARCHAR2,
                            p_codigoEnte             IN NUMBER,
                            p_modoControl            IN VARCHAR2,
                            p_codigoMoneda           IN VARCHAR2,
                            p_montoTotal             IN NUMBER,
                            p_tipoRemuneracion       IN VARCHAR2,
                            p_cantCuentasParaCredito IN NUMBER,
                            p_canRegistrosLeidos     IN NUMBER,
                            p_parametros             IN CLOB,
                            p_claveTransaccional     IN VARCHAR2,
                            p_claveToken             IN VARCHAR2,
                            p_fecPago                IN DATE) RETURN typ_pagoSalarios IS----NVB-2232
      -- datos recibidos
      p_modo             VARCHAR2(1) := substr(p_modoControl, 1, 1); -- modo de control L:ABM V:ARCHIVO
      p_cod_ente         NUMBER(5);
      p_cod_moneda       VARCHAR2(3); -- moneda
      -- comentado por aguara, no se puede obtener este detalle por archivos
      p_tip_remuneracion VARCHAR2(1); -- Tipo de remuneracion
      --comentado por aguara, no se puede obtener este detalle por archivos
      p_can_registros    NUMBER(5); -- cantidad de registros leidos
      v_cta_formateada   VARCHAR2(17); -- cuenta formateada
      v_cod_tip_cuenta   VARCHAR2(2); -- codigo del tipo de cuenta
      v_des_tip_cuenta   VARCHAR2(35); -- descripcion del tipo de cuenta
      v_cod_moneda       VARCHAR2(3); -- moneda de la cuenta
      v_nom_cuenta       VARCHAR2(100); -- nombre de la cuenta
      v_cod_res_cta      VARCHAR2(3); -- respuesta por cada cuenta
      v_nro_cuenta       VARCHAR2(17); -- contiene los numeros de cuentas
      v_monto            NUMBER(16, 2); -- monto del credito
      v_tot_detalles     NUMBER(16, 2) := 0; -- total a debitar
      v_can_detalles     NUMBER := 0; -- cantidad de cuentas
      v_cod_ente         NUMBER(6); -- codigo del ente
      v_des_ente         VARCHAR2(100); -- descripcion del ente
      v_cod_ent_cre      NUMBER(6); -- codigo del ente para las ctas credito
      v_nro_cta_debito   VARCHAR2(17); -- cuenta de debito
      v_registro         VARCHAR2(200);
      v_for_archivo      VARCHAR2(100);
      v_tipo             VARCHAR2(10);
      v_can_creditos     NUMBER(5) := 0; -- Cantidad de Creditos
      v_can_errores      NUMBER(5) := 0;
      v_lon_registro     NUMBER(3) := 102; -- longitud de registro fijo
      v_nro_documento    VARCHAR2(15);
      v_nro_archivo      NUMBER(10); -- Nro de archivo a agrupar
      --v_nro_archivo_tmp  NUMBER(10); -- Nro de archivo auxiliar
      v_redondeo         NUMBER;
      v_can_cta_debito   NUMBER := 0; -- Cantidad de cuentas para débito
      v_dir_correo       ge_par_dinamicos.val_parametro%TYPE;
      v_cod_transaccion  ge_transacciones.cod_transaccion%TYPE;
      v_cod_tra_padre    ge_transacciones.cod_transaccion%TYPE;
      v_cod_operacion    VARCHAR2(3) := '070';
      v_lugar            VARCHAR2(100);
      v_resLimite        typ_respuestaLimite;
      v_fec_actual       DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy;
      v_mensaje          VARCHAR2(100);
      v_usu_sesion       typ_validarsesion;
      v_retorno          typ_pagoSalarios := typ_pagoSalarios();--NVB-2232
      v_detalle          typ_detalleSalario := typ_detalleSalario(); -- datos de las cuentas--NVB-2232
      v_lis_detalle      typ_listadetallesalario := typ_listadetallesalario();--NVB-2232
      v_msj_respuesta    typ_MensajeRespuesta := typ_MensajeRespuesta;
      v_msj_caja         typ_mensajeCaja;
      v_permiso          typ_obtenerPermisos;
      v_nom_beneficiario VARCHAR2(50);
      v_cod_modulo       ge_cuentas.cod_modulo%TYPE;
      v_cod_modalidad    ge_cuentas.cod_modalidad%TYPE;
      v_sal_disponible   ge_cuentas.sal_promedio%TYPE;
      v_traspaso         ge_par_dinamicos.val_parametro%TYPE := 'N';
      v_pos_ant          NUMBER;
      v_pos_nvo          NUMBER;
      v_val_nro_doc      ge_par_entes.val_parametro%TYPE;
      v_nro_doc_credito  ba_personas.nro_documento%TYPE;
      v_nro_doc_generico ge_par_dinamicos.val_parametro%TYPE;
      v_cod_error        NUMBER := 0; -- 0: Ok, 1: Error en cuenta, 2: Error en monto, 3: error en cuenta y monto
      v_mon_debito       NUMBER(16, 2) := 0;
      v_nro_movimiento bw_movimientos.nro_movimiento%type;

      v_msj_bitacora     VARCHAR2(500) := substr('ente:'||trim(p_codigoEnte)
                                                        ||', modo:'||trim(p_modoControl)
                                                        ||', codMon:'||trim(p_codigoMoneda)
                                                        ||', mtoTot:'||trim(p_montoTotal)
                                                        ||', tipRem:'||p_tipoRemuneracion
                                                        ||', canCtaCre:'||p_cantCuentasParaCredito
                                                        ||', canReg:'||p_canRegistrosLeidos
                                                        ||', fecAct:'||v_fec_actual
                                                        ||', fecPago:'||p_fecPago, 1, 500);

      SAL_PER_SIN_AUT       CONSTANT VARCHAR2(15) := 'SAL_PER_SIN_AUT'; -- perfil sin autorizacion para pagos
      SAL_DAT_ENT_DUPLICADA CONSTANT VARCHAR2(15) := 'SAL_DAT_ENT_DUP'; -- datos de ente duplicada
      SAL_ERR_OBT_DAT_ENTES CONSTANT VARCHAR2(15) := 'SAL_ERR_DAT_ENT'; -- error al obtener datos de ente
      SAL_CTA_INSUFICIENTE  CONSTANT VARCHAR2(15) := 'SAL_CTA_INSUFIC'; -- la cuenta debito no cuenta con fondos
      SAL_ERR_DATOS         CONSTANT VARCHAR2(15) := 'SAL_ERR_DATOS';   -- datos incorrectos en la carga
      SAL_ERR_CTA_DEB_INVAL CONSTANT VARCHAR2(15) := 'SAL_CTA_DEB_INV'; -- cuenta debito invalida
      SAL_CAN_CTA_DEB_INVAL CONSTANT VARCHAR2(15) := 'SAL_CAN_CTA_DEB'; -- cantidad de ctas debito invalida
      SAL_MAX_CAN_CRE_INVAL CONSTANT VARCHAR2(15) := 'SAL_MAX_CRE_INV'; -- cantidad de creditos excedido
      SAL_PED_DUPLICADO     CONSTANT VARCHAR2(15) := 'SAL_PED_DUPLICA'; -- pedido duplicado, aviso
      SAL_CTA_DEB_TERCERO   CONSTANT VARCHAR2(15) := 'SAL_CTA_DEB_TER'; -- cta debito no pertenece al ente
      OPE_NO_PERMITIDA      CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      SAL_FMT_INCORRECTO    CONSTANT VARCHAR2(15) := 'SAL_FMT_INCORRE';
      FEC_PAGO_INVALIDO     CONSTANT VARCHAR2(15) := 'FEC_PAGO_INVAL';
      FEC_AGUINALDO_INVAL   CONSTANT VARCHAR2(15) := 'FEC_AGUINA_INV';
      SAL_MTO_TOT_INVAL     CONSTANT VARCHAR2(15) := 'SAL_MTO_TOT_INV';

   BEGIN
      IF p_modo NOT IN ('L', 'C', 'V') THEN
         pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('xxxxx', p_codigoCanal, p_sesion, v_cod_operacion, NULL, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 1. valido la clave del cliente
      v_lugar := 'Validacion de la clave';
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);

      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);


      -- 2. validacion fecha de pago
      IF p_fecPago IS NULL OR TRUNC(p_fecPago) > TRUNC((SYSDATE + NVL(fug_obt_pardinamico('FEC_PAGO_LIM_NOMINA'), 180))) OR TRUNC(p_fecPago) < trunc(SYSDATE) THEN
         pr_mensajeUsuario(FEC_PAGO_INVALIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('xxxxx', p_codigoCanal, p_sesion, v_cod_operacion, NULL, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 3. validacion de aguinaldo, no se puede realizar con fecha futura
      IF depurarTextos(p_tipoRemuneracion, 1) = 'A' AND TRUNC(SYSDATE) < TRUNC(p_fecPago) THEN
         pr_mensajeUsuario(FEC_AGUINALDO_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('xxxxx', p_codigoCanal, p_sesion, v_cod_operacion, NULL, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 4. verifica el canal de origen
      v_lugar := 'Validacion de la caja';
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      -- 5. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_lugar := 'Control de permisos';
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion); --nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), v_usu_sesion.codigoPerfil, v_cod_operacion, v_usu_sesion.codigoCanal);
      v_msj_bitacora := v_msj_bitacora||', perf: ' || v_usu_sesion.codigoPerfil;
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
         pr_mensajeUsuario(SAL_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- 6. Se cargan los parametros recibidos
      v_lugar            := 'Datos del parametro';
      p_cod_ente         := depurarNumerico(p_codigoEnte, 5);
      p_cod_moneda       := depurarTextos(p_codigoMoneda, 3); -- moneda
      --p_tot_debito       := p_montoTotal; -- monto total sueldos
      p_tip_remuneracion := depurarTextos(p_tipoRemuneracion, 1); -- Tipo de remuneracion
      --p_can_cuentas      := p_cantCuentasParaCredito; -- cantidad de cuentas
      p_can_registros    := p_canRegistrosLeidos; -- cantidad de registros leidos
      v_redondeo         := fug_obt_pardinamico('VAL_RED_MON_EXTRANJERA', NULL, NULL, p_cod_moneda, NULL, NULL);
      v_msj_bitacora     := v_msj_bitacora||', red: ' || v_redondeo;

      /*
      IF p_modo <> 'V' THEN
         -- formato fijo, porque se cargo por la pantalla
         v_lon_registro := 102; -- denominacion 50, cuenta 15, monto 16, Tipo Cta (C,D), documento 20
      END IF;
      v_msj_bitacora     := v_msj_bitacora||', lon: ' || v_lon_registro;  */

      -- 7. Verifico si la persona tiene el servicio de pago de sueldos
      v_lugar := 'Datos del Ente';
      IF v_retorno.error = 'N' THEN
         BEGIN
            SELECT a.cod_ente, a.descripcion, fug_obt_parentes(a.cod_ente, 'NRO_CTA_DEBITO'), fug_obt_parentes(a.cod_ente, 'REFERENCIA_TXT_SUELDO'), TRIM(fug_obt_parentes(a.cod_ente, 'VAL_NRO_DOCUMENTO'))
              INTO v_cod_ente, v_des_ente, v_nro_cta_debito, v_for_archivo, v_val_nro_doc
              FROM ge_entes a
             WHERE a.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
               AND a.tipo = 'SU'
               AND a.cod_ente = p_cod_ente
               AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO') = 'S'
               AND fug_obt_parentes(a.cod_ente, 'HAB_HOMEBANKING') = 'S';
         EXCEPTION
            WHEN too_many_rows THEN
               pr_mensajeUsuario(SAL_DAT_ENT_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
            WHEN OTHERS THEN
               v_msj_bitacora := v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 100) || ']';
               pr_mensajeUsuario(SAL_ERR_OBT_DAT_ENTES, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200)|| '] ' ||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
         END;
         /* OMM 13/01/2011 --Se agrego esta validaciòn solo para el BBVA por mala
            configuraciòn del OAS de Produccion en ITGF (el parametro "NLS_NUMERIC_CHARACTER" no estaba
            configurado en el OAS por esto se procesa con otro tipo de archivo en USD)   */
         IF v_for_archivo = 'PAG_SUELDOS_USD' THEN
            v_for_archivo := 'PAG_SUELDOS';
         END IF;
      END IF;

      -- 8. Tomo la cantidad de cuentas recibidas
      IF v_retorno.error = 'N' THEN
         IF p_modo = 'C' THEN
            -- obtenemos la secuencia del pago
            v_nro_archivo := paw_bce.fu_obt_nro_sec_sueldo(v_cod_ente, TRUNC(p_fecPago));
            /*IF v_fec_actual <> trunc(SYSDATE) THEN
               v_nro_archivo_tmp := paw_bce.fu_obt_nro_sec_sueldo(v_cod_ente, trunc(sysdate));

               IF v_nro_archivo_tmp > v_nro_archivo THEN
                  v_nro_archivo := v_nro_archivo_tmp;
               END IF;
            END IF;*/
            v_msj_bitacora := v_msj_bitacora || ', nroArc:' || v_nro_archivo;
         END IF;
         -- obtenemos si el ente tiene traspaso de aguinaldo
         IF p_tip_remuneracion = 'A' THEN
            v_traspaso := nvl(fug_obt_parentes(p_cod_ente, 'PAG_TRA_AGUINALDO'), 'N');
         END IF;
         -- obtenemos la transacción padre
         v_cod_tra_padre := fu_obt_tra_sueldo(v_cod_ente, p_tip_remuneracion);
         ---
         v_nro_doc_generico := fug_obt_pardinamico('NRO_DOC_GEN_PAG_SAL');
         v_lugar := 'leyendo los registros';
         v_pos_ant := 1;
         FOR i IN 1 .. p_can_registros
         LOOP
            IF p_modo <> 'V' THEN
               v_registro := substr(p_parametros, 1 + ((i - 1) * v_lon_registro), v_lon_registro);
               -- formato fijo
               v_nom_beneficiario := depurarTextos(substr(v_registro, 1, 50), 50);
               v_nro_cuenta       := depurarTextos(substr(v_registro, 51, 15), 15);
               v_monto            := nvl(to_number(REPLACE(TRIM(substr(v_registro, 66, 16)), ',', '.')), 0);
               v_tipo             := substr(v_registro, 82, 1);
               v_nro_doc_credito  := TRIM(depurarTextos(substr(v_registro, 83), 20));
            ELSE
               v_pos_nvo  := instr(p_parametros, '~', v_pos_ant);
               v_registro := substr(p_parametros, v_pos_ant, v_pos_nvo - v_pos_ant);
               v_pos_ant  := v_pos_nvo + 1;
               -- formato segun archivo
               v_nro_cuenta       := depurarTextos(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_SUELDOS_TMP', v_registro, 'NRO_CUENTA'),15);
               v_monto            := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_SUELDOS_TMP', v_registro, 'MONTO');
               v_tipo             := paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_SUELDOS_TMP', v_registro, 'TIPO');
               v_nom_beneficiario := substr(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_SUELDOS_TMP', v_registro, 'NOMBRE'), 1, 50);
               v_nro_doc_credito    := TRIM(depurarTextos(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_SUELDOS_TMP', v_registro, 'NRO_DOCUMENTO'), 20));
            END IF;
            -- OMM 07/10/2010
            IF v_tipo IS NULL OR v_tipo NOT IN ('C', 'D') THEN
               IF v_nro_cuenta = v_nro_cta_debito THEN
                  v_tipo := 'D';
               ELSE
                  v_tipo := 'C';
               END IF;
            END IF;
            IF v_tipo = 'C' THEN
               v_tot_detalles := v_tot_detalles + v_monto;
               v_can_creditos := v_can_creditos + 1;
               --  v_can_detalles   := v_can_detalles + 1; OMM 07/10/2010
            ELSE
               v_mon_debito := v_monto;
               v_nro_cta_debito := v_nro_cuenta;
               v_can_cta_debito := v_can_cta_debito + 1; -- para validar que solo exista una cuenta débito
            END IF;
            v_can_detalles := v_can_detalles + 1;
            -- OMM 06/10/2010
            v_cod_error   := 0;
            v_cod_res_cta := paw_bce.v_cod_aprobado;
            IF v_tipo IN ('C', 'D') THEN
               -- valido la cuenta recibida
               BEGIN
                  v_cta_formateada := NULL;
                  v_cod_tip_cuenta := NULL;
                  v_des_tip_cuenta := NULL;
                  v_nom_cuenta     := NULL;
                  v_cod_moneda     := NULL;
                  v_cod_modulo     := NULL;
                  SELECT fug_cta_formateada(a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.nro_cuenta, a.cod_moneda) cta_formateada, paw_bce.fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) des_tip_cuenta, a.denominacion nom_cuenta, a.cod_moneda cod_moneda, a.cod_modulo, a.cod_modalidad
                    INTO v_cta_formateada, v_cod_tip_cuenta, v_des_tip_cuenta, v_nom_cuenta, v_cod_moneda, v_cod_modulo, v_cod_modalidad
                    FROM ge_est_cuentas c, ge_cuentas a
                   WHERE a.nro_cuenta = TRIM(v_nro_cuenta)
                     AND a.cod_modulo = c.cod_modulo
                     AND a.cod_modalidad = c.cod_modalidad
                     AND a.estado = c.estado
                     AND c.activo = 'S' -- solo cuentas activas
                     AND a.estado NOT IN ('X', 'C', 'P') -- se controla los estados cerrado y pend. de cancelación
                     AND a.cod_modalidad IN (31, 41, 38, 39, 334); -- solo cuentas de ahorros y cuentas corrientes
                  IF p_cod_moneda <> v_cod_moneda THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_invalida; -- moneda diferente
                     v_mensaje     := 'La moneda de la cuenta es invalida';
                     v_cod_error   := 1;
                  ELSE
                     v_cod_res_cta := paw_bce.v_cod_aprobado;
                     v_mensaje     := 'Aprobado';
                  END IF;
               EXCEPTION
                  WHEN no_data_found THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_inexistente;
                     v_mensaje     := 'Cuenta inexistente';
                     v_cod_error   := 1;
                  WHEN too_many_rows THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_duplicada;
                     v_mensaje     := 'Cuenta duplicada';
                     v_cod_error   := 1;
                  WHEN OTHERS THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                     v_mensaje     := 'Cuenta invalida';
                     v_cod_error   := 1;
               END;
               -- valido que no acredita a cuenta propia
               IF v_cod_res_cta = paw_bce.v_cod_aprobado AND v_tipo = 'C' THEN
                  IF lf_val_cta_origen(v_nro_cuenta, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)) = 'S' THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                     v_mensaje     := 'La cuenta pertenece al ente';
                     v_cod_error   := 1;
                  END IF;
               END IF;
               -- comentamos la porcion de aguinaldo
               /*IF v_traspaso = 'S' AND v_cod_res_cta = paw_bce.v_cod_aprobado AND v_tipo = 'C' THEN
                  -- validamos cuentas de aguinaldo
                  paw_bce.pr_ver_cta_aguinaldo(v_nro_cuenta, v_traspaso, v_cod_error, v_mensaje, 40);
                  IF v_cod_error <> 0 THEN
                     v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                  END IF;
               END IF;*/

               -- Validamos que la cuenta credito pertenesca al ente
               IF v_tipo = 'C' and v_cod_modalidad in (31, 41, 38, 39, 334) Then
                 BEGIN
                    SELECT t.cod_ente
                      INTO v_cod_ent_cre
                      FROM ah_cta_vistas t
                     WHERE t.nro_cuenta = TRIM(v_nro_cuenta)
                       AND t.estado NOT IN ('X', 'C', 'P') -- se controla los estados cerrado y pend. de cancelación
                       AND t.cod_modalidad IN (31, 38, 39, 334);
                       IF v_cod_ent_cre IS NOT NULL THEN
                           IF v_cod_ent_cre != v_cod_ente THEN
                              v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                              v_mensaje     := 'La cuenta no pertenece al ente';
                              v_cod_error   := 1;
                           END IF;
                       ELSE
                           v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                           v_mensaje     := 'La cuenta no tiene un ente configurado';
                           v_cod_error   := 1;
                       END IF;
                  EXCEPTION
                     WHEN NO_DATA_FOUND THEN
                         v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                         v_mensaje     := 'No se pudo obtener el ente configurado';
                         v_cod_error   := 1;
                     WHEN OTHERS THEN
                         v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                         v_mensaje     := 'Error al obtener ente '||sqlerrm;
                         v_cod_error   := 1;
                  END;
               END IF;

               IF v_monto <= 0 THEN
                  IF v_cod_res_cta = paw_bce.v_cod_aprobado THEN
                     -- monto inválido
                     v_cod_res_cta := paw_bce.v_cod_mto_invalido;
                     v_mensaje     := 'Monto invalido';
                     v_cod_error   := 2;
                  ELSE
                     v_cod_error   := 3;
                     v_mensaje     := v_mensaje || '. Monto Invalido';
                  END IF;
               END IF;
               -- valido los decimales
               IF v_monto > 0 AND v_monto <> trunc(v_monto, v_redondeo) THEN
                  IF v_cod_res_cta = paw_bce.v_cod_aprobado THEN
                     v_cod_res_cta := paw_bce.v_mon_dec_invalida;
                     v_mensaje     := 'La cuenta no admite decimal';
                     v_cod_error   := 2;
                  ELSE
                     v_cod_error   := 3;
                     v_mensaje     := v_mensaje || '. La cuenta no admite decimal';
                  END IF;
               END IF;
                -- se valida el documento con la cuenta si se recibe
               IF v_tipo = 'C' AND v_val_nro_doc = 'S' THEN
                  --IF v_nro_doc_generico <> nvl(v_nro_doc_credito, '0') AND pag_sem.fu_ver_cta_documento(v_nro_doc_credito, v_nro_cuenta) = 'N' THEN
                  IF  pag_sue.fu_ver_cta_documento(v_nro_doc_credito, v_nro_cuenta) = 'N' THEN--NVB-2232-pag_sue
                     IF v_cod_res_cta = paw_bce.v_cod_aprobado THEN
                        v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                        v_mensaje   := 'Documento no pertenece a cuenta';
                        v_cod_error := 4;
                     ELSE
                        v_cod_error := v_cod_error + 4;
                        v_mensaje   := substr(v_mensaje || '. Documento no pertenece a cuenta', 1, 100);
                     END IF;
                  END IF;
               END IF;

               -- verificamos si se puede realizar la operación de débito/crédito
               IF v_cod_res_cta = paw_bce.v_cod_aprobado THEN
                  -- obtenemos el codigo de transacción
                  IF v_tipo = 'D' THEN
                     v_cod_transaccion := 503;
                  ELSE
                     v_cod_transaccion := 602;
                  END IF;

                  -- verificamos si se puede realizar la operacion, para fecha futura no debe validar saldo disponible
                  IF paw_bce.fu_ver_operacion(v_nro_cuenta, v_monto, v_cod_transaccion, v_cod_tra_padre, v_tipo) = 'N' THEN

                     IF pag_cta.g_cod_error <> 0 THEN
                        IF v_tipo = 'D' THEN
                           v_msj_bitacora := v_msj_bitacora || ', cta-deb: ' || v_nro_cuenta || ', cta-err: [' || substr(pag_cta.g_msj_error, 1, 150) || ']';
                        END IF;
                        -- controlamos si dispone de saldo suficiente
                        IF pag_cta.g_cod_error IN (25, 29, 31, 36)  THEN
                          IF v_tipo = 'D' AND TRUNC(p_fecPago) = TRUNC(SYSDATE) THEN
                             pr_mensajeUsuario(SAL_CTA_INSUFICIENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          END IF;
                        ELSE
                           -- hubo otro error
                           v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                           v_mensaje     := 'Cuenta invalida';
                           v_cod_error   := 1;
                        END IF;
                     END IF;
                  END IF;
                  -- verificamos el sobregiro
                  IF v_cod_res_cta = paw_bce.v_cod_aprobado AND v_tipo = 'C' AND (v_cod_modulo = 4 OR v_cod_modulo = 3) AND v_traspaso = 'S' THEN
                     v_sal_disponible := pag_cta.fu_sal_dis_combinada + pag_cta.FU_OBT_LIN_SOBREGIRO(v_nro_cuenta);
                     IF v_sal_disponible < 0 THEN
                        v_cod_error   := 1;
                        v_mensaje     := 'Cuenta no permite credito p/ Aguinaldo. Se encuentra en Sobregiro la cta combinada';
                        v_cod_res_cta := paw_bce.v_cod_cta_invalida;
                     END IF;
                  END IF;
               END IF;
               -- armo el detalle por cuenta
               v_detalle.numeroCuenta          := substr(v_nro_cuenta, 1, 15);
               v_detalle.tipo                  := v_tipo;
               v_detalle.descripcionTipoCuenta := substr(v_des_tip_cuenta, 1, 35);
               v_detalle.nombreCuenta          := substr(nvl(v_nom_cuenta, v_nom_beneficiario), 1, 50);
               v_detalle.codigoMoneda          := substr(v_cod_moneda, 1, 3);
               v_detalle.monto                 := v_monto;
               v_detalle.error                 := 'N';
               v_detalle.mensajeRespuesta      := v_cod_error || ' - ' || v_mensaje;
               v_detalle.numeroDocumento       := v_nro_doc_credito;
               IF v_cod_res_cta <> paw_bce.v_cod_aprobado THEN
                  v_detalle.error := 'S';
                  v_can_errores := v_can_errores + 1;
               END IF;
               v_lis_detalle.extend;
               v_lis_detalle(v_lis_detalle.count) := v_detalle;

               -- registro el codigo de respuesta general, si hay errores en el detalle
               IF v_cod_res_cta <> paw_bce.v_cod_aprobado THEN
                  IF v_tipo = 'D' THEN
                     IF v_cod_res_cta = paw_bce.v_mon_dec_invalida THEN
                        IF v_retorno.error = 'N' THEN
                           -- para que pueda editar el monto del débito importado
                           pr_mensajeUsuario(SAL_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        END IF;
                     ELSE
                        IF v_retorno.error <> 'SAL_CTA_INSUFIC' THEN
                           pr_mensajeUsuario(SAL_ERR_CTA_DEB_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        END IF;
                     END IF;
                  ELSE
                     IF v_retorno.error = 'N' THEN
                        pr_mensajeUsuario(SAL_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     END IF;
                  END IF;
               END IF;
               -- Es confirmacion y no hubo errores... OMM 07/10/2010
               IF p_modo = 'C' AND v_retorno.error = 'N' THEN
                  IF v_tipo = 'D' THEN
                     v_nro_cta_debito := v_nro_cuenta;
                  ELSE
                     INSERT INTO ge_pag_sueldos_tmp
                        (cod_ente, nro_cuenta, fec_envio, fec_proceso, tipo, monto, estado, nro_archivo, tip_remuneracion, nro_documento)
                     VALUES
                        (v_cod_ente, v_nro_cuenta, sysdate, trunc(p_fecPago), 'C', v_monto, 'H', v_nro_archivo, p_tip_remuneracion, v_nro_doc_credito);
                  END IF;
               END IF;
            END IF;
         END LOOP;
         v_lugar := 'Fin del ciclo Cantidad leidos: ' || v_can_detalles;
      END IF;
      v_retorno.cantidadCuentas := v_can_detalles;
      v_retorno.listaCuentas := v_lis_detalle;
      v_msj_bitacora := v_msj_bitacora || ', canDet:' || v_can_detalles || ', canCreLei:' || v_can_creditos|| ', totDetLei:' || v_tot_detalles;
      -- no puede haber más de una cuenta débito
    -- valida que el monto total sea igual al registrado en el archivo
      IF v_can_cta_debito > 1 THEN
         v_msj_bitacora := v_msj_bitacora || ', canCtaDeb:' || v_can_cta_debito;
         pr_mensajeUsuario(SAL_CAN_CTA_DEB_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      ELSIF v_can_creditos > paw_bce.v_max_imp_archivo THEN
         pr_mensajeUsuario(SAL_MAX_CAN_CRE_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      ELSIF v_mon_debito <> v_tot_detalles THEN
         pr_mensajeUsuario(SAL_MTO_TOT_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
    END IF;

      -- validar siempre que la cuenta debito pertenezca al ente
      -- OMM 07/10/2010 Valida q la Cta debito sea de la empresa.
      IF lf_cta_valida(v_nro_cta_debito, NULL, v_usu_sesion, v_msj_respuesta) = 'N' THEN
         v_msj_bitacora := v_msj_bitacora || 'nro_cta: [' ||v_nro_cta_debito|| ']';
         IF nvl(v_msj_respuesta.error, 'N') = 'N' THEN
            pr_mensajeUsuario(SAL_CTA_DEB_TERCERO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         ELSE
            v_retorno.error                := v_msj_respuesta.error;
            v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
            v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
         END IF;
        /*
         ELSIF v_tot_detalles <> p_tot_debito THEN
            pr_mensajeUsuario(SAL_MTO_TOT_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         ELSIF v_can_creditos <> p_can_cuentas THEN
            pr_mensajeUsuario(SAL_CAN_CRE_INVAL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         */
      END IF;
      IF v_retorno.error = 'S' THEN
         IF p_modo = 'C' THEN
         -- En caso de error al confirmar se debe eliminar los registros del temporal
            v_lugar := 'borrando datos temporales';
            pag_sue.LP_DEL_DATOS_TEMPORA(v_cod_ente, p_fecPago, v_lugar, v_nro_archivo);--NVB-2232-pag_sue
         END IF;
      ELSE
         IF p_modo IN ('V', 'L') THEN
            -- OMM 19/07/2011 Verificación de Duplicacion
            DECLARE
               v_can_duplicado NUMBER(6) := 0;
            BEGIN
               SELECT COUNT(*)
                 INTO v_can_duplicado
                 FROM ge_pag_sueldos_tmp a
                WHERE a.cod_ente = v_cod_ente
                  AND a.nro_cuenta = v_nro_cta_debito
                  AND a.fec_envio = v_fec_actual
                  AND a.tipo = 'D'
                  AND a.monto = v_tot_detalles --p_tot_debito
                  AND a.estado = 'H'
                  AND a.tip_remuneracion = p_tip_remuneracion
                  AND a.nro_archivo IS NOT NULL;
               IF v_can_duplicado > 0 THEN
                  pr_mensajeUsuario(SAL_PED_DUPLICADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            EXCEPTION
               WHEN OTHERS THEN
                  NULL;
            END;
         END IF;
         -- 20/04/2012 : Verifico que la cta de débito tenga límite para la operación
         --              se agrega monitoreo de limite global de pago de salarios
         IF v_retorno.error = 'N' OR v_retorno.nombreRespuesta = 'SAL_PED_DUPLICA' THEN
            IF p_modo <> 'I' THEN
               v_resLimite := fu_obtenerLimite(v_usu_sesion, v_cod_operacion, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), v_nro_cta_debito, p_cod_moneda, 503, 303, v_tot_detalles/*p_tot_debito*/, p_modo, p_cod_ente);
               IF v_resLimite.error = 'S' THEN
                  v_retorno.error                := 'S';
                  v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
                  v_retorno.nombreRespuesta      := v_resLimite.nombreRespuesta;
               END IF;
               v_retorno.respuestaLimite := v_resLimite.codRespuesta;
               v_msj_bitacora := v_msj_bitacora||', resLimite:'||v_resLimite.codRespuesta;
            END IF;
         END IF;
         IF v_retorno.error = 'N' THEN
            v_msj_respuesta.error := 'N';
            IF p_modo IN ('C', 'A') THEN
               IF v_resLimite.codRespuesta IN ('10', '11') THEN
                  -- clave transaccional requerida
                  v_msj_respuesta := lf_obt_cla_validar(p_claveTransaccional, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, 'T');
               END IF;

               IF v_msj_respuesta.error = 'N' THEN
                  IF v_resLimite.codRespuesta IN ('01', '11') THEN
                     -- token requerido
                     v_msj_respuesta := paw_seg.fu_obt_tok_validar(p_claveToken, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, p_modo);
                  END IF;
               END IF;

               IF v_msj_respuesta.error = 'S' THEN
                  v_retorno.error := 'S';
                  v_retorno.nombreRespuesta := v_msj_respuesta.nombreRespuesta;
                  v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
               END IF;
            END IF;
         END IF;
         IF p_modo = 'C' AND v_retorno.error = 'N' THEN
            -- Es confirmacion y no hubo errores...
            v_lugar := 'Insertando datos de sueldos';
            INSERT INTO ge_pag_sueldos_tmp
               (cod_ente, nro_cuenta, fec_envio, fec_proceso, tipo, monto, estado, tip_remuneracion, nro_archivo)
            VALUES
               (v_cod_ente, v_nro_cta_debito, sysdate, trunc(p_fecPago), 'D', v_tot_detalles /*p_tot_debito*/, 'H', p_tip_remuneracion, v_nro_archivo);
            --
            SELECT s_nro_documento.NEXTVAL
                 INTO v_nro_documento
                 FROM dual;

            IF v_can_aut_requeridas > 0 THEN
               --- inserto el movimiento pendiente de autorizacion

               INSERT INTO bw_mov_pendientes
                  (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda,
                    descripcion, monto, cantidad, etiqueta, dato, etiqueta2,
                    dato2, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, referencia, tip_pago)
               VALUES
                  (v_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), sysdate, '070', v_nro_cta_debito, p_cod_moneda,
                   'Pago de Salarios', v_tot_detalles, v_can_creditos, 'Ente', p_cod_ente, 'Fecha Pago',
                    to_char(p_fecPago, 'DD/MM/YYYY'), 'P', v_can_aut_requeridas, v_can_aut_requeridas, v_usu_sesion.codigoPersona, v_nro_archivo, p_tip_remuneracion);

               v_retorno.numeroDocumento := v_nro_documento;
               v_retorno.cantidadAutorizadores := v_can_aut_requeridas;
              ELSE
                 NULL;
               ----

               /*v_dir_correo := fug_obt_pardinamico('SUE_DIR_CORREO');

               IF v_retorno.error = 'N' THEN
                  v_lugar := 'Enviando mail';
                  it_mail.mail(fug_obt_dir_correo, v_dir_correo, 'Pago de Sueldos Pendiente', 'Pago de Sueldos ingresado por HomeBanking pendientes ' || chr(10) || 'Codigo  : ' || v_cod_ente || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Monto   : ' || lf_for_money(v_tot_detalles/*p_tot_debito*//*, 16) || chr(10) || 'Cantidad: ' || to_char(v_can_creditos) || chr(10) || 'Atentamente. ');*/
               /*END IF;*/
            END IF;
         END IF;
      END IF;
      v_lugar := 'Registrando operacion';
      -- registro del movimiento
      IF v_retorno.error = 'S' THEN
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', canErr:' || v_can_errores || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      ELSE
         IF p_modo = 'C' THEN
           /*BWP-37-glopez*/
               select s_nro_bw_movimiento.nextval
               into v_nro_movimiento
               from dual;
            lp_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/,
                          p_cod_moneda /*p_cod_moneda */,
                          v_tot_detalles /*p_monto*/,
                          NULL /*p_nro_cta_contra*/,
                          v_can_creditos /*p_cantidad*/,
                          'Ente' /*p_etiqueta*/,
                          v_cod_ente /*p_dato*/,
                          'Tip.Rem',
                          p_tipoRemuneracion,
                          'Homebanking',
                          NULL,
                          '000',
                          v_usu_sesion.codigoPersona,
                          v_cod_operacion,
                          v_nro_documento,
                          p_codigoCanal,
                          p_sesion,
                          v_usu_sesion.codigoEmpresa,
                          null,
                          null,
                          null,
                          v_nro_documento,
                          v_nro_movimiento);/*BWP-37-glopez*/
            pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
         END IF;
      END IF;
      -- siempre se responde con los detalles, sea o no sea con errores
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(SAL_FMT_INCORRECTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', lug: ' || v_lugar || ', Cant.Reg.:' || v_can_detalles || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 100) || '] ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
         --raise_application_error(-20005, SQLERRM || ' En: ' || v_lugar || ' Cant.Reg ' || v_can_detalles);
   END; -- Pago de Sueldos


  FUNCTION fu_obt_nro_sec_sueldo(p_cod_ente   in ge_pag_sueldos.cod_ente%type,
                                 p_fec_actual in ge_pag_sueldos.fec_envio%type)
      return number is
      v_nro_archivo     number;
      v_aux_nro_archivo number;
    begin
      begin
        -- obtenemos la maxima secuencia del temporal
        select distinct nvl(max(ge.nro_archivo), 0)
          into v_nro_archivo
          from ge_pag_sueldos_tmp ge
         where ge.cod_ente = p_cod_ente
           and ge.fec_envio = p_fec_actual;
      exception
        when no_data_found then
            v_nro_archivo := 0;
        when others then
          v_nro_archivo := 0;
      end;

      begin
        -- obtenemos la maxima secuencia del pago
        select distinct nvl(max(gs.nro_secuencia), 0)
          into v_aux_nro_archivo
          from ge_pag_sueldos gs
         where gs.cod_ente = p_cod_ente
           and gs.fec_proceso = p_fec_actual;
      exception
         when no_data_found then
            v_aux_nro_archivo := 0;
        when others then
            v_aux_nro_archivo := 0;
      end;
      --
      if v_aux_nro_archivo > v_nro_archivo then
        v_nro_archivo := v_aux_nro_archivo;
      end if;

      begin
        -- obtenemos la maxima secuencia de errores
        select distinct nvl(max(se.nro_secuencia), 0)
          into v_aux_nro_archivo
          from ge_pag_sueldos_err se
         where se.cod_ente = p_cod_ente
           and se.fec_proceso = p_fec_actual;
      exception
         when no_data_found then
           v_aux_nro_archivo := 0;
         when others then
           v_aux_nro_archivo := 0;
      end;
      -- incremento la secuencia
      v_nro_archivo := v_nro_archivo + 1;

      return v_nro_archivo;
    end;

 -- funcion que obtiene la transaccion padre de acuerdo al tipo de transaccion
  FUNCTION fu_obt_tra_sueldo(p_cod_ente         IN ge_entes.cod_ente%TYPE,
                             p_tip_remuneracion IN ge_pag_sueldos_tmp.tip_remuneracion%TYPE)
    RETURN NUMBER IS
    v_cod_tra_padre ge_transacciones.cod_transaccion%TYPE := NULL;
  BEGIN
    IF p_tip_remuneracion = 'S' THEN
      v_cod_tra_padre := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_SUELDO');
    ELSIF p_tip_remuneracion = 'A' THEN
      v_cod_tra_padre := fug_obt_parentes(p_cod_ente,
                                          'COD_TRA_PAD_AGUINALDO');
    ELSIF p_tip_remuneracion = 'C' THEN
      v_cod_tra_padre := fug_obt_parentes(p_cod_ente,
                                          'COD_TRA_PAD_COMISION');
    ELSIF p_tip_remuneracion = 'T' THEN
      v_cod_tra_padre := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_CREDITO');
    END IF;
    RETURN v_cod_tra_padre;
  END;
  -- obtiene los datos (campos) de un registros seguen formato de importacion
  FUNCTION fu_obt_dato(p_for_archivo in varchar2,
                       p_nom_tabla   in varchar2,
                       p_registro    in varchar2,
                       p_campo       in varchar2) return varchar2 is
    v_retorno       varchar2(200);
    v_tip_dato      varchar2(100);
    v_formato       varchar2(100);
    v_pos_inicial   number(8);
    v_longitud      number(8);
    v_separador     varchar2(1);
    v_nro_secuencia number(8);
    v_pos_final     number(8);
    v_funcion       varchar2(100);
    v_sentencia     varchar2(1000);
    v_can_decimales number(3);

  begin

    BEGIN
      select separador
      into v_separador
      from ge_archivos
     where referencia = p_for_archivo
       and rownum = 1;
       EXCEPTION
         WHEN NO_DATA_FOUND THEN
           v_separador := null;
    END;

    select tip_dato,
           formato,
           pos_inicial,
           longitud,
           nro_secuencia,
           funcion,
           pos_decimal
      into v_tip_dato,
           v_formato,
           v_pos_inicial,
           v_longitud,
           v_nro_secuencia,
           v_funcion,
           v_can_decimales

      from ge_arc_campos
     where referencia = p_for_archivo
       and nom_tabla = p_nom_tabla
       and campo = p_campo;
    if v_separador is null then
      v_retorno := substr(p_registro, v_pos_inicial, v_longitud);
    else
      -- no tiene formato fijo, se busca
      v_pos_inicial := instr(p_registro,
                             v_separador,
                             1,
                             v_nro_secuencia - 1) + 1;
      v_pos_final   := instr(p_registro, v_separador, 1, v_nro_secuencia);
      if v_pos_inicial = 0 then
        raise_application_error(-20056,
                                'No encuentro el separador nro ' ||
                                v_nro_secuencia || ' en ' || p_registro);
      elsif v_pos_final = 0 then
        v_pos_final := length(p_registro);
      end if;
      v_longitud := v_pos_final - v_pos_inicial;
      v_retorno  := substr(p_registro, v_pos_inicial, v_longitud);

    end if;
    if v_tip_dato = 'VARCHAR2' then
      v_retorno := trim(v_retorno);
    elsif v_tip_dato = 'NUMBER' then
      v_retorno := replace(trim(v_retorno), ',', '.');
      if instr(v_retorno, '.') = 0 and v_can_decimales > 0 then
        if instr(v_retorno, '-') > 0 then
          v_retorno := (nvl(to_number(replace(v_retorno, '-', '')), 0)) /
                       (power(10, v_can_decimales));
          v_retorno := v_retorno * (-1);
        else
          v_retorno := (nvl(to_number(v_retorno), 0)) /
                       (power(10, v_can_decimales));
        end if;
      else
        if instr(v_retorno, '-') > 0 then
          v_retorno := nvl(to_number(replace(v_retorno, '-', '')), 0);
          v_retorno := v_retorno * (-1);
        else
          v_retorno := nvl(to_number(v_retorno), 0);
        end if;
      end if;
    elsif v_tip_dato = 'DATE' then
      v_retorno := to_char(to_date(v_retorno, v_formato), 'dd/mm/yyyy');
    end if;
    if v_funcion is not null then
      -- se procesa el dato
      v_sentencia := 'begin :r := ' ||
                     replace(v_funcion, '$param', '''' || v_retorno || '''') ||
                     '; end;';
      v_retorno   := trim(sql_util.ejecute_funcion(v_sentencia));
    end if;

    return v_retorno;
  exception
    when others then
      return null;
  end;

FUNCTION fu_ver_operacion(p_nro_cuenta      in ge_cuentas.nro_cuenta%type,
                              p_monto           in ge_movimientos.monto%type,
                              p_cod_transaccion in ge_movimientos.cod_transaccion%type,
                              p_cod_tra_padre   in ge_movimientos.cod_tra_padre%type,
                              p_tip_movimiento  in varchar2) return varchar2 is
      v_cod_modulo     ge_cuentas.cod_modulo%type;
      v_cod_modalidad  ge_cuentas.cod_modalidad%type;
      v_cod_oficina    ge_cuentas.cod_oficina%type;
      v_cod_moneda     ge_cuentas.cod_moneda%type;
      v_procesa        varchar2(1) := 'N';
      v_nvo_estado     varchar2(1) := null;
      v_sal_disponible ge_movimientos.monto%type;
    begin
      -- obtenemos los datos de la cuenta
      select cod_modulo, cod_modalidad, cod_oficina, cod_moneda
        into v_cod_modulo, v_cod_modalidad, v_cod_oficina, v_cod_moneda
        from ge_cuentas
       where nro_cuenta = p_nro_cuenta;
      -- verificamos si la operacion se puede realizar
      pag_cta.pr_ver_operacion(p_nro_cuenta,
                               p_cod_tra_padre,
                               v_cod_modulo,
                               v_cod_modalidad,
                               p_tip_movimiento,
                               v_cod_moneda,
                               p_monto,
                               v_cod_oficina,
                               v_cod_modulo,
                               v_cod_modalidad,
                               v_nvo_estado,
                               v_sal_disponible,
                               v_procesa,
                               p_cod_transaccion);
      return v_procesa;
    exception
      when others then
        return 'N';
   end;


   FUNCTION fu_val_per_pendiente(p_nro_documento in bw_mov_pendientes.nro_documento%type,
                                p_cod_persona   in ge_clientes.cod_persona%type)
    return varchar2 is
    v_sino varchar2(1);
    begin
      begin
        select 'S'
        into v_sino
        from bw_mov_pendientes
        where nro_documento = p_nro_documento
         and cod_per_principal = p_cod_persona
         and trunc(fec_insercion) = trunc(sysdate);
      exception
    when no_data_found then
      v_sino := 'N';
    when others then
      v_sino := 'N';
      end;
      return v_sino;
    end;

  -- Funcion para saber que solicitar al autorizador (clave transaccional y/o token o nada).
  FUNCTION fu_obt_aut_limite(p_cod_empresa   in bw_mov_pendientes.cod_per_principal%type,
                           p_nro_documento in bw_mov_pendientes.nro_documento%type)
   return varchar2 is
    v_res_limite    varchar2(2);
    v_tip_mensaje   bw_mov_pendientes.cod_tip_mensaje%type;
    v_nro_cuenta    bw_mov_pendientes.nro_cuenta%type;
    v_cod_moneda    bw_mov_pendientes.cod_moneda%type;
    v_dato          bw_mov_pendientes.dato%type;
    v_cod_tra_padre ge_movimientos.cod_tra_padre%type;
    v_cod_ente      ge_entes.cod_ente%type;
  begin
   -- obtenemos los datos del movimiento pendiente
   SELECT cod_tip_mensaje, nro_cuenta, cod_moneda, dato
     INTO v_tip_mensaje, v_nro_cuenta, v_cod_moneda, v_dato
     FROM bw_mov_pendientes
    WHERE nro_documento = p_nro_documento
      AND cod_per_principal = p_cod_empresa
      AND estado = 'P';
    -- obtenemos la transaccion padre de la operacion donde se controla el limite
     CASE v_tip_mensaje
        WHEN '030' THEN -- transferencias a cuentas propias
           v_cod_tra_padre := 388;
        WHEN '031' THEN -- pago de Prestamos
           v_cod_tra_padre := 360;
        WHEN '032' THEN -- pago de tarjetas de Credito
           v_cod_tra_padre := 250;
        WHEN '033' THEN -- pagos aduaneros
           v_cod_tra_padre := 219;
        WHEN '036' THEN -- transferencias interbancarias
           v_cod_tra_padre := 303;
        WHEN '039' THEN -- transferencias a otros titulares
           v_cod_tra_padre := 388;
        WHEN '082' THEN -- pago de servicios
           v_cod_tra_padre := 485;
        WHEN '070' THEN -- pago de salarios
           v_cod_tra_padre := 303;
        WHEN '075' THEN -- pago proveedores
           v_cod_tra_padre := fug_obt_parentes(v_cod_ente, 'COD_TRA_PAD_PPROV');
        WHEN '214' THEN -- transferencias de cambio pre-pactadas
           v_cod_ente      := null;
           v_cod_tra_padre := 388;
        ELSE
           v_cod_tra_padre := -1; -- no es una operacion que controla limite
     end case;

     if v_cod_tra_padre = -1 then
        v_res_limite := '00';
     end if;

     return v_res_limite;
  exception
     when others then
      return '00';
  end;
  FUNCTION fu_obtenerDetalleAutorizacion(p_sesion          IN VARCHAR2,
                                          p_codigoCanal     IN VARCHAR2,
                                          p_numeroDocumento IN bw_mov_pendientes.nro_documento%TYPE,
                                          p_estado          IN VARCHAR2 DEFAULT 'P',
                                          p_fecha           IN DATE DEFAULT NULL) RETURN typ_detalleAutorizacion IS----NVB-2232
      --devuelve los datos del movimiento pendiente de autorizar en formato html para imprimir en la web
      v_cod_per_principal     bw_mov_pendientes.cod_per_principal%TYPE;
      v_fec_hora              bw_mov_pendientes.fec_hora%TYPE;
      v_cod_tip_mensaje       bw_mov_pendientes.cod_tip_mensaje%TYPE;
      v_descripcion           bw_mov_pendientes.descripcion%TYPE;
      v_monto                 bw_mov_pendientes.monto%TYPE;
      v_mto_cargo             bw_mov_pendientes.mto_cargo%TYPE;
      v_mto_iva               bw_mov_pendientes.mto_iva%TYPE;
      v_cotizacion            bw_mov_pendientes.cotizacion%TYPE;
      v_equ_local             bw_mov_pendientes.mto_equ_local%TYPE;
      v_cot_contra            bw_mov_pendientes.cot_contra%TYPE;
      v_mto_contra            bw_mov_pendientes.mto_contra%TYPE;
      v_estado                bw_mov_pendientes.estado%TYPE;
      v_can_aut_requeridas    bw_mov_pendientes.can_aut_requeridas%TYPE;
      v_can_aut_faltantes     bw_mov_pendientes.can_aut_faltantes%TYPE;
      v_etiqueta              bw_mov_pendientes.etiqueta%TYPE;
      v_dato                  bw_mov_pendientes.dato%TYPE;
      v_etiqueta2             bw_mov_pendientes.etiqueta2%TYPE;
      v_dato2                 bw_mov_pendientes.dato2%TYPE;
--UES-60
      v_etiqueta3             bw_mov_pendientes.etiqueta2%TYPE;
      v_dato3                 bw_mov_pendientes.dato2%TYPE;
      v_cod_per_ingreso       bw_mov_pendientes.cod_per_ingreso%TYPE;
      v_tip_pago              bw_mov_pendientes.tip_pago%TYPE;
      v_fec_insercion         bw_mov_pendientes.fec_insercion%TYPE;
      v_cod_moneda            ge_movimientos.cod_moneda%TYPE;
      v_cta_formateada        VARCHAR2(20);
      v_cta_contra_formateada bw_mov_pendientes.nro_cta_contra%TYPE;
      v_nro_cuenta            ge_movimientos.nro_cuenta%TYPE;
      v_cta_contra            bw_mov_pendientes.nro_cta_contra%TYPE;
      v_cantidad              bw_mov_pendientes.cantidad%TYPE; --NUMBER;
      --v_existe                VARCHAR2(1);
      v_des_tip_mensaje       bw_tip_mensajes.descripcion%TYPE;
      v_nro_tarjeta           ta_tarjetas.nro_tarjeta%TYPE;
      v_nro_tar_contra        ta_tarjetas.nro_tarjeta%TYPE;
      v_cod_mod_contra        ge_cuentas.cod_modulo%TYPE;
      v_cod_mad_contra        ge_cuentas.cod_modalidad%TYPE;
      v_cod_ofi_contra        ge_cuentas.cod_oficina%TYPE;
      v_cod_mon_contra        ge_cuentas.cod_moneda%TYPE;
      v_denominacion          ge_cuentas.denominacion%TYPE;
      v_tip_pro_sueldo        VARCHAR2(1) := NULL;
      v_referencia            bw_mov_pendientes.referencia%TYPE;
      v_fec_actual            DATE; -- fecha de hoy;
      v_fec_ins_movimiento    date;
      v_retorno               typ_detalleAutorizacion:= typ_detalleAutorizacion();--NVB-2232
      v_usu_sesion            typ_validarSesion;
      v_msj_caja              typ_mensajeCaja;
      v_permiso               typ_obtenerPermisos;
      v_fec_proceso           DATE;
      v_est_periodo           ge_snp_horarios.estado%TYPE;

      -- movimientos pendientes de sueldos
      CURSOR c_sue_pendientes(p_cod_ente IN NUMBER, p_nro_archivo IN NUMBER, p_fec_pago IN DATE) IS
         SELECT x.nro_cuenta, substr(z.denominacion, 1, 40) denominacion, nvl(x.cod_moneda, v_cod_moneda) cod_moneda, x.monto, x.fec_proceso
           FROM ge_cuentas z, ge_pag_sueldos_tmp x
          WHERE x.cod_ente = p_cod_ente
            AND trunc(x.fec_proceso) = trunc(p_fec_pago)
            AND x.estado = 'H'
            AND x.tipo = 'C'
            AND nvl(x.nro_archivo, 0) = nvl(p_nro_archivo, 0)
            AND to_char(x.nro_cuenta) = z.nro_cuenta;
      -- movimientos confirmados de sueldos
      CURSOR c_sue_confirmados(p_cod_ente IN NUMBER, p_nro_archivo IN NUMBER, p_fec_proceso IN DATE) IS
         SELECT x.nro_cuenta, substr(z.denominacion, 1, 40) denominacion, nvl(x.cod_moneda, v_cod_moneda) cod_moneda, x.monto, x.fec_proceso
           FROM ge_cuentas z, ge_pag_sueldos x
          WHERE x.cod_ente = p_cod_ente
            AND trunc(x.fec_proceso) = trunc(p_fec_proceso)
            AND x.estado = 'N'
            AND x.tipo = 'C'
            AND x.procesado = 'S'
            AND nvl(x.nro_secuencia, 0) = nvl(p_nro_archivo, 0)
            AND to_char(x.nro_cuenta) = z.nro_cuenta;
      -- movimientos pendientes de proveedores
      CURSOR c_pro_pendientes(p_cod_ente IN NUMBER, p_nro_archivo in number, p_fec_insercion in date) IS
         SELECT x.nro_orden, x.nro_factura, x.ref_facturas, x.for_pago, nvl(substr(z.denominacion, 1, 40), x.beneficiario) denominacion, nvl(x.cod_moneda, v_cod_moneda) cod_moneda, x.monto, x.nro_cta_credito,
                x.cod_tip_doc_beneficiario, x.nro_doc_beneficiario, x.nro_cta_beneficiario, x.ent_bca_beneficiario, x.ind_valor, x.fec_pago, x.cod_swift
           FROM ge_cuentas z, ge_pag_proveedores_tmp x
          WHERE x.cod_ente = p_cod_ente
            --AND trunc(x.fec_insercion) = trunc(p_fec_insercion)
            AND x.tip_carga = 'H'
            AND x.cod_usu_operador IN (/*v_msj_caja.codigoUsuario*/'HBANKJ','HBANKF')
            AND x.nro_cta_credito = z.nro_cuenta(+)
            and nvl(x.nro_archivo, 0) = nvl(p_nro_archivo, 0)
            order by x.nro_ord_archivo asc;
      -- movimientos confirmados de proveedores
      CURSOR c_pro_pagados(p_cod_ente IN ge_pag_proveedores.cod_ente%TYPE, p_nro_archivo in number, p_fec_insercion in date) IS
         SELECT x.nro_ord_archivo,x.nro_orden, x.nro_factura, x.ref_facturas, x.for_pago, nvl(substr(z.denominacion, 1, 40), x.beneficiario) denominacion, nvl(x.cod_moneda, v_cod_moneda) cod_moneda, x.monto, x.nro_cta_credito,
                x.cod_tip_doc_beneficiario, x.nro_doc_beneficiario, x.nro_cta_beneficiario, x.ent_bca_beneficiario, x.ind_valor, x.fec_pago, x.cod_swift,null situacion, null estado
           FROM ge_cuentas z, ge_pag_proveedores x
          WHERE x.cod_ente = p_cod_ente
             --AND trunc(x.fec_insercion) = trunc(p_fec_insercion)
            --AND trunc(x.fec_ingreso) = trunc(v_fec_actual)
           -- AND x.fec_pago = p_fec_pago
            AND x.tip_carga = 'H'
            AND x.cod_usu_operador IN (/*v_msj_caja.codigoUsuario,*/'HBANKJ','HBANKF')
            AND x.for_pago !='I'
            AND x.nro_cta_credito = z.nro_cuenta(+)
            AND x.referencia = p_numeroDocumento
            and nvl(x.nro_archivo, 0) = nvl(p_nro_archivo, 0)
         UNION ALL
         SELECT x.nro_ord_archivo,x.nro_orden, x.nro_factura, x.ref_facturas, x.for_pago, nvl(substr(z.denominacion, 1, 40), x.beneficiario) denominacion, nvl(x.cod_moneda, v_cod_moneda) cod_moneda, x.monto, x.nro_cta_credito,
                x.cod_tip_doc_beneficiario, x.nro_doc_beneficiario, x.nro_cta_beneficiario, x.ent_bca_beneficiario, x.ind_valor, x.fec_pago, x.cod_swift, fue_obt_des_refcodes('SITUACION',t.situacion) situacion,
               fue_obt_des_refcodes('EST_MSJ_SNP',t.estado) estado
           FROM ge_cuentas z, ge_pag_proveedores x,ge_snp_transferencias t
          WHERE x.cod_ente = p_cod_ente
            AND trunc(x.fec_insercion) = trunc(p_fec_insercion)
            --AND trunc(x.fec_ingreso) = trunc(v_fec_actual)
            --AND x.fec_pago = p_fec_pago
            AND x.tip_carga = 'H'
            AND x.for_pago ='I'
            AND x.cod_usu_operador IN (/*v_msj_caja.codigoUsuario,*/'HBANKJ','HBANKF')
            AND x.nro_cta_credito = z.nro_cuenta(+)
            AND x.referencia = p_numeroDocumento
            AND x.nro_documento=t.nro_referencia
            AND nvl(x.nro_archivo, 0) = nvl(p_nro_archivo, 0)
            order by 1 asc;
      -- recaudaciones temporales
      CURSOR c_rec_pendientes(p_cod_ente IN NUMBER, p_nro_archivo IN NUMBER) IS
         SELECT t.fec_operacion, t.nro_cta_debito, t.denominacion, t.nro_cta_credito, t.monto,
                t.nro_factura, t.tip_cobranza, NULL descripcion, 0 cod_error, 'Aprobado' msj_error, nvl(t.estado, 'P') estado
           FROM ge_pag_recaudaciones_tmp t
          WHERE t.cod_ente = p_cod_ente
            AND t.nro_archivo = p_nro_archivo
            AND nvl(t.estado, 'x') <> 'E'
            AND trunc(t.fec_insercion) = trunc(SYSDATE)
          UNION
         SELECT t.fec_operacion, t.nro_cta_debito, t.denominacion, t.nro_cta_credito, t.monto,
                t.nro_factura, t.tip_cobranza, NULL descripcion, e.cod_error, e.msj_error, t.estado
           FROM ge_pag_recaudaciones_tmp t, ge_pag_recaudaciones_err e
          WHERE t.cod_ente = p_cod_ente
            AND t.nro_archivo = p_nro_archivo
            AND nvl(t.estado, 'x') = 'E'
            AND trunc(t.fec_insercion) = trunc(SYSDATE)
            AND e.cod_ente = t.cod_ente
            AND e.nro_archivo = t.nro_archivo
            AND e.nro_cta_debito = t.nro_cta_debito
            AND e.nro_cta_credito = t.nro_cta_credito
            AND e.monto = t.monto
            AND trunc(e.fec_insercion) = trunc(t.fec_insercion);
      -- recaudaciones confirmadas
      CURSOR c_rec_procesadas(p_cod_ente IN NUMBER, p_nro_archivo IN NUMBER) IS
         SELECT t.fec_operacion, t.nro_cta_debito, t.denominacion, t.nro_cta_credito, t.monto, t.nro_documento,
                t.nro_factura, t.tip_cobranza, NULL descripcion, 0 cod_error, 'Aprobado' msj_error, t.estado
           FROM ge_pag_recaudaciones t
          WHERE t.cod_ente = p_cod_ente
            AND t.nro_archivo = p_nro_archivo
            AND nvl(t.estado, 'x') <> 'E'
            AND trunc(t.fec_insercion) = trunc(v_fec_actual)
          UNION
         SELECT t.fec_operacion, t.nro_cta_debito, t.denominacion, t.nro_cta_credito, t.monto, t.nro_documento,
                t.nro_factura, t.tip_cobranza, NULL descripcion, e.cod_error, e.msj_error, t.estado
           FROM ge_pag_recaudaciones t, ge_pag_recaudaciones_err e
          WHERE t.cod_ente = p_cod_ente
            AND t.nro_archivo = p_nro_archivo
            AND nvl(t.estado, 'x') = 'E'
            AND trunc(t.fec_insercion) = trunc(v_fec_actual)
            AND e.cod_ente = t.cod_ente
            AND e.nro_archivo = t.nro_archivo
            AND e.nro_cta_debito = t.nro_cta_debito
            AND e.nro_cta_credito = t.nro_cta_credito
            AND e.monto = t.monto
            AND trunc(e.fec_operacion) = trunc(t.fec_operacion);

     --Pendientes de Gourmet Card
     CURSOR c_acr_gourmet(p_cod_per_empresa IN VARCHAR2,p_nro_archivo in VARCHAR2) IS
       SELECT p.nom_completo, t.nro_tarjeta, g.monto, g.nro_documento, g.fec_recepcion
        FROM bw_mov_pendientes m, ta_acr_gourmet_tmp g, ta_tarjetas t, ba_personas p
       WHERE m.cod_tip_mensaje = '071'
         AND m.cod_per_principal = p_cod_per_empresa
         AND m.dato2 = g.cod_ente
         AND m.dato = g.nro_archivo
         AND m.nro_documento = p_numeroDocumento
         AND t.nro_tarjeta = g.nro_tarjeta
         AND p.cod_persona = t.cod_persona
         AND trunc(m.fec_insercion) = trunc(g.fec_insercion)
         AND trunc(g.fec_insercion)=trunc(sysdate);

     --Procesados de Gourmet Card
     CURSOR c_acr_gourmet_proc(p_cod_per_empresa IN VARCHAR2,p_nro_archivo in VARCHAR2) IS
     SELECT p.nom_completo, t.nro_tarjeta, g.monto, g.nro_documento, g.fec_recepcion
        FROM bw_mov_pendientes m, ta_acr_gourmet g, ta_tarjetas t, ba_personas p
       WHERE m.cod_tip_mensaje = '071'
         AND m.cod_per_principal = p_cod_per_empresa
         AND m.dato2 = g.cod_ente
         AND m.dato = g.nro_archivo
         AND m.nro_documento = p_numeroDocumento
         AND t.nro_tarjeta = g.nro_tarjeta
         AND trunc(m.fec_insercion) = trunc(g.fec_insercion)
         AND p.cod_persona = t.cod_persona;

      --detalle altas -- DYDMR-6437 -- 05/2017 -- Se modifica el cursor
      CURSOR c_alt_empleados(p_cod_ente IN NUMBER, p_nro_archivo IN NUMBER) IS
         SELECT distinct a.nro_cedula, a.tip_documento, a.pri_nombre, a.seg_nombre, a.pri_apellido,
                a.nro_lote, fec_nacimiento,
                case
                  when ( ( nvl(a.error,'x') like '%Cliente%ya%posee%CTA%asignada%Empresa%'
                         or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Ente%'
                         or a.error like '%Cliente%ya%posee%CTA%para%Sub%Modalidad%' )
                       and ( nvl(a.error,'x') not like '%Cliente inhibido para CTA CTE. Se ha creado una CTA. AV.%' ) ) then
                    null
                  else
                    a.error
                end error,
                a.fec_vto_documento, a.doc_pais,
                a.seg_apellido, a.sexo, a.est_civil, a.direccion, a.ciudad, a.pais,
                a.telefono, a.celular, a.mail, a.ape_casada, a.cod_pai_fatca, a.dir_fiscal,
                a.cod_pai_fiscal, a.sueldo, a.profesion, a.fec_ingreso,
                a.tip_contrato, a.direc_kit,
                case
                  when ( ( nvl(a.error,'x') like '%Cliente%ya%posee%CTA%asignada%Empresa%'
                         or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Ente%'
                         or a.error like '%Cliente%ya%posee%CTA%para%Sub%Modalidad%' )
                       and ( nvl(a.error,'x') not like '%Cliente inhibido para CTA CTE. Se ha creado una CTA. AV.%' ) ) then
                    'N'
                  else
                    a.estado
                end estado,
                c.nro_documento as nro_operacion,
                trunc(c.fec_insercion) as fec_insercion, a.nro_cuenta, a.fec_insercion fec_proceso
           FROM ge_pag_sue_emp a
           inner join ge_alt_empleados c on c.cod_ente = a.cod_empresa and c.nro_lote = a.nro_lote
          WHERE a.cod_empresa = p_cod_ente
            AND a.nro_lote = p_nro_archivo
            AND a.fec_insercion = (select min(fec_insercion) from ge_pag_sue_emp p
                            where p.cod_empresa = a.cod_empresa
                              and p.nro_lote = a.nro_lote
                              and p.nro_cedula = a.nro_cedula
                              and p.tip_documento = a.tip_documento
                              and p.pri_nombre = a.pri_nombre
                          )
            AND nvl(a.error,'x') not like '%persona%mismo%Doc%Pri%Nom%Pri%Ape%'
          UNION
         SELECT distinct a.nro_cedula, a.tip_documento, a.pri_nombre, a.seg_nombre, a.pri_apellido,
                a.nro_lote, fec_nacimiento, a.error, a.fec_vto_documento, a.doc_pais,
                a.seg_apellido, a.sexo, a.est_civil, a.direccion, a.ciudad, a.pais,
                a.telefono, a.celular, a.mail, a.ape_casada, a.cod_pai_fatca, a.dir_fiscal,
                a.cod_pai_fiscal, a.sueldo, a.profesion, a.fec_ingreso,
                a.tip_contrato, a.direc_kit,
                case
                  when ( ( nvl(a.error,'x') like '%Cliente%ya%posee%CTA%asignada%Empresa%'
                             or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Ente%'
                             or nvl(a.error,'x') like '%Cliente%ya%posee%CTA%para%Sub%Modalidad%' )
                          and ( nvl(a.error,'x') not like '%Cliente inhibido para CTA CTE. Se ha creado una CTA. AV.%' ) ) then
                    'C'
                  else
                    a.estado
                end estado,
                c.nro_documento as nro_operacion,
                trunc(c.fec_insercion) as fec_insercion, null as nro_cuenta, null as fec_proceso
           FROM ge_pag_sue_emp_tmp a
           LEFT JOIN ge_alt_empleados c on (c.cod_ente = a.cod_empresa and c.nro_lote = a.nro_lote)
          WHERE a.cod_empresa = p_cod_ente
            AND a.nro_lote = p_nro_archivo
            AND a.fec_insercion = (select min(fec_insercion) from ge_pag_sue_emp_tmp p
                            where p.cod_empresa = a.cod_empresa
                              and p.nro_lote = a.nro_lote
                              and p.nro_cedula = a.nro_cedula
                              and p.tip_documento = a.tip_documento
                              and p.pri_nombre = a.pri_nombre
                          )
            AND nvl(a.error,'x') not like '%persona%mismo%Doc%Pri%Nom%Pri%Ape%';
      --detalles de autorizaciones
      CURSOR detalles IS
         SELECT a.cod_persona, a.fec_hora, decode(a.accion, 'A', 'Autorizado', 'B', 'Eliminado', 'Rechazado') accion, a.observacion, b.nom_completo nombre
           FROM ba_personas b, bw_autorizaciones a
          WHERE a.nro_documento = p_numeroDocumento
            AND a.cod_persona = b.cod_persona
       ORDER BY fec_hora;
       
       --PDSYP-449
       cursor c_log_movpendientes(p_nro_documento it.bw_log_movpendientes.nro_documento%type) is
       select c.det_error
       from it.bw_log_movpendientes c
       where c.nro_documento = p_nro_documento
       order by c.fec_insercion desc;
       
   BEGIN
      v_retorno.error := 'N';
      v_fec_actual := nvl(p_fecha, trunc(sysdate));--pag_cal.fu_obt_fec_actual(9));
      -- 1. valido la clave del cliente
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error := 'S';
         v_retorno.descripcionError := 'Sesion invalida';
         RETURN v_retorno;
      END IF;
      -- 2. verifica el canal de origen
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error := 'S';
         v_retorno.descripcionError := 'Terminal invalida';
         RETURN v_retorno;
      END IF;
      -- 3. verifico si el cliente con su perfil tendrá acceso a consultar el detalle
      v_permiso := lf_obt_permisos(v_usu_sesion, '024');
      IF (v_permiso.error = 'S') THEN
         v_retorno.descripcionError := v_permiso.descripcionRespuesta;
         v_retorno.error            := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, '024', v_usu_sesion.codigoEmpresa, 'obtenerDetalleAutorizacion ', BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      DECLARE
        v_sino VARCHAR2(1);
      BEGIN
         SELECT 'S'
           INTO v_sino
           FROM bw_mov_pendientes p
          WHERE p.nro_documento = p_numeroDocumento
            AND p.cod_per_principal = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona);
      EXCEPTION
         WHEN TOO_MANY_ROWS THEN
            NULL;
         WHEN OTHERS THEN
            v_retorno.error := 'S';
            v_retorno.descripcionError := 'Documento invalido';
            RETURN v_retorno;
      END;
      --recupera el movimiento principal
      BEGIN
         SELECT a.tip_pago, a.fec_insercion, cod_per_principal, fec_hora, a.cod_tip_mensaje, b.descripcion, nro_cuenta, cod_moneda, a.descripcion, monto, nvl(mto_cargo, 0), nvl(mto_iva, 0), cotizacion, mto_equ_local, cantidad, nro_cta_contra, estado, can_aut_requeridas, can_aut_faltantes, etiqueta, dato, cod_per_ingreso, decode(a.nro_cuenta, NULL, NULL, fug_cta_formateada(NULL, NULL, NULL, a.nro_cuenta, a.cod_moneda)), decode(a.nro_cta_contra, NULL, NULL, fug_cta_formateada(NULL, NULL, NULL, a.nro_cta_contra, NULL)),
                a.cot_contra, a.mto_contra, a.etiqueta2, a.dato2, a.referencia,a.fec_insercion,a.etiqueta7,a.dato7
           INTO v_tip_pago, v_fec_insercion, v_cod_per_principal, v_fec_hora, v_cod_tip_mensaje, v_des_tip_mensaje, v_nro_cuenta, v_cod_moneda, v_descripcion, v_monto, v_mto_cargo, v_mto_iva, v_cotizacion, v_equ_local, v_cantidad, v_cta_contra, v_estado, v_can_aut_requeridas, v_can_aut_faltantes, v_etiqueta, v_dato, v_cod_per_ingreso, v_cta_formateada, v_cta_contra_formateada, v_cot_contra, v_mto_contra, v_etiqueta2, v_dato2, v_referencia,v_fec_ins_movimiento, v_etiqueta3, v_dato3
           FROM bw_tip_mensajes b, bw_mov_pendientes a
          WHERE a.nro_documento = p_numeroDocumento
            AND a.cod_tip_mensaje = b.cod_tip_mensaje;
      EXCEPTION
         WHEN no_data_found THEN
            v_retorno.error := 'S';
            v_retorno.descripcionError := 'No existe Movimiento Pendiente. Avise al Oficial';
            -- v_error := 'No existe Movimiento Pendiente. Avise al Oficial.';
         WHEN too_many_rows THEN
            v_retorno.error := 'S';
            v_retorno.descripcionError := 'Varios Movimientos con el mismo criterio. Avise al Oficial';
            -- v_error := 'Varios Movimientos con el mismo criterio. Avise al Oficial.';
         WHEN OTHERS THEN
            v_retorno.error := 'S';
            v_retorno.descripcionError := 'No se puede recuperar Mov.Pendiente ' || p_numeroDocumento;
            --v_error := 'No se puede recuperar Mov.Pendiente ' || p_nro_documento || SQLERRM;
      END;

      IF v_nro_cuenta IS NOT NULL THEN
         --recuperar datos de la cuenta, pag_cta porque es 3 o 4
         pag_cta.PR_OBT_CUENTA(v_nro_cuenta);
         IF PAG_CTA.FU_OBT_COD_ERROR() <> 0 THEN
            v_retorno.error := 'S';
            v_retorno.descripcionError := substr('Recup.Cta ' || pag_cta.fu_obt_msj_error(), 1, 200);
            -- v_error := 'Recup.Cta ' || pag_cta.fu_obt_msj_error();
         END IF;
         IF pag_cta.G_CTAS.cod_modulo = 5 THEN
            --tarjeta
            v_nro_tarjeta := fut_for_tarjeta(fut_obt_nro_tarjeta(v_nro_cuenta));
         ELSE
            v_nro_tarjeta := NULL;
         END IF;
      END IF;
      --recuperar datos de la cuenta contrapartida, no usa pag_cta porque puede ser préstamo
      --se excluyen las transferencias internacionales porque el dato ahí es solo informativo
      IF v_cta_contra IS NOT NULL AND v_cod_tip_mensaje <> '227' AND v_cod_tip_mensaje <> '055' THEN
         BEGIN
            SELECT a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.cod_moneda, denominacion
              INTO v_cod_mod_contra, v_cod_mad_contra, v_cod_ofi_contra, v_cod_mon_contra, v_denominacion
              FROM ge_cuentas a
             WHERE a.nro_cuenta = v_cta_contra;
         EXCEPTION
            WHEN OTHERS THEN
               v_retorno.error := 'S';
               v_retorno.descripcionError := substr('Error al recuperar cuentra contraparte ' || v_cta_contra, 1, 200);
               -- v_error := 'Recup.Cta Contrap. ' || SQLERRM;
         END;
      END IF;
      --BBVADES-2376
      IF v_cod_tip_mensaje = '070' THEN
         v_tip_pro_sueldo := nvl(fug_obt_parentes(v_dato, 'TIP_PRO_SUELDO'), 'O');

         -- si el pago es con fecha futura el pago sera tipo BATCH, independiente de la configuracion del ente
         IF TRUNC(to_date(v_dato2,'DD/MM/YYYY')) > TRUNC(v_fec_actual) THEN
            v_tip_pro_sueldo := 'B';
         END IF;

         IF v_tip_pago = 'A' THEN
            -- pagos de aguinaldo siempre online independientemente
            -- de la configuracion del ente
            v_tip_pro_sueldo := 'O';
         END IF;
      END IF;
      --Fin BBVADES-2376

      --si hubo error devolver el msj de error, sino imprimir comprobante
      IF v_retorno.error = 'N' THEN
         v_retorno.descripcionMensaje := substr(v_des_tip_mensaje, 1, 100);
         v_retorno.numeroComprobante := p_numeroDocumento;
         v_retorno.fechaOperacion := v_fec_hora;
         v_retorno.monedaPrincipal := substr(FUE_OBT_DES_MONEDA(v_cod_moneda), 1, 50);
         v_retorno.codigoMonedaPrincipal := substr(v_cod_moneda, 1, 3);

         IF v_nro_cuenta IS NOT NULL THEN
            v_retorno.cuentaPrincipal := substr(nvl(v_nro_tarjeta, v_cta_formateada) || ' - ' || pag_cta.FU_OBT_NOM_CUENTA, 1, 300);
            v_retorno.tipoCuenta := substr(fue_obt_titulo(fug_obt_des_modal(pag_cta.G_CTAS.cod_modulo, pag_cta.g_ctas.cod_modalidad)), 1, 50);
            v_retorno.oficinaPrincipal := substr(fue_obt_titulo(fue_obt_des_oficina(pag_cta.G_CTAS.COD_OFICINA)), 1, 100);
         END IF;
         v_retorno.montoPrincipal := v_monto;
         v_retorno.montoCargo := v_mto_cargo;
         v_retorno.montoIva := v_mto_iva;
         v_retorno.cotizacion := v_cotizacion;
         v_retorno.montoEquLocal := v_equ_local;
         v_retorno.codigoMovimiento := substr(v_cod_tip_mensaje, 1, 3);
         v_retorno.descripcionMovimiento := substr(v_descripcion, 1, 100);
         v_retorno.cantidad := v_cantidad;
         v_retorno.etiqueta := v_etiqueta;
         v_retorno.dato     := v_dato;
         v_retorno.etiqueta2 := v_etiqueta2;
         v_retorno.dato2     := v_dato2;
         v_retorno.tipPago     := v_tip_pago;
         --se excluyen las transferencias internacionales porque el dato ahí es solo informativo
        if v_cod_tip_mensaje = '089' then--solo enviar para pago de servicios
         v_retorno.etiqueta3 := v_etiqueta3;
         v_retorno.dato3     := v_dato3;
        end if;
   IF v_cta_contra IS NOT NULL AND v_cod_tip_mensaje <> '227' and v_cod_tip_mensaje <> '055' THEN
            IF v_cod_mod_contra = 5 THEN
               --tarjeta
               v_nro_tar_contra := trim(fut_for_tarjeta(fut_obt_nro_tarjeta(v_cta_contra)));
            ELSE
               v_nro_tar_contra := NULL;
            END IF;
            IF v_cod_mod_contra = 6 THEN
               v_retorno.etiquetaContra := substr('Nro. de Préstamo / Titular', 1, 100);
            ELSIF v_cod_mod_contra = 5 THEN
               v_retorno.etiquetaContra := substr('Nro. Cta. Tarjeta', 1, 100);
            ELSE
               v_retorno.etiquetaContra := substr('Cta. Contraparte', 1, 100);
            END IF;
            v_retorno.cuentaContra := substr(nvl(v_nro_tar_contra, v_cta_contra_formateada) || ' - ' || v_denominacion, 1, 300);
            v_retorno.tipoCuentaContra := substr(fue_obt_titulo(fug_obt_des_modal(v_cod_mod_contra, v_cod_mad_contra)), 1, 50);
            v_retorno.cotizacionContra   := v_cot_contra;
            v_retorno.codigoMonedaContra := substr(v_cod_mon_contra, 1, 3);
            v_retorno.montoContra        := v_mto_contra;
         ELSIF v_cod_tip_mensaje = '227' THEN
            DECLARE
               v_parametros bw_movimientos.parametros%TYPE;
            BEGIN
               SELECT parametros
                 INTO v_parametros
                 FROM bw_movimientos
                WHERE nro_documento = p_numeroDocumento
                  AND trunc(fec_hora) = trunc(v_fec_hora)
                  AND cod_per_principal = v_cod_per_principal
                  AND cod_tip_mensaje = v_cod_tip_mensaje;
               v_retorno.etiquetaContra := 'Beneficiario';
               v_retorno.cuentaContra := TRIM(substr(v_parametros, 421, 30)) || ' ~ ' || TRIM(substr(v_parametros, 1, 120));
               v_retorno.codigoMonedaContra := substr(v_parametros, 471, 3);
            EXCEPTION
               WHEN NO_DATA_FOUND THEN
                  NULL;
               WHEN OTHERS THEN
                  v_retorno.error := 'S';
                  v_retorno.descripcionError := substr('Error al recuperar cuentra contraparte ' || v_cta_contra, 1, 200);
            END;
            v_retorno.montoContra        := v_mto_contra;
            v_retorno.cotizacionContra   := v_cot_contra;
          ELSIF v_cod_tip_mensaje = '055' THEN
            v_retorno.cuentaContra := v_cta_contra;
            v_retorno.codigoMonedaContra := substr(trim(v_dato2), 1, 3);
            v_retorno.montoContra        := v_mto_contra;
            v_retorno.cotizacionContra   := v_cot_contra;
         END IF;
         v_retorno.nombreIngreso := substr(fue_obt_nom_persona(v_cod_per_ingreso), 1, 100);
         v_retorno.cantidadAutRequeridas := v_can_aut_requeridas;
         v_retorno.cantidadAutFaltantes := v_can_aut_faltantes;
         --detalles del movimiento
         IF v_cod_tip_mensaje = '070' AND (v_estado <> 'A' or p_estado IN ('P', 'E')) THEN
            --hay detalles de sueldos
            DECLARE
               v_lis_salario typ_listaDetalleSalario := typ_listaDetalleSalario();--NVB-2232
               v_det_salario typ_detalleSalario     := typ_detalleSalario();--NVB-2232
               v_pendiente      VARCHAR2(1)          := 'N';
            BEGIN
               v_retorno.tipoEnteSalario := v_tip_pro_sueldo;
               -- Movimientos confirmados para entes de tipo Batch y a Requerimiento aun puede estar en la
               -- tabla de temporales ya que pudo no procesarse aun el pago
               IF p_estado <> 'P' THEN
                  IF v_tip_pro_sueldo IN ('B', 'R') AND v_estado = 'C' THEN
                     FOR reg IN c_sue_pendientes(v_dato, v_referencia, to_date(v_dato2, 'DD/MM/YYYY')) LOOP
                        v_pendiente := 'S';
                        EXIT;
                     END LOOP;
                  END IF;
               ELSE
                  v_pendiente := 'S';
               END IF;

               IF v_estado IN ('P', 'E') OR v_pendiente = 'S' THEN
                  v_retorno.estadoSalario := v_estado;
                  FOR reg IN c_sue_pendientes(v_dato, v_referencia, to_date(v_dato2, 'DD/MM/YYYY'))
                  LOOP
                     v_fec_proceso := reg.fec_proceso;
                     v_det_salario.numeroCuenta := reg.nro_cuenta;
                     v_det_salario.tipo := 'C';
                     v_det_salario.descripcionTipoCuenta := NULL;
                     v_det_salario.nombreCuenta := substr(reg.denominacion, 1, 50);
                     v_det_salario.codigoMoneda := reg.cod_moneda;
                     v_det_salario.monto := reg.monto;
                     v_det_salario.error := NULL;
                     v_det_salario.mensajeRespuesta := NULL;
                     v_lis_salario.extend;
                     v_lis_salario(v_lis_salario.count) := v_det_salario;
                  END LOOP;
               ELSIF v_estado = 'C' THEN
                  v_retorno.estadoSalario := 'C';
                  FOR reg IN c_sue_confirmados(v_dato, v_referencia, TO_DATE(v_dato2,'DD/MM/YYYY') )
                  LOOP
                     v_fec_proceso := reg.fec_proceso;
                     v_det_salario.numeroCuenta := reg.nro_cuenta;
                     v_det_salario.tipo := 'C';
                     v_det_salario.descripcionTipoCuenta := NULL;
                     v_det_salario.nombreCuenta := substr(reg.denominacion, 1, 50);
                     v_det_salario.codigoMoneda := reg.cod_moneda;
                     v_det_salario.monto := reg.monto;
                     v_det_salario.error := NULL;
                     v_det_salario.mensajeRespuesta := NULL;
                     v_lis_salario.extend;
                     v_lis_salario(v_lis_salario.count) := v_det_salario;
                  END LOOP;
               END IF;
               lp_obt_sue_errores(v_dato, v_referencia, v_lis_salario, v_fec_proceso);
               v_retorno.listaDetalleSalario := v_lis_salario;
               v_retorno.cantidadDetallesSalario := v_lis_salario.count;
            EXCEPTION
               WHEN OTHERS THEN
                  v_retorno.error := 'S';
                  v_retorno.descripcionError := 'Error al obtener detalles de creditos para salarios';
            END;
         END IF; -- find detalles
         --detalles del movimiento
         IF v_cod_tip_mensaje = '071' THEN
           DECLARE
               --Se reutilizan los types de salario para la respuesta de Gourmet Card
               v_lis_salario typ_listaDetalleSalario:= typ_listaDetalleSalario();--NVB-2232
               v_det_salario typ_detalleSalario      := typ_detalleSalario();--NVB-2232
               v_pendiente      VARCHAR2(1)          := 'N';
            BEGIN
               IF p_estado IN ('P', 'E') THEN
                  FOR c_gourmet IN c_acr_gourmet(v_usu_sesion.codigoEmpresa, v_dato)
                  LOOP
                      v_det_salario.fecha := c_gourmet.fec_recepcion;
                      v_det_salario.numeroCuenta := substr(c_gourmet.nro_tarjeta,4,16);
                      v_det_salario.tipo := 'C';
                      v_det_salario.descripcionTipoCuenta := c_gourmet.nro_tarjeta;
                      v_det_salario.nombreCuenta := substr(c_gourmet.nom_completo, 1, 50);
                      v_det_salario.monto := c_gourmet.monto;
                      v_det_salario.codigoMoneda := v_cod_mon_local;
                      v_det_salario.error := NULL;
                      v_det_salario.mensajeRespuesta := NULL;
                      v_lis_salario.extend;
                      v_lis_salario(v_lis_salario.count) := v_det_salario;
                  END LOOP;
               ELSE
                  FOR c_gourmet IN c_acr_gourmet_proc(v_usu_sesion.codigoEmpresa, v_dato)
                  LOOP
                      v_det_salario.fecha := c_gourmet.fec_recepcion;
                      v_det_salario.numeroCuenta := substr(c_gourmet.nro_tarjeta,4,16);
                      v_det_salario.tipo := 'C';
                      v_det_salario.descripcionTipoCuenta := c_gourmet.nro_tarjeta;
                      v_det_salario.nombreCuenta := substr(c_gourmet.nom_completo, 1, 50);
                      v_det_salario.monto := c_gourmet.monto;
                      v_det_salario.codigoMoneda := v_cod_mon_local;
                      v_det_salario.error := NULL;
                      v_det_salario.mensajeRespuesta := NULL;
                      v_lis_salario.extend;
                      v_lis_salario(v_lis_salario.count) := v_det_salario;
                  END LOOP;
               END IF;

              v_retorno.descripcionMensaje := substr(v_des_tip_mensaje, 1, 100);
               --pag_htm.PR_COLUMNA(v_des_tip_mensaje, NULL, 'center', 'S'); -- agrego la columna etiqueta
               v_retorno.numeroComprobante := p_numeroDocumento;
               --pag_htm.PR_COLUMNA(p_nro_documento); -- agrego la columna del nro de cuenta
               v_retorno.fechaOperacion := v_fec_hora;
               --pag_htm.PR_COLUMNA('Fecha:', 120, 'left', 'S'); -- agrego la columna etiqueta
               --pag_htm.PR_COLUMNA(to_char(v_fec_hora, 'dd/mm/yyyy - hh24:mi:ss')); -- agrego la columna del nro de cuenta
               v_retorno.cuentaPrincipal := substr(nvl(v_nro_tarjeta, v_cta_formateada) || ' - ' || pag_cta.FU_OBT_NOM_CUENTA, 1, 300);
               --pag_htm.PR_COLUMNA('Cuenta:', 120, 'left', 'S'); -- agrego la columna etiqueta
               --pag_htm.PR_COLUMNA(nvl(v_nro_tarjeta, v_cta_formateada) || ' - ' || pag_cta.FU_OBT_NOM_CUENTA, 310); -- agrego la columna del nro de cuenta
               v_retorno.tipoCuenta := substr(fue_obt_titulo(fug_obt_des_modal(pag_cta.G_CTAS.cod_modulo, pag_cta.g_ctas.cod_modalidad)), 1, 50);
               --pag_htm.PR_COLUMNA('Tipo:', 10, 'left', 'S');
               --pag_htm.PR_COLUMNA(fue_obt_titulo(fug_obt_des_modal(pag_cta.G_CTAS.cod_modulo, pag_cta.g_ctas.cod_modalidad)), NULL, 'left');
               v_retorno.monedaPrincipal := substr(FUE_OBT_DES_MONEDA(v_cod_moneda), 1, 50);
               v_retorno.oficinaPrincipal := substr(fue_obt_titulo(fue_obt_des_oficina(pag_cta.G_CTAS.COD_OFICINA)), 1, 100);
               v_retorno.codigoMonedaPrincipal := substr(v_cod_moneda, 1, 3);
               v_retorno.montoPrincipal := v_monto;
               v_retorno.montoCargo := v_mto_cargo;
               v_retorno.montoIva := v_mto_iva;
               v_retorno.cotizacion := v_cotizacion;
               v_retorno.montoEquLocal := v_equ_local;
               v_retorno.codigoMovimiento := substr(v_cod_tip_mensaje, 1, 3);
               v_retorno.descripcionMovimiento := substr(v_descripcion, 1, 100);
               v_retorno.cantidad := v_cantidad;
               v_retorno.etiqueta := v_etiqueta;
               v_retorno.dato     := v_dato;
               v_retorno.etiqueta2 := v_etiqueta2;
               v_retorno.dato2     := v_dato2;

               v_retorno.listaDetalleSalario := v_lis_salario;
               v_retorno.cantidadDetallesSalario := v_lis_salario.count;

           EXCEPTION
               WHEN OTHERS THEN
                  v_retorno.error := 'S';
                  v_retorno.descripcionError := 'Error al obtener detalles de creditos gourmet.';

            END;
         END IF;

         IF v_cod_tip_mensaje = '075' AND (v_estado <> 'A' or p_estado IN ('P', 'E', 'I')) THEN
            --hay detalles de proveedores
            DECLARE
               v_lis_proveedor typ_listadetalleproveedor := typ_listadetalleproveedor();
               v_det_proveedor typ_detalleproveedor := typ_detalleproveedor();
               v_fec_pago      DATE := to_date(substr(v_dato2, 1, 10), 'dd/mm/yyyy');
               v_cam_fecha     BOOLEAN := FALSE;
               v_cta_snp       VARCHAR2(1) := 'N';
               v_cta_bbva      VARCHAR2(1) := 'N';
            BEGIN
               IF v_estado IN ('P', 'I') OR p_estado IN ('P', 'E', 'I') THEN
                  v_retorno.estadoProveedor := v_estado;
                  FOR reg IN c_pro_pendientes(v_dato, v_referencia,v_fec_ins_movimiento)
                  LOOP
                     v_det_proveedor.numeroOrden := reg.nro_orden;
                     v_det_proveedor.numeroFactura := substr(reg.nro_factura, 1, 20);
                     v_det_proveedor.formaPago := reg.for_pago;
                     v_det_proveedor.fechaPago := reg.fec_pago;
                     v_det_proveedor.numeroComprobante := NULL;
                     v_det_proveedor.numeroCuentaCredito := reg.nro_cta_credito;
                     v_det_proveedor.montoCredito := reg.monto;
                     v_det_proveedor.nombreBeneficiario := substr(reg.denominacion, 1, 60);
                     v_det_proveedor.codigoMoneda := reg.cod_moneda;
                     v_det_proveedor.concepto := NULL;
                     v_det_proveedor.codigoProceso := NULL;
                     v_det_proveedor.referenciaFacturas := substr(reg.ref_facturas, 1, 300);
                     v_det_proveedor.numeroBanco := reg.ent_bca_beneficiario;
                     v_det_proveedor.descripcionBanco := substr(lf_obt_bco_snp_swift(reg.cod_swift),1,60);
                     v_det_proveedor.tipoDocumento := reg.cod_tip_doc_beneficiario;
                     v_det_proveedor.numeroDocumento := reg.nro_doc_beneficiario;
                     v_det_proveedor.tipoMT := reg.ind_valor;
                     v_det_proveedor.numeroCuentaBeneficiario := reg.nro_cta_beneficiario;

                     IF v_det_proveedor.formaPago = 'I' THEN
                        v_cta_snp := 'S';
                     END IF;

                     IF v_det_proveedor.formaPago = 'C' THEN
                        v_cta_bbva := 'S';
                     END IF;

                     v_lis_proveedor.extend;
                     v_lis_proveedor(v_lis_proveedor.count) := v_det_proveedor;
                  END LOOP;
                  --comentado proyecto pago a proveedores
                  /*IF TRUNC(v_fec_pago) = TRUNC(SYSDATE) THEN
                     v_cam_fecha := paw_bce.fu_ver_hor_cie_proveedor(v_fec_pago);
                     IF v_cam_fecha = TRUE THEN
                        v_retorno.estadoProveedor := 'B'; -- para indicar proceso fecha posterior
                     ELSE
                        v_est_periodo := pas_snp.fu_obt_est_horario('103', '001', '002');
                        if ((v_est_periodo = 'A') and
                            (fug_den_per_act_snp('103','001','002',302,3) = 'S')) then
                            v_est_periodo := 'C';
                        end if;
                        IF v_est_periodo <> 'A' THEN
                           -- hora sipap cerrada, ver si el lote es solo sipap
                           IF v_cta_snp = 'S' AND v_cta_bbva = 'N' THEN
                              v_retorno.estadoProveedor := 'B';
                           END IF;
                        END IF;
                     END IF;
                  END IF;*/
               ELSIF v_estado = 'C' THEN
                  v_retorno.estadoProveedor := 'C';
                  FOR reg IN c_pro_pagados(v_dato, v_referencia, v_fec_pago)
                  LOOP
                     v_det_proveedor.numeroOrden := reg.nro_orden;
                     v_det_proveedor.numeroFactura := substr(reg.nro_factura, 1, 20);
                     v_det_proveedor.formaPago := reg.for_pago;
                     v_det_proveedor.fechaPago := reg.fec_pago;
                     v_det_proveedor.numeroComprobante := NULL;
                     v_det_proveedor.numeroCuentaCredito := reg.nro_cta_credito;
                     v_det_proveedor.montoCredito := reg.monto;
                     v_det_proveedor.nombreBeneficiario := substr(reg.denominacion, 1, 60);
                     v_det_proveedor.codigoMoneda := reg.cod_moneda;
                     v_det_proveedor.concepto := NULL;
                     v_det_proveedor.codigoProceso := NULL;
                     v_det_proveedor.referenciaFacturas := substr(reg.ref_facturas, 1, 300);
                     v_det_proveedor.numeroBanco := reg.ent_bca_beneficiario;
                     v_det_proveedor.descripcionBanco := substr(lf_obt_bco_snp_swift(reg.cod_swift),1,60);
                     v_det_proveedor.tipoDocumento := reg.cod_tip_doc_beneficiario;
                     v_det_proveedor.numeroDocumento := reg.nro_doc_beneficiario;
                     v_det_proveedor.tipoMT := reg.ind_valor;
                     v_det_proveedor.numeroCuentaBeneficiario := reg.nro_cta_beneficiario;
                     v_det_proveedor.estado_transferencia := reg.estado;
                     v_det_proveedor.situacion_transferencia := reg.situacion;



                     v_lis_proveedor.extend;
                     v_lis_proveedor(v_lis_proveedor.count) := v_det_proveedor;
                  END LOOP;
               elsif v_estado = 'G' then
                 --PDSYP-449
                 FOR regmovpen IN c_log_movpendientes(p_numeroDocumento)
                  LOOP
                    
                     v_det_proveedor.nombreBeneficiario := substr(regmovpen.det_error, 1, 60);
                     v_det_proveedor.montoCredito   := 0;
                     v_det_proveedor.numeroFactura  := '0';
                     v_det_proveedor.formaPago  := 'C';
                     v_det_proveedor.codigoMoneda  := 'GS';
                     v_lis_proveedor.extend;
                     v_lis_proveedor(v_lis_proveedor.count) := v_det_proveedor;
                  END LOOP;
               END IF;
               
               v_retorno.listaDetalleProveedor := v_lis_proveedor;
               v_retorno.cantidadDetallesProveedor := v_lis_proveedor.count;
            EXCEPTION
               WHEN OTHERS THEN
                  v_retorno.error := 'S';
                  v_retorno.descripcionError := 'Error al obtener detalles de creditos para proveedores';
            END;
         
         END IF; -- find detalles
         --ver si hay detalles
         --detalles de recaudacion
         IF v_cod_tip_mensaje = '090' AND (v_estado <> 'A' or p_estado IN ('P', 'E')) THEN
            --hay detalles de proveedores
            DECLARE
               v_lis_recaudacion typ_listadetallerecaudacion := typ_listadetallerecaudacion();
               v_det_recaudacion typ_detallerecaudacion := typ_detallerecaudacion();
            BEGIN
               IF v_estado = 'P' OR p_estado IN ('P', 'E') THEN
                  v_retorno.estadoRecaudador := v_estado;
                  FOR rec IN c_rec_pendientes(v_dato, v_referencia)
                  LOOP
                     v_det_recaudacion.numeroCuentaDebito := substr(rec.nro_cta_debito, 1, 15);
                     v_det_recaudacion.denominacion := substr(rec.denominacion, 1, 100);
                     v_det_recaudacion.descripcionCuenta := substr(rec.descripcion, 1, 35);
                     v_det_recaudacion.monto := rec.monto;
                     v_det_recaudacion.estado := rec.estado;
                     v_det_recaudacion.descripcionEstado := fue_obt_des_refcodes('EST_SER_RECAUDACIONES', rec.estado);
                     v_det_recaudacion.numeroFactura := substr(rec.nro_factura, 1, 60);
                     v_det_recaudacion.tipoCobranza := substr(rec.tip_cobranza, 1, 3);
                     v_det_recaudacion.descripcionCobranza := fue_obt_des_refcodes('TIP_COB_RECAUDACION', rec.tip_cobranza);
                     v_det_recaudacion.numeroDocumento := NULL;
                     v_det_recaudacion.codigoRespuesta := rec.cod_error;
                     v_det_recaudacion.mensajeRespuesta := substr(rec.msj_error, 1, 400);
                     v_lis_recaudacion.extend;
                     v_lis_recaudacion(v_lis_recaudacion.count) := v_det_recaudacion;
                  END LOOP;
               ELSIF v_estado = 'C' THEN
                  v_retorno.estadoRecaudador := 'C';
                  IF to_date(v_dato2, 'dd/mm/yyyy') > trunc(sysdate) THEN
                     v_retorno.estadoRecaudador := 'B';
                  END IF;
                  FOR rec IN c_rec_procesadas(v_dato, v_referencia)
                  LOOP
                     v_det_recaudacion.numeroCuentaDebito := substr(rec.nro_cta_debito, 1, 15);
                     v_det_recaudacion.denominacion := substr(rec.denominacion, 1, 100);
                     v_det_recaudacion.descripcionCuenta := substr(rec.descripcion, 1, 35);
                     v_det_recaudacion.monto := rec.monto;
                     v_det_recaudacion.estado := rec.estado;
                     v_det_recaudacion.descripcionEstado := fue_obt_des_refcodes('EST_SER_RECAUDACIONES', rec.estado);
                     v_det_recaudacion.numeroFactura := substr(rec.nro_factura, 1, 60);
                     v_det_recaudacion.tipoCobranza := substr(rec.tip_cobranza, 1, 3);
                     v_det_recaudacion.descripcionCobranza := fue_obt_des_refcodes('TIP_COB_RECAUDACION', rec.tip_cobranza);
                     v_det_recaudacion.numeroDocumento := rec.nro_documento;
                     v_det_recaudacion.codigoRespuesta := rec.cod_error;
                     v_det_recaudacion.mensajeRespuesta := substr(rec.msj_error, 1, 400);
                     v_lis_recaudacion.extend;
                     v_lis_recaudacion(v_lis_recaudacion.count) := v_det_recaudacion;
                  END LOOP;
               END IF;
               v_retorno.listaRecaudacion := v_lis_recaudacion;
               v_retorno.cantidadRecaudacion := v_lis_recaudacion.count;
            EXCEPTION
               WHEN OTHERS THEN
                  v_retorno.error := 'S';
                  v_retorno.descripcionError := 'Error al obtener detalles de creditos para proveedores';
            END;
         END IF; -- fin detalles recaudacion
         -- detalles altas
         IF v_cod_tip_mensaje = '130' AND v_estado <> 'A' THEN
            DECLARE
               v_pendiente VARCHAR2(1) := 'N';
               v_lis_alta typ_listaempleados := typ_listaempleados();
               v_det_alta typ_empleado := typ_empleado();
            BEGIN
               FOR c IN c_alt_empleados(v_dato, v_referencia) LOOP
                  v_det_alta.numeroDocumento := substr(c.nro_cedula, 1, 20);
                  v_det_alta.tipoDocumento   := substr(c.tip_documento, 1, 3);
                  v_det_alta.nombre          := substr(c.pri_nombre ||' '||c.seg_nombre, 1, 60);
                  v_det_alta.primerApellido  := substr(c.pri_apellido, 1, 30);
                  v_det_alta.segundoApellido := substr(c.seg_apellido, 1, 30);
                  v_det_alta.estado          := c.estado;
                  v_det_alta.numeroSolicitud := c.nro_operacion;
                  v_det_alta.fechaNacimiento := lf_for_date(c.fec_nacimiento);
                  v_det_alta.codigoError     := 0;
                  v_det_alta.estadoCivil     := substr(c.est_civil, 1, 1);
                  v_det_alta.sexo            := c.sexo;
                  v_det_alta.error           := substr(c.error, 1, 1000);
                  v_det_alta.ciudad          := substr(c.ciudad, 1, 100);
                  v_det_alta.direccion       := substr(c.direccion, 1, 100);
                  v_det_alta.nombrePaisDocumento := substr(c.doc_pais, 1, 60);
                  v_det_alta.codigoPaisDocumento := fue_obt_cod_pais(c.doc_pais);
                  v_det_alta.pais            := substr(c.pais, 1, 40);
                  v_det_alta.codigoPais      := fue_obt_cod_pais(c.pais);
                  v_det_alta.fechaIngreso    := lf_for_date(c.fec_ingreso);
                  v_det_alta.profesion       := substr(c.profesion, 1, 35);
                  v_det_alta.codigoProfesion := fue_obt_cod_profesion(c.profesion);
                  v_det_alta.tipoContrato    := substr(c.tip_contrato,1,1);
                  v_det_alta.nombreSucursal  := substr(c.direc_kit, 1, 200);
                  v_det_alta.fechaRecepcion  := paw_uti.fu_fec_char(c.fec_insercion, 2);
                  v_det_alta.cuentaAsignada  := substr(c.nro_cuenta, 1, 20);
                  if c.fec_proceso is not null then
                     v_det_alta.fechaProceso := lf_for_date(c.fec_proceso);
                  end if;
                  IF v_det_alta.error IS NOT NULL THEN
                     v_det_alta.codigoError := -1;
                  END IF;
                  v_lis_alta.extend;
                  v_lis_alta(v_lis_alta.count) := v_det_alta;
               END LOOP;
               v_retorno.listaAltaEmpleados := v_lis_alta;
               v_retorno.cantidadAlta := v_lis_alta.count;
            END;
         END IF;
         -- fin detalles de altas
         --IF v_existe = 'S' THEN
         DECLARE
            v_lis_autorizador  typ_listadetalleautorizador := typ_listadetalleautorizador();
            v_autorizador      typ_detalleAutorizador := typ_detalleAutorizador();
         BEGIN
            FOR reg IN detalles
            LOOP
               v_autorizador.nombre     := substr(fue_obt_titulo(reg.nombre), 1, 240);
               v_autorizador.fechaHora  := reg.fec_hora;
               v_autorizador.comentario := substr(reg.observacion, 1, 250);
               v_autorizador.estado     := substr(reg.accion, 1, 20);
               v_lis_autorizador.extend;
               v_lis_autorizador(v_lis_autorizador.count) := v_autorizador;
            END LOOP;
            IF v_lis_autorizador.count > 0 THEN
               v_retorno.listaAutorizadores := v_lis_autorizador;
               v_retorno.cantidadAutorizadores := v_lis_autorizador.count;
            END IF;
         EXCEPTION
            WHEN OTHERS THEN
               v_retorno.error := 'S';
               v_retorno.descripcionError := 'Error al obtener detalle de autorizadores';
         END;
         v_retorno.extraData := lf_obt_dat_extra(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), p_numeroDocumento, v_cod_tip_mensaje);
         -- END IF; -- fin detalles
      END IF; -- sin error

      RETURN v_retorno;
   END;

  PROCEDURE lp_obt_sue_errores(p_cod_ente            IN ge_entes.cod_ente%TYPE,
                                p_referencia          IN ge_pag_sueldos.nro_secuencia%TYPE,
                                p_listaDetalleSalario IN OUT typ_listaDetalleSalario,--NVB-2232
                                p_fecha               IN DATE DEFAULT NULL) IS
      v_can_sue_errores NUMBER;
      v_det_salario     typ_detalleSalario := typ_detalleSalario();--NVB-2232
      v_fec_actual      DATE := nvl(p_fecha, pag_cal.fu_obt_fec_actual(9)); -- fecha de hoy;
      CURSOR c_sue_error IS
         SELECT x.nro_cuenta, substr(z.denominacion, 1, 40) denominacion, x.cod_moneda cod_moneda, x.monto, x.msj_error
           FROM ge_cuentas z, ge_pag_sueldos_err x
          WHERE x.cod_ente = p_cod_ente
            AND x.fec_proceso = v_fec_actual
            AND nvl(x.nro_secuencia, 0) = nvl(p_referencia, 0)
            AND to_char(x.nro_cuenta) = z.nro_cuenta;
   BEGIN
      -- buscamos si hubieron registros con error
      SELECT nvl(COUNT(0), 0)
        INTO v_can_sue_errores
        FROM ge_pag_sueldos_err x
       WHERE x.cod_ente = p_cod_ente
         AND x.fec_proceso = v_fec_actual
         AND nvl(x.nro_secuencia, 0) = nvl(p_referencia, 0);
      -- desplegamos informacion de errores si las hubo
      IF v_can_sue_errores > 0 THEN
         FOR reg IN c_sue_error
         LOOP
            v_det_salario.numeroCuenta := reg.nro_cuenta;
            v_det_salario.tipo := 'C';
            v_det_salario.descripcionTipoCuenta := NULL;
            v_det_salario.nombreCuenta := substr(reg.denominacion, 1, 50);
            v_det_salario.codigoMoneda := reg.cod_moneda;
            v_det_salario.monto := reg.monto;
            v_det_salario.error := 'S';
            v_det_salario.mensajeRespuesta := substr(reg.msj_error, 1, 200);
            p_listaDetalleSalario.extend;
            p_listaDetalleSalario(p_listaDetalleSalario.count) := v_det_salario;
         END LOOP;
      END IF;
   END;
  -- actualizar fecha de pago a proveedores
  -- dato2 es la columna que se utiliza para indicar la fecha de pago
  -- cuando el tipo de mensaje de 075 - Pago a proveedores
   PROCEDURE pr_act_fec_pag_pendiente(p_nro_documento in bw_mov_pendientes.nro_documento%type,
                                     p_cod_persona   in bw_mov_pendientes.cod_per_principal%type,
                                     p_fec_pago      in bw_mov_pendientes.dato2%type) is
   begin
    update bw_mov_pendientes
       set dato2 = p_fec_pago
     where nro_documento = p_nro_documento
       and cod_per_principal = p_cod_persona;

   end pr_act_fec_pag_pendiente;

  --- Validacion y confirmacion de pago a proveedores
   /*FUNCTION fu_pagoProveedores(p_sesion                 IN VARCHAR2,
                               p_codigoCanal            IN VARCHAR2,
                               p_codigoEnte             IN NUMBER,
                               p_modoControl            IN VARCHAR2,
                               p_cuentaDebito           IN VARCHAR2,
                               p_fechaPago              IN DATE,
                               p_tipoPago               IN VARCHAR2,
                               p_cantFacturas           IN NUMBER,
                               p_parametros             IN CLOB,
                               p_claveTransaccional     IN VARCHAR2) RETURN typ_pagoProveedores IS
      -- datos recibidos
      p_cod_ente          NUMBER(5) := trim(p_codigoEnte);
      p_can_factura       NUMBER(5) := trim(p_cantFacturas);
      v_lon_registro      NUMBER(5) := 118;
      v_lon_reg_fac       NUMBER(5) := 118;
      v_lon_reg_total     NUMBER(5) := 0;
      v_can_detalles      NUMBER(5) := 0; -- cantidad de cuentas
      v_cod_ente          NUMBER(6);
      v_registro          VARCHAR2(4000);
      v_arc_mon_local     VARCHAR2(100);
      v_arc_mon_fuerte    VARCHAR2(100);
      v_for_archivo       VARCHAR2(100);
      p_modo              VARCHAR2(1) := substr(trim(p_modoControl), 1, 1); -- modo de control C-CONFIRMA
      v_detalle           typ_detalleProveedor := typ_detalleProveedor(); -- datos de las cuentas
      v_lis_detalle       typ_listadetalleproveedor := typ_listadetalleproveedor();
      -- codigo del ente
      v_des_ente          VARCHAR2(100); -- descripcion del ente
      v_cod_respuesta     varchar2(20) := '000'; -- respuesta
      v_tip_comprobante   ge_pag_proveedores_tmp.tip_comprobante%TYPE;
      r_orden             ge_pag_proveedores_tmp%ROWTYPE;
      v_nro_orden         ge_pag_pro_facturas_tmp.nro_orden%TYPE;
      v_nro_orden_fac     ge_pag_pro_facturas_tmp.nro_orden%TYPE;
      v_cod_moneda        ge_cuentas.cod_moneda%TYPE;
      v_nro_cta_debito    ge_cuentas.nro_cuenta%TYPE;
      v_cod_modulo        ge_movimientos.cod_modulo%TYPE;
      v_cod_modalidad     ge_movimientos.cod_modalidad %TYPE;
      v_cod_oficina       ge_movimientos.cod_oficina%TYPE;
      v_tra_pad_proveedor ge_movimientos.cod_tra_padre%TYPE := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_PPROV');
      v_tra_pad_credito   ge_movimientos.cod_tra_padre%TYPE := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_PRV_CREDITO');
      v_cod_tra_padre     ge_movimientos.cod_tra_padre%TYPE;
      v_des_pendiente     bw_mov_pendientes.descripcion%TYPE;
      v_sesion            bw_aut_sesiones.cod_sesion%type;
      v_codigocanal       ge_canales.cod_canal%type;
      p_fec_pago1         DATE := p_fechaPago;
      v_pos_ant           NUMBER(8);
      v_nro_documento     NUMBER(20);
      v_tot_debito        NUMBER(18, 2);
      v_indice            NUMBER(5);
      v_can_facturas      NUMBER(10) := 0;
      v_can_ordenes       NUMBER;
      v_cta_for_debito    VARCHAR2(17);
      v_nom_cta_debito    VARCHAR2(100);
      v_for_fijo          VARCHAR2(1) := 'S';
      v_error             VARCHAR2(2000);
      v_concepto          VARCHAR2(40);
      v_err_pago          VARCHAR2(2) := '00';
      v_tip_pago          VARCHAR2(1); -- P: Pago a proveedores, C: Credito en cuenta

    -- cantidad de ordenes para Credito
      v_retorno           typ_pagoProveedores := typ_pagoProveedores();
      v_usu_sesion        typ_validarsesion;
      v_msj_respuesta     typ_MensajeRespuesta := typ_MensajeRespuesta;
      v_msj_caja          typ_mensajeCaja;
      v_permiso           typ_obtenerPermisos;
      v_dir_correo        ba_personas.dir_correo%TYPE;
      v_nro_archivo       ge_pag_proveedores_tmp.nro_archivo%type;
      v_claveTransaccional bw_ope_claves.clave%type;
      v_lugar             VARCHAR2(100);
      v_cod_operacion     VARCHAR2(3) := '075';
      v_modo              VARCHAR2(2);
      v_mensaje           VARCHAR2(100);
      v_fec_actual        DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy;
      v_can_errores       NUMBER(5) := 0;
      v_cantidad          NUMBER := 0;
      v_cod_error         NUMBER := 0; -- 0: Ok, 1: Error en cuenta, 2: Error en monto, 3: error en cuenta y monto
      v_general           NUMBER :=0;--almacena las cantidad de errores que tuvo en el detalle.

      v_par_factura       NUMBER :=1; --parche para las facturas

      v_msj_bitacora      VARCHAR2(1000) := substr('ente:'||trim(p_codigoEnte)
                                                         ||', modo:'||trim(p_modoControl)
                                                         ||', ctaDeb:'||trim(p_cuentaDebito)
                                                         ||', fecPag:'||p_fechaPago
                                                         ||', tipPag:'||p_tipoPago
                                                         ||', canFac:'||p_cantFacturas, 1, 500);
      PRO_PER_SIN_AUT         CONSTANT VARCHAR2(15) := 'PRO_PER_SIN_AUT';
      PRO_FEC_PAG_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_FEC_PAG_INV';
      PRO_TRA_PAD_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_TRA_PAD_INV';
      PRO_CTA_DEB_TERCERO     CONSTANT VARCHAR2(15) := 'PRO_CTA_DEB_TER';
      PRO_MON_PAG_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_MON_PAG_INV';
      PRO_FMT_ARC_INDEFINIDO  CONSTANT VARCHAR2(15) := 'PRO_FMT_ARC_IND';
      PRO_CTA_DEB_INEXISTENTE CONSTANT VARCHAR2(15) := 'PRO_CTA_DEB_INE';
      PRO_CTA_DEB_DUPLICADA   CONSTANT VARCHAR2(15) := 'PRO_CTA_DEB_DUP';
      PRO_OBT_ERR_CTA_DEBITO  CONSTANT VARCHAR2(15) := 'PRO_OBT_CTA_DEB';
      OPE_NO_PERMITIDA        CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      PRO_ERR_DATOS           CONSTANT VARCHAR2(15) := 'PRO_ERR_DATOS';
      PRO_MAX_CRE_EXCEDIDO    CONSTANT VARCHAR2(15) := 'PRO_MAX_CRE_EXE';
      PRO_MAX_FAC_EXCEDIDA    CONSTANT VARCHAR2(15) := 'PRO_MAX_FAC_EXE';
      PRO_ERR_VER_PAGO        CONSTANT VARCHAR2(15) := 'PRO_ERR_VER_PAG';
      PRO_ERR_PRO_PAGO        CONSTANT VARCHAR2(15) := 'PRO_ERR_PRO_PAG';
      PRO_ERR_DAT_INVALIDOS   CONSTANT VARCHAR2(15) := 'PRO_ERR_DAT_INV';
      PRO_COD_MTO_INVALIDO    CONSTANT VARCHAR2(15)  :='PRO_COD_MTO_INV';
      MSG_CLA_OPE_INVALIDA    CONSTANT VARCHAR2(15) := 'CLA_OPE_INVALID';
      PRO_NRO_FAC_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_NRO_FAC_INV';
      PRO_CAN_FAC_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_CAN_FAC_INV';
      PRO_NRO_REGISTRO        CONSTANT VARCHAR2(15) := 'PRO_NRO_REGISTR';
      PRO_SAL_ERR_DATOS       CONSTANT VARCHAR2(15) := 'SAL_ERR_DATOS';
      PRO_FMT_INCORRECTO      CONSTANT VARCHAR2(15) := 'PRO_FMT_INCORRE';
      MOV_PEN_EXISTE          CONSTANT VARCHAR2(15) := 'PRO_MOV_PEN_EXI';
      PRO_ERR_COR_INVALIDOS   CONSTANT VARCHAR2(15) := '321';
    v_horario         VARCHAR2(1) := 'D'; -- Dia normal
      v_es_mov_noc      VARCHAR2(1) := 'N';
      v_es_cta_noc      VARCHAR2(1) := 'N'; -- Graba S/N ctas noctunas
      v_fec_valor       DATE := v_fec_actual;
      retError          typ_mensajerespuesta := typ_mensajerespuesta;

      -- registro de detalles
      CURSOR c_detalle(p_nro_archivo in number) IS
         SELECT nro_orden, nro_factura, tip_comprobante, for_pago, nro_cheque, nro_cta_credito, fec_ingreso, fec_pago, monto, nro_recibo, beneficiario, decode(cod_proceso, 0, 'Aprobado', InitCap(concepto)) concepto, estado, cod_usu_operador, cod_ente, cod_proceso, cod_moneda, tip_carga, nvl(f_cantidad, 0) f_cantidad, ref_facturas
           FROM ge_pag_proveedores_tmp,
                (SELECT cod_ente f_cod_ente, nro_orden f_nro_orden, COUNT(*) f_cantidad
                   FROM ge_pag_pro_facturas_tmp
                   WHERE cod_ente = p_cod_ente
                      AND trunc(fec_insercion) = trunc(SYSDATE)
                      AND usu_insercion = USER
                 GROUP BY cod_ente, nro_orden)
          WHERE f_cod_ente(+) = cod_ente
             AND f_nro_orden(+) = nro_orden
             AND cod_ente = p_cod_ente
             AND usu_insercion = USER
             AND tip_carga = 'H'
             AND nro_archivo = p_nro_archivo
             AND trunc(fec_insercion) = trunc(sysdate)
       ORDER BY nro_orden;
      -- cuentas proveedores
      CURSOR c_cuentas_proveedor IS
      SELECT DISTINCT (TRIM(a.beneficiario)) beneficiario, (TRIM(decode(a.nro_cta_credito, '0', ' ', NULL, ' ', a.nro_cta_credito))) cta_credito, g.cod_moneda
        FROM ge_cuentas g,
             (SELECT DISTINCT (TRIM(beneficiario)) beneficiario, MAX(TRIM(nro_cta_credito)) nro_cta_credito
                 FROM ge_pag_proveedores
                WHERE cod_ente = p_cod_ente
                  AND fec_ingreso > SYSDATE - 90
                GROUP BY beneficiario
               UNION
               SELECT DISTINCT (TRIM(beneficiario)), MAX(TRIM(nro_cta_credito)) nro_cta_credito
                 FROM ge_pag_proveedores_tmp
                WHERE cod_ente = p_cod_ente
                GROUP BY beneficiario) a
       WHERE g.nro_cuenta(+) = a.nro_cta_credito
             AND nvl(g.estado, 'A') IN ('A', 'N', 'I');

   BEGIN
     pre_cam_for_numerico('.,');
     v_codigocanal     := depurarAlfanumerico(p_codigoCanal,3);
     v_sesion          := depurarAlfanumerico(p_sesion,32);
     v_claveTransaccional := trim(p_claveTransaccional);

      -- 1. valido la clave del cliente
      v_lugar := 'Validacion de la clave';
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
         v_retorno.error                := v_usu_sesion.error;
         v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
         \*  Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoProveedores := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoProveedores',
         'PagoProveedores'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
         p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
         p_tipoPago||', '|| p_cantFacturas);

         RETURN v_retorno;
      END IF;
      -- 2. verifica el canal de origen
      v_lugar := 'Validacion de la caja';
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
         v_retorno.error                := v_msj_caja.error;
         v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
         \*  Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoProveedores := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoProveedores',
         'PagoProveedores'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
         p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
         p_tipoPago||', '|| p_cantFacturas);
         RETURN v_retorno;
      END IF;

      --controla horario cierre
      if nvl(fug_obt_pardinamico('BWE_BLO_HOR_CIERRE'),'N') = 'S' then
          reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                      v_msj_caja.fechaUltimoCierre \* v_ult_cierre *\,
                                      -- IN
                                      v_msj_caja.codigoOficinaOrigen \* v_cod_ofi_origen *\,
                                      -- IN
                                      v_fec_actual, v_msj_caja.fechacierre, v_fec_valor);

           IF reterror.error = 'S' THEN
              v_retorno.error                := reterror.error;
              v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
              v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
              RETURN v_retorno;
           END IF;
      end if;

      -- 3. verifico si el cliente con su perfil tendra acceso a realizar la transaccion
      v_lugar := 'Control de permisos';
      v_permiso := lf_obt_permisos(nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona),v_usu_sesion.codigoPerfil, v_cod_operacion,v_usu_sesion.codigoCanal);
     IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         \*  Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoProveedores := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoProveedores',
         'PagoProveedores'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
         p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
         p_tipoPago||', '|| p_cantFacturas);

         RETURN v_retorno;
      END IF;
      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
         pr_mensajeUsuario(PRO_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         \*  Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoProveedores := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoProveedores',
         'PagoProveedores'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
         p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
         p_tipoPago||', '|| p_cantFacturas);

         RETURN v_retorno;
      END IF;

--------------Verifica los parametros
     If nvl(length(p_parametros),0) <=  0 then
        pr_mensajeUsuario(PRO_FMT_INCORRECTO,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'PAGPRV- p_parametros null'||v_msj_bitacora || ' ' ||
        fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         \*  Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoProveedores := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoProveedores',
         'PAGPRV'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
         p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
         p_tipoPago||', '|| p_cantFacturas);
        RETURN v_retorno;
      end if;

      If nvl(length(p_can_factura),0) <=  0 then
        pr_mensajeUsuario(PRO_FMT_INCORRECTO,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
        pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, 'PAGPRV - p_canRegistrosLeidos NULOS'||v_msj_bitacora || ' ' ||
        fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),BITACORA_ERROR);

        \*  Obtiene la informacion de parametros recibos y el return del type *\
        paw_log.g_typ_pagoProveedores := v_retorno;
        paw_log.pr_logValoresTypes('typ_pagoProveedores',
        'PAGPRV'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
        p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
        p_tipoPago||', '|| p_cantFacturas);
        RETURN v_retorno;
      end if;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_modo := trim(p_modoControl);
    --valida la clave transaccional
      IF nvl(p_modo, 'x') = 'C'  then
         If v_claveTransaccional is null then
           pr_mensajeUsuario(MSG_CLA_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          \*  Obtiene la informacion de parametros recibos y el return del type *\
          paw_log.g_typ_pagoProveedores := v_retorno;
          paw_log.pr_logValoresTypes('typ_pagoProveedores',
          'PagoProveedores'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
          p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
          p_tipoPago||', '|| p_cantFacturas);

          RETURN v_retorno;
         end if;
      end if;

      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);
     IF nvl(v_modo, 'x') <> 'A' THEN
        DECLARE
          v_lugar VARCHAR2(50);
          BEGIN
          -- Ajuste por requerimiento de control de clave en la verificacion
          IF (v_modo = 'C'  AND p_claveTransaccional IS NOT NULL) THEN
              v_lugar  := 'lf_obt_cla_validar: ';
              v_msj_respuesta := lf_obt_cla_validar(v_claveTransaccional, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa,'T');
          END IF;
             IF v_msj_respuesta.error = 'S' THEN
                v_retorno.error := v_msj_respuesta.error;
                v_retorno.nombreRespuesta := v_msj_respuesta.nombreRespuesta;
                v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
                pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_tip_mensaje, v_usu_sesion.codigoEmpresa, v_lugar || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                \*  Obtiene la informacion de parametros recibos y el return del type *\
                paw_log.g_typ_pagoProveedores := v_retorno;
                paw_log.pr_logValoresTypes('typ_pagoProveedores',
                'PagoProveedores'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
                p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
                p_tipoPago||', '|| p_cantFacturas);
                RETURN v_retorno;
             END IF;
        END;
     END IF;
        v_lugar := 'Tomando las fechas';
      IF  p_fec_pago1 IS NOT NULL THEN
         BEGIN
             IF p_fec_pago1 < v_fec_actual THEN
                pr_mensajeUsuario(PRO_FEC_PAG_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            else
              pr_mensajeUsuario(MSG_OK,
                                v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta,
                                v_retorno.error);
             END IF;
         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(PRO_FEC_PAG_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END;
      END IF;

    --Controla de que no existan pagos de proveedores pendientes de aprobacion
     If(lf_ver_pag_pendientes(v_usu_sesion.codigoEmpresa, v_cod_operacion )='S')then
          pr_mensajeUsuario(MOV_PEN_EXISTE,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(v_usu_sesion.codigoPersona,p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa,v_lugar||v_msj_bitacora || ' ' ||
          fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
          return v_retorno;
     end if;

     -- 4. Verifico si la persona tiene el servicio de pago a proveedores
      IF v_retorno.error = 'N' THEN
         v_lugar := 'Datos del ente';
         BEGIN
            -- se elimina cta_debito porque ahora se recibe en la mensajeria,
            -- se agrega el formato de archivo para pagos en USD
            SELECT a.cod_ente, a.descripcion, fug_obt_parentes(a.cod_ente, 'TIP_COB_PPROV'), fug_obt_parentes(a.cod_ente, 'REF_TXT_PPROV'), fug_obt_parentes(a.cod_ente, 'REF_TXT_PPROV_USD')
              INTO v_cod_ente, v_des_ente, v_tip_comprobante, v_arc_mon_local, v_arc_mon_fuerte
              FROM ge_entes a
             WHERE a.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
               AND a.tipo = 'PR'
               AND (p_modo = 'D' OR (p_modo <> 'D' AND a.cod_ente = p_cod_ente))
               AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO_PRV') = 'S'
               AND fug_obt_parentes(a.cod_ente, 'BWE_PAG_PROVEEDOR') = 'S';
            IF p_modo = 'D' THEN
               p_cod_ente := v_cod_ente;
            END IF;

            -- La cuenta de Debito ahora se recibe como parametro en la mensajeria
            -- validamos la misma y verificamos si pertenece al ente

            IF nvl(p_modo,'X') IN ('L', 'D', 'C', 'V') THEN
               IF v_ind_cta_encriptada = 'S' THEN
                  v_nro_cta_debito := fu_desencriptacionCuentas(depurarCuenta(p_cuentaDebito,CUENTA_TAMANO));
               ELSE
                  v_nro_cta_debito := depurarCuenta(p_cuentaDebito,CUENTA_TAMANO);
               END IF;
               v_tip_pago       := TRIM(substr(p_tipoPago, 1, 1));
             IF v_tip_pago = 'P' THEN
                  v_cod_tra_padre := v_tra_pad_proveedor; -- transaccion padre para pago a proveedores
                  v_des_pendiente := 'Proveedores';
               ELSIF v_tip_pago = 'C' THEN
                  v_cod_tra_padre := v_tra_pad_credito; -- transaccion padre para Credito en cuenta
                  v_des_pendiente := 'Credito en Cuenta';
               ELSE
                  pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
               -- si no existe transaccion padre, retornamos el error
               IF p_modo <> 'D' AND v_cod_tra_padre IS NULL AND v_retorno.error = 'N' THEN
                  pr_mensajeUsuario(PRO_TRA_PAD_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            ELSE
               pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;
            -- validamos si la cuenta pertenece al cliente
            IF v_retorno.error = 'N' and p_modo <> 'D' THEN
               IF lf_val_cta_origen(v_nro_cta_debito, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)) = 'N' THEN
                  -- no es una cuenta del cliente
                  pr_mensajeUsuario(PRO_CTA_DEB_TERCERO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
            IF p_modo <> 'D' AND v_retorno.error = 'N' THEN
               pag_cta.pr_obt_cuenta(v_nro_cta_debito);
               v_cod_moneda := pag_cta.fu_obt_mon_cuenta;

               -- De acuerdo a la moneda, se elige el formato de archivo
               IF v_cod_moneda = v_cod_mon_local THEN
                  v_for_archivo := v_arc_mon_local;
                  v_cod_respuesta := paw_bem.v_cod_aprobado;
                  v_mensaje       := 'Aprobado';
               ELSIF v_cod_moneda = pag_gen.FU_OBT_MON_FUERTE THEN
                  v_for_archivo := v_arc_mon_fuerte;
                  v_cod_respuesta := paw_bem.v_cod_aprobado;
                  v_mensaje       := 'Aprobado';
               ELSE
                 v_cod_respuesta := PRO_MON_PAG_INVALIDA;
                 v_cod_error := 1;
                 v_mensaje := 'No se puede realizar el pago en la moneda de la cuenta';
                 v_general := v_general + v_cod_error;
                 v_msj_bitacora := v_msj_bitacora || ', monDeb:' || v_cod_moneda;
                 pr_mensajeUsuario(PRO_MON_PAG_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;

               -- Si no tiene definido el formato de importacion
               -- para archivos, debe dar error
               IF v_retorno.error = 'N' AND v_for_archivo IS NULL AND p_modo = 'L' THEN
                  pr_mensajeUsuario(PRO_FMT_ARC_INDEFINIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               END IF;
            END IF;
         EXCEPTION
            WHEN no_data_found THEN
               pr_mensajeUsuario(PRO_CTA_DEB_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN too_many_rows THEN
               pr_mensajeUsuario(PRO_CTA_DEB_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            WHEN OTHERS THEN
               pr_mensajeUsuario(PRO_OBT_ERR_CTA_DEBITO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         END;
      END IF;
      IF p_modo = 'D' AND v_retorno.error = 'N' THEN
         FOR reg IN c_cuentas_proveedor
         LOOP
            v_can_detalles := v_can_detalles + 1;
            -- armo el detalle de las cuentas a acreditar
            v_detalle.numeroOrden          := NULL;
            v_detalle.numeroFactura        := NULL;
            v_detalle.formaPago            := NULL;
            v_detalle.numeroCuentaCredito  := reg.cta_credito;
            v_detalle.montoCredito         := 0;
            v_detalle.nombreBeneficiario   := substr(reg.beneficiario, 1, 50);
            v_detalle.codigoMoneda         := TRIM(reg.cod_moneda);
            v_detalle.concepto             := NULL;
            v_detalle.codigoProceso        := NULL;
            v_lis_detalle.extend;
            v_lis_detalle(v_lis_detalle.count) := v_detalle;
         END LOOP;
         v_retorno.listaProveedores := v_lis_detalle;
      ELSE
         -- 4. Tomo la cantidad de cuentas recibidas
         IF v_retorno.error = 'N' THEN
            v_indice          := 1;
            v_tip_comprobante := fug_obt_parentes(p_cod_ente, 'TIP_COB_PPROV');
            v_for_fijo        := 'S';
            IF instr(p_parametros, '~') > 0 THEN
               v_for_fijo := 'N';
            END IF;
            v_pos_ant    := 1\*118*\; -- se modifica porque cambia la mensajeria, se agrega cta_debito y tip_pago
            v_tot_debito := 0;
            v_nro_archivo := pag_prv.fu_obt_nro_secuencia(p_cod_ente, p_fec_pago1);
            v_msj_bitacora := v_msj_bitacora || ', nro_arc: ' ||v_nro_archivo;
            IF p_can_factura > 0 THEN
               v_can_ordenes := 0; -- para contar el total de Creditos, no puede super paw_bce.v_max_imp_archivo
               -- Se elimino control de valor decimal
               -- ya que la misma se hace en pag_prv.pr_ver_dat_tmp
               FOR i IN 1 .. p_can_factura
               LOOP
                  ----
                  v_lugar := 'Leyendo el registro Nro.' || i;
                  IF v_for_fijo = 'S' THEN
                     -- formato fijo
                     v_registro := substr(p_parametros,
                             1 + ((i - 1) * v_lon_registro),
                             v_lon_registro);
                     v_indice   := 1;
                     r_orden    := NULL;
                     -- CR: se agrega validacion de dato ingresado
                     BEGIN
                        r_orden.nro_orden := to_number(substr(v_registro, v_indice, 10));
                     EXCEPTION
                        WHEN OTHERS THEN
                           r_orden.nro_orden := i;
                     END;

                     v_indice                 := v_indice + 10;
                     r_orden.nro_factura      := TRIM(substr(v_registro, 11, 20));
                     --v_indice                 := v_indice + 15;
                     r_orden.tip_comprobante  := v_tip_comprobante; -- Toma del parametro del Ente....
                     r_orden.for_pago         := TRIM(substr(v_registro, 31, 1));
                    -- v_indice                 := v_indice + 1;
                     r_orden.nro_cheque       := NULL;
                     r_orden.nro_cta_credito  := TRIM(substr(v_registro, 32, 15));
                     v_indice                 := v_indice + 15;
                     r_orden.fec_ingreso      := trunc(sysdate); --v_fec_actual;
                     r_orden.fec_pago         := NULL;
                     r_orden.monto            := to_number(replace(trim(substr(v_registro, 47, 18)), ',', '.'));
                     v_indice                 := v_indice + 18;
                     r_orden.nro_recibo       := NULL;
                     r_orden.beneficiario     := TRIM(substr(v_registro, 65, 50));
                     v_indice                 := v_indice + 50;
                     r_orden.concepto         := NULL;
                     r_orden.estado           := 'C';
                     r_orden.cod_usu_operador := USER;
                     r_orden.cod_ente         := p_cod_ente;
                     r_orden.cod_proceso      := NULL;
                     r_orden.cod_moneda       := TRIM(substr(v_registro, 115, 3));
                     v_indice                 := v_indice + 3;
                     v_detalle.mensajeRespuesta := v_mensaje;
                     If v_mensaje = 'Aprobado' then
                        v_detalle.error          := 'N';
                      else
                        v_detalle.error          := 'S';
                      end if;
                     --validar nro de factura
                     If length(r_orden.nro_factura) <=0 then
                        v_cod_respuesta := PRO_NRO_FAC_INVALIDA;
                        v_mensaje     := 'Nro de factua invalida';
                        v_cod_error   := 1;
                        v_general     := v_general + v_cod_error;
                      end if;
                     If r_orden.monto <=0 then
                        v_cod_respuesta := PRO_MON_PAG_INVALIDA;
                        v_mensaje     := 'Monto invalido';
                        v_cod_error   := 1;
                        v_general     := v_general + v_cod_error;
                      end if;
                     --Ajuste para
                     IF length(p_can_factura) > 0 THEN
                        --v_tip_carga          := 'M';
                        v_lon_reg_total      := (\*120*\1 + (p_can_factura) * v_lon_registro);
                        r_orden.ref_facturas := NULL;
                        FOR n IN 1 .. v_par_factura
                        LOOP
                           v_indice   := 1;
                           v_lugar := 'Leyendo factura Nro.' || n;
                           v_registro := substr(p_parametros, \*120*\1 + ((i - 1) * v_lon_registro), v_lon_registro);
                           -- Se valida lo ingresado por el usuario
                           BEGIN
                              v_nro_orden_fac := to_number(substr(v_registro, v_indice, 10));
                           EXCEPTION
                              WHEN OTHERS THEN
                                 v_nro_orden_fac := r_orden.nro_orden;
                           END;

                           v_indice := v_indice + 10;

                           IF v_nro_orden_fac = r_orden.nro_orden THEN
                              BEGIN
                                 v_can_facturas       := v_can_facturas + 1;
                                 r_orden.ref_facturas := r_orden.ref_facturas || TRIM(substr(v_registro, v_indice, 15)) || ';';
                                 IF TRIM(r_orden.nro_factura) IS NULL AND v_can_facturas = 1 THEN
                                    r_orden.nro_factura := TRIM(substr(v_registro, v_indice, 15));
                                 END IF;
                              EXCEPTION
                                 WHEN OTHERS THEN
                                    v_msj_bitacora := v_msj_bitacora ||', regFac:'||n||', gloFac:'||v_can_facturas;
                                    pr_mensajeUsuario(PRO_MAX_FAC_EXCEDIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                    pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, sqlerrm||v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                                    \*  Obtiene la informacion de parametros recibos y el return del type *\
                                     paw_log.g_typ_pagoProveedores := v_retorno;
                                     paw_log.pr_logValoresTypes('typ_pagoProveedores',
                                     'PagoProveedores'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
                                     p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
                                     p_tipoPago||', '|| p_cantFacturas);

                                     RETURN v_retorno;
                              END;
                           END IF;

                        END LOOP;
                        v_can_facturas := 0;
                     ELSE
                        r_orden.ref_facturas := TRIM(substr(v_registro, v_indice, 300));
                        v_indice             := v_indice + 300;
                     END IF;
                     -- Se elimino control de valor decimal
                     -- ya que la misma se hace en pag_prv.pr_ver_dat_tmp
                     r_orden.tip_carga := 'H';
                     r_orden.nro_archivo := v_nro_archivo;
                  ELSE
                    -- tomo los datos segun formato de archivo
                     r_orden             := NULL;
                     r_orden.cod_ente    := p_cod_ente;
                     v_lugar             := 'Nro de orden';
                     r_orden.nro_orden   := NVL(paw_bem.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_ORDEN'), i);
                     v_lugar             := 'Nro de Factura';
                     r_orden.nro_factura := paw_bem.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_FACTURA');
                     v_lugar             := 'Forma de pago';
                     r_orden.for_pago    := paw_bem.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'FOR_PAGO');
                     IF r_orden.for_pago IS NULL THEN
                        r_orden.for_pago := 'C';
                     END IF;
                     v_lugar                 := 'Nro de cta credito';
                     r_orden.nro_cta_credito := paw_bem.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_CTA_CREDITO');
                     v_lugar                 := 'Fecha de pago';
                     r_orden.fec_pago        := to_date(paw_bem.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'FEC_PAGO'), 'dd/mm/yyyy');
                     v_lugar                 := 'monto';
                     r_orden.monto           := paw_bem.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'MONTO');
                     v_lugar                 := 'Beneficiario';
                     r_orden.beneficiario    := paw_bem.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'BENEFICIARIO');
                     v_lugar                 := 'Moneda';
                     r_orden.cod_moneda      := paw_bem.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'COD_MONEDA');
                     v_lugar                 := 'Ref_factura';
                     r_orden.ref_facturas    := paw_bem.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'REF_FACTURAS');
                     r_orden.concepto         := NULL;
                     r_orden.estado           := 'C';
                     r_orden.tip_carga        := 'H';
                     r_orden.nro_archivo := v_nro_archivo;
                     r_orden.cod_usu_operador := USER;
                     r_orden.nro_cheque       := NULL;
                     r_orden.tip_comprobante  := v_tip_comprobante; -- Toma del parametro del Ente....
                     r_orden.fec_ingreso      := trunc(sysdate);    --v_fec_actual;
                  END IF;
                  IF r_orden.nro_factura IS NULL THEN
                     r_orden.nro_factura := r_orden.nro_orden;
                  END IF;
                  -- Aumentamos el contador de Creditos
                  v_can_ordenes := v_can_ordenes + 1;
                  -- Se sumariza solo si el monto es valido
                  IF r_orden.monto > 0 THEN
                     v_tot_debito := v_tot_debito + r_orden.monto;
                  END IF;
                  v_lugar := 'Insertando en temporales';
                  IF r_orden.for_pago IN ('C', 'G') THEN

                  INSERT INTO ge_pag_pro_facturas_tmp
                  (nro_orden, fec_carga, nro_factura, mto_total, concepto, cod_ente)
                  VALUES
                  (r_orden.nro_orden, sysdate, r_orden.nro_factura, r_orden.monto, r_orden.concepto, r_orden.cod_ente);

                   INSERT INTO ge_pag_proveedores_tmp
                        (nro_orden, nro_factura, tip_comprobante, for_pago, nro_cheque, nro_cta_credito, fec_ingreso, fec_pago, monto, nro_recibo, beneficiario, concepto, estado, cod_usu_operador, cod_ente, cod_proceso, cod_moneda, tip_carga, nro_archivo, ref_facturas)
                     VALUES
                        (r_orden.nro_orden, r_orden.nro_factura, r_orden.tip_comprobante, r_orden.for_pago, r_orden.nro_cheque, r_orden.nro_cta_credito, r_orden.fec_ingreso, r_orden.fec_pago, r_orden.monto, r_orden.nro_recibo, r_orden.beneficiario, r_orden.concepto, r_orden.estado, r_orden.cod_usu_operador, r_orden.cod_ente, r_orden.cod_proceso, r_orden.cod_moneda, r_orden.tip_carga, r_orden.nro_archivo, r_orden.ref_facturas);
                  END IF;
               END LOOP;
               v_msj_bitacora := v_msj_bitacora || ', ordLei:' || v_can_ordenes;
               -- Se controla que el total de Creditos no supere el maximo permitido
                v_lugar := 'Validando el total de creditos';
               IF v_can_ordenes > paw_bem.v_max_imp_archivo THEN
                   v_cod_respuesta := PRO_MAX_CRE_EXCEDIDO;
                   v_mensaje     := 'Credito en cuenta excedida';
                   v_cod_error   := 1;
                   v_general     := v_general + v_cod_error;
                   pr_mensajeUsuario(PRO_MAX_CRE_EXCEDIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               ELSE
                    v_cod_respuesta := paw_bem.v_cod_aprobado;
                    v_mensaje     := 'Aprobado';
                END IF;

               -- Se valida la cuenta de Debito
               v_lugar := 'Validando la cuenta del cliente';
               IF v_retorno.error = 'N' THEN

                  v_msj_respuesta := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_tot_debito,
                                                       v_cod_moneda, v_cod_modulo, v_cod_modalidad,
                                                       v_cod_oficina, v_cta_for_debito, v_nom_cta_debito,
                                                       v_usu_sesion, v_msj_caja);

                  IF v_msj_respuesta.error = 'S' THEN
                    -- para poder corregir los decimales en los detalles
                     IF instr(pag_cta.G_MSJ_ERROR, 'Decimales no permitidos') > 0 THEN
                         v_cod_respuesta := PRO_ERR_DATOS;
                         v_mensaje     := 'Decimales no permitidos';
                         v_cod_error   := 3;
                         v_general     := v_general + v_cod_error;

                        pr_mensajeUsuario(PRO_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     ELSE
                        v_retorno.error                := v_msj_respuesta.error;
                        v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
                        v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;

                     END IF;
                     v_msj_bitacora := v_msj_bitacora || ', CTA-ERR:[' || substr(pag_cta.g_msj_error, 1, 50)||']';
                  ELSE
                        v_cod_respuesta := paw_bem.v_cod_aprobado;
                        v_mensaje     := 'Aprobado';
                  END IF;
               END IF;
               IF v_retorno.error = 'N' OR v_retorno.nombreRespuesta = 'PRO_ERR_DATOS' THEN
                  v_lugar := 'Verificando datos temporales';
                  --- Una vez que carga todo va a validar....P
                   pag_prv.PR_VER_DAT_TMP(p_cod_ente, p_fec_pago1, NULL , v_error, 'N');
                  IF v_error IS NOT NULL AND v_retorno.error = 'N' THEN
                    v_cod_respuesta := PRO_ERR_DATOS; -- hay problemas en algun dato
                    v_mensaje     := 'Hay problemas con la cuenta Debito';
                    v_cod_error   := 4;
                    v_general     := v_general + v_cod_error;
                     pr_mensajeUsuario(PRO_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     v_msj_bitacora := v_msj_bitacora || ', CTA-ERR:[' || substr(v_error, 1, 50)||']';
                  ELSE
                     v_cod_respuesta := paw_bem.v_cod_aprobado;
                     v_mensaje     := 'Aprobado';
                  END IF;
                  v_can_detalles := p_can_factura;
                  v_lugar        := 'Generando salida';

                  FOR r1 IN c_detalle(v_nro_archivo) LOOP
                     v_detalle.numeroOrden          := r1.nro_orden;
                     v_detalle.numeroFactura        := substr(r1.nro_factura, 1, 15);
                     v_detalle.formaPago            := r1.for_pago;
                     v_detalle.numeroCuentaCredito  := r1.nro_cta_credito;
                     v_detalle.montoCredito         := r1.monto;
                     v_detalle.nombreBeneficiario   := substr(r1.beneficiario, 1, 50);
                     v_detalle.codigoMoneda         := r1.cod_moneda;
                     v_detalle.concepto             := substr(nvl(v_concepto, r1.concepto), 1, 40);
                     v_detalle.codigoProceso        := r1.cod_proceso;
                     --validamos factura
                     IF length(substr(r1.nro_factura, 1, 15)) <= 0 then
                       pr_mensajeUsuario(PRO_NRO_FAC_INVALIDA,
                                      v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta,
                                      v_retorno.error);
                       v_detalle.mensajeRespuesta     := 'Factura invalida';
                       v_detalle.error   := 'S';
                       v_cod_error   := 1;
                       v_general     := v_general + v_cod_error;
                     ELSE
                       v_cod_respuesta := paw_bem.v_cod_aprobado;
                       v_detalle.mensajeRespuesta     := 'Aprobado';
                       v_detalle.error   := 'N';
                     END IF;

                     IF r1.monto <= 0 THEN

                        IF v_cod_respuesta = paw_bem.v_cod_aprobado THEN
                          -- monto invalido
                          pr_mensajeUsuario(PRO_COD_MTO_INVALIDO,
                                      v_retorno.nombreRespuesta,
                                      v_retorno.descripcionRespuesta,
                                      v_retorno.error);
                           v_cod_respuesta := PRO_COD_MTO_INVALIDO ;
                           v_cod_error   := 2;
                           v_detalle.mensajeRespuesta     := 'Monto invalido';
                           v_detalle.error   := 'S';
                           v_general     := v_general + v_cod_error;
                        ELSE
                          v_cod_respuesta := PRO_COD_MTO_INVALIDO;
                          v_cod_error := 3;
                          v_detalle.mensajeRespuesta     := 'Monto invalido';
                          v_detalle.error   := 'S';
                          v_general     := v_general + v_cod_error;
                        END IF;
                     ELSE
                        v_cod_respuesta := paw_bem.v_cod_aprobado;
                        v_detalle.mensajeRespuesta     := 'Aprobado';
                        v_detalle.error   := 'N';
                     END IF;
                     --validamos cuenta a acreditar
                     pag_cta.PR_OBT_CUENTA(r1.nro_cta_credito);
                     if PAG_CTA.fu_obt_cod_error != 0 OR
                        PAG_CTA.g_ctas.cod_modalidad != 31 OR
                        PAG_CTA.g_ctas.estado IN ('X', 'C', 'P') THEN
                        v_cod_error   := 4;
                        v_detalle.mensajeRespuesta     := 'Cuenta inexistente';
                        v_detalle.error   := 'S';
                        v_general     := v_general + v_cod_error;
                        pr_mensajeUsuario(PRO_CTA_DEB_INEXISTENTE,
                                          v_retorno.nombreRespuesta,
                                          v_retorno.descripcionRespuesta,
                                          v_retorno.error);
                      END IF;
                      --
                      IF TRIM(r1.cod_moneda) <> pag_cta.g_ctas.cod_moneda THEN
                            pr_mensajeUsuario(PRO_CTA_DEB_INEXISTENTE,
                                              v_retorno.nombreRespuesta,
                                              v_retorno.descripcionRespuesta,
                                              v_retorno.error);
                             v_detalle.mensajeRespuesta  := 'La moneda de la cuenta es invalida';
                             v_detalle.error   := 'S';
                             v_cod_error := 3;
                             v_general     := v_general + v_cod_error;

                      END IF;
                      --verifico si la cuenta esta duplicada en el ge_pag_proveedores_tmp
                      BEGIN
                        SELECT COUNT(*)
                          INTO v_cantidad
                          FROM ge_pag_proveedores_tmp
                         WHERE cod_ente = p_cod_ente
                           AND usu_insercion = USER
                           AND nro_cta_credito = r1.nro_cta_credito
                           AND tip_carga = 'H'
                           AND nro_archivo = v_nro_archivo
                           AND trunc(fec_insercion) = trunc(SYSDATE);
                        IF nvl(v_cantidad, 0) > 1 THEN
                           pr_mensajeUsuario(pro_cta_deb_duplicada, v_retorno.nombreRespuesta,
                                             v_retorno.descripcionRespuesta, v_retorno.error);
                           v_detalle.mensajerespuesta := 'Cuenta duplicada en el archivo';
                           v_detalle.error            := 'S';
                           v_cod_error                := 5;
                           v_general                  := v_general + v_cod_error;
                        END IF;
                      EXCEPTION
                         WHEN no_data_found THEN
                            v_cantidad := 0;
                      END;
                      --verifico si los datos estan duplicados en el ge_pag_proveedores
                      --orden+nro_factura+cod_ente
                      v_cantidad := 0;
                      BEGIN
                          SELECT COUNT(*)
                            INTO v_cantidad
                            FROM ge_pag_proveedores p
                           WHERE p.nro_orden = r1.nro_orden
                             AND p.cod_ente = p_cod_ente;
                          IF nvl(v_cantidad, 0) > 0 THEN
                             v_detalle.mensajerespuesta := 'El nro de orden no se puede repetir.';
                             v_detalle.error            := 'S';
                             v_cod_error                := 1;
                             v_general                  := v_general + v_cod_error;
                             pr_mensajeUsuario(pro_err_dat_invalidos, v_retorno.nombreRespuesta,
                                               v_retorno.descripcionRespuesta, v_retorno.error);
                             pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion,
                                                 v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                                 v_msj_bitacora || ', lug: ' || v_lugar || ', cantReg: ' ||
                                                  v_can_detalles ||
                                                  fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                                     v_retorno.descripcionRespuesta, NULL),
                                                 bitacora_error);
                          END IF;
                       EXCEPTION
                          WHEN no_data_found THEN
                             v_cantidad := 0;
                       END;
                       --verifico si los datos estan duplicados en el ge_pag_pro_facturas
                       --orden+nro_factura+cod_ente
                       v_cantidad := 0;
                       BEGIN
                          SELECT COUNT(*)
                            INTO v_cantidad
                            FROM ge_pag_pro_facturas p
                           WHERE p.nro_orden = r1.nro_orden
                             AND p.nro_factura = substr(r1.nro_factura, 1, 15)
                             AND p.cod_ente = p_cod_ente;
                          IF nvl(v_cantidad, 0) > 0 THEN
                             v_detalle.mensajerespuesta := 'El nro de orden+nro de factura no se puede repetir.';
                             v_detalle.error            := 'S';
                             v_cod_error                := 1;
                             v_general                  := v_general + v_cod_error;
                             pr_mensajeUsuario(pro_err_dat_invalidos, v_retorno.nombreRespuesta,
                                               v_retorno.descripcionRespuesta, v_retorno.error);
                             pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion,
                                                 v_cod_operacion, v_usu_sesion.codigoEmpresa,
                                                 v_msj_bitacora || ', lug: ' || v_lugar || ', cantReg: ' ||
                                                  v_can_detalles ||
                                                  fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,
                                                                     v_retorno.descripcionRespuesta, NULL),
                                                 bitacora_error);
                          END IF;
                       EXCEPTION
                           WHEN no_data_found THEN
                             v_cantidad := 0;
                       END;
                       IF r1.f_cantidad > 999 THEN
                            pr_mensajeUsuario(PRO_MAX_FAC_EXCEDIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                            v_msj_bitacora := v_msj_bitacora || ', canFac:'||r1.f_cantidad;
                           EXIT;
                       END IF;
                       v_detalle.referenciaFacturas   := substr(r1.ref_facturas, 1, 300);
                       v_lis_detalle.extend;
                       v_lis_detalle(v_lis_detalle.count) := v_detalle;
                   END LOOP;
\*
                   If nvl(v_lis_detalle.count,0) != nvl(p_can_factura,0) then
                     pr_mensajeUsuario(PRO_NRO_REGISTRO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                     pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                     --  Obtiene la informacion de parametros recibos y el return del type
                     paw_log.g_typ_pagoProveedores := v_retorno;
                     paw_log.pr_logValoresTypes('typ_pagoProveedores',
                     'PagoProveedores'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
                     p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
                     p_tipoPago||', '|| p_cantFacturas);


                     RETURN v_retorno;
                   End If;
*\
                   v_retorno.listaProveedores := v_lis_detalle;
               END IF;
               IF p_modo <> 'C' OR v_retorno.error = 'S' THEN
                  v_lugar := 'Borrando pendientes 2';
                  pag_prv.PR_ELI_PROV_TMP(p_cod_ente,'N'\*, SYSDATE, v_nro_archivo*\);
                  v_lugar := 'Borrando pendientes 3';
                  pag_prv.PR_ELI_FAC_TMP(p_cod_ente\*, SYSDATE, v_nro_archivo*\);
               END IF;
               IF v_retorno.error = 'N' AND p_modo = 'C' THEN
                   SELECT s_nro_documento.NEXTVAL
                    INTO v_nro_documento
                    FROM dual;
                    --actualizamos la referencia de la tabla temporal ge_pag_proveedores_tmp
                    begin
                      update ge_pag_proveedores_tmp
                         set referencia = v_nro_documento
                       where trunc(fec_insercion) = trunc(sysdate)
                         and usu_insercion = user; --por el usuario
                    end;
                    --
                    v_retorno.numeroDocumento := v_nro_documento;
                    v_retorno.cantidadAutorizadores := v_can_aut_requeridas;

                    IF v_can_aut_requeridas > 0 THEN
                       v_lugar := 'Insertando mov pendiente';
                       --- inserto el movimiento pendiente de autorizacion

                       INSERT INTO bw_mov_pendientes
                        (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cantidad, etiqueta, dato, etiqueta2, dato2, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, referencia, tip_pago)
                       VALUES
                        (v_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito, v_cod_moneda, v_des_pendiente, v_tot_debito, p_can_factura, 'Ente', p_cod_ente, 'Fechas de Pago', to_char(p_fec_pago1, 'dd/mm/yyyy') \*|| ' ' || to_char(p_fec_pago2, 'dd/mm/yyyy')*\, 'P', v_can_aut_requeridas, v_can_aut_requeridas, v_usu_sesion.codigoPersona, v_nro_archivo, v_tip_pago);
                    ELSE
                      \* Se inserta como movimiento pendiente solo para agrupar
                        para el procedimiento de generacion de movimientos*\
                      INSERT INTO bw_mov_pendientes
                        (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cantidad, etiqueta, dato, etiqueta2, dato2, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, referencia, tip_pago)
                      VALUES
                        (v_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito, v_cod_moneda, v_des_pendiente, v_tot_debito, p_can_factura, 'Ente', p_cod_ente, 'Fechas de Pago', to_char(p_fec_pago1, 'dd/mm/yyyy') \*|| ' ' || to_char(p_fec_pago2, 'dd/mm/yyyy')*\, 'C', 0, 0, v_usu_sesion.codigoPersona, v_nro_archivo, v_tip_pago);

                      pag_prv.PR_VER_DAT_TMP(p_cod_ente, p_fec_pago1, NULL\*p_fec_pago2*\, v_error, 'S'\*, v_nro_documento, v_nro_cta_debito, v_nro_archivo*\);

                      IF v_error IS NOT NULL THEN
                          v_cod_respuesta := PRO_ERR_VER_PAGO;
                          v_mensaje     := 'Error en pago Proveedor';
                          pr_mensajeUsuario(PRO_ERR_VER_PAGO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          v_msj_bitacora := v_msj_bitacora || ', err: [' || substr(v_error, 1, 50) || ']';
                      ELSE
                          v_cod_respuesta := paw_bem.v_cod_aprobado;
                          v_mensaje     := 'Aprobado';
                          -- Se generan los movimientos automaticamente
                          IF to_char(p_fec_pago1, 'DD/MM/YYYY') = trunc(SYSDATE) THEN
                             pag_prv.PR_PRO_PAGO(p_cod_ente, v_nro_documento, v_err_pago);
                             IF v_err_pago <> '00' THEN
                                v_cod_respuesta := PRO_ERR_PRO_PAGO;
                                v_mensaje     := 'Error en pago Proveedor';
                                v_cod_error   := 2;
                                v_general     := v_general + v_cod_error;
                                pr_mensajeUsuario(PRO_ERR_PRO_PAGO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                             ELSE
                                it_mail.mail(fug_obt_dir_correo, 'itc_productos@itconsultores.com.py', 'Pago a Proveedores en Linea',
                                           'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) || 'Codigo  : ' || p_cod_ente || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Monto   : ' || to_char(v_tot_debito, '999G999G999G999D99') || ' ' || v_cod_moneda || chr(10) || 'Cantidad: ' || to_char(p_can_factura) || chr(10) || 'Fecha de Pago: ' || to_char(p_fec_pago1) || chr(10) || chr(10) || 'Atentamente. ');
                             END IF;
                          ELSE
                             it_mail.mail(fug_obt_dir_correo, 'itc_productos@itconsultores.com.py', 'Pago a Proveedores Fecha Futura',
                                        'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) || 'Codigo  : ' || p_cod_ente || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Monto   : ' || to_char(v_tot_debito, '999G999G999G999D99') || ' ' || v_cod_moneda || chr(10) || 'Cantidad: ' || to_char(p_can_factura) || chr(10) || 'Fecha de Pago: ' || to_char(p_fec_pago1) || chr(10) || chr(10) || 'Atentamente. ');
                          END IF;
                      END IF;
                    END IF;
                    v_lugar := 'Enviando correo incorrecto';
                    -- si hubieron registros eliminados por el usuario se envia para conocimiento del ente
                    IF v_error IS NULL  THEN
                     -- obtenemos la direccion de correo de la empresa
                     BEGIN
                        v_dir_correo := fug_obt_dir_mail_per(v_usu_sesion.codigoEmpresa);
                     EXCEPTION
                        WHEN OTHERS THEN
                           v_dir_correo := 'itc_productos@itconsultores.com.py';
                     END;
                     BEGIN

                        it_mail.mail(fug_obt_dir_correo, v_dir_correo, 'Pago a Proveedores - Registros No Procesados',
                                     'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) || 'Codigo  : ' || p_cod_ente || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Moneda  : ' || v_cod_moneda || chr(10) || 'Fecha de Pago: ' || to_char(p_fec_pago1) || chr(10) || chr(10) || 'Se envia adjunto los registros no acreditados' || chr(10) || chr(10) || 'Atentamente. ' || ' ' || RPAD('CUENTA', 15) || RPAD('BENEFICIARIO', 50) || RPAD('MONTO', 18) || RPAD('MOTIVO', 40) || chr(13) ||
                                      chr(10) || RPAD('-', 123, '-') || p_cod_ente || '_' || v_cod_moneda || '_reg_eli_' || to_char(SYSDATE, 'yyyymmddhh24miss') || '.txt');

                     EXCEPTION
                        WHEN OTHERS THEN
                           pr_mensajeUsuario(PRO_ERR_COR_INVALIDOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', lug: ' || v_lugar || ', cantReg: ' || v_can_detalles || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);

                           RETURN V_RETORNO;
                     END;

          END IF;
               END IF;
            ELSE
                pr_mensajeUsuario(PRO_CAN_FAC_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            END IF;

         END IF;
      END IF;
      --
      v_lugar := 'Registrando log';
      v_retorno.cantidadProveedores := v_can_detalles;
      IF v_retorno.error = 'S' THEN
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      ELSE
         SELECT s_nro_operacion.Nextval
           INTO v_nro_documento
           FROM dual;
        paw_con.pr_reg_operacion(v_nro_cta_debito \*p_nro_cuenta*\,
                          v_cod_moneda \*p_cod_moneda *\,
                          v_tot_debito \*p_monto*\,
                          NULL \*p_nro_cta_contra*\,
                          p_can_factura \*p_cantidad*\,
                          'Ente' \*p_etiqueta*\,
                          p_cod_ente \*p_dato*\,
                          'Fec.Pago',
                          to_char(p_fec_pago1) ,
                          'Homebanking',
                          NULL,
                          '000',
                          v_usu_sesion.codigoPersona,
                          v_cod_operacion,
                          v_nro_documento,
                          p_codigoCanal,
                          p_sesion,
                          v_usu_sesion.codigoEmpresa);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      END IF;
      -- siempre se responde con los detalles, sea o no sea con errores
      IF nvl(v_general,0) > 0 then
       pr_mensajeUsuario(MSG_ERROR,
                                v_retorno.nombreRespuesta,
                                v_retorno.descripcionRespuesta,
                                v_retorno.error);
      END IF;

    \*  Obtiene la informacion de parametros recibos y el return del type *\
     paw_log.g_typ_pagoProveedores := v_retorno;
     paw_log.pr_logValoresTypes('typ_pagoProveedores',
     'PagoProveedores'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
     p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
     p_tipoPago||', '|| p_cantFacturas);
     RETURN v_retorno;
    EXCEPTION
     WHEN OTHERS THEN
         pr_mensajeUsuario(PRO_ERR_DAT_INVALIDOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', lug: ' || v_lugar || ', cantReg: ' || v_can_detalles || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         \*  Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_pagoProveedores := v_retorno;
         paw_log.pr_logValoresTypes('typ_pagoProveedores',
         'PagoProveedores'||'- '||p_sesion||', '|| p_codigoCanal||', '||  p_codigoEnte||', '||
         p_modoControl||', '|| p_cuentaDebito||', '|| p_fechaPago||', '||
         p_tipoPago||', '|| p_cantFacturas);
         RETURN v_retorno;
   END;--pagoProveedores*/
     -- Validacion y confirmacion de pago a proveedores
     FUNCTION fu_pagoProveedores_dev(p_sesion                 IN VARCHAR2,
                   p_codigoCanal            IN VARCHAR2,
                   p_codigoEnte             IN NUMBER,
                   p_modoControl            IN VARCHAR2,
                   p_cuentaDebito           IN VARCHAR2,
                   p_fechaPago              IN DATE,
                   p_tipoPago               IN VARCHAR2,
                   p_cantOrdenes            IN NUMBER,
                   p_cantFacturas           IN NUMBER,
                   p_parametros             IN CLOB,
                   p_par_errores            IN CLOB,
                   p_claveTransaccional     IN VARCHAR2,
                   p_claveToken             IN VARCHAR2) RETURN typ_pagoProveedores IS--NVB-2232
      -- datos recibidos
      p_modo              VARCHAR2(1) := substr(trim(p_modoControl), 1, 1); -- modo de control C-CONFIRMA
      p_cod_ente          NUMBER(5) := p_codigoEnte;
      p_can_orden         NUMBER(5) := p_cantOrdenes;
      v_registro          VARCHAR2(4000);
      v_arc_mon_local     VARCHAR2(100);
      v_arc_mon_fuerte    VARCHAR2(100);
      v_for_archivo       VARCHAR2(100);
      v_detalle           typ_detalleProveedor := typ_detalleProveedor(); -- datos de las cuentas
      v_lis_detalle       typ_listadetalleproveedor := typ_listadetalleproveedor();
      v_cod_ente          NUMBER(6); -- codigo del ente
      v_des_ente          VARCHAR2(100); -- descripcion del ente
      v_tip_comprobante   ge_pag_proveedores_tmp.tip_comprobante%TYPE;
      v_mod_reg_pago      ge_par_dinamicos.val_parametro%TYPE;
      r_orden             ge_pag_proveedores_tmp%ROWTYPE;
      v_pos_ant           NUMBER(8);
      v_pos_nvo           NUMBER(8);
      v_nro_documento     NUMBER(20);
      v_tot_debito        ge_movimientos.monto%TYPE;
      v_mto_debito        ge_movimientos.monto%TYPE;
      v_cot_credito       ge_movimientos.cotizacion%TYPE;
      v_cot_debito        ge_movimientos.cotizacion%TYPE;
      v_cod_moneda        ge_cuentas.cod_moneda%TYPE;
      v_cta_for_debito    VARCHAR2(17);
      v_nom_cta_debito    VARCHAR2(100);
      v_nro_cta_debito    ge_cuentas.nro_cuenta%TYPE;
      v_error             VARCHAR2(2000);
      p_fec_pago1         DATE := p_fechaPago;
      v_err_pago          VARCHAR2(2) := '00';
      v_cod_modulo        ge_movimientos.cod_modulo%TYPE;
      v_cod_modalidad     ge_movimientos.cod_modalidad %TYPE;
      v_cod_oficina       ge_movimientos.cod_oficina%TYPE;
      v_tra_pad_proveedor ge_movimientos.cod_tra_padre%TYPE := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_PPROV');
      v_tra_pad_credito   ge_movimientos.cod_tra_padre%TYPE := fug_obt_parentes(p_cod_ente, 'COD_TRA_PAD_PRV_CREDITO');
      v_prioridad         VARCHAR2(1);
      v_cod_tra_padre     ge_movimientos.cod_tra_padre%TYPE;
      v_lin_inicial       ge_archivos.lin_inicial%TYPE;
      v_separador         ge_archivos.separador%TYPE;
      v_cant_separador    NUMBER;
      v_pos_ant_proc      NUMBER;
      v_pos_nvo_proc      NUMBER;
      v_tip_pago          VARCHAR2(1); -- P: Pago a proveedores, C: Crédito en cuenta
      v_des_pendiente     bw_mov_pendientes.descripcion%TYPE;
      v_can_ordenes       NUMBER := 0; -- cantidad de ordenes para crédito
      v_dir_correo        ba_personas.dir_correo%TYPE;
      v_lugar             VARCHAR2(100);
      v_cod_operacion     VARCHAR2(3) := '075';
      v_resLimite         typ_respuestaLimite;
      v_fec_actual        DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy;
      v_retorno           typ_pagoProveedores := typ_pagoProveedores();--NVB-2232
      v_usu_sesion        typ_validarsesion;
      v_msj_respuesta     typ_MensajeRespuesta := typ_MensajeRespuesta;
      v_msj_caja          typ_mensajeCaja;
      v_permiso           typ_obtenerPermisos;
      v_nro_archivo       ge_pag_proveedores_tmp.nro_archivo%type;
      v_can_ord_sipap     NUMBER := 0;
      v_can_orden      NUMBER := 0;
      v_can_limite        NUMBER := 0;
      v_cam_fecha         BOOLEAN;
      v_est_periodo       ge_snp_horarios.estado%TYPE;
      v_fec_snp_hor       ge_snp_horarios.fecha%TYPE;
      v_cantidad          NUMBER;
      v_exi_for_pago      VARCHAR2(1);
      v_hab_ach           varchar2(1) := substr(fug_obt_pardinamico('SNP_HAB_MSJ_ACH'),1,1);
      v_hora_fin          ge_snp_horarios.hor_fin%TYPE;
      v_hora_pro          ge_snp_horarios.hor_fin%TYPE;
      v_nro_movimiento bw_movimientos.nro_movimiento%type;--BWP-311
      v_msj_bitacora      VARCHAR2(800) := substr('ente:'||trim(p_codigoEnte)
                               ||', modo:'||trim(p_modoControl)
                               ||', ctaDeb:'||trim(p_cuentaDebito)
                               ||', fecPag:'||p_fechaPago
                               ||', tipPag:'||p_tipoPago
                               ||', canOrd:'||p_cantOrdenes
                               ||', canFac:'||p_cantFacturas, 1, 500);
      PRO_PER_SIN_AUT         CONSTANT VARCHAR2(15) := 'PRO_PER_SIN_AUT';
      PRO_FEC_PAG_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_FEC_PAG_INV';
      PRO_TRA_PAD_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_TRA_PAD_INV';
      PRO_CTA_DEB_TERCERO     CONSTANT VARCHAR2(15) := 'PRO_CTA_DEB_TER';
      PRO_MON_PAG_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_MON_PAG_INV';
      PRO_FMT_ARC_INDEFINIDO  CONSTANT VARCHAR2(15) := 'PRO_FMT_ARC_IND';
      PRO_CTA_DEB_INEXISTENTE CONSTANT VARCHAR2(15) := 'PRO_CTA_DEB_INE';
      PRO_CTA_DEB_DUPLICADA   CONSTANT VARCHAR2(15) := 'PRO_CTA_DEB_DUP';
      PRO_OBT_ERR_CTA_DEBITO  CONSTANT VARCHAR2(15) := 'PRO_OBT_CTA_DEB';
      PRO_FEC_PAG_NOHABIL     CONSTANT VARCHAR2(15) := 'FEC_PAG_NOHABIL';
      OPE_NO_PERMITIDA        CONSTANT VARCHAR2(15) := 'P_OP_NO_PERM';
      PRO_ERR_DATOS           CONSTANT VARCHAR2(15) := 'PRO_ERR_DATOS';
      PRO_MAX_CRE_EXCEDIDO    CONSTANT VARCHAR2(15) := 'PRO_MAX_CRE_EXE';
      PRO_ERR_FOR_PAGO        CONSTANT VARCHAR2(15) := 'PRO_ERR_FOR_PAG';
      PRO_ERR_SIPAP           CONSTANT VARCHAR2(15) := 'PRO_ERR_SIPAP';
      PRO_ERR_VER_PAGO        CONSTANT VARCHAR2(15) := 'PRO_ERR_VER_PAG';
      PRO_ERR_PRO_PAGO        CONSTANT VARCHAR2(15) := 'PRO_ERR_PRO_PAG';
      PRO_CAN_ORD_INVALIDA    CONSTANT VARCHAR2(15) := 'PRO_CAN_ORD_INV';
      PRO_ERR_DAT_INVALIDOS   CONSTANT VARCHAR2(15) := 'PRO_ERR_DAT_INV';
      PRO_ERR_REQ_FIRMA       CONSTANT VARCHAR2(15) := 'PRO_ERR_REQ_FIR';
      PRO_ERR_FOR_INCORRECTO  CONSTANT VARCHAR2(15) := 'PRO_ERR_FFORMAT';
      v_e                     exception;
      -- registro de detalles
      CURSOR c_detalle(p_nro_archivo in number) IS
       SELECT nro_orden, nro_factura, tip_comprobante, for_pago, nro_cheque, nro_cta_credito,
          fec_ingreso, fec_pago, monto, nro_recibo, beneficiario,
          decode(cod_proceso, 0, concepto, InitCap(concepto)) concepto, estado,
          cod_usu_operador, a.cod_ente, cod_proceso, cod_moneda, tip_carga,
          nvl(f_cantidad, 0) f_cantidad, ref_facturas, ent_bca_beneficiario,
          nro_doc_beneficiario, cod_tip_doc_beneficiario, nro_cta_beneficiario,
          ind_valor, nro_con_cambio, ben_dir_correo, a.cod_swift
         FROM ge_pag_proveedores_tmp a,
          (SELECT cod_ente f_cod_ente, nro_orden f_nro_orden, COUNT(*) f_cantidad
             FROM ge_pag_pro_facturas_tmp
             WHERE cod_ente = p_cod_ente
              AND trunc(fec_insercion) = trunc(SYSDATE)
              AND usu_insercion = USER
           GROUP BY cod_ente, nro_orden)
        WHERE a.cod_ente = p_cod_ente
         AND f_cod_ente(+) = a.cod_ente
         AND f_nro_orden(+) = nro_orden
         AND usu_insercion = USER
         AND tip_carga = 'H'
         AND nro_archivo = p_nro_archivo
         AND trunc(fec_insercion) = trunc(sysdate)
         --UES-2087
       ORDER BY cod_proceso desc;
      -- cuentas proveedores
      CURSOR c_cta IS
      SELECT DISTINCT (TRIM(a.beneficiario)) beneficiario, (TRIM(decode(a.nro_cta_credito, '0', ' ', NULL, ' ', a.nro_cta_credito))) cta_credito, g.cod_moneda
      FROM ge_cuentas g,
         (SELECT DISTINCT (TRIM(beneficiario)) beneficiario, MAX(TRIM(nro_cta_credito)) nro_cta_credito
           FROM ge_pag_proveedores
          WHERE cod_ente = p_cod_ente
            AND fec_pago > SYSDATE - 90
            AND for_pago = 'C'
            AND estado IN ('C', 'N')
          GROUP BY beneficiario
           /*UNION
           SELECT DISTINCT (TRIM(beneficiario)), MAX(TRIM(nro_cta_credito)) nro_cta_credito
           FROM ge_pag_proveedores_tmp
          WHERE cod_ente = p_cod_ente
            AND ent_bca_beneficiario IS NULL
          GROUP BY beneficiario*/) a
       WHERE g.nro_cuenta(+) = a.nro_cta_credito
       AND nvl(g.estado, 'A') IN ('A', 'N', 'I');

     CURSOR c_cta_sipap IS
      SELECT DISTINCT (TRIM(beneficiario)) beneficiario, ent_bca_beneficiario,
           nro_doc_beneficiario, cod_tip_doc_beneficiario, cod_moneda,  MAX(TRIM(nro_cta_beneficiario)) nro_cta_beneficiario, cod_swift
        FROM ge_pag_proveedores
       WHERE cod_ente = p_cod_ente
         AND fec_pago > SYSDATE - 90
         AND for_pago = 'I'
         AND estado IN ('C','N')
       GROUP BY beneficiario, ent_bca_beneficiario, nro_doc_beneficiario, cod_tip_doc_beneficiario, cod_moneda;

      FUNCTION lf_obt_con_cambio(p_nro_contrato IN NUMBER) RETURN NUMBER IS
       v_retorno lc_ope_pendientes.nro_diario%TYPE := NULL;
      BEGIN
       IF p_nro_contrato IS NOT NULL THEN
         SELECT l.nro_diario
         INTO v_retorno
         FROM lc_ope_pendientes l
        WHERE l.nro_operacion = p_nro_contrato
          AND l.liquidado = 'N'
          AND l.ope_homebanking = 'S'
          AND l.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
          AND TRUNC(l.fec_operacion) = TRUNC(SYSDATE);
       END IF;
       RETURN v_retorno;
      EXCEPTION
       WHEN OTHERS THEN
        RETURN NULL;
      END;
     /* Obtiene la hora fin snp de un periodo */
     FUNCTION LF_OBT_HOR_FIN_SNP(P_COD_PERIODO IN GE_SNP_HORARIOS.COD_PERIODO%TYPE) RETURN VARCHAR2 IS
      v_retorno ge_snp_horarios.hor_fin%TYPE;
     BEGIN
      SELECT h.hor_fin
        INTO v_retorno
        FROM ge_snp_horarios h
       WHERE h.cod_periodo = p_cod_periodo;

      RETURN v_retorno;

     EXCEPTION
      WHEN OTHERS THEN
         RETURN NULL;
     END LF_OBT_HOR_FIN_SNP;
     --
     PROCEDURE pp_asi_nro_orden(p_cod_ente    ge_pag_proveedores_tmp.cod_ente%type,
                                p_nro_archivo ge_pag_proveedores_tmp.nro_archivo%type) IS
       v_existe number;
       v_nro_orden number;
       -- Curson de registros sin nro_orden
       Cursor c_cursor is
       Select t.*, rowid
         From ge_pag_proveedores_tmp t
        Where trunc(fec_insercion) = trunc(sysdate)
          and t.nro_archivo        = p_nro_archivo
          and t.cod_ente           = p_cod_ente
          and t.nro_orden          = 0;
      BEGIN
         Select count(*)
           into v_existe
           from ge_pag_proveedores_tmp t
          where trunc(fec_insercion)           = trunc(sysdate)
            and t.cod_ente                     = p_cod_ente
            and nvl(t.ind_gen_nro_orden, 'N')  = 'S'; -- Existe nro_orden generado automaticamente
           If v_existe = 0 Then      -- si no existe ningun numero generado entonces se toma el ultimo nro_orden de ge_pag_proveedores
              Select max(nro_orden)
                into v_nro_orden
                from ge_pag_proveedores
               where cod_ente = p_cod_ente;
           Else                     -- se toma el ultimo nro_orden generado en ge_pag_proveedores_tmp
              Select max(nro_orden)
                into v_nro_orden
                from ge_pag_proveedores_tmp
               where cod_ente = p_cod_ente
                 and nvl(ind_gen_nro_orden, 'N')  = 'S' ;
           End if;

            For reg in c_Cursor loop
              v_nro_orden := nvl( v_nro_orden, 0 ) + 1;
              update ge_pag_proveedores_tmp
                 set nro_orden         = v_nro_orden,
                     ind_gen_nro_orden = 'S'
               where trunc(fec_insercion) = trunc(sysdate)
                 and cod_ente             = p_cod_ente
                 and nro_archivo          = p_nro_archivo
                 and rowid                = reg.rowid
                 and nvl(nro_Secuencia,0) = nvl(reg.nro_Secuencia,0); --Agregado NVL para Nro. Secuencia ya que en Archivo viene Nulo. KF.
             End loop;

     END pp_asi_nro_orden;

     BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      -- 1. valido la clave del cliente
      v_lugar := 'Validacion de la clave';
      v_usu_sesion := fu_validarSesion(depurarAlfanumerico(p_sesion,32), p_codigoCanal);
      IF v_usu_sesion.error = 'S' THEN
       v_retorno.error                := v_usu_sesion.error;
       v_retorno.nombreRespuesta      := v_usu_sesion.nombreRespuesta;
       v_retorno.descripcionRespuesta := v_usu_sesion.descripcionRespuesta;
       RETURN v_retorno;
      END IF;
      -- 2. verifica el canal de origen
      v_lugar := 'Validacion de la caja';
      v_msj_caja := lf_val_caja(v_usu_sesion);
      IF v_msj_caja.error = 'S' THEN
       v_retorno.error                := v_msj_caja.error;
       v_retorno.nombreRespuesta      := v_msj_caja.nombreRespuesta;
       v_retorno.descripcionRespuesta := v_msj_caja.descripcionRespuesta;
       RETURN v_retorno;
      END IF;
       /*
       Seteamos el valor del campo codigoUsuario ya que es el cual utiliza para guardar los movimientos.
       glopez - BWP-18
       */
       v_msj_caja.codigoUsuario  := fug_obt_user_sesion(p_sesion);

      -- 3. verifico si el cliente con su perfil tendrá acceso a realizar la transacción
      v_lugar := 'Control de permisos';
      v_permiso := lf_obt_permisos(v_usu_sesion, v_cod_operacion);
      IF (v_permiso.error = 'S') THEN
       v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
       v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
       v_retorno.error                := v_permiso.error;
       pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
       RETURN v_retorno;
      END IF;
      IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
       pr_mensajeUsuario(PRO_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
       RETURN v_retorno;
      END IF;
      pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);

      v_lugar := 'Tomando las fechas';
    /*  --Proyecto pago a proveedores
      IF p_fec_pago1 IS NOT NULL THEN
       BEGIN

        IF p_fec_pago1 < v_fec_actual OR p_fec_pago1 < trunc(SYSDATE) THEN
           pr_mensajeUsuario(PRO_FEC_PAG_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        ELSE
           IF pag_cal.fu_obt_fec_habil(p_fec_pago1, 1, v_msj_caja.codigoOficinaOrigen) != p_fec_pago1 THEN
            pr_mensajeUsuario(PRO_FEC_PAG_NOHABIL, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           END IF;
        END IF;
       EXCEPTION
        WHEN OTHERS THEN
           pr_mensajeUsuario(PRO_FEC_PAG_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       END;
      END IF;
*/
      -- 4. Verifico si la persona tiene el servicio de pago a proveedores
      IF v_retorno.error = 'N' THEN
       v_lugar := 'Datos del ente';
       BEGIN
        -- se elimina cta_debito porque ahora se recibe en la mensajería,
        -- se agrega el formato de archivo para pagos en USD
        SELECT a.cod_ente, a.descripcion, fug_obt_parentes(a.cod_ente, 'TIP_COB_PPROV'), fug_obt_parentes(a.cod_ente, 'REF_TXT_PPROV'), fug_obt_parentes(a.cod_ente, 'REF_TXT_PPROV_USD'), nvl(fug_obt_parentes(a.cod_ente, 'SNP_TIP_PRIORIDAD'), 'A')
          INTO v_cod_ente, v_des_ente, v_tip_comprobante, v_arc_mon_local, v_arc_mon_fuerte, v_prioridad
          FROM ge_entes a
         WHERE a.cod_persona = nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)
           AND a.tipo = 'PR'
           AND (p_modo = 'D' OR (p_modo <> 'D' AND a.cod_ente = p_cod_ente))
           AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO_PRV') = 'S'
           AND fug_obt_parentes(a.cod_ente, 'HAB_HOMEBANKING_PRV') = 'S';
        -- a veces en el modo D no se puede obtener el codigo ente desde aguara
        IF p_modo = 'D' THEN
           p_cod_ente := v_cod_ente;
        END IF;
        ---
        -- CR 03/09/2012 - La cuenta de débito ahora se recibe como parámetro en la mensajería
        -- validamos la misma y verificamos si pertenece al ente
        IF p_modo IN ('L', 'D', 'C', 'V') THEN
           v_nro_cta_debito := TRIM(substr(p_cuentaDebito, 1, 15));
           v_tip_pago       := TRIM(substr(p_tipoPago, 1, 1));

           IF v_tip_pago = 'P' THEN
            v_cod_tra_padre := v_tra_pad_proveedor; -- transacción padre para pago a proveedores
            v_des_pendiente := 'Proveedores';
           ELSIF v_tip_pago = 'C' THEN
            v_cod_tra_padre := v_tra_pad_credito; -- transacción padre para crédito en cuenta
            v_des_pendiente := 'Crédito en Cuenta';
           ELSE
            pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           END IF;
           -- si no existe transacción padre, retornamos el error
           IF p_modo <> 'D' AND v_cod_tra_padre IS NULL AND v_retorno.error = 'N' THEN
            pr_mensajeUsuario(PRO_TRA_PAD_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           END IF;
        ELSE
           pr_mensajeUsuario(OPE_NO_PERMITIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        END IF;
        -- validamos si la cuenta pertenece al cliente
        IF v_retorno.error = 'N' and p_modo <> 'D' THEN
           IF lf_val_cta_origen(v_nro_cta_debito, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona)) = 'N' THEN
            -- no es una cuenta del cliente
            pr_mensajeUsuario(PRO_CTA_DEB_TERCERO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           END IF;
        END IF;
        IF p_modo <> 'D' AND v_retorno.error = 'N' THEN
           SELECT cod_moneda
           INTO v_cod_moneda
           FROM ge_cuentas
          WHERE nro_cuenta = v_nro_cta_debito;

           -- CR: de acuerdo a la moneda, se elige el formato de archivo
           IF v_cod_moneda = paw_bce.v_cod_mon_local THEN
            v_for_archivo := v_arc_mon_local;
           ELSIF v_cod_moneda = pag_gen.FU_OBT_MON_FUERTE THEN
            v_for_archivo := v_arc_mon_fuerte;
           ELSE
           --v_cod_respuesta := paw_bce.v_cod_tra_invalida;s
           v_msj_bitacora := v_msj_bitacora || ', monDeb:' || v_cod_moneda;
           pr_mensajeUsuario(PRO_MON_PAG_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           END IF;

           -- CR: Si no tiene definido el formato de importación
           -- para archivos, debe dar error
           IF v_retorno.error = 'N' AND v_for_archivo IS NULL AND p_modo = 'L' THEN
            pr_mensajeUsuario(PRO_FMT_ARC_INDEFINIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           END IF;
        END IF;
       EXCEPTION
        WHEN no_data_found THEN
           pr_mensajeUsuario(PRO_CTA_DEB_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        WHEN too_many_rows THEN
           pr_mensajeUsuario(PRO_CTA_DEB_DUPLICADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        WHEN OTHERS THEN
           pr_mensajeUsuario(PRO_OBT_ERR_CTA_DEBITO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       END;
      END IF;

      IF p_modo = 'D' AND v_retorno.error = 'N' THEN
         FOR reg IN c_cta
       LOOP
        --v_can_detalles := v_can_detalles + 1;
        v_can_ordenes := v_can_ordenes + 1;

        -- armo el detalle de las cuentas a acreditar
        v_detalle.numeroOrden          := NULL;
        v_detalle.numeroFactura        := NULL;
        v_detalle.formaPago            := 'C';
        v_detalle.numeroCuentaCredito  := reg.cta_credito;
        v_detalle.montoCredito         := 0;
        v_detalle.nombreBeneficiario   := substr(reg.beneficiario, 1, 60);
        v_detalle.codigoMoneda         := reg.cod_moneda;
        v_detalle.concepto             := NULL;
        v_detalle.codigoProceso        := NULL;
        v_detalle.numeroBanco          := NULL;
        v_detalle.descripcionBanco     := fug_obt_pardinamico('NOM_BANCO');
        v_lis_detalle.extend;
        v_lis_detalle(v_lis_detalle.count) := v_detalle;
       END LOOP;
       FOR reg IN c_cta_sipap
       LOOP
        --v_can_detalles := v_can_detalles + 1;
        v_can_ordenes := v_can_ordenes + 1;

        -- armo el detalle de las cuentas a acreditar
        v_detalle.numeroOrden          := NULL;
        v_detalle.numeroFactura        := NULL;
        v_detalle.formaPago            := 'I';
        v_detalle.numeroCuentaCredito  := NULL;
        v_detalle.montoCredito         := 0;
        v_detalle.nombreBeneficiario   := substr(reg.beneficiario, 1, 60);
        v_detalle.codigoMoneda         := reg.cod_moneda;
        v_detalle.concepto             := NULL;
        v_detalle.codigoProceso        := NULL;
        v_detalle.numeroBanco          := reg.ent_bca_beneficiario;
        v_detalle.numeroCuentaBeneficiario := substr(reg.nro_cta_beneficiario, 1, 35);
        v_detalle.tipoDocumento        := substr(reg.cod_tip_doc_beneficiario, 1, 3);
        v_detalle.numeroDocumento      := substr(reg.nro_doc_beneficiario, 1, 20);
        v_detalle.descripcionBanco     := substr(lf_obt_bco_snp_swift(reg.cod_swift), 1, 60);
        v_lis_detalle.extend;
        v_lis_detalle(v_lis_detalle.count) := v_detalle;
       END LOOP;
       v_retorno.listaProveedores := v_lis_detalle;
      ELSE
       -- 4. Tomo la cantidad de cuentas recibidas

        IF v_for_archivo IS NOT NULL THEN
           BEGIN
            SELECT nvl(a.lin_inicial, 1), a.separador
            INTO v_lin_inicial, v_separador
            FROM ge_archivos a
             WHERE a.referencia = TRIM(v_for_archivo);
           EXCEPTION
            WHEN OTHERS THEN
             v_lin_inicial := 1;
             v_separador   := null;
           END;
        END IF;

        IF p_modo = 'L' THEN
          IF v_separador IS NOT NULL THEN
              v_cant_separador := instr(p_parametros,v_separador); --separador configurado
              IF v_cant_separador = 0 THEN
                 pr_mensajeUsuario(PRO_ERR_FOR_INCORRECTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              END IF;
          ELSE
              v_cant_separador := instr(p_parametros,'$'); --separador de excel
              IF v_cant_separador > 0 THEN
                 pr_mensajeUsuario(PRO_ERR_FOR_INCORRECTO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              END IF;
          END IF;
        END IF;

       IF v_retorno.error = 'N' THEN

        v_tip_comprobante := fug_obt_parentes(p_cod_ente, 'TIP_COB_PPROV');
        v_mod_reg_pago := nvl(TRIM(fug_obt_parentes(p_cod_ente, 'MOD_REG_PAG_PRV')), 'N'); /* N=Normal, P=Por operación*/

        v_pos_ant    := 1;
        v_tot_debito := 0;
        --comentado proyecto pago a proveedores
        /*v_cam_fecha := paw_bce.fu_ver_hor_cie_proveedor(p_fec_pago1);
        IF v_cam_fecha THEN
           v_msj_bitacora := v_msj_bitacora || ', camFec';
        END IF;*/
        v_nro_archivo := pag_prv.fu_obt_nro_secuencia(p_cod_ente, p_fec_pago1);
        v_msj_bitacora := v_msj_bitacora || ', nro_arc: ' ||v_nro_archivo;
        IF p_can_orden > 0 THEN
           v_can_ordenes := 0; -- para contar el total de créditos, no puede super paw_bce.v_max_imp_archivo
           -- CR 03/09/2012 se eliminó control de valor decimal
           -- ya que la misma se hace en pag_prv.pr_ver_dat_tmp
           FOR i IN 1 .. p_can_orden
           LOOP
            ----
            v_lugar := 'Leyendo el registro Nro.' || i;
            v_pos_nvo  := instr(p_parametros, '~', v_pos_ant);
            v_registro := substr(p_parametros, v_pos_ant, v_pos_nvo - v_pos_ant);
            v_pos_ant  := v_pos_nvo + 1;

            v_exi_for_pago      := 'S';

            r_orden             := NULL;
            r_orden.cod_ente    := p_cod_ente;

            r_orden.tip_comprobante  := v_tip_comprobante; -- Toma del parametro del Ente....
            r_orden.estado           := 'C';
            r_orden.tip_carga        := 'H';
            r_orden.nro_archivo      := v_nro_archivo;
            r_orden.cod_usu_operador := USER;
            r_orden.nro_cheque       := NULL;
            r_orden.fec_ingreso      := trunc(sysdate); --v_fec_actual;
            r_orden.cod_ente         := p_cod_ente;
            r_orden.cod_proceso      := NULL;
            r_orden.fec_pago         := p_fec_pago1;

            IF p_modo <> 'L' THEN
             -- formato fijo

             IF v_registro IS NULL OR length(TRIM(v_registro)) < 30 THEN
              GOTO end_loop;
             END IF;

             -- los campos vienen separados por ';'
             v_pos_ant_proc := 1;
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);

             -- CR: se agrega validación de dato ingresado
             v_lugar                 := 'nro orden';
             BEGIN
              --PDSYP-42 se coloca 0 para que siempre genere el numero de orden
              if COALESCE(fug_obt_pardinamico('GEN_AUT_ORD_PRV_PAYM'), 'S') = 'S' then 
                r_orden.nro_orden := 0; 
              else
                r_orden.nro_orden := substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc);
              end if;
             EXCEPTION
              WHEN OTHERS THEN
                 r_orden.nro_orden := 0;
             END;
             v_pos_ant_proc  := v_pos_nvo_proc + 1;

             v_lugar                 := 'nro factura';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.nro_factura := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 20); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'tipo pago';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.for_pago := TRIM(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc)); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'cuenta beneficiario';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.nro_cta_credito  := depurarAlfanumerico(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 15); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'monto';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.monto := to_number(replace(trim(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc)), ',', '.')); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'beneficiario';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.beneficiario := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 60); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'codigo moneda';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.cod_moneda := TRIM(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc)); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'ref facturas';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.ref_facturas := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 300); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'tipo documento';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.cod_tip_doc_beneficiario := substr(TRIM(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc)), 1, 3); v_pos_ant_proc := v_pos_nvo_proc + 1;

             /*v_lugar                 := 'Entidad beneficiaria';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.ent_bca_beneficiario := TRIM(substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 12)); v_pos_ant_proc := v_pos_nvo_proc + 1;*/

             v_lugar                 := 'Codigo Swift Entidad';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.cod_swift := TRIM(substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 20)); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'Documento beneficiario';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.nro_doc_beneficiario := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 20); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'Nro cta credito Sipap';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.nro_cta_beneficiario := depurarAlfanumerico(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 35); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'concepto';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.concepto := depurarTextos(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 35); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'indice valor';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.ind_valor := substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 1); v_pos_ant_proc := v_pos_nvo_proc + 1;
             --- OMM Dic/2017 Ajuste para no generar MT102
             -- MTOP Jun/2020 Ajuste para generar MT102 luego del corte
             if  nvl(r_orden.ind_valor, 'A') = 'A' and --nvl(v_hab_ach,'N') = 'N'
               paw_bas.fu_obt_tip_TransfInterbancaria('103','001','002', 302, r_orden.monto, r_orden.cod_moneda, null, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona))  = '103' then
               r_orden.ind_valor := 'A' ;
             else
               r_orden.ind_valor := 'B' ;
             end if ;

             v_lugar                 := 'contrato cambio';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.nro_con_cambio := substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 3); v_pos_ant_proc := v_pos_nvo_proc + 1;

             v_lugar                 := 'mail beneficiario';
             v_pos_nvo_proc := instr(v_registro, ';', v_pos_ant_proc);
             r_orden.ben_dir_correo := substr(substr(v_registro, v_pos_ant_proc, v_pos_nvo_proc - v_pos_ant_proc), 1, 80); v_pos_ant_proc := v_pos_nvo_proc + 1;
            ELSE
             -- por si se envien datos incorrectos, se omiten
             IF v_lin_inicial > i OR v_registro IS NULL OR length(TRIM(v_registro)) < 30 THEN
              GOTO end_loop;
             END IF;

             -- tomo los datos segun formato de archivo
             v_lugar             := 'Nro de orden';
             --PDSYP-42 se coloca 0 para que siempre genere el numero de orden
             if COALESCE(fug_obt_pardinamico('GEN_AUT_ORD_PRV_PAYM'), 'S') = 'S' then
               r_orden.nro_orden   := 0;
             else 
               r_orden.nro_orden   := trim(nvl(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_ORDEN'), 0));
             end if;
             v_lugar             := 'Nro de Factura';
             r_orden.nro_factura := depurarTextos(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_FACTURA'), 20);
             v_lugar             := 'Forma de pago';
             r_orden.for_pago    := paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'FOR_PAGO');
             v_lugar                 := 'Nro de cta credito';
             r_orden.nro_cta_credito := depurarAlfanumerico(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_CTA_CREDITO'), 15);
             v_lugar                 := 'monto';
             r_orden.monto           := paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'MONTO');
             v_lugar                 := 'Beneficiario';
             r_orden.beneficiario    := depurarTextos(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'BENEFICIARIO'), 60);
             v_lugar                 := 'Moneda';
             r_orden.cod_moneda      := paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'COD_MONEDA');
             v_lugar                 := 'Ref_factura';
             r_orden.ref_facturas    := depurarTextos(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'REF_FACTURAS'), 300);
             v_lugar                 := 'tipo documento';
             r_orden.cod_tip_doc_beneficiario := substr(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'COD_TIP_DOC_BENEFICIARIO'), 1, 3);
            /* v_lugar                 := 'Entidad beneficiaria';
             r_orden.ent_bca_beneficiario := TRIM(substr(paw_bce.fu_obt_dato(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'ENT_BCA_BENEFICIARIO'), 1, 5));*/
             v_lugar                 := 'Codigo Swift de la entidad';
             r_orden.cod_swift       := TRIM(substr(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'COD_SWIFT'), 1, 20));
             v_lugar                 := 'Documento beneficiario';
             r_orden.nro_doc_beneficiario := depurarTextos(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_DOC_BENEFICIARIO'), 20);
             v_lugar                 := 'Nro de cta sipap';
             r_orden.nro_cta_beneficiario := depurarAlfanumerico(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_CTA_BENEFICIARIO'), 35);
             v_lugar                 := 'concepto';
             r_orden.concepto        := depurarTextos(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'CONCEPTO'), 35);
             v_lugar                 := 'indice valor';
             r_orden.ind_valor       := v_prioridad;
             --- OMM Dic/2017 Ajuste para no generar MT102
             -- MTOP Jun/2020 Ajuste para generar MT102 luego del corte
             if nvl(r_orden.ind_valor, 'A') = 'A' and  --nvl(v_hab_ach,'N') = 'N')
              paw_bas.fu_obt_tip_TransfInterbancaria('103','001','002', 302, r_orden.monto, r_orden.cod_moneda, null, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona))  = '103' then
               r_orden.ind_valor := 'A' ;
             else
               r_orden.ind_valor := 'B' ;
             end if ;
             v_lugar                 := 'nro contrato';
             r_orden.nro_con_cambio  := substr(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'NRO_CON_CAMBIO'), 1, 7);
             v_lugar                 := 'correo beneficiario';
             r_orden.ben_dir_correo  := substr(paw_bce.fu_obt_dato_dev(v_for_archivo, 'GE_PAG_PROVEEDORES_TMP', v_registro, 'BEN_DIR_CORREO'), 1, 80);
            END IF;
            -- se valida en el temporal
            /*IF r_orden.for_pago IS NULL THEN
             r_orden.for_pago := 'C';
            END IF;*/
            IF r_orden.nro_factura IS NULL THEN
             r_orden.nro_factura := 0;
            END IF;
           /* IF r_orden.nro_orden = 0 THEN
             r_orden.nro_orden := i;
            END IF;*/
            /*IF r_orden.ent_bca_beneficiario = 0 THEN
             r_orden.ent_bca_beneficiario := NULL;
            END IF;*/
            IF r_orden.cod_swift IS NULL THEN
             r_orden.cod_swift := NULL;
            END IF;
            IF r_orden.cod_tip_doc_beneficiario = 0 THEN
             r_orden.cod_tip_doc_beneficiario := NULL;
            END IF;
            IF r_orden.nro_con_cambio = 0 THEN
             r_orden.nro_con_cambio := NULL;
            END IF;
            -- se valida en el temporal
            /*IF r_orden.cod_moneda IS NULL AND r_orden.for_pago = 'C' THEN
             r_orden.cod_moneda := v_cod_moneda;
            END IF;*/
            IF paw_uti.fu_validarMail(nvl(r_orden.ben_dir_correo, fug_obt_dir_correo)) = 'N' THEN
             r_orden.ben_dir_correo := NULL;
            END IF;
            -- CR aumentamos el contador de créditos
            v_can_ordenes := v_can_ordenes + 1;

            IF r_orden.for_pago IS NULL THEN
               v_exi_for_pago := 'N';
               EXIT;
            END IF;


            IF r_orden.for_pago = 'I' THEN
             v_can_ord_sipap := v_can_ord_sipap + 1;
            ELSE
             v_can_orden := v_can_orden + 1;
             r_orden.cod_tip_doc_beneficiario := NULL;
             r_orden.ent_bca_beneficiario := NULL;
             r_orden.cod_swift            := NULL;
             r_orden.nro_doc_beneficiario := NULL;
             r_orden.nro_cta_beneficiario := NULL;
             r_orden.concepto             := NULL;
             r_orden.ind_valor            := NULL;
             r_orden.nro_con_cambio       := NULL;
            END IF;
            -- CR 03/09/2012 se sumariza solo si el monto es válido
            IF r_orden.monto > 0 THEN
             IF r_orden.cod_moneda = v_cod_moneda THEN
              v_tot_debito := v_tot_debito + r_orden.monto;
             ELSE
              v_mto_debito := 0;
              IF r_orden.nro_con_cambio IS NOT NULL THEN
                 pag_prv.pr_val_nro_contrato(r_orden.nro_con_cambio, -- IN OUT
                               nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona),
                               r_orden.monto, -- monto credito
                               v_cod_moneda,  -- moneda debito
                               r_orden.cod_moneda,-- moneda credito
                               'S',
                               r_orden.cod_proceso,
                               r_orden.concepto,
                               v_mto_debito);
              ELSE
                 BEGIN
                  pr_con_mon_a_moneda(r_orden.cod_moneda, v_cod_moneda, r_orden.monto, v_mto_debito, v_cot_credito, v_cot_debito, 'S');
                 EXCEPTION
                  WHEN OTHERS THEN
                   r_orden.concepto    := 'Error de conversion de monedas';
                   r_orden.cod_proceso := 64;
                 END;
              END IF;
              IF nvl(v_mto_debito, 0) > 0 THEN
                 v_tot_debito := v_tot_debito + v_mto_debito;
              END IF;
             END IF;
            END IF;
            ----
            v_lugar := 'Insertando en temporales';
             begin
            IF r_orden.for_pago IN ('C', 'G', 'I') THEN
             INSERT INTO ge_pag_proveedores_tmp
              (nro_orden, nro_factura, tip_comprobante, for_pago, nro_cheque, nro_cta_credito, fec_ingreso,
               fec_pago, monto, nro_recibo, beneficiario, concepto, estado, cod_usu_operador, cod_ente, cod_proceso,
               cod_moneda, tip_carga, nro_archivo, ref_facturas, cod_tip_doc_beneficiario, nro_doc_beneficiario,
               nro_cta_beneficiario, ent_bca_beneficiario, ind_valor, nro_con_cambio, ben_dir_correo, nro_ord_archivo, cod_swift)
             VALUES
              (r_orden.nro_orden, r_orden.nro_factura, r_orden.tip_comprobante, r_orden.for_pago, r_orden.nro_cheque, r_orden.nro_cta_credito, r_orden.fec_ingreso,
               r_orden.fec_pago, r_orden.monto, r_orden.nro_recibo, r_orden.beneficiario, r_orden.concepto, r_orden.estado, r_orden.cod_usu_operador, r_orden.cod_ente, r_orden.cod_proceso,
               r_orden.cod_moneda, r_orden.tip_carga, r_orden.nro_archivo, r_orden.ref_facturas, r_orden.cod_tip_doc_beneficiario, r_orden.nro_doc_beneficiario,
               r_orden.nro_cta_beneficiario, r_orden.ent_bca_beneficiario, r_orden.ind_valor,
               r_orden.nro_con_cambio, r_orden.ben_dir_correo, i, r_orden.cod_swift);
            END IF;
            exception
              when others then
                PRG_INS_LOG_PROGRAMAS(p_cod_programa => 'PAW_BEM.FU_PAGOPROVEEDORES_DEV',
                           p_det_error    => fu_generarBitacora('S','ERROR_INS_GE_PAG_PROVEEDORES_TMP', pae_cnf.g_nro_secuencia  || ' ' || SQLERRM),
                           p_cod_persona  => v_usu_sesion.codigoEmpresa,
                           p_nro_cuenta   => null);
             
            raise v_E;
            end;
            r_orden.concepto             := NULL;
            <<end_loop>> NULL;
           END LOOP;

           IF v_exi_for_pago = 'N' THEN
              pr_mensajeUsuario(PRO_ERR_FOR_PAGO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           END IF;

           pp_asi_nro_orden(v_cod_ente, v_nro_archivo);

           v_msj_bitacora := v_msj_bitacora || ', ordLei:' || v_can_ordenes || ', can_snp:' || v_can_ord_sipap || ', can_ordenes' ||v_can_orden;
           -- CR: se controla que el total de créditos no supere el máximo permitido
           v_lugar := 'Validando el total de creditos';
           IF v_can_ordenes > paw_bce.v_max_imp_archivo THEN
            pr_mensajeUsuario(PRO_MAX_CRE_EXCEDIDO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           END IF;
           -- CR: se valida la cuenta de débito
           v_lugar := 'Validando la cuenta del cliente';
           IF v_retorno.error = 'N' THEN
            v_msj_respuesta := lf_val_cta_debito(v_nro_cta_debito, v_cod_tra_padre, v_tot_debito,
                               v_cod_moneda, v_cod_modulo, v_cod_modalidad,
                               v_cod_oficina, v_cta_for_debito, v_nom_cta_debito,
                               v_usu_sesion, v_msj_caja);

            -- solo debe tener en cuenta el saldo si la fecha de pago es al dia
            IF v_msj_respuesta.nombreRespuesta = 'COD_SAL_INSUF' AND p_fec_pago1 <> trunc(SYSDATE) THEN
             v_msj_respuesta.error := 'N';
            END IF;

            IF v_msj_respuesta.error = 'S' THEN
             v_msj_bitacora := v_msj_bitacora || ', total:' || v_tot_debito;
             -- para poder corregir los decimales en los detalles
             IF instr(pag_cta.G_MSJ_ERROR, 'Decimales no permitidos') > 0 THEN
              pr_mensajeUsuario(PRO_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             ELSE
              v_retorno.error                := v_msj_respuesta.error;
              v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
              v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
             END IF;
             v_msj_bitacora := v_msj_bitacora || ', CTA-ERR:[' || substr(pag_cta.g_msj_error, 1, 80)||']';
            END IF;
           END IF;
           IF v_retorno.error = 'N' OR v_retorno.nombreRespuesta = 'PRO_ERR_DATOS' THEN
            v_lugar := 'Verificando datos temporales';
            --- Una vez que carga todo va a validar....
            pag_prv.PR_VER_DAT_TMP_DEV(p_cod_ente, p_fec_pago1, NULL, v_error, 'N', NULL, v_nro_cta_debito, v_nro_archivo);--NVB-2232
             IF v_error IS NOT NULL THEN
             IF v_can_ordenes = 0 AND p_modo = 'L' THEN
              pr_mensajeUsuario(PRO_ERR_DAT_INVALIDOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             ELSIF instr(v_error, 'Horario SIPAP Cerrado') > 0 THEN
              pr_mensajeUsuario(PRO_ERR_SIPAP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             ELSIF v_retorno.error = 'N' THEN
              pr_mensajeUsuario(PRO_ERR_DATOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              v_retorno.descripcionRespuesta := v_error;
             END IF;
             v_msj_bitacora := v_msj_bitacora || ', CTA-ERR:[' || substr(v_error, 1, 50)||']';
            END IF;
            --v_detalles     := NULL;
            v_lugar        := 'Generando salida';
            FOR r1 IN c_detalle(v_nro_archivo)
            LOOP
             v_detalle.numeroOrden          := r1.nro_orden;
             v_detalle.numeroFactura        := substr(r1.nro_factura, 1, 20);
             v_detalle.formaPago            := r1.for_pago;
             v_detalle.numeroCuentaCredito  := substr(r1.nro_cta_credito, 1, 15);
             v_detalle.montoCredito         := r1.monto;
             v_detalle.nombreBeneficiario   := substr(r1.beneficiario, 1, 60);
             v_detalle.codigoMoneda         := TRIM(r1.cod_moneda);
             v_detalle.concepto             := substr(TRIM(r1.concepto), 1, 40);
             v_detalle.codigoProceso        := r1.cod_proceso;
             v_detalle.referenciaFacturas   := substr(r1.ref_facturas, 1, 300);
             v_detalle.tipoDocumento := r1.cod_tip_doc_beneficiario;
             v_detalle.numeroDocumento := substr(r1.nro_doc_beneficiario, 1, 20);
             v_detalle.numeroBanco := r1.ent_bca_beneficiario;
             v_detalle.descripcionBanco :=  substr(lf_obt_bco_snp_swift(r1.cod_swift), 1, 60);
             v_detalle.tipoMT := substr(r1.ind_valor, 1, 1);
             v_detalle.numeroCuentaBeneficiario := substr(r1.nro_cta_beneficiario, 1, 35);
             v_detalle.numeroContrato       := lf_obt_con_cambio(r1.nro_con_cambio);
             v_detalle.mailBeneficiario     := substr(r1.ben_dir_correo, 1, 80);
             v_detalle.codigoSwift          := r1.cod_swift;
             v_lis_detalle.extend;
             v_lis_detalle(v_lis_detalle.count) := v_detalle;
            END LOOP;
            v_retorno.listaProveedores := v_lis_detalle;
           END IF;
           -- control de cambio de fecha para pagos sipap fuera de hora de corte
           IF v_retorno.error = 'N' AND v_can_orden = 0 AND v_can_ord_sipap > 0 THEN
            IF trunc(p_fec_pago1) = trunc(SYSDATE) THEN
             v_est_periodo := pas_snp.fu_obt_est_horario('103', '001', '002');
             if ((v_est_periodo = 'A') and
               (fug_den_per_act_snp('103','001','002',302,3) = 'S')) then
              --No se evalua si el cliente puede enviar para no separa las transf--
              v_est_periodo := 'C';
             end if;
             IF v_est_periodo <> 'A' THEN -- hora sipap cerrada
              v_fec_snp_hor := pag_prv.fu_obt_fec_snp(1);

              -- si llego hasta aca es porque el lote no es mixto
              IF v_fec_snp_hor = p_fec_pago1 THEN
                 -- si se cambia la fecha hay que ver si hay monedas distintas
                 v_cantidad := pag_prv.fu_obt_can_ope_cambio(v_cod_ente, p_fec_pago1, v_cod_moneda, v_nro_archivo, 'S');

                 IF v_cantidad > 0 THEN -- hora cerrada no permite operacion de cambio
                  pr_mensajeusuario(PRO_ERR_SIPAP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 ELSE
                   --Proyecto pago a proveedores
                 /*v_hora_fin := LF_OBT_HOR_FIN_SNP(1);
                 v_hora_pro := TO_CHAR(SYSDATE,'HH24MI');
                 if TO_NUMBER(v_hora_pro) >= TO_NUMBER(v_hora_fin) then
                  -- se cambia fecha de pago por hora cerrada, solo pagos SIPAP si llego hasta aca
                  v_cam_fecha := pag_prv.fu_cam_fec_pago(v_cod_ente, p_fec_pago1, v_nro_archivo, 'S');
                 end if;
                  IF v_cam_fecha THEN
                   v_msj_bitacora := v_msj_bitacora || ', cam_hor_snp: '||to_char(p_fec_pago1, 'dd/mm/yyyy');
                  END IF;
                  */
                  NULL;
                 END IF;
              END IF;
             END IF;
            END IF;
           END IF;
           -- 03/05/2012 : Verifico que la cta de débito tenga límite para la operación
           -- se agrega monitoreo de límite global de pago a proveedores
           IF v_retorno.error = 'N' THEN
            IF p_modo <> 'I' THEN
             IF v_mod_reg_pago = 'N' THEN
              v_can_limite := v_can_ord_sipap;
              IF v_can_orden > 0 THEN
                 v_can_limite := v_can_limite + 1;
              END IF;
             ELSE
              v_can_limite := v_can_ordenes;
             END IF;
             v_lugar      := 'Verificando limites';
             v_resLimite := fu_obtenerLimite (v_usu_sesion,
                              v_cod_operacion,
                              nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona),
                              v_nro_cta_debito,
                              v_cod_moneda,
                              7503,
                              v_cod_tra_padre,
                              v_tot_debito,
                              p_modo,
                              p_cod_ente,
                              null,
                              null,
                              v_can_limite);
             IF v_resLimite.error = 'S' THEN
              v_retorno.error := v_resLimite.error;
              v_retorno.nombreRespuesta := v_resLimite.nombreRespuesta;
              v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;
             END IF;
             v_msj_bitacora := v_msj_bitacora || ', resLim: ' || v_resLimite.codRespuesta;
            END IF;
           END IF;
           v_retorno.respuestaLimite := v_resLimite.codRespuesta;
           v_lugar    := 'Verificando claves';
           IF v_retorno.error = 'N' THEN
            v_msj_respuesta.error := 'N';
            IF p_modo IN ('C', 'A') THEN

             IF v_resLimite.codRespuesta IN ('10', '11') THEN
              -- clave transaccional requerida
              v_msj_respuesta := lf_obt_cla_validar(p_claveTransaccional, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, 'T');
             END IF;

             IF v_msj_respuesta.error = 'N' THEN
              IF v_resLimite.codRespuesta IN ('01', '11') THEN
                 -- token requerido
                 v_msj_respuesta := paw_seg.fu_obt_tok_validar(p_claveToken, v_usu_sesion.codigoPersona, v_usu_sesion.codigoEmpresa, p_modo);
              END IF;
             END IF;

             IF v_msj_respuesta.error = 'S' THEN
              v_retorno.error                := v_msj_respuesta.error;
              v_retorno.nombreRespuesta      := v_msj_respuesta.nombreRespuesta;
              v_retorno.descripcionRespuesta := v_msj_respuesta.descripcionRespuesta;
             END IF;
            END IF;
           END IF;
           --
           ---
           IF p_modo <> 'C' OR v_retorno.error = 'S' THEN
            v_lugar := 'Borrando pendientes 2';
            pag_prv.PR_ELI_PROV_TMP_DEV(p_cod_ente, SYSDATE, v_nro_archivo);--NVB-2232
            v_lugar := 'Borrando pendientes 3';
            pag_prv.PR_ELI_FAC_TMP_DEV(p_cod_ente, SYSDATE, v_nro_archivo);----NVB-2232
           END IF;
           IF v_retorno.error = 'N' AND p_modo = 'C' THEN
            --
            SELECT s_nro_documento.NEXTVAL
            INTO v_nro_documento
            FROM dual;

            v_retorno.numeroDocumento := v_nro_documento;
            v_retorno.cantidadAutorizadores := v_can_aut_requeridas;

            IF v_can_aut_requeridas > 0 THEN
             v_lugar := 'Insertando mov pendiente';
             --- inserto el movimiento pendiente de autorización

             INSERT INTO bw_mov_pendientes
              (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cantidad, etiqueta, dato, etiqueta2, dato2, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, referencia, tip_pago)
             VALUES
              (v_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito, v_cod_moneda, v_des_pendiente, v_tot_debito, v_can_ordenes, 'Ente', p_cod_ente, 'Fechas de Pago', to_char(p_fec_pago1, 'dd/mm/yyyy'), 'P', v_can_aut_requeridas, v_can_aut_requeridas, v_usu_sesion.codigoPersona, v_nro_archivo, v_tip_pago);
            ELSE
              -- Es necesario que se configure al menos una Firma
               v_lugar := 'Se requiere al menos una firma de autorizacion';
               pr_mensajeUsuario(PRO_ERR_REQ_FIRMA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

               /* OMM 03/05/2011 Se inserta como movimiento pendiente solo para agrupar
               para el procedimiento de generacion de movimientos*/
               /*INSERT INTO bw_mov_pendientes
                (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta, cod_moneda, descripcion, monto, cantidad, etiqueta, dato, etiqueta2, dato2, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso, referencia, tip_pago)
               VALUES*/
                --(v_nro_documento, nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), SYSDATE, v_cod_operacion, v_nro_cta_debito, v_cod_moneda, v_des_pendiente, v_tot_debito, v_can_ordenes /*p_can_orden*/, 'Ente', p_cod_ente, 'Fechas de Pago', to_char(p_fec_pago1, 'dd/mm/yyyy') /*|| ' ' || to_char(p_fec_pago2, 'dd/mm/yyyy')*/, 'C', 0, 0, v_usu_sesion.codigoPersona, v_nro_archivo, v_tip_pago);

                /*pag_prv.PR_VER_DAT_TMP_DEV(p_cod_ente, p_fec_pago1, NULL, v_error, 'S', v_nro_documento, v_nro_cta_debito, v_nro_archivo);*/

               /*IF v_error IS NOT NULL THEN
                pr_mensajeUsuario(PRO_ERR_VER_PAGO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                v_msj_bitacora := v_msj_bitacora || ', err: [' || substr(v_error, 1, 50) || ']';
               ELSE
                -- OMM 02/05/2011 Se generan los movimientos automáticamente
                IF to_char(p_fec_pago1, 'DD/MM/YYYY') = trunc(SYSDATE) THEN
                   pag_prv.PR_PRO_PAGO(p_cod_ente, v_nro_documento, v_err_pago);
                   IF v_err_pago <> '00' THEN
                    pr_mensajeUsuario(PRO_ERR_PRO_PAGO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                   ELSE
                    it_mail.mail(fug_obt_dir_correo, fug_obt_pardinamico('SUE_DIR_CORREO'), 'Pago a Proveedores en Linea',
                           'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) || 'Codigo  : ' || p_cod_ente || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Monto   : ' || to_char(v_tot_debito, '999G999G999G999D99') || ' ' || v_cod_moneda || chr(10) || 'Cantidad: ' || to_char(p_can_orden) || chr(10) || 'Fecha de Pago: ' || to_char(p_fec_pago1) || chr(10) || chr(10) || 'Atentamente. ');
                   END IF;
                ELSE
                   it_mail.mail(fug_obt_dir_correo, fug_obt_pardinamico('SUE_DIR_CORREO'), 'Pago a Proveedores Fecha Futura',
                        'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) || 'Codigo  : ' || p_cod_ente || chr(10) || 'Empresa : ' || v_des_ente || chr(10) || 'Monto   : ' || to_char(v_tot_debito, '999G999G999G999D99') || ' ' || v_cod_moneda || chr(10) || 'Cantidad: ' || to_char(p_can_orden) || chr(10) || 'Fecha de Pago: ' || to_char(p_fec_pago1) || chr(10) || chr(10) || 'Atentamente. ');
                END IF;
               END IF;*/

            END IF;

            v_lugar := 'Enviando correo incorrecto';
            -- si hubieron registros eliminados por el usuario se envía para conocimiento del ente
            IF (v_error IS NULL AND length(p_par_errores) > 0) THEN
             -- obtenemos la direccion de correo de la empresa
             BEGIN
              v_dir_correo := fug_obt_dir_mail_per(v_usu_sesion.codigoEmpresa);
             EXCEPTION
              WHEN OTHERS THEN
                 v_dir_correo := fug_obt_pardinamico('SUE_DIR_CORREO');
             END;
             it_mail.mail_attach(fug_obt_dir_correo,
                       v_dir_correo,
                       'Pago a Proveedores - Registros No Procesados',
                       'Pago a Proveedores ingresado por el HomeBanking ' || chr(10) || chr(10) ||
                       'Codigo  : ' || p_cod_ente || chr(10) ||
                       'Empresa : ' || v_des_ente || chr(10) ||
                       'Moneda  : ' || v_cod_moneda || chr(10) ||
                       'Fecha de Pago: ' || to_char(p_fec_pago1) || chr(10) || chr(10) ||
                       'Se envia adjunto los registros no acreditados' || chr(10) || chr(10) ||
                       'Atentamente. ',
                       RPAD('CUENTA', 15) || RPAD('BENEFICIARIO', 50) || RPAD('MONTO', 18)
                                || RPAD('MOTIVO', 40) || chr(13) || chr(10) || RPAD('-', 123, '-')
                                || REPLACE(p_par_errores, '*', chr(13) || chr(10)),
                      p_cod_ente || '_' || v_cod_moneda || '_reg_eli_' || to_char(SYSDATE, 'yyyymmddhh24miss') || '.txt');
            END IF;
           END IF;
        ELSE
           pr_mensajeUsuario(PRO_CAN_ORD_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        END IF;

       END IF;
      END IF;
      v_lugar := 'Registrando log';
      v_retorno.cantidadProveedores := v_can_ordenes;
      v_retorno.montoTotal := v_tot_debito;
      IF v_retorno.error = 'S' THEN
       pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      ELSE
       IF p_modo = 'C' THEN
          /*BWP-311*/
               select s_nro_bw_movimiento.nextval
               into v_nro_movimiento
               from dual;
        lp_reg_operacion(v_nro_cta_debito /*p_nro_cuenta*/,
                v_cod_moneda /*p_cod_moneda */,
                v_tot_debito /*p_monto*/,
                NULL /*p_nro_cta_contra*/,
                p_can_orden /*p_cantidad*/,
                'Ente' /*p_etiqueta*/,
                p_cod_ente /*p_dato*/,
                'Fec.Pago',
                to_char(p_fec_pago1) ,
                'Pago a Proveedor-'||v_nro_documento,--'Yaguarete',
                NULL,
                '000',
                v_usu_sesion.codigoPersona,
                v_cod_operacion,
                v_nro_documento,
                p_codigoCanal,
                p_sesion,
                v_usu_sesion.codigoEmpresa,
                null,
                null,
                null,
                v_nro_documento,
                v_nro_movimiento);
       END IF;
       pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      END IF;
      -- siempre se responde con los detalles, sea o no sea con errores
      RETURN v_retorno;
     EXCEPTION
      WHEN OTHERS THEN
       pr_mensajeUsuario(PRO_ERR_DAT_INVALIDOS, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(v_usu_sesion.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, v_usu_sesion.codigoEmpresa, v_msj_bitacora || ', lug: ' || v_lugar || ', cantReg: ' || v_can_ordenes/*v_can_detalles*/ || ', ORA-ERR: [' ||substr(SQLERRM, 1, 200) ||'] '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
       RETURN v_retorno;
     END; -- Pago a Proveedores.

   FUNCTION fu_obt_tip_pro_sueldo(p_cod_ente IN ge_entes.cod_ente%TYPE)
    RETURN VARCHAR2 IS
   BEGIN
      RETURN nvl(fug_obt_parentes(p_cod_ente, 'TIP_PRO_SUELDO'), 'O');
   EXCEPTION
      WHEN OTHERS THEN
         RETURN 'O';
   END;

