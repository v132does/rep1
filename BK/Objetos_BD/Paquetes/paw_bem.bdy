         EXCEPTION
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora('0', v_cod_canal, NULL, c_cod_operacion, NULL, 'obtenerCajeros -' || SQLERRM, BITACORA_ERROR);
