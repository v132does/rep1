   /** Listado de Cajeros Automaticos
   * @param p_codCanal Codigo del canal
   * @return Retorna los Cajeros Automaticos de la Entidad
   */
   /*FUNCTION fu_obtenerCajeros (p_codCanal IN VARCHAR2) RETURN typ_informacionCajeros IS

      v_listaCajeros     typ_listaCajeros := typ_listaCajeros();
      v_retorno          typ_informacionCajeros := typ_informacionCajeros;
      v_can_detalles     number(3) := 0; -- cantidad de Cajeros
