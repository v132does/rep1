 /* FUNCTION fu_altaPersona
    (
       p_codigoCanal         IN VARCHAR2,
       p_nroDocumento        IN VARCHAR2,
       p_tipoDocumento       IN VARCHAR2,
       p_codigoPais          IN VARCHAR2,
       p_nombre              IN VARCHAR2,
       p_apellido            IN VARCHAR2,
       p_tipo                IN VARCHAR2,
       p_codSexo             IN VARCHAR2,
       p_fechaNacimiento     IN VARCHAR2,
       p_direccionParticular IN VARCHAR2,
       p_codigoCiudad        IN NUMBER,
       p_codigoBarrio        IN NUMBER,
       p_nroVivienda         IN VARCHAR2,
       p_observacionVivienda IN VARCHAR2,
       p_telefono            IN VARCHAR2,
       p_area                IN VARCHAR2,
       p_tipoLinea           IN VARCHAR2,
       p_latitud             IN VARCHAR2,
       p_longitud            IN VARCHAR2,
       p_estadoClave         IN VARCHAR2,
       p_tipoClave           IN VARCHAR2,
       p_correoElectronico   IN VARCHAR2
    ) RETURN typ_altaPersona IS
       c_cod_operacion   CONSTANT VARCHAR2(3) := '233';

       c_err_persona     CONSTANT VARCHAR2(3) := '323';
       c_err_dir_persona CONSTANT VARCHAR2(3) := '310';
       c_err_tel_persona CONSTANT VARCHAR2(3) := '311';
       c_exi_persona     CONSTANT VARCHAR2(3) := '312';
       c_exi_clave       CONSTANT VARCHAR2(3) := '313';
       v_cod_persona    ba_per_fisicas.cod_persona%TYPE;
       v_nro_documento  ba_personas.nro_documento%TYPE;
       v_tip_Documento  ba_personas.cod_tip_documento%TYPE;
       v_cod_pais       ba_personas.cod_pais%TYPE;
       v_nombres        ba_personas.nom_completo%TYPE; --nombre/s
       v_apellidos      ba_personas.nom_completo%TYPE; --apellido/s
       v_tipo           ba_personas.tipo%TYPE;
       v_rub_primario   ba_personas.cod_rub_primario%TYPE;
       v_cod_oficial    ge_clientes.cod_usu_oficial%TYPE := fug_obt_pardinamico('BWE_COD_USU_OFICIAL');
       v_cod_oficina    ge_clientes.cod_oficina%TYPE := 1;
       v_dir_particular ba_direcciones.direccion%TYPE;
       v_cod_ciudad     ba_direcciones.cod_ciudad%TYPE;
       v_cod_barrio     ba_direcciones.cod_barrio%TYPE;
       v_nro_vivienda   ba_direcciones.numero%TYPE;
       v_obs_vivienda   ba_direcciones.observacion%TYPE;
       v_telefono       ba_telefonos.telefono%TYPE;
       v_area           ba_telefonos.area%TYPE;
       v_tip_linea      ba_telefonos.tip_linea%TYPE;
       v_latitud        ba_direcciones.latitud%TYPE;
       v_longitud       ba_direcciones.longitud%TYPE;
       v_cod_sexo       ba_per_fisicas.cod_sexo%TYPE;
       v_cla_impresa    bw_ope_claves.cla_impresa%TYPE;
       v_est_clave      bw_ope_claves.est_clave%TYPE;
       v_tip_clave      bw_ope_claves.tip_clave%TYPE;
       v_dir_correo     ba_personas.dir_correo%type;
       v_existe         VARCHAR2(1);
       v_cod_canal      VARCHAR2(3);
       v_error          VARCHAR2(300);
       retError         typ_mensajerespuesta := typ_mensajerespuesta();
       v_retorno        typ_altaPersona := typ_altaPersona;
       v_fec_nacimiento VARCHAR2(10);
       v_dir_env_correo     varchar2(300) := fug_obt_pardinamico('BWE_DIR_COR_WEB');
       v_tex_mail        varchar2(100);
    BEGIN
       pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

       v_cod_canal      := paw_bem.depurarAlfanumerico(p_codigoCanal, 3);
       v_nro_documento  := trim(p_nroDocumento);
       v_tip_documento  := paw_bem.depurarAlfanumerico(p_tipoDocumento, 1);
       v_cod_pais       := paw_bem.depurarAlfanumerico(p_codigoPais, 5);
       v_nombres        := substr(p_nombre,1,60);
       v_apellidos      := substr(p_apellido, 1,60);
       v_tipo           := paw_bem.depurarAlfanumerico(p_tipo, 1);
       v_fec_nacimiento := SUBSTR(p_fechaNacimiento,1,14);
       v_dir_particular := SUBSTR(p_direccionParticular,1,79);
       v_cod_ciudad     := paw_bem.depurarAlfanumerico(p_codigoCiudad, 3);
       v_cod_barrio     := paw_bem.depurarAlfanumerico(p_codigoBarrio, 3);
       v_nro_vivienda   := paw_bem.depurarAlfanumerico(p_nroVivienda, 8);
       v_obs_vivienda   := SUBSTR(p_observacionVivienda,1,999);
       v_telefono       := paw_bem.depurarAlfanumerico(p_telefono, 10);
       v_area           := paw_bem.depurarAlfanumerico(p_area, 10);
       v_tip_linea      := paw_bem.depurarAlfanumerico(p_tipoLinea, 1);
       v_latitud        := paw_bem.depurarAlfanumerico(p_latitud, 80);
       v_longitud       := paw_bem.depurarAlfanumerico(p_longitud, 80);
       v_cod_sexo       := paw_bem.depurarAlfanumerico(p_codSexo, 20);
       v_est_clave      := paw_bem.depurarAlfanumerico(p_estadoClave, 20);
       v_tip_clave      := paw_bem.depurarAlfanumerico(p_tipoClave, 20);
       v_dir_correo     := SUBSTR(p_correoElectronico,1,80);
       v_rub_primario := fug_obt_pardinamico('BWE_RUB_PRIN_PERSONAS');
       \* Obtiene la informacion de parametros recibos y el return del type *\
       paw_log.g_typ_altaPersona := v_retorno;
       paw_log.pr_logValoresTypes('typ_altaPersona',
       'Fu_altaPersona'||' '||p_codigoCanal||', '|| p_nroDocumento||', '||  p_tipoDocumento||', '||
       p_codigoPais||', '|| p_nombre||', '|| p_apellido||', '||
       p_tipo||', '|| p_codSexo||', '||
       p_fechaNacimiento||', '|| p_direccionParticular||', '|| p_codigoCiudad||', '||
       p_codigoBarrio||', '|| p_nroVivienda||', '|| p_observacionVivienda||', '||
       p_telefono||', '|| p_area||', '|| p_tipoLinea||', '||
       p_latitud||', '|| p_longitud||', '|| p_estadoClave||', '||
       p_tipoClave||', '|| p_correoElectronico
            );
     If v_cod_canal = '999' then
       v_tex_mail := 'a traves de Banca Web';
      else
        v_tex_mail := 'a traves de Banca Telefonica';
     end if;

       --verificar que no exista la persona
       BEGIN
          SELECT 'S'
            INTO v_existe
            FROM ba_personas
           WHERE nro_documento = v_nro_documento;
          v_existe := 'S';
       EXCEPTION
          WHEN no_data_found THEN
             v_existe := 'N';
          WHEN OTHERS THEN
             v_existe := 'N';
       END;
       IF v_existe = 'S' THEN
          paw_bem.pr_mensajeUsuario(c_exi_persona, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          paw_bem.pr_insertarBitacora(NULL, v_cod_canal, NULL, c_cod_operacion, NULL, 'Generar Persona/Clientes -' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
          RETURN v_retorno;
       END IF;
       --generamos la persona
       prw_ins_persona(v_nro_documento, v_tip_documento, v_cod_pais, v_nombres, v_apellidos, v_tipo, v_cod_sexo, to_date(v_fec_nacimiento, 'dd/mm/yyyy'), v_rub_primario, v_cod_persona, v_dir_correo,v_error);

       IF v_error != 'OK' THEN
          paw_bem.pr_mensajeUsuario(c_err_persona, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          paw_bem.pr_insertarBitacora(NULL, v_cod_canal, NULL, c_cod_operacion, NULL, 'Generar Persona/Clientes -' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL) || v_error, BITACORA_ERROR);
          RETURN v_retorno;
       END IF;
       v_error := null;

       lp_ins_dir_personas(v_cod_persona, v_dir_particular, v_cod_pais, v_cod_ciudad, v_cod_barrio, v_nro_vivienda, v_obs_vivienda, v_latitud, v_longitud, retError);

       IF retError.error != 'N' THEN
          paw_bem.pr_mensajeUsuario(c_err_dir_persona, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          paw_bem.pr_insertarBitacora(NULL, v_cod_canal, NULL, c_cod_operacion, NULL, 'Generar Persona/Clientes -' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL) || retError.nombreRespuesta, BITACORA_ERROR);
          RETURN v_retorno;
       END IF;

       lp_ins_telefono(v_cod_persona, v_telefono, v_area, v_tip_linea, retError);

       IF retError.error != 'N' THEN
          paw_bem.pr_mensajeUsuario(c_err_tel_persona, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          paw_bem.pr_insertarBitacora(NULL, v_cod_canal, NULL, c_cod_operacion, NULL, 'Generar Persona/Clientes -' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL) || retError.nombreRespuesta, BITACORA_ERROR);
          RETURN v_retorno;
       END IF;

       lp_ins_cliente(v_cod_persona, v_cod_oficina, v_cod_oficial,retError);

        IF retError.error != 'N' THEN
          paw_bem.pr_mensajeUsuario(c_err_persona, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          paw_bem.pr_insertarBitacora(NULL, v_cod_canal, NULL, c_cod_operacion, NULL, 'Generar Persona/Clientes -' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL) || retError.nombreRespuesta, BITACORA_ERROR);
          RETURN v_retorno;
       END IF;
       IF v_retorno.error = 'N' THEN
          pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

          v_retorno.numeroDocumento := v_nro_documento;
          v_retorno.codigoPersona   := v_cod_persona;
          v_retorno.nombreCompleto       := v_nombres||' '||v_apellidos;
          v_retorno.numerotelefono  := v_area||''||v_telefono;

          IF v_dir_env_correo is not null AND
             instr(v_dir_env_correo, '@') > 0 then
             it_mail.mail(fug_obt_dir_correo,
                       v_dir_env_correo,
                       'Alta de personas '|| v_tex_mail,
                        'Informamos que se ha generado una nueva persona ' ||
                        v_tex_mail || ' Codigo del cliente: ' ||v_cod_persona ||chr(10)
                        || ' Persona: '||v_nombres||' '||v_apellidos||
                       chr(10) || 'Atentamente. ');
           END  IF;
      END IF;
           RETURN V_RETORNO;
  END;*/

  /*FUNCTION fu_informeSemestral (p_sesion        IN VARCHAR2,
                                p_codigoCanal   IN VARCHAR2,
                                p_ann           IN VARCHAR2,
                                p_semester      IN VARCHAR2) RETURN typ_movimientosSemestral IS
     -- variables

     v_ann             VARCHAR2(10);
     v_semester        VARCHAR2(10);
     v_des_fecha       DATE;
     v_has_fecha       DATE;
     v_consolidar      VARCHAR2(1):= 'N';

     v_can_detalles NUMBER(8) := 0;
     userInfo          paw_bem.typ_validarSesion;
     v_cod_canal       VARCHAR2(3);
     v_retorno         typ_movimientosSemestral := typ_movimientosSemestral;
     v_log_mensaje     VARCHAR2(1000);
     v_sesion          bw_aut_sesiones.cod_sesion%TYPE;
     detalleMovimiento typ_movimientoSemestral := typ_movimientoSemestral;
     listaMovimientos  typ_listaMovSemestrales  := typ_listaMovSemestrales();
     c_mov_inexistente constant varchar2(15) := '335';
     c_cod_operacion   CONSTANT VARCHAR2(3) := '239';
     v_fec1            VARCHAR2(10);
     v_fec2            VARCHAR2(10);
     v_cod_ofi_matriz  ge_par_generales.cod_ofi_matriz%type;

       CURSOR movimientos IS
        SELECT monto,
               cod_persona,
               nombres,
               oficial,
               nro_cuenta,
               transaccion,
               fecha,
               nro_cuota,
               cod_modulo,
               des_modulo,
               cod_moneda,
               cod_oficina,
               cod_oficina || '-' || fue_obt_des_oficina(cod_oficina) des_oficina
          FROM (SELECT SUM(nvl(mto_gravado, 0) + nvl(mto_iva, 0)) monto,
                       a.cod_persona,
                       fue_obt_nom_persona(a.cod_persona) nombres,
                       fue_obt_nom_usuario(s.cod_usu_oficial) oficial,
                       a.nro_cuenta,
                       a.concepto transaccion,
                       a.fecha,
                       NULL nro_cuota,
                       g.cod_modulo,
                       fue_obt_descripcion('BA_MODULOS', 'COD_MODULO', g.cod_modulo) des_modulo,
                       a.cod_moneda,
                       a.cod_oficina
                  FROM sb_cob_gastos a, ge_clientes s, ge_cuentas g
                 WHERE s.cod_persona = a.cod_persona
                   AND a.nro_cuenta = g.nro_cuenta(+)
                 GROUP BY a.cod_persona,
                          a.nro_cuenta,
                          a.cod_transaccion,
                          a.fecha,
                          g.cod_modulo,
                          a.cod_moneda,
                          a.cod_oficina,
                          g.cod_modalidad,
                          a.concepto,
                          s.cod_usu_oficial
                UNION
                SELECT SUM(nvl(g.sal_interes, 0) + nvl(g.sal_int_documentado, 0)),
                       g.cod_persona,
                       fue_obt_nom_persona(g.cod_persona) nombres,
                       fue_obt_nom_usuario(s.cod_usu_oficial) oficial,
                       g.nro_cuenta,
                       'INTERESES PAGO DE CUOTAS',
                       g.fec_ult_pago,
                       g.nro_cuota,
                       a.cod_modulo,
                       fue_obt_descripcion('BA_MODULOS', 'COD_MODULO', a.cod_modulo) des_modulo,
                       g.cod_moneda,
                       s.cod_oficina
                  FROM sb_cob_intereses g, ge_cuentas a, ge_clientes s
                 WHERE a.nro_cuenta = g.nro_cuenta(+)
                   AND s.cod_persona = g.cod_persona
                   AND (g.sal_interes <> 0 OR sal_int_documentado <> 0)
                 GROUP BY g.cod_persona,
                          g.nro_cuenta,
                          g.fec_ult_pago,
                          g.nro_cuota,
                          a.cod_modulo,
                          g.cod_moneda,
                          s.cod_oficina,
                          s.cod_usu_oficial)
         WHERE (cod_persona = userInfo.codigoPersona)
           AND fecha BETWEEN v_des_fecha AND v_has_fecha
           AND nvl(v_consolidar, 'N') = 'N'

        UNION
        SELECT SUM(monto),
               cod_persona,
               nombres,
               oficial,
               NULL,
               transaccion,
               fecha,
               NULL,
               cod_modulo,
               des_modulo,
               cod_moneda,
               cod_oficina,
               cod_oficina || '-' || fue_obt_des_oficina(cod_oficina) des_oficina
          FROM (SELECT SUM(nvl(mto_gravado, 0) + nvl(mto_iva, 0)) monto,
                       a.cod_persona,
                       fue_obt_nom_persona(a.cod_persona) nombres,
                       fue_obt_nom_usuario(s.cod_usu_oficial) oficial,
                       a.nro_cuenta,
                       a.concepto transaccion,
                       a.fecha,
                       NULL nro_cuota,
                       g.cod_modulo,
                       fue_obt_descripcion('BA_MODULOS', 'COD_MODULO', g.cod_modulo) des_modulo,
                       a.cod_moneda,
                       s.cod_oficina
                  FROM sb_cob_gastos a, ge_clientes s, ge_cuentas g
                 WHERE s.cod_persona = a.cod_persona
                   AND a.nro_cuenta = g.nro_cuenta(+)
                   AND a.fecha BETWEEN v_des_fecha AND v_has_fecha
                 GROUP BY a.cod_persona,
                          a.nro_cuenta,
                          a.cod_transaccion,
                          a.fecha,
                          g.cod_modulo,
                          a.cod_moneda,
                          s.cod_oficina,
                          a.cod_modalidad,
                          a.concepto,
                          s.cod_usu_oficial
                UNION
                SELECT SUM(nvl(g.sal_interes, 0) + nvl(g.sal_int_documentado, 0)),
                       g.cod_persona,
                       fue_obt_nom_persona(g.cod_persona) nombres,
                       fue_obt_nom_usuario(s.cod_usu_oficial) oficial,
                       g.nro_cuenta,
                       'INTERESES PAGO DE CUOTAS',
                       g.fec_ult_pago,
                       g.nro_cuota,
                       a.cod_modulo,
                       fue_obt_descripcion('BA_MODULOS', 'COD_MODULO', a.cod_modulo) des_modulo,
                       g.cod_moneda,
                       s.cod_oficina
                  FROM sb_cob_intereses g, ge_cuentas a, ge_clientes s
                 WHERE a.nro_cuenta = g.nro_cuenta
                   AND s.cod_persona = g.cod_persona
                   AND g.fec_ult_pago BETWEEN v_des_fecha AND v_has_fecha
                   AND (g.sal_interes <> 0 OR sal_int_documentado <> 0)
                 GROUP BY g.cod_persona,
                          g.nro_cuenta,
                          g.fec_ult_pago,
                          g.nro_cuota,
                          a.cod_modulo,
                          g.cod_moneda,
                          s.cod_oficina,
                          s.cod_usu_oficial)
         WHERE (cod_persona= userInfo.codigoPersona)
           AND nvl(v_consolidar, 'N') = 'S'
         GROUP BY cod_persona,
                  nombres,
                  oficial,
                  transaccion,
                  cod_modulo,
                  des_modulo,
                  cod_moneda,
                  cod_oficina,
                  fecha
        order by cod_persona, des_modulo, cod_moneda, fecha, nro_cuota ;

  BEGIN

     pr_mensajeUsuario(MSG_OK, v_retorno.error, v_retorno.descripcionRespuesta, v_retorno.error);
     v_sesion       := paw_bem.depurarAlfanumerico(p_sesion, 32);
     v_cod_canal    := paw_bem.depurarAlfanumerico(p_codigoCanal, 3);

     v_ann             := depurarAlfanumerico(p_ann, 4);
     v_semester        := depurarAlfanumerico(p_semester, 4);

     -- 1. valido la clave del cliente
     userInfo := paw_bem.fu_validarSesion(v_sesion, v_cod_canal);
     --Logear parametros
     v_log_mensaje := 'fu_inf_semestral(p_sesion= ' || v_sesion || ',p_codigoCanal= ' || v_cod_canal || ' ,p_desFecha= ' || v_des_fecha || ' ,p_hasFecha= ' || v_has_fecha || ')';
     paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_log_mensaje, bitacora_entrada);

     IF userInfo.error = 'S' THEN
        v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
        v_retorno.error                := 'S';
        RETURN v_retorno;
     END IF;



     if to_number(v_semester) = 1 then
        v_fec1 := '01/01/'||v_ann;
        v_fec2 := '30/06/'||v_ann;
     elsif to_number(v_semester) = 2 then
        v_fec1 := '01/07/'||v_ann;
        v_fec2 := '31/12/'||v_ann;
     end if;

     select to_date(v_fec1,'dd/mm/yyyy') into v_des_fecha from dual;
     select to_date(v_fec2,'dd/mm/yyyy') into v_has_fecha from dual;

     -- 2. ejecuto la funcion para generar el comprobante
     BEGIN

        FOR mv IN movimientos LOOP
               v_can_detalles                                := v_can_detalles + 1;

               detalleMovimiento.montoGs := round((CASE mv.cod_moneda WHEN 'GS' THEN mv.monto WHEN 'USD' THEN mv.monto*fug_obt_cotizacion(mv.cod_moneda,mv.fecha) END),0);
               -- es un registro que debo mostrar
               detalleMovimiento.monto                    := mv.monto;
               detalleMovimiento.nombres                  := mv.nombres;
               detalleMovimiento.oficial                  := mv.oficial;
               detalleMovimiento.numeroCuenta             := mv.nro_cuenta;
               detalleMovimiento.transaccion              := mv.transaccion;
               detalleMovimiento.fecha                    := lf_for_date(mv.fecha);
               detalleMovimiento.numeroCuota              := mv.nro_cuota;
               detalleMovimiento.codigoModulo             := mv.cod_modulo;
               detalleMovimiento.desModulo                := mv.des_modulo;
               detalleMovimiento.codigoMoneda             := mv.cod_moneda;
               detalleMovimiento.codigoOficina            := mv.cod_oficina;
               detalleMovimiento.desOficina               := mv.des_oficina;

               listaMovimientos.extend;

               listaMovimientos(listaMovimientos.count) := detalleMovimiento;


           END LOOP; --end loop movimientos

            IF v_retorno.error = 'N' THEN
               -- esta bien el dato se carga el detalle
               v_retorno.cantidadMovimientos  := v_can_detalles;--v_can_movimientos;
               v_retorno.listaMovSemestrales := listaMovimientos;
            END IF;

            select cod_ofi_matriz into v_cod_ofi_matriz from ge_par_generales;
            select fue_obt_des_oficina(v_cod_ofi_matriz) into v_retorno.oficina from dual;

     EXCEPTION
        WHEN OTHERS THEN
           paw_bem.pr_mensajeUsuario(c_mov_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Sin movimientos -' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
           RETURN v_retorno;
     END;



     -- registro del movimiento
     paw_con.pr_reg_operacion(NULL \*p_nro_cuenta*\, NULL \*p_cod_moneda *\, NULL \*p_monto*\, NULL \*p_nro_cta_contra*\, NULL \*p_cantidad*\, ' p_desFecha ' \*p_etiqueta*\, v_des_fecha, \*p_dato*\ ' p_hasFecha ', v_has_fecha, NULL, NULL, NULL, userInfo.codigoPersona, c_cod_operacion, userinfo.codigoPersona || v_cod_canal, v_cod_canal, v_sesion, userInfo.codigoEmpresa);
     paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'informeSemestral-' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), bitacora_salida);
     RETURN v_retorno;
  EXCEPTION
     WHEN OTHERS THEN
       paw_log.g_typ_movSemestrales := v_retorno;
       paw_log.pr_logValoresTypes('typ_movimientosSemestral',
       'fu_informeSemestral'||' '||p_sesion||', '|| p_codigoCanal||', '||  v_des_fecha||', '|| v_has_fecha);

        paw_bem.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        paw_bem.pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, NULL, 'fu_informeSemestral -' || SQLERRM, BITACORA_ERROR);
        RETURN v_retorno;
  END;

*/
/*  FUNCTION fu_registrarDatosPersonales(p_sesion       IN VARCHAR2,
                                       p_codigoCanal  IN VARCHAR2,
                                       p_modo         IN VARCHAR2,
                                       p_typ_actualizacionDatos IN typ_administracionDatos)

    RETURN typ_administracionDatos IS


      c_cod_operacion        CONSTANT VARCHAR2(3) := '211';
      c_cod_sin_autorizacion CONSTANT VARCHAR2(3) := '108';
      c_act_reg_error        CONSTANT VARCHAR2(3) := '285';
      c_cod_act_direccion    CONSTANT VARCHAR2(3) := '286';
      c_cod_eli_direccion    CONSTANT VARCHAR2(3) := '287';
      c_cod_eli_direccion1   CONSTANT VARCHAR2(3) := '288';
      c_cod_eli_direccion2   CONSTANT VARCHAR2(3) := '289';
      c_cod_eli_direccion3   CONSTANT VARCHAR2(3) := '290';
      c_obt_can_direccion    CONSTANT VARCHAR2(3) := '291';
      c_obt_err_direccion    CONSTANT VARCHAR2(3) := '292';
      c_err_ins_reg          CONSTANT VARCHAR2(3) := '293';
      c_act_reg_telefono     CONSTANT VARCHAR2(3) := '294';
      c_eli_reg_telefono     CONSTANT VARCHAR2(3) := '295';
      c_err_obt_reg          CONSTANT VARCHAR2(3) := '296';
      c_obt_cant_telefono    CONSTANT VARCHAR2(3) := '297';
      c_act_correo           CONSTANT VARCHAR2(3) := '298';
      c_dir_nueva            CONSTANT VARCHAR2(3) := '299';
      c_err_can_telefono     CONSTANT VARCHAR2(3) := '300';
      c_err_dir_principal    CONSTANT VARCHAR2(3) := '327';
      c_err_tel_principal    CONSTANT VARCHAR2(3) := '328';
      c_err_dir_correo       CONSTANT VARCHAR2(3) := '329';
      c_err_dir_vacia        CONSTANT VARCHAR2(3) := '330';
      c_err_tel_vacio        CONSTANT VARCHAR2(3) := '331';
      c_pre_otr_error        CONSTANT VARCHAR2(10) := 'OP_ERROR';

      --variables generales
      v_modo                 VARCHAR2(1); --p: obtengo datos del cliente; s: solicitud de ciudades barrios;c: Datos para procesar:
      v_existe               VARCHAR2(1) := 'N';
      v_can_det              NUMBER(3) := 0;
      v_can_telefono            NUMBER := 0;
      v_can_direccion            NUMBER := 0;

      v_ciu_codigo           ba_ciudades.cod_ciudad%TYPE;
      v_email                ba_personas.dir_correo%TYPE;
      v_email_tmp            ba_personas.dir_correo%TYPE;
      v_ofi_cliente          ba_oficinas.descripcion%TYPE;
      v_codCanal             bw_claves.cod_canal%TYPE;
      v_nom_oficial          ba_usuarios.nombre%TYPE;
      v_tel_oficial          ba_usuarios.telefono%TYPE;
      v_cor_oficial          ba_usuarios.dir_correo%TYPE;
      v_sesion               bw_aut_sesiones.cod_sesion%type;
      v_bitacora             VARCHAR2(600);
      --v_ema_extrac           VARCHAR2(1);
      v_exi_det              VARCHAR2(1) := 'N';

      v_tex_mail             VARCHAR2(4000);

      retValidarSesion       typ_validarSesion;
      v_permiso              typ_obtenerPermisos;
      v_retorno              typ_administracionDatos   := typ_administracionDatos();
      v_actualiza            typ_administracionDatos    := typ_administracionDatos();
      v_listaTelefonos       typ_listaTelefonos        := typ_listaTelefonos();
      v_telefono             typ_telefono              := typ_telefono();
      v_listaDirecciones     typ_listaDirecciones      := typ_listaDirecciones();
      v_direcciones          typ_direccion             := typ_direccion();
      v_nro_secuencia        bw_personas.nro_secuencia%type;
      v_cod_error            number(6);
      v_type                 VARCHAR2(20000);
      v_codigo               number(6);
      v_max_codigo           number(6);
      v_tel                  number(15);
      v_tel_matriz           ba_telefonos.telefono%type;
      v_horario         VARCHAR2(1) := 'D'; -- Dia normal
      v_es_mov_noc      VARCHAR2(1) := 'N';
      v_es_cta_noc      VARCHAR2(1) := 'N'; -- Graba S/N ctas noctunas
      v_fec_actual      DATE := pag_cal.fu_obt_fec_actual(9);
      v_fec_valor       DATE := v_fec_actual;
      retError          typ_mensajerespuesta := typ_mensajerespuesta;
      v_mensajeCaja     paw_bem.typ_mensajeCaja;

      CURSOR c_direcciones is
        SELECT DISTINCT(a.cod_direccion) n, a.direccion, b.descripcion ciudad, c.descripcion barrio,
               a.tipo, a.prINcipal, a.cod_direccion, a.cod_ciudad, a.cod_barrio, a.numero, a.departamento,
               a.piso,a.edificio
          FROM ba_direcciones a, ba_ciudades b,  ba_barrios c
         WHERE a.cod_persona = nvl( retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
           AND b.cod_pais = 586
           AND b.cod_ciudad = a.cod_ciudad
           AND c.cod_barrio(+) = a.cod_barrio
           AND b.cod_ciudad = a.cod_ciudad
           AND (c.cod_ciudad(+) = a.cod_ciudad AND (c.cod_barrio = a.cod_barrio OR a.cod_barrio is null))
         ORDER BY a.cod_direccion;

      CURSOR c_telefonos is
        SELECT  j.tipo, j.tip_lINea, decode(j.telefono,'null',null,j.telefono) telefono, j.prINcipal, j.area, j.cod_telefono, j.INterno
          FROM ba_telefonos j
         WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
           AND j.tipo <> 'M'
      ORDER BY j.cod_telefono;

      CURSOR c_direcciones_tmp is
        SELECT DISTINCT(a.cod_direccion) n, a.direccion, b.descripcion ciudad, c.descripcion barrio,
               a.tipo, a.prINcipal, a.cod_direccion, a.cod_ciudad, a.cod_barrio, a.numero, a.departamento,
               a.piso,a.edificio, a.observacion
          FROM bw_direcciones a, ba_ciudades b,  ba_barrios c
         WHERE a.cod_persona = nvl( retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
           AND a.estado = 'P'
           AND b.cod_pais = 586
           AND b.cod_ciudad = a.cod_ciudad
           AND c.cod_barrio(+) = a.cod_barrio
           AND b.cod_ciudad = a.cod_ciudad
           AND (c.cod_ciudad(+) = a.cod_ciudad AND (c.cod_barrio = a.cod_barrio OR a.cod_barrio is null))
         ORDER BY a.cod_direccion;

      CURSOR c_telefonos_tmp is
        SELECT  j.tipo, j.tip_lINea, decode(j.telefono,'null',null,j.telefono) telefono, j.prINcipal, j.area, j.cod_telefono, j.INterno
          FROM bw_telefonos j
         WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
           AND j.estado = 'P'
           AND j.tipo <> 'M'
      ORDER BY j.cod_telefono;

    BEGIN
        v_codCanal   := depurarAlfanumerico(p_codigoCanal, 3);
        v_sesion     := depurarAlfanumerico(p_sesion, 32);

        -- 1. valido la clave del cliente

        pr_mensajeUsuario(MSG_OK_PEN, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        retValidarSesion := fu_validarSesion(v_sesion, v_codCanal);

        if p_modo = 'C' then
           v_listadirecciones := p_typ_actualizacionDatos.listaDirecciones;
            FOR idx IN  v_listadirecciones.first ..v_listadirecciones.last LOOP
                 v_direcciones := v_listadirecciones(idx);
                 v_type := v_type||' v_direcciones.codigoDireccion '||v_direcciones.codigoDireccion||' ,v_direcciones.tipo '
                 ||v_direcciones.tipo || ' ,v_direcciones.principal '||v_direcciones.principal ||' ,v_direcciones.direccion '
                 ||v_direcciones.direccion|| ' ,v_direcciones.codigoCiudad '||v_direcciones.codigoCiudad || ' ,v_direcciones.codigoBarrio '
                 ||v_direcciones.codigoBarrio || ' ,v_direcciones.observacion '||v_direcciones.observacion;
             END LOOP;
        end if;

        pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),v_codCanal,v_sesion,c_cod_operacion,retValidarSesion.codigoEmpresa,' - fu_registrarDatosPersonales ' || v_bitacora || ' ' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,  null), BITACORA_ENTRADA,
        null, null,null,null,null, null,null, null, v_type);
        --pr_insertarBitacora(retValidarSesion.codigoPersona,v_codCanal,v_sesion,c_cod_operacion,retValidarSesion.codigoEmpresa,' - fu_registrarDatosPersonales ' || v_bitacora || ' ' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,  null), BITACORA_ENTRADA);
        \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_administracionDatos := v_retorno;
         paw_log.pr_logValoresTypes('typ_administracionDatos',
         'fu_registrarDatosPersonales'||', '||p_modo\*||', '|| p_typ_actualizacionDatos||', listaDirrr '|| p_typ_listaDirecciones*\
         );

        IF nvl(retValidarSesion.error, 'S') = 'S' then
          v_retorno.error                := retValidarSesion.error;
          v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
          v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
          RETURN v_retorno;
        END IF;

        --Valida Caja
        v_mensajeCaja := paw_bem.lf_val_caja(retValidarSesion);
        IF v_mensajeCaja.error = 'S' THEN
           v_retorno.error                := v_mensajeCaja.error;
           v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
           v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
           RETURN v_retorno;
        END IF;

        --controla horario cierre
        if nvl(fug_obt_pardinamico('BWE_BLO_HOR_CIERRE'),'N') = 'S' then
            reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                        v_mensajeCaja.fechaUltimoCierre \* v_ult_cierre *\,
                                        -- IN
                                        v_mensajeCaja.codigoOficinaOrigen \* v_cod_ofi_origen *\,
                                        -- IN
                                        v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

             IF reterror.error = 'S' THEN
                v_retorno.error                := reterror.error;
                v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
                v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
                RETURN v_retorno;
             END IF;
        end if;

        -- 2. valido si el usuario tiene permisos para realizar la transaccion
        v_permiso := paw_bem.lf_obt_permisos(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),retValidarSesion.codigoPerfil, c_cod_operacion, v_codCanal);
        IF v_permiso.error = 'S' THEN
          pr_mensajeUsuario(c_cod_sin_autorizacion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal,v_sesion, c_cod_operacion,retValidarSesion.codigoEmpresa, 'fu_registrarDatosPersonales '||paw_bem.fu_generarBitacora(v_retorno.error,  v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null) ||  v_bitacora,BITACORA_ERROR);
          RETURN v_retorno;
        END IF;

        IF v_retorno.error = 'N'  then
          v_modo := paw_bem.depurarAlfanumerico(p_modo,1);
         --tipo envio C: impreso;Z: mail;N: nada; X: impreso y mail

        IF v_modo = 'P' THEN
            --obtengo los datos del cliente
          BEGIN
            select t.dir_correo
                 into v_email
              from BW_PERSONAS t
             where t.cod_persona = nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona)
               and t.estado = 'P';
            v_existe := 'S';
          EXCEPTION
            WHEN no_data_found THEN
              v_existe := 'N';
          END;

          if v_existe='N' then
              --email
              BEGIN
                SELECT j.dir_correo
                  INTO v_email
                  FROM ba_personas j
                 WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);

                 IF v_email IS NULL THEN
                   v_email := 'NO REGISTRADO';
                 END IF;
              EXCEPTION
                WHEN no_data_found THEN
                  v_email := 'NO REGISTRADO';
                WHEN OTHERS THEN
                  v_email := 'NO REGISTRADO';
              END;
              v_retorno.email := v_email;

              --oficial
              SELECT a.descripcion
                INTO v_ofi_cliente
                FROM ba_oficinas a
               WHERE a.cod_oficina = (SELECT cod_oficina
                                        FROM ge_clientes
                                       WHERE cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                                       );
              v_retorno.oficinaCliente := v_ofi_cliente;

              pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonales'||' ' ||'Cantidad  '||v_listaTelefonos.Count||' Lista de Telefonos '|| ' modo: '||v_modo||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);

              --direcciones
              FOR dir IN c_direcciones LOOP
                v_can_det  := v_can_det+1;

                v_direcciones.direccion := dir.direccion;
                v_direcciones.ciudad    := dir.ciudad;
                v_direcciones.barrio    := dir.barrio;
                v_direcciones.tipo      := dir.tipo;
                v_direcciones.principal := dir.principal;
                v_direcciones.codigoCiudad := dir.cod_ciudad;
                v_direcciones.codigoBarrio := dir.cod_barrio;
                v_direcciones.codigoDireccion := dir.cod_direccion;
                v_direcciones.numero := dir.numero;
                v_direcciones.departamento := dir.departamento;
                v_direcciones.piso := dir.piso;
                v_direcciones.edificio := dir.edificio;
                v_direcciones.accion := 'N';

                v_listaDirecciones.ExtEND;
                v_listaDirecciones(v_listaDirecciones.Count) := v_direcciones;
                IF dir.principal = 'S' then
                  v_ciu_codigo := dir.cod_ciudad;
                END IF;
              END LOOP;
                v_retorno.listaDirecciones := v_listaDirecciones;
                pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonales'||' ' ||'Cantidad '||v_listaDirecciones.Count||' Lista de Direcciones '|| ' modo: '||v_modo||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);

              --telefonos
              FOR tel IN c_telefonos LOOP
                v_telefono.telefono := tel.telefono;
                v_telefono.area := tel.area;
                v_telefono.interno := tel.interno;
                v_telefono.tipoLINea := tel.tip_lINea;
                v_telefono.tipo := tel.tipo;
                v_telefono.principal := tel.principal;
                v_telefono.codigoTelefono := tel.cod_telefono;
                v_telefono.accion := 'N';

                v_listaTelefonos.Extend;
                v_listaTelefonos(v_listaTelefonos.Count) := v_telefono;
             END LOOP;
              v_retorno.listaTelefonos := v_listaTelefonos;
              pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonales'||' ' ||'Cantidad '||v_listaTelefonos.Count||' Lista de Telefonos '|| ' modo: '||v_modo||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);
         ELSE
              BEGIN
                SELECT j.dir_correo
                  INTO v_email
                  FROM BW_PERSONAS j
                 WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona) and j.estado = 'P';
                 IF v_email IS NULL THEN
                   v_email := 'NO REGISTRADO';
                 END IF;
              EXCEPTION
                WHEN no_data_found THEN
                  v_email := 'NO REGISTRADO';
                WHEN OTHERS THEN
                  v_email := 'NO REGISTRADO';
              END;
              --email
              v_retorno.email := v_email;

              SELECT a.descripcion
                INTO v_ofi_cliente
                FROM ba_oficinas a
               WHERE a.cod_oficina = (SELECT cod_oficina
                                        FROM ge_clientes
                                       WHERE cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                                       );
              v_retorno.oficinaCliente := v_ofi_cliente;

              pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonales'||' ' ||'Cantidad  '||v_listaTelefonos.Count||' Lista de Telefonos '|| ' modo: '||v_modo||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);

              --direcciones
              FOR dir IN c_direcciones_tmp LOOP
                v_can_det  := v_can_det+1;
                v_existe := 'N';

                BEGIN
                  select cod_direccion
                       into v_codigo
                    from ba_direcciones d
                   where d.cod_persona = nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona)
                     and d.cod_direccion = dir.cod_direccion;
                  v_existe := 'S';
                EXCEPTION
                  WHEN no_data_found THEN
                    v_existe := 'N';
                END;

                v_direcciones.direccion := dir.direccion;
                v_direcciones.ciudad    := dir.ciudad;
                v_direcciones.barrio    := dir.barrio;
                v_direcciones.tipo      := dir.tipo;
                v_direcciones.principal := dir.principal;
                v_direcciones.codigoCiudad := dir.cod_ciudad;
                v_direcciones.codigoBarrio := dir.cod_barrio;
                v_direcciones.codigoDireccion := dir.cod_direccion;
                v_direcciones.numero := dir.numero;
                v_direcciones.departamento := dir.departamento;
                v_direcciones.piso := dir.piso;
                v_direcciones.edificio := dir.edificio;
                if v_existe = 'S' then
                   v_direcciones.accion := 'N';
                else
                   v_direcciones.accion := 'E';
                end if;
                v_direcciones.observacion := dir.observacion;

                v_listaDirecciones.Extend;
                v_listaDirecciones(v_listaDirecciones.Count) := v_direcciones;
                IF dir.principal = 'S' then
                  v_ciu_codigo := dir.cod_ciudad;
                END IF;
              END LOOP;
              v_retorno.listaDirecciones := v_listaDirecciones;
              pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonales'||' ' ||'Cantidad '||v_listaDirecciones.Count||' Lista de Direcciones '|| ' modo: '||v_modo||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);

              --telefonos
              FOR tel IN c_telefonos_tmp LOOP
                v_existe := 'N';
                BEGIN
                  select cod_telefono
                       into v_codigo
                    from ba_telefonos t
                   where t.cod_persona = nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona)
                     and t.cod_telefono = tel.cod_telefono;
                  v_existe := 'S';
                EXCEPTION
                  WHEN no_data_found THEN
                    v_existe := 'N';
                END;

                v_telefono.telefono := tel.telefono;
                v_telefono.area := tel.area;
                v_telefono.interno := tel.interno;
                v_telefono.tipoLINea := tel.tip_lINea;
                v_telefono.tipo := tel.tipo;
                v_telefono.principal := tel.principal;
                v_telefono.codigoTelefono := tel.cod_telefono;
                if v_existe = 'S' then
                   v_telefono.accion := 'N';
                else
                   v_telefono.accion := 'E';
                end if;

                v_listaTelefonos.Extend;
                v_listaTelefonos(v_listaTelefonos.Count) := v_telefono;
             END LOOP;
             v_retorno.listaTelefonos := v_listaTelefonos;
             pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonales'||' ' ||'Cantidad '||v_listaTelefonos.Count||' Lista de Telefonos '|| ' modo: '||v_modo||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);
         END IF;

      ELSIF v_modo = 'C' then  --Se envian los datos para procesar
          paw_log.g_typ_administracionDatos := p_typ_actualizacionDatos;
          paw_log.pr_logValoresTypes('typ_actualizacionDatos',paw_log.fu_generarLog);
          v_actualiza       := p_typ_actualizacionDatos;
          v_listatelefonos  := v_actualiza.listaTelefonos;
          v_listaDirecciones:= v_actualiza.listaDirecciones; --p_typ_listaDirecciones;
          pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),v_codCanal,v_sesion,c_cod_operacion,retValidarSesion.codigoEmpresa,' - fu_registrarDatosPersonales ' || v_bitacora || ' ' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,  null), BITACORA_ENTRADA);
          BEGIN
            v_can_telefono := v_listatelefonos.count;
          EXCEPTION
            WHEN OTHERS THEN
              v_can_telefono := 0;
          END;
          BEGIN
            v_can_direccion := v_listaDirecciones.Count;
          EXCEPTION
            WHEN OTHERS THEN
              v_can_direccion := 0;
          END;

         --Procesamos el correo
          v_email      := v_actualiza.email;
          if fug_val_correo(v_email) = 'S' or v_email is null  then
              v_retorno := p_typ_actualizacionDatos;
              v_retorno.email := ' ';
              pr_mensajeUsuario(c_err_dir_correo, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonasles'||' ' || 'Obtiene cant. Direccion'||v_email||' - '||SQLERRM, bitacora_error);
              rollback;
              RETURN v_retorno;
          end if;

          --v_ema_extrac := v_actualiza.tipoExtracto;

          IF v_email = 'NO REGISTRADO' then
               v_email := null;
          END IF;

          BEGIN
            DELETE FROM BW_PERSONAS
             where cod_persona =
                   nvl(retValidarSesion.codigoEmpresa,
                       retValidarSesion.codigoPersona)
               and estado = 'P';


            select s_bw_id_dat_persona.nextval
            into v_nro_secuencia
            from dual;

            INSERT INTO BW_PERSONAS
               (nro_secuencia, cod_persona, dir_correo, estado)
            VALUES
               (v_nro_secuencia, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_email, 'P');
          END;

          --Procesamos las direcciones
          IF v_can_direccion > 0 then
             DELETE FROM BW_DIRECCIONES
              WHERE cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                and estado = 'P';

             FOR idx IN  v_listadirecciones.first ..v_listadirecciones.last LOOP
                 v_direcciones := v_listadirecciones(idx);

                 v_existe := 'N';

                 if trim(v_direcciones.direccion) = '' then
                    v_retorno := p_typ_actualizacionDatos;
                    pr_mensajeUsuario(c_err_dir_vacia, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonasles'||' ' || 'Obtiene cant. Direccion'||v_email||' - '||SQLERRM, bitacora_error);
                    rollback;
                    RETURN v_retorno;
                 end if;

                 BEGIN
                   select cod_direccion
                       into v_codigo
                    from ba_direcciones d
                   where d.cod_persona = nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona)
                     and d.cod_direccion = v_direcciones.codigoDireccion;
                   v_existe := 'S';
                 EXCEPTION
                   WHEN no_data_found THEN
                    v_existe := 'N';
                 END;

                 if v_existe = 'S' then
                    v_codigo  := v_direcciones.codigoDireccion;
                 else
                    BEGIN
                      select max(cod_direccion)
                           into v_max_codigo
                        from bw_direcciones d
                       where d.cod_persona = nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona);
                    EXCEPTION
                      WHEN no_data_found THEN
                        v_max_codigo := 0;
                    END;
                    v_codigo := v_max_codigo + 1;
                 end if;

                 INSERT INTO BW_DIRECCIONES
                    (nro_secuencia, cod_persona, cod_direccion, tipo, principal, direccion, cod_pais, cod_ciudad, cod_barrio, observacion, estado,
                    numero,departamento,piso,edificio)
                 VALUES
                    (v_nro_secuencia, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codigo, v_direcciones.tipo, v_direcciones.principal,
                    v_direcciones.direccion, 586, v_direcciones.codigoCiudad, v_direcciones.codigoBarrio, v_direcciones.observacion, 'P',
                    v_direcciones.numero,v_direcciones.departamento,v_direcciones.piso,v_direcciones.edificio);
             END LOOP;
          END IF;

          --Verifico que no hayan habido duplicaciones
          BEGIN
            SELECT count(j.principal)
              INTO v_can_det
              FROM BW_DIRECCIONES j
            WHERE j.principal = 'S'
             AND j.estado='P'
             AND j.cod_persona =nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);
          EXCEPTION
            WHEN OTHERS THEN
              v_retorno := p_typ_actualizacionDatos;
              pr_mensajeUsuario(c_obt_can_direccion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonasles'||' ' || 'Obtiene cant. Direccion'||v_email||' - '||SQLERRM, bitacora_error);
              rollback;
              RETURN v_retorno;
          END;

          IF v_can_det = 0 or v_can_det > 1 then
            v_retorno := p_typ_actualizacionDatos;
            pr_mensajeUsuario(c_err_dir_principal, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonasles'||' ' || 'Error al obt. Direccion'||v_email||' - '||SQLERRM, bitacora_error);
            rollback;
            RETURN v_retorno;
          END IF;

          --Procesamos los telefonos
          IF nvl(v_can_telefono,0) > 0 then
              DELETE FROM BW_TELEFONOS
               WHERE cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                 and estado = 'P';

              FOR idx IN  v_listatelefonos.first ..v_listaTelefonos.last LOOP
                 v_telefono := v_listatelefonos(idx);

                 v_existe := 'N';
                 v_tel := to_number(v_telefono.telefono);

                 if trim(v_telefono.telefono) = '' or v_tel = 0 then
                    v_retorno := p_typ_actualizacionDatos;
                    pr_mensajeUsuario(c_err_tel_vacio, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonasles'||' ' || 'Obtiene cant. Direccion'||v_email||' - '||SQLERRM, bitacora_error);
                    rollback;
                    RETURN v_retorno;
                 end if;

                 BEGIN
                   select cod_telefono
                       into v_codigo
                    from ba_telefonos d
                   where d.cod_persona = nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona)
                     and d.cod_telefono = v_telefono.codigoTelefono;
                   v_existe := 'S';
                 EXCEPTION
                   WHEN no_data_found THEN
                    v_existe := 'N';
                 END;

                 if v_existe = 'S' then
                    v_codigo  := v_telefono.codigoTelefono;
                 else
                    BEGIN
                      select max(cod_telefono)
                           into v_max_codigo
                        from bw_telefonos d
                       where d.cod_persona = nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona);
                    EXCEPTION
                      WHEN no_data_found THEN
                        v_max_codigo := 0;
                    END;
                    v_codigo := v_max_codigo + 1;
                 end if;

                 INSERT INTO BW_TELEFONOS
                    (nro_secuencia, cod_persona, cod_telefono, tipo, principal, tip_linea, telefono, area, interno, observacion, estado)
                 VALUES
                    (v_nro_secuencia, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codigo, v_telefono.tipo, v_telefono.principal,
                    v_telefono.tipoLinea, v_telefono.telefono, v_telefono.area, v_telefono.interno,
                    v_telefono.observacion, 'P');
              END LOOP;
           END IF;
           --VerIFico que no hayan habido duplicaciones
          BEGIN
            SELECT count(j.principal)
              INTO v_can_det
              FROM BW_TELEFONOS j
            WHERE j.principal = 'S'
             AND j.estado = 'P'
             AND j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona);
          EXCEPTION
            WHEN OTHERS THEN
              v_retorno := p_typ_actualizacionDatos;
              pr_mensajeUsuario(c_obt_cant_telefono, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonales'||' ' || 'Cantidad de telefono'||' '||' - '||SQLERRM, bitacora_error);
              rollback;
              RETURN v_retorno;
          END;

          IF v_can_det = 0 or v_can_det > 1 then
            v_retorno := p_typ_actualizacionDatos;
            pr_mensajeUsuario(c_err_tel_principal, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonales'||' ' || 'Cantidad de telefono'||' '||' - '||SQLERRM, bitacora_error);
            rollback;
            RETURN v_retorno;
          END IF;

          --elimina previamente los workflows pendientes para el cliente correspondientes al circuito
          v_cod_error := paw_cir.fu_can_cir_pendientes(400, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona));
          --crea circuito de workflow
          v_cod_error := paw_cir.fu_ini_circuito(400, v_nro_secuencia, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona));
          if v_cod_error <> 0 then
            v_retorno := p_typ_actualizacionDatos;
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona), v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_registrarDatosPersonales'||' - '||paw_cir.G_MSJ_ERROR, bitacora_error);
            rollback;
            RETURN v_retorno;
          end if;

          prw_obt_dat_oficial(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),v_nom_oficial, v_tel_oficial, v_cor_oficial);

          v_tex_mail :=
                     'Informamos que se ha realizado con exito la solicitud de modificacion de la siguiente informacion en Homebanking Web:'||chr(10)||chr(10);

          IF v_retorno.error= 'N' AND v_email is not null then
            BEGIN
              select b.telefono
                into v_tel_matriz
                from ge_par_generales a, ba_telefonos b
               where a.cod_persona = b.cod_persona
                 and principal = 'S';
            EXCEPTION
              WHEN OTHERS THEN
                v_tel_matriz := null;
            END;

            it_mail.mail(fug_obt_dir_correo,
                         v_email,
                         'Actualizacion; de datos personales.',
                         'Estimado cliente,'||chr(10)||chr(10)||v_tex_mail||
                         'Si usted no ha realizado modificaciones, favor contacte con su Oficial o comuniquese a nuestro Contact Center al telefono '||v_tel_matriz||chr(10)||chr(10)||
                         'Atentamente,'||chr(10)||chr(10)||
                         fug_obt_nom_entidad
                         );
          END IF;

          IF v_retorno.error = 'N' AND v_cor_oficial is not null then
            it_mail.mail(fug_obt_dir_correo,
                         v_cor_oficial,
                         'Actualizacion de datos personales del cliente '||fue_obt_nom_persona(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona))||'(' ||nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)||')',
                         v_tex_mail||chr(10)||chr(10)||fug_obt_nom_entidad
                         );
          END IF;

          -- registro del movimiento (LOG)
           paw_con.pr_reg_operacion(null,    --p_nro_cuenta
                                   null,            --p_cod_moneda
                                   null,            --p_monto
                                   null,            --p_nro_cta_contra
                                   null,            --p_cantidad
                                   'Accion',         --p_etiqueta
                                   'Actualizacion de datos.',  --p_dato
                                   'Respuesta',         --p_etiqueta2
                                   substr(v_retorno.descripcionRespuesta,1,50), --p_dato2
                                   'AdministracionDatos', --Observacion,
                                   null, --Direccion IP
                                   v_modo||'-'||'Administracion Datos',
                                   nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                                   c_cod_operacion,
                                   null,
                                   C_COD_HOMEBANKING,
                                   p_sesion,
                                   nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                                   );  --Mensaje



          commit;
          RETURN v_retorno;
        END IF;
      END IF;
      RETURN v_retorno;
    EXCEPTION
    WHEN OTHERS THEN
      pr_mensajeUsuario(c_pre_otr_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa, 'AdministracionDatos'||' - '||SQLERRM, bitacora_error);
      RETURN v_retorno;
    END;
*/
   /**
   * @param p_sesion Codigo de la sesion
   * @param p_codCanal Codigo del canal
   * @param p_nroCda Numero de operacion CDA
   * @return Retorna los cupones de CDA
   */
    FUNCTION fu_obtenerCuponesCda(p_sesion      IN VARCHAR2,
                                  p_codCanal    IN VARCHAR2,
                                  p_nroCda      IN VARCHAR2)
    RETURN typ_cuponesCda IS

    MSG_NROCDA_NOEX       constant varchar2(15) := 'NROCDA_NOEX';
    v_retorno             typ_cuponesCda := typ_cuponesCda;
    detalleCuota          typ_cuponCda := typ_cuponCda();
    listaCuotas           typ_listaCuponCda := typ_listaCuponCda();
    retValidarSesion      typ_validarSesion;
    retError              typ_mensajeRespuesta := typ_mensajeRespuesta;
    v_sesion              bw_aut_sesiones.cod_sesion%type;
    v_cod_canal           ge_canales.cod_canal%type;
    v_nro_cuenta          varchar2(17);
    v_can_cuotas          ah_cupones.nro_cupon%type:=0;

    CURSOR cuotas(p_nro_cuenta IN VARCHAR2) IS
      select nro_cupon, mto_interes, fec_vencimiento, estado
        from ah_cupones
       where nro_cuenta = p_nro_cuenta
       and estado != 'P'
       order by nro_cupon;

  BEGIN

   If nvl(p_nroCda, 'X') = 'X' Then

      pr_mensajeUsuario(MSG_NROCDA_NOEX,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
      retError.error                := v_retorno.error;
      retError.nombreRespuesta      := v_retorno.nombreRespuesta;
      retError.descripcionRespuesta := v_retorno.descripcionRespuesta;
      pr_insertarBitacora(retValidarSesion.codigoPersona,
                          p_codCanal,
                          p_sesion,
                          v_tip_mensaje,
                          retValidarSesion.codigoEmpresa,
                          'Obtener Cupones CDa - Nro Cda: ' ||
                          p_nroCda ||
                          fu_generarBitacora(retValidarSesion.error,
                                             retValidarSesion.nombreRespuesta,
                                             retValidarSesion.descripcionRespuesta,
                                             null),
                          BITACORA_ERROR);

     /* Obtiene la informacion de parametros recibos y el return del type
     */
     paw_log.g_typ_cuponesCda := v_retorno;
     paw_log.pr_logValoresTypes('typ_cuponesCda',
     'CuponesCda'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCda);
     RETURN v_retorno;
   end if;

    --0. valido la sesion del cliente
    v_sesion    := depurarAlfanumerico(p_sesion, 32);
    v_cod_canal := depurarAlfanumerico(p_codCanal, 3);

    retValidarSesion := fu_validarSesion(v_sesion, v_cod_canal);
    IF v_ind_cta_encriptada = 'S' THEN
       v_nro_cuenta   := fu_desencriptacionCuentas(depurarCuenta(p_nroCda,
                                                                CUENTA_TAMANO));
    ELSE
       v_nro_cuenta   := depurarCuenta(p_nroCda,CUENTA_TAMANO);
    END IF;


    IF retValidarSesion.error = 'S' THEN
      v_retorno.error                := retValidarSesion.error;
      v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      /* Obtiene la informacion de parametros recibos y el return del type
      */
      paw_log.g_typ_cuponesCda := v_retorno;
      paw_log.pr_logValoresTypes('typ_cuponesCda',
      'CuponesCda'||' '||p_sesion||', '|| p_codCanal||', '||  v_nro_cuenta);

      RETURN v_retorno;
    END IF;

    -- no hubo errores, obtengo los detalles de las cuotas

      FOR cu IN cuotas(v_nro_cuenta) LOOP
        v_can_cuotas                  := v_can_cuotas + 1;
        detalleCuota.numeroCupon      := cu.nro_cupon;
        detalleCuota.monto            := cu.mto_interes;
        detalleCuota.fechaVencimiento := to_char(cu.fec_vencimiento,
                                                 'ddmmyyyy');

        listaCuotas.EXTEND;
        listaCuotas(listaCuotas.COUNT) := detalleCuota;
      END LOOP;
      v_retorno.cantidadCuotas := v_can_cuotas;
      v_retorno.listaCuotas    := listaCuotas;
      IF v_ind_cta_encriptada = 'S' THEN
         v_retorno.numeroCda := fu_encriptacioncuentas(v_nro_cuenta);
      ELSE
         v_retorno.numeroCda := v_nro_cuenta;
      END IF;
      pr_insertarBitacora(retValidarSesion.codigoPersona,
                          v_cod_canal,
                          v_sesion,
                          v_tip_mensaje,
                          retValidarSesion.codigoEmpresa,
                          'Nro. CDA:' || v_nro_cuenta || ' ' ||
                          fu_generarBitacora(retValidarSesion.error,
                                             retValidarSesion.nombreRespuesta,
                                             retValidarSesion.descripcionRespuesta,
                                             null),
                          BITACORA_SALIDA);


   /* Obtiene la informacion de parametros recibos y el return del type
    */
   paw_log.g_typ_cuponesCda := v_retorno;
   paw_log.pr_logValoresTypes('typ_cuponesCda',
   'CuponesCda'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCda);

    RETURN v_retorno;
  END;

   /**
   * @param p_sesion Codigo de la sesion
   * @param p_codCanal Codigo del canal
   * @param p_nroCda Numero de operacion CDA
   * @return Retorna los cupones de CDA
   */
   /* FUNCTION fu_envioSms(p_sesion      IN VARCHAR2,
                         p_codCanal    IN VARCHAR2,
                         p_mensaje     IN VARCHAR2)
    RETURN typ_mensajeria IS

    MSG_NROCDA_NOEX       constant varchar2(15) := 'NROCDA_NOEX';
    v_retorno             typ_mensajeria := typ_mensajeria;
    retValidarSesion      typ_validarSesion;
    retError              typ_mensajeRespuesta := typ_mensajeRespuesta;
    v_sesion              bw_aut_sesiones.cod_sesion%type;
    v_cod_canal           ge_canales.cod_canal%type;
    v_codpersona          ba_personas.cod_persona%type;
    v_area                ba_telefonos.area%type;
    v_telefono            ba_telefonos.telefono%type;
    c_tel_nulo            varchar2(3):='316';
    c_men_nulo            varchar2(3):='334';
    v_env_sms             VARCHAR2(50);

  BEGIN
    v_tip_mensaje := '240';


    --0. valido la sesion del cliente
    v_sesion    := depurarAlfanumerico(p_sesion, 32);
    v_cod_canal := depurarAlfanumerico(p_codCanal, 3);

    retValidarSesion := fu_validarSesion(v_sesion, v_cod_canal);

    IF retValidarSesion.error = 'S' THEN
      v_retorno.error                := retValidarSesion.error;
      v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      \* Obtiene la informacion de parametros recibos y el return del type
      *\
      paw_log.g_typ_mensajeria := v_retorno;
      paw_log.pr_logValoresTypes('typ_mensajeria',
      'Mensajeria'||' '||p_sesion||', '|| p_codCanal||', '||  p_mensaje);

      RETURN v_retorno;
    END IF;

    pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

    v_codpersona  := nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);

    begin
      select t.area, t.telefono
        into v_area, v_telefono
        from ba_telefonos t, (select max(cod_telefono) cod_tel FROM ba_telefonos where tip_linea='S' and cod_persona = v_codpersona) te
       where t.cod_telefono = te.cod_tel
         and t.cod_persona = v_codpersona
         and t.tip_linea = 'S';

      EXCEPTION
        WHEN OTHERS THEN
          v_telefono := null;
      END;

      if v_telefono is null then
         pr_mensajeUsuario(c_tel_nulo,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona,v_cod_canal,v_sesion,
                          v_tip_mensaje,retValidarSesion.codigoEmpresa,'Envio sms:' || p_mensaje || ' ' ||
                          fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,
                          null),BITACORA_ERROR);

         paw_log.g_typ_mensajeria := v_retorno;
         paw_log.pr_logValoresTypes('typ_mensajeria',
         'Mensajeria'||' '||p_sesion||', '|| p_codCanal||', '||  p_mensaje);

         RETURN v_retorno;
     end if;

     if p_mensaje is null then
         pr_mensajeUsuario(c_men_nulo,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona,v_cod_canal,v_sesion,
                          v_tip_mensaje,retValidarSesion.codigoEmpresa,'Envio sms:' || p_mensaje || ' ' ||
                          fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,
                          null),BITACORA_ERROR);

         paw_log.g_typ_mensajeria := v_retorno;
         paw_log.pr_logValoresTypes('typ_mensajeria',
         'Mensajeria'||' '||p_sesion||', '|| p_codCanal||', '||  p_mensaje);

         RETURN v_retorno;
     end if;

    -- no hubo errores envio el sms
     IF p_mensaje IS NOT NULL THEN
        v_env_sms := paw_not.fu_env_sms(v_area||v_telefono, p_mensaje, v_codpersona);
        v_retorno.respuesta := v_env_sms;
     END IF;

    \* Obtiene la informacion de parametros recibos y el return del type
    *\
     paw_log.g_typ_mensajeria := v_retorno;
     paw_log.pr_logValoresTypes('typ_mensajeria',
     'Mensajeria'||' '||p_sesion||', '|| p_codCanal||', '||  p_mensaje);

     IF v_retorno.error = 'N' THEN
        pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, v_tip_mensaje, retValidarSesion.codigoEmpresa,
        'Envio sms:' || p_mensaje || ' ' ||
        fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,
        null),BITACORA_SALIDA);
     END IF;
    RETURN v_retorno;
  END;
*/
    FUNCTION fu_obtenerCliente(p_codPersona in varchar2, p_codEmpresa in varchar2)
    return typ_clientefielco is
    v_clientefielco typ_clientefielco:=typ_clientefielco();
    v_tipo varchar2(1);
    v_area varchar2(4);
    v_telefono varchar2(10);
    begin
      begin
        select
            p.cod_persona,
            p.nom_completo,
            p.tipo,
            p.cod_tip_documento,
            p.nro_documento,
            p.cod_pais,
            p.dir_correo,
            d.direccion,
            t.area , t.telefono
            into
            v_clientefielco.cod_persona,
            v_clientefielco.nombre,
            v_clientefielco.tipoPersona,
            v_clientefielco.tipoDocumento,
            v_clientefielco.numeroDocumento,
            v_clientefielco.nacionalidad,
            v_clientefielco.correoElectronico,
            v_clientefielco.direccion,
            v_area,
            v_telefono
            from ba_personas p, ge_clientes c, ba_direcciones d, ba_telefonos t
            where p.cod_persona=c.cod_persona and c.cod_persona=d.cod_persona(+) and d.cod_persona=t.cod_persona(+)
            and t.principal='S' and d.principal='S' --Comentado por temas de migracion, deberia estar
            and p.cod_persona=nvl(p_codEmpresa,p_codPersona)
            and rownum=1;
                  EXCEPTION
              WHEN OTHERS THEN
                return null;
            END;
              v_clientefielco.nroTelefono:=v_area||v_telefono;
      return v_clientefielco;
    end;

    FUNCTION fu_obtenerClienteCuenta(p_nroCuenta in varchar2, p_tipoDocumento in number, p_nroDocumento in varchar2)
    return typ_clientefielco is
    v_codPersona ba_personas.cod_persona%type;
    begin
      begin
        select
          p.cod_persona
          into
          v_codPersona
          from ba_personas p, ge_cta_clientes c
          where p.cod_persona = c.cod_persona
          and p.cod_tip_documento=p_tipoDocumento
          and c.nro_cuenta=p_nroCuenta
          and p.nro_documento=p_nroDocumento;
       EXCEPTION
              WHEN OTHERS THEN
                return null;
        END;
        return paw_bem.fu_obtenerCliente(v_codPersona,null);
    end;

    FUNCTION fu_obtenerClienteDocumento(p_tipoDocumento in number, p_nroDocumento in varchar2)
    return typ_clientefielco is
    v_codPersona ba_personas.cod_persona%type;
    begin
      begin
        select
          p.cod_persona
          into
          v_codPersona
          from ba_personas p
          where p.cod_tip_documento=p_tipoDocumento
          and p.nro_documento=p_nroDocumento;
       EXCEPTION
              WHEN OTHERS THEN
                return null;
        END;
        return paw_bem.fu_obtenerCliente(v_codPersona,null);
    end;
 procedure lp_env_tra_notificacion(p_cod_persona in ba_personas.cod_persona%type,
                                   p_tip_producto in ge_mai_onb_templates.tip_producto%type,
                                   p_inf_json in ba_env_correos.parametros%type,
                                   p_tip_mensaje in bw_tip_mensajes.cod_tip_mensaje%type,
                                   p_retorno OUT typ_mensajerespuesta) is
   v_dir_mai_cliente ba_personas.dir_correo%type;
   --C_ERR_INS_ENV_CORREO CONSTANT VARCHAR2(10) := '400';
 begin
   p_retorno:=typ_mensajerespuesta();
   if p_cod_persona is not null then
       
    BEGIN
       /*
      Ticket: NVB-380 
      User: GLOPEZ
      Desc.: Buscamos de ba_tab_dat_adicionales
     */
      v_dir_mai_cliente := fue_tab_dat_adicional('BA_PERSONAS','EMAIL_ONBOARDING',p_cod_persona);
    EXCEPTION
      WHEN OTHERS THEN
         v_dir_mai_cliente := Null;
    END;
    if v_dir_mai_cliente is null then
       BEGIN
         -- Busca la direccion de Correo del Cliente y Oficial
         select b.dir_correo
           into v_dir_mai_cliente
           from ba_personas b, ge_clientes c
          where b.cod_persona = p_cod_persona
            and b.cod_persona = c.cod_persona;

       EXCEPTION
         when others then
           v_dir_mai_cliente     := null;
       END;
    end if;
   end if;
   if v_dir_mai_cliente is not null then
   begin
     insert into it.ba_env_correos
       (cod_persona,
        tip_producto,
        estado,
        fec_registro,
        parametros,
        mai_destinatario)
     values
       (p_cod_persona,
        p_tip_producto,
        'P',
        sysdate,
        p_inf_json,
        v_dir_mai_cliente);

   exception
     when others then
        pr_mensajeUsuario('ERR_RG_NOT', p_retorno.nombreRespuesta, p_retorno.descripcionRespuesta, p_retorno.error);
        pr_insertarBitacora(p_cod_persona,C_COD_HOMEBANKING, NULL, p_tip_mensaje, NULL, SUBSTR('lp_env_tra_notificacion()'||SQLERRM,1,4000), BITACORA_ERROR,NULL,'ERR_RG_NOT',SUBSTR('lp_env_tra_notificacion()'||SQLERRM,1,4000));
   end;
  end if;

 EXCEPTION
   WHEN OTHERS THEN
    NULL;
 end;
 FUNCTION fu_obt_hora(p_ind_usuario number) return varchar2 is
    v_hora ge_movimientos.hora%type;
    v_nro_sec number;
    v_nro_hor number;
  BEGIN
    if p_ind_usuario > 0 then
      v_nro_sec := fue_obt_sig_secuencia('s_hor_mov'||p_ind_usuario);
    elsif  p_ind_usuario = 0 then
      v_nro_sec := fue_obt_sig_secuencia('s_hor_mov');
    end if;

    if v_nro_sec <= 86400 then
      v_nro_hor := v_nro_sec;
    else
      v_nro_hor := mod(v_nro_sec, 86400);
    end if;
    v_hora := TO_CHAR(trunc(v_nro_hor/3600), 'FM9900')|| ':' ||
              TO_CHAR(TRUNC(MOD(v_nro_hor,3600)/60),'FM00') || ':' ||
              TO_CHAR(MOD(v_nro_hor,60),'FM00');
    return v_hora;
  EXCEPTION
    WHEN OTHERS THEN
      raise_application_error(-20000, 'No se puede obtener la hora del movimiento. ' || sqlerrm);
  END;

   /** Crea una sesion para el canal y cuenta especificada
   * @param p_password        Contraseña en texto plano
   * @param p_dato            Información de tercero que desea iniciar sesion. El tipo esta especificado en p_tipoDato
   * @param p_tipoDato        Código del tipo de cuenta que desea iniciar sesion. "D" documento, "K" codigo Persona, "C" tarjeta de credito
   * @param p_nroDocEmpresa   nro de RUC de empresa a la que esta vinculada la persona.Opcional
   * @param p_tipoDocEmpresa  Tipo de Documento de la empresa. "D" RUC
   * @param p_codCanal        Código de Canal para el cual se creará la sesion
   * @return retorna informacion de la sesion creada  e información referente a la cuenta.
   */
FUNCTION fu_iniciarsesion(p_password       IN VARCHAR2,
                          p_dato           IN VARCHAR2,
                          p_tipodato       IN VARCHAR2,
                          p_nrodocempresa  IN VARCHAR2,
                          p_tipodocempresa IN VARCHAR2,
                          p_codcanal       IN VARCHAR2)
  RETURN typ_iniciarsesion IS
  PRAGMA AUTONOMOUS_TRANSACTION;

  -- variables
  --v_est_clave       VARCHAR2(1); -- estado de la clave: N-Nueva, A-Activa- B-bloqueada I_Inactiva
  v_password     VARCHAR2(32); -- clave del cliente (plaintext)


  v_inisesion NUMBER := 0;

  --v_cod_persona       ba_personas.cod_persona%TYPE;
  v_retorno           typ_iniciarsesion := typ_iniciarsesion;
  --Codigos de error

  msg_login_ses_existe           CONSTANT VARCHAR2(30) := 'L_SES_EXISTE';
  cod_operacion                  CONSTANT VARCHAR2(5) := '005';
  fecha_hora_actual              CONSTANT DATE := SYSDATE;
BEGIN

  v_retorno := paw_seg.fu_iniciarsesion(p_password, p_dato, p_tipodato, p_nrodocempresa, p_tipodocempresa, p_codcanal);

  IF v_retorno.error = 'N' THEN
    DECLARE
      v_salt         VARCHAR2(32);
      v_authtoken    VARCHAR2(32);
      v_max_time     NUMBER;
      v_tie_restante VARCHAR(10);
    BEGIN
      -- Se crea el Token de autenticacion
      --BBVAHB-750
      BEGIN
        BEGIN
          v_inisesion := to_number(nvl(fug_obt_pardinamico('NUE_SESION_HB'), 30));
        EXCEPTION
          WHEN OTHERS THEN
            v_inisesion := 30;
        END;
        v_max_time  := v_inisesion; --minutos
        v_inisesion := v_inisesion / 1440;
        SELECT cod_sesion
          INTO v_authtoken
          FROM bw_aut_sesiones
         WHERE cod_persona = v_retorno.codigocliente
           AND cod_canal = p_codcanal
           AND fec_insercion > SYSDATE - v_inisesion;
        paw_uti.pr_mensajeusuario(msg_login_ses_existe, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, v_retorno.error);

        BEGIN

          SELECT substr(to_char(((fec_ult_actividad +
                                 numtodsinterval(fug_obt_pardinamico('NUE_SESION_HB'),
                                                   'MINUTE')) -
                                 CAST(SYSDATE AS TIMESTAMP)), 'hh24:mi:ss'),
                         15, 5)
            INTO v_tie_restante
            FROM bw_aut_sesiones
           WHERE cod_persona = v_retorno.codigocliente
             AND cod_canal = p_codcanal
             AND (fec_ult_actividad + numtodsinterval(fug_obt_pardinamico('NUE_SESION_HB'), 'MINUTE')) > SYSDATE;

          --Redondemos para arriba para mostrar solo los minutos
          v_tie_restante := to_number(substr(v_tie_restante, 0, 2)) + 1;
          -- Ajustamos el texto con el plazo de validez de la sesion
          v_retorno.descripcionrespuesta := REPLACE(v_retorno.descripcionrespuesta,
                                                    '%d', v_tie_restante);
        EXCEPTION
          WHEN OTHERS THEN
            v_retorno.descripcionrespuesta := REPLACE(v_retorno.descripcionrespuesta,
                                                      '%d', v_max_time);
            paw_uti.pr_insertarbitacora(v_retorno.codigocliente, p_codcanal, NULL, cod_operacion, v_retorno.codigoempresa, 'Error ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta,
                                                    'Error: fec_ult_actividad ' || SYSDATE || ' -- ' || SQLCODE || ' => ' || substr(SQLERRM, 1, 200), NULL), paw_uti.bitacora_error);
        END;

        paw_uti.pr_insertarbitacora(v_retorno.codigocliente, p_codcanal, v_retorno.codigocliente, cod_operacion, v_retorno.codigoempresa, 'Error ' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, NULL), paw_uti.bitacora_error);
        --v_retorno.sesionusuario := NULL;
        COMMIT;
        RETURN v_retorno;
      EXCEPTION
        WHEN OTHERS THEN
          paw_uti.pr_insertarbitacora(v_retorno.codigocliente, p_codcanal, v_retorno.codigocliente, cod_operacion,  v_retorno.codigoempresa, 'Error ' || fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, 'Error: ' || SQLCODE || ' => ' ||  substr(SQLERRM, 1, 200),  NULL), paw_uti.bitacora_error);
      END;
      --BBVAHB-750

      -- Generar Salt aleatorio Salt = MD5(random_string)
      SELECT paw_bce.fu_enc_md5(dbms_random.string('P', 20)) salt
        INTO v_salt
        FROM dual;

      -- md5(pass + salt + nroTerminal)
      v_authtoken := paw_bce.fu_enc_md5(v_password || v_salt || p_codcanal);

      --Invalidar los authtokens para misma cuenta y mismo canal
      --XXX IF (FORZAR_UNICA_SESION
      DELETE FROM bw_aut_sesiones
       WHERE cod_persona = v_retorno.codigocliente
         AND cod_canal = p_codcanal;

      --  Almacenar el hash en la tabla XX_AUTH_TOKEN, junto con los datos de IP,terminal, nroCuenta y fecha acceso
      INSERT INTO bw_aut_sesiones
        (cod_persona, cod_per_vinculada, cod_perfil, cod_canal, fec_ult_actividad, cod_sesion)
      VALUES
        (v_retorno.codigocliente, v_retorno.codigoempresa, v_retorno.codigoperfil, p_codcanal, fecha_hora_actual, v_authtoken);

      v_retorno.sesionusuario := v_authtoken;


      COMMIT;
      paw_uti.pr_insertarbitacora(v_retorno.codigocliente, p_codcanal, v_retorno.sesionusuario, cod_operacion, v_retorno.codigoempresa, 'iniciarSesion' || paw_uti.fu_generarbitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionrespuesta, NULL), paw_uti.bitacora_salida);
    END;
  END IF;
  --Estado de Softoken
  IF v_retorno.codigoEmpresa IS NULL THEN
     v_retorno.softoken := paw_otp.fu_obtenerAsignacionSofttoken(v_retorno.codigoCliente,'F', null);
  ELSE
     v_retorno.softoken := paw_otp.fu_obtenerAsignacionSofttoken(v_retorno.codigoCliente,'J', v_retorno.codigoEmpresa);
  END IF;
  --
  RETURN v_retorno;
END;
/** Verifica la validez de una sesion obtenida previamente de fu_iniciarSesion
   * @param p_sesionUsuario identificador de sesion a ser verificado
   * @param p_codCanal identificador del Canal para el cual la sesion fue obtenida
   * @return retorna información de la sesion o error si no pudo comprobarse su validez
   */
   FUNCTION fu_validarSesion(p_sesionUsuario IN VARCHAR2,
                             p_codCanal      IN VARCHAR2,
                             p_validar       IN VARCHAR DEFAULT 'S') RETURN typ_validarSesion IS
      PRAGMA AUTONOMOUS_TRANSACTION;

      MSG_AUTH_ERROR  CONSTANT VARCHAR2(15) := 'L_AUTH_ERROR';
      MSG_CAM_CLA_NUE CONSTANT VARCHAR2(15) := 'L_CAM_CLAVE_NUE';
      MSG_CAM_CLA_EXP CONSTANT VARCHAR2(15) := 'L_CAM_CLAVE_EXP';
      MSG_TK_EXPIRADO CONSTANT VARCHAR2(15) := 'L_SESSION_EXP';

      FECHA_HORA_ACTUAL             CONSTANT DATE := SYSDATE;
      MAX_TIEMPO_INACTIVIDAD_SESION CONSTANT NUMBER(3) := to_number(nvl(fug_obt_pardinamico('NUE_SESION_HB'), 30));
      COD_OPERACION                 CONSTANT VARCHAR2(5) := '005';

      v_ultimoAcceso DATE;
      v_sesion       VARCHAR2(32);
      v_retorno      typ_validarSesion;
   BEGIN
      IF length(p_sesionUsuario) = 47 THEN
         paw_seg.fu_val_ses_consumer(p_sesionUsuario, p_codCanal,
                                     v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,
                                     v_retorno.codigoPersona, v_retorno.codigoEmpresa, v_retorno.codigoPerfil);
         v_retorno.codigoCanal := p_codCanal;
         RETURN v_retorno;
      END IF;
      v_sesion := depurarAlfanumerico(p_sesionUsuario, 32);

      IF (p_codCanal IS NULL OR v_sesion IS NULL OR length(p_codCanal) = 0 OR length(v_sesion) = 0) THEN
         pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_sesion, p_codCanal, NULL, COD_OPERACION, NULL, 'fu_validarSesion- Error Canal ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      BEGIN
         SELECT cod_canal, cod_persona, cod_per_vinculada, cod_perfil, fec_ult_actividad
           INTO v_retorno.codigoCanal, v_retorno.codigoPersona, v_retorno.codigoEmpresa, v_retorno.codigoPerfil, v_ultimoAcceso
           FROM BW_AUT_SESIONES TK
          WHERE TK.cod_sesion = v_sesion;
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            --LOG "Token no existe"
            pr_insertarBitacora('0', p_codCanal, v_sesion, COD_OPERACION, NULL, 'fu_validarSesion - Token inexistente-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;

      -- AuthToken  NO corresponde al usuario y canal proveido?
      IF (v_retorno.codigoCanal <> p_codCanal) THEN
         --Panic!
         DELETE FROM BW_AUT_SESIONES
          WHERE cod_sesion = p_sesionUsuario;
         COMMIT;

         pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         --LOG "Token no corresponde a datos enviados"
         pr_insertarBitacora('0', p_codCanal, p_sesionUsuario, COD_OPERACION, NULL, 'fu_validarSesion - Token no corresponde a canal-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --El AuthToken  ya no es válido?
      IF ((FECHA_HORA_ACTUAL - v_ultimoAcceso) * 1440) > MAX_TIEMPO_INACTIVIDAD_SESION THEN

         DELETE FROM BW_AUT_SESIONES
          WHERE cod_sesion = p_sesionUsuario;
         COMMIT;
         pr_mensajeUsuario(MSG_TK_EXPIRADO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         --LOG "Token expirado"
         pr_insertarBitacora('0', p_codCanal, p_sesionUsuario, COD_OPERACION, v_retorno.codigoEmpresa, 'fu_validarSesion Token expirado-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --Validamos si la clave de acceso es nueva o ha expirado
      IF p_validar = 'S' THEN
        IF  paw_seg.fu_ver_ctr_clave('A') = 'S' THEN
         DECLARE
            v_est_clave bw_ope_claves.est_clave%type;
         BEGIN
            SELECT est_clave
              INTO v_est_clave
              FROM bw_ope_claves
             WHERE cod_persona = v_retorno.codigoPersona
               AND tip_clave = 'A'
               AND (
                     (v_retorno.codigoEmpresa IS NULL AND cod_per_vinculada IS NULL) OR
                     (v_retorno.codigoEmpresa IS NOT NULL AND cod_per_vinculada = v_retorno.codigoEmpresa)
                   );
              IF v_est_clave <> 'M' THEN
                 IF v_est_clave = 'A' THEN
                    pr_mensajeUsuario(MSG_CAM_CLA_EXP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(v_sesion, p_codCanal, p_sesionUsuario, COD_OPERACION, v_retorno.codigoEmpresa, 'fu_validarSesion - Clave acceso expirada ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 ELSIF v_est_clave IN ('N', 'P') THEN
                    pr_mensajeUsuario(MSG_CAM_CLA_NUE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(v_sesion, p_codCanal, p_sesionUsuario, COD_OPERACION, v_retorno.codigoEmpresa, 'fu_validarSesion - Clave acceso expirada ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 ELSE
                    pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(v_sesion, p_codCanal, NULL, COD_OPERACION, NULL, 'fu_validarSesion- Estado clave invalida ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                 END IF;
                 RETURN v_retorno;
              END IF;
         END;
       END IF;
      END IF;

      --todo fue ok, actualizar el ultimo acceso
      UPDATE BW_AUT_SESIONES
         SET fec_ult_actividad = FECHA_HORA_ACTUAL
       WHERE cod_sesion = p_sesionUsuario;
      COMMIT;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- pr_insertarBitacora('000', p_codCanal, p_sesionUsuario, COD_OPERACION, v_retorno.codigoEmpresa, 'validarSesion-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   END;

   /** Elimina la sesion de la lista de sesiones activas
   * @param p_sesionUsuario identificador de sesion a ser eliminado
   * @return retorna el resultado de la operacion de eliminación
   */
   FUNCTION fu_eliminarSesion(p_sesionUsuario IN VARCHAR2) RETURN typ_mensajeRespuesta IS
      PRAGMA AUTONOMOUS_TRANSACTION;
      MSG_AUTH_ERROR CONSTANT VARCHAR2(15) := 'L_AUTH_ERROR';
      COD_OPERACION  CONSTANT VARCHAR2(5) := '005';
      v_retorno typ_mensajeRespuesta := typ_mensajerespuesta;

   BEGIN

      IF length(TRIM(p_sesionUsuario)) <> 32 THEN
         pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('000', '999', p_sesionUsuario, COD_OPERACION, NULL, 'fu_eliminarSesion - Pin inválido-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --Si existe Invalidar Siempre
      DELETE FROM BW_AUT_SESIONES
       WHERE cod_sesion = p_sesionUsuario;

      IF SQL%ROWCOUNT <> 1 THEN
         --LOG intentando invalidar sesion no existente
         pr_mensajeUsuario(MSG_AUTH_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('000', '999', p_sesionUsuario, COD_OPERACION, NULL, 'fu_eliminarSesion - Pin inválido-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      ELSE
         pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('000', '999', p_sesionUsuario, COD_OPERACION, NULL, 'fu_eliminarSesion - eliminarSesion' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      END IF;
      COMMIT;
      RETURN v_retorno;
   END;

   FUNCTION fu_cambiarClaveAcceso(p_sesion      IN VARCHAR2,
                                  p_codCanal    IN VARCHAR2,
                                  p_claveActual IN VARCHAR2,
                                  p_claveNueva  IN VARCHAR2) RETURN typ_mensajeRespuesta IS

      --variables
      v_cod_operacion        VARCHAR2(3) := '080';
      v_retorno              typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_permiso              typ_obtenerPermisos;
      retValidarSesion       typ_validarSesion;
      v_clave_encriptada_new BW_OPE_CLAVES.clave%TYPE; -- GE_CLIENTES.clave%TYPE;
      v_clave_encriptada_old BW_OPE_CLAVES.clave%TYPE; -- GE_CLIENTES.clave%TYPE;
      v_clave_encriptadabd   BW_OPE_CLAVES.clave%TYPE; -- GE_CLIENTES.clave%TYPE;
      v_clave                VARCHAR2(300);
      v_aux                  VARCHAR2(100);
      v_salt                 BW_OPE_CLAVES.cla_verificador%TYPE;
      v_can_intentos         BW_OPE_CLAVES.CAN_INTENTOS%TYPE;

      --Codigos de error
      MSG_LOGIN_OK    CONSTANT VARCHAR2(15) := 'OP_APROBADA';
      MSG_LOGIN_ERR   CONSTANT VARCHAR2(15) := 'L_ERROR';
      MSG_CLA_DUPLICA CONSTANT VARCHAR2(15) := 'G_CLA_DUPLICADA';
      MSG_CLA_BLOQ_ERR  CONSTANT VARCHAR2(15) := 'L_PIN_BLOQUEADO';
      MSG_CLA_BLOQ_WARN CONSTANT VARCHAR2(15) := 'L_PIN_BLOQ_WARN';
      --MSG_NUMERIC_ERR CONSTANT VARCHAR2(15) := 'G_NUMERIC_ERROR';

   BEGIN
      v_clave_encriptada_new := p_claveNueva;
      --v_clave_encriptada_old := p_claveActual;

      --valido la sesión del cliente
      retValidarSesion := fu_validarSesion(p_sesion, p_codCanal, 'N');

      IF retValidarSesion.error = 'S' THEN
         v_retorno.error                := retValidarSesion.error;
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      v_permiso := lf_obt_permisos(retValidarSesion, v_cod_operacion); --nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), retValidarSesion.codigoPerfil, v_cod_operacion, p_codCanal);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, '- fu_cambiarClaveAcceso:' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF length(p_claveNueva) <> 32 THEN
        pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '- fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
        RETURN v_retorno;
      END IF;

      --valida que el parámetro "clave actual" sea el que se encuentre registrado en la base de datos
      BEGIN
         SELECT a.clave, a.cla_verificador, a.can_intentos
           INTO v_clave_encriptadabd, v_salt, v_can_intentos
           FROM bw_ope_claves a
          WHERE a.cod_persona = retValidarSesion.codigoPersona
            AND a.tip_clave = 'A'
            AND
              (
                (retValidarSesion.codigoEmpresa IS NULL AND a.cod_per_vinculada IS NULL) OR
                (retValidarSesion.codigoEmpresa IS NOT NULL AND a.cod_per_vinculada = retValidarSesion.codigoEmpresa )
              );
         IF SQL%NOTFOUND THEN
            pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null), BITACORA_ERROR);
         ELSE


            v_clave_encriptada_old := v_salt || '|' || p_claveActual;
            v_clave_encriptada_old := rawtohex(utl_raw.cast_to_raw(dbms_obfuscation_toolkit.md5(input_string => v_clave_encriptada_old)));
            --v_clave_encriptada_old := p_claveActual;
         END IF;
      EXCEPTION
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null), BITACORA_ERROR);
      END;

      IF (v_clave_encriptadabd <> v_clave_encriptada_old) THEN
        --issue 10622757 GMVSES-CESI-ITR-074 (PenTEST Holding 2016)
        v_retorno := paw_seg.fu_val_ope_clave(v_clave_encriptada_old, retValidarSesion.codigoPersona, null, 'A', 'N');
        v_can_intentos := v_can_intentos + 1;

        IF v_can_intentos = 4 THEN
           pr_mensajeUsuario(MSG_CLA_BLOQ_WARN, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        ELSIF v_can_intentos > 4 THEN
           pr_mensajeUsuario(MSG_CLA_BLOQ_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        ELSE
           pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        END IF;

        pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null), BITACORA_ERROR);
        RETURN v_retorno;
      END IF;

      --Control de la clave nueva
      IF length(TRIM(p_claveNueva)) = 0 THEN
         -- no viene la clave nueva
         pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      ELSIF p_claveNueva = p_claveActual THEN
         -- clave igual a la anterior
         pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      ELSE
         -- aprobado
         pr_mensajeUsuario(MSG_LOGIN_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

         -- actualizo la nueva clave
         v_clave := paw_bce.fu_gen_ope_clave(v_clave_encriptada_new,
                                             retValidarSesion.codigoPersona,
                                             retValidarSesion.codigoEmpresa,
                                             'A', -- actualizar clave de acceso
                                             'A', -- tipo de clave
                                             v_aux);
         IF v_clave in ('-5', '-3') THEN
           -- v_cod_respuesta := paw_bce.v_cod_pin_invalido;
           pr_mensajeUsuario(MSG_LOGIN_ERR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
           RETURN v_retorno;
         ELSIF v_clave = '-6' THEN
           -- v_cod_respuesta := paw_bce.v_sol_cla_existe;
           pr_mensajeUsuario(MSG_CLA_DUPLICA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_ERROR);
           RETURN v_retorno;
         END IF;
      END IF;
      -- registro del movimiento
      lp_reg_operacion(NULL /*p_nro_cuenta*/, NULL /*p_cod_moneda */, NULL /*p_monto*/, NULL /*p_nro_cta_contra*/, NULL
                       /*p_cantidad*/, 'Clave Nueva' /*p_etiqueta*/, NULL /*p_dato*/, NULL /*p_etiqueta2*/, NULL /*p_dato2*/, NULL
                       /*p_observacion*/, NULL /*p_dir_ip*/, NULL /*p_cod_respuesta*/, retValidarSesion.codigoPersona
                       /*p_cod_persona*/, v_cod_operacion /*p_cod_operacion*/, retValidarSesion.codigoPersona /*p_nro_operacion*/, p_codCanal /*p_nro_terminal*/, p_sesion /*p_clave*/, retValidarSesion.codigoEmpresa /*p_cod_per_empresa*/);

      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, '- fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_SALIDA);
      RETURN v_retorno;

   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, v_retorno.descripcionRespuesta || '-fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), NULL);
         RETURN v_retorno;
   END;
   /*FUNCTION fu_obtenerMovimientos(p_sesion              IN VARCHAR2,
                                  p_codCanal            IN VARCHAR2,
                                  p_nroCuentaEspecifica IN VARCHAR2,
                                  p_nroPagina           IN NUMBER DEFAULT NULL,
                                  p_cantItemsPagina     IN NUMBER DEFAULT NULL,
                                  p_cantDias            IN NUMBER DEFAULT NULL) RETURN typ_detalleMovimientos IS

      userInfo         typ_validarSesion;
      v_fec_actual DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
      v_fec_inicio DATE := v_fec_actual - nvl(p_cantDias, 90);
      v_fec_final  DATE := v_fec_actual;
      COD_OPERACION    VARCHAR2(3) := '021';
      v_retorno        typ_DetalleMovimientos := typ_detalleMovimientos;

   BEGIN
      v_retorno :=fu_obtenerMovimientos_por_fec(p_sesion,
                                  p_codCanal,
                                  p_nroCuentaEspecifica,
                                  p_nroPagina,
                                  p_cantItemsPagina,
                                  v_fec_inicio,
                                  v_fec_final);
      return v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obtenerMovimientos -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;*/


   FUNCTION fu_obtenerMovimientos_por_fec(p_sesion      IN VARCHAR2,
                                  p_codCanal            IN VARCHAR2,
                                  p_nroCuentaEspecifica IN VARCHAR2,
                                  p_nroPagina           IN NUMBER DEFAULT NULL,
                                  p_cantItemsPagina     IN NUMBER DEFAULT NULL,
                                  p_fec_inicio          IN DATE DEFAULT NULL,
                                  p_fec_fin             IN DATE DEFAULT NULL) RETURN typ_detalleMovimientos IS
      -- variables
      userInfo         typ_validarSesion;
      v_permiso        typ_obtenerPermisos;
      COD_OPERACION    VARCHAR2(3) := '021';
      v_retorno        typ_DetalleMovimientos := typ_detalleMovimientos;
      v_logmessage     VARCHAR2(1000);
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);

      --Logear parametros
      v_logMessage := 'p_nroPagina='||p_nroPagina||',p_cantItemsPagina='||p_cantItemsPagina||', nroCuentaEspecifica=' || p_nroCuentaEspecifica;

      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         paw_uti.pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage ||' '||paw_uti.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), paw_uti.BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      -- 2. busco los datos de la cuentas
      RETURN paw_bas.fu_obtenerMovimientos_por_fec(userInfo.codigoPersona, userInfo.codigoEmpresa, p_codCanal, p_sesion, p_nroCuentaEspecifica, p_nroPagina, p_cantItemsPagina, p_fec_inicio, p_fec_fin);
   END;
   FUNCTION fu_obtComprobanteMovimiento(p_sesion       IN VARCHAR2,
                                        p_codCanal     IN VARCHAR2,
                                        p_nroCuenta    IN VARCHAR2,
                                        p_fecha        IN DATE,
                                        p_nroDocumento IN NUMBER,
                                        p_monto        IN NUMBER,
                                        p_tipo         IN VARCHAR2,
                                        p_factura      IN VARCHAR2,
                                        p_nroSecuencia IN NUMBER DEFAULT NULL,
                                        p_hora         IN VARCHAR2 DEFAULT NULL)
    RETURN typ_comprobanteMovimiento IS

      COD_OPERACION CONSTANT VARCHAR2(3) := '022';

      MSG_OBTCOMPROB_TJ_INEXISTENTE  CONSTANT VARCHAR2(15) := 'OBTCOMP_TJ_NOEX';
      MSG_OBTCOMPROB_TJ_ERROR        CONSTANT VARCHAR2(15) := 'OBTCOMP_TJ_ERR';
      MSG_OBTCOMPROB_SIN_COMPROBANTE CONSTANT VARCHAR2(15) := 'OBTCOMP_SIN_COM';
      MSG_OBTCOMPROB_MULTIPLES_COMPR CONSTANT VARCHAR2(15) := 'OBTCOMP_MULT_CO';
      MSG_OBTCOMPROB_ERROR           CONSTANT VARCHAR2(15) := 'OBTCOMP_ERROR';
      MSG_CTA_NO_CORRESP             CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';
      --devuelve los datos del movimiento en formato html para imprimir el comprobante en la web
      v_des_tra_padre   ge_transacciones.descripcion%TYPE;
      v_cod_moneda      ge_movimientos.cod_moneda%TYPE;
      v_fila            VARCHAR2(200);
      v_cod_transaccion ge_movimientos.cod_transaccion%TYPE;
      v_cod_banco       ge_movimientos.cod_banco%TYPE;
      v_nro_caja        ge_movimientos.nro_caja%TYPE;
      v_concepto        ge_movimientos.concepto%TYPE;
      v_ofi_origen      ge_movimientos.cod_ofi_origen%TYPE;
      v_cod_oficina     ge_movimientos.cod_oficina%TYPE;
      v_hora            ge_movimientos.hora%TYPE;
      v_hora_n          ge_movimientos.hora%TYPE;
      v_cta_formateada  VARCHAR2(20);
      v_tip_cta         ge_modalidades.descripcion%TYPE;
      v_tip_mov         VARCHAR2(10);
      v_error           VARCHAR2(1000);
      v_cod_usuario     ge_movimientos.cod_usuario%TYPE;
      v_nro_secuencia   ge_movimientos.nro_secuencia%TYPE;
      v_nro_cuenta      ge_movimientos.nro_cuenta%TYPE;
      v_nro_cta_mov     ge_movimientos.nro_cuenta%TYPE;
      v_cantidad        NUMBER;
      v_cod_tra_padre   ge_movimientos.cod_tra_padre%TYPE;
      v_cod_mad_padre   ge_movimientos.cod_mad_padre%TYPE;
      v_cod_mod_padre   ge_movimientos.cod_mod_padre%TYPE;
      v_cod_modulo      NUMBER(5);
      v_cod_modalidad   NUMBER(5);
      v_retorno         typ_comprobanteMovimiento := typ_comprobanteMovimiento;
      v_msj_bitacora    VARCHAR2(400);
      v_nroDocumento    ge_movimientos.nro_documento%TYPE := p_nroDocumento;
      v_monto           ge_movimientos.monto%TYPE := p_monto;
      userInfo          typ_validarSesion;
      v_permiso         typ_obtenerPermisos;
      v_nroCuenta       VARCHAR2(20);
      v_nro_documento3  ge_movimientos.nro_documento3%type := null;
      -- SNP
      v_situacion       varchar2(100);
      v_estado          varchar2(100);
      v_msj_swift       varchar2(1000);
      v_tip_mt          varchar2(20);
      --v_nro_operacion   bw_movimientos.nro_documento%type;
      v_nro_factura     ge_pag_proveedores.nro_factura%TYPE;
      v_ref_factura     ge_pag_proveedores.ref_facturas%TYPE;
      v_tipo         varchar2(4);
      v_cuenta       varchar2(100);
      v_bic          varchar2(100);
      v_banco        varchar2(300);
      v_nombre       varchar2(300);
      v_nro_cta_origen        varchar2(35);
      v_nro_cta_destino       varchar2(35);
      v_banco_origen          varchar2(40);
      v_banco_destino         varchar2(40);
      v_nom_origen            varchar2(200);
      v_nom_destino           varchar2(200);
      v_nro_doc_solicitante   VARCHAR2(20);
      v_nro_doc_beneficiario  VARCHAR2(50);

      --detalles del movimiento
      CURSOR detalles(p_nro_documento IN ge_movimientos.nro_documento%TYPE) IS
         SELECT decode(a.cod_tra_padre, v_cod_tra_padre, b.descripcion, c.descripcion) descripcion, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad), decode(a.nro_cuenta, NULL, nvl(a.TIP_MOV_RUBRO, fug_obt_tip_mov_contable(a.cod_modulo, a.cod_modalidad, a.cod_transaccion)), decode(a.cod_modulo, 3, b.tipo, 4, b.tipo, nvl(a.TIP_MOV_RUBRO, fug_obt_tip_mov_contable(a.cod_modulo, a.cod_modalidad, a.cod_transaccion)))) tipo, a.cod_moneda, rownum, a.cod_transaccion, a.cod_banco,
                decode(a.cod_modulo, 5, fut_obt_nro_tarjeta(a.nro_cuenta), a.nro_cuenta) nro_cuenta, a.monto, a.nro_caja, a.concepto, a.cod_ofi_origen, a.hora, cod_oficina, a.cod_modulo cod_modulo, nro_documento3, decode(a.nro_cuenta, NULL, NULL, fug_cta_formateada(a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.nro_cuenta, a.cod_moneda)) cta_formateada, a.cod_modulo modulo, a.cod_modalidad modalidad
           FROM ge_transacciones c, ge_transacciones b, gv_movimientos a
          WHERE /*a.reversado = 'N'
            AND */a.fecha = p_fecha
            AND a.hora = v_hora
            AND a.cod_usuario = v_cod_usuario
            AND a.cod_transaccion = b.cod_transaccion
            AND a.cod_modulo = b.cod_modulo
            AND a.cod_modalidad = b.cod_modalidad
            AND a.estado = 'N'
            AND b.ve_cliente = 'S'
            AND a.nro_secuencia <> v_nro_secuencia --para q no traiga el principal otra vez
            AND (a.nro_cuenta <> v_nro_cuenta OR a.nro_cuenta IS NULL) --para q no traiga otro débito o crédito a la cuenta
            AND a.monto > 0
            AND (a.nro_cuenta = v_nro_cta_mov OR v_nro_cta_mov IS NULL)
            AND a.cod_tra_padre = c.cod_transaccion
            AND a.cod_mod_padre = c.cod_modulo
            AND a.cod_mad_padre = c.cod_modalidad
            AND ((a.cod_modulo <> 4) OR (a.cod_modulo = 4 AND a.cod_modalidad = 41))
            AND ((a.cod_modulo = 6 AND a.cod_modalidad <> 68) OR a.cod_modulo <> 6)
            AND ((v_cod_tra_padre not in (360, 361, 362, 359) and a.nro_documento = p_nro_documento) OR
                 v_cod_tra_padre in (360, 361, 362, 359)
                ) -- para pagos en batch, hay movimientos con misma hora y fecha, se excluyen prestamos
                  -- que no tienen el mismo numero de documento para los movimientos registrados
          ORDER BY nro_secuencia;

      FUNCTION lf_cta_relacionadas(p_nro_Cuenta1 IN VARCHAR2,
                                   p_nro_cuenta2 IN VARCHAR2) RETURN VARCHAR2 IS
         v_sino VARCHAR2(1) := 'N';
      BEGIN
         IF p_nro_cuenta1 = v_nro_cuenta AND v_tip_mov = 'Débito' THEN
            RETURN 'S';
         ELSE
            SELECT 'S'
              INTO v_sino
              FROM ge_cta_clientes a
             WHERE a.nro_cuenta = p_nro_cuenta1
               AND EXISTS (SELECT 0
                      FROM ge_cta_clientes b
                     WHERE b.nro_cuenta = p_nro_cuenta2
                       AND b.cod_persona = a.cod_persona)
               AND rownum = 1;
         END IF;
         RETURN v_sino;
      EXCEPTION
         WHEN OTHERS THEN
            RETURN 'N';
      END;

   BEGIN

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      --Adicionar sanitización
      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parámetros
      v_nroCuenta:=depurarAlfanumerico(p_nroCuenta,CUENTA_TAMANO);
      v_msj_bitacora := substr('nroCuenta: ' || v_nroCuenta
                                             ||', fec: '||to_char(p_fecha, 'dd/mm/yyyy')
                                             ||', tip: '||substr(p_tipo, 1, 1)
                                             ||', doc: '||v_nroDocumento
                                             ||', mto: '||v_monto
                                             ||', sec: '||p_nroSecuencia
                                             ||', fac: '||p_factura,1, 400); --XXX
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ENTRADA);

      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;

      -- se valida el permiso
      v_permiso := lf_obt_permisos(userInfo, COD_OPERACION);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      --identifica si el parámetro es una cuenta o una tarjeta
      IF length(v_nroCuenta) = 16 THEN
         -- es un tarjeta de crédito
         BEGIN
            SELECT nro_cuenta
              INTO v_nro_cuenta
              FROM ta_tarjetas b
             WHERE b.nro_tarjeta = v_nroCuenta;
         EXCEPTION
            WHEN no_data_found THEN
               pr_mensajeUsuario(MSG_OBTCOMPROB_TJ_INEXISTENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'No existe Tarjeta-'||v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, null), BITACORA_ERROR);
               RETURN v_retorno;
            WHEN OTHERS THEN
               pr_mensajeUsuario(MSG_OBTCOMPROB_TJ_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_msj_bitacora || ', ORA-ERR : [' || substr(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
               RETURN v_retorno;
         END;
      ELSE
         v_nro_cuenta := depurarAlfanumerico(v_nroCuenta,15);
      END IF;

      --Valida que la cuenta corresponda al cliente
      IF p_tipo != 'I' THEN -- Transferencia Interbancaria (envia nro. referencia)
         IF lf_val_cta_origen(v_nroCuenta, nvl(userinfo.codigoEmpresa, userinfo.codigopersona)) = 'N' THEN
            pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;

      --recupera el movimiento principal
      BEGIN
         IF p_tipo = 'I' THEN -- Transferencia Interbancaria
            SELECT decode(length(gs.nro_cta_beneficiario),16,'PAGO DE TARJETA OTROS BCOS','TRANSFERENCIA INTERBANCARIA'),
                   null, null, gs.cod_moneda, 1, null, null, gs.usu_insercion, null,
                   decode(length(gs.nro_cta_beneficiario),16,'Pago de Tarjeta Otros Bcos','Transferencia Interbancaria'),
                   gs.cod_oficina, null, gs.cod_oficina, null, gs.nro_cta_solicitante, null, null,
                   FUE_OBT_DES_REFCODES('SITUACION',gs.situacion) Situacion,
                   FUE_OBT_DES_REFCODES('EST_MSJ_SNP',gs.estado) Estado, gs.msj_swift,
                   decode(gs.ind_valor,'S','Alto Valor','Bajo Valor'),to_char(gs.fec_insercion, 'hh24:mi:ss')
              INTO v_des_tra_padre, v_tip_cta, v_tip_mov, v_cod_moneda, v_fila, v_cod_transaccion, v_cod_banco, v_cod_usuario,
                   v_nro_caja, v_concepto, v_ofi_origen, v_hora, v_cod_oficina, v_nro_secuencia, v_cta_formateada, v_cod_tra_padre,
                   v_cod_modulo, v_situacion, v_estado, v_msj_swift, v_tip_mt, v_hora_n
              FROM ge_snp_transferencias gs
             WHERE gs.nro_referencia = v_nro_cuenta ;
         ELSE
            SELECT c.descripcion, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad), decode(p_tipo, 'D', 'Débito', 'Crédito'), a.cod_moneda, rownum, a.cod_transaccion, a.cod_banco, cod_usuario, a.nro_caja, a.concepto, a.cod_ofi_origen, a.hora, cod_oficina, nro_secuencia, fug_cta_formateada(a.cod_modulo, a.cod_modalidad, a.cod_oficina, a.nro_cuenta, a.cod_moneda), a.cod_tra_padre, a.cod_modulo, a.cod_modalidad, a.nro_documento3, a.cod_mad_padre,
              to_char(a.fec_insercion, 'hh24:mi:ss'), a.cod_mod_padre
              INTO v_des_tra_padre, v_tip_cta, v_tip_mov, v_cod_moneda, v_fila, v_cod_transaccion, v_cod_banco, v_cod_usuario, v_nro_caja, v_concepto, v_ofi_origen, v_hora, v_cod_oficina, v_nro_secuencia, v_cta_formateada, v_cod_tra_padre, v_cod_modulo, v_cod_modalidad, v_nro_documento3, v_cod_mad_padre,
              v_hora_n, v_cod_mod_padre
              FROM ge_transacciones c, ge_transacciones b, gv_movimientos a
             WHERE ((a.nro_documento = v_nroDocumento OR v_nroDocumento IS NULL) OR
                    (a.COD_MAD_PADRE = 455 and substr(a.nro_documento,-7) = v_nroDocumento)) -- SNP
               AND (a.nro_secuencia = p_nroSecuencia OR p_nroSecuencia IS NULL)
             --  AND a.reversado = 'N'
               AND a.estado = 'N'
               AND a.nro_cuenta = v_nro_cuenta
               AND a.fecha = p_fecha
               AND a.monto = v_monto
               AND (a.HORA = p_hora or p_hora is null)
               AND fug_obt_tra_tipo(b.cod_transaccion, b.tipo, b.afecta) = p_tipo
               AND a.cod_transaccion = b.cod_transaccion
               AND a.cod_modulo = b.cod_modulo
               AND a.cod_modalidad = b.cod_modalidad
               AND a.cod_tra_padre = c.cod_transaccion
               AND a.cod_mod_padre = c.cod_modulo
               AND a.cod_mad_padre = c.cod_modalidad;
         END IF;
      if v_cod_tra_padre = pas_snp.fu_obt_cod_tra_padre and
         v_cod_mod_padre = pas_snp.fu_obt_cod_mod_padre and
         v_cod_mad_padre = pas_snp.fu_obt_cod_mad_padre then

       begin
        SELECT gs.nro_cta_solicitante,
               gs.nro_cta_beneficiario,
               paw_bem.lf_obt_bco_snp_swift(nvl(gs.cod_swi_suc_solicitante, gs.cod_swi_pte_solicitante)),
               paw_bem.lf_obt_bco_snp_swift(nvl(gs.cod_swi_suc_beneficiario, gs.cod_swi_pte_beneficiario)),
               nvl(fue_obt_nom_persona(gs.cod_per_solicitante),upper(gs.nom_solicitante)),
               nvl(fue_obt_nom_persona(gs.cod_per_beneficiario),upper(gs.nom_beneficiario)),
               gs.nro_doc_solicitante,
               gs.nro_doc_beneficiario
          INTO v_nro_cta_origen,
               v_nro_cta_destino,
               v_banco_origen,
               v_banco_destino,
               v_nom_origen,
               v_nom_destino,
               v_nro_doc_solicitante,
               v_nro_doc_beneficiario
         FROM ge_snp_transferencias gs
        WHERE gs.nro_referencia = v_nroDocumento
          and gs.cod_usuario = v_cod_usuario
          and gs.cod_moneda = v_cod_moneda;
        EXCEPTION
           WHEN no_data_found THEN
              pr_mensajeUsuario(MSG_OBTCOMPROB_SIN_COMPROBANTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Sin.Comp- ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
           WHEN too_many_rows THEN
              pr_mensajeUsuario(MSG_OBTCOMPROB_MULTIPLES_COMPR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Dup.Comp- ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
           WHEN OTHERS THEN
              pr_mensajeUsuario(MSG_OBTCOMPROB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Err.Imp- ' || v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 250) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
        END;
        
      elsif v_cod_tra_padre = 388 and
            v_cod_mod_padre = 9 and
            v_cod_mad_padre = 91 then
       begin
             SELECT 
               case when p_tipo = 'D' then
                 p_nroCuenta
               else
                 a.NRO_CUENTA  
               end  nro_cta_solicitante,
               case
               when p_tipo = 'D' then
                 a.NRO_CUENTA
               else
                 p_nroCuenta   
               end  nro_cta_beneficiario,
               paw_bem.lf_obt_bco_snp_swift(pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)),
               paw_bem.lf_obt_bco_snp_swift(pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)),
               case
               when p_tipo = 'D' then
                 fue_obt_nom_persona( FUG_OBT_CLI_PRINCIPAL(p_nroCuenta))
               else
                  fue_obt_nom_persona( FUG_OBT_CLI_PRINCIPAL(a.NRO_CUENTA))  
               end , 
               case
               when p_tipo = 'D' then
                 fue_obt_nom_persona( FUG_OBT_CLI_PRINCIPAL(a.NRO_CUENTA))
               else
                 fue_obt_nom_persona( FUG_OBT_CLI_PRINCIPAL(p_nroCuenta))  
               end ,
               
               case
               when p_tipo = 'D' then
                 FUE_OBT_NRO_DOC_PERSONA( FUG_OBT_CLI_PRINCIPAL(p_nroCuenta))
               else
                  FUE_OBT_NRO_DOC_PERSONA( FUG_OBT_CLI_PRINCIPAL(a.NRO_CUENTA))  
               end , 
               case
               when p_tipo = 'D' then
                 FUE_OBT_NRO_DOC_PERSONA( FUG_OBT_CLI_PRINCIPAL(a.NRO_CUENTA))
               else
                 FUE_OBT_NRO_DOC_PERSONA( FUG_OBT_CLI_PRINCIPAL(p_nroCuenta))  
               end 
              
             into   v_nro_cta_origen,
               v_nro_cta_destino,
               v_banco_origen,
               v_banco_destino,
               v_nom_origen,
               v_nom_destino,
               v_nro_doc_solicitante,
               v_nro_doc_beneficiario     
              FROM ge_transacciones c, ge_transacciones b, gv_movimientos a
             WHERE 
                a.estado = 'N'
               AND a.fecha = p_fecha
               AND a.HORA = v_hora 
               and a.COD_USUARIO = v_cod_usuario
               AND fug_obt_tra_tipo(b.cod_transaccion, b.tipo, b.afecta) not in (p_tipo,'E','P')
               AND a.cod_transaccion = b.cod_transaccion
               AND a.cod_modulo = b.cod_modulo
               AND a.cod_modalidad = b.cod_modalidad
               AND a.cod_tra_padre = c.cod_transaccion
               AND a.cod_mod_padre = c.cod_modulo
               AND a.cod_mad_padre = c.cod_modalidad;
              EXCEPTION
           WHEN no_data_found THEN
              pr_mensajeUsuario(MSG_OBTCOMPROB_SIN_COMPROBANTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Sin.Comp- ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
           WHEN too_many_rows THEN
              pr_mensajeUsuario(MSG_OBTCOMPROB_MULTIPLES_COMPR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Dup.Comp- ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
           WHEN OTHERS THEN
              pr_mensajeUsuario(MSG_OBTCOMPROB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Err.Imp- ' || v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 250) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
              RETURN v_retorno;
        END;
               
      end if;
      EXCEPTION
         WHEN no_data_found THEN
            pr_mensajeUsuario(MSG_OBTCOMPROB_SIN_COMPROBANTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Sin.Comp- ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         WHEN too_many_rows THEN
            pr_mensajeUsuario(MSG_OBTCOMPROB_MULTIPLES_COMPR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Dup.Comp- ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_OBTCOMPROB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Err.Imp- ' || v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 250) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
      END;
      -- se busca si hay facturas pagadas para pago a proveedores
      IF v_cod_tra_padre in (346, 348) AND p_tipo = 'C' THEN
         BEGIN
             select gpp.nro_factura, gpp.ref_facturas
              into v_nro_factura, v_ref_factura
              from ge_pag_proveedores gpp
             where gpp.cod_ente = v_nro_documento3
               and gpp.fec_pago = p_fecha
               and gpp.nro_cta_credito = v_nro_cuenta
               and gpp.monto = v_monto
               and gpp.referencia = v_nroDocumento;

             --Se toma el valor de NRO_FACTURA pero si es null se retorna REF_FACTURAS
             v_retorno.referenciaFacturas := NVL(v_nro_factura, v_ref_factura);
             if (v_retorno.referenciaFacturas <= 0) then
                --Se verifica si la factura es CERO en cuyo caso se devuelve REF_FACTURAS
                v_retorno.referenciaFacturas := v_ref_factura;
             end if;
         EXCEPTION
            WHEN OTHERS THEN
               NULL;
         END;
      END IF;

      -- se pidio no mostrar detalle de creditos en el comprobante de
      -- pago de sueldos y proveedores
      IF v_cod_tra_padre in (360, 361, 362, 359)
         AND v_cod_transaccion = 503 AND p_tipo = 'D' THEN
         v_nro_cta_mov := NULL; --tomar todos los detalles ya que son de la cuenta
      ELSIF v_cod_tra_padre = 411 THEN
         v_nro_cta_mov := v_nro_cuenta; -- occultar cta. credito puente
      ELSIF TRIM(v_concepto) LIKE 'Imp:%Desp%' THEN
         v_nro_cta_mov := v_nro_cuenta; --son mov de pago de despachos, sólo tomar el de la cuenta
      ELSE
         --busca si hay más movimientos de otras cuentas para el movimiento principal -> son movimientos masivos
         SELECT COUNT(0)
           INTO v_cantidad
           FROM (SELECT DISTINCT nro_cuenta, a.cod_transaccion
                   FROM ge_transacciones b, gv_movimientos a
                 WHERE /*a.reversado = 'N'
                      AND*/ a.fecha = p_fecha
                      AND a.hora = v_hora
                      AND a.cod_usuario = v_cod_usuario
                      AND a.cod_transaccion = b.cod_transaccion
                      AND a.cod_modulo = b.cod_modulo
                      AND a.cod_modalidad = b.cod_modalidad
                      AND a.estado = 'N'
                      AND b.ve_cliente = 'S'
                      AND a.nro_cuenta IS NOT NULL
                      AND a.nro_secuencia <> v_nro_secuencia
                      AND a.monto > 0);
         IF v_cantidad > 2 OR substr(v_cod_usuario,1,3) = 'ATM' OR
            v_cod_tra_padre IN (303, 333, 3303, -- pagos de sueldos
                             346, 348) THEN -- pagos a proveedores
            v_nro_cta_mov := v_nro_cuenta; --son movimientos masivos o por ATM, sólo tomar el de la cuenta
         ELSE
            v_nro_cta_mov := NULL; --tomar todos los detalles ya que son de la cuenta
         END IF;
      END IF;
      IF v_cta_formateada IS NOT NULL THEN
         if p_tipo = 'I' then
            pag_cta.PR_OBT_CUENTA(v_cta_formateada);
         else
            pag_cta.PR_OBT_CUENTA(v_nro_cuenta);
         end if ;

         IF PAG_CTA.FU_OBT_COD_ERROR() <> 0 THEN
            v_error := substr(pag_cta.fu_obt_msj_error(), 1, 250);
            pr_mensajeUsuario(MSG_OBTCOMPROB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_msj_bitacora || ', CTA-ERR : [' || v_error || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            RETURN v_retorno;
         END IF;
      END IF;

      v_retorno.descripcionMovimiento := v_des_tra_padre;

      if v_cod_tra_padre=303 then
         if v_cod_transaccion = 196 then
           v_concepto:='CARGO POR TRANS. OTROS BANCOS';
         end if;
         if v_cod_transaccion = 517 then
           v_concepto:='IVA S/COMISIONES TRANS. A OTROS BANCOS';
         end if;
      end if;

      v_retorno.nroCuenta := v_cta_formateada;
      v_retorno.descTipoCuenta := fue_obt_titulo(v_tip_cta);
      v_retorno.denominacion   := pag_cta.FU_OBT_NOM_CUENTA; --XXX

      v_retorno.codMoneda      := v_cod_moneda;
      v_retorno.oficinaDestino := fue_obt_titulo(fue_obt_des_oficina(v_cod_oficina));
      v_retorno.fecha          := lf_for_date(p_fecha);
      v_retorno.hora           := v_hora_n;
      v_retorno.oficinaOrigen  := fue_obt_des_oficina(v_ofi_origen); ---XXX oficina otra vez?
      v_retorno.monto          := p_monto;
      v_retorno.concepto       := v_concepto;
      v_retorno.codigoBanco    := v_cod_banco;
      v_retorno.nroCaja        := v_nro_caja;
      v_retorno.codigoModulo   := v_cod_modulo;
      v_retorno.codigoModalidad:= v_cod_modalidad;

      v_retorno.nro_cta_origen := v_nro_cta_origen;
      v_retorno.nro_cta_destino := v_nro_cta_destino;
      v_retorno.banco_origen := v_banco_origen;
      v_retorno.banco_destino := v_banco_destino;
      v_retorno.nombre_origen    := v_nom_origen;
      v_retorno.nombre_destino   := v_nom_destino;
      v_retorno.nro_doc_solicitante  := v_nro_doc_solicitante;
      v_retorno.nro_doc_beneficiario  := v_nro_doc_beneficiario;
       begin
                select t.tipo,t.cuenta,t.nombre,t.bic
                into v_tipo,v_cuenta,v_nombre,v_bic
                from     (
                        select  decode(tip_operacion,'P','R','E') as tipo ,
                                decode(tip_operacion,'P',nro_cta_origen,g.nro_cta_receptor) as cuenta ,
                                decode(tip_operacion,'P',nom_cli_origen,nom_cli_receptor) as nombre ,
                                decode(tip_operacion,'P',bic_origen,g.bic_receptor) as bic
                        from ge_spi_transferencias g
                        where nro_referencia=v_nroDocumento
                        union all
                        select  decode(cod_swi_pte_solicitante,'BBVAPYPA','E','R') as tipo ,
                                decode(cod_swi_pte_solicitante,'BBVAPYPA',t.nro_cta_beneficiario,t.nro_cta_solicitante) as cuenta ,
                                decode(cod_swi_pte_solicitante,'BBVAPYPA',t.nom_beneficiario,t.nom_solicitante)as nombre,
                                decode(cod_swi_pte_solicitante,'BBVAPYPA',t.cod_swi_pte_beneficiario,t.cod_swi_pte_solicitante) as bic
                        from ge_snp_transferencias t
                        where nro_referencia=v_nroDocumento ) t;
         exception when no_data_found then
               v_tipo:='N';
               v_banco:='N';
               v_nombre:='N';
               v_cuenta:='N';
         when others then
               v_tipo:='N';
               v_banco:='N';
               v_nombre:='N';
               v_cuenta:='N';
         end;

       begin
            SELECT participante
            into v_banco
            FROM gv_snp_participantes g
            WHERE g.cod_swift=v_bic;
       exception when no_data_found then
             v_banco:='N';
       when others then
              v_banco:='N';
       end;

      v_retorno.tipoDetalle   := v_tipo;
      v_retorno.bancoDetalle  := v_banco;
      v_retorno.nombreDetalle := v_nombre;
      v_retorno.cuentaDetalle := v_cuenta;

      --detalles del movimiento
      v_retorno.cantDetalles       := 0;
      v_retorno.detallesMovimiento := typ_listaComprobanteDetalleMov();
      IF v_cod_tra_padre IN (360, 361, 362, 359) THEN
        v_retorno.codigoDato1:='CUOTA';

      END IF;
      FOR reg IN detalles(v_nroDocumento) LOOP
         DECLARE
            v_detalleMovimiento typ_comprobanteDetalleMov := typ_comprobanteDEtalleMov;
         BEGIN
            IF lf_cta_relacionadas(v_nro_cuenta, reg.nro_cuenta) = 'S' THEN

               v_retorno.cantDetalles          := v_retorno.cantDetalles + 1;
               v_detalleMovimiento.descripcion := fue_obt_titulo(reg.descripcion);
               IF reg.cod_modulo = 5 THEN
                  --tarjeta
                  v_detalleMovimiento.cuenta := fut_for_tarjeta(reg.nro_cuenta);
               ELSE
                  v_detalleMovimiento.cuenta := reg.cta_formateada;
               END IF;

               IF v_cod_tra_padre IN (360, 361, 362, 359) THEN
                  --préstamos
                  v_detalleMovimiento.nroDocumento := reg.nro_documento3;
                  v_retorno.dato1:=reg.nro_documento3;
               END IF;
               v_detalleMovimiento.codMoneda := reg.cod_moneda;
               v_detalleMovimiento.monto := reg.monto;
               v_retorno.detallesMovimiento.extend;
               v_retorno.detallesMovimiento(v_retorno.detallesMovimiento.count) := v_detalleMovimiento;
            END IF;
         END;
      END LOOP;
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_OBTCOMPROB_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Err.GEN- ' || v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 250) || '] ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;
  /* FUNCTION fu_obtenerOficinas RETURN typ_informacionOficinas IS

      v_listaOficinas typ_listaOficinas := typ_listaOficinas();
      v_retorno       typ_informacionOficinas := typ_informacionOficinas;
      v_can_detalles  NUMBER(3) := 0; -- cantidad de oficinas
      COD_OPERACION   VARCHAR2(3) := '223';
      codCanal        VARCHAR2(3) := '999';
      CURSOR agencias IS
         SELECT cod_oficina, REPLACE(descripcion, 'Ñ', 'N') descripcion
           FROM ba_oficinas
          WHERE estado = 'A'
                AND cod_oficina NOT IN (31)
          ORDER BY descripcion; -- no se toma la casa matriz para el bbva

   BEGIN
