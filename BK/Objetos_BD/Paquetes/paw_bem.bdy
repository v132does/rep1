  /*
  Obtiene tipos de documentos.

  */
  FUNCTION Fu_obtenerTipoDocumentos(p_sesion      IN VARCHAR2,
                                    p_codigoCanal IN VARCHAR2)
    RETURN typ_tipoDocumentos IS

    v_listaDocumentos typ_listadocumentos := typ_listadocumentos();
    v_retorno         typ_tipoDocumentos := typ_tipoDocumentos;
    userInfo          typ_validarSesion;
    v_can_detalles    number(3) := 0; -- cantidad de oficinas
    c_cod_operacion   varchar2(3) := '226';
    v_cod_canal       varchar2(3);
    v_sesion          bw_aut_sesiones.cod_sesion%type;

    CURSOR documentos IS
      SELECT cod_tip_documento, descripcion, abreviatura, tip_persona
        FROM ba_tip_documentos
       WHERE estado = 'A';

  BEGIN
    v_sesion    := depurarAlfanumerico(p_sesion, 32);
    v_cod_canal := depurarAlfanumerico(p_codigoCanal, 3);

    pr_mensajeUsuario(MSG_OK,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
    userInfo := fu_validarSesion(v_sesion, v_cod_canal);
    pr_insertarBitacora(userInfo.codigoPersona,null,null,c_cod_operacion,null,'ObtenerTiposDocumentos-',BITACORA_ERROR);

    IF userInfo.error = 'S' THEN
      v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
      v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
      v_retorno.error                := 'S';
      RETURN v_retorno;
    END IF;

    FOR ag IN documentos LOOP
      DECLARE
        v_detalleDocumento typ_tipoDocumento := typ_tipoDocumento;
      BEGIN
        v_can_detalles                         := v_can_detalles + 1;
        v_detalleDocumento.codigoTipoDocumento := ag.cod_tip_documento;
        v_detalleDocumento.descripcion         := substr(ag.descripcion, 1,100);
        v_detalleDocumento.abreviatura         := ag.abreviatura;
        v_detalleDocumento.tipoPersona         := ag.tip_persona;
        v_listaDocumentos.extend;
        v_listaDocumentos(v_listaDocumentos.count) := v_detalleDocumento;

      EXCEPTION
        WHEN OTHERS THEN
          pr_mensajeUsuario(MSG_ERROR,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
          pr_insertarBitacora(userInfo.codigoPersona,null,null,c_cod_operacion,null,'ObtenerTiposDocumentos-',BITACORA_ERROR);
      END;
    END LOOP;
    IF v_retorno.error = 'N' THEN
      v_retorno.informacionDocumentos := v_listaDocumentos;
      v_retorno.cantdocumentos        := v_can_detalles;
    END IF;
    RETURN v_retorno;
   EXCEPTION
    WHEN OTHERS THEN
      pr_mensajeUsuario(msg_error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
      pr_insertarBitacora(userInfo.codigoPersona,null,null,c_cod_operacion,null,'ObtenerTiposDocumentos-',BITACORA_ERROR);
      RETURN v_retorno;
   END;
   /*Obtener modalidades para hb*/

   FUNCTION Fu_obtenerModalSolicitud(p_sesion      IN VARCHAR2,
                                    p_codigoCanal IN VARCHAR2,
                                    p_tipo        IN VARCHAR2)
    RETURN typ_modalSolicitud IS

    c_cod_operacion varchar2(3) := '227';
    c_sin_modalidad  constant varchar2(15) := '284';
    v_cod_canal     varchar2(3);
    v_tipo          varchar2(3);
    v_sesion        bw_aut_sesiones.cod_sesion%type;
    v_retorno       typ_modalSolicitud := typ_modalSolicitud;
    userInfo        typ_validarSesion;

   BEGIN
    v_sesion    := depurarAlfanumerico(p_sesion, 32);
    v_cod_canal := depurarAlfanumerico(p_codigoCanal, 3);
    v_tipo      := depurarAlfanumerico(p_tipo, 32);

    pr_mensajeUsuario(MSG_OK,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
    userInfo := fu_validarSesion(v_sesion, v_cod_canal);
    pr_insertarBitacora(userInfo.codigoPersona,null,null,c_cod_operacion,null,'Fu_obtenerModalSolicitud-',BITACORA_ERROR);

    IF userInfo.error = 'S' THEN
      v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
      v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
      v_retorno.error                := 'S';
      RETURN v_retorno;
    END IF;
    IF v_tipo = 'PP' then
      --Prestamos Personales
      v_retorno.codigoModalidad := fug_obt_pardinamico('BWE_COD_PRE_CONSUMO',NULL,NULL,NULL);
      v_retorno.descripcion     := 'Prestamos Personales';
    ELSIF v_tipo = 'DD' then
      --Descuento de Documentos: pagares
      v_retorno.codigoModalidad := fug_obt_pardinamico('BWE_COD_PRE_PAGARES', NULL,NULL,NULL);
      v_retorno.descripcion     := 'Descuento de Documentos-pagares';

    ELSIF v_tipo = 'DC' then --Descuento de Documentos: cheques.
      v_retorno.codigoModalidad := fug_obt_pardinamico('BWE_COD_PRE_CHEQUES', NULL,NULL,NULL);
      v_retorno.descripcion     := 'Descuento de Documentos-Cheques.';
    END IF;

    If nvl(v_retorno.codigoModalidad,'N') = 'N'  then
      pr_mensajeUsuario(c_sin_modalidad,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
      pr_insertarBitacora(userInfo.codigoPersona,null,NULL,c_cod_operacion,NULL,'Fu_obtenerModalSolicitud-',BITACORA_ERROR);
    end if;
   RETURN v_retorno;
  EXCEPTION
    WHEN OTHERS THEN
      pr_mensajeUsuario(msg_error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
      pr_insertarBitacora(userInfo.codigoPersona,null,NULL,c_cod_operacion,NULL,'Fu_obtenerModalSolicitud-',BITACORA_ERROR);
      RETURN v_retorno;
  END;

  /* Registra la solicitud de Prestamo*/
  /*FUNCTION fu_registrarSolicitud
  (
     p_sesion            IN VARCHAR2,
     p_codigoCanal       IN VARCHAR2,
     p_cabeceraSolicitud IN typ_cabecerasolicitud
  ) RETURN typ_cabecerasolicitud IS

     v_cod_operacion    VARCHAR2(3) := '045';
     v_sesion           bw_aut_sesiones.cod_sesion%TYPE;
     v_codigoCanal      bw_aut_sesiones.cod_canal%TYPE;
     userInfo           typ_validarSesion;
     v_retorno          typ_cabecerasolicitud := p_cabeceraSolicitud;
     v_permiso          typ_obtenerPermisos;
     v_mensajeCaja      typ_mensajeCaja;
     v_msj_bitacora     VARCHAR2(200) := '';
     v_nro_solicitud    NUMBER(11) := 0;
     v_detalleSolicitud typ_detallesolicitud;
     v_logMessage       VARCHAR2(1000);
     v_estado           VARCHAR2(1) := 'I';
  BEGIN
     pre_cam_for_numerico('.,');
     v_msj_bitacora := substr('sucursal:' || p_cabeceraSolicitud.sucursal || ', modalidad:' || p_cabeceraSolicitud.codigoModalidad || ', importe:' || p_cabeceraSolicitud.importe, 1, 200);

     v_codigocanal := depurarAlfanumerico(p_codigoCanal, 3);
     v_sesion      := depurarAlfanumerico(p_sesion, 32);

     userinfo := fu_validarsesion(v_sesion, v_codigoCanal);

     v_logMessage := 'fu_registrarSolicitud(p_sesion=' || p_sesion || ', p_codigoCanal  = ' || p_codigoCanal || ', codigoModalidad = ' || p_cabeceraSolicitud.codigoModalidad || ', importe ' || p_cabeceraSolicitud.importe || ', plazo ' || p_cabeceraSolicitud.plazo || ', sucursal ' || p_cabeceraSolicitud.sucursal || ', fechaSolicitud ' || p_cabeceraSolicitud.fechaSolicitud || ', estado ' || p_cabeceraSolicitud.estado || ')';
     pr_insertarBitacora(userInfo.codigoPersona, v_codigoCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

     IF userinfo.error = 'S' THEN
        v_retorno.error                := userinfo.error;
        v_retorno.nombrerespuesta      := userinfo.nombreRespuesta;
        v_retorno.descripcionrespuesta := userinfo.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     -- Verifica si el usuario tiene acceso a la opcion y en que condicion
     v_permiso := lf_obt_permisos(userinfo.codigoPersona, userinfo.codigoPerfil, v_cod_operacion, userinfo.codigoCanal);
     v_logMessage := 'fu_registrarSolicitud - lf_obt_permisos(p_cod_persona=' || userinfo.codigoPersona || ', p_cod_perfil  = ' || userinfo.codigoPerfil || ', p_cod_operacion = ' || v_cod_operacion || ', codigoCanal ' || userinfo.codigoCanal || ')';
     pr_insertarBitacora(userInfo.codigoPersona, v_codigoCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

     IF (v_permiso.error = 'S') THEN
        v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
        v_retorno.error                := v_permiso.error;
        RETURN v_retorno;
     END IF;

     IF (p_cabeceraSolicitud IS NOT NULL) THEN
        SELECT s_nro_sol_homebanking.nextval
          INTO v_nro_solicitud
          FROM dual;

        INSERT INTO bw_cab_solicitudes
           (nro_solicitud, cod_persona, cod_modalidad, importe, plazo, sucursal, fec_solicitud, estado)
        VALUES
           (v_nro_solicitud, nvl(userInfo.codigoEmpresa, userInfo.codigoPersona), p_cabeceraSolicitud.codigoModalidad, p_cabeceraSolicitud.importe, p_cabeceraSolicitud.plazo, p_cabeceraSolicitud.sucursal, p_cabeceraSolicitud.fechaSolicitud, v_estado);

         v_msj_bitacora := 'fu_registrarSolicitud - cantidad de Detalles recibidos:' || p_cabeceraSolicitud.cantidadDetalles;
         pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, userinfo.codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ENTRADA);

        IF (p_cabeceraSolicitud.cantidadDetalles IS NOT NULL and p_cabeceraSolicitud.cantidadDetalles <> 0) THEN
           FOR idx IN p_cabeceraSolicitud.listaDetalleSolicitud.FIRST .. p_cabeceraSolicitud.listaDetalleSolicitud.LAST LOOP
              BEGIN

                 v_detalleSolicitud := p_cabeceraSolicitud.listaDetalleSolicitud(idx);

                 if (v_detalleSolicitud.tipoDocumento = 'C') then --es cheque
                     if (v_detalleSolicitud.codigoBanco is null or v_detalleSolicitud.numeroCtaCorriente is null or v_detalleSolicitud.numeroDocumento is null) then
                         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                         v_logMessage := 'fu_registrarSolicitud - datos para cheque no ingresados';
                         pr_insertarBitacora(userInfo.codigoPersona, v_codigoCanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, v_logMessage, BITACORA_ERROR);
                     end if;
                 end if;

                 IF v_retorno.error = 'S' THEN
                    RETURN v_retorno;
                 END IF;
                 INSERT INTO bw_det_solicitudes
                    (nro_solicitud, tip_documento, fec_emision, fec_vencimiento, importe, cod_banco, nro_cta_corriente, nro_documento, cod_tip_doc_librador, nro_doc_librador, nom_librador, imagen)
                 VALUES
                    (v_nro_solicitud, v_detalleSolicitud.tipoDocumento, to_date(v_detalleSolicitud.fechaEmision,'yyyy-mm-dd'), to_date(v_detalleSolicitud.fechaVencimiento,'yyyy-mm-dd'), v_detalleSolicitud.importe, v_detalleSolicitud.codigoBanco, v_detalleSolicitud.numeroCtaCorriente, v_detalleSolicitud.numeroDocumento, v_detalleSolicitud.tipoDocumentoLibrador, v_detalleSolicitud.numeroDocumentoLibrador, v_detalleSolicitud.nombreLibrador, v_detalleSolicitud.imagen);
              END;
           END LOOP;
        END IF;
     END IF;

     v_retorno.numeroSolicitud := v_nro_solicitud;
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userinfo.codigoPersona,
                   userinfo.codigoCanal,
                   p_sesion,
                   v_cod_operacion,
                   userinfo.codigoEmpresa,
                   v_msj_bitacora || ' ' ||'fu_registrarSolicitud '||
                   fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                   BITACORA_SALIDA);
     RETURN v_retorno;
  EXCEPTION
     WHEN OTHERS THEN
        paw_bem.pr_mensajeUsuario(msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_codigocanal, v_sesion, v_cod_operacion, userInfo.codigoEmpresa, 'fu_registrarSolicitud-' || SQLERRM || '-' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), bitacora_error);
        RETURN v_retorno;
  END;*/

   /** Obtiene el detalle de la solicitud
   */
