      v_sesion   := depurarAlfanumerico(p_sesion,32);
      v_cod_canal :=  depurarAlfanumerico(p_codCanal,3);
      v_cla_actual := trim(p_claveActual);
      v_cla_nueva  := trim(p_claveNueva);


      --cambio sha256
      --v_cla_nueva:= lower(rawtohex(utl_raw.cast_to_raw(dbms_obfuscation_toolkit.md5(input_string => v_cla_nueva))));
      --v_cla_actual:=lower(rawtohex(utl_raw.cast_to_raw(dbms_obfuscation_toolkit.md5(input_string => v_cla_actual))));
      --



      --controlo que la clave nueva y la actual tengan una extension de 32
      IF length(v_cla_actual) <> 64 OR length(v_cla_actual) <> 64 THEN
         pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('0', v_cod_Canal, v_sesion, v_tip_mensaje, NULL, 'fu_cambiarClaveTransaccion-'||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), NULL);
         RETURN v_retorno;
      END IF;

      --control de que la clave actual sea distinta a la anterior
      IF (p_claveActual = p_claveNueva) THEN
         pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora('0', v_cod_Canal, v_sesion, v_tip_mensaje, NULL,  'fu_cambiarClaveTransaccion-'||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), NULL);
         RETURN v_retorno;
      END IF;

      --valida la sesion del usuario
      retValidarSesion := fu_validarSesion(v_sesion, p_codCanal);

      IF retValidarSesion.error = 'S' THEN
         pr_insertarBitacora(retValidarSesion.codigoPersona, retValidarSesion.codigoCanal, v_sesion, v_tip_mensaje, NULL,  'fu_cambiarClaveTransaccion-'||v_retorno.descripcionRespuesta || '-' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), NULL);
         v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
         v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
         v_retorno.error                := retValidarSesion.error;
         RETURN v_retorno;
      END IF;



    -- validamos la clave transaccional actual
      v_retorno := fu_val_ope_clave(v_cla_actual, retValidarSesion.codigoPersona, retValidarSesion.codigoEmpresa, 'T');

      IF v_retorno.error = 'S' THEN
         -- si es clave nueva debe cambiar
         IF v_retorno.nombreRespuesta = 'CLA_OPE_CAMBIAR' THEN
            v_retorno.error := 'N';
            v_retorno.nombreRespuesta := 'OP_APROBADA';
            v_retorno.descripcionRespuesta := '';
         ELSE
            pr_insertarBitacora('0', v_cod_Canal, v_sesion, v_tip_mensaje, NULL,  'fu_cambiarClaveTransaccion-'||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), NULL);
            RETURN v_retorno;
         END IF;
      END IF;
      -- no hubo errores hasta aqui
      -- actualizo la nueva clave
      v_clave := paw_bem.fu_gen_ope_clave(v_cla_nueva,
                                          retValidarSesion.codigoPersona,
                                          retValidarSesion.codigoEmpresa,
                                          'A', -- actualizar clave transaccional
                                          'T', -- tipo de clave
                                          v_aux);
      IF v_clave in ('-5', '-3') THEN
         pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL, v_retorno.descripcionRespuesta || '-fu_cambiarClaveTransaccion:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), NULL);
         RETURN v_retorno;
      ELSIF v_clave = '-6' THEN
         pr_mensajeUsuario(MSG_CLA_DUPLICA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL, v_retorno.descripcionRespuesta || '-fu_cambiarClaveTransaccion:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), NULL);
         RETURN v_retorno;
      ELSIF v_clave = '-8' THEN
         pr_mensajeUsuario(MSG_CLA_ANTERIOR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_tip_mensaje, NULL, v_retorno.descripcionRespuesta || '-fu_cambiarClaveTransaccion:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), NULL);
         RETURN v_retorno;
      END IF;
      pr_mensajeUsuario(MSG_OPE_APROBADA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, retValidarSesion.codigoCanal, p_sesion, v_tip_mensaje, NULL,  'fu_cambiarClaveTransaccion-'||v_retorno.descripcionRespuesta || '-' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), NULL);
     -- registro del movimiento
      paw_con.pr_reg_operacion(NULL \*p_nro_cuenta*\, NULL \*p_cod_moneda *\, NULL \*p_monto*\, NULL \*p_nro_cta_contra*\, NULL
                       \*p_cantidad*\, 'Clave Transaccional' \*p_etiqueta*\, NULL \*p_dato*\, NULL \*p_etiqueta2*\, NULL \*p_dato2*\, NULL
                       \*p_observacion*\, NULL \*p_dir_ip*\, NULL \*p_cod_respuesta*\, retValidarSesion.codigoPersona
                       \*p_cod_persona*\, v_tip_mensaje \*p_cod_operacion*\, retValidarSesion.codigoPersona \*p_nro_operacion*\, p_codCanal \*p_nro_terminal*\, p_sesion \*p_clave*\, retValidarSesion.codigoEmpresa \*p_cod_per_empresa*\);

      pr_insertarBitacora(retValidarSesion.codigoPersona, p_codCanal, p_sesion, v_cod_operacion, retValidarSesion.codigoEmpresa, '- fu_cambiarClaveAcceso:' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), BITACORA_SALIDA);
      RETURN v_retorno;
     EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(retValidarSesion.codigoPersona, retValidarSesion.codigoCanal, p_sesion, v_tip_mensaje, NULL,  'fu_cambiarClaveTransaccion-'||v_retorno.descripcionRespuesta || '-' || fu_generarBitacora(retValidarSesion.error,retValidarSesion.nombreRespuesta, retValidarSesion.descripcionRespuesta,null ), NULL);
         RETURN v_retorno;
   END fu_cambiarClaveTransaccion_ueno;
*/
  /* FUNCTION fu_obtenerDetalleCuentas_ueno(p_codigoPersona         IN VARCHAR2,
                                     p_codigoEmpresa IN VARCHAR2,
                                     p_codCanal            IN VARCHAR2,
                                     p_nroCuentaEspecifica IN VARCHAR2 DEFAULT NULL
                                     ) RETURN typ_obtenerDetalleCuentas IS

     c_men_cta_inexistente  constant varchar2(15) := '101';
     c_err_procesadora      constant varchar2(15) := '246';
     c_cod_operacion        varchar2(3) := '020';

     v_ver_todas            varchar2(1);
     v_nro_cta_especifica   varchar2(16);
     v_can_detalles         number(3); -- cantidad de cuentas
     v_monto1               number(18, 2) := 0; -- monto 1
     v_monto2               number(18, 2) := 0; -- monto 2
     v_monto3               number(18, 2) := 0; -- monto 3
     v_monto4               number(18, 2) := 0; -- monto 4
     v_monto5               number(18, 2) := 0; -- monto 5
     v_monto6               number(18, 2) := 0; -- monto 6
     v_val_tasa             number(10, 4) := null;
     v_fec_inicio           date;
     v_fec_vencimiento      date;
     v_fec_prox_vencimiento date;
     v_fec_apertura         date;

     v_dia_mora            number;
     v_che_devuelto        varchar2(01);
     v_can_cuotas          number(5);
     v_cta_formateada      varchar2(17);
     v_fec_prox_vcto       date := null;

     v_fec_actual          date := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy

     v_tip_cierre          ta_cta_tarjetas.tip_cierre%type;
     v_fec_anterior        date;
     v_sal_promedio        cc_sal_mensuales.sal_acu_deudor%type;

     v_plazo               ge_plz_contables.cod_plazo%type;
     v_sal_acumulado       cc_sal_mensuales.sal_acu_deudor%type;
     v_can_dia_acumulado   cc_sal_mensuales.can_dia_acumulado%type;
     v_tas_efectiva        varchar2(04) := null;
     v_dias                number(06);
     v_tip_capitalizacion  number(02);
     v_nro_solicitud        PR_SOLICITUDES.NRO_SOLICITUD%TYPE;

     userInfo               typ_validarSesion;
     v_listaCuentas         typ_listaDetalleCuenta := typ_listaDetalleCuenta();
     v_retorno              typ_obtenerDetalleCuentas := typ_obtenerDetalleCuentas;
     v_logmessage           varchar(1000);
     v_sesion               bw_aut_sesiones.cod_sesion%type;
     v_cod_canal            ge_canales.cod_canal%type;

     detalleCuenta          typ_detalleCuenta := typ_detalleCuenta;
     v_sal_cierre           ta_sal_cierres.sal_financiado%type;
     v_sal_actual           ta_sal_cierres.sal_financiado%type;
     v_mto_pag_minimo       ta_sal_cierres.sal_financiado%type;
     v_fec_cierre           date := null;
     v_fec_vto_pago         date := null;
     v_certificado          VARCHAR2(18) := null;
     v_for_pago             VARCHAR2(18) := null;
     v_cta_credito          ah_cta_certificados.nro_cta_credito%type;
     v_vto_original         date;

   -- cursor de cuentas del cliente
     CURSOR cuentas IS
        SELECT a.nro_cuenta, a.cod_modalidad cod_modalidad,  a.nro_cuenta cta_formateada, fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta, decode(b.relacion, 'C', 'Codeudor', 'G', 'Codeudor', fug_obt_des_modal(a.cod_modulo, a.cod_modalidad)) des_tip_cuenta, a.cod_moneda cod_moneda, a.denominacion nom_cuenta, a.cod_modulo, a.cod_oficina, a.tas_personalizada, b.relacion
          FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
         WHERE a.nro_cuenta = b.nro_cuenta
           AND ((b.relacion IN ('O', 'P', 'Y', 'A') AND b.cod_modulo != 6) OR (b.relacion IN ('O', 'C', 'G', 'P') AND b.cod_modulo = 6))
           AND b.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
           AND a.cod_modulo = c.cod_modulo
           AND a.cod_modulo NOT IN ('30') -- Evitamos que vaya CAJAS DE SEGURIDAD
           AND a.cod_modalidad = c.cod_modalidad
           AND a.estado = c.estado
           AND b.cod_modulo NOT IN (7, 8)
           AND c.activo = 'S' -- solo cuentas activas
           AND a.estado <> 'X' -- pendiente de verificacion
           AND (v_ver_todas = 'S' OR b.nro_cuenta = v_nro_cta_especifica) -- solo ve la cuenta recibida o todas
           AND NOT EXISTS (SELECT 0
                  FROM bw_cta_accesos p
                 WHERE p.nro_cuenta = a.nro_cuenta
                   AND p.cod_per_vinculo = userInfo.codigoPersona
                   AND p.tip_acceso = 'P'
                   AND p.activo = 'S')
         ORDER BY decode(b.cod_modalidad, 31, 1, decode(b.cod_modulo, 5, 2, decode(b.cod_modalidad, 33, 3, 34, 4, decode(b.cod_modulo, 4, 5, 6)))), to_number(a.nro_cuenta);

        CURSOR cuotas(p_nro_cuenta in varchar2) is
          SELECT nro_cuota, mto_cuota, fec_vencimiento, fec_ult_pago, dia_mora
            FROM (SELECT nro_cuota, nvl(sal_capital, 0) + nvl(sal_interes, 0) + nvl(sal_int_documentado, 0) mto_cuota,
                         fec_vencimiento, fec_ult_pago,
                         decode(sign(v_fec_actual - fec_vencimiento), 1, (v_fec_actual - fec_vencimiento), 0) dia_mora
                     FROM pr_cuotas a
                    WHERE nro_cuenta = p_nro_cuenta
                      AND nro_cuota > 0
                      AND estado <> 'N'
                      AND fec_vencimiento <= (SELECT nvl(MIN(fec_vencimiento), v_fec_actual)
                                                FROM pr_cuotas b
                                               WHERE b.nro_cuenta = p_nro_cuenta
                                                 AND nro_cuota > 0
                                                 AND estado <> 'N'
                                                 AND fec_vencimiento >= v_fec_actual)
                    ORDER BY nro_cuota)
           WHERE ROWNUM < 2;

     CURSOR c_vistas
     (
        p_nro_cuenta   IN VARCHAR2,
        p_fec_anterior IN DATE
     ) IS
        SELECT nvl(sal_acu_diario, 0) / decode(nvl(can_dia_acumulado, 0), 0, 1, can_dia_acumulado) promedio
          FROM ah_sal_mensuales
         WHERE ano = to_number(to_char(p_fec_anterior, 'YYYY'))
           AND mes = to_number(to_char(p_fec_anterior, 'MM'))
           AND nro_cuenta = p_nro_cuenta;

  BEGIN
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     v_retorno.cantidadCuentas := 0;
     -- 0. valido la clave del cliente
     v_sesion               := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
     v_cod_canal := depurarAlfanumerico(p_codCanal,32);
     --userInfo := fu_validarSesion(v_sesion, v_cod_canal);
     userInfo.error:='N';
     userInfo.codigoCanal:=v_cod_canal;
     userInfo.codigoPersona:=p_codigoPersona;
     userInfo.codigoEmpresa:=p_codigoEmpresa;
     v_nro_cta_especifica := depurarCuenta(p_nroCuentaEspecifica, CUENTA_TAMANO);
     --Logear parametros
     v_logMessage := substr('obtenerDetalleCuentas(nroCuentaEspecifica=' || v_nro_cta_especifica || ')', 0, 999);
     pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

     IF userInfo.error = 'S' THEN
        v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
        v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
        v_retorno.error                := 'S';
        RETURN v_retorno;
     END IF;

     IF (v_nro_cta_especifica IS NULL) THEN
        v_ver_todas := 'S';
     ELSE
        v_ver_todas := 'N';

        IF v_cod_canal = C_COD_HOMEBANKING THEN
            IF v_ind_cta_encriptada = 'S' THEN
               v_nro_cta_especifica := fu_desencriptacionCuentas(v_nro_cta_especifica);
            END IF;
        END IF;

     END IF;

     IF length(v_nro_cta_especifica) = 16 THEN
        -- es un tarjeta de credito, busco y reemplazo el dato
        BEGIN
           SELECT a.nro_cuenta
             INTO v_nro_cta_especifica
             FROM ge_cta_clientes a, ta_tarjetas b
            WHERE b.nro_tarjeta = TRIM(v_nro_cta_especifica)
              AND b.nro_cuenta = a.nro_cuenta
              AND a.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona);
        EXCEPTION
           WHEN no_data_found THEN
              SELECT b.nro_cuenta
                INTO v_nro_cta_especifica
                FROM ta_tarjetas b
               WHERE b.nro_tarjeta = TRIM(v_nro_cta_especifica)
                 AND vigente = 'S'
                 AND rownum = 1;
        END;

     END IF;
     -- 2. busco los datos de la cuentas
     IF v_retorno.error = 'N' THEN
        v_can_detalles := 0;
        FOR ct IN cuentas LOOP

           BEGIN
              --- Debe controlar para que no muestre cuentas juridicas entre las cuentas del cliente
              IF fu_es_juridica(ct.nro_cuenta, userInfo.codigoEmpresa, userInfo.codigoPersona) = 'N' THEN
                 v_can_detalles := v_can_detalles + 1;
                 IF ct.cod_modulo = 5 THEN
                    v_cta_formateada := lf_obt_nro_tarjeta(ct.nro_cuenta, userInfo.codigoPersona, userInfo.codigoEmpresa);
                 ELSE
                    v_cta_formateada := ct.cta_formateada;
                 END IF;
                 IF v_ind_cta_encriptada = 'S' THEN
                    detalleCuenta.numeroCuenta       := fu_encriptacionCuentas(substr(ct.cta_formateada, 0, 17));
                 ELSE
                    detalleCuenta.numeroCuenta       := substr(ct.cta_formateada, 0, 17);
                 END IF;
                 detalleCuenta.tipoCuenta            := substr(ct.cod_tip_cuenta, 0, 2);
                 detalleCuenta.descripcionTipoCuenta := substr(ct.des_tip_cuenta, 0, 35);
                 detalleCuenta.denominacion          := substr(ct.nom_cuenta, 0, 50);
                 detalleCuenta.codigoMoneda          := substr(ct.cod_moneda, 0, 3);

                 v_monto1          := 0; -- monto 1
                 v_monto2          := 0; -- monto 2
                 v_monto3          := 0; -- monto 3
                 v_monto4          := 0; -- monto 4
                 v_monto5          := 0; -- monto 5
                 v_monto6          := 0; -- monto 6
                 v_val_tasa        := NULL;
                 v_fec_inicio      := NULL;
                 v_fec_vencimiento := NULL;
                 v_dia_mora        := 0;
                 v_che_devuelto    := 'N';
                 v_can_cuotas      := 0;
                 v_mto_pag_minimo  := 0;
                 v_sal_cierre      := 0;
                 v_fec_cierre      := null;
                 v_fec_vto_pago    := null;

                 -- busco los demas datos de las cuentas
                 BEGIN
                    IF ct.cod_modulo = 6 THEN
                       -- prestamos
                       SELECT nvl(b.mto_capital, 0) + nvl(a.mto_interes, 0),
                              nvl(b.sal_capital, 0),
                              nvl(b.sal_int_adelantado, 0) + nvl(b.sal_interes, 0),
                              -- 02/02/2010 - ITC Se cambio por solicitud de Jorge Rodriguez
                              0,
                              b.val_tasa,
                              b.fec_inicio, b.fec_vencimiento, b.dia_atraso, 'N', b.nro_solicitud
                         INTO v_monto1,
                              v_monto2,
                              v_monto3,
                              v_monto4,
                              v_val_tasa,
                              v_fec_inicio, v_fec_vencimiento, v_dia_mora, v_che_devuelto,
                              v_nro_solicitud --, v_dias, v_tip_interes
                         FROM pr_cta_prestamos b, pr_cuotas a
                        WHERE b.nro_cuenta = ct.nro_cuenta
                          AND b.nro_cuenta = a.nro_cuenta(+)
                          AND a.nro_cuota(+) = 0;

                       v_can_cuotas := 0;
                       for cu in cuotas(ct.nro_cuenta) loop
                           v_can_cuotas := v_can_cuotas + 1;
                           v_monto4 := cu.nro_cuota;
                           v_monto3 := cu.mto_cuota;
                           v_fec_prox_vencimiento := cu.fec_vencimiento;
                           v_dia_mora := cu.dia_mora;
                       end loop;

                    ELSIF ct.cod_modulo = 5 THEN
                       -- tarjetas
                       -- datos del sistema al dia de ayer
                       SELECT nvl(lin_credito, 0) - (nvl(sal_facturar, 0) + nvl(sal_facturado, 0) + nvl(sal_financiado, 0) + nvl(sal_cuo_pendientes, 0)),
                              (nvl(sal_facturar, 0) + nvl(sal_facturado, 0) + nvl(sal_financiado, 0) + nvl(sal_cuo_pendientes, 0)),
                              decode(nvl(sal_pag_minimo, 0), 0, nvl(mto_mora, 0), nvl(sal_pag_minimo, 0)),
                              nvl(lin_credito, 0),
                              tas_financiacion,
                              fec_ult_cierre,
                              fec_vct_ult_cierre,
                              fec_apertura,
                              dia_mora,
                              'N',
                              lin_cuotas,
                              tip_cierre
                         INTO v_monto1,
                              v_monto2,  -- v_sal_actual
                              v_monto3,-- pago minimo
                              v_monto4,
                              v_val_tasa,
                              v_fec_inicio,
                              v_fec_vencimiento,
                              v_fec_apertura,
                              v_dia_mora,
                              v_che_devuelto,
                              v_monto5,
                              v_tip_cierre
                         FROM ta_cta_tarjetas
                        WHERE nro_cuenta = ct.nro_cuenta;

                        v_vto_original := v_fec_vencimiento;

                        begin
                          select nvl(mto_pag_minimo,0),
                                 nvl(sal_financiado,0) + nvl(sal_facturado,0) + nvl(sal_facturar,0),
                                 fec_cierre,
                                 fec_vto_pago
                            into v_mto_pag_minimo,
                                 v_sal_cierre,
                                 v_fec_cierre,
                                 v_fec_vto_pago
                            from ta_sal_cierres a
                           where nro_cuenta = ct.nro_cuenta
                             and fec_cierre =
                                 (select max(fec_cierre)
                                    from ta_sal_cierres
                                   where nro_cuenta = ct.nro_cuenta);
                        EXCEPTION
                          WHEN no_data_found THEN
                            v_mto_pag_minimo := 0;
                            v_sal_cierre := 0;
                            v_fec_cierre := null;
                        END;

                       --se coloca la fecha del sistema a la fecha de inicio ya que al ser nueva la tarjeta le carga
                       --en dicha columna 01/01/1901
                       v_fec_inicio := v_fec_actual;

                       IF v_ver_todas = 'A' THEN
                          -- datos actuales de la procesadora
                          pag_ban.pr_con_saldos(REPLACE(v_cta_formateada, ' ', ''));
                          IF pag_ban.fu_obt_cod_error() != '00' THEN
                             -- tiene error
                             pr_mensajeUsuario(c_err_procesadora, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                             pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_obtenerDetalleCuentas - Cuenta Inexistente -' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                          ELSE
                             -- reemplzo los daots de hoy
                             v_monto1          := pag_ban.fu_Dis_com_normal();
                             v_monto2          := pag_ban.fu_Deu_total();
                             v_monto3          := pag_ban.fu_Pago_min_pendiente();
                             v_monto4          := pag_ban.fu_Lin_credito();
                             v_fec_prox_vcto   := pag_ban.fu_Fec_pro_cierre();
                             v_fec_vencimiento := pag_ban.fu_Fec_ven_pag_minimo();
                          END IF;
                       ELSE
                          -- veo los datos de ayer
                          -- Busco la fecha del sgte vcto despues del ultimo cierre(v_fec_inicio = fec_ult_cierre)
                          -- Primero busco si existe un vcto cargado para esa modalidad
                          SELECT MIN(fec_cierre)
                            INTO v_fec_prox_vcto
                            FROM ta_cal_cierres v
                           WHERE cod_ent_procesadora = fug_obt_pardinamico('COD_PRO_BANCARD')
                             AND v.cod_modulo = ct.cod_modulo
                             AND v.cod_modalidad = ct.cod_modalidad
                             AND v.cod_tip_cierre = v_tip_cierre
                             AND fec_cierre > v_fec_inicio;

                          -- si ya pago se busca el siguiente cierre, o ya hay nuevo cierre
                          IF v_monto3 = 0 THEN
                             SELECT MIN(fec_cierre), MIN(fec_vencimiento)
                               INTO v_fec_prox_vcto, v_fec_vencimiento
                               FROM ta_cal_cierres v
                              WHERE cod_ent_procesadora = fug_obt_pardinamico('COD_PRO_BANCARD')
                                AND v.cod_modulo = ct.cod_modulo
                                AND v.cod_modalidad = ct.cod_modalidad
                                AND v.cod_tip_cierre = v_tip_cierre
                                AND fec_cierre > v_fec_inicio;
                          END IF;

                          -- Si no existe para esa modalidad busco el vcto general
                          IF v_fec_prox_vcto IS NULL THEN
                             SELECT MIN(fec_cierre), MIN(fec_vencimiento)
                               INTO v_fec_prox_vcto, v_fec_vencimiento
                               FROM ta_cal_cierres v
                              WHERE cod_ent_procesadora = fug_obt_pardinamico('COD_PRO_BANCARD')
                                AND v.cod_modulo = ct.cod_modulo
                                AND v.cod_modalidad IS NULL
                                AND v.cod_tip_cierre = v_tip_cierre
                                AND fec_cierre > v_fec_inicio;
                          END IF;
                          -- Si no existe (puede ser que no se cargo) despliego el ultimo cierre
                          IF v_fec_prox_vcto IS NULL THEN
                             v_fec_prox_vcto := v_fec_inicio;
                          END IF;

                          v_fec_inicio := v_fec_apertura;
                       END IF;

                    ELSIF ct.cod_modalidad = 31 THEN
                       -- ahorro vista
                       pag_cta.PR_OBT_CUENTA(ct.nro_cuenta);
                       --
                       v_monto1 := pag_cta.g_ctas.sal_actual;
                       v_monto2 := pag_cta.g_ctas.sal_disponible;
                       v_monto3 := pag_cta.g_ctas.sal_retenido;
                       v_monto4 := 0;
                       -- Para obtener la tasa nominal de Ahorros Vistas
                       v_fec_anterior := pag_cal.FU_OBT_FEC_ANT_HAB(v_fec_actual, ct.cod_oficina, 1);
                       FOR vista IN c_vistas(ct.nro_cuenta, v_fec_anterior) LOOP
                          v_sal_promedio := vista.promedio;
                       END LOOP;
                       v_val_tasa        := FUG_OBT_VAL_TASA(ct.cod_modulo, ct.cod_modalidad, ct.cod_oficina, ct.nro_cuenta, ct.cod_moneda, v_sal_promedio, ct.tas_personalizada, pag_cta.g_ctas.cod_tasa, NULL, v_fec_actual);
                       v_fec_inicio      := pag_cta.g_ctas.fec_apertura;
                       v_fec_vencimiento := pag_cta.g_ctas.fec_vencimiento;
                       v_dia_mora        := 0;
                       v_che_devuelto    := 'N';
                    ELSIF ct.cod_modalidad IN (33, 34, 35) THEN
                       -- cda
                       SELECT capital, nvl(int_pendiente, 0) int_pendiente, nvl(sal_retenido, 0), nvl(int_pagados, 0) int_pagados, fug_obt_val_tasa(cod_modulo, cod_modalidad, cod_oficina, nro_cuenta, cod_moneda, capital, tas_personalizada, cod_tasa, NULL, v_fec_actual) val_tasa, fec_apertura, fec_vencimiento, 0, 'N', tip_capitalizacion,
                           can_fir_registradas,serie||+' '|| nro_certificado, nro_cta_credito,
                           (CASE
                               WHEN nvl(cre_automatico,'N')='S' THEN
                                'CREDITO EN CUENTA'
                               WHEN nvl(cre_automatico,'N')='N' THEN
                                'CUPONES'
                            END)
                         INTO v_monto1, v_monto2, v_monto3, v_monto4, v_val_tasa, v_fec_inicio, v_fec_vencimiento, v_dia_mora, v_che_devuelto, v_tip_capitalizacion,
                           v_monto5,  v_certificado, v_cta_credito, v_for_pago
                         FROM ah_cta_certificados i,
                              (SELECT nro_cuenta cuenta, SUM(mto_interes) int_pendiente
                                  FROM ah_cupones
                                 WHERE estado IN ('V', 'E')
                                 GROUP BY nro_cuenta) b,
                              -- Intereses Pagados
                              (SELECT nro_cuenta cuenta, SUM(mto_interes) int_pagados
                                  FROM ah_cupones
                                 WHERE estado = 'P'
                                 GROUP BY nro_cuenta) c
                        WHERE nro_cuenta = ct.nro_cuenta
                          AND b.cuenta(+) = nro_cuenta
                          AND c.cuenta(+) = nro_cuenta;

                    ELSIF ct.cod_modalidad = 41 THEN
                       -- cuenta corriente
                       BEGIN
                          SELECT can_dias
                            INTO v_dia_mora
                            FROM cc_sobregiros_res
                           WHERE nro_cuenta = ct.nro_cuenta;
                       EXCEPTION
                          WHEN OTHERS THEN
                             v_dia_mora := 0;
                       END;
                       pag_cta.PR_OBT_CUENTA(ct.nro_cuenta);
                       --
                       v_monto1          := pag_cta.g_ctas.sal_actual;
                       v_monto2          := pag_cta.g_ctas.sal_disponible;
                       v_monto3          := pag_cta.g_ctas.sal_retenido;
                       v_monto4          := pag_cta.FU_OBT_LIN_SOBREGIRO(ct.nro_cuenta, v_fec_actual);
                       v_val_tasa        := pag_cta.g_ctas.val_tasa;
                       v_fec_inicio      := pag_cta.g_ctas.fec_apertura;
                       v_fec_vencimiento := pag_cta.g_ctas.fec_vencimiento;
                       v_che_devuelto    := 'N';
                    END IF;
                 EXCEPTION
                    WHEN OTHERS THEN
                       pr_mensajeUsuario(c_men_cta_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                       pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_obtenerDetalleCuentas- Cta Inexistente -' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
                 END;

                 -- Calcula la Tasa Efectiva de las cuentas ---
                 IF ct.cod_modalidad = 41 THEN
                    -- Cuenta Corriente
                    --obtiene saldo promedio
                    pag_cta.pr_obt_sal_promedio(ct.cod_modulo, ct.cod_modalidad, ct.cod_oficina, ct.nro_cuenta, v_fec_actual, v_fec_actual, v_sal_acumulado, v_sal_promedio, v_can_dia_acumulado);
                    --busca x la transaccion de sobregiro
                    v_val_tasa     := fug_obt_val_tasa(ct.cod_modulo, ct.cod_modalidad, ct.cod_oficina, ct.nro_cuenta, ct.cod_moneda, v_sal_promedio, ct.tas_personalizada, NULL, 550, v_fec_actual);
                    v_tas_efectiva := lpad(pas_bcp.FU_OBT_TAE(v_val_tasa, 30) * 100,4,'0') ;

                 ELSIF ct.cod_modulo = 3 THEN
                    -- Ahorros
                    v_dias := nvl(v_fec_vencimiento, v_fec_inicio + 1) - v_fec_inicio;
                    IF (ct.cod_modulo = 3 AND ct.cod_modalidad = 31) OR ct.cod_modulo = 5 THEN
                       v_plazo := 1;
                    ELSE
                       v_plazo := FUG_OBT_PLZ_CONTABLE(v_dias);
                    END IF;

                    v_tas_efectiva := lpad(v_val_tasa * 100, 4,'0');
                    --
                 ELSIF ct.cod_modulo = 6 THEN
                    -- Prestamos
                    IF fup_obt_tip_descuento(ct.cod_modalidad) IN ('D', 'C', 'F') THEN
                       SELECT AVG(fec_vto_habil - v_fec_inicio)
                         INTO v_dias
                         FROM pr_sol_cuotas
                        WHERE nro_solicitud = v_nro_solicitud;
                    END IF;
                    --
                    IF v_dias > 0 THEN
                       v_tas_efectiva := lpad(pas_bcp.fu_obt_tae(v_val_tasa, v_dias) * 100, 4,'0');
                    ELSE
                       v_tas_efectiva := lpad(0, 4,'0');
                    END IF;
                    --
                 ELSE
                    v_tas_efectiva := lpad(0, 4,'0');
                 END IF;

                 IF v_retorno.error = 'N' THEN
                    v_che_devuelto := lf_obt_che_devuelto(ct.nro_cuenta);
                    -- esta bien el dato se carga el detalle
                    detalleCuenta.monto1           := v_monto1;
                    detalleCuenta.monto2           := v_monto2;   --TJ saldo actual
                    detalleCuenta.monto3           := v_monto3;    --TJ monto pago minimo
                    detalleCuenta.monto4           := v_monto4;
                    detalleCuenta.tasa             := v_val_tasa;
                    detalleCuenta.fechaInicio      := lf_for_date(v_fec_inicio);
                    detalleCuenta.fechaVencimiento := lf_for_date(v_fec_vencimiento); --TJ fec ult vcto si no pago minimo, fec prox vcto si pago minimo
                    detalleCuenta.diasMora         := v_dia_mora;
                    detalleCuenta.fechaProximoVencimiento := lf_for_date(v_fec_prox_vencimiento);

                    detalleCuenta.chequeDevuelto   := substr(v_che_devuelto, 0, 1);
                    detalleCuenta.saldoCierre      := v_sal_cierre;   --TJ saldo al cierre
                    detalleCuenta.pagoMinimo       := v_monto3;
                    detalleCuenta.fechaCierre      := lf_for_date(v_fec_prox_vcto);  --TJ fec ult cierre si no pago minimo, fec prox cierre si pago minimo
                    IF ct.cod_modalidad IN (33) THEN
                       detalleCuenta.monto4           := v_monto5;
                       detalleCuenta.pagoMinimo       := v_for_pago;
                       detalleCuenta.datoAdicional    := nvl(v_cta_credito,'-');
                    END IF;
                    IF ct.cod_modulo = 5 THEN
                       --se coloca la fecha de vcto actual por mas de que haya pagado el mes actual
                       if nvl(fug_obt_pardinamico('BWE_TAR_VTO_ORIGINAL'),'N')='S' then
                          detalleCuenta.fechaVencimiento := lf_for_date(v_vto_original);
                       end if;

                       detalleCuenta.fechaProximoVencimiento := lf_for_date(nvl(v_fec_vto_pago,v_fec_vencimiento));

                       detalleCuenta.saldoPagoMinimo := v_monto3;
                       detalleCuenta.pagoMinimo      := v_mto_pag_minimo;
                       -- detalleCuenta.pagoMinimo      := v_monto3;
                       detalleCuenta.datoAdicional   := nvl(FUT_OBT_NRO_TARJETA(ct.nro_cuenta),' ');
                    END IF;

                    v_listaCuentas.extend;
                    v_listaCuentas(v_listaCuentas.count) := detalleCuenta;
                 END IF;
              END IF;
              IF v_can_detalles >= 999 THEN
                 EXIT;
              END IF;
           END;
        END LOOP;

        IF v_can_detalles = 0 THEN
           pr_mensajeUsuario(c_men_cta_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_obtenerDetalleCuentas - Cuenta Inexistente -' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_ERROR);
        END IF;
     END IF;

     -- registro del movimiento
     paw_con.pr_reg_operacion(v_nro_cta_especifica \*p_nro_cuenta*\, NULL \*p_cod_moneda *\, NULL \*p_monto*\, NULL \*p_nro_cta_contra*\, NULL \*p_cantidad*\, 'Ver Todas' \*p_etiqueta*\, v_ver_todas, \*p_dato*\ NULL, NULL, 'Det.de Cuentas', NULL, NULL, userInfo.codigoPersona, c_cod_operacion, userinfo.codigoPersona || v_cod_canal, v_cod_canal, v_sesion, userInfo.codigoEmpresa);
     pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_obtenerDetalleCuentas-' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL), BITACORA_SALIDA);

     IF v_retorno.error = 'N' THEN
        v_retorno.listaCuentas := v_listaCuentas;
        v_retorno.cantidadCuentas  := v_can_detalles;
        RETURN v_retorno;
     ELSE
        RETURN v_retorno;
     END IF;

  \*EXCEPTION
     WHEN OTHERS THEN
        pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(NULL, v_cod_canal, NULL, c_cod_operacion, NULL, 'fu_obtenerDetalleCuentas -' || SQLERRM, BITACORA_ERROR);
        RETURN v_retorno;*\
  END;*/
  /* Funcion que devuelve si una persona es cliente Verificado */
  FUNCTION lf_ver_cliente(p_cod_persona IN VARCHAR2) RETURN BOOLEAN IS
     v_cantidad NUMBER := 0;
  BEGIN
     BEGIN
        SELECT 1
          INTO v_cantidad
          FROM ba_personas
         WHERE cod_persona = p_cod_persona
           AND est_verificacion = 'N'
           AND ROWNUM = 1;
     EXCEPTION
        WHEN NO_DATA_FOUND THEN
           v_cantidad := 0;
        WHEN OTHERS THEN
           v_cantidad := 0;
     END;
     IF v_cantidad > 0 THEN
        RETURN TRUE;
     ELSE
        RETURN FALSE;
     END IF;
  END;

/*FUNCTION fu_obtenerResumenCuentas_ueno(   p_codigoPersona         IN VARCHAR2,
                                    p_codigoEmpresa IN VARCHAR2,
                                    p_codCanal     IN VARCHAR2,
                                    p_tipoConsulta IN VARCHAR2 DEFAULT NULL,
                                    p_verCuentas   IN VARCHAR2 DEFAULT NULL,
                                    p_codigoMoneda IN VARCHAR2 DEFAULT NULL)
    RETURN typ_resumenCuentas IS

    c_men_cod_sinautorizacion constant varchar2(15) := '108';
    c_men_cta_duplicada       constant varchar2(15) := '102';
    c_men_cta_inexistente     constant varchar2(15) := '101';
    c_cod_operacion           constant varchar2(3) := '011';
    c_sin_cta_debito          constant varchar2(3) := '254';
    c_no_cta_cte              constant varchar2(3) := '255';
    c_mon_distintas           constant varchar2(3) := '257';
    c_per_nueva               constant varchar2(3) := '323';

    -- datos recibidos
    v_ver_cuentas     varchar2(1) := 'T';
    v_tip_consulta    varchar2(3);
    v_cod_perfil      varchar2(20);
    v_can_detalles    number(3);
    v_cod_moneda      varchar(3);
    v_cod_persona     varchar2(15);
    v_sesion          bw_aut_sesiones.cod_sesion%type;
    v_cod_canal       ge_canales.cod_canal%type;
    v_despliega      varchar2(1); -- indica si la cuenta debe o no desplegarse
    v_cta_formateada varchar2(17); -- para guardar la cuenta formateada
    v_sal_actual     number(20, 2) := null; -- Para el Saldo Actual

    userInfo       typ_validarSesion;
    v_listaCuentas typ_listaResumenCuenta := typ_listaResumenCuenta();
    v_retorno      typ_resumenCuentas := typ_resumenCuentas;
    v_logMessage   VARCHAR2(1000);
    -- cursor de cuentas del cliente
    CURSOR cuentas IS
      SELECT a.nro_cuenta,
             a.cod_modalidad cod_modalidad,
             a.nro_cuenta cta_formateada,
             fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta,
             fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) des_tip_cuenta,
             a.cod_moneda cod_moneda,
             a.denominacion nom_cuenta,
             fu_obt_sal_actual(a.cod_modulo, a.cod_modalidad, a.nro_cuenta) sal_actual,
             a.cod_modulo,
             a.estado,
             b.relacion
        FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b--, ta_tarjetas t
       WHERE a.nro_cuenta = b.nro_cuenta
         and b.relacion in ('O', 'P', 'Y', 'A')
         and b.cod_persona =
             nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
         and a.cod_modulo = c.cod_modulo
         and a.cod_modalidad = c.cod_modalidad
         and a.estado = c.estado

\*         and a.nro_cuenta = t.nro_cuenta(+)
         and (b.cod_modulo != 5 or (b.cod_modulo = 5 and t.vigente = 'S'))*\

         and b.cod_modulo not in (7, 8, 30)
         and not (b.cod_modulo = 3 and b.cod_modalidad in (34))--(33, 34))
         and c.activo = 'S' -- solo cuentas activas
         and a.estado <> 'X' -- pendiente de verificacion
         and (v_cod_moneda is null or a.cod_moneda = v_cod_moneda)
         and not exists (select 0
                from bw_cta_accesos p
               where p.nro_cuenta = a.nro_cuenta
                 and p.cod_per_vinculo = v_cod_persona
                 and p.tip_acceso = 'P'
                 and p.activo = 'S')
       ORDER BY decode(b.cod_modalidad,
                       31,
                       1,
                       decode(b.cod_modulo,
                              5,
                              2,
                              decode(b.cod_modalidad,
                                     33,
                                     3,
                                     34,
                                     4,
                                     decode(b.cod_modulo, 4, 5, 6))));

    CURSOR entes IS
      SELECT a.cod_ente,
             fug_obt_parentes(a.cod_ente, 'NRO_CTA_DEBITO') Cta_debito
        FROM ge_entes a
       WHERE a.cod_persona =
             nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
         AND a.tipo = 'SU'
         AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO') = 'S'
         AND fug_obt_parentes(a.cod_ente, 'BWE_PAG_SUELDO') = 'S';

    CURSOR ctas_entes(p_cod_ente NUMBER, p_moneda VARCHAR2) IS
    -- Se utiliza para validar pago de Sueldos
      SELECT DISTINCT a.cod_ente,
                      g.cod_moneda,
                      g.nro_cuenta,
                      decode(g.cod_modalidad, 31, 'AH', 'CC') Tipo_cta,
                      g.denominacion
        FROM ge_entes a, ge_cta_clientes c, ge_cuentas g
       WHERE a.cod_persona =
             nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
         AND a.tipo = 'SU'
         AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO') = 'S'
         AND fug_obt_parentes(a.cod_ente, 'BWE_PAG_SUELDO') = 'S'
         AND a.cod_ente = p_cod_ente
         AND a.cod_persona = c.cod_persona
         AND c.relacion = 'P'
         AND c.nro_cuenta = g.nro_cuenta
         AND g.cod_modalidad IN (31, 41)
         AND g.estado IN ('N', 'S')
         AND g.cod_moneda = p_moneda
       ORDER BY g.cod_moneda, Tipo_cta, g.nro_cuenta;

    CURSOR provee IS
    -- Se utiliza para validar pago a proveedores
      select a.cod_ente,
             a.descripcion,
             g.val_parametro,
             fug_obt_parentes(a.cod_ente, 'REF_TXT_PPROV') formato
        from ge_entes a, ge_par_entes g
       where a.cod_persona =
             nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
         and a.tipo = 'PR'
         and a.cod_ente = g.cod_ente
         and g.parametro = 'CTA_DEB_PPROV'
         and fug_obt_parentes(a.cod_ente, 'SER_ACTIVO_PRV') = 'S'
         and fug_obt_parentes(a.cod_ente, 'BWE_PAG_PROVEEDOR') = 'S';

  BEGIN

    --v_filtro    := depurarAlfanumerico(p_filtro,9);
    v_sesion               := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
    v_cod_canal    := depurarAlfanumerico(p_codCanal, 3);
    v_tip_consulta := depurarAlfanumerico(p_tipoConsulta, 3);
    v_ver_cuentas  := depurarAlfanumerico(p_verCuentas, 1);
    v_cod_moneda   := depurarAlfanumerico(p_codigoMoneda, 3);

    pr_mensajeUsuario(MSG_OK,
                      v_retorno.nombreRespuesta,
                      v_retorno.descripcionRespuesta,
                      v_retorno.error);
    v_retorno.cantidadCuentas := 0;

    if v_tip_consulta is null then
      v_tip_consulta := '020';
    end if;
    if v_ver_cuentas is null then
      v_ver_cuentas := 'T';
    end if;

   -- userInfo := fu_validarSesion(v_sesion, v_cod_canal);
      userInfo.error:='N';
      userInfo.codigoCanal:=v_cod_canal;
      userInfo.codigoPersona:=p_codigoPersona;
      userInfo.codigoEmpresa:=p_codigoEmpresa;

    --Logear parametros
    v_logMessage := 'obtenerResumenCuentas(p_tipoConsulta=' ||
                    v_tip_consulta || ', p_verCuentas  = ' || v_ver_cuentas ||
                    ', p_codigoMoneda = ' || v_cod_moneda || ', p_sesion ' ||
                    v_sesion || ', p_codCanal ' || v_cod_canal || ')';
    pr_insertarBitacora(userInfo.codigoPersona,
                        v_cod_canal,
                        v_sesion,
                        c_cod_operacion,
                        userInfo.codigoEmpresa,
                        v_logMessage,
                        BITACORA_ENTRADA);

    IF userInfo.error = 'S' THEN
      v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
      v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
      v_retorno.error                := 'S';
      RETURN v_retorno;
    END IF;

    v_cod_perfil      := userInfo.codigoPerfil;
    v_cod_persona     := userInfo.codigoPersona;

    -- Verifico si el cliente con su perfil tendra acceso a realizar la transaccion
    IF v_retorno.error = 'N' THEN
      DECLARE
        v_permiso typ_obtenerPermisos;
      BEGIN
        v_permiso := lf_obt_permisos(nvl(userInfo.codigoEmpresa,
                                         userInfo.codigoPersona),
                                     v_cod_perfil,
                                     v_tip_consulta,
                                     v_cod_canal);

        IF (v_permiso.error = 'S') THEN
          v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
          v_retorno.error                := v_permiso.error;
          RETURN v_retorno;
        END IF;
        IF not v_permiso.registra and v_ver_cuentas = 'D' THEN
          pr_mensajeUsuario(c_men_cod_sinautorizacion,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);
          pr_insertarBitacora(userInfo.codigoPersona,
                              v_cod_canal,
                              v_sesion,
                              c_cod_operacion,
                              userInfo.codigoEmpresa,
                              'obtenerResumenCuentas - Sin auth ' ||
                              fu_generarBitacora(v_retorno.error,
                                                 v_retorno.nombreRespuesta,
                                                 v_retorno.descripcionRespuesta,
                                                 null),
                              BITACORA_ERROR);
          RETURN V_RETORNO;

        END IF;
      END;
    END IF;
\*    IF not(lf_ver_cliente(nvl(userinfo.codigoEmpresa, userinfo.codigoPersona))) then
        pr_mensajeUsuario(c_per_nueva,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
        pr_insertarBitacora(userInfo.codigoPersona,v_cod_canal,v_sesion,c_cod_operacion,userInfo.codigoEmpresa,
        'ObtenerResumenCuentas - Sin Productos ' ||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),BITACORA_ERROR);
        RETURN V_RETORNO;
    END IF;
*\

    -- 2. busco los datos de la cuentas
    IF v_retorno.error = 'N' THEN
      v_can_detalles := 0;
      FOR ct IN cuentas LOOP
        v_despliega := 'N';
        IF v_ver_cuentas = 'T' THEN
          -- quiere ver todas las cuentas
          IF v_tip_consulta = '060' AND ct.cod_modalidad = 41 THEN
            -- consulta de chequeras
            v_despliega := 'S'; -- cuentas corrientes por chequeras
          ELSIF (v_tip_consulta IN ('021', '040', '041') AND
                (ct.cod_modalidad IN (31, 41) OR
                (ct.cod_modulo = 5 and
                (v_cod_canal = C_COD_HOMEBANKING or v_cod_canal = '998')))) THEN
            v_despliega := 'S'; -- cuentas ahorro o ctacte y es consulta de mov, cheq, dev o depositos pendientes
          ELSIF (v_tip_consulta = '093' and ct.cod_modalidad in (31, 41)) and
                v_cod_canal = C_COD_HOMEBANKING then
            v_despliega := 'S'; -- cuentas ahorro o ctacte
          ELSIF (v_tip_consulta IN ('020')) THEN
            -- consulta de saldos general
            v_despliega := 'S';
          ELSIF (v_tip_consulta IN ('070')) THEN
            -- Pago de Sueldos.
            DECLARE
              v_accountInfo typ_resumenCuenta := typ_resumenCuenta;
              v_moneda      VARCHAR(3);
            BEGIN
              SELECT COUNT(*)
                INTO v_can_detalles
                FROM ge_entes a
               WHERE a.cod_persona =
                     nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
                 AND a.tipo = 'SU'
                 AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO') = 'S'
                 AND fug_obt_parentes(a.cod_ente, 'BWE_PAG_SUELDO') = 'S';
              v_despliega := 'N';
              -- Si existe verifico cuantas cuentas posee.
              IF v_can_detalles > 0 THEN
                v_can_detalles := 0;
                FOR et IN entes LOOP
                  v_moneda := fug_obt_mon_cta(et.cta_debito);

                  FOR ce IN ctas_entes(et.cod_ente, v_moneda) LOOP
                    v_can_detalles             := v_can_detalles + 1;
                    v_accountInfo.codigoCuenta := substr(ce.cod_ente, 0, 5);
                    v_accountInfo.codigoMoneda := substr(ce.cod_moneda,
                                                         0,
                                                         3);
                    IF v_ind_cta_encriptada = 'S' THEN
                       v_accountInfo.numeroCuenta := fu_encriptacionCuentas(substr(ce.nro_cuenta,
                                                          0,
                                                          15));
                    ELSE
                       v_accountInfo.numeroCuenta := substr(ce.nro_cuenta,
                                                          0,
                                                          15);
                    END IF;


                    v_accountInfo.tipoCuenta   := substr(ce.tipo_cta, 0, 2);
                    v_accountInfo.denominacion := substr(ce.denominacion,
                                                         0,
                                                         70);
                    v_listaCuentas.extend;
                    v_listaCuentas(v_listaCuentas.count) := v_accountInfo;
                  END LOOP;
                END LOOP;
              ELSE
                pr_mensajeUsuario(c_men_cod_sinautorizacion,
                                  v_retorno.nombreRespuesta,
                                  v_retorno.descripcionRespuesta,
                                  v_retorno.error);
                pr_insertarBitacora(userInfo.codigoPersona,
                                    v_cod_canal,
                                    v_sesion,
                                    c_cod_operacion,
                                    userInfo.codigoEmpresa,
                                    'obtenerResumenCuentas - Sin auth ' ||
                                    fu_generarBitacora(v_retorno.error,
                                                       v_retorno.nombreRespuesta,
                                                       v_retorno.descripcionRespuesta,
                                                       null),
                                    BITACORA_ERROR);
              END IF;
            EXCEPTION
              WHEN too_many_rows THEN
                pr_mensajeUsuario(c_men_cta_duplicada,
                                  v_retorno.nombreRespuesta,
                                  v_retorno.descripcionRespuesta,
                                  v_retorno.error);
                pr_insertarBitacora(userInfo.codigoPersona,
                                    v_cod_canal,
                                    v_sesion,
                                    c_cod_operacion,
                                    userInfo.codigoEmpresa,
                                    'obtenerResumenCuentas - Cta. Duplicada' ||
                                    fu_generarBitacora(v_retorno.error,
                                                       v_retorno.nombreRespuesta,
                                                       v_retorno.descripcionRespuesta,
                                                       null),
                                    BITACORA_ERROR);
              WHEN OTHERS THEN
                pr_mensajeUsuario(c_men_cod_sinautorizacion,
                                  v_retorno.nombreRespuesta,
                                  v_retorno.descripcionRespuesta,
                                  v_retorno.error);
                pr_insertarBitacora(userInfo.codigoPersona,
                                    v_cod_canal,
                                    v_sesion,
                                    c_cod_operacion,
                                    userInfo.codigoEmpresa,
                                    'obtenerResumenCuentas - sin Auth ' ||
                                    fu_generarBitacora(v_retorno.error,
                                                       v_retorno.nombreRespuesta,
                                                       v_retorno.descripcionRespuesta,
                                                       null),
                                    BITACORA_ERROR);
            END;
          ELSIF (v_tip_consulta IN ('075')) THEN
            -- Pago a Proveedores
            BEGIN
              SELECT COUNT(*)
                INTO v_can_detalles
                FROM ge_entes a
               WHERE a.cod_persona =
                     nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
                 AND a.tipo = 'PR'
                 AND fug_obt_parentes(a.cod_ente, 'SER_ACTIVO_PRV') = 'S'
                 AND fug_obt_parentes(a.cod_ente, 'BWE_PAG_PROVEEDOR') = 'S';

              v_despliega := 'N';
              -- Si existe verifico cuantas cuentas posee.
              IF v_can_detalles > 0 THEN
                DECLARE
                  v_accountInfo typ_resumenCuenta := typ_resumenCuenta;
                BEGIN
                  FOR re IN provee LOOP
                    v_accountInfo.codigoCuenta := substr(re.cod_ente, 0, 5);
                    v_accountInfo.denominacion := substr(re.descripcion,
                                                         0,
                                                         60);
                    v_listaCuentas.extend;
                    v_listaCuentas(v_listaCuentas.count) := v_accountInfo;
                  END LOOP;
                END;
              ELSE
                pr_mensajeUsuario(c_men_cod_sinautorizacion,
                                  v_retorno.nombreRespuesta,
                                  v_retorno.descripcionRespuesta,
                                  v_retorno.error);
                pr_insertarBitacora(userInfo.codigoPersona,
                                    v_cod_canal,
                                    v_sesion,
                                    c_cod_operacion,
                                    userInfo.codigoEmpresa,
                                    'obtenerResumenCuentas - Sin auth ' ||
                                    fu_generarBitacora(v_retorno.error,
                                                       v_retorno.nombreRespuesta,
                                                       v_retorno.descripcionRespuesta,
                                                       null),
                                    BITACORA_ERROR);
              END IF;
            EXCEPTION
              WHEN too_many_rows THEN
                pr_mensajeUsuario(c_men_cta_duplicada,
                                  v_retorno.nombreRespuesta,
                                  v_retorno.descripcionRespuesta,
                                  v_retorno.error);
                pr_insertarBitacora(userInfo.codigoPersona,
                                    v_cod_canal,
                                    v_sesion,
                                    c_cod_operacion,
                                    userInfo.codigoEmpresa,
                                    'obtenerResumenCuentas - Cta.Duplicada' ||
                                    fu_generarBitacora(v_retorno.error,
                                                       v_retorno.nombreRespuesta,
                                                       v_retorno.descripcionRespuesta,
                                                       null),
                                    BITACORA_ERROR);
              WHEN OTHERS THEN
                pr_mensajeUsuario(c_men_cod_sinautorizacion,
                                  v_retorno.nombreRespuesta,
                                  v_retorno.descripcionRespuesta,
                                  v_retorno.error);
                pr_insertarBitacora(userInfo.codigoPersona,
                                    v_cod_canal,
                                    v_sesion,
                                    c_cod_operacion,
                                    userInfo.codigoEmpresa,
                                    'obtenerResumenCuentas - sin auth ' ||
                                    fu_generarBitacora(v_retorno.error,
                                                       v_retorno.nombreRespuesta,
                                                       v_retorno.descripcionRespuesta,
                                                       null),
                                    BITACORA_ERROR);
            END;
          ELSIF v_tip_consulta IN ('031') and ct.cod_modulo = 6 THEN
            v_despliega := 'S';
          END IF;
        ELSIF (v_ver_cuentas IN ('D', 'C') AND ct.cod_modalidad IN (31, 41)) THEN
          if ct.cod_modalidad = 31 and
             pag_cta.fu_obt_cta_cte_comb(ct.nro_cuenta) is not null then
            v_despliega := 'N';
          elsif ct.estado = 'P' then
            -- cerrada
            v_despliega := 'N';
          else
            if v_ver_cuentas = 'D' then
              -- veo si la cuenta no es conjunta
              if fu_es_conjunta(ct.nro_cuenta,
                                userInfo.codigoPersona,
                                userInfo.codigoEmpresa) = 'S' or
                 ct.estado in ('X', 'T', 'D', 'C') or
                 (ct.estado = 'A' and ct.cod_modalidad not in (31, 41)) then
                -- Las ctas. de AH y CC en Estado Abiertas pueden operar.
                v_despliega := 'N';
              else
                v_despliega := 'S';
              end if;
            else
              v_despliega := 'S';
            end if;
          end if;
        ELSIF v_tip_consulta in ('031', '032', '213') and
              v_ver_cuentas not in ('D') then
          if v_tip_consulta in ('032', '213') then
            -- pago de tarjetas
            if ct.cod_modulo = 5 then
              if lf_ver_adicional(ct.cod_modulo,
                                  ct.relacion,
                                  ct.nro_cuenta,
                                  nvl(userInfo.codigoEmpresa,
                                      userInfo.codigoPersona)) in
                 ('S', 'T') then
                v_despliega := 'S';
              else
                v_despliega := 'N';
              end if;
            end if;
          elsif v_tip_consulta = '031' then
            -- pago de prestamos
            if ct.cod_modulo = 6 then
              v_despliega := 'S';
            end if;
          end if;
        END IF;
        --- Debe controlar para que no muestre cuentas juridicas entre las cuentas del cliente
        IF fu_es_juridica(ct.nro_cuenta,
                          userInfo.codigoEmpresa,
                          userInfo.codigoPersona) = 'S' AND
           v_despliega = 'S' THEN
          v_despliega := 'N';
        END IF;

        IF v_cod_moneda IS NOT NULL AND
           trim(v_cod_moneda) <> trim(ct.cod_moneda) THEN
          v_despliega := 'N';
        END IF;

        IF v_despliega = 'S' THEN
          -- solo si se muestra
          DECLARE
            v_accountInfo typ_resumenCuenta := typ_resumenCuenta;
          BEGIN

            IF ct.cod_modulo = 5 THEN
              v_cta_formateada := ct.nro_cuenta;
            ELSE
              v_cta_formateada := ct.nro_cuenta; --ct.cta_formateada;
            END IF;

            -- 08/02/2010 - ITC - Cambio el saldo de CDA por Capital.
            IF ct.cod_modalidad = 32 then
              Begin
                SELECT nvl(CAPITAL, 0)
                  INTO v_sal_actual
                  FROM AH_CTA_PLAZOS
                 WHERE NRO_CUENTA = ct.nro_cuenta;
              EXCEPTION
                WHEN OTHERS THEN
                  pr_mensajeUsuario(c_men_cta_inexistente,
                                    v_retorno.nombreRespuesta,
                                    v_retorno.descripcionRespuesta,
                                    v_retorno.error);
                  pr_insertarBitacora(NULL,
                                      v_cod_canal,
                                      NULL,
                                      c_cod_operacion,
                                      NULL,
                                      'obtResumenCuenta (cod_modalidad = 32) - ' ||
                                      SQLERRM,
                                      BITACORA_ERROR);
                  RETURN v_retorno;
              END;
            ELSIF ct.cod_modalidad in (33, 34) Then
              Begin
                SELECT nvl(CAPITAL, 0)
                  INTO v_sal_actual
                  FROM AH_CTA_CERTIFICADOS
                 WHERE NRO_CUENTA = ct.nro_cuenta;
              EXCEPTION
                WHEN OTHERS THEN
                  pr_mensajeUsuario(c_men_cta_inexistente,
                                    v_retorno.nombreRespuesta,
                                    v_retorno.descripcionRespuesta,
                                    v_retorno.error);
                  pr_insertarBitacora(NULL,
                                      v_cod_canal,
                                      NULL,
                                      c_cod_operacion,
                                      NULL,
                                      'obtResumenCuenta (cod_modalidad = 32) - ' ||
                                      SQLERRM,
                                      BITACORA_ERROR);
                  RETURN v_retorno;
              END;
            ELSE
              v_sal_actual := ct.sal_actual;
            END IF;

            v_can_detalles               := v_can_detalles + 1;
            IF v_ind_cta_encriptada = 'S' THEN
               v_accountInfo.numeroCuenta   := fu_encriptacionCuentas(substr(v_cta_formateada,0,17));
            ELSE
               v_accountInfo.numeroCuenta   := substr(v_cta_formateada,0, 17);
            END IF;

            v_accountInfo.numeroTarjetaPrincipal := FUT_OBT_NRO_TARJETA(v_accountInfo.numeroCuenta);
            v_accountInfo.afinidad := lf_obt_ref_externa(v_accountInfo.numeroCuenta);
            v_accountInfo.tipoCuenta     := substr(ct.cod_tip_cuenta, 0, 2);
            v_accountInfo.descripcionTipoCuenta := substr(ct.des_tip_cuenta, 1, 50);
            v_accountInfo.denominacion   := substr(ct.nom_cuenta, 0, 50);
            v_accountInfo.codigoMoneda   := substr(ct.cod_moneda, 0, 3);
            v_accountInfo.saldoActual    := v_sal_actual;
            v_listaCuentas.extend;
            v_listaCuentas(v_listaCuentas.count) := v_accountInfo;
          END;
        END IF;
        IF (v_tip_consulta IN ('070', '075')) THEN
          -- Pago de Sueldos y Pago de Proveedores...
          EXIT;
        END IF;
      END LOOP;
      IF v_can_detalles = 0 AND
         nvl(v_tip_consulta, 'k') NOT IN ('031', '032') AND
         v_tip_consulta NOT IN ('030', '070', '075') THEN
        -- no tiene cotizaciones
        if v_tip_consulta = '060' then
          pr_mensajeUsuario(c_no_cta_cte,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);
        else
          pr_mensajeUsuario(c_men_cta_inexistente,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);
        end if;
      ELSIF v_can_detalles = 0 and v_ver_cuentas = 'D' THEN
        pr_mensajeUsuario(c_sin_cta_debito,
                          v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta,
                          v_retorno.error);
      ELSIF v_can_detalles = 0 AND nvl(v_tip_consulta, 'k') IN ('031') and
            v_ver_cuentas = 'T' and v_cod_moneda is not null THEN
        pr_mensajeUsuario(c_mon_distintas,
                          v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta,
                          v_retorno.error);
      END IF;
    END IF;
    pr_insertarBitacora(userInfo.codigoPersona,
                        v_cod_canal,
                        v_sesion,
                        c_cod_operacion,
                        userInfo.codigoEmpresa,
                        'obtenerResumenCuentas-' ||
                        fu_generarBitacora(v_retorno.error,
                                           v_retorno.nombreRespuesta,
                                           v_retorno.descripcionRespuesta,
                                           null),
                        BITACORA_ERROR);

    IF v_retorno.error = 'N' THEN
      -- todo ok, se arma el mensaje de respuesta
      v_retorno.resumenCuentas := v_listaCuentas;
      v_retorno.cantidadCuentas:= v_can_detalles;
      RETURN v_retorno;
    ELSE
      v_retorno.resumenCuentas := NULL;
      RETURN v_retorno;
    END IF;
  EXCEPTION
    WHEN OTHERS THEN
      pr_mensajeUsuario(MSG_ERROR,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
      pr_insertarBitacora(NULL,
                          v_cod_canal,
                          NULL,
                          c_cod_operacion,
                          NULL,
                          'obtResumenCuenta -' || SQLERRM,
                          BITACORA_ERROR);
      RETURN v_retorno;

  END;*/

  /*FUNCTION fu_obtenerMovimientos(p_codigoPersona         IN VARCHAR2,
                                 p_codigoEmpresa IN VARCHAR2,
                                 p_codCanal            IN VARCHAR2,
                                 p_nroCuentaEspecifica IN VARCHAR2,
                                 p_nroPagina           IN NUMBER DEFAULT NULL,
                                 p_cantItemsPagina     IN NUMBER DEFAULT NULL,
                                 p_fechaDesde           IN VARCHAR2,
                                 p_fechaHasta           IN VARCHAR2) RETURN typ_detalleMovimientos IS

      c_men_cta_inexistente  constant varchar2(15) := '101';
      c_sin_movimientos      constant varchar2(15) := '107';
      c_cod_operacion        varchar2(3) := '021';

      -- datos recibidos
      v_nro_pagina           number(3); -- nro de pagina
      v_ver_todas            varchar2(3);
      v_nro_cta_especifica   varchar2(16);
      --datos a responder
      v_can_cuentas          number(3); -- cantidad de Cuentas
      v_can_detalles         number(3) := 0; -- cantidad de cuentas
      -- variables
      v_monto1               number(18,2) := 0; -- monto 1
      v_can_movimientos      number(8)    := 0;
      v_saldo                number(18, 2) := 0;
      v_dummy                number(2) := 0;
      v_fec_actual           date := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy

      v_dia_movimiento       number(3) := 89;
      v_fec_inicio           date := to_date('01' || to_char(v_fec_actual - v_dia_movimiento, 'mmyyyy'), 'ddmmyyyy');

      v_reg_inicial          number(10);
      v_reg_final            number(10);
      v_can_pagina           number(5); -- movimientos por pagina
      userInfo               typ_validarSesion;
      v_cod_canal            varchar2(3);
      v_retorno              typ_detalleMovimientos := typ_detalleMovimientos;
      v_log_mensaje          varchar2(1000);
      v_can_registro         number(4) := 9999;
      v_sesion               bw_aut_sesiones.cod_sesion%type;
      v_fec_ini_tar          date;
      v_fec_desde            date;
      v_fec_hasta            date;
      v_nro_tarjeta          ta_tarjetas.nro_tarjeta%type;
      v_gru_tarjeta          ta_tarjetas.nro_tarjeta%type := '';
      v_can_tarjetas         number(8)    := 0;
      v_nombre               ta_tarjetas.nom_embozar%type;
      v_vigente              varchar2(1);

      -- cursor de cuentas pasivas del cliente
      CURSOR cuentas IS
         SELECT a.nro_cuenta, a.cod_modalidad cod_modalidad,
                a.nro_cuenta cta_formateada,
                fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta,
                fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) des_tip_cuenta,
                a.cod_moneda cod_moneda, a.denominacion nom_cuenta,
                a.cod_modulo, decode(a.cod_moneda, 'GS','PYG',a.cod_moneda) swi_moneda, b.relacion
           FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
          WHERE a.nro_cuenta = b.nro_cuenta
            AND b.relacion IN ('O', 'P', 'Y','A')
            AND b.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
            AND a.cod_modulo = c.cod_modulo
            AND a.cod_modalidad = c.cod_modalidad
            AND a.estado = c.estado
            AND c.activo = 'S' -- solo cuentas activas
            AND a.estado <> 'X' -- pendiente de verificacion
            AND (b.cod_modalidad IN (31, 33, 41) or b.cod_modulo = 5)
            AND (v_ver_todas = 'S' OR b.nro_cuenta = v_nro_cta_especifica) -- solo ve la cuenta recibida o todas
            AND not exists(select 0
                            from bw_cta_accesos p
                            where p.nro_cuenta = b.nro_cuenta
                              and p.cod_per_vinculo = userInfo.codigoPersona
                              and p.tip_acceso = 'P'
                              and p.activo = 'S' );

      -- movimientos por cuenta
      CURSOR movimientos(p_nro_cuenta IN VARCHAR2, p_can_registros IN NUMBER, p_nro_tarjeta IN VARCHAR2, p_nombre IN VARCHAR2) IS
        SELECT *
          FROM (
              SELECT fecha,
               fec_valor,
               nro_documento,
                      upper(decode(nvl(c.tip_despliegue,'D'),    -- Si no tiene nada se asigna D para Descripcion
                              'C',nvl(concepto,c.descripcion),   -- Si es C es Concepto
                              'A',c.abreviatura||' '||concepto,   -- Si es A es Abreviatura y Concepto
                              c.descripcion)) des_tra_padre,      -- Si no es C o A entonces es Descripcion
                      decode(v_cod_canal, C_COD_HOMEBANKING, REPLACE(a.hora, ':', ''), '998', REPLACE(a.hora, ':', ''), abr_tra_padre) abr_tra_padre,
                      fug_obt_tra_tipo(b.cod_transaccion, b.tipo, b.afecta) cod_tip_movimiento,
                      monto,
                      hora,
                      nro_secuencia,
                       a.fec_insercion,
                       a.TIPO,
                       '' nro_tarjeta,
                       '' relacion,
                       '' nombre
                 FROM ge_transacciones b, gv_movimientos a,
                                       ge_transacciones c
                WHERE nro_cuenta = p_nro_cuenta
                  AND estado = 'N'
                  AND reversado = 'N'
                  AND monto <> 0
                  AND cod_tip_movimiento IN ('D', 'C')
                  --AND fecha >= v_fec_inicio
                  AND fecha >= v_fec_desde
                  AND fecha <= v_fec_hasta
                  AND a.cod_modulo = b.cod_modulo
                  AND a.cod_modalidad = b.cod_modalidad
                  AND a.cod_transaccion = b.cod_transaccion
                  AND a.cod_mod_padre   = c.cod_modulo
                  AND a.cod_mad_padre   = c.cod_modalidad
                  AND a.cod_tra_padre   = c.cod_transaccion
                  AND b.ve_cliente = 'S'
                  AND a.cod_modulo <> 5
                  AND NOT EXISTS (SELECT 0
                                    FROM ah_retenciones x
                                   WHERE x.nro_cuenta = a.nro_cuenta
                                     AND x.nro_documento = a.nro_documento
                                     AND x.cod_retencion = a.cod_retencion
                                     AND x.fec_final = a.fec_fin_retencion
                                     AND x.liberado = 'N')

               UNION
                Select
                 a.fec_proceso fecha,
                    a.fec_movimiento fec_valor,
                    0 nro_documento,
                    fuw_obt_concepto(a.cod_tip_cargo, a.ref_archivo, a.descripcion) des_tra_padre,
                    '000000' abr_tra_padre,
                    -- Se agrega tipo de registro 2 a X para mostras movimientos en el exterior
                    (case WHEN nvl(a.cod_tip_movimiento,'D') != 'A' THEN nvl(a.cod_tip_movimiento,'D')
                          WHEN nvl(a.cod_tip_movimiento,'D') = 'A' THEN 'D'
                     end) cod_tip_movimiento,
                    fuw_obt_tar_monto(a.ref_archivo,a.cod_tip_cargo,a.est_cuota,a.mto_operacion,a.mto_seg_usuario, a.mto_impuesto, a.mto_int_cuota, a.mto_int_corriente, a.mto_int_punitorio,a.mto_int_mora,a.mto_cie_iva5) mto_operacion,
                    '00:00:00' hora,
                    0 nro_secuencia,
                    a.fec_insercion,
                     'D' TIPO,
                    (case when a.nro_tarjeta is not null then decode(a.nro_tarjeta,p_nro_cuenta,p_nro_tarjeta,a.nro_tarjeta )
                           when a.nro_tarjeta is null then p_nro_tarjeta
                     end) nro_tarjeta,
                    (case when a.nro_tarjeta is not null then decode(a.nro_tarjeta,p_nro_cuenta,'P',cc.relacion )
                           when a.nro_tarjeta is null then 'P'
                     end) relacion,
                     (case when a.nro_tarjeta is not null then decode(a.nro_tarjeta,p_nro_cuenta,p_nombre,t.nom_embozar)
                           when a.nro_tarjeta is null then p_nombre
                      end) nombre
               from ta_mov_especiales a, ta_tarjetas t, ge_cta_clientes cc
              where a.nro_tarjeta = t.nro_tarjeta(+)
              and t.cod_persona = cc.cod_persona(+)
              and t.nro_cuenta = cc.nro_cuenta(+)
              and a.nro_cuenta = p_nro_cuenta
               \*and (cod_tip_cargo is not null or
                  (cod_tip_cargo is null and nvl(cod_tip_movimiento,'D') != 'D'))*\
                 -- se inhibe registro donde figura el nombre del adicional
                ----and a.fec_proceso > v_fec_ini_tar
                 and (nvl(a.cod_tip_cargo,'0') != '33' or (nvl(a.cod_tip_cargo,'0') = '33' and NVL(FUE_OBT_VAL_MAX_REFERENCIA ('TAR_MOV_ESPECIAL', a.descripcion),'N') <> 'S'))
                 and (nvl(a.cod_tip_cargo,'0') != '39' or (nvl(a.cod_tip_cargo,'0') = '39' and a.est_cuota is null))
                 and (nvl(a.mto_operacion,0) != 0 or (nvl(a.mto_operacion,0) = 0 and a.ref_archivo = 'TAR_INF_GAS_FINANCIEROS'))
                 and (nvl(a.cod_tip_cargo,'0') != '38' or (nvl(a.cod_tip_cargo,'0') = '38' and a.can_cuotas = 1)
                  or (nvl(a.cod_tip_cargo,'0') = '38' and a.can_cuotas > 1 and est_cuota in ('C')))
                 and a.fec_proceso >= v_fec_desde
                 and a.fec_proceso <= v_fec_hasta
                 ORDER BY relacion DESC, nro_tarjeta, fecha DESC, HORA DESC, nro_secuencia DESC)
         WHERE ROWNUM <= p_can_registros;
   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      v_sesion               := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
      v_cod_canal          := depurarAlfanumerico(p_codCanal,3);
      v_nro_pagina         := depurarNumerico(p_nroPagina,4);
      v_can_pagina         := depurarNumerico(p_cantItemsPagina,4);
      v_nro_cta_especifica := depurarCuenta(p_nroCuentaEspecifica,CUENTA_TAMANO);
      v_ver_todas          := 'N';
      v_fec_desde         := trunc(to_date(paw_bem.depurarAlfanumerico(p_fechaDesde,8),'ddmmyyyy'));
      v_fec_hasta         := trunc(to_date(paw_bem.depurarAlfanumerico(p_fechaHasta,8),'ddmmyyyy'));
      --verificar nro de cuenta
      begin
        select 1
          into v_dummy
          from ge_cuentas
         where nro_cuenta = v_nro_cta_especifica
         and estado in ('N','B','D','S','T');
      exception
        when no_data_found then
          v_dummy := 0;
      end;
      If v_dummy = 0 then
         pr_mensajeUsuario(c_men_cta_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Cta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      end if;

      -- Fecha de Inicio Parametrizado para los movimientos
      v_dia_movimiento := NVL(fug_obt_pardinamico('BWE_DIA_MOVIMIENTOS'), v_dia_movimiento);
      v_fec_inicio := v_fec_actual - v_dia_movimiento;
      v_fec_ini_tar := v_fec_inicio;

      if nvl(fug_obt_pardinamico('BWE_FEC_CIE_TAR_MOV'),'N') = 'S' then
        begin
          SELECT MAX(fec_cierre)
            INTO v_fec_ini_tar
            FROM ta_cal_cierres
           WHERE fec_cierre < trunc(SYSDATE);
        exception
          when no_data_found then
            v_fec_ini_tar := v_fec_inicio;
        end;
      end if;

      if v_nro_pagina is not null and v_can_pagina is not null then
         v_reg_inicial := (v_nro_pagina * v_can_pagina) - (v_can_pagina - 1);
         v_reg_final   := (v_nro_pagina * v_can_pagina);
      end if;

      -- 1. valido la clave del cliente
      --userInfo := fu_validarSesion(v_sesion, v_cod_canal);
       userInfo.error:='N';
       userInfo.codigoCanal:=v_cod_canal;
       userInfo.codigoPersona:=p_codigoPersona;
       userInfo.codigoEmpresa:=p_codigoEmpresa;

      --Logear parametros
      v_log_mensaje := 'obtenerMovimientos(p_nroPagina= '||v_nro_pagina||',p_cantItemsPagina= '||v_can_pagina||' p_nroCuentaEspecifica=' || v_nro_cta_especifica ||
                       ' p_codCanal= ' || v_cod_canal ||')';
      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_log_mensaje, BITACORA_ENTRADA);


      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;

      --Cantidad de movimientos a desplegar
      IF v_cod_canal = C_COD_HOMEBANKING THEN
         v_can_registro := NVL(fug_obt_pardinamico('BWE_MAX_MOVIMIENTOS'), v_can_registro);
         if v_nro_cta_especifica is not null then
            If v_ind_cta_encriptada = 'S' THEN
               v_nro_cta_especifica := fu_desencriptacionCuentas(v_nro_cta_especifica);
            end if;
            if length(v_nro_cta_especifica) = 16 then
               v_nro_cta_especifica := lf_obt_cta_tarjeta(v_nro_cta_especifica,userInfo.codigoEmpresa, userInfo.codigoPersona);
            end if;
         else
            v_ver_todas := 'S';
         end if;
      END IF;

      -- 1.1. Armo el nro de cuenta
      IF v_nro_cta_especifica IS NULL THEN
         pr_mensajeUsuario(c_men_cta_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Cta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 2. busco los datos de la cuentas
      IF v_retorno.error = 'N' THEN
         v_can_cuentas := 0;
         FOR ct IN cuentas LOOP
            DECLARE
               detalleMovimiento typ_movimiento := typ_movimiento;
               listaMovimientos  typ_listaMovimientos;
               nombreTarjeta typ_nombreTarjeta := typ_nombreTarjeta;
               listaNombreTarjetas  typ_listaNombreTarjetas;
            BEGIN
               --- Debe controlar para que no muestre cuentas juridicas entre las cuentas del cliente
               IF fu_es_juridica(ct.nro_cuenta, userInfo.codigoEmpresa, userInfo.codigoPersona) = 'N' AND
                  lf_ver_adicional (ct.cod_modulo,ct.relacion,ct.nro_cuenta, nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)) in ('S','T') THEN
                  v_can_cuentas := v_can_cuentas + 1;
                  v_can_movimientos := 0;
                  -- busco los demas datos de las cuentas
                  BEGIN
                     pag_cta.PR_OBT_CUENTA(ct.nro_cuenta);
                  EXCEPTION
                     WHEN OTHERS THEN
                        pr_mensajeUsuario(c_men_cta_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Cta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
                        return v_retorno;
                  END;

                  listaMovimientos := typ_listaMovimientos();
                  listaNombreTarjetas := typ_listaNombreTarjetas();

                  --V_monto1 = al saldo disponible de la cuenta pero sin considerar el Bloqueado
                  IF ct.cod_modulo = 5 THEN
                    v_monto1 := fu_obt_sal_actual(ct.cod_modulo, ct.cod_modalidad, ct.nro_cuenta );
                  ELSE
                    v_monto1 := pag_cta.g_ctas.sal_disponible + pag_cta.g_ctas.sal_bloqueado;
                  END IF;

                  --Saldo disponibles + el Saldo bloqueado que resto en el package
                  v_saldo           := v_monto1;
                  v_can_movimientos := 0;
                  v_can_tarjetas := 0;
                  v_gru_tarjeta := '';

                  v_nro_tarjeta := '';
                  IF ct.cod_modulo = 5 then
                      select d.nro_tarjeta, d.nom_embozar
                      into v_nro_tarjeta, v_nombre
                      from ge_cta_clientes a, ge_cuentas b, ge_est_cuentas c, ta_tarjetas d
                       where a.nro_cuenta = b.nro_cuenta
                       and b.cod_modulo = c.cod_modulo
                       and b.cod_modalidad = c.cod_modalidad
                       and b.estado = c.estado
                       and a.nro_cuenta = d.nro_cuenta
                       and a.cod_persona = d.cod_persona
                       and d.vigente = 'S'
                       and a.nro_cuenta = ct.nro_cuenta and a.relacion = 'P';
                  END IF;


                  -- Ciclo para obtener el movimientos
                  FOR mv IN movimientos(ct.nro_cuenta, v_can_registro, v_nro_tarjeta, v_nombre) LOOP

                        if nvl(v_gru_tarjeta,'X') != mv.nro_tarjeta and ct.cod_modulo = 5 then
                           select ta.vigente
                             into v_vigente
                             from ta_tarjetas ta
                            where ta.nro_tarjeta = mv.nro_tarjeta;

                           nombreTarjeta.numeroTarjeta := mv.nro_tarjeta;
                           nombreTarjeta.nombre        := mv.nombre;
                           nombreTarjeta.tipo          := mv.relacion; --P-principal A-adicional
                           nombreTarjeta.vigente       := v_vigente;





                           listaNombreTarjetas.extend;
                           v_can_tarjetas := v_can_tarjetas + 1;
                           listaNombreTarjetas(listaNombreTarjetas.count) := nombreTarjeta;
                           v_gru_tarjeta := mv.nro_tarjeta;
                        end if;
                        v_can_movimientos := v_can_movimientos + 1;

                        IF (v_reg_inicial IS NULL) OR (v_can_movimientos >= v_reg_inicial) THEN
                           -- es un registro que debo mostrar

                           detalleMovimiento.fecha                       := lf_for_date(mv.fec_valor);
                           detalleMovimiento.fechaValor                  := lf_for_date(mv.fecha);
                           detalleMovimiento.numeroDocumento             := substr(mv.nro_documento,0, 15);
                           detalleMovimiento.descripcionTransaccionPadre := substr(mv.des_tra_padre,0, 35);
                           detalleMovimiento.abreviaturaTransaccionPadre := substr(mv.abr_tra_padre,0, 10);
                           detalleMovimiento.tipoMovimiento              := substr(mv.cod_tip_movimiento,0, 1);
                           detalleMovimiento.monto                       := mv.monto;
                           detalleMovimiento.saldo                       := v_saldo;
                           detalleMovimiento.hora                        := mv.hora;
                           detalleMovimiento.nro_tarjeta                 := mv.nro_tarjeta;
                           listaMovimientos.extend;
                           v_can_detalles                                := v_can_detalles + 1;
                           listaMovimientos(listaMovimientos.count) := detalleMovimiento;
                        END IF;

                        IF mv.cod_tip_movimiento = 'C' THEN
                           v_saldo := nvl(v_saldo, 0) - nvl(mv.monto, 0);
                        ELSE
                           v_saldo := nvl(v_saldo, 0) + nvl(mv.monto, 0);
                        END IF;

                        IF (v_reg_final IS NOT NULL) AND (v_can_movimientos >= v_reg_final) THEN
                           EXIT;
                        END IF;
                     END LOOP; --end loop movimientos
                  --
                  v_monto1 := v_saldo;
                  IF v_retorno.error = 'N' THEN
                     -- esta bien el dato se carga el detalle
                     v_retorno.cantidadMovimientos  := v_can_detalles;--v_can_movimientos;
                     v_retorno.listaMovimientos := listaMovimientos;
                     v_retorno.cantidadTarjetas := v_can_tarjetas;
                     v_retorno.listaNombreTarjetas := listaNombreTarjetas;
                  END IF;
               END IF;
            END;
         END LOOP; --end loop cuentas
         IF v_can_cuentas = 0 THEN
            -- no tiene detalles
            pr_mensajeUsuario(c_men_cta_inexistente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_obtenerMovimientos - Cta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END IF;
         IF v_can_movimientos = 0 THEN
            -- no tiene detalles
            pr_mensajeUsuario(c_sin_movimientos, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_obtenerMovimientos - Cta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         END IF;
      END IF;
      -- registro del movimiento
      paw_con.pr_reg_operacion(substr(v_nro_cta_especifica,0,15) \*p_nro_cuenta*\, NULL \*p_cod_moneda *\, NULL \*p_monto*\, NULL \*p_nro_cta_contra*\, NULL \*p_cantidad*\, 'Ver Todas' \*p_etiqueta*\, v_ver_todas, \*p_dato*\ NULL, NULL, 'Obt Movimientos', NULL, NULL, userInfo.codigoPersona, c_cod_operacion, userinfo.codigoPersona || v_cod_canal, v_cod_canal, v_sesion, userInfo.codigoEmpresa);
      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerMovimientos-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, NULL, 'fu_obtenerMovimientos -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;
  */ 
   FUNCTION fu_obtenerMovimientos(p_sesion              IN VARCHAR2,
                                  p_codCanal            IN VARCHAR2,
                                  p_nroCuentaEspecifica IN VARCHAR2,
                                  p_nroPagina           IN NUMBER DEFAULT NULL,
                                  p_cantItemsPagina     IN NUMBER DEFAULT NULL,
                                  p_cantDias            IN NUMBER DEFAULT NULL) RETURN typ_detalleMovimientos IS

      userInfo         typ_validarSesion;
      v_fec_actual DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
      v_fec_inicio DATE := v_fec_actual - nvl(p_cantDias, 90);
      v_fec_final  DATE := v_fec_actual;
      COD_OPERACION    VARCHAR2(3) := '021';
      v_retorno        typ_DetalleMovimientos := typ_detalleMovimientos;

   BEGIN
      v_retorno :=fu_obtenerMovimientos_por_fec(p_sesion,
                                  p_codCanal,
                                  p_nroCuentaEspecifica,
                                  p_nroPagina,
                                  p_cantItemsPagina,
                                  v_fec_inicio,
                                  v_fec_final);
      return v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'fu_obtenerMovimientos -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;


