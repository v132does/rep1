      -- 2. ejecuto la funcion para generar el comprobante
      v_retorno.listaFacturas := typ_listaFacturas();
      FOR ft IN facturas
      LOOP
         v_detalles.numeroFactura  := ft.nro_factura;
         v_detalles.fecha          := lf_for_date(ft.fecha);
         v_detalles.tipo           := ft.tipo;
         v_detalles.codigoMoneda   := ft.cod_moneda;
