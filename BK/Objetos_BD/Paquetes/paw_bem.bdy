   END;*/


  /* FUNCTION fu_obtenerChequesDevueltos(p_sesion    IN VARCHAR2,
                                       p_codCanal  IN VARCHAR2,
                                       p_nroCuenta IN VARCHAR2 DEFAULT NULL) RETURN typ_ChequesDevueltos IS

      c_ope_no_permitida   constant varchar2(15) := '245';
      c_cod_operacion      constant varchar2(3)  := '040';
      c_men_sin_datos      constant varchar2(15) := '256';

      v_ver_todas          varchar2(1);
      v_nro_cta_especifica varchar2(16);
      v_can_detalles       number(3); -- cantidad de cuentas
      v_can_movimientos    number(5);
      v_sesion             bw_aut_sesiones.cod_sesion%type;
      v_cod_canal          ge_canales.cod_canal%type;
      v_nro_cuenta         varchar2(16);
      v_fec_actual         date := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
      v_log_mensaje        VARCHAR2(1000);
      userInfo             typ_validarSesion;
      v_retorno            typ_chequesDevueltos := typ_chequesDevueltos;
      v_movimiento         typ_chequeDevuelto := typ_chequeDevuelto;

      -- cursor de cuentas pasivas del cliente
      CURSOR cuentas IS
         SELECT a.nro_cuenta, a.cod_modalidad cod_modalidad, a.nro_cuenta cta_formateada, fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta, fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) des_tip_cuenta, a.cod_moneda cod_moneda, a.denominacion nom_cuenta, fu_obt_sal_actual(a.cod_modulo, a.cod_modalidad, a.nro_cuenta) sal_actual, a.cod_modulo
           FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
          WHERE a.nro_cuenta = b.nro_cuenta
            AND b.relacion IN ('O', 'P', 'Y')
            AND b.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
            AND a.cod_modulo = c.cod_modulo
            AND a.cod_modalidad = c.cod_modalidad
            AND a.estado = c.estado
            AND c.activo = 'S' -- solo cuentas activas
            AND a.estado <> 'X' -- pendiente de verificacion
            AND b.cod_modalidad IN (31, 41)
            AND (v_ver_todas = 'S' OR b.nro_cuenta = v_nro_cta_especifica); -- solo ve la cuenta recibida o todas

      -- movimientos de cheques devueltos de camara y del exterior depositados en cuenta
      CURSOR movimientos(p_nro_cuenta IN VARCHAR2) IS
         SELECT b.descripcion des_banco, a.nro_documento nro_cheque, a.monto monto, c.descripcion des_causa, a.fecha
           FROM ge_causales c, ge_bancos b, gv_movimientos a
          WHERE a.nro_cuenta = p_nro_cuenta
            AND a.cod_mod_padre IN(3,4)
            AND a.cod_mad_padre IN (41,31)
            AND a.cod_tra_padre = 321
            AND a.cod_transaccion IN (522, 503, 182)
            AND a.reversado = 'N'
            AND a.estado = 'N'
            AND a.cod_banco = b.cod_banco
            AND a.cod_causa = c.cod_causa
            AND a.fecha >= v_fec_actual - 30
          ORDER BY a.fecha asc;

    -- movimientos de cheques devueltos de camara y del exterior depositados en cuenta para BT
    CURSOR mov_bt(p_nro_cuenta in varchar2) is
       select b.descripcion des_banco, a.nro_documento nro_cheque,
          a.monto monto, c.descripcion des_causa,  a.fecha
       from ge_causales c, ge_bancos b, gv_movimientos a
      where a.nro_cuenta = p_nro_cuenta
        and a.cod_mod_padre IN(3,4)
       and a.cod_mad_padre IN (41,31)
        and a.cod_tra_padre = 321
        and a.cod_transaccion in (522,503,182)
        and a.reversado = 'N'
        and a.estado = 'N'
        and a.cod_banco = b.cod_banco
        and a.cod_causa = c.cod_causa
        and a.fecha >= v_fec_actual - 30
        Order by a.fecha desc;

   BEGIN

      v_cod_canal     := depurarAlfanumerico(p_codCanal,3);
      v_sesion        := depurarAlfanumerico(p_sesion,32);
      v_nro_cuenta    := depurarCuenta(p_nroCuenta,CUENTA_TAMANO);
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      IF (v_nro_cuenta IS NULL) THEN
         v_ver_todas := 'S';
      ELSE
         v_ver_todas := 'N';
         IF v_cod_canal = C_COD_HOMEBANKING THEN
            IF v_ind_cta_encriptada = 'S' THEN
               v_nro_cta_especifica := fu_desencriptacionCuentas(v_nro_cuenta);
            ELSE
               v_nro_cta_especifica := v_nro_cuenta;
           END IF;
         END IF;
      END IF;


      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(v_sesion, v_cod_canal);
      --Logear parametros
      v_log_mensaje := 'ObtenerChequesDevueltos(sesion='||v_sesion||'*,codCanal='||v_cod_canal||'*,nroCuenta=' || v_nro_cuenta || ')';
      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_log_mensaje, BITACORA_ENTRADA);

      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         \*Obtiene la informacion de parametros recibos y el return del type*\
         paw_log.g_typ_ChequesDevueltos := v_retorno;
         paw_log.pr_logValoresTypes('typ_ChequesDevueltos',
         'fu_obtenerChequesDevueltos'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta);
         RETURN v_retorno;
      END IF;

      -- 2. busco los datos de la cuentas
      v_can_detalles                  := 0;
      v_retorno.listaChequesDevueltos := typ_listaChequesDevueltos();
      FOR ct IN cuentas LOOP
         --- Debe controlar para que no muestre cuentas juridicas entre las cuentas del cliente
         IF fu_es_juridica(ct.nro_cuenta, userInfo.codigoEmpresa, userInfo.codigoPersona) = 'N' THEN
            v_can_detalles    := v_can_detalles + 1;
            v_can_movimientos := 0;

            IF v_cod_canal = '998' THEN
              FOR mv IN mov_bt(ct.nro_cuenta) LOOP

                 BEGIN
                  v_can_movimientos             := v_can_movimientos + 1;
                  IF v_ind_cta_encriptada = 'S' THEN
                     v_movimiento.numeroCuenta     := fu_encriptacionCuentas(ct.nro_cuenta);
                  ELSE
                     v_movimiento.numeroCuenta     := ct.nro_cuenta;
                  END IF;
                  v_movimiento.banco            := substr(mv.des_banco,0, 35);
                  v_movimiento.numeroCheque     := mv.nro_cheque;
                  v_movimiento.importe          := mv.monto;
                  v_movimiento.motivoDevolucion := substr(mv.des_causa,0, 35);
                  v_movimiento.fecha            := lf_for_date(mv.fecha);
                  v_movimiento.codigoMoneda     := ct.cod_moneda;
                  v_retorno.listaChequesDevueltos.extend;
                  v_retorno.listaChequesDevueltos(v_retorno.listaChequesDevueltos.count) := v_movimiento;

                  EXIT WHEN v_can_movimientos >= 4;
                 END;
              END LOOP;
            ELSE
              FOR mv IN movimientos(ct.nro_cuenta) LOOP

                 BEGIN
                  v_can_movimientos             := v_can_movimientos + 1;
                   IF v_ind_cta_encriptada = 'S' THEN
                      v_movimiento.numeroCuenta     := fu_encriptacionCuentas(ct.nro_cuenta);
                   ELSE
                      v_movimiento.numeroCuenta     := ct.nro_cuenta;
                   END IF;
                  v_movimiento.banco            := substr(mv.des_banco,0, 35);
                  v_movimiento.numeroCheque     := mv.nro_cheque;
                  v_movimiento.importe          := mv.monto;
                  v_movimiento.motivoDevolucion := substr(mv.des_causa,0, 35);
                  v_movimiento.fecha            := lf_for_date(mv.fecha);
                  v_movimiento.codigoMoneda     := ct.cod_moneda;
                  v_retorno.listaChequesDevueltos.extend;
                  v_retorno.listaChequesDevueltos(v_retorno.listaChequesDevueltos.count) := v_movimiento;
                 END;
              END LOOP;
            END IF;

         END IF;
      END LOOP;

      IF v_can_detalles = 0 THEN
         -- no tiene detalles
         pr_mensajeUsuario(c_ope_no_permitida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Cuenta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         \*Obtiene la informacion de parametros recibos y el return del type*\
          paw_log.g_typ_ChequesDevueltos := v_retorno;
          paw_log.pr_logValoresTypes('typ_ChequesDevueltos',
          'fu_obtenerChequesDevueltos'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta);
          RETURN v_retorno;
      END IF;

      IF v_can_movimientos = 0 THEN
         -- no tiene movimientos
         pr_mensajeUsuario(c_men_sin_datos, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'Cuenta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         \*Obtiene la informacion de parametros recibos y el return del type*\
         paw_log.g_typ_ChequesDevueltos := v_retorno;
         paw_log.pr_logValoresTypes('typ_ChequesDevueltos',
         'fu_obtenerChequesDevueltos'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta);
         RETURN v_retorno;
      END IF;

      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      v_retorno.cantChequesDevueltos := v_can_movimientos;

     \*Obtiene la informacion de parametros recibos y el return del type*\
      paw_log.g_typ_ChequesDevueltos := v_retorno;
      paw_log.pr_logValoresTypes('typ_ChequesDevueltos',
      'fu_obtenerChequesDevueltos'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta);


      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, NULL, c_cod_operacion, NULL, 'obtChequesDevueltos -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
   END;
*/
  /* FUNCTION fu_obtenerDepositosConfirmar(p_sesion    IN VARCHAR2,
                                         p_codCanal  IN VARCHAR2,
                                         p_nroCuenta IN VARCHAR2 DEFAULT NULL,
                                         p_esFaxNocturno IN VARCHAR2 DEFAULT 'N') RETURN typ_depositosConfirmar IS

       c_cod_operacion      constant varchar2(03) := '041';
       c_men_cta_no_corresp constant varchar2(15) := '247';
       c_men_sin_datos      constant varchar2(15) := '185';

       -- datos recibidos
       v_ver_todas          varchar2(1);
       v_nro_cta_especifica varchar2(16);
       v_cod_canal          varchar2(3);
       v_sesion             bw_aut_sesiones.cod_sesion%type;
       v_fax_nocturno       varchar2(1);
       -- datos a responder
       v_can_detalles       number(3); -- cantidad de cuentas
       userInfo             typ_validarSesion;
       v_retorno            typ_depositosConfirmar := typ_depositosConfirmar;
       v_log_mensaje        varchar2(1000);
       v_can_limite         number(8) := 5; -- Utilizado para Mobile Banking
       v_cod_persona        ba_personas.cod_persona%type;

      -- cursor de cuentas pasivas del cliente
      CURSOR cuentas IS
         SELECT a.nro_cuenta, a.cod_modalidad cod_modalidad,
                a.nro_cuenta cta_formateada,
               fu_tip_cuenta(a.cod_modulo, a.cod_modalidad) cod_tip_cuenta,
               fug_obt_des_modal(a.cod_modulo, a.cod_modalidad) des_tip_cuenta,
               a.cod_moneda cod_moneda, a.denominacion nom_cuenta,
               a.cod_modulo
           FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
          WHERE a.nro_cuenta = b.nro_cuenta
            AND b.relacion IN ('O', 'P', 'Y')
            AND b.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
            AND a.cod_modulo = c.cod_modulo
            AND a.cod_modalidad = c.cod_modalidad
            AND a.estado = c.estado
            AND c.activo = 'S' -- solo cuentas activas
            AND a.estado <> 'X' -- pendiente de verificacion
            AND b.cod_modalidad IN (31, 41)
            AND (v_ver_todas = 'S' OR b.nro_cuenta = v_nro_cta_especifica) -- solo ve la cuenta recibida o todas
            AND NOT EXISTS (SELECT 0
                    FROM bw_cta_accesos p
                   WHERE p.nro_cuenta = a.nro_cuenta
                     AND p.cod_per_vinculo = userInfo.codigoPersona
                     AND p.tip_acceso = 'P'
                     AND p.activo = 'S');

      -- movimientos de depositos a cofirmar por cuenta
      CURSOR movimientos(p_nro_cuenta IN VARCHAR2) IS
         SELECT nro_documento, monto, fec_inicio, fec_final
           FROM ah_retenciones
          WHERE nro_cuenta = p_nro_cuenta
            AND liberado = 'N'
          ORDER BY fec_inicio, fec_final;

      \* Productos: Se comenta tabla ah_retenciones_ant, se cambia por ah_retenciones, para compilar version incial*\
      CURSOR mov_fax_nocturno(p_nro_cuenta IN VARCHAR2) IS
          SELECT nro_documento, monto, fec_inicio, fec_final
            --FROM ah_retenciones_ant
            FROM ah_retenciones
           WHERE nro_cuenta = p_nro_cuenta
             AND liberado = 'N'
           ORDER BY fec_inicio, fec_final;

   BEGIN
      v_sesion             := depurarAlfanumerico(p_sesion,32);
      v_cod_canal          := depurarAlfanumerico(p_codCanal,3);
      v_nro_cta_especifica := depurarCuenta(p_nroCuenta,CUENTA_TAMANO);
      v_fax_nocturno       := depurarAlfanumerico(p_esFaxNocturno,1);

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      IF v_nro_cta_especifica IS NULL THEN
         v_ver_todas := 'S';
      ELSE
         v_ver_todas := 'N';
         IF v_cod_canal = C_COD_HOMEBANKING THEN
            IF v_ind_cta_encriptada = 'S' THEN
               v_nro_cta_especifica := fu_desencriptacionCuentas(v_nro_cta_especifica);
           END IF;
         END IF;
      END IF;

      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(v_sesion, v_cod_canal);
      --Logear parametros
      v_log_mensaje := 'ObtDepositosConfirmar (sesion='||v_sesion||', codCanal='||v_cod_canal||', nroCuenta=' || v_nro_cta_especifica || ')';
      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_log_mensaje, BITACORA_ENTRADA);

      IF (userInfo.error = 'S') THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;

      v_cod_persona := nvl(userInfo.codigoEmpresa,userInfo.codigoPersona);
     --Valida que la cuenta corresponda al cliente
      IF v_nro_cta_especifica is not null and lf_val_cta_origen(v_nro_cta_especifica, v_cod_persona) = 'N' THEN
         pr_mensajeUsuario(c_men_cta_no_corresp, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_cod_persona, v_cod_canal, v_sesion, c_cod_operacion, userinfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      -- 2. busco los datos de la cuentas

      v_can_detalles                    := 0;
      v_retorno.listaDepositosConfirmar := typ_listaDepositosConfirmar();
      FOR ct IN cuentas LOOP
         --- Debe controlar para que no muestre cuentas juridicas entre las cuentas del cliente
         IF fu_es_juridica(ct.nro_cuenta, userInfo.codigoEmpresa, userInfo.codigoPersona) = 'N' THEN

            IF v_fax_nocturno = 'S' then

              FOR mv IN mov_fax_nocturno(ct.nro_cuenta) LOOP
                 DECLARE
                  v_deposito typ_depositoConfirmar := typ_depositoConfirmar;
                 BEGIN
                  v_can_detalles            := v_can_detalles + 1;
                  If v_ind_cta_encriptada = 'S' THEN
                     v_deposito.nroCuenta      := fu_encriptacionCuentas(ct.cta_formateada);
                  ELSE
                     v_deposito.nroCuenta      := ct.cta_formateada;
                  END IF;
                  v_deposito.nroBoleta      := mv.nro_documento;
                  v_deposito.importe        := mv.monto;
                  v_deposito.fechaDeposito  := lf_for_date(mv.fec_inicio);
                  v_deposito.fechaConfirmar := lf_for_date(mv.fec_final);
                  v_deposito.codigoMoneda   := ct.cod_moneda;
                  v_retorno.listaDepositosConfirmar.extend;
                  v_retorno.listaDepositosConfirmar(v_retorno.listaDepositosConfirmar.count) := v_deposito;
                 END;
              END LOOP;
            ELSE

              FOR mv IN movimientos(ct.nro_cuenta) LOOP
                 DECLARE
                  v_deposito typ_depositoConfirmar := typ_depositoConfirmar;
                 BEGIN
                  v_can_detalles            := v_can_detalles + 1;
                  IF v_ind_cta_encriptada = 'S' THEN
                     v_deposito.nroCuenta      := fu_encriptacionCuentas(ct.cta_formateada);
                  ELSE
                     v_deposito.nroCuenta      := ct.cta_formateada;
                  END IF;
                  v_deposito.nroBoleta      := mv.nro_documento;
                  v_deposito.importe        := mv.monto;
                  v_deposito.fechaDeposito  := lf_for_date(mv.fec_inicio);
                  v_deposito.fechaConfirmar := lf_for_date(mv.fec_final);
                  v_deposito.codigoMoneda   := ct.cod_moneda;
                  v_retorno.listaDepositosConfirmar.extend;
                  v_retorno.listaDepositosConfirmar(v_retorno.listaDepositosConfirmar.count) := v_deposito;
                 END;

                 EXIT WHEN v_can_detalles >= v_can_limite and v_cod_canal = '993';
              END LOOP;
            END IF;
         END IF;
      END LOOP;

      v_retorno.cantDepositosConfirmar := v_can_detalles;
      IF v_can_detalles = 0 THEN
         -- no tiene detalles
         pr_mensajeUsuario(c_men_sin_datos, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_cod_persona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtDepositosConfirmar-Cta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      END IF;

      \*Obtiene la informacion de parametros recibos y el return del type*\
      paw_log.g_typ_depositosConfirmar := v_retorno;
      paw_log.pr_logValoresTypes('typ_depositosConfirmar',
      'fu_obtenerDepositosConfirmar'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta||', '|| p_esFaxNocturno);

      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(v_cod_persona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtdepositosConfirmar-' || SQLERRM || '-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
   END;*/
   
--verifica si esa empresa tiene un movimiento pendiente de aprobacion
    FUNCTION lf_ver_pag_pendientes
    (
       p_cod_empresa IN VARCHAR2, p_tip_mensaje IN VARCHAR2
    ) RETURN VARCHAR2 IS
       v_retorno VARCHAR2(1) := 'N';
    BEGIN
       BEGIN
          SELECT 'S'
            INTO v_retorno
            FROM bw_mov_pendientes p
           WHERE p.cod_per_principal = p_cod_empresa
             AND p.cod_per_principal <> p.cod_per_ingreso
             AND p.estado = 'P'
             AND p.cod_tip_mensaje = p_tip_mensaje
             and trunc(sysdate)=trunc(p.fec_insercion);
       EXCEPTION
          WHEN no_data_found THEN
             v_retorno := 'N';
          WHEN too_many_rows THEN
             v_retorno := 'S';
       END;
       RETURN v_retorno;
    END;

  -- Agregado para control de limite global de operaciones
  -- se obtiene el total de movimientos por dia de cod_persona y de su cuenta
  procedure pr_obt_tot_movimiento(p_cod_tip_mensaje IN bw_tip_mensajes.cod_tip_mensaje%TYPE,
                                  p_cod_ente        IN ge_entes.cod_ente%TYPE,
                                  p_cod_persona     IN ba_personas.cod_persona%TYPE,
                                  p_nro_cuenta      IN ge_cta_clientes.nro_cuenta%TYPE,
                                  p_cod_moneda      IN ba_monedas.cod_moneda%TYPE,
                                  p_cod_transaccion IN ge_movimientos.cod_transaccion%TYPE,
                                  p_cod_tra_padre   IN ge_movimientos.cod_tra_padre%TYPE,
                                  p_mto_tra_cuenta  OUT ge_movimientos.monto%TYPE,
                                  p_mto_tra_persona OUT ge_movimientos.monto%TYPE) is

  -- auxiliares
  v_aux_mto_tra_cuenta  ge_movimientos.monto%TYPE;
  v_aux_mto_tra_persona ge_movimientos.monto%TYPE;

  begin
    p_mto_tra_cuenta   := 0;
    p_mto_tra_persona  := 0;
    -- ----------------------------------------
    -- obtengo la suma de todos los movimientos
    -- ----------------------------------------
    -- -------------------
    -- movimientos del dia
    -- -------------------
    if p_cod_tip_mensaje = '033' then -- pago de aduanas tiene 4 tipo de transacciones padre
       SELECT SUM(CASE WHEN gm.nro_cuenta = p_nro_cuenta THEN gm.monto ELSE 0 END),
              SUM(gm.monto)
         INTO v_aux_mto_tra_cuenta, v_aux_mto_tra_persona
         FROM ge_movimientos gm
        WHERE gm.nro_cuenta IN
        (
         select a.nro_cuenta
           from ge_est_cuentas c,ge_cuentas a, ge_cta_clientes b
          where a.nro_cuenta = b.nro_cuenta
            and b.relacion in ('O','P','Y')
            and b.cod_persona = p_cod_persona
            and a.cod_modulo = c.cod_modulo
            and a.cod_modalidad = c.cod_modalidad
            and a.estado = c.estado
            and b.cod_modulo != 7
            and b.cod_modalidad <> 36
            and c.activo = 'S'  -- solo cuentas activas
            and a.estado <> 'X' -- pendiente de verificacion
            and a.cod_moneda = p_cod_moneda
        )
          AND gm.estado = 'N'
          AND gm.reversado = 'N'
          AND gm.cod_transaccion = p_cod_transaccion
          AND gm.cod_moneda = p_cod_moneda
          AND gm.cod_tra_padre IN (219,220,222,226)
          AND trunc(gm.fec_insercion) = trunc(SYSDATE);
    elsif p_cod_tip_mensaje in ('070', '075') then -- pago de salario y proveedores se sumariza por codigo del ente
       SELECT SUM(CASE WHEN gm.nro_cuenta = p_nro_cuenta THEN gm.monto ELSE 0 END),
              SUM(gm.monto)
         INTO v_aux_mto_tra_cuenta, v_aux_mto_tra_persona
         FROM ge_movimientos gm
        WHERE gm.nro_cuenta IN
        (
         select a.nro_cuenta
           from ge_est_cuentas c,ge_cuentas a, ge_cta_clientes b
          where a.nro_cuenta = b.nro_cuenta
            and b.relacion in ('O','P','Y')
            and b.cod_persona = p_cod_persona
            and a.cod_modulo = c.cod_modulo
            and a.cod_modalidad = c.cod_modalidad
            and a.estado = c.estado
            and b.cod_modulo != 7
            and b.cod_modalidad <> 36
            and c.activo = 'S'  -- solo cuentas activas
            and a.estado <> 'X' -- pendiente de verificacion
            and a.cod_moneda = p_cod_moneda
        )
          AND gm.estado = 'N'
          AND gm.reversado = 'N'
          AND gm.cod_transaccion = p_cod_transaccion
          AND gm.cod_moneda = p_cod_moneda
          AND gm.nro_documento3 = p_cod_ente
          AND trunc(gm.fec_insercion) = trunc(SYSDATE);
    elsif p_cod_tip_mensaje <> '214' then
       SELECT SUM(CASE WHEN gm.nro_cuenta = p_nro_cuenta THEN gm.monto ELSE 0 END),
              SUM(gm.monto)
         INTO v_aux_mto_tra_cuenta, v_aux_mto_tra_persona
         FROM ge_movimientos gm
        WHERE gm.nro_cuenta IN
        (
         select a.nro_cuenta
           from ge_est_cuentas c,ge_cuentas a, ge_cta_clientes b
          where a.nro_cuenta = b.nro_cuenta
            and b.relacion in ('O','P','Y')
            and b.cod_persona = p_cod_persona
            and a.cod_modulo = c.cod_modulo
            and a.cod_modalidad = c.cod_modalidad
            and a.estado = c.estado
            and b.cod_modulo != 7
            and b.cod_modalidad <> 36
            and c.activo = 'S'  -- solo cuentas activas
            and a.estado <> 'X' -- pendiente de verificacion
            and a.cod_moneda = p_cod_moneda
        )
          AND gm.estado = 'N'
          AND gm.reversado = 'N'
          AND gm.cod_transaccion = p_cod_transaccion
          AND gm.cod_moneda = p_cod_moneda
          AND gm.cod_tra_padre = p_cod_tra_padre
          AND (p_cod_tip_mensaje NOT IN ('030','039') OR
               (p_cod_tip_mensaje = '039' AND gm.concepto LIKE 'Transf. a % desde %') OR
               (p_cod_tip_mensaje = '030' AND gm.concepto NOT LIKE 'Transf. a % desde %'
                                          AND gm.concepto NOT LIKE '% Ope. Cambio %')
              ) -- para diferenciar transferencias propias de terceros y pre-pactadas
          AND trunc(gm.fec_insercion) = trunc(SYSDATE);
    end if;

    p_mto_tra_cuenta   := p_mto_tra_cuenta + nvl(v_aux_mto_tra_cuenta, 0);
    p_mto_tra_persona  := p_mto_tra_persona + nvl(v_aux_mto_tra_persona, 0);

    -- ---------------------
    -- movimientos nocturnos
    -- ---------------------
    if p_cod_tip_mensaje = '033' then -- pago de aduanas tiene 4 tipo de transacciones padre
       SELECT SUM(CASE WHEN gnoc.nro_cuenta = p_nro_cuenta THEN gnoc.monto ELSE 0 END),
              SUM(gnoc.monto)
         INTO v_aux_mto_tra_cuenta, v_aux_mto_tra_persona
         FROM ge_movimientos_noc gnoc
        WHERE gnoc.nro_cuenta IN
        (
          select a.nro_cuenta
            from ge_est_cuentas c,ge_cuentas a, ge_cta_clientes b
           where a.nro_cuenta = b.nro_cuenta
             and b.relacion in ('O','P','Y')
             and b.cod_persona = p_cod_persona
             and a.cod_modulo = c.cod_modulo
             and a.cod_modalidad = c.cod_modalidad
             and a.estado = c.estado
             and b.cod_modulo != 7
             and b.cod_modalidad <> 36
             and c.activo = 'S'  -- solo cuentas activas
             and a.estado <> 'X' -- pendiente de verificacion
             and a.cod_moneda = p_cod_moneda
        )
          AND gnoc.estado = 'N'
          AND gnoc.reversado = 'N'
          AND gnoc.cod_transaccion = p_cod_transaccion
          AND gnoc.cod_tra_padre IN (219,220,222,226)
          AND gnoc.cod_moneda = p_cod_moneda
          AND trunc(gnoc.fec_insercion) = trunc(SYSDATE);
    elsif p_cod_tip_mensaje in ('070', '075') then -- pago de salario y proveedores se sumariza por codigo del ente
       SELECT SUM(CASE WHEN gnoc.nro_cuenta = p_nro_cuenta THEN gnoc.monto ELSE 0 END),
              SUM(gnoc.monto)
         INTO v_aux_mto_tra_cuenta, v_aux_mto_tra_persona
         FROM ge_movimientos_noc gnoc
        WHERE gnoc.nro_cuenta IN
        (
          select a.nro_cuenta
            from ge_est_cuentas c,ge_cuentas a, ge_cta_clientes b
           where a.nro_cuenta = b.nro_cuenta
             and b.relacion in ('O','P','Y')
             and b.cod_persona = p_cod_persona
             and a.cod_modulo = c.cod_modulo
             and a.cod_modalidad = c.cod_modalidad
             and a.estado = c.estado
             and b.cod_modulo != 7
             and b.cod_modalidad <> 36
             and c.activo = 'S'  -- solo cuentas activas
             and a.estado <> 'X' -- pendiente de verificacion
             and a.cod_moneda = p_cod_moneda
        )
          AND gnoc.estado = 'N'
          AND gnoc.reversado = 'N'
          AND gnoc.cod_transaccion = p_cod_transaccion
          AND gnoc.nro_documento3 = p_cod_ente
          AND gnoc.cod_moneda = p_cod_moneda
          AND trunc(gnoc.fec_insercion) = trunc(SYSDATE);
    elsif p_cod_tip_mensaje <> '214' then
       SELECT SUM(CASE WHEN gnoc.nro_cuenta = p_nro_cuenta THEN gnoc.monto ELSE 0 END),
              SUM(gnoc.monto)
         INTO v_aux_mto_tra_cuenta, v_aux_mto_tra_persona
         FROM ge_movimientos_noc gnoc
        WHERE gnoc.nro_cuenta IN
        (
          select a.nro_cuenta
            from ge_est_cuentas c,ge_cuentas a, ge_cta_clientes b
           where a.nro_cuenta = b.nro_cuenta
             and b.relacion in ('O','P','Y')
             and b.cod_persona = p_cod_persona
             and a.cod_modulo = c.cod_modulo
             and a.cod_modalidad = c.cod_modalidad
             and a.estado = c.estado
             and b.cod_modulo != 7
             and b.cod_modalidad <> 36
             and c.activo = 'S'  -- solo cuentas activas
             and a.estado <> 'X' -- pendiente de verificacion
             and a.cod_moneda = p_cod_moneda
        )
          AND gnoc.estado = 'N'
          AND gnoc.reversado = 'N'
          AND gnoc.cod_transaccion = p_cod_transaccion
          AND gnoc.cod_tra_padre = p_cod_tra_padre
          AND gnoc.cod_moneda = p_cod_moneda
          AND (p_cod_tip_mensaje NOT IN ('030','039') OR
               (p_cod_tip_mensaje = '039' AND gnoc.concepto LIKE 'Transf. a % desde %') OR
               (p_cod_tip_mensaje = '030' AND gnoc.concepto NOT LIKE 'Transf. a % desde %'
                                          AND gnoc.concepto NOT LIKE '% Ope. Cambio %')
              ) -- para diferenciar transferencias propias de terceros y pre-pactadas
          AND trunc(gnoc.fec_insercion) = trunc(SYSDATE);
    end if;

    p_mto_tra_cuenta   := p_mto_tra_cuenta + nvl(v_aux_mto_tra_cuenta, 0);
    p_mto_tra_persona  := p_mto_tra_persona + nvl(v_aux_mto_tra_persona, 0);

    -- ----------------------
    -- movimientos pendientes
    -- ----------------------
    SELECT SUM(CASE WHEN mpend.nro_cuenta = p_nro_cuenta THEN mpend.monto ELSE 0 END),
           SUM(mpend.monto)
      INTO v_aux_mto_tra_cuenta, v_aux_mto_tra_persona
      FROM bw_mov_pendientes mpend
     WHERE mpend.nro_cuenta IN
     (
      select a.nro_cuenta
        from ge_est_cuentas c,ge_cuentas a, ge_cta_clientes b
       where a.nro_cuenta = b.nro_cuenta
         and b.relacion in ('O','P','Y')
         and b.cod_persona = p_cod_persona
         and a.cod_modulo = c.cod_modulo
         and a.cod_modalidad = c.cod_modalidad
         and a.estado = c.estado
         and b.cod_modulo != 7
         and b.cod_modalidad <> 36
         and c.activo = 'S'  -- solo cuentas activas
         and a.estado <> 'X' -- pendiente de verificacion
         and a.cod_moneda = p_cod_moneda
     )
       AND mpend.cod_tip_mensaje = p_cod_tip_mensaje
       AND mpend.cod_moneda = p_cod_moneda
       AND mpend.estado = 'P'
       AND trunc(mpend.fec_insercion) = trunc(SYSDATE);

    p_mto_tra_cuenta   := p_mto_tra_cuenta + nvl(v_aux_mto_tra_cuenta, 0);
    p_mto_tra_persona  := p_mto_tra_persona + nvl(v_aux_mto_tra_persona, 0);

    -- ------------------------------------------------------------
    -- pago a proveedores puede tener movimientos aun no procesados
    -- ------------------------------------------------------------
    if p_cod_tip_mensaje = '075' then
       SELECT SUM(CASE WHEN pagpro.nro_cta_debito = p_nro_cuenta THEN pagpro.monto ELSE 0 END),
              SUM(pagpro.monto)
         INTO v_aux_mto_tra_cuenta, v_aux_mto_tra_persona
         FROM ge_pag_proveedores pagpro
        WHERE pagpro.cod_ente = p_cod_ente
          AND pagpro.cod_moneda = p_cod_moneda
          AND pagpro.estado = 'C'
          AND trunc(pagpro.fec_insercion) = trunc(sysdate);

       p_mto_tra_cuenta   := p_mto_tra_cuenta + nvl(v_aux_mto_tra_cuenta, 0);
       p_mto_tra_persona  := p_mto_tra_persona + nvl(v_aux_mto_tra_persona, 0);
    end if;

    -- -------------------------------------
    -- Transferencias con contrato de cambio
    -- -------------------------------------
    if p_cod_tip_mensaje = '214' then
       SELECT SUM(CASE WHEN lop.cta_ref_contra3 = p_nro_cuenta THEN lop.mto_contra3 ELSE 0 END),
              SUM(lop.mto_contra3)
         INTO v_aux_mto_tra_cuenta, v_aux_mto_tra_persona
         FROM lc_ope_pendientes lop
        WHERE lop.cta_ref_contra3 IN
        (
         select a.nro_cuenta
           from ge_est_cuentas c,ge_cuentas a, ge_cta_clientes b
          where a.nro_cuenta = b.nro_cuenta
            and b.relacion in ('O','P','Y')
            and b.cod_persona = p_cod_persona
            and a.cod_modulo = c.cod_modulo
            and a.cod_modalidad = c.cod_modalidad
            and a.estado = c.estado
            and b.cod_modulo != 7
            and b.cod_modalidad <> 36
            and c.activo = 'S'  -- solo cuentas activas
            and a.estado <> 'X' -- pendiente de verificacion
            and a.cod_moneda = p_cod_moneda
        )
          AND lop.liquidado = 'S'
          AND trunc(lop.fec_insercion) = trunc(sysdate);

       p_mto_tra_cuenta   := p_mto_tra_cuenta + nvl(v_aux_mto_tra_cuenta, 0);
       p_mto_tra_persona  := p_mto_tra_persona + nvl(v_aux_mto_tra_persona, 0);
    end if;
   end;

   FUNCTION fu_obtenerCalificacionRiesgo(p_sesion   IN VARCHAR2,
                                         p_codCanal IN VARCHAR2) RETURN typ_calificacionRiesgo IS
      -- datos a responder
      COD_OPERACION CONSTANT VARCHAR2(3) := '095';
      v_cat_riesgo ge_clientes.cat_riesgo%TYPE;
      v_retorno    typ_calificacionRiesgo := typ_calificacionRiesgo;
      userInfo     typ_validarSesion;
      v_riesgo       varchar2(50) := null ; -- Categoria de Riesgo
      v_fec_riesgo   varchar2(10) := null ;  -- Fecha de Riesgo

      v_fec_clasificacion date;
      v_logMessage VARCHAR2(1000);
      v_nro_documento  ba_personas.nro_documento%type;
      v_tip_documento  ba_tip_documentos.abreviatura%type;

   BEGIN
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- 1. valido la clave del cliente
      userinfo := fu_validarSesion(p_sesion, p_codCanal);
      --Logear parametros
      v_logMessage := 'ObtenerCalificacionRiesgo';
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

      IF (userInfo.error = 'S') THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
        /*Obtiene la informacion de parametros recibos y el return del type*/
        paw_log.g_typ_calificacionRiesgo := v_retorno;
        paw_log.pr_logValoresTypes('typ_calificacionRiesgo',
        'fu_obtenerCalificacionRiesgo'||' '||p_sesion||', '|| p_codCanal);
         RETURN v_retorno;
      END IF;

      BEGIN

          select p.nro_documento, d.abreviatura
            into v_nro_documento, v_tip_documento
            from ba_personas p, ba_tip_documentos d
           where p.cod_tip_documento = d.cod_tip_documento
             and cod_persona =
                 nvl(userInfo.codigoEmpresa, userInfo.codigoPersona);

          select fec_proceso, cla_sistema
            into v_fec_clasificacion, v_cat_riesgo
            from ge_bcp_clasificacion_his
           where nro_documento = v_nro_documento
             and tip_documento = v_tip_documento
             and fec_proceso =
                 (select max(fec_proceso)
                    from ge_bcp_clasificacion_his
                   where nro_documento = v_nro_documento
                     and tip_documento = v_tip_documento);

         --SDC SELECT pap_cat.fu_obt_cat_crc(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona), NULL, 'N'),
/*         SELECT pap_cat.FU_OBT_CAT_CLIENTE(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona), NULL),
                g.fec_ult_clasif
           INTO v_cat_riesgo,
                v_fec_clasificacion
           FROM ge_clientes g
          WHERE g.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona);*/
      EXCEPTION
         WHEN no_data_found THEN
            v_cat_riesgo := NULL;
         WHEN OTHERS THEN
            pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, NULL, 'obtCalificacionRiesgo -' || SQLERRM, BITACORA_ERROR);
           /*Obtiene la informacion de parametros recibos y el return del type*/
            paw_log.g_typ_calificacionRiesgo := v_retorno;
            paw_log.pr_logValoresTypes('typ_calificacionRiesgo',
            'fu_obtenerCalificacionRiesgo'||' '||p_sesion||', '|| p_codCanal);
            RETURN v_retorno;
      END;


      IF v_cat_riesgo IS NULL THEN
         v_cat_riesgo := 0;
         v_riesgo := 'SIN CALIFICACION';
         v_fec_riesgo := pag_cal.fu_obt_fec_actual(1);
      ELSE
         v_riesgo     := fue_obt_des_refcodes('CAT_RIESGO', v_cat_riesgo);
         v_fec_riesgo := v_fec_clasificacion;
      END IF;
      IF  LF_OBT_COD_ENTIDAD  != C_COD_OTR_ENTIDAD then
      v_retorno.calificacionRiesgo := v_cat_riesgo;
      v_retorno.fecha :=v_fec_riesgo;
      v_retorno.descripcionCalificacion:=v_riesgo;
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'ObtenerCalificacionRiesgo - cat:'|| v_cat_riesgo ||',fec:'||v_fec_riesgo ||',des:'||v_riesgo ||',' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      ELSE
      v_retorno.calificacionRiesgo :=0;
      v_retorno.fecha :=null;
      v_retorno.descripcionCalificacion:=null;
      END IF;
      RETURN v_retorno;
   END;

   /*FUNCTION fu_obtTransInternacional(p_sesion   IN VARCHAR2,
                                     p_codCanal IN VARCHAR2,
                                     p_inicio   IN DATE,
                                     p_fin      IN DATE) RETURN typ_detalleTransInternacional IS

      COD_OPERACION              CONSTANT VARCHAR2(3) := '086';
      MSG_OBTINFTRANSF_FINVALIDA CONSTANT VARCHAR2(15) := 'RANGOFEC_INVAL';
      MSG_OBTINFTRANSF_ERR_RANGO CONSTANT VARCHAR2(15) := 'RANGO_MUY_LARG';
      v_fec_desde      DATE;
      v_fec_hasta      DATE;
      v_can_detalles   NUMBER(3) := 0;
      userInfo         typ_validarSesion;
      v_logmessage     VARCHAR2(1000);
      v_sesion        bw_aut_sesiones.cod_sesion%type;
      v_codcanal     ge_canales.cod_canal%type;
      v_retorno        typ_detalleTransInternacional := typ_detalleTransInternacional;
      v_transferencia  typ_transferenciaInternacional := typ_transferenciaInternacional;

      -- variables
      CURSOR cabecera(p_fec_desde DATE, p_fec_hasta DATE) IS
         SELECT 'ENV' Tip_trans, a.nro_ref_externa nro_ref_externa, a.nro_cta_referencia nro_cta_referencia, 'ENVIADA AL SWIFT' Estado, a.monto monto, decode(a.cod_modalidad, 72, 'E', 'R') Tipo, nvl(a.nom_beneficiario, a.nom_ordenante) Beneficiario, a.nom_solicitante Solicitante, a.nro_operacion Operacion, a.fec_operacion Fec_operacion, a.nom_banco Banco,
                nvl((SELECT gb.descripcion
                       FROM ge_bancos gb
                      WHERE gb.cod_banco = a.cod_bco_corresponsal), a.cod_bco_corresponsal) Corresponsal, a.cod_moneda Moneda, a.fec_valor Fec_valor, a.msj_swift Swift
           FROM lc_transferencias a
          WHERE a.cod_modalidad = 72 -- Solo la modalidad de Transferencia enviada
            AND a.fec_operacion >= p_fec_desde
            AND a.fec_operacion <= p_fec_hasta
            AND a.cod_per_solicitante = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)
            AND a.estado = 'E' -- Solo los de estados Enviado al Swift
         UNION ALL
         SELECT 'REC' Tip_trans, a.nro_ref_externa nro_ref_externa, a.nro_cta_referencia nro_cta_referencia, 'PAGADA' Estado, a.monto monto, decode(a.cod_modalidad, 72, 'E', 'R') Tipo, nvl(a.nom_beneficiario, a.nom_ordenante) Beneficiario, a.nom_solicitante Solicitante, a.nro_operacion Operacion, a.fec_operacion Fec_operacion, a.nom_banco Banco,
                nvl((SELECT gb.descripcion
                       FROM ge_bancos gb
                      WHERE gb.cod_banco = a.cod_bco_corresponsal), a.cod_bco_corresponsal) Corresponsal, a.cod_moneda Moneda, a.fec_valor Fec_valor, a.msj_swift Swift
           FROM lc_transferencias a
          WHERE a.cod_modalidad = 75 -- Solo la modalidad de Trnasferencia Recibida
            AND a.fec_operacion >= p_fec_desde
            AND a.fec_operacion <= p_fec_hasta
            AND (a.cod_per_beneficiario = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona) OR a.nro_doc_beneficiario = (SELECT p.nro_documento
                                                                                                                             FROM ba_personas p
                                                                                                                            WHERE p.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona)))
            AND a.estado = 'OK' -- Solo los de estados Pagados
          ORDER BY fec_operacion, nro_cta_referencia;

      v_fec_actual DATE := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy

   BEGIN
      v_codcanal      := depurarAlfanumerico(p_codCanal,3);
      v_sesion        := depurarAlfanumerico(p_sesion,32);
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      -- 1. valido la clave del cliente
      userInfo := fu_validarSesion(v_sesion, v_codcanal);
      --Logear parametros
      v_logMessage := 'obtInfTransfInternacionales(sesion=*,codCanal=*,fechaDesde=' || p_inicio || ',fechaHasta=' || p_fin || ')';
      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

      IF (userInfo.error = 'S') THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;

      IF p_inicio IS NOT NULL THEN
         v_fec_desde := trim(p_inicio);
      ELSE
         v_fec_desde := v_fec_actual - 30;
         v_fec_hasta := v_fec_actual;
      END IF;

      IF p_fin IS NOT NULL THEN
         v_fec_hasta := trim(p_fin);
      END IF;

      IF v_fec_hasta < v_fec_desde THEN
         --retValue.codRespuesta:= paw_bce.v_fec_invalida ;
         pr_mensajeUsuario(MSG_OBTINFTRANSF_FINVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, ' Rango invalido -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      IF (v_fec_hasta - v_fec_desde) > 60 THEN
         --retValue.codRespuesta  := paw_bce.v_fec_exceso ;
         pr_mensajeUsuario(MSG_OBTINFTRANSF_ERR_RANGO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, 'Cuenta Inexistente -' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         RETURN v_retorno;
      END IF;

      v_retorno.listaTransferencias := typ_listaTransInternacional();

      FOR cb IN cabecera(v_fec_desde, v_fec_hasta) LOOP
         BEGIN
            v_can_detalles                          := v_can_detalles + 1;
            v_transferencia.tipoTransferencia       := substr(cb.tip_trans,0, 3);
            v_transferencia.numeroReferenciaExterna := substr(cb.nro_ref_externa,0, 20);
            v_transferencia.fechaOperacion          := cb.fec_operacion;
            v_transferencia.numeroCuentaReferencia  := substr(cb.nro_cta_referencia,0, 20);
            v_transferencia.estado                  := substr(cb.estado,0, 16);
            v_transferencia.codigoMoneda            := substr(cb.moneda,0, 3);
            v_transferencia.monto                   := cb.monto;
            v_transferencia.beneficiario            := substr(cb.beneficiario,0, 100);
            v_transferencia.solicitante             := substr(cb.solicitante,0, 100);
            v_transferencia.numeroOperacion         := cb.operacion;
            v_transferencia.nombreBancoCorresponsal := substr(cb.corresponsal,0, 100);
            v_transferencia.fechaValor              := cb.fec_valor;
            v_transferencia.mensajeSwift            := substr(cb.swift,0, 4000);

            v_retorno.listaTransferencias.extend;
            v_retorno.listaTransferencias(v_retorno.listaTransferencias.count) := v_transferencia;
         END;
      END LOOP;
      v_retorno.cantidadTransferencias := v_can_detalles;

      pr_insertarBitacora(userInfo.codigoPersona, p_codCanal, p_sesion, COD_OPERACION, userInfo.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
   EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(NULL, p_codCanal, NULL, COD_OPERACION, NULL, 'obtCheque -' || SQLERRM, BITACORA_ERROR);
     RETURN v_retorno;
   END;*/


/*FUNCTION fu_pagoServicioMovil(p_sesion             IN VARCHAR2,
                              p_codCanal           IN VARCHAR2,
                              p_numeroCuenta       IN VARCHAR2,
                              p_modo               IN VARCHAR2,
                              p_codigoServicio     IN NUMBER,
                              p_monto              IN NUMBER,
                              p_codigoMoneda       IN VARCHAR2,
                              p_numeroLote         IN VARCHAR2,
                              p_numeroOperacion    IN NUMBER,
                              p_mora               IN NUMBER,
                              p_comision           IN NUMBER,
                              p_codigoTerminal     IN NUMBER) RETURN typ_mensajeRespuesta IS

  v_nro_cuenta         varchar2(16); -- nro de cuenta
  v_modo               varchar2(3);  -- modo S/V/C
  v_cod_canal          varchar2(3);
  v_nro_transaccion    number(10);
  v_cod_servicio       number(5);
  v_monto              ge_cob_servicios.monto%type;
  v_cod_mon_servicio   varchar2(3);
  v_sesion             varchar2(32);
  v_bitacora           varchar2(600);
  v_fec_actual         date          := pag_cal.fu_obt_fec_actual(9);
  v_mto_destino        number(18,2);
  v_cod_mon_credito    ba_monedas.cod_moneda%type;
  v_cot_origen         ge_cotizaciones.val_conversion%type;
  v_cot_destino        ge_cotizaciones.val_conversion%type;
  v_cod_mon_debito     ba_monedas.cod_moneda%type;
  v_cod_mon_fuerte     ba_monedas.cod_moneda%type := pag_gen.fu_obt_mon_fuerte;
  v_mto_lim_canal      number(18,2);
  v_cot_lim_ori        ge_cotizaciones.val_compra%type;
  v_cot_lim_des        ge_cotizaciones.val_compra%type;
  v_cod_res_ser        varchar2(1000);
  v_nro_lote           varchar2(20);
  v_nro_ref_tra        number(10);
  v_mora               number(18,2);
  v_comision           number(18,2);
  v_hor_servicio       ge_movimientos.hora%type;
  v_fec_servicio       ge_movimientos.fecha%type;
  v_cod_terminal       number(10);

  retValidarSesion     typ_validarSesion;
  v_permiso            typ_obtenerPermisos;
  v_retorno            typ_mensajeRespuesta := typ_mensajeRespuesta;

  -- Errores
  c_tip_mensaje               constant varchar2(3) := '089';
  c_tra_err_conversion        constant varchar2(3) := '203';
  c_cod_lim_excedido          constant varchar2(3) := '250';
  c_cod_sin_autorizacion      constant varchar2(3) := '108';
  c_cod_cta_sin_saldo         constant varchar2(3) := '105';
  c_cod_otr_error             constant varchar2(3) := '199';
  c_ses_movil                 constant varchar2(10) := 'Smartphone';

  function lf_obt_nro_transaccion
    return number
    is
  v_nro  ge_cob_servicios.nro_operacion%type;
  begin
    select max(nro_operacion) + 1
      into v_nro
      from ge_cob_servicios l
     where l.cod_servicio = '33'
       and l.tip_cobro = 'E';
      return v_nro;
  end;


  BEGIN
    pre_cam_for_numerico('.,');
    v_cod_canal        := depurarAlfanumerico(p_codCanal,3);
    v_sesion           := depurarAlfanumerico(p_sesion,32);
    IF v_ind_cta_encriptada = 'S' THEN
       v_nro_cuenta       := fu_desencriptacionCuentas(depurarCuenta(p_numeroCuenta,CUENTA_TAMANO));
    ELSE
      v_nro_cuenta       := depurarCuenta(p_numeroCuenta,CUENTA_TAMANO);
    END IF;
    v_modo             := depurarAlfanumerico(p_modo,1);
    v_cod_servicio     := depurarNumerico(p_codigoServicio,5);
    v_monto            := depurarNumerico(p_monto,18);
    v_cod_mon_servicio := depurarAlfanumerico(p_codigoMoneda,3);

    v_nro_lote         := depurarAlfanumerico(p_numeroLote,20);
    v_nro_ref_tra      := depurarNumerico(p_numeroOperacion,10);
    v_mora             := depurarNumerico(p_mora,18);
    v_comision         := depurarNumerico(p_comision,18);
    v_cod_terminal     := depurarNumerico(p_codigoTerminal,10);

    v_bitacora         := ' - Cod Canal: ' || v_cod_canal || ' - Nro de Cta: ' || v_nro_cuenta ||'- Cod. Servicio: '|| v_cod_servicio||
                          ' - Nro. Transaccion: ' || v_nro_ref_tra || ' - Modo: ' || v_modo || ' - Monto: ' || v_monto||' - Moneda: '||v_cod_mon_servicio||
                          ' - Terminal: '||v_cod_terminal;

    pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
    retValidarSesion := fu_validarSesion(v_sesion, v_cod_canal);
    pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, c_tip_mensaje, retValidarSesion.codigoEmpresa, ' - fu_pagoServicioMovil '||v_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ENTRADA);

    IF retValidarSesion.error = 'S' THEN
       v_retorno.error           := retValidarSesion.error;
       v_retorno.nombreRespuesta := retValidarSesion.nombreRespuesta;
       v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
       RETURN v_retorno;
    END IF;

    -- Verifico si el cliente con su perfil tendra acceso a realizar la transaccion
    v_permiso := lf_obt_permisos(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), retValidarSesion.codigoPerfil, v_tip_mensaje, v_cod_canal);
    IF v_permiso.error = 'S' THEN
       pr_mensajeUsuario(c_cod_sin_autorizacion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, c_tip_mensaje, retValidarSesion.codigoEmpresa, fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null) || v_bitacora, BITACORA_ERROR);
       RETURN v_retorno;
    END IF;

    -- 1. valido la clave del cliente
    if v_cod_mon_servicio = 'PYG' then
       v_cod_mon_servicio := 1;
    elsif v_cod_mon_servicio = 'USD' then
       v_cod_mon_servicio := 2;
    end if;
    if v_modo in ('V','C') then
       pag_cta.PR_OBT_CUENTA(v_nro_cuenta);
       v_cod_mon_debito := pag_cta.G_CTAS.COD_MONEDA;
       v_cod_mon_credito := v_cod_mon_local;
       if v_cod_mon_servicio = 2  then --moneda fuerte
          v_cod_mon_credito := v_cod_mon_fuerte;
       end if;

       begin
         lp_con_mon_a_moneda(v_cod_mon_credito
                            ,v_cod_mon_debito
                            ,v_monto
                            ,v_mto_destino
                            ,v_cot_origen
                            ,v_cot_destino);
       exception
          when others then
            pr_mensajeUsuario(c_tra_err_conversion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, c_tip_mensaje, NULL, ' fu_pagoServicioMovil - Conversion Monedas -Mon. Origen: '||v_cod_mon_credito||' -Mon. Destino: '||v_cod_mon_debito||' -Mto. Origen: '||v_monto||' '
                                ||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
            return v_retorno;
       end;

       -- validacion de limite
       if fu_es_ope_limitadas(c_tip_mensaje, v_nro_cuenta, v_cod_canal, v_fec_actual) = 'S' then
          begin
            lp_con_mon_a_moneda(v_cod_mon_debito
                               ,v_cod_mon_fuerte
                               ,v_mto_destino
                               ,v_mto_lim_canal
                               ,v_cot_lim_ori
                               ,v_cot_lim_des);

          exception
           when others then
             pr_mensajeUsuario(c_tra_err_conversion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, c_tip_mensaje, NULL, ' fu_pagoServicioMovil Control Limite - Mon. Origen: '||v_cod_mon_debito ||' - Mto. Origen: '||v_mto_destino||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
             return v_retorno;
          end;
       end if;
     end if;
     if v_modo = 'V' then

         if fu_val_monto(v_mto_lim_canal, v_cod_mon_fuerte, c_tip_mensaje, v_nro_cuenta, v_cod_canal, v_fec_actual) = 'N' then
             pr_mensajeUsuario(c_cod_lim_excedido, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, c_tip_mensaje, NULL, ' fu_pagoServicioMovil Control Limite '||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR,
                                 retValidarSesion.numeroTelefono, '-36',null, null,v_nro_cuenta,null,v_mto_lim_canal,v_cod_mon_fuerte);

             return v_retorno;

         else
            v_nro_transaccion := lf_obt_nro_transaccion;
            v_cod_res_ser := pag_ser.fu_aut_pago(c_ses_movil         -- session
                                                ,v_cod_servicio      -- servicio
                                                ,v_nro_cuenta        -- Cuemta
                                                ,null                -- Fecha
                                                ,null                -- Hora
                                                ,v_nro_transaccion   -- Nro. de Operacion
                                                ,null                -- Lote
                                                ,retValidarSesion.numeroTelefono -- Telefono o Id del Dispositivo
                                                ,v_sesion            -- Teminal
                                                ,v_cod_mon_servicio  -- Moneda
                                                ,v_monto             -- Importe
                                                ,null                -- Comision
                                                ,null                -- Mora
                                                ,null                -- Interes
                                                );
         end if;
    elsif v_modo = 'C' then

          begin
           select a.fecha, a.hora, a.nro_operacion
             into v_fec_servicio, v_hor_servicio, v_nro_transaccion
             from ge_cob_servicios a
            where a.referencia2 = v_sesion
              and nvl(a.referencia3,'N') = 'N'
              and a.cod_servicio = 33
              and a.nro_cta_debito = v_nro_cuenta
              and a.monto          = v_monto
              and a.referencia1    = retValidarSesion.numeroTelefono;
          exception
            when others then
               v_fec_servicio := null;
               v_hor_servicio := null;
          end;

         update ge_cob_servicios a
            set a.referencia2 = v_cod_terminal,
                a.referencia5 = v_nro_lote,
                a.referencia6 = v_nro_ref_tra,
                a.ref_numerico1 = v_mora,
                a.mto_comision  = v_comision
          where a.referencia2 = v_sesion
            and nvl(a.referencia3,'N') = 'N'
            and a.cod_servicio = 33
            and a.nro_cta_debito = v_nro_cuenta
            and a.monto          = v_monto
            and a.referencia1    = retValidarSesion.numeroTelefono;

         -- actualizar el nro documento enviado por PRONET en GE_MOVIMIENTOS
         update ge_movimientos a
            set a.nro_documento2 = a.nro_documento,
                a.nro_documento = v_nro_ref_tra
          where a.nro_documento = v_nro_transaccion
            and a.monto = v_monto
            and a.fecha = v_fec_servicio
            and a.hora  = v_hor_servicio
            and a.concepto like '%serv.%'
            and a.cod_usuario = 'MOB';
            if sql%notfound then
               update ge_movimientos_noc a
                  set a.nro_documento2 = a.nro_documento,
                      a.nro_documento = v_nro_ref_tra
                where a.nro_documento = v_nro_transaccion
                  and a.monto = v_monto
                  and a.fecha = v_fec_servicio
                  and a.hora  = v_hor_servicio
                  and a.concepto like '%serv.%'
                  and a.cod_usuario = 'MOB';
            end if;

       if fu_es_ope_limitadas(c_tip_mensaje , v_nro_cuenta, v_cod_canal, v_fec_actual) = 'S' then
              pr_gen_monto(c_tip_mensaje
                          ,v_mto_lim_canal
                          ,v_cod_mon_fuerte
                          ,v_nro_cuenta
                          ,v_fec_actual
                          ,v_cod_canal);
       end if;
       return v_retorno;
    elsif v_modo = 'R' then
       begin
         select a.nro_operacion
           into v_nro_transaccion
           from ge_cob_servicios a
          where a.referencia2 = v_sesion
            and nvl(a.referencia3,'N') = 'N'
            and a.cod_servicio = 33
            and a.nro_cta_debito = v_nro_cuenta
            and a.monto          = v_monto
            and a.referencia1    = retValidarSesion.numeroTelefono;
       exception
            when others then
               v_nro_transaccion := null;
       end;

       \*v_cod_res_ser := pag_ser.fu_rev_pago(v_nro_lote
                                           ,v_nro_transaccion
                                           ,retValidarSesion.numeroTelefono
                                           ,v_monto
                                           ,v_nro_cuenta
                                           ,v_cod_canal);*\
    end if;
    if v_modo in ('V','R') then
       if substr (v_cod_res_ser,1,5) = '0~OK~' then
          pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, c_tip_mensaje, retValidarSesion.codigoEmpresa,' - fu_pagoServicioMovil '||v_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_SALIDA);
       else
          if instr(upper(v_cod_res_ser),'INSUFIC') > 0 then
             pr_mensajeUsuario(c_cod_cta_sin_saldo, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, c_tip_mensaje, retValidarSesion.codigoEmpresa,' - fu_pagoServicioMovil '||v_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
          else
             pr_mensajeUsuario(c_cod_otr_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal, v_sesion, c_tip_mensaje, retValidarSesion.codigoEmpresa,' - fu_pagoServicioMovil '||v_bitacora||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null ), BITACORA_ERROR);
          end if;
       end if;
    else
       return v_retorno;
    end if;
    commit;
    return v_retorno;
  exception
    when others then
       raise_application_error(-20005,sqlerrm);
  end;*/

 /* FUNCTION fu_obtenerSaldosCuenta(p_sesion    IN VARCHAR2,
                                  p_codCanal  IN VARCHAR2,
                                  p_nroCuenta IN VARCHAR2,
                                  p_dias      IN NUMBER)
    RETURN typ_saldosCuentas IS

    v_tip_mensaje       VARCHAR2(3) := '300';
    v_moneda            VARCHAR2(3);
    v_nroCuenta         VARCHAR2(16);
    v_sesion            VARCHAR2(32);
    v_can_detalles      NUMBER(3) := 0; -- cantidad de registros
    v_dias              NUMBER(3):= 0;
    v_fecDesde          DATE;
    v_codCanal          bw_aut_sesiones.cod_canal%type;
    v_listaSaldosCuenta typ_listaSaldosCuenta := typ_listaSaldosCuenta();
    v_retorno           typ_saldosCuentas := typ_saldosCuentas;
    menRespuesta        typ_mensajeRespuesta := typ_mensajeRespuesta;
    retValidarSesion    typ_validarSesion;

    --Codigos de error
    MSG_CTA_INEXISTENTE CONSTANT VARCHAR2(15) := 'G_NROCTAINVALID';
    MSG_CTA_NO_CORRESP  CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND';
    MSG_VAL_CAN_DIAS    CONSTANT VARCHAR2(3)  := '263';

    CURSOR ahorros(p_fecDesde DATE) IS
      SELECT nro_cuenta,
             ano,
             mes,
             SUM(CASE
                   WHEN can_dia_acumulado > 0 THEN
                    sal_acu_diario / can_dia_acumulado
                   ELSE
                    sal_acu_diario
                 END) saldo
        FROM ah_sal_mensuales
       WHERE nro_cuenta = v_nroCuenta
         AND to_date(to_char(fec_insercion, 'dd/mm/yyyy'), 'dd/mm/yyyy') BETWEEN
             to_date(to_char(p_fecDesde, 'dd/mm/yyyy'), 'dd/mm/yyyy') AND
             trunc(pag_cal.FU_OBT_FEC_ACTUAL(3))
       GROUP BY nro_cuenta, ano, mes
       ORDER BY ano DESC, mes DESC;

    CURSOR tarjetas(p_fecDesde DATE) IS
      SELECT nro_cuenta,
             ano,
             mes,
             SUM(sal_financiado + sal_facturado + sal_facturar) saldo
        FROM ta_sal_mensuales
       WHERE nro_cuenta = v_nroCuenta
        AND to_date(to_char(fec_insercion, 'dd/mm/yyyy'), 'dd/mm/yyyy') BETWEEN
             to_date(to_char(p_fecDesde, 'dd/mm/yyyy'), 'dd/mm/yyyy') AND
             trunc(pag_cal.FU_OBT_FEC_ACTUAL(3))
       GROUP BY nro_cuenta, ano, mes
       ORDER BY ano DESC, mes DESC;

    CURSOR ctacte(p_fecDesde DATE) IS
      SELECT c.nro_cuenta,
             c.ano,
             c.mes,
             SUM(CASE
                   WHEN c.can_dia_acumulado > 0 THEN
                    c.sal_acu_diario / c.can_dia_acumulado
                   ELSE
                    c.sal_acu_diario
                 END) saldo
        FROM cc_sal_mensuales c
       WHERE c.nro_cuenta = v_nroCuenta
         AND trunc(fec_insercion) BETWEEN trunc(p_fecDesde) AND
             trunc(pag_cal.FU_OBT_FEC_ACTUAL(3))
       GROUP BY c.nro_cuenta, c.ano, c.mes
       ORDER BY c.ano DESC, c.mes DESC;

  BEGIN
    v_sesion   := depurarAlfanumerico(p_sesion,32);
    v_codCanal :=  depurarAlfanumerico(p_codCanal,3);
    v_dias     := depurarNumerico(p_dias,3);
  --valido la sesion del cliente
    retValidarSesion := fu_validarSesion(p_sesion, v_codCanal);

    IF retValidarSesion.error = 'S' THEN
      v_retorno.error                := retValidarSesion.error;
      v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
      v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
      \*Obtiene la informacion de parametros recibos y el return del type*\
      paw_log.g_typ_saldosCuentas := v_retorno;
      paw_log.pr_logValoresTypes('typ_saldosCuentas',
      'fu_obtenerSaldosCuenta'||' '||v_sesion||', '|| v_codCanal||', '||  p_nroCuenta||', '|| p_dias);
      RETURN v_retorno;
    END IF;
    IF v_ind_cta_encriptada = 'S' THEN
       v_nroCuenta := fu_desencriptacionCuentas(trim(p_nroCuenta));
    ELSE
       v_nroCuenta := trim(p_nroCuenta);
    END IF;
    --Valida que la cuenta corresponda al cliente
    IF lf_val_cta_origen(v_nroCuenta, nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona)) = 'N' THEN
       pr_mensajeUsuario(MSG_CTA_NO_CORRESP,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
       menRespuesta.error                := v_retorno.error;
       menRespuesta.nombreRespuesta      := v_retorno.nombreRespuesta;
       menRespuesta.descripcionRespuesta := v_retorno.descripcionRespuesta;
       pr_insertarBitacora(retValidarSesion.codigoPersona,p_codCanal,p_sesion,v_tip_mensaje,
                          retValidarSesion.codigoEmpresa,fu_generarBitacora(menRespuesta.error,
                                                                            menRespuesta.nombreRespuesta,
                                                                            menRespuesta.descripcionRespuesta,null),
                          BITACORA_ERROR);


       \*Obtiene la informacion de parametros recibos y el return del type*\
       paw_log.g_typ_saldosCuentas := v_retorno;
       paw_log.pr_logValoresTypes('typ_saldosCuentas',
       'fu_obtenerSaldosCuenta'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta||', '|| p_dias);

       RETURN v_retorno;
    END IF;

    IF nvl(v_dias,0)=0 then
      pr_mensajeUsuario(MSG_VAL_CAN_DIAS,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,v_retorno.error);
      menRespuesta.error                := v_retorno.error;
      menRespuesta.nombreRespuesta      := v_retorno.nombreRespuesta;
      menRespuesta.descripcionRespuesta := v_retorno.descripcionRespuesta;
      pr_insertarBitacora(retValidarSesion.codigoPersona,p_codCanal,p_sesion,v_tip_mensaje,
                          retValidarSesion.codigoEmpresa,fu_generarBitacora(menRespuesta.error,menRespuesta.nombreRespuesta,menRespuesta.descripcionRespuesta,null),
                          BITACORA_ERROR);

       \*Obtiene la informacion de parametros recibos y el return del type*\
       paw_log.g_typ_saldosCuentas := v_retorno;
       paw_log.pr_logValoresTypes('typ_saldosCuentas',
       'fu_obtenerSaldosCuenta'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta||', '|| p_dias);
       RETURN v_retorno;

    END IF;

    pr_mensajeUsuario(MSG_OK,
                      v_retorno.nombreRespuesta,
                      v_retorno.descripcionRespuesta,
                      v_retorno.error);
    pr_insertarBitacora(retValidarSesion.codigoPersona,
                        p_codCanal,
                        p_sesion,
                        v_tip_mensaje,
                        retValidarSesion.codigoEmpresa,
                        'Obtener Saldos Cuenta - Nro Cta:' || p_nroCuenta ||
                        fu_generarBitacora(retValidarSesion.error,
                                           retValidarSesion.nombreRespuesta,
                                           retValidarSesion.descripcionRespuesta,
                                           null),
                        BITACORA_ENTRADA);

    --obtengo la moneda del nro de cuenta
    BEGIN
      SELECT x.cod_moneda
        INTO v_moneda
        FROM ge_cuentas x
       WHERE x.nro_cuenta = v_nroCuenta;
    EXCEPTION
      WHEN no_data_found THEN
        pr_mensajeUsuario(MSG_CTA_INEXISTENTE,
                          v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta,
                          v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona,
                            p_codCanal,
                            p_sesion,
                            v_tip_mensaje,
                            retValidarSesion.codigoEmpresa,
                            'Obtener Saldos Cuenta Ahorros - Nro Cta: ' ||
                            p_nroCuenta ||
                            fu_generarBitacora(retValidarSesion.error,
                                               retValidarSesion.nombreRespuesta,
                                               retValidarSesion.descripcionRespuesta,
                                               null),
                            BITACORA_ERROR);

        \*Obtiene la informacion de parametros recibos y el return del type*\
        paw_log.g_typ_saldosCuentas := v_retorno;
        paw_log.pr_logValoresTypes('typ_saldosCuentas',
        'fu_obtenerSaldosCuenta'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta||', '|| p_dias);
        RETURN v_retorno;
      WHEN OTHERS THEN
        pr_mensajeUsuario(MSG_ERROR,
                          v_retorno.nombreRespuesta,
                          v_retorno.descripcionRespuesta,
                          v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona,
                            p_codCanal,
                            p_sesion,
                            v_tip_mensaje,
                            retValidarSesion.codigoEmpresa,
                            'Obtener Saldos Cuenta Ahorros - Nro Cta: ' ||
                            p_nroCuenta ||
                            fu_generarBitacora(retValidarSesion.error,
                                               retValidarSesion.nombreRespuesta,
                                               retValidarSesion.descripcionRespuesta,
                                               null),
                            BITACORA_ERROR);

        \*Obtiene la informacion de parametros recibos y el return del type*\
        paw_log.g_typ_saldosCuentas := v_retorno;
        paw_log.pr_logValoresTypes('typ_saldosCuentas',
        'fu_obtenerSaldosCuenta'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta||', '|| p_dias);

        RETURN v_retorno;
    END;

    --calculo de la fecha desde
    v_fecDesde := SYSDATE - v_Dias;

    --ahorros
    FOR ah IN ahorros(v_fecDesde) LOOP
      DECLARE
        detalleSaldoCuenta typ_SaldoCuenta := typ_saldoCuenta;
      BEGIN
        v_can_detalles            := v_can_detalles + 1;
        detalleSaldoCuenta.saldo  := ah.saldo;
        detalleSaldoCuenta.anho   := ah.ano;
        detalleSaldoCuenta.mes    := ah.mes;
        detalleSaldoCuenta.moneda := v_moneda;

        v_listaSaldosCuenta.extend;
        v_listaSaldosCuenta(v_listaSaldosCuenta.count) := detalleSaldoCuenta;

      EXCEPTION
        WHEN OTHERS THEN
          pr_mensajeUsuario(MSG_ERROR,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);

          pr_insertarBitacora(retValidarSesion.codigoPersona,
                              p_codCanal,
                              p_sesion,
                              v_tip_mensaje,
                              retValidarSesion.codigoEmpresa,
                              'Obtener Saldos Cuenta Ahorros - Nro Cta: ' ||
                              p_nroCuenta || SQLERRM ||
                              fu_generarBitacora(retValidarSesion.error,
                                                 retValidarSesion.nombreRespuesta,
                                                 retValidarSesion.descripcionRespuesta,
                                                 null),
                              BITACORA_ERROR);

          \*Obtiene la informacion de parametros recibos y el return del type*\
          paw_log.g_typ_saldosCuentas := v_retorno;
          paw_log.pr_logValoresTypes('typ_saldosCuentas',
          'fu_obtenerSaldosCuenta'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta||', '|| p_dias);
          RETURN v_retorno;
      END;
    END LOOP;

    --tarjetas
    FOR tj IN tarjetas(v_fecDesde) LOOP
      DECLARE
        detalleSaldoCuenta typ_SaldoCuenta := typ_saldoCuenta;
      BEGIN
        v_can_detalles            := v_can_detalles + 1;
        detalleSaldoCuenta.saldo  := tj.saldo;
        detalleSaldoCuenta.anho   := tj.ano;
        detalleSaldoCuenta.mes    := tj.mes;
        detalleSaldoCuenta.moneda := v_moneda;

        v_listaSaldosCuenta.extend;
        v_listaSaldosCuenta(v_listaSaldosCuenta.count) := detalleSaldoCuenta;

      EXCEPTION
        WHEN OTHERS THEN
          pr_mensajeUsuario(MSG_ERROR,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona,
                              p_codCanal,
                              p_sesion,
                              v_tip_mensaje,
                              retValidarSesion.codigoEmpresa,
                              'Obtener Saldos Cuenta Tarjetas - Nro Cta:' ||
                              p_nroCuenta || SQLERRM ||
                              fu_generarBitacora(retValidarSesion.error,
                                                 retValidarSesion.nombreRespuesta,
                                                 retValidarSesion.descripcionRespuesta,
                                                 null),
                              BITACORA_ERROR);
      END;
    END LOOP;

    --cuenta corriente
    FOR cc IN ctacte(v_fecDesde) LOOP
      DECLARE
        detalleSaldoCuenta typ_SaldoCuenta := typ_saldoCuenta;
      BEGIN
        v_can_detalles            := v_can_detalles + 1;
        detalleSaldoCuenta.saldo  := cc.saldo;
        detalleSaldoCuenta.anho   := cc.ano;
        detalleSaldoCuenta.mes    := cc.mes;
        detalleSaldoCuenta.moneda := v_moneda;
        v_listaSaldosCuenta.extend;
        v_listaSaldosCuenta(v_listaSaldosCuenta.count) := detalleSaldoCuenta;

      EXCEPTION
        WHEN OTHERS THEN
          pr_mensajeUsuario(MSG_ERROR,
                            v_retorno.nombreRespuesta,
                            v_retorno.descripcionRespuesta,
                            v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona,
                              p_codCanal,
                              p_sesion,
                              v_tip_mensaje,
                              retValidarSesion.codigoEmpresa,
                              'Obtener Saldos Cuenta Cta Cte - Nro Cta:' ||
                              p_nroCuenta || SQLERRM ||
                              fu_generarBitacora(retValidarSesion.error,
                                                 retValidarSesion.nombreRespuesta,
                                                 retValidarSesion.descripcionRespuesta,
                                                 null),
                              BITACORA_ERROR);

          \*Obtiene la informacion de parametros recibos y el return del type*\
          paw_log.g_typ_saldosCuentas := v_retorno;
          paw_log.pr_logValoresTypes('typ_saldosCuentas',
          'fu_obtenerSaldosCuenta'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta||', '|| p_dias);
          RETURN v_retorno;
      END;
    END LOOP;

    IF v_retorno.error = 'N' THEN
      v_retorno.cantidad      := v_can_detalles;
      v_retorno.saldosCuentas := v_listaSaldosCuenta;
    END IF;
    \*Obtiene la informacion de parametros recibos y el return del type*\
    paw_log.g_typ_saldosCuentas := v_retorno;
    paw_log.pr_logValoresTypes('typ_saldosCuentas',
    'fu_obtenerSaldosCuenta'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta||', '|| p_dias);

    RETURN v_retorno;
  EXCEPTION
    WHEN OTHERS THEN
      pr_mensajeUsuario(MSG_ERROR,
                        v_retorno.nombreRespuesta,
                        v_retorno.descripcionRespuesta,
                        v_retorno.error);
      pr_insertarBitacora('0',
                          p_codCanal,
                          p_sesion,
                          v_tip_mensaje,
                          NULL,
                          'Obtener Saldos Cuenta - Nro Cta:' || p_nroCuenta ||
                          SQLERRM,
                          BITACORA_ERROR);

      \*Obtiene la informacion de parametros recibos y el return del type*\
      paw_log.g_typ_saldosCuentas := v_retorno;
      paw_log.pr_logValoresTypes('typ_saldosCuentas',
       'fu_obtenerSaldosCuenta'||' '||p_sesion||', '|| p_codCanal||', '||  p_nroCuenta||', '|| p_dias);

      RETURN v_retorno;
  END;
*/
