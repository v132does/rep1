                     v_cod_per_cumplimiento := fug_snp_val_cumplimiento(v_nro_referencia);
                     if v_cod_per_cumplimiento is not null then
                        --Inicia Workflow solo si el cliente tiene cumplimiento y no haya superado el monto limite para transferencias emitidas
                        if v_retorno.error = 'N' and
                           not v_lim_excedido
                        then
                           begin
                              prs_snp_ini_cir_advertencia( v_nro_referencia );
                           exception
                             when others then
                               pr_mensajeUsuario(c_con_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                               pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                               return v_retorno;
                           end;
                        end if;
                     end if;
                   end if;*/
                   if v_retorno.error = 'N' then
                         /*Inserta el motivo, fondo y financiacion de la transferencia en BA_TAB_DAT_ADICIONALES
                         si ha iniciado circuito de workflow o no*/
                         v_tab_relacion := 'GE_SNP_TRANSFERENCIAS';
                         Begin
                            insert into ba_tab_dat_adicionales (tab_relacion, referencia,parametro,val_parametro)
                            values(v_tab_relacion, v_nro_referencia, 'SIB_TRA_MOTIVO', v_motivo);

                            insert into ba_tab_dat_adicionales (tab_relacion, referencia,parametro,val_parametro)
                            values (v_tab_relacion, v_nro_referencia, 'SIB_TRA_FINANCIACION', v_financia);

                            insert into ba_tab_dat_adicionales (tab_relacion, referencia,parametro,val_parametro)
                            values (v_tab_relacion, v_nro_referencia, 'SIB_TRA_FONDO', v_fondo);
                         exception
                           when dup_val_on_index then
                             paw_bem.pr_mensajeUsuario(c_dup_dat_adicionales, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                             paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -'|| sqlerrm || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                             prg_rol_savepoint('sipap');
                             --borrar transf
                             if v_elimina then --HA-3690
                                pr_del_snp_transferencias(v_nro_referencia);
                             end if;							 
                             return v_retorno;
                           when others then
                             paw_bem.pr_mensajeUsuario(c_ins_dat_adicionales, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                             paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || sqlerrm|| paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                             prg_rol_savepoint('sipap');
                             --borrar transf
                             if v_elimina then --HA-3690
                                pr_del_snp_transferencias(v_nro_referencia);
                             end if;							 
                             return v_retorno;
                            end;
                                           /*
                       || Aprueba Todos los de la Web
                       || en caso que no se haya iniciado circuito por cumplimiento
                       || o por exceso en monto limite de transferencias por cliente
                       */
                       v_estado := NULL;
                       /*if v_cod_per_cumplimiento is null and
                          not v_lim_excedido
                       then
                          v_estado := 'A';
                       end if;*/
                       If v_retorno.error = 'N' then
                         if  r_gtran.cod_msj_swift = fug_obt_pardinamico( 'COD_SPI_PCD' ) and   nvl(v_tra_spi,'N') = 'S' and nvl(v_tra_spi_ind,'N') = 'C'/*cancelar*/ then
                           v_estado := 'R';
                           v_situacion:='C';
                          elsif  r_gtran.cod_msj_swift = fug_obt_pardinamico( 'COD_SPI_PCD' ) and   nvl(v_tra_spi,'N') = 'S' and  v_es_mov_noc = 'N' and nvl(v_tra_spi_ind,'N') not in ('C','R')/*no sean Cancelar y redireccionar*/ AND r_gtran.fec_valor =trunc(sysdate)/*DA-7772*/ then

                           v_estado := 'U';
                         else
                           v_estado := 'A';
                         end if;

                           -- Actualiza el Estado y le agrega el Mensaje Swift generado
                         update ge_snp_transferencias gt
                            set gt.msj_swift = v_msj_swift,
                                gt.estado = nvl( v_estado, gt.estado ),
                                gt.situacion=nvl( v_situacion, gt.situacion ),
                                gt.error= CASE  WHEN v_estado='R' and v_situacion='C' THEN
                                'Transferencia cancelada por entidad emisora fuera de SPI'
                                ELSE  gt.error END
                          where gt.nro_referencia = v_nro_referencia
                            and gt.cod_msj_swift = r_gtran.cod_msj_swift;
                         if sql%notfound then
                            paw_bem.pr_mensajeUsuario(c_con_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                            paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                            prg_rol_savepoint('sipap');
                            --borrar transf.
                            if v_elimina then --HA-3690
                               pr_del_snp_transferencias(v_nro_referencia);
                            end if;							
                            return v_retorno;
                         end if;
                     end if;
                     if v_retorno.error = 'N' then
                           pas_snp.pr_obt_mensaje( v_nro_referencia, 'N' );
                           if pag_cta.fu_obt_cod_error <> 0 then
                              paw_bem.pr_mensajeUsuario(c_con_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                              paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                              prg_rol_savepoint('sipap');
                              return v_retorno;
                           end if;
                     end if;

                   end if;
                  if pae_cnf.fu_obt_est_modulo(3) IN (1,6) then----DA-7022

                       paw_bem.pr_mensajeUsuario(c_op_error , v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                       paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Modulo en estado 1 o 6:' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                       prg_rol_savepoint('sipap');
                       --borrar transf
                       if v_elimina then --HA-3690
                          pr_del_snp_transferencias(v_nro_referencia);
                       end if;					   
                       return v_retorno;
                    end if;
                 --Graba en mov nocturno para transferencias SPI
                 if v_es_mov_noc ='S' and  r_gtran.cod_msj_swift = fug_obt_pardinamico( 'COD_SPI_PCD' ) and   nvl(v_tra_spi,'N') ='S' and  nvl(v_tra_spi_ind,'N') not in ('C','R') then-- que no sean cancelar y redireccionar

                   prg_gen_mov_noc_spi(v_mto_debito,
                                       v_nro_cta_debito,
                                       v_cta_pte_solicitante,
                                       v_cod_mon_debito,
                                       r_gtran.cod_msj_swift,
                                       r_gtran.cod_tip_operacion,
                                       r_gtran.cod_sub_tip_operacion,
                                       v_nro_referencia,
                                       r_gtran.nro_ref_externa,
                                       v_cod_swift,
                                       'E',
                                       'N',
                                       null,
                                       null,
                                       null,
                                       null,
                                       null,
                                       v_cod_respuesta,
                                       v_desc_respuesta);


                         IF v_cod_respuesta=91 then --en cierre --DA-7022

                            paw_bem.pr_mensajeUsuario(c_op_error , v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                            paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Modulo en estado 1 o 6:' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                            prg_rol_savepoint('sipap');
                            --borrar transf --HA-3690
                            if v_elimina then 
                                pr_del_snp_transferencias(v_nro_referencia);
                            end if;							
                       return v_retorno;
                         elsif v_cod_respuesta != 0 THEN

                           v_retorno.nombreRespuesta:=v_desc_respuesta;
                           v_retorno.descripcionRespuesta:=v_desc_respuesta;
                           v_retorno.error:=v_cod_respuesta;
                           paw_bem.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                           paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error );
                           prg_rol_savepoint('sipap');
                           --borrar transf
                           if v_elimina then --HA-3690
                              pr_del_snp_transferencias(v_nro_referencia);
                           end if;						   
                           return v_retorno;
                         END IF;
                 elsif nvl(v_tra_spi_ind,'N') <>'C' then--que no sea cancelar la transferencia
                 -- Genera el Movimiento y envia el mensaje a BCP si la fecha es actual y esta activo
                 if v_retorno.error = 'N' and
                    r_gtran.fec_valor = r_gtran.fec_ingreso and
                   ( pas_snp.fu_obt_fec_ult_operacion = r_gtran.fec_valor and nvl(v_tra_spi,'N') <> 'S') or (v_tra_spi='S' and r_gtran.fec_valor = trunc(sysdate)) /*DA-7772*/

                 then
                    if pas_snp.fu_obt_est_horario( r_gtran.cod_msj_swift,
