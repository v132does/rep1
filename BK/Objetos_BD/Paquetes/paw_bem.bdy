                       paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Modulo en estado 1 o 6:' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                       prg_rol_savepoint('sipap');
                       --borrar transf --HA-3690
                       if v_elimina then 
                          pr_del_snp_transferencias(v_nro_referencia);
                       end if;					   
                       return v_retorno;
                   end if;
                    -- Registrar movimientos de Debito al CLIENTE
                    pag_cta.g_horario := 'D';
                    pag_cta.pr_act_operacion(v_nro_cta_debito ,     -- Nro.Cta.
                                             v_hor_actual,          -- Hora
                                             'D',                   -- Tip.Mov.
                                             v_cod_mon_debito,      -- Cod.Mon.
                                             v_mto_debito,          -- Monto
                                             v_cod_tra_padre,       -- Trx.Padre
                                             v_cod_tra_debito,      -- Trx.Hija
                                             v_nro_referencia,      -- Nro.Doc.
                                             v_cot_debito,          -- Cotizacion
                                             v_cod_ofi_debito,      -- Ofic.Orig.
                                             v_cod_mod_padre,       -- Mod.Pad.Cliente
                                             v_cod_mad_padre,       -- Mad.Pad.Cliente
                                             NULL,                  -- Cod.Tasa
                                             NULL,                  -- Val.Tasa
                                             v_concepto_mov, -- Concepto
                                             'S',                   -- Emit.Aviso
                                             v_nro_secuencia,
                                             v_fec_actual,
                                             null,   -- Cod_Banco
                                             null,   -- Cod_Causa
                                             v_mto_equ_local );
                    if pag_cta.fu_obt_cod_error = 0 then

                          if v_mod_estado!=pae_cnf.fu_obt_est_modulo(3) then--DA-7022
                            paw_bem.pr_mensajeUsuario(c_op_error , v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                            paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap - Modulo en estado 1 o 6:' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                            prg_rol_savepoint('sipap');
                            --borrar transf --HA-3690
                            if v_elimina then 
                               pr_del_snp_transferencias(v_nro_referencia);
                            end if;							
                            return v_retorno;

                          end if;
                       if v_cod_mon_credito <> v_cod_mon_local then
                          if v_cod_mon_debito = v_cod_mon_local then
                             v_mto_equ_local := v_mto_debito ;
                          else
                             v_mto_equ_local := null ;
                          end if ;
                       end if ;
                       v_tip_movimiento := pas_snp.fu_obt_tip_mov_transaccion(v_cod_mod_padre,v_cod_mad_padre,v_cod_tra_credito) ;

                       if nvl(pas_snp.fu_obt_cod_error,1) <> 0 then
                          paw_bem.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error );
                          prg_rol_savepoint('sipap');
                          --borrar transf
                          if v_elimina then --HA-3690
                             pr_del_snp_transferencias(v_nro_referencia);
                          end if;						  
                          return v_retorno;
                       else
                          -- Setea el Tipo de Movimiento del Rubro para SNP
                          pag_cta.pr_set_cod_rubro(pac_che.fu_obt_rub_cta_ban(v_cta_pte_solicitante), v_tip_movimiento);
                          -- Setea la Referencia del Movimiento para SNP
                          pag_cta.pr_set_referencia(v_cod_swift) ;
                          -- Registrar movimientos a la Cta. Interbancaria
                          pag_cta.pr_act_operacion( v_cta_pte_solicitante, -- Nro.Cta.
                                                    v_hor_actual,          -- Hora
                                                    v_tip_movimiento,      -- Tip.Mov.Cta.Corresponsal
                                                    v_cod_mon_credito,     -- Cod.Mon.
                                                    v_mto_credito,         -- Monto
                                                    v_cod_tra_padre,       -- Trx.Padre
                                                    v_cod_tra_credito,     -- Trx.Hija
                                                    v_nro_referencia,      -- Nro.Doc.
                                                    v_cot_credito,         -- Cotizacion
                                                    v_cod_ofi_debito,      -- Ofic.Orig.
                                                    v_cod_mod_padre,       -- Mod.Pad.Cliente
                                                    v_cod_mad_padre,       -- Mad.Pad.Cliente
                                                    NULL,                  -- Cod.Tasa
                                                    NULL,                  -- Val.Tasa
                                                    v_concepto_mov,
                                                    'S',                   -- Emit.Aviso
                                                    v_nro_secuencia,
                                                    v_fec_actual,
                                                    null,   -- Cod_Banco
                                                    null,   -- Cod_Causa
                                                    v_mto_equ_local );
                          if pag_cta.fu_obt_cod_error = 0 then
                             --Para las transferencias que corresponden a SNP se debe cargar este campo. No asi para la generacion de cargos.
                             pag_cta.pr_set_nro_documento2 (null);
                             --
                             pas_snp.pr_obt_mensaje( v_nro_referencia, 'N' );
                             if pag_cta.fu_obt_cod_error <> 0 then
                                paw_bem.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                                prg_rol_savepoint('sipap');
                                if v_elimina then --HA-3690
                                   pr_del_snp_transferencias(v_nro_referencia);
                                end if;								
                                return v_retorno;
                             else -- No tuvo ERRORES
                                pas_snp.pr_gen_mov_cargo( r_gtran,
                                                          v_nro_cta_debito,
                                                          v_cta_pte_solicitante,
                                                          v_mto_credito,
                                                          v_hor_actual,
                                                          v_nro_secuencia
                                                        );
                                if pag_cta.fu_obt_cod_error <> 0 then
                                   paw_bem.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                   paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                                   prg_rol_savepoint('sipap');
                                   --borrar transf --HA-3690
                                   if v_elimina then 
                                      pr_del_snp_transferencias(v_nro_referencia);
                                   end if;								   
                                   return v_retorno;
                                end if;

                                 BEGIN
                                    -- Actualiza la Transferencia
                                    update ge_snp_transferencias gt
                                       set gt.fecha       = v_fec_actual,
                                           gt.hora        = v_hor_actual,
                                           gt.cod_usuario = v_mensajeCaja.codigoUsuario
                                     where gt.nro_referencia = v_nro_referencia
                                       and gt.cod_msj_swift = r_gtran.cod_msj_swift ;
                                    if sql%notfound then
                                       paw_bem.pr_mensajeUsuario(c_con_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                                       paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                                       prg_rol_savepoint('sipap');
                                       --borrar transf --HA-3690
                                       if v_elimina then
                                          pr_del_snp_transferencias(v_nro_referencia);
                                       end if;									   
                                       return v_retorno;
                                    end if;
                                 END;

                             end if;
                          else
                             paw_bem.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                             paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                             prg_rol_savepoint('sipap');
                             --borrar transf --HA-3690
                             if v_elimina then
                                pr_del_snp_transferencias(v_nro_referencia);
                             end if;							 
                             return v_retorno;
                          end if ;
                       end if ;
                    else
                       if pag_cta.fu_obt_cod_error = 31 then
                          paw_bem.pr_mensajeUsuario(c_sal_insufiente, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                          prg_rol_savepoint('sipap');
                          --borrar transf --HA-3690
                          if v_elimina then
                             pr_del_snp_transferencias(v_nro_referencia);
                          end if;						  
                          return v_retorno;
                       else
                          paw_bem.pr_mensajeUsuario(c_tra_invalida, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                          paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                          prg_rol_savepoint('sipap');
                          --borrar transf --HA-3690
                          if v_elimina then
                             pr_del_snp_transferencias(v_nro_referencia);
                          end if;						  
                          return v_retorno;
                       end if;
                    end if;
                   -- Si esta todo OK envia la transferencia al Socket -- solo si no esta en lista de cumplimiento
                   if v_retorno.error = 'N' and v_cod_per_cumplimiento is null and  not v_lim_excedido
                     and  r_gtran.cod_msj_swift = 103 then


                       if pas_snp.fu_obt_cod_error = 31 then
                         paw_bem.pr_mensajeUsuario(c_err_hor_cerrado, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                         paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                         prg_rol_savepoint('sipap');
                         --borrar transf --HA-3690
                         if v_elimina then
                            pr_del_snp_transferencias(v_nro_referencia);
                         end if;						 
                         return v_retorno;
                       elsif pas_snp.fu_obt_cod_error <> 0 then
                         paw_bem.pr_mensajeUsuario(c_err_env_swift, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                         paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_transferenciaSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                         prg_rol_savepoint('sipap');
                         --borrar transf --HA-3690
                         if v_elimina then
                            pr_del_snp_transferencias(v_nro_referencia);
                         end if;						 
                         return v_retorno;
                      end if;
                       pas_snp.pr_gen_arc_swift(v_nro_referencia, 'N','A') ;
                       commit;--HA-3690					   
                   end if ;

                   end if;

                 end if ;
              end if ;--- ver si el registro siguiente no afectaria
              end if ;
             --registro el movimiento
             --guarda el nro de referencia en bw_movimientos en dato2, para utilizarlo como join con ge_movimientos en la funcion lf_obt_tot_transacciones
             lp_reg_ope_transferencias(v_nro_cta_debito /*p_nro_cuenta*/,
                              v_cod_mon_debito /*p_cod_moneda */,
                              v_mto_debito /*p_monto*/,
                              null /*p_nro_cta_contra*/,
                              null,
                              'Entidad_Destino',
                              v_cod_swift,
                              'Nro. Referencia',
                              v_nro_referencia,
                              v_concepto,
                              v_nro_ip,
                              v_modo||'-'||retObtenerPermisos.canAutRequeridas,
                              userInfo.codigoPersona,
                              c_cod_operacion,
                              v_nro_referencia,
                              C_COD_HOMEBANKING,
                              v_sesion,
                              nvl(userInfo.codigoEmpresa, userInfo.codigoPersona),--BWP-37 glopez
                              null,
                              null,
                              null,
                              p_nro_mov_pendiente,
                              null, --BWP-37 glopez
                              v_tip_canal
                              );

             pre_cam_for_numerico('.,');
             v_retorno.nro_referencia:=v_nro_referencia;
             return v_retorno;

  EXCEPTION
        WHEN OTHERS THEN
           pre_cam_for_numerico('.,');
           pr_mensajeUsuario(MSG_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, null, c_cod_operacion, null, 'fuw_transferenciaSipap-' || SQLERRM || '-' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
           prg_rol_savepoint('sipap');
           --borrar transf --HA-3690
           if v_elimina then
              pr_del_snp_transferencias(v_nro_referencia);
           end if;		   
           RETURN v_retorno;
  END;


  /* Obtiene el detalle de transfrencias de SNP.
   */

  /*FUNCTION fu_obtenerdetalleTransfSnp( p_codigoPersona         IN VARCHAR2,
                                       p_codigoEmpresa IN VARCHAR2,
                                       p_codigoCanal      IN VARCHAR2,
                                       p_numeroReferencia IN NUMBER) RETURN typ_detalleTransferenciaSnp IS

      c_cod_operacion           constant varchar2(3)  := '037';
      c_sin_movimientos         constant varchar2(15) := '107';

      -- datos recibidos
      v_can_detalles    number(3);
      v_sesion          bw_aut_sesiones.cod_sesion%type;
      v_cod_canal       bw_claves.cod_canal%type;
      v_nro_referencia  number(20);
      v_ope_futura      varchar2(1) := 'N';


      userInfo                paw_bem.typ_validarSesion;
      v_listaTransferencias   typ_listaDetalleSnp := typ_listaDetalleSnp();
      v_retorno               typ_detalleTransferenciaSnp := typ_detalleTransferenciaSnp;
      v_logMessage            VARCHAR2(1000);
      v_tip_doc_solicitante   ba_tip_documentos.descripcion%type;
      v_tip_doc_beneficiario  ba_tip_documentos.descripcion%type;

      cursor detalle(p_nro_ref in number)  is
         Select decode(a.nro_ref_externa, null, 'E', 'R') Tipo, a.nro_referencia,
                a.fec_valor, a.fec_ingreso, a.nro_cta_beneficiario nro_cta_credito,
                a.nro_cta_solicitante nro_cta_debito, a.nom_beneficiario,
                pas_snp.fu_obt_des_participante(decode(a.nro_ref_externa, null, a.cod_swi_pte_beneficiario, a.cod_swi_pte_solicitante)) Entidad,
                decode(a.nro_ref_externa, null, a.cod_swi_pte_beneficiario, a.cod_swi_pte_solicitante) Cod_swift,
                fue_obt_des_moneda(a.cod_moneda) moneda, a.monto,
                fue_obt_des_refcodes('SITUACION',case
                                                   when a.situacion = 'T'
                                                   then
                                                     'C'
                                                   else a.situacion
                                                 end
                                    ) Situacion,
                FUE_OBT_DES_REFCODES('EST_MSJ_SNP',a.estado) Estado, a.msj_swift,
                a.cod_tip_doc_solicitante, b.descripcion v_tip_doc_solicitante,
                a.nro_doc_solicitante, a.cod_tip_doc_beneficiario, c.descripcion v_tip_doc_beneficiario,
                a.nro_doc_beneficiario, a.cod_swi_pte_solicitante,
                pas_snp.fu_obt_des_participante(a.cod_swi_pte_solicitante) entidadSolicitante
           from ge_snp_transferencias a, ba_tip_documentos b, ba_tip_documentos c
          where a.nro_referencia = p_nro_ref
            and a.cod_tip_doc_solicitante = b.cod_tip_documento
            and a.cod_tip_doc_beneficiario= c.cod_tip_documento;

     BEGIN
      v_sesion               := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
      v_cod_canal       := paw_bem.depurarAlfanumerico(p_codigoCanal,3);
      v_nro_referencia  := paw_bem.depurarAlfanumerico(p_numeroReferencia,20);

      paw_bem.pr_mensajeUsuario(MSG_OK, v_retorno.codigoRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_retorno.cantidadCuentas := 0;

     -- userInfo := paw_bem.fu_validarSesion(v_sesion, v_cod_canal);
      userInfo.error:='N';
      userInfo.codigoCanal:=v_cod_canal;
      userInfo.codigoPersona:=p_codigoPersona;
      userInfo.codigoEmpresa:=p_codigoEmpresa;
      --Logear parametros
      v_logMessage := 'detalleTransferenciasSipap(p_sesion= ' || v_sesion ||', p_codigoCanal = '||v_cod_canal||', p_numeroReferencia '||v_nro_referencia||')';
      paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

      IF userInfo.error = 'S' THEN
         v_retorno.codigoRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;

      -- Verifico si el cliente con su perfil tendra acceso a realizar la transaccion
      IF v_retorno.error = 'N' THEN
         DECLARE
            v_permiso paw_bem.typ_obtenerPermisos;
         BEGIN
            v_permiso := paw_bem.lf_obt_permisos(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona), userInfo.codigoPerfil, c_cod_operacion, v_cod_canal);
            IF (v_permiso.error = 'S') THEN
               v_retorno.codigoRespuesta      := v_permiso.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
               v_retorno.error                := v_permiso.error;
               RETURN v_retorno;
            END IF;
         END;
      END IF;

      -- 2. busco los datos de la cuentas
      IF v_retorno.error = 'N' THEN
         v_can_detalles := 0;
         for det in detalle(v_nro_referencia)  loop
             if (trunc(det.fec_valor) > trunc(det.fec_ingreso)) then
                v_ope_futura := 'S';
             end if;

               DECLARE
                  v_transferenciaInfo typ_detalleSnp := typ_detalleSnp;
               BEGIN
                 v_can_detalles := v_can_detalles + 1;

                 v_transferenciaInfo.tipo                  := substr(det.tipo,0,1);
                 v_transferenciaInfo.numeroReferencia      := det.nro_referencia;
                 v_transferenciaInfo.fechaValor            := paw_bem.lf_for_date(det.fec_valor);
                 v_transferenciaInfo.numeroCuentaCredito   := substr(det.nro_cta_credito,0,35);
                 v_transferenciaInfo.numeroCuentaDebito    := substr(det.nro_cta_debito,0,35);
                 v_transferenciaInfo.nombreBeneficiario    := substr(det.nom_beneficiario,0,120);
                 v_transferenciaInfo.entidad               := substr(det.entidad,0,60);
                 v_transferenciaInfo.codigoSwift           := substr(det.cod_swift,0,20);
                 v_transferenciaInfo.moneda                := substr(det.moneda,0,30);
                 v_transferenciaInfo.monto                 := det.monto;
                 v_transferenciaInfo.situacion             := substr(det.situacion,0,30);
                 v_transferenciaInfo.estado                := substr(det.estado,0,15);
                 v_transferenciaInfo.operacionFutura       := substr(v_ope_futura,0,1);
                 v_transferenciaInfo.mensajeSwift          := substr(nvl(REPLACE(REPLACE(det.msj_swift,chr(10),' '), chr(13), ''),'~'),0,2000);
                 v_transferenciaInfo.tipoDocSolicitante    := det.v_tip_doc_solicitante;
                 v_transferenciaInfo.documentoSolicitante  := det.nro_doc_solicitante;
                 v_transferenciaInfo.tipoDocBeneficiario   := det.v_tip_doc_beneficiario;
                 v_transferenciaInfo.documentoBeneficiario := det.nro_doc_beneficiario;
                 v_transferenciaInfo.codigoSwiftEmisor     := det.cod_swi_pte_solicitante;
                 v_transferenciaInfo.entidadEmisor         := substr(det.entidadSolicitante,0,60);
                 CASE
                 WHEN det.monto > 0 THEN
                    v_transferenciaInfo.montoTexto := upper(trim(fue_obt_denominacion(det.monto))||' '||substr(det.moneda,0,30));
                 WHEN det.monto = 0 THEN
                    v_transferenciaInfo.montoTexto := '';
                 END CASE;


                 v_listaTransferencias.extend;
                 v_listaTransferencias(v_listaTransferencias.count) := v_transferenciaInfo;

               END;
         end loop;
       END IF;

       IF v_can_detalles = 0 THEN
          -- no tiene detalles
          paw_bem.pr_mensajeUsuario(c_sin_movimientos, v_retorno.codigoRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'detalleTransferenciasSipap - ' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.codigoRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
       END IF;


      paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'detalleTransferenciasSipap - ' ||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.codigoRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);

      IF v_retorno.error = 'N' THEN

           paw_con.pr_reg_operacion(null \*p_nro_cuenta*\,
                              null \*p_cod_moneda *\,
                              null \*p_monto*\,
                              null \*p_nro_cta_contra*\,
                              null,
                              'Tipo Consulta',
                              null,
                              'Cantidad Msj',
                              v_nro_referencia,
                              null,
                              null,
                              null,
                              userInfo.codigoPersona,
                              c_cod_operacion,
                              v_nro_referencia,
                              C_COD_HOMEBANKING,
                              v_sesion,
                              userInfo.codigoEmpresa
                              );
       -- todo ok, se arma el mensaje de respuesta
         v_retorno.listaTransferencias := v_listaTransferencias;
         v_retorno.cantidadCuentas := v_can_detalles;
         RETURN v_retorno;
      ELSE

          paw_con.pr_reg_operacion(null \*p_nro_cuenta*\,
                              null \*p_cod_moneda *\,
                              null \*p_monto*\,
                              null \*p_nro_cta_contra*\,
                              null,
                              'Tipo Consulta',
                              null,
                              'Cantidad Msj',
                              v_nro_referencia,
                              null,
                              null,
                              null,
                              userInfo.codigoPersona,
                              c_cod_operacion,
                              v_nro_referencia,
                              C_COD_HOMEBANKING,
                              v_sesion,
                              userInfo.codigoEmpresa
                              );
         v_retorno.listaTransferencias := NULL;
         RETURN v_retorno;
      END IF;

   EXCEPTION
     WHEN OTHERS THEN
     paw_bem.pr_mensajeUsuario(msg_error, v_retorno.codigoRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     paw_bem.pr_insertarBitacora(NULL, v_cod_canal, NULL, c_cod_operacion, NULL, 'detalleTransferenciasSipap -' || SQLERRM, bitacora_error);
     RETURN v_retorno;
  END;*/

  FUNCTION lf_ver_snp_movimiento(p_nro_referencia in ge_snp_transferencias.nro_referencia%type)
    return varchar2 is
    v_tie_movimiento varchar2(1) := 'N';
   begin
    select 'S'
      into v_tie_movimiento
      from ge_snp_transferencias a
     where a.nro_referencia = p_nro_referencia
       and exists
     (select 0
              from gv_movimientos m
             where m.cod_tra_padre = pas_snp.fu_obt_cod_tra_padre
               and m.cod_mod_padre = pas_snp.fu_obt_cod_mod_padre
               and m.cod_mad_padre = pas_snp.fu_obt_cod_mad_padre
               and m.nro_documento = a.nro_referencia
               and m.fecha = a.fecha
               and m.hora = a.hora
               and m.cod_usuario = a.cod_usuario
               and m.nro_documento2 is not null);

   return v_tie_movimiento;
   exception
    when others then
      return v_tie_movimiento;
  end;

  FUNCTION lf_obt_nro_referencia(p_observacion in ge_snp_transferencias.observacion%type)
     return VARCHAR2 IS
   BEGIN
     /*
     || Recupera los digitos ( hasta 16 ) que corresponden al Numero de referencia original a partir de la sintaxis /REV/
     ||
     */
     RETURN REGEXP_SUBSTR(p_observacion,
                          '/REV/([[:digit:]]{0,16})(\s|$)',
                          1,
                          1,
                          'n',
                          1);
   EXCEPTION
     WHEN OTHERS THEN
       return null;
  END;

  FUNCTION lf_obt_nro_ref_externa(p_nro_ref_externa          in ge_snp_transferencias.nro_ref_externa%type,
                                    p_nro_cta_solicitante      in ge_snp_transferencias.nro_cta_solicitante%type,
                                    p_cod_swi_pte_solicitante  in ge_snp_transferencias.cod_swi_pte_solicitante%type,
                                    p_nro_cta_beneficiario     in ge_snp_transferencias.nro_cta_beneficiario%type,
                                    p_cod_swi_pte_beneficiario in ge_snp_transferencias.cod_swi_pte_beneficiario%type,
                                    p_monto                    in ge_snp_transferencias.monto%type,
                                    p_cod_moneda               in ge_snp_transferencias.cod_moneda%type,
                                    p_nro_referencia           in ge_snp_transferencias.nro_referencia%type)
      RETURN VARCHAR2 IS
      v_valor varchar2(1) := 'N';

    BEGIN
      select 0
        into v_valor
        from ge_snp_transferencias a
       where a.fec_recepcion is null
         and lf_obt_nro_referencia(case
                                             when a.cod_msj_swift = 102 then
                                              a.concepto
                                             else
                                              a.observacion
                                           end) = p_nro_ref_externa
         and a.nro_cta_beneficiario = p_nro_cta_solicitante
         and a.cod_swi_pte_beneficiario = p_cod_swi_pte_solicitante
         and a.nro_cta_solicitante = p_nro_cta_beneficiario
         and a.cod_swi_pte_solicitante = p_cod_swi_pte_beneficiario
         and a.monto = p_monto
         and a.cod_moneda = p_cod_moneda;

      return paw_bem.lf_ver_snp_movimiento(p_nro_referencia);

    EXCEPTION
      WHEN OTHERS THEN
        RETURN 'N';
    END lf_obt_nro_ref_externa;

   /*
   Fu_obtenerTransaferenciasSipap
   */

  /*FUNCTION fu_obtenerTransferenciaSnp( p_codigoPersona         IN VARCHAR2,
                                 p_codigoEmpresa IN VARCHAR2,
                                        p_codigoCanal  IN VARCHAR2,
                                        p_fechaDesde   IN VARCHAR2,
                                        p_fechaHasta   IN VARCHAR2) RETURN typ_respuestaTransferenciaSnp IS

      c_cod_operacion           constant varchar2(3) := '037';
      c_sin_movimientos         constant varchar2(3) := '107';
      c_cod_per_invalido        constant varchar2(3) := '167';

      -- datos recibidos
      v_can_detalles    number(3);
      v_sesion          bw_aut_sesiones.cod_sesion%type;
      v_cod_canal       bw_claves.cod_canal%type;
      v_fec_desde       date;
      v_fec_hasta       date;
      v_estado          varchar2(15) := 'N';


      userInfo                paw_bem.typ_validarSesion;
      v_listaTransferencias   typ_listaTransferenciaSnp := typ_listaTransferenciaSnp();
      v_retorno               typ_respuestaTransferenciaSnp := typ_respuestaTransferenciaSnp;
      v_logMessage            VARCHAR2(1000);
      --variables internas
      v_tip_persona varchar2(1);

      cursor cabecera (p_cod_persona in varchar2, p_tip_persona in varchar2, p_fec_desde in date, p_fec_hasta in date) is
       SELECT 'E' Tipo,
              a.nro_referencia,
              a.nro_sec_lote,
              a.fec_valor,
              a.fec_ingreso,
              a.nro_cta_beneficiario,
              a.nom_beneficiario,
              a.cod_msj_swift,
            pas_snp.fu_obt_des_participante(a.cod_swi_pte_beneficiario) Entidad,
              FUE_OBT_DES_MONEDA(a.cod_moneda) moneda,
              a.monto,
              FUE_OBT_DES_REFCODES('SITUACION',
                                    CASE
                                        WHEN a.situacion = 'T' THEN
                                                  'C'
                                        ELSE
                                         a.situacion
                                     END) Situacion,
              FUE_OBT_DES_REFCODES('EST_MSJ_SNP',
                                    CASE
                                        WHEN nvl(instr(a.concepto, '/REV/', 1, 1), 0) > 0 OR --para colocar estado R a aquellas mensajerias q tienen /REV/ en el concepto u observacion
                                             nvl(instr(a.observacion, '/REV/', 1, 1), 0) > 0 THEN
                                                    'R'
                                        ELSE
                                         a.estado
                                     END) Estado,
              a.origen,
              a.cod_moneda,
              a.nro_cta_solicitante,
              a.nom_solicitante
         FROM ge_snp_transferencias a, ge_cta_clientes b
        WHERE b.cod_persona = p_cod_persona
          AND b.nro_cuenta = a.nro_cta_solicitante
          AND ((p_tip_persona = 'J') OR (p_tip_persona = 'F' AND (SELECT i.tipo
                                                                    FROM ge_cta_clientes h, ba_personas i
                                                                   WHERE h.cod_persona = i.cod_persona
                                                                     AND h.nro_cuenta = a.nro_cta_solicitante
                                                                     AND h.relacion = 'P') <> 'J'))
          AND a.fec_recepcion IS NULL
          AND a.fec_valor = a.fec_ingreso
          AND a.fec_valor BETWEEN p_fec_desde AND p_fec_hasta
          AND a.nro_cta_beneficiario IS NOT NULL
          AND a.cod_swi_pte_solicitante = pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)
--          AND a.fecha IS NOT NULL
--          AND a.hora IS NOT NULL
--          AND ((a.cod_usuario IS NOT NULL and a.ind_valor='S') or (a.ind_valor='N'))
--          AND ((a.estado = 'A' AND a.situacion = 'L') OR (a.estado IN ('C', 'R') AND pas_snp.fu_ver_mt_env_bcp(a.nro_referencia) = 'S') OR (a.estado = 'C' AND a.situacion = 'T') OR (a.ind_valor = 'N' AND a.estado = 'A' AND a.situacion IN ('P', 'V')) --incluye las transferencias con situacion P y V solo si es de bajo valor
--              )
       UNION ALL

       SELECT 'F' Tipo,
              a.nro_referencia,
              a.nro_sec_lote,
              a.fec_valor,
              a.fec_ingreso,
              a.nro_cta_beneficiario,
              a.nom_beneficiario,
              a.cod_msj_swift,
            pas_snp.fu_obt_des_participante(a.cod_swi_pte_beneficiario) Entidad,
              FUE_OBT_DES_MONEDA(a.cod_moneda) moneda,
              a.monto,
              FUE_OBT_DES_REFCODES('SITUACION',
                                    CASE
                                        WHEN a.situacion = 'T' THEN
                                                  'C'
                                        ELSE
                                         a.situacion
                                     END) Situacion,
              FUE_OBT_DES_REFCODES('EST_MSJ_SNP',
                                    CASE
                                        WHEN nvl(instr(a.concepto, '/REV/', 1, 1), 0) > 0 OR --para colocar estado R a aquellas mensajerias q tienen /REV/ en el concepto u observacion
                                             nvl(instr(a.observacion, '/REV/', 1, 1), 0) > 0 THEN
                                                    'R'
                                        ELSE
                                         a.estado
                                     END) Estado,
              a.origen,
              a.cod_moneda,
              a.nro_cta_solicitante,
              a.nom_solicitante
         FROM ge_snp_transferencias a, ge_cta_clientes b
        WHERE b.cod_persona = p_cod_persona
          AND b.nro_cuenta = a.nro_cta_solicitante
          AND ((p_tip_persona = 'J') OR (p_tip_persona = 'F' AND (SELECT i.tipo
                                                                    FROM ge_cta_clientes h, ba_personas i
                                                                   WHERE h.cod_persona = i.cod_persona
                                                                     AND h.nro_cuenta = a.nro_cta_solicitante
                                                                     AND h.relacion = 'P') <> 'J'))
          AND a.nro_cta_beneficiario IS NOT NULL
          AND a.fec_recepcion IS NULL
          AND a.fec_valor > a.fec_ingreso
          AND a.fec_valor BETWEEN p_fec_desde AND p_fec_hasta
          AND a.cod_swi_pte_solicitante = pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)
--          AND (a.fecha IS NOT NULL AND a.hora IS NOT NULL AND a.cod_usuario IS NOT NULL AND ((a.estado = 'A' AND a.situacion = 'L') OR (a.estado IN ('C', 'R') AND pas_snp.fu_ver_mt_env_bcp(a.nro_referencia) = 'S')) OR (a.estado = 'A' AND a.situacion = 'P') --o las pendientes aun de envio
--              OR (a.estado = 'C' AND a.situacion = 'T') --o las reversadas automaticamente
--              OR (a.ind_valor = 'N' AND a.estado = 'A' AND a.situacion IN ('P', 'V')) --incluye las transferencias con situacion P y V solo si es de bajo valor
              --)
       UNION ALL

       SELECT 'R' Tipo,
              a.nro_referencia,
              a.nro_sec_lote,
              a.fec_valor,
              a.fec_ingreso,
                                                                                       a.nro_cta_solicitante,
              a.nom_solicitante,
              a.cod_msj_swift,
              pas_snp.fu_obt_des_participante(a.cod_swi_pte_solicitante) Entidad,
              FUE_OBT_DES_MONEDA(a.cod_moneda) moneda,
                                                                                       a.monto,
              FUE_OBT_DES_REFCODES('SITUACION', a.situacion) Situacion,
              FUE_OBT_DES_REFCODES('EST_MSJ_SNP',
                                    CASE
                                        WHEN nvl(instr(a.concepto, '/REV/', 1, 1), 0) > 0 OR --para colocar estado R a aquellas mensajerias q tienen /REV/ en el concepto u observacion
                                             nvl(instr(a.observacion, '/REV/', 1, 1), 0) > 0 OR
                                            --para colocar en estado R aquellas mensajerias recibidas con movimiento y q cuentan con un retorno enviado
                                             lf_obt_nro_ref_externa(a.nro_ref_externa, a.nro_cta_solicitante, a.cod_swi_pte_solicitante, a.nro_cta_beneficiario, a.cod_swi_pte_beneficiario, a.monto, a.cod_moneda, a.nro_referencia) = 'S' THEN
                                                    'R'
                                        ELSE
                                         a.estado
                                     END) Estado,
              a.origen,
              a.cod_moneda,
              a.nro_cta_beneficiario,
              a.nom_beneficiario
         FROM ge_snp_transferencias a, ge_cta_clientes b
        WHERE b.cod_persona = p_cod_persona
          AND b.nro_cuenta = a.nro_cta_beneficiario
          AND ((p_tip_persona = 'J') OR (p_tip_persona = 'F' AND (SELECT i.tipo
                                                                    FROM ge_cta_clientes h, ba_personas i
                                                                   WHERE h.cod_persona = i.cod_persona
                                                                     AND h.nro_cuenta = a.nro_cta_beneficiario
                                                                     AND h.relacion = 'P') <> 'J'))
          AND a.fec_recepcion IS NOT NULL
          AND a.fec_valor BETWEEN p_fec_desde AND p_fec_hasta
          AND a.nro_cta_beneficiario IS NOT NULL
          AND a.cod_swi_pte_beneficiario = pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)
          AND ((a.fecha IS NOT NULL AND a.hora IS NOT NULL AND a.cod_usuario IS NOT NULL
                --para q recupere solo las transferencias que cuentan con movimientos y liquidados o cancelados
              AND ((a.estado = 'A' AND a.situacion = 'L') OR a.estado = 'C')) OR (a.estado = 'R' AND paw_bem.lf_ver_snp_movimiento(paw_bem.lf_obt_nro_referencia(CASE --para desplegar los retornos de aquellas mensajerias q cuentan con movimiento
                                                                                                                                                                     WHEN a.cod_msj_swift = 102 THEN
                                                                                                      a.concepto
                                                                                                                                                                     ELSE
                                                                                                                                                                      a.observacion
                                                                                                                                                                  END)) = 'S'))
        ORDER BY fec_valor DESC;

   BEGIN
    -- raise_application_error(-20000,p_fechaDesde||'-'||p_fechahasta);
      v_sesion               := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
      v_cod_canal    := paw_bem.depurarAlfanumerico(p_codigoCanal,3);
      v_fec_desde         := trunc(to_date(paw_bem.depurarAlfanumerico(p_fechaDesde,8),'ddmmyyyy'));
      v_fec_hasta         := trunc(to_date(paw_bem.depurarAlfanumerico(p_fechaHasta,8),'ddmmyyyy'));

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_retorno.cantidadCuentas := 0;


       userInfo.error:='N';
       userInfo.codigoCanal:=v_cod_canal;
       userInfo.codigoPersona:=p_codigoPersona;
       userInfo.codigoEmpresa:=p_codigoEmpresa;

      --Logear parametros
      v_logMessage := 'fu_obtenerTransferenciaSnp(p_sesion= ' || v_sesion ||', p_codigoCanal = '||v_cod_canal||', p_fechaDesde '||v_fec_desde||', p_fechaHasta '||v_fec_hasta  ||')';
      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);
  Begin
    Select a.tipo
      into v_tip_persona
      from ba_personas a
     where a.cod_persona = nvl(userInfo.codigoEmpresa, userInfo.codigoPersona);
  Exception
    When OTHERS then
      pr_mensajeUsuario(c_cod_per_invalido,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerTransferenciasSipap - ' ||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null),BITACORA_ERROR);
      \* Obtiene la informacion de parametros recibos y el return del type *\
      paw_log.g_typ_respuestaTransfSnp := v_retorno;
      paw_log.pr_logValoresTypes('g_typ_respuestaTransfSnp',
      'fu_obtenerTransferenciaSnp'||' '||v_sesion||', '|| p_codigoCanal||','||
       p_fechaDesde||', '||p_fechaHasta);

  End;

      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_respuestaTransfSnp := v_retorno;
         paw_log.pr_logValoresTypes('g_typ_respuestaTransfSnp',
         'fu_obtenerTransferenciaSnp'||' '||v_sesion||', '|| p_codigoCanal||','||
         p_fechaDesde||', '||p_fechaHasta);
         RETURN v_retorno;
      END IF;

      -- Verifico si el cliente con su perfil tendra acceso a realizar la transaccion
      IF v_retorno.error = 'N' THEN
         DECLARE
            v_permiso typ_obtenerPermisos;
         BEGIN
            v_permiso := paw_bem.lf_obt_permisos(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona), userInfo.codigoPerfil, c_cod_operacion, v_cod_canal);
            IF (v_permiso.error = 'S') THEN
               v_retorno.nombreRespuesta      := v_permiso.nombrerespuesta;
               v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
               v_retorno.error                := v_permiso.error;
               \* Obtiene la informacion de parametros recibos y el return del type *\
               paw_log.g_typ_respuestaTransfSnp := v_retorno;
               paw_log.pr_logValoresTypes('g_typ_respuestaTransfSnp',
               'fu_obtenerTransferenciaSnp'||' '||v_sesion||', '|| p_codigoCanal||','||
               p_fechaDesde||', '||p_fechaHasta);
               RETURN v_retorno;
            END IF;
         END;
      END IF;

      -- 2. busco los datos de la cuentas
      IF v_retorno.error = 'N' THEN
         v_can_detalles := 0;
    for cab in cabecera(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona),v_tip_persona,v_fec_desde,v_fec_hasta) loop
            v_estado := cab.estado;
            if cab.estado = 'Reversado' then
               v_estado := 'Devuelto';
            end if;

               DECLARE
                  v_transferenciaInfo typ_transferenciaSnp := typ_transferenciaSnp;
               BEGIN
                 v_can_detalles := v_can_detalles + 1;

                 v_transferenciaInfo.tipo                  := substr(cab.tipo,0,1);
                 v_transferenciaInfo.numeroReferencia      := cab.nro_referencia;
                 v_transferenciaInfo.numeroLote            := substr(cab.nro_sec_lote,0,20);
                 v_transferenciaInfo.fechaValor            := lf_for_date(cab.fec_valor);
                 v_transferenciaInfo.numeroCtaBeneficiario := substr(cab.nro_cta_beneficiario,0,35);
                 v_transferenciaInfo.nombreBeneficiario    := substr(cab.nom_beneficiario,0,120);
                 v_transferenciaInfo.entidad               := substr(cab.entidad,0,60);
                 v_transferenciaInfo.codigoMoneda          := substr(cab.cod_moneda,0,3);
                 v_transferenciaInfo.monto                 := cab.monto;
                 v_transferenciaInfo.situacion             := substr(cab.situacion,0,30);
                 v_transferenciaInfo.estado                := substr(v_estado,0,15);
                 v_transferenciaInfo.origen                := substr(cab.origen,0,1);
                 v_transferenciaInfo.fechaIngreso          := lf_for_date(cab.fec_ingreso);
                 v_transferenciaInfo.numeroCtaSolicitante  := substr(cab.nro_cta_solicitante,0,35);
                 v_listaTransferencias.extend;
                 v_listaTransferencias(v_listaTransferencias.count) := v_transferenciaInfo;
               exit when v_can_detalles > 30 ;
               END;
         end loop;
       END IF;

       IF v_can_detalles = 0 THEN
          -- no tiene detalles
          pr_mensajeUsuario(c_sin_movimientos, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerTransferenciasSipap - ' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
       END IF;

      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerTransferenciasSipap - ' ||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      \* Obtiene la informacion de parametros recibos y el return del type *\
      paw_log.g_typ_respuestaTransfSnp := v_retorno;
      paw_log.pr_logValoresTypes('g_typ_respuestaTransfSnp',
      'fu_obtenerTransferenciaSnp'||' '||v_sesion||', '|| p_codigoCanal||','||
      p_fechaDesde||', '||p_fechaHasta);


      IF v_retorno.error = 'N' THEN
         -- todo ok, se arma el mensaje de respuesta
         v_retorno.listaTransferencias := v_listaTransferencias;
         v_retorno.cantidadCuentas := v_can_detalles;
         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_respuestaTransfSnp := v_retorno;
         paw_log.pr_logValoresTypes('g_typ_respuestaTransfSnp',
         'fu_obtenerTransferenciaSnp'||' '||v_sesion||', '|| p_codigoCanal||','||
         p_fechaDesde||', '||p_fechaHasta);

         RETURN v_retorno;
      ELSE
         v_retorno.listaTransferencias := NULL;
         RETURN v_retorno;
      END IF;

  EXCEPTION
    WHEN OTHERS THEN
       pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       pr_insertarBitacora(NULL, v_cod_canal, NULL, c_cod_operacion, NULL, 'fu_obtenerTransferenciaSnp -' || SQLERRM, BITACORA_ERROR);
       \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_respuestaTransfSnp := v_retorno;
         paw_log.pr_logValoresTypes('g_typ_respuestaTransferenciaSnp',
         'fu_obtenerTransferenciaSnp'||' '||v_sesion||', '|| p_codigoCanal||','||
         p_fechaDesde||', '||p_fechaHasta);
        RETURN v_retorno;
  END;*/

 /* FUNCTION fu_obtenerTransferenciaFutura(p_sesion   IN VARCHAR2,
                                          p_codigoCanal  IN VARCHAR2) RETURN typ_transferenciaFuturaSnp IS

      c_cod_operacion           constant varchar2(3)  := '038';
      c_sin_movimientos         constant varchar2(15) := '107';

      -- datos recibidos
      v_can_detalles    number(3);
      v_sesion          bw_aut_sesiones.cod_sesion%type;
      v_cod_canal       bw_claves.cod_canal%type;
      v_fec_actual      date         := pag_cal.fu_obt_fec_actual(9);

      userInfo                paw_bem.typ_validarSesion;
      v_listaTransferencias   typ_listaTransferenciaSnp := typ_listaTransferenciaSnp();
      v_retorno               typ_transferenciaFuturaSnp := typ_transferenciaFuturaSnp;
      v_logMessage            VARCHAR2(1000);

      cursor cabecera (p_cod_persona in varchar2) is
       Select a.nro_referencia, a.nro_sec_lote, a.fec_valor,
              a.nro_cta_beneficiario, a.nom_beneficiario,
              pas_snp.fu_obt_des_participante(a.cod_swi_pte_beneficiario) Entidad,
              fue_obt_des_moneda(a.cod_moneda) moneda, a.monto, a.cod_moneda,
              a.situacion,a.estado,a.origen,a.fec_ingreso, a.nro_cta_solicitante,
              a.tip_mensaje, fu_tip_cuenta(b.cod_modulo, b.cod_modalidad) cod_tip_cuenta

        from ge_snp_transferencias a,
            ge_cta_clientes b
       where a.nro_cta_solicitante = b.nro_cuenta
          and b.cod_persona = p_cod_persona
          and a.nro_cta_beneficiario is not null
          and a.fec_valor > v_fec_actual
          and a.situacion = 'P' -- Solo los que estan Pendiente de envio.
          and a.estado not in ('C', 'E')
          and a.fecha is null -- Solo los que no tienen movimiento asociado (Fecha Futura)
          and a.cod_swi_pte_solicitante = pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)
          -- Para no mostrar las transferencias solicitadas para cancelar - Empresas
          and not exists ( Select 1 from bw_mov_pendientes b
                           where b.cod_per_principal = p_cod_persona
                             and trunc(b.fec_hora) = trunc(sysdate)
                             and b.estado = 'P'
                             and b.cod_tip_mensaje = '038'
                             and b.referencia = a.nro_referencia)
      order by fec_valor desc;

   BEGIN

      v_sesion    := paw_bem.depurarAlfanumerico(p_sesion,32);
      v_cod_canal := paw_bem.depurarAlfanumerico(p_codigoCanal,3);


      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_retorno.cantidadCuentas := 0;


      userInfo := paw_bem.fu_validarSesion(v_sesion, v_cod_canal);
      --Logear parametros
      v_logMessage := 'fu_obtenerTransferenciaFutura(p_sesion= ' || v_sesion ||', p_codigoCanal = '||v_cod_canal||')';
      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_logMessage, BITACORA_ENTRADA);

      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_transferenciaFuturaSnp := v_retorno;
         paw_log.pr_logValoresTypes('typ_transferenciaFuturaSnp',
         'fu_obtenerTransferenciaFutura'||' '||p_sesion||', '|| p_codigoCanal);
         RETURN v_retorno;
      END IF;

      -- Verifico si el cliente con su perfil tendra acceso a realizar la transaccion
      IF v_retorno.error = 'N' THEN
         DECLARE
            v_permiso typ_obtenerPermisos;
         BEGIN
            v_permiso := paw_bem.lf_obt_permisos(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona), userInfo.codigoPerfil, c_cod_operacion, v_cod_canal);
            IF (v_permiso.error = 'S') THEN
               v_retorno.nombreRespuesta      := v_permiso.nombrerespuesta;
               v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
               v_retorno.error                := v_permiso.error;
               \* Obtiene la informacion de parametros recibos y el return del type *\
               paw_log.g_typ_transferenciaFuturaSnp := v_retorno;
               paw_log.pr_logValoresTypes('typ_transferenciaFuturaSnp',
               'fu_obtenerTransferenciaFutura'||' '||p_sesion||', '|| p_codigoCanal);
             RETURN v_retorno;
            END IF;
         END;
      END IF;

      -- 2. busco los datos de la cuentas
      IF v_retorno.error = 'N' THEN
         v_can_detalles := 0;
         for cab in cabecera(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona))  loop

               DECLARE
                  v_transferenciaInfo typ_transferenciaSnp := typ_transferenciaSnp;
               BEGIN
                 v_can_detalles := v_can_detalles + 1;

                 v_transferenciaInfo.tipo :=  cab.cod_tip_cuenta;
                 v_transferenciaInfo.numeroReferencia      := cab.nro_referencia;--.nro_referencia;
                 v_transferenciaInfo.numeroLote            := substr(cab.nro_sec_lote,0,20);
                 v_transferenciaInfo.fechaValor            := lf_for_date(cab.fec_valor);
                 v_transferenciaInfo.numeroCtaBeneficiario := substr(cab.nro_cta_beneficiario,0,35);
                 v_transferenciaInfo.nombreBeneficiario    := substr(cab.nom_beneficiario,0,120);
                 v_transferenciaInfo.entidad               := substr(cab.entidad,0,60);
                 v_transferenciaInfo.codigoMoneda          := substr(cab.cod_moneda,0,3);
                 v_transferenciaInfo.monto                 := cab.monto;
                 v_transferenciaInfo.situacion             := cab.situacion;
                 v_transferenciaInfo.estado                := cab.estado;
                 v_transferenciaInfo.origen                := cab.origen;
                 v_transferenciaInfo.fechaingreso          := lf_for_date(cab.fec_ingreso);
                 v_transferenciaInfo.numeroctasolicitante  := cab.nro_cta_solicitante;
                 v_listaTransferencias.extend;
                 v_listaTransferencias(v_listaTransferencias.count) := v_transferenciaInfo;

               END;
         end loop;
       END IF;

       IF v_can_detalles = 0 THEN
          -- no tiene detalles
          pr_mensajeUsuario(c_sin_movimientos, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerTransferenciasSipap - ' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
       END IF;


      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerTransferenciasSipap - ' ||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
      \* Obtiene la informacion de parametros recibos y el return del type *\
      paw_log.g_typ_transferenciaFuturaSnp := v_retorno;
      paw_log.pr_logValoresTypes('typ_transferenciaFuturaSnp',
      'fu_obtenerTransferenciaFutura'||' '||p_sesion||', '|| p_codigoCanal);


      IF v_retorno.error = 'N' THEN
         -- todo ok, se arma el mensaje de respuesta
         v_retorno.listaTransferencias := v_listaTransferencias;
         v_retorno.cantidadCuentas := v_can_detalles;
         \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_transferenciaFuturaSnp := v_retorno;
         paw_log.pr_logValoresTypes('typ_transferenciaFuturaSnp',
         'fu_obtenerTransferenciaFutura'||' '||p_sesion||', '|| p_codigoCanal);

         RETURN v_retorno;
      ELSE
         v_retorno.listaTransferencias := NULL;
         RETURN v_retorno;
      END IF;

   EXCEPTION
     WHEN OTHERS THEN
     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(NULL, v_cod_canal, NULL, c_cod_operacion, NULL, 'fu_obtenerTransferenciaFutura -' || SQLERRM, BITACORA_ERROR);
     \* Obtiene la informacion de parametros recibos y el return del type *\
      paw_log.g_typ_transferenciaFuturaSnp := v_retorno;
      paw_log.pr_logValoresTypes('typ_transferenciaFuturaSnp',
      'fu_obtenerTransferenciaFutura'||' '||p_sesion||', '|| p_codigoCanal);
    RETURN v_retorno;
   END;*/
   /*
    Cancelacion de SNP
   */
  /*FUNCTION fu_cancelacionSnp(p_sesion IN VARCHAR2,
                                   p_codigoCanal  IN VARCHAR2,
                                   p_modo         IN VARCHAR2,
                                   p_numeroReferencia IN NUMBER) RETURN typ_cancelacionsnp IS

      c_cod_operacion           constant varchar2(3)  := '038';-- Cancelacion de Transferencia Interbancaria SNP
      c_sin_movimientos         constant varchar2(15) := '107';
      c_cod_dat_invalido        constant varchar2(15) := '127';

      -- datos recibidos
      v_can_detalles    number(3);
      v_sesion          bw_aut_sesiones.cod_sesion%type;
      v_cod_canal       bw_claves.cod_canal%type;
      v_fec_actual      date         := pag_cal.fu_obt_fec_actual(9);
      v_modo            varchar2(1);    -- modo V-validacion o C-confirmacion

      userInfo                typ_validarSesion;
      v_listaTransferencias   typ_listaTransferenciaSnp := typ_listaTransferenciaSnp();
      v_retorno               typ_cancelacionsnp := typ_cancelacionsnp;
      v_logMessage            VARCHAR2(1000);
      v_permiso               typ_obtenerPermisos;
      v_nro_referencia        number(15);

      --Variables Locales
      v_nro_cta_debito       varchar2(20);
      v_nro_cta_credito      varchar2(20);
      v_cod_moneda           varchar2(3) ;
      v_monto                number(18,2);
      v_fec_operacion        date;
      v_nro_documento        number(12);
      v_horario         VARCHAR2(1) := 'D'; -- Dia normal
      v_es_mov_noc      VARCHAR2(1) := 'N';
      v_es_cta_noc      VARCHAR2(1) := 'N'; -- Graba S/N ctas noctunas
      v_fec_valor       DATE := v_fec_actual;
      retError          typ_mensajerespuesta := typ_mensajerespuesta;
      v_mensajeCaja     paw_bem.typ_mensajeCaja;

   cursor cabecera (p_cod_persona in varchar2, p_nro_referencia in number) is
     Select a.nro_referencia, a.nro_sec_lote, a.fec_valor,
        a.nro_cta_beneficiario, a.nom_beneficiario,
        pas_snp.fu_obt_des_participante(a.cod_swi_pte_beneficiario) Entidad,
        fue_obt_des_moneda(a.cod_moneda) moneda, a.monto, a.cod_moneda,
        fue_obt_des_refcodes('SITUACION',case when a.situacion = 'T' then
                                           'C'
                                         else a.situacion
                                         end
                          ) Situacion,
        fue_obt_des_refcodes('EST_MSJ_SNP',a.estado) Estado,
        decode(a.ind_valor,'S', 'Alto Valor', 'N','Bajo Valor') tip_valor, a.msj_swift,
        a.nro_cta_solicitante
     from ge_snp_transferencias a,
            ge_cta_clientes b
      where a.nro_cta_solicitante = b.nro_cuenta
        and b.cod_persona = p_cod_persona
        and a.nro_referencia = p_nro_referencia
        and a.nro_cta_beneficiario is not null
        and a.fec_valor > v_fec_actual
        and a.situacion = 'P' -- Solo los que estan Pendiente de envio.
        and a.estado not in ('C', 'E')
        and a.fecha is null -- Solo los que no tienen movimiento asociado (Fecha Futura)
        and a.cod_swi_pte_solicitante = pas_snp.fu_obt_cod_swi_participante(fug_obt_per_entidad)
        order by fec_valor desc;

   BEGIN

      --v_filtro    := depurarAlfanumerico(p_filtro,9);
      v_sesion    := paw_bem.depurarAlfanumerico(p_sesion,32);
      v_cod_canal := paw_bem.depurarAlfanumerico(p_codigoCanal,3);
      v_modo      := paw_bem.depurarAlfanumerico(p_modo,1);
      v_nro_referencia := paw_bem.depurarNumerico(p_numeroReferencia,15);

      paw_bem.pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      v_retorno.cantidadCuentas := 0;

      userInfo := paw_bem.fu_validarSesion(v_sesion, v_cod_canal);
      --Logear parametros
      v_logMessage := 'fu_cancelacionSnp(p_sesion= ' || v_sesion ||', p_codigoCanal = '||v_cod_canal||')';
      paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_logMessage, bitacora_entrada);
      paw_log.g_typ_cancelacionsnp := v_retorno;
      paw_log.pr_logValoresTypes('typ_cancelacionsnp',
      'fu_cancelacionSnp'||' '||p_sesion||', '|| p_codigoCanal||', '||  p_modo||', '||p_numeroReferencia);
      IF userInfo.error = 'S' THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;

      -- Verifico si el cliente con su perfil tendra acceso a realizar la transaccion
      IF v_retorno.error = 'N' THEN
         BEGIN
            v_permiso := paw_bem.lf_obt_permisos(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona), userInfo.codigoPerfil, c_cod_operacion, v_cod_canal);
            IF (v_permiso.error = 'S') THEN
               v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
               v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
               v_retorno.error                := v_permiso.error;
               RETURN v_retorno;
            END IF;
         END;
      END IF;

    --Valida Caja
      v_mensajeCaja := paw_bem.lf_val_caja(userInfo);
      IF v_mensajeCaja.error = 'S' THEN
         v_retorno.error                := v_mensajeCaja.error;
         v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;

      --controla horario cierre
          reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                      v_mensajeCaja.fechaUltimoCierre \* v_ult_cierre *\,
                                      -- IN
                                      v_mensajeCaja.codigoOficinaOrigen \* v_cod_ofi_origen *\,
                                      -- IN
                                      v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

           IF reterror.error = 'S' THEN
              v_retorno.error                := reterror.error;
              v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
              v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
              RETURN v_retorno;
           END IF;

      IF v_modo = 'C' AND NVL(v_can_aut_requeridas,0) = 0 THEN
         v_modo:= 'A';
      END IF;

      -- 2. busco los datos de la cuentas
      IF v_retorno.error = 'N' THEN
         IF v_modo = 'V' THEN
           v_can_detalles := 0;
           for cab in cabecera(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona), v_nro_referencia)  loop

                 DECLARE
                    v_transferenciaInfo typ_transferenciaSnp := typ_transferenciaSnp;
                 BEGIN
                   v_can_detalles := v_can_detalles + 1;
                   v_transferenciaInfo.numeroReferencia      := cab.nro_referencia;--.nro_referencia;
                   v_transferenciaInfo.numeroLote            := substr(cab.nro_sec_lote,0,20);
                   v_transferenciaInfo.fechaValor            := paw_bem.lf_for_date(cab.fec_valor);
                   v_transferenciaInfo.numeroCtaBeneficiario := substr(cab.nro_cta_beneficiario,0,35);
                   v_transferenciaInfo.nombreBeneficiario    := substr(cab.nom_beneficiario,0,120);
                   v_transferenciaInfo.entidad               := substr(cab.entidad,0,60);
                   v_transferenciaInfo.codigoMoneda          := substr(cab.cod_moneda,0,3);
                   v_transferenciaInfo.monto                 := cab.monto;
                   v_transferenciaInfo.situacion             := substr(cab.situacion,0,30);
                   v_transferenciaInfo.estado                := substr(cab.estado,0,15);
                   v_transferenciaInfo.numeroCtaSolicitante  := substr(cab.nro_cta_solicitante,0,35);
                   v_transferenciaInfo.mensajeSwift          := substr(nvl(replace(replace(cab.msj_swift,chr(10),' '), chr(13), ''),'~'),0,2000);
                   v_listaTransferencias.extend;
                   v_listaTransferencias(v_listaTransferencias.count) := v_transferenciaInfo;

                 END;
           end loop;

           IF v_can_detalles = 0 THEN
              -- no tiene detalles
              paw_bem.pr_mensajeUsuario(c_sin_movimientos, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerTransferenciasSipap - ' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
              return v_retorno;
           END IF;
         ELSIF v_modo = 'A' THEN
              pas_snp.pr_obt_mensaje(v_nro_referencia, 'N') ;
              pas_snp.g_msj.estado := 'C' ;
              PAS_SNP.PR_SET_TRANSFERENCIAS(pas_snp.fu_obt_reg_transferencias) ;
              if pas_snp.g_cod_error <> 0 then
                 paw_bem.pr_mensajeUsuario(c_cod_dat_invalido, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                 paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerTransferenciasSipap - ' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                 return v_retorno;
              end if ;
         ELSIF v_modo = 'C' AND  NVL(v_can_aut_requeridas,0) > 0 then
              Begin
                 Select t.nro_cta_solicitante, t.monto, t.cod_moneda, t.nro_cta_beneficiario, t.fec_valor
                   into v_nro_cta_debito, v_monto, v_cod_moneda, v_nro_cta_credito, v_fec_operacion
                   from ge_snp_transferencias t
                  where t.nro_referencia = v_nro_referencia ;
              exception
                 when others then
                    paw_bem.pr_mensajeUsuario(c_sin_movimientos, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerTransferenciasSipap - ' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
                    return v_retorno;
              end ;
              -- Se inserta el movimiento pendiente de autorizacion si encontro el registro
              if v_retorno.error = 'N' then
                 select s_nro_documento.nextval into v_nro_documento from dual;
                 insert into bw_mov_pendientes(
                    nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje, nro_cuenta,
                    descripcion, estado, can_aut_requeridas, can_aut_faltantes,
                    cod_per_ingreso, monto, etiqueta, dato,
                    etiqueta2, dato2, referencia, cod_moneda)
                 values
                    (v_nro_documento,nvl(userInfo.codigoEmpresa,userInfo.codigoPersona),sysdate,'038', v_nro_cta_debito,
                     'Cancelacion de Operacion', 'P', v_can_aut_requeridas, v_can_aut_requeridas,
                     userInfo.codigoPersona, v_monto, 'Nro.Cta.Credito/Moneda', v_nro_cta_credito||' / '||v_cod_moneda,
                     'Fecha Valor',to_char(v_fec_operacion,'DD/MM/YYYY'), v_nro_referencia, v_cod_moneda);
              end if ;
         END IF;
       END IF;


      paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'obtenerTransferenciasSipap - ' ||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);

      IF v_retorno.error = 'N' THEN
         -- todo ok, se arma el mensaje de respuesta
         v_retorno.listaTransferencias := v_listaTransferencias;
         v_retorno.cantidadCuentas := v_can_detalles;
         RETURN v_retorno;
      ELSE
         v_retorno.listaTransferencias := NULL;
         RETURN v_retorno;
      END IF;

  EXCEPTION
   WHEN OTHERS THEN
     paw_bem.pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     paw_bem.pr_insertarBitacora(NULL, v_cod_canal, NULL, c_cod_operacion, NULL, 'fuw_canTransferenciaSipap -' || SQLERRM, bitacora_error);
     paw_log.g_typ_cancelacionsnp := v_retorno;
     paw_log.pr_logValoresTypes('typ_cancelacionsnp',
     'fu_cancelacionSnp'||' '||p_sesion||', '|| p_codigoCanal||', '||  p_modo||', '||p_numeroReferencia);
     RETURN v_retorno;
  END;*/

  /* Frecuentes de SIPAP
  */

  /*FUNCTION fu_frecuenteSnp (p_sesion   IN VARCHAR2,
                            p_codigoCanal  IN VARCHAR2,
                            p_modo         IN VARCHAR2,
                            p_cuentaDebito   IN VARCHAR2 DEFAULT NULL,
                            p_monedaCredito  IN VARCHAR2 DEFAULT NULL,
                            p_montoCredito   IN NUMBER DEFAULT NULL,
                            p_cuentaCredito  IN VARCHAR2 DEFAULT NULL,
                            p_codigoSwift    IN VARCHAR2 DEFAULT NULL,
                            p_documentoCredito   IN VARCHAR2 DEFAULT NULL,
                            p_nombreBeneficiario IN VARCHAR2 DEFAULT NULL,
                            p_direccionBeneficiario IN VARCHAR2 DEFAULT NULL,
                            p_tipoDocBeneficiario   IN VARCHAR2 DEFAULT NULL,
                            p_numeroPlanilla        IN NUMBER DEFAULT 0) RETURN typ_mensajeRespuesta IS

      c_cod_operacion      constant varchar2(03) := '036';
      c_dup_plantilla      constant varchar2(04) := '279';
      c_err_plantilla      constant varchar2(04) := '306';
      c_eli_plantilla      constant varchar2(04) := '281';

      v_cod_canal          varchar2(3);
      v_sesion             bw_aut_sesiones.cod_sesion%type;
      userInfo             paw_bem.typ_validarSesion;
      v_retorno            typ_mensajeRespuesta := typ_mensajeRespuesta;
      v_log_mensaje        varchar2(1000);

      -- Variables Internas
      v_nro_cta_debito       varchar2(16);
      v_nro_cta_credito      varchar2(20);   -- cuenta de credito
      v_cod_mon_credito      ge_snp_transferencias.cod_moneda%type;   -- moneda de la transferencia
      v_nro_doc_credito      ba_personas.nro_documento%type := null;  -- nro de documento del acreditado
      v_cod_swift            ge_snp_transferencias.cod_swi_pte_beneficiario%type;
      v_nom_beneficiario     ge_snp_transferencias.nom_beneficiario%type;
      v_dir_beneficiario     ge_snp_transferencias.dir_beneficiario%type;
      v_tip_doc_beneficiario ge_snp_transferencias.cod_tip_doc_beneficiario%type;
      v_mto_credito          ge_movimientos.monto%type;  -- Monto de la transferencia
      v_modo                 varchar2(1);
      v_nro_plantilla        ge_snp_plantillas.nro_plantilla%type;

    BEGIN
      v_sesion             := paw_bem.depurarAlfanumerico(p_sesion,32);
      v_cod_canal          := paw_bem.depurarAlfanumerico(p_codigoCanal,3);
      v_modo               := paw_bem.depurarAlfanumerico(p_modo,1);
      v_nro_cta_debito     := paw_bem.depurarCuenta(p_cuentaDebito,paw_bem.CUENTA_TAMANO);
      v_cod_mon_credito    := paw_bem.depurarAlfanumerico(p_monedaCredito,3);
      v_mto_credito        := paw_bem.depurarNumerico(p_montoCredito,18);
      v_nro_cta_credito    := paw_bem.depurarAlfanumerico(p_cuentaCredito,20);
      v_cod_swift          := paw_bem.depurarAlfanumerico(p_codigoSwift,20);
      v_nro_doc_credito    := paw_bem.depurarAlfanumerico(p_documentoCredito,20);
      v_nom_beneficiario     := paw_bem.depurarTextos(p_nombreBeneficiario,100);
      v_dir_beneficiario     := paw_bem.depurarTextos(p_direccionBeneficiario,100);
      v_tip_doc_beneficiario := paw_bem.depurarAlfanumerico(p_tipoDocBeneficiario,3);
      v_nro_plantilla        := paw_bem.depurarNumerico(p_numeroPlanilla,10);

      paw_bem.pr_mensajeUsuario(msg_ok, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      \* Obtiene la informacion de parametros recibos y el return del type *\
     paw_log.g_typ_mensajeRespuesta := v_retorno;
     paw_log.pr_logValoresTypes('typ_mensajeRespuesta',
     'fu_frecuenteSnp'||' '||p_sesion||', '|| p_codigoCanal||', '||  p_modo||', '||
     p_cuentaDebito||', '||p_monedaCredito||', '||p_montoCredito||', '||p_cuentaCredito
     ||', '|| p_codigoSwift||', '|| p_documentoCredito||', '||p_nombreBeneficiario||', '||p_direccionBeneficiario||', '|| p_tipoDocBeneficiario||', '||
     p_numeroPlanilla);

      -- 1. valido la clave del cliente
      userInfo := paw_bem.fu_validarSesion(v_sesion, v_cod_canal);

      --Logear parametros
      v_log_mensaje := 'fu_frecuenteSNP (sesion='||v_sesion||', codigoCanal='||v_cod_canal||',modo='||v_modo||', cuentaCredio='||v_nro_cta_debito||'
                        ,moneda='||p_monedaCredito||',montoCredito='||p_montoCredito||' )';
      paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, v_log_mensaje, bitacora_entrada);

      IF (userInfo.error = 'S') THEN
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         v_retorno.error                := 'S';
         RETURN v_retorno;
      END IF;
      if v_modo = 'G' then
        begin
           select s_plantilla.nextval into v_nro_plantilla from dual;

           insert into ge_snp_plantillas
              (nro_plantilla, cod_persona, cod_per_vinculada, nro_cta_solicitante, cod_moneda, monto,
               cod_swi_pte_beneficiario, nro_cta_beneficiario, nom_beneficiario, dir_beneficiario,
               cod_tip_doc_beneficiario, nro_doc_beneficiario)
           values
              (v_nro_plantilla, userInfo.codigoPersona, userInfo.codigoEmpresa, v_nro_cta_debito, v_cod_mon_credito,
               v_mto_credito, v_cod_swift, v_nro_cta_credito, v_nom_beneficiario, v_dir_beneficiario,
               v_tip_doc_beneficiario, v_nro_doc_credito);

        exception
           when dup_val_on_index then
             paw_bem.pr_mensajeUsuario(c_dup_plantilla, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_frecuenteSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
             RETURN V_RETORNO;
           when others then
             paw_bem.pr_mensajeUsuario(c_err_plantilla, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_frecuenteSipap- ' || SQLERRM || '-' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
             RETURN V_RETORNO;
        end;
      elsif v_modo = 'E' then
        if nvl(v_nro_plantilla,0) = 0 then
           paw_bem.pr_mensajeUsuario(c_eli_plantilla, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_frecuenteSipap -' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
        else
           delete from ge_snp_plantillas where nro_plantilla = v_nro_plantilla;
        end if;
      end if;

      RETURN v_retorno;
  EXCEPTION
      WHEN OTHERS THEN
         paw_bem.pr_mensajeUsuario(msg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fuw_frecuenteSipap-' || SQLERRM || '-' || paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_error);
         RETURN v_retorno;
  END;
*/

  /* Obtiene lass URLS para el consumo del WSDL de los WebServices*/
  FUNCTION fu_parametrosBancard(p_sesion        IN VARCHAR2,
                                p_codigoCanal   IN VARCHAR2,
                                p_tipoOperacion IN NUMBER,
                                p_tipoSolicitud IN number)
    RETURN typ_parametrosBancard

   is
    c_cod_operacion        constant varchar2(3) := '213';
    c_lgn_sin_autorizacion constant varchar2(3) := '108';
    v_sesion        bw_aut_sesiones.cod_sesion%type;
    v_codCanal      bw_aut_sesiones.cod_canal%type;
    v_tipoOperacion number := trim(p_tipoOperacion);
    v_tipoSolicitud varchar2(2) := trim(p_tipoSolicitud);
    userInfo        typ_validarSesion;
    v_retorno       typ_parametrosBancard := typ_parametrosBancard;
  begin
    v_codcanal := depurarAlfanumerico(p_codigoCanal, 3);
    v_sesion   := depurarAlfanumerico(p_sesion, 32);
    pr_mensajeUsuario(MSG_OK,
                      v_retorno.nombreRespuesta,
                      v_retorno.descripcionRespuesta,
                      v_retorno.error);
    -- Valido la Sesion del Cliente
    userinfo                := fu_validarSesion(v_sesion, v_codcanal);
    v_retorno.tipoOperacion := v_tipoOperacion;
    v_retorno.tipoSolicitud := v_tipoSolicitud;

    IF userinfo.error = 'S' THEN
      v_retorno.error                := userinfo.error;
      v_retorno.nombreRespuesta      := userinfo.nombreRespuesta;
      v_retorno.descripcionRespuesta := userinfo.descripcionRespuesta;
      /* Obtiene la informacion de parametros recibos y el return del type */
      paw_log.g_typ_parametrosBancard := v_retorno;
      paw_log.pr_logValoresTypes('typ_parametrosBancard', 'Parametros Bancard ' || '-' || p_sesion || ', ' ||
                                 p_codigocanal || ', ' || p_tipoOperacion || ', ' ||
                                 p_tipoSolicitud);
      RETURN v_retorno;
    END IF;
    If p_tipoSolicitud = 1 then
      --ambiente de desarrollo
      v_retorno.contrasena    := fug_obt_parentes(7, 'BWE_DES_CONTRASENA');
      v_retorno.puerto        := fug_obt_parentes(7, 'BWE_DES_PUERTO');
      v_retorno.usuario       := fug_obt_parentes(7, 'BWE_DES_USUARIO');
      v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_DES_DIR_IP_WS');
      v_retorno.indSecure     := fug_obt_parentes(7, 'BWE_DES_IND_SECURE');
      v_retorno.server        := fug_obt_parentes(7, 'BWE_DES_SERVER');

      If v_tipoOperacion = 1 then
        --Consulta de Saldo
        v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_DES_CON_SALDO');

      elsif v_tipoOperacion = 2 then
        --Extracto al dia
        v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_DES_EXT_DIA');
      elsif v_tipoOperacion = 3 then
        -- -Ciclos de Extractos anteriores
        v_retorno.ipWebservices := fug_obt_parentes(7,'BWE_DES_CIC_EXT_ANTERIOR');
      elsif v_tipoOperacion = 4 then
        -- -Extractos de Ciclos anteriores
        v_retorno.ipWebservices := fug_obt_parentes(7,'BWE_DES_EXT_CIC_ANTERIOR');
      elsif v_tipoOperacion = 5 then
        --Pago de Tarjeta de Credito
        v_retorno.ipWebservices := fug_obt_parentes(7,'BWE_DES_PAG_TAR_CREDITO');
      elsif v_tipoOperacion = 6 then
        ---Pagos via Infonet Cobranzas
        v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_DES_PAG_VIA_IFC');

      elsif v_tipoOperacion = 7 then
        ----Consulta Gral. Infonet Cob.
        v_retorno.ipWebservices := fug_obt_parentes(7,'BWE_DES_CON_GRAL_IFC');

      elsif v_tipoOperacion = 8 then
        ---Prestamos Dinamicos
        v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_DES_PRE_DINAMICOS');

      end if;

    elsif p_tipoSolicitud = 2 then
      --ambiente de produccion
      v_retorno.contrasena    := fug_obt_parentes(7, 'BWE_PRO_CONTRASENA');
      v_retorno.puerto        := fug_obt_parentes(7, 'BWE_PRO_PUERTO');
      v_retorno.usuario       := fug_obt_parentes(7, 'BWE_PRO_USUARIO');
      v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_PRO_DIR_IP_WS');
      v_retorno.indSecure     := fug_obt_parentes(7, 'BWE_PRO_IND_SECURE');
      v_retorno.server        := fug_obt_parentes(7, 'BWE_PRO_SERVER');

      If v_tipoOperacion = 1 then
        --Consulta de Saldo
        v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_PRO_CONSULTASALDO');

      elsif v_tipoOperacion = 2 then
        --Extracto al dia
        v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_PRO_EXT_DIA');
      elsif v_tipoOperacion = 3 then
        -- -Ciclos de Extractos anteriores
        v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_PRO_CIC_EXT_ANTERIOR');
      elsif v_tipoOperacion = 4 then
        -- -Extractos de Ciclos anteriores
        v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_PRO_EXT_CIC_ANTERIOR');
      elsif v_tipoOperacion = 5 then
        --Pago de Tarjeta de Credito
        v_retorno.ipWebservices := fug_obt_parentes(7,'BWE_PRO_PAG_TAR_CREDITO');
      elsif v_tipoOperacion = 6 then
        ---Pagos via Infonet Cobranzas
        v_retorno.ipWebservices := fug_obt_parentes(7,'BWE_PRO_PAG_VIA_IFC');

      elsif v_tipoOperacion = 7 then
        ----Consulta Gral. Infonet Cob.
        v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_PRO_CON_GRAL_IFC');

      elsif v_tipoOperacion = 8 then
        ---Prestamos Dinamicos
        v_retorno.ipWebservices := fug_obt_parentes(7, 'BWE_PRO_PRE_DINAMICOS');

      end if;
    end if;
    RETURN V_RETORNO;

  EXCEPTION
    WHEN OTHERS THEN
      paw_bem.pr_mensajeUsuario(msg_error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
      paw_bem.pr_insertarBitacora(userInfo.codigoPersona, v_codcanal, v_sesion, c_cod_operacion, userInfo.codigoEmpresa, 'fu_parametrosBancard-' || SQLERRM || '-' ||paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),bitacora_error);
      RETURN v_retorno;
  END;


