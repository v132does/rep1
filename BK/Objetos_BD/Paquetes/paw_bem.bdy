      v_retorno              typ_listadetallesolicitud := typ_listadetallesolicitud();
      v_typ_detalleSolicitud typ_detallesolicitud := typ_detallesolicitud;

      CURSOR detalle IS
         SELECT a.nro_solicitud, a.tip_documento, a.fec_emision, a.fec_vencimiento, a.importe, a.cod_banco, a.nro_cta_corriente, a.nro_documento, a.cod_tip_doc_librador, a.nro_doc_librador, a.imagen
           FROM bw_det_solicitudes a
          WHERE a.nro_solicitud = p_numeroSolicitud
          ORDER BY fec_vencimiento;
   BEGIN
      FOR reg IN detalle LOOP
         v_typ_detalleSolicitud.numeroSolicitud         := reg.nro_solicitud;
         v_typ_detalleSolicitud.tipoDocumento           := reg.tip_documento;
         v_typ_detalleSolicitud.fechaEmision            := reg.fec_emision;
         v_typ_detalleSolicitud.fechaVencimiento        := reg.fec_vencimiento;
         v_typ_detalleSolicitud.importe                 := reg.importe;
         v_typ_detalleSolicitud.codigoBanco             := reg.cod_banco;
         v_typ_detalleSolicitud.numeroCtaCorriente      := reg.nro_cta_corriente;
         v_typ_detalleSolicitud.numeroDocumento         := reg.nro_documento;
         v_typ_detalleSolicitud.tipoDocumentoLibrador   := reg.cod_tip_doc_librador;
         v_typ_detalleSolicitud.numeroDocumentoLibrador := reg.nro_doc_librador;
         v_typ_detalleSolicitud.imagen                  := reg.imagen;

         v_retorno.extend;
         v_retorno(v_retorno.count) := v_typ_detalleSolicitud;
      END LOOP;
      RETURN v_retorno;
   END;
*/
/*  FUNCTION fu_obtenerSolicitudes
  (
      p_sesion        IN VARCHAR2,
      p_codigoCanal   IN VARCHAR2,
      p_nro_sol_desde IN VARCHAR2,
      p_nro_sol_hasta IN VARCHAR2,
      p_fec_sol_desde IN VARCHAR2,
      p_fec_sol_hasta IN VARCHAR2,
      p_estado        IN VARCHAR2
   ) RETURN typ_solicitudes IS
      v_cod_operacion         VARCHAR2(3) := '046';
      v_sesion                bw_aut_sesiones.cod_sesion%TYPE;
      v_codigoCanal           bw_aut_sesiones.cod_canal%TYPE;
      userInfo                typ_validarSesion;
      v_retorno               typ_solicitudes := typ_solicitudes;
      v_permiso               typ_obtenerPermisos;
      v_mensajeCaja           typ_mensajeCaja;
      v_msj_bitacora          VARCHAR2(200) := '';
      v_can_detalles          NUMBER(3) := 0;
      v_typ_cabeceraSolicitud typ_cabecerasolicitud := typ_cabecerasolicitud;
      v_typ_solicitudes       typ_listaCabeceraSolicitud := typ_listaCabeceraSolicitud();
      v_logMessage            VARCHAR2(1000);
      v_fec_sol_desde         DATE;
      v_fec_sol_hasta         DATE;

      cabeceraSolicitud typ_cabecerasolicitud := typ_cabecerasolicitud;

      CURSOR cabecera IS
         SELECT nro_solicitud, cod_persona, cod_modalidad, importe, plazo, sucursal, fec_solicitud, estado, enviado, fec_envio, explicacion, score
           FROM bw_cab_solicitudes
          WHERE cod_persona = userinfo.codigoPersona
            AND ((p_nro_sol_desde IS NULL AND p_nro_sol_hasta IS NULL) OR nro_solicitud BETWEEN to_number(p_nro_sol_desde) AND to_number(p_nro_sol_hasta))
            AND ((v_fec_sol_desde IS NULL AND v_fec_sol_hasta IS NULL) OR fec_solicitud BETWEEN v_fec_sol_desde AND v_fec_sol_hasta)
            AND (p_estado IS NULL OR estado = p_estado)
          ORDER BY fec_solicitud DESC;
      BEGIN

         v_codigocanal := depurarAlfanumerico(p_codigoCanal, 3);
         v_sesion      := depurarAlfanumerico(p_sesion, 32);

         v_fec_sol_desde  := to_date(p_fec_sol_desde, 'dd-mm-yyyy');
         v_fec_sol_hasta  := to_date(p_fec_sol_hasta, 'dd-mm-yyyy');

         userinfo := fu_validarsesion(v_sesion, v_codigoCanal);
         v_logMessage := 'fu_obtenerSolicitudes - ' || substr('p_nro_sol_desde:' || p_nro_sol_desde || ', p_nro_sol_hasta:' || p_nro_sol_hasta || ', p_fec_sol_desde:' || p_fec_sol_desde || ', p_fec_sol_hasta:' || p_fec_sol_hasta || ', p_estado:' || p_estado, 1, 200);
         pr_insertarBitacora(userInfo.codigoPersona,
                           v_codigoCanal,
                           v_sesion,
                           v_cod_operacion,
                           userInfo.codigoEmpresa,
                           v_logMessage,
                           BITACORA_ENTRADA);
         IF userinfo.error = 'S' THEN
            v_retorno.error                := userinfo.error;
            v_retorno.nombrerespuesta      := userinfo.nombreRespuesta;
            v_retorno.descripcionrespuesta := userinfo.descripcionRespuesta;
            RETURN v_retorno;
         END IF;

         -- Verifica si el usuario tiene acceso a la opcion y en que condicion
         v_permiso := lf_obt_permisos(userinfo.codigoPersona, userinfo.codigoPerfil, v_cod_operacion, userinfo.codigoCanal);

         IF (v_permiso.error = 'S') THEN
            v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
            v_retorno.error                := v_permiso.error;
            RETURN v_retorno;
         END IF;

         FOR reg IN cabecera LOOP
            v_can_detalles                          := v_can_detalles + 1;
            v_typ_cabeceraSolicitud.numeroSolicitud := reg.nro_solicitud;
            v_typ_cabeceraSolicitud.codigoPersona   := reg.cod_persona;
            v_typ_cabeceraSolicitud.codigoModalidad := reg.cod_modalidad;
            v_typ_cabeceraSolicitud.importe         := reg.importe;
            v_typ_cabeceraSolicitud.plazo           := reg.plazo;
            v_typ_cabeceraSolicitud.sucursal        := reg.sucursal;
            v_typ_cabeceraSolicitud.fechaSolicitud  := reg.fec_solicitud;
            v_typ_cabeceraSolicitud.estado          := reg.estado;
            v_typ_cabeceraSolicitud.enviado         := reg.enviado;
            v_typ_cabeceraSolicitud.fechaEnvio      := reg.fec_envio;
            v_typ_cabeceraSolicitud.explicacion     := reg.explicacion;
            v_typ_cabeceraSolicitud.score           := reg.score;

            v_typ_cabeceraSolicitud.listaDetalleSolicitud := lf_obt_det_solicitud(reg.nro_solicitud);
            v_typ_solicitudes.extend;
            v_typ_solicitudes(v_typ_solicitudes.count) := v_typ_cabeceraSolicitud;
         END LOOP;
         v_retorno.listaSolicitudes := v_typ_solicitudes;
        IF (v_can_detalles > 0) THEN
           v_retorno.cantidadDetalles := v_can_detalles;
        END IF;

        v_logMessage := substr('fu_obtenerSolicitudes - Cantidad de detalles devueltos:' || v_can_detalles, 1, 200);
        pr_insertarBitacora(userInfo.codigoPersona,
                           v_codigoCanal,
                           v_sesion,
                           v_cod_operacion,
                           userInfo.codigoEmpresa,
                           v_logMessage,
                           BITACORA_SALIDA);

        RETURN v_retorno;
    END;*/

/*  FUNCTION fu_administracionDatos(p_sesion       IN VARCHAR2,
                                  p_codigoCanal  IN VARCHAR2,
                                  p_modo         IN VARCHAR2,
                                  p_typ_actualizacionDatos IN typ_actualizacionDatos
                                                      )

    RETURN typ_administracionDatos IS


      c_cod_operacion        CONSTANT VARCHAR2(3) := '211';
      c_cod_sin_autorizacion CONSTANT VARCHAR2(3) := '108';
      c_act_reg_error        CONSTANT VARCHAR2(3) := '285';
      c_cod_act_direccion    CONSTANT VARCHAR2(3) := '286';
      c_cod_eli_direccion    CONSTANT VARCHAR2(3) := '287';
      c_cod_eli_direccion1   CONSTANT VARCHAR2(3) := '288';
      c_cod_eli_direccion2   CONSTANT VARCHAR2(3) := '289';
      c_cod_eli_direccion3   CONSTANT VARCHAR2(3) := '290';
      c_obt_can_direccion    CONSTANT VARCHAR2(3) := '291';
      c_obt_err_direccion    CONSTANT VARCHAR2(3) := '292';
      c_err_ins_reg          CONSTANT VARCHAR2(3) := '293';
      c_act_reg_telefono     CONSTANT VARCHAR2(3) := '294';
      c_eli_reg_telefono     CONSTANT VARCHAR2(3) := '295';
      c_err_obt_reg          CONSTANT VARCHAR2(3) := '296';
      c_obt_cant_telefono    CONSTANT VARCHAR2(3) := '297';
      c_act_correo           CONSTANT VARCHAR2(3) := '298';
      c_dir_nueva            CONSTANT VARCHAR2(3) := '299';
      c_err_can_telefono     CONSTANT VARCHAR2(3) := '300';
      c_pre_otr_error        CONSTANT VARCHAR2(10) := 'OP_ERROR';

      --variables generales
      v_modo                 VARCHAR2(1); --p: obtengo datos del cliente; s: solicitud de ciudades barrios;c: Datos para procesar:
      v_act_mail             VARCHAR2(1) := 'N';
      v_existe               VARCHAR2(1) := 'N';
      v_imp_factura          VARCHAR2(3);
      v_imp_fac_nvo          VARCHAR2(3);
      v_opcion               NUMBER(3) := 0;
      v_can_det              NUMBER(3) := 0;
      v_can_telefono            NUMBER := 0;
      v_can_direccion            NUMBER := 0;

      v_ciu_codigo           ba_ciudades.cod_ciudad%TYPE;
      v_dir_codigo           ba_direcciones.cod_direccion%TYPE;
      v_dir_cod_ext          ba_direcciones.cod_direccion%TYPE := 0;
      v_tel_codigo           ba_telefonos.cod_telefono%TYPE;
      v_email                ba_personas.dir_correo%TYPE;
      v_email_tmp            ba_personas.dir_correo%TYPE;
      v_tip_extracto         ge_clientes.tip_extracto%TYPE := 'N';
      v_tip_ext_tmp          ge_clientes.tip_extracto%TYPE := 'N';
      v_tip_envio            ge_dir_envios.tip_envio%TYPE := 'N';
      v_cod_ofi_cliente      ba_oficinas.cod_oficINa%TYPE;
      v_ofi_cliente          ba_oficinas.descripcion%TYPE;
      v_nom_cliente          ba_personas.nom_completo%TYPE;
      v_codCanal             bw_claves.cod_canal%TYPE;
      v_nom_oficial          ba_usuarios.nombre%TYPE;
      v_tel_oficial          ba_usuarios.telefono%TYPE;
      v_cor_oficial          ba_usuarios.dir_correo%TYPE;
      v_sesion               bw_aut_sesiones.cod_sesion%type;
      v_ind_cla_mail         VARCHAR2(1) := 'N';
      v_bitacora             VARCHAR2(600);
      v_ema_extrac           VARCHAR2(1);
      v_ofi_tie_courrier     VARCHAR2(1);
      v_es_retener           VARCHAR2(1) := 'N';
      v_exi_det              VARCHAR2(1) := 'N';
      v_direccion            VARCHAR2(2000);

      v_act_direccion        VARCHAR2(1):= 'N';
      v_act_telefono         VARCHAR2(1):= 'N';
      v_act_envio            VARCHAR2(1):= 'N';
      v_act_tip_envio        VARCHAR2(1):= 'N';
      v_act_factura          VARCHAR2(1):= 'N';
      v_tex_mail             VARCHAR2(4000);

      retValidarSesion       typ_validarSesion;
      v_permiso              typ_obtenerPermisos;
      v_retorno              typ_administracionDatos   := typ_administracionDatos();
      v_actualiza            typ_actualizacionDatos    := typ_actualizacionDatos();
      v_listaTelefonos       typ_listaTelefonos        := typ_listaTelefonos();
      v_telefono             typ_telefono              := typ_telefono();
      v_listaDirecciones     typ_listasDirecciones      := typ_listasDirecciones();
      v_direcciones          typ_direcciones             := typ_direcciones();


      CURSOR c_direcciones is
        SELECT DISTINCT(a.cod_direccion) n, a.direccion, b.descripcion ciudad, c.descripcion barrio,
               a.tipo, a.prINcipal, a.cod_direccion, a.cod_ciudad, a.cod_barrio
          FROM ba_direcciones a, ba_ciudades b,  ba_barrios c
         WHERE a.cod_persona = nvl( retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
           AND b.cod_pais = 586
           AND b.cod_ciudad = a.cod_ciudad
           AND c.cod_barrio(+) = a.cod_barrio
           AND b.cod_ciudad = a.cod_ciudad
           AND (c.cod_ciudad(+) = a.cod_ciudad AND (c.cod_barrio = a.cod_barrio OR a.cod_barrio is null))
         ORDER BY a.principal DESC, a.tipo;

      CURSOR c_telefonos is
        SELECT  j.tipo, j.tip_lINea, decode(j.telefono,'null',null,j.telefono) telefono, j.prINcipal, j.area, j.cod_telefono, j.INterno
          FROM ba_telefonos j
         WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
           AND j.tipo <> 'M'
      ORDER BY j.principal DESC;

    BEGIN
        v_codCanal   := depurarAlfanumerico(p_codigoCanal, 3);
        v_sesion     := depurarAlfanumerico(p_sesion, 32);

        -- 1. valido la clave del cliente

        pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        retValidarSesion := fu_validarSesion(v_sesion, v_codCanal);
        pr_insertarBitacora(retValidarSesion.codigoPersona,v_codCanal,v_sesion,c_cod_operacion,retValidarSesion.codigoEmpresa,' - fuw_admINistracionDatos ' || v_bitacora || ' ' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombrerespuesta, v_retorno.descripcionRespuesta,  null), BITACORA_ENTRADA);
        \* Obtiene la informacion de parametros recibos y el return del type *\
         paw_log.g_typ_administracionDatos := v_retorno;
         paw_log.pr_logValoresTypes('typ_administracionDatos',
         'Fu_administracionDatos'||', '||p_modo\*||', '|| p_typ_actualizacionDatos*\
         );

        IF nvl(retValidarSesion.error, 'S') = 'S' then
          v_retorno.error                := retValidarSesion.error;
          v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
          v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
          RETURN v_retorno;
        END IF;
          -- 2. valido si el usuario tiene permisos para realizar la transaccion
        v_permiso := paw_bem.lf_obt_permisos(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),retValidarSesion.codigoPerfil, c_cod_operacion, v_codCanal);
        IF v_permiso.error = 'S' THEN
          pr_mensajeUsuario(c_cod_sin_autorizacion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
          pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal,v_sesion, c_cod_operacion,retValidarSesion.codigoEmpresa, 'fu_admINistracionDatos '||paw_bem.fu_generarBitacora(v_retorno.error,  v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null) ||  v_bitacora,BITACORA_ERROR);
          RETURN v_retorno;
        END IF;

        IF v_retorno.error = 'N'  then
          v_modo := paw_bem.depurarAlfanumerico(p_modo,1);
         --tipo envio C: impreso;Z: mail;N: nada; X: impreso y mail
        BEGIN
          SELECT j.tip_extracto
            INTO v_tip_extracto
            FROM ge_clientes j
           WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);
        EXCEPTION
          WHEN no_data_found then
            v_tip_extracto := 'N';
          WHEN OTHERS THEN
            v_tip_extracto := 'N';
        END;
        BEGIN
          SELECT nvl(fug_obt_pardinamico('BWE_OFI_TIE_COURRIER', null, null, null, g.cod_oficINa), 'S')
            INTO v_ofi_tie_courrier
            FROM ge_clientes g
           WHERE g.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);
        EXCEPTION
          WHEN OTHERS THEN -- solo puede ocurrir si por algun motivo no encuentra la persona
            v_ofi_tie_courrier := 'S';
        END;

        IF v_modo = 'P' THEN
            --obtengo los datos del cliente
          BEGIN
            SELECT j.dir_correo
              INTO v_email
              FROM ba_personas j
             WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);

             IF v_email IS NULL THEN
               v_email := 'NO REGISTRADO';
             END IF;
          EXCEPTION
            WHEN no_data_found THEN
              v_email := 'NO REGISTRADO';
            WHEN OTHERS THEN
              v_email := 'NO REGISTRADO';
          END;
          --email
          v_retorno.email := v_email;
          --tipo de extracto
          v_retorno.tipoExtracto := v_tip_extracto;
          --oficina del cliente tiene courrier
          v_retorno.indOficinaCurrier := v_ofi_tie_courrier;
          SELECT a.descripcion
            INTO v_ofi_cliente
            FROM ba_oficinas a
           WHERE a.cod_oficina = (SELECT cod_oficina
                                    FROM ge_clientes
                                   WHERE cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                                   );
          v_retorno.oficinaCliente := v_ofi_cliente;
          BEGIN
            SELECT 'S'
              INTO v_es_retener
              FROM ge_dir_envios de
             WHERE de.tip_envio = 'R'
               AND de.nro_cuenta is null
               AND cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);
            EXCEPTION
              WHEN OTHERS THEN
                v_es_retener := 'N';
          END;
          v_retorno.esRetener := v_es_retener;
          pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' ||'Cantidad  '||v_listaTelefonos.Count||' Lista de Telefonos '|| ' modo: '||v_modo||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);
           --direcciones
          FOR dir IN c_direcciones LOOP
            v_can_det  := v_can_det+1;

              BEGIN
                --d = direccion r = retener c = casilla de correo k = casillero

                SELECT j.tip_envio
                  INTO v_tip_envio
                  FROM ge_dir_envios j
                 WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                   AND j.nro_cuenta is null
                   AND j.referencia = dir.cod_direccion;
              EXCEPTION
                when no_data_found then
                  v_tip_envio := 'N';
                WHEN OTHERS THEN
                  v_tip_envio := 'N';
              END;
            v_direcciones.direccion := dir.direccion;
            v_direcciones.ciudad    := dir.ciudad;
            v_direcciones.barrio    := dir.barrio;
            v_direcciones.tipo      := dir.tipo;
            v_direcciones.principal := dir.principal;
            v_direcciones.codigoCiudad := dir.cod_ciudad;
            v_direcciones.codigoBarrio := dir.cod_barrio;
            v_direcciones.codigoDireccion := dir.cod_direccion;
            v_direcciones.tipoEnvio := v_tip_envio;
            v_listaDirecciones.ExtEND;
            v_listaDirecciones(v_listaDirecciones.Count) := v_direcciones;
            IF dir.principal = 'S' then
              v_ciu_codigo := dir.cod_ciudad;
            END IF;
          END LOOP;
            v_retorno.listaDirecciones := v_listaDirecciones;
            pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' ||'Cantidad '||v_listaDirecciones.Count||' Lista de Direcciones '|| ' modo: '||v_modo||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);
         --telefonos
          FOR tel IN c_telefonos LOOP

            v_telefono.telefono := tel.telefono;
            v_telefono.area := tel.area;
            v_telefono.interno := tel.interno;
            v_telefono.tipoLINea := tel.tip_lINea;
            v_telefono.tipo := tel.tipo;
            v_telefono.principal := tel.principal;
            v_telefono.codigoTelefono := tel.cod_telefono;
            v_listaTelefonos.Extend;
            v_listaTelefonos(v_listaTelefonos.Count) := v_telefono;
         END LOOP;
          v_retorno.listaTelefonos := v_listaTelefonos;
          pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' ||'Cantidad '||v_listaTelefonos.Count||' Lista de Telefonos '|| ' modo: '||v_modo||paw_bem.fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), bitacora_salida);

      ELSIF v_modo = 'C' then--Se envian los datos para procesar
          paw_log.g_typ_actualizacionDatos := p_typ_actualizacionDatos;
          paw_log.pr_logValoresTypes('typ_actualizacionDatos',paw_log.fu_generarLog);
          v_actualiza       := p_typ_actualizacionDatos;
          v_listatelefonos  := v_actualiza.listaTelefonos;
          v_listaDirecciones:= v_actualiza.listaDirecciones;
          pr_insertarBitacora(retValidarSesion.codigoPersona,v_codCanal,v_sesion,c_cod_operacion,retValidarSesion.codigoEmpresa,' - fuw_admINistracionDatos ' || v_bitacora || ' ' || paw_bem.fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,  null), BITACORA_ENTRADA);
          BEGIN
            v_can_telefono := v_listatelefonos.count;
          EXCEPTION
            WHEN OTHERS THEN
              v_can_telefono := 0;
          END;
          BEGIN
            v_can_direccion := v_listaDirecciones.Count;
          EXCEPTION
            WHEN OTHERS THEN
              v_can_direccion := 0;
          END;
         --Procesamos el correo
            v_email      := v_actualiza.email;--p_email;
            v_ema_extrac := v_actualiza.tipoExtracto;
            v_es_retener := v_actualiza.esRetener;--p_esRetener ;

            IF v_email = 'NO REGISTRADO' then
               v_email := null;
            END IF;

            IF v_es_retener = 'S' then
              v_tip_envio := 'R';
            else
              v_tip_envio := 'D';
            END IF;

          BEGIN
            SELECT j.dir_correo
              INTO v_email_tmp
              FROM ba_personas j
             WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);

             IF v_email_tmp is null then
               v_email_tmp := 'N';
             END IF;
          END;

          IF nvl(v_email,'N') <> v_email_tmp  AND v_email <> 'N' then
            BEGIN
              update ba_personas j
                 set j.dir_correo = v_email
               WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);

               v_exi_det:='S';
               v_act_mail := 'S';
            EXCEPTION
              WHEN OTHERS THEN
               pr_mensajeUsuario(c_act_reg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_admINistracionDatos'||' ' || 'Update email'||v_email||' - '||SQLERRM, bitacora_error);
               RETURN v_retorno;
            END;
          ELSIF nvl(v_email,'N') <> v_email_tmp  AND nvl(v_email,'N') = 'N' then
                v_exi_det:='N';

                pr_mensajeUsuario(c_act_correo, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fu_admINistracionDatos'||' ' || 'Update email'||v_email||' - '||SQLERRM, bitacora_error);
               RETURN v_retorno;
         END IF;
          --Procesamos las direcciones
          IF v_can_direccion > 0 then
             FOR idx IN  v_listadirecciones.first ..v_listadirecciones.last LOOP
                   v_direcciones := v_listadirecciones(idx);

                   IF v_direcciones.accion = 'A' AND v_direcciones.principal <> 'S' then
                       BEGIN
                          SELECT 'S'
                            INTO v_existe
                            FROM ba_direcciones j
                           WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                             AND j.cod_direccion = nvl(v_direcciones.codigoDireccion,-1)
                             AND j.tipo        = nvl(v_direcciones.tipo,'x')
                             AND j.direccion   = nvl(v_direcciones.direccion,'x')
                             AND j.principal   = nvl(v_direcciones.principal,'x')
                             AND nvl(j.cod_ciudad,-1)  = nvl(v_direcciones.codigoCiudad,-1)
                             AND nvl(j.cod_barrio,-1)  = decode(nvl(v_direcciones.codigoBarrio,0),0,-1,nvl(v_direcciones.codigoBarrio,0));
                       EXCEPTION
                         when no_data_found then
                           v_existe := 'N';
                       END;

                  IF v_existe = 'N' then
                       BEGIN
                          update ba_direcciones j
                             set j.tipo        = v_direcciones.tipo,
                                 j.direccion   = v_direcciones.direccion,
                                 j.cod_ciudad  = v_direcciones.codigoCiudad,
                                 j.principal   = v_direcciones.principal,
                                 j.cod_barrio  = decode(v_direcciones.codigoBarrio,0,null,v_direcciones.codigoBarrio)
                           WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                             AND j.cod_direccion =  v_direcciones.codigoDireccion;
                            v_act_direccion := 'S';
                        EXCEPTION
                          WHEN OTHERS THEN
                              pr_mensajeUsuario(c_cod_act_direccion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                              pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'Update direccion'||v_email||' - '||SQLERRM, bitacora_error);
                        END;
                   END IF;
                  IF v_direcciones.tipoEnvio = 'S' then
                    v_dir_cod_ext := v_direcciones.codigoDireccion;
                  END IF;
                ELSIF v_direcciones.accion = 'E' then

                  BEGIN
                    SELECT 'S',1
                      INTO v_existe, v_opcion
                      FROM cr_inf_laborales j
                     WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                       AND j.cod_direccion = v_direcciones.codigoDireccion
                       AND rownum = 1;
                  EXCEPTION
                    when no_data_found then
                      v_existe := 'N';
                  END;

                  IF v_existe = 'N' then
                      BEGIN
                        SELECT 'S',2
                          INTO v_existe, v_opcion
                          FROM ge_sol_ver_particulares j
                         WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                           AND j.cod_direccion = v_direcciones.codigoDireccion
                           AND rownum = 1;
                      EXCEPTION
                        when no_data_found then
                          v_existe := 'N';
                      END;
                  END IF;

                  IF v_existe = 'N' then
                      BEGIN
                        SELECT 'S',3
                          INTO v_existe, v_opcion
                          FROM ge_dir_envios j
                         WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                           AND j.tip_envio = 'D'
                           AND j.referencia = v_direcciones.codigoDireccion
                           AND rownum = 1;
                      EXCEPTION
                        when no_data_found then
                          v_existe := 'N';
                      END;
                  END IF;

                  IF v_existe = 'N' then
                    BEGIN
                      delete FROM ba_direcciones j
                       WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                         AND j.cod_direccion = v_direcciones.codigoDireccion;
                        v_act_direccion := 'S';
                    EXCEPTION
                      WHEN OTHERS THEN
                        pr_mensajeUsuario(c_cod_eli_direccion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'ElimINa Direccion'||v_email||' - '||SQLERRM, bitacora_error);
                         RETURN v_retorno;
                     END;
                  ELSIF v_existe = 'S' AND v_opcion = 1 then
                    v_opcion := 0;

                    pr_mensajeUsuario(c_cod_eli_direccion1, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'ElimINa Direccion'||v_email||' - '||SQLERRM, bitacora_error);
                     RETURN v_retorno;
                  ELSIF v_existe = 'S' AND v_opcion = 2 then
                    v_opcion := 0;
                    pr_mensajeUsuario(c_cod_eli_direccion2, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa, 'fuw_admINistracionDatos'||' ' ||'ElimINa Direccion'||v_email||' - '||SQLERRM, bitacora_error);
                     RETURN v_retorno;
                   ELSIF v_existe = 'S' AND v_opcion = 3 then
                    v_opcion := 0;

                    pr_mensajeUsuario(c_cod_eli_direccion3, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'ElimINa Direccion'||v_email||' - '||SQLERRM, bitacora_error);
                    RETURN v_retorno;
                   END IF;
                ELSIF  v_direcciones.accion = 'N' then
                    pr_mensajeUsuario(c_dir_nueva, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'ElimINa Direccion'||v_email||' - '||SQLERRM, bitacora_error);
                    RETURN v_retorno;
                END IF;

              END LOOP;
          END IF;
          --Verifico que no hayan habido duplicaciones
          BEGIN
            SELECT count(j.principal)
              INTO v_can_det
              FROM ba_direcciones j
            WHERE j.principal = 'S'
             AND j.cod_persona =nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);
          EXCEPTION
            WHEN OTHERS THEN
              pr_mensajeUsuario(c_obt_can_direccion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
              pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'Obtiene cant. Direccion'||v_email||' - '||SQLERRM, bitacora_error);
              RETURN v_retorno;
          END;

          IF v_can_det = 0 or v_can_det > 1 then
            pr_mensajeUsuario(c_obt_err_direccion, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'Error al obt. Direccion'||v_email||' - '||SQLERRM, bitacora_error);
            RETURN v_retorno;
          END IF;
          --tipo envio C: impreso ; Z: mail;N: nada ;X: impreso y mail
          --direcciones de extractos
          IF v_ema_extrac IN ('Z','X') AND v_dir_cod_ext = 0 then
            IF v_es_retener = 'S' then
              v_tip_ext_tmp := 'X';
            else
              v_tip_ext_tmp := 'Z';
            END IF;
          ELSIF v_ema_extrac = 'X' AND v_dir_cod_ext <> 0  then
            v_tip_ext_tmp := 'X';
          ELSIF v_ema_extrac IN ('C','N') AND v_dir_cod_ext = 0  then
            IF v_es_retener = 'S' then
              v_tip_ext_tmp := 'C';
            else
              v_tip_ext_tmp := 'N';
            END IF;
          ELSIF v_ema_extrac = 'N' AND v_dir_cod_ext <> 0  then
            v_tip_ext_tmp := 'C';
          END IF;
          -- manejo adicional de errores (en caso de JavaScript desactivado)
          IF v_dir_cod_ext <> 0 AND v_es_retener = 'S' then
            v_tip_ext_tmp := 'N';
          END IF;

          IF v_tip_envio = 'R' then
            SELECT cod_oficINa
              INTO v_dir_cod_ext
              FROM ge_clientes
             WHERE cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);
          END IF;
          --actualizo la direccion de envio
          IF v_dir_cod_ext <> 0 then
            --veo si hay direcciones cargadas
            BEGIN
              SELECT 'S', trim(j.referencia)
                INTO v_existe, v_dir_codigo
                FROM ge_dir_envios j
               WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                 AND j.nro_cuenta is null;
            EXCEPTION
              when no_data_found then
                v_existe := 'N';
                v_dir_codigo := 0;
              WHEN OTHERS THEN
                v_existe := 'N';
                v_dir_codigo := 0;
            END;

            --si ya existe se actualiza
            IF v_existe = 'S' then
              BEGIN
                update ge_dir_envios j
                   set j.referencia = v_dir_cod_ext,
                       j.tip_envio = v_tip_envio
                 WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                   AND j.referencia = v_dir_codigo;
                   v_act_envio := 'S';
              EXCEPTION
                WHEN OTHERS THEN
                  pr_mensajeUsuario(c_act_reg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa, 'fuw_admINistracionDatos'||' ' ||'Update email'||v_email||' - '||SQLERRM, bitacora_error);
                 RETURN v_retorno;
              END;
            else
              BEGIN
                insert INTO ge_dir_envios(cod_persona,tip_envio,referencia)
                values(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona), v_tip_envio, v_dir_cod_ext);
                v_act_envio := 'S';
              EXCEPTION
                WHEN OTHERS THEN
                  pr_mensajeUsuario(c_err_INs_reg, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'Update email'||v_email||' - '||SQLERRM, bitacora_error);
                 RETURN v_retorno;
              END;
            END IF;
          END IF;

          --Actualizo el tipo de extracto
          IF v_tip_ext_tmp <> v_tip_extracto then
            BEGIN
              update ge_clientes j
                 set j.tip_extracto = v_tip_ext_tmp
               WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);
               v_act_tip_envio := 'S';
            EXCEPTION
              WHEN OTHERS THEN
                  pr_mensajeUsuario(c_act_reg_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                  pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'Update registro'||v_email||' - '||SQLERRM, bitacora_error);
                 RETURN v_retorno;
             END;
          END IF;
          --Procesamos los telefonos
          IF nvl(v_can_telefono,0) > 0 then

              FOR idx IN  v_listatelefonos.first ..v_listaTelefonos.last LOOP
                   v_telefono := v_listatelefonos(idx);
                IF v_telefono.accion = 'A' then
                  --Si el dato es el mismo no lo actualizo
                  BEGIN
                    SELECT 'S'
                    INTO v_existe
                    FROM ba_telefonos j
                    WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                      AND j.cod_telefono = v_telefono.codigoTelefono
                      AND j.telefono = v_telefono.telefono
                      AND nvl(j.area,'X') = nvl(v_telefono.area,'X')
                      AND nvl(j.interno,'X') = nvl(v_telefono.interno,'X')
                      AND j.tip_linea = v_telefono.tipoLINea
                      AND j.principal = v_telefono.prINcipal
                      AND j.tipo = v_telefono.tipo;
                  EXCEPTION
                    WHEN no_data_found then
                      v_existe := 'N';
                  END;

                IF v_existe = 'N' AND v_telefono.principal = 'N' then

                   IF  v_telefono.interno = 'null' then
                       v_telefono.interno := null;
                   END IF;

                    BEGIN
                      UPDATE ba_telefonos j
                         SET j.tipo        = v_telefono.tipo,
                             j.tip_lINea   = v_telefono.tipoLINea,
                             j.telefono    = v_telefono.telefono,
                             j.area        = v_telefono.area,
                             j.interno     = v_telefono.interno,
                             j.prINcipal   = v_telefono.prINcipal
                       WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                         AND j.cod_telefono= v_telefono.codigoTelefono;

                         v_act_telefono := 'S';
                    EXCEPTION
                      WHEN OTHERS THEN
                        pr_mensajeUsuario(c_act_reg_telefono, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'Update telefono'||v_telefono.codigoTelefono||' - '||SQLERRM, bitacora_error);
                       RETURN v_retorno;
                     END;
                  END IF;
                ELSIF v_telefono.accion = 'E' then
                  --verIFico si puedo elimINar
                  BEGIN
                    SELECT 'S',1
                      INTO v_existe, v_opcion
                      FROM cr_inf_laborales j
                     WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                       AND j.cod_telefono = v_telefono.codigoTelefono
                       AND rownum = 1;
                  EXCEPTION
                    WHEN no_data_found THEN
                      v_existe := 'N';
                  END;

              IF v_existe = 'N' then
                    BEGIN
                      delete FROM ba_telefonos j
                       WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
                         AND j.cod_telefono = v_telefono.codigoTelefono;
                         v_act_telefono := 'S';
                    EXCEPTION
                      WHEN OTHERS THEN
                      pr_mensajeUsuario(c_eli_reg_telefono, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                      pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'ElimINa telefono'||v_email||' - '||SQLERRM, bitacora_error);
                     RETURN v_retorno;
                    END;
                  ELSIF v_existe = 'S' AND v_opcion = 1 then
                    v_opcion := 0;
                    pr_mensajeUsuario(c_eli_reg_telefono, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'ElimINa telefono'||v_email||' - '||SQLERRM, bitacora_error);
                    RETURN v_retorno;
                  ELSIF v_existe = 'S' AND v_opcion = 2 then
                    v_opcion := 0;
                    pr_mensajeUsuario(c_eli_reg_telefono, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                    pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'ElimINa telefono'||v_email||' - '||SQLERRM, bitacora_error);
                    RETURN v_retorno;
                  END IF;
                ELSIF v_telefono.accion = 'N' then
                  --Obtengo cod_telefono
                  BEGIN
                    SELECT nvl(max(j.cod_telefono),0)+1
                      INTO v_tel_codigo
                      FROM ba_telefonos j
                     WHERE j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona);
                  EXCEPTION
                    WHEN OTHERS THEN
                      pr_mensajeUsuario(c_err_obt_reg, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                      pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'Error Obt Datos'||v_email||' - '||SQLERRM, bitacora_error);
                      RETURN v_retorno;
                   END;

                  IF v_retorno.error = 'N' then

                      IF  v_telefono.interno = 'null' then
                         v_telefono.interno := null;
                     END IF;

                    BEGIN
                      INSERT INTO ba_telefonos (tipo, tip_lINea, telefono, cod_telefono, cod_persona,
                                                prINcipal, area, interno\*, cod_ent_compania*\)
                      VALUES (v_telefono.tipo \*v_tel_tipo*\,v_telefono.tipoLINea \*v_tel_lINea*\,v_telefono.telefono \*v_tel_numero*\,
                              v_tel_codigo, nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                              v_telefono.principal \*v_tel_prINci*\, v_telefono.area \*v_tel_area*\, v_telefono.interno \*v_tel_INter*\\*, v_telefono.codigoEntidadCompania*\ \*v_cod_ent_compania*\);
                      v_act_telefono := 'S';
                    EXCEPTION
                      WHEN OTHERS THEN
                        pr_mensajeUsuario(c_err_INs_reg, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                        pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa, 'fuw_admINistracionDatos'||' ' ||'INsertar Datos'||''||' - '||SQLERRM, bitacora_error);
                        RETURN v_retorno;
                     END;
                  END IF;
                END IF;
               END LOOP;
           END IF;
           --VerIFico que no hayan habido duplicaciones
          BEGIN
            SELECT count(j.principal)
              INTO v_can_det
              FROM ba_telefonos j
            WHERE j.principal = 'S'
             AND j.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigopersona);
          EXCEPTION
            WHEN OTHERS THEN
            pr_mensajeUsuario(c_obt_cant_telefono, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'Cantidad de telefono'||' '||' - '||SQLERRM, bitacora_error);
            RETURN v_retorno;
            END;

          IF v_can_det = 0 or v_can_det > 1 then

            pr_mensajeUsuario(c_err_can_telefono, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
            pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa,'fuw_admINistracionDatos'||' ' || 'Cantidad de telefono'||' '||' - '||SQLERRM, bitacora_error);
            RETURN v_retorno;
         END IF;

          prw_obt_dat_oficial(retValidarSesion.codigoPersona,v_nom_oficial, v_tel_oficial, v_cor_oficial);

          v_tex_mail :=
                     'Informamos que se ha realizado con exito la modificacion de la siguiente informacion en Homebanking Web:'||chr(10)||chr(10);
          IF v_exi_det = 'S' then
             v_tex_mail := v_tex_mail||
                        '- Direccion de correo electronico, la nueva es: '||v_email||'.'||chr(10);
          END IF;
          IF v_act_direccion = 'S' then
             v_tex_mail := v_tex_mail||
                        '- Direccion fisica.'||chr(10);
          END IF;
          IF v_act_envio = 'S' then
             v_tex_mail := v_tex_mail||
                        '- Direccion de envio de extracto.'||chr(10);
          END IF;
          IF v_act_factura = 'S' then
             v_tex_mail := v_tex_mail||
                        '- El medio de impresion de facturas.'||chr(10);
          END IF;
          IF v_act_tip_envio = 'S' then
             v_tex_mail := v_tex_mail||
                        '- El medio envio de extractos.'||chr(10);
          END IF;
          IF v_act_telefono = 'S' then
             v_tex_mail := v_tex_mail||
                        '- Datos del telefono.'||chr(10);
          END IF;
           v_tex_mail := v_tex_mail||chr(10);


          IF v_retorno.error= 'N' AND v_email_tmp <> 'N' then
            it_mail.mail(fug_obt_dir_correo,
                         v_email_tmp,
                         'Actualizacion; de datos personales.',
                         'Estimado cliente,'||chr(10)||chr(10)||v_tex_mail||
                         'Si usted no ha realizado esta modificacion, favor contacte con su Oficial o comuniquese a nuestro Contact Center a los telefonos 0800 - 11 00 20 +595 21 416 8000  *4168.'||chr(10)||chr(10)||
                         'Atentamente,'||chr(10)||chr(10)||
                         fug_obt_nom_entidad
                         );
          ELSIF v_email_tmp = 'N' AND v_exi_det = 'S' then
              prw_reg_log_mail(fug_obt_dir_correo, null,'Actualizacion de datos personales.',
                              'Estimado cliente,'||chr(10)||chr(10)||v_tex_mail||chr(10)||chr(10)||
                               'Si usted no ha realizado esta modificacion, favor contacte con su Oficial o comuniquese a nuestro Contact Center a los telefonos  0800 - 11 00 20 +595 21 416 8000  *4168.'||chr(10)||chr(10)||
                                'Atentamente,'||chr(10)||chr(10)||
                                fug_obt_nom_entidad,
                               'No se encontro direccion de correo destino, favor verificar direccion de correo de la persona '||nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona));
          END IF;

          IF v_retorno.error = 'N' AND v_cor_oficial is not null then
            it_mail.mail(fug_obt_dir_correo,
                         v_cor_oficial,
                         'Actualizacion de datos personales del cliente '||fue_obt_nom_persona(nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona))||'(' ||nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)||')',
                         v_tex_mail||chr(10)||chr(10)||fug_obt_nom_entidad
                         );
          ELSIF v_email_tmp = 'N' AND v_exi_det = 'S' then
              prw_reg_log_mail(fug_obt_dir_correo, null,'Actualizacion de datos personales del cliente '||nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona),
                               v_tex_mail||chr(10)||chr(10)||fug_obt_nom_entidad,
                               'No se encontro direccion de correo destino, favor verificar direccion de correo de la persona '||nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona));
          END IF;


          IF v_retorno.error = 'N'
            AND v_ofi_tie_courrier = 'N' AND v_es_retener = 'N' AND v_dir_cod_ext <> 0 then
            -- se obtiene datos del cliente para el mail
            SELECT cod_oficina
              INTO v_cod_ofi_cliente
              FROM ge_clientes g
             WHERE g.cod_persona = nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona);
            SELECT d.direccion || ' - Ciudad: ' || nvl(e.descripcion, '------') || ' - Barrio: ' ||  nvl(f.descripcion, '------')
              INTO v_direccion
              FROM ba_direcciones d
              INner joIN ge_dir_envios de
                on (d.cod_persona = de.cod_persona)
              left joIN ba_ciudades e
                on (d.cod_pais = e.cod_pais AND d.cod_ciudad = e.cod_ciudad)
              left joIN ba_barrios f
                on (d.cod_pais = f.cod_pais AND d.cod_ciudad = f.cod_ciudad AND d.cod_barrio = f.cod_barrio)
             WHERE d.cod_persona = nvl(retValidarSesion.codigoEmpresa, retValidarSesion.codigoPersona)
               AND de.referencia = d.cod_direccion
               AND de.nro_cuenta is null;
            SELECT nom_completo
              INTO v_nom_cliente
              FROM ba_personas
             WHERE cod_persona = nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona);
               it_mail.mail(fug_obt_dir_correo,
                         fug_obt_pardinamico('ENV_MAI_CAM_DIRECCION', null, null, null, v_cod_ofi_cliente),
                         'Modificacion de la direccion de envio de extracto (Suc. Sin cobertura de courrier)',
                         'El cliente: ' || nvl(retValidarSesion.codigoEmpresa,retValidarSesion.codigoPersona) || ' - ' || v_nom_cliente || chr(10) ||
                         'ha modificado su direccion de envio de extracto, colocando la direccion:' || chr(10) ||
                         v_direccion || '.' ||chr(10) || chr(10) ||
                         'Favor verifique si la ciudad tiene cobertura de Courrier y pongase en contacto con el cliente' || chr(10) ||
                         'para confirmar la modificacion.'
                         );
          END IF;
          -- registro del movimiento (LOG)
          -- registro del movimiento (LOG)
           paw_con.pr_reg_operacion(null,    --p_nro_cuenta
                                   null,            --p_cod_moneda
                                   null,            --p_monto
                                   null,            --p_nro_cta_contra
                                   null,            --p_cantidad
                                   'Accion',         --p_etiqueta
                                   'Actualizacion de datos.',  --p_dato
                                   'Respuesta',         --p_etiqueta2
                                   substr(v_retorno.descripcionRespuesta,1,50), --p_dato2
                                   'AdministracionDatos', --Observacion,
                                   null, --Direccion IP
                                   v_modo||'-'||'Administracion Datos',
                                   retValidarSesion.codigoPersona,
                                   c_cod_operacion,
                                   null,
                                   C_COD_HOMEBANKING,
                                   p_sesion,
                                   retValidarSesion.codigoPersona
                                   );  --Mensaje

          commit;
          RETURN v_retorno;
        END IF;
      END IF;
      RETURN v_retorno;
    EXCEPTION
    WHEN OTHERS THEN
      pr_mensajeUsuario(c_pre_otr_error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(retValidarSesion.codigoPersona, v_codCanal, v_sesion, c_cod_operacion, retValidarSesion.codigoEmpresa, 'AdministracionDatos'||' - '||SQLERRM, bitacora_error);
      RETURN v_retorno;
    END fu_AdministracionDatos;*/

  /*FUNCTION fu_obtenerBarrios(p_sesion       IN VARCHAR2,
                               p_codigoCanal  IN VARCHAR2,
                               p_codigoCiudad IN VARCHAR2,
                               p_codigoPais  IN VARCHAR2)
        RETURN typ_barrios IS

        c_cod_operacion CONSTANT VARCHAR2(3) := '228';
        c_sin_barrios   CONSTANT VARCHAR2(3) := '301';

        retValidarSesion typ_validarSesion;
