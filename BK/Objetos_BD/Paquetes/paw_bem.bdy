            pr_insertarBitacora(retValidarSesion.codigoPersona,v_cod_canal, v_sesion,c_cod_operacion, NULL, 'obtenerCiudades -' || SQLERRM,BITACORA_ERROR);
            RETURN v_retorno;
        END;
      END LOOP;

      v_retorno.listaCiudades := v_listaCiudades;

      IF v_can_ciudades = 0 THEN
        pr_mensajeUsuario(c_sin_barrios,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
        pr_insertarBitacora(retValidarSesion.codigoPersona, v_cod_canal,v_sesion, c_cod_operacion,NULL,v_bitacora,bitacora_salida);
