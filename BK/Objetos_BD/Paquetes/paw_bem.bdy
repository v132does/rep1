      WHEN OTHERS THEN
         RETURN -7;
   END;*/

   /*genera una clave lista para guardar en bw_ope_claves, si generar ='S'
   crea una clave con un numero aleatorio y la retorna en p_cla_operacion
   la clave no debe ser almacenada en ningun lugar en plano, siempre tiene que estar al menos hasheada
   p_cod_per_vinculada tiene que ser nulo si es una persona fisica*/
  /* FUNCTION fu_gen_ope_clave (p_clave           in  varchar2,
                           p_cod_persona       in  varchar2,
                           p_cod_per_vinculada in  varchar2,
                           p_accion            in  varchar2,
                           p_tip_clave         in  varchar2,
                           p_cla_operacion     out varchar2)
   return varchar2 is
    v_salt      NUMBER;
    v_clave     VARCHAR(300);
    v_clave_aux NUMBER;
    v_ret       NUMBER;
    v_retorna   VARCHAR2(1);
    v_dia_dur   ge_par_dinamicos.val_parametro%TYPE := fug_obt_pardinamico('PAW_CAN_DIA_CAD_CLA');

   --guarda en el log
   BEGIN
   --verifica que la persona este relacionada a la empresa
   IF p_cod_per_vinculada IS NOT NULL THEN
     IF lf_val_per_vinculada(p_cod_per_vinculada, p_cod_persona) = 'N' THEN
        RETURN -5;
     END IF;
   END IF;
   v_salt := round(dbms_random.value(1000000, 9999999));
   IF (p_clave IS NULL OR p_accion = 'C') THEN
    IF (p_tip_clave='A') then
     v_clave_aux     := round(dbms_random.value(100000000, 999999999));
    ELSE
     v_clave_aux     := round(dbms_random.value(100000, 999999));
    END IF;
     p_cla_operacion := v_clave_aux;
   ELSIF p_accion <> 'A' THEN -- p_clave ya viene hasheada con p_accion = 'A'
     v_clave_aux := to_number(p_clave);
   END IF;
    --hago el hash 2 veces porque necesito poder enviar desde el hb la clave y que no se pueda ver en los logs
    --se va a enviar la clave hasheada, entonce se vuelve a hashear
    --los hash se guardan en minusculas para que sean iguales a los producidos por perl
    -- modificado para reutilizar desde fu_pro_operacion_080 y fu_pro_operacion_219
    -- donde la clave ya viene hasheada y envia p_accion = 'A'
    IF p_accion = 'A' THEN
       v_clave := p_clave;
    ELSE
      --no se aplica sha256 porque se quiere mantener la misma logica anterior y sobre ella el sha 256
      v_clave := lower(rawtohex(utl_raw.cast_to_raw(dbms_obfuscation_toolkit.md5(input_string => v_clave_aux))));

      --ajuste sha256
      v_clave := fuw_obt_sha256(v_clave);
      --

    END IF;
    --aca hasheo el hasheo de la clave
    --v_clave := v_salt || '|' || v_clave;
    --v_clave := rawtohex(utl_raw.cast_to_raw(dbms_obfuscation_toolkit.md5(input_string => v_clave)));

   --Si accion es N, crear Nueva contrasenha
    CASE p_accion
       WHEN 'C' THEN
          BEGIN
             INSERT INTO bw_ope_claves
                (cla_verificador, clave, can_acceso, est_clave, cod_persona, cod_per_vinculada, tip_clave,cla_impresa) --FSPC-245
             VALUES
                (v_salt, v_clave, 0, 'N', p_cod_persona, p_cod_per_vinculada, p_tip_clave,v_clave_aux); --FSPC-245
             lp_cla_reg_operacion(p_cod_persona, p_accion, p_cod_per_vinculada, p_tip_clave);
          EXCEPTION
             WHEN dup_val_on_index THEN
                --Si hay error de PK intenta actualizar
                BEGIN
                   UPDATE bw_ope_claves
                      SET cla_verificador = v_salt,
                          clave           = v_clave,
                          est_clave       = 'N',
                          can_intentos    = 0,
                          cla_impresa = v_clave_aux --FSPC-245
                    WHERE cod_persona = p_cod_persona
                      AND tip_clave = p_tip_clave
                      AND (
                           (p_cod_per_vinculada IS NULL AND cod_per_vinculada IS NULL) OR
                           (p_cod_per_vinculada IS NOT NULL AND cod_per_vinculada = p_cod_per_vinculada)
                          );
                   lp_cla_reg_operacion(p_cod_persona, p_accion, p_cod_per_vinculada, p_tip_clave);
                EXCEPTION
                   WHEN OTHERS THEN
                      RETURN - 7;
                END;
             WHEN OTHERS THEN
                RETURN - 1;
          END;

       WHEN 'R' THEN
          --La accion es cambiar la contrasenha
          DECLARE
             i NUMBER;
          BEGIN
            if fu_ver_cla_anterior(p_cod_persona, v_clave, p_tip_clave, '') = 'N' then
               UPDATE bw_ope_claves
                  SET cla_verificador = v_salt,
                      clave           = v_clave,
                      est_clave       = 'N',
                      can_intentos    = 0
                WHERE cod_persona = p_cod_persona
                  AND tip_clave = p_tip_clave
                  AND (
                       (p_cod_per_vinculada IS NULL AND cod_per_vinculada IS NULL) OR
                       (p_cod_per_vinculada IS NOT NULL AND cod_per_vinculada = p_cod_per_vinculada)
                      );
               i := SQL%ROWCOUNT;
               IF i = 0 THEN
                  -- no se actualizo ningun registro
                  RETURN - 3;
               END IF;

                v_ret  := fu_ins_cla_anterior(p_cod_persona, v_clave, p_tip_clave, '');
                if v_ret != 0 then
                    return -7;
                end if;

                lp_cla_reg_operacion(p_cod_persona, p_accion, p_cod_per_vinculada, p_tip_clave);
             else
               return -8;
             end if;
          EXCEPTION
             WHEN OTHERS THEN
                RETURN - 2;
          END;
    WHEN 'A' THEN
       -- verificamos si la clave ya esta en uso
       IF fu_val_vul_claves(p_cod_persona, p_clave) = 'N' THEN
          RETURN -6;
       END IF;

       if fu_ver_cla_anterior(p_cod_persona, v_clave, p_tip_clave, '') = 'N' then
           -- actualizar clave nueva y estado
           UPDATE bw_ope_claves
              SET clave           = v_clave,
                  cla_verificador = v_salt,
                  fec_cam_clave   = SYSDATE,
                  fec_ult_acceso  = SYSDATE,
                  can_intentos    = 0,
                  est_clave       = 'M'
            WHERE cod_persona = p_cod_persona
              AND ((p_cod_per_vinculada IS NULL AND cod_per_vinculada IS NULL) OR
                   (p_cod_per_vinculada IS NOT NULL AND cod_per_vinculada = p_cod_per_vinculada)
                  )
              AND tip_clave = p_tip_clave;
           -- controlamos si hubo actualizacion
           IF SQL%NOTFOUND THEN
              -- no se actualizo ningun registro
              RETURN - 3;
           END IF;

            v_ret  := fu_ins_cla_anterior(p_cod_persona, v_clave, p_tip_clave, '');
            if v_ret != 0 then
                return -7;
            end if;

            lp_cla_reg_operacion(p_cod_persona, p_accion, p_cod_per_vinculada, p_tip_clave);
       else
           return -8;
       end if;

    END CASE;
    IF nvl(fue_per_dat_adicional(p_cod_persona, 'PAW_IND_ENV_CLA_COR'), 'N') = 'S' THEN
      \*IF p_tip_clave = 'A' THEN
            it_mail.mail(fug_obt_dir_correo,
                         fug_obt_dir_mail_per(p_cod_persona),
                         'Generacion clave de Acceso',
                         'Estimado Cliente:
                          La clave para el ingreso a las plataformas digitales de Finexpar es '||v_clave_aux||', esta clave tiene una duracion de '||v_dia_dur||' dias desde el momento de la recepcion. Una vez que ingrese al sistema le solicitara el cambio de clave por seguridad.
                          Le recordamos que la clave es de uso personal.
                          Desde ya, gracias.');
         ELSE
           it_mail.mail(fug_obt_dir_correo,
                         fug_obt_dir_mail_per(p_cod_persona),
                         'Generacion Clave Transaccional',
                         'Estimado Cliente:
                          La clave transaccional para operaciones en las plataformas digitales de Finexpar es '||v_clave_aux||', esta clave tiene una duracion de '||v_dia_dur||' dias desde el momento de la recepcion.
                          Una vez que precise realizar alguna operacion le solicitar? el cambio de clave por seguridad.
                          Le recordamos que la clave es de uso personal. Si tiene algun inconveniente clave favor comunicarse al 021 218 7000 o con su Oficial de Negocios.
                          Desde ya, gracias.');
         END IF;*\--FSPC-245

         update bw_ope_claves
            set usu_impresion= user,
                fec_impresion = sysdate,
                cod_ofi_impresion = fug_obt_ofi_usuario(USER)
          where cod_persona = p_cod_persona
          and ((p_cod_per_vinculada IS NULL AND cod_per_vinculada IS NULL) OR
              (p_cod_per_vinculada IS NOT NULL AND cod_per_vinculada = p_cod_per_vinculada))
            and tip_clave   =   p_tip_clave;  --jbenitez
     END IF;
     RETURN v_clave_aux;
    --RETURN lower(v_clave);
    --RETURN v_clave;
   END;*/

   /* Funcion que valida que el codigo de persona este vinculada a la empresa */
   FUNCTION lf_val_per_vinculada(p_cod_per_empresa in ge_clientes.cod_persona%type,
                                p_cod_persona     in ge_clientes.cod_persona%type)
    return varchar2 is
    v_sino varchar2(1) := 'N';
   begin
     begin
       if pag_gen.fu_es_per_fisica(p_cod_per_empresa) = 'N' then
         select 'S'
           into v_sino
           from ba_vinculos
          where cod_per_vinculo = p_cod_persona
            and cod_persona = p_cod_per_empresa;
       end if;
    exception
    when no_data_found then
      null;
    when others then
    null;
    end;
    return v_sino;
   end;

   --Guarda una accion con las claves de operaciones
   PROCEDURE lp_cla_reg_operacion(p_cod_persona in varchar2, p_accion in varchar2,p_cod_per_vinculada in varchar2, p_tip_clave in varchar2) is
    PRAGMA AUTONOMOUS_TRANSACTION; --- para que grabe solo esta transaccion
    begin
     insert into BW_CLA_ACCIONES
        (cod_persona,accion,tip_clave,cod_per_vinculada)
      values
        (p_cod_persona,p_accion,p_tip_clave,p_cod_per_vinculada);--Codigo C es para Crear -- R Cambiar
      commit;
    exception
     when others then
        raise_application_error(-20000,sqlerrm);
  end;

  -- funcion que valida que una clave (de acceso o transaccional) no se repita,
  -- si un usuario posee varias claves, todas deben ser diferentes, p_cla_nueva esta en MD5
  -- S : la clave es valida para usar, N : caso contrario
  FUNCTION fu_val_vul_claves(p_cod_persona in bw_ope_claves.cod_persona%type,
                             p_cla_nueva   in bw_ope_claves.clave%type) return varchar2 is
  v_cla_valida      varchar2(1) := 'S'; -- es valida la clave
  v_clave           varchar2(300);
  v_nro_doc_cliente ba_personas.nro_documento%type;
  -- obtiene todas las claves que posee la persona
  cursor c_claves is
    select cla_verificador, clave, cod_per_vinculada
      from bw_ope_claves
     where cod_persona = p_cod_persona;
  begin
    -- buscamos si ya existe la clave nueva creada
    for cla in c_claves loop

      --ajuste sha256
      --v_clave := cla.cla_verificador || '|' || p_cla_nueva;
      --v_clave := rawtohex(utl_raw.cast_to_raw(dbms_obfuscation_toolkit.md5(input_string => v_clave)));
      v_clave := p_cla_nueva;
      --

      if v_clave = cla.clave then
        v_cla_valida := 'N'; -- no es valida la clave
        exit;
      end if;
      -- buscamos si escogio la clave igual a su cod. persona vinculada
      if v_cla_valida = 'S' and cla.cod_per_vinculada is not null then

        --ajuste sha256
        v_clave := fuw_obt_sha256(lower(rawtohex(utl_raw.cast_to_raw(dbms_obfuscation_toolkit.md5(input_string => cla.cod_per_vinculada)))));
        --

        if v_clave = p_cla_nueva then
          v_cla_valida := 'N';
          exit;
        end if;
      end if;
    end loop;
    -- buscamos si escogio la clave igual a su cod. persona
    if v_cla_valida = 'S' then

      --ajuste sha256
      v_clave := fuw_obt_sha256(lower(rawtohex(utl_raw.cast_to_raw(dbms_obfuscation_toolkit.md5(input_string => p_cod_persona)))));
      --

      if v_clave = p_cla_nueva then
        v_cla_valida := 'N';
      end if;
    end if;

    -- buscamos si escogio la clave igual a su CI
    if v_cla_valida = 'S' then
      begin
        select a.nro_documento
          into v_nro_doc_cliente
          from ba_personas a
         where a.cod_persona = p_cod_persona;

        --ajuste sha256
        v_clave := fuw_obt_sha256(lower(rawtohex(utl_raw.cast_to_raw(dbms_obfuscation_toolkit.md5(input_string => v_nro_doc_cliente)))));
        --

        if v_clave = p_cla_nueva then
          v_cla_valida := 'N';
        end if;
      exception
        when others then
          v_cla_valida := 'N';
      end;
    end if;
    return v_cla_valida;
  end;

  --obtener el ultimo Nro. de Hoja de Seguridad
  FUNCTION fu_obt_nro_seguridad (p_cod_cliente       in varchar2,
                                 p_cod_per_vinculada in varchar2,
                                 p_tip_clave         in varchar2)
  return number is
  v_hoj_seguridad number(6);
  begin
     if p_tip_clave in ('T', 'A') then
        begin
           select a.nro_hoj_seguridad
             into v_hoj_seguridad
             from bw_cla_acciones a
            where a.cod_persona   = p_cod_cliente
              and a.accion        = 'H'
              and a.tip_clave     = p_tip_clave
              and nvl(a.cod_per_vinculada,-1) = nvl(p_cod_per_vinculada,-1)
              and a.fec_insercion = (select max(fec_insercion)
                                       from bw_cla_acciones
                                      where cod_persona = p_cod_cliente
                                        and accion      = 'H'
                                        and tip_clave   = p_tip_clave
                                        and nvl(cod_per_vinculada,-1) = nvl(p_cod_per_vinculada,-1));

           return v_hoj_seguridad;
        exception
           when no_data_found then
              v_hoj_seguridad := null;
              return v_hoj_seguridad;
           when others then
              raise_application_error(-20001,'Error en la tabla (BW_CLA_ACCIONES).'||sqlerrm);
        end;
     else
        raise_application_error(-20003,'Error en la tabla (BW_CLA_ACCIONES), tipo de clave no reconocido.'||sqlerrm);
     end if;
  end;

  FUNCTION fu_act_est_clave(p_cod_persona       bw_ope_claves.cod_persona%TYPE,
                            p_cod_per_vinculada bw_ope_claves.cod_per_vinculada%TYPE,
                            p_tipo              varchar2,
                            p_est_clave         bw_ope_claves.est_clave%TYPE)
  return boolean IS
  v_actualizo  boolean;
  v_fec_actual date := pag_cal.fu_obt_fec_actual(1);
  --p_tipo Tipo Clave. Valores: (T/Transaccional, A/Acceso)
  begin
     -- actualizar el valor del estado de la clave a IMPRESA.
     begin
        pre_ini_aplicacion;
        pae_cnf.g_cod_modulo := 1;
     end;

     v_actualizo := true;

     if p_tipo in ('A', 'T') then -- si el tipo de clave es acceso o transaccional

        if p_est_clave = 'A' then
           insert into bw_cla_acciones(usu_insercion, cod_persona, cod_per_vinculada, accion, tip_clave)
           values (user, p_cod_persona, p_cod_per_vinculada, 'A', p_tipo/*'T'*/);
        end if;

        -- Se le llama desde el report GLCLAOPE para tip_clave = 'T'
        -- Se le llama desde el report GLCLAVE  para tip_clave = 'A'
        update bw_ope_claves
           set est_clave         = nvl(p_est_clave, 'I'),
               fec_est_clave     = v_fec_actual,
               cla_impresa       = null,
               usu_impresion     = user,
               fec_impresion     = v_fec_actual,
               cod_ofi_impresion = fug_obt_ofi_usuario(user)
         where cod_persona       = p_cod_persona
           and (
                (p_cod_per_vinculada is null and cod_per_vinculada is null) or
                (p_cod_per_vinculada is not null and cod_per_vinculada = p_cod_per_vinculada)
               )
           and tip_clave = p_tipo;

        if SQL%NOTFOUND then
           v_actualizo := false;
        end if;
     else
        v_actualizo := false;
     end if;

     if v_actualizo then
        commit;
     else
        rollback;
     end if;

     return(v_actualizo);
  exception
     when others then
        raise_application_error(-20000, 'Error en FU_ACT_EST_CLAVE. ' || sqlerrm);
  end;

  FUNCTION fu_obt_sig_nro_secuencia(p_cod_ente    IN ge_pag_sue_lotes.cod_ente%TYPE,
                                    p_fec_proceso IN ge_pag_sue_lotes.fec_proceso%TYPE)
  RETURN NUMBER IS

    v_nro_secuencia NUMBER(3);

  BEGIN

    SELECT NVL(MAX(nro_secuencia),0) + 1
      INTO v_nro_secuencia
      FROM ge_pag_sue_lotes s1
     WHERE s1.cod_ente = p_cod_ente
       AND trunc(s1.fec_proceso) = trunc(p_fec_proceso);
    RETURN v_nro_secuencia;

  EXCEPTION
    WHEN no_data_found THEN
       v_nro_secuencia := 1;
       RETURN v_nro_secuencia;
  END;

   /**
   * Consulta de Autorizaciones Pendientes por persona
   * Detalla solamente las autorizaciones pendientes de confirmacion por
   * persona
   * @Fecha : 13-10-2014
   */

  FUNCTION fu_obtenerAutorizacionUsuario( p_sesion  IN VARCHAR2,
                                           p_codigoCanal IN VARCHAR2,
                                           p_estado      IN VARCHAR2 DEFAULT NULL )
                    RETURN typ_consultaAutorizaciones IS

      v_cod_operacion        VARCHAR2(3) := '024';
      v_cta_formateada       VARCHAR2(17);
      v_estado                VARCHAR2(10);
      v_can_autorizaciones   NUMBER := 0;
      v_sesion               bw_aut_sesiones.cod_sesion%type;
      v_codigocanal          ge_canales.cod_canal%type;
      userInfo               typ_validarSesion;
      v_mensajeCaja          typ_mensajeCaja;
      v_retorno              typ_consultaAutorizaciones := typ_consultaAutorizaciones();
      v_lis_detalle          typ_listaAutorizaciones := typ_listaAutorizaciones();
      v_res_autorizacion     typ_resumenAutorizacion := typ_resumenAutorizacion();
      v_permiso              typ_obtenerpermisos;

      -- detalle de movimientos pendientes, anulados o confirmados
      CURSOR c_ope_pendientes(p_cod_per_empresa IN ba_personas.cod_persona%TYPE,
                              p_cod_persona IN ba_personas.cod_persona%TYPE ) IS
         SELECT a.nro_documento, a.fec_hora, b.descripcion, a.cod_tip_mensaje,
                 c.nro_cuenta cta_formateada,
                a.nro_cuenta, a.cod_moneda, a.monto, c.cod_modulo, a.estado est_mov,
                decode(a.estado, 'A', 'Anulada', 'C', 'Confirmada', 'P', 'Pendiente') estado,
                a.referencia, a.can_aut_requeridas, a.can_aut_faltantes, a.cod_per_ingreso, a.fec_insercion
           FROM ge_cuentas c, bw_tip_mensajes b, bw_mov_pendientes a
          WHERE a.cod_per_principal = p_cod_per_empresa
            AND c.nro_cuenta = a.nro_cuenta
            AND (v_estado IS NULL OR a.estado = v_estado)
            AND b.cod_tip_mensaje = a.cod_tip_mensaje
            AND trunc(a.fec_insercion) >= trunc(SYSDATE)
            AND a.cod_per_ingreso != p_cod_persona
            ORDER BY TRUNC(a.fec_insercion) DESC, DECODE(a.estado, 'P', 0, 'C', 1, 2) ASC;

   BEGIN
      v_codigocanal  := depurarAlfanumerico(p_codigoCanal,3);
      v_sesion       := depurarAlfanumerico(p_sesion,32);
      v_estado       := trim(p_estado);
      -- Valido la Sesion del Cliente
      userInfo := fu_validarSesion(v_sesion, v_codigocanal);

      IF userInfo.error = 'S' THEN
         v_retorno.error                := userInfo.error;
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(userinfo.codigoPersona,p_codigoCanal, p_sesion,v_tip_mensaje,userinfo.codigoEmpresa, 'obtenerAutorizaciones. Estado' || p_estado|| fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta, NULL),BITACORA_ENTRADA);
       -- Verifica el canal de origen
      v_mensajeCaja := lf_val_caja(userInfo);

      IF v_mensajeCaja.error = 'S' THEN
         v_retorno.error                := v_mensajeCaja.error;
         v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
     -- 3. verifico si el cliente con su perfil tendra acceso a realizar la transaccion
      v_permiso := lf_obt_permisos(nvl(userInfo.codigoEmpresa, userInfo.codigoPersona),userInfo.codigoPerfil, v_cod_operacion,userInfo.codigoCanal);--nvl(v_usu_sesion.codigoEmpresa, v_usu_sesion.codigoPersona), v_usu_sesion.codigoPerfil, v_cod_operacion, v_usu_sesion.codigoCanal);
      IF (v_permiso.error = 'S') THEN
         v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
         v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
         v_retorno.error                := v_permiso.error;
         pr_insertarBitacora(userInfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userInfo.codigoEmpresa,   'fu_obtenerAutorizacionUsuario ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
         /* Obtiene la informacion de parametros recibos y el return del type */
         RETURN v_retorno;
      END IF;

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
      -- Selecciona los Movimientos Pendientes
      FOR mp IN c_ope_pendientes(userInfo.codigoEmpresa, userInfo.codigoPersona )
      LOOP
            v_can_autorizaciones := v_can_autorizaciones + 1;

            IF mp.cod_modulo = 5 THEN
               v_cta_formateada := lf_obt_nro_tarjeta(mp.nro_cuenta, userInfo.codigoPersona, userInfo.codigoEmpresa);
            ELSE
               v_cta_formateada := mp.cta_formateada;
            END IF;

            v_res_autorizacion.numeroDocumento := mp.nro_documento;
            v_res_autorizacion.fecha           := mp.fec_hora;
            v_res_autorizacion.descripcion     := substr(mp.descripcion, 1, 60);
            v_res_autorizacion.numeroCuenta    := substr(v_cta_formateada, 1, 17);
            v_res_autorizacion.moneda          := mp.cod_moneda;
            v_res_autorizacion.monto           := mp.monto;
            v_res_autorizacion.estado          := substr(mp.estado, 1, 10);
            v_res_autorizacion.autorizacionesRequeridas := mp.can_aut_requeridas;
            v_res_autorizacion.autorizacionesFaltantes := mp.can_aut_faltantes;

            v_lis_detalle.extend;
            v_lis_detalle(v_lis_detalle.count) := v_res_autorizacion;

      END LOOP;

      v_retorno.cantidadAutorizaciones   := v_can_autorizaciones;
      v_retorno.listaAutorizaciones      := v_lis_detalle;
      pr_insertarBitacora(userInfo.codigoPersona,p_codigoCanal,p_sesion,v_cod_operacion,userInfo.codigoEmpresa, 'est: ' || p_estado || ',canDet:' || v_can_autorizaciones ||
      fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,NULL),BITACORA_SALIDA);
      RETURN v_retorno;

   END;

  PROCEDURE lp_obt_vinculos
  (
     p_tipo IN VARCHAR2, p_dato IN VARCHAR2, p_tipoClave VARCHAR2, p_codpersona IN OUT bw_ope_claves.cod_persona%TYPE, p_codempresa IN OUT bw_ope_claves.cod_persona%TYPE
  ) IS
     v_cod_persona ba_personas.cod_persona%TYPE;

   BEGIN
     IF p_tipo = 'D' THEN

      BEGIN
        SELECT cod_persona
          INTO v_cod_persona
          FROM ba_personas
         WHERE nro_documento = p_dato;
      EXCEPTION
        WHEN no_data_found THEN
              NULL;
      END;

     ELSIF p_tipo = 'C' THEN
      BEGIN
       SELECT COD_PERSONA
        INTO v_cod_persona
        FROM GE_CTA_CLIENTES
       WHERE NRO_CUENTA = p_dato;
      EXCEPTION
         WHEN NO_DATA_FOUND THEN
              NULL;
      END;

     ELSIF p_tipo = 'K' THEN

      v_cod_persona := p_dato;

     ELSIF p_tipo = 'T' THEN
       BEGIN
           SELECT g.cod_persona
        INTO v_cod_persona
        FROM ta_tarjetas t, ge_cta_clientes g
            WHERE t.nro_cuenta = g.nro_cuenta
              AND nro_tarjeta = p_dato;
        EXCEPTION
         WHEN NO_DATA_FOUND THEN
              NULL;
         END;
    END IF;
    BEGIN
    SELECT cod_persona, cod_per_vinculada
      INTO p_codpersona, p_codempresa
      FROM bw_ope_claves
     WHERE cod_persona = v_cod_persona
       AND tip_clave = p_tipoClave;
       EXCEPTION
         WHEN NO_DATA_FOUND THEN
           NULL;
         END;

    END;

   /** Retorna la lista de entes asociados a un codigo de Persona
   * @param p_sesion Codigo de persona
   * @param p_codigoCanal Codigo de canal
   */
   FUNCTION fu_obtenerEnte( p_sesion   IN VARCHAR2,
                            p_codigoCanal IN VARCHAR2,
                            p_tipoentidad IN VARCHAR2) RETURN typ_ente IS

      MSG_ENT_SINDET   CONSTANT VARCHAR2(15) := 'ENT_SIN_DATOS';
      v_can_detalles    NUMBER(3) := 0;
      v_cod_canal       VARCHAR2(3);
      v_sesion          bw_aut_sesiones.cod_sesion%type;
      userInfo          typ_validarSesion;
      v_retorno         typ_ente:= typ_ente;
      v_tip_entidad     ge_entes.tipo%type;

      CURSOR entes IS
        SELECT cod_ente,descripcion,cod_persona,tipo,
               nvl(fug_obt_parentes(cod_ente, 'CTA_DEB_PPROV'),
                   fug_obt_parentes(cod_ente, 'NRO_CTA_DEBITO')) nro_Cuenta
          FROM ge_entes
         WHERE cod_persona = userInfo.codigoEmpresa
         AND tipo = v_tip_entidad
         ORDER BY cod_ente;


    BEGIN
      v_sesion             := depurarAlfanumerico(p_sesion,32);
      v_cod_canal          := depurarAlfanumerico(p_codigoCanal,3);
      v_tip_entidad        := depurarAlfanumerico(p_tipoentidad,2);

      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);

      --valido la sesion del cliente
      userInfo := fu_validarSesion(p_sesion, p_codigoCanal);

      IF userInfo.error = 'S' THEN
         v_retorno.error                := userInfo.error;
         v_retorno.nombreRespuesta      := userInfo.nombreRespuesta;
         v_retorno.descripcionRespuesta := userInfo.descripcionRespuesta;
         RETURN v_retorno;
      END IF;
      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, MSG_ENT_SINDET, ' ',
      fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null),
      BITACORA_ENTRADA);

      v_retorno.listaEnteProveedor := typ_listaEnteProveedor();
      v_retorno.listaEnteSueldo    := typ_listaEnteSueldo();


      FOR en IN entes LOOP
         DECLARE
            v_ente_pr typ_enteProveedor := typ_enteProveedor;
            v_ente_su typ_enteSueldo    := typ_enteSueldo;

          BEGIN
              BEGIN
                pag_cta.pr_obt_cuenta(en.nro_Cuenta);
                IF pag_cta.G_COD_ERROR = 0 THEN
                  v_ente_pr.descripcionCuenta := substr(pag_cta.G_CTAS.DENOMINACION,1,40);
                  v_ente_pr.montoCredito := pag_cta.G_CTAS.SAL_TOTAL;
                 ELSE
                  v_ente_pr.descripcionCuenta:=  substr(pag_cta.G_COD_ERROR || ' - ' || pag_cta.G_MSJ_ERROR,1,40);
                END IF;
              END;


             IF nvl(en.tipo,'X') = 'PR' THEN
                v_can_detalles                 := v_can_detalles + 1;
                v_ente_pr.codigoente           := en.cod_ente;
                v_ente_pr.descripcion          := substr(en.descripcion,1,40);
                v_ente_pr.codigoPersona        := en.cod_persona;
                v_ente_pr.tipo                 := en.tipo;
                v_ente_pr.numeroCuenta         := en.nro_Cuenta;
                v_ente_pr.moneda               := lf_obt_moneda(fug_obt_parentes(en.cod_ente, 'CTA_DEB_PPROV'));
                v_retorno.listaEnteProveedor.extend;
                v_retorno.listaEnteProveedor(v_retorno.listaEnteProveedor.count) := v_ente_pr;
             ELSE
                v_can_detalles                 := v_can_detalles + 1;
                v_ente_su.codigoente           := en.cod_ente;
                v_ente_su.descripcion          := substr(en.descripcion,1,40);
                v_ente_su.codigoPersona        := en.cod_persona;
                v_ente_su.tipo                 := en.tipo;
                v_ente_su.moneda               := lf_obt_moneda(fug_obt_parentes(en.cod_ente, 'NRO_CTA_DEBITO'));
                v_retorno.listaEnteSueldo.extend;
                v_retorno.listaEnteSueldo(v_retorno.listaEnteSueldo.count) := v_ente_su;
             END IF;
          END;
       END LOOP;
       v_retorno.cantidadDetalles := v_can_detalles;

      IF v_can_detalles = 0 THEN
         pr_mensajeUsuario(MSG_ENT_SINDET, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona,v_cod_canal, v_sesion, MSG_ENT_SINDET, ' ', 'ObtenerEnte-' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
         RETURN v_retorno;
      END IF;
      pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
      pr_insertarBitacora(userInfo.codigoPersona, v_cod_canal, v_sesion, MSG_ENT_SINDET, ' ', fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_SALIDA);
      RETURN v_retorno;
    EXCEPTION
      WHEN OTHERS THEN
         pr_mensajeUsuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userInfo.codigoPersona,v_cod_canal, v_sesion, MSG_ENT_SINDET, NULL, 'ObtenerEnte -' || SQLERRM, BITACORA_ERROR);
         RETURN v_retorno;
    END fu_obtenerEnte;
   /**
   * Pago de Servicios
   */
   FUNCTION fu_pagoServicios(--p_sesion      IN VARCHAR2,
                             p_codigoPersona IN VARCHAR2,
                             p_codigoEmpresa IN VARCHAR2,
                             p_codigoCanal IN VARCHAR2,
                             p_modo        IN VARCHAR2,
                             p_cuenta      IN VARCHAR2,
                             p_montoOperacion  IN NUMBER,
                             p_montoComision   IN NUMBER,
                             p_numeroOperacion  IN NUMBER,
                             p_desOperacion IN VARCHAR2,
                             p_parEnviados IN VARCHAR2,
                             p_ideSeguridad IN VARCHAR2,
                             p_claveTransaccional IN VARCHAR2)
                             RETURN typ_pagoServicios IS
     userinfo        typ_validarSesion;
     v_retorno       typ_pagoServicios := typ_pagoServicios;
     v_retError     typ_mensajeRespuesta := typ_mensajeRespuesta;
     v_mensajeCaja   typ_mensajeCaja;
     v_permiso       typ_obtenerPermisos;
     v_resLimite     typ_respuestaLimite;
     v_claveTransaccional bw_ope_claves.clave%TYPE;
     v_sesion        bw_aut_sesiones.cod_sesion%type;
     v_codigocanal   ge_canales.cod_canal%type;
     v_cod_operacion VARCHAR2(3) := '033';
     v_cuenta        VARCHAR2(18);
     v_modo          VARCHAR2(3);
     v_montoOperacion number(18,2) := 0;
     v_montoComision number(18,2) := 0;
     v_saldo          number(18,2) := 0;
     v_cod_tra_padre  number(4) := 485;
     v_cod_mon_debito varchar2(4);
     v_fec_valor      date := pag_cal.fu_obt_fec_actual(9); -- fecha de hoy
     v_hor_actual      varchar2(08) := to_char(SYSDATE, 'HH24:MI:SS'); -- Hora actual
     v_nro_secuencia  number(3) := 0;
     v_horario         varchar2(1) := 'D'; -- Dia normal
     v_es_mov_noc      varchar2(1) := 'N';
     v_es_cta_noc      varchar2(1) := 'N'; -- Graba S/N ctas noctunas
     v_nro_operacion   bw_pag_servicios.nro_transaccion%type;
     v_des_operacion   bw_pag_servicios.des_servicio%type;
     c_cta_deb_invalida     constant varchar2(15) := '222';
     c_mon_diferentes   constant varchar2(15) := '332';
     c_pre_cta_deb_error constant varchar2(15) := '225';
     c_mon_invalido      constant varchar2(15) := '333';
     v_par_enviados      bw_pag_servicios.par_enviados%type;
     v_ide_seguridad     bw_pag_servicios.nro_lote%type;
     v_mon_local        varchar2(5) := pag_gen.fu_obt_mon_local;

     v_est_cta_debito ge_cuentas.estado%type;

     MSG_CTA_NO_CORRESP    CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND'; --Nro. de Cuenta no corresponde al cliente
     MSG_COD_TRA_INVALIDA  CONSTANT VARCHAR2(15) := 'COD_TRA_INVALID';
     MSG_INS_MOV_ER        CONSTANT VARCHAR2(15) := 'INS_MOV_ER';
     MSG_CLA_OPE_INVALIDA CONSTANT VARCHAR2(15)  := 'CLA_OPE_INVALID';
     MOV_DUP_SERVICIO      CONSTANT VARCHAR2(15) := '266';
     SAL_INSUFICIENTE      CONSTANT VARCHAR2(15) := 'COD_SAL_INSUF';
     MSG_COD_CTA_CONJUNTA    CONSTANT VARCHAR2(15) := 'CTA_CONJUNTA';
     MSG_COD_CTA_INVALIDA    CONSTANT VARCHAR2(15) := 'COD_CTA_INVALID';
     v_msj_bitacora  VARCHAR2(200) := substr('modo:'||trim(p_modo)
                            ||', ctaDebito:'||trim(p_cuenta), 1, 200);
     v_fec_actual      DATE := pag_cal.fu_obt_fec_actual(9);
   retError          typ_mensajerespuesta := typ_mensajerespuesta;

   BEGIN
     pre_cam_for_numerico('.,');
     v_tip_mensaje     := '033';
     v_codigocanal     := depurarAlfanumerico(p_codigoCanal,3);
     --v_sesion          := depurarAlfanumerico(p_sesion,32);
     v_sesion    := depurarAlfanumerico('P'||p_codigoPersona||' E:'||p_codigoEmpresa,32);
     v_clavetransaccional := trim(p_claveTransaccional);
     v_modo            := trim(p_modo);
     v_montoOperacion  := nvl(depurarNumerico(p_montoOperacion,18),0);
     v_montoComision   := nvl(depurarNumerico(p_montoComision,18),0);
     v_nro_operacion    := depurarAlfanumerico(p_numeroOperacion,250);
     --v_sesion          := depurarAlfanumerico(p_sesion,32);
     -- Valido la Sesion del Cliente
     userinfo := fu_validarsesion(v_sesion, v_codigoCanal);
     userinfo.error:='N';
     userinfo.codigoCanal:=v_codigocanal;
     userinfo.codigoPersona:=p_codigoPersona;
     userinfo.codigoEmpresa:=p_codigoEmpresa;
     IF userinfo.error = 'S' THEN
        v_retorno.error                := userinfo.error;
        v_retorno.nombrerespuesta      := userinfo.nombreRespuesta;
        v_retorno.descripcionrespuesta := userinfo.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

     -- Verifica si el usuario tiene acceso a la opcion y en que condicion
     v_permiso := lf_obt_permisos(userinfo.codigoPersona,
                    userinfo.codigoPerfil,
                    v_cod_operacion,
                    userinfo.codigoCanal);

     IF (v_permiso.error = 'S') THEN
        v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
        v_retorno.error                := v_permiso.error;
        RETURN v_retorno;
     END IF;

     -- Verifica el canal de origen
     v_mensajeCaja := lf_val_caja(userinfo);
     IF v_mensajeCaja.error = 'S' THEN
        v_retorno.error                := v_mensajeCaja.error;
        v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
        RETURN v_retorno;
     END IF;

      --controla horario cierre
      if nvl(fug_obt_pardinamico('BWE_BLO_HOR_CIERRE'),'N') = 'S' then
          reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                      v_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                      -- IN
                                      v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                      -- IN
                                      v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

           IF reterror.error = 'S' THEN
              v_retorno.error                := reterror.error;
              v_retorno.nombreRespuesta      := reterror.nombreRespuesta;
              v_retorno.descripcionRespuesta := reterror.descripcionRespuesta;
              RETURN v_retorno;
           END IF;
      end if;

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userinfo.codigoPersona, userinfo.codigoCanal, v_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora ||' '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null ), BITACORA_ENTRADA);

     IF v_ind_cta_encriptada = 'S' THEN
        v_cuenta := fu_desencriptacionCuentas(p_cuenta);
     ELSE
        v_cuenta := depurarAlfanumerico(p_cuenta, CUENTA_TAMANO);
     END IF;

     IF v_modo = 'V' THEN
        v_montoOperacion  := depurarNumerico(nvl(p_montoOperacion,0),18);
        if v_montoOperacion <= 0 then
           pr_mensajeUsuario(c_mon_invalido, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona, v_codigocanal, v_sesion, v_tip_mensaje, userinfo.codigoEmpresa, 'Nro. cuenta:'||v_cuenta||' modo:'||v_modo||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
           return v_retorno;
        end if;

        --Valida que la cuenta corresponda al cliente
        IF lf_val_cta_origen(v_cuenta, userinfo.codigoPersona) = 'N' THEN
           pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona,
               userinfo.codigoCanal,
               v_sesion,
               v_cod_operacion,
               userinfo.codigoEmpresa,
               v_msj_bitacora || ' '||'FU_PAGO-SERVICIOS '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
               BITACORA_ERROR);
           RETURN v_retorno;
        END IF;
        --Valida que la cuenta no sea conjunta
        IF fu_es_conjunta(v_cuenta,userinfo.codigoPersona,userinfo.codigoEmpresa) = 'S' THEN
           pr_mensajeUsuario(MSG_COD_CTA_CONJUNTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
           pr_insertarBitacora(userinfo.codigoPersona,
               userinfo.codigoCanal,
               v_sesion,
               v_cod_operacion,
               userinfo.codigoEmpresa,
               v_msj_bitacora || ' ' ||'FU_PAGO_SERVICIOS '|| fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
               BITACORA_ERROR);
           RETURN v_retorno;
        END IF;

        --valida la cuenta
       SELECT a.estado
        INTO v_est_cta_debito
        FROM ge_cuentas a
       WHERE a.nro_cuenta = v_cuenta;

       IF v_est_cta_debito IN ('B', 'D', 'S', 'T') THEN
          pr_mensajeUsuario(113, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       ELSIF v_est_cta_debito NOT IN ('P', 'I', 'N', 'S') THEN
          pr_mensajeUsuario(MSG_COD_CTA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
       END IF;

       IF v_retError.error = 'S' THEN
          pr_insertarBitacora(userinfo.codigoPersona, v_codigocanal, v_sesion, v_tip_mensaje, userinfo.codigoEmpresa, 'fu_ver_transaccion - cuenta Debito:'||v_cuenta||' modo:'||v_modo||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);

          paw_log.g_typ_pagoServicios := v_retorno;
          paw_log.pr_logValoresTypes('typ_pagoServicios',
          'PagoServicios Operacion'||' '||v_sesion||', '|| p_codigoCanal||', '||  v_cuenta||', '||
          p_montoOperacion||', '||p_modo );
          return v_retorno;
       END IF;

        begin
          select sal_total - sal_retenido - sal_bloqueado
            into v_saldo
            from ah_cta_vistas
           where nro_cuenta = v_cuenta;

           if nvl(v_saldo,0) < v_montoOperacion then
               pr_mensajeUsuario(SAL_INSUFICIENTE, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
               pr_insertarBitacora(userinfo.codigoPersona,
                     userinfo.codigoCanal,
                     v_sesion,
                     v_cod_operacion,
                     userinfo.codigoEmpresa,
                     v_msj_bitacora || ' '||'FU_PAGOSERVICIOS '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                     BITACORA_ERROR);
           end if;

        exception
          when others then
            pr_mensajeUsuario(c_cta_deb_invalida,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
            pr_insertarBitacora(userinfo.codigoPersona,v_codigocanal,v_sesion,v_tip_mensaje,userinfo.codigoEmpresa,'Nro. cuenta:' || v_cuenta || ' modo:' ||v_modo || ' ' ||
                                fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,null),
                                BITACORA_ERROR);
        end;

       -- valido la duplicacion de pago de servicios
       v_retError := fu_ver_transaccion(503
                                     ,v_cod_tra_padre
                                     ,v_cuenta
                                     ,v_montoOperacion
                                     ,v_mensajeCaja);

       if v_retError.error = 'S' then
          v_retorno.error := v_retError.error;
          v_retorno.nombreRespuesta := v_retError.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_retError.descripcionRespuesta;
          pr_insertarBitacora(userinfo.codigoPersona, v_codigocanal, v_sesion, v_tip_mensaje, userinfo.codigoEmpresa, 'fu_ver_transaccion - cuenta Debito:'||v_cuenta||' modo:'||v_modo||' '||fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);

          paw_log.g_typ_pagoServicios := v_retorno;
          paw_log.pr_logValoresTypes('typ_pagoServicios',
          'PagoServicios Operacion'||' '||v_sesion||', '|| p_codigoCanal||', '||  v_cuenta||', '||
          p_montoOperacion||', '||p_modo );
         return v_retorno;
       end if;

     ELSIF v_modo = 'T' THEN
        /*If v_claveTransaccional is null then
             pr_mensajeUsuario(MSG_CLA_OPE_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             RETURN v_retorno;
        end if;
        v_retError := lf_obt_cla_validar(v_claveTransaccional, userinfo.codigoPersona,
                           userinfo.codigoEmpresa, 'T');*/

        IF v_retError.error = 'S' THEN
           v_retorno.error                := v_retError.error;
           v_retorno.nombreRespuesta      := v_retError.nombreRespuesta;
           v_retorno.descripcionRespuesta := v_retError.descripcionRespuesta;
           pr_insertarBitacora(userinfo.codigoPersona,
                     p_codigoCanal,
                     v_sesion,
                     v_cod_operacion,
                     userinfo.codigoEmpresa,
                     v_msj_bitacora || ' ' ||'FU_PAGO-SERVICIOS '||
                     fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                     BITACORA_ERROR);
           RETURN v_retorno;
      END IF;

     ELSIF v_modo = 'C' THEN
        v_des_operacion:= p_desOperacion;
        v_ide_seguridad:= depurarAlfanumerico(p_ideSeguridad,250);
        v_par_enviados:= p_parEnviados;

        -- esta la cuenta en condiciones, verifico el horario
        v_reterror := lp_ver_horario(v_horario, v_es_mov_noc, v_es_cta_noc,
                                    v_mensajeCaja.fechaUltimoCierre /* v_ult_cierre */,
                                    -- IN
                                    v_mensajeCaja.codigoOficinaOrigen /* v_cod_ofi_origen */,
                                    -- IN
                                    v_fec_actual, v_mensajeCaja.fechacierre, v_fec_valor);

        IF v_reterror.error = 'S' THEN
            v_retorno.error                := v_reterror.error;
            v_retorno.nombreRespuesta      := v_reterror.nombreRespuesta;
            v_retorno.descripcionRespuesta := v_reterror.descripcionRespuesta;
            pr_insertarBitacora(userinfo.codigoPersona, v_codigocanal, v_sesion,
                                v_tip_mensaje, userinfo.codigoEmpresa,
                                'fu_pagoServicios ' || 'lp_ver_horario - Cta deb:' ||
                                 v_cuenta || ' mto:' || v_montoOperacion || ' modo:' || p_modo || ' ' ||
                                 fu_generarBitacora(v_retorno.error,
                                                    v_retorno.nombreRespuesta,
                                                    v_retorno.descripcionRespuesta, NULL),
                                bitacora_error);

             /*Obtiene la informacion de parametros recibos y el return del type*/
             paw_log.g_typ_pagoServicios := v_retorno;
             paw_log.pr_logValoresTypes('typ_pagoservicio',
             'fu_pagoservicios Modo C'||' '||v_sesion||', '|| p_codigocanal||', '||  v_cuenta||', '||
             v_montoOperacion||', '|| v_montoComision||', '|| p_modo);

            RETURN v_retorno;
        END IF;

        INSERT INTO bw_pag_servicios
           (nro_cuenta, cod_servicio, fecha, hora, nro_transaccion, nro_lote, ip_usuario,
            terminal, cod_moneda, mto_transaccion, mto_comision, mto_mora, mto_interes,
            reversado, mto_debito, cod_mon_servicio, red_pago, des_servicio, par_enviados)
        VALUES
           (v_cuenta, 0, v_fec_actual, v_hor_actual, v_nro_operacion, v_ide_seguridad,
            null, null, v_mon_local, v_montoOperacion, v_montoComision,
            null, null, 'N', v_montoOperacion+v_montoComision, 1, 0, v_des_operacion, v_par_enviados);
     END IF;
     RETURN v_retorno;
   END;

   FUNCTION fu_pagoServiciosEmp (p_sesion      IN VARCHAR2,
                                 p_codigoCanal IN VARCHAR2,
                                 p_modo        IN VARCHAR2,
                                 p_cuenta      IN VARCHAR2,
                                 p_moneda      IN NUMBER,
                                 p_monto       IN NUMBER,
                                 p_proveedor   IN NUMBER,
                                 p_numeroIp    IN VARCHAR2,
                                 p_claveTransaccional IN VARCHAR2,
                                 p_claveToken  IN VARCHAR2,
                                 p_identificador IN VARCHAR2 DEFAULT 'N')
                                 RETURN typ_pagoServicios IS

     userinfo              typ_validarSesion;
     v_retorno             typ_pagoServicios := typ_pagoServicios;
     v_mensajeCaja         typ_mensajeCaja;
     v_permiso             typ_obtenerPermisos;
     v_resLimite           typ_respuestaLimite;
     v_retError            typ_mensajeRespuesta := typ_mensajeRespuesta;
     v_claveSesion         VARCHAR(32);
     v_cod_operacion       VARCHAR2(3) := '089';
     v_cuenta              VARCHAR2(18);
     v_cod_mon_debito      ba_monedas.cod_moneda%TYPE := NULL;
     v_cod_mon_servicio    ba_monedas.cod_moneda%TYPE := NULL;
     v_mto_equ_local       ge_movimientos.mto_equ_local%TYPE;
     v_mto_credito         ge_movimientos.monto%TYPE  := p_monto;
     v_mto_debito          ge_movimientos.monto%TYPE := NULL;
     v_cot_credito         ge_movimientos.cotizacion%TYPE := NULL;
     v_cot_debito          ge_movimientos.cotizacion%TYPE := NULL;
     v_nro_documento       NUMBER(15);
     v_cuentaAux           VARCHAR2(18);
     v_nro_movimiento      bw_movimientos.nro_movimiento%type; /*BWP-37-glopez*/
     v_nro_operacion       bw_movimientos.nro_documento%type;  /*BWP-37-glopez*/
     MSG_CTA_NO_CORRESP    CONSTANT VARCHAR2(15) := 'CTANOCORRESPOND'; --Nro. de Cuenta no corresponde al cliente
     MSG_CTA_CONJUNTA      CONSTANT VARCHAR2(15) := 'CTA_CONJUNTA';
     MSG_INS_MOV_ER        CONSTANT VARCHAR2(15) := 'INS_MOV_ER';
     MOV_DUP_SERVICIO      CONSTANT VARCHAR2(15) := 'MOV_DUP_SERV';
     SER_PER_SIN_AUT       CONSTANT VARCHAR2(15) := 'SER_PER_SIN_AUT';
     MSG_COD_TRA_INVALIDA  CONSTANT VARCHAR2(15) := 'COD_TRA_INVALID';
     v_mad_aho             ge_par_dinamicos.val_parametro%type :=fug_obt_pardinamico('MAD_AHO_BAN_WEB');
     v_msj_bitacora        VARCHAR2(200) := substr('modo:'||trim(p_modo)
                                                    ||', ctaDebito:'||trim(p_cuenta)
                                                    ||', nroIp:'||trim(p_numeroIp), 1, 200);
   BEGIN
     -- Valido la Sesión del Cliente
     userinfo := fu_validarsesion(p_sesion, p_codigoCanal);
     IF userinfo.error = 'S' THEN
          v_retorno.error                := userinfo.error;
          v_retorno.nombrerespuesta      := userinfo.nombreRespuesta;
          v_retorno.descripcionrespuesta := userinfo.descripcionRespuesta;
          RETURN v_retorno;
     END IF;
     -- Verifica el canal de origen
     v_mensajeCaja := lf_val_caja(userinfo);
     IF v_mensajeCaja.error = 'S' THEN
          v_retorno.error                := v_mensajeCaja.error;
          v_retorno.nombreRespuesta      := v_mensajeCaja.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_mensajeCaja.descripcionRespuesta;
          RETURN v_retorno;
     END IF;
     /*
       Seteamos el valor del campo codigoUsuario ya que es el cual utiliza para guardar los movimientos.
       glopez - BWP-18
     */
       v_mensajeCaja.codigoUsuario  := fug_obt_user_sesion(p_sesion);
     -- Verifica si el usuario tiene acceso a la opcion y en que condicion
     v_permiso := lf_obt_permisos(userinfo, v_cod_operacion);
     v_can_aut_requeridas := v_permiso.canAutRequeridas;

     IF (v_permiso.error = 'S') THEN
          v_retorno.nombreRespuesta      := v_permiso.nombreRespuesta;
          v_retorno.descripcionRespuesta := v_permiso.descripcionRespuesta;
          v_retorno.error                := v_permiso.error;
          pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
          RETURN v_retorno;
     END IF;
     -- se verifica que tiene permiso para registrar
     IF v_permiso.registra = FALSE AND instr(v_tip_mensaje, 'I') > 0 THEN
        pr_mensajeUsuario(SER_PER_SIN_AUT, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona, p_codigoCanal, p_sesion, v_cod_operacion, NULL, v_msj_bitacora||' '||fu_generarbitacora(v_retorno.error,v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta,null), BITACORA_ERROR);
        RETURN v_retorno;
     END IF;

     pr_mensajeUsuario(MSG_OK, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
     pr_insertarBitacora(userinfo.codigoPersona, userinfo.codigoCanal, p_sesion, v_cod_operacion, userinfo.codigoEmpresa, v_msj_bitacora ||' '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, null ), BITACORA_ENTRADA);

     -- validamos que se pueda insertar una sesion
     IF pag_ser.fu_val_ins_sesion(userinfo.codigoPersona, userinfo.codigoEmpresa) = 'N' THEN
        pr_mensajeUsuario(MOV_DUP_SERVICIO, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
        pr_insertarBitacora(userinfo.codigoPersona,
                   userinfo.codigoCanal,
                   p_sesion,
                   v_cod_operacion,
                   userinfo.codigoEmpresa,
                   v_msj_bitacora || ' '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                   BITACORA_ERROR);
        RETURN v_retorno;
     END IF;

     --Solo verifica hasta clave Transaccional en p_modo = T
     v_cuenta := depurarAlfanumerico(p_cuenta, CUENTA_TAMANO);
     
      --Verifica que se pueda debitar de la cuenta
    SELECT a.nro_cuenta, a.cod_moneda
      into v_cuentaAux, v_cod_mon_debito
      FROM ge_est_cuentas c, ge_cuentas a, ge_cta_clientes b
     WHERE a.nro_cuenta = b.nro_cuenta
       AND b.relacion IN ('O', 'P')
       AND b.cod_persona = nvl(userinfo.codigoEmpresa, userinfo.codigoPersona)
       and a.nro_cuenta = v_cuenta
       AND a.cod_modulo = c.cod_modulo
       AND a.cod_modalidad = c.cod_modalidad
       AND b.cod_modulo != 7
       AND (instr(v_mad_aho, '#'||b.cod_modalidad||'#' ) > 0  or
            b.cod_modalidad = '41' ) -- NVB-3705
       --and b.cod_modalidad IN (31, 41)
       AND c.activo = 'S' -- solo cuentas activas
       AND a.estado not in ('X', 'A', 'T', 'D', 'C', 'V', 'P', 'B')
       AND a.estado = c.estado;
    
      --Valida que la cuenta corresponda al cliente
      IF lf_val_cta_origen(v_cuenta, nvl(userinfo.codigoEmpresa, userinfo.codigoPersona)) = 'N' THEN
         pr_mensajeUsuario(MSG_CTA_NO_CORRESP, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona,
                   userinfo.codigoCanal,
                   p_sesion,
                   v_cod_operacion,
                   userinfo.codigoEmpresa,
                   v_msj_bitacora || ' '||fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                   BITACORA_ERROR);
         RETURN v_retorno;
      END IF;
      --Valida que la cuenta no sea conjunta
      /*IF PAW_BAS.fu_es_conjunta(v_cuenta, v_can_aut_requeridas) = 'S' THEN
         pr_mensajeUsuario(MSG_CTA_CONJUNTA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarBitacora(userinfo.codigoPersona,
                   userinfo.codigoCanal,
                   p_sesion,
                   v_cod_operacion,
                   userinfo.codigoEmpresa,
                   v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                   BITACORA_ERROR);
         RETURN v_retorno;
      END IF;*/

      -- obtenemos la moneda del servicio a pagar
      /*IF pag_ser.fu_obt_cta_credito(p_proveedor, p_moneda, v_cuenta, v_cod_mon_servicio) <> 0 THEN
         pr_mensajeusuario(MSG_COD_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
         pr_insertarbitacora(userinfo.codigoPersona,
                             userinfo.codigoCanal,
                             p_sesion,
                             v_cod_operacion,
                             userinfo.codigoEmpresa,
                             'Moneda inv - ' || v_msj_bitacora || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                             BITACORA_ERROR);

          RETURN v_retorno;
      END IF;
      -- moneda diferentes
      IF v_cod_mon_servicio <> v_cod_mon_debito THEN
         -- Verifica que no pueda realizar cambio de monedas en fecha distinta a la fecha actual
         BEGIN
            pr_con_mon_a_moneda(v_cod_mon_servicio,
                                v_cod_mon_debito,
                                v_mto_credito,
                                v_mto_debito,
                                v_cot_credito,
                                v_cot_debito,
                                'S'); -- VENTA
          EXCEPTION
             WHEN OTHERS THEN
                pr_mensajeusuario(MSG_ERROR, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
                pr_insertarbitacora(userinfo.codigoPersona,
                             userinfo.codigoCanal,
                             p_sesion,
                             v_cod_operacion,
                             userinfo.codigoEmpresa,
                             v_msj_bitacora || ', ORA-ERR: [' || SUBSTR(SQLERRM, 1, 200) || '] ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                             BITACORA_ERROR);

                RETURN v_retorno;
          END;

          IF v_mto_credito <= 0 OR v_mto_debito <= 0 THEN
             pr_mensajeusuario(MSG_COD_TRA_INVALIDA, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarbitacora(userinfo.codigoPersona,
                             p_codigoCanal,
                             p_sesion,
                             v_cod_operacion,
                             userinfo.codigoEmpresa,
                             v_msj_bitacora || ', mtoDebInvalido: ' || v_mto_debito || ' ' || fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                             BITACORA_ERROR);
             RETURN v_retorno;
          END IF;
       ELSE*/
          -- Se iguala el monto por que la Moneda Credito y Debito es igual
          --Por el momento solo en GS
          v_mto_debito := v_mto_credito;
       --END IF;

      --Verifica Limite de operaciones (cantidad y monto)
        v_resLimite := fu_obtenerLimite (userinfo,
                                         '089',
                                         nvl(userinfo.codigoEmpresa, userinfo.codigoPersona),
                                         v_cuenta,
                                         pag_gen.FU_OBT_MON_LOCAL,
                                         8527, --503,
                                         8526, --485,
                                         p_monto,
                                         'C');
        v_retorno.error                := v_resLimite.error;
        v_retorno.nombreRespuesta      := v_resLimite.nombreRespuesta;
        v_retorno.descripcionRespuesta := v_resLimite.descripcionRespuesta;

        IF v_retorno.error = 'S' THEN
          pr_insertarBitacora(userinfo.codigoPersona,
                              userinfo.codigoCanal,
                              p_sesion,
                              v_cod_operacion,
                              userinfo.codigoEmpresa,
                              v_msj_bitacora || ' ' ||
                              fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                              BITACORA_ERROR);
           RETURN v_retorno;
        END IF;

        -- clave transaccional requerida
        IF v_resLimite.codRespuesta IN ('10', '11') THEN
            v_retError := lf_obt_cla_validar(p_claveTransaccional, userinfo.codigoPersona, userinfo.codigoEmpresa, 'T');
        END IF;

        /*IF nvl(v_retError.error, 'N') = 'N' THEN
           IF v_resLimite.codRespuesta IN ('01', '11') THEN
              -- token requerido
              v_retError := paw_seg.fu_obt_tok_validar(p_claveToken, userinfo.codigoPersona, userinfo.codigoEmpresa, 'C');
           END IF;
        END IF;*/

        IF v_retError.error = 'S' THEN
           v_retorno.error                := v_retError.error;
           v_retorno.nombreRespuesta      := v_retError.nombreRespuesta;
           v_retorno.descripcionRespuesta := v_retError.descripcionRespuesta;
           pr_insertarBitacora(userinfo.codigoPersona,
                               p_codigoCanal,
                               p_sesion,
                               v_cod_operacion,
                               userinfo.codigoEmpresa,
                               v_msj_bitacora || ' ' ||
                               fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                               BITACORA_ERROR);
           RETURN v_retorno;
        END IF;

        --Solo insertar en modo V
        IF p_modo <> 'T' THEN
          BEGIN
            IF v_cod_mon_debito <> v_cod_mon_local AND
               v_cod_mon_debito <> v_cod_mon_servicio AND
               v_cod_mon_servicio = v_cod_mon_local THEN
               v_mto_equ_local := v_mto_credito;
            ELSE
               v_mto_equ_local  := null;
            END IF;

             SELECT s_nro_documento.NEXTVAL
               INTO v_nro_documento
               FROM dual;

            INSERT INTO bw_mov_pendientes
               (nro_documento, cod_per_principal, fec_hora, cod_tip_mensaje,
                nro_cuenta, cod_moneda, descripcion, monto, cotizacion, mto_equ_local,
                nro_cta_contra, estado, can_aut_requeridas, can_aut_faltantes, cod_per_ingreso,
                mto_contra, cot_contra, etiqueta, /*dato,*/ referencia, etiqueta2, dato2, etiqueta7, dato7)
            VALUES
               (v_nro_documento, nvl(userinfo.codigoEmpresa, userinfo.codigoPersona), SYSDATE, v_cod_operacion,
                v_cuenta, v_cod_mon_debito, 'Pago Servicio', v_mto_debito, v_cot_debito, v_mto_equ_local,
                '', 'P', v_can_aut_requeridas, v_can_aut_requeridas, userinfo.codigoPersona /* v_cod_persona */,
                v_mto_credito, v_cot_credito, 'Token', /*p_tokenServicios,*/ p_proveedor, 'Concepto: Pago Servicio','Pago Servicio', 'Indicador BFF', p_identificador);

            v_retorno.numeroDocumento := v_nro_documento;

            pr_mensajeusuario(MSG_OK,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);

            pr_insertarbitacora(userinfo.codigoPersona,
                                userinfo.codigoCanal,
                                p_sesion,
                                v_cod_operacion,
                                userinfo.codigoEmpresa,
                                v_msj_bitacora || ', nro_doc: ' ||v_retorno.numeroDocumento || ', firReq: ' || v_can_aut_requeridas ||
                                    fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                BITACORA_SALIDA);
          EXCEPTION
            WHEN OTHERS THEN
             --MSG_INS_MOV_ER
             pr_mensajeUsuario(MSG_INS_MOV_ER, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, v_retorno.error);
             pr_insertarBitacora(userinfo.codigoPersona,
                                 userinfo.codigoCanal,
                                 p_sesion,
                                 v_cod_operacion,
                                 userinfo.codigoEmpresa,
                                 v_msj_bitacora || ', ORA-ERR: [' || substr(SQLERRM, 1, 200) || '] ' ||
                                 fu_generarBitacora(v_retorno.error, v_retorno.nombreRespuesta, v_retorno.descripcionRespuesta, NULL),
                                 BITACORA_ERROR);
             RETURN v_retorno;
          END;
        END IF;
       
       /*
          BWP-37-glopez
          Insertamos en la teabla be_movimientos
          Solo le envia modo V una ves cuando es banca empresa
          Solo envia modo T una ves cuando es banca fisica
        */
        if nvl(p_identificador, 'N') = 'N' then
        if p_modo = 'V' or --Este es para el caso de banca empresa
           (p_modo = 'T' and v_can_aut_requeridas = 0) then --Este es para el caso de banca fisica
         -- genero el numero de operacion
         SELECT s_nro_ope_homebanking.NEXTVAL
           INTO v_nro_operacion
           FROM dual;
          /*BWP-37-glopez*/
         select s_nro_bw_movimiento.nextval
         into v_nro_movimiento
         from dual;
         -- registro del movimiento
           lp_reg_operacion(v_cuenta /*p_nro_cuenta*/,
              v_cod_mon_debito /*p_cod_moneda */,
              v_mto_debito          /*p_monto*/,
              null /*p_nro_cta_contra*/,
              NULL              /*p_cantidad*/,
              NULL /*p_etiqueta*/,
              p_proveedor   /*p_dato*/,
             'Cotizacion'      /*p_etiqueta2*/,
             v_cot_debito      /*p_dato2*/,
             'Pago de servicios'||v_cot_credito /*observacion*/,
             NULL          /*direccion IP*/,
             '000',
             userinfo.codigopersona,
             v_cod_operacion,
             v_nro_operacion,
             p_codigoCanal,
             p_sesion,
             userinfo.codigoempresa,
             null,
             null,
             null,
             v_nro_documento, --BWP-37
             v_nro_movimiento);--BWP-37

             --Solo cuando es fisica. Devuelvo
             --Cuando es empresa se debe de consultar mediante una funcion que le va a devolver.
            if (p_modo = 'T' and v_can_aut_requeridas = 0) then
              v_retorno.numeroDocumento := to_number(v_nro_movimiento || v_cod_operacion);
            end if;
        end if;
        end if;
     RETURN v_retorno;

  END fu_pagoServiciosEmp;

   /*FUNCTION fu_obtenerOpcionesMenu( p_sesion   IN VARCHAR2,
                                    p_codigoCanal IN VARCHAR2) RETURN typ_menu  IS

      MSG_SIN_DETALLE   CONSTANT VARCHAR2(15) := '269';
