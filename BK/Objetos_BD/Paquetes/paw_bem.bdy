        v_can_barrios NUMBER(9) := 0;
        v_cod_pais    NUMBER(3) := 0;

        -- Barrios
        CURSOR c_barrios is
          SELECT j.cod_barrio, j.descripcion
            FROM ba_barrios j
           WHERE j.cod_pais = v_cod_pais
             AND j.cod_ciudad = v_cod_ciudad
           ORDER BY j.descripcion;

      BEGIN
        v_cod_canal  := depurarAlfanumerico(p_codigoCanal, 3);
        v_sesion     := depurarAlfanumerico(p_sesion, 32);
        v_cod_ciudad := depurarAlfanumerico(p_codigoCiudad, 3);
        v_cod_pais   := depurarAlfanumerico(p_codigoPais, 3);

        pr_mensajeUsuario(MSG_OK,v_retorno.nombreRespuesta,v_retorno.descripcionRespuesta,v_retorno.error);
        retValidarSesion := fu_validarSesion(v_sesion, v_cod_canal);

        v_bitacora := ' fu_obtenerBarrios(' || v_sesion || ', ' ||v_cod_canal || ', ' || v_cod_ciudad || ')';
        pr_insertarBitacora(retValidarSesion.codigoPersona,v_cod_canal,v_sesion,c_cod_operacion,NULL, v_bitacora,bitacora_entrada);

        IF retValidarSesion.error = 'S' THEN
          v_retorno.error                := retValidarSesion.error;
          v_retorno.nombreRespuesta      := retValidarSesion.nombreRespuesta;
          v_retorno.descripcionRespuesta := retValidarSesion.descripcionRespuesta;
          RETURN v_retorno;
        END IF;

        FOR c in c_barrios LOOP
          DECLARE
