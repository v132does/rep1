CREATE OR REPLACE PACKAGE IT.PAP_MES IS

V_DOCU VARCHAR2(1);
V_CONCEPTO GE_MOVIMIENTOS.CONCEPTO%TYPE;
V_ESTADO_CTA PR_CTA_PRESTAMOS.ESTADO%TYPE;
V_COTIZACION GE_COTIZACIONES.VAL_COMPRA%TYPE;
V_COD_MODULO BA_MODULOS.COD_MODULO%TYPE;
V_COD_MODALIDAD GE_MODALIDADES.COD_MODALIDAD%TYPE;
V_COD_OFICINA BA_OFICINAS.COD_OFICINA%TYPE;
V_DIAS NUMBER;
V_TRANS NUMBER(3);
V_SAL_CAP PR_CUOTAS.SAL_CAPITAL%TYPE;
V_SAL_INTAUTOR PR_CUOTAS.SAL_CAPITAL%TYPE;
V_SECUENCIA GE_MOVIMIENTOS.NRO_SECUENCIA%TYPE;
V_COD_TRA_PAD GE_MOVIMIENTOS.COD_TRA_PADRE%TYPE;
V_COD_TRA_HIJ GE_MOVIMIENTOS.COD_TRA_PADRE%TYPE;
V_MTO_TRANS GE_MOVIMIENTOS.MONTO%TYPE;
V_FCDEHOY DATE;
V_FCVENCI DATE;
RV_PRES PR_CTA_PRESTAMOS%ROWTYPE;
V_DEV_NOCOB PR_CTA_PRESTAMOS.DEV_NO_COBRADO%TYPE;
WLUGAR VARCHAR2(100);
V_SAL_INT PR_CUOTAS.SAL_INTERES%TYPE;
V_IMPORTE PR_CUOTAS.SAL_CAPITAL%TYPE;
V_ADEVENGAR PR_CUOTAS.SAL_CAPITAL%TYPE;
V_MONE_LOCAL BA_MONEDAS.COD_MONEDA%TYPE;
V_HORAMOVIM GE_MOVIMIENTOS.HORA%TYPE;
V_NRO_CUENTA PR_CTA_PRESTAMOS.NRO_CUENTA%TYPE;
V_CATEGORIA  GE_CLIENTES.CAT_AUTOMATICA%TYPE;

/* Actualizar el estado de un préstamo. */
PROCEDURE PR_ACT_EST_PRESTAMO
 (P_NRO_CUENTA IN PR_CTA_PRESTAMOS.NRO_CUENTA%TYPE
 ,P_ESTADO IN PR_CTA_PRESTAMOS.ESTADO%TYPE
 );
/* Obtener saldos capital e interés de un préstamo. */
PROCEDURE PR_OBT_CAP_INT_PRES
 (P_NRO_CUENTA IN PR_CTA_PRESTAMOS.NRO_CUENTA%TYPE
 ,P_SAL_CAPITAL IN OUT PR_CUOTAS.SAL_CAPITAL%TYPE
 ,P_SAL_INTERES IN OUT PR_CUOTAS.SAL_INTERES%TYPE
 ,P_SAL_X IN OUT PR_CUOTAS.SAL_CAPITAL%TYPE
 );
/* Cambio de Situación */
PROCEDURE PR_CAM_SITUACION
 (P_COD_MODULO IN PR_CTA_PRESTAMOS.COD_MODULO%TYPE
 ,P_COD_MODALIDAD IN PR_CTA_PRESTAMOS.COD_MODALIDAD%TYPE
 ,P_COD_OFICINA IN PR_CTA_PRESTAMOS.COD_OFICINA%TYPE
 ,P_NRO_CUENTA IN PR_CTA_PRESTAMOS.NRO_CUENTA%TYPE
 ,P_CATEGORIA  IN GE_CLIENTES.CAT_AUTOMATICA%TYPE
 ,P_FECHA IN GE_MOVIMIENTOS.FECHA%TYPE
 ,P_HORA IN OUT GE_MOVIMIENTOS.HORA%TYPE
 ,P_NRO_SECUENCIA IN OUT GE_MOVIMIENTOS.NRO_SECUENCIA%TYPE
 );
/* Realizar asientos contables por el cambio de estado del préstamo. */
PROCEDURE PR_INS_ASIE_CAMES
 (P_COD_TRA_PADRE IN GE_MOVIMIENTOS.COD_TRA_PADRE%TYPE
 ,P_COD_TRANSACCION IN GE_MOVIMIENTOS.COD_TRANSACCION%TYPE
 ,P_MONTO IN GE_MOVIMIENTOS.MONTO%TYPE
 ,P_CONCEPTO IN GE_MOVIMIENTOS.CONCEPTO%TYPE
 ,P_ESTADO IN GE_MOVIMIENTOS.EST_CUENTA%TYPE
 );
/* Permite obtener los datos de la cuenta de préstamos no cancelada. */
PROCEDURE PR_OBT_DAT_PRE_NOCAN
 (P_NRO_CUENTA IN PR_CTA_PRESTAMOS.NRO_CUENTA%TYPE
 ,RP_PCPRE IN OUT PR_CTA_PRESTAMOS%ROWTYPE
 );
/* Proceso de cambio de estado de préstamos. */
PROCEDURE PR_PRO_CAM_EST_PREST;
/* Actualizar el estado de las cuotas del préstamo. */
PROCEDURE PR_ACT_EST_CUOTAS
 (P_NRO_CUENTA IN PR_CTA_PRESTAMOS.NRO_CUENTA%TYPE
 ,P_ESTADO IN PR_CTA_PRESTAMOS.ESTADO%TYPE
 );
/* Recupera monto previsión de ge_cla_operaciones. */
FUNCTION FU_OBT_PREVISION
 (P_NRO_CUENTA IN PR_CTA_PRESTAMOS.NRO_CUENTA%TYPE
 )
 RETURN NUMBER;
/* Recupera monto valuación de pr_valuaciones. */
FUNCTION FU_OBT_VALUACION
 (P_NRO_CUENTA IN PR_CTA_PRESTAMOS.NRO_CUENTA%TYPE
 )
 RETURN NUMBER;
END PAP_MES;
/

