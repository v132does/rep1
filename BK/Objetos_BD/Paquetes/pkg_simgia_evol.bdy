CREATE OR REPLACE PACKAGE BODY IT.PKG_SIMGIA_EVOL IS

  PROCEDURE PRC_LIMPIAR IS
  BEGIN
    	--execute immediate 'truncate table it.simgia_tmp_cr';
		  --execute immediate 'truncate table it.simgia_tmp_cp';
		  execute immediate 'truncate table it.simgia_crcp';
			IF VERIFICAR_TABLAS('IT', 'simgia_ranking_actual_cp', NULL) = 1 THEN
			    execute immediate 'truncate table it.simgia_ranking_actual_cp';
			END IF;
			IF VERIFICAR_TABLAS('IT', 'simgia_ranking_actual_cr', NULL) = 1 THEN
			   execute immediate 'truncate table it.simgia_ranking_actual_cr';
			END IF;
  END PRC_LIMPIAR;


  PROCEDURE PRC_PRINCIPAL(FECHA IN VARCHAR2) IS
  BEGIN
    CARGAR_SIMGIA_CRCP(FECHA);
    ACTUALIZAR_OBJETIVO_AGENTES;
    PRC_CALCULAR_RANKING(FECHA);
    PRC_ACTUALIZAR_RANKING_CRCP(FECHA);
  END PRC_PRINCIPAL;

  FUNCTION VERIFICAR_TABLAS(OWNER  IN VARCHAR2,
                            TABLA  IN VARCHAR2,
                            DBLINK IN VARCHAR2) RETURN INTEGER IS

    RESULT          INTEGER;
    S_SQL_VERIFICAR VARCHAR2(15000);
    VALOR_VERIFICAR INTEGER;
  BEGIN

    VALOR_VERIFICAR := 0;
    S_SQL_VERIFICAR := 'SELECT 1 FROM SYS.ALL_TABLES' || DBLINK || ' A ' ||
                       'WHERE A.OWNER = ''' || Upper(OWNER) ||
                       ''' AND A.TABLE_NAME = ''' || Upper(TABLA) || '''';

    BEGIN
      EXECUTE IMMEDIATE S_SQL_VERIFICAR
        INTO VALOR_VERIFICAR;
    EXCEPTION
      WHEN OTHERS THEN
        NULL;
    END;

    IF VALOR_VERIFICAR = 0 THEN
      RESULT := 0;
    ELSE
      RESULT := 1;
    END IF;

    RETURN(RESULT);
  END VERIFICAR_TABLAS;

  PROCEDURE CARGAR_SIMGIA_CRCP(FECHA IN VARCHAR2) IS
    SQL_INSERT_CP VARCHAR2(6000);
    SQL_INSERT_CR VARCHAR2(6000);
		SQL_UPDATE_CR VARCHAR2(6000);
		SQL_UPDATE_CP VARCHAR2(6000);
		
  BEGIN
	 
	/*SQL_UPDATE_CR:= 'update it.simgia_tmp_cr a
 set a.cod_persona=to_number(a.cod_persona),
    a.monto_gs=to_number(a.monto_gs),
    a.monto_usd=to_number(a.monto_usd)';
	EXECUTE IMMEDIATE	SQL_UPDATE_CR;
	COMMIT;
		SQL_UPDATE_CR:=	'update it.simgia_tmp_cp a
 set a.cod_persona=to_number(a.cod_persona),
    a.monto_gs=to_number(a.monto_gs)';
	
	EXECUTE IMMEDIATE	SQL_UPDATE_CR;
	COMMIT;*/
	
	
	
    SQL_INSERT_CR := '
INSERT INTO IT.SIMGIA_CRCP (
FECHA,
COD_OFICINA_ORIGEN,
COD_PERSONA,
NOM_PERSONA,
NOM_GESTOR,
MONTO_GS,
MONTO_USD,
TIP_OPERACION,
MTO_OBJETIVO,
RANKING_ACTUAL,
RANKING_ANTERIOR,
SUBREGION,
COD_USU_OFICIAL,
GRUPO_OFICINA)

SELECT TO_DATE(' || FECHA ||
                     ',''YYYYMMDD'')AS FECHA,
OFICINA,
COD_PERSONA,
NOM_PERSONA,
NOM_GESTOR,
MONTO_GS,
0 AS MONTO_USD,
''CR'' AS TIPO_OPERACION,
0 AS MTO_OBJETIVO,
0 AS RANKING_ACTUAL,
0 AS RANKING_ANTERIOR,
SUB_REGION SUBREGION,
                       COD_USU_OFICIAL,GRUPO_OFI
         FROM (
               SELECT C.COD_OFICINA OFICINA, C.NOMBRE NOM_GESTOR, D.DESCRIPCION GRUPO_OFI, B.COD_PERSONA
							 ,E.NOM_COMPLETO NOM_PERSONA, B.COD_USU_OFICIAL, ROUND(SUM(A.MONTO_GS)/1000,0) MONTO_GS, F.SUB_REGION 
               FROM IT.SIMGIA_CR A,
               GE_CLIENTES B,
               BA_USUARIOS C,
               BA_OFICINAS D,
							 BA_PERSONAS E,
							 simgia_grupos_oficinas f
               WHERE A.COD_PERSONA=B.COD_PERSONA
               AND B.COD_USU_OFICIAL=C.COD_USUARIO
               AND C.COD_OFICINA = D.COD_OFICINA
							 AND E.COD_PERSONA = A.COD_PERSONA
							 and f.cod_oficina = c.cod_oficina
               and a.cod_oficina < 100
               GROUP BY C.COD_OFICINA, D.DESCRIPCION, B.COD_PERSONA,E.NOM_COMPLETO,C.NOMBRE,B.COD_USU_OFICIAL, SUB_REGION
               UNION ALL               
               SELECT A.COD_OFICINA OFICINA, a.nom_gestor NOM_GESTOR, a.nom_gestor GRUPO_OFI, to_char(A.COD_OFICINA) COD_PERSONA
               ,a.nom_gestor NOM_PERSONA, decode(A.COD_OFICINA,990,''ADMINCENTRAL'',991,''RRHH'',992,''OTROS'',''OTROS'') COD_USU_OFICIAL, ROUND(SUM(A.MONTO_GS)/1000,0) MONTO_GS, F.SUB_REGION 
               FROM IT.SIMGIA_CR A,               
               simgia_grupos_oficinas f
               WHERE f.cod_oficina = a.cod_oficina
               and a.cod_oficina > 900           
               GROUP BY A.COD_OFICINA, a.nom_gestor, f.SUB_REGION 
               UNION ALL
               SELECT 993 OFICINA, ''GESTORES NO CARGADOS'' NOM_GESTOR, ''GESTORES NO CARGADOS'' GRUPO_OFI, B.COD_PERSONA
							 ,E.NOM_COMPLETO NOM_PERSONA, ''NOCARGADO'' COD_USU_OFICIAL, ROUND((SUM(A.MONTO_GS))/1000,0) MONTO_GS,
							 93 SUB_REGION
               FROM SIMGIA_CR A,
               GE_CLIENTES B,
               BA_USUARIOS C,
               BA_OFICINAS D,
							 BA_PERSONAS E							 
               WHERE A.COD_PERSONA=B.COD_PERSONA
               AND B.COD_USU_OFICIAL=C.COD_USUARIO
               AND C.COD_OFICINA = D.COD_OFICINA
							 AND E.COD_PERSONA = A.COD_PERSONA							
               and a.cod_oficina < 100
               and B.COD_USU_OFICIAL in (select a.cod_gestor no_cargado
                      from
                      (select distinct t.cod_gestor  from simgia_cr t ) a,
                      (select o.cod_usu_oficial from simgia_objetivos_agentes o
                      where o.tipo = ''CR'' 
                      and o.cod_usu_oficial not in (''RRHH'',''ADMINCENTRAL'',''OTROS'')) b
                      where a.cod_gestor = b.cod_usu_oficial (+)
                      and decode(a.cod_gestor,b.cod_usu_oficial,''OK'',''DIF'') = ''DIF'')    
               GROUP BY C.COD_OFICINA, D.DESCRIPCION, B.COD_PERSONA,E.NOM_COMPLETO,C.NOMBRE,B.COD_USU_OFICIAL
  ) X
        ORDER BY 10,3';
    COMMIT;
    EXECUTE IMMEDIATE SQL_INSERT_CR;
    --INSERT CP
    SQL_INSERT_CP := 'INSERT INTO IT.SIMGIA_CRCP (
FECHA,
COD_OFICINA_ORIGEN,
COD_PERSONA,
NOM_PERSONA,
NOM_GESTOR,
MONTO_GS,
TIP_OPERACION,
MTO_OBJETIVO,
RANKING_ACTUAL,
RANKING_ANTERIOR,
SUBREGION,
COD_USU_OFICIAL,
GRUPO_OFICINA)

SELECT TO_DATE(' || FECHA || ',''YYYYMMDD'')AS FECHA,
OFICINA,
COD_PERSONA,
NOM_PERSONA,
NOM_GESTOR,
MONTO_GS,
''CP'' AS TIPO_OPERACION,
0 AS MTO_OBJETIVO,
0 AS RANKING_ACTUAL,
0 AS RANKING_ANTERIOR,
SUB_REGION SUBREGION,
                       COD_USU_OFICIAL,GRUPO_OFI
         FROM (
               SELECT C.COD_OFICINA OFICINA, C.NOMBRE NOM_GESTOR, D.DESCRIPCION GRUPO_OFI, B.COD_PERSONA
							 ,E.NOM_COMPLETO NOM_PERSONA, B.COD_USU_OFICIAL, ROUND((SUM(A.MONTO_GS))/1000,0) MONTO_GS,
							 F.SUB_REGION
               FROM SIMGIA_CP A,
               GE_CLIENTES B,
               BA_USUARIOS C,
               BA_OFICINAS D,
							 BA_PERSONAS E,
							 SIMGIA_GRUPOS_OFICINAS F
               WHERE A.COD_PERSONA=B.COD_PERSONA
               AND B.COD_USU_OFICIAL=C.COD_USUARIO
               AND C.COD_OFICINA = D.COD_OFICINA
							 AND E.COD_PERSONA = A.COD_PERSONA
							 AND F.COD_OFICINA = C.COD_OFICINA
               and a.cod_oficina < 100
               GROUP BY C.COD_OFICINA, D.DESCRIPCION, B.COD_PERSONA,E.NOM_COMPLETO,C.NOMBRE,B.COD_USU_OFICIAL, sub_region
               UNION ALL               
               SELECT A.COD_OFICINA OFICINA, a.nom_gestor NOM_GESTOR, a.nom_gestor GRUPO_OFI, to_char(A.COD_OFICINA) COD_PERSONA
               ,a.nom_gestor NOM_PERSONA, decode(A.COD_OFICINA,990,''ADMINCENTRAL'',991,''RRHH'',992,''OTROS'') COD_USU_OFICIAL, ROUND(SUM(A.MONTO_GS)/1000,0) MONTO_GS, F.SUB_REGION 
               FROM IT.SIMGIA_CP A,               
               simgia_grupos_oficinas f
               WHERE f.cod_oficina = a.cod_oficina
               and a.cod_oficina > 900                        
               GROUP BY A.COD_OFICINA, a.nom_gestor, f.SUB_REGION
               UNION ALL
               SELECT 993 OFICINA, ''GESTORES NO CARGADOS'' NOM_GESTOR, ''GESTORES NO CARGADOS'' GRUPO_OFI, B.COD_PERSONA
							 ,E.NOM_COMPLETO NOM_PERSONA, ''NOCARGADO'' COD_USU_OFICIAL, ROUND((SUM(A.MONTO_GS))/1000,0) MONTO_GS,
							 93 SUB_REGION
               FROM SIMGIA_CP A,
               GE_CLIENTES B,
               BA_USUARIOS C,
               BA_OFICINAS D,
							 BA_PERSONAS E							 
               WHERE A.COD_PERSONA=B.COD_PERSONA
               AND B.COD_USU_OFICIAL=C.COD_USUARIO
               AND C.COD_OFICINA = D.COD_OFICINA
							 AND E.COD_PERSONA = A.COD_PERSONA							
               and a.cod_oficina < 100
               and B.COD_USU_OFICIAL in (select a.cod_gestor no_cargado
                      from
                      (select distinct t.cod_gestor  from simgia_cp t ) a,
                      (select o.cod_usu_oficial from simgia_objetivos_agentes o
                      where o.tipo = ''CP'' 
                      and o.cod_usu_oficial not in (''RRHH'',''ADMINCENTRAL'',''OTROS'')) b
                      where a.cod_gestor = b.cod_usu_oficial (+)
                      and decode(a.cod_gestor,b.cod_usu_oficial,''OK'',''DIF'') = ''DIF'')    
               GROUP BY C.COD_OFICINA, D.DESCRIPCION, B.COD_PERSONA,E.NOM_COMPLETO,C.NOMBRE,B.COD_USU_OFICIAL
    ) X
        ORDER BY 10,3';
    EXECUTE IMMEDIATE SQL_INSERT_CP;
    COMMIT;
  END CARGAR_SIMGIA_CRCP;

  PROCEDURE ACTUALIZAR_OBJETIVO_AGENTES IS
    SQL_UPDATE VARCHAR2(6000);
		SQL_UPDATE_COMPETENCIA VARCHAR2(6000);
  BEGIN
	
	
/*    SQL_UPDATE := 'update simgia_objetivos_agentes a
			set a.cod_usu_oficial = (select  b.cod_usuario 
			from ba_usuarios b 
			where b.nombre = a.nombre_gestor and b.cod_usuario not in ( ''XPY3808'', ''XPY1709'',''XPY2710'',''XPY2808'',''XPY6809'',''XPY9110'',''FRONT O. 2'') and rownum = 1)'; -- and estado = ''A''
EXECUTE IMMEDIATE SQL_UPDATE;
COMMIT;*/
    
		SQL_UPDATE := 'UPDATE IT.SIMGIA_CRCP C SET C.MTO_OBJETIVO =
(SELECT D.OBJETIVO FROM IT.SIMGIA_OBJETIVOS_AGENTES D
WHERE C.COD_USU_OFICIAL = D.COD_USU_OFICIAL and d.tipo = ''CR'' )
where c.tip_operacion = ''CR''';

    EXECUTE IMMEDIATE SQL_UPDATE;
    COMMIT;
		
SQL_UPDATE := 'UPDATE IT.SIMGIA_CRCP C SET C.MTO_OBJETIVO =
(SELECT D.OBJETIVO FROM IT.SIMGIA_OBJETIVOS_AGENTES D
WHERE C.COD_USU_OFICIAL = D.COD_USU_OFICIAL and d.tipo = ''CP'' )
where c.tip_operacion = ''CP''';

    EXECUTE IMMEDIATE SQL_UPDATE;
    COMMIT;
		
		SQL_UPDATE_COMPETENCIA := 'UPDATE IT.SIMGIA_CRCP C SET C.COMPETENCIA =
(SELECT D.COMPETENCIA FROM IT.SIMGIA_OBJETIVOS_AGENTES D
WHERE C.COD_USU_OFICIAL = D.COD_USU_OFICIAL and d.tipo = ''CR'' )
where c.tip_operacion = ''CR''';
 EXECUTE IMMEDIATE SQL_UPDATE_COMPETENCIA;
    COMMIT;
		
		SQL_UPDATE_COMPETENCIA := 'UPDATE IT.SIMGIA_CRCP C SET C.COMPETENCIA =
(SELECT D.COMPETENCIA FROM IT.SIMGIA_OBJETIVOS_AGENTES D
WHERE C.COD_USU_OFICIAL = D.COD_USU_OFICIAL and d.tipo = ''CP'' )
where c.tip_operacion = ''CP''';
 EXECUTE IMMEDIATE SQL_UPDATE_COMPETENCIA;
    COMMIT;
  END;

  PROCEDURE PRC_CALCULAR_RANKING(FECHA IN VARCHAR2) IS
    SQL_STR_CR VARCHAR2(20000);
    SQL_STR_CP VARCHAR2(20000);
		SQL_RANKING VARCHAR2(20000);
		SQL_RANKING_1 VARCHAR2(20000);
		CANTIDAD_R1 INTEGER;
		CANTIDAD_R2 INTEGER;
		

  BEGIN
	
SQL_RANKING := 'SELECT COUNT(DISTINCT A.NOM_GESTOR) CANTIDAD
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CR''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MAYORISTA''
AND A.FECHA = TO_DATE(' || FECHA || ',''YYYYMMDD'')';

EXECUTE IMMEDIATE SQL_RANKING INTO CANTIDAD_R1;
	
	
	SQL_RANKING_1 := 'SELECT COUNT(DISTINCT A.NOM_GESTOR) CANTIDAD
	FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CR''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MINORISTA''
AND A.FECHA = TO_DATE(' || FECHA ||',''YYYYMMDD'')';

EXECUTE IMMEDIATE SQL_RANKING INTO CANTIDAD_R2;
	
	-- PARA EL FILTRO VIEJO: AND A.GRUPO_OFICINA IN (''BANCA EMPRESAS - INSTIT'', ''BANCA AGRICOLA GANADERA'')
	--AND A.GRUPO_OFICINA IN (''SANTA RITA'', ''CIUDAD DEL ESTE'',''LOMA PLATA'',''CONCEPCION'',''CAMPO 9'',''SALTO DEL GUAIRA'',''ENCARNACION'',
--''OBLIGADO'', ''PEDRO JUAN CABALLERO'',''SANTANI'',''CASA MATRIZ'',''SUCURSAL CENTRO'',''ESPAÑA'',''SAN LORENZO'',''EUSEBIO AYALA'')
IF VERIFICAR_TABLAS('IT', 'SIMGIA_RANKING_ACTUAL_CR', NULL) = 1 THEN
      SQL_STR_CR := 'INSERT INTO IT.SIMGIA_RANKING_ACTUAL_CR
SELECT ''CR''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS) TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
RANK ()OVER(ORDER BY NVL(ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2),0)DESC)RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
,B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CR''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MAYORISTA''
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO,B.SUB_REGION
UNION ALL

--LAS DEMAS OFICINAS
SELECT ''CR''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
RANK ()OVER(ORDER BY NVL(ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2),0)DESC)RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
,B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CR''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MINORISTA''
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||',''YYYYMMDD'')
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO,B.SUB_REGION

UNION ALL

--LOS QUE NO COMPITEN
SELECT ''CR''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
 0 RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
,B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CR''
AND A.COMPETENCIA = ''NO''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')													
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO,B.SUB_REGION

UNION ALL

--ADMINCENTRAL, RRHH, OTROS --fijos
SELECT ''CR''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, 0 MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
0 PORC,
 0 RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
,B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CR''
AND A.cod_oficina_origen = B.cod_oficina
AND B.cod_oficina > 900
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')													
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO,B.SUB_REGION';

      EXECUTE IMMEDIATE SQL_STR_CR;
      COMMIT;

ELSE
      SQL_STR_CR := 'CREATE TABLE IT.SIMGIA_RANKING_ACTUAL_CR AS
SELECT ''CR''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS) TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
RANK () OVER(ORDER BY NVL(ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2),0)DESC)RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
, B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CR''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MAYORISTA''
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION
UNION ALL

--LAS DEMAS OFICINAS
SELECT ''CR''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
RANK () OVER(ORDER BY NVL(ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2),0)DESC)RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
, B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CR''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MAYORISTA''
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||',''YYYYMMDD'')
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION

UNION ALL

--LOS QUE NO COMPITEN
SELECT ''CR''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
 0 RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
, B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CR''
AND A.COMPETENCIA = ''NO''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')										
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION

UNION ALL

--ADMINCENTRAL, RRHH, OTROS --fijos
SELECT ''CR''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, 0 MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
0 PORC,
 0 RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
, B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CR''
AND A.cod_oficina_origen = B.cod_oficina
AND B.cod_oficina > 900
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')										
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION';

      EXECUTE IMMEDIATE SQL_STR_CR;
COMMIT;
END IF;


SQL_RANKING := 'SELECT COUNT(DISTINCT A.NOM_GESTOR) CANTIDAD
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CP''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MAYORISTA''
AND A.FECHA = TO_DATE(' || FECHA || ',''YYYYMMDD'')';

EXECUTE IMMEDIATE SQL_RANKING INTO CANTIDAD_R1;
	
	
	SQL_RANKING := 'SELECT COUNT(DISTINCT A.NOM_GESTOR) CANTIDAD
	FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B

WHERE A.TIP_OPERACION = ''CP''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MINORISTA''
AND A.FECHA = TO_DATE(' || FECHA ||',''YYYYMMDD'')';

EXECUTE IMMEDIATE SQL_RANKING INTO CANTIDAD_R2;


IF VERIFICAR_TABLAS('IT', 'SIMGIA_RANKING_ACTUAL_CP', NULL) = 1 THEN
      SQL_STR_CP := 'INSERT INTO IT.SIMGIA_RANKING_ACTUAL_CP
SELECT ''CP''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS) TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
NTILE('|| CANTIDAD_R1 ||')OVER(ORDER BY NVL(ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2),0)desc)RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
,B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CP''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MAYORISTA''
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION
UNION ALL

--LAS DEMAS OFICINAS
SELECT ''CP''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
NTILE('|| CANTIDAD_R2 ||')OVER(ORDER BY NVL(ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2),0)desc)RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
,B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CP''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MINORISTA''
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||',''YYYYMMDD'')
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION
UNION ALL

--LOS QUE NO COMPITEN
SELECT ''CP''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
0 RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
,B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CP''
AND A.COMPETENCIA = ''NO''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION

UNION ALL

--ADMINCENTRAL, RRHH, OTROS --fijos
SELECT ''CP''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, 0 MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
0 PORC,
0 RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
,B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CP''
AND A.cod_oficina_origen = B.cod_oficina
AND B.cod_oficina > 900
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION';

      EXECUTE IMMEDIATE SQL_STR_CP;
      COMMIT;

ELSE
      SQL_STR_CP := 'CREATE TABLE IT.SIMGIA_RANKING_ACTUAL_CP AS
SELECT ''CP''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS) TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
NTILE('|| CANTIDAD_R1 ||')OVER(ORDER BY NVL(ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2),0)desc)RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
, B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CP''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MAYORISTA''
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION
UNION ALL

--LAS DEMAS OFICINAS
SELECT ''CP''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
NTILE('|| CANTIDAD_R2 ||')OVER(ORDER BY NVL(ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2),0)desc)RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
, B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CP''
AND A.COMPETENCIA = ''SI''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MINORISTA''
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||',''YYYYMMDD'')
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION
										
UNION ALL

--LOS QUE NO COMPITEN
SELECT ''CP''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
ROUND((SUM(MONTO_GS)/(CASE WHEN A.MTO_OBJETIVO = 0 THEN 1 ELSE A.MTO_OBJETIVO END))*100,2) AS PORC,
0 RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
, B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CP''
AND A.COMPETENCIA = ''NO''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.cod_oficina < 100
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')
										
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION
										
UNION ALL

--ADMINCENTRAL, RRHH, OTROS --fijos
SELECT ''CP''TIPO, A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, 0 MTO_OBJETIVO, SUM(MONTO_GS)TOTAL_MTO_GS,
0 PORC,
0 RANKING_ACTUAL
,0 AS RANKING_ANTERIOR
,0 AS RANKING_OFICINA
,0 AS RANKING_OFICINA_ANTERIOR
, B.SUB_REGION
FROM IT.SIMGIA_CRCP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIP_OPERACION = ''CP''
AND A.cod_oficina_origen = B.cod_oficina
AND B.cod_oficina > 900
AND A.FECHA = TO_DATE(' || FECHA ||
                    ',''YYYYMMDD'')
										
GROUP BY A.NOM_GESTOR, A.FECHA, A.GRUPO_OFICINA, A.MTO_OBJETIVO, B.SUB_REGION';

EXECUTE IMMEDIATE SQL_STR_CP;

COMMIT;

END IF;

  END PRC_CALCULAR_RANKING;

  PROCEDURE PRC_ACTUALIZAR_RANKING_CRCP(FECHA IN VARCHAR2) IS

    SQL_UPDATE_CP VARCHAR2(6000);
    SQL_UPDATE_CR VARCHAR2(6000);
		SQL_UPDATE_CP_OFICINA VARCHAR2(6000);
		SQL_UPDATE_CR_OFICINA VARCHAR2(6000);

  BEGIN
	
	--Ranking Oficina
		 SQL_UPDATE_CP_OFICINA := 'update IT.SIMGIA_RANKING_ACTUAL_CP a1
	set a1.RANKING_OFICINA =
	(SELECT B.RANK from (select A.GRUPO_OFICINA, RANK () OVER(ORDER BY NVL(ROUND((SUM(TOTAL_MTO_GS)/(CASE WHEN sum(A.MTO_OBJETIVO) = 0 THEN 1 ELSE sum(A.MTO_OBJETIVO) END))*100,2),0)DESC) AS RANK
FROM IT.SIMGIA_RANKING_ACTUAL_CP A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIPO = ''CP''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MINORISTA''
AND A.FECHA = TO_DATE(' || FECHA ||',''YYYYMMDD'')GROUP BY  A.GRUPO_OFICINA) B WHERE B.GRUPO_OFICINA = a1.grupo_oficina)
	where a1.fecha = to_date('||FECHA||',''YYYYMMDD'')';
	
	COMMIT;
EXECUTE IMMEDIATE SQL_UPDATE_CP_OFICINA;


SQL_UPDATE_CR_OFICINA := 'update IT.SIMGIA_RANKING_ACTUAL_CR a1
	set a1.RANKING_OFICINA =
	(SELECT B.RANK from (select A.GRUPO_OFICINA, RANK () OVER(ORDER BY NVL(ROUND((SUM(TOTAL_MTO_GS)/(CASE WHEN sum(A.MTO_OBJETIVO) = 0 THEN 1 ELSE sum(A.MTO_OBJETIVO) END))*100,2),0)DESC) AS RANK
FROM IT.SIMGIA_RANKING_ACTUAL_CR A, IT.SIMGIA_GRUPOS_OFICINAS B
WHERE A.TIPO = ''CR''
AND A.GRUPO_OFICINA = B.GRUPO_OFICINA
AND B.TIPO = ''MINORISTA''
AND A.FECHA = TO_DATE(' || FECHA ||',''YYYYMMDD'')GROUP BY  A.GRUPO_OFICINA) B WHERE B.GRUPO_OFICINA = a1.grupo_oficina)
	where a1.fecha = to_date('||FECHA||',''YYYYMMDD'')';
	
	COMMIT;
EXECUTE IMMEDIATE SQL_UPDATE_CR_OFICINA;



	/*
    --Ranking Anterior
    SQL_UPDATE_CP := 'update IT.SIMGIA_RANKING_ACTUAL_CP a1
set a1.ranking_anterior =
(select a.ranking_actual from simgia_ranking_actual_cp a where 
fecha = (select max(d.fecha) from simgia_ranking_actual_cp d 
where d.fecha < (select max(fecha) from simgia_ranking_actual_cp))  
and a1.nom_gestor = a.nom_gestor and a.tipo = ''CP''),
a1.ranking_oficina_anterior = (select a.ranking_oficina from simgia_ranking_actual_cp a where 
fecha = (select max(d.fecha) from simgia_ranking_actual_cp d 
where d.fecha < (select max(fecha) from simgia_ranking_actual_cp))  
and a1.nom_gestor = a.nom_gestor and a.tipo = ''CP'')
where a1.fecha = to_date('||FECHA||',''YYYYMMDD'')';


COMMIT;
EXECUTE IMMEDIATE SQL_UPDATE_CP;

    SQL_UPDATE_CR := 'update IT.SIMGIA_RANKING_ACTUAL_CR a1
