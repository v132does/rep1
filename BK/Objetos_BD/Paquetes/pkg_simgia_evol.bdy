and a1.nom_gestor = a.nom_gestor and a.tipo = ''CR''),
a1.ranking_oficina_anterior =
(select a.ranking_oficina from simgia_ranking_actual_cr a where 
fecha = (select max(d.fecha) from simgia_ranking_actual_cr d 
where d.fecha < (select max(fecha) from simgia_ranking_actual_cr))  
