CREATE OR REPLACE PACKAGE IT.PKG_SIMGIA_EVOL AUTHID CURRENT_USER IS

  PROCEDURE PRC_LIMPIAR;
	PROCEDURE PRC_PRINCIPAL(FECHA IN VARCHAR2);
	FUNCTION VERIFICAR_TABLAS(OWNER  IN VARCHAR2,
														TABLA  IN VARCHAR2,
														DBLINK IN VARCHAR2) RETURN INTEGER;
	PROCEDURE CARGAR_SIMGIA_CRCP(FECHA IN VARCHAR2);
	PROCEDURE ACTUALIZAR_OBJETIVO_AGENTES;
	PROCEDURE PRC_CALCULAR_RANKING(FECHA IN VARCHAR2);
	PROCEDURE PRC_ACTUALIZAR_RANKING_CRCP(FECHA IN VARCHAR2);

end PKG_SIMGIA_EVOL;
/

