CREATE OR REPLACE PACKAGE IT.PAG_CAL IS

G_FEC_ACTUAL GE_CALENDARIOS.FEC_ACTUAL%TYPE;
G_NOM_MES GE_CALENDARIOS.NOM_MES%TYPE;
G_NRO_TRIMESTRE GE_CALENDARIOS.NRO_TRIMESTRE%TYPE;
G_FEC_PROXIMA GE_CALENDARIOS.FEC_PROXIMA%TYPE;
G_FEC_ANTERIOR GE_CALENDARIOS.FEC_ANTERIOR%TYPE;
G_PRI_DIA_MES GE_CALENDARIOS.PRI_DIA_MES%TYPE;
G_PRI_DIA_MES_HABIL GE_CALENDARIOS.PRI_DIA_MES_HABIL%TYPE;
G_ULT_DIA_MES GE_CALENDARIOS.ULT_DIA_MES%TYPE;
G_ULT_DIA_MES_HABIL GE_CALENDARIOS.ULT_DIA_MES_HABIL%TYPE;
G_PRI_DIA_TRIMESTRE GE_CALENDARIOS.PRI_DIA_TRIMESTRE%TYPE;
RG_GCALE GE_CALENDARIOS%ROWTYPE;
G_PRI_DIA_HAB_TRIMESTRE GE_CALENDARIOS.PRI_DIA_HAB_TRIMESTRE%TYPE;
G_ULT_DIA_TRIMESTRE GE_CALENDARIOS.ULT_DIA_TRIMESTRE%TYPE;
G_ULT_DIA_HAB_TRIMESTRE GE_CALENDARIOS.ULT_DIA_HAB_TRIMESTRE%TYPE;
G_MES_INI_TRIMESTRE GE_CALENDARIOS.MES_INI_TRIMESTRE%TYPE;
G_CAN_DIA_ANO GE_CALENDARIOS.CAN_DIA_ANO%TYPE;
G_MES_FIN_TRIMESTRE GE_CALENDARIOS.MES_FIN_TRIMESTRE%TYPE;
G_NOM_DIA GE_CALENDARIOS.NOM_DIA%TYPE;

/* Obtiene la fecha actual */
FUNCTION FU_OBT_FEC_ACTUAL
 (P_COD_MODULO IN BA_MODULOS.COD_MODULO%TYPE
 )
 RETURN DATE;
/* Obtiene la fecha proxima de GE_CALENDARIOS dado el modulo */
FUNCTION FU_OBT_FEC_PROXIMA
 (P_COD_MODULO IN BA_MODULOS.COD_MODULO%TYPE
 )
 RETURN DATE;
/* Obtiene la fecha anterior */
FUNCTION FU_OBT_FEC_ANTERIOR
 (P_COD_MODULO IN BA_MODULOS.COD_MODULO%TYPE
 )
 RETURN DATE; 
/* Obtener la siguiente fecha habil segun el factor de la fecha parametro */
FUNCTION FU_OBT_FEC_HABIL
 (P_FECHA IN DATE
 ,P_FACTOR IN NUMBER
 ,P_COD_OFICINA IN BA_OFICINAS.COD_OFICINA%TYPE
 )
 RETURN DATE;
/* Obtiene la anterior fecha hábil */
FUNCTION FU_OBT_FEC_ANT_HAB
 (P_FECHA IN DATE
 ,P_COD_OFICINA IN BA_OFICINAS.COD_OFICINA%TYPE
 ,P_DIAS IN NUMBER DEFAULT 1
 )
 RETURN DATE;
/* Obtiene la Siguiente fecha habil */
FUNCTION FU_OBT_FEC_SIG_HAB
 (P_FECHA IN DATE
 ,P_COD_OFICINA IN BA_OFICINAS.COD_OFICINA%TYPE
 ,P_DIAS IN NUMBER DEFAULT 1
 )
 RETURN DATE;
/* Obtiene el registro de GE_CALENDARIO dado un módulo especifico. */
FUNCTION FU_OBT_REG_CAL
 (P_MODULO IN GE_MODALIDADES.COD_MODULO%TYPE
 )
 RETURN ge_calendarios%rowtype;
/* Obtener datos del Calendario */
PROCEDURE PR_OBT_DAT_CALENDAR
 (P_COD_MODULO IN BA_MODULOS.COD_MODULO%TYPE
 );
/* Obtener el nombre del día en Español */
FUNCTION FU_OBT_NOM_DIA
 (P_FECHA date
 )
 RETURN VARCHAR2;
/* Obtiene fecha fin de retencion */
FUNCTION FU_OBT_FEC_FIN_RET
 (P_FECHA IN DATE
 ,P_COD_OFICINA IN BA_OFICINAS.COD_OFICINA%TYPE
 ,P_DIAS IN NUMBER DEFAULT 0
 )
 RETURN DATE;
/* Obtiene la fecha del primer día habil del mes de GE_CALENDARIOS dado e */
FUNCTION FU_OBT_FEC_PRI_DIA_MES_HABIL
 (P_COD_MODULO IN BA_MODULOS.COD_MODULO%TYPE
 )
 RETURN DATE;
END PAG_CAL;
/

