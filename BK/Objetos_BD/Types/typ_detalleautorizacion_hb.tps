CREATE OR REPLACE TYPE IT."TYP_DETALLEAUTORIZACION_HB"                                          FORCE is OBJECT
(
  error                     VARCHAR2(1),
  descripcionError          VARCHAR2(200),
  descripcionMensaje        VARCHAR2(100),
  numeroComprobante         NUMBER(15),
  fechaOperacion            DATE,
  cuentaPrincipal           VARCHAR2(300),
  tipoCuenta                VARCHAR2(50),
  monedaPrincipal           VARCHAR2(50),
  oficinaPrincipal          VARCHAR2(100),
  codigoMonedaPrincipal     VARCHAR2(3),
  montoPrincipal            NUMBER(18,2),
  montoCargo                NUMBER(18,2),
  montoIva                  NUMBER(18,2),
  cotizacion                NUMBER(14,8),
  montoEquLocal             NUMBER(18,2),
  codigoMovimiento          VARCHAR2(3),
  descripcionMovimiento     VARCHAR2(100),
  cantidad                  NUMBER(10),
  etiqueta                  VARCHAR2(50),
  dato                      VARCHAR2(50),
  etiqueta2                 VARCHAR2(50),
  dato2                     VARCHAR2(50),
  etiquetaContra            VARCHAR2(100),
  cuentaContra              VARCHAR2(300),
  tipoCuentaContra          VARCHAR2(50),
  cotizacionContra          NUMBER(14,8),
  codigoMonedaContra        VARCHAR2(3),
  montoContra               NUMBER(18,2),
  nombreIngreso             VARCHAR2(100),
  cantidadAutRequeridas     NUMBER,
  cantidadAutFaltantes      NUMBER,
  tipoEnteSalario           VARCHAR2(1),
  estadoSalario             VARCHAR2(1),
  cantidadDetallesSalario   NUMBER,
  listaDetalleSalario       typ_listaDetalleSalario,--NVB-2232
  estadoProveedor           VARCHAR2(1),
  cantidadDetallesProveedor NUMBER,
  listaDetalleProveedor     typ_listadetalleproveedor,
  cantidadAutorizadores     NUMBER,
  listaAutorizadores        typ_listaDetalleAutorizador,
  extraData                 VARCHAR2(2000),
  estadoRecaudador          VARCHAR2(1),
  cantidadRecaudacion       NUMBER,
  listaRecaudacion          typ_listadetallerecaudacion,
  cantidadAlta              NUMBER,
  listaAltaEmpleados        typ_listaempleados,
  tipPago                   VARCHAR2(1),
  semillaAutorizacion       NUMBER,
  CONSTRUCTOR FUNCTION typ_detalleautorizacion_hb RETURN SELF AS RESULT
)
/

