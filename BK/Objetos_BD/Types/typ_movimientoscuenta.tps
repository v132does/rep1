CREATE OR REPLACE TYPE IT.TYP_MOVIMIENTOSCUENTA FORCE IS OBJECT
(
fecha           DATE,
hora            VARCHAR(8),
numeroDocumento NUMBER(15),
monto           NUMBER(18),
tipoMovimientos VARCHAR2(1),
nroCuenta       VARCHAR2(20),
  CONSTRUCTOR FUNCTION TYP_MOVIMIENTOSCUENTA RETURN SELF AS RESULT
)
/
