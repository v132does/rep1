CREATE OR REPLACE TYPE IT.TYP_TRANSFERENCIASCUENTA FORCE IS OBJECT
(
fecha           DATE,
hora            VARCHAR(8),
numeroDocumento NUMBER(15),
monto           NUMBER(18),
codigoBanco     NUMBER(3),
nroCuenta       VARCHAR2(20),
  CONSTRUCTOR FUNCTION TYP_TRANSFERENCIASCUENTA RETURN SELF AS RESULT
)
/
