CREATE OR REPLACE TYPE IT."TYP_EMPLEADO"                                          force is OBJECT
(
   numeroDocumento      VARCHAR2(20),
   tipoDocumento        VARCHAR2(3),
   fechaVencDocumento   VARCHAR2(10),
   codigoPaisDocumento  NUMBER(3),
   nombrePaisDocumento  VARCHAR2(60),
   nombre               VARCHAR2(60),
   primerApellido       VARCHAR2(30),
   segundoApellido      VARCHAR2(30),
   fechaNacimiento      VARCHAR2(10),
   sexo                 VARCHAR2(1),
   estadoCivil          VARCHAR2(60),
   direccion            VARCHAR2(100),
   ciudad               VARCHAR2(100),
   codigoPais           NUMBER(3),
   pais                 VARCHAR2(40),
   telefono             VARCHAR2(20),
   celular              VARCHAR2(20),
   email                VARCHAR2(100),
   apellidoCasada       VARCHAR2(15),
   separacionBienes     VARCHAR2(1),
   codigoPaisFatca      NUMBER(3),
   nombrePaisFatca      VARCHAR2(60),
   direccionFiscal      VARCHAR2(80),
   codigoPaisFiscal     NUMBER(3),
   nombrePaisFiscal     VARCHAR2(60),
   sueldo               NUMBER(18,2),
   codigoProfesion      NUMBER(3),
   profesion            VARCHAR2(35),
   fechaIngreso         VARCHAR2(10),
   tipoContrato         VARCHAR2(1),
   nombreSucursal       VARCHAR2(100),
   direccionSucursal    VARCHAR2(80),
   estado               VARCHAR2(3),
   sobregiro            VARCHAR2(1),
   codigoSectorContable VARCHAR2(1),
   fechaProceso         VARCHAR2(10),
   cuentaAsignada       VARCHAR2(20),
   numeroSolicitud      NUMBER,
   codigoError          NUMBER,
   error                VARCHAR2(1000),
   fechaRecepcion       VARCHAR2(10),
  CONSTRUCTOR FUNCTION typ_empleado RETURN SELF AS RESULT
)
/

