CREATE OR REPLACE TYPE IT."TYP_DATCUSTOMER"                                          IS OBJECT(
   customerId                         VARCHAR2(50),  -- Id de Cliente("1234123275")(R)
   firstName                          VARCHAR2(100), -- Primer Nombre("Carlos")(R)
   middleName                         VARCHAR2(100), -- Segundo Nombre (O)
   lastName                           VARCHAR2(100), -- Apellido("Salas Tapia")(R)
   suffix                             VARCHAR2(100),  -- Sufijo ("PDH")(O)
   birthDataCity                      VARCHAR2(100), -- Ciudad de Nacimiento("Lima")(O)
   birthDataStateid                   VARCHAR2(100), -- Id. de estado("PE-LMA")(R)
   birthDataStatename                 VARCHAR2(100), -- Nombre de estado Provincia o Region("Lima")(R)
   birthDataCountryid                 VARCHAR2(100),  -- Id de Pais de Nacimiento("PE")(R)
   birthDataCountryname               VARCHAR2(100), -- Nombre de Pais de Nacimiento("Perú")(R)
   birthDataBirthDate                 VARCHAR2(100),  -- Fecha de Nacimiento("1946-07-09")(R)
   nationalityid                      VARCHAR2(100),  -- Id de Nacionalidad("PE")(R)
   nationalityName                    VARCHAR2(100), -- Nacionalidad("Perú")(R)
   iDdocumentTypeid                   VARCHAR2(100),  -- Id de documento de Identidad("DNI")(R)
   iDdocumentTypeName                 VARCHAR2(100), -- Nombre de Tipo("Documento Nacional de Identidad")(R)
   iDcountryid                        VARCHAR2(100),  -- Id de Pais de Documento ("PE")(R)
   iDcountryname                      VARCHAR2(100), -- Nombre de Pais de Documento("PERU")(R)
   iDstateid                          VARCHAR2(100),  -- ID de estado de documento("PE-LMA")(R)
   iDstatename                        VARCHAR2(100), -- Nombre de estado, region, provincia("Lima")(R)
   iDstatusid                         VARCHAR2(100),  -- Id del estatus (Active/Expired)("ACTIVE")(R)
   iDstatusname                       VARCHAR2(100), -- nombre del status("Activo")(R)
   iDissueDate                        VARCHAR2(12),  -- Fecha de Emision("2016-09-02")(O)
   iDexpirationDate                   VARCHAR2(12),  -- Fecha de Expiracion("2018-09-02")(O)
   iDdocumentNumber                   VARCHAR2(100), -- Nro del documento ("12345678912")(R)
   membershipDate                     VARCHAR2(12),  -- fecha de membresia("2016-01-15")(R)
   lastAccessDate                     VARCHAR2(20),  -- fecha/Hora (0)
   personalTitleid                    VARCHAR2(10),  -- Id de titulo("MR")(R)
   personalTitlename                  VARCHAR2(100), -- Descripcion de titulo("Señor")(R)
   maritalStatusid                    VARCHAR2(100),  -- Id de estado civil("SINGLE")(R)
   maritalStatusname                  VARCHAR2(100), -- Nombre de estado civil("Soltero")(R)
   genderid                           VARCHAR2(20),  -- id de genero("MALE")(R)
   gendername                         VARCHAR2(100), -- nombre de genero("Masculino")(R)
   bankId                             VARCHAR2(100),  -- Id de Banco("0101")(R)
   bankname                           VARCHAR2(100), -- Nombre de Banco ("BBVA Continental")(R)
   bankbranchId                       VARCHAR2(30),  -- id de rama("4000")(R)
   bankbranchname                     VARCHAR2(100), -- Nombre de Rama("Oficina Principal")(R)
   bankbranchcostCenter               VARCHAR2(100), -- unidad de centro de Costo dentro del banco(O)
   residencecountryid                 VARCHAR2(100),  -- Id de pais de residencia("PE")(R)
   residencecountryname               VARCHAR2(100), -- Nombre de Pais de residencia("Perú")(R)
   residenceTypeid                    VARCHAR2(50),  -- Id de tipo de residencia("PERMANENT")(R)
   residenceTypename                  VARCHAR2(100), -- Descripcion de tipo("Permanente")(R)
   residencestartDate                 VARCHAR2(12),  -- Inicio de estadia de residencia("1990-11-23")(R)
   pEPid                              VARCHAR2(30),  -- PEP id("SELF")(R)
   pEPfullName                        VARCHAR2(100), -- Pep name(O)
   pEPposition                        VARCHAR2(100), -- PEP Posicion("AMBASSADOR")(O)
   socialSecurityNumber               VARCHAR2(100), -- Nombre de Seguro Social(O)
   isClient                           VARCHAR2(100), -- Es Cliente (S- si es cliente , N- Si es persona , NULL sino Existe)
   error                              VARCHAR2(1),   --  Indica si la respuesta es de error o no
   nombreRespuesta                    VARCHAR2(15),  --  Codigo de respuesta
   descripcionRespuesta               VARCHAR2(200), --  Descripcion del codigo de respuesta
   CONSTRUCTOR FUNCTION typ_datCustomer RETURN SELF AS result
)
/

