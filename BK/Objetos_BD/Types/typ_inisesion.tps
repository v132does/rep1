CREATE OR REPLACE TYPE IT."TYP_INISESION" IS OBJECT
(
  access_token             varchar2(32),
  last_access              varchar2(20),
  first_login              varchar2(1),
  conditions_accepted      varchar2(4),
  transactional_key_status varchar2(1),
  is_acceso_session_itgf   varchar2(5),
  fullName                 varchar2(120),
  email                    varchar2(80),
  profile                  varchar2(20),
  city                     varchar2(80),
  address_description      varchar2(80),
  manager_name             varchar2(60),
  manager_email            varchar2(80),
  manager_phone_number     varchar2(35),
  branch_id                varchar2(3),
  branch_number            varchar2(3),
  branch_name              varchar2(40),
  branch_city              varchar2(150),
  branch_country           varchar2(100),
  branch_address           varchar2(250),
  branch_latitude          varchar2(25),
  branch_longitude         varchar2(25),
  branch_phone_number      varchar2(20),
  clientCode               varchar2(10),
  profileDescription       varchar2(40),
  gender                   varchar2(1),
  birthDate                varchar2(10),
  birthCountry             varchar2(40),
  countryCodBT             varchar2(3),
  survey                   varchar2(1),
  documentClientNumber     varchar2(20),
  documentClientTypeBT     varchar2(3),
  clientCodeDtm            varchar2(4),
  employee                 varchar2(1),
  cel                      varchar2(35),
  companyName              varchar2(150),
  externalCompanyCode      varchar2(10),
  error                    varchar2(1),
  error_code               varchar2(50),
  error_description        varchar2(4000),

  CONSTRUCTOR FUNCTION TYP_INISESION RETURN SELF AS result
)
/
