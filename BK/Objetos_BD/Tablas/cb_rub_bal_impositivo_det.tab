create table IT.CB_RUB_BAL_IMPOSITIVO_DET
(
  cod_rub_padre    VARCHAR2(15),
  cod_rubro        VARCHAR2(15),
  mto_debito       NUMBER(18,2),
  mto_credito      NUMBER(18,2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_RUB_BAL_IMPOSITIVO_DET
  is 'Detalles de rubros del balance impositivo.';
comment on column IT.CB_RUB_BAL_IMPOSITIVO_DET.cod_rub_padre
  is 'Codigo de rubro padre para el Balance Impositivo.';
comment on column IT.CB_RUB_BAL_IMPOSITIVO_DET.cod_rubro
  is 'Codigo de rubro contable.';
comment on column IT.CB_RUB_BAL_IMPOSITIVO_DET.mto_debito
  is 'Monto debito.';
comment on column IT.CB_RUB_BAL_IMPOSITIVO_DET.mto_credito
  is 'Monto credito.';
comment on column IT.CB_RUB_BAL_IMPOSITIVO_DET.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_RUB_BAL_IMPOSITIVO_DET.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_RUB_BAL_IMPOSITIVO_DET.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_RUB_BAL_IMPOSITIVO_DET.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

