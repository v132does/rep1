-- Create table
create table IT.BA_TAB_DAT_ADICIONALES
(
  tab_relacion     VARCHAR2(30) not null,
  referencia       VARCHAR2(50) not null,
  parametro        VARCHAR2(30) not null,
  val_parametro    VARCHAR2(500) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.BA_TAB_DAT_ADICIONALES
  is 'Datos adicionales por TABLAS. Contiene los datos';
-- Add comments to the columns 
comment on column IT.BA_TAB_DAT_ADICIONALES.tab_relacion
  is 'Tabla de relacion';
comment on column IT.BA_TAB_DAT_ADICIONALES.referencia
  is 'Dato de referencia';
comment on column IT.BA_TAB_DAT_ADICIONALES.parametro
  is 'Codigo del campo.';
comment on column IT.BA_TAB_DAT_ADICIONALES.val_parametro
  is 'Valor del campo.';
comment on column IT.BA_TAB_DAT_ADICIONALES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_TAB_DAT_ADICIONALES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_TAB_DAT_ADICIONALES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_TAB_DAT_ADICIONALES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
-- Create/Recreate indexes 
create index IT.IN_ETDAD_REFERENCIA_PARAMETRO on IT.BA_TAB_DAT_ADICIONALES (REFERENCIA, PARAMETRO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.BA_TAB_DAT_ADICIONALES
  add constraint PK_BA_TAB_DAT_ADICIONALES primary key (TAB_RELACION, PARAMETRO, REFERENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.BA_TAB_DAT_ADICIONALES to IT_TEMPORAL;
