  is 'Monto Previsión Cta Hijo realizada en fecha de inicio de nueva operación';
comment on column IT.PR_RE4_DIF_PREVISIONES.observacion
  is 'Observación';
comment on column IT.PR_RE4_DIF_PREVISIONES.mto_tot_deu_cta_madre
