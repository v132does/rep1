comment on column IT.PR_RE4_DIF_PREVISIONES.cat_rie_cliente
  is 'Categoria de Riesgo del Cliente antes del nacimiento de la nueva cuenta.';
comment on column IT.PR_RE4_DIF_PREVISIONES.fec_dat_rie_cliente
  is 'Fecha obtenida para Categoria de Riesgo del Cliente antes del nacimiento de la nueva cuenta.';
comment on column IT.PR_RE4_DIF_PREVISIONES.mto_deu_real
  is 'Monto Deuda Real Fecha inicial';
comment on column IT.PR_RE4_DIF_PREVISIONES.mto_dev_no_cobrado
  is 'Monto Devengado no Cobrado';
alter table IT.PR_RE4_DIF_PREVISIONES
  add constraint PK_PR_RE4_PREVISIONES primary key (NRO_CUENTA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_RE4_DIF_PREVISIONES
  add constraint FK_PRPRE_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

