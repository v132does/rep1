comment on column IT.PR_RE4_DIF_PREVISIONES.cat_ren_cta_madre
  is 'categoria de las renovaciones, refinanciaciones o restructuraciones Cta. Madre';
comment on column IT.PR_RE4_DIF_PREVISIONES.mto_pre_mon_original
  is 'Monto Total Previsión Diferir en moneda original';
comment on column IT.PR_RE4_DIF_PREVISIONES.cotizacion
  is 'Cotización';
comment on column IT.PR_RE4_DIF_PREVISIONES.cod_mon_cta_madre
  is 'Código de moneda Cta Madre';
comment on column IT.PR_RE4_DIF_PREVISIONES.por_pre_cta_hijo
  is 'Porcentaje que fue aplicado para Previsión Cta. Hijo';
comment on column IT.PR_RE4_DIF_PREVISIONES.cat_ren_cta_hijo
  is 'categoria de las renovaciones, refinanciaciones o restructuraciones Cta. Hijo';
comment on column IT.PR_RE4_DIF_PREVISIONES.fec_pre_ini_cta_ori
  is 'Fecha previsión Cuenta Origen antes de Nueva Operación';
comment on column IT.PR_RE4_DIF_PREVISIONES.fec_pre_cta_madre
  is 'Fecha Previsión Cta Madre';
comment on column IT.PR_RE4_DIF_PREVISIONES.fec_pre_cta_hijo
  is 'Fecha Previsión Cta Hijo ';
comment on column IT.PR_RE4_DIF_PREVISIONES.mto_prev_cta_madre
  is 'Monto Previsión Cta Madre ';
comment on column IT.PR_RE4_DIF_PREVISIONES.por_cta_mad_fec_ini
  is 'Porcentaje que fue aplicado para Previsión Cta. Madre';
comment on column IT.PR_RE4_DIF_PREVISIONES.mto_pre_cta_mad_fec_ini
  is 'Monto Previsión Cta Madre realizada en fecha de inicio de nueva operación';
comment on column IT.PR_RE4_DIF_PREVISIONES.por_cta_hij_fec_ini
  is 'Porcentaje que fue aplicado para Previsión Cta. Hijo';
