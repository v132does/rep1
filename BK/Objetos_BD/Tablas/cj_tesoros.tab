create table IT.CJ_TESOROS
(
  cod_ofi_emisora   NUMBER(3),
  cod_usu_emisor    VARCHAR2(10),
  cod_caj_emisora   NUMBER(3),
  cod_tipo          VARCHAR2(1),
  nro_remesa        NUMBER(11),
  cod_moneda        VARCHAR2(3),
  cantidad          NUMBER(10) default 0,
  monto             NUMBER(18,2),
  estado            VARCHAR2(1),
  cod_denominacion  VARCHAR2(3),
  descripcion       VARCHAR2(250),
  fec_emision       DATE,
  hor_emision       VARCHAR2(8),
  cod_ofi_destino   NUMBER(3),
  cod_usu_receptor  VARCHAR2(10),
  cod_caj_receptora NUMBER(3),
  fec_recepcion     DATE,
  hor_recepcion     VARCHAR2(8),
  fechayhora        DATE,
  auditor           VARCHAR2(10),
  id                NUMBER(11) default 0,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_banco         NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CJ_TESOROS
  is 'Tabla creada por WorldSys.';
comment on column IT.CJ_TESOROS.cod_ofi_emisora
  is 'Codigo de la sucursal que remite los fondos.';
comment on column IT.CJ_TESOROS.cod_usu_emisor
  is 'Usuario que realizo la operacion.';
comment on column IT.CJ_TESOROS.cod_caj_emisora
  is 'Codigo de caja donde se realizo la operacion.';
comment on column IT.CJ_TESOROS.cod_tipo
  is '''1'' indica propio  , 2 indica en custodia';
comment on column IT.CJ_TESOROS.nro_remesa
  is 'Numero de cada operacion.';
comment on column IT.CJ_TESOROS.cod_moneda
  is 'Codigo de moneda de la operacion.';
comment on column IT.CJ_TESOROS.cantidad
  is 'Cantidad de billetes o monedas.';
comment on column IT.CJ_TESOROS.monto
  is 'Importe de la operacion.';
comment on column IT.CJ_TESOROS.estado
  is 'estado 1 = emitido, 2 recepcionado  9 reversado o anulado.';
comment on column IT.CJ_TESOROS.cod_denominacion
  is 'Indica la especie de la cantidad y corresponde a una tabla general.';
comment on column IT.CJ_TESOROS.descripcion
  is 'Descripcion del valor en custodia.';
comment on column IT.CJ_TESOROS.fec_emision
  is 'Fecha de emision de la remesa.';
comment on column IT.CJ_TESOROS.hor_emision
  is 'Hora de la emision de la remesa.';
comment on column IT.CJ_TESOROS.cod_ofi_destino
  is 'Codigo de la sucursal que recibe los fondos.';
comment on column IT.CJ_TESOROS.cod_usu_receptor
  is 'Usuario que realizo la confirmacion de los fondos recibidos.';
comment on column IT.CJ_TESOROS.cod_caj_receptora
  is 'Caja donde se realizo la recepcion de los fondos.';
comment on column IT.CJ_TESOROS.fec_recepcion
  is 'Fecha de la recepcion.';
comment on column IT.CJ_TESOROS.hor_recepcion
  is 'Hora de la recepcion.';
comment on column IT.CJ_TESOROS.fechayhora
  is 'Fecha y hora de la ultima modificacion.';
comment on column IT.CJ_TESOROS.auditor
  is 'Usuario que realizo la ultima modificacion.';
comment on column IT.CJ_TESOROS.id
  is 'Autonumerico.';
comment on column IT.CJ_TESOROS.usu_insercion
  is 'Usuario que realizo la  insercion del registro.';
comment on column IT.CJ_TESOROS.fec_insercion
  is 'Fecha en que se inserto el  registro.';
comment on column IT.CJ_TESOROS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion  en el registro.';
comment on column IT.CJ_TESOROS.fec_modificacion
  is 'Fecha en que se realizo la ultima  modificacion en el registro.';

