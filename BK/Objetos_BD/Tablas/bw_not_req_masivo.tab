create table IT.BW_NOT_REQ_MASIVO
(
  cod_mensaje      NUMBER default 0 not null,
  cod_persona      VARCHAR2(10) not null,
  mensaje          VARCHAR2(200) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  lote             NUMBER,
  encolado         VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_NOT_REQ_MASIVO
  is 'Mensajes masivos push';
comment on column IT.BW_NOT_REQ_MASIVO.cod_mensaje
  is 'Identificador de los mensaje';
comment on column IT.BW_NOT_REQ_MASIVO.cod_persona
  is 'Codigo de la persona';
comment on column IT.BW_NOT_REQ_MASIVO.mensaje
  is 'Mensaje a ser enviado';
comment on column IT.BW_NOT_REQ_MASIVO.lote
  is 'Agrupador de mensajes';
comment on column IT.BW_NOT_REQ_MASIVO.encolado
  is 'Indica si fue encolado para envio';

