-- Create table
create table it.ah_con_dia_cab
(
  nro_con_dia     NUMBER(18) not null,
  tip_registro    VARCHAR2(1),
  cod_marca       VARCHAR2(5),
  cod_ent_emisora VARCHAR2(5),
  fec_proceso     DATE,
  hor_proceso     VARCHAR2(8),
  archivo         VARCHAR2(8),
  des_archivo     VARCHAR2(30),
  filtros         VARCHAR2(1735)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.AH_CON_DIA_CAB
  is 'Conciliacion de transacciones diaria Cabecera';
-- Add comments to the columns 
comment on column IT.AH_CON_DIA_CAB.nro_con_dia
  is 'Nro. Conciliacion diaria';
comment on column IT.AH_CON_DIA_CAB.tip_registro
  is 'Tipo de Registro (2-Detalle)';
comment on column IT.AH_CON_DIA_CAB.cod_marca
  is 'Codigo de Marca';
comment on column IT.AH_CON_DIA_CAB.cod_ent_emisora
  is 'Codigo asignado a la entidad otorgante.';
comment on column IT.AH_CON_DIA_CAB.fec_proceso
  is 'Fecha de Proceso del Archivo';
comment on column IT.AH_CON_DIA_CAB.hor_proceso
  is 'Hora de proceso del archivo';
comment on column IT.AH_CON_DIA_CAB.archivo
  is 'Nombre del Archivo';
comment on column IT.AH_CON_DIA_CAB.des_archivo
  is 'Descripcion del Archivo';
comment on column IT.AH_CON_DIA_CAB.filtros
  is 'Filtros.';
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.AH_CON_DIA_CAB
  add constraint PK_AH_CON_DIA_CAB primary key (NRO_CON_DIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Grant/Revoke object privileges 
grant select, insert, update, delete, alter, debug, read on IT.AH_CON_DIA_CAB to IT_TEMPORAL;
