create table IT.GE_PAQ_CUENTAS
(
  cod_paquete       NUMBER(3) not null,
  cod_persona       VARCHAR2(10) not null,
  nro_cuenta        VARCHAR2(15) not null,
  cod_modulo        NUMBER(3) not null,
  cod_modalidad     NUMBER(3) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_sub_modalidad NUMBER,
  sub_afinidad      VARCHAR2(3),
  nro_secuencia     NUMBER(3) not null,
  afinidad          VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAQ_CUENTAS
  is 'Cuentas de Clientes vinculadas a Paquetes';
comment on column IT.GE_PAQ_CUENTAS.cod_paquete
  is 'Código de Paquete.';
comment on column IT.GE_PAQ_CUENTAS.cod_persona
  is 'Código de Persona.';
comment on column IT.GE_PAQ_CUENTAS.nro_cuenta
  is 'Número de Cuenta.';
comment on column IT.GE_PAQ_CUENTAS.cod_modulo
  is 'Código de Módulo.';
comment on column IT.GE_PAQ_CUENTAS.cod_modalidad
  is 'Código de Modalidad.';
comment on column IT.GE_PAQ_CUENTAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_PAQ_CUENTAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PAQ_CUENTAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAQ_CUENTAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAQ_CUENTAS.cod_sub_modalidad
  is 'Código de Sub Modalidad.';
comment on column IT.GE_PAQ_CUENTAS.sub_afinidad
  is 'Código de Sub Afinidad';
comment on column IT.GE_PAQ_CUENTAS.nro_secuencia
  is 'Número de Secuencia';
comment on column IT.GE_PAQ_CUENTAS.afinidad
  is 'Código de Afinidad';
alter table IT.GE_PAQ_CUENTAS
  add constraint PK_GE_PAQ_CUENTAS primary key (COD_PAQUETE, COD_PERSONA, NRO_CUENTA, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAQ_CUENTAS
  add constraint UK_GPACTA_NRO_CUENTA unique (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAQ_CUENTAS
  add constraint FK_GPACTA_COD_PAQUETE foreign key (COD_PAQUETE)
  references IT.GE_PAQUETES (COD_PAQUETE);
alter table IT.GE_PAQ_CUENTAS
  add constraint FK_GPACTA_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_PAQ_CUENTAS
  add constraint FK_GPACTA_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.GE_PAQ_CUENTAS
  add constraint FK_GPACTA_PAQCLI foreign key (COD_PAQUETE, COD_PERSONA, NRO_SECUENCIA)
  references IT.GE_PAQ_CLIENTES (COD_PAQUETE, COD_PERSONA, NRO_SECUENCIA);

