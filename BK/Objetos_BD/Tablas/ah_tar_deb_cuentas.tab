create table IT.AH_TAR_DEB_CUENTAS
(
  nro_cuenta          VARCHAR2(15) not null,
  cod_persona         VARCHAR2(10) not null,
  nro_cta_relacionada VARCHAR2(15) not null,
  usu_insercion       VARCHAR2(10) default substr( USER,1, 10 ) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default substr( USER,1, 10 ) not null,
  fec_modificacion    DATE default SYSDATE not null,
  cod_ent_procesadora NUMBER(5) not null,
  fec_envio           DATE,
  adherente           VARCHAR2(2) default '00' not null,
  enviado             VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AH_TAR_DEB_CUENTAS
  is 'Cuentas relacionadas a las Tarjetas de Debito.';
comment on column IT.AH_TAR_DEB_CUENTAS.nro_cuenta
  is 'Nro. de Cuenta.';
comment on column IT.AH_TAR_DEB_CUENTAS.cod_persona
  is 'Codigo de la Persona.';
comment on column IT.AH_TAR_DEB_CUENTAS.nro_cta_relacionada
  is 'Nro. de Cuenta Relacionada.';
comment on column IT.AH_TAR_DEB_CUENTAS.usu_insercion
  is 'Usuario de insercion.';
comment on column IT.AH_TAR_DEB_CUENTAS.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.AH_TAR_DEB_CUENTAS.usu_modificacion
  is 'Usuario que modifico.';
comment on column IT.AH_TAR_DEB_CUENTAS.fec_modificacion
  is 'Fecha de la ultima modificacion.';
comment on column IT.AH_TAR_DEB_CUENTAS.cod_ent_procesadora
  is 'Entidad Procesadora de la Tarjeta.';
comment on column IT.AH_TAR_DEB_CUENTAS.fec_envio
  is 'Fecha de Envio a la procesadora.';
comment on column IT.AH_TAR_DEB_CUENTAS.adherente
  is 'Adherente.';
comment on column IT.AH_TAR_DEB_CUENTAS.enviado
  is 'Indicador de Enviado a la procesadora.';
alter table IT.AH_TAR_DEB_CUENTAS
  add constraint PK_AH_TAR_DEB_CUENTAS primary key (NRO_CUENTA, COD_PERSONA, NRO_CTA_RELACIONADA, ADHERENTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

