create table IT.CR_AGENDAS
(
  cod_agenda           NUMBER(10) not null,
  cod_persona          VARCHAR2(10) not null,
  cod_usu_encargado    VARCHAR2(10) not null,
  cod_actividad        NUMBER(3) not null,
  cod_estado           NUMBER(2) not null,
  cod_mot_actividad    VARCHAR2(5) not null,
  fec_actividad        DATE not null,
  can_reprogramaciones NUMBER(2) default 0,
  det_actividad        VARCHAR2(2000) not null,
  fec_realizacion      DATE,
  fec_vencimiento      DATE,
  revisado             VARCHAR2(1) default 'N' not null,
  det_respuesta        VARCHAR2(1000),
  automatico           VARCHAR2(1) default 'N',
  cod_campana          NUMBER(3),
  cod_age_anterior     NUMBER(10),
  nro_referencia       VARCHAR2(20),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cod_canal            NUMBER(3),
  nro_orden            NUMBER(10) default 1,
  cod_respuesta        NUMBER(2),
  dia_atraso           NUMBER(5) default 0,
  mto_mora             NUMBER(18,2) default 0,
  fec_ini_asignacion   DATE,
  mto_capital          NUMBER(18,2) default 0,
  tel_contacto         VARCHAR2(20),
  doc_adjunto          BLOB,
  orden                NUMBER(5)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_AGENDAS
  is 'Agenda.';
comment on column IT.CR_AGENDAS.cod_agenda
  is 'Numero de secuencia unico.';
comment on column IT.CR_AGENDAS.cod_persona
  is 'Codigo de persona.';
comment on column IT.CR_AGENDAS.cod_usu_encargado
  is 'Encargado de la actividad.';
comment on column IT.CR_AGENDAS.cod_actividad
  is 'Codigo de actividad.';
comment on column IT.CR_AGENDAS.cod_estado
  is 'Estado actual de la actividad.';
comment on column IT.CR_AGENDAS.cod_mot_actividad
  is 'Codigo de motivo de actividad.';
comment on column IT.CR_AGENDAS.fec_actividad
  is 'Fecha de actividad.';
comment on column IT.CR_AGENDAS.can_reprogramaciones
  is 'Numero de reprogramaciones. Por defecto 0.';
comment on column IT.CR_AGENDAS.det_actividad
  is 'Detalle de la actividad.';
comment on column IT.CR_AGENDAS.fec_realizacion
  is 'Fecha de realizacion. Contiene la hora.';
comment on column IT.CR_AGENDAS.fec_vencimiento
  is 'Fecha de vencimiento.';
comment on column IT.CR_AGENDAS.revisado
  is 'Indicador de revisado (S/N).';
comment on column IT.CR_AGENDAS.det_respuesta
  is 'Detalle de la Respuesta.';
comment on column IT.CR_AGENDAS.automatico
  is 'Indicador de si la actividad fue generada en forma automatica (s/N).';
comment on column IT.CR_AGENDAS.cod_campana
  is 'Codigo de campaña asociada.';
comment on column IT.CR_AGENDAS.cod_age_anterior
  is 'Numero de la actividad predecesora, en los casos de reprogramaciones o reasignaciones.';
comment on column IT.CR_AGENDAS.nro_referencia
  is 'Numero de Referencia Externa.';
comment on column IT.CR_AGENDAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_AGENDAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_AGENDAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_AGENDAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CR_AGENDAS.cod_canal
  is 'Codigo de Canal.';
comment on column IT.CR_AGENDAS.nro_orden
  is 'Nro de orden de las actividades generadas en forma automatica.';
comment on column IT.CR_AGENDAS.cod_respuesta
  is 'Codigo de respuesta.';
comment on column IT.CR_AGENDAS.dia_atraso
  is 'Maxima cantidad de dias de atraso.';
comment on column IT.CR_AGENDAS.mto_mora
  is 'Total de monto en mora.';
comment on column IT.CR_AGENDAS.fec_ini_asignacion
  is 'Fecha inicial de asignacion de la actividad.';
comment on column IT.CR_AGENDAS.mto_capital
  is 'Corresponde al monto total de las operaciones adeudadas por el cliente.';
