alter table IT.CR_AGENDAS
  add constraint PK_CR_AGENDAS primary key (COD_AGENDA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_AGENDAS
  add constraint FK_RAGEN_COD_ACTIVIDAD foreign key (COD_ACTIVIDAD)
  references IT.CR_AGE_ACTIVIDADES (COD_ACTIVIDAD);
alter table IT.CR_AGENDAS
  add constraint FK_RAGEN_COD_AGE_ANTERIOR foreign key (COD_AGE_ANTERIOR)
  references IT.CR_AGENDAS (COD_AGENDA);
alter table IT.CR_AGENDAS
  add constraint FK_RAGEN_COD_CAMPANA foreign key (COD_CAMPANA)
  references IT.CR_CAMPANAS (COD_CAMPANA);
alter table IT.CR_AGENDAS
  add constraint FK_RAGEN_COD_CANAL foreign key (COD_CANAL)
  references IT.GE_CANALES (COD_CANAL);
alter table IT.CR_AGENDAS
  add constraint FK_RAGEN_COD_MOT_ACTIVIDAD foreign key (COD_MOT_ACTIVIDAD)
  references IT.CR_AGE_MOT_ACTIVIDADES (COD_MOT_ACTIVIDAD);
alter table IT.CR_AGENDAS
  add constraint FK_RAGEN_COD_USU_ENCARGADO foreign key (COD_USU_ENCARGADO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.CR_AGENDAS
  add constraint AVCON_1080843837_AUTOM_001
  check (AUTOMATICO IN ('S', 'N'));
alter table IT.CR_AGENDAS
  add constraint AVCON_1080843837_REVIS_000
  check (REVISADO IN ('S', 'N'));
alter table IT.CR_AGENDAS
  add constraint AVCON_1118232349_COD_A_003
  check (COD_ACTIVIDAD BETWEEN 0 AND 999);
alter table IT.CR_AGENDAS
  add constraint AVCON_1118232349_COD_C_002
  check (COD_CAMPANA BETWEEN 0 AND 999);
alter table IT.CR_AGENDAS
  add constraint AVCON_1118232349_COD_C_003
  check (COD_CANAL BETWEEN 0 AND 999);
alter table IT.CR_AGENDAS
  add constraint AVCON_1118232349_COD_R_000
  check (COD_RESPUESTA BETWEEN 0 AND 999);

