create table IT.AH_DEL_TAR_DEBITOS_TMP
(
  nro_cuenta VARCHAR2(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AH_DEL_TAR_DEBITOS_TMP
  is 'Temporal para recibir cuentas a eliminar de ah_tar_debitos';
comment on column IT.AH_DEL_TAR_DEBITOS_TMP.nro_cuenta
  is 'Nro. Cuenta.';

