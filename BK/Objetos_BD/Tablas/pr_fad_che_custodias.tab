create table IT.PR_FAD_CHE_CUSTODIAS
(
  nro_solicitud      NUMBER(7) not null,
  nro_cuota          NUMBER(3) not null,
  cod_banco          NUMBER(3) not null,
  nro_cheque         NUMBER(15) not null,
  cta_libradora      VARCHAR2(20) not null,
  cod_moneda         VARCHAR2(3) not null,
  cod_ofi_camara     NUMBER(3),
  cod_oficina        NUMBER(3),
  estado             VARCHAR2(1) default 'C' not null,
  monto              NUMBER(18,2) default 0 not null,
  fec_emision        DATE not null,
  fec_vencimiento    DATE not null,
  fec_proceso        DATE,
  observacion        VARCHAR2(200),
  tip_servicio       VARCHAR2(1) default 'D' not null,
  nro_boleta         NUMBER(15),
  fec_deposito       DATE,
  mot_entrega        NUMBER(3),
  cod_cau_devolucion NUMBER(3),
  compensado         VARCHAR2(1),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  tip_afe_lim_cre    VARCHAR2(1) default 'D'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_FAD_CHE_CUSTODIAS
  is 'Se registran los datos de Cheques ingresados por la Fabrica de Dscto. de Cheques.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.nro_solicitud
  is 'Número de propuesta.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.nro_cuota
  is 'Numero de Cuota si es Prestamos.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.cod_banco
  is 'Codigo de Banco.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.nro_cheque
  is 'Numero de Cheque.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.cta_libradora
  is 'Cuenta Libradora.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.cod_moneda
  is 'Codigo de Moneda del Importe.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.cod_ofi_camara
  is 'Codigo de Oficina de Camara donde se realizo el Deposito.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.cod_oficina
  is 'Codigo de Oficina Origen.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.estado
  is 'Estado de la Solicitud. (I=Ingresado, V=Validado, E=Con Error, A=Aprobado, D=Descontado, C=Cancelado).';
comment on column IT.PR_FAD_CHE_CUSTODIAS.monto
  is 'Monto del Cheque.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.fec_emision
  is 'Fecha de Emision.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.fec_vencimiento
  is 'Fecha de Vencimiento del Cheque.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.fec_proceso
  is 'Fecha de Proceso.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.observacion
  is 'Observaciones.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.tip_servicio
  is 'Tipo de Servicio (D=Descuento de cheques, C=custodia de cheques).';
comment on column IT.PR_FAD_CHE_CUSTODIAS.nro_boleta
  is 'Numero de Boleta de Deposito.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.fec_deposito
  is 'Fecha en la que se debe Depositar el Cheque.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.mot_entrega
  is 'Motivo de Entrega del Cheque. Ver en Causales.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.cod_cau_devolucion
  is 'Codigo de Causa de Devolucion.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.compensado
  is 'Indica que el cheque fue compensado';
comment on column IT.PR_FAD_CHE_CUSTODIAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.PR_FAD_CHE_CUSTODIAS.tip_afe_lim_cre
  is 'Tipo de afectación a límite de crédito. D=Dscto de Cheques, P=Prestamos contra pagaré.';
create index IT.IN_FADCH_SOLICITUDES on IT.PR_FAD_CHE_CUSTODIAS (NRO_SOLICITUD)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_FAD_CHE_CUSTODIAS
  add constraint PK_GE_FAD_CHE_CUSTODIAS primary key (NRO_SOLICITUD, NRO_CUOTA, NRO_CHEQUE, COD_BANCO, CTA_LIBRADORA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 8M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_FAD_CHE_CUSTODIAS
  add constraint FK_FADUS_COD_BANCO foreign key (COD_BANCO)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.PR_FAD_CHE_CUSTODIAS
  add constraint FK_FADUS_COD_CAU_DEVOLUCION foreign key (COD_CAU_DEVOLUCION)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.PR_FAD_CHE_CUSTODIAS
  add constraint FK_FADUS_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_FAD_CHE_CUSTODIAS
  add constraint FK_FADUS_COD_OFI_CAMARA foreign key (COD_OFI_CAMARA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.PR_FAD_CHE_CUSTODIAS
  add constraint FK_FADUS_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.PR_FAD_CHE_CUSTODIAS
  add constraint FADON_1118276299_COD_B_001
  check (COD_BANCO BETWEEN 0 AND 999);
alter table IT.PR_FAD_CHE_CUSTODIAS
  add constraint FADON_1118276299_COD_O_002
  check (COD_OFI_CAMARA BETWEEN 0 AND 999);

