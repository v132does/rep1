create table IT.SB_ITEMS_DET
(
  nom_archivo       VARCHAR2(10) not null,
  fecha             DATE not null,
  nro_registro      NUMBER(6) not null,
  cod_persona       VARCHAR2(10) not null,
  tip_formulario    VARCHAR2(2) not null,
  tip_identificador VARCHAR2(3) not null,
  nro_identificador VARCHAR2(15) not null,
  cod_item          VARCHAR2(10) not null,
  cod_plazo         NUMBER(2) not null,
  cod_region        NUMBER(3) not null,
  cod_actividad     NUMBER(3) not null,
  cod_moneda        NUMBER(4) not null,
  mto_item          NUMBER(15) not null,
  mto_riesgo        NUMBER(15) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_ITEMS_DET
  is 'Detalle de Items.';
comment on column IT.SB_ITEMS_DET.nom_archivo
  is 'Nombre del archivo.';
comment on column IT.SB_ITEMS_DET.fecha
  is 'Fecha.';
comment on column IT.SB_ITEMS_DET.nro_registro
  is 'Nro. de registro.';
comment on column IT.SB_ITEMS_DET.cod_persona
  is 'Cliente.';
comment on column IT.SB_ITEMS_DET.tip_formulario
  is 'Tipo de formulario.';
comment on column IT.SB_ITEMS_DET.tip_identificador
  is 'Tipo identificador.';
comment on column IT.SB_ITEMS_DET.nro_identificador
  is 'Nro. identificador.';
comment on column IT.SB_ITEMS_DET.cod_item
  is 'Codigo de item.';
comment on column IT.SB_ITEMS_DET.cod_plazo
  is 'Codigo de plazo.';
comment on column IT.SB_ITEMS_DET.cod_region
  is 'Codigo de region.';
comment on column IT.SB_ITEMS_DET.cod_actividad
  is 'Codigo de actividad.';
comment on column IT.SB_ITEMS_DET.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.SB_ITEMS_DET.mto_item
  is 'Monto del item.';
comment on column IT.SB_ITEMS_DET.mto_riesgo
  is 'Monto de riesgo.';
comment on column IT.SB_ITEMS_DET.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.SB_ITEMS_DET.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.SB_ITEMS_DET.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.SB_ITEMS_DET.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_SIDET_COD_PERSONA on IT.SB_ITEMS_DET (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SB_ITEMS_DET
  add constraint SIDET_PK primary key (FECHA, NOM_ARCHIVO, NRO_REGISTRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

