create table IT.CC_CHE_REC_ERRORES
(
  nro_cuenta       VARCHAR2(15),
  nro_cheque       NUMBER(15),
  msj_error        VARCHAR2(100),
  importe          NUMBER(18,2) default 0,
  cod_banco        NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_moneda       VARCHAR2(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CHE_REC_ERRORES
  is 'Registro de errores en la carga de Cheques Recibidos.';
comment on column IT.CC_CHE_REC_ERRORES.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.CC_CHE_REC_ERRORES.nro_cheque
  is 'Numero de cheque.';
comment on column IT.CC_CHE_REC_ERRORES.msj_error
  is 'Mensaje de error.';
comment on column IT.CC_CHE_REC_ERRORES.importe
  is 'Importe.';
comment on column IT.CC_CHE_REC_ERRORES.cod_banco
  is 'Codigo de banco.';
comment on column IT.CC_CHE_REC_ERRORES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CHE_REC_ERRORES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CHE_REC_ERRORES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_REC_ERRORES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_REC_ERRORES.cod_moneda
  is 'Código Moneda del Archivo Importado';
create index IT.IN_CCRER_USU_INSERCION on IT.CC_CHE_REC_ERRORES (USU_INSERCION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHE_REC_ERRORES
  add constraint AVCON_1118352759_COD_B_000
  check (COD_BANCO BETWEEN 0 AND 999);

