-- Create table
create table IT.GE_CTA_BLO_CREDITOS_DET
(
  cod_blo_credito  NUMBER(5) not null,
  cod_transaccion  NUMBER(4) not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the columns 
comment on column IT.GE_CTA_BLO_CREDITOS_DET.cod_blo_credito
  is 'Código del bloqueo.';
comment on column IT.GE_CTA_BLO_CREDITOS_DET.cod_transaccion
  is 'Código de transacción bloqueado.';
comment on column IT.GE_CTA_BLO_CREDITOS_DET.cod_modulo
  is 'Código de módulo.';
comment on column IT.GE_CTA_BLO_CREDITOS_DET.cod_modalidad
  is 'Código de modalidad.';
comment on column IT.GE_CTA_BLO_CREDITOS_DET.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_CTA_BLO_CREDITOS_DET.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_CTA_BLO_CREDITOS_DET.usu_modificacion
  is 'Usuario que realizó la última modificación del registro.';
comment on column IT.GE_CTA_BLO_CREDITOS_DET.fec_modificacion
  is 'Fecha en que se realizó la última modificación d el registro.';
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.GE_CTA_BLO_CREDITOS_DET
  add constraint PK_GE_CTA_BLO_CREDITOS_DET primary key (COD_BLO_CREDITO, COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CTA_BLO_CREDITOS_DET
  add constraint FK_GCBCD_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
