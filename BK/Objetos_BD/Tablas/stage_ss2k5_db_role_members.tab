create global temporary table IT.STAGE_SS2K5_DB_ROLE_MEMBERS
(
  svrid_fk            NUMBER(38),
  dbid_gen_fk         NUMBER(38),
  member_principal_id NUMBER(38) not null,
  role_principal_id   NUMBER(38) not null
)
on commit preserve rows;
create index IT.S_SS2K5_D_R_M_DBID_GEN_FK on IT.STAGE_SS2K5_DB_ROLE_MEMBERS (DBID_GEN_FK);
create index IT.S_SS2K5_D_R_M_MEMBER_P_ID on IT.STAGE_SS2K5_DB_ROLE_MEMBERS (MEMBER_PRINCIPAL_ID);
create index IT.S_SS2K5_D_R_M_ROLE_PL_ID on IT.STAGE_SS2K5_DB_ROLE_MEMBERS (ROLE_PRINCIPAL_ID);

