create table IT.PR_SIMULACIONES
(
  nro_simulacion      NUMBER(7) not null,
  descripcion         VARCHAR2(35),
  cod_persona         VARCHAR2(10),
  cod_modulo          NUMBER(3) not null,
  cod_modalidad       NUMBER(3) not null,
  cod_moneda          VARCHAR2(3) not null,
  tip_monto           VARCHAR2(1) not null,
  monto               NUMBER(18,2) default 0 not null,
  tot_prestamo        NUMBER(18,2) default 0 not null,
  can_cuotas          NUMBER(6) not null,
  fec_pri_vencimiento DATE not null,
  val_tasa            NUMBER(20,4) not null,
  fec_inicio          DATE,
  tot_interes         NUMBER(18,2) default 0,
  tot_cargos          NUMBER(18,2) default 0,
  cotizacion          NUMBER(14,8) default 0,
  nro_cuenta          VARCHAR2(15),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  tip_interes         VARCHAR2(1),
  tip_amortizacion    VARCHAR2(1),
  per_vto_capital     NUMBER(5),
  per_vto_interes     NUMBER(5),
  cod_sub_modalidad   NUMBER(3) default 1 not null,
  tip_renovacion      VARCHAR2(1),
  cod_mon_edilicio    VARCHAR2(3),
  mto_edilicio        NUMBER(18,2) default 0,
  iva_desglose        VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_SIMULACIONES
  is 'Simulación de Préstamos.';
comment on column IT.PR_SIMULACIONES.nro_simulacion
  is 'Número de simulación.';
comment on column IT.PR_SIMULACIONES.descripcion
  is 'Descripción de la simulación.';
comment on column IT.PR_SIMULACIONES.cod_persona
  is 'Código de persona que solicita el préstamo.';
comment on column IT.PR_SIMULACIONES.cod_modulo
  is 'Código de módulo.';
comment on column IT.PR_SIMULACIONES.cod_modalidad
  is 'Código de modalidad.';
comment on column IT.PR_SIMULACIONES.cod_moneda
  is 'Código de moneda.';
comment on column IT.PR_SIMULACIONES.tip_monto
  is 'Tipo de Monto.';
comment on column IT.PR_SIMULACIONES.monto
  is 'Valor del monto del préstamo.';
comment on column IT.PR_SIMULACIONES.tot_prestamo
  is 'Valor total del préstamo.';
comment on column IT.PR_SIMULACIONES.can_cuotas
  is 'Cantidad de cuotas.';
comment on column IT.PR_SIMULACIONES.fec_pri_vencimiento
  is 'Fecha del primer vencimiento.';
comment on column IT.PR_SIMULACIONES.val_tasa
  is 'Tasa.';
comment on column IT.PR_SIMULACIONES.fec_inicio
  is 'Fecha de inicio del préstamo.';
comment on column IT.PR_SIMULACIONES.tot_interes
  is 'Total de intereses.';
comment on column IT.PR_SIMULACIONES.tot_cargos
  is 'Total de cargos.';
comment on column IT.PR_SIMULACIONES.cotizacion
  is 'Cotización.';
comment on column IT.PR_SIMULACIONES.nro_cuenta
  is 'Número de cuenta.';
comment on column IT.PR_SIMULACIONES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_SIMULACIONES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_SIMULACIONES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_SIMULACIONES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_SIMULACIONES.tip_interes
  is 'Tipo de interes A-adelantado o V-vencido.';
comment on column IT.PR_SIMULACIONES.tip_amortizacion
  is 'Metodo de amortizacion: P.rice C.onstante F.lexible.';
comment on column IT.PR_SIMULACIONES.per_vto_capital
  is 'Periodo de Vencimiento de capital.';
comment on column IT.PR_SIMULACIONES.per_vto_interes
  is 'Periodo de vencimiento de interes.';
comment on column IT.PR_SIMULACIONES.cod_sub_modalidad
  is 'Código de Sub-Modalidad.';
comment on column IT.PR_SIMULACIONES.tip_renovacion
  is 'Tipo de Renovación.';
comment on column IT.PR_SIMULACIONES.cod_mon_edilicio
  is 'Codigo de Moneda del Monto Edilicio.';
comment on column IT.PR_SIMULACIONES.mto_edilicio
  is 'Valor del Monto Edilicio declarado en la simulacion.';
comment on column IT.PR_SIMULACIONES.iva_desglose
  is 'Valor que permite cuotizar el IVA.';
create index IT.IN_PSIMU_COD_PERSONA on IT.PR_SIMULACIONES (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_PSIMU_NRO_CUENTA on IT.PR_SIMULACIONES (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_SIMULACIONES
  add constraint PK_PR_SIMULACIONES primary key (NRO_SIMULACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_SIMULACIONES
  add constraint FK_PSIMU_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.PR_SIMULACIONES
  add constraint FK_PSIMU_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_SIMULACIONES
  add constraint FK_PSIMU_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.PR_SIMULACIONES
  add constraint FK_PSIMU_COD_SUB_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD)
  references IT.GE_SUB_MODALIDADES (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD);
alter table IT.PR_SIMULACIONES
  add constraint AVCON_1085008648_COD_M_002
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.PR_SIMULACIONES
  add constraint AVCON_1085008648_COD_M_003
  check (COD_MODALIDAD BETWEEN 0 AND 999);

