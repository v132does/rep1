  storage
  (
    initial 3M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_COR_RUB_COD_RUBRO on IT.CB_COR_RUB_DET (COD_RUBRO)
  tablespace IT_IND
