create table IT.IG_UNI_NEG_METAS
(
  cod_unidad       NUMBER(3) not null,
  cod_concepto     NUMBER(3) not null,
  cod_sub_concepto NUMBER(4),
  cod_periodo      NUMBER(3) not null,
  por_meta         NUMBER(5,2) not null,
  mto_meta         NUMBER(18,2) not null,
  liquidado        VARCHAR2(1) default 'N' not null,
  logro            NUMBER(20,4),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.IG_UNI_NEG_METAS
  is 'Metas por Unidades de Negocios.';
comment on column IT.IG_UNI_NEG_METAS.cod_unidad
  is 'Codigo de unidad de negocios.';
comment on column IT.IG_UNI_NEG_METAS.cod_concepto
  is 'Codigo de concepto.';
comment on column IT.IG_UNI_NEG_METAS.cod_sub_concepto
  is 'Codigo del sub-concepto.';
comment on column IT.IG_UNI_NEG_METAS.cod_periodo
  is 'Periodo fijado para la meta.';
comment on column IT.IG_UNI_NEG_METAS.por_meta
  is 'Meta en Porcentaje que se debe alcanzar o no superar.';
comment on column IT.IG_UNI_NEG_METAS.mto_meta
  is 'Meta en Monto que se debe alcanzar o no superar en la moneda de consolidacion.';
comment on column IT.IG_UNI_NEG_METAS.liquidado
  is 'Indica si el periodo ya fue liquidado. S/N.';
comment on column IT.IG_UNI_NEG_METAS.logro
  is 'Logro alcanzado por la unidad de negocios.';
comment on column IT.IG_UNI_NEG_METAS.usu_insercion
  is 'Usuario que inserta.';
comment on column IT.IG_UNI_NEG_METAS.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.IG_UNI_NEG_METAS.usu_modificacion
  is 'Usuario que modifica.';
comment on column IT.IG_UNI_NEG_METAS.fec_modificacion
  is 'Fecha de modificacion.';
alter table IT.IG_UNI_NEG_METAS
  add constraint UK_IG_UNI_NEG_METAS unique (COD_UNIDAD, COD_CONCEPTO, COD_SUB_CONCEPTO, COD_PERIODO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.IG_UNI_NEG_METAS
  add constraint FK_IUNME_COD_CONCEPTO foreign key (COD_CONCEPTO, COD_SUB_CONCEPTO, COD_PERIODO)
  references IT.IG_ENT_METAS (COD_CONCEPTO, COD_SUB_CONCEPTO, COD_PERIODO);
alter table IT.IG_UNI_NEG_METAS
  add constraint FK_IUNME_COD_UNIDAD foreign key (COD_UNIDAD)
  references IT.IG_UNI_NEGOCIOS (COD_UNIDAD);
alter table IT.IG_UNI_NEG_METAS
  add constraint AVCON_1180382030_COD_C_004
  check (COD_CONCEPTO BETWEEN 0 AND 999);
alter table IT.IG_UNI_NEG_METAS
  add constraint AVCON_1180382030_COD_U_002
  check (COD_UNIDAD BETWEEN 0 AND 999);
alter table IT.IG_UNI_NEG_METAS
  add constraint AVCON_1180382030_LIQUI_001
  check (LIQUIDADO IN ('S', 'N'));

