-- Create table
create table IT.CR_PER_TIP_OPERACIONES_HIS
(
  cod_persona      VARCHAR2(10),
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  cod_moneda       VARCHAR2(3),
  fec_inicio       DATE,
  fec_vencimiento  DATE,
  mto_limite       NUMBER(18,2),
  novedad          VARCHAR2(1),
  usu_ver_perfil   VARCHAR2(10),
  fec_ver_perfil   DATE,
  est_ver_perfil   VARCHAR2(1),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_circuito     NUMBER(15),
  estado           VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 192K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.CR_PER_TIP_OPERACIONES_HIS
  is 'Tipos de Operaciones de la Persona.';
-- Add comments to the columns 
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.cod_persona
  is 'Codigo de la persona.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.cod_modulo
  is 'Modulo.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.cod_modalidad
  is 'Modalidad.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.cod_moneda
  is 'Moneda del Limite de Operacion del Cliente.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.fec_inicio
  is 'Fecha de Inicio del Limite de Operacion.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.fec_vencimiento
  is 'Fecha de Vencimiento del Limite de Operacion.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.mto_limite
  is 'Monto de Limite de Operacion del Cliente.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.novedad
  is 'Novedad en el registro, I:Inserción, E: Eliminación, M: Modificación';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.usu_ver_perfil
  is 'Usuario de la verificación del perfil en ese momento.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.fec_ver_perfil
  is 'Fecha de la verificación del perfil en ese momento.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.est_ver_perfil
  is 'Estado de la verificación del perfil en ese momento.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.cod_circuito
  is 'Código de WF generado.';
comment on column IT.CR_PER_TIP_OPERACIONES_HIS.estado
  is 'Estado verificación del monto límite.';
-- Create/Recreate indexes 
create index IT.IN_RPTOH_COD_PERSONA on IT.CR_PER_TIP_OPERACIONES_HIS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.CR_PER_TIP_OPERACIONES_HIS
  add constraint FK_RPTOH_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
