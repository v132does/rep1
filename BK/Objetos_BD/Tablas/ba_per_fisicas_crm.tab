create table IT.BA_PER_FISICAS_CRM
(
  cod_persona          VARCHAR2(10) not null,
  pri_nombre           VARCHAR2(30),
  pri_apellido         VARCHAR2(30),
  est_civil            VARCHAR2(1),
  cod_sexo             VARCHAR2(1),
  cod_niv_estudio      NUMBER(3),
  cod_tip_vivienda     NUMBER(3),
  cod_pai_nacionalidad NUMBER(3),
  seg_nombre           VARCHAR2(30),
  seg_apellido         VARCHAR2(30),
  fec_nacimiento       DATE,
  can_hijos            NUMBER(2),
  cod_profesion        NUMBER(3),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     TIMESTAMP(6) default current_timestamp not null,
  cod_titulo           NUMBER(3),
  can_personas         NUMBER(2),
  patrimonio           NUMBER(18,2),
  cod_actividad        NUMBER(3),
  tip_accion           VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_PER_FISICAS_CRM
  is 'Datos Personas Fisicas.';
comment on column IT.BA_PER_FISICAS_CRM.cod_persona
  is 'Codigo de la persona fisica.';
comment on column IT.BA_PER_FISICAS_CRM.pri_nombre
  is 'Primer nombre.';
comment on column IT.BA_PER_FISICAS_CRM.pri_apellido
  is 'Primer apellido.';
comment on column IT.BA_PER_FISICAS_CRM.est_civil
  is 'Estado civil.';
comment on column IT.BA_PER_FISICAS_CRM.cod_sexo
  is 'Codigo del sexo (M=Masculino / F=Femenino).';
comment on column IT.BA_PER_FISICAS_CRM.cod_niv_estudio
  is 'Nivel de estudios.';
comment on column IT.BA_PER_FISICAS_CRM.cod_tip_vivienda
  is 'Tipo de vivienda.';
comment on column IT.BA_PER_FISICAS_CRM.cod_pai_nacionalidad
  is 'Codigo de nacionalidad.';
comment on column IT.BA_PER_FISICAS_CRM.seg_nombre
  is 'Segundo nombre.';
comment on column IT.BA_PER_FISICAS_CRM.seg_apellido
  is 'Segundo apellido.';
comment on column IT.BA_PER_FISICAS_CRM.fec_nacimiento
  is 'Fecha de nacimiento.';
comment on column IT.BA_PER_FISICAS_CRM.can_hijos
  is 'Numero de hijos.';
comment on column IT.BA_PER_FISICAS_CRM.cod_profesion
  is 'Codigo de profesion.';
comment on column IT.BA_PER_FISICAS_CRM.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_PER_FISICAS_CRM.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_PER_FISICAS_CRM.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_PER_FISICAS_CRM.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.BA_PER_FISICAS_CRM.cod_titulo
  is 'Título Universitario Obtenido.';
comment on column IT.BA_PER_FISICAS_CRM.can_personas
  is 'Cantidad de Personas a Cargo';
comment on column IT.BA_PER_FISICAS_CRM.patrimonio
  is 'Si el valor comercial de propiedades + valor comercial de vehículos > 0, entonces Patrimonio > 0';
comment on column IT.BA_PER_FISICAS_CRM.cod_actividad
  is 'Actividad de la persona.';
comment on column IT.BA_PER_FISICAS_CRM.tip_accion
  is 'Indica el tipo de accion realizado con el registro en el Core.-';
create index IT.IN_CRM_PRI_APELLIDO on IT.BA_PER_FISICAS_CRM (PRI_APELLIDO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CRM_PRI_NOMBRE on IT.BA_PER_FISICAS_CRM (PRI_NOMBRE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );

