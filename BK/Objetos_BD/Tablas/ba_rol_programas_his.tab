create table IT.BA_ROL_PROGRAMAS_HIS
(
  fecha            DATE default SYSDATE not null,
  cod_programa     VARCHAR2(30) not null,
  cod_rol          VARCHAR2(20) not null,
  inserta          VARCHAR2(1) default 'N',
  actualiza        VARCHAR2(1) default 'N',
  elimina          VARCHAR2(1) default 'N',
  consulta         VARCHAR2(1) default 'N',
  imprime          VARCHAR2(1) default 'N',
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_ROL_PROGRAMAS_HIS
  is 'Histórico de los permisos por programas que posee cada rol.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.fecha
  is 'Fecha del registro';
comment on column IT.BA_ROL_PROGRAMAS_HIS.cod_programa
  is 'Codigo del Programa.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.cod_rol
  is 'Codigo del Rol.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.inserta
  is 'Indicador de Insercion.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.actualiza
  is 'Indicador de Actualizacion.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.elimina
  is 'Indicador de Eliminacion.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.consulta
  is 'Indicador de Consulta.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.imprime
  is 'Indica el permiso de Impresion.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.usu_insercion
  is 'Usuario que inserta.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.usu_modificacion
  is 'Usuario que modifica.';
comment on column IT.BA_ROL_PROGRAMAS_HIS.fec_modificacion
  is 'Fecha de modificacion.';
alter table IT.BA_ROL_PROGRAMAS_HIS
  add constraint PK_BA_ROL_PROGRAMAS_HIS primary key (COD_PROGRAMA, COD_ROL, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 896K
    next 1M
    minextents 1
    maxextents unlimited
  );

