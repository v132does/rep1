create index IT.IN_LOPEN_COD_MONEDA on IT.LC_OPE_PENDIENTES (COD_MONEDA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
