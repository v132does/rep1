-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.LC_OPE_PENDIENTES
  add constraint PK_LC_OPE_PENDIENTES primary key (NRO_OPERACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_OPE_PENDIENTES
  add constraint FK_LOPEN_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.LC_OPE_PENDIENTES
  add constraint FK_LOPEN_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.LC_OPE_PENDIENTES
  add constraint FK_LOPEN_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.LC_OPE_PENDIENTES
  add constraint FK_LOPEN_COD_TIP_OPE_BCP foreign key (COD_TIP_OPE_BCP)
  references IT.LC_TIP_OPE_BCP (COD_TIP_OPE_BCP);
alter table IT.LC_OPE_PENDIENTES
  add constraint FK_LOPEN_COD_TIP_OPERACION foreign key (COD_TIP_OPERACION)
  references IT.LC_TIP_OPERACIONES (COD_TIP_OPERACION);
alter table IT.LC_OPE_PENDIENTES
  add constraint FK_LOPEN_COD_TIP_REFERENCIA foreign key (COD_TIP_REFERENCIA)
  references IT.LC_TIP_REFERENCIAS (COD_TIP_REFERENCIA);
alter table IT.LC_OPE_PENDIENTES
  add constraint FK_LOPEN_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.LC_CTA_CAMBIOS (NRO_CUENTA);
-- Create/Recreate check constraints 
alter table IT.LC_OPE_PENDIENTES
  add constraint AVCON_1123594858_REFER_000
  check (REFERENCIADO IN ('S', 'N'));
-- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.LC_OPE_PENDIENTES to IT_TEMPORAL;
