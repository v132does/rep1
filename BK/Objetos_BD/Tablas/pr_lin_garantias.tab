create table IT.PR_LIN_GARANTIAS
(
  nro_garantia     NUMBER(7),
  nro_linea        NUMBER(7) not null,
  cod_garantia     NUMBER(3) not null,
  mto_aplicado     NUMBER(18,2) default 0 not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_LIN_GARANTIAS
  is 'Garantías por Líneas de Crédito.';
comment on column IT.PR_LIN_GARANTIAS.nro_garantia
  is 'Número de garantía.';
comment on column IT.PR_LIN_GARANTIAS.nro_linea
  is 'Número de línea.';
comment on column IT.PR_LIN_GARANTIAS.cod_garantia
  is 'Código de garantía.';
comment on column IT.PR_LIN_GARANTIAS.mto_aplicado
  is 'Monto aplicado.';
comment on column IT.PR_LIN_GARANTIAS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_LIN_GARANTIAS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_LIN_GARANTIAS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_LIN_GARANTIAS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.PR_LIN_GARANTIAS
  add constraint UK_PR_LIN_GARANTIAS unique (NRO_LINEA, COD_GARANTIA, NRO_GARANTIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_LIN_GARANTIAS
  add constraint FK_PLIGA_COD_GARANTIA foreign key (COD_GARANTIA)
  references IT.PR_GAR_TIPOS (COD_GARANTIA);
alter table IT.PR_LIN_GARANTIAS
  add constraint FK_PLIGA_NRO_GARANTIA foreign key (NRO_GARANTIA)
  references IT.PR_GARANTIAS (NRO_GARANTIA);
alter table IT.PR_LIN_GARANTIAS
  add constraint FK_PLIGA_NRO_LINEA foreign key (NRO_LINEA)
  references IT.PR_LINEAS (NRO_LINEA);

