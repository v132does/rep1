create table IT.LC_CON_CAMBIOS
(
  nro_contrato       NUMBER(15) not null,
  tipo               VARCHAR2(1),
  cod_mon_compra     VARCHAR2(3),
  cot_compra         NUMBER(14,8),
  mto_compra         NUMBER(18,2),
  cod_mon_venta      VARCHAR2(3),
  cot_venta          NUMBER(14,8),
  mto_venta          NUMBER(18,2),
  paridad            NUMBER(10,4),
  nro_cta_debito     VARCHAR2(15),
  nro_cta_credito    VARCHAR2(15),
  estado             VARCHAR2(1) default 'P' not null,
  nro_referencia     NUMBER(10),
  cod_tip_referencia VARCHAR2(3),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.LC_CON_CAMBIOS.nro_contrato
  is 'Numero de Contrato.';
comment on column IT.LC_CON_CAMBIOS.tipo
  is 'Tipo de Operacion: (C)Compra, (V)Venta, (A)Arbitraje.';
comment on column IT.LC_CON_CAMBIOS.cod_mon_compra
  is 'Moneda de Compra.';
comment on column IT.LC_CON_CAMBIOS.cot_compra
  is 'Cotizacion de Compra.';
comment on column IT.LC_CON_CAMBIOS.mto_compra
  is 'Monto de Compra.';
comment on column IT.LC_CON_CAMBIOS.cod_mon_venta
  is 'Moneda de Venta.';
comment on column IT.LC_CON_CAMBIOS.cot_venta
  is 'Cotizacion de Venta.';
comment on column IT.LC_CON_CAMBIOS.mto_venta
  is 'Monto de Venta.';
comment on column IT.LC_CON_CAMBIOS.paridad
  is 'Paridad de Cotizacion.';
comment on column IT.LC_CON_CAMBIOS.nro_cta_debito
  is 'Cuenta de Debito.';
comment on column IT.LC_CON_CAMBIOS.nro_cta_credito
  is 'Cuenta de Credito.';
comment on column IT.LC_CON_CAMBIOS.estado
  is 'Estado: (P)Pendiente, (C)Confirmado, (A)Anulado.';
comment on column IT.LC_CON_CAMBIOS.nro_referencia
  is 'Número de referencia de la transferencia.';
comment on column IT.LC_CON_CAMBIOS.cod_tip_referencia
  is 'Código de referencia de la transferencia.';
comment on column IT.LC_CON_CAMBIOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.LC_CON_CAMBIOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.LC_CON_CAMBIOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.LC_CON_CAMBIOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.LC_CON_CAMBIOS
  add constraint PK_LC_CON_CAMBIOS primary key (NRO_CONTRATO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_CON_CAMBIOS
  add check (TIPO IN ('C', 'V', 'A'));
alter table IT.LC_CON_CAMBIOS
  add check (ESTADO IN ('P', 'C', 'A'));

