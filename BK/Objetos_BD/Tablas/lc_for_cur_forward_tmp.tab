create table IT.LC_FOR_CUR_FORWARD_TMP
(
  cod_moneda       VARCHAR2(3),
  ano              NUMBER(4),
  semana           NUMBER(2),
  fec_desde        DATE,
  fec_hasta        DATE,
  dia_plazo        NUMBER(6),
  val_cotizacion   NUMBER(14,8),
  cad_plazo        VARCHAR2(200),
  cad_cotizacion   VARCHAR2(200),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.LC_FOR_CUR_FORWARD_TMP.cod_moneda
  is 'Codigo de Moneda';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.ano
  is 'Año de los datos';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.semana
  is 'Semana de los datos';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.fec_desde
  is 'Fecha desde';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.fec_hasta
  is 'Fecha hasta';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.dia_plazo
  is 'Dias de Plazo';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.val_cotizacion
  is 'Valor de la cotizacion (Curva Forward)';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.cad_plazo
  is 'Cadena de texto de plazo usada en la importacion de datos';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.cad_cotizacion
  is 'Cadena de texto de cotizacion usada en la importacion de datos';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.usu_insercion
  is 'Usuario de Insercion';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.fec_insercion
  is 'Fecha de Insercion';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.usu_modificacion
  is 'Usuario de Modificacion';
comment on column IT.LC_FOR_CUR_FORWARD_TMP.fec_modificacion
  is 'Fecha de Modificacion';

