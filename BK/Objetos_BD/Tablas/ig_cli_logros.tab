create table IT.IG_CLI_LOGROS
(
  cod_persona       VARCHAR2(10) not null,
  cod_concepto      NUMBER(3) not null,
  cod_sub_concepto  NUMBER(4) not null,
  cod_plazo         NUMBER(3) default 1 not null,
  cod_periodo       NUMBER(3) not null,
  monto             NUMBER(18,2) default 0,
  valor             NUMBER(7,4),
  cod_oficina       NUMBER(3) not null,
  cod_unidad        NUMBER(3) not null,
  cod_usu_oficial   VARCHAR2(10),
  cod_gru_economico NUMBER(5),
  cat_riesgo        VARCHAR2(1),
  cantidad          NUMBER(5),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_moneda        VARCHAR2(3) not null,
  fecha             DATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.IG_CLI_LOGROS
  is 'Resumen de Logros por Cliente.';
comment on column IT.IG_CLI_LOGROS.cod_persona
  is 'Codigo de Cliente Principal.';
comment on column IT.IG_CLI_LOGROS.cod_concepto
  is 'Codigo de Concepto.';
comment on column IT.IG_CLI_LOGROS.cod_sub_concepto
  is 'Codigo de Sub-Concepto.';
comment on column IT.IG_CLI_LOGROS.cod_plazo
  is 'Codigo de Plazo.';
comment on column IT.IG_CLI_LOGROS.cod_periodo
  is 'Codigo del periodo.';
comment on column IT.IG_CLI_LOGROS.monto
  is 'Monto del logro en la moneda de consolidacion.';
comment on column IT.IG_CLI_LOGROS.valor
  is 'Valor expresado en Porcentaje.';
comment on column IT.IG_CLI_LOGROS.cod_oficina
  is 'Codigo de la Oficina.';
comment on column IT.IG_CLI_LOGROS.cod_unidad
  is 'Unidad de negocios en la que se encuentra el oficial.';
comment on column IT.IG_CLI_LOGROS.cod_usu_oficial
  is 'Codigo del oficial de cuentas.';
comment on column IT.IG_CLI_LOGROS.cod_gru_economico
  is 'Codigo de grupo economico.';
comment on column IT.IG_CLI_LOGROS.cat_riesgo
  is 'Categoria de Riesgo (1- Normal ; 2- Potencial; 3- Real ; 4-Alto Riesgo; 5-Irrecuperable).';
comment on column IT.IG_CLI_LOGROS.cantidad
  is 'Cantidad.';
comment on column IT.IG_CLI_LOGROS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.IG_CLI_LOGROS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.IG_CLI_LOGROS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.IG_CLI_LOGROS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.IG_CLI_LOGROS.cod_moneda
  is 'Moneda.';
comment on column IT.IG_CLI_LOGROS.fecha
  is 'Fecha del proceso.';
create index IT.IN_ICLOG_COD_CONCEPTO on IT.IG_CLI_LOGROS (COD_CONCEPTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_ICLOG_COD_PERIODO on IT.IG_CLI_LOGROS (COD_PERIODO, COD_USU_OFICIAL, COD_CONCEPTO, COD_SUB_CONCEPTO, COD_PLAZO, COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 4M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_ICLOG_FECHA on IT.IG_CLI_LOGROS (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_ICLOG_PERSONA on IT.IG_CLI_LOGROS (COD_PERSONA, FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.IG_CLI_LOGROS
  add constraint PK_IG_CLI_LOGROS primary key (FECHA, COD_PERSONA, COD_CONCEPTO, COD_SUB_CONCEPTO, COD_PLAZO, COD_PERIODO, COD_MONEDA, COD_UNIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 5M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.IG_CLI_LOGROS
  add constraint FK_ICLOG_COD_CONCEPTO foreign key (COD_CONCEPTO)
  references IT.IG_CONCEPTOS (COD_CONCEPTO);
alter table IT.IG_CLI_LOGROS
  add constraint FK_ICLOG_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.IG_CLI_LOGROS
  add constraint FK_ICLOG_COD_PERIODO foreign key (COD_PERIODO)
  references IT.IG_PARAMETROS (COD_PERIODO);
alter table IT.IG_CLI_LOGROS
  add constraint FK_ICLOG_COD_PERSONA foreign key (COD_PERSONA)
  references IT.GE_CLIENTES (COD_PERSONA);
alter table IT.IG_CLI_LOGROS
  add constraint FK_ICLOG_COD_PLAZO foreign key (COD_PLAZO)
  references IT.IG_PLAZOS (COD_PLAZO);
alter table IT.IG_CLI_LOGROS
  add constraint FK_ICLOG_COD_SUB_CONCEPTO foreign key (COD_CONCEPTO, COD_SUB_CONCEPTO)
  references IT.IG_SUB_CONCEPTOS (COD_CONCEPTO, COD_SUB_CONCEPTO);
alter table IT.IG_CLI_LOGROS
  add constraint FK_ICLOG_COD_UNIDAD foreign key (COD_UNIDAD)
  references IT.IG_UNI_NEGOCIOS (COD_UNIDAD);
alter table IT.IG_CLI_LOGROS
  add constraint FK_ICLOG_COD_USUARIO foreign key (COD_USU_OFICIAL)
  references IT.BA_USUARIOS (COD_USUARIO);

