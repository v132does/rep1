create table IT.GE_FTP_PARAMETROS
(
  tdb_usuario      VARCHAR2(10),
  tdb_clave        VARCHAR2(20),
  tdb_dir_local    VARCHAR2(60),
  tdb_nom_local    VARCHAR2(60),
  tdb_ip_remoto    VARCHAR2(60),
  tdb_dir_remoto   VARCHAR2(60),
  tdb_nom_remoto   VARCHAR2(60),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_FTP_PARAMETROS
  is 'Parametros para Transferencia de Tarjetas de debito.';
comment on column IT.GE_FTP_PARAMETROS.tdb_usuario
  is 'Usuario.';
comment on column IT.GE_FTP_PARAMETROS.tdb_clave
  is 'Clave.';
comment on column IT.GE_FTP_PARAMETROS.tdb_dir_local
  is 'Direccion del Archivo.';
comment on column IT.GE_FTP_PARAMETROS.tdb_nom_local
  is 'Nombre del Archivo.';
comment on column IT.GE_FTP_PARAMETROS.tdb_ip_remoto
  is 'Direccion IP en la Administradora.';
comment on column IT.GE_FTP_PARAMETROS.tdb_dir_remoto
  is 'Directorio en la Administradora.';
comment on column IT.GE_FTP_PARAMETROS.tdb_nom_remoto
  is 'Nombre del Archivo en la Administradora.';
comment on column IT.GE_FTP_PARAMETROS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_FTP_PARAMETROS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_FTP_PARAMETROS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_FTP_PARAMETROS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

