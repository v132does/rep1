create table IT.LOG_ATM_TMP
(
  mensaje       VARCHAR2(4000),
  respuesta     VARCHAR2(4000),
  usu_insercion VARCHAR2(10),
  fec_insercion DATE,
  error         VARCHAR2(1000),
  fec_inicio    DATE,
  procesado     VARCHAR2(1) default 'N'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

