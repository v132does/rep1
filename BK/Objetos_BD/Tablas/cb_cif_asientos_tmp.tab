create table IT.CB_CIF_ASIENTOS_TMP
(
  fecha            DATE not null,
  cod_oficina      NUMBER(3) not null,
  nro_asiento      NUMBER(6) not null,
  nro_linea        NUMBER(9) not null,
  cod_rubro        VARCHAR2(15) not null,
  tip_movimiento   VARCHAR2(1) not null,
  mto_mon_rubro    NUMBER(18,2),
  mto_mon_local    NUMBER(18,2),
  descripcion      VARCHAR2(100),
  referencia       VARCHAR2(11),
  protegido        VARCHAR2(1),
  actualizado      VARCHAR2(1),
  val_cotizacion   NUMBER(14,8),
  distribuido      VARCHAR2(1),
  ref_movimiento   NUMBER(7),
  usu_insercion    VARCHAR2(10) not null,
  fec_insercion    DATE not null,
  usu_modificacion VARCHAR2(10) not null,
  fec_modificacion DATE not null,
  fec_valor        DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CIF_ASI_FEC on IT.CB_CIF_ASIENTOS_TMP (FECHA)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CIF_ASI_FEC_REF on IT.CB_CIF_ASIENTOS_TMP (FECHA, REF_MOVIMIENTO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CIF_ASI_REF_MOV on IT.CB_CIF_ASIENTOS_TMP (REF_MOVIMIENTO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

