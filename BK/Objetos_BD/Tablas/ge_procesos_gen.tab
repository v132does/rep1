create table IT.GE_PROCESOS_GEN
(
  cod_proceso      NUMBER(3) not null,
  nro_orden        NUMBER(3) not null,
  nom_archivo      VARCHAR2(20) not null,
  det_sql          LONG not null,
  con_cabecera     VARCHAR2(1) default 'S' not null,
  sep_campos       VARCHAR2(1) default ',',
  sep_texto        VARCHAR2(1) default '"',
  var_sustitucion  VARCHAR2(1000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PROCESOS_GEN
  is 'Datos Adicionales para la Generacion de ASCII.';
comment on column IT.GE_PROCESOS_GEN.cod_proceso
  is 'Codigo del proceso padre.';
comment on column IT.GE_PROCESOS_GEN.nro_orden
  is 'Nro de orden del reporte en el proceso.';
comment on column IT.GE_PROCESOS_GEN.nom_archivo
  is 'Nombre del archivo a generar.';
comment on column IT.GE_PROCESOS_GEN.det_sql
  is 'Detalle del sql.';
comment on column IT.GE_PROCESOS_GEN.con_cabecera
  is 'Generar con cabecera (S/N).';
comment on column IT.GE_PROCESOS_GEN.sep_campos
  is 'Separador de Campos.';
comment on column IT.GE_PROCESOS_GEN.sep_texto
  is 'Separador de Texto.';
comment on column IT.GE_PROCESOS_GEN.var_sustitucion
  is 'Varibales de sustitucion. Formato: variable = sentencia sql;.';
comment on column IT.GE_PROCESOS_GEN.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_PROCESOS_GEN.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PROCESOS_GEN.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PROCESOS_GEN.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_PROCESOS_GEN
  add constraint PK_GE_PROCESOS_GEN primary key (COD_PROCESO, NRO_ORDEN)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PROCESOS_GEN
  add constraint FK_GPGEN_COD_PROCESO foreign key (COD_PROCESO, NRO_ORDEN)
  references IT.GE_PROCESOS_DET (COD_PROCESO, NRO_ORDEN);
alter table IT.GE_PROCESOS_GEN
  add constraint CK_GPGEN_CON_CABECERA
  check (con_cabecera in ('S','N'));

