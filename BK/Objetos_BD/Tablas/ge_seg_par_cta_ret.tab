create table IT.GE_SEG_PAR_CTA_RET
(
  cod_seg_cliente   NUMBER(3) not null,
  cod_moneda        VARCHAR2(3) not null,
  cod_modulo        NUMBER(3) not null,
  cod_modalidad     NUMBER(3) not null,
  cod_retencion     NUMBER(3) not null,
  can_dia_retencion NUMBER(3) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_sub_modalidad NUMBER(3) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SEG_PAR_CTA_RET
  is 'Parametros de Retenciones.';
comment on column IT.GE_SEG_PAR_CTA_RET.cod_seg_cliente
  is 'Numero de Cuenta.';
comment on column IT.GE_SEG_PAR_CTA_RET.cod_moneda
  is 'Codigo de Moneda.';
comment on column IT.GE_SEG_PAR_CTA_RET.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.GE_SEG_PAR_CTA_RET.cod_modalidad
  is 'Codigo de la modalidad.';
comment on column IT.GE_SEG_PAR_CTA_RET.cod_retencion
  is 'Codigo  de retencion personalizada.';
comment on column IT.GE_SEG_PAR_CTA_RET.can_dia_retencion
  is 'Dias de retencion personalizado.';
comment on column IT.GE_SEG_PAR_CTA_RET.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_SEG_PAR_CTA_RET.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_SEG_PAR_CTA_RET.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_SEG_PAR_CTA_RET.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_SEG_PAR_CTA_RET.cod_sub_modalidad
  is 'Código de Sub Modalidad';
alter table IT.GE_SEG_PAR_CTA_RET
  add constraint PK_GE_SEG_PAR_CTA_RET primary key (COD_RETENCION, COD_SEG_CLIENTE, COD_MODULO, COD_MODALIDAD, COD_MONEDA, COD_SUB_MODALIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SEG_PAR_CTA_RET
  add constraint FK_GSPCR_COD_RETENCION foreign key (COD_RETENCION)
  references IT.GE_RETENCIONES (COD_RETENCION);
alter table IT.GE_SEG_PAR_CTA_RET
  add constraint AVCON_1097167816_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_SEG_PAR_CTA_RET
  add constraint AVCON_1097167816_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_SEG_PAR_CTA_RET
  add constraint AVCON_1097167816_COD_R_000
  check (COD_RETENCION BETWEEN 0 AND 999);
alter table IT.GE_SEG_PAR_CTA_RET
  add constraint AVCON_1097167816_COD_S_000
  check (COD_SEG_CLIENTE BETWEEN 0 AND 999);

