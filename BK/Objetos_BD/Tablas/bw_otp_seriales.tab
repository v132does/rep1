create table IT.BW_OTP_SERIALES
(
  tipo                 VARCHAR2(1),
  nro_lote             VARCHAR2(10),
  nro_serial           VARCHAR2(20) not null,
  estado               VARCHAR2(1),
  cod_oficina          NUMBER(3),
  cod_ofi_origen       NUMBER(3),
  cod_causa            NUMBER(3),
  cod_persona          VARCHAR2(10),
  cod_per_vinculada    VARCHAR2(10),
  fec_est_otp          DATE,
  exportado            VARCHAR2(1),
  can_intentos         NUMBER(2),
  usu_asignacion       VARCHAR2(10),
  fec_asignacion       DATE,
  usu_impresion        VARCHAR2(10),
  fec_impresion        DATE,
  cod_ofi_impresion    NUMBER(3),
  usu_entrega          VARCHAR2(10),
  fec_entrega          DATE,
  cod_ofi_entrega      NUMBER(3),
  usu_activacion       VARCHAR2(10),
  fec_activacion       DATE,
  observacion          VARCHAR2(1000),
  est_anterior         VARCHAR2(1),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cod_est_solicitud    VARCHAR2(1),
  usu_adm_modificacion VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 10
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_OTP_SERIALES
  is 'Seriales OTP.';
comment on column IT.BW_OTP_SERIALES.tipo
  is 'Tipo de Token (Físico/Virtual).';
comment on column IT.BW_OTP_SERIALES.nro_lote
  is 'Lote de los dispositivos OTP.';
comment on column IT.BW_OTP_SERIALES.nro_serial
  is 'Número de serial correspondiente al dispositivo OTP.';
comment on column IT.BW_OTP_SERIALES.estado
  is 'Estado del dispositivo OTP (I/Inactivo ,D/Disponible, N/Nuevo, P/Impreso, E/Entregado, A/Activo, B/Bloqueado, X/Inutilizable).';
comment on column IT.BW_OTP_SERIALES.cod_oficina
  is 'Código de oficina.';
comment on column IT.BW_OTP_SERIALES.cod_ofi_origen
  is 'Código de oficina origen del dispositivo OTP.';
comment on column IT.BW_OTP_SERIALES.cod_causa
  is 'Motivo de Baja o Rechazo del dispositivo OTP.';
comment on column IT.BW_OTP_SERIALES.cod_persona
  is 'Código del Cliente al que fue asignado el dispositivo OTP.';
comment on column IT.BW_OTP_SERIALES.cod_per_vinculada
  is 'Código de la Persona a la que está vinculado el Cliente.';
comment on column IT.BW_OTP_SERIALES.fec_est_otp
  is 'Fecha de cambio de Estado del dispositivo OTP.';
comment on column IT.BW_OTP_SERIALES.exportado
  is 'Indica si el registro fue exportado al sistema Vasco. (S/SI, X/EN PROCESO, N/NO).';
comment on column IT.BW_OTP_SERIALES.can_intentos
  is 'Cantidad de intentos de accesos.';
comment on column IT.BW_OTP_SERIALES.usu_asignacion
  is 'Usuario que asignó el OTP.';
comment on column IT.BW_OTP_SERIALES.fec_asignacion
  is 'Fecha de asignación del OTP al cliente.';
comment on column IT.BW_OTP_SERIALES.usu_impresion
  is 'Usuario que realizó la impresión del acuse de recibo del dispositivo OTP.';
comment on column IT.BW_OTP_SERIALES.fec_impresion
  is 'Fecha de Impresión del acuse.';
comment on column IT.BW_OTP_SERIALES.cod_ofi_impresion
  is 'Oficina donde se realizó la impresión.';
comment on column IT.BW_OTP_SERIALES.usu_entrega
  is 'Usuario que realizó la entrega del dispositivo OTP.';
comment on column IT.BW_OTP_SERIALES.fec_entrega
  is 'Fecha de entrega del dispositivo OTP.';
comment on column IT.BW_OTP_SERIALES.cod_ofi_entrega
  is 'Oficina donde se entregó el dispositivo OTP.';
comment on column IT.BW_OTP_SERIALES.usu_activacion
  is 'Usuario que activó el dispositivo.';
comment on column IT.BW_OTP_SERIALES.fec_activacion
  is 'Fecha de Activación del dispositivo.';
comment on column IT.BW_OTP_SERIALES.observacion
  is 'Cualquier comentario referente al circuito del dispositivo.';
comment on column IT.BW_OTP_SERIALES.est_anterior
  is 'Estado anterior del dispositivo OTP (I/Inactivo ,D/Disponible, N/Nuevo, P/Impreso, E/Entregado, A/Activo, B/Bloqueado, X/Inutilizable).';
comment on column IT.BW_OTP_SERIALES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.BW_OTP_SERIALES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.BW_OTP_SERIALES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.BW_OTP_SERIALES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.BW_OTP_SERIALES.cod_est_solicitud
  is 'Estado de la solicitud para softoken';
alter table IT.BW_OTP_SERIALES
  add constraint PK_BW_OTP_SERIALES primary key (NRO_SERIAL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

