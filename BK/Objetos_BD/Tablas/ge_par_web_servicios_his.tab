create table IT.GE_PAR_WEB_SERVICIOS_HIS
(
  cod_envio         VARCHAR2(10) not null,
  fecha             DATE default SYSDATE,
  cod_servicio      VARCHAR2(10),
  estado            VARCHAR2(1) default 'P',
  dat_enviados      VARCHAR2(600),
  log_error         VARCHAR2(600),
  cod_programa      VARCHAR2(30),
  fec_procesamiento DATE,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  est_servicio      VARCHAR2(1),
  reg_pago          VARCHAR2(50)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAR_WEB_SERVICIOS_HIS
  is 'Parametros de servicios web calendarizados a enviar';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.cod_envio
  is 'Id del Envio';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.fecha
  is 'Fecha de ingreso';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.cod_servicio
  is 'Codigo identificador del servicio web';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.estado
  is 'Estado P-Pendiente, E-Enviado, R-Rechazado.';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.dat_enviados
  is 'Datos a enviar al servicio web';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.log_error
  is 'Log de Error ';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.cod_programa
  is 'Programa que inserta los datos en la tabla';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.fec_procesamiento
  is 'Fecha y hora de procesamiento';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAR_WEB_SERVICIOS_HIS.est_servicio
  is 'Estado de respuesta del servicio';

