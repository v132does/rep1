create table IT.CJ_VAL_TRANSITO
(
  nro_documento        NUMBER(15) not null,
  nro_caja             NUMBER(3) not null,
  cod_oficina          NUMBER(3),
  cod_moneda           VARCHAR2(3) not null,
  fecha                DATE not null,
  monto                NUMBER(18,2) default 0 not null,
  cod_ofi_destino      NUMBER(3),
  estado               VARCHAR2(1),
  nro_caj_proceso      NUMBER(3),
  cod_usu_proceso      VARCHAR2(10),
  fec_proceso          DATE,
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cod_usu_autorizacion VARCHAR2(10),
  fec_autorizacion     DATE,
  hora                 VARCHAR2(10),
  nro_caj_afecta       NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CJ_VAL_TRANSITO
  is 'Valores en Transito.';
comment on column IT.CJ_VAL_TRANSITO.nro_documento
  is 'Número de Documento.';
comment on column IT.CJ_VAL_TRANSITO.nro_caja
  is 'Número de Caja Origen.';
comment on column IT.CJ_VAL_TRANSITO.cod_oficina
  is 'Código de Oficina Origen.';
comment on column IT.CJ_VAL_TRANSITO.cod_moneda
  is 'Código de Moneda.';
comment on column IT.CJ_VAL_TRANSITO.fecha
  is 'Fecha.';
comment on column IT.CJ_VAL_TRANSITO.monto
  is 'Monto de Envío.';
comment on column IT.CJ_VAL_TRANSITO.cod_ofi_destino
  is 'Código de Oficina Destino.';
comment on column IT.CJ_VAL_TRANSITO.estado
  is 'Estado ( X Pendiente, E Enviado,  P Procesado).';
comment on column IT.CJ_VAL_TRANSITO.nro_caj_proceso
  is 'Número de Caja que recibe el Monto.';
comment on column IT.CJ_VAL_TRANSITO.cod_usu_proceso
  is 'Código de Usuario que recibe el Monto.';
comment on column IT.CJ_VAL_TRANSITO.fec_proceso
  is 'Fecha del Proceso.';
comment on column IT.CJ_VAL_TRANSITO.usu_insercion
  is 'Usuario que realizó la Inserción del Registro.';
comment on column IT.CJ_VAL_TRANSITO.fec_insercion
  is 'Fecha en que se Insertó el Registro.';
comment on column IT.CJ_VAL_TRANSITO.usu_modificacion
  is 'Usuario que realizó la última Modificación en el Registro.';
comment on column IT.CJ_VAL_TRANSITO.fec_modificacion
  is 'Fecha en que se realizó la última Modificación en el Registro.';
comment on column IT.CJ_VAL_TRANSITO.cod_usu_autorizacion
  is 'Código del Usuario que realizó la Autorización.';
comment on column IT.CJ_VAL_TRANSITO.fec_autorizacion
  is 'Fecha y Hora en que se realizó la Autorización.';
comment on column IT.CJ_VAL_TRANSITO.hora
  is 'Hora Movimiento de Envío.';
comment on column IT.CJ_VAL_TRANSITO.nro_caj_afecta
  is 'Número de Caja a la que debe afectar.';
alter table IT.CJ_VAL_TRANSITO
  add constraint PK_CJ_VAL_TRANSITO primary key (NRO_DOCUMENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

