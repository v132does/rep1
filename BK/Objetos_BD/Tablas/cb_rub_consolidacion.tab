create table IT.CB_RUB_CONSOLIDACION
(
  cod_consolidacion VARCHAR2(20) not null,
  descripcion       VARCHAR2(200)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_RUB_CONSOLIDACION
  add constraint PK_CB_CTA_CONSOLIDACION primary key (COD_CONSOLIDACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

