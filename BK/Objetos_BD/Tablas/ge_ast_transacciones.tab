create table IT.GE_AST_TRANSACCIONES
(
  cod_ast_transaccion NUMBER(8) not null,
  cod_transaccion     NUMBER(4),
  cod_modulo          NUMBER(3),
  cod_modalidad       NUMBER(3),
  descripcion         VARCHAR2(60),
  tipo                VARCHAR2(1),
  ind_monitoreo       VARCHAR2(1),
  cod_gru_transaccion VARCHAR2(10),
  usu_insercion       VARCHAR2(10),
  fec_insercion       DATE,
  usu_modificacion    VARCHAR2(10),
  fec_modificacion    DATE,
  fec_envio           DATE,
  cod_tra_padre       NUMBER(4),
  cod_mad_padre       NUMBER(3),
  cod_mod_padre       NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_AST_TRANSACCIONES
  is 'Tabla de equivalencia de las trancciones para ASSITS';
comment on column IT.GE_AST_TRANSACCIONES.cod_ast_transaccion
  is 'Codigo de la transaccion en el ASSIST';
comment on column IT.GE_AST_TRANSACCIONES.cod_transaccion
  is 'Codigo de transaccion.';
comment on column IT.GE_AST_TRANSACCIONES.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_AST_TRANSACCIONES.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_AST_TRANSACCIONES.descripcion
  is 'Nombre de la transaccion.';
comment on column IT.GE_AST_TRANSACCIONES.tipo
  is 'Tipo de transaccion. Define en que forma afecta en la operacion.';
comment on column IT.GE_AST_TRANSACCIONES.ind_monitoreo
  is 'Indicador que verifica si se realiza o no el monitoreo.';
comment on column IT.GE_AST_TRANSACCIONES.cod_gru_transaccion
  is 'Código de Grupo de Transacción.';
comment on column IT.GE_AST_TRANSACCIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_AST_TRANSACCIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_AST_TRANSACCIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_AST_TRANSACCIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_AST_TRANSACCIONES.fec_envio
  is 'Fecha de envio a ASSIST.';
