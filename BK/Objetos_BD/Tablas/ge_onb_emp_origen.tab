create table IT.GE_ONB_EMP_ORIGEN
(
  cod_origen       NUMBER not null,
  key              VARCHAR2(100) not null,
  origen           VARCHAR2(100) not null,
  usu_insercion    VARCHAR2(10) default substr(user,1,10),
  fec_insercion    DATE default sysdate,
  usu_modificacion VARCHAR2(10) default substr(user,1,10),
  fec_modificacion DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_ONB_EMP_ORIGEN.cod_origen
  is 'Código origen';
comment on column IT.GE_ONB_EMP_ORIGEN.key
  is 'Key';
comment on column IT.GE_ONB_EMP_ORIGEN.origen
  is 'Origen';
comment on column IT.GE_ONB_EMP_ORIGEN.usu_insercion
  is 'Usuario que realizó la inserción del registro';
comment on column IT.GE_ONB_EMP_ORIGEN.fec_insercion
  is 'Fecha en que se insertó el registro';
comment on column IT.GE_ONB_EMP_ORIGEN.usu_modificacion
  is 'Usuario que realizó la ultima modificación en el registro';
comment on column IT.GE_ONB_EMP_ORIGEN.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro';
alter table IT.GE_ONB_EMP_ORIGEN
  add constraint PK_COD_ORIGEN primary key (COD_ORIGEN)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

