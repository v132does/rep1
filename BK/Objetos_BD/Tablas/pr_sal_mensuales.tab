create index IT.IN_PSMEN_COD_MODALIDAD on IT.PR_SAL_MENSUALES (COD_MODALIDAD, COD_MODULO, COD_OFICINA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 384K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_SAL_MENSUALES
  add constraint PK_PR_SAL_MENSUALES primary key (NRO_CUENTA, ANO, MES)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
