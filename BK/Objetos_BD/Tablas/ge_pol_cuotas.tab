create table IT.GE_POL_CUOTAS
(
  codigo           NUMBER not null,
  nro_cuota        NUMBER not null,
  fec_vencimiento  DATE,
  monto            NUMBER(18,2),
  observacion      VARCHAR2(1000),
  estado           VARCHAR2(1),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_POL_CUOTAS
  is 'Tabla de Cuotas de Seguros';
comment on column IT.GE_POL_CUOTAS.codigo
  is 'Codigo identificador de registro. Igual al Numero de Solicitud en SEBAOT.';
comment on column IT.GE_POL_CUOTAS.nro_cuota
  is 'Nro de Cuota';
comment on column IT.GE_POL_CUOTAS.fec_vencimiento
  is 'Fecha de Vencimiento de la Cuota';
comment on column IT.GE_POL_CUOTAS.monto
  is 'Monto de la cuota';
comment on column IT.GE_POL_CUOTAS.observacion
  is 'Observacion';
comment on column IT.GE_POL_CUOTAS.estado
  is 'Estado de la cuota';
comment on column IT.GE_POL_CUOTAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_POL_CUOTAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_POL_CUOTAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_POL_CUOTAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_POL_CUOTAS
  add constraint PK_GE_POL_CUOTAS primary key (CODIGO, NRO_CUOTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

