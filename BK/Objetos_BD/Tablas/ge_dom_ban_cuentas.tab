create table IT.GE_DOM_BAN_CUENTAS
(
  nro_cuenta               VARCHAR2(15) not null,
  estado                   VARCHAR2(1) not null,
  cod_persona              VARCHAR2(10) not null,
  cod_per_pte_beneficiario VARCHAR2(10) not null,
  nro_cta_beneficiario     VARCHAR2(35) not null,
  fec_domiciliacion        DATE not null,
  cod_circuito             NUMBER(15),
  usu_insercion            VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion            DATE default SYSDATE not null,
  usu_modificacion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion         DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_DOM_BAN_CUENTAS.nro_cuenta
  is 'Nro. de Cuenta';
comment on column IT.GE_DOM_BAN_CUENTAS.estado
  is 'Estado del Alta de la Cuenta de la Domiciliacion';
comment on column IT.GE_DOM_BAN_CUENTAS.cod_persona
  is 'Codigo de Persona';
comment on column IT.GE_DOM_BAN_CUENTAS.cod_per_pte_beneficiario
  is 'Codigo de Persona Pte Beneficiario Destino (Banco o Ente)';
comment on column IT.GE_DOM_BAN_CUENTAS.nro_cta_beneficiario
  is 'Nro. de Cuenta Beneficiario Destino';
comment on column IT.GE_DOM_BAN_CUENTAS.fec_domiciliacion
  is 'Fecha de Domiciliacion';
comment on column IT.GE_DOM_BAN_CUENTAS.cod_circuito
  is 'Codigo de Circuito de WF';
comment on column IT.GE_DOM_BAN_CUENTAS.usu_insercion
  is 'Usuario de Insercion';
comment on column IT.GE_DOM_BAN_CUENTAS.fec_insercion
  is 'Fecha de Insercion';
comment on column IT.GE_DOM_BAN_CUENTAS.usu_modificacion
  is 'Usuario de Mpdificacion';
comment on column IT.GE_DOM_BAN_CUENTAS.fec_modificacion
  is 'Fecha de Modificacion';
alter table IT.GE_DOM_BAN_CUENTAS
  add constraint PK_GE_DOM_BAN_CUENTAS primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_DOM_BAN_CUENTAS
  add constraint FK_DOMBA_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

