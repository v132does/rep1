-- Add comments to the table 
comment on table IT.CB_ASIENTOS_DET_HIS
  is 'Detalle De Los Asientos Contables - Historico ** Se borra a medida que los asientos del a?o en curso se superpongan a los del a?o anterior **';
-- Add comments to the columns 
comment on column IT.CB_ASIENTOS_DET_HIS.fecha
  is 'Fecha del asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS.cod_oficina
  is 'Codigo de la oficina del asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS.nro_asiento
  is 'Numero de asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS.nro_linea
  is 'Numero de lmnea del asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS.cod_rubro
  is 'Codigo de la cuenta contable.';
comment on column IT.CB_ASIENTOS_DET_HIS.tip_movimiento
  is 'Tipo de movimiento: D=Debito C=Credito.';
comment on column IT.CB_ASIENTOS_DET_HIS.mto_mon_rubro
  is 'Importe del movimiento en moneda extranjera.';
comment on column IT.CB_ASIENTOS_DET_HIS.mto_mon_local
  is 'Importe del movimiento en moneda local.';
comment on column IT.CB_ASIENTOS_DET_HIS.descripcion
  is 'Descripcion del asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS.referencia
  is 'Referencia.';
comment on column IT.CB_ASIENTOS_DET_HIS.protegido
  is 'IND_PROTEGIDO? S=Registro IND_PROTEGIDO, no puede ser eliminado. N=Registro no IND_PROTEGIDO, puede ser eliminado.';
comment on column IT.CB_ASIENTOS_DET_HIS.actualizado
  is 'Registro actualizado en saldo de cuentas? S=Registro actualizado en saldo de cuentas N=Registro no actualizado en saldo de cuentas.';
comment on column IT.CB_ASIENTOS_DET_HIS.val_cotizacion
  is 'Valor de la tasa de cambio usada para generar asientos de cuentas en moneda extranjera.';
comment on column IT.CB_ASIENTOS_DET_HIS.distribuido
  is 'Tiene cuenta de distribucion: S=Tiene cuenta de distribucion. N=No tiene cuenta de distribucion.';
comment on column IT.CB_ASIENTOS_DET_HIS.ref_movimiento
  is 'Numero de Referencia.';
comment on column IT.CB_ASIENTOS_DET_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_ASIENTOS_DET_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_ASIENTOS_DET_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_ASIENTOS_DET_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CB_ASIENTOS_DET_HIS.fec_valor
  is 'Fecha valor del asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS.cod_area
  is 'Codigo del Area.';
comment on column IT.CB_ASIENTOS_DET_HIS.cod_persona
  is 'Codigo de Persona.';
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.CB_ASIENTOS_DET_HIS
  add constraint PK_CB_ASIENTOS_DET_HIS primary key (FECHA, COD_OFICINA, NRO_ASIENTO, NRO_LINEA)
  using index 
  local;
alter index IT.PK_CB_ASIENTOS_DET_HIS nologging;
alter table IT.CB_ASIENTOS_DET_HIS
  add constraint FK_BADHI_NRO_ASIENTO foreign key (FECHA, COD_OFICINA, NRO_ASIENTO)
  references IT.CB_ASIENTOS_HIS (FECHA, COD_OFICINA, NRO_ASIENTO)
  deferrable initially deferred;
-- Create/Recreate check constraints 
alter table IT.CB_ASIENTOS_DET_HIS
  add constraint AVCON_1082384743_ACTUA_001
  check (ACTUALIZADO IN ('S', 'N'));
alter table IT.CB_ASIENTOS_DET_HIS
  add constraint AVCON_1082384743_COD_O_003
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.CB_ASIENTOS_DET_HIS
  add constraint AVCON_1082384743_DISTR_000
  check (DISTRIBUIDO IN ('S', 'N'));
alter table IT.CB_ASIENTOS_DET_HIS
  add constraint AVCON_1082384743_PROTE_003
  check (PROTEGIDO IN ('S', 'N'));
alter table IT.CB_ASIENTOS_DET_HIS
  add constraint AVCON_1082384743_TIP_M_000
  check (TIP_MOVIMIENTO IN ('D', 'C'));
