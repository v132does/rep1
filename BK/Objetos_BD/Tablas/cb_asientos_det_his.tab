-- Create table
create table IT.CB_ASIENTOS_DET_HIS
(
  fecha            DATE not null,
  cod_oficina      NUMBER(3) not null,
  nro_asiento      NUMBER(6) not null,
  nro_linea        NUMBER(9) not null,
  cod_rubro        VARCHAR2(15) not null,
  tip_movimiento   VARCHAR2(1) not null,
  mto_mon_rubro    NUMBER(18,2) default 0,
  mto_mon_local    NUMBER(18,2) default 0,
  descripcion      VARCHAR2(60),
  referencia       VARCHAR2(11),
  protegido        VARCHAR2(1) default 'N',
  actualizado      VARCHAR2(1) default 'N',
  val_cotizacion   NUMBER(14,8) default 0,
  distribuido      VARCHAR2(1) default 'N',
  ref_movimiento   NUMBER(10),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  fec_valor        DATE,
  cod_area         NUMBER(3),
  cod_persona      VARCHAR2(10)
)
partition by range (FECHA)
(
  partition P2020 values less than (TO_DATE(' 2020-01-01 00:00:00', 'SYYYY-MM-DD HH24:MI:SS', 'NLS_CALENDAR=GREGORIAN'))
    tablespace IT_DATA
    pctfree 10
    initrans 1
    maxtrans 255
    storage
    (
      initial 64K
      next 1M
      minextents 1
      maxextents unlimited
