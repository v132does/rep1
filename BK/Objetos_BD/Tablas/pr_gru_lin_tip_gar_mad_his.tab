create table IT.PR_GRU_LIN_TIP_GAR_MAD_HIS
(
  nro_linea        NUMBER(7),
  cod_garantia     NUMBER(3),
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  mto_limite       NUMBER(18,2),
  mto_aplicado     NUMBER(18,2),
  usu_insercion    VARCHAR2(10),
  fec_insercion    DATE,
  usu_modificacion VARCHAR2(10),
  fec_modificacion DATE,
  nro_secuencia    NUMBER(18) not null
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_GRU_LIN_TIP_GAR_MAD_HIS
  is 'Detalle de aplicaciones de líneas por tipo de garantía - Histórico.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.nro_linea
  is 'Número de línea.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.cod_garantia
  is 'Código de Garantía.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.cod_modulo
  is 'Código de Módulo.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.cod_modalidad
  is 'Código de Modalidad.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.mto_limite
  is 'Monto limite.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.mto_aplicado
  is 'Monto Aplicado.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_GRU_LIN_TIP_GAR_MAD_HIS.nro_secuencia
  is 'Secuencia de inserción en el histórico de Límites Globales.';

