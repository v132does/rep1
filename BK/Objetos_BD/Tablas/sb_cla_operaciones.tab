  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.FK_SCOPE_COD_PERSONA_I on IT.SB_CLA_OPERACIONES (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.FK_SCOPE_COD_SEC_CREDITO_I on IT.SB_CLA_OPERACIONES (COD_SEC_CREDITO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SB_CLA_OPERACIONES
  add constraint PK_SB_CLA_OPERACIONES primary key (NRO_CUENTA, COD_PERSONA, COD_ESTADO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SB_CLA_OPERACIONES
  add constraint FK_SCOPE_COD_ESTADO foreign key (COD_MODULO, COD_MODALIDAD, COD_ESTADO)
  references IT.GE_EST_CUENTAS (COD_MODULO, COD_MODALIDAD, ESTADO);
alter table IT.SB_CLA_OPERACIONES
  add constraint FK_SCOPE_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.SB_CLA_OPERACIONES
  add constraint FK_SCOPE_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.SB_CLA_OPERACIONES
  add constraint FK_SCOPE_COD_PERSONA foreign key (COD_PERSONA)
  references IT.SB_CLIENTES (COD_PERSONA);
alter table IT.SB_CLA_OPERACIONES
  add constraint FK_SCOPE_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

