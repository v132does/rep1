create table IT.GE_INF_COB_BATCH_DET
(
  nro_proceso       NUMBER(20) not null,
  nro_transaccion   NUMBER(18) not null,
  nom_archivo       VARCHAR2(50),
  tip_registro      VARCHAR2(1),
  cod_emision       VARCHAR2(3),
  cod_sucursal      VARCHAR2(3),
  cod_caja          VARCHAR2(2),
  dig_ver_cod_barra VARCHAR2(1),
  monto             NUMBER(18,2),
  mto_facturador    NUMBER(18,2),
  fec_cobro         DATE,
  nro_documento     NUMBER(20),
  cod_cargo         NUMBER(1),
  nro_factura       VARCHAR2(10),
  cod_entidad       VARCHAR2(3),
  hor_referencia    VARCHAR2(8),
  dat_adicional     VARCHAR2(35),
  incluir           VARCHAR2(1),
  nro_cta_deb_batch VARCHAR2(20),
  hor_credito       VARCHAR2(8),
  ind_mov_comision  VARCHAR2(1),
  cod_tra_padre     NUMBER(4),
  liberado          VARCHAR2(1),
  fec_acreditacion  DATE,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_INF_COB_BATCH_DET
  is 'Detalle de Credito de Ope. Infonet Cobranzas en Batch';
comment on column IT.GE_INF_COB_BATCH_DET.nro_proceso
  is 'Nombre del Archivo.';
comment on column IT.GE_INF_COB_BATCH_DET.nro_transaccion
  is 'Numero transacción.';
comment on column IT.GE_INF_COB_BATCH_DET.nom_archivo
  is 'Nombre del Archivo.';
comment on column IT.GE_INF_COB_BATCH_DET.tip_registro
  is 'Tipo de Registro';
comment on column IT.GE_INF_COB_BATCH_DET.cod_emision
  is 'Codigo Emisión.';
comment on column IT.GE_INF_COB_BATCH_DET.cod_sucursal
  is 'Código de Sucursal';
comment on column IT.GE_INF_COB_BATCH_DET.cod_caja
  is 'Código de Caja.';
comment on column IT.GE_INF_COB_BATCH_DET.dig_ver_cod_barra
  is 'Dígito verificador de Código de Barra.';
comment on column IT.GE_INF_COB_BATCH_DET.monto
  is 'Monto Factura.';
comment on column IT.GE_INF_COB_BATCH_DET.mto_facturador
  is 'Monto Facturador.';
comment on column IT.GE_INF_COB_BATCH_DET.fec_cobro
  is 'Fecha de Cobro.';
comment on column IT.GE_INF_COB_BATCH_DET.nro_documento
  is 'Número de Documento.';
comment on column IT.GE_INF_COB_BATCH_DET.cod_cargo
  is 'Código de Cargo.';
comment on column IT.GE_INF_COB_BATCH_DET.nro_factura
  is 'Nro Factura.';
comment on column IT.GE_INF_COB_BATCH_DET.cod_entidad
  is 'Cod. de Entidad.';
comment on column IT.GE_INF_COB_BATCH_DET.hor_referencia
  is 'Hora Referencia.';
comment on column IT.GE_INF_COB_BATCH_DET.dat_adicional
  is 'Dato Adicional.';
comment on column IT.GE_INF_COB_BATCH_DET.incluir
  is 'Incluir S/N.';
comment on column IT.GE_INF_COB_BATCH_DET.nro_cta_deb_batch
  is 'Nro. Cuenta Debito en Batch';
comment on column IT.GE_INF_COB_BATCH_DET.hor_credito
  is 'Hora Credito.';
comment on column IT.GE_INF_COB_BATCH_DET.ind_mov_comision
  is 'Indicador de Movimiento de Comisión S/N.';
comment on column IT.GE_INF_COB_BATCH_DET.cod_tra_padre
  is 'Código de Transacción Padre.';
comment on column IT.GE_INF_COB_BATCH_DET.liberado
  is 'Liberarado S/N.';
comment on column IT.GE_INF_COB_BATCH_DET.fec_acreditacion
  is 'Fecha de Acreditación';
comment on column IT.GE_INF_COB_BATCH_DET.usu_insercion
  is 'Usuario de Inserción.';
comment on column IT.GE_INF_COB_BATCH_DET.fec_insercion
  is 'Fecha de Inserción.';
comment on column IT.GE_INF_COB_BATCH_DET.usu_modificacion
  is 'Usuario de Modificacion.';
comment on column IT.GE_INF_COB_BATCH_DET.fec_modificacion
  is 'Fecha de Modificacion.';
alter table IT.GE_INF_COB_BATCH_DET
  add constraint PK_GE_INF_COB_BATCH_DET primary key (NRO_PROCESO, NRO_TRANSACCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

