create table IT.LC_INF_MIGRACION_XML
(
  id_operacion        NUMBER(10) not null,
  nro_operacion       NUMBER(10) not null,
  tip_operacion       VARCHAR2(1),
  mercado             NUMBER(2),
  origen              VARCHAR2(12),
  operacion           VARCHAR2(6),
  fec_transaccion     DATE,
  hor_transaccion     VARCHAR2(8),
  fec_ini_contrato    DATE,
  fec_fin_contrato    DATE,
  tip_registro        VARCHAR2(5),
  tip_tasa            VARCHAR2(1),
  tas_interes         NUMBER(14,8),
  val_amortizacion    NUMBER(18,2),
  precio              NUMBER(14,8),
  monto               NUMBER(18,2),
  cod_moneda          VARCHAR2(3),
  cod_mon_contraparte VARCHAR2(3),
  tip_indentificacion VARCHAR2(1),
  id_contraparte      VARCHAR2(30),
  observacion         VARCHAR2(200),
  cumplimiento        VARCHAR2(12),
  sis_origen          VARCHAR2(1),
  ciudad              VARCHAR2(60),
  estado              VARCHAR2(1),
  liquidado           VARCHAR2(1),
  sal_ini_dia         NUMBER(18,2),
  usuario             VARCHAR2(10),
  tipo                VARCHAR2(60),
  sal_ini_for         NUMBER(18,2),
  nom_cliente         VARCHAR2(200),
  nro_cuenta          VARCHAR2(100),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.LC_INF_MIGRACION_XML
  is 'Registros de operaciones de cambios informados al sistema Datatec via importacion';
comment on column IT.LC_INF_MIGRACION_XML.id_operacion
  is 'Identificador autonumérico';
comment on column IT.LC_INF_MIGRACION_XML.nro_operacion
  is 'Nro.Operación a Enviar';
comment on column IT.LC_INF_MIGRACION_XML.tip_operacion
  is '“I” = ingreso de un registro nuevo; “A” = anulacion de un registro existente';
comment on column IT.LC_INF_MIGRACION_XML.mercado
  is 'Codigo del mercado correspondiente';
comment on column IT.LC_INF_MIGRACION_XML.origen
  is 'EMPRESA o PARTICULARES';
comment on column IT.LC_INF_MIGRACION_XML.operacion
  is 'COMPRA o VENTA';
comment on column IT.LC_INF_MIGRACION_XML.fec_transaccion
  is 'Fecha de la transaccion';
comment on column IT.LC_INF_MIGRACION_XML.hor_transaccion
  is 'Hora de la transaccion';
comment on column IT.LC_INF_MIGRACION_XML.fec_ini_contrato
  is 'Fecha de inicio de un contrato. Solo para mercados 87 (Forward)';
comment on column IT.LC_INF_MIGRACION_XML.fec_fin_contrato
  is 'Fecha de fin de un contrato. Solo para mercados 87 (Forward)';
comment on column IT.LC_INF_MIGRACION_XML.tip_registro
  is 'Tipo de operacion. Solo para mercados 47 (Arbitraje)';
comment on column IT.LC_INF_MIGRACION_XML.tip_tasa
  is '“C” = cheque o “E” = efectivo. Solo para mercado 45 (Dólar Efectivo). No requerido';
comment on column IT.LC_INF_MIGRACION_XML.tas_interes
  is 'Precio en Gs de la segunda moneda, es decir a la venta. Solo para mercados 47 (Arbitraje)';
comment on column IT.LC_INF_MIGRACION_XML.val_amortizacion
  is 'Monto correspondiente a la venta. Solo para mercados 47 (Arbitraje)';
comment on column IT.LC_INF_MIGRACION_XML.precio
  is 'Precio de la transaccion. Para los mercados 47 (Arbitraje) es el precio de compra';
comment on column IT.LC_INF_MIGRACION_XML.monto
  is 'Monto de la transaccion. Para los mercados 47 (Arbitraje) es el monto de compra';
comment on column IT.LC_INF_MIGRACION_XML.cod_moneda
  is 'Codigo de 3 letras correspondiente a la primera moneda del par de monedas';
comment on column IT.LC_INF_MIGRACION_XML.cod_mon_contraparte
  is 'Codigo de 3 letras correspondiente a la segunda moneda del par de monedas';
comment on column IT.LC_INF_MIGRACION_XML.tip_indentificacion
  is '“C” = Cedula; “R” = RUC; “P” = Pasaporte; “T” = Tarjeta de identidad';
comment on column IT.LC_INF_MIGRACION_XML.id_contraparte
  is 'Valores de la identificacion';
comment on column IT.LC_INF_MIGRACION_XML.observacion
  is 'Comentario opcional';
comment on column IT.LC_INF_MIGRACION_XML.cumplimiento
  is 'DELIVERY o NON-DELIVERY. Solo para mercado 87 (Dolár Forward)';
comment on column IT.LC_INF_MIGRACION_XML.sis_origen
  is '“X” debe procesarse el registro; “D” no debe procesarse';
comment on column IT.LC_INF_MIGRACION_XML.ciudad
  is 'Ciudad/sucursal desde donde se realizo la operacion';
comment on column IT.LC_INF_MIGRACION_XML.estado
  is '“I” = insertado o “E” = enviado';
comment on column IT.LC_INF_MIGRACION_XML.liquidado
  is 'Liquidado (S/N)';
comment on column IT.LC_INF_MIGRACION_XML.sal_ini_dia
  is 'Saldo Inicial del Día';
comment on column IT.LC_INF_MIGRACION_XML.tipo
  is 'Tipo Spot/ Forward';
comment on column IT.LC_INF_MIGRACION_XML.sal_ini_for
  is 'Saldo Inicial del Día Forward';
comment on column IT.LC_INF_MIGRACION_XML.nom_cliente
  is 'Nombre Cliente';
comment on column IT.LC_INF_MIGRACION_XML.nro_cuenta
  is 'Numero de Cuenta';
comment on column IT.LC_INF_MIGRACION_XML.usu_insercion
  is 'Usuario que Inserta el Registro';
comment on column IT.LC_INF_MIGRACION_XML.fec_insercion
  is 'Fecha de Insercion';
comment on column IT.LC_INF_MIGRACION_XML.usu_modificacion
  is 'Usuario que modifica el Registro';
comment on column IT.LC_INF_MIGRACION_XML.fec_modificacion
  is 'Fecha de Modificacion';
create index IT.IND_FEC_TRANSACC on IT.LC_INF_MIGRACION_XML (FEC_TRANSACCION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create unique index IT.IND_ID_OPE on IT.LC_INF_MIGRACION_XML (ID_OPERACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IND_NRO_FEC on IT.LC_INF_MIGRACION_XML (NRO_OPERACION, FEC_TRANSACCION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IND_NRO_OPERACIO on IT.LC_INF_MIGRACION_XML (NRO_OPERACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_INF_MIGRACION_XML
  add constraint PK_LC_INF_MIGRACION_XML primary key (ID_OPERACION, NRO_OPERACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

