create table IT.SB_ANA_LIQ_INF34
(
  moneda       CHAR(4),
  cuentas      VARCHAR2(15),
  plz_vista    NUMBER,
  men_180_dias NUMBER,
  men_365_dias NUMBER,
  men_3_anos   NUMBER,
  men_5_anos   NUMBER,
  men_10_anos  NUMBER,
  may_10_anos  NUMBER,
  monto        NUMBER,
  informe      VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

