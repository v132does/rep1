create table IT.AF_TIP_ARTICULOS
(
  cod_tip_articulo NUMBER(10) not null,
  descripcion      VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AF_TIP_ARTICULOS
  is 'Tipos de Articulos del Activo Fijo.';
comment on column IT.AF_TIP_ARTICULOS.cod_tip_articulo
  is 'Codigo del Tipo de Articulo';
comment on column IT.AF_TIP_ARTICULOS.descripcion
  is 'Descripcion del Tipo de Articulo.';
comment on column IT.AF_TIP_ARTICULOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.AF_TIP_ARTICULOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.AF_TIP_ARTICULOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.AF_TIP_ARTICULOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.AF_TIP_ARTICULOS
  add constraint PK_AF_TIP_ARTICULOS primary key (COD_TIP_ARTICULO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AF_TIP_ARTICULOS
  add constraint UK_FTART_DESCRIPCION unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AF_TIP_ARTICULOS
  add constraint AVCON_1191859992_COD_T_000
  check (COD_TIP_ARTICULO BETWEEN 0 AND 999999999);

