create global temporary table IT.STAGE_SYB12_SYSCOMMENTS
(
  svrid_fk    NUMBER,
  dbid_gen_fk NUMBER,
  id_gen_fk   NUMBER,
  id          NUMBER,
  db_number   NUMBER,
  colid       NUMBER,
  texttype    NUMBER,
  language    NUMBER,
  text        VARCHAR2(255 CHAR),
  colid2      NUMBER,
  status      NUMBER
)
on commit preserve rows;

