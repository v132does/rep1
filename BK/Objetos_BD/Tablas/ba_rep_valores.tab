create table IT.BA_REP_VALORES
(
  cod_programa     VARCHAR2(30) not null,
  nro_orden        NUMBER(3) not null,
  fecha            DATE not null,
  valor            NUMBER(18,2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 384K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_REP_VALORES
  is 'Saldos calculados por día para cada una de las líneas de detalle.';
comment on column IT.BA_REP_VALORES.cod_programa
  is 'Código de Programa.';
comment on column IT.BA_REP_VALORES.nro_orden
  is 'Nro. de Secuencia de aparición en el Reporte.';
comment on column IT.BA_REP_VALORES.fecha
  is 'Orden para la ejecución de las Sentencias.';
comment on column IT.BA_REP_VALORES.valor
  is 'Descripción de la Línea de Detalle a ser desplegada en el reporte.';
comment on column IT.BA_REP_VALORES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.BA_REP_VALORES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.BA_REP_VALORES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.BA_REP_VALORES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.BA_REP_VALORES
  add constraint PK_BA_REP_VALORES primary key (COD_PROGRAMA, NRO_ORDEN, FECHA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_REP_VALORES
  add constraint FK_BRVAL_COD_PROGRAMA foreign key (COD_PROGRAMA, NRO_ORDEN)
  references IT.BA_DEF_REPORTES (COD_PROGRAMA, NRO_ORDEN);

