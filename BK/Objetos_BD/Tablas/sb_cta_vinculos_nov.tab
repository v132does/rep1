create table IT.SB_CTA_VINCULOS_NOV
(
  fecha            DATE not null,
  hora             VARCHAR2(8),
  nro_cuenta       VARCHAR2(15),
  cod_persona      VARCHAR2(15),
  evento           VARCHAR2(1),
  relacion         VARCHAR2(1),
  cod_modulo       NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  nro_cuotas       NUMBER(3),
  nro_cheque       NUMBER(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_CTA_VINCULOS_NOV
  is 'Registra las actualizaciones de relaciones.';
comment on column IT.SB_CTA_VINCULOS_NOV.fecha
  is 'Fecha de eliminación.';
comment on column IT.SB_CTA_VINCULOS_NOV.hora
  is 'Hora del registro.';
comment on column IT.SB_CTA_VINCULOS_NOV.nro_cuenta
  is 'Nro. de Cuenta.';
comment on column IT.SB_CTA_VINCULOS_NOV.cod_persona
  is 'Código de Persona.';
comment on column IT.SB_CTA_VINCULOS_NOV.evento
  is 'V=Vinculación de la cuenta, D=Desvinculación de la cuenta.';
comment on column IT.SB_CTA_VINCULOS_NOV.relacion
  is 'Relación con la cuenta';
comment on column IT.SB_CTA_VINCULOS_NOV.cod_modulo
  is 'Código de Módulo.';
comment on column IT.SB_CTA_VINCULOS_NOV.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.SB_CTA_VINCULOS_NOV.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.SB_CTA_VINCULOS_NOV.usu_modificacion
  is 'Usuario que realizó la ultima modificación en el registro.';
comment on column IT.SB_CTA_VINCULOS_NOV.fec_modificacion
  is 'Fecha en que se realizó la ultima modificación en el registro.';

