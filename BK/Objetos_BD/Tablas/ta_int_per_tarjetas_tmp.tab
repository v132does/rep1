create table IT.TA_INT_PER_TARJETAS_TMP
(
  cod_entidad     NUMBER(3),
  nro_cuenta      NUMBER(11),
  cod_moneda      NUMBER(3),
  tip_tas_interes NUMBER(3),
  val_tasa        NUMBER(5,2),
  reservado       CHAR(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_INT_PER_TARJETAS_TMP
  is 'Tabla de Interes Personalizada';
comment on column IT.TA_INT_PER_TARJETAS_TMP.cod_entidad
  is 'Código de la Entidad.';
comment on column IT.TA_INT_PER_TARJETAS_TMP.nro_cuenta
  is 'Número de Cuenta.';
comment on column IT.TA_INT_PER_TARJETAS_TMP.cod_moneda
  is 'Código de la Moneda.';
comment on column IT.TA_INT_PER_TARJETAS_TMP.tip_tas_interes
  is 'Tipo de Tasa de Ineterés.';
comment on column IT.TA_INT_PER_TARJETAS_TMP.val_tasa
  is 'Valor de Tasa';
comment on column IT.TA_INT_PER_TARJETAS_TMP.reservado
  is 'Reservado.';
create index IT.IN_TINT_NRO_CUENTA on IT.TA_INT_PER_TARJETAS_TMP (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

