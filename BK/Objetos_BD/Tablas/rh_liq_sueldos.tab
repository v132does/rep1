alter table IT.RH_LIQ_SUELDOS
  add constraint FK_HLSUE_COD_CEN_COSTO foreign key (COD_CEN_COSTO)
  references IT.CB_CEN_COSTOS (COD_CEN_COSTO);
alter table IT.RH_LIQ_SUELDOS
  add constraint FK_HLSUE_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.RH_LIQ_SUELDOS
  add constraint FK_HLSUE_COD_PERSONA foreign key (COD_PERSONA)
  references IT.RH_EMPLEADOS (COD_PERSONA);
alter table IT.RH_LIQ_SUELDOS
  add constraint FK_HLSUE_COD_TIP_DESCUENTO foreign key (COD_TIP_DESCUENTO)
  references IT.RH_TIP_DESCUENTOS (COD_TIP_DESCUENTO);
alter table IT.RH_LIQ_SUELDOS
  add constraint FK_HLSUE_COD_TIP_INGRESO foreign key (COD_TIP_INGRESO)
  references IT.RH_TIP_INGRESOS (COD_TIP_INGRESO);
alter table IT.RH_LIQ_SUELDOS
  add constraint FK_HLSUE_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.RH_LIQ_SUELDOS
  add constraint FK_HLSUE_DES_NUMERO foreign key (DES_NUMERO, COD_PERSONA)
  references IT.RH_DESCUENTOS (NUMERO, COD_PERSONA);
alter table IT.RH_LIQ_SUELDOS
  add constraint FK_HLSUE_ING_NUMERO foreign key (COD_PERSONA, ING_NUMERO)
  references IT.RH_INGRESOS (COD_PERSONA, NUMERO);
alter table IT.RH_LIQ_SUELDOS
  add constraint FK_HLSUE_NRO_SOBRE foreign key (NRO_SOBRE, COD_PERSONA)
  references IT.RH_SOBRES (NRO_SOBRE, COD_PERSONA);
alter table IT.RH_LIQ_SUELDOS
  add constraint FK_HLSUE_VAC_FEC_DESDE foreign key (COD_PERSONA, VAC_FEC_DESDE)
  references IT.RH_VACACIONES (COD_PERSONA, FEC_DESDE);

