create table IT.BW_DMS_TARJETAS
(
  cod_persona      VARCHAR2(10) not null,
  card_id          NUMBER not null,
  fec_extracto     VARCHAR2(10) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_DMS_TARJETAS
  is 'Tabla que contiene los ids de cierres de extractos proveidos por el DMS';
comment on column IT.BW_DMS_TARJETAS.cod_persona
  is 'Codigo cliente.';
comment on column IT.BW_DMS_TARJETAS.card_id
  is 'Numero identificador extracto.';
comment on column IT.BW_DMS_TARJETAS.fec_extracto
  is 'Fecha cierre del extracto.';
comment on column IT.BW_DMS_TARJETAS.usu_insercion
  is 'Usuario que inserto el registro.';
comment on column IT.BW_DMS_TARJETAS.fec_insercion
  is 'Fecha que se inserto el registro.';
comment on column IT.BW_DMS_TARJETAS.usu_modificacion
  is 'Usuario que modifico el registro.';
comment on column IT.BW_DMS_TARJETAS.fec_modificacion
  is 'Fecha que se modifico el registro.';
alter table IT.BW_DMS_TARJETAS
  add constraint PK_BW_DMS_TARJETAS primary key (COD_PERSONA, CARD_ID, FEC_EXTRACTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

