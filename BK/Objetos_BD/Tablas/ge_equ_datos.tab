create table IT.GE_EQU_DATOS
(
  fecha            DATE not null,
  num_cliente      VARCHAR2(3),
  datos            CLOB,
  tip_persona      VARCHAR2(1) not null,
  nom_archivo      VARCHAR2(30) not null,
  tip_operacion    NUMBER not null,
  comentario       VARCHAR2(1000),
  tip_archivo      VARCHAR2(5),
  dat_base64       CLOB,
  tip_proceso      VARCHAR2(1) not null,
  estado           VARCHAR2(1) not null,
  error            VARCHAR2(4000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_EQU_DATOS
  is 'Tabla donde se generan los datos a enviar para nutrir la base de Equifax';
comment on column IT.GE_EQU_DATOS.fecha
  is 'Fecha en que es ejecutado el proceso.';
comment on column IT.GE_EQU_DATOS.num_cliente
  is 'Número de cliente asignado a BBVA.';
comment on column IT.GE_EQU_DATOS.datos
  is 'Los datos a enviar para el tipo de archivo.';
comment on column IT.GE_EQU_DATOS.tip_persona
  is 'Tipo de persona a enviar F-Fisica o J-Juridica.';
comment on column IT.GE_EQU_DATOS.nom_archivo
  is 'Nombre del archivo a enviar.';
comment on column IT.GE_EQU_DATOS.tip_operacion
  is 'Tipo de operacion enviado en el archivo  I-Inclusión o M-Modificación.';
comment on column IT.GE_EQU_DATOS.comentario
  is 'Observación alguna que deba ser tenido en cuenta al momento de procesar los datos.';
comment on column IT.GE_EQU_DATOS.tip_archivo
  is 'Tipo o Extensión del Archico a envíar.';
comment on column IT.GE_EQU_DATOS.dat_base64
  is 'Son los datos a enviar codificado en base64';
comment on column IT.GE_EQU_DATOS.tip_proceso
  is 'Tipo de Procesamiento de los datos M-Manual o A-Automático.';
comment on column IT.GE_EQU_DATOS.estado
  is 'Estado de los datos generados P-Pendiente, E-Con Error o N-Normal.';
comment on column IT.GE_EQU_DATOS.error
  is 'Descripción del error.';
alter table IT.GE_EQU_DATOS
  add primary key (FECHA, TIP_PERSONA, NOM_ARCHIVO, TIP_OPERACION, TIP_PROCESO, ESTADO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

