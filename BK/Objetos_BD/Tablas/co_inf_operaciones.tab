create table IT.CO_INF_OPERACIONES
(
  cod_inf_operacion NUMBER(2) not null,
  descripcion       VARCHAR2(40),
  usu_insercion     VARCHAR2(10) default substr( USER, 1, 10 ) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default substr( USER, 1, 10 ) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CO_INF_OPERACIONES
  is 'Operaciones utilizadas por Informconf.';
comment on column IT.CO_INF_OPERACIONES.cod_inf_operacion
  is 'Codigo de operacion de Informconf.';
comment on column IT.CO_INF_OPERACIONES.descripcion
  is 'Descripcion de la operacion.';
comment on column IT.CO_INF_OPERACIONES.usu_insercion
  is 'Usuario que inserto el registro.';
comment on column IT.CO_INF_OPERACIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CO_INF_OPERACIONES.usu_modificacion
  is 'Usuario que modifico el registro.';
comment on column IT.CO_INF_OPERACIONES.fec_modificacion
  is 'Fecha en que se modifico el registro.';
alter table IT.CO_INF_OPERACIONES
  add constraint PK_CO_INF_OPERACIONES primary key (COD_INF_OPERACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

