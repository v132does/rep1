create table IT.CC_CHE_REMITIDOS_RES_TMP
(
  fecha            DATE,
  cod_oficina      NUMBER(3),
  nro_caja         NUMBER(3),
  nro_lote         NUMBER(4),
  tip_dato         NUMBER(3),
  nro_referencia   VARCHAR2(15),
  nro_boleta       VARCHAR2(15),
  monto            NUMBER(18,2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_ofi_origen   NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CHE_REMITIDOS_RES_TMP
  is 'Resumen de los cheques remitidos temporales';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.fecha
  is 'Fecha.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.cod_oficina
  is 'Codigo de Oficina.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.nro_caja
  is 'Numero de Caja.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.nro_lote
  is 'Numero de Lote.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.tip_dato
  is 'Tipo de Dato.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.nro_referencia
  is 'Numero de Referencia.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.nro_boleta
  is 'Numero de boleta.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.monto
  is 'Monto Total.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_REMITIDOS_RES_TMP.cod_ofi_origen
  is 'Oficina Origen del Cheque';

