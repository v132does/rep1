create table IT.CB_GRU_ASIENTOS_DET
(
  cod_gru_asiento  NUMBER(5) not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  cod_transaccion  NUMBER(4) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_GRU_ASIENTOS_DET
  is 'Detalle de Grupos contables.';
comment on column IT.CB_GRU_ASIENTOS_DET.cod_gru_asiento
  is 'Codigo de grupo de Asiento.';
comment on column IT.CB_GRU_ASIENTOS_DET.cod_modulo
  is 'Codigo del modulo.';
comment on column IT.CB_GRU_ASIENTOS_DET.cod_modalidad
  is 'Codigo de la Modalidad.';
comment on column IT.CB_GRU_ASIENTOS_DET.cod_transaccion
  is 'Codigo de la Transaccion.';
comment on column IT.CB_GRU_ASIENTOS_DET.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_GRU_ASIENTOS_DET.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_GRU_ASIENTOS_DET.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_GRU_ASIENTOS_DET.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CB_GRU_ASIENTOS_DET
  add constraint PK_CB_GRU_ASIENTOS_DET primary key (COD_GRU_ASIENTO, COD_MODULO, COD_MODALIDAD, COD_TRANSACCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_GRU_ASIENTOS_DET
  add constraint FK_CGASD_COD_GRU_ASIENTO foreign key (COD_GRU_ASIENTO)
  references IT.CB_GRU_ASIENTOS (COD_GRU_ASIENTO);
alter table IT.CB_GRU_ASIENTOS_DET
  add constraint FK_CGASD_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);

