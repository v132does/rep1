create global temporary table IT.STAGE_SS2K5_IDENTITY_COLUMNS
(
  svrid_fk        NUMBER(38),
  dbid_gen_fk     NUMBER(38),
  object_id_gen   NUMBER(38),
  seed_value      NUMBER(38),
  increment_value NUMBER(38),
  last_value      NUMBER(38),
  object_id       NUMBER(38) not null,
  column_id       NUMBER(38) not null
)
on commit preserve rows;
create index IT.S_SS2K5_I_C_OBJECT_ID on IT.STAGE_SS2K5_IDENTITY_COLUMNS (OBJECT_ID);
create index IT.S_SS2K5_ITY_CS_DBID_GEN_FK on IT.STAGE_SS2K5_IDENTITY_COLUMNS (DBID_GEN_FK);

