create table IT.TA_ENV_DEBCRE_HIS
(
  cod_ent_procesadora NUMBER(5),
  nro_cuenta          VARCHAR2(15),
  nro_tarjeta         VARCHAR2(16),
  monto               NUMBER(18,2),
  fec_valor           DATE,
  fec_envio           DATE,
  hor_envio           VARCHAR2(8),
  concepto            VARCHAR2(35),
  cod_usuario         VARCHAR2(10),
  financia            VARCHAR2(1),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  cod_transaccion     NUMBER(4),
  cod_modulo          NUMBER(3),
  cod_modalidad       NUMBER(3),
  tip_saldo           VARCHAR2(3)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_ENV_DEBCRE_HIS
  is 'Envio de Debitos / Creditos (Historico).';
comment on column IT.TA_ENV_DEBCRE_HIS.cod_ent_procesadora
  is 'Codigo de la Procesadora.';
comment on column IT.TA_ENV_DEBCRE_HIS.nro_cuenta
  is 'Numero de Cuenta de la Tarjeta.';
comment on column IT.TA_ENV_DEBCRE_HIS.nro_tarjeta
  is 'Numero de Tarjeta de la Procesadora.';
comment on column IT.TA_ENV_DEBCRE_HIS.monto
  is 'Monto del Pago.';
comment on column IT.TA_ENV_DEBCRE_HIS.fec_valor
  is 'Fecha del Pago.';
comment on column IT.TA_ENV_DEBCRE_HIS.fec_envio
  is 'Fecha de envio del Pago.';
comment on column IT.TA_ENV_DEBCRE_HIS.hor_envio
  is 'Hora de envio del Pago.';
comment on column IT.TA_ENV_DEBCRE_HIS.concepto
  is 'Descripcion del Movimiento.';
comment on column IT.TA_ENV_DEBCRE_HIS.cod_usuario
  is 'Usuario.';
comment on column IT.TA_ENV_DEBCRE_HIS.financia
  is 'Financia. ';
comment on column IT.TA_ENV_DEBCRE_HIS.usu_insercion
  is 'Usuario de insercion.';
comment on column IT.TA_ENV_DEBCRE_HIS.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.TA_ENV_DEBCRE_HIS.usu_modificacion
  is 'Fecha de modificacion.';
comment on column IT.TA_ENV_DEBCRE_HIS.fec_modificacion
  is 'Usuario de modificacion.';
comment on column IT.TA_ENV_DEBCRE_HIS.cod_transaccion
  is 'Codigo de la Transaccion.';
comment on column IT.TA_ENV_DEBCRE_HIS.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.TA_ENV_DEBCRE_HIS.cod_modalidad
  is 'Codigo de la Modalidad.';
comment on column IT.TA_ENV_DEBCRE_HIS.tip_saldo
  is 'Tipo de Saldo.';
create index IT.IN_TEDHI_COD_ENT_PROCESADORA on IT.TA_ENV_DEBCRE_HIS (COD_ENT_PROCESADORA, FEC_ENVIO, HOR_ENVIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

