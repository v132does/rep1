create table IT.RH_TIP_INGRESOS
(
  cod_tip_ingreso   NUMBER(3) not null,
  cod_transaccion   NUMBER(4) not null,
  cod_modulo        NUMBER(3) not null,
  cod_modalidad     NUMBER(3) not null,
  descripcion       VARCHAR2(50) not null,
  ind_imponible     VARCHAR2(1) default 'N' not null,
  ind_acu_aguinaldo VARCHAR2(1) default 'N' not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_TIP_INGRESOS
  is 'Tipos de Ingresos.';
comment on column IT.RH_TIP_INGRESOS.cod_tip_ingreso
  is 'Tipo de Ingreso.';
comment on column IT.RH_TIP_INGRESOS.cod_transaccion
  is 'Codigo de la Transaccion.';
comment on column IT.RH_TIP_INGRESOS.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.RH_TIP_INGRESOS.cod_modalidad
  is 'Codigo de la Modalidad.';
comment on column IT.RH_TIP_INGRESOS.descripcion
  is 'Descripcion.';
comment on column IT.RH_TIP_INGRESOS.ind_imponible
  is 'Indica si el ingreso paga o no IPS.';
comment on column IT.RH_TIP_INGRESOS.ind_acu_aguinaldo
  is 'Indica si el ingreso acumula o no para el aguinaldo.';
comment on column IT.RH_TIP_INGRESOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_TIP_INGRESOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_TIP_INGRESOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_TIP_INGRESOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.RH_TIP_INGRESOS
  add constraint PK_RH_TIP_INGRESOS primary key (COD_TIP_INGRESO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_TIP_INGRESOS
  add constraint UK_HTING_DESCRIPCION unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_TIP_INGRESOS
  add constraint FK_HTING_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.RH_TIP_INGRESOS
  add constraint AVCON_1191539824_IND_A_000
  check (IND_ACU_AGUINALDO IN ('S', 'N'));
alter table IT.RH_TIP_INGRESOS
  add constraint AVCON_1191539824_IND_I_000
  check (IND_IMPONIBLE IN ('S', 'N'));

