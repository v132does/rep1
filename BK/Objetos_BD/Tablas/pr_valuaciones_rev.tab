create table IT.PR_VALUACIONES_REV
(
  nro_cuenta           VARCHAR2(15) not null,
  fecha                DATE not null,
  estado               VARCHAR2(1) not null,
  tipo                 VARCHAR2(1) not null,
  tip_interes          VARCHAR2(1) not null,
  tip_renovacion       VARCHAR2(1),
  tip_documento        VARCHAR2(1) not null,
  sal_capital          NUMBER(18,2) not null,
  sal_interes          NUMBER(18,2) not null,
  sal_int_adelantado   NUMBER(18,2),
  dev_no_cobrado       NUMBER(18,2) not null,
  tot_gar_computables  NUMBER(18,2),
  tot_prevision        NUMBER(18,2),
  cat_automatica       NUMBER(3,2) not null,
  cotizacion           NUMBER(14,8) not null,
  tot_val_capital      NUMBER(18,2) not null,
  tot_val_interes      NUMBER(18,2) not null,
  tot_val_int_ade      NUMBER(18,2) not null,
  tot_val_devengado    NUMBER(18,2) not null,
  tot_val_garantia     NUMBER(18,2) not null,
  tot_val_prevision    NUMBER(18,2) not null,
  usu_insercion        VARCHAR2(10) not null,
  fec_insercion        DATE not null,
  usu_modificacion     VARCHAR2(10) not null,
  fec_modificacion     DATE not null,
  dev_suspenso         NUMBER(18,2),
  tot_val_suspenso     NUMBER(18,2) not null,
  cot_anterior         NUMBER(14,8),
  val_int_devengar     NUMBER(18,2),
  tot_val_int_devengar NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_VALUACIONES_REV
  is 'Valuaciones.';
comment on column IT.PR_VALUACIONES_REV.nro_cuenta
  is 'Nro. de cuenta.';
comment on column IT.PR_VALUACIONES_REV.fecha
  is 'Fecha.';
comment on column IT.PR_VALUACIONES_REV.estado
  is 'Estado.';
comment on column IT.PR_VALUACIONES_REV.tipo
  is 'Tipo.';
comment on column IT.PR_VALUACIONES_REV.tip_interes
  is 'Tipo de interes.';
comment on column IT.PR_VALUACIONES_REV.tip_renovacion
  is 'Tipo de renovacion.';
comment on column IT.PR_VALUACIONES_REV.tip_documento
  is 'Tipo de documento.';
comment on column IT.PR_VALUACIONES_REV.sal_capital
  is 'Saldo de capital.';
comment on column IT.PR_VALUACIONES_REV.sal_interes
  is 'Saldo de interes.';
comment on column IT.PR_VALUACIONES_REV.sal_int_adelantado
  is 'Saldo de int. documentado.';
comment on column IT.PR_VALUACIONES_REV.dev_no_cobrado
  is 'Devengado no cobrado.';
comment on column IT.PR_VALUACIONES_REV.tot_gar_computables
  is 'Total de garantias computables.';
comment on column IT.PR_VALUACIONES_REV.tot_prevision
  is 'Total de prevision.';
comment on column IT.PR_VALUACIONES_REV.cat_automatica
  is 'Categoria automatica.';
comment on column IT.PR_VALUACIONES_REV.cotizacion
  is 'Cotizacion.';
comment on column IT.PR_VALUACIONES_REV.tot_val_capital
  is 'Total valuado de capital.';
comment on column IT.PR_VALUACIONES_REV.tot_val_interes
  is 'Total valuado de interes.';
comment on column IT.PR_VALUACIONES_REV.tot_val_int_ade
  is ' Total valuado de int. adelantado.';
comment on column IT.PR_VALUACIONES_REV.tot_val_devengado
  is 'Total valuado de devengado.';
comment on column IT.PR_VALUACIONES_REV.tot_val_garantia
  is 'Total valuado de garantia.';
comment on column IT.PR_VALUACIONES_REV.tot_val_prevision
  is 'Total valuado de prevision.';
comment on column IT.PR_VALUACIONES_REV.usu_insercion
  is 'Usuario de insercion.';
comment on column IT.PR_VALUACIONES_REV.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.PR_VALUACIONES_REV.usu_modificacion
  is 'Usuario de modificacion.';
comment on column IT.PR_VALUACIONES_REV.fec_modificacion
  is 'Fecha de modificacion.';
comment on column IT.PR_VALUACIONES_REV.dev_suspenso
  is 'Total valuado de dev. en suspenso.';
comment on column IT.PR_VALUACIONES_REV.tot_val_suspenso
  is 'Total valuado de suspenso.';
comment on column IT.PR_VALUACIONES_REV.cot_anterior
  is 'Cotizacion anterior.';
comment on column IT.PR_VALUACIONES_REV.val_int_devengar
  is 'Interes a devengar.';
comment on column IT.PR_VALUACIONES_REV.tot_val_int_devengar
  is 'Total valuado de interes a devengar.';
create index IT.IN_PR_VALUACIONES_REV on IT.PR_VALUACIONES_REV (NRO_CUENTA, FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );

