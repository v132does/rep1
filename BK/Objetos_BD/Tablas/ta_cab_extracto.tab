create index IT.IN_TCABEXT_NRO_CUENTA on IT.TA_CAB_EXTRACTO (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_CAB_EXTRACTO
  add constraint PK_TA_CAB_EXTRACTO primary key (FEC_CIERRE, NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

