create table IT.TA_CAB_EXTRACTO
(
  fec_cierre                  DATE not null,
  nro_cuenta                  NUMBER(11) not null,
  cod_moneda                  NUMBER(3),
  nom_cuenta                  VARCHAR2(42),
  cod_entidad                 NUMBER(3),
  afinidad                    NUMBER(6),
  marca                       VARCHAR2(3),
  pro_marca                   VARCHAR2(3),
  tip_cuenta                  VARCHAR2(15),
  cod_emp_adherida            NUMBER(5),
  nom_emp_adherida            VARCHAR2(26),
  cod_persona                 NUMBER(7),
  tip_persona                 VARCHAR2(15),
  nom_per_fisica              VARCHAR2(20),
  ape_per_fisica              VARCHAR2(20),
  tip_doc_persona             VARCHAR2(3),
  nro_doc_persona             VARCHAR2(16),
  tip_cli_persona             VARCHAR2(15),
  ruc_extracto                VARCHAR2(11),
  raz_social                  VARCHAR2(30),
  ruc_per_juridica            VARCHAR2(11),
  dir_1                       VARCHAR2(50),
  dir_2                       VARCHAR2(50),
  dir_3                       VARCHAR2(50),
  cod_pais                    NUMBER(3),
  cod_departamento            NUMBER(3),
  cod_ciudad                  NUMBER(6),
  nom_ciudad                  VARCHAR2(40),
  cod_zona                    VARCHAR2(10),
  nom_zon_entidad             VARCHAR2(40),
  nro_telefono                VARCHAR2(15),
  nro_celular                 VARCHAR2(15),
  email                       VARCHAR2(60),
  cod_suc_entidad             NUMBER(4),
  nom_suc_entidad             VARCHAR2(40),
  cod_ofi_cuenta              NUMBER(7),
  nom_ofi_cuenta              VARCHAR2(42),
  cta_vip                     VARCHAR2(2),
  ret_extracto                VARCHAR2(2),
  mot_no_lis_extracto         NUMBER(3),
  sec_sep_extracto            NUMBER(6),
  tip_cierre                  VARCHAR2(2),
  cal_bcp                     VARCHAR2(2),
  cod_cliente                 VARCHAR2(15),
  sit_cuenta                  VARCHAR2(15),
  dia_mora                    NUMBER(5),
  car_suspendido              VARCHAR2(2),
  tip_doc_cuenta              VARCHAR2(3),
  nro_doc_cuenta              VARCHAR2(16),
  ruc                         VARCHAR2(11),
  mod_pago                    VARCHAR2(1),
  des_mod_pago                VARCHAR2(30),
  tip_cta_bancaria            VARCHAR2(1),
  des_cta_bancaria            VARCHAR2(30),
  cta_bancaria                NUMBER(15),
  tip_pago                    VARCHAR2(1),
  cgf_aplicar                 VARCHAR2(1),
  des_cgf_aplicar             VARCHAR2(30),
  cgf_apl_dia_mora            VARCHAR2(1),
  des_cgf_apl_dia_mora        VARCHAR2(30),
  ttf_aplicar                 VARCHAR2(1),
  per_ttis                    VARCHAR2(2),
  per_pag_minimo              VARCHAR2(2),
  por_pag_minimo              NUMBER(5,2),
  imp_min_pag_minimo          NUMBER(15,2),
  imp_fij_pag_minimo          NUMBER(15,2),
  fac_mul_vip                 NUMBER(5,2),
  sal_ult_resumen             NUMBER(15,2),
  num_com_per_anterior        NUMBER(18),
  can_extractos               NUMBER(5),
  dia_mora_inicial            NUMBER(5),
  num_com_per_actual          NUMBER(18),
  tas_alt_cierre              VARCHAR2(2),
  fec_ult_actualizacion       DATE,
  des_tti                     VARCHAR2(15),
  cta_excedida                VARCHAR2(2),
  imp_mora                    NUMBER(15,2),
  imp_exceso                  NUMBER(15,2),
  imp_com_no_financiable      NUMBER(15,2),
  imp_gas_financiero          NUMBER(15,2),
  imp_por_com_financiable     NUMBER(15,2),
  imp_aju_por_com_financiable NUMBER(15,2),
  imp_pag_minimo              NUMBER(15,2),
  tas_aplicada                NUMBER(5,2),
  tas_anu_efe_aplicada        NUMBER(6,3),
  con_extracto                VARCHAR2(15),
  nom_formulario              VARCHAR2(10),
  nro_control                 NUMBER(7),
  nro_factura                 NUMBER(13),
  timbrado                    NUMBER(11),
  vto_pag_min_actual          DATE,
  deu_total                   NUMBER(15,2),
  res_est_meses               NUMBER(5),
  res_est_total               NUMBER(15,2),
  pun_anteriores              NUMBER(15,2),
  pun_generados               NUMBER(15,2),
  pun_canjeados               NUMBER(15,2),
  pun_vencidos                NUMBER(15,2),
  pun_baja                    NUMBER(15,2),
  sal_puntos                  NUMBER(15,2),
  pro_lealtad                 NUMBER(12),
  nom_puntos                  VARCHAR2(40),
  des_tip_pago                VARCHAR2(15),
  car_sus_acumulado           NUMBER(15,2),
  pro_int_anteriores          NUMBER(15,2),
  pro_int_periodo             NUMBER(15,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
