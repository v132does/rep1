create table IT.TM_CTA_TARJETAS_AUX
(
  nro_cuenta VARCHAR2(15) not null,
  problema   VARCHAR2(50)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TM_CTA_TARJETAS_AUX
  is 'Cuentas de Tarjetas de Creditos con problemas.';
comment on column IT.TM_CTA_TARJETAS_AUX.nro_cuenta
  is 'Nro. Cuenta.';
comment on column IT.TM_CTA_TARJETAS_AUX.problema
  is 'Descripcion del problema.';
alter table IT.TM_CTA_TARJETAS_AUX
  add constraint PK_TM_CTA_TARJETAS_AUX primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

