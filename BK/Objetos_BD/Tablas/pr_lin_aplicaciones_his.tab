create table IT.PR_LIN_APLICACIONES_HIS
(
  nro_linea        NUMBER(7) not null,
  nro_sec_padre    NUMBER(10) not null,
  nro_cuenta       VARCHAR2(50) not null,
  cod_moneda       VARCHAR2(3) not null,
  mto_aplicado     NUMBER(18,2) default 0 not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_LIN_APLICACIONES_HIS
  is 'Tabla de aplicación de Líneas - Histórico.';
comment on column IT.PR_LIN_APLICACIONES_HIS.nro_linea
  is 'Número de Línea.';
comment on column IT.PR_LIN_APLICACIONES_HIS.nro_sec_padre
  is 'Número de Secuencia Padre.';
comment on column IT.PR_LIN_APLICACIONES_HIS.nro_cuenta
  is 'Número de Cuenta de Referencia (ge_cuentas o solicitudes de tarjetas o préstamos).';
comment on column IT.PR_LIN_APLICACIONES_HIS.cod_moneda
  is 'Moneda de la Propuesta aplicada.';
comment on column IT.PR_LIN_APLICACIONES_HIS.mto_aplicado
  is 'Monto aplicado.';
comment on column IT.PR_LIN_APLICACIONES_HIS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_LIN_APLICACIONES_HIS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_LIN_APLICACIONES_HIS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_LIN_APLICACIONES_HIS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IDX$$_34CB30002 on IT.PR_LIN_APLICACIONES_HIS (NRO_CUENTA, FEC_INSERCION, NRO_LINEA)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_PLAHI_COD_MONEDA on IT.PR_LIN_APLICACIONES_HIS (COD_MONEDA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_PR_LIN_APLICACIONES_HIS on IT.PR_LIN_APLICACIONES_HIS (NRO_LINEA, NRO_CUENTA, NRO_SEC_PADRE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_LIN_APLICACIONES_HIS
  add constraint FK_PLAHI_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);

