create table IT.CJ_CORTES_TMP
(
  fecha            DATE not null,
  hora             VARCHAR2(8) not null,
  cod_usuario      VARCHAR2(10) not null,
  nro_secuencia    NUMBER(3) not null,
  cod_tra_padre    NUMBER(4) not null,
  des_tra_padre    VARCHAR2(100) not null,
  cod_oficina      NUMBER(3) not null,
  cod_moneda       VARCHAR2(3) not null,
  nro_caja         NUMBER(3) not null,
  monto            NUMBER(18,2) not null,
  tip_monto        VARCHAR2(1) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  nro_corte        NUMBER(3) not null,
  cod_retencion    NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CJ_CORTES_TMP
  add constraint PK_CJ_CORTES_TMP primary key (FECHA, HORA, COD_USUARIO, NRO_CORTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

