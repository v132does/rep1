create table IT.BW_SOF_EMPRESAS
(
  sof_ser_id           NUMBER not null,
  cod_per_vinculada    VARCHAR2(15) not null,
  estado               VARCHAR2(1),
  enrolado             VARCHAR2(1) default 'N',
  fec_insercion        DATE default SYSDATE not null,
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  usu_activacion       VARCHAR2(10),
  usu_adm_modificacion VARCHAR2(10),
  observacion          VARCHAR2(1000),
  fec_activacion       DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.BW_SOF_EMPRESAS.cod_per_vinculada
  is 'codigo de la empresa';
comment on column IT.BW_SOF_EMPRESAS.estado
  is 'estado de la clave: E:enrolado, P:pendiente, A:activo, S:solicitado, R:rechazado, B:bloqueada, I:inactivo';
comment on column IT.BW_SOF_EMPRESAS.enrolado
  is 'estado de enrolamiento activo: S:Si, N:No';
comment on column IT.BW_SOF_EMPRESAS.fec_insercion
  is 'fecha de insersion';
comment on column IT.BW_SOF_EMPRESAS.usu_insercion
  is 'usuario de insersion';
comment on column IT.BW_SOF_EMPRESAS.fec_modificacion
  is 'fecha de modificacion';
comment on column IT.BW_SOF_EMPRESAS.usu_modificacion
  is 'usuario de modificacion';
create index IT.ID_BW_SOF_EMPRESAS on IT.BW_SOF_EMPRESAS (COD_PER_VINCULADA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BW_SOF_EMPRESAS
  add constraint PK_BW_SOF_EMPRESAS primary key (SOF_SER_ID, COD_PER_VINCULADA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BW_SOF_EMPRESAS
  add constraint FK_BW_SOF_ID foreign key (SOF_SER_ID)
  references IT.BW_SOF_SERIALES (ID);

