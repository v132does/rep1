create table IT.GE_LOG_RBAONLINE
(
  mensaje       CLOB,
  respuesta     VARCHAR2(4000),
  usu_insercion VARCHAR2(10) default user,
  fec_insercion DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_LOG_RBAONLINE
  is 'Log de Envíos y Respuestas RBA Online.';
create index IT.IN_GLRB_FEC_INSERCION on IT.GE_LOG_RBAONLINE (TRUNC(FEC_INSERCION))
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

