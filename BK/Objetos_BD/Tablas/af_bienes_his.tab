create table IT.AF_BIENES_HIS
(
  cod_bien             NUMBER(10) not null,
  cod_articulo         NUMBER(10) not null,
  descripcion          VARCHAR2(250),
  cod_oficina          NUMBER(3) not null,
  cod_area             NUMBER(3) not null,
  nro_serie            NUMBER(20),
  val_compra           NUMBER(18,2) default 0 not null,
  cod_moneda           VARCHAR2(3) not null,
  fec_compra           DATE not null,
  cod_ent_proveedor    NUMBER(5),
  nro_factura          VARCHAR2(20),
  tipo                 VARCHAR2(1),
  coeficiente          NUMBER(20,4) default 0,
  fec_vto_depreciacion DATE,
  rev_anterior         NUMBER(18,2) default 0,
  rev_actual           NUMBER(18,2) default 0,
  dep_anterior         NUMBER(18,2) default 0,
  dep_anual            NUMBER(18,2) default 0,
  dep_mensual          NUMBER(18,2) default 0,
  rev_depreciacion     NUMBER(18,2) default 0,
  dep_actual           NUMBER(18,2) default 0,
  dep_acumulada        NUMBER(18,2) default 0,
  val_neto             NUMBER(18,2) default 0,
  fec_proceso          DATE,
  tip_proceso          VARCHAR2(1),
  estado               VARCHAR2(1) default 'A' not null,
  fec_enajenacion      DATE,
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  dep_mensual_normal   NUMBER(18,2) default 0,
  rev_ano_anterior     NUMBER(18,2) default 0,
  rev_ano_acumulado    NUMBER(18,2) default 0,
  dep_ano_acu_anterior NUMBER(18,2) default 0,
  por_val_res_bien     NUMBER(3),
  por_val_dep_bien     NUMBER(3)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AF_BIENES_HIS
  is 'Historico de Bienes del Activo Fijo.';
comment on column IT.AF_BIENES_HIS.cod_bien
  is 'Codigo del Bien.';
comment on column IT.AF_BIENES_HIS.cod_articulo
  is 'Codigo del Articulo.';
comment on column IT.AF_BIENES_HIS.descripcion
  is 'Descripcion del Bien.';
comment on column IT.AF_BIENES_HIS.cod_oficina
  is 'Oficina a la que pertenece el Bien.';
comment on column IT.AF_BIENES_HIS.cod_area
  is 'Area a la que pertenece el Bien.';
comment on column IT.AF_BIENES_HIS.nro_serie
  is 'Numero de serie del bien.';
comment on column IT.AF_BIENES_HIS.val_compra
  is 'Monto de la compra.';
comment on column IT.AF_BIENES_HIS.cod_moneda
  is 'Codigo de la moneda.';
comment on column IT.AF_BIENES_HIS.fec_compra
  is 'Fecha de la compra.';
comment on column IT.AF_BIENES_HIS.cod_ent_proveedor
  is 'Codigo de entidad del Proveedor.';
comment on column IT.AF_BIENES_HIS.nro_factura
  is 'Numero de la factura de compra.';
comment on column IT.AF_BIENES_HIS.tipo
  is 'Tipo de Comprobante: F / Factura o B / Boleta de Venta.';
comment on column IT.AF_BIENES_HIS.coeficiente
  is 'Ultimo Coeficiente de Revaluo.';
comment on column IT.AF_BIENES_HIS.fec_vto_depreciacion
  is 'Fecha de vigencia hasta.';
comment on column IT.AF_BIENES_HIS.rev_anterior
  is 'Revaluo anterior.';
comment on column IT.AF_BIENES_HIS.rev_actual
  is 'Valor Revaluado.';
comment on column IT.AF_BIENES_HIS.dep_anterior
  is 'Depreciacion Anterior.';
comment on column IT.AF_BIENES_HIS.dep_anual
  is 'Depreciacion Anual.';
comment on column IT.AF_BIENES_HIS.dep_mensual
  is 'Depreciacion Mensual.';
comment on column IT.AF_BIENES_HIS.rev_depreciacion
  is 'Revaluo de depreciacion.';
comment on column IT.AF_BIENES_HIS.dep_actual
  is 'Ultima Depreciacion.';
comment on column IT.AF_BIENES_HIS.dep_acumulada
  is 'Depreciacion Acumulada.';
comment on column IT.AF_BIENES_HIS.val_neto
  is 'Valor Neto.';
comment on column IT.AF_BIENES_HIS.fec_proceso
  is 'Fecha de Proceso de la Depreciacion y el Revaluo.';
comment on column IT.AF_BIENES_HIS.tip_proceso
  is 'Tipo del Coeficiente de Revaluo (A / Anual, M / Mensual).';
comment on column IT.AF_BIENES_HIS.estado
  is 'Estado del Bien.';
comment on column IT.AF_BIENES_HIS.fec_enajenacion
  is 'Fecha de enajenacion del Bien.';
comment on column IT.AF_BIENES_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.AF_BIENES_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.AF_BIENES_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.AF_BIENES_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.AF_BIENES_HIS.dep_mensual_normal
  is 'Depreciación Normal. Aquí se guarda la Dep. Normal en el caso de tener Dep. Acelerada de Bienes.';
comment on column IT.AF_BIENES_HIS.rev_ano_anterior
  is 'Revalúo al mes de Diciembre del Año anterior.';
comment on column IT.AF_BIENES_HIS.rev_ano_acumulado
  is 'Porción de Revalúo Acumulado durante el Año.';
comment on column IT.AF_BIENES_HIS.dep_ano_acu_anterior
  is 'Depreciación Acumulada del Año anterior.';
comment on column IT.AF_BIENES_HIS.por_val_res_bien
  is 'Porcentaje Valor Residual';
comment on column IT.AF_BIENES_HIS.por_val_dep_bien
  is 'Porcentaje Valor Depreciable';
create index IT.IN_FBHIS_COD_BIEN on IT.AF_BIENES_HIS (COD_BIEN)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AF_BIENES_HIS
  add constraint FK_FBHIS_COD_AREA foreign key (COD_AREA, COD_OFICINA)
  references IT.BA_AREAS (COD_AREA, COD_OFICINA);
alter table IT.AF_BIENES_HIS
  add constraint FK_FBHIS_COD_ENT_PROVEEDOR foreign key (COD_ENT_PROVEEDOR)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.AF_BIENES_HIS
  add constraint FK_FBHIS_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.AF_BIENES_HIS
  add constraint FK_FBHIS_FEC_PROCESO foreign key (FEC_PROCESO, TIP_PROCESO)
  references IT.AF_COE_REVALUOS (FEC_PROCESO, TIPO);
alter table IT.AF_BIENES_HIS
  add constraint AVCON_1191859915_COD_B_000
  check (COD_BIEN BETWEEN 0 AND 999999999);

