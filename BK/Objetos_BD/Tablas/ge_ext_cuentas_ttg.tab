CREATE GLOBAL TEMPORARY TABLE IT.GE_EXT_CUENTAS_TTG (
   COD_PERSONA	      VARCHAR2(10 BYTE),
   NRO_CUENTA	      VARCHAR2(15 BYTE),
   COD_MODULO	      NUMBER(3,0),
   COD_MODALIDAD	   NUMBER(3,0),
   FEC_ULT_EXTRACTO	DATE,
   SAL_ULT_EXTRACTO	NUMBER(18,2),
   NRO_FOLIO	      NUMBER(7,0),
   NOM_TABLA	      VARCHAR2(25 BYTE)
)
ON COMMIT PRESERVE ROWS;

CREATE PUBLIC SYNONYM GE_EXT_CUENTAS_TTG FOR IT.GE_EXT_CUENTAS_TTG;
      
COMMENT ON TABLE GE_EXT_CUENTAS_TTG IS 'Tabla global temporal por sesión para generación de extractos';

COMMENT ON COLUMN GE_EXT_CUENTAS_TTG.COD_PERSONA IS 'Codigo de la Persona';

COMMENT ON COLUMN GE_EXT_CUENTAS_TTG.NRO_CUENTA IS 'Número de cuenta';

COMMENT ON COLUMN GE_EXT_CUENTAS_TTG.COD_MODULO IS 'Código de módulo de la Cuenta';

COMMENT ON COLUMN GE_EXT_CUENTAS_TTG.COD_MODALIDAD IS 'Código de modalidad de la Cuenta';

COMMENT ON COLUMN GE_EXT_CUENTAS_TTG.FEC_ULT_EXTRACTO IS 'Fecha de último extracto';

COMMENT ON COLUMN GE_EXT_CUENTAS_TTG.SAL_ULT_EXTRACTO IS 'Saldo del último extracto';

COMMENT ON COLUMN GE_EXT_CUENTAS_TTG.NRO_FOLIO IS 'Número de folio';

COMMENT ON COLUMN GE_EXT_CUENTAS_TTG.NOM_TABLA IS 'Nombre de tabla para actualizar';

GRANT SELECT, INSERT, UPDATE, DELETE ON GE_EXT_CUENTAS_TTG TO IT_TEMPORAL;