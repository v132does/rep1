create global temporary table IT.SS2K5_INDEX_COLUMNS
(
  db_id           NUMBER(10),
  index_column_id NUMBER(10) not null,
  object_id       NUMBER(10) not null,
  index_id        NUMBER(10) not null,
  column_id       NUMBER(10) not null
)
on commit preserve rows;
create index IT.SS2K5_INDEX_COLUMNS_DB_ID on IT.SS2K5_INDEX_COLUMNS (DB_ID);
create index IT.SS2K5_INDEX_COLUMNS_OBJECT_ID on IT.SS2K5_INDEX_COLUMNS (OBJECT_ID);

