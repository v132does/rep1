create table IT.GE_SOL_DISTRIBUCIONES
(
  cod_estado       VARCHAR2(3) not null,
  cod_modulo       NUMBER(3),
  cod_usuario      VARCHAR2(10) not null,
  cod_campana      NUMBER(3),
  cod_rango        NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_tip_canal    NUMBER(3),
  cod_canal        NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SOL_DISTRIBUCIONES
  is 'Distribuye solicitudes entre usuarios.';
comment on column IT.GE_SOL_DISTRIBUCIONES.cod_estado
  is 'Codigo de estado.';
comment on column IT.GE_SOL_DISTRIBUCIONES.cod_modulo
  is 'Codigo de Modulo.';
comment on column IT.GE_SOL_DISTRIBUCIONES.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.GE_SOL_DISTRIBUCIONES.cod_campana
  is 'Código de campaña.';
comment on column IT.GE_SOL_DISTRIBUCIONES.cod_rango
  is 'Codigo de rango.';
comment on column IT.GE_SOL_DISTRIBUCIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_SOL_DISTRIBUCIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_SOL_DISTRIBUCIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_SOL_DISTRIBUCIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_SOL_DISTRIBUCIONES.cod_tip_canal
  is 'Codigo de tipo de canal.';
comment on column IT.GE_SOL_DISTRIBUCIONES.cod_canal
  is 'Codigo de Canal.';
create index IT.IN_BBVA_GESOLDIST on IT.GE_SOL_DISTRIBUCIONES (COD_CAMPANA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint UK_GE_SOL_DISTRIBUCIONES unique (COD_ESTADO, COD_USUARIO, COD_RANGO, COD_CAMPANA, COD_TIP_CANAL, COD_CANAL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint FK_GSDIS_COD_CAMPANA foreign key (COD_CAMPANA)
  references IT.CR_CAMPANAS (COD_CAMPANA);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint FK_GSDIS_COD_CANAL foreign key (COD_CANAL)
  references IT.GE_CANALES (COD_CANAL);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint FK_GSDIS_COD_ESTADO foreign key (COD_ESTADO)
  references IT.GE_SOL_ESTADOS (COD_ESTADO);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint FK_GSDIS_COD_MODULO foreign key (COD_MODULO)
  references IT.BA_MODULOS (COD_MODULO);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint FK_GSDIS_COD_RANGO foreign key (COD_RANGO)
  references IT.GE_SOL_RANGOS (COD_RANGO);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint FK_GSDIS_COD_TIP_CANAL foreign key (COD_TIP_CANAL)
  references IT.GE_TIP_CANALES (COD_TIP_CANAL);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint FK_GSDIS_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint AVCON_1083264899_COD_C_003
  check (COD_CAMPANA BETWEEN 0 AND 999);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint AVCON_1083264899_COD_M_005
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint AVCON_1083264899_COD_R_000
  check (COD_RANGO BETWEEN 0 AND 999);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint AVCON_1088554123_COD_T_001
  check (COD_TIP_CANAL BETWEEN 0 AND 999);
alter table IT.GE_SOL_DISTRIBUCIONES
  add constraint AVCON_1088606833_COD_C_001
  check (COD_CANAL BETWEEN 0 AND 999);

