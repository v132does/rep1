create table IT.BW_ENV_NOT_PUSH
(
  cod_persona      VARCHAR2(10) not null,
  activo           VARCHAR2(1) default 'N' not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.BW_ENV_NOT_PUSH.cod_persona
  is 'Código de la Persona.';
comment on column IT.BW_ENV_NOT_PUSH.activo
  is 'Activo: S/Si, N/No';
comment on column IT.BW_ENV_NOT_PUSH.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BW_ENV_NOT_PUSH.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BW_ENV_NOT_PUSH.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BW_ENV_NOT_PUSH.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BW_ENV_NOT_PUSH
  add constraint PK_BW_ENV_NOT_PUSH primary key (COD_PERSONA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BW_ENV_NOT_PUSH
  add constraint FK_BWNTE_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.BW_ENV_NOT_PUSH
  add constraint CK_BWNTE_ACTIVO
  check (ACTIVO IN ('S','N'));

