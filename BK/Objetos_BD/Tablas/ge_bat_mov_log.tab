create table IT.GE_BAT_MOV_LOG
(
  fecha            DATE default sysdate not null,
  usuario          VARCHAR2(20) default user not null,
  log              VARCHAR2(3000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_BAT_MOV_LOG.fecha
  is 'Fecha de proceso';
comment on column IT.GE_BAT_MOV_LOG.usuario
  is 'Codigo del usuario';
comment on column IT.GE_BAT_MOV_LOG.log
  is 'Mensaje';
create index IT.IN_BMLOG_FECHA on IT.GE_BAT_MOV_LOG (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

