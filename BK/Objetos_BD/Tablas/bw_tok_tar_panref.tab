create table IT.BW_TOK_TAR_PANREF
(
  cod_persona      VARCHAR2(10),
  cod_ref_pan      VARCHAR2(24) not null,
  tipo             VARCHAR2(10),
  nro_tar_credito  VARCHAR2(25),
  nro_tar_debito   VARCHAR2(25),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.BW_TOK_TAR_PANREF.cod_persona
  is 'Codigo persona';
comment on column IT.BW_TOK_TAR_PANREF.cod_ref_pan
  is 'PanRefID';
comment on column IT.BW_TOK_TAR_PANREF.tipo
  is '(DEBIT o CREDIT)';
comment on column IT.BW_TOK_TAR_PANREF.nro_tar_credito
  is 'Número de tarjeta de crédito';
comment on column IT.BW_TOK_TAR_PANREF.nro_tar_debito
  is 'Número de tarjeta de débito';
comment on column IT.BW_TOK_TAR_PANREF.usu_insercion
  is 'Usuario Inserción';
comment on column IT.BW_TOK_TAR_PANREF.fec_insercion
  is 'Fecha Inserción';
comment on column IT.BW_TOK_TAR_PANREF.usu_modificacion
  is 'Usuario Modificacion';
comment on column IT.BW_TOK_TAR_PANREF.fec_modificacion
  is 'Fecha Modificacion';
alter table IT.BW_TOK_TAR_PANREF
  add constraint PK_BW_TOK_TAR_PANREF primary key (COD_REF_PAN)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

