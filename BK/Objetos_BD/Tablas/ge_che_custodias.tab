create table IT.GE_CHE_CUSTODIAS
(
  cod_banco             NUMBER(3) not null,
  nro_cheque            NUMBER(15) not null,
  cta_libradora         VARCHAR2(20) not null,
  cod_moneda            VARCHAR2(3) not null,
  monto                 NUMBER(18,2) default 0 not null,
  fec_emision           DATE not null,
  fec_vencimiento       DATE not null,
  nro_referencia        VARCHAR2(15) not null,
  nro_cuota             NUMBER(3),
  estado                VARCHAR2(1) default 'C' not null,
  fec_proceso           DATE,
  tip_servicio          VARCHAR2(1) default 'D' not null,
  nro_boleta            NUMBER(15),
  cod_ofi_camara        NUMBER(3),
  fec_deposito          DATE,
  mot_entrega           NUMBER(3),
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default SYSDATE not null,
  observacion           VARCHAR2(200),
  cod_oficina           NUMBER(3),
  cod_cau_devolucion    NUMBER(3),
  compensado            VARCHAR2(1),
  cod_persona           VARCHAR2(10),
  fec_fin_renegociacion DATE,
  doc_adjunto           BLOB,
  serie                 VARCHAR2(5),
  cod_gru_cheque        NUMBER
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CHE_CUSTODIAS
  is 'Se registran los datos de Cheques Descontados ingresados por el módulo de préstamos.';
comment on column IT.GE_CHE_CUSTODIAS.cod_banco
  is 'Codigo de Banco.';
comment on column IT.GE_CHE_CUSTODIAS.nro_cheque
  is 'Numero de Cheque.';
comment on column IT.GE_CHE_CUSTODIAS.cta_libradora
  is 'Cuenta Libradora.';
comment on column IT.GE_CHE_CUSTODIAS.cod_moneda
  is 'Codigo de Moneda del Importe.';
comment on column IT.GE_CHE_CUSTODIAS.monto
  is 'Monto del Cheque.';
comment on column IT.GE_CHE_CUSTODIAS.fec_emision
  is 'Fecha de Emision.';
comment on column IT.GE_CHE_CUSTODIAS.fec_vencimiento
  is 'Fecha de Vencimiento del Cheque.';
comment on column IT.GE_CHE_CUSTODIAS.nro_referencia
  is 'Numero de Cuenta o Propuesta Relacionada.';
comment on column IT.GE_CHE_CUSTODIAS.nro_cuota
  is 'Numero de Cuota si es Prestamos.';
comment on column IT.GE_CHE_CUSTODIAS.estado
  is 'Estado del Cheque (C=custodia, E=entregar, D=Descontado, I=ingresado, A=En Camara, B=Devuelto).';
comment on column IT.GE_CHE_CUSTODIAS.fec_proceso
  is 'Fecha de Proceso.';
comment on column IT.GE_CHE_CUSTODIAS.tip_servicio
  is 'Tipo de Servicio (D=Descuento de cheques, C=custodia de cheques, H=Caución de cheques).';
comment on column IT.GE_CHE_CUSTODIAS.nro_boleta
  is 'Numero de Boleta de Deposito.';
comment on column IT.GE_CHE_CUSTODIAS.cod_ofi_camara
  is 'Codigo de Oficina de Camara donde se realizo el Deposito.';
comment on column IT.GE_CHE_CUSTODIAS.fec_deposito
  is 'Fecha en la que se debe Depositar el Cheque.';
comment on column IT.GE_CHE_CUSTODIAS.mot_entrega
  is 'Motivo de Entrega del Cheque. Ver en Causales.';
comment on column IT.GE_CHE_CUSTODIAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CHE_CUSTODIAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CHE_CUSTODIAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CHE_CUSTODIAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_CHE_CUSTODIAS.observacion
  is 'Observaciones.';
comment on column IT.GE_CHE_CUSTODIAS.cod_oficina
  is 'Codigo de Oficina Origen.';
comment on column IT.GE_CHE_CUSTODIAS.cod_cau_devolucion
  is 'Codigo de Causa de Devolucion.';
comment on column IT.GE_CHE_CUSTODIAS.compensado
  is 'Indica que el cheque fue compensado';
comment on column IT.GE_CHE_CUSTODIAS.cod_persona
  is 'Codigo de Persona.';
comment on column IT.GE_CHE_CUSTODIAS.fec_fin_renegociacion
  is 'Fecha de Renegociación de pago.';
comment on column IT.GE_CHE_CUSTODIAS.doc_adjunto
  is 'Documento adjunto.';
comment on column IT.GE_CHE_CUSTODIAS.serie
  is 'Serie del cheque.';
create index IT.IN_GCCUS_COD_CAU_DEVOLUCION on IT.GE_CHE_CUSTODIAS (COD_CAU_DEVOLUCION, COD_OFICINA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GCCUS_COD_OFI_CAMARA on IT.GE_CHE_CUSTODIAS (ESTADO, COD_OFI_CAMARA, COD_BANCO, COD_MONEDA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 6M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GCCUS_NRO_REFERENCIA on IT.GE_CHE_CUSTODIAS (NRO_REFERENCIA, NRO_CUOTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 7M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CHE_CUSTODIAS
  add constraint PK_GE_CHE_CUSTODIAS primary key (NRO_CHEQUE, COD_BANCO, CTA_LIBRADORA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 8M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CHE_CUSTODIAS
  add constraint FK_GCCUS_COD_BANCO foreign key (COD_BANCO)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.GE_CHE_CUSTODIAS
  add constraint FK_GCCUS_COD_CAU_DEVOLUCION foreign key (COD_CAU_DEVOLUCION)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.GE_CHE_CUSTODIAS
  add constraint FK_GCCUS_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_CHE_CUSTODIAS
  add constraint FK_GCCUS_COD_OFI_CAMARA foreign key (COD_OFI_CAMARA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CHE_CUSTODIAS
  add constraint FK_GCCUS_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CHE_CUSTODIAS
  add constraint AVCON_1118276299_COD_B_001
  check (COD_BANCO BETWEEN 0 AND 999);
alter table IT.GE_CHE_CUSTODIAS
  add constraint AVCON_1118276299_COD_O_002
  check (COD_OFI_CAMARA BETWEEN 0 AND 999);

