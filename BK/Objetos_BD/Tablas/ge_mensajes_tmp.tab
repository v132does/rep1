create table IT.GE_MENSAJES_TMP
(
  cod_mensaje NUMBER(3),
  mensaje     VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_MENSAJES_TMP.cod_mensaje
  is 'Código del mensaje';
comment on column IT.GE_MENSAJES_TMP.mensaje
  is 'Mensaje a desplegar';

