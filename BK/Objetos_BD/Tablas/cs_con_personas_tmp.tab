create table IT.CS_CON_PERSONAS_TMP
(
  nro_contrato        VARCHAR2(10) not null,
  cod_persona         VARCHAR2(10) not null,
  tip_relacion        VARCHAR2(1),
  lla_entregadas      NUMBER(2),
  lla_devueltas       NUMBER(2),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  tip_fir_autorizados VARCHAR2(1),
  tip_fir_clientes    VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CS_CON_PERSONAS_TMP
  is 'Personas relacionadas o autorizadas por contrato.';
comment on column IT.CS_CON_PERSONAS_TMP.nro_contrato
  is 'Codigo del Contrato.';
comment on column IT.CS_CON_PERSONAS_TMP.cod_persona
  is 'Codigo de la Persona.';
comment on column IT.CS_CON_PERSONAS_TMP.tip_relacion
  is 'Relacion en el Contrato: (T)itular, (A)utorizado.';
comment on column IT.CS_CON_PERSONAS_TMP.lla_entregadas
  is 'Cantidad de llaves entregadas por contrato.';
comment on column IT.CS_CON_PERSONAS_TMP.lla_devueltas
  is 'Cantidad de llaves devueltas por contrato.';
comment on column IT.CS_CON_PERSONAS_TMP.usu_insercion
  is 'Usuario que inserto el registro.';
comment on column IT.CS_CON_PERSONAS_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CS_CON_PERSONAS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion del registro.';
comment on column IT.CS_CON_PERSONAS_TMP.fec_modificacion
  is 'Usuario que realizo la ultima modificacion del registro.';
comment on column IT.CS_CON_PERSONAS_TMP.tip_fir_autorizados
  is 'Tipo de Firma que se ejercera entre los Autorizados.';
comment on column IT.CS_CON_PERSONAS_TMP.tip_fir_clientes
  is 'Tipo de Firma que se ejercera entre clientes.';
alter table IT.CS_CON_PERSONAS_TMP
  add constraint PK_CS_CON_PERSONAS_TMP primary key (NRO_CONTRATO, COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

