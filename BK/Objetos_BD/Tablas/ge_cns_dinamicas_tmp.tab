  columna34        VARCHAR2(500),
  columna35        VARCHAR2(500),
  columna36        VARCHAR2(500),
  columna37        VARCHAR2(500),
  columna38        VARCHAR2(500),
  columna39        VARCHAR2(500),
  columna40        VARCHAR2(500),
