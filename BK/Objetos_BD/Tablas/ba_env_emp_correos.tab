create table IT.BA_ENV_EMP_CORREOS
(
  nro_correo       NUMBER not null,
  cod_persona      VARCHAR2(10) not null,
  tip_producto     NUMBER not null,
  estado           VARCHAR2(1) default 'P' not null,
  fec_registro     DATE default sysdate not null,
  fec_envio        DATE,
  msj_error        VARCHAR2(4000),
  parametros       LONG,
  destinatarios    VARCHAR2(4000) not null,
  usu_insercion    VARCHAR2(10) default substr(user,1,10) not null,
  fec_insercion    DATE default sysdate not null,
  usu_modificacion VARCHAR2(10) default substr(user,1,10) not null,
  fec_modificacion DATE default sysdate not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_ENV_EMP_CORREOS
  is 'Registro de mails a enviarse para empresas.';
comment on column IT.BA_ENV_EMP_CORREOS.nro_correo
  is 'Número de correo.';
comment on column IT.BA_ENV_EMP_CORREOS.cod_persona
  is 'Código de Persona..';
comment on column IT.BA_ENV_EMP_CORREOS.tip_producto
  is 'Código del tipo de producto.';
comment on column IT.BA_ENV_EMP_CORREOS.estado
  is 'Tipo de estado (P = Pendiente, S = Enviado, E = Error).';
comment on column IT.BA_ENV_EMP_CORREOS.fec_registro
  is 'Fecha en que se registro el mail.';
comment on column IT.BA_ENV_EMP_CORREOS.fec_envio
  is 'Fecha de envío del mail.';
comment on column IT.BA_ENV_EMP_CORREOS.msj_error
  is 'Mensaje de error del demonio.';
comment on column IT.BA_ENV_EMP_CORREOS.parametros
  is 'Json con los datos para armar el mai.';
comment on column IT.BA_ENV_EMP_CORREOS.destinatarios
  is 'Listado de destinatarios del mail.';
alter table IT.BA_ENV_EMP_CORREOS
  add constraint PK_NRO_CORREO primary key (NRO_CORREO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

