create table IT.CO_PER_CORREOS_TMP
(
  cod_per_correo   NUMBER(10) not null,
  tip_operacion    VARCHAR2(1),
  cod_persona      VARCHAR2(10),
  cod_mail         VARCHAR2(20),
  tipo             VARCHAR2(6),
  mail             VARCHAR2(255),
  contacto         VARCHAR2(1),
  valido           VARCHAR2(1),
  estado           VARCHAR2(1),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CO_PER_CORREOS_TMP
  is 'Temporal de Mails modificados en el Recovery Strategy.';
comment on column IT.CO_PER_CORREOS_TMP.cod_per_correo
  is 'Código de Correo de la Persona.';
comment on column IT.CO_PER_CORREOS_TMP.tip_operacion
  is 'Tipo de Operación.';
comment on column IT.CO_PER_CORREOS_TMP.cod_persona
  is 'Código de Cliente.';
comment on column IT.CO_PER_CORREOS_TMP.cod_mail
  is 'Código de Mail.';
comment on column IT.CO_PER_CORREOS_TMP.tipo
  is 'Código de tipo de Mail.';
comment on column IT.CO_PER_CORREOS_TMP.mail
  is 'Mail.';
comment on column IT.CO_PER_CORREOS_TMP.contacto
  is 'Es mail de contacto?.';
comment on column IT.CO_PER_CORREOS_TMP.valido
  is 'Es mail válido?.';
comment on column IT.CO_PER_CORREOS_TMP.estado
  is 'Estado.';
comment on column IT.CO_PER_CORREOS_TMP.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CO_PER_CORREOS_TMP.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CO_PER_CORREOS_TMP.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CO_PER_CORREOS_TMP.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_OPCTM_COD_PERSONA on IT.CO_PER_CORREOS_TMP (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

