create table IT.RH_ERRORES
(
  clave            VARCHAR2(30) not null,
  error            VARCHAR2(250) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_ERRORES
  is 'Errores del Sistema.';
comment on column IT.RH_ERRORES.clave
  is 'Clave del error.';
comment on column IT.RH_ERRORES.error
  is 'Error que se produjo.';
comment on column IT.RH_ERRORES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_ERRORES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_ERRORES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_ERRORES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

