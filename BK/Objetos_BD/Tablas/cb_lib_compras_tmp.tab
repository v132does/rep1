create table IT.CB_LIB_COMPRAS_TMP
(
  fecha             DATE not null,
  nro_factura       VARCHAR2(20) not null,
  tipo              VARCHAR2(2) not null,
  cod_persona       VARCHAR2(10) not null,
  mto_exento        NUMBER(18,2) default 0,
  mto_gravado_10    NUMBER(18,2),
  impuesto_10       NUMBER(18,2) default 0,
  mto_gravado_5     NUMBER(18,2) default 0,
  impuesto_5        NUMBER(18,2) default 0,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  nro_documento     VARCHAR2(20) not null,
  raz_social        VARCHAR2(120),
  cod_ofi_origen    NUMBER(4) not null,
  cod_ent_proveedor NUMBER(5) not null,
  procesado         VARCHAR2(1) default 'N',
  nro_timbrado      VARCHAR2(20),
  dig_verificador   NUMBER(1),
  tip_compra        VARCHAR2(2),
  can_cuota         NUMBER(3) default 0
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_LIB_COMPRAS_TMP
  is 'Libro Compras';
comment on column IT.CB_LIB_COMPRAS_TMP.fecha
  is 'Fecha.';
comment on column IT.CB_LIB_COMPRAS_TMP.nro_factura
  is 'Numero de Factura.';
comment on column IT.CB_LIB_COMPRAS_TMP.tipo
  is 'Tipo.';
comment on column IT.CB_LIB_COMPRAS_TMP.cod_persona
  is 'Codigo de Persona.';
comment on column IT.CB_LIB_COMPRAS_TMP.mto_exento
  is 'Monto Exento.';
comment on column IT.CB_LIB_COMPRAS_TMP.mto_gravado_10
  is 'Monto Gravado 10.';
comment on column IT.CB_LIB_COMPRAS_TMP.impuesto_10
  is 'Impuesto 10.';
comment on column IT.CB_LIB_COMPRAS_TMP.mto_gravado_5
  is 'Monto Gravado 5.';
comment on column IT.CB_LIB_COMPRAS_TMP.impuesto_5
  is 'Impuesto 5.';
comment on column IT.CB_LIB_COMPRAS_TMP.usu_insercion
  is 'Usuario que realizo la Insercion del Registro.';
comment on column IT.CB_LIB_COMPRAS_TMP.fec_insercion
  is 'Fecha en que se Inserto el Registro.';
comment on column IT.CB_LIB_COMPRAS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_LIB_COMPRAS_TMP.fec_modificacion
  is 'Fecha en que se realizo la Ultima Modificacion en el Registro.';
comment on column IT.CB_LIB_COMPRAS_TMP.nro_documento
  is 'Nro. de RUC del Proveedor';
comment on column IT.CB_LIB_COMPRAS_TMP.raz_social
  is 'Razon Social del Proveedor';
comment on column IT.CB_LIB_COMPRAS_TMP.cod_ofi_origen
  is 'Oficina donde ingreso la factura';
comment on column IT.CB_LIB_COMPRAS_TMP.cod_ent_proveedor
  is 'Codigo de entidad del Proveedor.';
comment on column IT.CB_LIB_COMPRAS_TMP.procesado
  is 'Indica si fue procesado para Hechauka';
comment on column IT.CB_LIB_COMPRAS_TMP.nro_timbrado
  is 'Nro. de Timbrado';
comment on column IT.CB_LIB_COMPRAS_TMP.dig_verificador
  is 'Digito Verificador';
comment on column IT.CB_LIB_COMPRAS_TMP.tip_compra
  is 'Condicion de Compra(COntado, CRedito)';
comment on column IT.CB_LIB_COMPRAS_TMP.can_cuota
  is 'Cantidad de cuotas';
create unique index IT.PK_CB_LIB_COMPRAS_TMP on IT.CB_LIB_COMPRAS_TMP (NRO_FACTURA, COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

