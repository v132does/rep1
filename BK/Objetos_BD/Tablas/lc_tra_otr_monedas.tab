comment on column IT.LC_TRA_OTR_MONEDAS.nro_ord_pag_dna
  is 'Nro Orden Pago DNA';
comment on column IT.LC_TRA_OTR_MONEDAS.nro_cta_debito
  is 'Nro de Cuenta de Debito del cliente';
comment on column IT.LC_TRA_OTR_MONEDAS.cod_mon_tte
