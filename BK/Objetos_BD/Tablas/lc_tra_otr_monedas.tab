comment on column IT.LC_TRA_OTR_MONEDAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_LC_TRAO_FEC_OPERACION on IT.LC_TRA_OTR_MONEDAS (FEC_OPERACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_LTRAO_NRO_OPERACION on IT.LC_TRA_OTR_MONEDAS (NRO_OPERACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_TRA_OTR_MONEDAS
  add constraint PK_LC_TRAO_MONEDAS primary key (NRO_REFERENCIA, COD_TIP_REFERENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_TRA_OTR_MONEDAS
  add constraint UK_LCTRAO_NRO_REF_EXTERNA unique (NRO_REF_EXTERNA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

