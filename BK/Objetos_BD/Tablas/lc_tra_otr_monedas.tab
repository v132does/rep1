comment on column IT.LC_TRA_OTR_MONEDAS.tip_fondo
  is 'Origen de Fondos';
comment on column IT.LC_TRA_OTR_MONEDAS.tip_motivo
  is 'Motivo de la Transferencia';
comment on column IT.LC_TRA_OTR_MONEDAS.tip_financiacion
  is 'Tipo de financiacion';
comment on column IT.LC_TRA_OTR_MONEDAS.nom_ordenante
  is 'Nombre del Ordenante';
comment on column IT.LC_TRA_OTR_MONEDAS.tip_ref_obs
  is 'Tipo de Referencia de Observacion';
comment on column IT.LC_TRA_OTR_MONEDAS.age_banco
  is 'Agencia/Oficina del Banco';
comment on column IT.LC_TRA_OTR_MONEDAS.nom_bco_cor_contra
  is 'Nombre del Banco Corresponsal Intermediario';
comment on column IT.LC_TRA_OTR_MONEDAS.cod_swi_bco_contra
  is 'Codigo de Swift del Banco Contra';
comment on column IT.LC_TRA_OTR_MONEDAS.cod_aba_bco_contra
  is 'Codigo de Aba del Banco Contra';
comment on column IT.LC_TRA_OTR_MONEDAS.cta_cobranza
  is 'Cuenta de Cobranza (Importacion-Exportacion)';
comment on column IT.LC_TRA_OTR_MONEDAS.fondeado
  is 'Indica si la Transferencia Recibida fue Fondeada(S/N):';
comment on column IT.LC_TRA_OTR_MONEDAS.procesado
  is 'Columna que indica si la transferencia ya fue procesada (S) o no (N).';
comment on column IT.LC_TRA_OTR_MONEDAS.referencia
  is 'Referencia de la Transferencia';
comment on column IT.LC_TRA_OTR_MONEDAS.nro_operacion2
  is 'Numero de Operacion 2';
comment on column IT.LC_TRA_OTR_MONEDAS.autorizado
  is 'Autorización para compartir información con MH o DNA.';
comment on column IT.LC_TRA_OTR_MONEDAS.cod_pai_bco_contra
  is 'Codigo de pais del Banco intermediario';
comment on column IT.LC_TRA_OTR_MONEDAS.cod_ciu_bco_contra
  is 'Codigo de ciudad del Banco intermediario';
comment on column IT.LC_TRA_OTR_MONEDAS.campo
