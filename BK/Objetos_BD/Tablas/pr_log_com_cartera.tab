create table IT.PR_LOG_COM_CARTERA
(
  nro_registro     NUMBER(10),
  nro_error        NUMBER(5),
  men_error        VARCHAR2(500),
  comentario       VARCHAR2(4000),
  proceso          VARCHAR2(50),
  fec_proceso      DATE,
  usu_insercion    VARCHAR2(10) default SUBSTR( USER, 1, 10 ) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR( USER, 1, 10 ) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 8M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_LOG_COM_CARTERA
  is 'Log de control.';
comment on column IT.PR_LOG_COM_CARTERA.nro_registro
  is 'Número de registro dentro del proceso.';
comment on column IT.PR_LOG_COM_CARTERA.nro_error
  is 'Código del error Oracle.';
comment on column IT.PR_LOG_COM_CARTERA.men_error
  is 'Mensaje de error.';
comment on column IT.PR_LOG_COM_CARTERA.comentario
  is 'Comentarios del proceso acerca del suceso.';
comment on column IT.PR_LOG_COM_CARTERA.proceso
  is 'Nombre el proceso.';
comment on column IT.PR_LOG_COM_CARTERA.fec_proceso
  is 'Fecha del proceso.';
comment on column IT.PR_LOG_COM_CARTERA.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_LOG_COM_CARTERA.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_LOG_COM_CARTERA.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_LOG_COM_CARTERA.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';

