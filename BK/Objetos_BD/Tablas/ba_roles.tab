create table IT.BA_ROLES
(
  cod_rol          VARCHAR2(20) not null,
  descripcion      VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_ROLES
  is 'Roles del Sistema.';
comment on column IT.BA_ROLES.cod_rol
  is 'Codigo de Roles.';
comment on column IT.BA_ROLES.descripcion
  is 'Nombre de Roles.';
comment on column IT.BA_ROLES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_ROLES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_ROLES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_ROLES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BA_ROLES
  add constraint PK_BA_ROLES primary key (COD_ROL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

