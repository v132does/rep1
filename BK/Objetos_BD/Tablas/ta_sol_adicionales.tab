create table IT.TA_SOL_ADICIONALES
(
  nro_solicitud        NUMBER(15),
  cod_persona          VARCHAR2(10) not null,
  fec_aprobacion       DATE,
  fec_ingreso          DATE not null,
  cod_usu_autoriza     VARCHAR2(10),
  cod_usu_promotor     VARCHAR2(10),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  nom_embozado         VARCHAR2(26),
  cod_usu_oficial      VARCHAR2(10),
  cod_causa            NUMBER(3),
  observacion          VARCHAR2(4000),
  niv_aprobacion       VARCHAR2(3),
  nro_acta             NUMBER(10),
  cod_estado           VARCHAR2(3) default 'PAN' not null,
  nro_cuenta           VARCHAR2(15),
  pla_ope_por_contado  NUMBER(18,2),
  pla_ope_mto_contado  NUMBER(18,2),
  pla_ope_mto_adelanto NUMBER(18,2),
  pla_ope_por_adelanto NUMBER(18,2),
  cod_canal            NUMBER(3),
  cod_campana          NUMBER(3),
  nro_com_web          NUMBER(15),
  cod_ent_procesadora  NUMBER(5) default 7
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_SOL_ADICIONALES
  is 'Contiene los Datos de Solicitudes de Adicionales de Tarjetas.';
comment on column IT.TA_SOL_ADICIONALES.nro_solicitud
  is 'Numero de Solicitud.';
comment on column IT.TA_SOL_ADICIONALES.cod_persona
  is 'Codigo de Cliente.';
comment on column IT.TA_SOL_ADICIONALES.fec_aprobacion
  is 'Fecha de Aprobacion.';
comment on column IT.TA_SOL_ADICIONALES.fec_ingreso
  is 'Fecha de Ingreso.';
comment on column IT.TA_SOL_ADICIONALES.cod_usu_autoriza
  is 'Operador de Autorizacion.';
comment on column IT.TA_SOL_ADICIONALES.cod_usu_promotor
  is 'Promotor.';
comment on column IT.TA_SOL_ADICIONALES.usu_insercion
  is 'Usuario que realizo la insercion del Registro.';
comment on column IT.TA_SOL_ADICIONALES.fec_insercion
  is 'Fecha en que se inserto el Registro.';
comment on column IT.TA_SOL_ADICIONALES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el Registro.';
comment on column IT.TA_SOL_ADICIONALES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el Registro.';
comment on column IT.TA_SOL_ADICIONALES.nom_embozado
  is 'Nombre a Embozar.';
comment on column IT.TA_SOL_ADICIONALES.cod_usu_oficial
  is 'Oficial de Cuenta.';
comment on column IT.TA_SOL_ADICIONALES.cod_causa
  is 'Causa de Rechazo.';
comment on column IT.TA_SOL_ADICIONALES.observacion
  is 'Observaciones.';
comment on column IT.TA_SOL_ADICIONALES.niv_aprobacion
  is 'Niveles de Aprobacion.';
comment on column IT.TA_SOL_ADICIONALES.nro_acta
  is 'Numero de Acta. ';
comment on column IT.TA_SOL_ADICIONALES.cod_estado
  is 'Estado.';
comment on column IT.TA_SOL_ADICIONALES.nro_cuenta
  is 'Numero de Cuenta del titular.';
comment on column IT.TA_SOL_ADICIONALES.pla_ope_por_contado
  is 'Operador Plan Porcentaje.';
comment on column IT.TA_SOL_ADICIONALES.pla_ope_mto_contado
  is 'Operador Plan Importe.';
comment on column IT.TA_SOL_ADICIONALES.pla_ope_mto_adelanto
  is 'Operador Plan Adelanto Efectivo Importe.';
comment on column IT.TA_SOL_ADICIONALES.pla_ope_por_adelanto
  is 'Operador Plan Adelanto Efectivo Porcentaje.';
comment on column IT.TA_SOL_ADICIONALES.cod_canal
  is 'Codigo canal';
comment on column IT.TA_SOL_ADICIONALES.cod_campana
  is 'Codigo campaña';
comment on column IT.TA_SOL_ADICIONALES.nro_com_web
  is 'Numero de Comprobante del Archivo Adjunto de la Solicitud';
comment on column IT.TA_SOL_ADICIONALES.cod_ent_procesadora
  is 'C?digo de ente de la Procesadora de la tarjeta.';
create index IT.IN_TA_SOL_ADICIONALES on IT.TA_SOL_ADICIONALES (NRO_SOLICITUD, COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TSADI_COD_PERSONAS on IT.TA_SOL_ADICIONALES (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TSADI_NRO_CUENTA on IT.TA_SOL_ADICIONALES (NRO_CUENTA, COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_SOL_ADICIONALES
  add constraint FK_TSADI_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.TA_SOL_ADICIONALES
  add constraint FK_TSADI_COD_USU_AUTORIZA foreign key (COD_USU_AUTORIZA)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.TA_SOL_ADICIONALES
  add constraint FK_TSADI_COD_USU_PROMOTOR foreign key (COD_USU_PROMOTOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.TA_SOL_ADICIONALES
  add constraint FK_TSADI_COD_USU_SUPERVISOR foreign key (COD_USU_OFICIAL)
  references IT.BA_USUARIOS (COD_USUARIO);

