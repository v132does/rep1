create table IT.MOV_EXT_ABRIL
(
  fecha          DATE,
  hora           VARCHAR2(8),
  cod_usuario    VARCHAR2(10),
  cod_tra_padre  NUMBER(4),
  cod_mod_padre  NUMBER(3),
  cod_mad_padre  NUMBER(3),
  nro_documento3 NUMBER(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

