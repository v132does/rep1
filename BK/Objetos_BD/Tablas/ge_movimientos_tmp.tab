-- Create table
create table IT.GE_MOVIMIENTOS_TMP
(
  fecha               DATE not null,
  hora                VARCHAR2(8) not null,
  cod_usuario         VARCHAR2(10) not null,
  nro_secuencia       NUMBER(3) not null,
  fec_valor           DATE,
  monto               NUMBER(18,2) default 0,
  nro_cuenta          VARCHAR2(15),
  cod_moneda          VARCHAR2(3) not null,
  cod_oficina         NUMBER(3),
  cod_error           VARCHAR2(10),
  cod_retencion       NUMBER(3),
  fec_fin_retencion   DATE,
  est_cuenta          VARCHAR2(1),
  estado              VARCHAR2(1) default 'N' not null,
  cod_causa           NUMBER(3),
  cod_banco           NUMBER(3),
  cod_ofi_origen      NUMBER(3) not null,
  concepto            VARCHAR2(100),
  cod_tasa            NUMBER(3),
  val_tasa            NUMBER(20,4) default 0,
  cod_rubro           VARCHAR2(15),
  cod_ref_cambio      VARCHAR2(3),
  reversado           VARCHAR2(1) default 'N' not null,
  cod_usu_reversion   VARCHAR2(10),
  hor_reversion       VARCHAR2(8),
  emi_aviso           VARCHAR2(1) default 'N',
  cod_tra_padre       NUMBER(4) not null,
  cod_mod_padre       NUMBER(3) not null,
  cod_mad_padre       NUMBER(3) not null,
  cod_transaccion     NUMBER(4),
  cod_modulo          NUMBER(3),
  cod_modalidad       NUMBER(3),
  mto_equ_local       NUMBER(18,2),
  nro_caja            NUMBER(3),
  cotizacion          NUMBER(14,8),
  cod_bco_central     VARCHAR2(6),
  nro_documento       NUMBER(15),
  nro_documento2      NUMBER(15),
  nro_documento3      NUMBER(15),
  nro_documento4      NUMBER(15),
  protegido           VARCHAR2(1) default 'N',
  cod_autorizacion    NUMBER(10),
  cod_usu_autorizador VARCHAR2(10),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  tip_mov_rubro       VARCHAR2(1),
  cod_tip_ope_cambio  VARCHAR2(3),
  referencia          VARCHAR2(20),
  cod_persona         VARCHAR2(10),
  cod_sit_contable    NUMBER(20),
  nro_conciliacion    NUMBER(20),
  tab_referencia      VARCHAR2(50),
  procesado           VARCHAR2(1) default 'N'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.GE_MOVIMIENTOS_TMP
  is 'Movimientos Diarios que no fueron transpasado al histórico por error de PK.';
-- Add comments to the columns 
comment on column IT.GE_MOVIMIENTOS_TMP.fecha
  is 'Fecha de la transaccion.';
comment on column IT.GE_MOVIMIENTOS_TMP.hora
  is 'Hora del movimiento.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_usuario
  is 'Codigo de operador.';
comment on column IT.GE_MOVIMIENTOS_TMP.nro_secuencia
  is 'Numero de secuencia.';
comment on column IT.GE_MOVIMIENTOS_TMP.fec_valor
  is 'Fecha valor de la transaccion.';
comment on column IT.GE_MOVIMIENTOS_TMP.monto
  is 'Importe de la transaccion.';
comment on column IT.GE_MOVIMIENTOS_TMP.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_error
  is 'Codigo de error.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_retencion
  is 'Codigo de retencion.';
comment on column IT.GE_MOVIMIENTOS_TMP.fec_fin_retencion
  is 'Fecha fin de la retencion.';
comment on column IT.GE_MOVIMIENTOS_TMP.est_cuenta
  is 'Estado de la cuenta. (En caso de que se haga cambio de estado).';
comment on column IT.GE_MOVIMIENTOS_TMP.estado
  is 'Estado del movimiento. ( ).';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_causa
  is 'Codigo de causa de bloqueo.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_banco
  is 'Codigo de banco.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_ofi_origen
  is 'Codigo de oficina origen.';
comment on column IT.GE_MOVIMIENTOS_TMP.concepto
  is 'Concepto del movimiento.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_tasa
  is 'Codigo de tasa.';
comment on column IT.GE_MOVIMIENTOS_TMP.val_tasa
  is 'Importe de la tasa.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_rubro
  is 'Codigo de cuenta contable.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_ref_cambio
  is 'Codigo de referencia.';
comment on column IT.GE_MOVIMIENTOS_TMP.reversado
  is 'Reversado. (N=NO / S=SI).';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_usu_reversion
  is 'Operador de reversion.';
comment on column IT.GE_MOVIMIENTOS_TMP.hor_reversion
  is 'Hora de reversion.';
comment on column IT.GE_MOVIMIENTOS_TMP.emi_aviso
  is 'Emitir aviso. (N=NO / S=SI).';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_tra_padre
  is 'Codigo de transaccion padre.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_mod_padre
  is 'Codigo de modulo padre.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_mad_padre
  is 'Codigo de modalidad padre.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_transaccion
  is 'Codigo de transaccion hijo.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_MOVIMIENTOS_TMP.mto_equ_local
  is 'Importe equivalente en GS.';
comment on column IT.GE_MOVIMIENTOS_TMP.nro_caja
  is 'Numero de caja.';
comment on column IT.GE_MOVIMIENTOS_TMP.cotizacion
  is 'Cotizacion.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_bco_central
  is 'Codigo en el BCP.';
comment on column IT.GE_MOVIMIENTOS_TMP.nro_documento
  is 'Numero de documento.';
comment on column IT.GE_MOVIMIENTOS_TMP.nro_documento2
  is 'Numero de documento.';
comment on column IT.GE_MOVIMIENTOS_TMP.nro_documento3
  is 'Numero de documento.';
comment on column IT.GE_MOVIMIENTOS_TMP.nro_documento4
  is 'Numero de documento.';
comment on column IT.GE_MOVIMIENTOS_TMP.protegido
  is 'Protegido. (N=NO / S=SI).';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_autorizacion
  is 'Numero de autorizacion.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_usu_autorizador
  is 'Codigo de autorizacion.';
comment on column IT.GE_MOVIMIENTOS_TMP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_MOVIMIENTOS_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_MOVIMIENTOS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_MOVIMIENTOS_TMP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_MOVIMIENTOS_TMP.tip_mov_rubro
  is 'Tipo de movimiento.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_tip_ope_cambio
  is 'Codigo de tipo de operacion de cambio.';
comment on column IT.GE_MOVIMIENTOS_TMP.referencia
  is 'Referencia general.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_persona
  is 'Persona asociada al movimiento.';
comment on column IT.GE_MOVIMIENTOS_TMP.cod_sit_contable
  is 'Indica la Situacion Contable actual de la Operacion. ';
comment on column IT.GE_MOVIMIENTOS_TMP.nro_conciliacion
  is 'Número Secuencia Extracto Swift.';
comment on column IT.GE_MOVIMIENTOS_TMP.tab_referencia
  is 'Tabla de referencia Movimiento histórico.';
comment on column IT.GE_MOVIMIENTOS_TMP.procesado
  is 'Procesado. (N=NO / S=SI).';
-- Create/Recreate indexes 
create index IT.IN_GMOVI_NRO_MOVIMIENTO on IT.GE_MOVIMIENTOS_TMP (FECHA, HORA, NRO_SECUENCIA, COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

