create table IT.GE_COTIZACIONES
(
  cod_moneda            VARCHAR2(3) not null,
  fecha                 DATE not null,
  val_conversion        NUMBER(14,8) default 1,
  val_compra            NUMBER(14,8) default 0,
  val_venta             NUMBER(14,8) default 0,
  val_ven_cheque        NUMBER(14,8) default 0,
  val_com_cheque        NUMBER(14,8) default 0,
  val_com_electronica   NUMBER(14,8) default 0,
  val_ven_electronica   NUMBER(14,8) default 0,
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default SYSDATE not null,
  val_com_interbancaria NUMBER(14,8) default 0,
  val_ven_interbancaria NUMBER(14,8) default 0,
  val_com_autorizador   NUMBER(14,8),
  val_ven_autorizador   NUMBER(14,8)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_COTIZACIONES
  is 'Cotizaciones.';
comment on column IT.GE_COTIZACIONES.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.GE_COTIZACIONES.fecha
  is 'Fecha de cotizacion.';
comment on column IT.GE_COTIZACIONES.val_conversion
  is 'Valor de conversion.';
comment on column IT.GE_COTIZACIONES.val_compra
  is 'Valor Compra de Efectivo.';
comment on column IT.GE_COTIZACIONES.val_venta
  is 'Valor Venta de Efectivo.';
comment on column IT.GE_COTIZACIONES.val_ven_cheque
  is 'Valor de Venta de Cheque.';
comment on column IT.GE_COTIZACIONES.val_com_cheque
  is 'Valor de Compra de Cheque.';
comment on column IT.GE_COTIZACIONES.val_com_electronica
  is 'Valor de Compra para Banca Electrsnica.';
comment on column IT.GE_COTIZACIONES.val_ven_electronica
  is 'Valor de Venta para Banca Electrsnica.';
comment on column IT.GE_COTIZACIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_COTIZACIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_COTIZACIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_COTIZACIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_COTIZACIONES.val_com_interbancaria
  is 'Valor de Compra para Operaciones Interbancarias Recibidas.';
comment on column IT.GE_COTIZACIONES.val_ven_interbancaria
  is 'Valor de Venta para Operaciones Interbancarias Recibidas.';
comment on column IT.GE_COTIZACIONES.val_com_autorizador
  is 'Valor de Compra Autorizador.';
comment on column IT.GE_COTIZACIONES.val_ven_autorizador
  is 'Valor de Venta Autorizador.';
alter table IT.GE_COTIZACIONES
  add constraint PK_GE_COTIZACIONES primary key (COD_MONEDA, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_COTIZACIONES
  add constraint FK_GCOTI_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);

