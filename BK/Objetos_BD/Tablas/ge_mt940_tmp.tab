create table IT.GE_MT940_TMP
(
  nro_orden VARCHAR2(10),
  texto     VARCHAR2(1000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_MT940_TMP
  is 'Datos Leidos del MT940 por Líneas.';
comment on column IT.GE_MT940_TMP.nro_orden
  is 'Número de Línea.';
comment on column IT.GE_MT940_TMP.texto
  is 'Texto.';

