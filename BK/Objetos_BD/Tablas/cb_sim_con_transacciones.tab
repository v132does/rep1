create table IT.CB_SIM_CON_TRANSACCIONES
(
  fecha            DATE,
  cod_mod_padre    NUMBER(3),
  cod_mad_padre    NUMBER(3),
  cod_ofi_origen   NUMBER(3),
  cod_oficina      NUMBER(3),
  cod_moneda       VARCHAR2(3),
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  cod_transaccion  NUMBER(4),
  cod_sector       VARCHAR2(1),
  cod_tip_deudor   NUMBER(2),
  residente        VARCHAR2(1),
  cod_plazo        NUMBER(1),
  cantidad         NUMBER(8),
  total            NUMBER(18,2),
  tot_mon_local    NUMBER(22,2),
  nro_referencia   NUMBER(7),
  est_cuenta       VARCHAR2(1),
  tip_cuenta       VARCHAR2(1),
  tip_interes      VARCHAR2(1),
  tip_renovacion   VARCHAR2(1),
  cat_automatica   NUMBER(3,2),
  fec_valor        DATE,
  cod_tra_padre    NUMBER(4),
  cod_sit_contable NUMBER(20),
  nro_cuenta       VARCHAR2(20),
  concepto         VARCHAR2(100),
  cod_sec_rubro    VARCHAR2(3),
  reversado        VARCHAR2(1),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SIM_CON_TRANSACCIONES
  is 'Consolidado de Transacciones';
comment on column IT.CB_SIM_CON_TRANSACCIONES.fecha
  is 'Fecha de Transacci¿n.';
