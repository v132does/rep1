comment on column IT.CB_SIM_CON_TRANSACCIONES.cod_tip_deudor
  is 'Tipo de deudor. ( ).';
comment on column IT.CB_SIM_CON_TRANSACCIONES.residente
  is 'IND_RESIDENTE. (N=NO / S=SI).';
comment on column IT.CB_SIM_CON_TRANSACCIONES.cod_plazo
  is 'C¿digo de Plazo.';
comment on column IT.CB_SIM_CON_TRANSACCIONES.cantidad
  is 'Cantidad de transacciones.';
comment on column IT.CB_SIM_CON_TRANSACCIONES.total
  is 'Total de la transacci¿n.';
comment on column IT.CB_SIM_CON_TRANSACCIONES.tot_mon_local
