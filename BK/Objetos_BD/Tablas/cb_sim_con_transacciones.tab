create index IT.IN_SCTRA_FECHA on IT.CB_SIM_CON_TRANSACCIONES (FECHA, NRO_REFERENCIA)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_SCTRA_FECHA1 on IT.CB_SIM_CON_TRANSACCIONES (FECHA, COD_TRANSACCION, COD_MONEDA, COD_OFI_ORIGEN, COD_OFICINA, COD_MAD_PADRE, COD_MODALIDAD, COD_SECTOR, COD_TIP_DEUDOR, RESIDENTE, COD_PLAZO, REVERSADO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_SIM_CON_TRANSACCIONES
  add constraint FK_SCTRA_COD_MOD_PADRE foreign key (COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.CB_SIM_CON_TRANSACCIONES
  add constraint FK_SCTRA_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CB_SIM_CON_TRANSACCIONES
  add constraint FK_SCTRA_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CB_SIM_CON_TRANSACCIONES
  add constraint FK_SCTRA_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CB_SIM_CON_TRANSACCIONES
  add constraint FK_SCTRA_COD_TRANSACCIONES foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);

