alter table IT.TA_CTA_TARJETAS_CRM
  add constraint PK_TA_CTA_TARJETAS_CRM primary key (FEC_MODIFICACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

