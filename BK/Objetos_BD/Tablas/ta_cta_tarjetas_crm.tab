create table IT.TA_CTA_TARJETAS_CRM
(
  nro_cuenta           VARCHAR2(15) not null,
  denominacion         VARCHAR2(65),
  cod_modulo           NUMBER(3),
  cod_modalidad        NUMBER(3),
  cod_oficina          NUMBER(3),
  cod_moneda           VARCHAR2(3),
  lin_credito          NUMBER(18,2),
  lin_cuotas           NUMBER(18,2),
  sal_facturar         NUMBER(18,2),
  sal_facturado        NUMBER(18,2),
  sal_financiado       NUMBER(18,2),
  sal_ult_extracto     NUMBER(18,2),
  sal_cuo_pendientes   NUMBER(18,2),
  mto_pag_minimo       NUMBER(18,2),
  sal_pag_minimo       NUMBER(18,2),
  mto_mora             NUMBER(18,2),
  dia_mora             NUMBER(14,2),
  mto_autorizaciones   NUMBER(18,2),
  mto_int_compras      NUMBER(18,2),
  mto_pag_mes          NUMBER(18,2),
  mto_gas_mora         NUMBER(18,2),
  estado               VARCHAR2(1),
  est_administradora   VARCHAR2(1),
  fec_solicitud        DATE,
  fec_apertura         DATE,
  fec_ult_pago         DATE,
  fec_ult_compra       DATE,
  fec_ult_operacion    DATE,
  fec_ult_extracto     DATE,
  fec_ult_cierre       DATE,
  fec_vct_ult_cierre   DATE,
  cod_tip_cierre       NUMBER(2),
  cob_gas_financiero   VARCHAR2(1),
  tip_tas_financiacion VARCHAR2(1),
  tip_com_emision      VARCHAR2(1),
  tas_financiacion     NUMBER(20,4),
  tas_adelanto         NUMBER(20,4),
  tas_mora             NUMBER(20,4),
  tas_cuotas           NUMBER(20,4),
  deb_automatico       VARCHAR2(1),
  tip_cobro            VARCHAR2(1),
  nro_cta_debito       VARCHAR2(15),
  mto_min_pago         NUMBER(18,2),
  por_pag_minimo       NUMBER(5,2),
  cod_usu_promotor     VARCHAR2(10),
  mar_mora             VARCHAR2(1),
  mar_excedido         VARCHAR2(1),
  mar_recuperado       VARCHAR2(1),
  mar_bloqueo          VARCHAR2(1),
  con_costo            VARCHAR2(1),
  nro_solicitud        NUMBER(15),
  cod_causa            NUMBER(3),
  cod_canal            NUMBER(3),
  cod_campana          NUMBER(3),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     TIMESTAMP(6) default current_timestamp not null,
  cat_automatica       NUMBER(2),
  fec_juicio           DATE,
  cod_ent_juicio       NUMBER(5),
  max_atraso           NUMBER(5),
  pro_atraso           NUMBER(5),
  nro_linea            NUMBER(7),
  en_juicio            VARCHAR2(1),
  cat_aut_anterior     NUMBER(2),
  fec_activacion       DATE,
  fec_cancelacion      DATE,
  tas_efectiva         NUMBER(20,4),
  mto_aut_cuotas       NUMBER(18,2),
  afinidad             VARCHAR2(10),
  sub_afinidad         VARCHAR2(3),
  sal_procesadora      NUMBER(18,2),
  cod_rub_economico    VARCHAR2(6),
  tip_plastico         VARCHAR2(1),
  mto_fij_pag_minimo   NUMBER(18,2),
  mto_min_pag_minimo   NUMBER(18,2),
  tas_int_corriente    NUMBER(18,2),
  tas_int_compra       NUMBER(18,2),
  tas_int_mora         NUMBER(18,2),
  tip_accion           VARCHAR2(1),
  car_no_aplicar       VARCHAR2(30)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_CTA_TARJETAS_CRM
  is 'Es la tabla maestra de Cuentas de Tarjetas ** No se borran los datos **';
comment on column IT.TA_CTA_TARJETAS_CRM.nro_cuenta
  is 'Número de la Cuenta de Tarjeta.';
