    maxextents unlimited
  );
create index IT.IN_COR_RUB_HIS_PROCESO on IT.CB_COR_RUB_DET_HIS (MOV_CUADRE, FEC_CONCILIACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 4M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_COR_RUB_DET_HIS
  add constraint PK_CB_COR_RUB_DET_HIS primary key (FECHA, COD_OFICINA, NRO_ASIENTO, NRO_LINEA, PK_MOVIMIENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

