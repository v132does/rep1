  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 3M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_COR_RUB_HIS_MOV_CUADRE on IT.CB_COR_RUB_DET_HIS (MOV_CUADRE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 3M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_COR_RUB_HIS_NRO_ASIENTO on IT.CB_COR_RUB_DET_HIS (NRO_ASIENTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 3M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_COR_RUB_HIS_NRO_LINEA on IT.CB_COR_RUB_DET_HIS (NRO_LINEA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 3M
