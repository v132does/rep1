create table IT.PR_DEVENGADOS_HIS
(
  nro_cuenta       VARCHAR2(15) not null,
  ano              NUMBER(4) not null,
  mes              NUMBER(2) not null,
  mto_interes      NUMBER(18,2) default 0 not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  cod_oficina      NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  dev_no_cobrado   NUMBER(18,2) default 0,
  dev_suspenso     NUMBER(18,2) default 0,
  dev_ganancia     NUMBER(18,2) default 0,
  dev_recuperado   NUMBER(18,2) default 0,
  sal_dev_acu_mes  NUMBER(18,2) default 0,
  sal_dev_noc_mes  NUMBER(18,2) default 0,
  sal_dev_sus_mes  NUMBER(18,2) default 0
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_DEVENGADOS_HIS
  is 'Contiene datos de los Intereses Devengados de Préstamos** Mantener dos años completos **.';
comment on column IT.PR_DEVENGADOS_HIS.nro_cuenta
  is 'Número de cuenta.';
comment on column IT.PR_DEVENGADOS_HIS.ano
  is 'Año del devengamiento.';
comment on column IT.PR_DEVENGADOS_HIS.mes
  is 'Mes del devengamiento.';
comment on column IT.PR_DEVENGADOS_HIS.mto_interes
  is 'Valor del interés devengado.';
comment on column IT.PR_DEVENGADOS_HIS.cod_modulo
  is 'Código de Módulo de la cuenta.';
comment on column IT.PR_DEVENGADOS_HIS.cod_modalidad
  is 'Código de modalidad de la cuenta.';
comment on column IT.PR_DEVENGADOS_HIS.cod_oficina
  is 'Código de oficina de la cuenta.';
comment on column IT.PR_DEVENGADOS_HIS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_DEVENGADOS_HIS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_DEVENGADOS_HIS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_DEVENGADOS_HIS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_DEVENGADOS_HIS.dev_no_cobrado
  is 'Monto total devengado en el mes.';
comment on column IT.PR_DEVENGADOS_HIS.dev_suspenso
  is 'Monto total devengado en suspenso.';
comment on column IT.PR_DEVENGADOS_HIS.dev_ganancia
  is 'Monto devengado enviado a utilidad, incluye el devengado no cobrado.';
comment on column IT.PR_DEVENGADOS_HIS.dev_recuperado
  is 'Monto devengado recuperado en el mes.';
comment on column IT.PR_DEVENGADOS_HIS.sal_dev_acu_mes
  is 'Saldo devengado acumulado de la cuenta a fin de mes.';
comment on column IT.PR_DEVENGADOS_HIS.sal_dev_noc_mes
  is 'Saldo devengado no cobrado de la cuenta a fin de mes.';
comment on column IT.PR_DEVENGADOS_HIS.sal_dev_sus_mes
  is 'Saldo devengado suspenso de la cuenta a fin de mes.';
alter table IT.PR_DEVENGADOS_HIS
  add constraint PK_PR_DEVENGADOS_HIS primary key (NRO_CUENTA, ANO, MES)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_DEVENGADOS_HIS
  add constraint AVCON_1117224857_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.PR_DEVENGADOS_HIS
  add constraint AVCON_1117224857_COD_O_002
  check (COD_OFICINA BETWEEN 0 AND 999);

