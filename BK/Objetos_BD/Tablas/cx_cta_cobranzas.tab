-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.CX_CTA_COBRANZAS
  add constraint PK_CX_COBRANZAS primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_BCO_CORRESP foreign key (COD_BCO_CORRESPONSAL)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_CAU_CANCELA foreign key (COD_CAU_CANCELACION)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_CIU_BENEFICIARIO foreign key (COD_CIU_BENEFICIARIO, COD_PAI_BENEFICIARIO)
  references IT.BA_CIUDADES (COD_CIUDAD, COD_PAIS);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_CIU_PAGADOR foreign key (COD_CIU_PAGADOR, COD_PAI_PAGADOR)
  references IT.BA_CIUDADES (COD_CIUDAD, COD_PAIS);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_PAI_BENEFICIARIO foreign key (COD_PAI_BENEFICIARIO)
  references IT.BA_PAISES (COD_PAIS);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_PAI_PAGADOR foreign key (COD_PAI_PAGADOR)
  references IT.BA_PAISES (COD_PAIS);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_PER_BENEFICIARIO foreign key (COD_PER_BENEFICIARIO)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_COD_PER_PAGADOR foreign key (COD_PER_PAGADOR)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.CX_CTA_COBRANZAS
  add constraint FK_XCCOB_NRO_SOLICITUD foreign key (NRO_SOL_PRESTAMO)
  references IT.PR_SOLICITUDES (NRO_SOLICITUD);
-- Create/Recreate check constraints 
alter table IT.CX_CTA_COBRANZAS
  add constraint CK_XCCOB_PERSONA
  check ((COD_MODALIDAD = 83 AND COD_PER_PAGADOR IS NOT NULL) OR (COD_MODALIDAD = 84 AND COD_PER_BENEFICIARIO IS NOT NULL));