create table IT.MD_PARTITIONS
(
  id                   NUMBER not null,
  table_id_fk          NUMBER not null,
  native_sql           CLOB,
  partition_expression VARCHAR2(4000),
  comments             VARCHAR2(4000),
  security_group_id    NUMBER default 0 not null,
  created_by           VARCHAR2(255),
  created_on           DATE default sysdate not null,
  last_updated_by      VARCHAR2(255),
  last_updated_on      DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MD_PARTITIONS
  is 'Partition information is stored in this table.';
comment on column IT.MD_PARTITIONS.id
  is 'Primary Key';
comment on column IT.MD_PARTITIONS.table_id_fk
  is 'The table that this partition refers to //PARENTFIELD';
comment on column IT.MD_PARTITIONS.native_sql
  is 'The SQL used to create this partition at source';
comment on column IT.MD_PARTITIONS.partition_expression
  is 'The partition expression';
alter table IT.MD_PARTITIONS
  add constraint MD_PARTITIONS_PK primary key (ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.MD_PARTITIONS
  add constraint MD_PARTITIONS_MD_TABLES_FK1 foreign key (TABLE_ID_FK)
  references IT.MD_TABLES (ID) on delete cascade;

