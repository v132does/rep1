create table IT.CV_ORDEN
(
  cod_orden        NUMBER(3) not null,
  descripcion      VARCHAR2(50),
  cod_seccion      NUMBER(3),
  estado           VARCHAR2(1),
  val_incluidos    VARCHAR2(100),
  abreviatura      VARCHAR2(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CV_ORDEN
  is 'Orden de Letras del Mueble del Archivo Físico.';
comment on column IT.CV_ORDEN.cod_orden
  is 'Código del Orden de la Custodia.';
comment on column IT.CV_ORDEN.descripcion
  is 'Descripción del Orden.';
comment on column IT.CV_ORDEN.cod_seccion
  is 'Sección del Orden.';
comment on column IT.CV_ORDEN.estado
  is 'Estado del Orden.A=Activo,I=Inactivo.';
comment on column IT.CV_ORDEN.val_incluidos
  is 'Lista de valores que corresponden al Orden (letras).';
comment on column IT.CV_ORDEN.abreviatura
  is 'Abreviatura para Código de Barras.';
comment on column IT.CV_ORDEN.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CV_ORDEN.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CV_ORDEN.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CV_ORDEN.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CV_ORDEN
  add constraint PK_CV_ORDEN primary key (COD_ORDEN)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CV_ORDEN
  add constraint FK_CVORD_COD_SECCION foreign key (COD_SECCION)
  references IT.CV_SECCIONES (COD_SECCION);

