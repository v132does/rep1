create table IT.LC_OPE_PENDIENTES_HIS
(
  nro_operacion       NUMBER(7) not null,
  cod_tip_operacion   VARCHAR2(3) not null,
  referenciado        VARCHAR2(1) default 'N' not null,
  cod_tip_referencia  VARCHAR2(3),
  nro_referencia      NUMBER(10) default 0,
  cod_tip_ope_bcp     VARCHAR2(6),
  cod_moneda          VARCHAR2(3) not null,
  cod_persona         VARCHAR2(10),
  cod_oficina         NUMBER(3) not null,
  fec_operacion       DATE not null,
  monto               NUMBER(18,2) default 0 not null,
  cotizacion          NUMBER(14,8) not null,
  mto_equ_local       NUMBER(18,2) default 0 not null,
  cta_referencia      VARCHAR2(15),
  cod_tra_cargo1      NUMBER(4),
  mto_cargo1          NUMBER(18,2) default 0,
  cod_tra_cargo2      NUMBER(4),
  mto_cargo2          NUMBER(18,2) default 0,
  cod_tra_cargo3      NUMBER(4),
  mto_cargo3          NUMBER(18,2) default 0,
  cod_tra_cargo4      NUMBER(4),
  mto_cargo4          NUMBER(18,2) default 0,
  cta_ref_contra1     VARCHAR2(15),
  mto_contra1         NUMBER(18,2) default 0,
  cta_ref_contra2     VARCHAR2(15),
  mto_contra2         NUMBER(18,2) default 0,
  cta_ref_contra3     VARCHAR2(15),
  mto_contra3         NUMBER(18,2) default 0,
  cta_ref_contra4     VARCHAR2(15),
  mto_contra4         NUMBER(18,2) default 0,
  nro_cuenta          VARCHAR2(15) not null,
  nro_cta_bancaria    VARCHAR2(15),
  nro_cheque          VARCHAR2(15),
  nro_boleta          NUMBER(15),
  concepto            VARCHAR2(35),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  observacion         VARCHAR2(1000),
  nro_documento       VARCHAR2(20) not null,
  liquidado           VARCHAR2(1) default 'N' not null,
  cod_usu_liquidacion VARCHAR2(10),
  fec_liquidacion     DATE,
  cta_ref_contra5     VARCHAR2(15),
  mto_contra5         NUMBER(18,2) default 0,
  cod_retencion       NUMBER(3),
  nro_diario          NUMBER(3) default 0,
  ope_homebanking     VARCHAR2(1) default 'N',
  cod_mon_destino     VARCHAR2(3),
  usu_anulacion       VARCHAR2(10) not null,
  fec_anulacion       DATE default SYSDATE not null,
  cierre              VARCHAR2(1) default 'N'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.LC_OPE_PENDIENTES_HIS.nro_operacion
  is 'Numero de operacion identificadora.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_tip_operacion
  is 'Codigo del tipo de operacion de cambios.';
comment on column IT.LC_OPE_PENDIENTES_HIS.referenciado
  is 'Referenciado por otra operacion S/N.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_tip_referencia
  is 'Codigo del tipo de referencia de la operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.nro_referencia
  is 'Numero del tipo referencia.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_tip_ope_bcp
  is 'Codigo de BCP asignado al Tipo de Operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_moneda
  is 'Codigo de moneda de la operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_persona
  is 'Codigo del cliente  de la operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.LC_OPE_PENDIENTES_HIS.fec_operacion
  is 'Fecha de emision de la operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.monto
  is 'Monto de la operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cotizacion
  is 'Cotizacion de la operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.mto_equ_local
  is 'Monto equivalente en moneda local.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cta_referencia
  is 'Cuenta Debito/Credito a la que hace referencia la operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_tra_cargo1
  is 'Codigo de cargo.';
comment on column IT.LC_OPE_PENDIENTES_HIS.mto_cargo1
  is 'Monto del cargo.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_tra_cargo2
  is 'Codigo de cargo.';
comment on column IT.LC_OPE_PENDIENTES_HIS.mto_cargo2
  is 'Monto del cargo.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_tra_cargo3
  is 'Codigo de cargo.';
comment on column IT.LC_OPE_PENDIENTES_HIS.mto_cargo3
  is 'Monto del cargo.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_tra_cargo4
  is 'Codigo de cargo.';
comment on column IT.LC_OPE_PENDIENTES_HIS.mto_cargo4
  is 'Monto del cargo.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cta_ref_contra1
  is 'Contra cuenta de la operacion (efectivo).';
comment on column IT.LC_OPE_PENDIENTES_HIS.mto_contra1
  is 'Monto o valor de la contra cuenta (efectivo).';
comment on column IT.LC_OPE_PENDIENTES_HIS.cta_ref_contra2
  is 'Contra cuenta de la operacion (cheque).';
comment on column IT.LC_OPE_PENDIENTES_HIS.mto_contra2
  is 'Monto o valor de la contra cuenta (cheque).';
comment on column IT.LC_OPE_PENDIENTES_HIS.cta_ref_contra3
  is 'Contra cuenta de la operacion (Cuenta Cliente).';
comment on column IT.LC_OPE_PENDIENTES_HIS.mto_contra3
  is 'Monto o valor de la contra cuenta (Cuenta Cliente).';
comment on column IT.LC_OPE_PENDIENTES_HIS.cta_ref_contra4
  is 'Contra cuenta de la operacion (Cuenta Contable).';
comment on column IT.LC_OPE_PENDIENTES_HIS.mto_contra4
  is 'Monto o valor de la contra cuenta (Cuenta Contable).';
comment on column IT.LC_OPE_PENDIENTES_HIS.nro_cuenta
  is 'Numero de Cuenta de Cambios.';
comment on column IT.LC_OPE_PENDIENTES_HIS.nro_cta_bancaria
  is 'Cuenta corriente corresponsal.';
comment on column IT.LC_OPE_PENDIENTES_HIS.nro_cheque
  is 'Numero de cheque.';
comment on column IT.LC_OPE_PENDIENTES_HIS.nro_boleta
  is 'Numero deposito.';
comment on column IT.LC_OPE_PENDIENTES_HIS.concepto
  is 'Concepto.';
comment on column IT.LC_OPE_PENDIENTES_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.LC_OPE_PENDIENTES_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.LC_OPE_PENDIENTES_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.LC_OPE_PENDIENTES_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.LC_OPE_PENDIENTES_HIS.observacion
  is 'Observacion sobre la operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.nro_documento
  is 'Numero de documento del cliente.';
comment on column IT.LC_OPE_PENDIENTES_HIS.liquidado
  is 'Indica si la operacion ya fue liquidada.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_usu_liquidacion
  is 'Usuario que realizo la liquidacion de la operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.fec_liquidacion
  is 'Fecha en que se liquida la operacion.';
comment on column IT.LC_OPE_PENDIENTES_HIS.cta_ref_contra5
  is 'Contra cuenta de la operacion (cheque nuestro banco).';
comment on column IT.LC_OPE_PENDIENTES_HIS.mto_contra5
  is 'Monto o valor de la contra cuenta (cheque nuestro banco).';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_retencion
  is 'Codigo de retencion. Ver tabla de Codigos de retenciones.';
comment on column IT.LC_OPE_PENDIENTES_HIS.nro_diario
  is 'El Número de Operación diaria ';
comment on column IT.LC_OPE_PENDIENTES_HIS.ope_homebanking
  is 'La Operación para retomar vía Home Banking S|N';
comment on column IT.LC_OPE_PENDIENTES_HIS.cod_mon_destino
  is 'Código de la Moneda destino de la Operación ';
comment on column IT.LC_OPE_PENDIENTES_HIS.usu_anulacion
  is 'Usuario que realizó la anulación de la operación.';
comment on column IT.LC_OPE_PENDIENTES_HIS.fec_anulacion
  is 'Fecha en que se realizó la anulación de la operación';
comment on column IT.LC_OPE_PENDIENTES_HIS.cierre
  is 'Indica si la operación fue anulada en el cierre.';
alter table IT.LC_OPE_PENDIENTES_HIS
  add constraint PK_LC_OPE_ANULADAS primary key (NRO_OPERACION, FEC_ANULACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

