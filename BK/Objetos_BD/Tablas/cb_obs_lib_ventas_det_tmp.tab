alter table IT.CB_OBS_LIB_VENTAS_DET_TMP
  add constraint PK_CB_OBS_LIB_VENTAS_DET_TMP primary key (FECHA, HORA, COD_USUARIO, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_OBS_LIB_VENTAS_DET_TMP
  add constraint FK_BOLVD_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CB_OBS_LIB_VENTAS_DET_TMP
  add constraint FK_BOLVD_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CB_OBS_LIB_VENTAS_DET_TMP
  add constraint FK_BOLVD_COD_TRA_PADRE foreign key (COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.CB_OBS_LIB_VENTAS_DET_TMP
  add constraint FK_BOLVD_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);

