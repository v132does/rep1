create index IT.IN_BOLVD_COD_TRA_PADRE on IT.CB_OBS_LIB_VENTAS_DET_TMP (COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE)
  tablespace IT_IND
