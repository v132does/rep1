alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_USU_AUTORIZADOR foreign key (COD_USU_AUTORIZADOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_USU_REVERSION foreign key (COD_USU_REVERSION)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_NRO_CAJA foreign key (NRO_CAJA)
  references IT.CJ_CAJAS (NRO_CAJA);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_COD_B_003
  check (COD_BANCO BETWEEN 0 AND 999);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_COD_C_001
  check (COD_CAUSA BETWEEN 0 AND 999);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_COD_M_011
  check (COD_MAD_PADRE BETWEEN 0 AND 999);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_COD_M_012
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_COD_M_013
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_COD_O_004
  check (COD_OFI_ORIGEN BETWEEN 0 AND 999);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_COD_R_001
  check (COD_RETENCION BETWEEN 0 AND 999);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_COD_T_002
  check (COD_TASA BETWEEN 0 AND 999);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_EMI_A_000
  check (EMI_AVISO IN ('S', 'N'));
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_PROTE_001
  check (PROTEGIDO IN ('S', 'N'));
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_REVER_000
  check (REVERSADO IN ('S', 'N'));
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint AVCON_2083072595_TIP_M_000
  check (TIP_MOV_RUBRO IN ('D', 'C'));

