alter table IT.TA_MOVIMIENTOS_HIS
  add constraint PK_TA_MOVIMIENTOS_HIS primary key (FECHA, HORA, COD_USUARIO, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_BANCO foreign key (COD_BANCO)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_CAUSAL foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_RETENCION foreign key (COD_RETENCION)
  references IT.GE_RETENCIONES (COD_RETENCION);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_TRA_HIJO foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_TRA_PADRE foreign key (COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.TA_MOVIMIENTOS_HIS
  add constraint FK_TMHIS_COD_USUARIO foreign key (COD_USUARIO)
