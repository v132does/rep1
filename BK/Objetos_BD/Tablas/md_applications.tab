create table IT.MD_APPLICATIONS
(
  id                NUMBER not null,
  name              VARCHAR2(4000),
  description       VARCHAR2(4000),
  base_dir          VARCHAR2(4000),
  output_dir        VARCHAR2(4000),
  backup_dir        VARCHAR2(4000),
  inplace           NUMBER,
  project_id_fk     NUMBER not null,
  security_group_id NUMBER default 0 not null,
  created_on        DATE default sysdate not null,
  created_by        VARCHAR2(255),
  last_updated_on   DATE,
  last_updated_by   VARCHAR2(255)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MD_APPLICATIONS
  is 'This is the base table for application projects.  It holds the base information for applications associated with a database';
comment on column IT.MD_APPLICATIONS.id
  is 'Primary Key';
comment on column IT.MD_APPLICATIONS.name
  is 'Name of the application suite  //OBJECTNAME';
comment on column IT.MD_APPLICATIONS.description
  is 'Overview of what the application does.';
comment on column IT.MD_APPLICATIONS.base_dir
  is 'This is the base src directory for the application.  It could be an svn checkout, a clearcase view or something similar';
comment on column IT.MD_APPLICATIONS.output_dir
  is 'This is the output directory where the scanner will present the converted files, if there are converted or modified.';
comment on column IT.MD_APPLICATIONS.backup_dir
  is 'This is the directory in which the application files are backed up if a backp is chosen';
comment on column IT.MD_APPLICATIONS.inplace
  is 'Designates whether the changes have been made inplace, in the source directory or not';
comment on column IT.MD_APPLICATIONS.project_id_fk
  is 'project of the database(s) this application relates to';
alter table IT.MD_APPLICATIONS
  add constraint MD_APPLICATIONS_PK primary key (ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.MD_APPLICATIONS
  add constraint MD_APP_PROJ_FK foreign key (PROJECT_ID_FK)
  references IT.MD_PROJECTS (ID) on delete cascade;

