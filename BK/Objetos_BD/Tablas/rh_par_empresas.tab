create table IT.RH_PAR_EMPRESAS
(
  cod_empresa                  VARCHAR2(10) not null,
  cod_per_responsable          VARCHAR2(10),
  ind_apo_ips_caja             VARCHAR2(1) default 'N',
  pat_ips_01                   NUMBER(15),
  pat_ips_02                   NUMBER(15),
  por_ips_emp                  NUMBER(5,3),
  por_ips_pat                  NUMBER(5,3),
  cod_ban_caja                 VARCHAR2(10),
  por_caj_emp                  NUMBER(5,3),
  por_caj_pat                  NUMBER(5,3),
  por_caj_emp_act              NUMBER(5,3),
  por_caj_pat_act              NUMBER(5,3),
  por_caj_ret_snpp             NUMBER(5,3),
  ano_actual                   NUMBER(4),
  mes_actual                   NUMBER(2),
  qui_actual                   NUMBER(1),
  por_descuentos               NUMBER(10),
  por_bonificacion             NUMBER(8,2),
  fec_ult_cierre               DATE,
  min_tolerancia               NUMBER(5) default 0,
  nro_mjt                      NUMBER(15),
  cod_tip_des_ips              NUMBER(3),
  cod_tip_des_caja             NUMBER(3),
  cod_tip_des_fondo            NUMBER(3),
  cod_tip_ing_vacacion         NUMBER(3),
  cod_tip_ing_vac_proporcional NUMBER(3),
  cod_tip_ing_sueldo           NUMBER(3),
  cod_tip_ing_bonificacion     NUMBER(3),
  cod_tip_ing_preaviso         NUMBER(3),
  cod_tip_ing_indemnizacion    NUMBER(3),
  cod_tip_ing_normal           NUMBER(3),
  cod_tip_ing_extras           NUMBER(3),
  cod_tip_ing_30               NUMBER(3),
  cod_tip_ing_50               NUMBER(3),
  cod_tip_ing_100              NUMBER(3),
  cod_tip_ing_130              NUMBER(3),
  cod_tip_ing_aguinaldo        NUMBER(3),
  cod_tip_ing_comision         NUMBER(3),
  cod_tip_ing_destajo          NUMBER(3),
  cod_tip_prov_vacacion        VARCHAR2(3),
  cod_tip_prov_aguinaldo       VARCHAR2(3),
  cod_tur_administrativo       NUMBER(3),
  cod_tip_des_pri_sueldo       NUMBER(3),
  cod_tip_des_aumento          NUMBER(3),
  cod_tip_ing_titulo           NUMBER(3),
  cod_tip_ing_antiguedad       NUMBER(3),
  cod_tip_ing_cargo            NUMBER(3),
  cod_tip_ing_representacion   NUMBER(3),
  cod_tip_ing_gratificacion    NUMBER(3),
  fec_insercion                DATE default SYSDATE not null,
  usu_modificacion             VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion             DATE default SYSDATE not null,
  usu_insercion                VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  cod_tip_des_renuncia         NUMBER(3),
  cod_tip_ing_aumento          NUMBER(3),
  cod_tip_des_pat_ips          NUMBER(3),
  cod_tip_des_pat_caja         NUMBER(3),
  cod_tip_des_pat_fondo        NUMBER(3),
  cod_tip_des_pat_snpp         NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_PAR_EMPRESAS
  is 'Parametros del Modulo de RRHH para las Empresas.';
comment on column IT.RH_PAR_EMPRESAS.cod_empresa
  is 'Codigo de la Empresa.';
comment on column IT.RH_PAR_EMPRESAS.cod_per_responsable
  is 'Responsable por la Empresa.';
comment on column IT.RH_PAR_EMPRESAS.ind_apo_ips_caja
  is 'Indica si se aporta a IPS o a la Caja.';
comment on column IT.RH_PAR_EMPRESAS.pat_ips_01
  is 'Nro. Patronal IPS (Principal).';
comment on column IT.RH_PAR_EMPRESAS.pat_ips_02
  is 'Nro. Patronal IPS (Secundario).';
comment on column IT.RH_PAR_EMPRESAS.por_ips_emp
  is 'Porcentaje que abona al IPS el Empleado.';
comment on column IT.RH_PAR_EMPRESAS.por_ips_pat
  is 'Porcentaje que aporte al IPS la Patronal.';
comment on column IT.RH_PAR_EMPRESAS.cod_ban_caja
  is 'Codigo del Banco en la Caja.';
comment on column IT.RH_PAR_EMPRESAS.por_caj_emp
  is 'Porcentaje que aporta el Empleado a la caja.';
comment on column IT.RH_PAR_EMPRESAS.por_caj_pat
  is 'Porcentaje que aporta la Patronal a la Caja.';
comment on column IT.RH_PAR_EMPRESAS.por_caj_emp_act
  is 'Porcentaje que aporta el Empleado para el fondo de Actualizacion de la Caja.';
comment on column IT.RH_PAR_EMPRESAS.por_caj_pat_act
  is 'Porcentaje que aporta la Patronal para el fondo de Actualizacion de la Caja.';
comment on column IT.RH_PAR_EMPRESAS.por_caj_ret_snpp
  is 'Porcentaje de Retencion para el SNPP.';
comment on column IT.RH_PAR_EMPRESAS.ano_actual
  is 'Año Actual.';
comment on column IT.RH_PAR_EMPRESAS.mes_actual
  is 'Mes Actual.';
comment on column IT.RH_PAR_EMPRESAS.qui_actual
  is 'Quincena Actual.';
comment on column IT.RH_PAR_EMPRESAS.por_descuentos
  is 'Porcentaje de Descuento Judicial.';
comment on column IT.RH_PAR_EMPRESAS.por_bonificacion
  is 'Porcentaje Bonificacion Familiar.';
comment on column IT.RH_PAR_EMPRESAS.fec_ult_cierre
  is 'Fecha en que ser realizo el ultimo proceso de cierre.';
comment on column IT.RH_PAR_EMPRESAS.min_tolerancia
  is 'Minutos de Tolerancia por llegada tardia.';
comment on column IT.RH_PAR_EMPRESAS.nro_mjt
  is 'Numero de la Empresa en el Ministerio de Justicia y Trabajo.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_des_ips
  is 'Codigo del Tipo Descuento para IPS.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_des_caja
  is 'Codigo del Tipo Descuento para la Caja.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_des_fondo
  is 'Codigo del Tipo Descuento para el fondo de inversion de la Caja.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_vacacion
  is 'Tipo de Ingreso por Vacaciones.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_vac_proporcional
  is 'Tipo de Ingreso para las Vacaciones Proporcionales.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_sueldo
  is 'Tipo de Ingreso por Sueldo Basico.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_bonificacion
  is 'Tipo de Ingreso por Bonificacion Familiar.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_preaviso
  is 'Tipo de Ingreso por Preaviso.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_indemnizacion
  is 'Tipo de Ingreso por Indemnizacion.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_normal
  is 'Tipo de Ingreso por Horas Normales.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_extras
  is 'Tipo de Ingreso por Horas Extras normales.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_30
  is 'Tipo de Ingreso por Horas Extras 30%.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_50
  is 'Tipo de Ingreso por Horas Extras 50%.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_100
  is 'Tipo de Ingreso por Horas Extras 100%.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_130
  is 'Tipo de Ingreso por Horas Extras 130%.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_aguinaldo
  is 'Tipo de Ingreso por Aguinaldo.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_comision
  is 'Tipo de Ingreso para las Comisiones.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_destajo
  is 'Tipo de Ingreso por Destajo.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_prov_vacacion
  is 'Tipo de Ingreso para la Provision de Vacaciones.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_prov_aguinaldo
  is 'Tipo de Ingreso para la Provision de Aguinaldo.';
comment on column IT.RH_PAR_EMPRESAS.cod_tur_administrativo
  is 'Codigo del Turno Administrativo.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_des_pri_sueldo
  is 'Tipo de Descuento para la Caja por el primer sueldo.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_des_aumento
  is 'Tipo de Descuento para la Caja por aumento.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_titulo
  is 'Tipo de Ingreso adicional por Titulo Universitario.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_antiguedad
  is 'Tipo de Ingreso adicional por Antiguedad.';
comment on column IT.RH_PAR_EMPRESAS.cod_tip_ing_cargo
