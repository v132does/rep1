create table IT.GE_PAG_BTS_MENSUALES
(
  nro_orden            NUMBER(12) not null,
  nro_doc_beneficiario VARCHAR2(20) not null,
  ano                  NUMBER not null,
  mes                  NUMBER not null,
  can_operaciones      NUMBER not null,
  mon_operaciones      NUMBER not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAG_BTS_MENSUALES
  is 'Acumulado por cantidad y montos de operaciones BTS por beneficiario.';
comment on column IT.GE_PAG_BTS_MENSUALES.nro_orden
  is 'Número de orden';
comment on column IT.GE_PAG_BTS_MENSUALES.nro_doc_beneficiario
  is 'Número de documento del beneficiario';
comment on column IT.GE_PAG_BTS_MENSUALES.ano
  is 'Año de las operaciones del cliente';
comment on column IT.GE_PAG_BTS_MENSUALES.mes
  is 'Mes de las operaciones del cliente';
comment on column IT.GE_PAG_BTS_MENSUALES.can_operaciones
  is 'Cantidad de operaciones del cliente en un mes';
comment on column IT.GE_PAG_BTS_MENSUALES.mon_operaciones
  is 'Monto de operaciones del cliente en un mes';
comment on column IT.GE_PAG_BTS_MENSUALES.fec_insercion
  is 'Fecha que se insertó el registro';
comment on column IT.GE_PAG_BTS_MENSUALES.usu_insercion
  is 'Usuario que insertó el registro';
comment on column IT.GE_PAG_BTS_MENSUALES.fec_modificacion
  is 'Última fecha que se modificó el registro';
comment on column IT.GE_PAG_BTS_MENSUALES.usu_modificacion
  is 'Usuario quién realizó la última modificación';

