create table IT.AH_COM_CARTERA_TMP
(
  fecha                   DATE default trunc(SYSDATE) not null,
  cod_oficina             NUMBER(3) default 1,
  nro_documento           VARCHAR2(20) not null,
  cod_tip_documento       NUMBER(3) not null,
  cod_pais                NUMBER(3) not null,
  nombre                  VARCHAR2(60) not null,
  apellido                VARCHAR2(60) not null,
  tipo                    VARCHAR2(1) not null,
  fec_nacimiento          DATE not null,
  dir_particular          VARCHAR2(80) not null,
  nro_dir_particular      VARCHAR2(8) not null,
  cod_pais_dir_particular NUMBER(3) not null,
  cod_ciu_dir_particular  VARCHAR2(35),
  cod_bar_dir_particular  NUMBER(3),
  obs_dir_particular      VARCHAR2(100),
  tip_linea_particular    VARCHAR2(1) default 'B' not null,
  area_tel_particular     VARCHAR2(10) not null,
  tel_particular          VARCHAR2(10) not null,
  saldo_cta               NUMBER(18,2) not null,
  inactivo                VARCHAR2(1),
  des_puesto              VARCHAR2(80) not null,
  cod_rub_primario        VARCHAR2(6) not null,
  cod_moneda              VARCHAR2(3) not null,
  observaciones           VARCHAR2(1000),
  cod_usu_oficial         VARCHAR2(10),
  cod_sex_cliente         VARCHAR2(1),
  cod_dpto_dir_particular VARCHAR2(35),
  est_civil               VARCHAR2(15),
  correo                  VARCHAR2(100),
  procesado               VARCHAR2(1) default 'N' not null,
  usu_insercion           VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_insercion           DATE default SYSDATE not null,
  usu_modificacion        VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_modificacion        DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

