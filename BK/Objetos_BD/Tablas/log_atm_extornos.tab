create table IT.LOG_ATM_EXTORNOS
(
  nro_transaccion NUMBER(15) not null,
  usu_insercion   VARCHAR2(10) default user,
  fec_insercion   DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LOG_ATM_EXTORNOS
  add constraint PK_LOG_ATM_EXTORNOS primary key (NRO_TRANSACCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

