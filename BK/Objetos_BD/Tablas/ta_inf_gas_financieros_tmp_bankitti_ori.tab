comment on column IT.TA_INF_GAS_FINANCIEROS_TMP_BANKITTI_ORI.mto_imp_int_cierre
  is 'Monto del Iva 5% afecta en el Cierre.';
comment on column IT.TA_INF_GAS_FINANCIEROS_TMP_BANKITTI_ORI.fec_ult_act
  is 'FH Ultima Actualización';
comment on column IT.TA_INF_GAS_FINANCIEROS_TMP_BANKITTI_ORI.ref_archivo
  is 'Referencia del Archivo de Importación.';
comment on column IT.TA_INF_GAS_FINANCIEROS_TMP_BANKITTI_ORI.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.TA_INF_GAS_FINANCIEROS_TMP_BANKITTI_ORI.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.TA_INF_GAS_FINANCIEROS_TMP_BANKITTI_ORI.usu_modificacion
  is 'Usuario que realizó la última modificación.';
comment on column IT.TA_INF_GAS_FINANCIEROS_TMP_BANKITTI_ORI.fec_modificacion
