create table IT.AUX_CTA_EXC_DEB_PROACTIVO
(
  cod_persona      VARCHAR2(10) not null,
  nro_cuenta       VARCHAR2(15) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_modulo       NUMBER(3),
  nro_cta_debito   VARCHAR2(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AUX_CTA_EXC_DEB_PROACTIVO
  is 'Tabla auxiliar utilizada para parametrizar cuenta que no tendrán activo el débito pro-activo.';
comment on column IT.AUX_CTA_EXC_DEB_PROACTIVO.cod_persona
  is 'Codigo de persona.';
comment on column IT.AUX_CTA_EXC_DEB_PROACTIVO.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.AUX_CTA_EXC_DEB_PROACTIVO.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.AUX_CTA_EXC_DEB_PROACTIVO.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.AUX_CTA_EXC_DEB_PROACTIVO.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.AUX_CTA_EXC_DEB_PROACTIVO.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.AUX_CTA_EXC_DEB_PROACTIVO
  add constraint PK_AUX_CTA_EXC_DEB_PROACTIVO primary key (COD_PERSONA, NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );

