alter table IT.RH_MOVIMIENTOS_HIS
  add constraint PK_RH_MOVIMIENTOS_HIS primary key (FECHA, HORA, COD_USUARIO, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_AUTORIZACION foreign key (COD_AUTORIZACION)
  references IT.GE_AUTORIZACIONES (COD_AUTORIZACION);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_BANCO foreign key (COD_BANCO)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_CAUSA foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_RETENCION foreign key (COD_RETENCION)
  references IT.GE_RETENCIONES (COD_RETENCION);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_TRA_PADRE foreign key (COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_USU_AUTORIZADOR foreign key (COD_USU_AUTORIZADOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_COD_USU_REVERSION foreign key (COD_USU_REVERSION)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_NRO_CAJA foreign key (NRO_CAJA)
  references IT.CJ_CAJAS (NRO_CAJA);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint FK_HMHIS_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_COD_B_000
  check (COD_BANCO BETWEEN 0 AND 999);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_COD_C_000
  check (COD_CAUSA BETWEEN 0 AND 999);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_COD_M_006
  check (COD_MAD_PADRE BETWEEN 0 AND 999);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_COD_M_007
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_COD_M_008
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_COD_O_000
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_COD_O_001
  check (COD_OFI_ORIGEN BETWEEN 0 AND 999);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_COD_R_000
  check (COD_RETENCION BETWEEN 0 AND 999);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_COD_T_000
  check (COD_TASA BETWEEN 0 AND 999);
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_EMI_A_000
  check (EMI_AVISO IN ('S', 'N'));
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_PROTE_000
  check (PROTEGIDO IN ('S', 'N'));
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint AVCON_1191946564_REVER_000
  check (REVERSADO IN ('S', 'N'));
alter table IT.RH_MOVIMIENTOS_HIS
  add constraint CK_NRO_CUENTA_MOV
  check ((NRO_CUENTA IS NULL AND COD_RUBRO IS NOT NULL ) OR
(NRO_CUENTA IS NOT NULL AND COD_RUBRO IS NULL) OR
(NRO_CUENTA IS NOT NULL
AND COD_RUBRO IS NOT NULL)  OR (COD_TRANSACCION IS NOT NULL));

