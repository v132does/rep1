create table IT.GE_SOL_EST_INICIAL
(
  cod_tip_canal    NUMBER(3),
  cod_canal        NUMBER(3),
  cod_campana      NUMBER(3),
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  cod_estado       VARCHAR2(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SOL_EST_INICIAL
  is 'Estado inicial parametrizado...';
comment on column IT.GE_SOL_EST_INICIAL.cod_tip_canal
  is 'Tipo de canal.';
comment on column IT.GE_SOL_EST_INICIAL.cod_canal
  is 'Codigo de Canal.';
comment on column IT.GE_SOL_EST_INICIAL.cod_campana
  is 'Código de Campaña.';
comment on column IT.GE_SOL_EST_INICIAL.cod_modulo
  is 'Codigo de Modulo.';
comment on column IT.GE_SOL_EST_INICIAL.cod_modalidad
  is 'Codigo de Modalidad.';
comment on column IT.GE_SOL_EST_INICIAL.cod_estado
  is 'Codigo de Estado Inicial.';
comment on column IT.GE_SOL_EST_INICIAL.usu_insercion
  is 'Usuario de insercion.';
comment on column IT.GE_SOL_EST_INICIAL.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.GE_SOL_EST_INICIAL.usu_modificacion
  is 'Usuario de modificacion.';
comment on column IT.GE_SOL_EST_INICIAL.fec_modificacion
  is 'Fecha de modificacion.';
create index IT.IN_BBVA_CAMINSEST on IT.GE_SOL_EST_INICIAL (COD_CAMPANA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_EST_INICIAL
  add constraint UK_GE_SOL_EST_INICIAL unique (COD_TIP_CANAL, COD_CANAL, COD_CAMPANA, COD_MODULO, COD_MODALIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_EST_INICIAL
  add constraint FK_GSEIN_COD_CAMPANA foreign key (COD_CAMPANA)
  references IT.CR_CAMPANAS (COD_CAMPANA);
alter table IT.GE_SOL_EST_INICIAL
  add constraint FK_GSEIN_COD_CANAL foreign key (COD_CANAL)
  references IT.GE_CANALES (COD_CANAL);
alter table IT.GE_SOL_EST_INICIAL
  add constraint FK_GSEIN_COD_ESTADO foreign key (COD_ESTADO)
  references IT.GE_SOL_ESTADOS (COD_ESTADO);
alter table IT.GE_SOL_EST_INICIAL
  add constraint FK_GSEIN_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_SOL_EST_INICIAL
  add constraint FK_GSEIN_COD_TIP_CANAL foreign key (COD_TIP_CANAL)
  references IT.GE_TIP_CANALES (COD_TIP_CANAL);

