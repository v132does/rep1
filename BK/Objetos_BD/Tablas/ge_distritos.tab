create table IT.GE_DISTRITOS
(
  cod_pais         NUMBER(3) not null,
  cod_ciudad       NUMBER(3) not null,
  cod_distrito     NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_DISTRITOS
  is 'Distritos de Ciudades.';
comment on column IT.GE_DISTRITOS.cod_pais
  is 'Codigo del pais.';
comment on column IT.GE_DISTRITOS.cod_ciudad
  is 'Codigo de Ciudad.';
comment on column IT.GE_DISTRITOS.cod_distrito
  is 'Codigo de Distrito.';
comment on column IT.GE_DISTRITOS.descripcion
  is 'Descripcion del Distrito.';
comment on column IT.GE_DISTRITOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_DISTRITOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_DISTRITOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_DISTRITOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_DISTRITOS
  add constraint PK_GE_DISTRITOS primary key (COD_DISTRITO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_DISTRITOS
  add constraint FK_GDIST_COD_CIUDAD foreign key (COD_CIUDAD, COD_PAIS)
  references IT.BA_CIUDADES (COD_CIUDAD, COD_PAIS);
alter table IT.GE_DISTRITOS
  add constraint AVCON_1083093171_COD_C_001
  check (COD_CIUDAD BETWEEN 0 AND 999);
alter table IT.GE_DISTRITOS
  add constraint AVCON_1083093171_COD_D_001
  check (COD_DISTRITO BETWEEN 0 AND 999);
alter table IT.GE_DISTRITOS
  add constraint AVCON_1083093171_COD_P_001
  check (COD_PAIS BETWEEN 0 AND 999);

