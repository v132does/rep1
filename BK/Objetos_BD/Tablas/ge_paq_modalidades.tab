create table IT.GE_PAQ_MODALIDADES
(
  cod_paquete       NUMBER(3) not null,
  cod_modulo        NUMBER(3) not null,
  cod_modalidad     NUMBER(3) not null,
  cod_sub_modalidad NUMBER(3),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  sub_afinidad      VARCHAR2(3),
  afinidad          VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAQ_MODALIDADES
  is 'Paquetes vinculados a Modalidades.';
comment on column IT.GE_PAQ_MODALIDADES.cod_paquete
  is 'Código del Paquete.';
comment on column IT.GE_PAQ_MODALIDADES.cod_modulo
  is 'Código del Módulo.';
comment on column IT.GE_PAQ_MODALIDADES.cod_modalidad
  is 'Código de la Modalidad.';
comment on column IT.GE_PAQ_MODALIDADES.cod_sub_modalidad
  is 'Código de la Sub Modalidad.';
comment on column IT.GE_PAQ_MODALIDADES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_PAQ_MODALIDADES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PAQ_MODALIDADES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAQ_MODALIDADES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAQ_MODALIDADES.sub_afinidad
  is 'Código de la Sub Afinidad.';
comment on column IT.GE_PAQ_MODALIDADES.afinidad
  is 'Código de Afinidad';
alter table IT.GE_PAQ_MODALIDADES
  add constraint UK_GE_PAQ_MODALIDADES unique (COD_PAQUETE, COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD, AFINIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

