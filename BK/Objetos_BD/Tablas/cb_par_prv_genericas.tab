create table IT.CB_PAR_PRV_GENERICAS
(
  tip_riesgo       VARCHAR2(1) not null,
  sec_riesgo       VARCHAR2(2) not null,
  sec_inversion    VARCHAR2(2) not null,
  cod_gru_rubro    NUMBER(5),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_PAR_PRV_GENERICAS
  is 'Tabla paramétrica para generación del informe de previsiones genéricas.';
comment on column IT.CB_PAR_PRV_GENERICAS.tip_riesgo
  is 'Tipo de riesgo.';
comment on column IT.CB_PAR_PRV_GENERICAS.sec_riesgo
  is 'Sector comercial de acuerdo al tipo de riesgo.';
comment on column IT.CB_PAR_PRV_GENERICAS.sec_inversion
  is 'Tipo de inversión al que corresponde el sector comercial.';
comment on column IT.CB_PAR_PRV_GENERICAS.cod_gru_rubro
  is 'Código de grupo de rubros vinculado al tipo de riesgo.';
comment on column IT.CB_PAR_PRV_GENERICAS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CB_PAR_PRV_GENERICAS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CB_PAR_PRV_GENERICAS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CB_PAR_PRV_GENERICAS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.CB_PAR_PRV_GENERICAS
  add constraint PK_CB_PAR_PRV_GENERICAS primary key (TIP_RIESGO, SEC_RIESGO, SEC_INVERSION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_PAR_PRV_GENERICAS
  add constraint FK_BPPGE_COD_GRU_RUBRO foreign key (COD_GRU_RUBRO)
  references IT.CB_GRU_RUBROS (COD_GRU_RUBRO);

