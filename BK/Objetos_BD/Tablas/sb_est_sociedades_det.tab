create table IT.SB_EST_SOCIEDADES_DET
(
  fecha            DATE not null,
  cod_persona      VARCHAR2(10) not null,
  nro_cuenta       VARCHAR2(15) not null,
  mto_loc_prestamo NUMBER(18,2),
  mto_ext_prestamo NUMBER(18,2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_EST_SOCIEDADES_DET
  is 'Tabla que contendrá por fecha el detalle de los prestamos de clientes para el Informe Estadistico de Sociedades';
comment on column IT.SB_EST_SOCIEDADES_DET.fecha
  is 'Fecha de Trimestre.';
comment on column IT.SB_EST_SOCIEDADES_DET.cod_persona
  is 'Codigo persona de la Sociedad.';
comment on column IT.SB_EST_SOCIEDADES_DET.nro_cuenta
  is 'Numero de Cuenta.';
comment on column IT.SB_EST_SOCIEDADES_DET.mto_loc_prestamo
  is 'Monto en Moneda Local de Prestamo de la Sociedad.';
comment on column IT.SB_EST_SOCIEDADES_DET.mto_ext_prestamo
  is 'Monto en Moneda Extranjera de Prestamo de la Sociedad.';
comment on column IT.SB_EST_SOCIEDADES_DET.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.SB_EST_SOCIEDADES_DET.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.SB_EST_SOCIEDADES_DET.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.SB_EST_SOCIEDADES_DET.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.SB_EST_SOCIEDADES_DET
  add constraint PK_SB_EST_SOCIEDADES_DET primary key (FECHA, COD_PERSONA, NRO_CUENTA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

