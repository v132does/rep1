create table IT.GE_GIROS
(
  nro_operacion        NUMBER(7) not null,
  fec_operacion        DATE not null,
  cod_per_solicitante  VARCHAR2(10) not null,
  cod_moneda           VARCHAR2(3) not null,
  monto                NUMBER(18,2) default 0 not null,
  for_pago             VARCHAR2(1),
  doc_beneficiario     VARCHAR2(20) not null,
  nom_beneficiario     VARCHAR2(100) not null,
  dir_beneficiario     VARCHAR2(100),
  tel_beneficiario     VARCHAR2(20),
  cod_per_beneficiario VARCHAR2(10),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cod_ofi_origen       NUMBER(2),
  nro_cta_debito       VARCHAR2(15),
  ind_cob_cargo        VARCHAR2(1),
  cod_estado           VARCHAR2(1),
  fec_cam_estado       DATE,
  for_cobro            VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_GIROS.nro_operacion
  is 'Numero de operacion.';
comment on column IT.GE_GIROS.fec_operacion
  is 'Fecha de la operacion';
comment on column IT.GE_GIROS.cod_per_solicitante
  is 'Codigo del persona del solicitante.';
comment on column IT.GE_GIROS.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.GE_GIROS.monto
  is 'Montro de la operacion.';
comment on column IT.GE_GIROS.for_pago
  is 'Forma de pago';
comment on column IT.GE_GIROS.doc_beneficiario
  is 'Nro. de documento del beneficiario.';
comment on column IT.GE_GIROS.nom_beneficiario
  is 'Nombre del beneficiario.';
comment on column IT.GE_GIROS.dir_beneficiario
  is 'Direccion del beneficiario';
comment on column IT.GE_GIROS.tel_beneficiario
  is 'Nro. de telefono del beneficiario';
comment on column IT.GE_GIROS.cod_per_beneficiario
  is 'Codigo de persona del beneficiario';
comment on column IT.GE_GIROS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_GIROS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_GIROS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_GIROS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_GIROS.cod_ofi_origen
  is 'Codigo de oficina origen';
comment on column IT.GE_GIROS.nro_cta_debito
  is 'Nro. de Cuenta de debito';
comment on column IT.GE_GIROS.ind_cob_cargo
  is 'Indicador de cobro de cargo (S/N)';
comment on column IT.GE_GIROS.cod_estado
  is 'Estado (1=Ingresado, 2=Cobrado, 3=Pagado, 4=Anulado)';
comment on column IT.GE_GIROS.fec_cam_estado
  is 'Fecha de cambio de estado';
comment on column IT.GE_GIROS.for_cobro
  is 'Forma de Cobro';
alter table IT.GE_GIROS
  add constraint PK_GE_GIROS primary key (NRO_OPERACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_GIROS
  add constraint CK_GGIROCOD_ESTADO
  check (cod_estado in ('1','2','3','4','5'));

