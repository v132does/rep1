create table IT.CR_PER_CLUBES
(
  cod_persona      VARCHAR2(10) not null,
  cod_club         NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_PER_CLUBES
  is 'Clubes por persona.';
comment on column IT.CR_PER_CLUBES.cod_persona
  is 'Codigo de persona.';
comment on column IT.CR_PER_CLUBES.cod_club
  is 'Codigo de Club.';
comment on column IT.CR_PER_CLUBES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_PER_CLUBES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_PER_CLUBES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_PER_CLUBES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CR_PER_CLUBES
  add constraint PK_CR_PER_CLUBES primary key (COD_PERSONA, COD_CLUB)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_PER_CLUBES
  add constraint FK_RPCLU_COD_CLUB foreign key (COD_CLUB)
  references IT.CR_CLUBES (COD_CLUB);
alter table IT.CR_PER_CLUBES
  add constraint FK_RPCLU_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CR_PER_CLUBES
  add constraint AVCON_1080843837_COD_C_010
  check (COD_CLUB BETWEEN 1 AND 999);

