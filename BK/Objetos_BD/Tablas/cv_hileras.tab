create table IT.CV_HILERAS
(
  cod_hilera       NUMBER(3) not null,
  descripcion      VARCHAR2(50),
  cod_nivel        NUMBER(5),
  estado           VARCHAR2(1),
  val_incluidos    VARCHAR2(100),
  abreviatura      VARCHAR2(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CV_HILERAS
  is 'Hileras del Nivel (semanas) del Mueble del Archivo Físico.';
comment on column IT.CV_HILERAS.cod_hilera
  is 'Código de Hilera de Custodia.';
comment on column IT.CV_HILERAS.descripcion
  is 'Descripción de  Hilera de Custodia.';
comment on column IT.CV_HILERAS.cod_nivel
  is 'Codigo de Nivel de la Hilera.';
comment on column IT.CV_HILERAS.estado
  is 'Estado del Nivel. A=Activo,I=Inactivo.';
comment on column IT.CV_HILERAS.val_incluidos
  is 'Lista de valores que corresponden a la Hilera (semanas).';
comment on column IT.CV_HILERAS.abreviatura
  is 'Abreviatura para Código de Barras.';
comment on column IT.CV_HILERAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CV_HILERAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CV_HILERAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CV_HILERAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CV_HILERAS
  add constraint PK_CV_HILERAS primary key (COD_HILERA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CV_HILERAS
  add constraint FK_CVHIL_COD_NIVEL foreign key (COD_NIVEL)
  references IT.CV_NIVELES (COD_NIVEL);

