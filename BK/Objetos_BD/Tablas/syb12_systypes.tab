create global temporary table IT.SYB12_SYSTYPES
(
  db_id      NUMBER(10),
  db_uid     NUMBER(10),
  usertype   NUMBER(10),
  variable   NUMBER(1),
  allownulls NUMBER(1),
  db_type    NUMBER(10),
  length     NUMBER(10),
  tdefault   NUMBER(10),
  domain     NUMBER(10),
  name       VARCHAR2(255),
  printfmt   VARCHAR2(255),
  prec       NUMBER(10),
  scale      NUMBER(10),
  ident      NUMBER(10),
  heirarchy  NUMBER(10),
  accessrule NUMBER(12),
  xtypeid    NUMBER(12),
  vxdbid     NUMBER(12)
)
on commit preserve rows;

