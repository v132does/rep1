create table IT.BW_PWD_POL_EXPRESIONES
(
  cod_expresion    NUMBER(18) not null,
  cod_politica     NUMBER(18),
  expresion        VARCHAR2(4000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_PWD_POL_EXPRESIONES
  is 'Expresiones de Políticas.';
comment on column IT.BW_PWD_POL_EXPRESIONES.cod_expresion
  is 'Código de Expresión.';
comment on column IT.BW_PWD_POL_EXPRESIONES.cod_politica
  is 'Código de Politica.';
comment on column IT.BW_PWD_POL_EXPRESIONES.expresion
  is 'Expresión.';
comment on column IT.BW_PWD_POL_EXPRESIONES.usu_insercion
  is 'Usuario de Inserción.';
comment on column IT.BW_PWD_POL_EXPRESIONES.fec_insercion
  is 'Fecha de Inserción.';
comment on column IT.BW_PWD_POL_EXPRESIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BW_PWD_POL_EXPRESIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BW_PWD_POL_EXPRESIONES
  add constraint PK_BW_PWD_POL_EXPRESIONES primary key (COD_EXPRESION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

