create table IT.TA_BLO_AUT_TARJETAS
(
  fecha             DATE not null,
  cod_persona       VARCHAR2(10) not null,
  nro_tarjeta       VARCHAR2(25) not null,
  dat_bloqueo       VARCHAR2(100),
  mot_bloqueo       VARCHAR2(120) not null,
  estado            VARCHAR2(1) default 'P',
  observacion       VARCHAR2(200),
  log_error         VARCHAR2(600),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_accion        VARCHAR2(4),
  tip_bloqueo       VARCHAR2(1),
  tip_operacion     VARCHAR2(1),
  amb_bloqueo       VARCHAR2(1),
  for_bloqueo       VARCHAR2(1),
  cod_motivo        NUMBER(2),
  usu_actualizacion VARCHAR2(10) default SUBSTR(USER,1,10),
  mes_purga         NUMBER(3),
  cod_respuesta     VARCHAR2(2),
  res_extendida     VARCHAR2(4)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_BLO_AUT_TARJETAS.fecha
  is 'Fecha del Bloqueo.';
comment on column IT.TA_BLO_AUT_TARJETAS.cod_persona
  is 'Código de la Persona.';
comment on column IT.TA_BLO_AUT_TARJETAS.nro_tarjeta
  is 'Número de Tarjeta.';
comment on column IT.TA_BLO_AUT_TARJETAS.dat_bloqueo
  is 'Datos del Bloqueo.';
comment on column IT.TA_BLO_AUT_TARJETAS.mot_bloqueo
  is 'Motivo del Bloqueo.';
comment on column IT.TA_BLO_AUT_TARJETAS.estado
  is 'Estado P-Pendiente, E-Enviado, R-Rechazado.';
comment on column IT.TA_BLO_AUT_TARJETAS.observacion
  is 'Observación.';
comment on column IT.TA_BLO_AUT_TARJETAS.log_error
  is 'Log de Error.';
comment on column IT.TA_BLO_AUT_TARJETAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_BLO_AUT_TARJETAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_BLO_AUT_TARJETAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_BLO_AUT_TARJETAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.TA_BLO_AUT_TARJETAS.cod_accion
  is 'Códigos de Acción.';
comment on column IT.TA_BLO_AUT_TARJETAS.tip_bloqueo
  is 'Tipo de bloqueo: A: ADMINISTRATIVO, U: USUARIO';
comment on column IT.TA_BLO_AUT_TARJETAS.tip_operacion
  is 'Tipos de Operaciones';
comment on column IT.TA_BLO_AUT_TARJETAS.amb_bloqueo
  is 'Ambiente de bloqueo: L: Local, I: Internacional';
comment on column IT.TA_BLO_AUT_TARJETAS.for_bloqueo
  is 'Forma de bloqueo: T: Temporal, D: Definitivo';
comment on column IT.TA_BLO_AUT_TARJETAS.cod_motivo
  is 'Código del Motivos de Bloqueos';
comment on column IT.TA_BLO_AUT_TARJETAS.usu_actualizacion
  is 'Usuario que realiza el pedido de bloqueo';
comment on column IT.TA_BLO_AUT_TARJETAS.mes_purga
  is 'Meses de purga';
comment on column IT.TA_BLO_AUT_TARJETAS.cod_respuesta
  is 'Respuesta: 00 = Transacción Aprobada, 06 = Transacción Rechazada';
comment on column IT.TA_BLO_AUT_TARJETAS.res_extendida
  is 'Respuesta extendida';

