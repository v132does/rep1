create table IT.LOG_BCA_ELECTRONICA
(
  mensaje       VARCHAR2(4000),
  respuesta     VARCHAR2(4000),
  usu_insercion VARCHAR2(10) default user,
  fec_insercion DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.LOG_BCA_ELECTRONICA
  is 'Log de Envios y Respuestas de Mensajería.';

