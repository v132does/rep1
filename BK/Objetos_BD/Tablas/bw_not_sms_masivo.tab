create table IT.BW_NOT_SMS_MASIVO
(
  cod_mensaje      NUMBER default 0 not null,
  cod_persona      VARCHAR2(10) not null,
  mensaje          VARCHAR2(200) not null,
  fecha            DATE,
  lote             NUMBER,
  encolado         VARCHAR2(1),
  nro_celular      VARCHAR2(100),
  error            VARCHAR2(3000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_NOT_SMS_MASIVO
  is 'Mensajes masivos sms';
comment on column IT.BW_NOT_SMS_MASIVO.cod_mensaje
  is 'Identificador de los mensaje';
comment on column IT.BW_NOT_SMS_MASIVO.cod_persona
  is 'Codigo de la persona';
comment on column IT.BW_NOT_SMS_MASIVO.mensaje
  is 'Mensaje a ser enviado';
comment on column IT.BW_NOT_SMS_MASIVO.fecha
  is 'Indica Fecha de Proceso';
comment on column IT.BW_NOT_SMS_MASIVO.lote
  is 'Agrupador de mensajes';
comment on column IT.BW_NOT_SMS_MASIVO.encolado
  is 'Indica si fue encolado para envio';
comment on column IT.BW_NOT_SMS_MASIVO.nro_celular
  is 'Nro de Celular';
comment on column IT.BW_NOT_SMS_MASIVO.error
  is 'Indica si hubo error';
alter table IT.BW_NOT_SMS_MASIVO
  add constraint PK_BW_NOT_SMS_MASIVO primary key (COD_MENSAJE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

