create table IT.SB_CRC_GARANTIAS_DET
(
  fecha                    DATE not null,
  nom_referencia           VARCHAR2(10) not null,
  nro_formulario           VARCHAR2(3),
  cod_oficina              NUMBER(3),
  cod_mon_iso_garantia     VARCHAR2(3),
  nro_garantia             VARCHAR2(20),
  cod_ref_bco_central      NUMBER(3),
  nro_inscripcion          VARCHAR2(10),
  rango                    NUMBER(2),
  fec_valor                DATE,
  fec_vencimiento          DATE,
  mto_garantia             NUMBER(18,2),
  fec_ini_tasacion         DATE,
  fec_vto_tasacion         DATE,
  mto_tas_asegurable       NUMBER(18,2),
  mto_tas_no_asegurable    NUMBER(18,2),
  fec_ini_seguro           DATE,
  fec_vto_seguro           DATE,
  cod_mon_iso_seguro       VARCHAR2(3),
  mto_asegurado            NUMBER(18,2),
  tip_gar_especifica       VARCHAR2(1),
  perfeccionada            VARCHAR2(1),
  nro_registro             NUMBER(9) not null,
  cod_persona              VARCHAR2(10),
  est_garantia             VARCHAR2(1),
  fec_confirmacion         DATE,
  mto_seg_equ_local        NUMBER(18,2),
  mto_gar_equ_local        NUMBER(18,2),
  mto_tas_ase_equ_local    NUMBER(18,2),
  mto_tas_no_ase_equ_local NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_CRC_GARANTIAS_DET
  is 'Datos de Garantías de las Operaciones para la generación del Archivo Garantías para envío a CRC.';
comment on column IT.SB_CRC_GARANTIAS_DET.fecha
  is 'Fecha de Periodo de envío del Archivo.';
comment on column IT.SB_CRC_GARANTIAS_DET.nom_referencia
  is 'Nombre del Archivo a generarse a la CRC (Archivo GARANTIAS).';
comment on column IT.SB_CRC_GARANTIAS_DET.nro_formulario
  is 'Nro. de Formulario correspondiente al Archivo de Vínculos. Este nro. Es fijo para identificar dicho Archivo.';
comment on column IT.SB_CRC_GARANTIAS_DET.cod_oficina
  is 'Código de Oficina de la Garantía. ';
comment on column IT.SB_CRC_GARANTIAS_DET.cod_mon_iso_garantia
  is 'Código de Moneda de la Garantía.';
comment on column IT.SB_CRC_GARANTIAS_DET.nro_garantia
  is 'Nro. de Garantía.';
comment on column IT.SB_CRC_GARANTIAS_DET.cod_ref_bco_central
  is 'Tipo de Garantía (Código de Referencia de Banco Central PR_GAR_TIPOS).';
comment on column IT.SB_CRC_GARANTIAS_DET.nro_inscripcion
  is 'Nro. de Inscripción de Registro Público.';
comment on column IT.SB_CRC_GARANTIAS_DET.rango
  is 'Rango de Garantía(Valores Posibles1-Primer Rango,2-Segundo Rango)';
comment on column IT.SB_CRC_GARANTIAS_DET.fec_valor
  is 'Fecha de Inicio de la Garantía.';
comment on column IT.SB_CRC_GARANTIAS_DET.fec_vencimiento
  is 'Fecha de Vencimiento de la Garantía.';
comment on column IT.SB_CRC_GARANTIAS_DET.mto_garantia
  is 'Monto de la Garantía.';
comment on column IT.SB_CRC_GARANTIAS_DET.fec_ini_tasacion
  is 'Fecha de Inicio de la Tasación.';
comment on column IT.SB_CRC_GARANTIAS_DET.fec_vto_tasacion
  is 'Fecha de Vencimiento de la Tasación.';
comment on column IT.SB_CRC_GARANTIAS_DET.mto_tas_asegurable
  is 'Mto. de Tasación(Asegurable).';
comment on column IT.SB_CRC_GARANTIAS_DET.mto_tas_no_asegurable
  is 'Mto. de Tasación no asegurable.';
comment on column IT.SB_CRC_GARANTIAS_DET.fec_ini_seguro
  is 'Fecha de Inicio de Seguro.';
comment on column IT.SB_CRC_GARANTIAS_DET.fec_vto_seguro
  is 'Fecha de Vencimiento del Seguro.';
comment on column IT.SB_CRC_GARANTIAS_DET.cod_mon_iso_seguro
  is 'Código de Moneda del Seguro (Moneda ISO).';
comment on column IT.SB_CRC_GARANTIAS_DET.mto_asegurado
  is 'Monto /Valor asegurado.';
comment on column IT.SB_CRC_GARANTIAS_DET.tip_gar_especifica
  is 'Tipo de Garantía (Abierta S/N PR_GARANTIAS).';
comment on column IT.SB_CRC_GARANTIAS_DET.perfeccionada
  is 'Garantía Perfeccionada (Las Garantías Reales deben estar perfeccionadas de conformidad con las disposiciones legales y tributarias vigentes).';
comment on column IT.SB_CRC_GARANTIAS_DET.nro_registro
  is 'Nro. de Registro único.';
comment on column IT.SB_CRC_GARANTIAS_DET.cod_persona
  is 'Código de Persona';
comment on column IT.SB_CRC_GARANTIAS_DET.est_garantia
  is 'Estado de Garantía';
comment on column IT.SB_CRC_GARANTIAS_DET.fec_confirmacion
  is 'Fecha de Confirmación de la Garantía';
comment on column IT.SB_CRC_GARANTIAS_DET.mto_seg_equ_local
  is 'Monto /Valor asegurado en Moneda Local.';
comment on column IT.SB_CRC_GARANTIAS_DET.mto_gar_equ_local
  is 'Monto de la Garantía en Moneda Local.';
comment on column IT.SB_CRC_GARANTIAS_DET.mto_tas_ase_equ_local
  is 'Mto. de Tasación(Asegurable) en Moneda Local.';
comment on column IT.SB_CRC_GARANTIAS_DET.mto_tas_no_ase_equ_local
  is 'Mto. de Tasación no asegurable en Moneda Local.';
alter table IT.SB_CRC_GARANTIAS_DET
  add constraint PK_SB_CRC_GARANTIAS_DET primary key (FECHA, NOM_REFERENCIA, NRO_REGISTRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SB_CRC_GARANTIAS_DET
  add constraint UK_SCGDE_NRO_GARANTIA unique (NRO_GARANTIA, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

