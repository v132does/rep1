create table IT.AP_PROYECTOS
(
  cod_plan          NUMBER(10) not null,
  cod_proyecto      NUMBER(10) not null,
  cod_usuario       VARCHAR2(10) not null,
  cod_area          NUMBER(3) not null,
  cod_oficina       NUMBER(3) not null,
  descripcion       VARCHAR2(60) not null,
  fec_inicio        DATE not null,
  fec_fin           DATE not null,
  duracion          NUMBER(4) not null,
  situacion         VARCHAR2(2) default 'NI' not null,
  prioridad         NUMBER(1) default 4 not null,
  orden             NUMBER(3) default 999 not null,
  mto_presupuestado NUMBER(18,2) default 0 not null,
  mto_ejecutado     NUMBER(18,2) default 0 not null,
  por_ejecutado     NUMBER(5,2) default 0 not null,
  aprobado          VARCHAR2(1) default 'N' not null,
  des_detallada     VARCHAR2(1000),
  fec_ini_real      DATE,
  fec_fin_real      DATE,
  dur_real          NUMBER(4),
  por_avance        NUMBER(5,2) default 0,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AP_PROYECTOS
  is 'Proyectos.';
comment on column IT.AP_PROYECTOS.cod_plan
  is 'Identificador del Plan.';
comment on column IT.AP_PROYECTOS.cod_proyecto
  is 'Identificador del Proyecto.';
comment on column IT.AP_PROYECTOS.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.AP_PROYECTOS.cod_area
  is 'Codigo del Area.';
comment on column IT.AP_PROYECTOS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.AP_PROYECTOS.descripcion
  is 'Descripcion breve del proyecto.';
comment on column IT.AP_PROYECTOS.fec_inicio
  is 'Fecha de Inicio del Proyecto.';
comment on column IT.AP_PROYECTOS.fec_fin
  is 'Fecha de culminacion del proyecto.';
comment on column IT.AP_PROYECTOS.duracion
  is 'Duracion en dias del tiempo estimado de desarrollo del proyecto.';
comment on column IT.AP_PROYECTOS.situacion
  is 'Situacion actual del proyecto (En Proceso, Demorado, Finalizado, Pendiente).';
comment on column IT.AP_PROYECTOS.prioridad
  is 'Prioridad del Proyecto.';
comment on column IT.AP_PROYECTOS.orden
  is 'Orden dentro de la Prioridad del Proyecto.';
comment on column IT.AP_PROYECTOS.mto_presupuestado
  is 'Monto Total Presupuestado.';
comment on column IT.AP_PROYECTOS.mto_ejecutado
  is 'Monto Total ejecutado para el proyecto.';
comment on column IT.AP_PROYECTOS.por_ejecutado
  is 'Porcentaje Ejecutado.';
comment on column IT.AP_PROYECTOS.aprobado
  is 'Indica si el proyecto esta finalizado o no.';
comment on column IT.AP_PROYECTOS.des_detallada
  is 'Descripcion detallada del proyecto.';
comment on column IT.AP_PROYECTOS.fec_ini_real
  is 'Fecha real de Inicio del Proyecto.';
comment on column IT.AP_PROYECTOS.fec_fin_real
  is 'Fecha real de Fin del Proyecto.';
comment on column IT.AP_PROYECTOS.dur_real
  is 'Duracion en dias del tiempo real de desarrollo del proyecto.';
comment on column IT.AP_PROYECTOS.por_avance
  is 'Porcentaje.';
comment on column IT.AP_PROYECTOS.usu_insercion
  is 'Usuario que inserta.';
comment on column IT.AP_PROYECTOS.fec_insercion
  is 'Fecha de Insercion.';
comment on column IT.AP_PROYECTOS.usu_modificacion
  is 'Usuario que modifica.';
comment on column IT.AP_PROYECTOS.fec_modificacion
  is 'Fecha de modificacion.';
create index IT.IN_YPROY_COD_AREA on IT.AP_PROYECTOS (COD_AREA, COD_OFICINA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_YPROY_COD_PLAN on IT.AP_PROYECTOS (COD_PLAN)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_YPROY_COD_USUARIO on IT.AP_PROYECTOS (COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AP_PROYECTOS
  add constraint PK_AP_PROYECTOS primary key (COD_PROYECTO, COD_PLAN)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AP_PROYECTOS
  add constraint FK_YPROY_COD_AREA foreign key (COD_AREA, COD_OFICINA)
  references IT.BA_AREAS (COD_AREA, COD_OFICINA);
alter table IT.AP_PROYECTOS
  add constraint FK_YPROY_COD_PLAN foreign key (COD_PLAN)
  references IT.AP_PLANES (COD_PLAN);
alter table IT.AP_PROYECTOS
  add constraint FK_YPROY_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.AP_PROYECTOS
  add constraint AVCON_1081349332_APROB_000
  check (APROBADO IN ('S', 'N'));
alter table IT.AP_PROYECTOS
  add constraint AVCON_1081349332_COD_A_000
  check (COD_AREA BETWEEN 1 AND 999);
alter table IT.AP_PROYECTOS
  add constraint AVCON_1081349332_COD_O_002
  check (COD_OFICINA BETWEEN 1 AND 999);
alter table IT.AP_PROYECTOS
  add constraint AVCON_1081349332_COD_P_015
  check (COD_PLAN BETWEEN 1 AND 999999999);
alter table IT.AP_PROYECTOS
  add constraint AVCON_1081349332_COD_P_016
  check (COD_PROYECTO BETWEEN 1 AND 999999999);
alter table IT.AP_PROYECTOS
  add constraint AVCON_1081349332_PRIOR_001
  check (PRIORIDAD IN (1, 2, 3, 4));
alter table IT.AP_PROYECTOS
  add constraint AVCON_1081349332_SITUA_001
  check (SITUACION IN ('NI', 'DE', 'AT', 'FI', 'PO', 'CA'));
alter table IT.AP_PROYECTOS
  add constraint CK_YPROY_RANGO_FECHA
  check ((fec_inicio is not null
and fec_inicio < fec_fin) or (fec_inicio is null and fec_fin is null));
alter table IT.AP_PROYECTOS
  add constraint CK_YPROY_RANGO_FECHA_REAL
  check ((fec_ini_real is not null
and fec_ini_real < fec_fin_real) or (fec_ini_real is null
and fec_fin_real is null));

