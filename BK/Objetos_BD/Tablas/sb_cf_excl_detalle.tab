create table IT.SB_CF_EXCL_DETALLE (
  ID_EJECUCION      NUMBER         NOT NULL,
  COD_REGLA         VARCHAR2(10)   NOT NULL,
  ACCION            VARCHAR2(10)   NOT NULL,
  COD_PERSONA       NUMBER,
  TIPO_IDENT        VARCHAR2(10),
  NRO_DOCUMENTO     VARCHAR2(50),
  TIPO_PER          VARCHAR2(3),
  NOMBRE            VARCHAR2(120),
  APELLIDO          VARCHAR2(120),
  PAIS_NACIMIENTO   VARCHAR2(2),
  FECHA_NAC         DATE,
  FECHA_VENC_DOC    DATE,
  GENERO            VARCHAR2(1),
  MOTIVO            VARCHAR2(500),
  VALOR_ORIGINAL    VARCHAR2(200),
  VALOR_CORREGIDO   VARCHAR2(200),
  FEC_LOG           TIMESTAMP      DEFAULT SYSTIMESTAMP
) TABLESPACE IT_DATA;

CREATE INDEX IT.IN_SCFED_ID_EJECUCION
  ON IT.SB_CF_EXCL_DETALLE (ID_EJECUCION, COD_REGLA)
  TABLESPACE IT_IND;

CREATE INDEX IT.IN_SCFED_PERSONA
  ON IT.SB_CF_EXCL_DETALLE (COD_PERSONA)
  TABLESPACE IT_IND;

COMMENT ON TABLE IT.SB_CF_EXCL_DETALLE IS 'Detalle por persona de exclusiones y correcciones del CF Alta Personas';
COMMENT ON COLUMN IT.SB_CF_EXCL_DETALLE.COD_REGLA       IS 'Regla que origino la accion: R01..R21';
COMMENT ON COLUMN IT.SB_CF_EXCL_DETALLE.ACCION          IS 'EXCLUIR: no va al CSV | CORREGIR: va al CSV con valor modificado';
COMMENT ON COLUMN IT.SB_CF_EXCL_DETALLE.MOTIVO          IS 'Descripcion del problema puntual de este registro';
COMMENT ON COLUMN IT.SB_CF_EXCL_DETALLE.VALOR_ORIGINAL  IS 'Valor tal como esta en Bankiti';
COMMENT ON COLUMN IT.SB_CF_EXCL_DETALLE.VALOR_CORREGIDO IS 'Valor enviado al CSV (solo para CORREGIR)';

CREATE PUBLIC SYNONYM SB_CF_EXCL_DETALLE FOR IT.SB_CF_EXCL_DETALLE;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_CF_EXCL_DETALLE TO IT_CONSULTAS;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_CF_EXCL_DETALLE TO IT_TEMPORAL;
