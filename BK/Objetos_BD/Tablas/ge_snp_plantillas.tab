create table IT.GE_SNP_PLANTILLAS
(
  nro_plantilla            NUMBER(10) not null,
  cod_persona              VARCHAR2(10) not null,
  nro_cta_solicitante      VARCHAR2(35) not null,
  cod_moneda               VARCHAR2(3) not null,
  monto                    NUMBER(18,2) not null,
  cod_swi_pte_beneficiario VARCHAR2(20) not null,
  nro_cta_beneficiario     VARCHAR2(35) not null,
  nom_beneficiario         VARCHAR2(120) not null,
  cod_tip_doc_beneficiario NUMBER(3) not null,
  nro_doc_beneficiario     VARCHAR2(20) not null,
  cod_per_vinculada        VARCHAR2(10),
  dir_beneficiario         VARCHAR2(100),
  usu_insercion            VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion            DATE default SYSDATE not null,
  usu_modificacion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion         DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SNP_PLANTILLAS
  is 'Contiene los datos frecuentes de Transferencias Interbancarias.';
comment on column IT.GE_SNP_PLANTILLAS.nro_plantilla
  is 'Identificador del registro - secuencia S_SNP_NRO_PLANTILLA.';
comment on column IT.GE_SNP_PLANTILLAS.cod_persona
  is 'Código del cliente.';
comment on column IT.GE_SNP_PLANTILLAS.nro_cta_solicitante
  is 'Cuenta de Referencia de la Transferencia (puede ser de la Entidad si es Emitida o Externa si es Recibida).';
comment on column IT.GE_SNP_PLANTILLAS.cod_moneda
  is 'Código de Moneda.';
comment on column IT.GE_SNP_PLANTILLAS.monto
  is 'Monto de la Transferencia.';
comment on column IT.GE_SNP_PLANTILLAS.cod_swi_pte_beneficiario
  is 'Codigo Swift, codigo electrónico del banco.';
comment on column IT.GE_SNP_PLANTILLAS.nro_cta_beneficiario
  is 'Cuenta de Referencia de la Transferencia (puede ser de la Entidad si es Emitida o Externa si es Recibida).';
comment on column IT.GE_SNP_PLANTILLAS.nom_beneficiario
  is 'Nombre y Apellido del Beneficiario.';
comment on column IT.GE_SNP_PLANTILLAS.cod_tip_doc_beneficiario
  is 'Tipo de Documento del Beneficiario.';
comment on column IT.GE_SNP_PLANTILLAS.nro_doc_beneficiario
  is 'Número de Documento de Identidad del Beneficiario.';
comment on column IT.GE_SNP_PLANTILLAS.cod_per_vinculada
  is 'Código de la persona jurídica a la que está vinculada el cliente.';
comment on column IT.GE_SNP_PLANTILLAS.dir_beneficiario
  is 'Dirección del Beneficiario.';
comment on column IT.GE_SNP_PLANTILLAS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_SNP_PLANTILLAS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_SNP_PLANTILLAS.usu_modificacion
  is 'Usuario que realizó la ultima modificación en el registro.';
comment on column IT.GE_SNP_PLANTILLAS.fec_modificacion
  is 'Fecha en que se realizó la ultima modificación en el registro.';
alter table IT.GE_SNP_PLANTILLAS
  add constraint PK_GE_SNP_PLANTILLAS primary key (NRO_PLANTILLA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SNP_PLANTILLAS
  add constraint UN_GE_SNP_PLANTILLAS unique (COD_PERSONA, NRO_CTA_SOLICITANTE, COD_MONEDA, MONTO, COD_SWI_PTE_BENEFICIARIO, NRO_CTA_BENEFICIARIO, NOM_BENEFICIARIO, COD_TIP_DOC_BENEFICIARIO, NRO_DOC_BENEFICIARIO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

