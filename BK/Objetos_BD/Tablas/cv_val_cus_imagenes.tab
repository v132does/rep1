create table IT.CV_VAL_CUS_IMAGENES
(
  cod_val_custodia  NUMBER(15) not null,
  ima_doc           BLOB,
  cod_tip_documento VARCHAR2(10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_insercion     VARCHAR2(10) default substr(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default substr(USER,1,10) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CV_VAL_CUS_IMAGENES
  is 'Registro de imágenes de archivos en custodia.';
comment on column IT.CV_VAL_CUS_IMAGENES.cod_val_custodia
  is 'Código del Valor en Custodia.';
comment on column IT.CV_VAL_CUS_IMAGENES.ima_doc
  is 'Imagen del Documento en Custodia.';
comment on column IT.CV_VAL_CUS_IMAGENES.cod_tip_documento
  is 'Tipo de Documento.Dominio: TIP_ARCHIVO.';
comment on column IT.CV_VAL_CUS_IMAGENES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CV_VAL_CUS_IMAGENES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CV_VAL_CUS_IMAGENES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.CV_VAL_CUS_IMAGENES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
alter table IT.CV_VAL_CUS_IMAGENES
  add constraint PK_CV_VAL_CUS_IMAGENES primary key (COD_VAL_CUSTODIA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

