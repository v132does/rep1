create table IT.PR_PRE_APROBADOS_TMP_MOM
(
  cod_pre_aprobado     NUMBER not null,
  cod_pla_pre_aprobado VARCHAR2(20),
  fec_ini_oferta       DATE,
  fec_fin_oferta       DATE,
  cod_oficina          NUMBER(3),
  cod_usu_oficial      VARCHAR2(10),
  cod_persona          VARCHAR2(10) not null,
  mon_pre_aprobado     NUMBER(18,2),
  can_cuota            NUMBER(5),
  tip_amortizacion     VARCHAR2(1),
  cod_modalidad        NUMBER(3),
  cod_rub_economico    VARCHAR2(6),
  cod_moneda           VARCHAR2(3),
  nro_solicitud        NUMBER(7),
  mot_estado           VARCHAR2(500),
  can_visitas          NUMBER(7),
  cod_canal            NUMBER(3),
  estado               VARCHAR2(1) default 'C',
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion        DATE default SYSDATE,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion     DATE default SYSDATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_PRE_APROBADOS_TMP_MOM
  is 'Prestamos pre aprobados.';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.cod_pre_aprobado
  is 'Identificador de la base de pre aprobados.';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.cod_pla_pre_aprobado
  is 'Codigo asignado por BI a las Planillas.';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.fec_ini_oferta
  is 'Inicio de Vigencia del pre aprobado.';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.fec_fin_oferta
  is 'Fin de Vigencia del pre aprobado.';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.cod_oficina
  is 'Codigo de Oficina / Sucursal.';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.cod_usu_oficial
  is 'Oficial del cliente';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.cod_persona
  is 'Codigo del cliente';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.mon_pre_aprobado
  is 'Monto del pre aprobado';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.can_cuota
  is 'Cantidad de cuotas del pre aprobado';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.tip_amortizacion
  is 'Tipo de sistema de Amortizacion';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.cod_modalidad
  is 'Codigo de modalidad';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.cod_rub_economico
  is 'Codigo de rubro economico';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.cod_moneda
  is 'Codigo de moneda';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.nro_solicitud
  is 'Numero de propuesta';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.mot_estado
  is 'Motivo del Estado';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.can_visitas
  is 'Cantidad de vistas de la oferta';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.cod_canal
  is 'Canal';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.estado
  is 'Estado de la Oferta C-Vigente, N-Cancelado, R-Rechazado, G-En proceso, V-Vencido, D-Desembolsado';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.usu_insercion
  is 'Usuario que realizo la insercion';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.fec_insercion
  is 'Fecha en que se inserto el registro';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.usu_modificacion
  is 'Usuario que realizo la modificacion';
comment on column IT.PR_PRE_APROBADOS_TMP_MOM.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion';
alter table IT.PR_PRE_APROBADOS_TMP_MOM
  add constraint PK_PR_PRE_APROBADOS_TMP_MON primary key (COD_PRE_APROBADO, COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

