-- Create table
create table IT.TA_COBROS_GP
(
  nro_cuenta       VARCHAR2(15) not null,
  nro_tarjeta      VARCHAR2(25) not null,
  nro_cta_debito   VARCHAR2(15),
  fec_proceso      DATE not null,
  monto            NUMBER(18,2) default 0 not null,
  estado           VARCHAR2(1) not null,
  fec_valor        DATE not null,
  observacion      VARCHAR2(50),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  est_envio        VARCHAR2(1) default 'P',
  hora             VARCHAR2(8),
  cod_usuario      VARCHAR2(10),
  dia_mora         NUMBER(5),
  tip_envio        VARCHAR2(1) default 'O',
  tipo             VARCHAR2(1),
  red_pago         VARCHAR2(2),
  canal            VARCHAR2(2),
  nro_documento    NUMBER(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.TA_COBROS_GP
  is 'Contiene los datos de los cobros realizados hasta la fecha. Esta tabla se utiliza para enviar a las administradoras los cobros recibidos en el dia. (fba120.fecha del dia).  ** Mantener seis meses **.';
-- Add comments to the columns 
comment on column IT.TA_COBROS_GP.nro_cuenta
  is 'Número de cuenta.';
comment on column IT.TA_COBROS_GP.nro_tarjeta
  is 'Número de Tarjeta.';
comment on column IT.TA_COBROS_GP.nro_cta_debito
  is 'N?mero de Cuenta.';
comment on column IT.TA_COBROS_GP.fec_proceso
  is 'Fecha de Proceso.';
comment on column IT.TA_COBROS_GP.monto
  is 'Importe de débito.';
comment on column IT.TA_COBROS_GP.estado
  is 'Estado del Registro: C-Cobrado en Caja P-Procesado por debito en cuenta E-No procesado por error.';
comment on column IT.TA_COBROS_GP.fec_valor
  is 'Fecha Valor del Pago.';
comment on column IT.TA_COBROS_GP.observacion
  is 'Observaciones, en caso de que hubo error descripción del Error.';
comment on column IT.TA_COBROS_GP.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.TA_COBROS_GP.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.TA_COBROS_GP.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.TA_COBROS_GP.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.TA_COBROS_GP.est_envio
  is 'Estado de Envío a la Procesadora P=Pendiente, E=Enviado.';
comment on column IT.TA_COBROS_GP.hora
  is 'Hora.';
comment on column IT.TA_COBROS_GP.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.TA_COBROS_GP.dia_mora
  is 'Dias de Mora en el momento del cobro.';
comment on column IT.TA_COBROS_GP.tip_envio
  is 'Tipo de Envío de cobro "B" - Batch, "O" - Online.';
comment on column IT.TA_COBROS_GP.tipo
  is 'Tipo P-Pago, R-Reversión';
comment on column IT.TA_COBROS_GP.red_pago
  is 'Red de Pago(1-Pronet, 2-Practipago,...)';
comment on column IT.TA_COBROS_GP.canal
  is 'Canal de donde proviene el pago(C: CORE, W: WEB, A: APP)';
comment on column IT.TA_COBROS_GP.nro_documento
  is 'Corresponde al código de confirmación o nro. cupón de GP';
-- Create/Recreate indexes 
create index IN_TCOBRGP_CTA_PROCESO on IT.TA_COBROS_GP (NRO_CTA_DEBITO, FEC_PROCESO, ESTADO, NRO_TARJETA, NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IN_TCOBRGP_FEC_PROCESO on IT.TA_COBROS_GP (FEC_PROCESO, NRO_TARJETA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IN_TCOBRGP_NRO_CTA_DEBITO on IT.TA_COBROS_GP (NRO_CTA_DEBITO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IN_TCOBRGP_NRO_CUENTA on IT.TA_COBROS_GP (NRO_CUENTA, NRO_TARJETA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IN_TCOBRGP_VAL_EST_CTA on IT.TA_COBROS_GP (FEC_VALOR, ESTADO, NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Grant/Revoke object privileges 
grant select on IT.TA_COBROS_GP to IT_CONSULTAS;
grant select, insert, update, delete on IT.TA_COBROS_GP to IT_TEMPORAL;
grant select, insert, update, delete, references on IT.TA_COBROS_GP to MI;
grant select on IT.TA_COBROS_GP to UENO_EXTRACTOR;
