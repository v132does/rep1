create table IT.PLSQL_PROFILER_DATA
(
  runid       NUMBER not null,
  unit_number NUMBER not null,
  line#       NUMBER not null,
  total_occur NUMBER,
  total_time  NUMBER,
  min_time    NUMBER,
  max_time    NUMBER,
  spare1      NUMBER,
  spare2      NUMBER,
  spare3      NUMBER,
  spare4      NUMBER
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PLSQL_PROFILER_DATA
  is 'Accumulated data from all profiler runs.';
alter table IT.PLSQL_PROFILER_DATA
  add primary key (RUNID, UNIT_NUMBER, LINE#)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PLSQL_PROFILER_DATA
  add foreign key (RUNID, UNIT_NUMBER)
  references IT.PLSQL_PROFILER_UNITS (RUNID, UNIT_NUMBER);

