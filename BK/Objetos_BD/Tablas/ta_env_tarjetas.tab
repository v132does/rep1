  is 'Nro. de Solicitud.';
comment on column IT.TA_ENV_TARJETAS.cod_modalidad
  is 'Código de Modalidad. ';
comment on column IT.TA_ENV_TARJETAS.sec_env_datos
  is 'Secuencia de Envío de Datos.';
comment on column IT.TA_ENV_TARJETAS.usu_insercion
  is 'Usuario de Inserción.';
comment on column IT.TA_ENV_TARJETAS.fec_insercion
  is 'Fecha de Inserción.';
comment on column IT.TA_ENV_TARJETAS.usu_modificacion
  is 'Usuario de Modificación.';
comment on column IT.TA_ENV_TARJETAS.fec_modificacion
  is 'Fecha de Modificación.';
comment on column IT.TA_ENV_TARJETAS.tip_per_titular
