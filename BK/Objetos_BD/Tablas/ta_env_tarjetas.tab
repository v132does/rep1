  is 'Secuencia del Alta.';
comment on column IT.TA_ENV_TARJETAS.cod_movimiento
  is 'Código del Movimiento (A=Activa, C=Inactiva, M=Modificacion, Null=No Renovacion) ';
comment on column IT.TA_ENV_TARJETAS.nom_embozado
  is 'Nombre Embozado.';
comment on column IT.TA_ENV_TARJETAS.fec_envio
  is 'Fecha de Envío.';
comment on column IT.TA_ENV_TARJETAS.hor_envio
  is 'Hora de Envío.';
comment on column IT.TA_ENV_TARJETAS.estado
  is 'Estado.';
