  is 'Código del Banco.';
comment on column IT.TA_ENV_TARJETAS.cod_sucursal
  is 'Código de la Sucursal. ';
comment on column IT.TA_ENV_TARJETAS.cod_afinidad
  is 'Código de Afinidad de la Procesadora. (Ref. Externa TA_TIPOS) ';
comment on column IT.TA_ENV_TARJETAS.fec_movimiento
  is 'Fecha del Movimiento. ';
