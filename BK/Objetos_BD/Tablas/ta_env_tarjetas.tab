comment on column IT.TA_ENV_TARJETAS.cod_tip_doc_titular
  is 'Tipo de Documento(''CAD'',''CIP'',''PAS'',''CIE'',''RUC'')-Requerido si Tipo Persona=''F'' -Titular de la Tarjeta.';
comment on column IT.TA_ENV_TARJETAS.pri_nom_titular
  is 'Primer Nombre -Titular de la Tarjeta.';
comment on column IT.TA_ENV_TARJETAS.seg_nom_titular
  is 'Segundo Nombre -Titular de la Tarjeta.';
