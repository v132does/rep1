create table IT.TA_ENV_TARJETAS
(
  cod_procesadora          VARCHAR2(10),
  nro_tarjeta              VARCHAR2(19),
  nro_cuenta               VARCHAR2(15),
  nom_usuario              VARCHAR2(26),
  cod_persona              VARCHAR2(10),
  nro_documento            VARCHAR2(20),
  nro_doc_procesadora      VARCHAR2(20),
  dur_tarjeta              NUMBER(2),
  tip_tarjeta              VARCHAR2(1),
  ven_tarjeta              VARCHAR2(4),
  cod_encargado            VARCHAR2(2),
  cla_tarjeta              VARCHAR2(2),
  cod_banco                NUMBER(3),
  cod_sucursal             NUMBER(4),
  cod_afinidad             VARCHAR2(10),
  fec_movimiento           DATE,
  sec_alta                 NUMBER(4),
  cod_movimiento           VARCHAR2(1),
  nom_embozado             VARCHAR2(26),
  fec_envio                DATE,
  hor_envio                VARCHAR2(8),
  estado                   VARCHAR2(1),
  nro_solicitud            NUMBER(7),
  cod_modalidad            NUMBER(3),
  sec_env_datos            NUMBER(12),
  usu_insercion            VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion            DATE default SYSDATE not null,
  usu_modificacion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion         DATE default SYSDATE not null,
  tip_per_titular          VARCHAR2(1),
  cod_tip_doc_titular      VARCHAR2(3),
  pri_nom_titular          VARCHAR2(20),
  seg_nom_titular          VARCHAR2(20),
  pri_ape_titular          VARCHAR2(20),
  seg_ape_titular          VARCHAR2(20),
  cod_pai_titular          NUMBER(3),
  cod_sex_titular          VARCHAR2(1),
  fec_nac_titular          DATE,
  lug_nac_titular          VARCHAR2(15),
  est_civ_titular          VARCHAR2(1),
  act_titular              VARCHAR2(4),
  dir_cor_titular          VARCHAR2(60),
  tip_doc_nvo_titular      VARCHAR2(3),
  nro_doc_nvo_titular      VARCHAR2(16),
  tip_plastico             VARCHAR2(1),
  nom_plastico             VARCHAR2(26),
  adi_personalizado        VARCHAR2(1),
  nro_doc_promotor         VARCHAR2(16),
  cod_tip_doc_promotor     VARCHAR2(3),
  situacion                VARCHAR2(1),
  ren_automatica           VARCHAR2(1),
  orden_1                  NUMBER(4),
  orden_2                  NUMBER(6),
  tip_per_promotor         VARCHAR2(1),
  pri_nom_promotor         VARCHAR2(20),
  seg_nom_promotor         VARCHAR2(20),
  pri_ape_promotor         VARCHAR2(20),
  seg_ape_promotor         VARCHAR2(20),
  cod_sex_promotor         VARCHAR2(1),
  fec_nac_promotor         DATE,
  lug_nac_promotor         VARCHAR2(15),
  est_civ_promotor         VARCHAR2(1),
  act_promotor             VARCHAR2(4),
  dir_cor_promotor         VARCHAR2(60),
  pla_contado              VARCHAR2(2),
  ope_pla_contado          VARCHAR2(1),
  imp_per_pla_contado      NUMBER(16),
  por_per_pla_contado      NUMBER(6),
  pla_ade_efectivo         VARCHAR2(2),
  ope_pla_ade_efectivo     VARCHAR2(1),
  imp_per_pla_ade_efectivo NUMBER(16),
  por_per_ade_efectivo     NUMBER(6),
  pue_financiar            VARCHAR2(1),
  usu_actualizacion        VARCHAR2(10),
  emboza                   VARCHAR2(1),
  nro_socio                VARCHAR2(15),
  mot_novedad              NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_ENV_TARJETAS
  is 'Envio de alta de tarjetas';
comment on column IT.TA_ENV_TARJETAS.cod_procesadora
  is 'Código de la Procesadora.';
comment on column IT.TA_ENV_TARJETAS.nro_tarjeta
  is 'Nro. de tarjeta. ';
comment on column IT.TA_ENV_TARJETAS.nro_cuenta
  is 'Nro. de cuenta. ';
comment on column IT.TA_ENV_TARJETAS.nom_usuario
  is 'Nombre usuario. ';
comment on column IT.TA_ENV_TARJETAS.cod_persona
  is 'Código de Persona.';
comment on column IT.TA_ENV_TARJETAS.nro_documento
  is 'Nro. de Documento. ';
comment on column IT.TA_ENV_TARJETAS.nro_doc_procesadora
  is 'Nro. Documento de la Procesadora. ';
comment on column IT.TA_ENV_TARJETAS.dur_tarjeta
  is 'Duración de la Tarjeta. ';
