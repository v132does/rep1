create table IT.CC_LIB_ANT_CHEQUES
(
  nro_cuenta       VARCHAR2(15) not null,
  nro_documento    NUMBER(15) not null,
  cod_retencion    NUMBER(3) not null,
  fec_final        DATE not null,
  cod_oficina      NUMBER(3) not null,
  cod_moneda       VARCHAR2(3) not null,
  monto            NUMBER(18,2) default 0 not null,
  fec_inicio       DATE not null,
  nro_sol_prestamo NUMBER(7) not null,
  nro_cta_prestamo VARCHAR2(15),
  estado           VARCHAR2(1) not null,
  fec_desembolso   DATE,
  hor_desembolso   VARCHAR2(8),
  usu_desembolso   VARCHAR2(10),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.CC_LIB_ANT_CHEQUES.nro_cuenta
  is 'Numero de la Cuenta.';
comment on column IT.CC_LIB_ANT_CHEQUES.nro_documento
  is 'Nro.de Documento (boleta de deposito).';
comment on column IT.CC_LIB_ANT_CHEQUES.cod_retencion
  is 'Codigo de Retencion. Ver tabla de Codigos de Retenciones.';
comment on column IT.CC_LIB_ANT_CHEQUES.fec_final
  is 'Fecha Valor de la Retencion (final de la retencion).';
comment on column IT.CC_LIB_ANT_CHEQUES.cod_oficina
  is 'Codigo de la Oficina de la Cuenta.';
comment on column IT.CC_LIB_ANT_CHEQUES.cod_moneda
  is 'Codigo de Moneda.';
comment on column IT.CC_LIB_ANT_CHEQUES.monto
  is 'Valor de la Retencion.';
comment on column IT.CC_LIB_ANT_CHEQUES.fec_inicio
  is 'Fecha de Inicio de la Retencion.';
comment on column IT.CC_LIB_ANT_CHEQUES.nro_sol_prestamo
  is 'Numero de Solicitud del Prestamo.';
comment on column IT.CC_LIB_ANT_CHEQUES.nro_cta_prestamo
  is 'Numero de la Cuenta del Prestamo.';
comment on column IT.CC_LIB_ANT_CHEQUES.estado
  is 'Estado.';
comment on column IT.CC_LIB_ANT_CHEQUES.fec_desembolso
  is 'Fecha en que se realizo el desembolso.';
comment on column IT.CC_LIB_ANT_CHEQUES.hor_desembolso
  is 'Hora en que se realizo el desembolso.';
comment on column IT.CC_LIB_ANT_CHEQUES.usu_desembolso
  is 'Usuario que realizo el desembolso.';
comment on column IT.CC_LIB_ANT_CHEQUES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_LIB_ANT_CHEQUES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_LIB_ANT_CHEQUES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_LIB_ANT_CHEQUES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CC_LIB_ANT_CHEQUES
  add constraint PK_CC_LIB_ANT_CHEQUES primary key (NRO_CUENTA, NRO_DOCUMENTO, COD_RETENCION, FEC_FINAL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_LIB_ANT_CHEQUES
  add constraint UK_NRO_SOLICITUD unique (NRO_SOL_PRESTAMO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

