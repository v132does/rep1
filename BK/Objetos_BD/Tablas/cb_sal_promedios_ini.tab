create table IT.CB_SAL_PROMEDIOS_INI
(
  cod_oficina           NUMBER(3) not null,
  cod_rubro             VARCHAR2(15) not null,
  ano                   NUMBER(4) not null,
  mes                   NUMBER(2) not null,
  cod_moneda            VARCHAR2(3) not null,
  tot_acumulado         NUMBER(18,2) default 0,
  tot_acu_mon_local     NUMBER(18,2) default 0,
  tot_acu_mon_fuerte    NUMBER(18,2) default 0,
  tot_acu_debitos       NUMBER(18,2) default 0,
  tot_acu_creditos      NUMBER(18,2) default 0,
  tot_acu_deb_mon_local NUMBER(18,2) default 0,
  tot_acu_cre_mon_local NUMBER(18,2) default 0,
  can_dia_acumulado     NUMBER(6),
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default SYSDATE not null,
  tot_acu_equ_local     NUMBER(18,2) default 0,
  tot_acu_deb_equ_loc   NUMBER(18,2) default 0,
  tot_acu_cre_equ_loc   NUMBER(18,2) default 0
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 4M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SAL_PROMEDIOS_INI
  is 'Contiene los datos de saldos promedios de cuentas contables **  Mantener un a?o completo **';
comment on column IT.CB_SAL_PROMEDIOS_INI.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.CB_SAL_PROMEDIOS_INI.cod_rubro
  is 'Codigo de la cuenta contable.';
comment on column IT.CB_SAL_PROMEDIOS_INI.ano
  is 'Codigo de a?o del saldo.';
comment on column IT.CB_SAL_PROMEDIOS_INI.mes
  is 'Codigo de mes del saldo.';
comment on column IT.CB_SAL_PROMEDIOS_INI.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.CB_SAL_PROMEDIOS_INI.tot_acumulado
  is 'Acumulado del saldo en moneda extranjera.';
comment on column IT.CB_SAL_PROMEDIOS_INI.tot_acu_mon_local
  is 'Acumulado del saldo en moneda local.';
comment on column IT.CB_SAL_PROMEDIOS_INI.tot_acu_mon_fuerte
  is 'Acumulado en dolares.';
comment on column IT.CB_SAL_PROMEDIOS_INI.tot_acu_debitos
  is 'Importe acumulado de debitos en moneda extranjera.';
comment on column IT.CB_SAL_PROMEDIOS_INI.tot_acu_creditos
  is 'Importe acumulado de creditos en moneda extranjera.';
comment on column IT.CB_SAL_PROMEDIOS_INI.tot_acu_deb_mon_local
  is 'Importe acumulado de debitos.';
comment on column IT.CB_SAL_PROMEDIOS_INI.tot_acu_cre_mon_local
  is 'Importe acumulado de creditos.';
comment on column IT.CB_SAL_PROMEDIOS_INI.can_dia_acumulado
  is 'Cantidad de dias.';
comment on column IT.CB_SAL_PROMEDIOS_INI.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_SAL_PROMEDIOS_INI.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_SAL_PROMEDIOS_INI.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_SAL_PROMEDIOS_INI.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CB_SAL_PROMEDIOS_INI.tot_acu_equ_local
  is 'Total  acumulado del equivalente en moneda local del acumulado en m/e.';
comment on column IT.CB_SAL_PROMEDIOS_INI.tot_acu_deb_equ_loc
  is 'Total acumulado de debitos equivalente en moneda local del acumulado en m/e.';
comment on column IT.CB_SAL_PROMEDIOS_INI.tot_acu_cre_equ_loc
  is 'Total acumulado de creditos equivalente en moneda local del acumulado en m/e.';

