create table IT.GE_DAT_ACC_OPE_CNB
(
  id_acceso            INTEGER not null,
  token                VARCHAR2(300) not null,
  tip_operacion        VARCHAR2(100) not null,
  estado               VARCHAR2(30) not null,
  fec_hor_conexion     DATE default sysdate not null,
  fec_hor_ult_conexion DATE default sysdate not null,
  empresa              VARCHAR2(50) not null,
  usu_acceso           VARCHAR2(50) not null,
  id_operacion         INTEGER not null,
  tok_req_id           INTEGER default 0 not null,
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_DAT_ACC_OPE_CNB.id_acceso
  is 'Id_acceso';
comment on column IT.GE_DAT_ACC_OPE_CNB.token
  is 'Token';
comment on column IT.GE_DAT_ACC_OPE_CNB.tip_operacion
  is 'Tip_operacion';
comment on column IT.GE_DAT_ACC_OPE_CNB.estado
  is 'Estado';
comment on column IT.GE_DAT_ACC_OPE_CNB.fec_hor_conexion
  is 'Fec_hor_conexion';
comment on column IT.GE_DAT_ACC_OPE_CNB.fec_hor_ult_conexion
  is 'Fec_hor_ult_conexion';
comment on column IT.GE_DAT_ACC_OPE_CNB.empresa
  is 'Empresa';
comment on column IT.GE_DAT_ACC_OPE_CNB.usu_acceso
  is 'Usu_acceso';
comment on column IT.GE_DAT_ACC_OPE_CNB.id_operacion
  is 'Id_operacion';
comment on column IT.GE_DAT_ACC_OPE_CNB.tok_req_id
  is 'Tok_req_id';
comment on column IT.GE_DAT_ACC_OPE_CNB.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_DAT_ACC_OPE_CNB.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_DAT_ACC_OPE_CNB.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_DAT_ACC_OPE_CNB.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

