create table IT.GE_GRU_TRA_ASSIST
(
  cod_gru_transaccion VARCHAR2(10) not null,
  descripcion         VARCHAR2(60),
  usu_insercion       VARCHAR2(10),
  fec_insercion       DATE,
  usu_modificacion    VARCHAR2(10),
  fec_modificacion    DATE,
  fec_envio           DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_GRU_TRA_ASSIST.cod_gru_transaccion
  is 'Código de Grupo de Transacciones.';
comment on column IT.GE_GRU_TRA_ASSIST.descripcion
  is 'Descripción del Grupo de Transacciones.';
comment on column IT.GE_GRU_TRA_ASSIST.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_GRU_TRA_ASSIST.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_GRU_TRA_ASSIST.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_GRU_TRA_ASSIST.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_GRU_TRA_ASSIST.fec_envio
  is 'Fecha de envío a ASSIST.';
alter table IT.GE_GRU_TRA_ASSIST
  add constraint PK_GE_GRU_TRA_ASSIST primary key (COD_GRU_TRANSACCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

