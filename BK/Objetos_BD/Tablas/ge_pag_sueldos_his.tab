create table IT.GE_PAG_SUELDOS_HIS
(
  cod_usuario      VARCHAR2(10),
  cod_ente         NUMBER(5) not null,
  fec_proceso      DATE,
  nro_secuencia    NUMBER(3) not null,
  cod_modalidad    NUMBER(3),
  nro_cuenta       VARCHAR2(15),
  cod_moneda       VARCHAR2(3),
  fec_envio        DATE,
  tipo             VARCHAR2(1),
  monto            NUMBER(18,2) default 0,
  estado           VARCHAR2(1),
  cod_proceso      NUMBER(3),
  cod_modulo       NUMBER(3),
  fec_insercion    DATE default SYSDATE not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  ano              NUMBER(4),
  nivel            NUMBER(2),
  entidad          NUMBER(3),
  observacion      VARCHAR2(15),
  procesado        VARCHAR2(1) default 'N'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAG_SUELDOS_HIS
  is 'Detalle de pago de sueldos.';
comment on column IT.GE_PAG_SUELDOS_HIS.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.GE_PAG_SUELDOS_HIS.cod_ente
  is 'codigo de ente.';
comment on column IT.GE_PAG_SUELDOS_HIS.fec_proceso
  is 'fecha de proceso.';
comment on column IT.GE_PAG_SUELDOS_HIS.nro_secuencia
  is 'nro de secuencia.';
comment on column IT.GE_PAG_SUELDOS_HIS.cod_modalidad
  is 'codigo de modalidad.';
comment on column IT.GE_PAG_SUELDOS_HIS.nro_cuenta
  is 'nro de cuenta.';
comment on column IT.GE_PAG_SUELDOS_HIS.cod_moneda
  is 'cod moneda.';
comment on column IT.GE_PAG_SUELDOS_HIS.fec_envio
  is 'fecha de envio.';
comment on column IT.GE_PAG_SUELDOS_HIS.tipo
  is 'tipo.';
comment on column IT.GE_PAG_SUELDOS_HIS.monto
  is 'monto.';
comment on column IT.GE_PAG_SUELDOS_HIS.estado
  is 'estado.';
comment on column IT.GE_PAG_SUELDOS_HIS.cod_proceso
  is 'codigo de proceso.';
comment on column IT.GE_PAG_SUELDOS_HIS.cod_modulo
  is 'codigo de modulo.';
comment on column IT.GE_PAG_SUELDOS_HIS.fec_insercion
  is 'fecha de insercion.';
comment on column IT.GE_PAG_SUELDOS_HIS.usu_insercion
  is 'usuario de insercion.';
comment on column IT.GE_PAG_SUELDOS_HIS.fec_modificacion
  is 'fecha de modificacion.';
comment on column IT.GE_PAG_SUELDOS_HIS.usu_modificacion
  is 'usuario de modificacion.';
comment on column IT.GE_PAG_SUELDOS_HIS.ano
  is 'Año del Movimiento.';
comment on column IT.GE_PAG_SUELDOS_HIS.nivel
  is 'Nivel.';
comment on column IT.GE_PAG_SUELDOS_HIS.entidad
  is 'Codigo de Entidad.';
comment on column IT.GE_PAG_SUELDOS_HIS.observacion
  is 'Observacion. (Contine numero de Remito para ciertos Entes)';
comment on column IT.GE_PAG_SUELDOS_HIS.procesado
  is 'Procesado (S / N)';
create index IT.IN_GPSUE_COD_ENTE2 on IT.GE_PAG_SUELDOS_HIS (FEC_PROCESO, COD_ENTE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GPSUE_NRO_CUENTA2 on IT.GE_PAG_SUELDOS_HIS (NRO_CUENTA, FEC_PROCESO, COD_ENTE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

