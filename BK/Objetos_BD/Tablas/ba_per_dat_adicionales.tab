create table IT.BA_PER_DAT_ADICIONALES
(
  cod_persona      VARCHAR2(10) not null,
  parametro        VARCHAR2(30) not null,
  val_parametro    VARCHAR2(200) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_PER_DAT_ADICIONALES
  is 'Datos adicionales por Persona';
comment on column IT.BA_PER_DAT_ADICIONALES.cod_persona
  is 'Codigo de Persona.';
comment on column IT.BA_PER_DAT_ADICIONALES.parametro
  is 'Codigo del campo.';
comment on column IT.BA_PER_DAT_ADICIONALES.val_parametro
  is 'Valor del campo.';
comment on column IT.BA_PER_DAT_ADICIONALES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_PER_DAT_ADICIONALES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_PER_DAT_ADICIONALES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_PER_DAT_ADICIONALES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_BPDAD_PARAMETRO on IT.BA_PER_DAT_ADICIONALES (PARAMETRO, VAL_PARAMETRO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_PER_DAT_ADICIONALES
  add constraint PK_BA_PER_DAT_ADICIONALES primary key (COD_PERSONA, PARAMETRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_PER_DAT_ADICIONALES
  add constraint FK_BPDAD_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);

