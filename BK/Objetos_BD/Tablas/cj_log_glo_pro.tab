create table IT.CJ_LOG_GLO_PRO
(
  fec_sistema       DATE,
  pedido            VARCHAR2(4000),
  respuesta         VARCHAR2(4000),
  msj_error         VARCHAR2(4000),
  fecha             DATE,
  hora              VARCHAR2(8),
  nro_transaccion   VARCHAR2(4000),
  nro_cta_debito    VARCHAR2(100),
  cod_bco_debito    NUMBER(3),
  nro_cta_credito   VARCHAR2(15),
  cod_bco_credito   NUMBER(3),
  cod_operacion     VARCHAR2(200),
  mto_total         NUMBER(18,2),
  cod_moneda        VARCHAR2(3),
  nro_atm           VARCHAR2(20),
  cod_bco_atm       NUMBER(3),
  nro_pos           NUMBER(2),
  tra_pos           NUMBER(4),
  tip_hora          VARCHAR2(3),
  nom_comercio      VARCHAR2(48),
  nro_documento     VARCHAR2(15),
  cod_estado        VARCHAR2(6),
  fec_insercion     DATE default sysdate not null,
  nro_tra_cancelado VARCHAR2(4000),
  mot_cancelacion   VARCHAR2(4000),
  cod_comercio      VARCHAR2(20),
  mcc               VARCHAR2(20),
  cod_postal        VARCHAR2(255),
  nro_tarjeta       VARCHAR2(20),
  cod_mon_iso       VARCHAR2(3),
  cod_mon_iso_tra   VARCHAR2(3),
  fec_proceso       VARCHAR2(30),
  hor_proceso       VARCHAR2(8),
  cod_usuario       VARCHAR2(10),
  tag_internacional VARCHAR2(100),
  men_json          VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CJ_LOG_GLO_PRO
  is 'Log de Autorizaciones de Global.';
comment on column IT.CJ_LOG_GLO_PRO.fec_sistema
  is 'Fecha del sistema.';
comment on column IT.CJ_LOG_GLO_PRO.pedido
  is 'Pedido.';
comment on column IT.CJ_LOG_GLO_PRO.respuesta
  is 'Respuesta.';
comment on column IT.CJ_LOG_GLO_PRO.msj_error
  is 'Mensaje de Error.';
comment on column IT.CJ_LOG_GLO_PRO.fecha
  is 'Fecha calendario.';
comment on column IT.CJ_LOG_GLO_PRO.hora
  is 'Hora Movimiento.';
comment on column IT.CJ_LOG_GLO_PRO.nro_transaccion
  is 'Nro. Transaccion (request_id)';
comment on column IT.CJ_LOG_GLO_PRO.nro_cta_debito
  is 'Nro. Cuenta Debito.';
comment on column IT.CJ_LOG_GLO_PRO.cod_bco_debito
  is 'Banco Debito.';
comment on column IT.CJ_LOG_GLO_PRO.nro_cta_credito
  is 'Nro. Cuenta Credito.';
comment on column IT.CJ_LOG_GLO_PRO.cod_bco_credito
  is 'Banco Credito.';
comment on column IT.CJ_LOG_GLO_PRO.cod_operacion
  is 'Cod. Operacion.';
comment on column IT.CJ_LOG_GLO_PRO.mto_total
  is 'Monto Operacion.';
comment on column IT.CJ_LOG_GLO_PRO.cod_moneda
  is 'Cod. Moneda.';
comment on column IT.CJ_LOG_GLO_PRO.nro_atm
  is 'Nro atm (Terminal).';
comment on column IT.CJ_LOG_GLO_PRO.cod_bco_atm
  is 'Codigo banco ATM.';
comment on column IT.CJ_LOG_GLO_PRO.nro_pos
  is 'Nro. Pos.';
comment on column IT.CJ_LOG_GLO_PRO.tra_pos
  is 'Tra. Pos.';
comment on column IT.CJ_LOG_GLO_PRO.tip_hora
  is 'Tipo Hora.';
comment on column IT.CJ_LOG_GLO_PRO.nom_comercio
  is 'Nombre del Comercio.';
comment on column IT.CJ_LOG_GLO_PRO.nro_documento
  is 'Nro. Documento.';
comment on column IT.CJ_LOG_GLO_PRO.cod_estado
  is 'Estado.';
comment on column IT.CJ_LOG_GLO_PRO.fec_insercion
  is 'Fecha Insercion.';
comment on column IT.CJ_LOG_GLO_PRO.nro_tra_cancelado
  is 'Nro. Transaccion Cencelado.';
comment on column IT.CJ_LOG_GLO_PRO.mot_cancelacion
  is 'Motivo Cancelacion.';
comment on column IT.CJ_LOG_GLO_PRO.cod_comercio
  is 'Cod. Comercio.';
comment on column IT.CJ_LOG_GLO_PRO.mcc
  is 'MCC.';
comment on column IT.CJ_LOG_GLO_PRO.cod_postal
  is 'Cod. Postal.';
comment on column IT.CJ_LOG_GLO_PRO.nro_tarjeta
  is 'Nro Tarjeta.';
comment on column IT.CJ_LOG_GLO_PRO.cod_mon_iso
  is 'Cod. Moneda ISO.';
comment on column IT.CJ_LOG_GLO_PRO.cod_mon_iso_tra
  is 'Cod. Moneda Iso Transaccion.';
comment on column IT.CJ_LOG_GLO_PRO.fec_proceso
  is 'Fecha Proceso.';
comment on column IT.CJ_LOG_GLO_PRO.hor_proceso
  is 'Hora Proceso.';
comment on column IT.CJ_LOG_GLO_PRO.cod_usuario
  is 'Cod. Usuario';
comment on column IT.CJ_LOG_GLO_PRO.tag_internacional
  is 'Marca de transaccion internacional';
comment on column IT.CJ_LOG_GLO_PRO.men_json
  is 'Mensaje recibido-Traza';
create index IT.IN_JLOG_CANCEL on IT.CJ_LOG_GLO_PRO (NRO_TRA_CANCELADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 167
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_JLOG_FEC_INSERCION on IT.CJ_LOG_GLO_PRO (TRUNC(FEC_INSERCION), NRO_DOCUMENTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_JLOGL_FECHA on IT.CJ_LOG_GLO_PRO (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_JLOGL_FEC_SISTEMA on IT.CJ_LOG_GLO_PRO (FEC_SISTEMA)
  tablespace IT_IND
  pctfree 10
