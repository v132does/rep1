  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_JLOGL_NRO_CUENTA on IT.CJ_LOG_GLO_PRO (NRO_CTA_DEBITO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_JLOGL_NRO_TRANSACCION on IT.CJ_LOG_GLO_PRO (NRO_TRANSACCION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 167
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

