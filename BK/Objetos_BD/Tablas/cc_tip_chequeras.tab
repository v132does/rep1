create table IT.CC_TIP_CHEQUERAS
(
  cod_tip_chequera VARCHAR2(1) not null,
  descripcion      VARCHAR2(35) not null,
  can_cheques      VARCHAR2(60) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_tasa         NUMBER(3) not null,
  cod_transaccion  NUMBER(4) not null,
  tipo             VARCHAR2(1) not null,
  can_minima       NUMBER(5) default 0,
  can_maxima       NUMBER(5) default 99999,
  cod_moneda       VARCHAR2(3),
  cod_tas_casa     NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_TIP_CHEQUERAS
  is 'Define los tipos de chequeras que pueden solicitarse.';
comment on column IT.CC_TIP_CHEQUERAS.cod_tip_chequera
  is 'Codigo del tipo de chequera.';
comment on column IT.CC_TIP_CHEQUERAS.descripcion
  is 'Descripcion del tipo de chequera.';
comment on column IT.CC_TIP_CHEQUERAS.can_cheques
  is 'Cantidad de cheques que acepta el tipo de chequera, en caso de aceptar mas de una cantidad debe ir separado por comas Ej: 25,50,75.';
comment on column IT.CC_TIP_CHEQUERAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_TIP_CHEQUERAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_TIP_CHEQUERAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_TIP_CHEQUERAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_TIP_CHEQUERAS.cod_tasa
  is 'Codigo de Tasa.';
comment on column IT.CC_TIP_CHEQUERAS.cod_transaccion
  is 'Codigo de Transaccion.';
comment on column IT.CC_TIP_CHEQUERAS.tipo
  is 'Tipo(Vista/Diferido).';
comment on column IT.CC_TIP_CHEQUERAS.can_minima
  is 'Cantidad minima que puede ser solicitada.';
comment on column IT.CC_TIP_CHEQUERAS.can_maxima
  is 'Cantidad maxima que puede ser solicitada.';
comment on column IT.CC_TIP_CHEQUERAS.cod_moneda
  is 'Moneda al que aplica (Si es nulo a todos).';
alter table IT.CC_TIP_CHEQUERAS
  add constraint PK_CC_TIP_CHEQUERAS primary key (COD_TIP_CHEQUERA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_TIP_CHEQUERAS
  add constraint FK_CTCHE_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.CC_TIP_CHEQUERAS
  add constraint AVCON_1104333317_COD_T_000
  check (COD_TASA BETWEEN 0 AND 999);

