create table IT.DEPARTAMENTOS
(
  cddpto        VARCHAR2(15),
  departamentos VARCHAR2(30)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 8K
    minextents 1
    maxextents unlimited
  );
comment on column IT.DEPARTAMENTOS.cddpto
  is 'Código de Departamentos';

