create table IT.GE_PAS_FIDEICOMISO_TMP
(
  nro_cuenta    VARCHAR2(15),
  cod_modalidad NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_PAS_FIDEICOMISO_TMP.nro_cuenta
  is 'Nro. Cuenta';
comment on column IT.GE_PAS_FIDEICOMISO_TMP.cod_modalidad
  is 'Modalidad destino';

