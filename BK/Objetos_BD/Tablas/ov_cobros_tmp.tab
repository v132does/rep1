create table IT.OV_COBROS_TMP
(
  nro_cuenta        VARCHAR2(15) not null,
  fec_valor         DATE not null,
  estado            VARCHAR2(1) not null,
  sal_total         NUMBER(18,2) default 0,
  fec_ult_pago      DATE,
  dia_mora          NUMBER,
  mto_total         NUMBER(18,2) default 0,
  mto_int_moratorio NUMBER(18,2) default 0,
  mto_int_punitorio NUMBER(18,2) default 0,
  mto_cargo         NUMBER(18,2) default 0,
  mto_cargo_iva     NUMBER(18,2) default 0,
  mto_impuesto      NUMBER(18,2) default 0,
  nro_documento     NUMBER(15),
  mto_int_mor_cal   NUMBER(18,2) default 0,
  mto_int_pun_cal   NUMBER(18,2) default 0,
  mto_cargo_cal     NUMBER(18,2) default 0,
  mto_car_iva_cal   NUMBER(18,2) default 0,
  mto_impuesto_cal  NUMBER(18,2) default 0,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  mto_int_pun_des   NUMBER(18,2) default 0,
  mto_car_des       NUMBER(18,2) default 0,
  mto_int_mor_des   NUMBER(18,2) default 0
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.OV_COBROS_TMP
  is 'Se utiliza para los cobros de operaciones vencidas para calculos temporales.';
comment on column IT.OV_COBROS_TMP.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.OV_COBROS_TMP.fec_valor
  is 'Fecha valor del cobro.';
comment on column IT.OV_COBROS_TMP.estado
  is 'Estado en el momento del cobro.';
comment on column IT.OV_COBROS_TMP.sal_total
  is 'Saldo en el momento del cobro.';
comment on column IT.OV_COBROS_TMP.fec_ult_pago
  is 'Fecha de ultimo pago en el momento del cobro.';
comment on column IT.OV_COBROS_TMP.dia_mora
  is 'Dias de mora si estaba vencida.';
comment on column IT.OV_COBROS_TMP.mto_total
  is 'Monto cobrado.';
comment on column IT.OV_COBROS_TMP.mto_int_moratorio
  is 'Monto interes moratorio cobrado.';
comment on column IT.OV_COBROS_TMP.mto_int_punitorio
  is 'Monto interes punitorio cobrado.';
comment on column IT.OV_COBROS_TMP.mto_cargo
  is 'Monto del cargo cobrado.';
comment on column IT.OV_COBROS_TMP.mto_cargo_iva
  is 'Monto de impuesto sobre cargo cobrado.';
comment on column IT.OV_COBROS_TMP.mto_impuesto
  is 'Monto de impuestos cobrados.';
comment on column IT.OV_COBROS_TMP.nro_documento
  is 'Numero de documento.';
comment on column IT.OV_COBROS_TMP.mto_int_mor_cal
  is 'Monto interes moratorio calculado.';
comment on column IT.OV_COBROS_TMP.mto_int_pun_cal
  is 'Monto de interes punitorio calculado.';
comment on column IT.OV_COBROS_TMP.mto_cargo_cal
  is 'Monto de cargos calculado.';
comment on column IT.OV_COBROS_TMP.mto_car_iva_cal
  is 'Monto de impuesto sobre cargo calculado.';
comment on column IT.OV_COBROS_TMP.mto_impuesto_cal
  is 'Monto de impuesto calculado.';
comment on column IT.OV_COBROS_TMP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.OV_COBROS_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.OV_COBROS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.OV_COBROS_TMP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.OV_COBROS_TMP.mto_int_pun_des
  is 'Monto interes punitorio descontado.';
comment on column IT.OV_COBROS_TMP.mto_car_des
  is 'Monto del cargo descontado.';
comment on column IT.OV_COBROS_TMP.mto_int_mor_des
  is 'Monto interes moratorio descontado.';
alter table IT.OV_COBROS_TMP
  add constraint PK_OV_COBROS_TMP primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

