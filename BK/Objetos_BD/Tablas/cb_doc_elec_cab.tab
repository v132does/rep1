comment on column IT.CB_DOC_ELEC_CAB.icondope
  is 'Condición de la operación 1= Contado 2= Crédito';
comment on column IT.CB_DOC_ELEC_CAB.ddcondope
  is '60 Descripción de la condición de operación';
comment on column IT.CB_DOC_ELEC_CAB.icondcred
  is 'Condición de la operación a crédito';
comment on column IT.CB_DOC_ELEC_CAB.ddcondcred
  is 'Descripción de la condición de la operación a crédito';
comment on column IT.CB_DOC_ELEC_CAB.dplazocre
  is 'Plazo del crédito';
comment on column IT.CB_DOC_ELEC_CAB.dcuotas
  is 'Cantidad de cuotas';
