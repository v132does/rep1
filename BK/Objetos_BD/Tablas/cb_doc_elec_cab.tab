  is 'Subtotal de la operación con IVA incluido a la tasa 5%(es total del iva 5)';
comment on column IT.CB_DOC_ELEC_CAB.dsub10
  is 'Subtotal de la operación con IVA incluido a la tasa 10% (es total del iva 10)';
comment on column IT.CB_DOC_ELEC_CAB.dtotope
  is 'Total Bruto de la operación';
comment on column IT.CB_DOC_ELEC_CAB.dtotdesc
  is 'Total descuento particular por ítem';
comment on column IT.CB_DOC_ELEC_CAB.dtotdescglotem
  is 'Total descuento global por ítem';
comment on column IT.CB_DOC_ELEC_CAB.dtotantitem
  is 'Total Anticipo por ítem';
comment on column IT.CB_DOC_ELEC_CAB.dtotant
  is '80 Total Anticipo global por ítem';
comment on column IT.CB_DOC_ELEC_CAB.dporcdesctotal
  is 'Porcentaje de descuento global sobre total de la operación';
comment on column IT.CB_DOC_ELEC_CAB.ddesctotal
  is 'Total Descuentos de la operación';
comment on column IT.CB_DOC_ELEC_CAB.danticipo
  is 'Total Anticipos de la operación';
comment on column IT.CB_DOC_ELEC_CAB.dredon
  is 'Redondeo de la operación';
comment on column IT.CB_DOC_ELEC_CAB.dcomi
  is 'Comisión de la operación';
comment on column IT.CB_DOC_ELEC_CAB.dtotgralope
  is 'Total Neto de la operación';
