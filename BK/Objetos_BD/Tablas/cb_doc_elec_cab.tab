-- Create table
create table IT.CB_DOC_ELEC_CAB
(
  id_documento     NUMBER(8) not null,
  dinfoemi         VARCHAR2(2),
  dinfofisc        VARCHAR2(3000),
  itide            NUMBER(2),
  ddestide         VARCHAR2(40),
  dnumtim          NUMBER(8),
  dest             VARCHAR2(3),
  dpunexp          VARCHAR2(3),
  dnumdoc          VARCHAR2(7),
  dserienum        VARCHAR2(2),
  dfeinit          DATE,
  dfeemide         DATE,
  itiptra          NUMBER(2),
  ddestiptra       VARCHAR2(36),
  itimp            NUMBER(1),
  ddestimp         VARCHAR2(11),
  cmoneope         VARCHAR2(3),
  ddesmoneope      VARCHAR2(20),
  dcondticam       NUMBER(1),
  dticam           NUMBER(8,2),
  icondant         NUMBER(1),
  ddescondant      NUMBER(17),
  inatrec          NUMBER(1),
  itiope           NUMBER(1),
  cpaisrec         VARCHAR2(3),
  ddespaisre       VARCHAR2(20),
  iticontrec       NUMBER(1),
  drucrec          VARCHAR2(8),
  ddvrec           NUMBER(1),
  itipidrec        NUMBER(1),
  ddtipidrec       VARCHAR2(41),
  dnumidrec        VARCHAR2(20),
  dnomrec          VARCHAR2(255),
  dnomfanrec       VARCHAR2(255),
  ddirrec          VARCHAR2(255),
  dnumcasrec       NUMBER(6),
  cdeprec          NUMBER(2),
  ddesdeprec       VARCHAR2(16),
  cdisrec          NUMBER(4),
  ddesdisrec       VARCHAR2(30),
  cciurec          NUMBER(6),
  ddesciurec       VARCHAR2(30),
  dtelrec          VARCHAR2(15),
  dcelrec          VARCHAR2(20),
  demailrec        VARCHAR2(100),
  dcodcliente      VARCHAR2(15),
  iindpres         NUMBER(8),
  ddesindpres      VARCHAR2(50),
  dfecemnr         DATE,
  dmodcont         VARCHAR2(50),
  dentcont         NUMBER(5),
  danocont         NUMBER(2),
  dseccont         NUMBER(7),
  dfecodcont       DATE,
  imotemi          NUMBER(2),
  ddesmotemi       VARCHAR2(60),
  dkmr             NUMBER(5),
  dfecem           DATE,
  icondope         NUMBER(2),
  ddcondope        VARCHAR2(20),
  icondcred        NUMBER(2),
  ddcondcred       VARCHAR2(20),
  dplazocre        VARCHAR2(50),
  dcuotas          NUMBER(3),
  dmonent          NUMBER(15,4),
  dciclo           NUMBER(8),
  dfecinic         DATE,
  dfecfinc         DATE,
  dvencpag         DATE,
  dcontrato        NUMBER(10),
  dsalant          NUMBER(14),
  dsubexe          NUMBER(14,2),
  dsubexo          NUMBER(14,2),
  dsub5            NUMBER(14,2),
  dsub10           NUMBER(14,2),
  dtotope          NUMBER(14,2),
  dtotdesc         NUMBER(14,2) default 0,
  dtotdescglotem   NUMBER(14,2) default 0,
  dtotantitem      NUMBER(14) default 0,
  dtotant          NUMBER(14) default 0,
  dporcdesctotal   NUMBER(14,2) default 0,
  ddesctotal       NUMBER(14) default 0,
  danticipo        NUMBER(14) default 0,
  dredon           NUMBER(14) default 0,
  dcomi            NUMBER(22,8),
  dtotgralope      NUMBER(14,2),
  diva5            NUMBER(14),
  diva10           NUMBER(22,8),
  dliqtotiva5      NUMBER(22,8),
  dliqtotiva10     NUMBER(22,8),
  divacomi         NUMBER(22,8),
  dtotiva          NUMBER(22,8),
  dbasegrav5       NUMBER(22,8),
  dbasegrav10      NUMBER(22,8),
  dtbasgraiva      NUMBER(22,8),
  dtotalgs         NUMBER(20,4),
  dcarqr           VARCHAR2(600),
  dinfadic         VARCHAR2(3000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  est_fac          VARCHAR2(10),
  cod_control      VARCHAR2(44),
  sfn_observaciones VARCHAR2(4000),
  coblafe     NUMBER(3),
  ddesoblafe  VARCHAR2(65)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.CB_DOC_ELEC_CAB
  is 'Cabecera de la facturacion electronica.';
-- Add comments to the columns 
comment on column IT.CB_DOC_ELEC_CAB.id_documento
  is 'ID';
comment on column IT.CB_DOC_ELEC_CAB.dinfoemi
  is 'Información de interés del emisor respecto al DE';
comment on column IT.CB_DOC_ELEC_CAB.dinfofisc
  is 'Información de interés del Fisco respecto al DE. ej nota de remision.';
comment on column IT.CB_DOC_ELEC_CAB.itide
  is 'Tipo de Documento Electrónico. 1= Factura Electronica segun M.T.';
comment on column IT.CB_DOC_ELEC_CAB.ddestide
  is 'Descripción del tipo de documento electrónico';
comment on column IT.CB_DOC_ELEC_CAB.dnumtim
  is 'Número del timbrado';
comment on column IT.CB_DOC_ELEC_CAB.dest
  is 'Establecimiento';
comment on column IT.CB_DOC_ELEC_CAB.dpunexp
  is 'Punto de expedición';
comment on column IT.CB_DOC_ELEC_CAB.dnumdoc
  is 'Número del documento';
comment on column IT.CB_DOC_ELEC_CAB.dserienum
  is '10 Serie del número de timbrado';
comment on column IT.CB_DOC_ELEC_CAB.dfeinit
  is 'Fecha inicio de vigencia del timbrado';
comment on column IT.CB_DOC_ELEC_CAB.dfeemide
  is 'Fecha y hora de emisión del DE';
comment on column IT.CB_DOC_ELEC_CAB.itiptra
  is 'Tipo de transacción';
comment on column IT.CB_DOC_ELEC_CAB.ddestiptra
  is 'Descripción del tipo de transacción';
comment on column IT.CB_DOC_ELEC_CAB.itimp
  is 'Tipo de impuesto afectado';
comment on column IT.CB_DOC_ELEC_CAB.ddestimp
  is 'Descripción del tipo de impuesto afectado';
comment on column IT.CB_DOC_ELEC_CAB.cmoneope
  is 'Moneda de la operación';
comment on column IT.CB_DOC_ELEC_CAB.ddesmoneope
  is 'Descripción de la moneda de la operación';
comment on column IT.CB_DOC_ELEC_CAB.dcondticam
  is 'Condición del tipo de cambio';
comment on column IT.CB_DOC_ELEC_CAB.dticam
  is '20 Tipo de cambio de la operación';
comment on column IT.CB_DOC_ELEC_CAB.icondant
  is 'Condición del Anticipo';
comment on column IT.CB_DOC_ELEC_CAB.ddescondant
  is 'Descripción de la condición del Anticipo';
comment on column IT.CB_DOC_ELEC_CAB.inatrec
  is 'Naturaleza del receptor';
comment on column IT.CB_DOC_ELEC_CAB.itiope
  is 'Tipo de operación';
comment on column IT.CB_DOC_ELEC_CAB.cpaisrec
  is 'Código de país del receptor';
comment on column IT.CB_DOC_ELEC_CAB.ddespaisre
  is 'Descripción del país receptor';
comment on column IT.CB_DOC_ELEC_CAB.iticontrec
  is 'Tipo de contribuyente receptor';
comment on column IT.CB_DOC_ELEC_CAB.drucrec
  is 'RUC del receptor';
comment on column IT.CB_DOC_ELEC_CAB.ddvrec
  is 'Dígito verificador del RUC del receptor';
comment on column IT.CB_DOC_ELEC_CAB.itipidrec
  is '30 Tipo de documento de identidad del receptor';
comment on column IT.CB_DOC_ELEC_CAB.ddtipidrec
  is 'Descripción del tipo de documento de identidad';
comment on column IT.CB_DOC_ELEC_CAB.dnumidrec
  is 'Número de documento de identidad';
comment on column IT.CB_DOC_ELEC_CAB.dnomrec
  is 'Nombre o razón social del receptor del DE';
comment on column IT.CB_DOC_ELEC_CAB.dnomfanrec
  is 'Nombre de fantasía';
comment on column IT.CB_DOC_ELEC_CAB.ddirrec
  is 'Dirección del receptor';
comment on column IT.CB_DOC_ELEC_CAB.dnumcasrec
  is 'Número de casa del receptor';
comment on column IT.CB_DOC_ELEC_CAB.cdeprec
  is 'Código del departamento del receptor';
comment on column IT.CB_DOC_ELEC_CAB.ddesdeprec
  is 'Descripción del departamento del receptor';
comment on column IT.CB_DOC_ELEC_CAB.cdisrec
  is 'Código del distrito del receptor';
comment on column IT.CB_DOC_ELEC_CAB.ddesdisrec
  is '40 Descripción del distrito del receptor';
comment on column IT.CB_DOC_ELEC_CAB.cciurec
  is 'Código de la ciudad del receptor';
comment on column IT.CB_DOC_ELEC_CAB.ddesciurec
  is 'Descripción de la ciudad del receptor';
comment on column IT.CB_DOC_ELEC_CAB.dtelrec
  is 'Número de teléfono del receptor';
comment on column IT.CB_DOC_ELEC_CAB.dcelrec
  is 'Número de celular del receptor';
comment on column IT.CB_DOC_ELEC_CAB.demailrec
  is 'Correo electrónico del receptor';
comment on column IT.CB_DOC_ELEC_CAB.dcodcliente
  is 'Código del cliente';
