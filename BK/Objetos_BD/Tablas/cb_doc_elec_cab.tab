  is '90 Liquidación total del IVA por redondeo a la tasa del 10%';
comment on column IT.CB_DOC_ELEC_CAB.divacomi
  is 'Liquidación total del IVA de la comisión';
comment on column IT.CB_DOC_ELEC_CAB.dtotiva
  is 'Liquidación total del IVA';
comment on column IT.CB_DOC_ELEC_CAB.dbasegrav5
  is 'Total base gravada al 5%';
comment on column IT.CB_DOC_ELEC_CAB.dbasegrav10
  is 'Total base gravada al 10%';
comment on column IT.CB_DOC_ELEC_CAB.dtbasgraiva
  is 'Total de la base gravada de IVA';
comment on column IT.CB_DOC_ELEC_CAB.dtotalgs
  is 'Total general de la operación en Guaraníes';
comment on column IT.CB_DOC_ELEC_CAB.dcarqr
  is 'Caracteres correspondientes al código QR';
comment on column IT.CB_DOC_ELEC_CAB.dinfadic
  is 'Información adicional de interés para el emisor';
comment on column IT.CB_DOC_ELEC_CAB.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_DOC_ELEC_CAB.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_DOC_ELEC_CAB.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_DOC_ELEC_CAB.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CB_DOC_ELEC_CAB.cod_control
  is 'Código de Control de la Factura. Este campo se actualiza cuando el documento es aprobado por SIFEN.';
comment on column IT.CB_DOC_ELEC_CAB.sfn_observaciones
  is 'Código y descripción del rechazo de SIFEN. Este campo se actualiza cuando el documento es rechazado por SIFEN.';
comment on column IT.CB_DOC_ELEC_CAB.coblafe
  is 'Tipo de obligaciones.';
comment on column IT.CB_DOC_ELEC_CAB.ddesoblafe
  is 'Descripción de la obligación afectada.';
-- Create/Recreate indexes 
create index IT.IN_CBDCAB_DEST on IT.CB_DOC_ELEC_CAB (DEST||'-'||DPUNEXP||'-'||DNUMDOC, ITIDE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CBDCAB_DEST2 on IT.CB_DOC_ELEC_CAB (DEST||'-'||DPUNEXP||'-'||DNUMDOC, EST_FAC, ITIDE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.CB_DOC_ELEC_CAB
  add constraint PK_CB_DOC_ELEC_CAB primary key (ID_DOCUMENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
