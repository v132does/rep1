create table IT.LC_COT_OFICINAS
(
  cod_oficina      NUMBER(3) not null,
  cod_moneda       VARCHAR2(3) not null,
  fecha            DATE not null,
  val_compra       NUMBER(14,8) default 0,
  val_venta        NUMBER(14,8) default 0,
  val_ven_cheque   NUMBER(14,8) default 0,
  val_com_cheque   NUMBER(14,8) default 0,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.LC_COT_OFICINAS
  is 'Cotizaciones particulares por Oficina (Cambios).';
comment on column IT.LC_COT_OFICINAS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.LC_COT_OFICINAS.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.LC_COT_OFICINAS.fecha
  is 'Fecha de cotizacion.';
comment on column IT.LC_COT_OFICINAS.val_compra
  is 'Valor Compra de Efectivo.';
comment on column IT.LC_COT_OFICINAS.val_venta
  is 'Valor Venta de Efectivo.';
comment on column IT.LC_COT_OFICINAS.val_ven_cheque
  is 'Valor de Venta de Cheque.';
comment on column IT.LC_COT_OFICINAS.val_com_cheque
  is 'Valor de Compra de Cheque.';
comment on column IT.LC_COT_OFICINAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.LC_COT_OFICINAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.LC_COT_OFICINAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.LC_COT_OFICINAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_LCOTI_COD_MONEDA on IT.LC_COT_OFICINAS (COD_MONEDA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_COT_OFICINAS
  add constraint PK_LC_COT_OFICINAS primary key (COD_OFICINA, COD_MONEDA, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_COT_OFICINAS
  add constraint FK_LCOTI_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.LC_COT_OFICINAS
  add constraint FK_LCOTI_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.LC_COT_OFICINAS
  add constraint AVCON_1109600994_COD_O_002
  check (COD_OFICINA BETWEEN 0 AND 999);

