create table IT.BA_SER_PAISES
(
  cod_pais         NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  deseng           VARCHAR2(50),
  cod_pai_iso      VARCHAR2(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_pai_bt       NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_SER_PAISES
  is 'Paises.';
comment on column IT.BA_SER_PAISES.cod_pais
  is 'Codigo de pais.';
comment on column IT.BA_SER_PAISES.descripcion
  is 'Descripcion del pais en ingles';
comment on column IT.BA_SER_PAISES.cod_pai_iso
  is 'Codigo Pais equivalente ISO.';
comment on column IT.BA_SER_PAISES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_SER_PAISES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_SER_PAISES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_SER_PAISES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BA_SER_PAISES
  add constraint PK_BA_SER_PAISES primary key (COD_PAIS)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_SER_PAISES
  add constraint UK_EPAIS_SER_DES unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

