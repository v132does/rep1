create table IT.GE_DEB_AUT_NOMINAS
(
  cod_ente        NUMBER(5) not null,
  nro_cta_nomina  VARCHAR2(15) not null,
  nro_cta_mora    VARCHAR2(15) not null,
  tip_cuenta      NUMBER(3) not null,
  cod_per_titular VARCHAR2(10) not null,
  estado          VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_DEB_AUT_NOMINAS.cod_ente
  is 'Codigo de Ente al cual corresponde la cuenta nomina';
comment on column IT.GE_DEB_AUT_NOMINAS.nro_cta_nomina
  is 'Numero de Cuenta Nomina';
comment on column IT.GE_DEB_AUT_NOMINAS.nro_cta_mora
  is 'Numero de Cuenta en Mora para adherir al Debito Automático';
comment on column IT.GE_DEB_AUT_NOMINAS.tip_cuenta
  is 'Modalidad de la Cuenta en Mora';
comment on column IT.GE_DEB_AUT_NOMINAS.cod_per_titular
  is 'Codigo de la Persona Titular';
comment on column IT.GE_DEB_AUT_NOMINAS.estado
  is 'Estado del Registro; "A" (Actualizado); "C" (Cancelado); "N" (No modificado)';

