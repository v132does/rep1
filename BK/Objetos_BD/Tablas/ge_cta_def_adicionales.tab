create table IT.GE_CTA_DEF_ADICIONALES
(
  parametro        VARCHAR2(30) not null,
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  cod_oficina      NUMBER(3),
  cod_moneda       VARCHAR2(3),
  cod_banca        NUMBER(3),
  obligatorio      VARCHAR2(1) default 'N' not null,
  modificable      VARCHAR2(1) default 'N' not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  tip_campo        VARCHAR2(1) default 'T',
  tip_dato         VARCHAR2(1) default 'A',
  lon_maxima       NUMBER(3) default 200,
  val_defecto      VARCHAR2(300),
  permiso          VARCHAR2(2000),
  tip_permiso      VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CTA_DEF_ADICIONALES
  is 'Definicion de Datos Adicionales por Cuenta.';
comment on column IT.GE_CTA_DEF_ADICIONALES.parametro
  is 'Codigo de campo.';
comment on column IT.GE_CTA_DEF_ADICIONALES.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.GE_CTA_DEF_ADICIONALES.cod_modalidad
  is 'Codigo de la modalidad.';
comment on column IT.GE_CTA_DEF_ADICIONALES.cod_oficina
  is 'Codigo de la oficina.';
comment on column IT.GE_CTA_DEF_ADICIONALES.cod_moneda
  is 'Codigo de la moneda.';
comment on column IT.GE_CTA_DEF_ADICIONALES.cod_banca
  is 'Codigo de Banca.';
comment on column IT.GE_CTA_DEF_ADICIONALES.obligatorio
  is 'Es obligatorio la carga del campo.';
comment on column IT.GE_CTA_DEF_ADICIONALES.modificable
  is 'Es modificable el campo.';
comment on column IT.GE_CTA_DEF_ADICIONALES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CTA_DEF_ADICIONALES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CTA_DEF_ADICIONALES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CTA_DEF_ADICIONALES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_CTA_DEF_ADICIONALES.tip_campo
  is 'Tipo de Campo: T-exto, L-Lista, C-heck ';
comment on column IT.GE_CTA_DEF_ADICIONALES.tip_dato
  is 'Tipo de Dato si es Texto, F-echa, H-ora, $-monto, %-tasa, A-lfanumerico, C-odigo, M-mayusculas ';
comment on column IT.GE_CTA_DEF_ADICIONALES.lon_maxima
  is 'Longitud maxima que se puede ingresar del campo';
comment on column IT.GE_CTA_DEF_ADICIONALES.val_defecto
  is 'Valor por defecto para el campo';
comment on column IT.GE_CTA_DEF_ADICIONALES.permiso
  is 'Roles a quienes se da permiso';
comment on column IT.GE_CTA_DEF_ADICIONALES.tip_permiso
  is 'Tipo de Permiso permitido: G=> ''''General''''; P=>''''Permiso especifico''.';
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint UK_GE_CTA_DEF_ADICIONALES unique (PARAMETRO, COD_MODULO, COD_MODALIDAD, COD_OFICINA, COD_MONEDA, COD_BANCA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint FK_GCDAC_COD_BANCA foreign key (COD_BANCA)
  references IT.GE_BANCAS (COD_BANCA);
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint FK_GCDAC_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint FK_GCDAC_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint FK_GCDAC_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint FK_GCDAC_PARAMETRO foreign key (PARAMETRO)
  references IT.GE_PARAMETROS (PARAMETRO);
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint AVCON_1080843414_COD_B_003
  check (COD_BANCA BETWEEN 1 AND 999);
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint AVCON_1080843414_COD_M_022
  check (COD_MODULO BETWEEN 1 AND 999);
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint AVCON_1080843414_COD_M_023
  check (COD_MODALIDAD BETWEEN 1 AND 999);
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint AVCON_1080843414_COD_O_008
  check (COD_OFICINA BETWEEN 1 AND 999);
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint AVCON_1080843414_MODIF_000
  check (MODIFICABLE IN ('S', 'N'));
alter table IT.GE_CTA_DEF_ADICIONALES
  add constraint AVCON_1080843414_OBLIG_002
  check (OBLIGATORIO IN ('S', 'N'));

