create table IT.CB_ASI_AUT_DET_TMP
(
  fecha           DATE not null,
  cod_oficina     NUMBER(3) not null,
  nro_asiento     NUMBER(6) not null,
  nro_linea       NUMBER(9) not null,
  cod_rubro       VARCHAR2(15) not null,
  cod_moneda      VARCHAR2(3) not null,
  desc_rubro      VARCHAR2(60) not null,
  mto_mon_rubro   NUMBER(18,2),
  debito          NUMBER,
  credito         NUMBER,
  descripcion_asi VARCHAR2(60),
  referencia      VARCHAR2(11),
  val_cotizacion  NUMBER(14,8),
  ref_movimiento  NUMBER(7),
  cod_modulo      NUMBER(3),
  cod_modalidad   NUMBER(3),
  modalidad       VARCHAR2(35) not null,
  cod_ofi_origen  NUMBER(3),
  fec_valor       DATE,
  nro_registro    NUMBER
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

