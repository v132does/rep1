create table IT.CR_PER_AFICIONES
(
  cod_persona      VARCHAR2(10) not null,
  cod_aficion      NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_PER_AFICIONES
  is 'Aficiones por persona.';
comment on column IT.CR_PER_AFICIONES.cod_persona
  is 'Codigo de persona.';
comment on column IT.CR_PER_AFICIONES.cod_aficion
  is 'Codigo de Aficion.';
comment on column IT.CR_PER_AFICIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_PER_AFICIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_PER_AFICIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_PER_AFICIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CR_PER_AFICIONES
  add constraint PK_CR_PER_AFICIONES primary key (COD_PERSONA, COD_AFICION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_PER_AFICIONES
  add constraint FK_RPAFI_COD_AFICION foreign key (COD_AFICION)
  references IT.CR_AFICIONES (COD_AFICION);
alter table IT.CR_PER_AFICIONES
  add constraint FK_RPAFI_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CR_PER_AFICIONES
  add constraint AVCON_1080843837_COD_A_003
  check (COD_AFICION BETWEEN 1 AND 999);

