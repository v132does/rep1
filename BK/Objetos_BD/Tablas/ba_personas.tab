alter table IT.BA_PERSONAS
  add constraint PK_BA_PERSONAS primary key (COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 3M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_PERSONAS
  add constraint UK_EPERS_NRO_DOCUMENTO unique (NRO_DOCUMENTO, COD_TIP_DOCUMENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 3M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_PERSONAS
  add constraint FK_EPERS_COD_ACTIVIDAD foreign key (COD_ACTIVIDAD)
  references IT.GE_ACTIVIDADES (COD_ACTIVIDAD);
alter table IT.BA_PERSONAS
  add constraint FK_EPERS_COD_PAI_DOCUMENTO foreign key (COD_PAI_DOCUMENTO)
  references IT.BA_PAISES (COD_PAIS);
alter table IT.BA_PERSONAS
  add constraint FK_EPERS_COD_PAIS foreign key (COD_PAIS)
  references IT.BA_PAISES (COD_PAIS);
alter table IT.BA_PERSONAS
  add constraint FK_EPERS_COD_RUB_PRIMARIO foreign key (COD_RUB_PRIMARIO)
  references IT.GE_RUB_ECONOMICOS (COD_RUB_ECONOMICO);
alter table IT.BA_PERSONAS
  add constraint FK_EPERS_COD_RUB_SECUNDARIO foreign key (COD_RUB_SECUNDARIO)
  references IT.GE_RUB_ECONOMICOS (COD_RUB_ECONOMICO);
alter table IT.BA_PERSONAS
  add constraint FK_EPERS_COD_RUB_TERCIARIO foreign key (COD_RUB_TERCIARIO)
  references IT.GE_RUB_ECONOMICOS (COD_RUB_ECONOMICO);
alter table IT.BA_PERSONAS
  add constraint FK_EPERS_COD_TIP_DOCUMENTO foreign key (COD_TIP_DOCUMENTO)
  references IT.BA_TIP_DOCUMENTOS (COD_TIP_DOCUMENTO);
alter table IT.BA_PERSONAS
  add constraint FK_EPERS_COD_USU_PROMOTOR foreign key (COD_USU_PROMOTOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.BA_PERSONAS
  add constraint FK_EPERS_COD_USU_VERIFICADOR foreign key (COD_USU_VERIFICADOR)
  references IT.BA_USUARIOS (COD_USUARIO);

