create table IT.GE_VER_IMPRESORAS_TMP
(
  texto            VARCHAR2(4000),
  nro_orden        VARCHAR2(4000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_VER_IMPRESORAS_TMP
  is 'Tabla temporal de datos de impresora para verificación';
comment on column IT.GE_VER_IMPRESORAS_TMP.texto
  is 'Linea de Texto';
comment on column IT.GE_VER_IMPRESORAS_TMP.nro_orden
  is 'Orden de carga';
comment on column IT.GE_VER_IMPRESORAS_TMP.usu_insercion
  is 'Usuario de inserción';
comment on column IT.GE_VER_IMPRESORAS_TMP.fec_insercion
  is 'Fecha de inserción';
comment on column IT.GE_VER_IMPRESORAS_TMP.usu_modificacion
  is 'Usuario de Modificación';
comment on column IT.GE_VER_IMPRESORAS_TMP.fec_modificacion
  is 'Fecha de Modificación';

