create table IT.PR_RES_FOGAPY
(
  fec_proceso              DATE not null,
  nro_cuenta               VARCHAR2(15) not null,
  cod_moneda               VARCHAR2(3),
  cod_persona              VARCHAR2(10),
  nro_documento            VARCHAR2(20),
  nom_completo             VARCHAR2(120),
  nro_garantia             NUMBER(7),
  nro_referencia           VARCHAR2(20),
  fec_inicio               DATE,
  fec_vencimiento          DATE,
  capital                  NUMBER(18,2),
  sal_capital              NUMBER(18,2),
  fec_ven_prox_cuo_capital DATE,
  sig_sal_capital          NUMBER(18,2),
  can_cuo_pagadas          NUMBER(5),
  can_cuo_atrasadas        NUMBER(5),
  dia_atraso               NUMBER(5),
  fec_insercion            DATE default SYSDATE not null,
  usu_insercion            VARCHAR2(10) default SUBSTR(USER,1,10) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_RES_FOGAPY
  is 'Contiene datos de los prestamos con Garantia FOGAPY';
comment on column IT.PR_RES_FOGAPY.fec_proceso
  is 'Fecha de generacion del registro.';
comment on column IT.PR_RES_FOGAPY.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.PR_RES_FOGAPY.cod_moneda
  is 'Codigo de Moneda.';
comment on column IT.PR_RES_FOGAPY.cod_persona
  is 'Codigo de persona.';
comment on column IT.PR_RES_FOGAPY.nro_documento
  is 'Numero de documento.';
comment on column IT.PR_RES_FOGAPY.nom_completo
  is 'Nombre completo.';
comment on column IT.PR_RES_FOGAPY.nro_garantia
  is 'Numero de garantia.';
comment on column IT.PR_RES_FOGAPY.nro_referencia
  is 'Número de referencia de la garantía, corresponde a Cuentas, Nro. de Documento, etc.';
comment on column IT.PR_RES_FOGAPY.fec_inicio
  is 'Fecha de inicio';
comment on column IT.PR_RES_FOGAPY.fec_vencimiento
  is 'Fecha de vencimiento.';
comment on column IT.PR_RES_FOGAPY.capital
  is 'Monto Capital.';
comment on column IT.PR_RES_FOGAPY.sal_capital
  is 'Saldo del Capital On line.';
comment on column IT.PR_RES_FOGAPY.fec_ven_prox_cuo_capital
  is 'Fecha de vencimiento de la proxima cuota capital.';
comment on column IT.PR_RES_FOGAPY.sig_sal_capital
  is 'Siguiente saldo capital.';
comment on column IT.PR_RES_FOGAPY.can_cuo_pagadas
  is 'Cantidad de cuotas pagadas.';
comment on column IT.PR_RES_FOGAPY.can_cuo_atrasadas
  is 'Cantidad de cuotas atrasadas.';
comment on column IT.PR_RES_FOGAPY.dia_atraso
  is 'Dias de atraso.';
comment on column IT.PR_RES_FOGAPY.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.PR_RES_FOGAPY.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
alter table IT.PR_RES_FOGAPY
  add constraint PK_NROCTAFECPRO primary key (NRO_CUENTA, FEC_PROCESO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

