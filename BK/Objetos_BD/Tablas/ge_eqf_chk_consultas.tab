create table IT.GE_EQF_CHK_CONSULTAS
(
  nro_solicitud      NUMBER(10) not null,
  nro_secuencia      NUMBER(5) not null,
  cod_persona        VARCHAR2(10) not null,
  fec_consulta       DATE,
  hor_consulta       VARCHAR2(10),
  nom_ser_webservice VARCHAR2(50),
  nom_entidad        VARCHAR2(100),
  cod_entidad        VARCHAR2(100),
  fecha              VARCHAR2(100),
  motivo             VARCHAR2(100),
  operacion          VARCHAR2(100),
  tip_consulta       VARCHAR2(100) not null,
  msg_error          VARCHAR2(4000),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_EQF_CHK_CONSULTAS.nro_solicitud
  is 'Nro Solicitud al servicio web';
comment on column IT.GE_EQF_CHK_CONSULTAS.nro_secuencia
  is 'Nro de secuencia por solicitud';
comment on column IT.GE_EQF_CHK_CONSULTAS.cod_persona
  is 'Cod de persona que se consulta en los servicios web';
comment on column IT.GE_EQF_CHK_CONSULTAS.fec_consulta
  is 'Fecha de la consulta al servicio web';
comment on column IT.GE_EQF_CHK_CONSULTAS.hor_consulta
  is 'Hora de la consulta al servicio web';
comment on column IT.GE_EQF_CHK_CONSULTAS.nom_ser_webservice
  is 'Nombre del servicio web consultado';
comment on column IT.GE_EQF_CHK_CONSULTAS.nom_entidad
  is 'Nombre entidad';
comment on column IT.GE_EQF_CHK_CONSULTAS.cod_entidad
  is 'Cod entidad';
comment on column IT.GE_EQF_CHK_CONSULTAS.fecha
  is 'Fecha de la consulta realizada por la entidad';
comment on column IT.GE_EQF_CHK_CONSULTAS.motivo
  is 'Motivo de consulta';
comment on column IT.GE_EQF_CHK_CONSULTAS.operacion
  is 'Operación';
comment on column IT.GE_EQF_CHK_CONSULTAS.tip_consulta
  is 'Tipo de consulta BANCARIA, PUBLICA';
comment on column IT.GE_EQF_CHK_CONSULTAS.msg_error
  is 'Mensaje de error del webservice si lo hubiere';
create index IT.IN_CHKCON_PER_SOL_FEC on IT.GE_EQF_CHK_CONSULTAS (COD_PERSONA, FEC_CONSULTA, NRO_SOLICITUD)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_EQF_CHK_CONSULTAS
  add constraint PK_GE_EQF_CHK_CONSULTAS primary key (NRO_SOLICITUD, TIP_CONSULTA, NRO_SECUENCIA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_EQF_CHK_CONSULTAS
  add constraint FK_CHKCO_NRO_SOLICITUD foreign key (NRO_SOLICITUD)
  references IT.GE_EQF_SOLICITUDES (NRO_SOLICITUD) on delete cascade;

