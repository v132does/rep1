create table IT.TA_PAD_DIARIO
(
  tip_registro     NUMBER(1),
  cod_marca        NUMBER(5),
  cod_entidad      NUMBER(5),
  cod_sucursal     NUMBER(5),
  nro_cuenta       NUMBER(10) not null,
  cod_producto     NUMBER(3),
  apellido         VARCHAR2(50),
  nombre           VARCHAR2(50),
  tip_documento    NUMBER(5),
  nro_documento    VARCHAR2(15),
  dis_compra       NUMBER(19,4),
  signo1           VARCHAR2(1),
  dis_adelanto     NUMBER(19,4),
  signo2           VARCHAR2(1),
  dis_com_usd      NUMBER(19,4),
  signo3           VARCHAR2(1),
  dis_ade_usd      NUMBER(19,4),
  signo4           VARCHAR2(1),
  tra_pen_gs       NUMBER(19,4),
  signo5           VARCHAR2(1),
  tra_pen_usd      NUMBER(19,4),
  signo6           VARCHAR2(1),
  est_cuenta       NUMBER(3),
  sal_ant_gs       NUMBER(19,4),
  signo7           VARCHAR2(1),
  sal_ant_usd      NUMBER(19,4),
  signo8           VARCHAR2(1),
  sal_act_gs       NUMBER(19,4),
  signo9           VARCHAR2(1),
  sal_act_usd      NUMBER(19,4),
  signo10          VARCHAR2(1),
  filler           VARCHAR2(17),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion    DATE default SYSDATE,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion DATE default SYSDATE,
  fec_proceso      DATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 3M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_PAD_DIARIO
  is 'Procesamiento archivo T1015D Padrón Diario Disponibles';
comment on column IT.TA_PAD_DIARIO.tip_registro
  is '2 - Detalle
';
comment on column IT.TA_PAD_DIARIO.cod_marca
  is 'Código de Marca
';
comment on column IT.TA_PAD_DIARIO.cod_entidad
  is 'Código asignado a la Entidad Otorgante.
';
comment on column IT.TA_PAD_DIARIO.cod_sucursal
  is 'Código asignado a la Sucursal
';
comment on column IT.TA_PAD_DIARIO.nro_cuenta
  is 'Número de cuenta
';
comment on column IT.TA_PAD_DIARIO.cod_producto
  is 'Código del tipo de producto
';
comment on column IT.TA_PAD_DIARIO.apellido
  is 'Primer apellido de la persona
';
comment on column IT.TA_PAD_DIARIO.nombre
  is 'Primer nombre de la persona
';
comment on column IT.TA_PAD_DIARIO.tip_documento
  is 'Código de tipo de documento
';
comment on column IT.TA_PAD_DIARIO.nro_documento
  is 'Numero del documento
';
comment on column IT.TA_PAD_DIARIO.dis_compra
  is 'Disponible de compra en moneda local de la cuenta al momento de generación del archivo.Formato 15,4
';
comment on column IT.TA_PAD_DIARIO.dis_adelanto
  is 'Disponible de adelanto en moneda local de la cuenta al momento de generación del archivo';
comment on column IT.TA_PAD_DIARIO.dis_com_usd
  is 'Disponible de compra en moneda dólar de la cuenta al momento de generación del archivo
';
comment on column IT.TA_PAD_DIARIO.dis_ade_usd
  is 'Disponible de adelanto en moneda dólar de la cuenta al momento de generación del archivo
';
comment on column IT.TA_PAD_DIARIO.tra_pen_gs
  is 'Importe transitorio pendiente de presentación en Moneda Local
';
comment on column IT.TA_PAD_DIARIO.tra_pen_usd
  is 'Importe transitorio pendiente de presentación en Moneda Dólar
';
comment on column IT.TA_PAD_DIARIO.est_cuenta
  is 'Estado de la cuenta
';
comment on column IT.TA_PAD_DIARIO.sal_ant_gs
  is 'Saldo al inicio del periodo de moneda local
';
comment on column IT.TA_PAD_DIARIO.sal_ant_usd
  is 'Saldo al inicio del periodo de moneda dólar
';
comment on column IT.TA_PAD_DIARIO.sal_act_gs
  is 'Saldo al momento moneda local
';
comment on column IT.TA_PAD_DIARIO.sal_act_usd
  is 'Saldo al momento moneda dólar
';
comment on column IT.TA_PAD_DIARIO.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.TA_PAD_DIARIO.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.TA_PAD_DIARIO.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.TA_PAD_DIARIO.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.TA_PAD_DIARIO.fec_proceso
  is 'Fecha en que se realizo el volcado';
create index IT.IN_TPD_FECPROD on IT.TA_PAD_DIARIO (FEC_PROCESO, COD_PRODUCTO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_PAD_DIARIO
  add constraint PK_TA_PAD_DIARIO primary key (NRO_CUENTA, FEC_PROCESO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

