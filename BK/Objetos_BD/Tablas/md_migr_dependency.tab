create table IT.MD_MIGR_DEPENDENCY
(
  id                 NUMBER not null,
  connection_id_fk   NUMBER not null,
  parent_id          NUMBER not null,
  child_id           NUMBER not null,
  parent_object_type VARCHAR2(4000) not null,
  child_object_type  VARCHAR2(4000) not null,
  security_group_id  NUMBER default 0 not null,
  created_on         DATE default sysdate not null,
  created_by         VARCHAR2(255),
  last_updated_on    DATE,
  last_updated_by    VARCHAR2(255)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.MD_MIGR_DEPENDENCY.connection_id_fk
  is 'The connection that this exists in //PARENTFIELD';
alter table IT.MD_MIGR_DEPENDENCY
  add constraint MIGR_DEPENDENCY_PK primary key (ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.MD_MIGR_DEPENDENCY
  add constraint MIGR_DEPENDENCY_FK foreign key (CONNECTION_ID_FK)
  references IT.MD_CONNECTIONS (ID) on delete cascade;

