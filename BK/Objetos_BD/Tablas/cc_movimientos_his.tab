comment on column IT.CC_MOVIMIENTOS_HIS.cod_ref_cambio
  is 'Codigo de Referencia.';
comment on column IT.CC_MOVIMIENTOS_HIS.reversado
  is 'Reversado. (N=NO / S=SI).';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_usu_reversion
  is 'Operador de Reversion.';
comment on column IT.CC_MOVIMIENTOS_HIS.hor_reversion
  is 'Hora de Reversion.';
comment on column IT.CC_MOVIMIENTOS_HIS.emi_aviso
  is 'Emitir Aviso. (N=NO / S=SI).';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_tra_padre
  is 'Codigo de Transaccion Padre.';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_mod_padre
  is 'Codigo de Modulo Padre.';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_mad_padre
  is 'Codigo de Modalidad Padre.';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_transaccion
  is 'Codigo de Transaccion Hijo.';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_modulo
  is 'Codigo de Modulo.';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_modalidad
  is 'Codigo de Modalidad.';
comment on column IT.CC_MOVIMIENTOS_HIS.mto_equ_local
  is 'Importe Equivalente en Moneda Local.';
comment on column IT.CC_MOVIMIENTOS_HIS.nro_caja
  is 'Numero de Caja.';
comment on column IT.CC_MOVIMIENTOS_HIS.cotizacion
  is 'Cotizacion.';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_bco_central
  is 'Codigo en el BCP.';
comment on column IT.CC_MOVIMIENTOS_HIS.nro_documento
  is 'Numero de Documento.';
comment on column IT.CC_MOVIMIENTOS_HIS.nro_documento2
  is 'Numero de Documento.';
comment on column IT.CC_MOVIMIENTOS_HIS.nro_documento3
  is 'Numero de Documento.';
comment on column IT.CC_MOVIMIENTOS_HIS.nro_documento4
  is 'Numero de Documento.';
comment on column IT.CC_MOVIMIENTOS_HIS.protegido
  is 'Protegido. (N=NO / S=SI).';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_autorizacion
  is 'Numero de autorizacion.';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_usu_autorizador
  is 'Codigo de Autorizacion.';
comment on column IT.CC_MOVIMIENTOS_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_MOVIMIENTOS_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_MOVIMIENTOS_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_MOVIMIENTOS_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_MOVIMIENTOS_HIS.tip_mov_rubro
  is 'Tipo de Movimiento.';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_tip_ope_cambio
  is 'Codigo de Tipo de Operacion de Cambio.';
comment on column IT.CC_MOVIMIENTOS_HIS.nro_folio
  is 'Numero de Folio de Extracto.';
comment on column IT.CC_MOVIMIENTOS_HIS.referencia
  is 'Referencia General.';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_persona
  is 'Codigo de Persona.';
comment on column IT.CC_MOVIMIENTOS_HIS.cod_sit_contable
  is 'Indica la Situacion Contable actual de la Operacion.';
comment on column IT.CC_MOVIMIENTOS_HIS.nro_conciliacion
  is 'N�mero Secuencia Extracto Swift.';
create index IT.IN_CMHIS_NRO_CUENTA_MONTO on IT.CC_MOVIMIENTOS_HIS (NRO_CUENTA, MONTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
