create table IT.GE_SNP_MSJ_MT940_DET
(
  cod_mensaje              VARCHAR2(20),
  fecha                    DATE,
  tip_movimiento           VARCHAR2(1),
  monto                    NUMBER(18,2),
  ind_referencia           VARCHAR2(1),
  cod_msj_swift            VARCHAR2(100),
  nro_referencia           VARCHAR2(100),
  nro_identificador        VARCHAR2(100),
  dat_adi_operacion        VARCHAR2(4000),
  dat_adi_otros            VARCHAR2(4000),
  nro_cuenta               VARCHAR2(100),
  usu_insercion            VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion            DATE default SYSDATE not null,
  usu_modificacion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion         DATE default SYSDATE not null,
  cod_swi_pte_solicitante  VARCHAR2(20),
  cod_swi_pte_beneficiario VARCHAR2(20)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SNP_MSJ_MT940_DET
  is 'Tabla de movimientos de detalle de extractos MT940';
comment on column IT.GE_SNP_MSJ_MT940_DET.cod_mensaje
  is 'Codigo de Mensaje (Para relacionar con la cabecera)';
comment on column IT.GE_SNP_MSJ_MT940_DET.fecha
  is 'Fecha del Movimiento';
comment on column IT.GE_SNP_MSJ_MT940_DET.tip_movimiento
  is 'Tipo de Movimiento / C-Credito , D-Debito';
comment on column IT.GE_SNP_MSJ_MT940_DET.monto
  is 'Monto del movimiento';
comment on column IT.GE_SNP_MSJ_MT940_DET.ind_referencia
  is 'Indicador de referencia';
comment on column IT.GE_SNP_MSJ_MT940_DET.cod_msj_swift
  is 'Codigo de mesnaje swift';
comment on column IT.GE_SNP_MSJ_MT940_DET.nro_referencia
  is 'Nro. de Referencia';
comment on column IT.GE_SNP_MSJ_MT940_DET.nro_identificador
  is 'Nro. Identificador';
comment on column IT.GE_SNP_MSJ_MT940_DET.dat_adi_operacion
  is 'Datos adicionales del movimiento (Tipo :86:)';
comment on column IT.GE_SNP_MSJ_MT940_DET.dat_adi_otros
  is 'Datos adicionales del movimiento (Detalle del :86: y otros)';
comment on column IT.GE_SNP_MSJ_MT940_DET.nro_cuenta
  is 'Nro. de Cuenta';
comment on column IT.GE_SNP_MSJ_MT940_DET.cod_swi_pte_solicitante
  is 'Código SWIFT (BIC) del Participante Solicitante.';
comment on column IT.GE_SNP_MSJ_MT940_DET.cod_swi_pte_beneficiario
  is 'Código SWIFT (BIC) del Participante Beneficiario.';
create index IT.IN_COD_MENSAJE on IT.GE_SNP_MSJ_MT940_DET (COD_MENSAJE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_FECHA on IT.GE_SNP_MSJ_MT940_DET (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_NRO_CUENTA3 on IT.GE_SNP_MSJ_MT940_DET (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

