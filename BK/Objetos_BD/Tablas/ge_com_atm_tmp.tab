create table IT.GE_COM_ATM_TMP
(
  cod_banco        VARCHAR2(3),
  nom_banco        VARCHAR2(30),
  referencia       VARCHAR2(30),
  mto_recibido     VARCHAR2(20),
  mto_pagado       VARCHAR2(20),
  fec_insercion    DATE default SYSDATE not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_COM_ATM_TMP
  is 'Datos de Pago Comisiones a Bancos por uso de ATM.';
comment on column IT.GE_COM_ATM_TMP.cod_banco
  is 'Código del Banco.';
comment on column IT.GE_COM_ATM_TMP.nom_banco
  is 'Nombre del Banco.';
comment on column IT.GE_COM_ATM_TMP.referencia
  is 'Referencia.';
comment on column IT.GE_COM_ATM_TMP.mto_recibido
  is 'Monto correspondiente al Importe Recibido.';
comment on column IT.GE_COM_ATM_TMP.mto_pagado
  is 'Monto correspondiente al Importe Pagado.';
comment on column IT.GE_COM_ATM_TMP.fec_insercion
  is 'Fecha de Inserción.';
comment on column IT.GE_COM_ATM_TMP.usu_insercion
  is 'Usuario de Inserción.';
comment on column IT.GE_COM_ATM_TMP.fec_modificacion
  is 'Fecha de Modificación.';
comment on column IT.GE_COM_ATM_TMP.usu_modificacion
  is 'Usuario de Modificación.';

