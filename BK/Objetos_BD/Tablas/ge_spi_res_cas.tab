create table IT.GE_SPI_RES_CAS
(
  nro_referencia       VARCHAR2(33) not null,
  tip_identificador    VARCHAR2(10) not null,
  val_identificador    VARCHAR2(20) not null,
  cod_persona          VARCHAR2(10),
  tip_consulta         VARCHAR2(20),
  fecha                DATE not null,
  hora                 VARCHAR2(8) not null,
  val_cli_recordid     VARCHAR2(33),
  val_cta_recordid     VARCHAR2(33),
  val_alias_recordid   VARCHAR2(33),
  fec_vto_documento    DATE,
  nombre               VARCHAR2(120),
  apellido             VARCHAR2(120),
  nro_cuenta           VARCHAR2(35),
  tip_cuenta           VARCHAR2(3),
  cod_mon_cta          VARCHAR2(3),
  fec_apertura         DATE,
  fec_cancelacion      DATE,
  cta_defecto          VARCHAR2(1),
  error                VARCHAR2(4000),
  usu_insercion        VARCHAR2(10) default substr(user,1,10) not null,
  fec_insercion        DATE default sysdate not null,
  usu_modificacion     VARCHAR2(10) default substr(user,1,10) not null,
  fec_modificacion     DATE default sysdate not null,
  fec_registro         DATE,
  fec_venc_registro    DATE,
  cod_swi_participante VARCHAR2(20),
  tip_doc_cliente      VARCHAR2(10),
  nro_doc_cliente      VARCHAR2(80)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SPI_RES_CAS
  is 'Registro de Respuestas sobre Consultas de datos en CAS.';
comment on column IT.GE_SPI_RES_CAS.nro_referencia
  is 'Nro de referencia.';
comment on column IT.GE_SPI_RES_CAS.tip_identificador
  is 'Tipo de identificador.';
comment on column IT.GE_SPI_RES_CAS.val_identificador
  is 'Valor del Identificador.';
comment on column IT.GE_SPI_RES_CAS.cod_persona
  is 'Código del cliente solicitante.';
comment on column IT.GE_SPI_RES_CAS.tip_consulta
  is 'Tipo de consulta Valores:
      CON_CLIENTE [Consulta por cliente]
      CON_CUENTA [Consulta por cuenta]
      CON_ALIAS [Consulta por alias].';
comment on column IT.GE_SPI_RES_CAS.fecha
  is 'Fecha de la solicitud.';
comment on column IT.GE_SPI_RES_CAS.hora
  is 'Hora de la generación.';
comment on column IT.GE_SPI_RES_CAS.val_cli_recordid
  is 'Valor correspondiente al ID en CAS del cliente.';
comment on column IT.GE_SPI_RES_CAS.val_cta_recordid
  is 'Valor correspondiente al ID en CAS de la cuenta.';
comment on column IT.GE_SPI_RES_CAS.val_alias_recordid
  is 'alor correspondiente al ID en CAS del alias.';
comment on column IT.GE_SPI_RES_CAS.fec_vto_documento
  is ' Fecha de  vencimiento del documento del cliente en CAS.';
comment on column IT.GE_SPI_RES_CAS.nombre
  is ' Nombre del Cliente en CAS.';
comment on column IT.GE_SPI_RES_CAS.apellido
  is 'Apellido del Cliente en CAS.';
comment on column IT.GE_SPI_RES_CAS.nro_cuenta
  is 'Número de cuenta.';
comment on column IT.GE_SPI_RES_CAS.tip_cuenta
  is 'Tipo de Cuenta en CAS.';
comment on column IT.GE_SPI_RES_CAS.cod_mon_cta
  is 'Moneda de la cuenta en CAS.';
comment on column IT.GE_SPI_RES_CAS.fec_apertura
  is 'Fecha de apertura de la cuenta en CAS';
comment on column IT.GE_SPI_RES_CAS.fec_cancelacion
  is 'Fecha de cancelacion de la cuenta en CAS';
comment on column IT.GE_SPI_RES_CAS.cta_defecto
  is 'Cuenta por Defecto. Valores posibles ‘S'' [SI], ''N’ [NO]';
comment on column IT.GE_SPI_RES_CAS.error
  is 'Descripción del error generado al procesar la solicitud..';
comment on column IT.GE_SPI_RES_CAS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_SPI_RES_CAS.fec_insercion
  is 'Fecha en que se inserta el registro.';
comment on column IT.GE_SPI_RES_CAS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_SPI_RES_CAS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_GSPI_RES_CAS on IT.GE_SPI_RES_CAS (TIP_IDENTIFICADOR, VAL_IDENTIFICADOR)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GSPI_VAL_ALIAS_CAS on IT.GE_SPI_RES_CAS (VAL_ALIAS_RECORDID)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GSPI_VAL_CLI_CAS on IT.GE_SPI_RES_CAS (VAL_CLI_RECORDID)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GSPI_VAL_CTA_CAS on IT.GE_SPI_RES_CAS (VAL_CTA_RECORDID)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SPI_RES_CAS
  add constraint PK_NRO_REF_CAST primary key (NRO_REFERENCIA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

