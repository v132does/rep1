create table IT.CC_CHE_ANULADOS
(
  nro_cuenta          VARCHAR2(15) not null,
  nro_cheque          NUMBER(15) not null,
  fecha               DATE not null,
  hora                VARCHAR2(8) not null,
  cod_usuario         VARCHAR2(10) not null,
  cod_causa           NUMBER(3) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  observacion         VARCHAR2(1000),
  fec_hor_destruccion DATE,
  cod_usu_destruccion VARCHAR2(10),
  nro_acta            NUMBER(8)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CHE_ANULADOS
  is 'Detalle de Cheques Anulados.';
comment on column IT.CC_CHE_ANULADOS.nro_cuenta
  is 'Numero de Cuenta.';
comment on column IT.CC_CHE_ANULADOS.nro_cheque
  is 'Numero de Cheque.';
comment on column IT.CC_CHE_ANULADOS.fecha
  is 'Fecha de la Notificacion.';
comment on column IT.CC_CHE_ANULADOS.hora
  is 'Hora de Cotificacion.';
comment on column IT.CC_CHE_ANULADOS.cod_usuario
  is 'Codigo del Usuario.';
comment on column IT.CC_CHE_ANULADOS.cod_causa
  is 'Codigo de Causa de Bloqueo.';
comment on column IT.CC_CHE_ANULADOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CHE_ANULADOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CHE_ANULADOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_ANULADOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_ANULADOS.observacion
  is 'Observacion.';
comment on column IT.CC_CHE_ANULADOS.fec_hor_destruccion
  is 'Fecha y Hora de Destruccion.';
comment on column IT.CC_CHE_ANULADOS.cod_usu_destruccion
  is 'Usuario que Destruye los Anulados.';
comment on column IT.CC_CHE_ANULADOS.nro_acta
  is 'Numero de Acta de Destruccion.';
create index IT.IN_CCANU_FEC_DESTRUCCION on IT.CC_CHE_ANULADOS (FEC_HOR_DESTRUCCION, COD_USU_DESTRUCCION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHE_ANULADOS
  add constraint PK_CC_CHE_ANULADOS primary key (NRO_CUENTA, NRO_CHEQUE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 26M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHE_ANULADOS
  add constraint FK_CCANU_COD_CAUSAL foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.CC_CHE_ANULADOS
  add constraint FK_CCANU_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.CC_CHE_ANULADOS
  add constraint FK_CCANU_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.CC_CHE_ANULADOS
  add constraint AVCON_1092770008_COD_C_010
  check (COD_CAUSA BETWEEN 0 AND 999);

