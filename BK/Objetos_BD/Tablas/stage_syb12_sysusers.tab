create global temporary table IT.STAGE_SYB12_SYSUSERS
(
  svrid_fk    NUMBER,
  dbid_gen_fk NUMBER,
  suid_gen    NUMBER,
  gen_id_fk   NUMBER,
  suid        NUMBER,
  db_uid      NUMBER not null,
  gid         NUMBER,
  name        VARCHAR2(256),
  environ     VARCHAR2(256)
)
on commit preserve rows;

