-- Create table
create table IT.CB_ASIENTOS_DET_HIS_INI
(
  fecha            DATE not null,
  cod_oficina      NUMBER(3) not null,
  nro_asiento      NUMBER(10) not null,
  nro_linea        NUMBER(20) not null,
  cod_rubro        VARCHAR2(15) not null,
  tip_movimiento   VARCHAR2(1) not null,
  mto_mon_rubro    NUMBER(18,2) default 0,
  mto_mon_local    NUMBER(18,2) default 0,
  descripcion      VARCHAR2(60),
  referencia       VARCHAR2(11),
  protegido        VARCHAR2(1) default 'N',
  actualizado      VARCHAR2(1) default 'N',
  val_cotizacion   NUMBER(14,8) default 0,
  distribuido      VARCHAR2(1) default 'N',
  ref_movimiento   NUMBER(7),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  fec_valor        DATE,
  cod_area         NUMBER(3),
  cod_persona      VARCHAR2(10)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 48M
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.CB_ASIENTOS_DET_HIS_INI
  is 'Detalle De Los Asientos Contables - Historico ** Se borra a medida que los asientos del a?o en curso se superpongan a los del a?o anterior **';
-- Add comments to the columns 
comment on column IT.CB_ASIENTOS_DET_HIS_INI.fecha
  is 'Fecha del asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.cod_oficina
  is 'Codigo de la oficina del asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.nro_asiento
  is 'Numero de asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.nro_linea
  is 'Numero de lmnea del asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.cod_rubro
  is 'Codigo de la cuenta contable.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.tip_movimiento
  is 'Tipo de movimiento: D=Debito C=Credito.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.mto_mon_rubro
  is 'Importe del movimiento en moneda extranjera.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.mto_mon_local
  is 'Importe del movimiento en moneda local.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.descripcion
  is 'Descripcion del asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.referencia
  is 'Referencia.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.protegido
  is 'IND_PROTEGIDO? S=Registro IND_PROTEGIDO, no puede ser eliminado. N=Registro no IND_PROTEGIDO, puede ser eliminado.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.actualizado
  is 'Registro actualizado en saldo de cuentas? S=Registro actualizado en saldo de cuentas N=Registro no actualizado en saldo de cuentas.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.val_cotizacion
  is 'Valor de la tasa de cambio usada para generar asientos de cuentas en moneda extranjera.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.distribuido
  is 'Tiene cuenta de distribucion: S=Tiene cuenta de distribucion. N=No tiene cuenta de distribucion.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.ref_movimiento
  is 'Numero de Referencia.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.fec_valor
  is 'Fecha valor del asiento.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.cod_area
  is 'Codigo del Area.';
comment on column IT.CB_ASIENTOS_DET_HIS_INI.cod_persona
  is 'Codigo de Persona.';