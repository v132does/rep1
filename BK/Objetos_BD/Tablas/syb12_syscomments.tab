create global temporary table IT.SYB12_SYSCOMMENTS
(
  db_id     NUMBER(10),
  id        NUMBER(10),
  db_number NUMBER(10),
  colid     NUMBER(10),
  texttype  NUMBER(10),
  language  NUMBER(10),
  text      VARCHAR2(1000 CHAR),
  colid2    NUMBER(10),
  status    NUMBER(10)
)
on commit preserve rows;

