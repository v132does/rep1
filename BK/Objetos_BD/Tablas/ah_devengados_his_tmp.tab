create table IT.AH_DEVENGADOS_HIS_TMP
(
  nro_cuenta       VARCHAR2(15) not null,
  ano              NUMBER(4) not null,
  mes              NUMBER(2) not null,
  mto_interes      NUMBER(18,2) default 0 not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  cod_oficina      NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AH_DEVENGADOS_HIS_TMP
  is 'Contiene datos de los Intereses Devengados de Ahorros ** Mantener dos a?os completos **';
comment on column IT.AH_DEVENGADOS_HIS_TMP.nro_cuenta
  is 'Numero de Cuenta.';
comment on column IT.AH_DEVENGADOS_HIS_TMP.ano
  is 'Año del Devengamiento.';
comment on column IT.AH_DEVENGADOS_HIS_TMP.mes
  is 'Mes del Devengamiento.';
comment on column IT.AH_DEVENGADOS_HIS_TMP.mto_interes
  is 'Valor del Interes Devengado.';
comment on column IT.AH_DEVENGADOS_HIS_TMP.cod_modulo
  is 'Codigo de Modulo de la Cuenta.';
comment on column IT.AH_DEVENGADOS_HIS_TMP.cod_modalidad
  is 'Codigo de Modalidad de la Cuenta.';
comment on column IT.AH_DEVENGADOS_HIS_TMP.cod_oficina
  is 'Codigo de Oficina de la Cuenta.';
comment on column IT.AH_DEVENGADOS_HIS_TMP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.AH_DEVENGADOS_HIS_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.AH_DEVENGADOS_HIS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.AH_DEVENGADOS_HIS_TMP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.AH_DEVENGADOS_HIS_TMP
  add constraint PK_AH_INT_DEVENGADOS_HIS_TMP primary key (NRO_CUENTA, ANO, MES)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 11M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AH_DEVENGADOS_HIS_TMP
  add constraint FK_AIDHT_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.AH_DEVENGADOS_HIS_TMP
  add constraint FK_AIDHT_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.AH_DEVENGADOS_HIS_TMP
  add constraint AVCON_108084442T_COD_M_006
  check (COD_MODALIDAD BETWEEN 1 AND 999);
alter table IT.AH_DEVENGADOS_HIS_TMP
  add constraint AVCON_108084442T_COD_O_000
  check (COD_OFICINA BETWEEN 1 AND 999);

