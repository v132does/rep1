create table IT.BA_DIRECCIONES
(
  cod_persona      VARCHAR2(10) not null,
  cod_direccion    NUMBER(3) not null,
  tipo             VARCHAR2(1) not null,
  principal        VARCHAR2(1) default 'N' not null,
  direccion        VARCHAR2(80) not null,
  cod_pais         NUMBER(3) not null,
  cod_ciudad       NUMBER(3),
  cod_barrio       NUMBER(4),
  observacion      VARCHAR2(1000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  numero           VARCHAR2(8),
  departamento     VARCHAR2(8),
  piso             VARCHAR2(8),
  edificio         VARCHAR2(35),
  cod_postal       VARCHAR2(10),
  dir_lateral      VARCHAR2(50),
  cod_departamento NUMBER(3),
  latitud          VARCHAR2(50),
  longitud         VARCHAR2(50)
)
tablespace IT_DATA
  pctfree 10
  initrans 10
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_DIRECCIONES
  is 'Direcciones por Persona.';
comment on column IT.BA_DIRECCIONES.cod_persona
  is 'Codigo de Persona.';
comment on column IT.BA_DIRECCIONES.cod_direccion
  is 'Numero de direcciones por cada Persona.';
comment on column IT.BA_DIRECCIONES.tipo
  is 'Tipo de Direccion. (P=Particular, L=Laboral, C=Chequera en Casa, M=Marketing, O=Otra).';
comment on column IT.BA_DIRECCIONES.principal
  is 'Indica si es Direccion default o principal (S=SI / N= NO).';
comment on column IT.BA_DIRECCIONES.direccion
  is 'Direccion o Nombre de la Calle.';
comment on column IT.BA_DIRECCIONES.cod_pais
  is 'Codigo de Pais.';
comment on column IT.BA_DIRECCIONES.cod_ciudad
  is 'Codigo de Ciudad.';
comment on column IT.BA_DIRECCIONES.cod_barrio
  is 'Codigo de Barrio.';
comment on column IT.BA_DIRECCIONES.observacion
  is 'Observacion de la Direccion.';
comment on column IT.BA_DIRECCIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_DIRECCIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_DIRECCIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_DIRECCIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.BA_DIRECCIONES.numero
  is 'Numero o altura de la vivienda en la Calle.';
comment on column IT.BA_DIRECCIONES.departamento
  is 'Numero o Identificador del Departamento.';
comment on column IT.BA_DIRECCIONES.piso
  is 'Piso del Departamento en el Edificio.';
comment on column IT.BA_DIRECCIONES.edificio
  is 'Edificio y Bloque o Cuerpo.';
comment on column IT.BA_DIRECCIONES.cod_postal
  is 'Codigo Postal.';
comment on column IT.BA_DIRECCIONES.dir_lateral
  is 'Dirección lateral';
comment on column IT.BA_DIRECCIONES.cod_departamento
  is 'Código de departamento.';
comment on column IT.BA_DIRECCIONES.latitud
  is 'Latitud de la Dirección de la Persona.';
comment on column IT.BA_DIRECCIONES.longitud
  is 'Longitud de la Dirección de la Persona.';
create index IT.IDX$$_10FF0001 on IT.BA_DIRECCIONES (TO_NUMBER(COD_PERSONA), COD_DIRECCION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BA_DIR on IT.BA_DIRECCIONES (COD_PAIS, COD_CIUDAD, COD_BARRIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BA_DIR_2 on IT.BA_DIRECCIONES (COD_CIUDAD, COD_PAIS)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BBVA_PERSONAS on IT.BA_DIRECCIONES (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_EDIRE_COD_BARRIO on IT.BA_DIRECCIONES (COD_BARRIO, COD_CIUDAD, COD_PAIS)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 6M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_DIRECCIONES
  add constraint PK_BA_DIRECCIONES primary key (COD_PERSONA, COD_DIRECCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 9M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_DIRECCIONES
  add constraint FK_EDIRE_COD_BARRIO foreign key (COD_PAIS, COD_CIUDAD, COD_BARRIO)
  references IT.BA_BARRIOS (COD_PAIS, COD_CIUDAD, COD_BARRIO);
alter table IT.BA_DIRECCIONES
  add constraint FK_EDIRE_COD_CIUDAD foreign key (COD_CIUDAD, COD_PAIS)
  references IT.BA_CIUDADES (COD_CIUDAD, COD_PAIS);
alter table IT.BA_DIRECCIONES
  add constraint FK_EDIRE_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.BA_DIRECCIONES
  add constraint AVCON_1080842839_PRINC_001
  check (PRINCIPAL IN ('S', 'N'));
alter table IT.BA_DIRECCIONES
  add constraint AVCON_1082997745_COD_D_002
  check (COD_DIRECCION BETWEEN 0 AND 999);

