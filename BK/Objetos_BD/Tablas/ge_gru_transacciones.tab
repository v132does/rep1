create table IT.GE_GRU_TRANSACCIONES
(
  cod_gru_transaccion NUMBER(5) not null,
  descripcion         VARCHAR2(60) not null,
  condicion           VARCHAR2(1) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_GRU_TRANSACCIONES
  is 'Cabecera de Grupo de Transacciones.';
comment on column IT.GE_GRU_TRANSACCIONES.cod_gru_transaccion
  is 'Codigo de grupo  de Transaccion.';
comment on column IT.GE_GRU_TRANSACCIONES.descripcion
  is 'Descripcion.';
comment on column IT.GE_GRU_TRANSACCIONES.condicion
  is 'Condicion del Where I= In N= Not in.';
comment on column IT.GE_GRU_TRANSACCIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_GRU_TRANSACCIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_GRU_TRANSACCIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_GRU_TRANSACCIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_GRU_TRANSACCIONES
  add constraint PK_GE_GRU_TRANSACCIONES primary key (COD_GRU_TRANSACCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_GRU_TRANSACCIONES
  add constraint AVCON_1080843414_CONDI_000
  check (CONDICION IN ('I', 'N'));

