create table IT.GE_DEB_CRE_BATCH
(
  cod_deb_cre_batch NUMBER(3) not null,
  descripcion       VARCHAR2(35) not null,
  tip_movimiento    VARCHAR2(1) not null,
  cod_tra_padre     NUMBER(4) not null,
  cod_mad_padre     NUMBER(3) not null,
  cod_mod_padre     NUMBER(3) not null,
  det_sql           VARCHAR2(4000),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_transaccion   NUMBER(4) not null,
  sobregiro         VARCHAR2(1) default 'N' not null,
  cob_parcial       VARCHAR2(1) default 'N' not null,
  pendiente         VARCHAR2(1) default 'N' not null,
  pro_error         VARCHAR2(1) default 'N' not null,
  dif_hora          VARCHAR2(1) default 'N' not null,
  pos_proceso       VARCHAR2(30),
  pre_proceso       VARCHAR2(30),
  iva_incluido      VARCHAR2(1) default 'S'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_DEB_CRE_BATCH
  is 'Debitos y Creditos en Batch';
comment on column IT.GE_DEB_CRE_BATCH.cod_deb_cre_batch
  is 'Codigo del Debito o Credito en Batch.';
comment on column IT.GE_DEB_CRE_BATCH.descripcion
  is 'Descripcion del Debito o Credito en Batch.';
comment on column IT.GE_DEB_CRE_BATCH.tip_movimiento
  is 'Tipo de Movimiento: C / Credito, D / Debito, G / Cargos.';
comment on column IT.GE_DEB_CRE_BATCH.cod_tra_padre
  is 'Codigo de la Transaccion Padre.';
comment on column IT.GE_DEB_CRE_BATCH.cod_mad_padre
  is 'Codigo de la Modalidad Padre.';
comment on column IT.GE_DEB_CRE_BATCH.cod_mod_padre
  is 'Codigo del Modulo Padre.';
comment on column IT.GE_DEB_CRE_BATCH.det_sql
  is 'Detalle del SQL para recuperar los campos a utilzar (select... from... where...).';
comment on column IT.GE_DEB_CRE_BATCH.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_DEB_CRE_BATCH.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_DEB_CRE_BATCH.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_DEB_CRE_BATCH.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_DEB_CRE_BATCH.cod_transaccion
  is 'Codigo de la Transaccion del movimiento.';
comment on column IT.GE_DEB_CRE_BATCH.sobregiro
  is 'Permite sobregirar las cuentas? S/N.';
comment on column IT.GE_DEB_CRE_BATCH.cob_parcial
  is 'Permite cobros parciales? S/N.';
comment on column IT.GE_DEB_CRE_BATCH.pendiente
  is 'Indica si el movimiento quedara pendiente intentando cobrar hasta que la cuenta reciba creditos. S/N.';
comment on column IT.GE_DEB_CRE_BATCH.pro_error
  is 'Indica si el proceso seguira ejecutandose en caso de error o se detiene la ejecucion. S/N';
comment on column IT.GE_DEB_CRE_BATCH.dif_hora
  is 'Indica si genera movimientos con horas diferentes por cuenta.';
comment on column IT.GE_DEB_CRE_BATCH.pos_proceso
  is 'Proceso que se ejecuta despues de leer el archivo.';
comment on column IT.GE_DEB_CRE_BATCH.pre_proceso
  is 'Proceso que se ejecuta antes de leer el archivo.';
comment on column IT.GE_DEB_CRE_BATCH.iva_incluido
  is 'Indica si el iva esta o no incluido en el cargo';
alter table IT.GE_DEB_CRE_BATCH
  add constraint PK_GE_DEB_CRE_BATCH primary key (COD_DEB_CRE_BATCH)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_DEB_CRE_BATCH
  add constraint UK_GDCBA_DESCRIPCION unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_DEB_CRE_BATCH
  add constraint FK_GDCBA_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_DEB_CRE_BATCH
  add constraint FK_GDCBA_COD_TRA_PADRE foreign key (COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_DEB_CRE_BATCH
  add constraint AVCON_1191960665_COD_D_000
  check (COD_DEB_CRE_BATCH BETWEEN 0 AND 999);
alter table IT.GE_DEB_CRE_BATCH
  add constraint AVCON_1191960665_TIP_M_000
  check (TIP_MOVIMIENTO IN ('D', 'C', 'G'));

