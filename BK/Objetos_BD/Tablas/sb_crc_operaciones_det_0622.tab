create table IT.SB_CRC_OPERACIONES_DET_0622
(
  fecha                DATE not null,
  nom_referencia       VARCHAR2(10) not null,
  nro_formulario       VARCHAR2(3),
  cod_oficina          NUMBER(4),
  tip_operacion        NUMBER(3),
  nro_operacion        VARCHAR2(60),
  cod_moneda           VARCHAR2(3),
  fec_operacion        DATE,
  fec_pri_vencimiento  DATE,
  nro_cuota            NUMBER(3),
  cta_con_cap_original VARCHAR2(18),
  mto_ori_capital      NUMBER(20,2) default 0,
  mto_lin_credito      NUMBER(20,2) default 0,
  cta_con_int_original VARCHAR2(18),
  mto_ori_interes      NUMBER(20,2) default 0,
  cod_rub_primario     VARCHAR2(6),
  cod_departamento     VARCHAR2(4),
  cod_rub_economico    VARCHAR2(6),
  dia_plazo            NUMBER(5),
  tas_nominal          NUMBER(5,2) default 0,
  nro_registro         NUMBER(9) not null,
  cod_modulo           NUMBER(3),
  cod_persona          VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_CRC_OPERACIONES_DET_0622
  is 'Datos de Detalle del Archivo Operaciones CRC1.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.fecha
  is 'Fecha.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.nom_referencia
  is 'Nombre de Referencia.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.nro_formulario
  is 'Número de Formulario.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.cod_oficina
  is 'Código de Oficina.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.tip_operacion
  is 'Tipo de Operación.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.nro_operacion
  is 'Número de Operación.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.cod_moneda
  is 'Código de Moneda.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.fec_operacion
  is 'Fecha de Operación.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.fec_pri_vencimiento
  is 'Fecha de Primer Vencimiento.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.nro_cuota
  is 'Número de Cuota.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.cta_con_cap_original
  is 'Cuenta Contable del Capital Original.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.mto_ori_capital
  is 'Monto del Capital Original.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.mto_lin_credito
  is 'Monto de Línea de Crédito.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.cta_con_int_original
  is 'Cuenta Contable Interés Original.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.mto_ori_interes
  is 'Monto Original Interés.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.cod_rub_primario
  is 'Código de Rubro Primario.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.cod_departamento
  is 'Código de Departamento.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.cod_rub_economico
  is 'Código de Rubro de Crédito.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.dia_plazo
  is 'Días de Plazo.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.tas_nominal
  is 'Tasa Nominal.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.nro_registro
  is 'Tasa Nominal.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.cod_modulo
  is 'Código del Módulo.';
comment on column IT.SB_CRC_OPERACIONES_DET_0622.cod_persona
  is 'Código de Persona.';
create index IT.IN_NRO_OPERACION_0622 on IT.SB_CRC_OPERACIONES_DET_0622 (NVL(SUBSTR(NRO_OPERACION,1,INSTR(NRO_OPERACION,'#')-1),NRO_OPERACION))
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_SB_NRO_CUENTA_0622 on IT.SB_CRC_OPERACIONES_DET_0622 (NRO_OPERACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SB_CRC_OPERACIONES_DET_0622
  add constraint PK_SB_CRC_OPERACIONES_DET_0622 primary key (FECHA, NOM_REFERENCIA, NRO_REGISTRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

