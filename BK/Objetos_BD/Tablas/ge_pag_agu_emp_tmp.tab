create table IT.GE_PAG_AGU_EMP_TMP
(
  cod_persona      VARCHAR2(10) not null,
  nro_cta_ahorro   VARCHAR2(15) not null,
  tip_documento    VARCHAR2(3) default 'CI' not null,
  nro_cedula       VARCHAR2(20) not null,
  cod_empresa      NUMBER(5),
  pri_nombre       VARCHAR2(30),
  seg_nombre       VARCHAR2(30),
  pri_apellido     VARCHAR2(30),
  seg_apellido     VARCHAR2(30),
  fec_nacimiento   DATE,
  sexo             VARCHAR2(1) default 'M',
  est_civil        VARCHAR2(20),
  direccion        VARCHAR2(100),
  ciudad           VARCHAR2(100),
  telefono         VARCHAR2(20),
  error            VARCHAR2(60),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_PAG_AGU_EMP_TMP.cod_persona
  is 'Códligo de Cliente.';
comment on column IT.GE_PAG_AGU_EMP_TMP.nro_cta_ahorro
  is 'Nro de cuenta de ahorro para combinar con la nueva cuenta';
comment on column IT.GE_PAG_AGU_EMP_TMP.tip_documento
  is 'Tipo de Documento';
comment on column IT.GE_PAG_AGU_EMP_TMP.nro_cedula
  is 'Numero de Cedula';
comment on column IT.GE_PAG_AGU_EMP_TMP.cod_empresa
  is 'Codigo de la Empresa';
comment on column IT.GE_PAG_AGU_EMP_TMP.pri_nombre
  is 'Primer Nombre';
comment on column IT.GE_PAG_AGU_EMP_TMP.seg_nombre
  is 'Segundo Nombre';
comment on column IT.GE_PAG_AGU_EMP_TMP.pri_apellido
  is 'Primer Apellido';
comment on column IT.GE_PAG_AGU_EMP_TMP.seg_apellido
  is 'Segundo Apellido';
comment on column IT.GE_PAG_AGU_EMP_TMP.fec_nacimiento
  is 'Fecha de Nacimiento';
comment on column IT.GE_PAG_AGU_EMP_TMP.sexo
  is 'Sexo';
comment on column IT.GE_PAG_AGU_EMP_TMP.est_civil
  is 'Estado Civil';
comment on column IT.GE_PAG_AGU_EMP_TMP.direccion
  is 'Direccion';
comment on column IT.GE_PAG_AGU_EMP_TMP.ciudad
  is 'Ciudad';
comment on column IT.GE_PAG_AGU_EMP_TMP.telefono
  is 'Telefono';
comment on column IT.GE_PAG_AGU_EMP_TMP.error
  is 'Registro de Error.';
comment on column IT.GE_PAG_AGU_EMP_TMP.usu_insercion
  is 'Usuario que realizo la insercion';
comment on column IT.GE_PAG_AGU_EMP_TMP.fec_insercion
  is 'Fecha de la insercion';
comment on column IT.GE_PAG_AGU_EMP_TMP.usu_modificacion
  is 'Usuario que realizo la modificacion';
comment on column IT.GE_PAG_AGU_EMP_TMP.fec_modificacion
  is 'Fecha de la modificacion';
create index IT.IN_GPAET_COD_EMPRESA on IT.GE_PAG_AGU_EMP_TMP (COD_EMPRESA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

