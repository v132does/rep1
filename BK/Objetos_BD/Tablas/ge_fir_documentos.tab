create table IT.GE_FIR_DOCUMENTOS
(
  cod_documento    NUMBER(10) not null,
  tip_documento    VARCHAR2(3) not null,
  nom_documento    VARCHAR2(100),
  cod_persona      VARCHAR2(10),
  directorio       VARCHAR2(100),
  estado           VARCHAR2(2) not null,
  nro_sec_firmada  NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  fec_calculo      DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_FIR_DOCUMENTOS
  is 'Documentos con Firmas Digitales.';
comment on column IT.GE_FIR_DOCUMENTOS.cod_documento
  is 'Código de Documento.';
comment on column IT.GE_FIR_DOCUMENTOS.tip_documento
  is 'Tipo de Documento.';
comment on column IT.GE_FIR_DOCUMENTOS.nom_documento
  is 'Nombre del Documento PDF(cod_persona+aaaamm+nro_secuencial).';
comment on column IT.GE_FIR_DOCUMENTOS.cod_persona
  is 'Código de Persona beneficiaria del Documento.';
comment on column IT.GE_FIR_DOCUMENTOS.directorio
  is 'Ubicación Física del archivo.';
comment on column IT.GE_FIR_DOCUMENTOS.estado
  is 'Estado del Documento.';
comment on column IT.GE_FIR_DOCUMENTOS.nro_sec_firmada
  is 'Último nro. de secuencia del documento firmado.';
comment on column IT.GE_FIR_DOCUMENTOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_FIR_DOCUMENTOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_FIR_DOCUMENTOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_FIR_DOCUMENTOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.GE_FIR_DOCUMENTOS.fec_calculo
  is 'Fecha de cálculo de liquidación.';
alter table IT.GE_FIR_DOCUMENTOS
  add constraint PK_GE_FIR_DOCUMENTOS primary key (COD_DOCUMENTO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

