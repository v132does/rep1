create table IT.GE_MOV_COB_TIGO
(
  fec_pago        TIMESTAMP(6),
  transaccion     VARCHAR2(20),
  nro_comprobante VARCHAR2(30),
  nro_doc_cliente VARCHAR2(20),
  token           VARCHAR2(100),
  referencia      VARCHAR2(20),
  mto_comision    NUMBER(18,2),
  monto           NUMBER(18,2),
  estado          VARCHAR2(20),
  liquidado       VARCHAR2(1),
  nro_cuenta      VARCHAR2(15),
  fec_liquidacion TIMESTAMP(6),
  id_proceso      NUMBER(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_MOV_COB_TIGO.id_proceso
  is 'ID proceso de liquidacion';

