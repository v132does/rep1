create table IT.CO_INF_MONEDAS
(
  cod_moneda       VARCHAR2(3) not null,
  cod_inf_moneda   VARCHAR2(1) not null,
  usu_insercion    VARCHAR2(10) default substr( USER, 1,  10 ) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default substr( USER, 1,  10 ) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CO_INF_MONEDAS
  is 'Contiene los Codigos de Monedas que utiliza el Sistema y su Representacion para INFORMCONF.';
comment on column IT.CO_INF_MONEDAS.cod_moneda
  is 'Codificacion utilizada por el sistema para las monedas.';
comment on column IT.CO_INF_MONEDAS.cod_inf_moneda
  is 'Codificacion utilizada por Informconf para las monedas.';
comment on column IT.CO_INF_MONEDAS.usu_insercion
  is 'Usuario que inserto el registro.';
comment on column IT.CO_INF_MONEDAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CO_INF_MONEDAS.usu_modificacion
  is 'Usuario que modifico el registro.';
comment on column IT.CO_INF_MONEDAS.fec_modificacion
  is 'Fecha en que se modifico el registro.';
alter table IT.CO_INF_MONEDAS
  add constraint PK_CO_INF_MONEDAS primary key (COD_MONEDA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CO_INF_MONEDAS
  add constraint UK_OIMON_COD_INF_MONEDAS unique (COD_INF_MONEDA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CO_INF_MONEDAS
  add constraint FK_OIMON_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);

