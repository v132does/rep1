create table IT.GE_EXT_BAN_MOVIMIENTOS_TMP
(
  nro_cuenta     VARCHAR2(15) not null,
  tip_movimiento VARCHAR2(1) not null,
  fecha          DATE not null,
  hora           VARCHAR2(8) not null,
  descripcion    VARCHAR2(60),
  nro_documento  NUMBER(15),
  debito         NUMBER,
  credito        NUMBER,
  cod_moneda     VARCHAR2(3) not null,
  cod_persona    VARCHAR2(10),
  fec_extracto   DATE,
  cod_ente       NUMBER(5),
  cod_banco      NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

