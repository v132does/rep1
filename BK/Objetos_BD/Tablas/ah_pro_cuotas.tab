create table IT.AH_PRO_CUOTAS
(
  nro_cuenta       VARCHAR2(15) not null,
  nro_cuota        NUMBER(3) not null,
  mto_cuota        NUMBER(18,2) default 0 not null,
  fec_vencimiento  DATE not null,
  mto_interes      NUMBER(18,2) default 0 not null,
  estado           VARCHAR2(1) not null,
  fec_ult_pago     DATE,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  sal_acumulado    NUMBER(18,2) default 0,
  periodo          NUMBER(3),
  tipo             VARCHAR2(1) default 'C'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AH_PRO_CUOTAS
  is 'Contiene los datos del Plan de debitos de Ahorro Programado.';
comment on column IT.AH_PRO_CUOTAS.nro_cuenta
  is 'Número de Ahorro Programado.';
comment on column IT.AH_PRO_CUOTAS.nro_cuota
  is 'Número de Cuota del Ahorro Programado.';
comment on column IT.AH_PRO_CUOTAS.mto_cuota
  is 'Monto de Cuota.';
comment on column IT.AH_PRO_CUOTAS.fec_vencimiento
  is 'Fecha de Vencimiento de la Cuota.';
comment on column IT.AH_PRO_CUOTAS.mto_interes
  is 'Monto del Interés generado.';
comment on column IT.AH_PRO_CUOTAS.estado
  is 'Estado de la Cuota (E=Emitido / A=Vigente Atrasada / V=Vencida / P=Pagada).';
comment on column IT.AH_PRO_CUOTAS.fec_ult_pago
  is 'Fecha de Último Pago.';
comment on column IT.AH_PRO_CUOTAS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.AH_PRO_CUOTAS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.AH_PRO_CUOTAS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.AH_PRO_CUOTAS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.AH_PRO_CUOTAS.sal_acumulado
  is 'Monto de capital acumulado';
comment on column IT.AH_PRO_CUOTAS.periodo
  is 'Periodo del debito';
comment on column IT.AH_PRO_CUOTAS.tipo
  is 'Tipo C-uota / R-efuerzo';
create index IT.IN_AH_PRO_ESTADO on IT.AH_PRO_CUOTAS (ESTADO, PERIODO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 8K
    minextents 1
    maxextents unlimited
  );
alter table IT.AH_PRO_CUOTAS
  add constraint PK_AH_PRO_CUOTAS primary key (NRO_CUENTA, NRO_CUOTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 16M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AH_PRO_CUOTAS
  add constraint FK_ACUOT_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.AH_CTA_PLAZOS (NRO_CUENTA);

