create table IT.TA_TARJETAS
(
  nro_cuenta           VARCHAR2(15) not null,
  nro_tarjeta          VARCHAR2(25) not null,
  cod_persona          VARCHAR2(10) not null,
  cod_estado           NUMBER(2) default 6 not null,
  fec_vencimiento      DATE not null,
  cod_causa            NUMBER(3),
  nom_embozar          VARCHAR2(26),
  nom_enviar           VARCHAR2(26),
  vigente              VARCHAR2(1) default 'N' not null,
  fec_emision          DATE not null,
  fec_solicitud        DATE,
  tip_envio            VARCHAR2(1) default 'D',
  referencia           VARCHAR2(35),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  nro_planilla         NUMBER(8),
  tip_planilla         NUMBER(2),
  nro_pla_anterior     NUMBER(8),
  fec_entrega          DATE,
  fec_activacion       DATE,
  observacion          VARCHAR2(200),
  pre_embozada         VARCHAR2(1),
  pla_ope_por_contado  NUMBER(18,2),
  pla_ope_mto_contado  NUMBER(18,2),
  pla_ope_mto_adelanto NUMBER(18,2),
  pla_ope_por_adelanto NUMBER(18,2),
  tip_embozado         VARCHAR2(2),
  motivo               VARCHAR2(60),
  rel_tarjeta          NUMBER(1),
  id_producto          VARCHAR2(6),
  id                   RAW(16) not null,
  id_virtual           as (CASE  WHEN "ID" IS NULL THEN NULL ELSE LOWER(SUBSTR(RAWTOHEX("ID"),1,8)||'-'||SUBSTR(RAWTOHEX("ID"),9,4)||'-'||SUBSTR(RAWTOHEX("ID"),13,4)||'-'||SUBSTR(RAWTOHEX("ID"),17,4)||'-'||SUBSTR(RAWTOHEX("ID"),21,12)) END)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_TARJETAS
  is 'Es la tabla de relacion Cuenta-Tarjeta.';
comment on column IT.TA_TARJETAS.nro_cuenta
  is 'Numero de la Cuenta.';
comment on column IT.TA_TARJETAS.nro_tarjeta
  is 'Numero de Tarjeta.';
comment on column IT.TA_TARJETAS.cod_persona
  is 'Codigo de Cliente.';
comment on column IT.TA_TARJETAS.cod_estado
  is 'Estado de la Tarjeta ( 6=activa ).';
comment on column IT.TA_TARJETAS.fec_vencimiento
  is 'Fecha de vencimiento de la Tarjeta.';
comment on column IT.TA_TARJETAS.cod_causa
  is 'Codigo de Motivo de Cancelacion.';
comment on column IT.TA_TARJETAS.nom_embozar
  is 'Nombre a Embozar.';
comment on column IT.TA_TARJETAS.nom_enviar
  is 'Nombre a enviar a la Administradora.';
comment on column IT.TA_TARJETAS.vigente
  is 'Indicador si esta vigente o no ( S=si, N=no ).';
comment on column IT.TA_TARJETAS.fec_emision
  is 'Fecha de Emision.';
comment on column IT.TA_TARJETAS.fec_solicitud
  is 'Fecha de Solicitud.';
comment on column IT.TA_TARJETAS.tip_envio
  is 'Tipo de Envio: D-Direccion, R-Retener en, K-Casilla de correo, C-Casillero.';
comment on column IT.TA_TARJETAS.referencia
  is 'En base al tipo de envio esta columna tendra la direccion o sucursal de retencion de los documentos.';
comment on column IT.TA_TARJETAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_TARJETAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_TARJETAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_TARJETAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.TA_TARJETAS.nro_planilla
  is 'Nro.Planilla.';
comment on column IT.TA_TARJETAS.tip_planilla
  is 'Tipo Planilla.';
comment on column IT.TA_TARJETAS.nro_pla_anterior
  is 'Nro de planilla anterior.';
comment on column IT.TA_TARJETAS.fec_entrega
  is 'Fecha de entrega.';
comment on column IT.TA_TARJETAS.fec_activacion
  is 'Fecha de Activacion de la Tarjeta.';
comment on column IT.TA_TARJETAS.observacion
  is 'Observacion.';
comment on column IT.TA_TARJETAS.pre_embozada
  is 'Indicador de Pre Embozada.';
comment on column IT.TA_TARJETAS.pla_ope_por_contado
  is 'Plan Contado. Operador Porcentaje Contado';
comment on column IT.TA_TARJETAS.pla_ope_mto_contado
  is 'Plan Contado. Operador Monto Contado';
comment on column IT.TA_TARJETAS.pla_ope_mto_adelanto
  is 'Plan Adelanto. Operador Monto Adelanto';
comment on column IT.TA_TARJETAS.pla_ope_por_adelanto
  is 'Plan Adelanto. Operador Porcentaje Adelanto';
comment on column IT.TA_TARJETAS.tip_embozado
  is 'Tipo de embozado.
S/N/D/MV/MF Si, No, Virtual(Digital).';
comment on column IT.TA_TARJETAS.id_producto
  is 'Id de producto GP'; 
comment on column IT.TA_TARJETAS.id
  is 'Identificador de la tarjeta en raw';
comment on column IT.TA_TARJETAS.id_virtual
  is 'Identificador virtual de la tarjeta en formato UUID V7';
