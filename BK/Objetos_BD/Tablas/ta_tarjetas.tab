alter table IT.TA_TARJETAS
  add constraint PK_TA_TARJETAS primary key (NRO_TARJETA, NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 768K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_TARJETAS
  add constraint FK_TTARJ_COD_CAUSA foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.TA_TARJETAS
  add constraint FK_TTARJ_COD_ESTADO foreign key (COD_ESTADO)
  references IT.TA_TAR_ESTADOS (COD_ESTADO);
alter table IT.TA_TARJETAS
  add constraint FK_TTARJ_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.TA_TARJETAS
  add constraint FK_TTARJ_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.TA_CTA_TARJETAS (NRO_CUENTA);
alter table IT.TA_TARJETAS
  add constraint AVCON_1081353181_COD_C_002
  check (COD_CAUSA BETWEEN 0 AND 999);
alter table IT.TA_TARJETAS
  add constraint AVCON_1081353181_TIP_E_000
  check (TIP_ENVIO IN ('D', 'R', 'C', 'K'));
alter table IT.TA_TARJETAS
  add constraint AVCON_1081353181_VIGEN_000
  check (VIGENTE IN ('S', 'N'));
alter table IT.TA_TARJETAS
  add constraint CHECK_TAR_TIP_EMB
  check (tip_embozado IN ('S', 'N', 'D','MF','MV'));
