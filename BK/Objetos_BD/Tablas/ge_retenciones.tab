create table IT.GE_RETENCIONES
(
  cod_retencion    NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_RETENCIONES
  is 'Tipos de Retenciones.';
comment on column IT.GE_RETENCIONES.cod_retencion
  is 'Codigo de retencion.';
comment on column IT.GE_RETENCIONES.descripcion
  is 'Descripcion de la retencion.';
comment on column IT.GE_RETENCIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_RETENCIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_RETENCIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_RETENCIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_RETENCIONES
  add constraint PK_GE_RETENCIONES primary key (COD_RETENCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_RETENCIONES
  add constraint AVCON_1080843414_COD_R_001
  check (COD_RETENCION BETWEEN 0 AND 999);

