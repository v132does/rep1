create global temporary table IT.STAGE_SYB12_SYSINDEXES
(
  svrid_fk    NUMBER,
  dbid_gen_fk NUMBER,
  id_gen_fk   NUMBER,
  indid_gen   NUMBER,
  table_id    NUMBER,
  index_name  VARCHAR2(256) not null,
  index_desc  VARCHAR2(1000),
  index_keys  VARCHAR2(1000),
  keycnt      NUMBER(7),
  indid       NUMBER(7),
  status      NUMBER(7),
  status2     NUMBER(7)
)
on commit preserve rows;

