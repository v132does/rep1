create table IT.BA_DIRECCIONES_TALLER
(
  cod_persona      VARCHAR2(10) not null,
  cod_direccion    NUMBER(3) not null,
  tipo             VARCHAR2(1) not null,
  principal        VARCHAR2(1) default 'N' not null,
  direccion        VARCHAR2(80) not null,
  cod_pais         NUMBER(3) not null,
  cod_ciudad       NUMBER(3),
  cod_barrio       NUMBER(4),
  observacion      VARCHAR2(1000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  numero           VARCHAR2(8),
  departamento     VARCHAR2(8),
  piso             VARCHAR2(8),
  edificio         VARCHAR2(35),
  cod_postal       VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

