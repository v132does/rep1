  is 'categoria del grupo economico al que corresponde.';
comment on column IT.GE_CLIENTES_HIS.cat_anterior
  is 'Categor¿a anterior.';
comment on column IT.GE_CLIENTES_HIS.fec_cat_anterior
  is 'Fecha de categorizaci¿n anterior.';
comment on column IT.GE_CLIENTES_HIS.fec_ult_clasif
  is 'Fecha de ¿ltima clasificaci¿n o categorizaci¿n.';
comment on column IT.GE_CLIENTES_HIS.cat_atraso
  is 'Categor¿a por atraso.';
comment on column IT.GE_CLIENTES_HIS.tip_clave
  is 'Tipo de clave: C-consulta T-Transaccional.';
comment on column IT.GE_CLIENTES_HIS.tot_deu_cod_sistema
  is 'Total deuda codeudor¿a en el Sistema Financiero Global.';
comment on column IT.GE_CLIENTES_HIS.tot_deu_codeudoria
  is 'Total deuda codeudor¿a en la entidad.';
comment on column IT.GE_CLIENTES_HIS.tot_deu_con_sistema
