create table IT.GE_CLIENTES_HIS
(
  fecha                DATE not null,
  cod_persona          VARCHAR2(10) not null,
  cod_oficina          NUMBER(3) not null,
  cat_riesgo           VARCHAR2(1),
  cod_gru_economico    NUMBER(5),
  exo_impuestos        VARCHAR2(1) default 'N' not null,
  cod_usu_oficial      VARCHAR2(10) not null,
  cli_especial         VARCHAR2(1) default 'N' not null,
  residente            VARCHAR2(1) default 'N' not null,
  cod_sec_contable     VARCHAR2(1) not null,
  cod_tip_deudor       NUMBER(3) not null,
  cod_departamento     NUMBER(3),
  niv_cruzamiento      NUMBER(8,2),
  clave                VARCHAR2(40),
  est_clave            VARCHAR2(1),
  fec_est_clave        DATE,
  can_intentos         NUMBER(2),
  tipo                 VARCHAR2(1),
  tot_deu_real         NUMBER(18,2) default 0,
  tot_deu_contingente  NUMBER(18,2) default 0,
  cat_subjetiva        NUMBER(1),
  tot_gar_computables  NUMBER(18,2) default 0,
  tot_prevision        NUMBER(18,2) default 0,
  tip_extracto         VARCHAR2(1) default 'C' not null,
  cod_usu_gestion      VARCHAR2(10),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  fec_ingreso          DATE default TRUNC(SYSDATE) not null,
  cod_seg_cliente      NUMBER(3),
  cli_confidencial     VARCHAR2(1) default 'N' not null,
  tot_deu_sistema      NUMBER(18,2),
  cat_automatica       NUMBER(3,2) default 1 not null,
  cat_sistema          NUMBER(1),
  cat_renovaciones     NUMBER(1),
  cat_gru_economico    NUMBER(3,2),
  cat_anterior         NUMBER(3,2),
  fec_cat_anterior     DATE,
  fec_ult_clasif       DATE,
  cat_atraso           VARCHAR2(2),
  tip_clave            VARCHAR2(1),
  tot_deu_cod_sistema  NUMBER(18,2),
  tot_deu_codeudoria   NUMBER(18,2),
  tot_deu_con_sistema  NUMBER(18,2),
  ult_cat_riesgo       VARCHAR2(1),
  fec_ult_cat_sub      DATE,
  fec_ult_cat_3        DATE,
  cod_perfil           VARCHAR2(20),
  fec_ult_acceso       DATE,
  cod_canal            NUMBER(3),
  val_comercial        NUMBER(2),
  fec_ult_cla_sistema  DATE,
  cod_seg_preferente   NUMBER(3),
  cod_seg_pre_anterior NUMBER(3),
  usu_imp_clave        VARCHAR2(10),
  cod_ofi_imp_clave    NUMBER(3),
  fec_imp_clave        DATE,
  cod_banca            NUMBER(3),
  tip_gru_cobranza     VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CLIENTES_HIS
  is 'Historico de Clientes que existen de GE_CLA_OPERACIONES_HIS.';
comment on column IT.GE_CLIENTES_HIS.fecha
  is 'Fecha.';
comment on column IT.GE_CLIENTES_HIS.cod_persona
  is 'C¿digo de cliente.';
comment on column IT.GE_CLIENTES_HIS.cod_oficina
  is 'C¿digo de la Oficina.';
comment on column IT.GE_CLIENTES_HIS.cat_riesgo
  is 'Categoria de Riesgo (1- Normal ; 2- Potencial; 3- Real ; 4-Alto Riesgo; 5-Irrecuperable).';
comment on column IT.GE_CLIENTES_HIS.cod_gru_economico
  is 'C¿digo de grupo economico.';
comment on column IT.GE_CLIENTES_HIS.exo_impuestos
  is 'Tiene exoneraci¿n de impuestos (S= SI ; N= No).';
