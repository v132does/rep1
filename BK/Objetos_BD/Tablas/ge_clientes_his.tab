comment on column IT.GE_CLIENTES_HIS.tot_gar_computables
  is 'Monto total de la garantias computables.';
comment on column IT.GE_CLIENTES_HIS.tot_prevision
  is 'Monto total de la Previsi¿n.';
comment on column IT.GE_CLIENTES_HIS.tip_extracto
  is 'Tipo de impresi¿n de extracto. C-Impreso,  Z-x Mail,  N-No impreso X-Env¿o x mail e impreso.';
comment on column IT.GE_CLIENTES_HIS.cod_usu_gestion
  is 'C¿digo de Usuario de Gesti¿n de Cobranza.';
comment on column IT.GE_CLIENTES_HIS.usu_insercion
  is 'Usuario que realiz¿ la inserci¿n del registro.';
comment on column IT.GE_CLIENTES_HIS.fec_insercion
  is 'Fecha en que se insert¿ el registro.';
