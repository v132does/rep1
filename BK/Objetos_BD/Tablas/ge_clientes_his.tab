create index IT.IN_GCHIS_COD_DEPARTAMENTO on IT.GE_CLIENTES_HIS (COD_DEPARTAMENTO, COD_GRU_ECONOMICO, COD_SEG_CLIENTE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GCHIS_COD_OFICINA on IT.GE_CLIENTES_HIS (COD_OFICINA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 80K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CLIENTES_HIS
  add constraint PK_GE_CLIENTES_HIS primary key (COD_PERSONA, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 80K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CLIENTES_HIS
  add constraint FK_GCHIS_COD_DEPARTAMENTO foreign key (COD_DEPARTAMENTO)
  references IT.BA_DEPARTAMENTOS (COD_DEPARTAMENTO);
alter table IT.GE_CLIENTES_HIS
  add constraint FK_GCHIS_COD_GRU_ECONOMICO foreign key (COD_GRU_ECONOMICO)
  references IT.GE_GRU_ECONOMICOS (COD_GRU_ECONOMICO);
alter table IT.GE_CLIENTES_HIS
  add constraint FK_GCHIS_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CLIENTES_HIS
  add constraint FK_GCHIS_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_CLIENTES_HIS
  add constraint FK_GCHIS_COD_SEG_CLIENTE foreign key (COD_SEG_CLIENTE)
  references IT.GE_SEG_CLIENTES (COD_SEG_CLIENTE);

