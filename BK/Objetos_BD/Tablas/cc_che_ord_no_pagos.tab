create table IT.CC_CHE_ORD_NO_PAGOS
(
  nro_cuenta       VARCHAR2(15) not null,
  nro_cheque       NUMBER(15) not null,
  monto            NUMBER(18,2) default 0,
  beneficiario     VARCHAR2(60),
  estado           VARCHAR2(1),
  fecha            DATE,
  hora             VARCHAR2(8),
  cod_usuario      VARCHAR2(10) not null,
  cod_causa        NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  observacion      VARCHAR2(1000),
  serie            VARCHAR2(5),
  cod_motivo       NUMBER(2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CHE_ORD_NO_PAGOS
  is 'Cheques con Orden de no Pagos.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.nro_cuenta
  is 'Numero de cuenta del cheque con O.N.P.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.nro_cheque
  is 'Numero de cheque con O.N.P.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.monto
  is 'Valor del cheque con O.N.P.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.beneficiario
  is 'Beneficiario.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.estado
  is 'Estado de la O.N.P.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.fecha
  is 'Fecha de notificacion.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.hora
  is 'Hora de notificacion.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.cod_usuario
  is 'Codigo de operador.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.cod_causa
  is 'Codigo de causa de bloqueo.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.observacion
  is 'Observacion.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.serie
  is 'Serie de los Cheques.';
comment on column IT.CC_CHE_ORD_NO_PAGOS.cod_motivo
  is 'Motivo robo o extravio a enviar en informe - Resolución Nro. 130';
create index IT.IN_CCONP_COD_CAUSA on IT.CC_CHE_ORD_NO_PAGOS (COD_CAUSA, COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create unique index IT.IN_NRO_CTA_NRO_CHE on IT.CC_CHE_ORD_NO_PAGOS (NRO_CUENTA, NRO_CHEQUE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 704K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHE_ORD_NO_PAGOS
  add constraint PK_CC_CHE_ORD_NO_PAGOS primary key (NRO_CUENTA, NRO_CHEQUE);
alter table IT.CC_CHE_ORD_NO_PAGOS
  add constraint FK_CCONP_COD_CAUSA foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.CC_CHE_ORD_NO_PAGOS
  add constraint FK_CCONP_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.CC_CHE_ORD_NO_PAGOS
  add constraint FK_CCONP_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.CC_CHE_ORD_NO_PAGOS
  add constraint AVCON_1092358390_COD_C_003
  check (COD_CAUSA BETWEEN 0 AND 999);

