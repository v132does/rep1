create index IT.IN_GCCLI_NRO_CUENTA_2 on IT.GE_CTA_CLIENTES(TO_NUMBER("NRO_CUENTA")) ONLINE
  tablespace IT_IND
  NOLOGGING
  COMPUTE STATISTICS
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CTA_CLIENTES
  add constraint PK_GE_CTA_CLIENTES primary key (NRO_CUENTA, COD_PERSONA);
alter table IT.GE_CTA_CLIENTES
  add constraint FK_GCCLI_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_CTA_CLIENTES
  add constraint AVCON_1083601552_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_CTA_CLIENTES
  add constraint AVCON_1083601552_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_CTA_CLIENTES
  add constraint AVCON_1083601552_COD_O_000
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.GE_CTA_CLIENTES
  add constraint AVCON_1083601552_RELAC_000
  check (RELACION IN ('P', 'A', 'O', 'Y', 'C', 'G', 'E','D', 'R', 'T'));

