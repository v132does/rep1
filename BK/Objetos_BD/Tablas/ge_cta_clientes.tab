create table IT.GE_CTA_CLIENTES
(
  cod_persona         VARCHAR2(10) not null,
  nro_cuenta          VARCHAR2(15) not null,
  dig_verificador     NUMBER(1) default 0 not null,
  cod_oficina         NUMBER(3) not null,
  cod_modulo          NUMBER(3) not null,
  cod_modalidad       NUMBER(3) not null,
  relacion            VARCHAR2(1) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  nro_cta_cli_btw     NUMBER(9),
  integracion         VARCHAR2(2000),
  nro_sub_cta_cli_btw NUMBER(9),
  est_relacion        VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CTA_CLIENTES
  is 'Relacion Clientes / Cuentas.';
comment on column IT.GE_CTA_CLIENTES.cod_persona
  is 'Codigo de cliente.';
comment on column IT.GE_CTA_CLIENTES.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.GE_CTA_CLIENTES.dig_verificador
  is 'Digito verificador.';
comment on column IT.GE_CTA_CLIENTES.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.GE_CTA_CLIENTES.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_CTA_CLIENTES.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_CTA_CLIENTES.relacion
  is 'Relacion de cuenta(P=Principal, Y=Firmante conj,O=Firmante ind.,G=Garante,C=codDeudor,A=Adicional).';
comment on column IT.GE_CTA_CLIENTES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CTA_CLIENTES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CTA_CLIENTES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CTA_CLIENTES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
