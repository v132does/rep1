create table IT.PR_GAR_FIDEICOMISO
(
  nro_garantia       NUMBER(7) not null,
  nro_finca          VARCHAR2(20) not null,
  cod_distrito       NUMBER(3) not null,
  cta_catastral      VARCHAR2(20),
  direccion          VARCHAR2(80) not null,
  val_edilicio       NUMBER(18,2) default 0,
  val_terreno        NUMBER(18,2) default 0,
  fec_ult_tasacion   DATE,
  fec_inicio         DATE,
  fec_vencimiento    DATE,
  cod_ent_seguro     NUMBER(5),
  nro_poliza         VARCHAR2(20),
  fec_vto_seguro     DATE,
  serie              VARCHAR2(5),
  nro_inscripcion    NUMBER(10),
  nro_folio          NUMBER(5),
  fec_inscripcion    DATE,
  val_vta_rapida     NUMBER(18,2) default 0,
  val_seguro         NUMBER(18,2),
  cod_ent_tasador    NUMBER(5),
  fec_ini_seguro     DATE,
  cod_ent_fiduciaria NUMBER(3),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_GAR_FIDEICOMISO
  is 'Contiene los datos de las Garantias Fideicomiso';
comment on column IT.PR_GAR_FIDEICOMISO.nro_garantia
  is 'Numero de la Garantia.';
comment on column IT.PR_GAR_FIDEICOMISO.nro_finca
  is 'Numero de Finca de la Propiedad.';
comment on column IT.PR_GAR_FIDEICOMISO.cod_distrito
  is 'Distrito al que Pertenece la Propiedad.';
comment on column IT.PR_GAR_FIDEICOMISO.cta_catastral
  is 'Cuenta Catastral.';
comment on column IT.PR_GAR_FIDEICOMISO.direccion
  is 'Direccion de la propiedad.';
comment on column IT.PR_GAR_FIDEICOMISO.val_edilicio
  is 'Valor Edilicio.';
comment on column IT.PR_GAR_FIDEICOMISO.val_terreno
  is 'Valor del Terreno.';
comment on column IT.PR_GAR_FIDEICOMISO.fec_ult_tasacion
  is 'Fecha ultima tasacion.';
comment on column IT.PR_GAR_FIDEICOMISO.fec_inicio
  is 'Fecha Inicial de la Garantia.';
comment on column IT.PR_GAR_FIDEICOMISO.fec_vencimiento
  is 'Fecha de Vencimiento de la Garantia.';
comment on column IT.PR_GAR_FIDEICOMISO.cod_ent_seguro
  is 'Codigo de la Aseguradora.';
comment on column IT.PR_GAR_FIDEICOMISO.nro_poliza
  is 'Numero de Poliza de Seguro.';
comment on column IT.PR_GAR_FIDEICOMISO.fec_vto_seguro
  is 'Fecha de Vencimiento del Seguro.';
comment on column IT.PR_GAR_FIDEICOMISO.serie
  is 'Serie de la Hipoteca.';
comment on column IT.PR_GAR_FIDEICOMISO.nro_inscripcion
  is 'Numero de Inscripcion.';
comment on column IT.PR_GAR_FIDEICOMISO.nro_folio
  is 'Numero de Folio.';
comment on column IT.PR_GAR_FIDEICOMISO.fec_inscripcion
  is 'Fecha de Inscripcion.';
comment on column IT.PR_GAR_FIDEICOMISO.val_vta_rapida
  is 'Monto de Venta Rapida.';
comment on column IT.PR_GAR_FIDEICOMISO.val_seguro
  is 'Valor del Serguro.';
comment on column IT.PR_GAR_FIDEICOMISO.cod_ent_tasador
  is 'Codigo de Ente del Tasador.';
comment on column IT.PR_GAR_FIDEICOMISO.fec_ini_seguro
  is 'Fecha de Valor del Seguro.';
comment on column IT.PR_GAR_FIDEICOMISO.cod_ent_fiduciaria
  is 'Código de la entidad fiduciaria.';
comment on column IT.PR_GAR_FIDEICOMISO.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.PR_GAR_FIDEICOMISO.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.PR_GAR_FIDEICOMISO.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.PR_GAR_FIDEICOMISO.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_PGFID_COD_DISTRITO on IT.PR_GAR_FIDEICOMISO (COD_DISTRITO, COD_ENT_SEGURO, COD_ENT_TASADOR)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_GAR_FIDEICOMISO
  add constraint PK_PR_GAR_FIDEICOMISO primary key (NRO_GARANTIA, NRO_FINCA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_GAR_FIDEICOMISO
  add constraint FK_PGFID_COD_DISTRITO foreign key (COD_DISTRITO)
  references IT.GE_DISTRITOS (COD_DISTRITO);
alter table IT.PR_GAR_FIDEICOMISO
  add constraint FK_PGFID_NRO_GARANTIA foreign key (NRO_GARANTIA)
  references IT.PR_GARANTIAS (NRO_GARANTIA);
alter table IT.PR_GAR_FIDEICOMISO
  add constraint AVCON_1083093671_COD_D_002
  check (COD_DISTRITO BETWEEN 0 AND 999);

