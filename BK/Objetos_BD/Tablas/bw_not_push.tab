create table IT.BW_NOT_PUSH
(
  cod_mensaje      NUMBER(6) not null,
  descripcion      VARCHAR2(35) not null,
  mensaje          VARCHAR2(2000) not null,
  fec_inicio       DATE not null,
  fec_fin          DATE not null,
  activo           VARCHAR2(1) default 'S' not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_NOT_PUSH
  is 'Tipos de Mensajes.';
comment on column IT.BW_NOT_PUSH.cod_mensaje
  is 'Tipo de Mensaje.';
comment on column IT.BW_NOT_PUSH.descripcion
  is 'Descripcion del Tipo de Mensaje.';
comment on column IT.BW_NOT_PUSH.mensaje
  is 'Mensaje a desplegar.';
comment on column IT.BW_NOT_PUSH.fec_inicio
  is 'Fecha de inicio del Mensaje.';
comment on column IT.BW_NOT_PUSH.fec_fin
  is 'Fecha de fin del Mensaje.';
comment on column IT.BW_NOT_PUSH.activo
  is 'Activo: S/Si, N/No.';
comment on column IT.BW_NOT_PUSH.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BW_NOT_PUSH.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BW_NOT_PUSH.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BW_NOT_PUSH.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BW_NOT_PUSH
  add constraint PK_BW_NOT_PUSH primary key (COD_MENSAJE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BW_NOT_PUSH
  add constraint CK_BWNP_ACTIVO
  check (ACTIVO IN ('S','N'));
alter table IT.BW_NOT_PUSH
  add constraint CK_BWNP_COD_MENSAJE
  check (COD_MENSAJE BETWEEN 1 AND 999);

