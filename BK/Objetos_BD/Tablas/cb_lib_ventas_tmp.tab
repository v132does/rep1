create table IT.CB_LIB_VENTAS_TMP
(
  nro_factura        VARCHAR2(20),
  nro_timbrado       VARCHAR2(20),
  fecha              DATE not null,
  cod_oficina        NUMBER(3),
  tip_comprobante    VARCHAR2(1),
  tip_venta          VARCHAR2(2),
  cod_persona        VARCHAR2(10),
  nom_completo       VARCHAR2(120) not null,
  nro_documento      VARCHAR2(20) not null,
  mto_exento         NUMBER(18,2) default 0,
  mto_gravado_5      NUMBER(18,2) default 0,
  mto_gravado_10     NUMBER(18,2) default 0,
  impuesto_5         NUMBER(18,2) default 0,
  impuesto_10        NUMBER(18,2) default 0,
  dig_verificador    NUMBER(1),
  nro_fac_referencia VARCHAR2(20),
  nro_tim_referencia VARCHAR2(20),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  impreso            VARCHAR2(1) default 'N',
  procesado          VARCHAR2(1) default 'N' not null,
  hora               VARCHAR2(8),
  cod_usuario        VARCHAR2(10),
  reversado          VARCHAR2(1),
  can_cuota          NUMBER(3) default 0
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_LIB_VENTAS_TMP
  is 'Libro Venta Cabecera.';
comment on column IT.CB_LIB_VENTAS_TMP.nro_factura
  is 'Numero de Factura.';
comment on column IT.CB_LIB_VENTAS_TMP.nro_timbrado
  is 'Numero de Timbrado.';
comment on column IT.CB_LIB_VENTAS_TMP.fecha
  is 'Fecha de la Factura.';
comment on column IT.CB_LIB_VENTAS_TMP.cod_oficina
  is 'Oficina del Cliente.';
comment on column IT.CB_LIB_VENTAS_TMP.tip_comprobante
  is 'Tipo de Comprobante.';
comment on column IT.CB_LIB_VENTAS_TMP.tip_venta
  is 'Condicion de Venta(COntado, Credito).';
comment on column IT.CB_LIB_VENTAS_TMP.cod_persona
  is 'Codigo Persona del Cliente.';
comment on column IT.CB_LIB_VENTAS_TMP.nom_completo
  is 'Razon Social del Cliente.';
comment on column IT.CB_LIB_VENTAS_TMP.nro_documento
  is 'Numero de Documento del Cliente.';
comment on column IT.CB_LIB_VENTAS_TMP.mto_exento
  is 'Monto total Exento.';
comment on column IT.CB_LIB_VENTAS_TMP.mto_gravado_5
  is 'Monto total Gravado 5%.';
comment on column IT.CB_LIB_VENTAS_TMP.mto_gravado_10
  is 'Monto total Gravado 10%.';
comment on column IT.CB_LIB_VENTAS_TMP.impuesto_5
  is 'Monto total Impuesto 5%.';
comment on column IT.CB_LIB_VENTAS_TMP.impuesto_10
  is 'Monto total Impuesto 10%';
comment on column IT.CB_LIB_VENTAS_TMP.dig_verificador
  is 'Digito Verificador del Cliente.';
comment on column IT.CB_LIB_VENTAS_TMP.nro_fac_referencia
  is 'Numero de Factura Referencia.';
comment on column IT.CB_LIB_VENTAS_TMP.nro_tim_referencia
  is 'Numero de Timbrado Referencia.';
comment on column IT.CB_LIB_VENTAS_TMP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_LIB_VENTAS_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_LIB_VENTAS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_LIB_VENTAS_TMP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CB_LIB_VENTAS_TMP.impreso
  is 'Indica si ya fue impresa o no la factura.';
comment on column IT.CB_LIB_VENTAS_TMP.procesado
  is 'Indica si ya fue procesado para Hechauka';
comment on column IT.CB_LIB_VENTAS_TMP.hora
  is 'Hora de Generacion del Movimiento.';
comment on column IT.CB_LIB_VENTAS_TMP.cod_usuario
  is 'Codigo de Usuario.';
comment on column IT.CB_LIB_VENTAS_TMP.reversado
  is 'Reversado(S/N).';
comment on column IT.CB_LIB_VENTAS_TMP.can_cuota
  is 'Cantidad de cuotas';
create index IT.IN_BLVTE_COD_OFICINA on IT.CB_LIB_VENTAS_TMP (COD_OFICINA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BLVTE_COD_PERSONA on IT.CB_LIB_VENTAS_TMP (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BLVTE_FECHA on IT.CB_LIB_VENTAS_TMP (FECHA, HORA, COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create unique index IT.PK_CB_LIB_VENTAS_TMP on IT.CB_LIB_VENTAS_TMP (NRO_FACTURA, NRO_TIMBRADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_LIB_VENTAS_TMP
  add constraint FK_BLVTE_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);

