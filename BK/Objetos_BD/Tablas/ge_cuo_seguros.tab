create table IT.GE_CUO_SEGUROS
(
  nro_seguro       NUMBER(18) not null,
  nro_cuota        NUMBER(5) not null,
  monto            NUMBER(18) not null,
  estado           VARCHAR2(1) not null,
  fec_vencimiento  DATE,
  fec_ult_pago     DATE,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_CUO_SEGUROS.nro_seguro
  is 'Numero del seguro';
comment on column IT.GE_CUO_SEGUROS.nro_cuota
  is 'Numero de la cuota';
comment on column IT.GE_CUO_SEGUROS.monto
  is 'Monto de la cuota';
comment on column IT.GE_CUO_SEGUROS.estado
  is 'Estado Cuota. C-Cancelada / V-Vigente';
comment on column IT.GE_CUO_SEGUROS.fec_vencimiento
  is 'Fecha de vencimiento de la cuota';
comment on column IT.GE_CUO_SEGUROS.fec_ult_pago
  is 'Fecha del ultimo pago';
comment on column IT.GE_CUO_SEGUROS.usu_insercion
  is 'Usuario que realizó la inserción del registro';
comment on column IT.GE_CUO_SEGUROS.fec_insercion
  is 'Fecha en que se insertó el registro';
comment on column IT.GE_CUO_SEGUROS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro';
comment on column IT.GE_CUO_SEGUROS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro';
alter table IT.GE_CUO_SEGUROS
  add constraint PK_GE_CUO_SEGUROS primary key (NRO_SEGURO, NRO_CUOTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

