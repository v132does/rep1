create table IT.WF_GRUPOS
(
  cod_grupo        VARCHAR2(5) not null,
  descripcion      VARCHAR2(60) not null,
  estado           VARCHAR2(1) default 'A' not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.WF_GRUPOS
  is 'Definicion de Grupos de Usuarios';
comment on column IT.WF_GRUPOS.cod_grupo
  is 'Codigo de grupo.';
comment on column IT.WF_GRUPOS.descripcion
  is 'Descripcion del grupo.';
comment on column IT.WF_GRUPOS.estado
  is 'Estado del Grupo de usuarios: A-Activo I-Inactivo';
comment on column IT.WF_GRUPOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.WF_GRUPOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.WF_GRUPOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.WF_GRUPOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.WF_GRUPOS
  add constraint PK_WF_GRUPOS primary key (COD_GRUPO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

