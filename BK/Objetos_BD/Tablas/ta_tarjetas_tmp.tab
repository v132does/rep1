create table IT.TA_TARJETAS_TMP
(
  nro_cuenta          VARCHAR2(15) not null,
  nro_tarjeta         VARCHAR2(25) not null,
  cod_persona         VARCHAR2(10),
  cod_estado          NUMBER(2),
  fec_vencimiento     DATE,
  cod_causa           NUMBER(3),
  nom_embozar         VARCHAR2(50),
  nom_enviar          VARCHAR2(26),
  vigente             VARCHAR2(1) default 'N',
  fec_emision         DATE,
  fec_solicitud       DATE,
  tip_envio           VARCHAR2(1) default 'D',
  referencia          VARCHAR2(35),
  nro_planilla        NUMBER(8),
  tip_planilla        NUMBER(2),
  nro_pla_anterior    NUMBER(8),
  fec_entrega         DATE,
  dig_verificador     NUMBER(1),
  relacion            NUMBER(1),
  cod_situacion       NUMBER(1),
  nro_documento       VARCHAR2(20),
  dur_meses           NUMBER(3),
  mes_vencimiento     VARCHAR2(5),
  mar_boletinada      VARCHAR2(1) default 'N',
  mar_recuperada      VARCHAR2(1) default 'N',
  mar_vencida         VARCHAR2(1) default 'N',
  tip_bloqueo         VARCHAR2(1),
  renovar             VARCHAR2(1) default 'N',
  fec_nacimiento      DATE,
  cod_est_civil       VARCHAR2(1),
  cod_sexo            VARCHAR2(1),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  cod_modalidad       NUMBER(3),
  nro_reg             NUMBER(10),
  cod_ent_procesadora NUMBER(5),
  cod_oficina         NUMBER(3),
  cod_afinidad        VARCHAR2(6),
  det_error           VARCHAR2(4000),
  tip_doc_bancard     VARCHAR2(3),
  tip_ult_embozado    CHAR(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_TARJETAS_TMP
  is 'Es la tabla Temporal de relacion Cuenta-Tarjeta.';
comment on column IT.TA_TARJETAS_TMP.nro_cuenta
  is 'Numero de la Cuenta.';
comment on column IT.TA_TARJETAS_TMP.nro_tarjeta
  is 'Numero de Tarjeta.';
comment on column IT.TA_TARJETAS_TMP.cod_persona
  is 'Codigo de Cliente.';
comment on column IT.TA_TARJETAS_TMP.cod_estado
  is 'Estado de la Tarjeta ( 6=activa ).';
comment on column IT.TA_TARJETAS_TMP.fec_vencimiento
  is 'Fecha de vencimiento de la Tarjeta.';
comment on column IT.TA_TARJETAS_TMP.cod_causa
  is 'Codigo de Motivo de Cancelacion.';
comment on column IT.TA_TARJETAS_TMP.nom_embozar
  is 'Nombre a Embozar.';
comment on column IT.TA_TARJETAS_TMP.nom_enviar
  is 'Nombre a enviar a la Administradora.';
comment on column IT.TA_TARJETAS_TMP.vigente
  is 'Indicador si esta vigente o no ( S=si, N=no ).';
comment on column IT.TA_TARJETAS_TMP.fec_emision
  is 'Fecha de Emision.';
comment on column IT.TA_TARJETAS_TMP.fec_solicitud
  is 'Fecha de Solicitud.';
comment on column IT.TA_TARJETAS_TMP.tip_envio
  is 'Tipo de Envio.';
comment on column IT.TA_TARJETAS_TMP.referencia
  is 'En base al tipo de envio esta columna tendra la direccion o sucursal de retencion de los documentos.';
comment on column IT.TA_TARJETAS_TMP.nro_planilla
  is 'Numero de Planilla.';
comment on column IT.TA_TARJETAS_TMP.tip_planilla
  is 'Tipo de Planilla.';
comment on column IT.TA_TARJETAS_TMP.nro_pla_anterior
  is 'Numero de Planilla anterior.';
comment on column IT.TA_TARJETAS_TMP.fec_entrega
  is 'Fecha en que se entrego la tarjeta.';
comment on column IT.TA_TARJETAS_TMP.dig_verificador
  is 'Digito verificador de la cuenta.';
comment on column IT.TA_TARJETAS_TMP.relacion
  is 'Relacion de la Persona con la Cuenta (0= Principal; 1=Adicional).';
comment on column IT.TA_TARJETAS_TMP.cod_situacion
  is 'Situacion de la Tarjeta en la Procesadora (1= Activa; 3= Inactiva).';
comment on column IT.TA_TARJETAS_TMP.nro_documento
  is 'Numero de documento de identidad.';
comment on column IT.TA_TARJETAS_TMP.dur_meses
  is 'Duracion en meses del plastico.';
comment on column IT.TA_TARJETAS_TMP.mes_vencimiento
  is 'Mes de vencimiento del Plastico en formato MM/YYYY.';
comment on column IT.TA_TARJETAS_TMP.mar_boletinada
  is 'Marca de Tarjeta Boletinada (Bloqueada).';
comment on column IT.TA_TARJETAS_TMP.mar_recuperada
  is 'Marca de Tarjeta Recuperada.';
comment on column IT.TA_TARJETAS_TMP.mar_vencida
  is 'Indica que el plastico se encuentra vencido.';
comment on column IT.TA_TARJETAS_TMP.tip_bloqueo
  is 'Tipo de Bloqueo de la Tarjeta (U= Usuario; A= Administrativo).';
comment on column IT.TA_TARJETAS_TMP.renovar
  is 'Indica que la cuenta tiene orden de Renovacion.';
comment on column IT.TA_TARJETAS_TMP.fec_nacimiento
  is 'Fecha de nacimiento de la persona.';
comment on column IT.TA_TARJETAS_TMP.cod_est_civil
  is 'Codigo de estado civil de la persona.';
comment on column IT.TA_TARJETAS_TMP.cod_sexo
  is 'Sexo de la persona.';
comment on column IT.TA_TARJETAS_TMP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_TARJETAS_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_TARJETAS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_TARJETAS_TMP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.TA_TARJETAS_TMP.cod_modalidad
  is 'Codigo de Modalidad de la cuenta.';
comment on column IT.TA_TARJETAS_TMP.nro_reg
  is 'Numero de registro de posicion en el archivo.';
comment on column IT.TA_TARJETAS_TMP.cod_ent_procesadora
  is 'Codigo de Ente de la Procesadora.';
comment on column IT.TA_TARJETAS_TMP.cod_oficina
  is 'Oficina.';
comment on column IT.TA_TARJETAS_TMP.det_error
  is 'Detalle del error.';
comment on column IT.TA_TARJETAS_TMP.tip_doc_bancard
  is 'Tipo de documento en Bancard.';
comment on column IT.TA_TARJETAS_TMP.tip_ult_embozado
  is 'Tipo de Último Embozado. Emisión=E, Regrabación=P, Renovación=R';
create index IT.IN_CTART_NRO_TARJETA on IT.TA_TARJETAS_TMP (NRO_CUENTA, NRO_TARJETA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

