create table IT.PR_LIN_TIP_GARANTIAS_HIS
(
  nro_linea        NUMBER(7) not null,
  cod_garantia     NUMBER(3) not null,
  mto_limite       NUMBER(18,2) default 0 not null,
  mto_aplicado     NUMBER(18,2) default 0,
  rel_garantia     NUMBER(4,2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_LIN_TIP_GARANTIAS_HIS
  is 'Tipos de Garantía por Límite - Histórico.';
comment on column IT.PR_LIN_TIP_GARANTIAS_HIS.nro_linea
  is 'Número de línea.';
comment on column IT.PR_LIN_TIP_GARANTIAS_HIS.cod_garantia
  is 'Código de garantía.';
comment on column IT.PR_LIN_TIP_GARANTIAS_HIS.mto_limite
  is 'Monto del limite.';
comment on column IT.PR_LIN_TIP_GARANTIAS_HIS.mto_aplicado
  is 'Monto Aplicado.';
comment on column IT.PR_LIN_TIP_GARANTIAS_HIS.rel_garantia
  is 'Relación Garantía.';
comment on column IT.PR_LIN_TIP_GARANTIAS_HIS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_LIN_TIP_GARANTIAS_HIS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_LIN_TIP_GARANTIAS_HIS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_LIN_TIP_GARANTIAS_HIS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.PR_LIN_TIP_GAR on IT.PR_LIN_TIP_GARANTIAS_HIS (NRO_LINEA, COD_GARANTIA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

