create table IT.GE_BCP_DAT_PERSONALES
(
  nro_solicitud          NUMBER(10) not null,
  tip_servicio           VARCHAR2(40) not null,
  nro_registro           NUMBER(6) not null,
  cod_persona            VARCHAR2(10) not null,
  fec_calendario         DATE not null,
  cod_resultado          VARCHAR2(4),
  des_resultado          VARCHAR2(40),
  cod_tip_documento      VARCHAR2(4),
  nro_documento          VARCHAR2(20),
  nombre                 VARCHAR2(255),
  apellido               VARCHAR2(60),
  fec_nacimiento         DATE,
  sexo                   VARCHAR2(2),
  tip_persona            VARCHAR2(20),
  cla_sistema            VARCHAR2(2),
  periodo                VARCHAR2(10),
  cod_pais               VARCHAR2(4),
  des_pais               VARCHAR2(20),
  fec_baja               DATE,
  nro_gvp                VARCHAR2(40),
  cod_entidad            VARCHAR2(4),
  des_entidad            VARCHAR2(60),
  cod_moneda             VARCHAR2(5),
  can_entidad            VARCHAR2(3),
  tip_operacion          VARCHAR2(5),
  des_operacion          VARCHAR2(100),
  cod_act_destino        VARCHAR2(10),
  cod_cta_contable       VARCHAR2(20),
  mto_codeudoria         NUMBER(18,2),
  mto_emi_codeudoria     NUMBER(18,2),
  mto_contingencia       NUMBER(18,2),
  mto_deuda              NUMBER(18,2),
  mto_tot_riesgo         NUMBER(18,2),
  mto_deu_activa         NUMBER(18,2),
  mto_deu_fideicomiso    NUMBER(18,2),
  mto_deu_incobrable     NUMBER(18,2),
  mto_deu_vendida        NUMBER(18,2),
  dia_atraso             NUMBER(5),
  tip_inhabilitacion     VARCHAR2(10),
  causa                  VARCHAR2(20),
  fec_circular           DATE,
  fec_fin                DATE,
  fec_inhabilitacion     DATE,
  nro_cir_inhabilitacion VARCHAR2(5),
  nro_circular           VARCHAR2(10),
  observacion            VARCHAR2(50),
  mto_prevision          NUMBER(18,2),
  region                 VARCHAR2(100),
  tip_vinculo            VARCHAR2(100),
  cod_usuario            VARCHAR2(10),
  usu_insercion          VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion          DATE default SYSDATE not null,
  usu_modificacion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion       DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_BCP_DAT_PERSONALES.cod_persona
  is 'Codigo de Persona.';
comment on column IT.GE_BCP_DAT_PERSONALES.tip_inhabilitacion
  is 'INHAB o REHAB';
alter table IT.GE_BCP_DAT_PERSONALES
  add constraint PK_GE_BCP_DAT_PERSONALES primary key (NRO_SOLICITUD, NRO_REGISTRO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

