create table IT.CB_ASIENTOS_HIS_INI
(
  fecha              DATE not null,
  cod_oficina        NUMBER(3) not null,
  nro_asiento        NUMBER(10) not null,
  cod_usuario        VARCHAR2(10) not null,
  cod_modulo         NUMBER(3) not null,
  cod_modalidad      NUMBER(3) not null,
  tot_control        NUMBER(18,2) default 0 not null,
  actualizado        VARCHAR2(1) default 'N' not null,
  reversado          VARCHAR2(1) default 'N' not null,
  ofi_integrada      VARCHAR2(1) default 'N' not null,
  confirmado         VARCHAR2(1) default 'N' not null,
  cod_ofi_origen     NUMBER(3),
  usu_insercion      VARCHAR2(10) not null,
  fec_insercion      DATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE not null,
  fec_valor          DATE,
  nro_asi_automatico NUMBER(6),
  nro_asi_futuro     NUMBER(6),
  cod_cargo          NUMBER(10)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_ASIENTOS_HIS_INI
  is 'Cabecera De Los Asientos Contables - Historico.';
comment on column IT.CB_ASIENTOS_HIS_INI.fecha
  is 'Fecha de los movimientos que genera el asiento.';
comment on column IT.CB_ASIENTOS_HIS_INI.cod_oficina
  is 'Codigo de oficina del asiento.';
comment on column IT.CB_ASIENTOS_HIS_INI.nro_asiento
  is 'numero del asiento.';
comment on column IT.CB_ASIENTOS_HIS_INI.cod_usuario
  is 'Codigo del usuario que genero el asiento.';
comment on column IT.CB_ASIENTOS_HIS_INI.cod_modulo
  is 'Codigo de modulo del asiento.';
comment on column IT.CB_ASIENTOS_HIS_INI.cod_modalidad
  is 'Codigo de modalidad del asiento.';
comment on column IT.CB_ASIENTOS_HIS_INI.tot_control
  is 'Suma de debitos y creditos para control.';
comment on column IT.CB_ASIENTOS_HIS_INI.actualizado
  is 'Asiento actualizado? S=El asiento ya actualizs el saldo de la cuenta. N=El asiento no actualizs el saldo de la cuenta.';
comment on column IT.CB_ASIENTOS_HIS_INI.reversado
  is 'Si el asiento fue reversado: S=Asiento reversado N=Asiento no reversado.';
comment on column IT.CB_ASIENTOS_HIS_INI.ofi_integrada
  is 'Oficina integrada? S=Oficina integrada N=Oficina no integrada.';
comment on column IT.CB_ASIENTOS_HIS_INI.confirmado
  is 'Asiento confirmado Ok? S=Confirmado, puede actualizar saldo. N=No confirmado, no puede actualizar saldo.';
comment on column IT.CB_ASIENTOS_HIS_INI.cod_ofi_origen
  is 'Codigo de la oficina ormgen del asiento.';
comment on column IT.CB_ASIENTOS_HIS_INI.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_ASIENTOS_HIS_INI.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_ASIENTOS_HIS_INI.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_ASIENTOS_HIS_INI.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CB_ASIENTOS_HIS_INI.fec_valor
  is 'Fecha valor del movimiento que genera el asiento.';
comment on column IT.CB_ASIENTOS_HIS_INI.nro_asi_automatico
  is 'Número de Asiento Automático que generó el asiento definitivo en caso que el origen se de por esta vía.';
comment on column IT.CB_ASIENTOS_HIS_INI.nro_asi_futuro
  is 'Número de Asiento Futuro que generó el asiento definitivo en caso que el origen se de por esta vía.';
comment on column IT.CB_ASIENTOS_HIS_INI.cod_cargo
  is 'Código de Cargo en caso que el asiento tenga origen en un asiento futuro.';

