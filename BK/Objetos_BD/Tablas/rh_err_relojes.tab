create table IT.RH_ERR_RELOJES
(
  nro_tarjeta      VARCHAR2(20) not null,
  fecha            DATE not null,
  archivo          VARCHAR2(100) not null,
  error            VARCHAR2(250) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_ERR_RELOJES
  is 'Errores al recuperar Relojes.';
comment on column IT.RH_ERR_RELOJES.nro_tarjeta
  is 'Nro. de Tarjeta con error.';
comment on column IT.RH_ERR_RELOJES.fecha
  is 'Fecha del error.';
comment on column IT.RH_ERR_RELOJES.archivo
  is 'Archivo que contiene el error.';
comment on column IT.RH_ERR_RELOJES.error
  is 'Error que se produjo.';
comment on column IT.RH_ERR_RELOJES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_ERR_RELOJES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_ERR_RELOJES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_ERR_RELOJES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.RH_ERR_RELOJES
  add constraint PK_RH_ERR_RELOJES primary key (NRO_TARJETA, FECHA, ARCHIVO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

