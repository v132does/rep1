create table IT.RH_CAT_EMPLEADOS
(
  cod_cat_empleado NUMBER(3) not null,
  descripcion      VARCHAR2(40) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_CAT_EMPLEADOS
  is 'Categorias de Empleados.';
comment on column IT.RH_CAT_EMPLEADOS.cod_cat_empleado
  is 'Categoria del Empleado.';
comment on column IT.RH_CAT_EMPLEADOS.descripcion
  is 'Descripcion.';
comment on column IT.RH_CAT_EMPLEADOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_CAT_EMPLEADOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_CAT_EMPLEADOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_CAT_EMPLEADOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.RH_CAT_EMPLEADOS
  add constraint PK_RH_CAT_EMPLEADOS primary key (COD_CAT_EMPLEADO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_CAT_EMPLEADOS
  add constraint UK_HCEMP_DESCRIPCION unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

