create table IT.CB_LIB_RETENCION
(
  nro_factura       VARCHAR2(20) not null,
  nro_timbrado      VARCHAR2(20) not null,
  cod_persona       VARCHAR2(10),
  nom_completo      VARCHAR2(1000) not null,
  ruc_retenido      VARCHAR2(15) not null,
  nro_com_retencion VARCHAR2(20) not null,
  fec_com_retencion DATE,
  mto_ret_renta     NUMBER(18,2) default 0,
  mto_ret_iva       NUMBER(18,2) default 0,
  imp_ret_renta     NUMBER(18,2) default 0,
  imp_ret_iva       NUMBER(18,2) default 0,
  procesado         VARCHAR2(1) default 'N' not null,
  ruc_proveedor     VARCHAR2(15) not null,
  fec_pago          DATE,
  mto_exento        NUMBER(18,2),
  imp_ret_exento    NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.CB_LIB_RETENCION.mto_exento
  is 'Monto exento, se aplica a casos de pago de intereses.';
comment on column IT.CB_LIB_RETENCION.imp_ret_exento
  is 'Monto retención sobre exento se aplica para retención sobre pago de intereses.';

