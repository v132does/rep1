create table IT.OV_VALUACIONES_HIS
(
  nro_cuenta          VARCHAR2(15) not null,
  fecha               DATE not null,
  estado              VARCHAR2(1) not null,
  sal_total           NUMBER(18,2) default 0 not null,
  tot_gar_computables NUMBER(18,2) default 0,
  tot_prevision       NUMBER(18,2) default 0,
  cat_automatica      NUMBER(3,2) not null,
  cotizacion          NUMBER(14,4) default 0 not null,
  cot_anterior        NUMBER(14,4) default 0,
  tot_val_saldo       NUMBER(18,2) default 0 not null,
  tot_val_garantia    NUMBER(18,2) default 0 not null,
  tot_val_prevision   NUMBER(18,2) default 0 not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  tot_valuacion       NUMBER(18,2) default 0
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.OV_VALUACIONES_HIS
  is 'Datos para el proceso de Ganancias por Valuaciones.';
comment on column IT.OV_VALUACIONES_HIS.nro_cuenta
  is 'Numero de Prestamo.';
comment on column IT.OV_VALUACIONES_HIS.fecha
  is 'Fecha en que se proceso por ultima vez las diferencias por valuaciones.';
comment on column IT.OV_VALUACIONES_HIS.estado
  is 'Estado de Cuenta on line (C=Vigente, V=Vencido, G=En Gestion, M=Moroso, I=Irrecurable, N=Cancelado).';
comment on column IT.OV_VALUACIONES_HIS.sal_total
  is 'Saldo Total en el momento de la valuacion.';
comment on column IT.OV_VALUACIONES_HIS.tot_gar_computables
  is 'Total de Garantias computables.';
comment on column IT.OV_VALUACIONES_HIS.tot_prevision
  is 'Monto Total de la Prevision.';
comment on column IT.OV_VALUACIONES_HIS.cat_automatica
  is 'Categoria automatica del Sistema.';
comment on column IT.OV_VALUACIONES_HIS.cotizacion
  is 'Cotizacion utilizada en el Calculo de Valuacion.';
comment on column IT.OV_VALUACIONES_HIS.cot_anterior
  is 'Cotizacion anterior.';
comment on column IT.OV_VALUACIONES_HIS.tot_val_saldo
  is 'Monto Total de Valuacion por el Saldo.';
comment on column IT.OV_VALUACIONES_HIS.tot_val_garantia
  is 'Monto Total de Valuacion por la Garantia computable.';
comment on column IT.OV_VALUACIONES_HIS.tot_val_prevision
  is 'Monto Total de Valuacion por la Prevision.';
comment on column IT.OV_VALUACIONES_HIS.usu_insercion
  is 'Usuario que realizo la insercion del Registro.';
comment on column IT.OV_VALUACIONES_HIS.fec_insercion
  is 'Fecha en que se inserto el Registro.';
comment on column IT.OV_VALUACIONES_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el Registro.';
comment on column IT.OV_VALUACIONES_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el Registro.';
comment on column IT.OV_VALUACIONES_HIS.tot_valuacion
  is 'Monto Total de la Valuación Consolidado.';
alter table IT.OV_VALUACIONES_HIS
  add constraint PK_OV_VALUACIONES_HIS primary key (NRO_CUENTA, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.OV_VALUACIONES_HIS
  add constraint FK_VVHIS_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.OV_CTA_VENCIDAS (NRO_CUENTA);

