create table IT.PR_LINEAS_HIS
(
  nro_linea         NUMBER(7) not null,
  cod_persona       VARCHAR2(10),
  cod_gru_economico NUMBER(5),
  cod_modulo        NUMBER(3),
  cod_modalidad     NUMBER(3),
  cod_moneda        VARCHAR2(3) not null,
  monto             NUMBER(18,2) default 0 not null,
  fec_vencimiento   DATE,
  fec_otorgamiento  DATE not null,
  mto_aplicado      NUMBER(18,2) default 0,
  descripcion       VARCHAR2(60),
  estado            VARCHAR2(1),
  observacion       VARCHAR2(1000),
  niv_aprobacion    VARCHAR2(3),
  cotizacion        NUMBER(14,8) default 0,
  fec_aprobacion    DATE,
  nro_acta          VARCHAR2(10),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_campana       NUMBER(3),
  url_crm           VARCHAR2(4000)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_LINEAS_HIS
  is 'Tabla de Lineas de Credito - Histórico.';
comment on column IT.PR_LINEAS_HIS.nro_linea
  is 'Número de la Línea.';
comment on column IT.PR_LINEAS_HIS.cod_persona
  is 'Número de Cliente.';
comment on column IT.PR_LINEAS_HIS.cod_gru_economico
  is 'Grupo Económico.';
comment on column IT.PR_LINEAS_HIS.cod_modulo
  is 'Código del Módulo de la Línea.';
comment on column IT.PR_LINEAS_HIS.cod_modalidad
  is 'Código de la Modalidad de la Línea.';
comment on column IT.PR_LINEAS_HIS.cod_moneda
  is 'Código de la Moneda.';
comment on column IT.PR_LINEAS_HIS.monto
  is 'Monto de la Línea.';
comment on column IT.PR_LINEAS_HIS.fec_vencimiento
  is 'Fecha de Validez desde.';
comment on column IT.PR_LINEAS_HIS.fec_otorgamiento
  is 'Fecha de Otorgamiento.';
comment on column IT.PR_LINEAS_HIS.mto_aplicado
  is 'Valor ya aplicado de la línea.';
comment on column IT.PR_LINEAS_HIS.descripcion
  is 'Descripción de la Línea.';
comment on column IT.PR_LINEAS_HIS.estado
  is 'Estado de la Linea (P=Pendiente, A=Aprobado, V=Vencido, B=Bloqueado, C=Cancelado).';
comment on column IT.PR_LINEAS_HIS.observacion
  is 'Observaciones.';
comment on column IT.PR_LINEAS_HIS.niv_aprobacion
  is 'Niveles de aprobación.';
comment on column IT.PR_LINEAS_HIS.cotizacion
  is 'Cotización.';
comment on column IT.PR_LINEAS_HIS.fec_aprobacion
  is 'Fecha de Aprobación.';
comment on column IT.PR_LINEAS_HIS.nro_acta
  is 'Nro. de Acta.';
comment on column IT.PR_LINEAS_HIS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_LINEAS_HIS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_LINEAS_HIS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_LINEAS_HIS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_LINEAS_HIS.cod_campana
  is 'Código de campaña.';
comment on column IT.PR_LINEAS_HIS.url_crm
  is 'Url de acceso directo a la solicitud de Admision en CRM';
create index IT.IN_PLHIS_COD_GRU_ECONOMICO on IT.PR_LINEAS_HIS (COD_GRU_ECONOMICO, COD_MODALIDAD, COD_MODULO, COD_MONEDA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_PLHIS_NRO_LINEA on IT.PR_LINEAS_HIS (COD_PERSONA, NRO_LINEA, FEC_OTORGAMIENTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 576K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_LINEAS_HIS
  add constraint FK_PLHIS_COD_GRU_ECONOMICO foreign key (COD_GRU_ECONOMICO)
  references IT.GE_GRU_ECONOMICOS (COD_GRU_ECONOMICO);
alter table IT.PR_LINEAS_HIS
  add constraint FK_PLHIS_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.PR_LINEAS_HIS
  add constraint FK_PLHIS_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_LINEAS_HIS
  add constraint FK_PLHIS_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);

