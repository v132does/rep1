create table IT.GE_CLIENTES_BCP_TMP
(
  nro_documento VARCHAR2(15),
  tip_documento VARCHAR2(3),
  dat_respuesta CLOB
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CLIENTES_BCP_TMP
  is 'Tabla temporal para importación de datos de Clientes del BCP.';
comment on column IT.GE_CLIENTES_BCP_TMP.nro_documento
  is 'Numero de documento de identidad del cliente';
comment on column IT.GE_CLIENTES_BCP_TMP.tip_documento
  is 'Tipo de documento de identidad del cliente';
comment on column IT.GE_CLIENTES_BCP_TMP.dat_respuesta
  is 'Respuesta recibida del servicio ';

