create table IT.CR_AGE_RES_ACTIVIDADES
(
  cod_actividad    NUMBER(3) not null,
  cod_respuesta    NUMBER(2) not null,
  descripcion      VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default substr(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default substr(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_AGE_RES_ACTIVIDADES
  is 'Tipos de Respuestas de Actividad en la Agenda.';
comment on column IT.CR_AGE_RES_ACTIVIDADES.cod_actividad
  is 'Codigo de actividad.';
comment on column IT.CR_AGE_RES_ACTIVIDADES.cod_respuesta
  is 'Codigo de respuesta.';
comment on column IT.CR_AGE_RES_ACTIVIDADES.descripcion
  is 'Descripcion de la respuesta.';
comment on column IT.CR_AGE_RES_ACTIVIDADES.usu_insercion
  is 'Usuario que inserto.';
comment on column IT.CR_AGE_RES_ACTIVIDADES.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.CR_AGE_RES_ACTIVIDADES.usu_modificacion
  is 'Usuario que modifico.';
comment on column IT.CR_AGE_RES_ACTIVIDADES.fec_modificacion
  is 'Fecha de la modificacion.';
alter table IT.CR_AGE_RES_ACTIVIDADES
  add constraint PK_CR_AGE_RES_ACTIVIDADES primary key (COD_ACTIVIDAD, COD_RESPUESTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_AGE_RES_ACTIVIDADES
  add constraint AVCON_1118174505_COD_A_001
  check (COD_ACTIVIDAD BETWEEN 0 AND 999);
alter table IT.CR_AGE_RES_ACTIVIDADES
  add constraint AVCON_1118174505_COD_R_000
  check (COD_RESPUESTA BETWEEN 0 AND 999);

