create table IT.GE_PAG_SUE_EMP
(
  cod_empresa       NUMBER(5),
  nro_cedula        VARCHAR2(20) not null,
  pri_nombre        VARCHAR2(30),
  seg_nombre        VARCHAR2(30),
  pri_apellido      VARCHAR2(30),
  seg_apellido      VARCHAR2(30),
  ape_casada        VARCHAR2(15),
  fec_nacimiento    DATE not null,
  sexo              VARCHAR2(1) default 'M' not null,
  est_civil         VARCHAR2(20) not null,
  direccion         VARCHAR2(100),
  ciudad            VARCHAR2(100),
  telefono          VARCHAR2(20),
  sueldo            NUMBER(18,2) default 0,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  tip_documento     VARCHAR2(3) default 'CI',
  nro_solicitud     NUMBER(8),
  error             VARCHAR2(80),
  nro_cuenta        VARCHAR2(15),
  sobregiro         VARCHAR2(1),
  tip_contrato      VARCHAR2(1),
  direc_kit         VARCHAR2(200),
  nro_lote          NUMBER(10),
  estado            VARCHAR2(1),
  profesion         VARCHAR2(35),
  mail              VARCHAR2(319),
  pais              VARCHAR2(35),
  celular           VARCHAR2(20),
  fec_vto_documento DATE,
  fec_ingreso       DATE,
  cod_pai_fatca     NUMBER(3),
  dir_fiscal        VARCHAR2(80),
  cod_pai_fiscal    NUMBER(3),
  doc_pais          VARCHAR2(60),
  nro_operacion     NUMBER(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_PAG_SUE_EMP.cod_empresa
  is 'Codigo de Empresa.';
comment on column IT.GE_PAG_SUE_EMP.nro_cedula
  is 'Nro. de Cedula';
comment on column IT.GE_PAG_SUE_EMP.pri_nombre
  is 'Primer Nombre.';
comment on column IT.GE_PAG_SUE_EMP.seg_nombre
  is 'Segundo Nombre.';
comment on column IT.GE_PAG_SUE_EMP.pri_apellido
  is 'Primer Apellido.';
comment on column IT.GE_PAG_SUE_EMP.seg_apellido
  is 'Segundo Apellido.';
comment on column IT.GE_PAG_SUE_EMP.ape_casada
  is 'Apellido de Casada.';
comment on column IT.GE_PAG_SUE_EMP.fec_nacimiento
  is 'Fecha de Nacimiento.';
comment on column IT.GE_PAG_SUE_EMP.sexo
  is 'Codigo de Sexo.';
comment on column IT.GE_PAG_SUE_EMP.est_civil
  is 'Codigo de Estado Civil.';
comment on column IT.GE_PAG_SUE_EMP.direccion
  is 'Direccion.';
comment on column IT.GE_PAG_SUE_EMP.ciudad
  is 'Ciudad.';
comment on column IT.GE_PAG_SUE_EMP.telefono
  is 'Telefono.';
comment on column IT.GE_PAG_SUE_EMP.sueldo
  is 'Monto del Sueldo.';
comment on column IT.GE_PAG_SUE_EMP.usu_insercion
  is 'Usuario que realizó la Inserción.';
comment on column IT.GE_PAG_SUE_EMP.fec_insercion
  is 'Fecha de Insercion.';
comment on column IT.GE_PAG_SUE_EMP.usu_modificacion
  is 'Usuario que realizó la Modificación.';
comment on column IT.GE_PAG_SUE_EMP.fec_modificacion
  is 'Fecha de Modificación.';
comment on column IT.GE_PAG_SUE_EMP.tip_documento
  is 'Tipo de Documento.';
comment on column IT.GE_PAG_SUE_EMP.nro_solicitud
  is 'Nro. de Solicitud de Alta.';
comment on column IT.GE_PAG_SUE_EMP.error
  is 'Error.';
comment on column IT.GE_PAG_SUE_EMP.nro_cuenta
  is 'Nro. de Cuenta asignada.';
comment on column IT.GE_PAG_SUE_EMP.sobregiro
  is 'Sobregiro (S/N)';
comment on column IT.GE_PAG_SUE_EMP.tip_contrato
  is 'Indefinido o Temporal (I/T)';
comment on column IT.GE_PAG_SUE_EMP.direc_kit
  is 'Dirección del Kit';
comment on column IT.GE_PAG_SUE_EMP.nro_lote
  is 'Número de Lote desde la Web';
comment on column IT.GE_PAG_SUE_EMP.estado
  is 'Estado de la solicitud. (P: Pendiente, N:Procesado, C:Autorizado, R:Rechazado)';
comment on column IT.GE_PAG_SUE_EMP.profesion
  is 'Profesion';
comment on column IT.GE_PAG_SUE_EMP.mail
  is 'E-mail';
comment on column IT.GE_PAG_SUE_EMP.pais
  is 'País Origen';
comment on column IT.GE_PAG_SUE_EMP.celular
  is 'Celular';
comment on column IT.GE_PAG_SUE_EMP.fec_vto_documento
  is 'Fecha de Vencimiento del Documento';
comment on column IT.GE_PAG_SUE_EMP.fec_ingreso
  is 'Fecha de ingreso ';
comment on column IT.GE_PAG_SUE_EMP.cod_pai_fatca
  is 'Indica el País de quién solicita.';
comment on column IT.GE_PAG_SUE_EMP.dir_fiscal
  is 'Indica el nombre de la calle o dirección fiscal del cliente.';
comment on column IT.GE_PAG_SUE_EMP.cod_pai_fiscal
  is 'Indica el País asociado a la dirección fiscal del cliente.';
comment on column IT.GE_PAG_SUE_EMP.doc_pais
  is 'Indica el País asociado al documento del cliente.';
comment on column IT.GE_PAG_SUE_EMP.nro_operacion
  is 'Numero de operacion autorizada.';
create index IT.IN_GPSEM_COD_EMPRESA on IT.GE_PAG_SUE_EMP (COD_EMPRESA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

