create table IT.GE_EST_CUENTAS_CRM
(
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  estado           VARCHAR2(1),
  descripcion      VARCHAR2(35),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default current_timestamp not null,
  activo           VARCHAR2(1),
  tip_accion       VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_EST_CUENTAS_CRM
  is 'Catalogos de Estados de Cuentas.';
comment on column IT.GE_EST_CUENTAS_CRM.cod_modulo
  is 'Codigo de Modulo.';
comment on column IT.GE_EST_CUENTAS_CRM.cod_modalidad
  is 'Codigo de Modalidad.';
comment on column IT.GE_EST_CUENTAS_CRM.estado
  is 'Codigo de Estado.';
comment on column IT.GE_EST_CUENTAS_CRM.descripcion
  is 'Descripcion del Estado.';
comment on column IT.GE_EST_CUENTAS_CRM.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_EST_CUENTAS_CRM.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_EST_CUENTAS_CRM.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_EST_CUENTAS_CRM.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_EST_CUENTAS_CRM.activo
  is 'Indica si el estado corresponde a una cuenta activa o inactiva.';
comment on column IT.GE_EST_CUENTAS_CRM.tip_accion
  is 'Indica el tipo de accion realizado con el registro en el Core.-';
alter table IT.GE_EST_CUENTAS_CRM
  add constraint PK_GE_EST_CUENTAS_CRM primary key (FEC_MODIFICACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

