create table IT.CB_RUB_ROLES
(
  cod_rubro        VARCHAR2(15) not null,
  cod_rol          VARCHAR2(20) not null,
  cod_programa     VARCHAR2(30),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_RUB_ROLES
  is 'Rubros por Roles y Programas.';
comment on column IT.CB_RUB_ROLES.cod_rubro
  is 'Codigo de la cuenta contable.';
comment on column IT.CB_RUB_ROLES.cod_rol
  is 'Codigo del rol.';
comment on column IT.CB_RUB_ROLES.cod_programa
  is 'Codigo del Programa.';
comment on column IT.CB_RUB_ROLES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_RUB_ROLES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_RUB_ROLES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_RUB_ROLES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_BRROL_COD_PROGRAMA on IT.CB_RUB_ROLES (COD_PROGRAMA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BRROL_COD_ROL on IT.CB_RUB_ROLES (COD_ROL)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_RUB_ROLES
  add constraint UK_CB_RUB_ROLES unique (COD_RUBRO, COD_ROL, COD_PROGRAMA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 320K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_RUB_ROLES
  add constraint FK_BRROL_COD_PROGRAMA foreign key (COD_PROGRAMA)
  references IT.BA_PROGRAMAS (COD_PROGRAMA);
alter table IT.CB_RUB_ROLES
  add constraint FK_BRROL_COD_ROL foreign key (COD_ROL)
  references IT.BA_ROLES (COD_ROL);
alter table IT.CB_RUB_ROLES
  add constraint FK_BRROL_COD_RUBRO foreign key (COD_RUBRO)
  references IT.CB_RUBROS (COD_RUBRO);

