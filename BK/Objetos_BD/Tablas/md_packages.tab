create table IT.MD_PACKAGES
(
  id                NUMBER not null,
  schema_id_fk      NUMBER not null,
  name              VARCHAR2(4000) not null,
  package_header    CLOB,
  native_sql        CLOB,
  native_key        VARCHAR2(4000),
  language          VARCHAR2(40) not null,
  comments          VARCHAR2(4000),
  security_group_id NUMBER default 0 not null,
  created_on        DATE default sysdate not null,
  created_by        VARCHAR2(255),
  last_updated_on   DATE,
  last_updated_by   VARCHAR2(255)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MD_PACKAGES
  is 'For storing packages';
comment on column IT.MD_PACKAGES.id
  is 'Primary Key';
comment on column IT.MD_PACKAGES.schema_id_fk
  is 'the schema in which this package resides //PARENTFIELD';
comment on column IT.MD_PACKAGES.name
  is 'Name of this package //OBJECTNAME';
comment on column IT.MD_PACKAGES.native_sql
  is 'The SQL used to create this package at source';
comment on column IT.MD_PACKAGES.native_key
  is 'A unique identifer for this object at source.';
comment on column IT.MD_PACKAGES.language
  is '//PUBLIC';
alter table IT.MD_PACKAGES
  add constraint MD_PACKAGES_PK primary key (ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.MD_PACKAGES
  add constraint MD_PACKAGES_MD_SCHEMAS_FK1 foreign key (SCHEMA_ID_FK)
  references IT.MD_SCHEMAS (ID) on delete cascade;

