-- Create table
create table IT.SB_LCR_LIQ_INV_TMP
(
  moneda     VARCHAR2(5),
  cod_rubro  VARCHAR2(15),
  nro_cuenta VARCHAR2(15),
  plazo      VARCHAR2(5),
  monto      NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
