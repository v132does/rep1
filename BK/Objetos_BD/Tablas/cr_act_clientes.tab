-- Create table
create table IT.CR_ACT_CLIENTES
(
  id_registro    NUMBER generated by default as identity,
  codigo         VARCHAR2(10) not null,
  fecha_creacion DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the columns 
comment on column IT.CR_ACT_CLIENTES.id_registro
  is 'Identificador del registro';
comment on column IT.CR_ACT_CLIENTES.codigo
  is 'Codigo de la persona';
comment on column IT.CR_ACT_CLIENTES.fecha_creacion
  is 'Fecha de creacion';
-- Create/Recreate indexes 
create index IT.IDX_CR_ACT_CLIENTES_FECHA on IT.CR_ACT_CLIENTES (FECHA_CREACION)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
