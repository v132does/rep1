create table IT.MD_USERS
(
  id                NUMBER not null,
  schema_id_fk      NUMBER not null,
  username          VARCHAR2(4000) not null,
  password          VARCHAR2(4000),
  native_sql        CLOB,
  native_key        VARCHAR2(4000),
  comments          VARCHAR2(4000),
  security_group_id NUMBER default 0 not null,
  created_on        DATE default sysdate not null,
  created_by        VARCHAR2(255),
  last_updated_on   DATE,
  last_updated_by   VARCHAR2(255)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MD_USERS
  is 'User information.';
comment on column IT.MD_USERS.id
  is 'Primary Key';
comment on column IT.MD_USERS.schema_id_fk
  is 'Shema in which this object belongs //PARENTFIELD';
comment on column IT.MD_USERS.username
  is 'Username for login //OBJECTNAME';
comment on column IT.MD_USERS.password
  is 'Password for login';
comment on column IT.MD_USERS.native_sql
  is 'SQL Used to create this object at source';
comment on column IT.MD_USERS.native_key
  is 'Unique identifier for this object at source.';
alter table IT.MD_USERS
  add constraint MD_USERS_PK primary key (ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.MD_USERS
  add constraint MD_USERS_MD_SCHEMAS_FK1 foreign key (SCHEMA_ID_FK)
  references IT.MD_SCHEMAS (ID) on delete cascade;

