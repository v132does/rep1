create table IT.CB_SAL_CONSOLIDADOS_RES
(
  cod_rubro             VARCHAR2(15) not null,
  ano                   NUMBER(4) not null,
  mes                   NUMBER(2) not null,
  sal_mon_loc_ant       NUMBER(18,2) default 0,
  deb_mon_local         NUMBER(18,2) default 0,
  cre_mon_local         NUMBER(18,2) default 0,
  sal_ini_mes_mon_local NUMBER(18,2) default 0,
  sal_mon_rub_ant       NUMBER(18,2) default 0,
  deb_mon_rubro         NUMBER(18,2) default 0,
  cre_mon_rubro         NUMBER(18,2) default 0,
  sal_ini_mes_mon_rubro NUMBER(18,2) default 0,
  protegido             VARCHAR2(1) default 'N' not null,
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default SYSDATE not null,
  sal_equ_loc_ant       NUMBER(18,2),
  deb_equ_local         NUMBER(18,2),
  cre_equ_local         NUMBER(18,2),
  sal_ini_mes_equ_local NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SAL_CONSOLIDADOS_RES
  is 'Contiene la copia de los saldos de las cuentas contables consolidadas.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.cod_rubro
  is 'Codigo de la cuenta contable.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.ano
  is 'Año de saldo.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.mes
  is 'Mes de saldo.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.sal_mon_loc_ant
  is 'Saldo de ayer en moneda local.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.deb_mon_local
  is 'Debitos de hoy en moneda local.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.cre_mon_local
  is 'Creditos de hoy en moneda local.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.sal_ini_mes_mon_local
  is 'Saldo de inicio del mes en moneda local.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.sal_mon_rub_ant
  is 'Saldo de ayer en moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.deb_mon_rubro
  is 'Debitos de hoy en moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.cre_mon_rubro
  is 'Creditos de hoy en moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.sal_ini_mes_mon_rubro
  is 'Saldo de inicio del mes en moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.protegido
  is 'Registro protegido ? ( S=Es protegido, no puede ser borrado, N=No es protegido, puede ser borrado ).';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.sal_equ_loc_ant
  is 'Saldo anterior del equivalente en gs de la moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.deb_equ_local
  is 'Total de debitos del equivalente en gs de la moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.cre_equ_local
  is 'Total de creditos del equivalente en gs de la moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_RES.sal_ini_mes_equ_local
  is 'Saldo inicial del mes equivalente en gs de la moneda extranjera.';

