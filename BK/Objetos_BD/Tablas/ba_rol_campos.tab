create table IT.BA_ROL_CAMPOS
(
  cod_programa     VARCHAR2(30) not null,
  cod_rol          VARCHAR2(30) not null,
  nom_bloque       VARCHAR2(30),
  nom_campo        VARCHAR2(30),
  consulta         VARCHAR2(1) default 'S' not null,
  inserta          VARCHAR2(1) not null,
  modifica         VARCHAR2(1) not null,
  elimina          VARCHAR2(1) not null,
  tip_persona      VARCHAR2(1),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_ROL_CAMPOS
  is 'Tabla de totales por segmento de límites VaR.';
comment on column IT.BA_ROL_CAMPOS.cod_programa
  is 'Código del programa donde se va realizar el control especifico';
comment on column IT.BA_ROL_CAMPOS.cod_rol
  is 'Rol específico al cual se restringe el permiso';
comment on column IT.BA_ROL_CAMPOS.nom_bloque
  is 'Nombre del bloque que se desea controlar';
comment on column IT.BA_ROL_CAMPOS.nom_campo
  is 'Nombre del campo que se desea controlar';
comment on column IT.BA_ROL_CAMPOS.consulta
  is 'Indicador si tiene permiso a consultar los datos por defecto debería ser S';
comment on column IT.BA_ROL_CAMPOS.inserta
  is ' Indicador si tiene permiso para insertar los datos';
comment on column IT.BA_ROL_CAMPOS.modifica
  is 'Indicador si tiene permiso para modificar los datos';
comment on column IT.BA_ROL_CAMPOS.elimina
  is ' Indicador si tiene permiso para eliminar los datos';
comment on column IT.BA_ROL_CAMPOS.tip_persona
  is 'Tipo de persona: F=Física, J=Jurídica';
comment on column IT.BA_ROL_CAMPOS.usu_insercion
  is 'Usuario que insertó el registro';
comment on column IT.BA_ROL_CAMPOS.fec_insercion
  is 'Fecha de inserción del registro';
comment on column IT.BA_ROL_CAMPOS.usu_modificacion
  is 'Último usuario que modificó el registro';
comment on column IT.BA_ROL_CAMPOS.fec_modificacion
  is 'Fecha de última actualización del registro';
alter table IT.BA_ROL_CAMPOS
  add constraint FK_ROL_CAMPOS_PROGRAMA foreign key (COD_PROGRAMA)
  references IT.BA_PROGRAMAS (COD_PROGRAMA);
alter table IT.BA_ROL_CAMPOS
  add constraint FK_ROL_CAMPOS_ROL foreign key (COD_ROL)
  references IT.BA_ROLES (COD_ROL);

