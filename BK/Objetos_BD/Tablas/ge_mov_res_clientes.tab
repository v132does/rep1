    minextents 1
    maxextents unlimited
  );
alter table IT.GE_MOV_RES_CLIENTES
  add constraint FK_GMRCL_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_MOV_RES_CLIENTES
  add constraint FK_GMRCL_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_MOV_RES_CLIENTES
  add constraint FK_GMRCL_COD_TRA_PADRE foreign key (COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_MOV_RES_CLIENTES
  add constraint FK_GMRCL_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_MOV_RES_CLIENTES
  add constraint FK_GMRCL_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.GE_MOV_RES_CLIENTES
  add constraint AVCON_1185995347_COD_M_002
  check (COD_MAD_PADRE BETWEEN 0 AND 999);
alter table IT.GE_MOV_RES_CLIENTES
  add constraint AVCON_1185995347_COD_O_004
  check (COD_OFI_ORIGEN BETWEEN 0 AND 999);
alter table IT.GE_MOV_RES_CLIENTES
  add constraint AVCON_1185995347_INFOR_000
  check (INFORMADO IN ('S', 'N'));

