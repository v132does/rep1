    minextents 1
    maxextents unlimited
  );
create index IT.IN_GMRCL_NRO_DOCUMENTO on IT.GE_MOV_RES_CLIENTES (FECHA, HORA, COD_USUARIO, NRO_DOCUMENTO)
  tablespace IT_IND
