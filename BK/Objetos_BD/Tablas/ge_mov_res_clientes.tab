    maxextents unlimited
  );
create index IT.IN_GMRCL_NRO_CUENTA on IT.GE_MOV_RES_CLIENTES (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
