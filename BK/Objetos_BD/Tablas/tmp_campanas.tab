create table IT.TMP_CAMPANAS
(
  cod_persona  VARCHAR2(200) not null,
  nom_completo VARCHAR2(200) not null,
  nom_campana  VARCHAR2(30) not null,
  afinidad     VARCHAR2(100)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

