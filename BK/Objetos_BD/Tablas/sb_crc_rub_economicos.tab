CREATE TABLE IT.SB_CRC_RUB_ECONOMICOS (
COD_RUB_ECONOMICO  VARCHAR2(6) NOT NULL , 
DESCRIPCION                VARCHAR2(128) ,
COD_ACT_INTERNA            VARCHAR2(15),  
REFERENCIA                 NUMBER(3),     
COD_BCO_CENTRAL            NUMBER(38),    
COD_CAL_SARAS              VARCHAR2(26),  
DESCRIPCION_RUBRO          VARCHAR2(128), 
USU_INSERCION      VARCHAR2(10) NOT NULL, 
FEC_INSERCION      DATE  NOT NULL,        
USU_MODIFICACION   VARCHAR2(10)  NOT NULL,
FEC_MODIFICACION   DATE   NOT NULL)

tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

ALTER TABLE IT.SB_CRC_RUB_ECONOMICOS
  ADD CONSTRAINT PK_SB_RUB_ECON
  PRIMARY KEY (COD_RUB_ECONOMICO);

CREATE PUBLIC SYNONYM SB_CRC_RUB_ECONOMICOS FOR IT.SB_CRC_RUB_ECONOMICOS;
GRANT ALTER, DELETE, INSERT, UPDATE, SELECT ON IT.SB_CRC_RUB_ECONOMICOS TO IT_TEMPORAL;