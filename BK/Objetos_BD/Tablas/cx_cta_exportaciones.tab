alter table IT.CX_CTA_EXPORTACIONES
  add constraint PK_CX_CTA_EXPORTACIONES primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_COD_BCO_CORRESPONSAL foreign key (COD_BCO_CORRESPONSAL)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_COD_BCO_EMISOR foreign key (COD_BCO_EMISOR)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_COD_BCO_REEMBOLSANTE foreign key (COD_BCO_REEMBOLSANTE)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_COD_PER_BENEFICIARIO foreign key (COD_PER_BENEFICIARIO)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_COD_RUB_ECONOMICO foreign key (COD_RUB_ECONOMICO)
  references IT.PR_RUB_ECONOMICOS (COD_RUB_ECONOMICO);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_NRO_CTA_PRESTAMO foreign key (NRO_CTA_PRESTAMO)
  references IT.PR_CTA_PRESTAMOS (NRO_CUENTA);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint FK_CXCCE_NRO_SOLICITUD foreign key (NRO_SOL_PRESTAMO)
  references IT.PR_SOLICITUDES (NRO_SOLICITUD);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint AVCON_1173791835_COBRA_000
  check (COBRADO IN ('S', 'N'));
alter table IT.CX_CTA_EXPORTACIONES
  add constraint AVCON_1173791835_COD_B_005
  check (COD_BCO_EMISOR BETWEEN 0 AND 999);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint AVCON_1173791835_COD_B_006
  check (COD_BCO_CORRESPONSAL BETWEEN 0 AND 999);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint AVCON_1173791835_COD_M_007
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint AVCON_1173791835_COD_M_008
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint AVCON_1173791835_COD_O_005
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint AVCON_1173791835_CONFI_001
  check (CONFIRMADO IN ('S', 'N'));
alter table IT.CX_CTA_EXPORTACIONES
  add constraint AVCON_1173791835_TIP_C_001
  check (TIP_COBRO IN ('V', 'P'));
alter table IT.CX_CTA_EXPORTACIONES
  add constraint AVCON_1173791835_TIP_M_001
  check (TIP_MONTO IN ('E', 'A', 'H'));
alter table IT.CX_CTA_EXPORTACIONES
  add constraint AVCON_1173791835_TIP_U_000
  check (TIP_UTILIZACION IN ('P', 'T'));
alter table IT.CX_CTA_EXPORTACIONES
  add constraint CK_XCEXP_ANT_MONTO
  check (NVL(ANT_MONTO,0) >= 0);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint CK_XCEXP_MONTO
  check (NVL(MONTO,0) > 0);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint CK_XCEXP_MTO_UTILIZA
  check (NVL(MTO_UTILIZADO,0) <= NVL(MONTO,0));
alter table IT.CX_CTA_EXPORTACIONES
  add constraint CK_XCEXP_MTO_UTILIZADO
  check (NVL(MTO_UTILIZADO,0) >= 0);
alter table IT.CX_CTA_EXPORTACIONES
  add constraint CK_XCEXP_SALDO
  check (NVL(SALDO,0) >= 0);

