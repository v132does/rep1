create table IT.CX_CTA_EXPORTACIONES
(
  nro_cuenta               VARCHAR2(15) not null,
  cod_modulo               NUMBER(3) not null,
  cod_modalidad            NUMBER(3) not null,
  cod_oficina              NUMBER(3) not null,
  denominacion             VARCHAR2(60) not null,
  cod_moneda               VARCHAR2(3) not null,
  fec_solicitud            DATE,
  fec_aprobacion           DATE,
  fec_vencimiento          DATE,
  fec_cancelacion          DATE,
  tip_monto                VARCHAR2(1) default 'A' not null,
  monto                    NUMBER(18,2) default 0 not null,
  mto_equ_local            NUMBER(18,2) default 0,
  saldo                    NUMBER(18,2) default 0,
  sal_batch                NUMBER(18,2) default 0,
  cod_bco_emisor           NUMBER(3) not null,
  cod_bco_corresponsal     NUMBER(3),
  cod_per_beneficiario     VARCHAR2(10) not null,
  tip_utilizacion          VARCHAR2(1) default 'P',
  nro_referencia           VARCHAR2(20),
  mercaderia               VARCHAR2(250),
  nro_cta_reembolso        VARCHAR2(15),
  confirmado               VARCHAR2(1) default 'N',
  fec_ven_embarque         DATE,
  cobrado                  VARCHAR2(1) default 'N',
  estado                   VARCHAR2(1) not null,
  est_batch                VARCHAR2(1),
  nro_linea                NUMBER(7),
  tip_cobro                VARCHAR2(1) default 'V',
  nro_sol_prestamo         NUMBER(7),
  nro_cta_prestamo         VARCHAR2(15),
  observacion              VARCHAR2(4000),
  usu_insercion            VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion            DATE default SYSDATE not null,
  usu_modificacion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion         DATE default SYSDATE not null,
  fec_cam_estado           DATE,
  cod_cau_cancelacion      NUMBER(3),
  beneficiario             VARCHAR2(255),
  cod_bco_reembolsante     NUMBER(3),
  ordenante                VARCHAR2(100),
  ant_confirmado           VARCHAR2(1),
  ant_monto                NUMBER(18,2),
  ant_fec_vencimiento      DATE,
  con_aladi                VARCHAR2(1) default 'N',
  mto_utilizado            NUMBER(18,2) default 0,
  fec_utilizacion          DATE,
  discrepado               VARCHAR2(1) default 'N',
  cod_sit_contable         NUMBER(20),
  con_aladi_ant            VARCHAR2(1),
  cod_bco_corresponsal_ant NUMBER(3),
  ubi_bco_emisor_ant       VARCHAR2(1),
  nro_cta_debito           VARCHAR2(15),
  por_var_monto            NUMBER(6,2),
  mto_original             NUMBER(18,2),
  cod_rub_economico        VARCHAR2(6)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CX_CTA_EXPORTACIONES
  is 'Cartas de Credito de Exportacion.';
comment on column IT.CX_CTA_EXPORTACIONES.nro_cuenta
  is 'Nro. de cuenta interno.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_modulo
  is 'Codigo del modulo. Siempre es 8.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_modalidad
  is 'Codigo de modalidad. 82-Carta de Exportacion.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_oficina
  is 'Codigo de la oficina.';
comment on column IT.CX_CTA_EXPORTACIONES.denominacion
  is 'Nombre de la Cuenta.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.CX_CTA_EXPORTACIONES.fec_solicitud
  is 'Fecha de la solicitud de la carta.';
comment on column IT.CX_CTA_EXPORTACIONES.fec_aprobacion
  is 'Fecha de aprobacion de la cce.';
comment on column IT.CX_CTA_EXPORTACIONES.fec_vencimiento
  is 'Fecha de vencimiento.';
comment on column IT.CX_CTA_EXPORTACIONES.fec_cancelacion
  is 'Fecha de cancelacion.';
comment on column IT.CX_CTA_EXPORTACIONES.tip_monto
  is 'Tipo de monto: E-exacto A-Aprox.';
comment on column IT.CX_CTA_EXPORTACIONES.monto
  is 'Monto de la cce.';
comment on column IT.CX_CTA_EXPORTACIONES.mto_equ_local
  is 'Monto equivalente en moneda local.';
comment on column IT.CX_CTA_EXPORTACIONES.saldo
  is 'Saldo actual de la carta.';
comment on column IT.CX_CTA_EXPORTACIONES.sal_batch
  is 'Saldo batch de la carta.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_bco_emisor
  is 'Codigo del banco emisor.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_bco_corresponsal
  is 'Codigo del Banco corresponsal, puede ser el propio banco.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_per_beneficiario
  is 'Cliente Beneficiario.';
comment on column IT.CX_CTA_EXPORTACIONES.tip_utilizacion
  is 'Tipo de utilizacion: T-total o P-parcial.';
comment on column IT.CX_CTA_EXPORTACIONES.nro_referencia
  is 'Nro de referencia del corresponsal para la cce.';
comment on column IT.CX_CTA_EXPORTACIONES.mercaderia
  is 'Descripcion de la Mercaderia.';
comment on column IT.CX_CTA_EXPORTACIONES.nro_cta_reembolso
  is 'Es la cuenta del Banco Reembolsante donde se deposita a la Entidad.';
comment on column IT.CX_CTA_EXPORTACIONES.confirmado
  is 'Indica si esta confirmado S/N.';
comment on column IT.CX_CTA_EXPORTACIONES.fec_ven_embarque
  is 'Fecha de vencimiento del embarque.';
comment on column IT.CX_CTA_EXPORTACIONES.cobrado
  is 'Cobrado si o no.';
comment on column IT.CX_CTA_EXPORTACIONES.estado
  is 'Estado actual de la carta: S-Solicitado,A-Aprobadoo/C-cancelado/D-Deudores por Aval/P-Prestamo.';
comment on column IT.CX_CTA_EXPORTACIONES.est_batch
  is 'Estado batch de la carta: S-Solicitado,A-Aprobadoo/C-cancelado/D-Deudores por Aval/P-Prestamo.';
comment on column IT.CX_CTA_EXPORTACIONES.nro_linea
  is 'Nro de linea de credito.';
comment on column IT.CX_CTA_EXPORTACIONES.tip_cobro
  is 'Tipo de cobro: V-Vista o P-Plazo.';
comment on column IT.CX_CTA_EXPORTACIONES.nro_sol_prestamo
  is 'Nro. de solicitud de prestamos si esta asociado a uno.';
comment on column IT.CX_CTA_EXPORTACIONES.nro_cta_prestamo
  is 'Nro. de cuenta de prestamos si esta asociado a uno.';
comment on column IT.CX_CTA_EXPORTACIONES.observacion
  is 'Observaciones de la cce.';
comment on column IT.CX_CTA_EXPORTACIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CX_CTA_EXPORTACIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CX_CTA_EXPORTACIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CX_CTA_EXPORTACIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CX_CTA_EXPORTACIONES.fec_cam_estado
  is 'Fecha del ultimo cambio de estado.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_cau_cancelacion
  is 'Codigo de motivo de cancelacion.';
comment on column IT.CX_CTA_EXPORTACIONES.beneficiario
  is 'Nombre del Ordenante.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_bco_reembolsante
  is 'Codigo del Banco Reembolsante.';
comment on column IT.CX_CTA_EXPORTACIONES.ordenante
  is 'Ordenante o Importador de la mercaderia.';
comment on column IT.CX_CTA_EXPORTACIONES.ant_confirmado
  is 'Estado de confirmacion anterior aprobado, si se desea volver atras.';
comment on column IT.CX_CTA_EXPORTACIONES.ant_monto
  is 'Monto anterior aprobado, si es rechazado para volver atras';
comment on column IT.CX_CTA_EXPORTACIONES.ant_fec_vencimiento
  is 'Fecha de vencimiento anterior aprobada, si se desea volver atras.';
comment on column IT.CX_CTA_EXPORTACIONES.con_aladi
  is 'Indica si la carta tiene Convenio ALADI.';
comment on column IT.CX_CTA_EXPORTACIONES.mto_utilizado
  is 'Monto utilizado, si tiene utilizaciones parciales, embarques parciales.';
comment on column IT.CX_CTA_EXPORTACIONES.fec_utilizacion
  is 'Fecha en que se utiliza efectivamente la CCE.';
comment on column IT.CX_CTA_EXPORTACIONES.discrepado
  is 'Indica si la carta esta en discrepancia S/N.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_sit_contable
  is 'Indica la Situacion Contable actual de la Operacion. ';
comment on column IT.CX_CTA_EXPORTACIONES.con_aladi_ant
  is 'Indica si la carta tiene Convenio ALADI. Valor anterior.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_bco_corresponsal_ant
  is 'Codigo del corresponsal. Valor anterior.';
comment on column IT.CX_CTA_EXPORTACIONES.ubi_bco_emisor_ant
  is 'Ubicacion del banco emisor. Valor anterior.';
comment on column IT.CX_CTA_EXPORTACIONES.nro_cta_debito
  is 'Numero de Cuenta Debito.';
comment on column IT.CX_CTA_EXPORTACIONES.por_var_monto
  is 'Porcentaje de Variación del monto original.';
comment on column IT.CX_CTA_EXPORTACIONES.mto_original
  is 'Monto Original.';
comment on column IT.CX_CTA_EXPORTACIONES.cod_rub_economico
  is 'Rubro Económico / Destino de la Carta de Exportación. ';
create index IT.BBVA_IN_CX_BA_COD_PER_B on IT.CX_CTA_EXPORTACIONES (COD_PER_BENEFICIARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
