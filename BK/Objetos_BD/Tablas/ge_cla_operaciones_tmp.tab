create index IT.IN_GCOPET_COD_SEC_CREDITO on IT.GE_CLA_OPERACIONES_TMP (COD_SEC_CREDITO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 192K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GCOPET_FECHA on IT.GE_CLA_OPERACIONES_TMP (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CLA_OPERACIONES_TMP
  add constraint PK_GE_CLA_OPERACIONES_TMP primary key (NRO_CUENTA, COD_PERSONA, COD_ESTADO, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 512K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CLA_OPERACIONES_TMP
  add constraint FK_GCOPET_COD_ESTADO foreign key (COD_MODULO, COD_MODALIDAD, COD_ESTADO)
  references IT.GE_EST_CUENTAS (COD_MODULO, COD_MODALIDAD, ESTADO);
alter table IT.GE_CLA_OPERACIONES_TMP
  add constraint FK_GCOPET_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_CLA_OPERACIONES_TMP
  add constraint FK_GCOPET_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CLA_OPERACIONES_TMP
  add constraint FK_GCOPET_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_CLA_OPERACIONES_TMP
  add constraint FK_GCOPET_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA)
  disable
  novalidate;
alter table IT.GE_CLA_OPERACIONES_TMP
  add constraint CK_RANGO_MODULO
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_CLA_OPERACIONES_TMP
  add constraint CK_RANGO_MODALIDAD
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_CLA_OPERACIONES_TMP
  add constraint CK_RANGO_COD_OFICINA
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.GE_CLA_OPERACIONES_TMP
  add constraint CK_RANGO_SEC_CREDITO
  check (COD_SEC_CREDITO BETWEEN 0 AND 999);

