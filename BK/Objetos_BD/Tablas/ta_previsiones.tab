create table IT.TA_PREVISIONES
(
  fecha                DATE not null,
  nro_cuenta           VARCHAR2(15) not null,
  monto                NUMBER(18,2) default 0 not null,
  usu_insercion        VARCHAR2(10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  saldo                NUMBER(18,2) default 0,
  linea                NUMBER(18,2) default 0,
  porcentaje           NUMBER(5,2) default 0,
  situacion            VARCHAR2(1),
  tot_gar_computables  NUMBER(18,2) default 0,
  tot_pri_prevision    NUMBER(18,2) default 0,
  tot_prv_contingencia NUMBER(18,2) default 0,
  mto_pre_anterior     NUMBER(18,2),
  por_pre_anterior     NUMBER(5,2),
  por_calculado        NUMBER(5,2),
  ind_pri_sem_cat6     VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_PREVISIONES
  is 'Historial de previsiones de cuentas.';
comment on column IT.TA_PREVISIONES.fecha
  is 'Fecha de prevision.';
comment on column IT.TA_PREVISIONES.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.TA_PREVISIONES.monto
  is 'Importe de la prevision.';
comment on column IT.TA_PREVISIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_PREVISIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_PREVISIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_PREVISIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.TA_PREVISIONES.saldo
  is 'Saldo adeudado en el momento del calculo.';
comment on column IT.TA_PREVISIONES.linea
  is 'Linea otorgada en el momento del calculo.';
comment on column IT.TA_PREVISIONES.porcentaje
  is 'Porcentaje de riesgo considerado para el calculo.';
comment on column IT.TA_PREVISIONES.situacion
  is 'Situacion contable de la tarjeta segun atraso.';
comment on column IT.TA_PREVISIONES.tot_gar_computables
  is 'Total computado de garantias para el calculo.';
comment on column IT.TA_PREVISIONES.tot_pri_prevision
  is 'Importe de previsión registrado en el rubro de contigencia.';
comment on column IT.TA_PREVISIONES.mto_pre_anterior
  is 'Monto Anterior Previsionado.';
comment on column IT.TA_PREVISIONES.por_pre_anterior
  is 'Porcentaje Previsionado Anteriormente.';
comment on column IT.TA_PREVISIONES.por_calculado
  is 'Porcentaje Calculado.';
comment on column IT.TA_PREVISIONES.ind_pri_sem_cat6
  is 'Indicador que se calculó la previsión por el primer semestre de la previsión.';
create index IT.IN_TPREV_NRO_CUENTA on IT.TA_PREVISIONES (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create unique index IT.IN_TPREV_NRO_CUENTA_02 on IT.TA_PREVISIONES (NRO_CUENTA, MONTO, FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_PREVISIONES
  add constraint PK_TA_PREVISIONES primary key (FECHA, NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_PREVISIONES
  add constraint FK_TPREV_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

