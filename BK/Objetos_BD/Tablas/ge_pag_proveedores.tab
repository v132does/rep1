create index IT.IN_BBVA_GE_PAG_PRO1 on IT.GE_PAG_PROVEEDORES (COD_OFICINA, COD_ENTE, TIP_COMPROBANTE, ESTADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
