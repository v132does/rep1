  );
create index IT.IN_GPRRO_FEC_LOTE on IT.GE_PAG_PROVEEDORES (COD_ENTE, FEC_PAGO, NRO_LOTE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAG_PROVEEDORES
  add constraint PK_GE_PAG_PROVEEDORES unique (NRO_ORDEN, COD_ENTE, ORDEN)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAG_PROVEEDORES
  add constraint FK_GPPRO_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.GE_PAG_PROVEEDORES
  add constraint FK_GPPRO_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_PAG_PROVEEDORES
  add constraint FK_GPPRO_COD_USU_OPERADOR foreign key (COD_USU_OPERADOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_PAG_PROVEEDORES
  add constraint FK_GPPRO_NRO_CTA_CREDITO foreign key (NRO_CTA_CREDITO)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.GE_PAG_PROVEEDORES
  add constraint AVCON_1118189942_ESTAD_000
  check (ESTADO IN ('C', 'N', 'A', 'R'));
alter table IT.GE_PAG_PROVEEDORES
  add constraint AVCON_1118189942_NRO_O_000
  check (NRO_ORDEN BETWEEN 0 AND 999999999999);
alter table IT.GE_PAG_PROVEEDORES
  add constraint CK_GPPRO_TIP_CARGA
  check (TIP_CARGA IN ('A','H','F'));

