create index IT.IN_GPPRO_COD_MONEDA on IT.GE_PAG_PROVEEDORES (COD_MONEDA, COD_USU_OPERADOR, NRO_CTA_CREDITO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
