create table IT.GE_PAG_PROVEEDORES
(
  nro_orden                NUMBER(12) not null,
  cod_ente                 NUMBER(5) not null,
  nro_factura              VARCHAR2(20),
  tip_comprobante          VARCHAR2(1) default 'F' not null,
  for_pago                 VARCHAR2(1) default 'C' not null,
  nro_cheque               NUMBER(15),
  nro_cta_credito          VARCHAR2(15),
  cod_moneda               VARCHAR2(3) not null,
  monto                    NUMBER(18,2) not null,
  fec_ingreso              DATE,
  fec_pago                 DATE,
  nro_recibo               NUMBER(7),
  beneficiario             VARCHAR2(60),
  concepto                 VARCHAR2(40),
  estado                   VARCHAR2(1) default 'C',
  cod_usu_operador         VARCHAR2(10),
  fec_proceso              DATE,
  hora                     VARCHAR2(8),
  fec_insercion            DATE default SYSDATE not null,
  usu_insercion            VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion         DATE default SYSDATE not null,
  usu_modificacion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  tip_carga                VARCHAR2(1) default 'A' not null,
  nro_doc_beneficiario     VARCHAR2(20),
  telefono                 VARCHAR2(10),
  cod_oficina              NUMBER(3),
  fec_deb_comision         DATE,
  ref_facturas             VARCHAR2(1000),
  referencia               VARCHAR2(15),
  mon_tot_recibo           NUMBER(18,2),
  ret_fac_proveedor        NUMBER(18,2),
  des_fac_proveedor        NUMBER(18,2),
  ret_facturas             NUMBER(18,2),
  des_sucursal             VARCHAR2(100),
  nro_cta_debito           VARCHAR2(15),
  nro_asegurado            VARCHAR2(40),
  nro_archivo              NUMBER(6),
  cod_tip_doc_beneficiario NUMBER(3),
  nro_cta_beneficiario     VARCHAR2(35),
  ent_bca_beneficiario     NUMBER(5),
  ind_valor                VARCHAR2(1),
  nro_referencia           NUMBER(15),
  dir_beneficiario         VARCHAR2(100),
  tip_factura              VARCHAR2(1),
  nro_con_cambio           NUMBER(7),
  nro_documento            NUMBER(15),
  nro_pago                 VARCHAR2(30),
  nro_lote                 VARCHAR2(30),
  ben_dir_correo           VARCHAR2(80),
  nro_ord_archivo          NUMBER(6),
  fec_mov_pago             DATE,
  hor_mov_pago             VARCHAR2(8),
  usu_mov_pago             VARCHAR2(10),
  cod_swift                VARCHAR2(20),
  orden                    NUMBER(10),
  nro_timbrado             VARCHAR2(20),
  serie                    VARCHAR2(5),
  tip_venta                VARCHAR2(1),
  observacion              VARCHAR2(4000),
  mto_retencion            NUMBER(18,2),
  fec_vto_factura          DATE,
  mto_total                NUMBER(18,2),
  cod_compra               NUMBER(10),
  nro_retencion            NUMBER(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAG_PROVEEDORES
  is 'Cabecera de pago a proveedores, ordenes de pago.';
comment on column IT.GE_PAG_PROVEEDORES.nro_orden
  is 'Nro Orden.';
comment on column IT.GE_PAG_PROVEEDORES.cod_ente
  is 'Código de Empresa que realiza el pago a proveedores.';
