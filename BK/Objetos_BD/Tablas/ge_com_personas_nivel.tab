
CREATE TABLE GE_COM_PERSONAS_NIVEL
(
   COD_NIVEL         VARCHAR2(20 Byte)   NOT NULL,
   COD_PERSONA       VARCHAR2(20 Byte)   NOT NULL
)
TABLESPACE IT_DATA;

CREATE INDEX IN_COM_PERSONAS_NIVEL_COD_NIVEL
   ON GE_COM_PERSONAS_NIVEL (COD_NIVEL ASC)
   TABLESPACE IT_IND;

CREATE INDEX IN_COM_PERSONAS_NIVEL_NOM_NIVEL
   ON GE_COM_PERSONAS_NIVEL (COD_PERSONA ASC)
   TABLESPACE IT_IND;


GRANT ALTER, INSERT, SELECT, UPDATE, DEBUG, FLASHBACK, DELETE, ON COMMIT REFRESH, QUERY REWRITE, READ ON GE_COM_PERSONAS_NIVEL TO IT_TEMPORAL;
