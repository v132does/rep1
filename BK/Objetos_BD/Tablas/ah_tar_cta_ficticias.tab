create table IT.AH_TAR_CTA_FICTICIAS
(
  nro_cuenta       VARCHAR2(15) not null,
  nro_cta_cliente  VARCHAR2(15) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  nro_bin          VARCHAR2(8) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AH_TAR_CTA_FICTICIAS
  is 'Cuenta Ficticia Utilizada en Bancard.';
comment on column IT.AH_TAR_CTA_FICTICIAS.nro_cuenta
  is 'Numero de Cuenta Ficticia.';
comment on column IT.AH_TAR_CTA_FICTICIAS.nro_cta_cliente
  is 'Nro. de Cuenta Real Cliente';
comment on column IT.AH_TAR_CTA_FICTICIAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.AH_TAR_CTA_FICTICIAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.AH_TAR_CTA_FICTICIAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.AH_TAR_CTA_FICTICIAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.AH_TAR_CTA_FICTICIAS.nro_bin
  is 'Nro de bin de la solicitud';
alter table IT.AH_TAR_CTA_FICTICIAS
  add constraint PK_AH_TAR_CTA_FICTICIAS primary key (NRO_CUENTA, NRO_CTA_CLIENTE, NRO_BIN)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

