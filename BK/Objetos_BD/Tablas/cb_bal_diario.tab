create table IT.CB_BAL_DIARIO
(
  cod_rubro        VARCHAR2(10) not null,
  deb_hoy          NUMBER(18,2) default 0,
  cre_hoy          NUMBER(18,2) default 0,
  sal_mon_local    NUMBER(18,2) default 0,
  sal_mon_me       NUMBER(18,2) default 0,
  sal_total        NUMBER(18,2) default 0,
  fecha            DATE,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  sal_anterior     NUMBER(18,2) default 0,
  sal_equivalente  NUMBER(18,2) default 0
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_BAL_DIARIO
  is 'Contiene los datos del el balance diario.';
comment on column IT.CB_BAL_DIARIO.cod_rubro
  is 'Codigo de la cuenta contable.';
comment on column IT.CB_BAL_DIARIO.deb_hoy
  is 'Debitos de hoy.';
comment on column IT.CB_BAL_DIARIO.cre_hoy
  is 'Creditos de hoy.';
comment on column IT.CB_BAL_DIARIO.sal_mon_local
  is 'Saldo en guaranies.';
comment on column IT.CB_BAL_DIARIO.sal_mon_me
  is 'Saldo en moneda extranjera.';
comment on column IT.CB_BAL_DIARIO.sal_total
  is 'Saldo Total.';
comment on column IT.CB_BAL_DIARIO.fecha
  is 'Fecha de Movimiento.';
comment on column IT.CB_BAL_DIARIO.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_BAL_DIARIO.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_BAL_DIARIO.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_BAL_DIARIO.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CB_BAL_DIARIO.sal_anterior
  is 'Saldo Anterior.';
comment on column IT.CB_BAL_DIARIO.sal_equivalente
  is 'Saldo Equivalente.';

