create table IT.CR_PER_RECLAMOS
(
  nro_reclamo         NUMBER(10) not null,
  cod_persona         VARCHAR2(10) not null,
  cod_reclamo         NUMBER(5) not null,
  sub_tip_reclamo     NUMBER(5),
  fecha               DATE not null,
  cod_usu_responsable VARCHAR2(10) not null,
  detalle             VARCHAR2(2000),
  det_solucion        VARCHAR2(2000),
  fec_solucion        DATE,
  cod_rec_estado      NUMBER(2) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 52992K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_PER_RECLAMOS
  is 'Reclamo o Pedido';
comment on column IT.CR_PER_RECLAMOS.nro_reclamo
  is 'Número de secuencia unico';
comment on column IT.CR_PER_RECLAMOS.cod_persona
  is 'Código de persona';
comment on column IT.CR_PER_RECLAMOS.cod_reclamo
  is 'Tipo de Reclamo o Pedido';
comment on column IT.CR_PER_RECLAMOS.sub_tip_reclamo
  is 'Subtipo de Reclamo';
comment on column IT.CR_PER_RECLAMOS.fecha
  is 'Fecha de reclamo';
comment on column IT.CR_PER_RECLAMOS.cod_usu_responsable
  is 'Responsable';
comment on column IT.CR_PER_RECLAMOS.detalle
  is 'Detalle del Reclamo o Pedido';
comment on column IT.CR_PER_RECLAMOS.det_solucion
  is 'Detalle de la Solución';
comment on column IT.CR_PER_RECLAMOS.fec_solucion
  is 'Fecha de solucion';
comment on column IT.CR_PER_RECLAMOS.cod_rec_estado
  is 'Estado actual del Reclamo';
comment on column IT.CR_PER_RECLAMOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CR_PER_RECLAMOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CR_PER_RECLAMOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CR_PER_RECLAMOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IND_FK_RPREC_COD_ESTADO on IT.CR_PER_RECLAMOS (COD_RECLAMO, COD_REC_ESTADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 6M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IND_FK_RPREC_COD_USUARIO on IT.CR_PER_RECLAMOS (COD_USU_RESPONSABLE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 6M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IND_FK_RPREC_SUB_TIP_RECLAMO on IT.CR_PER_RECLAMOS (COD_RECLAMO, SUB_TIP_RECLAMO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 6M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_RPREC_COD_PERSONA on IT.CR_PER_RECLAMOS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 7M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_PER_RECLAMOS
  add constraint PK_CR_PER_RECLAMOS primary key (NRO_RECLAMO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 4M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_PER_RECLAMOS
  add constraint FK_RPREC_COD_ESTADO foreign key (COD_RECLAMO, COD_REC_ESTADO)
  references IT.CR_REC_ESTADOS (COD_RECLAMO, COD_REC_ESTADO);
alter table IT.CR_PER_RECLAMOS
  add constraint FK_RPREC_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CR_PER_RECLAMOS
  add constraint FK_RPREC_COD_USUARIO foreign key (COD_USU_RESPONSABLE)
  references IT.BA_USUARIOS (COD_USUARIO);

