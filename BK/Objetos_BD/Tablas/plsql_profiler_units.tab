create table IT.PLSQL_PROFILER_UNITS
(
  runid          NUMBER not null,
  unit_number    NUMBER not null,
  unit_type      VARCHAR2(32),
  unit_owner     VARCHAR2(32),
  unit_name      VARCHAR2(32),
  unit_timestamp DATE,
  total_time     NUMBER default 0 not null,
  spare1         NUMBER,
  spare2         NUMBER
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PLSQL_PROFILER_UNITS
  is 'Information about each library unit in a run.';
alter table IT.PLSQL_PROFILER_UNITS
  add primary key (RUNID, UNIT_NUMBER)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PLSQL_PROFILER_UNITS
  add foreign key (RUNID)
  references IT.PLSQL_PROFILER_RUNS (RUNID);

