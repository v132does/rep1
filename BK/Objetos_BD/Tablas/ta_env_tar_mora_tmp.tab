create table IT.TA_ENV_TAR_MORA_TMP
(
  nro_tarjeta     VARCHAR2(19),
  fec_valor       DATE,
  concepto        VARCHAR2(40),
  cod_moneda      VARCHAR2(3),
  mto_mora        NUMBER(18,2),
  tip_cargo       VARCHAR2(3),
  tip_saldo       VARCHAR2(3),
  tip_tran        VARCHAR2(1),
  financia        VARCHAR2(1),
  cod_usuario     VARCHAR2(10),
  iva             VARCHAR2(1),
  impuesto_iva    VARCHAR2(3),
  mov_res1        VARCHAR2(1),
  cod_procesadora VARCHAR2(4),
  cod_persona     VARCHAR2(10),
  nro_cuenta      VARCHAR2(15),
  dia_mora        NUMBER(14,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_ENV_TAR_MORA_TMP
  is 'Tabla temporal donde se encuentran los registros de tarjetas en mora enviados a bancard de una fecha.';
comment on column IT.TA_ENV_TAR_MORA_TMP.nro_tarjeta
  is 'Número de Tarjeta.';
comment on column IT.TA_ENV_TAR_MORA_TMP.fec_valor
  is 'Fecha en que se procesó el archivo';
comment on column IT.TA_ENV_TAR_MORA_TMP.concepto
  is 'Descripcion del registro a enviar para BANCARD';
comment on column IT.TA_ENV_TAR_MORA_TMP.cod_moneda
  is 'Moneda del Monto';
comment on column IT.TA_ENV_TAR_MORA_TMP.mto_mora
  is 'Monto en mora de la tarjeta';
comment on column IT.TA_ENV_TAR_MORA_TMP.tip_cargo
  is 'Tipo de cargo. 32-> Mov. Entidad-Interés, 33-> Mov. Entidad.';
comment on column IT.TA_ENV_TAR_MORA_TMP.tip_saldo
  is 'Tipo de Saldo. 1- A facturar -- 2-> Fact. No Vencido,3-> Financiado,6-> Interés a Facturar, 10-> Al pago mínimo';
comment on column IT.TA_ENV_TAR_MORA_TMP.tip_tran
  is 'Tipo transaccion. D -> Débito, C -> Crédito';
comment on column IT.TA_ENV_TAR_MORA_TMP.financia
  is 'Financiación. S -> Si, N -> No';
comment on column IT.TA_ENV_TAR_MORA_TMP.cod_usuario
  is 'Usuario que ejecuto el proceso de generar el archivo.';
comment on column IT.TA_ENV_TAR_MORA_TMP.iva
  is 'Forma de calcular el IVA. ?-> No Aplica, I-> Importe IVA Incluído, C-> Importe IVA a Calcular';
comment on column IT.TA_ENV_TAR_MORA_TMP.impuesto_iva
  is 'ID impuesto. Blanco -> Sin IVA, 1 -> IVA (10%), 4 -> IVA (5%)';
comment on column IT.TA_ENV_TAR_MORA_TMP.mov_res1
  is 'Tipific.Movim. p/ Resol. 1. N -> Normal, 1 -> Capital, 2 -> Cargo, 3 -> Interés, 4 -> Impuesto, 5 -> Pago';
comment on column IT.TA_ENV_TAR_MORA_TMP.cod_procesadora
  is 'Codigo de la procesadora. Ej: BANCARD, PROCARD, BEPSA, CABAL...etc';
comment on column IT.TA_ENV_TAR_MORA_TMP.cod_persona
  is 'Codigo de la persona al que pertenece la tarjeta';
comment on column IT.TA_ENV_TAR_MORA_TMP.nro_cuenta
  is 'Nro de la cuenta a la que pertenece la tarjeta';
comment on column IT.TA_ENV_TAR_MORA_TMP.dia_mora
  is 'Cantidad de dias en que se encuentra en mora la tarjeta';

