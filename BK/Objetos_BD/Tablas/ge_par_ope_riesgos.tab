create table IT.GE_PAR_OPE_RIESGOS
(
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  cod_transaccion  NUMBER(4) not null,
  cod_oficina      NUMBER(3),
  cod_moneda       VARCHAR2(3),
  cod_grupo        NUMBER,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAR_OPE_RIESGOS
  is 'Parametrización de Transacciones por Grupos de Montos.';
comment on column IT.GE_PAR_OPE_RIESGOS.cod_modulo
  is 'Código de Módulo.';
comment on column IT.GE_PAR_OPE_RIESGOS.cod_modalidad
  is 'Código de Modalidad.';
comment on column IT.GE_PAR_OPE_RIESGOS.cod_transaccion
  is 'Código de Transacción.';
comment on column IT.GE_PAR_OPE_RIESGOS.cod_oficina
  is 'Código de Oficina.';
comment on column IT.GE_PAR_OPE_RIESGOS.cod_moneda
  is 'Moneda de la Operación.';
comment on column IT.GE_PAR_OPE_RIESGOS.cod_grupo
  is 'Código de Grupo.';
alter table IT.GE_PAR_OPE_RIESGOS
  add constraint PK_GE_PAR_OPE_RIESGOS primary key (COD_MODULO, COD_MODALIDAD, COD_TRANSACCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

