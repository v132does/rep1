create table IT.TA_ERR_TAR_RECIBIDAS
(
  nro_cuenta          VARCHAR2(15) not null,
  nro_tarjeta         VARCHAR2(25) not null,
  cod_persona         VARCHAR2(10),
  cod_estado          NUMBER(2),
  fec_vencimiento     DATE,
  cod_causa           NUMBER(3),
  nom_embozar         VARCHAR2(50),
  nom_enviar          VARCHAR2(26),
  vigente             VARCHAR2(1) default 'N',
  fec_emision         DATE,
  fec_solicitud       DATE,
  tip_envio           VARCHAR2(1) default 'D',
  referencia          VARCHAR2(35),
  nro_planilla        NUMBER(8),
  tip_planilla        NUMBER(2),
  nro_pla_anterior    NUMBER(8),
  fec_entrega         DATE,
  dig_verificador     NUMBER(1),
  relacion            NUMBER(1),
  cod_situacion       NUMBER(1),
  nro_documento       VARCHAR2(20),
  dur_meses           NUMBER(3),
  mes_vencimiento     VARCHAR2(5),
  mar_boletinada      VARCHAR2(1) default 'N',
  mar_recuperada      VARCHAR2(1) default 'N',
  mar_vencida         VARCHAR2(1) default 'N',
  tip_bloqueo         VARCHAR2(1),
  renovar             VARCHAR2(1) default 'N',
  fec_nacimiento      DATE,
  cod_est_civil       VARCHAR2(1),
  cod_sexo            VARCHAR2(1),
  cod_modalidad       NUMBER(3),
  nro_reg             NUMBER(10),
  cod_ent_procesadora NUMBER(5),
  cod_oficina         NUMBER(3),
  cod_afinidad        VARCHAR2(2),
  det_error           VARCHAR2(4000),
  fec_proceso         DATE default SYSDATE not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_ERR_TAR_RECIBIDAS
  is 'Es la tabla Temporal de relación Cuenta-Tarjeta.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.nro_cuenta
  is 'Número de la Cuenta.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.nro_tarjeta
  is 'Número de Tarjeta.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.cod_persona
  is 'Código de Cliente.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.cod_estado
  is 'Estado de la Tarjeta ( 6=activa ).';
comment on column IT.TA_ERR_TAR_RECIBIDAS.fec_vencimiento
  is 'Fecha de vencimiento de la Tarjeta.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.cod_causa
  is 'Código de Motivo de Cancelacion.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.nom_embozar
  is 'Nombre a Embozar.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.nom_enviar
  is 'Nombre a enviar a la Administradora.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.vigente
  is 'Indicador si esta vigente o no ( S=si, N=no ).';
comment on column IT.TA_ERR_TAR_RECIBIDAS.fec_emision
  is 'Fecha de Emision.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.fec_solicitud
  is 'Fecha de Solicitud.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.tip_envio
  is 'Tipo de Envio.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.referencia
  is 'En base al tipo de envio esta columna tendra la dirección o sucursal de retención de los documentos.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.nro_planilla
  is 'Número de Planilla.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.tip_planilla
  is 'Tipo de Planilla.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.nro_pla_anterior
  is 'Número de Planilla anterior.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.fec_entrega
  is 'Fecha en que se entregó la tarjeta.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.dig_verificador
  is 'Digito verificador de la cuenta.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.relacion
  is 'Relación de la Persona con la Cuenta (0= Principal; 1=Adicional).';
comment on column IT.TA_ERR_TAR_RECIBIDAS.cod_situacion
  is 'Situación de la Tarjeta en la Procesadora (1= Activa; 3= Inactiva).';
comment on column IT.TA_ERR_TAR_RECIBIDAS.nro_documento
  is 'Número de documento de identidad.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.dur_meses
  is 'Duración en meses del plastico.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.mes_vencimiento
  is 'Mes de vencimiento del Plastico en formato MM/YYYY.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.mar_boletinada
  is 'Marca de Tarjeta Boletinada (Bloqueada).';
comment on column IT.TA_ERR_TAR_RECIBIDAS.mar_recuperada
  is 'Marca de Tarjeta Recuperada.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.mar_vencida
  is 'Indica que el plastico se encuentra vencido.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.tip_bloqueo
  is 'Tipo de Bloqueo de la Tarjeta (U= Usuario; A= Administrativo).';
comment on column IT.TA_ERR_TAR_RECIBIDAS.renovar
  is 'Indica que la cuenta tiene orden de Renovación.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.fec_nacimiento
  is 'Fecha de nacimiento de la persona.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.cod_est_civil
  is 'Código de estado civil de la persona.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.cod_sexo
  is 'Sexo de la persona.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.cod_modalidad
  is 'Código de Modalidad de la cuenta.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.nro_reg
  is 'Número de registro de posición en el archivo.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.cod_ent_procesadora
  is 'Código de Ente de la Procesadora.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.cod_oficina
  is 'Oficina.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.det_error
  is 'Comentario del Error ocurrido en el momento de la Lectura del Archivo.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.fec_proceso
  is 'Fecha de proceso.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.usu_insercion
  is 'Usuario que realizo la inserción del registro.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.usu_modificacion
  is 'Usuario que realizo la ultima modificación en el registro.';
comment on column IT.TA_ERR_TAR_RECIBIDAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificación en el registro.';
alter table IT.TA_ERR_TAR_RECIBIDAS
  add constraint PK_TA_ERR_TAR_RECIBIDAS primary key (NRO_CUENTA, NRO_TARJETA, FEC_PROCESO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

