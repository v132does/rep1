create table IT.PR_GRU_LIN_APLICACIONES
(
  nro_linea          NUMBER(7) not null,
  cod_gru_economico  NUMBER(5) not null,
  cod_persona        VARCHAR2(10) not null,
  cod_moneda         VARCHAR2(3) not null,
  mto_aplicado       NUMBER(18,2) default 0 not null,
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  nro_lin_individual NUMBER(7),
  estado             VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_GRU_LIN_APLICACIONES
  is 'Tabla de aplicación de Límites Globales.';
comment on column IT.PR_GRU_LIN_APLICACIONES.nro_linea
  is 'Número de Línea.';
comment on column IT.PR_GRU_LIN_APLICACIONES.cod_gru_economico
  is 'Grupo Económico.';
comment on column IT.PR_GRU_LIN_APLICACIONES.cod_persona
  is 'Código de Persona.';
comment on column IT.PR_GRU_LIN_APLICACIONES.cod_moneda
  is 'Moneda de la Propuesta aplicada.';
comment on column IT.PR_GRU_LIN_APLICACIONES.mto_aplicado
  is 'Monto aplicado.';
comment on column IT.PR_GRU_LIN_APLICACIONES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_GRU_LIN_APLICACIONES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_GRU_LIN_APLICACIONES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_GRU_LIN_APLICACIONES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_GRU_LIN_APLICACIONES.nro_lin_individual
  is 'Número de Línea Individual';
comment on column IT.PR_GRU_LIN_APLICACIONES.estado
  is 'Estado de la aplicación.';
create index IT.IN_PGLAPL_COD_GRU_ECONOMICO on IT.PR_GRU_LIN_APLICACIONES (COD_GRU_ECONOMICO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_GRU_LIN_APLICACIONES
  add constraint PK_PR_GRU_LIN_APLICACIONES primary key (NRO_LINEA, COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 192K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_GRU_LIN_APLICACIONES
  add constraint FK_PGLAPL_COD_GRU_ECONOMICO foreign key (COD_GRU_ECONOMICO)
  references IT.GE_GRU_ECONOMICOS (COD_GRU_ECONOMICO);
alter table IT.PR_GRU_LIN_APLICACIONES
  add constraint FK_PGLAPL_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_GRU_LIN_APLICACIONES
  add constraint FK_PGLAPL_NRO_LINEA foreign key (NRO_LINEA)
  references IT.PR_GRU_LINEAS (NRO_LINEA);

