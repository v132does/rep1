-- Create table
create table IT.GE_EXONERACIONES_TMP
(
  nro_pedido       NUMBER(10) not null,
  cod_transaccion  NUMBER(4) not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  cod_moneda       VARCHAR2(3) not null,
  cod_persona      VARCHAR2(10),
  nro_cuenta       VARCHAR2(15),
  estado           VARCHAR2(1) not null,
  cod_tasa         NUMBER(3),
  mto_exoneracion  NUMBER(18,2) default 0,
  mto_a_cobrar     NUMBER(18,2) default 0,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  nro_sol_prestamo NUMBER(7)
)
tablespace IT_DATA
  pctfree 10
  initrans 10
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the columns 
comment on column IT.GE_EXONERACIONES_TMP.nro_pedido
  is 'Número de Pedido de Autorización.';
comment on column IT.GE_EXONERACIONES_TMP.cod_transaccion
  is 'Transacción utilizada para el cobro del cargo.';
comment on column IT.GE_EXONERACIONES_TMP.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_EXONERACIONES_TMP.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_EXONERACIONES_TMP.cod_moneda
  is 'Moneda';
comment on column IT.GE_EXONERACIONES_TMP.cod_persona
  is 'Nro. de Cliente.';
comment on column IT.GE_EXONERACIONES_TMP.nro_cuenta
  is 'Cuenta del Cliente.';
comment on column IT.GE_EXONERACIONES_TMP.estado
  is 'Estado de la exoneracion.';
comment on column IT.GE_EXONERACIONES_TMP.cod_tasa
  is 'Código de la Tasa.';
comment on column IT.GE_EXONERACIONES_TMP.mto_exoneracion
  is 'Importe de la Exoneración.';
comment on column IT.GE_EXONERACIONES_TMP.mto_a_cobrar
  is 'Importe a cobrar s/Tarifario.';
comment on column IT.GE_EXONERACIONES_TMP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_EXONERACIONES_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_EXONERACIONES_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_EXONERACIONES_TMP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_EXONERACIONES_TMP.nro_sol_prestamo
  is 'Numero de Solicitud de Prestamo';
-- Create/Recreate indexes 
create index IT.IN_GEXOT_COD_MONEDA on IT.GE_EXONERACIONES_TMP (COD_MONEDA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GEXOT_COD_TASA on IT.GE_EXONERACIONES_TMP (COD_TASA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GEXOT_COD_TRANSACCION on IT.GE_EXONERACIONES_TMP (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GEXOT_NRO_CUENTA on IT.GE_EXONERACIONES_TMP (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.GE_EXONERACIONES_TMP
  add constraint FK_GEXOT_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_EXONERACIONES_TMP
  add constraint FK_GEXOT_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.GE_EXONERACIONES_TMP
  add constraint FK_GEXOT_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_EXONERACIONES_TMP
  add constraint FK_GEXOT_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
