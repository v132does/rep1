create table IT.CO_TRM_GRUPOS
(
  cod_tramo        NUMBER(3) not null,
  tip_gestor       VARCHAR2(1) not null,
  gru_agenda       VARCHAR2(5),
  max_asignaciones NUMBER(10) default 1000 not null,
  por_comision     NUMBER(18,4),
  por_impuesto     NUMBER(18,4),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CO_TRM_GRUPOS
  is 'Grupo de Tramos para Asignaciones de Morosos a los distintos Tipos de Gestores.';
comment on column IT.CO_TRM_GRUPOS.cod_tramo
  is 'Código de Tramo para Gestión de Cobranzas.';
comment on column IT.CO_TRM_GRUPOS.tip_gestor
  is 'Tipo de Gestor  (A=Abogado; O=Oficial; G=Gestor, E=Cobrador externo).';
comment on column IT.CO_TRM_GRUPOS.gru_agenda
  is 'Grupo de Agenda al cual debe asignar.';
comment on column IT.CO_TRM_GRUPOS.max_asignaciones
  is 'Cantidad Máxima de Asignaciones que se manejan para el Tramo.';
comment on column IT.CO_TRM_GRUPOS.por_comision
  is 'Porcentaje de la Comisión que se le pagará al Gestor.';
comment on column IT.CO_TRM_GRUPOS.por_impuesto
  is 'Porcentaje del Impuesto que se le cobra por la comisión.';
comment on column IT.CO_TRM_GRUPOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CO_TRM_GRUPOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CO_TRM_GRUPOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CO_TRM_GRUPOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.CO_TRM_GRUPOS
  add constraint PK_CO_TRM_GRUPOS primary key (COD_TRAMO, TIP_GESTOR)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CO_TRM_GRUPOS
  add constraint UK_OTGRU_COD_TRAMO unique (COD_TRAMO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CO_TRM_GRUPOS
  add constraint FK_OTGRU_COD_TRAMO foreign key (COD_TRAMO)
  references IT.CO_TRM_ASIGNACIONES (COD_TRAMO);
alter table IT.CO_TRM_GRUPOS
  add constraint CK_OTGRU_TIP_GESTOR
  check (TIP_GESTOR IN( 'A','M', 'O', 'E' , 'G', 'I'));

