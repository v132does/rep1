create table IT.GE_LOG_GEN_LIN_SOB
(
  fecha            DATE,
  nro_cuenta       VARCHAR2(15),
  cod_persona      VARCHAR2(10),
  observacion      VARCHAR2(4000),
  det_error        VARCHAR2(4000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_LOG_GEN_LIN_SOB
  is 'Log de errores en la generación de líneas de sobregiro PYMES.';
comment on column IT.GE_LOG_GEN_LIN_SOB.fecha
  is 'Fecha.';
comment on column IT.GE_LOG_GEN_LIN_SOB.nro_cuenta
  is 'Nro. Cuenta.';
comment on column IT.GE_LOG_GEN_LIN_SOB.cod_persona
  is 'Cod. Persona.';
comment on column IT.GE_LOG_GEN_LIN_SOB.observacion
  is 'Observacion.';
comment on column IT.GE_LOG_GEN_LIN_SOB.det_error
  is 'Detalle error.';
comment on column IT.GE_LOG_GEN_LIN_SOB.usu_insercion
  is 'Usuario de Inserción.';
comment on column IT.GE_LOG_GEN_LIN_SOB.fec_insercion
  is 'Fecha de Inserción.';
comment on column IT.GE_LOG_GEN_LIN_SOB.usu_modificacion
  is 'Usuario de Modificacion.';
comment on column IT.GE_LOG_GEN_LIN_SOB.fec_modificacion
  is 'Fecha de Modificacion.';
create index IT.ID_GMLLS_FECHA on IT.GE_LOG_GEN_LIN_SOB (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.ID_GMLLS_NRO_CUENTA on IT.GE_LOG_GEN_LIN_SOB (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

