create table IT.BA_MONEDAS
(
  cod_moneda          VARCHAR2(3) not null,
  descripcion         VARCHAR2(35) not null,
  cod_pais            NUMBER(3) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  cod_mon_bco_central NUMBER(4),
  cod_numerico        NUMBER(2),
  cod_mon_iso         VARCHAR2(3),
  cod_mon_entidad     NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_MONEDAS
  is 'Monedas.';
comment on column IT.BA_MONEDAS.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.BA_MONEDAS.descripcion
  is 'Nombre de la moneda.';
comment on column IT.BA_MONEDAS.cod_pais
  is 'Codigo de pais.';
comment on column IT.BA_MONEDAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_MONEDAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_MONEDAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_MONEDAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.BA_MONEDAS.cod_mon_bco_central
  is 'Codigo de moneda del BCP.';
comment on column IT.BA_MONEDAS.cod_numerico
  is 'Codigo equivalente numerico.';
comment on column IT.BA_MONEDAS.cod_mon_iso
  is 'Código Moneda equivalente ISO.';
comment on column IT.BA_MONEDAS.cod_mon_entidad
  is 'Código Moneda equivalente Entidad.';
create index IT.IN_EMONE_COD_NUMERICO on IT.BA_MONEDAS (COD_NUMERICO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_EMONE_COD_PAIS on IT.BA_MONEDAS (COD_PAIS)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_MONEDAS
  add constraint PK_BA_MONEDAS primary key (COD_MONEDA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_MONEDAS
  add constraint FK_EMONE_COD_PAIS foreign key (COD_PAIS)
  references IT.BA_PAISES (COD_PAIS);
alter table IT.BA_MONEDAS
  add constraint AVCON_1082384226_COD_P_000
  check (COD_PAIS BETWEEN 0 AND 999);

