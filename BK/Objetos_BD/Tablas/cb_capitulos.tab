create table IT.CB_CAPITULOS
(
  cod_sector       VARCHAR2(1) not null,
  cod_capitulo     VARCHAR2(1) not null,
  descripcion      VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_CAPITULOS
  is 'Capitulos del Plan de Cuentas BCP.';
comment on column IT.CB_CAPITULOS.cod_sector
  is 'Codigo de Sector.';
comment on column IT.CB_CAPITULOS.cod_capitulo
  is 'Codigo del Capitulo.';
comment on column IT.CB_CAPITULOS.descripcion
  is 'Descripcion.';
comment on column IT.CB_CAPITULOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_CAPITULOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_CAPITULOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_CAPITULOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CB_CAPITULOS
  add constraint PK_CB_CAPITULOS primary key (COD_SECTOR, COD_CAPITULO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

