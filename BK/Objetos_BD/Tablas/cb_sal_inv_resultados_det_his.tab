create table IT.CB_SAL_INV_RESULTADOS_DET_HIS
(
  fecha                      DATE not null,
  cod_rubro                  VARCHAR2(15) not null,
  nro_cuenta                 VARCHAR2(15) not null,
  val_cotizacion             NUMBER(14,8),
  sal_mon_extranjera         NUMBER(18,2),
  sal_mon_local              NUMBER(18,4),
  sal_acu_act_mon_extranjera NUMBER(18,2),
  sal_acu_act_mon_local      NUMBER(18,4),
  usu_insercion              VARCHAR2(10) default substr(user,1,10),
  fec_insercion              DATE default sysdate,
  usu_modificacion           VARCHAR2(10) default substr(user,1,10),
  fec_modificacion           DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SAL_INV_RESULTADOS_DET_HIS
  is 'Detalle de saldos historicos para inventario de cuentas de resultado.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.fecha
  is 'Fecha de monto inventariado';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.cod_rubro
  is 'Rubro del inventario.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.nro_cuenta
  is 'Nro. de cuenta.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.val_cotizacion
  is 'Cotizaci¿n del d¿a.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.sal_mon_extranjera
  is 'Saldo inventariado en moneda extranjera.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.sal_mon_local
  is 'saldo inventariado en moneda local.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.sal_acu_act_mon_extranjera
  is 'Saldo acumulado actual en moneda extranjera.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.sal_acu_act_mon_local
  is 'Saldo acumulado actual en moneda local.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.usu_insercion
  is 'Usuario de inserci¿n.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.fec_insercion
  is 'Fecha de inserci¿n.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.usu_modificacion
  is 'Usuario que realizo la modificaci¿n.';
comment on column IT.CB_SAL_INV_RESULTADOS_DET_HIS.fec_modificacion
  is 'Fecha de modificaci¿n.';
alter table IT.CB_SAL_INV_RESULTADOS_DET_HIS
  add constraint PK_CB_SAL_INV_RES_DET_HIS primary key (FECHA, COD_RUBRO, NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 58M
    next 1M
    minextents 1
    maxextents unlimited
  );

