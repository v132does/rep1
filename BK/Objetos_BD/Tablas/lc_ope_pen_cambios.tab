comment on column IT.LC_OPE_PEN_CAMBIOS.nro_cta_bancaria
  is 'Cuenta corriente corresponsal.';
comment on column IT.LC_OPE_PEN_CAMBIOS.nro_cheque
  is 'Numero de cheque.';
comment on column IT.LC_OPE_PEN_CAMBIOS.nro_boleta
  is 'Numero deposito.';
comment on column IT.LC_OPE_PEN_CAMBIOS.concepto
  is 'Concepto.';
comment on column IT.LC_OPE_PEN_CAMBIOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.LC_OPE_PEN_CAMBIOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.LC_OPE_PEN_CAMBIOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.LC_OPE_PEN_CAMBIOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.LC_OPE_PEN_CAMBIOS.observacion
  is 'Observacion sobre la operacion.';
comment on column IT.LC_OPE_PEN_CAMBIOS.nro_documento
