  is 'Monto de la operacion.';
comment on column IT.LC_OPE_PEN_CAMBIOS.cotizacion
  is 'Cotizacion de la operacion.';
comment on column IT.LC_OPE_PEN_CAMBIOS.mto_equ_local
  is 'Monto equivalente en moneda local.';
comment on column IT.LC_OPE_PEN_CAMBIOS.cta_referencia
  is 'Cuenta Debito/Credito a la que hace referencia la operacion.';
comment on column IT.LC_OPE_PEN_CAMBIOS.cod_tra_cargo1
  is 'Codigo de cargo.';
comment on column IT.LC_OPE_PEN_CAMBIOS.mto_cargo1
  is 'Monto del cargo.';
comment on column IT.LC_OPE_PEN_CAMBIOS.cod_tra_cargo2
  is 'Codigo de cargo.';
comment on column IT.LC_OPE_PEN_CAMBIOS.mto_cargo2
  is 'Monto del cargo.';
comment on column IT.LC_OPE_PEN_CAMBIOS.cod_tra_cargo3
  is 'Codigo de cargo.';
comment on column IT.LC_OPE_PEN_CAMBIOS.mto_cargo3
  is 'Monto del cargo.';
comment on column IT.LC_OPE_PEN_CAMBIOS.cod_tra_cargo4
  is 'Codigo de cargo.';
comment on column IT.LC_OPE_PEN_CAMBIOS.mto_cargo4
