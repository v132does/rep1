create index IT.IN_LOPE2_COD_TIP_OPERACION on IT.LC_OPE_PEN_CAMBIOS (COD_TIP_OPERACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_LOPE2_CTA_REF_CONTRA3 on IT.LC_OPE_PEN_CAMBIOS (CTA_REF_CONTRA3, LIQUIDADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_OPE_PEN_CAMBIOS
  add constraint PK_LC_OPE_PEN_CAMBIO2 primary key (NRO_OPERACION, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_OPE_PEN_CAMBIOS
  add constraint FK_LOPE2_COD_TIP_OPE_BCP foreign key (COD_TIP_OPE_BCP)
  references IT.LC_TIP_OPE_BCP (COD_TIP_OPE_BCP);
alter table IT.LC_OPE_PEN_CAMBIOS
  add constraint FK_LOPE2_COD_TIP_OPERACION foreign key (COD_TIP_OPERACION)
  references IT.LC_TIP_OPERACIONES (COD_TIP_OPERACION);
alter table IT.LC_OPE_PEN_CAMBIOS
  add constraint FK_LOPE2_COD_TIP_REFERENCIA foreign key (COD_TIP_REFERENCIA)
  references IT.LC_TIP_REFERENCIAS (COD_TIP_REFERENCIA);
alter table IT.LC_OPE_PEN_CAMBIOS
  add constraint FK_LOPE2_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.LC_CTA_CAMBIOS (NRO_CUENTA);
alter table IT.LC_OPE_PEN_CAMBIOS
  add constraint AVCO2_1123594858_REFER_000
  check (REFERENCIADO IN ('S', 'N'));

