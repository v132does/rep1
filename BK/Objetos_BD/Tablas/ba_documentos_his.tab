create table IT.BA_DOCUMENTOS_HIS
(
  nro_secuencia NUMBER(20),
  tabla         VARCHAR2(40) not null,
  clave         VARCHAR2(100) not null,
  nom_archivo   VARCHAR2(200) not null,
  tip_archivo   VARCHAR2(100),
  contenido     BLOB default EMPTY_BLOB(),
  comentario    VARCHAR2(100)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_DOCUMENTOS_HIS
  is 'Documentos anexos a cualquier tabla';
comment on column IT.BA_DOCUMENTOS_HIS.nro_secuencia
  is 'Código unico identificador del registro';
comment on column IT.BA_DOCUMENTOS_HIS.tabla
  is 'Nombre de la tabla asociada';
comment on column IT.BA_DOCUMENTOS_HIS.clave
  is 'Clave primaria de la tabla que identifica al registro. Si es compuesto, los campos van separados por #';
comment on column IT.BA_DOCUMENTOS_HIS.nom_archivo
  is 'Nombre del archivo guardado';
comment on column IT.BA_DOCUMENTOS_HIS.tip_archivo
  is 'Tipo de Archivo: DOC, TXT, XLS, ZIP, ARC';
comment on column IT.BA_DOCUMENTOS_HIS.contenido
  is 'Documento que contiene el archivo';
comment on column IT.BA_DOCUMENTOS_HIS.comentario
  is 'Comentario del archivo anexo';
alter table IT.BA_DOCUMENTOS_HIS
  add constraint PK_BA_DOCUMENTOS_HIS primary key (TABLA, CLAVE, NOM_ARCHIVO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

