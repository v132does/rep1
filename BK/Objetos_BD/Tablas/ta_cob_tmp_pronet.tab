create table IT.TA_COB_TMP_PRONET
(
  datos VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_COB_TMP_PRONET.datos
  is 'Datos del archivo de cobros ProNet - bbva$.txt';

