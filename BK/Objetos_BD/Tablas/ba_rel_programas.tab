create table IT.BA_REL_PROGRAMAS
(
  cod_programa        VARCHAR2(30) not null,
  cod_pro_relacionado VARCHAR2(30) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_REL_PROGRAMAS
  is 'Relacion de Programas.';
comment on column IT.BA_REL_PROGRAMAS.cod_programa
  is 'Codigo del Programa.';
comment on column IT.BA_REL_PROGRAMAS.cod_pro_relacionado
  is 'Codigo del Programa.';
comment on column IT.BA_REL_PROGRAMAS.usu_insercion
  is 'Usuario que inserta.';
comment on column IT.BA_REL_PROGRAMAS.fec_insercion
  is 'Fecha de Insercion.';
comment on column IT.BA_REL_PROGRAMAS.usu_modificacion
  is 'Usuario que modifica.';
comment on column IT.BA_REL_PROGRAMAS.fec_modificacion
  is 'Fecha de Modificaci{on.';
create index IT.IN_ERPRR_COD_PRO_RELACIONADO on IT.BA_REL_PROGRAMAS (COD_PRO_RELACIONADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_REL_PROGRAMAS
  add constraint PK_BA_REL_PROGRAMAS primary key (COD_PROGRAMA, COD_PRO_RELACIONADO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_REL_PROGRAMAS
  add constraint FK_ERPRR_COD_PROGRAMA foreign key (COD_PROGRAMA)
  references IT.BA_PROGRAMAS (COD_PROGRAMA);
alter table IT.BA_REL_PROGRAMAS
  add constraint FK_ERPRR_COD_PRO_RELACIONADO foreign key (COD_PRO_RELACIONADO)
  references IT.BA_PROGRAMAS (COD_PROGRAMA);

