create table IT.MD_INDEXES
(
  id                NUMBER not null,
  index_type        VARCHAR2(4000),
  table_id_fk       NUMBER not null,
  index_name        VARCHAR2(4000),
  native_sql        CLOB,
  native_key        VARCHAR2(4000),
  comments          VARCHAR2(4000),
  security_group_id NUMBER default 0 not null,
  created_on        DATE default sysdate not null,
  created_by        VARCHAR2(255),
  last_updated_on   DATE,
  last_updated_by   VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MD_INDEXES
  is 'This table is used to store information about the indexes in a schema';
comment on column IT.MD_INDEXES.id
  is 'Primary Key';
comment on column IT.MD_INDEXES.index_type
  is 'Type of the index e.g. PRIMARY';
comment on column IT.MD_INDEXES.table_id_fk
  is 'Table that this index is on //PARENTFIELD';
comment on column IT.MD_INDEXES.index_name
  is 'Name of the index //OBJECTNAME';
comment on column IT.MD_INDEXES.native_sql
  is 'SQL used to create the index at source';
comment on column IT.MD_INDEXES.native_key
  is 'A unique identifier for this object at the source';
alter table IT.MD_INDEXES
  add constraint MD_INDEXES_PK primary key (ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.MD_INDEXES
  add constraint MD_INDEXES_MD_TABLES_FK1 foreign key (TABLE_ID_FK)
  references IT.MD_TABLES (ID) on delete cascade;

