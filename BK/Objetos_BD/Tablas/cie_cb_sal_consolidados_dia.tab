create table IT.CIE_CB_SAL_CONSOLIDADOS_DIA
(
  cod_rubro             VARCHAR2(15) not null,
  fecha                 DATE not null,
  sal_mon_loc_ant       NUMBER(18,2),
  deb_mon_local         NUMBER(18,2),
  cre_mon_local         NUMBER(18,2),
  sal_ini_mes_mon_local NUMBER(18,2),
  sal_mon_rub_ant       NUMBER(18,2),
  deb_mon_rubro         NUMBER(18,2),
  cre_mon_rubro         NUMBER(18,2),
  sal_ini_mes_mon_rubro NUMBER(18,2),
  protegido             VARCHAR2(1) default 'N' not null,
  usu_insercion         VARCHAR2(10) default substr(user,1,10) not null,
  fec_insercion         DATE default sysdate not null,
  usu_modificacion      VARCHAR2(10) default substr(user,1,10) not null,
  fec_modificacion      DATE default sysdate not null,
  sal_equ_loc_ant       NUMBER(18,2),
  deb_equ_local         NUMBER(18,2),
  cre_equ_local         NUMBER(18,2),
  sal_ini_mes_equ_local NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

