create table IT.GE_MODALIDADES_CRM
(
  cod_modulo          NUMBER(3) not null,
  cod_modalidad       NUMBER(3) not null,
  descripcion         VARCHAR2(35),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    TIMESTAMP(6) default current_timestamp not null,
  cod_gru_cruzamiento NUMBER(3),
  sigla               VARCHAR2(4),
  cod_pro_contable    NUMBER(3),
  tipo                VARCHAR2(1),
  tip_accion          VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_MODALIDADES_CRM
  is 'Modalidades.';
comment on column IT.GE_MODALIDADES_CRM.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_MODALIDADES_CRM.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_MODALIDADES_CRM.descripcion
  is 'Descripcion de la modalidad.';
comment on column IT.GE_MODALIDADES_CRM.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_MODALIDADES_CRM.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_MODALIDADES_CRM.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_MODALIDADES_CRM.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_MODALIDADES_CRM.cod_gru_cruzamiento
  is 'Codigo de Grupo de Cruzamiento.';
comment on column IT.GE_MODALIDADES_CRM.sigla
  is 'Sigla de la modalidad.';
comment on column IT.GE_MODALIDADES_CRM.cod_pro_contable
  is 'Codigo Contable del Producto.';
comment on column IT.GE_MODALIDADES_CRM.tipo
  is 'Tipo.';
comment on column IT.GE_MODALIDADES_CRM.tip_accion
  is 'Indica el tipo de accion realizado con el registro en el Core.-';
alter table IT.GE_MODALIDADES_CRM
  add constraint PK_GE_MODALIDADES_CRM primary key (FEC_MODIFICACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

