-- Create table
create table IT.PR_SOL_GARANTIAS
(
  nro_solicitud    NUMBER(7) not null,
  nro_garantia     NUMBER(10),
  cod_garantia     NUMBER(3) not null,
  mto_aplicado     NUMBER(18,2) default 0 not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  porcentaje       NUMBER(7,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.PR_SOL_GARANTIAS
  is 'Contiene los datos de las garantias por solicitud.';
-- Add comments to the columns 
comment on column IT.PR_SOL_GARANTIAS.nro_solicitud
  is 'Número de propuesta.';
comment on column IT.PR_SOL_GARANTIAS.nro_garantia
  is 'Número de la garantía asociada o Número de cliente(codeudor).';
comment on column IT.PR_SOL_GARANTIAS.cod_garantia
  is 'Tipo de Garantía.';
comment on column IT.PR_SOL_GARANTIAS.mto_aplicado
  is 'Monto de garantía que cubre a la operación.';
comment on column IT.PR_SOL_GARANTIAS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_SOL_GARANTIAS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_SOL_GARANTIAS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_SOL_GARANTIAS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_SOL_GARANTIAS.porcentaje
  is 'Porcentaje de participación en seguro de vida.';
-- Create/Recreate indexes 
create index IT.IN_FK_PSGAR_COD_GARANTIA on IT.PR_SOL_GARANTIAS (COD_GARANTIA)
  tablespace IT_IND
  pctfree 10
  initrans 10
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_FK_PSGAR_NRO_SOLICITUD on IT.PR_SOL_GARANTIAS (NRO_SOLICITUD)
  tablespace IT_IND
  pctfree 10
  initrans 10
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_PSGAR_NRO_GARANTIA on IT.PR_SOL_GARANTIAS (NRO_GARANTIA, COD_GARANTIA)
  tablespace IT_IND
  pctfree 40
  initrans 4
  maxtrans 255
  storage
  (
    initial 512K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.PR_SOL_GARANTIAS
  add constraint UK_PR_SOL_GARANTIAS unique (NRO_SOLICITUD, NRO_GARANTIA, COD_GARANTIA)
  using index
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_SOL_GARANTIAS
  add constraint FK_PSGAR_COD_GARANTIA foreign key (COD_GARANTIA)
  references PR_GAR_TIPOS (COD_GARANTIA);
alter table PR_SOL_GARANTIAS
  add constraint FK_PSGAR_NRO_SOLICITUD foreign key (NRO_SOLICITUD)
  references PR_SOLICITUDES (NRO_SOLICITUD);
-- Create/Recreate check constraints 
alter table IT.PR_SOL_GARANTIAS
  add constraint AVCON_1085068328_COD_G_001
  check (COD_GARANTIA BETWEEN 0 AND 999);
-- Grant/Revoke object privileges 
grant select on PR_SOL_GARANTIAS to IT_CONSULTAS;
grant select on PR_SOL_GARANTIAS to IT_DYD;
grant select, insert, update, delete on PR_SOL_GARANTIAS to IT_TEMPORAL;
grant select, insert, update, delete, references on PR_SOL_GARANTIAS to MI;
