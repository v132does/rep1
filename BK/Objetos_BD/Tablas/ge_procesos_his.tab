create table IT.GE_PROCESOS_HIS
(
  fecha            DATE default SYSDATE not null,
  cod_proceso      NUMBER(3) not null,
  descripcion      VARCHAR2(35),
  nro_orden        NUMBER(3) not null,
  obligatorio      VARCHAR2(1) default 'N',
  tipo             VARCHAR2(1) default 'I',
  hor_inicio       VARCHAR2(8),
  hor_fin          VARCHAR2(8),
  cod_usuario      VARCHAR2(10),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  error            VARCHAR2(1000),
  permiso          VARCHAR2(2000),
  ubi_destino      VARCHAR2(100)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PROCESOS_HIS
  is 'Histórico de Control de Ejecucion de Procesos a Ejecutar.';
comment on column IT.GE_PROCESOS_HIS.fecha
  is 'Fecha del registro';
comment on column IT.GE_PROCESOS_HIS.cod_proceso
  is 'Codigo de Proceso.';
comment on column IT.GE_PROCESOS_HIS.descripcion
  is 'Nombre del proceso.';
comment on column IT.GE_PROCESOS_HIS.nro_orden
  is 'Numero de Orden.';
comment on column IT.GE_PROCESOS_HIS.obligatorio
  is 'obligatorio ? (N=NO / S=SI).';
comment on column IT.GE_PROCESOS_HIS.tipo
  is 'Tipo de proceso.';
comment on column IT.GE_PROCESOS_HIS.hor_inicio
  is 'Hora de inicio de ejecucion.';
comment on column IT.GE_PROCESOS_HIS.hor_fin
  is 'Hora de fin de ejecucion.';
comment on column IT.GE_PROCESOS_HIS.cod_usuario
  is 'Codigo  de usuario que ejecuto el proceso.';
comment on column IT.GE_PROCESOS_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_PROCESOS_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PROCESOS_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PROCESOS_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_PROCESOS_HIS.error
  is 'Descripcion del error que genero el proceso.';
comment on column IT.GE_PROCESOS_HIS.permiso
  is 'Roles a quienes se da permiso.';
comment on column IT.GE_PROCESOS_HIS.ubi_destino
  is 'Ubicación de destino por defecto de los archivos generados.';
alter table IT.GE_PROCESOS_HIS
  add constraint PK_GE_PROCESOS_HIS primary key (COD_PROCESO, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

