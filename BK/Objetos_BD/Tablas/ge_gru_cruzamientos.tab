create table IT.GE_GRU_CRUZAMIENTOS
(
  cod_gru_cruzamiento NUMBER(3) not null,
  descripcion         VARCHAR2(35) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_GRU_CRUZAMIENTOS
  is 'Define los Grupos de Modalidades para el cruzamiento.';
comment on column IT.GE_GRU_CRUZAMIENTOS.cod_gru_cruzamiento
  is 'Codigo de Grupo de Cruzamiento.';
comment on column IT.GE_GRU_CRUZAMIENTOS.descripcion
  is 'Descripcion.';
comment on column IT.GE_GRU_CRUZAMIENTOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_GRU_CRUZAMIENTOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_GRU_CRUZAMIENTOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_GRU_CRUZAMIENTOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_GRU_CRUZAMIENTOS
  add constraint PK_GE_GRU_CRUZAMIENTO primary key (COD_GRU_CRUZAMIENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_GRU_CRUZAMIENTOS
  add constraint AVCON_1085329119_COD_G_001
  check (COD_GRU_CRUZAMIENTO BETWEEN 0 AND 999);

