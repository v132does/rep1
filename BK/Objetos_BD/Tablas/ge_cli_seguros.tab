comment on column IT.GE_CLI_SEGUROS.estado
  is 'Estado V-Vigente / C-Cancelado';
comment on column IT.GE_CLI_SEGUROS.cod_ente
  is 'Codigo Ente Seguro';
comment on column IT.GE_CLI_SEGUROS.fec_inicio
  is 'Fecha Inicio del Seguro';
comment on column IT.GE_CLI_SEGUROS.fec_vencimiento
  is 'Fecha Vencimiento del Seguro';
comment on column IT.GE_CLI_SEGUROS.nro_cta_debito
