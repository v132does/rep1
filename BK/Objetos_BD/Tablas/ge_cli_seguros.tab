create table IT.GE_CLI_SEGUROS
(
  cod_persona          VARCHAR2(10) not null,
  nro_seguro           NUMBER(18) not null,
  cod_tip_seguro       NUMBER(5) not null,
  mto_capital          NUMBER(18) not null,
  can_cuo_pagadas      NUMBER(5),
  estado               VARCHAR2(1),
  cod_ente             NUMBER(5),
  fec_inicio           DATE not null,
  fec_vencimiento      DATE not null,
  nro_cta_debito       VARCHAR2(15),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cod_canal            NUMBER(3),
  motivo               VARCHAR2(200),
  beneficiario         VARCHAR2(100),
  nro_doc_beneficiario VARCHAR2(15),
  nro_poliza_madre     VARCHAR2(30)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_CLI_SEGUROS.cod_persona
  is 'Codigo de Persona del cliente';
comment on column IT.GE_CLI_SEGUROS.nro_seguro
  is 'Numero Seguro';
comment on column IT.GE_CLI_SEGUROS.cod_tip_seguro
