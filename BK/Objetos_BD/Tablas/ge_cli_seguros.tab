comment on column IT.GE_CLI_SEGUROS.nro_poliza_madre
  is 'N鷐ero de la P髄iza Madre.';
alter table IT.GE_CLI_SEGUROS
  add constraint PK_GE_CLI_SEGUROS primary key (COD_PERSONA, NRO_SEGURO, COD_TIP_SEGURO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CLI_SEGUROS
  add constraint FK_GCLSEG_COD_TIP_SEGURO foreign key (COD_PERSONA)
