create table IT.AP_RECURSOS
(
  cod_plan         NUMBER(10) not null,
  cod_proyecto     NUMBER(10) not null,
  cod_usuario      VARCHAR2(10) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AP_RECURSOS
  is 'Recursos.';
comment on column IT.AP_RECURSOS.cod_plan
  is 'Identificador del Plan.';
comment on column IT.AP_RECURSOS.cod_proyecto
  is 'Identificador del Proyecto.';
comment on column IT.AP_RECURSOS.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.AP_RECURSOS.usu_insercion
  is 'Usuario que inserta.';
comment on column IT.AP_RECURSOS.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.AP_RECURSOS.usu_modificacion
  is 'Usuario que modifica.';
comment on column IT.AP_RECURSOS.fec_modificacion
  is 'Fecha de modificacion.';
create index IT.IN_YRECU_COD_PROYECTO on IT.AP_RECURSOS (COD_PROYECTO, COD_PLAN)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_YRECU_COD_USUARIO on IT.AP_RECURSOS (COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AP_RECURSOS
  add constraint PK_AP_RECURSOS primary key (COD_PLAN, COD_PROYECTO, COD_USUARIO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AP_RECURSOS
  add constraint FK_YRECU_COD_PROYECTO foreign key (COD_PROYECTO, COD_PLAN)
  references IT.AP_PROYECTOS (COD_PROYECTO, COD_PLAN);
alter table IT.AP_RECURSOS
  add constraint FK_YRECU_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.AP_RECURSOS
  add constraint AVCON_1081349332_COD_P_011
  check (COD_PLAN BETWEEN 1 AND 999999999);
alter table IT.AP_RECURSOS
  add constraint AVCON_1081349332_COD_P_012
  check (COD_PROYECTO BETWEEN 1 AND 999999999);

