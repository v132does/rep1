create table IT.AH_TAR_DEBITOS
(
  nro_cuenta          VARCHAR2(15) not null,
  tar_activa          VARCHAR2(1) default 'N',
  fec_ingreso         DATE,
  cod_persona         VARCHAR2(10) not null,
  embozado            VARCHAR2(26),
  cod_usuario         VARCHAR2(10) not null,
  fec_grabacion       DATE,
  adherente           VARCHAR2(2) default '00' not null,
  nro_emision         VARCHAR2(2) not null,
  cod_causa           NUMBER(3),
  cod_ofi_origen      NUMBER(3) not null,
  fec_recepcion       DATE,
  fec_entrega         DATE,
  fec_ult_impresion   DATE,
  fec_vencimiento     DATE,
  fec_cancelacion     DATE,
  nro_planilla        NUMBER(8),
  tip_planilla        NUMBER(2),
  nro_pla_anterior    NUMBER(8),
  tip_envio           VARCHAR2(1),
  referencia          VARCHAR2(35) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  cod_est_solicitud   NUMBER(3),
  fec_envio           DATE,
  motivo              VARCHAR2(40),
  fec_activacion      DATE,
  cod_ent_procesadora NUMBER(5) not null,
  tip_tar_debito      VARCHAR2(2),
  nro_tarjeta         VARCHAR2(19),
  cod_est_pin         VARCHAR2(1),
  nro_bin             VARCHAR2(10) not null,
  renovacion          VARCHAR2(1),
  fec_ult_mov_pos     DATE,
  fec_ult_mov_atm     DATE,
  obs_tip_tdd         VARCHAR2(2000),
  nro_lote            NUMBER(6),
  ide_reg_lote        VARCHAR2(20),
  nro_cta_global      VARCHAR2(16),
  id_producto         VARCHAR2(6),
  id                  RAW(16) not null,
  id_virtual          as (CASE  WHEN "ID" IS NULL THEN NULL ELSE LOWER(SUBSTR(RAWTOHEX("ID"),1,8)||'-'||SUBSTR(RAWTOHEX("ID"),9,4)||'-'||SUBSTR(RAWTOHEX("ID"),13,4)||'-'||SUBSTR(RAWTOHEX("ID"),17,4)||'-'||SUBSTR(RAWTOHEX("ID"),21,12)) END)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AH_TAR_DEBITOS
  is 'Tarjetas de Debito.';
comment on column IT.AH_TAR_DEBITOS.nro_cuenta
  is 'Nro. de Cuenta.';
comment on column IT.AH_TAR_DEBITOS.tar_activa
  is 'Tiene Tarjeta Activa (S/N).';
comment on column IT.AH_TAR_DEBITOS.fec_ingreso
  is 'Fecha de Ingreso.';
comment on column IT.AH_TAR_DEBITOS.cod_persona
  is 'Cliente.';
comment on column IT.AH_TAR_DEBITOS.embozado
  is 'Embozado.';
comment on column IT.AH_TAR_DEBITOS.cod_usuario
  is 'Usuario.';
comment on column IT.AH_TAR_DEBITOS.fec_grabacion
  is 'Fecha de Grabacion.';
comment on column IT.AH_TAR_DEBITOS.adherente
  is '(00) Es Principal o (01...) Adicional.';
comment on column IT.AH_TAR_DEBITOS.nro_emision
  is 'Nro. de Emision.';
comment on column IT.AH_TAR_DEBITOS.cod_causa
  is 'Motivo de Cancelacion.';
comment on column IT.AH_TAR_DEBITOS.cod_ofi_origen
  is 'Oficina Origen.';
comment on column IT.AH_TAR_DEBITOS.fec_recepcion
  is 'Fecha de Recepcion.';
comment on column IT.AH_TAR_DEBITOS.fec_entrega
  is 'Fecha de Entrega.';
comment on column IT.AH_TAR_DEBITOS.fec_ult_impresion
  is 'Fecha Ultima Impresion.';
comment on column IT.AH_TAR_DEBITOS.fec_vencimiento
  is 'Fecha de Vencimiento.';
comment on column IT.AH_TAR_DEBITOS.fec_cancelacion
  is 'Fecha de Cancelacion.';
comment on column IT.AH_TAR_DEBITOS.nro_planilla
  is 'Nro. de Planilla.';
comment on column IT.AH_TAR_DEBITOS.tip_planilla
  is 'Tipo de Planilla.';
comment on column IT.AH_TAR_DEBITOS.nro_pla_anterior
  is 'Nro. de Planilla Anterior.';
comment on column IT.AH_TAR_DEBITOS.tip_envio
  is 'Tipo de Envio.';
comment on column IT.AH_TAR_DEBITOS.referencia
  is 'Codigo de Direccion.';
comment on column IT.AH_TAR_DEBITOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.AH_TAR_DEBITOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.AH_TAR_DEBITOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.AH_TAR_DEBITOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.AH_TAR_DEBITOS.cod_est_solicitud
  is 'Estado de la Tarjeta.';
comment on column IT.AH_TAR_DEBITOS.fec_envio
  is 'fecha de Proceso.';
comment on column IT.AH_TAR_DEBITOS.motivo
  is 'Motivo de Cancelacion.';
comment on column IT.AH_TAR_DEBITOS.fec_activacion
  is 'Fecha de Envio a Activacion.';
comment on column IT.AH_TAR_DEBITOS.cod_ent_procesadora
  is 'Entidad Procesadora de la Tarjeta.';
comment on column IT.AH_TAR_DEBITOS.tip_tar_debito
  is 'Tipo de Tarjeta de Debito.';
comment on column IT.AH_TAR_DEBITOS.nro_tarjeta
  is 'Nro. de Tarjeta';
comment on column IT.AH_TAR_DEBITOS.cod_est_pin
  is 'Estado del Pin.';
comment on column IT.AH_TAR_DEBITOS.nro_bin
  is 'Numero de Bin.';
comment on column IT.AH_TAR_DEBITOS.renovacion
  is 'Indicador de Renovacion.';
comment on column IT.AH_TAR_DEBITOS.fec_ult_mov_pos
  is 'Fecha de Ultimo Movimiento POS.';
comment on column IT.AH_TAR_DEBITOS.fec_ult_mov_atm
  is 'Fecha de Ultimo Movimiento ATM.';
comment on column IT.AH_TAR_DEBITOS.obs_tip_tdd
  is 'Observación,  El usuario debe escribir el motivo por el cual hizo la selección de tipo de tarjeta de débito INFONET';
comment on column IT.AH_TAR_DEBITOS.nro_lote
  is 'Nro. de Lote';
comment on column IT.AH_TAR_DEBITOS.ide_reg_lote
  is 'Identificador del registro del lote';
comment on column IT.AH_TAR_DEBITOS.id
  is 'Identificador de la tarjeta en raw';
comment on column IT.AH_TAR_DEBITOS.id_virtual
  is 'Identificador virtual de la tarjeta en formato UUID V7';
create index IT.IN_ATDEB_COD_CAUSA on IT.AH_TAR_DEBITOS (COD_CAUSA, COD_OFI_ORIGEN, COD_USUARIO, NRO_PLANILLA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BBVA_AH_TAR_DEBITOS on IT.AH_TAR_DEBITOS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CRDEB_NRO_LOTE on IT.AH_TAR_DEBITOS (NRO_LOTE, IDE_REG_LOTE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CTDEB_ID on IT.AH_TAR_DEBITOS (ID)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CTDEB_ID_VIRTUAL on IT.AH_TAR_DEBITOS (ID_VIRTUAL)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CTDEB_NRO_CUENTA on IT.AH_TAR_DEBITOS (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 384K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.JJNOTIF on IT.AH_TAR_DEBITOS (NRO_TARJETA, FEC_VENCIMIENTO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AH_TAR_DEBITOS
  add constraint PK_AH_TAR_DEBITOS primary key (NRO_CUENTA, COD_PERSONA, ADHERENTE, NRO_EMISION, NRO_BIN)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AH_TAR_DEBITOS
  add constraint FK_ATDEB_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.AH_TAR_DEBITOS
  add constraint FK_CTDEB_COD_CAUSA foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.AH_TAR_DEBITOS
  add constraint FK_CTDEB_COD_ENT_PROCESADORA foreign key (COD_ENT_PROCESADORA)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.AH_TAR_DEBITOS
  add constraint FK_CTDEB_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.AH_TAR_DEBITOS
  add constraint FK_CTDEB_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.AH_TAR_DEBITOS
  add constraint FK_CTDEB_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.AH_TAR_DEBITOS
  add constraint AVCON_1099426657_ADHER_000
  check (ADHERENTE between '00' and '99');
alter table IT.AH_TAR_DEBITOS
  add constraint AVCON_1099426657_COD_C_000
  check (COD_CAUSA BETWEEN 0 AND 999);
alter table IT.AH_TAR_DEBITOS
  add constraint AVCON_1099426657_COD_O_002
  check (COD_OFI_ORIGEN BETWEEN 0 AND 999);
alter table IT.AH_TAR_DEBITOS
  add constraint AVCON_1099426657_TAR_A_000
  check (TAR_ACTIVA IN ('S', 'N'));
alter table IT.AH_TAR_DEBITOS
  add constraint AVCON_1119032741_COD_E_000
  check (COD_EST_SOLICITUD IN (0, 1, 2, 3, 4, 5, 6, 8, 10, 12, 14, 15, 16, 17, 18, 19, 25, 26))
  novalidate;
