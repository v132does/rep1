  cod_paquete   NUMBER(3),
  descripcion   VARCHAR2(35),
  estado        VARCHAR2(100),
  fec_inicio    DATE,
  nro_cuenta    VARCHAR2(15),
  cod_moneda    VARCHAR2(3),
  des_modal     VARCHAR2(35),
  mes_pro_01    VARCHAR2(20),
  sal_pro_01    NUMBER(18,2),
  tie_car_01    VARCHAR2(1),
  mes_pro_02    VARCHAR2(20),
  sal_pro_02    NUMBER(18,2),
  tie_car_02    VARCHAR2(1),
  mes_pro_03    VARCHAR2(20),
