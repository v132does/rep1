  mes_pro_05    VARCHAR2(20),
  sal_pro_05    NUMBER(18,2),
  tie_car_05    VARCHAR2(1),
  mes_pro_06    VARCHAR2(20),
  sal_pro_06    NUMBER(18,2),
  tie_car_06    VARCHAR2(1),
  mes_pro_07    VARCHAR2(20),
  sal_pro_07    NUMBER(18,2),
  tie_car_07    VARCHAR2(1),
  mes_pro_08    VARCHAR2(20),
  sal_pro_08    NUMBER(18,2),
  tie_car_08    VARCHAR2(1),
  mes_pro_09    VARCHAR2(20),
  sal_pro_09    NUMBER(18,2),
  tie_car_09    VARCHAR2(1),
  mes_pro_10    VARCHAR2(20),
  sal_pro_10    NUMBER(18,2),
  tie_car_10    VARCHAR2(1),
  mes_pro_11    VARCHAR2(20),
  sal_pro_11    NUMBER(18,2),
  tie_car_11    VARCHAR2(1),
  mes_pro_12    VARCHAR2(20),
  sal_pro_12    NUMBER(18,2),
  tie_car_12    VARCHAR2(1),
  mes_pro_13    VARCHAR2(20),
  sal_pro_13    NUMBER(18,2),
  tie_car_13    VARCHAR2(1),
  mes_pro_14    VARCHAR2(20),
  sal_pro_14    NUMBER(18,2),
  tie_car_14    VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CTA_GANADORA_TMP
  is 'Tabla temporal de datos de Saldo Promedio de Cuenta Ganadora';
comment on column IT.GE_CTA_GANADORA_TMP.cod_persona
  is 'Código de riesgo';
