tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PSA024_HIS
  is 'TABLA Clientes de PIC';
comment on column IT.PSA024_HIS.psa024_hisfin
