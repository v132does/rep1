create table IT.BW_POL_ARCHIVOS
(
  cod_pol_seguro   NUMBER not null,
  arc_base64       CLOB,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_POL_ARCHIVOS
  is 'Tabla para guadar las polizas de seguros';
comment on column IT.BW_POL_ARCHIVOS.cod_pol_seguro
  is 'Codigo del seguro';
comment on column IT.BW_POL_ARCHIVOS.arc_base64
  is 'Se almacena la poliza en base64';
comment on column IT.BW_POL_ARCHIVOS.usu_insercion
  is 'Usuario que realizó la inserción del registro';
comment on column IT.BW_POL_ARCHIVOS.fec_insercion
  is 'Fecha en que se insertó el registro';
comment on column IT.BW_POL_ARCHIVOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro';
comment on column IT.BW_POL_ARCHIVOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro';
create index IT.IN_COD_POL_SEGURO on IT.BW_POL_ARCHIVOS (COD_POL_SEGURO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BW_POL_ARCHIVOS
  add constraint PK_POL_ARCHIVOS primary key (COD_POL_SEGURO);
alter table IT.BW_POL_ARCHIVOS
  add constraint FK_POL_ARCHIVOS foreign key (COD_POL_SEGURO)
  references IT.GE_POL_SEGUROS (CODIGO);

