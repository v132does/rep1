create table IT.PR_CUO_COM_CARTERA
(
  nro_operacion        VARCHAR2(30) not null,
  nro_cuota            NUMBER(7) not null,
  fec_vencimiento      DATE,
  mto_cuota            NUMBER(18,2),
  cod_ente             NUMBER(5) default 1 not null,
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  nro_cheque           NUMBER(15),
  cod_banco            NUMBER(3),
  cta_libradora        VARCHAR2(20),
  fec_emision          DATE,
  mto_cheque           NUMBER(18,2),
  nom_librador         VARCHAR2(60),
  ape_librador         VARCHAR2(60),
  nro_doc_librador     VARCHAR2(20),
  cod_tip_doc_librador NUMBER(3),
  cod_sex_librador     VARCHAR2(1),
  sal_capital          NUMBER(18,2),
  sal_interes          NUMBER(18,2),
  cta_lib_denominacion VARCHAR2(120)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.PR_CUO_COM_CARTERA.nro_operacion
  is 'Nro. de la operaci?n.';
comment on column IT.PR_CUO_COM_CARTERA.nro_cuota
  is 'Nro. de la cuota.';
comment on column IT.PR_CUO_COM_CARTERA.fec_vencimiento
  is 'Fecha de Vencimiento de la cuota.';
comment on column IT.PR_CUO_COM_CARTERA.mto_cuota
  is 'Monto de la cuota.';
comment on column IT.PR_CUO_COM_CARTERA.cod_ente
  is 'Entidad.';
comment on column IT.PR_CUO_COM_CARTERA.usu_insercion
  is 'Usuario que realiz? la inserci?n del registro.';
comment on column IT.PR_CUO_COM_CARTERA.fec_insercion
  is 'Fecha en que se insert? el registro.';
comment on column IT.PR_CUO_COM_CARTERA.usu_modificacion
  is 'Usuario que realiz? la ?ltima modificaci?n en el registro.';
comment on column IT.PR_CUO_COM_CARTERA.fec_modificacion
  is 'Fecha en que se realiz? la ?ltima modificaci?n en el registro.';
comment on column IT.PR_CUO_COM_CARTERA.nro_cheque
  is 'N?mero de Cheque.';
comment on column IT.PR_CUO_COM_CARTERA.cod_banco
  is 'C?digo de Banco.';
comment on column IT.PR_CUO_COM_CARTERA.cta_libradora
  is 'Cuenta Libradora.';
comment on column IT.PR_CUO_COM_CARTERA.fec_emision
  is 'Fecha de Emisi?n.';
comment on column IT.PR_CUO_COM_CARTERA.mto_cheque
  is 'Monto del Cheque.';
comment on column IT.PR_CUO_COM_CARTERA.nom_librador
  is 'Nombre del Librador.';
comment on column IT.PR_CUO_COM_CARTERA.ape_librador
  is 'Apellido del Librador.';
comment on column IT.PR_CUO_COM_CARTERA.nro_doc_librador
  is 'Nro. de Documento de Identidad  del Librador.';
comment on column IT.PR_CUO_COM_CARTERA.cod_tip_doc_librador
  is 'Tipo de documento del Librador(1-CI,2-pasaporte, etc).';
comment on column IT.PR_CUO_COM_CARTERA.cod_sex_librador
  is 'Codigo del sexo (M=Masculino / F=Femenino).';
comment on column IT.PR_CUO_COM_CARTERA.sal_capital
  is 'Capital de la Cuota.';
comment on column IT.PR_CUO_COM_CARTERA.sal_interes
  is 'Interes de la Cuota.';
comment on column IT.PR_CUO_COM_CARTERA.cta_lib_denominacion
  is 'Denominaci?n de la Cuenta Bancaria.';
alter table IT.PR_CUO_COM_CARTERA
  add constraint PK_PR_CUO_COM_CARTERA primary key (NRO_OPERACION, NRO_CUOTA, COD_ENTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

