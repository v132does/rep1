create table IT.TA_CON_PROMOCIONES_TMP
(
  fec_proceso      DATE,
  afinidad         VARCHAR2(6),
  nro_tarjeta      VARCHAR2(25),
  comercio         VARCHAR2(60),
  fec_operacion    DATE,
  mto_compra       NUMBER(18,2),
  mto_descuento    NUMBER(18,2),
  concepto         VARCHAR2(60),
  promocion        VARCHAR2(60),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_CON_PROMOCIONES_TMP.fec_proceso
  is 'Fecha de proceso.';
comment on column IT.TA_CON_PROMOCIONES_TMP.afinidad
  is 'Afinidad de la Tarjeta.';
comment on column IT.TA_CON_PROMOCIONES_TMP.nro_tarjeta
  is 'Numero de la Tarjeta.';
comment on column IT.TA_CON_PROMOCIONES_TMP.comercio
  is 'Descripción del Comercio.';
comment on column IT.TA_CON_PROMOCIONES_TMP.fec_operacion
  is 'Fecha de Operación.';
comment on column IT.TA_CON_PROMOCIONES_TMP.mto_compra
  is 'Monto de la Compra.';
comment on column IT.TA_CON_PROMOCIONES_TMP.mto_descuento
  is 'Monto del Descuento otorgado.';
comment on column IT.TA_CON_PROMOCIONES_TMP.concepto
  is 'Concepto.';
comment on column IT.TA_CON_PROMOCIONES_TMP.promocion
  is 'Descripcion de la Promoción.';
comment on column IT.TA_CON_PROMOCIONES_TMP.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.TA_CON_PROMOCIONES_TMP.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.TA_CON_PROMOCIONES_TMP.usu_modificacion
  is 'Usuario que realizó la última modificación.';
comment on column IT.TA_CON_PROMOCIONES_TMP.fec_modificacion
  is '
Ultima fecha en que se modificó el registro.';

