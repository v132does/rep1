create table IT.CB_SAL_CONSOLIDADOS_TMP
(
  cod_rubro        VARCHAR2(15) not null,
  fecha            DATE not null,
  sal_mon_loc_ant  NUMBER(18,2) default 0,
  deb_mon_local    NUMBER(18,2) default 0,
  cre_mon_local    NUMBER(18,2) default 0,
  sal_mon_rub_ant  NUMBER(18,2) default 0,
  deb_mon_rubro    NUMBER(18,2) default 0,
  cre_mon_rubro    NUMBER(18,2) default 0,
  protegido        VARCHAR2(1) default 'N' not null,
  sal_equ_loc_ant  NUMBER(18,2) default 0,
  deb_equ_local    NUMBER(18,2) default 0,
  cre_equ_local    NUMBER(18,2) default 0,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SAL_CONSOLIDADOS_TMP
  is 'Contiene los saldos de las cuentas contables consolidadas.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.cod_rubro
  is 'Codigo de la cuenta contable.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.fecha
  is 'Fecha.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.sal_mon_loc_ant
  is 'Saldo de ayer en moneda local.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.deb_mon_local
  is 'Debitos de hoy en moneda local.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.cre_mon_local
  is 'Creditos de hoy en moneda local.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.sal_mon_rub_ant
  is 'Saldo de ayer en moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.deb_mon_rubro
  is 'Debitos de hoy en moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.cre_mon_rubro
  is 'Creditos de hoy en moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.protegido
  is 'Registro protegido ? ( S=Es protegido, no puede ser borrado, N=No es protegido, puede ser borrado ).';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.sal_equ_loc_ant
  is 'Saldo anterior del equivalente en moneda local de la moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.deb_equ_local
  is 'Total de debitos del equivalente en moneda local de la moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.cre_equ_local
  is 'Total de creditos del equivalente en moneda local de la moneda extranjera.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_SAL_CONSOLIDADOS_TMP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_BCTMP_COD_RUBRO on IT.CB_SAL_CONSOLIDADOS_TMP (COD_RUBRO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_SAL_CONSOLIDADOS_TMP
  add constraint PK_CB_SAL_CONSOLIDADOS_TMP primary key (COD_RUBRO, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

