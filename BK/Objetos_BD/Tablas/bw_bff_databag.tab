-- Create table
create table IT.BW_BFF_DATABAG
(
  nro_operacion    NUMBER not null,
  peticion         LONG not null,
  estado           VARCHAR2(32) not null,
  cod_entidad      VARCHAR2(10) not null,
  nro_cuenta       VARCHAR2(15),
  cod_moneda       VARCHAR2(3),
  monto            NUMBER(18,2) default 0 not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.BW_BFF_DATABAG
  is 'La tabla se utiliza para guardar datos necesarios para el pago de servicios. Dicha información luego se utiliza para llamar a la API';
-- Add comments to the columns 
comment on column IT.BW_BFF_DATABAG.nro_operacion
  is 'Número autogenerado de la secuencia IT.S_NRO_BW_BFF_DATABAG';
comment on column IT.BW_BFF_DATABAG.peticion
  is 'Pedido(Request) de la Operacion';
comment on column IT.BW_BFF_DATABAG.estado
  is 'Estado de la Operacion.(P-Pendiente, C-Confirmado, R-Rechazado)';
comment on column IT.BW_BFF_DATABAG.cod_entidad
  is 'Código de Entidad del Servicio.';
comment on column IT.BW_BFF_DATABAG.nro_cuenta
  is 'Número de cuenta.';
comment on column IT.BW_BFF_DATABAG.cod_moneda
  is 'Moneda de la Cuenta.';
comment on column IT.BW_BFF_DATABAG.monto
  is 'Monto.';
comment on column IT.BW_BFF_DATABAG.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BW_BFF_DATABAG.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BW_BFF_DATABAG.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BW_BFF_DATABAG.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.BW_BFF_DATABAG
  add constraint PK_BW_BFF_DATABAG primary key (NRO_OPERACION)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BW_BFF_DATABAG
  add constraint FK_DATAB_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
-- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.BW_BFF_DATABAG to IT_TEMPORAL;
