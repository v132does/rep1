create table IT.GE_PLZ_CONTABLES
(
  cod_plazo        NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  can_dias         NUMBER(5) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PLZ_CONTABLES
  is 'Plazos de Plan de Cuentas BCP.';
comment on column IT.GE_PLZ_CONTABLES.cod_plazo
  is 'Codigo de plazo.';
comment on column IT.GE_PLZ_CONTABLES.descripcion
  is 'Nombre del plazo.';
comment on column IT.GE_PLZ_CONTABLES.can_dias
  is 'Cantidad de dias del plazo.';
comment on column IT.GE_PLZ_CONTABLES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_PLZ_CONTABLES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PLZ_CONTABLES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PLZ_CONTABLES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_GPCON_CAN_DIAS on IT.GE_PLZ_CONTABLES (CAN_DIAS)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  )
  nologging;
alter table IT.GE_PLZ_CONTABLES
  add constraint PK_GE_PLZ_CONTABLES primary key (COD_PLAZO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PLZ_CONTABLES
  add constraint AVCON_1080843414_COD_P_006
  check (COD_PLAZO BETWEEN 1 AND 999);

