create table IT.PR_CUOTAS_HIS
(
  cod_tas_fondo       NUMBER(10),
  nro_cuenta          VARCHAR2(15) not null,
  nro_cuota           NUMBER(3) not null,
  mto_capital         NUMBER(18,2) default 0 not null,
  fec_vencimiento     DATE not null,
  mto_interes         NUMBER(18,2) default 0 not null,
  estado              VARCHAR2(1) not null,
  sal_capital         NUMBER(18,2) default 0 not null,
  sal_interes         NUMBER(18,2) default 0 not null,
  prioridad           VARCHAR2(1) not null,
  fec_ult_pago        DATE,
  val_recargo         NUMBER(18,2) default 0,
  mto_int_documentado NUMBER(18,2) default 0,
  nro_documento       NUMBER(8),
  sal_int_documentado NUMBER(18,2) default 0,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  fec_modificacion    DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  dev_no_cobrado      NUMBER(18,2) default 0,
  dev_suspenso        NUMBER(18,2) default 0,
  dev_acumulado       NUMBER(18,2) default 0,
  mto_int_descontado  NUMBER(18,2) default 0,
  mto_cap_adelantado  NUMBER(18,2) default 0,
  val_tasa            NUMBER(20,4)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_CUOTAS_HIS
  is 'Contiene los datos del Plan de Pagos de Préstamos';
comment on column IT.PR_CUOTAS_HIS.cod_tas_fondo
  is 'Código del Ajuste de Tasa. Nulo si es pase a Incobrable';
comment on column IT.PR_CUOTAS_HIS.nro_cuenta
  is 'Número de préstamo';
comment on column IT.PR_CUOTAS_HIS.nro_cuota
  is 'Número de cuota del préstamo';
comment on column IT.PR_CUOTAS_HIS.mto_capital
  is 'Monto de capital a amortizar';
comment on column IT.PR_CUOTAS_HIS.fec_vencimiento
  is 'Fecha de vencimiento de la cuota';
comment on column IT.PR_CUOTAS_HIS.mto_interes
  is 'Monto del interés no documentado de la cuota';
comment on column IT.PR_CUOTAS_HIS.estado
  is 'Estado de la cuota (C=Vigente / A=Vigente Atrasada / V=Vencida / G=En Gestion / M=Morosa / N=Cancelada)';
comment on column IT.PR_CUOTAS_HIS.sal_capital
  is 'Saldo de capital de la cuota';
comment on column IT.PR_CUOTAS_HIS.sal_interes
  is 'Saldo de interés no doc. de la cuota';
comment on column IT.PR_CUOTAS_HIS.prioridad
  is 'Prioridad de cobro. (C=Capital / I=Interes)';
comment on column IT.PR_CUOTAS_HIS.fec_ult_pago
  is 'Fecha de último pago';
comment on column IT.PR_CUOTAS_HIS.val_recargo
  is 'Valor de recargo';
comment on column IT.PR_CUOTAS_HIS.mto_int_documentado
  is 'Valor del interés documentado de la cuota';
comment on column IT.PR_CUOTAS_HIS.nro_documento
  is 'Número de documento';
comment on column IT.PR_CUOTAS_HIS.sal_int_documentado
  is 'Saldo del interés documentado';
comment on column IT.PR_CUOTAS_HIS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_CUOTAS_HIS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_CUOTAS_HIS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_CUOTAS_HIS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_CUOTAS_HIS.dev_no_cobrado
  is 'Devengado No Cobrado';
comment on column IT.PR_CUOTAS_HIS.dev_suspenso
  is 'Devengado en Suspenso.';
comment on column IT.PR_CUOTAS_HIS.dev_acumulado
  is 'Devengado acumulado.';
comment on column IT.PR_CUOTAS_HIS.mto_int_descontado
  is 'Monto de interes descontado';
comment on column IT.PR_CUOTAS_HIS.mto_cap_adelantado
  is 'Monto de capital adelantado por cancelacion anticipada';
comment on column IT.PR_CUOTAS_HIS.val_tasa
  is 'Valor de la Tasa de Interés. Nulo si es pase a Incobrable';
create index IT.IN_PCUOH_NRO_CUENTA on IT.PR_CUOTAS_HIS (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_PR_CUOTAS_HIS on IT.PR_CUOTAS_HIS (MTO_CAPITAL, MTO_INTERES, ESTADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_CUOTAS_HIS
  add constraint FK_PCUOH_COD_TAS_FONDO foreign key (COD_TAS_FONDO)
  references IT.PR_TAS_FONDOS (COD_TAS_FONDO);
alter table IT.PR_CUOTAS_HIS
  add constraint FK_PCUOH_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.PR_CTA_PRESTAMOS (NRO_CUENTA);

