create table IT.GE_EQF_SOL_DETALLES
(
  nro_solicitud      NUMBER(10) not null,
  cod_persona        VARCHAR2(10) not null,
  nro_secuencia      NUMBER(5) not null,
  fec_consulta       DATE,
  hor_consulta       VARCHAR2(10),
  nom_ser_webservice VARCHAR2(100),
  tip_persona        VARCHAR2(1),
  nombre             VARCHAR2(120),
  fecha              VARCHAR2(20),
  telefono           VARCHAR2(50),
  tip_operaciones    VARCHAR2(50),
  msg_error          VARCHAR2(4000),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_EQF_SOL_DETALLES.nro_solicitud
  is 'Nro Solicitud al servicio web';
comment on column IT.GE_EQF_SOL_DETALLES.cod_persona
  is 'Cod de persona que se consulta en los servicios web';
comment on column IT.GE_EQF_SOL_DETALLES.nro_secuencia
  is 'Nro de secuencia por solicitud';
comment on column IT.GE_EQF_SOL_DETALLES.fec_consulta
  is 'Fecha de la consulta al servicio web';
comment on column IT.GE_EQF_SOL_DETALLES.hor_consulta
  is 'Hora de la consulta al servicio web';
comment on column IT.GE_EQF_SOL_DETALLES.nom_ser_webservice
  is 'Nombre del servicio web consultado';
comment on column IT.GE_EQF_SOL_DETALLES.tip_persona
  is 'Tipo de persona F= física, J= jurídica';
comment on column IT.GE_EQF_SOL_DETALLES.nombre
  is 'Nombre persona';
comment on column IT.GE_EQF_SOL_DETALLES.fecha
  is 'Fecha solicitud';
comment on column IT.GE_EQF_SOL_DETALLES.telefono
  is 'Nro de teléfono';
comment on column IT.GE_EQF_SOL_DETALLES.tip_operaciones
  is 'Tipo de operaciones';
comment on column IT.GE_EQF_SOL_DETALLES.msg_error
  is 'Mensaje de error del webservice si lo hubiere';
create index IT.IN_SOLDET_PER_SOL_FEC on IT.GE_EQF_SOL_DETALLES (COD_PERSONA, FEC_CONSULTA, NRO_SOLICITUD)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_EQF_SOL_DETALLES
  add constraint PK_GE_EQF_SOL_DETALLE primary key (NRO_SOLICITUD, NRO_SECUENCIA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_EQF_SOL_DETALLES
  add constraint FK_EQFSD_NRO_SOLICITUD foreign key (NRO_SOLICITUD)
  references IT.GE_EQF_SOLICITUDES (NRO_SOLICITUD) on delete cascade;

