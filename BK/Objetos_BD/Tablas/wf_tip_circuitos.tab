create table IT.WF_TIP_CIRCUITOS
(
  cod_tip_circuito   NUMBER(3) not null,
  descripcion        VARCHAR2(60) not null,
  detalle            VARCHAR2(300),
  estado             VARCHAR2(1) default 'A' not null,
  cod_obj_base       VARCHAR2(30) not null,
  cod_tar_inicial    NUMBER(3),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  referencia         VARCHAR2(50),
  det_sql            VARCHAR2(4000),
  cod_programa       VARCHAR2(30),
  cod_modulo         NUMBER(3),
  cod_modalidad      NUMBER(3),
  nom_par_referencia VARCHAR2(20),
  ref_val_limite     VARCHAR2(300)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.WF_TIP_CIRCUITOS
  is 'Definicion de los circuitos posibles ';
comment on column IT.WF_TIP_CIRCUITOS.cod_tip_circuito
  is 'Codigo del tipo de circuito';
comment on column IT.WF_TIP_CIRCUITOS.descripcion
  is 'Descripcion del tipo de circuito';
comment on column IT.WF_TIP_CIRCUITOS.detalle
  is 'Detalle de la definicion ';
comment on column IT.WF_TIP_CIRCUITOS.estado
  is 'Estado del usuario en el Grupo de usuarios: A-Activo I-Inactivo';
comment on column IT.WF_TIP_CIRCUITOS.cod_obj_base
  is 'Nombre del objeto base del circuito.';
comment on column IT.WF_TIP_CIRCUITOS.cod_tar_inicial
  is 'Codigo de tarea inicial';
comment on column IT.WF_TIP_CIRCUITOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.WF_TIP_CIRCUITOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.WF_TIP_CIRCUITOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.WF_TIP_CIRCUITOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.WF_TIP_CIRCUITOS.referencia
  is 'Nombre del campo de referencia';
comment on column IT.WF_TIP_CIRCUITOS.det_sql
  is 'Detalle de Datos(select) a ser mostrados como detalles de la operacion';
comment on column IT.WF_TIP_CIRCUITOS.cod_programa
  is 'Codigo del Programa que muestra detalles de la operacion';
comment on column IT.WF_TIP_CIRCUITOS.cod_modulo
  is 'Codigo del modulo para cargar el parametro: GLOBAL:wk_cdmodul';
comment on column IT.WF_TIP_CIRCUITOS.cod_modalidad
  is 'Codigo de la modalidad para cargar el parametro: GLOBAL:wk_cdmodal ';
comment on column IT.WF_TIP_CIRCUITOS.nom_par_referencia
  is 'Nombre de la variable global al que se asignara la referencia';
comment on column IT.WF_TIP_CIRCUITOS.ref_val_limite
  is 'Definición del nombre de una función que retorne un valor o nombre de una columna numérica de una tabla, etc.';
alter table IT.WF_TIP_CIRCUITOS
  add constraint PK_WF_TIP_CIRCUITOS primary key (COD_TIP_CIRCUITO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

