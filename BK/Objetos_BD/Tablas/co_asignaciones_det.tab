create table IT.CO_ASIGNACIONES_DET
(
  cod_persona        VARCHAR2(10) not null,
  fec_ini_asignacion DATE not null,
  nro_cuenta         VARCHAR2(15) not null,
  nro_cuota          NUMBER(3) not null,
  cod_modulo         NUMBER(3) not null,
  cod_modalidad      NUMBER(3) not null,
  cod_moneda         VARCHAR2(3) not null,
  mto_atraso         NUMBER(18,2) default 0 not null,
  dia_atraso         NUMBER(5) default 0 not null,
  dia_ini_atraso     NUMBER(5) default 0 not null,
  mto_pagado         NUMBER(18,2) default 0 not null,
  pro_cabecera       VARCHAR2(1) default 'N' not null,
  fec_vto_cuota      DATE,
  fec_ult_pago       DATE,
  cod_canal          NUMBER(3),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CO_ASIGNACIONES_DET
  is 'Detalle de Cuentas asignadas por Tramo y Gestor.';
comment on column IT.CO_ASIGNACIONES_DET.cod_persona
  is 'Código de Persona.';
comment on column IT.CO_ASIGNACIONES_DET.fec_ini_asignacion
  is 'Fecha Inicial de Asignación de la Actividad.';
comment on column IT.CO_ASIGNACIONES_DET.nro_cuenta
  is 'Número de Cuenta.';
comment on column IT.CO_ASIGNACIONES_DET.nro_cuota
  is 'Número de Cuota.';
comment on column IT.CO_ASIGNACIONES_DET.cod_modulo
  is 'Código de Módulo.';
comment on column IT.CO_ASIGNACIONES_DET.cod_modalidad
  is 'Código de Modalidad.';
comment on column IT.CO_ASIGNACIONES_DET.cod_moneda
  is 'Código de Moneda.';
comment on column IT.CO_ASIGNACIONES_DET.mto_atraso
  is 'Monto de Atraso de la Cuota Vencida o el Pago Mínimo de Tarjeta.';
comment on column IT.CO_ASIGNACIONES_DET.dia_atraso
  is 'Días de Atraso actual de la Operación.';
comment on column IT.CO_ASIGNACIONES_DET.dia_ini_atraso
  is 'Días de Atraso de la Operación al momento de asignar.';
comment on column IT.CO_ASIGNACIONES_DET.mto_pagado
  is 'Monto Pagado (se utiliza para calcular productividad).';
comment on column IT.CO_ASIGNACIONES_DET.pro_cabecera
  is 'Indica Producto Cabecera S/N.';
comment on column IT.CO_ASIGNACIONES_DET.fec_vto_cuota
  is 'Fecha de Vencimiento de la Cuota.';
comment on column IT.CO_ASIGNACIONES_DET.fec_ult_pago
  is 'Fecha de último Pago de la Cuota.';
comment on column IT.CO_ASIGNACIONES_DET.cod_canal
  is 'Código de Canal de la Cuenta (se utiliza para asignar diferenciados a clientes o empresas del grupo).';
comment on column IT.CO_ASIGNACIONES_DET.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CO_ASIGNACIONES_DET.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CO_ASIGNACIONES_DET.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CO_ASIGNACIONES_DET.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_OADET_COD_PERSONA on IT.CO_ASIGNACIONES_DET (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CO_ASIGNACIONES_DET
  add constraint PK_CO_ASIGNACIONES_DET primary key (COD_PERSONA, FEC_INI_ASIGNACION, NRO_CUENTA, NRO_CUOTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CO_ASIGNACIONES_DET
  add constraint FK_OADET_COD_CANAL foreign key (COD_CANAL)
  references IT.GE_CANALES (COD_CANAL);
alter table IT.CO_ASIGNACIONES_DET
  add constraint FK_OADET_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.CO_ASIGNACIONES_DET
  add constraint FK_OADET_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CO_ASIGNACIONES_DET
  add constraint FK_OADET_FEC_INI_ASIGNACION foreign key (COD_PERSONA, FEC_INI_ASIGNACION)
  references IT.CO_ASIGNACIONES (COD_PERSONA, FEC_INI_ASIGNACION);
alter table IT.CO_ASIGNACIONES_DET
  add constraint CK_OADET_COD_MODALIDAD
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.CO_ASIGNACIONES_DET
  add constraint CK_OADET_COD_MODULO
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.CO_ASIGNACIONES_DET
  add constraint CK_OADET_NRO_CUOTA
  check (NRO_CUOTA BETWEEN 0 AND 999);

