create table IT.BW_GEN_CLAVES_TMP
(
  cod_persona VARCHAR2(10) not null,
  nro_orden   NUMBER not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_GEN_CLAVES_TMP
  is 'TABLA TEMPORAL PARA GENERACION MASIVA DE CLAVES';
comment on column IT.BW_GEN_CLAVES_TMP.cod_persona
  is 'CODIGO DE PERSONA';
comment on column IT.BW_GEN_CLAVES_TMP.nro_orden
  is 'NRO ORDEN PARA IMPRESION';

