  is 'Código del Origen de Fondos.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.mto_lin_aplicado
  is 'Monto de la Línea Aplicado.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.sal_int_ade_batch
  is 'Saldo Total Interés Documento Batch.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.per_vto_capital
  is 'Periodo de Vencimiento del Capital.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.per_vto_interes
  is 'Periodo de Vencimiento del Interés.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.dev_suspenso
  is 'Devengado en Suspenso.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.tip_interes
  is 'Tipo de Interés (A=Adelantado / V=Vencido).';
comment on column IT.PR_CTA_PRESTAMOS_HIS.fec_juicio
  is 'Fecha en la cual pasó a Juicio.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.cod_ent_juicio
  is 'Ente al cual se derivó el Juicio.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.cat_renovaciones
  is 'Categoría de las Renovaciones, Refinanciaciones o Restructuraciones.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.en_juicio
  is 'Indica si el Préstamo se encuentra en estado Judicial.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.cod_banca
  is 'Código de Banca.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.mto_mora
  is 'Monto en Mora.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.por_ori_fondo
  is 'Porcentaje correspondiente al Origen de Fondos.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.fec_ren_tas_orig
  is 'Fecha de Renegociación de la Tasa Original.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.fec_ren_tas
  is 'Fecha de Renegociación de la Tasa Pactada con el Cliente.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.cod_sub_modalidad
  is 'Código de Sub-Modalidad.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.cod_rub_economico
  is 'Código de Rubro Económico.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.nro_cta_novada
  is 'Registra el número de cuenta renovada correspondiente a operaciones Nuevas.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.fec_ult_categorizacion
  is 'Registra la última fecha que mejoró la categoría.';
comment on column IT.PR_CTA_PRESTAMOS_HIS.fec_ini_rrr
  is 'Fecha de Inicio del Préstamo para Operaciones RRR por Cuotas';
comment on column IT.PR_CTA_PRESTAMOS_HIS.fecha
  is 'Fecha';
alter table IT.PR_CTA_PRESTAMOS_HIS
  add constraint PK_PR_CTA_PRESTAMOS_HIS primary key (FECHA, NRO_CUENTA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

