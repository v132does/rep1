create global temporary table IT.STAGE_SS2K5_TABLE_PRIVILEGES
(
  svrid_fk       NUMBER(38),
  dbid_gen_fk    NUMBER(38),
  suid_gen_fk    NUMBER(38),
  grantor        VARCHAR2(256 CHAR),
  table_schema   VARCHAR2(256 CHAR),
  table_name     VARCHAR2(256 CHAR) not null,
  privilege_type VARCHAR2(256 CHAR),
  is_grantable   VARCHAR2(256 CHAR),
  grantee        VARCHAR2(256 CHAR)
)
on commit preserve rows;
create index IT.S_SS2K5_TE_PS_DBID_GEN_FK on IT.STAGE_SS2K5_TABLE_PRIVILEGES (DBID_GEN_FK);
create index IT.S_SS2K5_T_P_TABLE_NAME on IT.STAGE_SS2K5_TABLE_PRIVILEGES (TABLE_NAME);
create index IT.S_SS2K5_T_P_TABLE_SCHEMA on IT.STAGE_SS2K5_TABLE_PRIVILEGES (TABLE_SCHEMA);

