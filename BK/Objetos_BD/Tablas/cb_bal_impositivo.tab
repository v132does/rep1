create table IT.CB_BAL_IMPOSITIVO
(
  nro_orden        NUMBER(7) not null,
  descripcion      VARCHAR2(60),
  nro_pagina       NUMBER(6),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_rubro        VARCHAR2(15),
  resaltar         NUMBER,
  tipo             VARCHAR2(2),
  tip_rubro        VARCHAR2(1),
  sum_debito       NUMBER(18,2),
  sum_credito      NUMBER(18,2),
  sal_deudor       NUMBER(18,2),
  sal_acreedor     NUMBER(18,2),
  inv_activo       NUMBER(18,2),
  inv_pasivo       NUMBER(18,2),
  res_perdida      NUMBER(18,2),
  res_ganancia     NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_BAL_IMPOSITIVO
  is 'Datos para imprimir el Balance Impositivo.';
comment on column IT.CB_BAL_IMPOSITIVO.nro_orden
  is 'Numero de Orden.';
comment on column IT.CB_BAL_IMPOSITIVO.descripcion
  is 'Descripcion del Rubro Contable.';
comment on column IT.CB_BAL_IMPOSITIVO.nro_pagina
  is 'Numero de Pagina.';
comment on column IT.CB_BAL_IMPOSITIVO.usu_insercion
  is 'Usuario que realizo la insercion del Registro.';
comment on column IT.CB_BAL_IMPOSITIVO.fec_insercion
  is 'Fecha en que se inserto el Registro.';
comment on column IT.CB_BAL_IMPOSITIVO.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el Registro.';
comment on column IT.CB_BAL_IMPOSITIVO.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el Registro.';
comment on column IT.CB_BAL_IMPOSITIVO.cod_rubro
  is 'Codigo de la Cuenta Contable.';
comment on column IT.CB_BAL_IMPOSITIVO.resaltar
  is 'Resaltar la Cuenta 1 o 0.';
comment on column IT.CB_BAL_IMPOSITIVO.tipo
  is 'Tipo: A Activo, P Pasivo, PA Patrimonio, R Resaltar.';
comment on column IT.CB_BAL_IMPOSITIVO.tip_rubro
  is 'Tipo de rubro.';
comment on column IT.CB_BAL_IMPOSITIVO.sum_debito
  is 'Suma debito.';
comment on column IT.CB_BAL_IMPOSITIVO.sum_credito
  is 'Suma credito.';
comment on column IT.CB_BAL_IMPOSITIVO.sal_deudor
  is 'Saldo deudor.';
comment on column IT.CB_BAL_IMPOSITIVO.sal_acreedor
  is 'Saldo acreedor.';
comment on column IT.CB_BAL_IMPOSITIVO.inv_activo
  is 'Inventario activo.';
comment on column IT.CB_BAL_IMPOSITIVO.inv_pasivo
  is 'Inventario pasivo.';
comment on column IT.CB_BAL_IMPOSITIVO.res_perdida
  is 'Resultado perdida.';
comment on column IT.CB_BAL_IMPOSITIVO.res_ganancia
  is 'Resultado ganancia.';
alter table IT.CB_BAL_IMPOSITIVO
  add constraint PK_CB_BAL_IMPOSITIVO primary key (NRO_ORDEN)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

