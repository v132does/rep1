create table IT.TA_SEG_VIDA_TMP
(
  cod_entidad         VARCHAR2(5),
  fec_cierre          DATE,
  tip_cierre          VARCHAR2(1),
  clase               VARCHAR2(2),
  afinidad            VARCHAR2(10),
  nro_cuenta          VARCHAR2(15),
  nro_tarjeta         VARCHAR2(16),
  nom_usuario         VARCHAR2(120),
  mes_ano_vencimiento VARCHAR2(6),
  mes_ano_nacimiento  VARCHAR2(8),
  edad                VARCHAR2(3),
  saldo               NUMBER(18,2),
  mto_seg_cliente     NUMBER(18,2),
  mto_seg_entidad     NUMBER(18,2),
  nro_documento       VARCHAR2(20),
  mto_iva_seg_cliente NUMBER(18,2),
  cod_moneda          NUMBER(3),
  afecta              VARCHAR2(2),
  motivo              VARCHAR2(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_SEG_VIDA_TMP
  is 'Tabla Temporal de Movimientoes Seguros Cargos de Vida(Cierre).';
