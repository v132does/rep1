create table IT.CB_RUB_PLZ_MAXIMOS
(
  cod_rubro            VARCHAR2(15) not null,
  fecha                DATE not null,
  plz_maximo           NUMBER(5),
  dia_exceso           NUMBER(5),
  sal_mon_local        NUMBER(18,2) default 0,
  sal_mon_rubro        NUMBER(18,2) default 0,
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  sal_mon_loc_anterior NUMBER(18,2) default 0,
  sal_mon_rub_anterior NUMBER(18,2) default 0
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.CB_RUB_PLZ_MAXIMOS.cod_rubro
  is 'Código de la Cuenta Contable.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.fecha
  is 'Fecha de inclusión en la tabla.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.plz_maximo
  is 'Indica el Plazo en días de Permanencia.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.dia_exceso
  is 'Días excedidios al plazo máximo.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.sal_mon_local
  is 'Saldo total en moneda local.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.sal_mon_rubro
  is 'Saldo total en moneda del rubro.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.usu_modificacion
  is 'Usuario que realizó la ultima modificación en el registro.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.fec_modificacion
  is 'Fecha en que se realizó la ultima modificación en el registro.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.sal_mon_loc_anterior
  is 'Saldo total en moneda local anterior.';
comment on column IT.CB_RUB_PLZ_MAXIMOS.sal_mon_rub_anterior
  is 'Saldo total en moneda del rubro anterior.';
alter table IT.CB_RUB_PLZ_MAXIMOS
  add constraint PK_CB_RUB_PLZ_MAXIMOS primary key (COD_RUBRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

