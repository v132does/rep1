create table IT.CR_PER_TIP_OPERACIONES
(
  cod_persona      VARCHAR2(10),
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_moneda       VARCHAR2(3),
  fec_inicio       DATE,
  fec_vencimiento  DATE,
  mto_limite       NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 10
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_PER_TIP_OPERACIONES
  is 'Tipos de Operaciones de la Persona.';
comment on column IT.CR_PER_TIP_OPERACIONES.cod_persona
  is 'Codigo de la persona.';
comment on column IT.CR_PER_TIP_OPERACIONES.cod_modulo
  is 'Modulo.';
comment on column IT.CR_PER_TIP_OPERACIONES.cod_modalidad
  is 'Modalidad.';
comment on column IT.CR_PER_TIP_OPERACIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_PER_TIP_OPERACIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_PER_TIP_OPERACIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_PER_TIP_OPERACIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CR_PER_TIP_OPERACIONES.cod_moneda
  is 'Moneda del Limite de Operacion del Cliente.';
comment on column IT.CR_PER_TIP_OPERACIONES.fec_inicio
  is 'Fecha de Inicio del Limite de Operacion.';
comment on column IT.CR_PER_TIP_OPERACIONES.fec_vencimiento
  is 'Fecha de Vencimiento del Limite de Operacion.';
comment on column IT.CR_PER_TIP_OPERACIONES.mto_limite
  is 'Monto de Limite de Operacion del Cliente.';
alter table IT.CR_PER_TIP_OPERACIONES
  add constraint UK_CR_PER_TIP_OPERACIONES unique (COD_PERSONA, COD_MODULO, COD_MODALIDAD, COD_MONEDA, FEC_INICIO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_PER_TIP_OPERACIONES
  add constraint FK_CPTOPE_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);

