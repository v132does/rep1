create table IT.CB_COR_PRO_PARAMETROS
(
  cod_rubro     VARCHAR2(15) not null,
  cod_proceso   VARCHAR2(50) not null,
  cod_parametro VARCHAR2(100) not null,
  orden         NUMBER not null,
  valor         LONG not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_COR_PRO_PARAMETROS
  add constraint PK_COR_PRO_PARAMETROS primary key (COD_RUBRO, COD_PROCESO, COD_PARAMETRO, ORDEN)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

