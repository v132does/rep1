create table IT.PR_FONDOS
(
  cod_ori_fondo      NUMBER(3) not null,
  descripcion        VARCHAR2(35) not null,
  monto              NUMBER(18,2) default 0,
  cod_moneda         VARCHAR2(3) not null,
  fec_vencimiento    DATE,
  val_tasa           NUMBER(20,4) default 0,
  mto_utilizado      NUMBER(18,2) default 0,
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  par_modalidad      VARCHAR2(2000),
  cod_tra_desembolso NUMBER(4),
  cod_tra_cobro      NUMBER(4)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_FONDOS
  is 'Origen de Fondos.';
comment on column IT.PR_FONDOS.cod_ori_fondo
  is 'Código de origen de fondo.';
comment on column IT.PR_FONDOS.descripcion
  is 'Descripción de origen de fondo.';
comment on column IT.PR_FONDOS.monto
  is 'Valor del monto.';
comment on column IT.PR_FONDOS.cod_moneda
  is 'Código de moneda.';
comment on column IT.PR_FONDOS.fec_vencimiento
  is 'Fecha de vencimiento.';
comment on column IT.PR_FONDOS.val_tasa
  is 'Valor de tasa.';
comment on column IT.PR_FONDOS.mto_utilizado
  is 'Valor utilizado.';
comment on column IT.PR_FONDOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_FONDOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_FONDOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_FONDOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_FONDOS.par_modalidad
  is 'Modalidades de Préstamos afectadas por el Origen de Fondos.';
comment on column IT.PR_FONDOS.cod_tra_desembolso
  is 'Código de Transacción de Desembolso.';
comment on column IT.PR_FONDOS.cod_tra_cobro
  is 'Código de Transacción de Cobro.';
alter table IT.PR_FONDOS
  add constraint PK_PR_FONDOS primary key (COD_ORI_FONDO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_FONDOS
  add constraint FK_PFOND_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_FONDOS
  add constraint AVCON_1080845005_COD_O_003
  check (COD_ORI_FONDO BETWEEN 1 AND 999);

