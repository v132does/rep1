create table IT.OGGCHKPT_LOX
(
  group_name         VARCHAR2(8) not null,
  group_key          NUMBER(19) not null,
  log_cmplt_csn      VARCHAR2(128) not null,
  log_cmplt_xids_seq NUMBER(5) not null,
  log_cmplt_xids     VARCHAR2(2000) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.OGGCHKPT_LOX
  add primary key (GROUP_NAME, GROUP_KEY, LOG_CMPLT_CSN, LOG_CMPLT_XIDS_SEQ)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

