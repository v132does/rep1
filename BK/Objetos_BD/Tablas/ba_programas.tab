create table IT.BA_PROGRAMAS
(
  cod_programa        VARCHAR2(30) not null,
  descripcion         VARCHAR2(60) not null,
  cod_tip_programa    NUMBER(3) default 1 not null,
  cod_modulo          NUMBER(3) not null,
  ubi_ejecutable      VARCHAR2(60) not null,
  ubi_fisico          VARCHAR2(60) not null,
  des_detallada       VARCHAR2(250),
  cod_herramienta     NUMBER(10),
  observacion         VARCHAR2(1000),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  ope_mod_cerrado     VARCHAR2(1) default 'N',
  cod_pro_equivalente VARCHAR2(30),
  documento           BLOB,
  ubi_menu            VARCHAR2(1000),
  ina_cierre          VARCHAR2(1) default 'N'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_PROGRAMAS
  is 'Contiene los programas utilizados en el Sistema de Administracion de Proyectos.';
comment on column IT.BA_PROGRAMAS.cod_programa
  is 'Codigo del Programa.';
comment on column IT.BA_PROGRAMAS.descripcion
  is 'Descripcion Breve.';
comment on column IT.BA_PROGRAMAS.cod_tip_programa
  is 'Codigo de Tipo de Programa.';
comment on column IT.BA_PROGRAMAS.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.BA_PROGRAMAS.ubi_ejecutable
  is 'Ubicacion del Ejecutable.';
comment on column IT.BA_PROGRAMAS.ubi_fisico
  is 'Ubicacion Fisca.';
comment on column IT.BA_PROGRAMAS.des_detallada
  is 'Descripcion o nombre del programa.';
comment on column IT.BA_PROGRAMAS.cod_herramienta
  is 'Codigo de Herramienta.';
comment on column IT.BA_PROGRAMAS.observacion
  is 'Observacion.';
comment on column IT.BA_PROGRAMAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_PROGRAMAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_PROGRAMAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_PROGRAMAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.BA_PROGRAMAS.ope_mod_cerrado
  is 'Opera o no con el modulo cerrado.';
comment on column IT.BA_PROGRAMAS.cod_pro_equivalente
  is 'Codigo del Programa.';
comment on column IT.BA_PROGRAMAS.documento
  is 'Documentacion visual del programa.';
comment on column IT.BA_PROGRAMAS.ubi_menu
  is 'Ubicacion en el Menu';
comment on column IT.BA_PROGRAMAS.ina_cierre
  is 'Indicador utilizado para los triggers, si es S implica que será deshabilitado durante el proceso de cierre.';
create index IT.IN_EPROG_COD_HERRAMIENTA on IT.BA_PROGRAMAS (COD_HERRAMIENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_EPROG_COD_MODULO on IT.BA_PROGRAMAS (COD_MODULO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_EPROG_COD_TIP_PROGRAMA on IT.BA_PROGRAMAS (COD_TIP_PROGRAMA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_PROGRAMAS
  add constraint PK_BA_PROGRAMAS primary key (COD_PROGRAMA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_PROGRAMAS
  add constraint FK_EPROG_COD_HERRAMIENTA foreign key (COD_HERRAMIENTA)
  references IT.AP_HERRAMIENTAS (COD_HERRAMIENTA)
  disable
  novalidate;
alter table IT.BA_PROGRAMAS
  add constraint FK_EPROG_COD_MODULO foreign key (COD_MODULO)
  references IT.BA_MODULOS (COD_MODULO);
alter table IT.BA_PROGRAMAS
  add constraint FK_EPROG_COD_TIP_PROGRAMA foreign key (COD_TIP_PROGRAMA)
  references IT.BA_TIP_PROGRAMAS (COD_TIP_PROGRAMA);
alter table IT.BA_PROGRAMAS
  add constraint AVCON_1092358390_COD_H_000
  check (COD_HERRAMIENTA BETWEEN 0 AND 999999999);
alter table IT.BA_PROGRAMAS
  add constraint AVCON_1092358390_COD_M_002
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.BA_PROGRAMAS
  add constraint AVCON_1092358390_COD_T_000
  check (COD_TIP_PROGRAMA BETWEEN 0 AND 999);
alter table IT.BA_PROGRAMAS
  add constraint CK_EPROG_INA_CIERRE
  check ((NVL(ina_cierre,'N') = 'S' AND cod_tip_programa = 7) or (NVL(ina_cierre,'N') = 'N'));

