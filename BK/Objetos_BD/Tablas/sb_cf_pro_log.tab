create table IT.SB_CF_PRO_LOG (
  ID_EJECUCION     NUMBER         NOT NULL,
  FEC_INICIO       TIMESTAMP      NOT NULL,
  FEC_FIN          TIMESTAMP,
  ESTADO           VARCHAR2(10)   NOT NULL,
  TIPO_PROCESO     VARCHAR2(20)   DEFAULT 'CF_ALTA' NOT NULL,
  FEC_CIERRE       DATE,
  TOTAL_REGISTROS  NUMBER,
  OBSERVACIONES    VARCHAR2(4000),
  USU_INSERCION    VARCHAR2(30),
  FEC_INSERCION    DATE           DEFAULT SYSDATE NOT NULL,
  USU_MODIFICACION VARCHAR2(30),
  FEC_MODIFICACION DATE,
  CONSTRAINT PK_SB_CF_PRO_LOG PRIMARY KEY (ID_EJECUCION)
) TABLESPACE IT_DATA;

COMMENT ON TABLE IT.SB_CF_PRO_LOG IS 'Log de ejecuciones BCP: CF_ALTA (Circ. SB.SG 00586/2010), CAR_PERSONAS (PRS_CAR_PERSONAS_REF), ACT_CIUDADES (PRS_ACT_REF_CIUDADES)';
COMMENT ON COLUMN IT.SB_CF_PRO_LOG.ID_EJECUCION  IS 'Identificador unico de ejecucion (SE_CF_ID_EJECUCION)';
COMMENT ON COLUMN IT.SB_CF_PRO_LOG.ESTADO         IS 'Estado del proceso: CORRIENDO / OK / ERROR';
COMMENT ON COLUMN IT.SB_CF_PRO_LOG.TIPO_PROCESO   IS 'Proceso que genero la ejecucion: CF_ALTA / CAR_PERSONAS / ACT_CIUDADES';
COMMENT ON COLUMN IT.SB_CF_PRO_LOG.FEC_CIERRE     IS 'Fecha de cierre contable (GE_CALENDARIOS.fec_anterior) - aplica solo a CF_ALTA';

CREATE PUBLIC SYNONYM SB_CF_PRO_LOG FOR IT.SB_CF_PRO_LOG;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_CF_PRO_LOG TO IT_CONSULTAS;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_CF_PRO_LOG TO IT_TEMPORAL;
