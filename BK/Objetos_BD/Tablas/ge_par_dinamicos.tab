-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.GE_PAR_DINAMICOS
  add constraint UK_GE_PAR_DINAMICOS unique (PARAMETRO, COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD, COD_OFICINA, COD_MONEDA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAR_DINAMICOS
  add constraint FK_GPDIN_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_PAR_DINAMICOS
  add constraint FK_GPDIN_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_PAR_DINAMICOS
  add constraint FK_GPDIN_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_PAR_DINAMICOS
  add constraint FK_GPDIN_COD_SUB_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD)
  references IT.GE_SUB_MODALIDADES (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD);
alter table IT.GE_PAR_DINAMICOS
  add constraint FK_GPDIN_PARAMETRO foreign key (PARAMETRO)
  references IT.GE_PARAMETROS (PARAMETRO);
-- Create/Recreate check constraints 
alter table IT.GE_PAR_DINAMICOS
  add constraint AVCON_1080843414_COD_M_003
  check (COD_MODULO BETWEEN 1 AND 999);
alter table IT.GE_PAR_DINAMICOS
  add constraint AVCON_1080843414_COD_M_004
  check (COD_MODALIDAD BETWEEN 1 AND 999);
alter table IT.GE_PAR_DINAMICOS
  add constraint AVCON_1080843414_COD_O_001
  check (COD_OFICINA BETWEEN 1 AND 999);
alter table IT.GE_PAR_DINAMICOS
  add constraint AVCON_1082582841_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_PAR_DINAMICOS
  add constraint AVCON_1082582841_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_PAR_DINAMICOS
  add constraint AVCON_1082582841_COD_O_000
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.GE_PAR_DINAMICOS
  add constraint AVCON_1085777548_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_PAR_DINAMICOS
  add constraint AVCON_1085777548_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_PAR_DINAMICOS
  add constraint AVCON_1085777548_COD_O_000
  check (COD_OFICINA BETWEEN 0 AND 999);
-- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.GE_PAR_DINAMICOS to IT_TEMPORAL;
