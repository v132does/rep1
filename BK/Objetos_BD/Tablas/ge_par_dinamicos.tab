-- Create table
create table IT.GE_PAR_DINAMICOS
(
  parametro         VARCHAR2(30) not null,
  val_parametro     VARCHAR2(2000) not null,
  cod_modulo        NUMBER(3),
  cod_modalidad     NUMBER(3),
  cod_oficina       NUMBER(3),
  cod_moneda        VARCHAR2(3),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_sub_modalidad NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 10
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.GE_PAR_DINAMICOS
  is 'Parametros dinamicos.';
-- Add comments to the columns 
comment on column IT.GE_PAR_DINAMICOS.parametro
  is 'Abreviatura del parametro.';
comment on column IT.GE_PAR_DINAMICOS.val_parametro
  is 'Valor del parametro.';
comment on column IT.GE_PAR_DINAMICOS.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.GE_PAR_DINAMICOS.cod_modalidad
  is 'Codigo de Modalidad.';
comment on column IT.GE_PAR_DINAMICOS.cod_oficina
  is 'Codigo de agencia u oficina.';
comment on column IT.GE_PAR_DINAMICOS.cod_moneda
  is 'Codigo de Moneda.';
comment on column IT.GE_PAR_DINAMICOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_PAR_DINAMICOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PAR_DINAMICOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAR_DINAMICOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAR_DINAMICOS.cod_sub_modalidad
  is 'Código de Sub Modalidad';
-- Create/Recreate indexes 
