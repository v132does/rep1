create table IT.SB_PER_REF_TMP (
    TIPO_IDENT    VARCHAR2(3)  NOT NULL,
    NRO_DOCUMENTO VARCHAR2(15),
    TIPO_PER      VARCHAR2(3),
    APELLIDO      VARCHAR2(30),
    NOMBRE        VARCHAR2(60),
    FECHA_NAC     VARCHAR2(8),
    PAIS_SWIFT    VARCHAR2(2)
) TABLESPACE IT_DATA;

CREATE INDEX IT.IN_SPERT_NRO_DOCUMENTO
  ON IT.SB_PER_REF_TMP (TIPO_IDENT, NRO_DOCUMENTO)
  TABLESPACE IT_IND;

COMMENT ON TABLE IT.SB_PER_REF_TMP IS 'Staging: padron BCP de personas (PERSONAS_BCP.DAT). Transitoria: se purga tras cada carga.';

CREATE PUBLIC SYNONYM SB_PER_REF_TMP FOR IT.SB_PER_REF_TMP;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_PER_REF_TMP TO IT_CONSULTAS;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_PER_REF_TMP TO IT_TEMPORAL;
