create table IT.GE_AUT_REVERSIONES
(
  nro_pedido          NUMBER(10) not null,
  fecha               DATE not null,
  hora                VARCHAR2(8) not null,
  cod_usuario         VARCHAR2(10) not null,
  cod_tra_padre       NUMBER(4) not null,
  cod_mod_padre       NUMBER(3) not null,
  cod_mad_padre       NUMBER(3) not null,
  nro_cuenta          VARCHAR2(15),
  cod_persona         VARCHAR2(10),
  mto_mon_fuerte      NUMBER(18,2) not null,
  cod_usu_autorizador VARCHAR2(10),
  concepto            VARCHAR2(100),
  nro_documento       NUMBER(15),
  estado              VARCHAR2(1) not null,
  observacion         VARCHAR2(1000),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  cod_oficina         NUMBER(3),
  monto               NUMBER(18,2),
  cod_moneda          VARCHAR2(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 10
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_AUT_REVERSIONES
  is 'Autorizaciones de pedidos de Reversiones del Sistema. Contiene todas las autorizaciones de pedidos de Reversión ON-LINE o previas realizadas en el Sistema.';
comment on column IT.GE_AUT_REVERSIONES.nro_pedido
  is 'Número de Pedido de Autorización.';
comment on column IT.GE_AUT_REVERSIONES.fecha
  is 'Fecha.';
comment on column IT.GE_AUT_REVERSIONES.hora
  is 'Hora.';
comment on column IT.GE_AUT_REVERSIONES.cod_usuario
  is 'Código de Operador.';
comment on column IT.GE_AUT_REVERSIONES.cod_tra_padre
  is 'Código de Transaccion Padre.';
comment on column IT.GE_AUT_REVERSIONES.cod_mod_padre
  is 'Código de Módulo Padre.';
comment on column IT.GE_AUT_REVERSIONES.cod_mad_padre
  is 'Código de Modalidad Padre.';
comment on column IT.GE_AUT_REVERSIONES.nro_cuenta
  is 'Número de Cuenta para la que se solicita la Autorización.';
comment on column IT.GE_AUT_REVERSIONES.cod_persona
  is 'Código del Titular Principal de la Cuenta.';
comment on column IT.GE_AUT_REVERSIONES.mto_mon_fuerte
  is 'Monto en moneda fuerte de la operación.';
comment on column IT.GE_AUT_REVERSIONES.cod_usu_autorizador
  is 'Código de Autorizador.';
comment on column IT.GE_AUT_REVERSIONES.concepto
  is 'Comentario para la Reversión.';
comment on column IT.GE_AUT_REVERSIONES.nro_documento
  is 'Número de Documento.';
comment on column IT.GE_AUT_REVERSIONES.estado
  is 'Estado del pedido (S=Solicitado, A=Aprobado, R=Rechazado, C=Cancelado).';
comment on column IT.GE_AUT_REVERSIONES.observacion
  is 'Observación.';
comment on column IT.GE_AUT_REVERSIONES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_AUT_REVERSIONES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_AUT_REVERSIONES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_AUT_REVERSIONES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.GE_AUT_REVERSIONES.cod_oficina
  is 'Oficina del Usuario Solicitante';
comment on column IT.GE_AUT_REVERSIONES.monto
  is 'Monto de la Operación';
comment on column IT.GE_AUT_REVERSIONES.cod_moneda
  is 'Código de Moneda de la Operación';
alter table IT.GE_AUT_REVERSIONES
  add constraint PK_GE_AUT_REVERSIONES primary key (NRO_PEDIDO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_AUT_REVERSIONES
  add constraint FK_GEARE_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_AUT_REVERSIONES
  add constraint FK_GEARE_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_AUT_REVERSIONES
  add constraint FK_GEARE_COD_USU_AUTORIZADOR foreign key (COD_USU_AUTORIZADOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_AUT_REVERSIONES
  add constraint CK_GEARE_ESTADO
  check (ESTADO IN ('S', 'C', 'A','R'));

