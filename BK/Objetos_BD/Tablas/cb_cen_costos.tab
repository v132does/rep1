create table IT.CB_CEN_COSTOS
(
  cod_cen_costo    NUMBER(3) not null,
  descripcion      VARCHAR2(60) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_CEN_COSTOS
  is 'Centros de Costo.';
comment on column IT.CB_CEN_COSTOS.cod_cen_costo
  is 'Codigo del centro de Costo.';
comment on column IT.CB_CEN_COSTOS.descripcion
  is 'Descripcion del centro de Costo.';
comment on column IT.CB_CEN_COSTOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_CEN_COSTOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_CEN_COSTOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_CEN_COSTOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CB_CEN_COSTOS
  add constraint PK_CB_CEN_COSTOS primary key (COD_CEN_COSTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

