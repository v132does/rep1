create table IT.TA_CON_BCD_TEMPORAL
(
  datos VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_CON_BCD_TEMPORAL.datos
  is 'Datos importados del archivo  - T$_AAAAMMDD.txt';

