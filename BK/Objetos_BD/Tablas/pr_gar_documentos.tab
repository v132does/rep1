create table IT.PR_GAR_DOCUMENTOS
(
  nro_garantia          NUMBER(7) not null,
  tip_documento         VARCHAR2(2) not null,
  fec_emision           DATE,
  fec_vencimiento       DATE,
  monto                 NUMBER(18,2),
  beneficiario          VARCHAR2(200),
  cod_ent_emisor        NUMBER(5),
  librador              VARCHAR2(200),
  observacion           VARCHAR2(1000),
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default SYSDATE not null,
  nro_documento         VARCHAR2(15),
  nro_secuencia         NUMBER(5),
  observacion_his       VARCHAR2(4000),
  cta_libradora         VARCHAR2(20),
  serie                 VARCHAR2(2),
  renegociado           VARCHAR2(1) default 'N',
  fec_fin_renegociacion DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_GAR_DOCUMENTOS
  is 'Garantías Documentarias.';
comment on column IT.PR_GAR_DOCUMENTOS.nro_garantia
  is 'Número de Garantía.';
comment on column IT.PR_GAR_DOCUMENTOS.tip_documento
  is 'Tipo de Documento.';
comment on column IT.PR_GAR_DOCUMENTOS.fec_emision
  is 'Fecha de Emision.';
comment on column IT.PR_GAR_DOCUMENTOS.fec_vencimiento
  is 'Fecha de Vencimiento.';
comment on column IT.PR_GAR_DOCUMENTOS.monto
  is 'Monto.';
comment on column IT.PR_GAR_DOCUMENTOS.beneficiario
  is 'A la orden de quien está.';
comment on column IT.PR_GAR_DOCUMENTOS.cod_ent_emisor
  is 'Código de Ente Emisor.';
comment on column IT.PR_GAR_DOCUMENTOS.librador
  is 'Librador del Documento.';
comment on column IT.PR_GAR_DOCUMENTOS.observacion
  is 'Observación.';
comment on column IT.PR_GAR_DOCUMENTOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_GAR_DOCUMENTOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_GAR_DOCUMENTOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_GAR_DOCUMENTOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_GAR_DOCUMENTOS.nro_documento
  is 'Número de Documento.';
comment on column IT.PR_GAR_DOCUMENTOS.nro_secuencia
  is 'Número de Secuencia.';
comment on column IT.PR_GAR_DOCUMENTOS.observacion_his
  is 'Guarda las observaciones que superaron los 1000 caracteres.';
comment on column IT.PR_GAR_DOCUMENTOS.serie
  is 'Serie del documento.';
comment on column IT.PR_GAR_DOCUMENTOS.renegociado
  is 'Documento redescontado.';
comment on column IT.PR_GAR_DOCUMENTOS.fec_fin_renegociacion
  is 'Fecha de fin de retención.';
alter table IT.PR_GAR_DOCUMENTOS
  add constraint UK_PR_GAR_DOCUMENTOS unique (NRO_GARANTIA, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_GAR_DOCUMENTOS
  add constraint FK_PGDOC_NRO_GARANTIA foreign key (NRO_GARANTIA)
  references IT.PR_GARANTIAS (NRO_GARANTIA);

