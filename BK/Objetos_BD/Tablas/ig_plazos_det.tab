create table IT.IG_PLAZOS_DET
(
  cod_plazo        NUMBER(3) not null,
  cod_moneda       VARCHAR2(3) not null,
  tas_compensacion NUMBER(6,4) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.IG_PLAZOS_DET
  is 'Detalle de Plazos para las Tasas de Compensacion x Moneda.';
comment on column IT.IG_PLAZOS_DET.cod_plazo
  is 'Codigo del plazo.';
comment on column IT.IG_PLAZOS_DET.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.IG_PLAZOS_DET.tas_compensacion
  is 'Tasa de compensacion.';
comment on column IT.IG_PLAZOS_DET.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.IG_PLAZOS_DET.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.IG_PLAZOS_DET.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.IG_PLAZOS_DET.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.IG_PLAZOS_DET
  add constraint PK_IG_PLAZOS_DET primary key (COD_PLAZO, COD_MONEDA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.IG_PLAZOS_DET
  add constraint FK_IGPDE_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.IG_PLAZOS_DET
  add constraint FK_IGPDE_COD_PLAZO foreign key (COD_PLAZO)
  references IT.IG_PLAZOS (COD_PLAZO);
alter table IT.IG_PLAZOS_DET
  add constraint AVCON_1180382033_COD_P_005
  check (COD_PLAZO BETWEEN 0 AND 999);

