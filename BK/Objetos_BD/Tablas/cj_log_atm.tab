create table IT.CJ_LOG_ATM
(
  fec_sistema       DATE,
  pedido            VARCHAR2(4000),
  respuesta         VARCHAR2(4000),
  msj_error         VARCHAR2(4000),
  fec_inicio        DATE,
  cod_extorno       VARCHAR2(2),
  fecha             DATE,
  nro_transaccion   NUMBER(15),
  nro_cta_debito    VARCHAR2(15),
  hora              VARCHAR2(8),
  cod_bco_debito    NUMBER(3),
  nro_cta_credito   VARCHAR2(15),
  cod_bco_credito   NUMBER(3),
  cod_operacion     VARCHAR2(2),
  mto_total         NUMBER(18,2),
  can_cheques       NUMBER(4),
  cod_moneda        VARCHAR2(3),
  nro_atm           NUMBER(3),
  nro_pos           NUMBER(2),
  tra_pos           NUMBER(4),
  tip_hora          VARCHAR2(3),
  nom_comercio      VARCHAR2(40),
  nro_tra_extornado VARCHAR2(15),
  cod_bco_atm       NUMBER(3),
  servicio          VARCHAR2(3),
  prestacion        VARCHAR2(4),
  marca             VARCHAR2(3),
  producto          VARCHAR2(3),
  med_pago          VARCHAR2(2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CJ_LOG_ATM
  is 'Registra todos los mensajes de Infonet que ingresaron a la base y sus respuestas.';
comment on column IT.CJ_LOG_ATM.fec_sistema
  is 'Fecha real del mensaje.';
comment on column IT.CJ_LOG_ATM.pedido
  is 'Pedido Recibido de Infonet.';
comment on column IT.CJ_LOG_ATM.respuesta
  is 'Respuesta enviada a Infonet.';
comment on column IT.CJ_LOG_ATM.msj_error
  is 'Error de la Base de Datos.';
comment on column IT.CJ_LOG_ATM.fec_inicio
  is 'Fecha de inicio de la transaccion.';
comment on column IT.CJ_LOG_ATM.cod_extorno
  is 'Código de Reversión (99).';
comment on column IT.CJ_LOG_ATM.fecha
  is 'Fecha de la Transacción.';
comment on column IT.CJ_LOG_ATM.nro_transaccion
  is 'Número único de Transacción.';
comment on column IT.CJ_LOG_ATM.nro_cta_debito
  is 'Número de Cuenta Débito.';
comment on column IT.CJ_LOG_ATM.hora
  is 'Hora de la Transacción.';
comment on column IT.CJ_LOG_ATM.cod_bco_debito
  is 'Código de entidad de Débito.';
comment on column IT.CJ_LOG_ATM.nro_cta_credito
  is 'Número Cuenta de Crédito.';
comment on column IT.CJ_LOG_ATM.cod_bco_credito
  is 'Código de Entidad Crédito.';
comment on column IT.CJ_LOG_ATM.cod_operacion
  is 'Código de Transacción.';
comment on column IT.CJ_LOG_ATM.mto_total
  is 'Importe Total de la Transacción.';
comment on column IT.CJ_LOG_ATM.can_cheques
  is 'Cantidad de Cheques solicitada.';
comment on column IT.CJ_LOG_ATM.cod_moneda
  is 'Moneda de la Transacción.';
comment on column IT.CJ_LOG_ATM.nro_atm
  is 'Nro. del ATM donde se realiza la transacción.';
comment on column IT.CJ_LOG_ATM.nro_pos
  is 'Nro. de Caja de Pos del comercio o agencia bancaria.';
comment on column IT.CJ_LOG_ATM.tra_pos
  is 'Nro. de Transacción o Nro. del ATM.';
comment on column IT.CJ_LOG_ATM.tip_hora
  is 'Flag de horario/Flag bancario.';
comment on column IT.CJ_LOG_ATM.nom_comercio
  is 'Nombre del negocio.';
comment on column IT.CJ_LOG_ATM.nro_tra_extornado
  is 'Número de boleta a reversar.';
comment on column IT.CJ_LOG_ATM.cod_bco_atm
  is 'Entidad dueña del ATM.';
comment on column IT.CJ_LOG_ATM.servicio
  is 'Servicio (ATM, POS, ..)';
comment on column IT.CJ_LOG_ATM.prestacion
  is 'PrestaciÃ³n (TD, TC, STAR)';
comment on column IT.CJ_LOG_ATM.marca
  is 'Marca (VS, MC, INF, ENT)';
comment on column IT.CJ_LOG_ATM.producto
  is 'Producto de la Marca (CLA, MST, ELE, PMO)';
comment on column IT.CJ_LOG_ATM.med_pago
  is 'Medio de Pago (00-Efectivo, 01-Tarjeta CrÃ©dito, 02-Tarjeta DÃ©bito)';
create index IT.IN_CLATM_FEC_SISTEMA on IT.CJ_LOG_ATM (FEC_SISTEMA)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );

