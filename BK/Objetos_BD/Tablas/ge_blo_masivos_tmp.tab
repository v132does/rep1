create table IT.GE_BLO_MASIVOS_TMP
(
  fecha       DATE,
  cod_persona VARCHAR2(10),
  linea       VARCHAR2(2000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_BLO_MASIVOS_TMP
  is 'Bloqueos Masivos a Clientes provenientes de RBAKYC.';

