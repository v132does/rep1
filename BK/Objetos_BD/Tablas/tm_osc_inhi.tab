create table IT.TM_OSC_INHI
(
  nro_secuencia VARCHAR2(6),
  nro_circular  VARCHAR2(8),
  ano_circular  VARCHAR2(4),
  codigo_banco  VARCHAR2(4),
  tipo_document VARCHAR2(4),
  nro_documento VARCHAR2(25),
  nombre1       VARCHAR2(70),
  nombre2       VARCHAR2(25),
  nombre3       VARCHAR2(25),
  apellido1     VARCHAR2(25),
  apellido2     VARCHAR2(25),
  apellido_casa VARCHAR2(25),
  causal        VARCHAR2(5),
  multa         VARCHAR2(17),
  inhab_por     VARCHAR2(3),
  fecha_circula VARCHAR2(8),
  moneda        VARCHAR2(4)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TM_OSC_INHI
  is 'Tabla temporal de Inhibiciones OSC.';
comment on column IT.TM_OSC_INHI.nro_secuencia
  is 'Numero de Secuencia.';
comment on column IT.TM_OSC_INHI.nro_circular
  is 'Numero de Circular.';
comment on column IT.TM_OSC_INHI.ano_circular
  is 'Año de Circular.';
comment on column IT.TM_OSC_INHI.codigo_banco
  is 'Codigo de Banco.';
comment on column IT.TM_OSC_INHI.tipo_document
  is 'Tipo de Documento.';
comment on column IT.TM_OSC_INHI.nro_documento
  is 'Numero de Documento.';
comment on column IT.TM_OSC_INHI.nombre1
  is 'Primer Nombre.';
comment on column IT.TM_OSC_INHI.nombre2
  is 'Segundo Nombre.';
comment on column IT.TM_OSC_INHI.nombre3
  is 'Tercer Nombre.';
comment on column IT.TM_OSC_INHI.apellido1
  is 'Primer Apellido.';
comment on column IT.TM_OSC_INHI.apellido2
  is 'Segundo Apellido.';
comment on column IT.TM_OSC_INHI.apellido_casa
  is 'Apellido de Casado.';
comment on column IT.TM_OSC_INHI.causal
  is 'Codigo de Causa de la Inhibicion.';
comment on column IT.TM_OSC_INHI.multa
  is 'Multa.';
comment on column IT.TM_OSC_INHI.inhab_por
  is 'Inhabilitado por.';
comment on column IT.TM_OSC_INHI.fecha_circula
  is 'Fecha de la Circular.';
comment on column IT.TM_OSC_INHI.moneda
  is 'Moneda.';

