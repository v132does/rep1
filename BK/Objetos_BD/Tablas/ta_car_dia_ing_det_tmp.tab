create table IT.TA_CAR_DIA_ING_DET_TMP
(
  tip_registro      NUMBER(1),
  tip_operacion     NUMBER(1),
  cod_ent_emisora   VARCHAR2(5),
  suc_ent_emisora   VARCHAR2(5),
  cod_ent_cobradora VARCHAR2(5),
  suc_ent_cobradora VARCHAR2(5),
  cod_moneda        VARCHAR2(2),
  comprobante       VARCHAR2(10),
  fec_movimiento    VARCHAR2(8),
  nro_cuenta        VARCHAR2(10),
  importe           NUMBER(15,2),
  con_ajuste        VARCHAR2(5),
  deb_o_cred        VARCHAR2(1),
  fec_presentacion  VARCHAR2(8),
  fec_aplicacion    VARCHAR2(8),
  fec_cie_cta_cte   VARCHAR2(8),
  filler_1          VARCHAR2(5),
  filler_2          VARCHAR2(12),
  gru_cie_codigo    VARCHAR2(5),
  filler_3          VARCHAR2(3),
  filler_4          VARCHAR2(100),
  filler_5          VARCHAR2(78)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_CAR_DIA_ING_DET_TMP
  is 'Detalle importacion archivo T3052 GP';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.tip_registro
  is '2 - Detalle
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.tip_operacion
  is 'Tipo de Operación.  2= Cargo
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.cod_ent_emisora
  is 'Código asignado a la Entidad Otorgante.
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.suc_ent_emisora
  is 'Código asignado a la Sucursal del socio
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.cod_ent_cobradora
  is 'Código asignado a la Entidad Otorgante.
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.suc_ent_cobradora
  is 'Código asignado a la Sucursal del socio
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.cod_moneda
  is 'Local = 1, Dólares = 2
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.comprobante
  is 'Numero de comprobante asignado por el sistema.
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.fec_movimiento
  is 'Fecha de Movimiento
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.nro_cuenta
  is 'Número de cuenta del socio
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.importe
  is 'Importe del cargo
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.con_ajuste
  is 'Código de Concepto del cargo
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.deb_o_cred
  is '0- Debito / 1 - Credito
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.fec_presentacion
  is 'Fecha de proceso del cargo.
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.fec_aplicacion
  is 'Fecha de apliación del cargo.
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.fec_cie_cta_cte
  is 'Fecha de cierre del periodo en cual se liquida el cargo
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.filler_1
  is 'Campo no validable
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.filler_2
  is 'Campo no validable
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.gru_cie_codigo
  is 'Se informa 6
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.filler_3
  is 'Campo no validable
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.filler_4
  is 'Campo no validable
';
comment on column IT.TA_CAR_DIA_ING_DET_TMP.filler_5
  is 'Espacios';
create index IT.IN_TACAR_DIA_TMP on IT.TA_CAR_DIA_ING_DET_TMP (NRO_CUENTA, FEC_MOVIMIENTO, COMPROBANTE)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

