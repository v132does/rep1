create table IT.CB_MOV_PROCESADORA
(
  nro_cuenta         VARCHAR2(15),
  adherente          NUMBER(2),
  emision            NUMBER(2),
  nom_entidad        VARCHAR2(26),
  nom_cliente        VARCHAR2(35),
  ban_credito        NUMBER(3),
  nro_atm_caja       NUMBER(4),
  nom_comercio       VARCHAR2(26),
  monto              NUMBER(18,2),
  cod_moneda         VARCHAR2(3),
  fecha              DATE,
  hora               VARCHAR2(8),
  cod_respuesta      NUMBER(2),
  ind_conclusion     VARCHAR2(1),
  nro_referencia     NUMBER(10),
  raz_social         VARCHAR2(26),
  cod_operacion      NUMBER(2),
  des_operacion      VARCHAR2(40),
  est_conciliado     VARCHAR2(1),
  mes                NUMBER(2),
  ano                NUMBER(4),
  ubicacion          VARCHAR2(35),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  conciliable        VARCHAR2(1),
  fec_hor_movimiento DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.CB_MOV_PROCESADORA.est_conciliado
  is 'S=Si Encontrado.';
comment on column IT.CB_MOV_PROCESADORA.ubicacion
  is 'Lugar donde fue ubicado.';
comment on column IT.CB_MOV_PROCESADORA.usu_insercion
  is 'Usuario que realizo la Insercion del Registro.';
comment on column IT.CB_MOV_PROCESADORA.fec_insercion
  is 'Fecha en que se Inserto el Registro.';
comment on column IT.CB_MOV_PROCESADORA.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_MOV_PROCESADORA.fec_modificacion
  is 'Fecha en que se realizo la Ultima Modificacion en el Registro.';
comment on column IT.CB_MOV_PROCESADORA.conciliable
  is 'S-Es conciliable N-No es conciliable.';
comment on column IT.CB_MOV_PROCESADORA.fec_hor_movimiento
  is 'fecha y hora del movimiento.';
create index IT.IN_CBPRO_ANO1 on IT.CB_MOV_PROCESADORA (ANO, MES, COD_OPERACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CBPRO_NRO_REFERENCIA1 on IT.CB_MOV_PROCESADORA (NRO_REFERENCIA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

