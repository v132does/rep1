create table IT.GE_RUB_ECONOMICOS
(
  cod_rub_economico VARCHAR2(6) not null,
  descripcion       VARCHAR2(60) not null,
  cod_act_interna   VARCHAR2(15),
  referencia        NUMBER(3) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_RUB_ECONOMICOS
  is 'Rubros económicos de la persona.';
comment on column IT.GE_RUB_ECONOMICOS.cod_rub_economico
  is 'Código de Rubro Económico.';
comment on column IT.GE_RUB_ECONOMICOS.descripcion
  is 'Descripción de Rubro Económico.';
comment on column IT.GE_RUB_ECONOMICOS.cod_act_interna
  is 'Código de la Actividad Interna.';
comment on column IT.GE_RUB_ECONOMICOS.referencia
  is 'Código de Referencia.';
comment on column IT.GE_RUB_ECONOMICOS.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.GE_RUB_ECONOMICOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_RUB_ECONOMICOS.usu_modificacion
  is 'Usuario que realizó la última modificación del registro.';
comment on column IT.GE_RUB_ECONOMICOS.fec_modificacion
  is 'Usuario que realizó la última modificación del registro.';
alter table IT.GE_RUB_ECONOMICOS
  add constraint PK_GE_RUB_ECONOMICOS primary key (COD_RUB_ECONOMICO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_RUB_ECONOMICOS
  add constraint FK_GRECO_COD_ACT_INTERNA foreign key (COD_ACT_INTERNA)
  references IT.GE_ACT_INTERNAS (COD_ACT_INTERNA);
alter table IT.GE_RUB_ECONOMICOS
  add constraint FK_GRECO_REFERENCIA foreign key (REFERENCIA)
  references IT.GE_ACTIVIDADES (COD_ACTIVIDAD);

