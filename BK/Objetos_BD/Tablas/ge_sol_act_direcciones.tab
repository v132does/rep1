create table IT.GE_SOL_ACT_DIRECCIONES
(
  nro_solicitud    NUMBER(15) not null,
  cod_persona      VARCHAR2(10) not null,
  cod_direccion    NUMBER(3) not null,
  tipo             VARCHAR2(1) not null,
  principal        VARCHAR2(1) default 'N' not null,
  direccion        VARCHAR2(80) not null,
  numero           VARCHAR2(8),
  dir_lateral      VARCHAR2(50),
  edificio         VARCHAR2(35),
  piso             VARCHAR2(8),
  departamento     VARCHAR2(8),
  cod_pais         NUMBER(3) not null,
  cod_ciudad       NUMBER(3),
  cod_barrio       NUMBER(4),
  cod_postal       VARCHAR2(10),
  observacion      VARCHAR2(1000),
  tip_modificacion VARCHAR2(1) default 'N' not null,
  det_modificacion CLOB,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SOL_ACT_DIRECCIONES
  is 'Solicitud de Actualización de Direcciones de la Persona.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.nro_solicitud
  is 'Numero de Solicitud';
comment on column IT.GE_SOL_ACT_DIRECCIONES.cod_persona
  is 'Codigo de Persona.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.cod_direccion
  is 'Numero de direcciones por cada Persona.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.tipo
  is 'Tipo de Direccion. (P=Particular, L=Laboral, C=Chequera en Casa, M=Marketing, O=Otra).';
comment on column IT.GE_SOL_ACT_DIRECCIONES.principal
  is 'Indica si es Direccion default o principal (S=SI / N= NO).';
comment on column IT.GE_SOL_ACT_DIRECCIONES.direccion
  is 'Direccion o Nombre de la Calle.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.numero
  is 'Numero o altura de la vivienda en la Calle.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.dir_lateral
  is 'Dirección lateral';
comment on column IT.GE_SOL_ACT_DIRECCIONES.edificio
  is 'Edificio y Bloque o Cuerpo.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.piso
  is 'Piso del Departamento en el Edificio.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.departamento
  is 'Numero o Identificador del Departamento.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.cod_pais
  is 'Codigo de Pais.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.cod_ciudad
  is 'Codigo de Ciudad.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.cod_barrio
  is 'Codigo de Barrio.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.cod_postal
  is 'Codigo Postal.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.observacion
  is 'Observacion de la Direccion.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.tip_modificacion
  is 'I=Insercion; M=Modificacion; E; Eliminacion; N=iNsercion iNicial';
comment on column IT.GE_SOL_ACT_DIRECCIONES.det_modificacion
  is 'Detalle del cambio realizado';
comment on column IT.GE_SOL_ACT_DIRECCIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_SOL_ACT_DIRECCIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IND_GSADIR_PAIS on IT.GE_SOL_ACT_DIRECCIONES (COD_PAIS, COD_CIUDAD, COD_BARRIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IND_GSADIR_PAIS_CIU on IT.GE_SOL_ACT_DIRECCIONES (COD_CIUDAD, COD_PAIS)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IND_GSADIR_PERSONAS on IT.GE_SOL_ACT_DIRECCIONES (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_ACT_DIRECCIONES
  add constraint PK_GE_SOL_ACT_DIRECCIONES primary key (NRO_SOLICITUD, COD_PERSONA, COD_DIRECCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 9M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_ACT_DIRECCIONES
  add constraint FK_GSADIR_COD_BARRIO foreign key (COD_PAIS, COD_CIUDAD, COD_BARRIO)
  references IT.BA_BARRIOS (COD_PAIS, COD_CIUDAD, COD_BARRIO);
alter table IT.GE_SOL_ACT_DIRECCIONES
  add constraint FK_GSADIR_COD_CIUDAD foreign key (COD_CIUDAD, COD_PAIS)
  references IT.BA_CIUDADES (COD_CIUDAD, COD_PAIS);
alter table IT.GE_SOL_ACT_DIRECCIONES
  add constraint FK_GSADIR_NRO_SOLICITUD foreign key (NRO_SOLICITUD)
  references IT.GE_SOL_ACT_DATOS (NRO_SOLICITUD);
alter table IT.GE_SOL_ACT_DIRECCIONES
  add constraint AVCON_GSADIR_COD_DIR
  check (COD_DIRECCION BETWEEN 0 AND 999);
alter table IT.GE_SOL_ACT_DIRECCIONES
  add constraint AVCON_GSADIR_PRINCIPAL
  check (PRINCIPAL IN ('S', 'N'));

