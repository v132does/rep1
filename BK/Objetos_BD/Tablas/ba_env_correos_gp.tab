create table IT.BA_ENV_CORREOS_GP
(
  nro_correo       NUMBER not null,
  cod_persona      VARCHAR2(10) not null,
  tip_producto     NUMBER not null,
  estado           VARCHAR2(1) default 'P' not null,
  fec_registro     DATE default sysdate not null,
  fec_envio        DATE,
  msj_error        VARCHAR2(4000),
  parametros       LONG,
  usu_insercion    VARCHAR2(10) default substr(user,1,10) not null,
  fec_insercion    DATE default sysdate not null,
  usu_modificacion VARCHAR2(10) default substr(user,1,10) not null,
  fec_modificacion DATE default sysdate not null,
  mai_destinatario VARCHAR2(80) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_ENV_CORREOS_GP
  is 'Registro de mails a enviar a los clientes';
comment on column IT.BA_ENV_CORREOS_GP.nro_correo
  is 'contador de correos por persona';
comment on column IT.BA_ENV_CORREOS_GP.cod_persona
  is 'codigo de persona ITGF';
comment on column IT.BA_ENV_CORREOS_GP.tip_producto
  is 'tipo de producto';
comment on column IT.BA_ENV_CORREOS_GP.estado
  is 'estados (P)pendiente (S)enviado (E)error';
comment on column IT.BA_ENV_CORREOS_GP.fec_registro
  is 'fecha de registro';
comment on column IT.BA_ENV_CORREOS_GP.fec_envio
  is 'fecha de envio del mensaje';
comment on column IT.BA_ENV_CORREOS_GP.msj_error
  is 'mensaje de error';
comment on column IT.BA_ENV_CORREOS_GP.parametros
  is 'json con los datos para armar el mensaje';
comment on column IT.BA_ENV_CORREOS_GP.mai_destinatario
  is 'Correo del destinatario';
alter table IT.BA_ENV_CORREOS_GP
  add constraint PK_BA_ENV_CORREOS_GP primary key (COD_PERSONA, TIP_PRODUCTO, FEC_REGISTRO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

