create table IT.GE_SNP_PAR_MENSAJES
(
  cod_msj_swift             NUMBER(3) not null,
  cod_tip_operacion         VARCHAR2(3) not null,
  cod_sub_tip_operacion     VARCHAR2(3) not null,
  prioridad                 NUMBER(3),
  descripcion               VARCHAR2(60) not null,
  cod_periodo               NUMBER(2),
  cod_periodo2              NUMBER(2),
  cod_periodo3              NUMBER(2),
  cod_modulo                NUMBER(3),
  cod_modalidad             NUMBER(3),
  cod_tra_emitido           NUMBER(4),
  cod_tra_recibido          NUMBER(4),
  usu_insercion             VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion             DATE default SYSDATE not null,
  usu_modificacion          VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion          DATE default SYSDATE not null,
  cod_tip_cir_emitido       NUMBER(3),
  cod_tip_cir_recibido      NUMBER(3),
  cod_tip_cir_rec_reversado NUMBER(3),
  cod_tra_padre             NUMBER(4),
  tipo                      VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SNP_PAR_MENSAJES
  is 'Parámetros de Mensajes.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_msj_swift
  is 'Código del Mensaje Swift.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_tip_operacion
  is 'Código de Tipo Operación.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_sub_tip_operacion
  is 'Código Sub Tipo de Operación.';
comment on column IT.GE_SNP_PAR_MENSAJES.prioridad
  is 'Prioridad del Mensaje Swift.';
comment on column IT.GE_SNP_PAR_MENSAJES.descripcion
  is 'Descripción del parámetro.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_periodo
  is 'Horario BCP establecido por el Tipo de Operación.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_periodo2
  is 'Horario adicional BCP establecido por el Tipo de Operación.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_periodo3
  is 'Horario adicional BCP establecido por el Tipo de Operación.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_modulo
  is 'Módulo de la Transacción Emitido/Recibido.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_modalidad
  is 'Modalidad de la Transacción Emitido/Recibido.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_tra_emitido
  is 'Transacción para Mensajes Emitidos.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_tra_recibido
  is 'Transacción para Mensajes Recibidos.';
comment on column IT.GE_SNP_PAR_MENSAJES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_SNP_PAR_MENSAJES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_SNP_PAR_MENSAJES.usu_modificacion
  is 'Usuario que realizó la ultima modificación en el registro.';
comment on column IT.GE_SNP_PAR_MENSAJES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_tip_cir_emitido
  is 'Código tipo de circuito de workflow para Mensajes Emitidos.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_tip_cir_recibido
  is 'Código tipo de circuito de workflow para Mensajes Recibidos.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_tip_cir_rec_reversado
  is 'Código tipo de circuito de workflow para Mensajes Recibidos Reversados.';
comment on column IT.GE_SNP_PAR_MENSAJES.cod_tra_padre
  is 'Código del Transacción Padre para mostrar distinto en el extracto';
comment on column IT.GE_SNP_PAR_MENSAJES.tipo
  is 'Indica Tipo de mensaje para SPI';
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint PK_GE_SNP_PAR_MENSAJES primary key (COD_MSJ_SWIFT, COD_TIP_OPERACION, COD_SUB_TIP_OPERACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint UK_GE_SNP_PAR_MENSAJES unique (COD_MSJ_SWIFT, COD_TIP_OPERACION, COD_SUB_TIP_OPERACION, COD_TRA_PADRE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint FK_GSPME_COD_PERIODO foreign key (COD_PERIODO)
  references IT.GE_SNP_HORARIOS (COD_PERIODO);
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint FK_GSPME_COD_PERIODO2 foreign key (COD_PERIODO2)
  references IT.GE_SNP_HORARIOS (COD_PERIODO);
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint FK_GSPME_COD_PERIODO3 foreign key (COD_PERIODO3)
  references IT.GE_SNP_HORARIOS (COD_PERIODO);
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint FK_GSPME_COD_TIP_CIR_EMITIDO foreign key (COD_TIP_CIR_EMITIDO)
  references IT.WF_TIP_CIRCUITOS (COD_TIP_CIRCUITO);
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint FK_GSPME_COD_TIP_CIR_RECIBIDO foreign key (COD_TIP_CIR_RECIBIDO)
  references IT.WF_TIP_CIRCUITOS (COD_TIP_CIRCUITO);
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint FK_GSPME_COD_TIP_CIR_REC_REV foreign key (COD_TIP_CIR_REC_REVERSADO)
  references IT.WF_TIP_CIRCUITOS (COD_TIP_CIRCUITO);
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint FK_GSPME_COD_TRA_EMITIDO foreign key (COD_TRA_EMITIDO, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint FK_GSPME_COD_TRA_RECIBIDO foreign key (COD_TRA_RECIBIDO, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_SNP_PAR_MENSAJES
  add constraint CK_GSPME_RANGO_PRIORIDAD
  check (PRIORIDAD BETWEEN 0 AND 100);

