create table IT.PR_DOCUMENTOS
(
  documento         VARCHAR2(15) not null,
  cod_moneda        VARCHAR2(3) not null,
  monto             NUMBER(18,2) default 0 not null,
  fec_emision       DATE,
  fec_vencimiento   DATE not null,
  nro_referencia    VARCHAR2(15) not null,
  nro_cuota         NUMBER(3),
  estado            VARCHAR2(1) default 'C' not null,
  cod_tip_documento NUMBER(3) not null,
  nro_documento     VARCHAR2(20) not null,
  nom_completo      VARCHAR2(120) not null,
  observaciones     VARCHAR2(100),
  fec_proceso       DATE,
  mot_entrega       VARCHAR2(1),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_DOCUMENTOS
  is 'Detalle de Documentos de Préstamos.';
comment on column IT.PR_DOCUMENTOS.documento
  is 'Número de Documento.';
comment on column IT.PR_DOCUMENTOS.cod_moneda
  is 'Código de Moneda del Importe.';
comment on column IT.PR_DOCUMENTOS.monto
  is 'Monto del Documento.';
comment on column IT.PR_DOCUMENTOS.fec_emision
  is 'Fecha de Emisión.';
comment on column IT.PR_DOCUMENTOS.fec_vencimiento
  is 'Fecha de Vencimiento del Documento.';
comment on column IT.PR_DOCUMENTOS.nro_referencia
  is 'Número de Cuenta o Propuesta Relacionada.';
comment on column IT.PR_DOCUMENTOS.nro_cuota
  is 'Número de cuota si es préstamos.';
comment on column IT.PR_DOCUMENTOS.estado
  is 'Estado del documento (C=custodia, E=entregar, D=Descontado, I=ingresado).';
comment on column IT.PR_DOCUMENTOS.cod_tip_documento
  is 'Código de Tipo de Documento del librador.';
comment on column IT.PR_DOCUMENTOS.nro_documento
  is 'Número de Documento de la Persona.';
comment on column IT.PR_DOCUMENTOS.nom_completo
  is 'Nombre del Librador del documento.';
comment on column IT.PR_DOCUMENTOS.observaciones
  is 'Observaciones.';
comment on column IT.PR_DOCUMENTOS.fec_proceso
  is 'Fecha de Proceso.';
comment on column IT.PR_DOCUMENTOS.mot_entrega
  is 'Motivo de entrega del documento (C=pedido por el cliente, I=instrucción comercial).';
comment on column IT.PR_DOCUMENTOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_DOCUMENTOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_DOCUMENTOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_DOCUMENTOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_PDOCU_NRO_REFERENCIA on IT.PR_DOCUMENTOS (NRO_REFERENCIA, NRO_CUOTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 512K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_DOCUMENTOS
  add constraint FK_PDOCU_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_DOCUMENTOS
  add constraint FK_PDOCU_COD_TIP_DOCUMENTO foreign key (COD_TIP_DOCUMENTO)
  references IT.BA_TIP_DOCUMENTOS (COD_TIP_DOCUMENTO);

