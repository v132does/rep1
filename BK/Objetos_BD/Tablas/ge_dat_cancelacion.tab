    maxextents unlimited
  );
create index IT.IND_NRO_CTA_EST_1 on IT.GE_DAT_CANCELACION (NRO_CUENTA, ESTADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_DAT_CANCELACION
  add constraint PK_NRO_CTA_MIG_1 primary key (NRO_CUENTA);

