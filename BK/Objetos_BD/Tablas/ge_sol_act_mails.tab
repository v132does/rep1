create table IT.GE_SOL_ACT_MAILS
(
  nro_solicitud    NUMBER(15) not null,
  cod_persona      VARCHAR2(10) not null,
  tipo             VARCHAR2(1) not null,
  dir_correo       VARCHAR2(319) not null,
  principal        VARCHAR2(1) default 'N' not null,
  observacion      VARCHAR2(1000),
  dir_correo_ant   VARCHAR2(319),
  tipo_ant         VARCHAR2(1),
  tip_modificacion VARCHAR2(1) default 'N' not null,
  det_modificacion CLOB,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SOL_ACT_MAILS
  is 'Solicitud de actualización de mails de la persona.';
comment on column IT.GE_SOL_ACT_MAILS.nro_solicitud
  is 'Número de Solicitud';
comment on column IT.GE_SOL_ACT_MAILS.cod_persona
  is 'Codigo de la Persona.';
comment on column IT.GE_SOL_ACT_MAILS.tipo
  is 'Tipo de Mail (L=Laboral / P= Particular / C= Canales).';
comment on column IT.GE_SOL_ACT_MAILS.dir_correo
  is 'Direccion de Correo Electronico.';
comment on column IT.GE_SOL_ACT_MAILS.principal
  is 'Indica si el telefono es default (S=SI / N=NO).';
comment on column IT.GE_SOL_ACT_MAILS.observacion
  is 'Observacion.';
comment on column IT.GE_SOL_ACT_MAILS.dir_correo_ant
  is 'Direccion de Correo Electronico Anterior al cambio';
comment on column IT.GE_SOL_ACT_MAILS.tipo_ant
  is 'Tipo de Mail Anterior al cambio';
comment on column IT.GE_SOL_ACT_MAILS.tip_modificacion
  is 'I=Insercion; M=Modificacion; E; Eliminacion; N=iNsercion iNicial';
comment on column IT.GE_SOL_ACT_MAILS.det_modificacion
  is 'Detalle del cambio realizado';
comment on column IT.GE_SOL_ACT_MAILS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_SOL_ACT_MAILS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_SOL_ACT_MAILS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_SOL_ACT_MAILS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IND_GSAM_PERSONA on IT.GE_SOL_ACT_MAILS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_ACT_MAILS
  add constraint PK_GE_SOL_ACT_MAILS primary key (NRO_SOLICITUD, COD_PERSONA, DIR_CORREO, TIPO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_ACT_MAILS
  add constraint FK_GSAM_NRO_SOLICITUD foreign key (NRO_SOLICITUD)
  references IT.GE_SOL_ACT_DATOS (NRO_SOLICITUD);
alter table IT.GE_SOL_ACT_MAILS
  add constraint AVCON_GSAM_PRINC_000
  check (PRINCIPAL IN ('S', 'N'));

