create table IT.PV_COMPRAS
(
  cod_compra         NUMBER(10) not null,
  fecha              DATE not null,
  cod_ent_proveedor  NUMBER(5) not null,
  nro_factura        VARCHAR2(20) not null,
  tip_comprobante    VARCHAR2(1) default 'F' not null,
  timbrado           VARCHAR2(20),
  ruc                VARCHAR2(20),
  tip_venta          VARCHAR2(2) default 'CO' not null,
  iva_discriminado   VARCHAR2(1),
  concepto           VARCHAR2(35) not null,
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  ind_pagado         VARCHAR2(1) default 'N' not null,
  for_pago           VARCHAR2(1) default 'C' not null,
  cod_moneda         VARCHAR2(3) not null,
  nom_proveedor      VARCHAR2(120),
  cod_cau_anulacion  NUMBER(3),
  cotizacion         NUMBER(14,4),
  fec_pago           DATE,
  nro_recibo         NUMBER(7),
  nro_cta_referencia VARCHAR2(15),
  fec_val_timbrado   DATE,
  iva_incluido       VARCHAR2(1) default 'N' not null,
  tot_compra         NUMBER(18,2) default 0 not null,
  tot_impuesto       NUMBER(18,2) default 0,
  estado             VARCHAR2(1) default 'I' not null,
  fec_cam_estado     DATE default SYSDATE not null,
  mto_mon_pago       NUMBER(18,2) default 0 not null,
  cod_mon_pago       VARCHAR2(3) not null,
  cod_ofi_origen     NUMBER(3),
  act_cuota          NUMBER(3),
  url_crm            VARCHAR2(3000),
  tip_emision        VARCHAR2(1) default 'F' not null,
  nro_ref_timbrado   VARCHAR2(20),
  nro_ref_factura    VARCHAR2(20),
  can_cuotas         NUMBER(5),
  ind_caj_chica      VARCHAR2(1),
  fec_vto_credito    DATE,
  ind_fac_virtual    VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PV_COMPRAS
  is 'Compras a Proveedores.';
comment on column IT.PV_COMPRAS.cod_compra
  is 'Codigo de la Compra.';
comment on column IT.PV_COMPRAS.fecha
  is 'Fecha de la Compra.';
comment on column IT.PV_COMPRAS.cod_ent_proveedor
  is 'Codigo de entidad del Proveedor.';
comment on column IT.PV_COMPRAS.nro_factura
  is 'Numero de la factura de compra.';
comment on column IT.PV_COMPRAS.tip_comprobante
  is 'Tipo de Comprobante: Factura, Boleta de Venta, Ticket, Recibo, etc.';
comment on column IT.PV_COMPRAS.timbrado
  is 'Numero de Timbrado de la Factura.';
comment on column IT.PV_COMPRAS.ruc
  is 'Registro Unico del Contribuyente.';
comment on column IT.PV_COMPRAS.tip_venta
  is 'Condicion de Venta (COntado, CRedito).';
comment on column IT.PV_COMPRAS.iva_discriminado
  is 'Iva discriminado';
comment on column IT.PV_COMPRAS.concepto
  is 'Descripcion de la Factura.';
comment on column IT.PV_COMPRAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.PV_COMPRAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.PV_COMPRAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.PV_COMPRAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.PV_COMPRAS.ind_pagado
  is 'Indica si la compra ya fue pagada (S/N).';
comment on column IT.PV_COMPRAS.for_pago
  is 'Forma Pago: ''C''redito en cuenta, Cheque ''G''erencia, ''E''fectivo, ''R''ubro contable.';
comment on column IT.PV_COMPRAS.cod_moneda
  is 'Codigo de la Moneda.';
comment on column IT.PV_COMPRAS.nom_proveedor
  is 'Nombre del Proveedor si no esta identificado en la base.';
comment on column IT.PV_COMPRAS.cod_cau_anulacion
  is 'Causa de Anulacion de la factura.';
comment on column IT.PV_COMPRAS.cotizacion
  is 'Cotizacion de la Moneda.';
comment on column IT.PV_COMPRAS.fec_pago
  is 'Fecha estimada de pago.';
comment on column IT.PV_COMPRAS.nro_recibo
  is 'Nro. de recibo de pago.';
comment on column IT.PV_COMPRAS.nro_cta_referencia
  is 'Nro. de Cuenta de Credito o Codigo de Rubro Contable.';
comment on column IT.PV_COMPRAS.fec_val_timbrado
  is 'Fecha de validez del timbrao';
comment on column IT.PV_COMPRAS.iva_incluido
  is 'Indica si el IVA esta incluido en el monto (S/N).';
comment on column IT.PV_COMPRAS.tot_compra
  is 'Total de Compra';
comment on column IT.PV_COMPRAS.tot_impuesto
  is 'Total de IVA';
comment on column IT.PV_COMPRAS.estado
  is 'Estado de la Factura: Ingresado, Aprobado, aNulado., P-pagado';
comment on column IT.PV_COMPRAS.fec_cam_estado
  is 'Fecha de cambio de estado.';
comment on column IT.PV_COMPRAS.mto_mon_pago
  is 'Monto de la Compra expresado en la Moneda de Pago.';
comment on column IT.PV_COMPRAS.cod_mon_pago
  is 'Codigo de la Moneda de Pago.';
comment on column IT.PV_COMPRAS.cod_ofi_origen
  is 'Oficina donde ingreso la factura';
comment on column IT.PV_COMPRAS.act_cuota
  is 'Numero de Cuota que indica Activacion de Bien para el caso de Factura Credito';
comment on column IT.PV_COMPRAS.url_crm
  is 'Url acceso a la solicitud de pago a proveedor en CRM';
comment on column IT.PV_COMPRAS.tip_emision
  is 'Tipo de emision ''F''-Fisica ''E''-Electronica ''V''irtual';
comment on column IT.PV_COMPRAS.nro_ref_timbrado
  is 'Numero de Referencia de Timbrado';
comment on column IT.PV_COMPRAS.nro_ref_factura
  is 'Numero de Referencia de Factura';
comment on column IT.PV_COMPRAS.can_cuotas
  is 'Cantidad de Cuotas de la Compra.';
comment on column IT.PV_COMPRAS.ind_caj_chica
  is 'Indicador de caja chica.';
comment on column IT.PV_COMPRAS.fec_vto_credito
  is 'Fecha de vencimiento.';
comment on column IT.PV_COMPRAS.ind_fac_virtual
  is 'Indica si la Factura: P /Preimpreso, E/Comprobante Electronico, V/Comprobante Virtual .';
alter table IT.PV_COMPRAS
  add constraint PK_PV_COMPRAS primary key (COD_COMPRA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PV_COMPRAS
  add constraint UK_KCOM_COD_ENTE unique (COD_ENT_PROVEEDOR, NOM_PROVEEDOR, TIP_COMPROBANTE, TIMBRADO, NRO_FACTURA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PV_COMPRAS
  add constraint FK_KCOM_COD_CAU_ANULACION foreign key (COD_CAU_ANULACION)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.PV_COMPRAS
  add constraint FK_KCOM_COD_ENTE foreign key (COD_ENT_PROVEEDOR)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.PV_COMPRAS
  add constraint FK_KCOM_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PV_COMPRAS
  add constraint AVCON_1204574946_IND_P_000
  check (IND_PAGADO IN ('S', 'N'));
alter table IT.PV_COMPRAS
  add constraint AVCON_1204574946_TIP_C_000
  check (TIP_COMPROBANTE IN ('F', 'B','K','L','T','Z','E','N'));
alter table IT.PV_COMPRAS
  add constraint CK_FOR_PAGO
  check (FOR_PAGO IN ('C', 'G', 'E', 'R'));
alter table IT.PV_COMPRAS
  add constraint CK_NRO_CTA_REFERENCIA
  check (((NRO_CTA_REFERENCIA IS NOT NULL AND FOR_PAGO IN ('C','R')) OR FOR_PAGO IN ('C','R','E','G')));
alter table IT.PV_COMPRAS
  add constraint CK_TIP_VENTA
  check (TIP_VENTA IN ('CO', 'CR'));

