CREATE TABLE IT.SB_CRC_CAM_OFICINA (
  NRO_OPERACION   VARCHAR2(60),
  TIP_OPERACION   NUMBER(3),
  COD_OFICINA     NUMBER(4),
  COD_MONEDA      VARCHAR2(3),
  COD_OFI_CRC     VARCHAR2(4),
  NRO_REGISTRO    NUMBER
) TABLESPACE IT_DATA;

COMMENT ON TABLE  IT.SB_CRC_CAM_OFICINA IS 'Equivalencias de código de oficina para reportes CRC (ITGF -> COD_OFI_CRC)';
COMMENT ON COLUMN IT.SB_CRC_CAM_OFICINA.NRO_OPERACION IS 'Número de operación/cuenta (formato ITGF)';
COMMENT ON COLUMN IT.SB_CRC_CAM_OFICINA.TIP_OPERACION IS 'Tipo de operación CRC';
COMMENT ON COLUMN IT.SB_CRC_CAM_OFICINA.COD_OFICINA IS 'Código de oficina origen (ITGF)';
COMMENT ON COLUMN IT.SB_CRC_CAM_OFICINA.COD_MONEDA IS 'Código de moneda (e.g., PYG)';
COMMENT ON COLUMN IT.SB_CRC_CAM_OFICINA.COD_OFI_CRC IS 'Código de oficina a reportar a BCP (equivalencia CRC)';
COMMENT ON COLUMN IT.SB_CRC_CAM_OFICINA.NRO_REGISTRO IS 'Identificador correlativo (si aplica)';

CREATE INDEX IT.IX_CAM_OFI_OP_TIP_OFI_MON ON IT.SB_CRC_CAM_OFICINA
(NRO_OPERACION, TIP_OPERACION, COD_OFICINA, COD_MONEDA) TABLESPACE IT_IND;

CREATE INDEX IT.IX_CAM_OFI_NRO_OP ON IT.SB_CRC_CAM_OFICINA (NRO_OPERACION) TABLESPACE IT_IND;

CREATE PUBLIC SYNONYM SB_CRC_CAM_OFICINA FOR IT.SB_CRC_CAM_OFICINA;

GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_CRC_CAM_OFICINA TO IT_TEMPORAL;
