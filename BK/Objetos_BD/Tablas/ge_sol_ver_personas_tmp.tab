create table IT.GE_SOL_VER_PERSONAS_TMP
(
  cod_persona      VARCHAR2(10) not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  monto            NUMBER(18,2) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SOL_VER_PERSONAS_TMP
  is 'Tabla temporal de solicitud de verificación de datos obligatorios para una persona física.';
comment on column IT.GE_SOL_VER_PERSONAS_TMP.cod_persona
  is 'Código de la Persona.';
comment on column IT.GE_SOL_VER_PERSONAS_TMP.cod_modulo
  is 'Código del Módulo.';
comment on column IT.GE_SOL_VER_PERSONAS_TMP.cod_modalidad
  is 'Código de la Modalidad.';
comment on column IT.GE_SOL_VER_PERSONAS_TMP.monto
  is 'Monto Solicitado.';
comment on column IT.GE_SOL_VER_PERSONAS_TMP.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_SOL_VER_PERSONAS_TMP.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_SOL_VER_PERSONAS_TMP.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_SOL_VER_PERSONAS_TMP.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.GE_SOL_VER_PERSONAS_TMP
  add constraint PK_GE_SOL_VER_PERSONAS_TMP primary key (COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_VER_PERSONAS_TMP
  add constraint FK_GSVPT_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);

