create table IT.GE_POL_SEGUROS_CRM
(
  codigo              NUMBER not null,
  cod_persona         VARCHAR2(10),
  cod_ente            NUMBER(5),
  cod_oficina         NUMBER(3),
  canal               VARCHAR2(2),
  seccion             VARCHAR2(5),
  sub_seccion         VARCHAR2(100),
  nro_poliza          VARCHAR2(30),
  producto            VARCHAR2(100),
  mto_capital         NUMBER(18,2),
  mto_premio          NUMBER(18,2),
  mto_prima           NUMBER(18,2),
  cuo_inicial         NUMBER(18,2),
  mto_cuota           NUMBER(18,2),
  can_cuota           NUMBER(2),
  for_pago            VARCHAR2(1),
  fec_inicial         DATE,
  fec_final           DATE,
  fec_propuesta       DATE,
  fec_envio           DATE,
  fec_entrega         DATE,
  observaciones       VARCHAR2(2000),
  estado              VARCHAR2(1),
  referencia          VARCHAR2(30),
  cod_usu_ges_interno VARCHAR2(10),
  cod_ges_externo     VARCHAR2(10),
  cod_irene           VARCHAR2(5),
  cod_moneda          VARCHAR2(3),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    TIMESTAMP(6) default current_timestamp not null,
  situacion           VARCHAR2(10),
  tip_movimiento      VARCHAR2(10),
  tip_anulacion       VARCHAR2(10),
  tip_accion          VARCHAR2(1),
  cod_sub_seccion     VARCHAR2(4)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_POL_SEGUROS_CRM
  is 'Tabla de Seguros por Cliente.';
comment on column IT.GE_POL_SEGUROS_CRM.codigo
  is 'Código identificador de registro. Igual al Número de Solicitud en SEBAOT.';
comment on column IT.GE_POL_SEGUROS_CRM.cod_persona
  is 'Código de Persona.';
comment on column IT.GE_POL_SEGUROS_CRM.cod_ente
  is 'Código de Ente Aseguradora.';
comment on column IT.GE_POL_SEGUROS_CRM.cod_oficina
  is 'Código de Oficina.';
comment on column IT.GE_POL_SEGUROS_CRM.canal
  is 'Canal relacionado al cliente del seguro (dominio: SEC_CANALES).';
comment on column IT.GE_POL_SEGUROS_CRM.seccion
  is 'Sección de la póliza (dominio: SEC_SEGURO).';
comment on column IT.GE_POL_SEGUROS_CRM.sub_seccion
  is 'Sub-Sección al que corresponde la Sección de la póliza.';
comment on column IT.GE_POL_SEGUROS_CRM.nro_poliza
  is 'Número de la Póliza.';
comment on column IT.GE_POL_SEGUROS_CRM.producto
  is 'Producto al que corresponde la póliza.';
comment on column IT.GE_POL_SEGUROS_CRM.mto_capital
  is 'Capital Asegurado.';
comment on column IT.GE_POL_SEGUROS_CRM.mto_premio
  is 'Monto del premio de la póliza.';
comment on column IT.GE_POL_SEGUROS_CRM.mto_prima
  is 'Monto de la prima de la póliza.';
comment on column IT.GE_POL_SEGUROS_CRM.cuo_inicial
  is 'Monto de la cuota Inicial.';
comment on column IT.GE_POL_SEGUROS_CRM.mto_cuota
  is 'Monto de la Cuota.';
comment on column IT.GE_POL_SEGUROS_CRM.can_cuota
  is 'Cantidad de Cuotas.';
comment on column IT.GE_POL_SEGUROS_CRM.for_pago
  is 'Forma de Pago.';
comment on column IT.GE_POL_SEGUROS_CRM.fec_inicial
  is 'Fecha de inicio de Vigencia.';
comment on column IT.GE_POL_SEGUROS_CRM.fec_final
  is 'Fecha de fin de Vigencia.';
comment on column IT.GE_POL_SEGUROS_CRM.fec_propuesta
  is 'Fecha de ingreso de la propuesta.';
comment on column IT.GE_POL_SEGUROS_CRM.fec_envio
  is 'Fecha de envío de la póliza a la aseguradora.';
comment on column IT.GE_POL_SEGUROS_CRM.fec_entrega
  is 'Fecha de entrega de la póliza al Cliente.';
comment on column IT.GE_POL_SEGUROS_CRM.observaciones
  is 'Observaciones (Descripción del Riesgo).';
comment on column IT.GE_POL_SEGUROS_CRM.estado
  is 'Estado de la Póliza (dominio: EST_POLIZA).';
comment on column IT.GE_POL_SEGUROS_CRM.referencia
  is 'Referencia del número de la póliza que fué renovada.';
comment on column IT.GE_POL_SEGUROS_CRM.cod_usu_ges_interno
  is 'Gestor Interno.';
comment on column IT.GE_POL_SEGUROS_CRM.cod_ges_externo
  is 'Gestor Externo.';
comment on column IT.GE_POL_SEGUROS_CRM.cod_irene
  is 'Código Irene.';
comment on column IT.GE_POL_SEGUROS_CRM.cod_moneda
  is 'Código de la moneda.';
comment on column IT.GE_POL_SEGUROS_CRM.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_POL_SEGUROS_CRM.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_POL_SEGUROS_CRM.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_POL_SEGUROS_CRM.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_POL_SEGUROS_CRM.situacion
  is 'Situación de la Póliza. (dominio: SIT_POLIZA)';
comment on column IT.GE_POL_SEGUROS_CRM.tip_movimiento
  is 'Tipo de Movimiento de Seguro. (dominio: TIP_MOV_POLIZA)';
comment on column IT.GE_POL_SEGUROS_CRM.tip_anulacion
  is 'Tipo de Anulación. (dominio: TIP_ANU_POLIZA)';
comment on column IT.GE_POL_SEGUROS_CRM.tip_accion
  is 'Indica el tipo de accion realizado con el registro en el Core.-';
comment on column IT.GE_POL_SEGUROS_CRM.cod_sub_seccion
  is 'Código de la sub-seccion o detalle de la poliza';
create index IT.IN_CRMPO_COD_PERSONA on IT.GE_POL_SEGUROS_CRM (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

