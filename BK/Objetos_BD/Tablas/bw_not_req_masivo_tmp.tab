create table IT.BW_NOT_REQ_MASIVO_TMP
(
  cod_mensaje      NUMBER default 0 not null,
  cod_persona      VARCHAR2(10) not null,
  mensaje          VARCHAR2(200) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_NOT_REQ_MASIVO_TMP
  is 'Mensajes masivos push';
comment on column IT.BW_NOT_REQ_MASIVO_TMP.cod_mensaje
  is 'Identificador de los mensaje';
comment on column IT.BW_NOT_REQ_MASIVO_TMP.cod_persona
  is 'Codigo de la persona';
comment on column IT.BW_NOT_REQ_MASIVO_TMP.mensaje
  is 'Mensaje a ser enviado';

