create table IT.MI_PR_CTA_PRESTAMOS_ASO
(
  nro_cuenta         VARCHAR2(15) not null,
  dig_verificador    NUMBER(1) default 0 not null,
  cod_modulo         NUMBER(3) not null,
  cod_modalidad      NUMBER(3) not null,
  cod_oficina        NUMBER(3) not null,
  nro_cta_debito     VARCHAR2(15),
  nro_cta_renovada   VARCHAR2(15),
  fec_cancelacion    DATE,
  estado             VARCHAR2(1) not null,
  mto_capital        NUMBER(18,2) default 0 not null,
  sal_capital        NUMBER(18,2) default 0 not null,
  sal_interes        NUMBER(18,2) default 0 not null,
  val_int_devengar   NUMBER(20,4) default 0,
  nro_solicitud      NUMBER(7),
  est_batch          VARCHAR2(1),
  sal_cap_batch      NUMBER(18,2) default 0,
  sal_int_batch      NUMBER(18,2) default 0,
  nro_documento      NUMBER(7),
  est_anterior       VARCHAR2(1),
  dev_acumulado      NUMBER(18,2) default 0,
  tip_documento      VARCHAR2(1) not null,
  nro_sol_renovada   NUMBER(7),
  cob_automatico     VARCHAR2(1) default 'N' not null,
  sal_int_adelantado NUMBER(18,2) default 0,
  fec_ult_devengado  DATE,
  dev_no_cobrado     NUMBER(18,2) default 0,
  nro_linea          NUMBER(7),
  cod_moneda         VARCHAR2(3) not null,
  monto              NUMBER(18,2) default 0 not null,
  fec_inicio         DATE not null,
  fec_vencimiento    DATE not null,
  tipo               VARCHAR2(1) default 'A' not null,
  val_tasa           NUMBER(20,4) not null,
  can_cuotas         NUMBER(5) not null,
  can_cuo_pagadas    NUMBER(5),
  dia_atraso         NUMBER(5),
  max_atraso         NUMBER(5),
  pro_atraso         NUMBER(5),
  exo_impuestos      VARCHAR2(1) default 'N' not null,
  cod_causa          NUMBER(3),
  cod_canal          NUMBER(3),
  cod_campana        NUMBER(3),
  cod_sec_credito    NUMBER(3) not null,
  descripcion        VARCHAR2(35),
  tip_destino        NUMBER(2),
  tip_renovacion     VARCHAR2(1),
  cod_ori_fondo      NUMBER(3),
  mto_lin_aplicado   NUMBER(18,2) default 0,
  sal_int_ade_batch  NUMBER(18,2) default 0,
  per_vto_capital    NUMBER(4) default 0 not null,
  per_vto_interes    NUMBER(4) default 0 not null,
  dev_suspenso       NUMBER(18,2) default 0,
  tip_interes        VARCHAR2(1) default 'V',
  fec_juicio         DATE,
  cod_ent_juicio     NUMBER(5),
  cat_renovaciones   NUMBER(1),
  en_juicio          VARCHAR2(1) default 'N',
  cod_banca          NUMBER(3),
  mto_mora           NUMBER(18,2) default 0,
  por_ori_fondo      NUMBER(7,4),
  fec_ren_tas_orig   DATE,
  fec_ren_tas        DATE,
  cod_rub_economico  VARCHAR2(6) not null,
  cod_persona        VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 8M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MI_PR_CTA_PRESTAMOS_ASO
  is 'Contiene los datos principales de los Prestamos.';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.nro_cuenta
  is 'Numero de Prestamo.';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.dig_verificador
  is 'Digito Verificador.';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.cod_modulo
  is 'Codigo de Modulo del Prestamo.';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.cod_modalidad
  is 'Codigo de Modalidad del Prestamo.';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.cod_oficina
  is 'Codigo de Oficina del Prestamo.';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.nro_cta_debito
  is 'Numero de la Cuenta de Debito.';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.nro_cta_renovada
  is 'Numero de Prestamo que fue renovado (en el nuevo), Numero de prestamo al que fue renovado (en el viejo).';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.fec_cancelacion
  is 'Fecha de Cancelacion del Prestamo.';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.estado
  is 'Estado de Cuenta on line (C=Vigente, V=Vencido, G=En Gestion, M=Moroso, I=Irrecurable, N=Cancelado).';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.mto_capital
  is 'Monto Capital.';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.sal_capital
  is 'Saldo del Capital on line.';
comment on column IT.MI_PR_CTA_PRESTAMOS_ASO.sal_interes
