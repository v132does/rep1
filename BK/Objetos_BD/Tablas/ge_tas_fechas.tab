-- Create table
create table IT.GE_TAS_FECHAS
(
  cod_tasa          NUMBER(3) not null,
  fec_vigencia      DATE not null,
  cod_oficina       NUMBER(3),
  cod_moneda        VARCHAR2(3),
  cod_modulo        NUMBER(3),
  cod_modalidad     NUMBER(3),
  nro_cuenta        VARCHAR2(15),
  val_maximo        NUMBER(18,2),
  val_minimo        NUMBER(18,2),
  val_base          NUMBER(18,2) default 0,
  val_tasa          NUMBER(20,4),
  aplicar           VARCHAR2(2) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  fec_vencimiento   DATE,
  observaciones     VARCHAR2(100),
  val_extension     NUMBER(20,4),
  tip_iva           VARCHAR2(2),
  cod_persona       VARCHAR2(10),
  cod_sub_modalidad NUMBER(3),
  no_actualizable   VARCHAR2(1),
  cod_ente          NUMBER(5)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.GE_TAS_FECHAS
  is 'Tasas fijas por Fecha.';
-- Add comments to the columns 
comment on column IT.GE_TAS_FECHAS.cod_tasa
  is 'Codigo de tasa.';
comment on column IT.GE_TAS_FECHAS.fec_vigencia
  is 'Fecha de vigencia de la tasa.';
comment on column IT.GE_TAS_FECHAS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.GE_TAS_FECHAS.cod_moneda
  is 'Moneda.';
comment on column IT.GE_TAS_FECHAS.cod_modulo
  is 'Codigo de Modulo.';
comment on column IT.GE_TAS_FECHAS.cod_modalidad
  is 'Codigo de Modalidad.';
comment on column IT.GE_TAS_FECHAS.nro_cuenta
  is 'Numero de cuenta a ser personalizada.';
comment on column IT.GE_TAS_FECHAS.val_maximo
  is 'Valor maximo.';
comment on column IT.GE_TAS_FECHAS.val_minimo
  is 'Valor minimo.';
comment on column IT.GE_TAS_FECHAS.val_base
  is 'Valor base.';
comment on column IT.GE_TAS_FECHAS.val_tasa
  is 'Valor de la tasa.';
comment on column IT.GE_TAS_FECHAS.aplicar
  is 'Aplicar.';
comment on column IT.GE_TAS_FECHAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_TAS_FECHAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_TAS_FECHAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_TAS_FECHAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_TAS_FECHAS.fec_vencimiento
  is 'Fecha de Vencimiento.';
comment on column IT.GE_TAS_FECHAS.observaciones
  is 'Observaciones.';
comment on column IT.GE_TAS_FECHAS.val_extension
  is 'Valor de extension o Spread.';
comment on column IT.GE_TAS_FECHAS.tip_iva
  is 'Tipo de IVA o Responsabilidad ante el Fisco.';
comment on column IT.GE_TAS_FECHAS.cod_persona
  is 'Codigo de la persona cuya tasa sera personalizada.';
comment on column IT.GE_TAS_FECHAS.cod_sub_modalidad
  is 'Código de Sub Modalidad';
comment on column IT.GE_TAS_FECHAS.no_actualizable
  is 'Indicador de Tasa no Actualizable por el proceso que calculo las tasas por moneda diferentes a la base.';
comment on column IT.GE_TAS_FECHAS.cod_ente
  is 'Código de Ente.';
-- Create/Recreate indexes 
create index IT.IN_GTFEC_COD_MODALIDAD on IT.GE_TAS_FECHAS (COD_MODULO, COD_MODALIDAD)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
