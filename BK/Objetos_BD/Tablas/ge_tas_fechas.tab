  storage
  (
    initial 192K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.GE_TAS_FECHAS
  add constraint UK_GE_TAS_FECHAS unique (COD_TASA, FEC_VIGENCIA, COD_OFICINA, COD_MONEDA, COD_MODULO, COD_MODALIDAD, NRO_CUENTA, TIP_IVA, COD_PERSONA, COD_SUB_MODALIDAD, COD_ENTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_TAS_FECHAS
  add constraint FK_GTFEC_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_TAS_FECHAS
  add constraint FK_GTFEC_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_TAS_FECHAS
  add constraint FK_GTFEC_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_TAS_FECHAS
  add constraint FK_GTFEC_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_TAS_FECHAS
  add constraint FK_GTFEC_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
-- Create/Recreate check constraints 
alter table IT.GE_TAS_FECHAS
  add constraint CK_GTFEC_FEC_VENCIMIENTO
  check (fec_vencimiento is not null and (nro_cuenta is not null or cod_persona is not null) or
           (nro_cuenta is null and cod_persona is null));
alter table IT.GE_TAS_FECHAS
  add constraint CK_TASA_DESCUENTO
  check ((nro_cuenta is not null or cod_persona is not null and
    ((val_tasa is not null and val_extension is null and val_minimo is null and val_maximo is null)
   or
     (val_tasa is null and val_extension is not null and val_minimo is null and val_maximo is null)
   or
     (val_tasa is null and val_extension is null and (val_minimo is not null or val_maximo is not null))))
or
(nro_cuenta is null and cod_persona is null and
    ((val_tasa is not null and val_extension is null)
   or
     (val_tasa is null and val_extension is not null))));
alter table IT.GE_TAS_FECHAS
  add constraint CK_TASA_SPREAD
  check (( nro_cuenta is not null or cod_persona is not null and
          ( ( val_tasa is not null and val_extension is null ) or
            ( val_tasa is null and val_extension is not null and
              val_minimo is null and val_maximo is null
            ) or
            ( val_tasa is null and val_extension is null and
              ( val_minimo is not null or val_maximo is not null )
            )
          ) ) or
          ( nro_cuenta is null and cod_persona is null and
            ( val_tasa is not null and val_extension is null )
          ));
