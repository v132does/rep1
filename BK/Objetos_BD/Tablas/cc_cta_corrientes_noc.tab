create table IT.CC_CTA_CORRIENTES_NOC
(
  cod_modulo          NUMBER(3) not null,
  cod_modalidad       NUMBER(3) not null,
  cod_oficina         NUMBER(3) not null,
  nro_cuenta          VARCHAR2(15) not null,
  dig_verificador     NUMBER(1),
  cod_moneda          VARCHAR2(3) not null,
  denominacion        VARCHAR2(65) not null,
  can_fir_requeridas  NUMBER(2),
  can_fir_registradas NUMBER(2),
  fec_apertura        DATE not null,
  ret_personalizada   VARCHAR2(1) default 'N' not null,
  tas_personalizada   VARCHAR2(1) default 'N' not null,
  sal_minimo          NUMBER(18,2) default 0,
  aut_pendiente       VARCHAR2(1) default 'N' not null,
  acu_sobregiro       VARCHAR2(1),
  tra_prohibida       VARCHAR2(1) default 'N' not null,
  cta_combinada       VARCHAR2(1) default 'N' not null,
  cod_usu_promotor    VARCHAR2(10),
  est_batch           VARCHAR2(1),
  estado              VARCHAR2(1) not null,
  fec_ult_extracto    DATE,
  sal_ult_extracto    NUMBER(16,2),
  nro_folio           NUMBER(7),
  fec_cam_estado      DATE,
  fec_ult_movimiento  DATE,
  hor_ult_movimiento  VARCHAR2(8),
  sal_ret_batch       NUMBER(18,2) default 0 not null,
  sal_retenido        NUMBER(18,2) default 0 not null,
  sal_blo_batch       NUMBER(18,2) default 0 not null,
  sal_bloqueado       NUMBER(18,2) default 0 not null,
  sal_tot_batch       NUMBER(18,2) default 0 not null,
  sal_total           NUMBER(18,2) default 0 not null,
  nom_chequera        VARCHAR2(60),
  mto_apertura        NUMBER(18,2) default 0,
  cod_canal           NUMBER(3),
  cod_campana         NUMBER(3),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  fre_extracto        VARCHAR2(1) default 'M',
  mto_cre_pendientes  NUMBER(18,2) default 0,
  mto_cre_a_confirmar NUMBER(18,2) default 0,
  cod_ente            NUMBER(5),
  mto_deb_pendientes  NUMBER(18,2) default 0,
  reg_firma           VARCHAR2(600),
  en_juicio           VARCHAR2(1) default 'N',
  fec_juicio          DATE,
  cod_ent_juicio      NUMBER(5),
  dia_atraso          NUMBER(5) default 0,
  max_atraso          NUMBER(5) default 0,
  pro_atraso          NUMBER(5) default 0,
  mto_mora            NUMBER(18,2) default 0,
  cod_sub_modalidad   NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CTA_CORRIENTES_NOC
  is 'Maestro de Cuentas Corrientes para movimientos Nocturnos.';
comment on column IT.CC_CTA_CORRIENTES_NOC.cod_modulo
  is 'Codigo de modulo de la Cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.cod_modalidad
  is 'Codigo de modalidad de la Cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.cod_oficina
  is 'Codigo de oficina de la Cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.dig_verificador
  is 'Digito verificador de la Cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.cod_moneda
  is 'Codigo de la moneda con que opera la Cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.denominacion
  is 'Rubro o Nombre de la cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.can_fir_requeridas
  is 'Cantidad de firmas requeridas.';
comment on column IT.CC_CTA_CORRIENTES_NOC.can_fir_registradas
  is 'Cantidad de firmas registradas en la ficha de la cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.fec_apertura
  is 'Fecha de apertura de la cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.ret_personalizada
  is 'Retencion personalizada.';
comment on column IT.CC_CTA_CORRIENTES_NOC.tas_personalizada
  is 'Tasa Personalizada.';
comment on column IT.CC_CTA_CORRIENTES_NOC.sal_minimo
  is 'Saldo minimo pactado.';
comment on column IT.CC_CTA_CORRIENTES_NOC.aut_pendiente
  is 'Tiene autorizacion. (N=NO / S=SI).';
comment on column IT.CC_CTA_CORRIENTES_NOC.acu_sobregiro
  is ' Indica si la Cuenta Tiene Acuerdo de Sobregiro  Vigente. (S = SI / N = NO).';
comment on column IT.CC_CTA_CORRIENTES_NOC.tra_prohibida
  is 'Tiene transaccion prohibida. (N=NO / S=SI).';
comment on column IT.CC_CTA_CORRIENTES_NOC.cta_combinada
  is 'Indicador de si participa en una Cuenta Combinada.';
comment on column IT.CC_CTA_CORRIENTES_NOC.cod_usu_promotor
  is 'Codigo de promotor de la cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.est_batch
  is 'Estado de cuenta batch. ( ).';
comment on column IT.CC_CTA_CORRIENTES_NOC.estado
  is 'Estado de cuenta on line ( A=abierta falta depositar, N=normal, C=cancelada, I=inactiva, T=totalmente bloqueada ).';
comment on column IT.CC_CTA_CORRIENTES_NOC.fec_ult_extracto
  is 'Fecha de ultimo extracto.';
comment on column IT.CC_CTA_CORRIENTES_NOC.sal_ult_extracto
  is 'Saldo del ultimo extracto.';
comment on column IT.CC_CTA_CORRIENTES_NOC.nro_folio
  is 'Numero de folio.';
comment on column IT.CC_CTA_CORRIENTES_NOC.fec_cam_estado
  is 'Fecha de cambio de Estado.';
comment on column IT.CC_CTA_CORRIENTES_NOC.fec_ult_movimiento
  is 'Fecha de ultimo movimiento.';
comment on column IT.CC_CTA_CORRIENTES_NOC.hor_ult_movimiento
  is 'Hora del ultimo movimiento.';
comment on column IT.CC_CTA_CORRIENTES_NOC.sal_ret_batch
  is 'Saldo retenido batch.';
comment on column IT.CC_CTA_CORRIENTES_NOC.sal_retenido
  is 'Saldo retenido on line.';
comment on column IT.CC_CTA_CORRIENTES_NOC.sal_blo_batch
  is 'Saldo bloqueado batch.';
comment on column IT.CC_CTA_CORRIENTES_NOC.sal_bloqueado
  is 'Saldo bloqueado on line.';
comment on column IT.CC_CTA_CORRIENTES_NOC.sal_tot_batch
  is 'Saldo total batch.';
comment on column IT.CC_CTA_CORRIENTES_NOC.sal_total
  is 'Saldo total on line.';
comment on column IT.CC_CTA_CORRIENTES_NOC.nom_chequera
  is 'Nombre a ser impreso en la Chequera.';
comment on column IT.CC_CTA_CORRIENTES_NOC.mto_apertura
  is 'Monto de apertura pactado con el clientes.';
comment on column IT.CC_CTA_CORRIENTES_NOC.cod_canal
  is 'Codigo de Canal.';
comment on column IT.CC_CTA_CORRIENTES_NOC.cod_campana
  is 'Codigo de Campaña.';
comment on column IT.CC_CTA_CORRIENTES_NOC.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CTA_CORRIENTES_NOC.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CTA_CORRIENTES_NOC.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CTA_CORRIENTES_NOC.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CTA_CORRIENTES_NOC.fre_extracto
  is 'Frecuencia de emision del extracto.';
comment on column IT.CC_CTA_CORRIENTES_NOC.mto_cre_pendientes
  is 'Creditos fuera de hora.';
comment on column IT.CC_CTA_CORRIENTES_NOC.mto_cre_a_confirmar
  is 'ATM.';
comment on column IT.CC_CTA_CORRIENTES_NOC.cod_ente
  is 'Codigo de empresa.';
comment on column IT.CC_CTA_CORRIENTES_NOC.mto_deb_pendientes
  is 'Debitos fuera de hora.';
comment on column IT.CC_CTA_CORRIENTES_NOC.reg_firma
  is 'Regimen de Firma.';
comment on column IT.CC_CTA_CORRIENTES_NOC.en_juicio
  is 'Indica si la cuenta se encuentra en juicio.';
comment on column IT.CC_CTA_CORRIENTES_NOC.fec_juicio
  is 'Fecha en la cual paso a juicio.';
comment on column IT.CC_CTA_CORRIENTES_NOC.cod_ent_juicio
  is 'Ente al cual se derivo el juicio.';
comment on column IT.CC_CTA_CORRIENTES_NOC.dia_atraso
  is 'Dias de atraso actual, por sobregiros.';
comment on column IT.CC_CTA_CORRIENTES_NOC.max_atraso
  is 'Maximo de dias de atraso, por sobregiros.';
comment on column IT.CC_CTA_CORRIENTES_NOC.pro_atraso
  is 'Promedio de Dias de atraso, por sobregiros.';
comment on column IT.CC_CTA_CORRIENTES_NOC.mto_mora
  is 'Monto en mora de la cuenta.';
comment on column IT.CC_CTA_CORRIENTES_NOC.cod_sub_modalidad
  is 'Código de Sub Modalidad';
create index IT.IN_CCCNO_COD_CAMPANA on IT.CC_CTA_CORRIENTES_NOC (COD_CAMPANA, COD_ENTE, COD_MODALIDAD, COD_MODULO, COD_MONEDA, COD_OFICINA, COD_USU_PROMOTOR, ESTADO, EST_BATCH)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CCCON_NRO_CUENTA on IT.CC_CTA_CORRIENTES_NOC (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 384K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint PK_CC_CTA_CORRIENTES_NOC primary key (NRO_CUENTA);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint FK_CCCNO_COD_CAMPANA foreign key (COD_CAMPANA)
  references IT.CR_CAMPANAS (COD_CAMPANA);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint FK_CCCNO_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint FK_CCCNO_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint FK_CCCNO_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint FK_CCCNO_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint FK_CCCNO_COD_SUB_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD)
  references IT.GE_SUB_MODALIDADES (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint FK_CCCNO_COD_USU_PROMOTOR foreign key (COD_USU_PROMOTOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint FK_CCCNO_ESTADO foreign key (COD_MODULO, COD_MODALIDAD, ESTADO)
  references IT.GE_EST_CUENTAS (COD_MODULO, COD_MODALIDAD, ESTADO);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint FK_CCCNO_EST_BATCH foreign key (COD_MODULO, COD_MODALIDAD, EST_BATCH)
  references IT.GE_EST_CUENTAS (COD_MODULO, COD_MODALIDAD, ESTADO);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1082660020_AUT_P_000
  check (AUT_PENDIENTE IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1082660020_CTA_C_000
  check (CTA_COMBINADA IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1082660020_RET_P_000
  check (RET_PERSONALIZADA IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1082660020_TAS_P_000
  check (TAS_PERSONALIZADA IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1082660020_TRA_P_000
  check (TRA_PROHIBIDA IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1092358390_COD_C_007
  check (COD_CANAL BETWEEN 0 AND 999);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1092358390_COD_C_008
  check (COD_CAMPANA BETWEEN 0 AND 999);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1092358390_COD_M_019
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1092358390_COD_M_020
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1092358390_COD_O_007
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.CC_CTA_CORRIENTES_NOC
  add constraint AVCON_1101745716_FRE_E_001
  check (FRE_EXTRACTO IN ('M', 'Q', 'S', 'D', 'm', 'q', 's', 'd'));

