create table IT.CB_PROC_SIFEN
(
  id_proceso       NUMBER(8) not null,
  estado           VARCHAR2(30),
  cant_facturas    NUMBER(8),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_PROC_SIFEN
  is 'Detalle de los lotes de facturas enviados a SIFEN.';
comment on column IT.CB_PROC_SIFEN.id_proceso
  is 'ID del proceso.';
comment on column IT.CB_PROC_SIFEN.estado
  is 'Estado del proceso.';
comment on column IT.CB_PROC_SIFEN.cant_facturas
  is 'Cantidad de facturas enviadas a SIFEN.';
comment on column IT.CB_PROC_SIFEN.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_PROC_SIFEN.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_PROC_SIFEN.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_PROC_SIFEN.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

