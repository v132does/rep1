alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_BANCA foreign key (COD_BANCA)
  references IT.GE_BANCAS (COD_BANCA);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_CANAL foreign key (COD_CANAL)
  references IT.GE_CANALES (COD_CANAL);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_DEPARTAMENTO foreign key (COD_DEPARTAMENTO)
  references IT.BA_DEPARTAMENTOS (COD_DEPARTAMENTO);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_GRU_ECONOMICO foreign key (COD_GRU_ECONOMICO)
  references IT.GE_GRU_ECONOMICOS (COD_GRU_ECONOMICO);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_OFI_IMP_CLAVE foreign key (COD_OFI_IMP_CLAVE)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_SEG_ANTERIOR foreign key (COD_SEG_PRE_ANTERIOR)
  references IT.GE_SEG_PREFERENTES (COD_SEG_PREFERENTE);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_SEG_CLIENTE foreign key (COD_SEG_CLIENTE)
  references IT.GE_SEG_CLIENTES (COD_SEG_CLIENTE);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_SEG_CONTABLE foreign key (COD_SEC_CONTABLE)
  references IT.GE_SEC_CONTABLES (COD_SEC_CONTABLE);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_SEG_PREFERENTE foreign key (COD_SEG_PREFERENTE)
  references IT.GE_SEG_PREFERENTES (COD_SEG_PREFERENTE);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_USU_GESTION foreign key (COD_USU_GESTION)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_COD_USU_OFICIAL foreign key (COD_USU_OFICIAL)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_CLIENTES
  add constraint FK_GCLIE_USU_IMP_CLAVE foreign key (USU_IMP_CLAVE)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_CLIENTES
  add constraint AVCON_1080843414_CLI_E_000
  check (CLI_ESPECIAL IN ('S', 'N'));
alter table IT.GE_CLIENTES
  add constraint AVCON_1080843414_EXO_I_000
  check (EXO_IMPUESTOS IN ('S', 'N'));
alter table IT.GE_CLIENTES
  add constraint AVCON_1080843414_RESID_000
  check (RESIDENTE IN ('S', 'N'));
alter table IT.GE_CLIENTES
  add constraint AVCON_1082658304_COD_D_001
  check (COD_DEPARTAMENTO BETWEEN 0 AND 999);
alter table IT.GE_CLIENTES
  add constraint AVCON_1082658304_COD_G_001
  check (COD_GRU_ECONOMICO BETWEEN 0 AND 99999);
alter table IT.GE_CLIENTES
  add constraint AVCON_1082658304_COD_O_003
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.GE_CLIENTES
  add constraint AVCON_1082658304_COD_T_002
  check (COD_TIP_DEUDOR BETWEEN 0 AND 999);
alter table IT.GE_CLIENTES
  add constraint AVCON_1095259058_CLI_C_000
  check (CLI_CONFIDENCIAL IN ('S', 'N'));
alter table IT.GE_CLIENTES
  add constraint AVCON_1104794015_CAT_R_000
  check (CAT_RIESGO IN ('1', '2', '3', '4', '5', '6'));
alter table IT.GE_CLIENTES
  add constraint AVCON_1104875958_TIPO_000
  check (TIPO IN ('R', 'M', 'N', 'C', 'P', 'T','G','V'));
alter table IT.GE_CLIENTES
  add constraint AVCON_1112369214_CAT_R_000
  check (CAT_RENOVACIONES IN (1, 2, 3, 4, 5, 6));
alter table IT.GE_CLIENTES
  add constraint AVCON_1112369214_CAT_S_000
  check (CAT_SUBJETIVA IN (1, 2, 3, 4, 5, 6));
alter table IT.GE_CLIENTES
  add constraint AVCON_1112369214_CAT_S_001
  check (CAT_SISTEMA IN (1, 2, 3, 4, 5, 6));
alter table IT.GE_CLIENTES
  add constraint AVCON_1123192154_EST_C_000
  check (EST_CLAVE IN ('B', 'N', 'A', 'S', 'M', 'X', 'I', 'P'));

