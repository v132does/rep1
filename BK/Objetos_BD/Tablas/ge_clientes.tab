create table IT.GE_CLIENTES
(
  cod_persona          VARCHAR2(10) not null,
  cod_oficina          NUMBER(3) not null,
  cat_riesgo           VARCHAR2(1),
  cod_gru_economico    NUMBER(5),
  exo_impuestos        VARCHAR2(1) default 'N' not null,
  cod_usu_oficial      VARCHAR2(10) not null,
  cli_especial         VARCHAR2(1) default 'N' not null,
  residente            VARCHAR2(1) default 'N' not null,
  cod_sec_contable     VARCHAR2(1) not null,
  cod_tip_deudor       NUMBER(3) not null,
  cod_departamento     NUMBER(3),
  niv_cruzamiento      NUMBER(8,2),
  clave                VARCHAR2(40),
  est_clave            VARCHAR2(1),
  fec_est_clave        DATE,
  can_intentos         NUMBER(2),
  tipo                 VARCHAR2(1),
  tot_deu_real         NUMBER(18,2) default 0,
  tot_deu_contingente  NUMBER(18,2) default 0,
  cat_subjetiva        NUMBER(1),
  tot_gar_computables  NUMBER(18,2) default 0,
  tot_prevision        NUMBER(18,2) default 0,
  tip_extracto         VARCHAR2(1) default 'C' not null,
  cod_usu_gestion      VARCHAR2(10),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  fec_ingreso          DATE default TRUNC(SYSDATE) not null,
  cod_seg_cliente      NUMBER(3),
  cli_confidencial     VARCHAR2(1) default 'N' not null,
  tot_deu_sistema      NUMBER(18,2),
  cat_automatica       NUMBER(3,2) default 1 not null,
  cat_sistema          NUMBER(1),
  cat_renovaciones     NUMBER(1),
  cat_gru_economico    NUMBER(3,2),
  cat_anterior         NUMBER(3,2),
  fec_cat_anterior     DATE,
  fec_ult_clasif       DATE,
  cat_atraso           VARCHAR2(2),
  tip_clave            VARCHAR2(1),
  tot_deu_cod_sistema  NUMBER(18,2),
  tot_deu_codeudoria   NUMBER(18,2),
  tot_deu_con_sistema  NUMBER(18,2),
  ult_cat_riesgo       VARCHAR2(1),
  fec_ult_cat_sub      DATE,
  fec_ult_cat_3        DATE,
  cod_perfil           VARCHAR2(20),
  fec_ult_acceso       DATE,
  cod_canal            NUMBER(3),
  val_comercial        NUMBER(2),
  fec_ult_cla_sistema  DATE,
  cod_seg_preferente   NUMBER(3),
  cod_seg_pre_anterior NUMBER(3),
  usu_imp_clave        VARCHAR2(10),
  cod_ofi_imp_clave    NUMBER(3),
  fec_imp_clave        DATE,
  cod_banca            NUMBER(3),
  tip_gru_cobranza     VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
CREATE INDEX IT.IN_TOTALES_DEUDOR_GE_CLI ON IT.GE_CLIENTES (NVL("TOT_DEU_SISTEMA",0) ASC, NVL("TOT_DEU_COD_SISTEMA",0) ASC, NVL("TOT_DEU_CON_SISTEMA",0) ASC) 
LOGGING 
TABLESPACE IT_DATA 
PCTFREE 10 
INITRANS 2 
STORAGE 
( 
  INITIAL 65536 
  NEXT 1048576 
  MINEXTENTS 1 
  MAXEXTENTS UNLIMITED 
  BUFFER_POOL DEFAULT 
) 
NOPARALLEL;
CREATE INDEX IT.IN_GECLIE_CATRIES on IT.GE_CLIENTES (COD_PERSONA,  CAT_RIESGO)
 tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CLIENTES
  is 'Clientes.';
comment on column IT.GE_CLIENTES.cod_persona
  is 'Código de cliente.';
comment on column IT.GE_CLIENTES.cod_oficina
  is 'Código de la Oficina.';
comment on column IT.GE_CLIENTES.cat_riesgo
  is 'Categoria de Riesgo (1- Normal ; 2- Potencial; 3- Real ; 4-Alto Riesgo; 5-Irrecuperable).';
comment on column IT.GE_CLIENTES.cod_gru_economico
  is 'Código de grupo economico.';
comment on column IT.GE_CLIENTES.exo_impuestos
  is 'Tiene exoneración de impuestos (S= SI ; N= No).';
comment on column IT.GE_CLIENTES.cod_usu_oficial
  is 'Código del oficial de cuentas.';
comment on column IT.GE_CLIENTES.cli_especial
  is 'Cliente especial. (N/S).';
comment on column IT.GE_CLIENTES.residente
  is 'Indica si es IND_RESIDENTE (S/N).';
comment on column IT.GE_CLIENTES.cod_sec_contable
  is 'Código de sector.';
comment on column IT.GE_CLIENTES.cod_tip_deudor
  is 'Tipo de deudor.';
comment on column IT.GE_CLIENTES.cod_departamento
  is 'Código del departamento.';
comment on column IT.GE_CLIENTES.niv_cruzamiento
  is 'Nivel de Cruzamiento (Porcentaje de productos que que posee el Cliente con respecto a los productos ofrecidos por la Entidad.';
comment on column IT.GE_CLIENTES.clave
  is 'Clave.';
comment on column IT.GE_CLIENTES.est_clave
  is 'Estado de la Clave.';
comment on column IT.GE_CLIENTES.fec_est_clave
  is 'Fecha de Estado.';
comment on column IT.GE_CLIENTES.can_intentos
  is 'Cantidad de intentos fallidos.';
comment on column IT.GE_CLIENTES.tipo
  is 'Tipo de cliente (R = Comercial Mayor Vinculado a la Entidad, M = Comercial Mayores, G = Comercial Mayor Vinculado a otros Grupos Económicos, N = Comercial Menor Vinculado a la Entidad, C = Comercial Menor, P = Personal - Credito de Consumo, V = Personal - Credito de Vivienda, T = Microcréditos).
';
comment on column IT.GE_CLIENTES.tot_deu_real
  is 'Total de la deuda real.';
comment on column IT.GE_CLIENTES.tot_deu_contingente
  is 'Total de la deuda contingente.';
comment on column IT.GE_CLIENTES.cat_subjetiva
  is 'Categoria subjetiva.';
comment on column IT.GE_CLIENTES.tot_gar_computables
  is 'Monto total de la garantias computables.';
comment on column IT.GE_CLIENTES.tot_prevision
  is 'Monto total de la Previsión.';
comment on column IT.GE_CLIENTES.tip_extracto
  is 'Tipo de impresión de extracto. C-Impreso,  Z-x Mail,  N-No impreso X-Envío x mail e impreso.';
comment on column IT.GE_CLIENTES.cod_usu_gestion
  is 'Código de Usuario de Gestión de Cobranza.';
comment on column IT.GE_CLIENTES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_CLIENTES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_CLIENTES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_CLIENTES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.GE_CLIENTES.fec_ingreso
  is 'Fecha de ingreso del cliente en la Entidad.';
comment on column IT.GE_CLIENTES.cod_seg_cliente
  is 'Segmento del cliente.';
comment on column IT.GE_CLIENTES.cli_confidencial
  is 'Indica si el cliente es confidencial.';
comment on column IT.GE_CLIENTES.tot_deu_sistema
  is 'Total de la deuda del sistema financiero global.';
comment on column IT.GE_CLIENTES.cat_automatica
  is 'Categoria ponderada.';
comment on column IT.GE_CLIENTES.cat_sistema
  is 'categoria final del sistema financiero.(ultima informacion).';
comment on column IT.GE_CLIENTES.cat_renovaciones
  is 'categoria de las renovaciones, refinanciaciones o restructuraciones.';
comment on column IT.GE_CLIENTES.cat_gru_economico
  is 'categoria del grupo economico al que corresponde.';
comment on column IT.GE_CLIENTES.cat_anterior
  is 'Categoría anterior.';
comment on column IT.GE_CLIENTES.fec_cat_anterior
  is 'Fecha de categorización anterior.';
comment on column IT.GE_CLIENTES.fec_ult_clasif
  is 'Fecha de última clasificación o categorización.';
comment on column IT.GE_CLIENTES.cat_atraso
  is 'Categoría por atraso.';
comment on column IT.GE_CLIENTES.tip_clave
  is 'Tipo de clave: C-consulta T-Transaccional.';
comment on column IT.GE_CLIENTES.tot_deu_cod_sistema
  is 'Total deuda codeudoría en el Sistema Financiero Global.';
comment on column IT.GE_CLIENTES.tot_deu_codeudoria
  is 'Total deuda codeudoría en la entidad.';
comment on column IT.GE_CLIENTES.tot_deu_con_sistema
  is 'Total deuda contingencia en el Sistema Financiero Global.';
comment on column IT.GE_CLIENTES.ult_cat_riesgo
  is 'Última categoría de riesgo, por cancelación de cuentas.';
comment on column IT.GE_CLIENTES.fec_ult_cat_sub
  is 'Fecha de Última Categorización Subjetiva.';
comment on column IT.GE_CLIENTES.fec_ult_cat_3
  is 'Fecha de Última Categorización a 3.';
comment on column IT.GE_CLIENTES.cod_perfil
  is 'Código de Perfil.';
comment on column IT.GE_CLIENTES.fec_ult_acceso
  is 'Fecha Último Acceso.';
comment on column IT.GE_CLIENTES.cod_canal
  is 'Código de Canal.';
comment on column IT.GE_CLIENTES.val_comercial
  is 'Valor Comercial del Cliente para el Banco. Ej: Alto Valor Acutal, Alto Valor Potencial, etc.';
comment on column IT.GE_CLIENTES.fec_ult_cla_sistema
  is 'Fecha de última Clasificación en el Sistema.';
comment on column IT.GE_CLIENTES.cod_seg_preferente
  is 'Segmento Preferente del Cliente.';
comment on column IT.GE_CLIENTES.cod_seg_pre_anterior
  is 'Segmento Preferente Anterior del Cliente.';
comment on column IT.GE_CLIENTES.usu_imp_clave
  is 'Usuario que realizó la Impresión de la Clave.';
comment on column IT.GE_CLIENTES.cod_ofi_imp_clave
  is 'Código de Oficina donde se realizó la Impresión.';
comment on column IT.GE_CLIENTES.fec_imp_clave
  is 'Fecha de la Impresión de la Clave.';
comment on column IT.GE_CLIENTES.cod_banca
  is 'Código de Banca.';
comment on column IT.GE_CLIENTES.tip_gru_cobranza
  is 'Tipo de Agrupación para envios de datos a tercerización de Cobranza (1 = Se externaliza, 0 = No se externaliza).';
