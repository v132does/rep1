create table IT.PR_GAR_STANDBYS
(
  nro_garantia     NUMBER(7) not null,
  nro_referencia   VARCHAR2(20) not null,
  fec_inicio       DATE,
  fec_vencimiento  DATE,
  monto            NUMBER(18,2) not null,
  beneficiario     VARCHAR2(200) not null,
  cod_ent_emisor   NUMBER(5),
  observacion      VARCHAR2(1000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  observacion_his  VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_GAR_STANDBYS
  is 'Garantías Standbys L/C Recibidas.';
comment on column IT.PR_GAR_STANDBYS.nro_garantia
  is 'Número de Garantía.';
comment on column IT.PR_GAR_STANDBYS.nro_referencia
  is 'Número de Referencia.';
comment on column IT.PR_GAR_STANDBYS.fec_inicio
  is 'Fecha de Inicio.';
comment on column IT.PR_GAR_STANDBYS.fec_vencimiento
  is 'Fecha de Vencimiento.';
comment on column IT.PR_GAR_STANDBYS.monto
  is 'Monto.';
comment on column IT.PR_GAR_STANDBYS.beneficiario
  is 'A la orden de quien está.';
comment on column IT.PR_GAR_STANDBYS.cod_ent_emisor
  is 'Código de Ente Emisor.';
comment on column IT.PR_GAR_STANDBYS.observacion
  is 'Observaciones.';
comment on column IT.PR_GAR_STANDBYS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_GAR_STANDBYS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_GAR_STANDBYS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_GAR_STANDBYS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_GAR_STANDBYS.observacion_his
  is 'Guarda las observaciones que superaron los 1000 caracteres.';
alter table IT.PR_GAR_STANDBYS
  add constraint PK_PR_GAR_STANDBYS primary key (NRO_GARANTIA, NRO_REFERENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_GAR_STANDBYS
  add constraint FK_PGSTA_NRO_GARANTIA foreign key (NRO_GARANTIA)
  references IT.PR_GARANTIAS (NRO_GARANTIA);

