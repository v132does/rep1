create table IT.TA_BUS_TRA_BENEFICIOS
(
  identificador                 NUMBER(15) not null,
  numero_ticket                 NUMBER(18) null,
  fecha_transaccion             DATE not null,
  confirmacion_reintegro        NUMBER(1) null,
  usu_insercion                 VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion                 DATE default SYSDATE not null,
  usu_modificacion              VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion              DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

alter table IT.TA_BUS_TRA_BENEFICIOS
add primary key (IDENTIFICADOR)
using index
tablespace IT_DATA
pctfree 10
initrans 2
maxtrans 255
storage
(
  initial 64K
  next 1M
  minextents 1
  maxextents unlimited
);

comment on table IT.TA_BUS_TRA_BENEFICIOS
  is 'BENEFICIOS - TA_BUS_TRANSACCIONES procesados';
comment on column IT.TA_BUS_TRA_BENEFICIOS.identificador
  is 'Identificador de la operacion';
comment on column IT.TA_BUS_TRA_BENEFICIOS.fecha_transaccion
  is 'fecha de la transaccion';
comment on column IT.TA_BUS_TRA_BENEFICIOS.confirmacion_reintegro
  is 'Confirmacion reintegro';
comment on column IT.TA_BUS_TRA_BENEFICIOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_BUS_TRA_BENEFICIOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_BUS_TRA_BENEFICIOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_BUS_TRA_BENEFICIOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

  -- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.TA_BUS_TRA_BENEFICIOS to IT_TEMPORAL;