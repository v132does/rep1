create table IT.GE_CLI_BCP_DEPOSITOS
(
  cod_resultado    VARCHAR2(3),
  resultado        VARCHAR2(200),
  periodo          VARCHAR2(6),
  tip_documento    VARCHAR2(32),
  nro_documento    VARCHAR2(15),
  nombres          VARCHAR2(255),
  apellidos        VARCHAR2(255),
  fec_nacimiento   VARCHAR2(8),
  tot_depositos    NUMBER,
  fec_proceso      DATE not null,
  dat_respuesta    CLOB,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CLI_BCP_DEPOSITOS
  is 'Tabla para resultado de proceso de importacion de datos de Clientes del BCP.';
comment on column IT.GE_CLI_BCP_DEPOSITOS.cod_resultado
  is 'Codigo de resultado 01: Datos encontrados/02:Datos no encontrados ';
comment on column IT.GE_CLI_BCP_DEPOSITOS.resultado
  is 'Resultado al consultar datos en BCP (mensaje)';
comment on column IT.GE_CLI_BCP_DEPOSITOS.periodo
  is 'Periodo de consulta de la deuda';
comment on column IT.GE_CLI_BCP_DEPOSITOS.tip_documento
  is 'Tipo de documento de identidad del cliente ';
comment on column IT.GE_CLI_BCP_DEPOSITOS.nro_documento
  is 'Numero de documento de identidad del cliente';
comment on column IT.GE_CLI_BCP_DEPOSITOS.nombres
  is 'Nombres del Cliente ';
comment on column IT.GE_CLI_BCP_DEPOSITOS.apellidos
  is 'Apellidos del Cliente';
comment on column IT.GE_CLI_BCP_DEPOSITOS.fec_nacimiento
  is 'Fecha de Nacimiento del Cliente ';
comment on column IT.GE_CLI_BCP_DEPOSITOS.tot_depositos
  is 'Total de depósito bcp';
comment on column IT.GE_CLI_BCP_DEPOSITOS.fec_proceso
  is 'Fecha de proceso';
comment on column IT.GE_CLI_BCP_DEPOSITOS.dat_respuesta
  is 'Respuesta recibida';

