create table IT.MD_TRIGGERS
(
  id                  NUMBER not null,
  table_or_view_id_fk NUMBER not null,
  trigger_on_flag     CHAR(1) not null,
  trigger_name        VARCHAR2(4000),
  trigger_timing      VARCHAR2(4000),
  trigger_operation   VARCHAR2(4000),
  trigger_event       VARCHAR2(4000),
  native_sql          CLOB,
  native_key          VARCHAR2(4000),
  language            VARCHAR2(40) not null,
  comments            VARCHAR2(4000),
  linecount           NUMBER,
  security_group_id   NUMBER default 0 not null,
  created_on          DATE default sysdate not null,
  created_by          VARCHAR2(255),
  last_updated_on     DATE,
  last_updated_by     VARCHAR2(255)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MD_TRIGGERS
  is 'For storing information about triggers.';
comment on column IT.MD_TRIGGERS.id
  is 'Primary Key';
comment on column IT.MD_TRIGGERS.table_or_view_id_fk
  is 'Table on which this trigger fires';
comment on column IT.MD_TRIGGERS.trigger_on_flag
  is 'Flag to show iif the trigger is on a table or a view.  If it is a table this should be ''T''. If it is on a view this should be ''V''';
comment on column IT.MD_TRIGGERS.trigger_name
  is 'Name of the trigger //OBJECTNAME';
comment on column IT.MD_TRIGGERS.trigger_timing
  is 'before, after ,etc.';
comment on column IT.MD_TRIGGERS.trigger_operation
  is 'insert, delete, etc.';
comment on column IT.MD_TRIGGERS.trigger_event
  is 'The actual trigger that gets fired ';
comment on column IT.MD_TRIGGERS.native_sql
  is 'The full definition ';
comment on column IT.MD_TRIGGERS.native_key
  is 'UInique identifer for this object at source';
comment on column IT.MD_TRIGGERS.language
  is '//PUBLIC';
alter table IT.MD_TRIGGERS
  add constraint MD_TRIGGERS_PK primary key (ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

