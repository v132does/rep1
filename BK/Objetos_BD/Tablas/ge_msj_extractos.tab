create table IT.GE_MSJ_EXTRACTOS
(
  cod_mensaje      NUMBER(3) not null,
  fec_extracto     DATE not null,
  mensaje          VARCHAR2(1000) not null,
  prioridad        NUMBER(2) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_MSJ_EXTRACTOS
  is 'Mensajes para Extractos.';
comment on column IT.GE_MSJ_EXTRACTOS.cod_mensaje
  is 'Tipo de Mensaje.';
comment on column IT.GE_MSJ_EXTRACTOS.fec_extracto
  is 'Fecha de Extracto.';
comment on column IT.GE_MSJ_EXTRACTOS.mensaje
  is 'Mensaje.';
comment on column IT.GE_MSJ_EXTRACTOS.prioridad
  is 'Prioridad del Mensaje para esa fecha.';
comment on column IT.GE_MSJ_EXTRACTOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_MSJ_EXTRACTOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_MSJ_EXTRACTOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_MSJ_EXTRACTOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create unique index IT.PK_GE_MNS_EXTRACTOS on IT.GE_MSJ_EXTRACTOS (COD_MENSAJE, FEC_EXTRACTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_MSJ_EXTRACTOS
  add constraint PK_GE_MSJ_EXTRACTOS primary key (COD_MENSAJE, FEC_EXTRACTO);
alter table IT.GE_MSJ_EXTRACTOS
  add constraint FK_GMEXT_COD_MENSAJE foreign key (COD_MENSAJE)
  references IT.GE_MENSAJES (COD_MENSAJE);
alter table IT.GE_MSJ_EXTRACTOS
  add constraint AVCON_1080843414_COD_M_029
  check (COD_MENSAJE BETWEEN 1 AND 999);

