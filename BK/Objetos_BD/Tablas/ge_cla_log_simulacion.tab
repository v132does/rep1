-- Crear tabla
CREATE TABLE IT.GE_CLA_LOG_SIMULACION (
  ID_LOG             NUMBER         NOT NULL,
  ID_EJECUCION       NUMBER,
  ID_PARAM           NUMBER,
  PASO               VARCHAR2(100 BYTE),
  FECHA_INICIO       DATE,
  FECHA_FIN          DATE,
  ESTADO             VARCHAR2(40 BYTE),
  MENSAJE_ERROR      VARCHAR2(4000 BYTE),
  REINTENTO          NUMBER         DEFAULT 0,
  FECHA_REINTENTO    DATE,
  USUARIO_EJECUCION  VARCHAR2(100 BYTE),
  ORIGEN_EJECUCION   VARCHAR2(100 BYTE)
)
LOGGING
TABLESPACE IT_DATA
PCTFREE 10
INITRANS 1
STORAGE (
  INITIAL 65536
  NEXT 1048576
  MINEXTENTS 1
  MAXEXTENTS UNLIMITED
  BUFFER_POOL DEFAULT
)
NOCOMPRESS
NO INMEMORY
NOPARALLEL;

-- Crear índice para la PK con nombre descriptivo
CREATE UNIQUE INDEX IT.IDX_GE_CLA_LOG_SIMULACION_PK ON IT.GE_CLA_LOG_SIMULACION (ID_LOG)
LOGGING
TABLESPACE IT_IND
PCTFREE 10
INITRANS 2
STORAGE (
  INITIAL 65536
  NEXT 1048576
  MINEXTENTS 1
  MAXEXTENTS UNLIMITED
  BUFFER_POOL DEFAULT
)
NOPARALLEL;

-- Agregar constraint de clave primaria con nombre legible
ALTER TABLE IT.GE_CLA_LOG_SIMULACION
  ADD CONSTRAINT PK_GE_CLA_LOG_SIMULACION PRIMARY KEY (ID_LOG)
  USING INDEX IT.IDX_GE_CLA_LOG_SIMULACION_PK
  ENABLE;

-- Comentarios
COMMENT ON TABLE IT.GE_CLA_LOG_SIMULACION IS 'Log de pasos ejecutados por el orquestador de Simulacion de Previsiones';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.ID_LOG IS 'Identificador unico del paso';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.ID_EJECUCION IS 'Identificador de la ejecucion completa (compartido por todos los pasos)';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.ID_PARAM IS 'Identificador del parametro utilizado en la ejecucion';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.PASO IS 'Nombre logico del paso';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.FECHA_INICIO IS 'Fecha de inicio del paso';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.FECHA_FIN IS 'Fecha de finalizacion del paso';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.ESTADO IS 'Estado del paso (OK, ERROR, etc)';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.MENSAJE_ERROR IS 'Detalle del error si ocurre';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.REINTENTO IS 'Numero de reintento';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.FECHA_REINTENTO IS 'Fecha del ultimo intento';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.USUARIO_EJECUCION IS 'Usuario Oracle que ejecuta';
COMMENT ON COLUMN IT.GE_CLA_LOG_SIMULACION.ORIGEN_EJECUCION IS 'MANUAL o AUTOMATICA';

CREATE PUBLIC SYNONYM GE_CLA_LOG_SIMULACION FOR IT.GE_CLA_LOG_SIMULACION;
GRANT ALTER, DELETE, INSERT, UPDATE, SELECT ON IT.GE_CLA_LOG_SIMULACION TO IT_TEMPORAL;