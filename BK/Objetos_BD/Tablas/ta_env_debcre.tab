create table IT.TA_ENV_DEBCRE
(
  cod_ent_procesadora NUMBER(5),
  nro_cuenta          VARCHAR2(15),
  nro_tarjeta         VARCHAR2(16),
  monto               NUMBER(18,2),
  fec_valor           DATE,
  fec_envio           DATE,
  hor_envio           VARCHAR2(8),
  concepto            VARCHAR2(35),
  cod_usuario         VARCHAR2(10),
  financia            VARCHAR2(1),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  cod_transaccion     NUMBER(4),
  cod_modulo          NUMBER(3),
  cod_modalidad       NUMBER(3),
  tip_saldo           VARCHAR2(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_ENV_DEBCRE
  is 'Envio de Debitos / Creditos.';
comment on column IT.TA_ENV_DEBCRE.cod_ent_procesadora
  is 'Codigo de la Procesadora.';
comment on column IT.TA_ENV_DEBCRE.nro_cuenta
  is 'Numero de Cuenta de la Tarjeta.';
comment on column IT.TA_ENV_DEBCRE.nro_tarjeta
  is 'Numero de Tarjeta de la Procesadora.';
comment on column IT.TA_ENV_DEBCRE.monto
  is 'Importe del Movimiento.';
comment on column IT.TA_ENV_DEBCRE.fec_valor
  is 'Fecha del Pago.';
comment on column IT.TA_ENV_DEBCRE.fec_envio
  is 'Fecha de Envio. ';
comment on column IT.TA_ENV_DEBCRE.hor_envio
  is 'Hora de Envio.';
comment on column IT.TA_ENV_DEBCRE.concepto
  is 'Descripcion del Movimiento.';
comment on column IT.TA_ENV_DEBCRE.cod_usuario
  is 'Usuario.';
comment on column IT.TA_ENV_DEBCRE.financia
  is 'Financia.';
comment on column IT.TA_ENV_DEBCRE.usu_insercion
  is 'Usuario de insercion.';
comment on column IT.TA_ENV_DEBCRE.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.TA_ENV_DEBCRE.usu_modificacion
  is 'Fecha de modificacion.';
comment on column IT.TA_ENV_DEBCRE.fec_modificacion
  is 'Usuario de modificacion.';
comment on column IT.TA_ENV_DEBCRE.cod_transaccion
  is 'Codigo de la transaccion.';
comment on column IT.TA_ENV_DEBCRE.cod_modulo
  is 'Codigo del Modulo. ';
comment on column IT.TA_ENV_DEBCRE.cod_modalidad
  is 'Codigo de la Modalidad.';
comment on column IT.TA_ENV_DEBCRE.tip_saldo
  is 'Tipo de Saldo.';

