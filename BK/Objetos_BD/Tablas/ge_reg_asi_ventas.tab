create table IT.GE_REG_ASI_VENTAS
(
  cod_reg_asistencia NUMBER(18) not null,
  cod_persona        VARCHAR2(10) not null,
  nom_completo       VARCHAR2(100) not null,
  fecha              DATE not null,
  cod_producto       VARCHAR2(100) not null,
  cod_canal          VARCHAR2(100) not null,
  cod_tip_asistencia VARCHAR2(100) not null,
  observacion        VARCHAR2(3000),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_REG_ASI_VENTAS
  is 'Registro de Asistencia en Venta';
comment on column IT.GE_REG_ASI_VENTAS.cod_reg_asistencia
  is 'Codigo de Registro Asistencia';
comment on column IT.GE_REG_ASI_VENTAS.cod_persona
  is 'Codigo de Persona';
comment on column IT.GE_REG_ASI_VENTAS.nom_completo
  is 'Nombre Completo';
comment on column IT.GE_REG_ASI_VENTAS.fecha
  is 'Fecha de Asistencia';
comment on column IT.GE_REG_ASI_VENTAS.cod_producto
  is 'Codigo de Producto -Referencia(COD_PRO_REG_ASI)';
comment on column IT.GE_REG_ASI_VENTAS.cod_canal
  is 'Codigo de Canal -Referencia(COD_PRO_REG_CANAL)';
comment on column IT.GE_REG_ASI_VENTAS.cod_tip_asistencia
  is 'Tipo de Asistencia -Referencia(COD_TIP_REG_ASI)';
comment on column IT.GE_REG_ASI_VENTAS.observacion
  is 'Observacion';
comment on column IT.GE_REG_ASI_VENTAS.usu_insercion
  is 'Usuario que inserta.';
comment on column IT.GE_REG_ASI_VENTAS.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.GE_REG_ASI_VENTAS.usu_modificacion
  is 'Usuario que modifica.';
comment on column IT.GE_REG_ASI_VENTAS.fec_modificacion
  is 'Fecha de modificacion.';
alter table IT.GE_REG_ASI_VENTAS
  add constraint PK_REG_ASISTENCIA primary key (COD_REG_ASISTENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

