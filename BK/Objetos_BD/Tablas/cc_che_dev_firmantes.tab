create table IT.CC_CHE_DEV_FIRMANTES
(
  nro_cuenta       VARCHAR2(15) not null,
  nro_cheque       NUMBER(15) not null,
  cod_persona      VARCHAR2(10) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CHE_DEV_FIRMANTES
  is 'Firmantes de los cheques devueltos.';
comment on column IT.CC_CHE_DEV_FIRMANTES.nro_cuenta
  is 'Nro de Cuenta.';
comment on column IT.CC_CHE_DEV_FIRMANTES.nro_cheque
  is 'Nro de Cheque.';
comment on column IT.CC_CHE_DEV_FIRMANTES.cod_persona
  is 'Codigo del cliente firmante de este cheque.';
comment on column IT.CC_CHE_DEV_FIRMANTES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CHE_DEV_FIRMANTES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CHE_DEV_FIRMANTES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_DEV_FIRMANTES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CC_CHE_DEV_FIRMANTES
  add constraint PK_CC_CHE_DEV_FIRMANTES primary key (NRO_CUENTA, NRO_CHEQUE, COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 576K
    next 1M
    minextents 1
    maxextents unlimited
  );

