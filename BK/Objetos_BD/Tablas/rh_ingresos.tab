create table IT.RH_INGRESOS
(
  cod_persona         VARCHAR2(10) not null,
  numero              NUMBER not null,
  fecha               DATE not null,
  cod_tip_ingreso     NUMBER(3) not null,
  monto               NUMBER(14,2) not null,
  cod_moneda          VARCHAR2(3) not null,
  ind_automatico      VARCHAR2(1) default 'N' not null,
  ind_procesado       VARCHAR2(1) default 'N' not null,
  cod_per_autorizador VARCHAR2(10),
  observacion         VARCHAR2(1000),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_INGRESOS
  is 'Ingresos del Empleado.';
comment on column IT.RH_INGRESOS.cod_persona
  is 'Codigo de la Persona.';
comment on column IT.RH_INGRESOS.numero
  is 'Numero secuencial de Ingreso por empleado.';
comment on column IT.RH_INGRESOS.fecha
  is 'Fecha del Ingreso.';
comment on column IT.RH_INGRESOS.cod_tip_ingreso
  is 'Codigo del Tipo de Ingreso.';
comment on column IT.RH_INGRESOS.monto
  is 'Monto del Ingreso.';
comment on column IT.RH_INGRESOS.cod_moneda
  is 'Codigo de la Moneda.';
comment on column IT.RH_INGRESOS.ind_automatico
  is 'Indica si el Ingreso es Automatico o no.';
comment on column IT.RH_INGRESOS.ind_procesado
  is 'Indica si el Ingreso ya fue procesado o no.';
comment on column IT.RH_INGRESOS.cod_per_autorizador
  is 'Persona que autoriza el ingreso.';
comment on column IT.RH_INGRESOS.observacion
  is 'Observacion.';
comment on column IT.RH_INGRESOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_INGRESOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_INGRESOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_INGRESOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_HINGR_COD_PERSONA on IT.RH_INGRESOS (COD_TIP_INGRESO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_INGRESOS
  add constraint PK_RH_INGRESOS primary key (COD_PERSONA, NUMERO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_INGRESOS
  add constraint FK_HINGR_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.RH_INGRESOS
  add constraint FK_HINGR_COD_PERSONA foreign key (COD_PERSONA)
  references IT.RH_EMPLEADOS (COD_PERSONA);
alter table IT.RH_INGRESOS
  add constraint FK_HINGR_COD_TIP_INGRESO foreign key (COD_TIP_INGRESO)
  references IT.RH_TIP_INGRESOS (COD_TIP_INGRESO);
alter table IT.RH_INGRESOS
  add constraint FK_HINGR_PER_AUTORIZADOR foreign key (COD_PER_AUTORIZADOR)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.RH_INGRESOS
  add constraint AVCON_1191539488_IND_A_000
  check (IND_AUTOMATICO IN ('S', 'N'));
alter table IT.RH_INGRESOS
  add constraint AVCON_1191539488_IND_P_000
  check (IND_PROCESADO IN ('S', 'N'));

