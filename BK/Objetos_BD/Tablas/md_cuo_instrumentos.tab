-- Create table
create table IT.MD_CUO_INSTRUMENTOS
(
  nro_cuenta           VARCHAR2(15) not null,
  nro_cuota            NUMBER(5) not null,
  mto_cuota            NUMBER(18,2) not null,
  estado               VARCHAR2(1) default 'S' not null,
  nro_cta_repo         VARCHAR2(15),
  val_tas_rendimiento  NUMBER(12,6),
  mto_presente         NUMBER(18,2),
  val_tas_porcentaje   NUMBER(14,8),
  mto_interes          NUMBER(18,2),
  mto_con_descuento    NUMBER(18,2),
  val_tas_instrumento  NUMBER(12,6),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  val_int_cuo_devengar NUMBER(20,4),
  mto_dev_cuo_actual   NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.MD_CUO_INSTRUMENTOS
  is 'Cuotas de las Cuentas de Mesa de Dinero.';
-- Add comments to the columns 
comment on column IT.MD_CUO_INSTRUMENTOS.nro_cuenta
  is 'Número de Cuenta.';
comment on column IT.MD_CUO_INSTRUMENTOS.nro_cuota
  is 'Número de Cuota. Por defecto todas las cuentas tendrán una sola cuota, solo en caso de REPO Recibido si es necesario el usuario dividirá las cuotas.';
comment on column IT.MD_CUO_INSTRUMENTOS.mto_cuota
  is 'Monto de Cuota (monto capital del documento).';
comment on column IT.MD_CUO_INSTRUMENTOS.estado
  is 'Estado de la Cuota. Los estados posibles son S-Solicitado, C-Vigente, R-ipeado, E-Repo, N-Cancelado, V-encido.';
comment on column IT.MD_CUO_INSTRUMENTOS.nro_cta_repo
  is 'Número de Cuenta REPO correspondiente a la cuota.';
comment on column IT.MD_CUO_INSTRUMENTOS.val_tas_rendimiento
  is 'Tasa marcada por la curva de rendimiento. (Sirve para calcular el precio del mercado del instrumento).';
comment on column IT.MD_CUO_INSTRUMENTOS.mto_presente
  is 'Monto del precio del instrumento en el mercado, que es negociado sin del descuento de Interes.';
comment on column IT.MD_CUO_INSTRUMENTOS.val_tas_porcentaje
  is 'Porcentaje de tasa para calcular el descuento (Sirve para calcular el interés a descontar del instrumento con Haircut).';
comment on column IT.MD_CUO_INSTRUMENTOS.mto_interes
  is 'Monto de Interes calculado a partir de Monto Presente y la Tasa del Porcentaje de Descuento.';
comment on column IT.MD_CUO_INSTRUMENTOS.mto_con_descuento
  is 'Monto del instrumento que es negociado con el  % de descuento de interés aplicado.';
comment on column IT.MD_CUO_INSTRUMENTOS.val_tas_instrumento
  is 'Tasa del Instrumento en la Operacion Repo.';
comment on column IT.MD_CUO_INSTRUMENTOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.MD_CUO_INSTRUMENTOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.MD_CUO_INSTRUMENTOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.MD_CUO_INSTRUMENTOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.MD_CUO_INSTRUMENTOS.val_int_cuo_devengar
  is 'Valor del Interes a Devengar a la Alta Reclasificacion Instrumentos.';
comment on column IT.MD_CUO_INSTRUMENTOS.mto_dev_cuo_actual
  is 'Valor de la porcion de Interes Devengado del Instrumento a la fecha.';
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.MD_CUO_INSTRUMENTOS
  add constraint PK_MD_CUO_INSTRUMENTOS primary key (NRO_CUENTA, NRO_CUOTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate check constraints 
alter table IT.MD_CUO_INSTRUMENTOS
  add constraint CK_MDCUO_ESTADO
  check (ESTADO IN ('R','C','N','V','S','E','X','T','I'));
-- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.MD_CUO_INSTRUMENTOS to IT_TEMPORAL;
