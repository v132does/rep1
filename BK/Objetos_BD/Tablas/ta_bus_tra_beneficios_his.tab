create table IT.TA_BUS_TRA_BENEFICIOS_HIS
(
  identificador                 NUMBER(15) not null,
  fecha_transaccion             DATE not null,
  confirmacion_reintegro        NUMBER(1) null,
  fecha_proceso                 DATE,
  usu_insercion                 VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion                 DATE default SYSDATE not null,
  usu_modificacion              VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion              DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

alter table IT.TA_BUS_TRA_BENEFICIOS_HIS
add primary key (IDENTIFICADOR)
using index
tablespace IT_DATA
pctfree 10
initrans 2
maxtrans 255
storage
(
  initial 64K
  next 1M
  minextents 1
  maxextents unlimited
);

comment on table IT.TA_BUS_TRA_BENEFICIOS_HIS
  is 'BENEFICIOS - TA_BUS_TRANSACCIONES procesados historico';
comment on column IT.TA_BUS_TRA_BENEFICIOS_HIS.identificador
  is 'Identificacor de la operacion';
comment on column IT.TA_BUS_TRA_BENEFICIOS_HIS.fecha_transaccion
  is 'Fecha de transaccion';
comment on column IT.TA_BUS_TRA_BENEFICIOS_HIS.confirmacion_reintegro
  is 'Confirmacion Reintegro';
comment on column IT.TA_BUS_TRA_BENEFICIOS_HIS.fecha_proceso
  is 'Fecha Proceso';
comment on column IT.TA_BUS_TRA_BENEFICIOS_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_BUS_TRA_BENEFICIOS_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_BUS_TRA_BENEFICIOS_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_BUS_TRA_BENEFICIOS_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
  -- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.TA_BUS_TRA_BENEFICIOS_HIS to IT_TEMPORAL;