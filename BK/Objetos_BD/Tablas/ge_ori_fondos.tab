create table IT.GE_ORI_FONDOS
(
  cod_ori_fondo    NUMBER(8) not null,
  descripcion      VARCHAR2(60),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion    DATE default SYSDATE,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion DATE default SYSDATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_ORI_FONDOS
  is 'Origen de Fondos.';
comment on column IT.GE_ORI_FONDOS.cod_ori_fondo
  is 'Código de Origen de Fondos.';
comment on column IT.GE_ORI_FONDOS.descripcion
  is 'Descripción de Origen de Fondos.';
comment on column IT.GE_ORI_FONDOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_ORI_FONDOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_ORI_FONDOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_ORI_FONDOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_ORI_FONDOS
  add constraint PK_GE_ORI_FONDOS primary key (COD_ORI_FONDO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

