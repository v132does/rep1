  nudoc            NUMBER not null,
  guaranies        NUMBER,
  contravalo       NUMBER,
  iaddivisa        NUMBER,
  vencim           VARCHAR2(8) not null,
  codtasa          NUMBER,
  nrolibrado       NUMBER,
  ctadocact        NUMBER,
  rubro_act        VARCHAR2(4000),
  ctadocpas        NUMBER,
  rubro_pas        VARCHAR2(4000),
  filler           VARCHAR2(15),
  tipod            NUMBER not null,
  fechaemisi       VARCHAR2(6),
  sucursalcu       NUMBER,
  gastosgc         NUMBER,
  vctoint          VARCHAR2(6),
  iadmontodc       NUMBER,
  iadsaldocp       NUMBER,
