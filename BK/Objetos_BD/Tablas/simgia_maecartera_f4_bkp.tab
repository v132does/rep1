tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SIMGIA_MAECARTERA_F4_BKP
  add constraint PK_SMG_MAECARTERA_F4_BKP primary key (NURIES, CONGRU, VENCIM, NUDOC, TIPOD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

