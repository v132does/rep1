create table IT.CC_CTA_FICTICIAS
(
  nro_cuenta       VARCHAR2(15) not null,
  cod_transaccion  NUMBER(4),
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  cod_rubro        VARCHAR2(15),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  nro_cta_cliente  VARCHAR2(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CTA_FICTICIAS
  is 'Cuenta Ficticia Utilizada en Infonet.';
comment on column IT.CC_CTA_FICTICIAS.nro_cuenta
  is 'Numero de Cuenta Ficticia.';
comment on column IT.CC_CTA_FICTICIAS.cod_transaccion
  is 'Transaccion Hija Relacionada (a ser grabadaen el fgdiari).';
comment on column IT.CC_CTA_FICTICIAS.cod_modulo
  is 'Modulo relacionado.';
comment on column IT.CC_CTA_FICTICIAS.cod_modalidad
  is 'Modalidad relacionada.';
comment on column IT.CC_CTA_FICTICIAS.descripcion
  is 'Descripcion.';
comment on column IT.CC_CTA_FICTICIAS.cod_rubro
  is 'Cuenta Contable.';
comment on column IT.CC_CTA_FICTICIAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CTA_FICTICIAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CTA_FICTICIAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CTA_FICTICIAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CTA_FICTICIAS.nro_cta_cliente
  is 'Nro. de Cuenta Cliente';
create index IT.IN_CCFIC_COD_MODALIDAD on IT.CC_CTA_FICTICIAS (COD_MODALIDAD, COD_MODULO, COD_RUBRO, COD_TRANSACCION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CTA_FICTICIAS
  add constraint PK_CC_CTA_FICTICIAS primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CTA_FICTICIAS
  add constraint FK_CCFIC_COD_RUBRO foreign key (COD_RUBRO)
  references IT.CB_RUBROS (COD_RUBRO);
alter table IT.CC_CTA_FICTICIAS
  add constraint FK_CCFIC_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.CC_CTA_FICTICIAS
  add constraint AVCON_CCOD_M_002
  check (COD_MODULO BETWEEN 1 AND 999);
alter table IT.CC_CTA_FICTICIAS
  add constraint AVCON_CCOD_M_003
  check (COD_MODALIDAD BETWEEN 1 AND 999);

