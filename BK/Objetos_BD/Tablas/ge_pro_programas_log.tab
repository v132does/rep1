CREATE TABLE it.GE_PRO_PROGRAMAS_LOG (
   COD_PROCESO   NUMBER(3,0),
   NRO_ORDEN     NUMBER(3,0),
   COD_PROGRAMA  VARCHAR2(30 BYTE),
   MENSAJE       VARCHAR2(500),
   NIVEL         VARCHAR2(5),
   CONTEXTO      VARCHAR2(15 BYTE),
   FECHA         DATE default SYSDATE,
   USU_INSERCION VARCHAR2(10) default SUBSTR(USER,1,10),
   FEC_INSERCION DATE default SYSDATE
)
tablespace IT_DATA
pctfree 10
initrans 1
maxtrans 255
storage
(
  initial 64K
  next 1M
  minextents 1
  maxextents unlimited
);

COMMENT ON TABLE it.GE_PRO_PROGRAMAS_LOG IS 'Mensajes de log durante la ejecucion de los Programas de un Proceso.';

COMMENT ON COLUMN it.GE_PRO_PROGRAMAS_LOG.COD_PROCESO IS 'Codigo de Proceso.';

COMMENT ON COLUMN it.GE_PRO_PROGRAMAS_LOG.NRO_ORDEN IS 'Numero de Orden.';

COMMENT ON COLUMN it.GE_PRO_PROGRAMAS_LOG.COD_PROGRAMA IS 'Nombre del Programa.';

COMMENT ON COLUMN it.GE_PRO_PROGRAMAS_LOG.MENSAJE IS 'Traza de log.';

COMMENT ON COLUMN it.GE_PRO_PROGRAMAS_LOG.NIVEL IS 'Nivel de log: OFF, TRACE, DEBUG, INFO, WARN, ERROR, FATAL.';

COMMENT ON COLUMN it.GE_PRO_PROGRAMAS_LOG.CONTEXTO IS 'Contexto de ejecucion del Programa.';

COMMENT ON COLUMN it.GE_PRO_PROGRAMAS_LOG.FECHA IS 'Fecha en que se genera el mensaje.';

COMMENT ON COLUMN it.GE_PRO_PROGRAMAS_LOG.USU_INSERCION IS 'Usuario que realizo la insercion del registro.';

COMMENT ON COLUMN it.GE_PRO_PROGRAMAS_LOG.FEC_INSERCION IS 'Fecha en que se inserto el registro.';

CREATE INDEX IT.IN_GPROL_NRO_ORDEN ON it.GE_PRO_PROGRAMAS_LOG (NRO_ORDEN)
TABLESPACE IT_IND
pctfree 10
initrans 2
maxtrans 255;

CREATE INDEX IT.IN_GPROL_COD_PROGRAMA ON it.GE_PRO_PROGRAMAS_LOG (COD_PROGRAMA)
TABLESPACE IT_IND
pctfree 10
initrans 2
maxtrans 255;

CREATE INDEX IT.IN_GPROL_NIVEL ON it.GE_PRO_PROGRAMAS_LOG (NIVEL)
TABLESPACE IT_IND
pctfree 10
initrans 2
maxtrans 255;

CREATE PUBLIC SYNONYM GE_PRO_PROGRAMAS_LOG FOR it.GE_PRO_PROGRAMAS_LOG;

GRANT ALTER, DELETE, INSERT, UPDATE, SELECT on it.GE_PRO_PROGRAMAS_LOG to IT_TEMPORAL;
