create table IT.GE_PAQ_CLIENTES
(
  cod_paquete      NUMBER(3) not null,
  cod_persona      VARCHAR2(10) not null,
  fec_inicio       DATE default trunc(sysdate),
  fec_final        DATE,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  estado           VARCHAR2(1),
  nro_secuencia    NUMBER(3) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAQ_CLIENTES
  is 'Clientes Vinculados a Paquetes';
comment on column IT.GE_PAQ_CLIENTES.cod_paquete
  is 'Código de Paquete.';
comment on column IT.GE_PAQ_CLIENTES.cod_persona
  is 'Código de Cliente.';
comment on column IT.GE_PAQ_CLIENTES.fec_inicio
  is 'Fecha de Inicio del Paquete.';
comment on column IT.GE_PAQ_CLIENTES.fec_final
  is 'Fecha Final del Paquete.';
comment on column IT.GE_PAQ_CLIENTES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_PAQ_CLIENTES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PAQ_CLIENTES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAQ_CLIENTES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAQ_CLIENTES.estado
  is 'Estado del Paquete, N=Normal, C=Cancelado';
comment on column IT.GE_PAQ_CLIENTES.nro_secuencia
  is 'Número de Secuencia';
alter table IT.GE_PAQ_CLIENTES
  add constraint PK_GE_PAQ_CLIENTES primary key (COD_PAQUETE, COD_PERSONA, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAQ_CLIENTES
  add constraint FK_GPACLI_COD_PAQUETE foreign key (COD_PAQUETE)
  references IT.GE_PAQUETES (COD_PAQUETE);
alter table IT.GE_PAQ_CLIENTES
  add constraint FK_GPACLI_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);

