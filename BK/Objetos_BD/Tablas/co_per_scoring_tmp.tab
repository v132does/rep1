create table IT.CO_PER_SCORING_TMP
(
  cod_persona      VARCHAR2(10),
  tipo             VARCHAR2(1),
  scoring          NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CO_PER_SCORING_TMP
  is 'Scoring de las Personas.';
comment on column IT.CO_PER_SCORING_TMP.cod_persona
  is 'Código de la Persona.';
comment on column IT.CO_PER_SCORING_TMP.tipo
  is 'Indica por cual Scoring fue calculado: Mora Temprana, Mora Tardía.';
comment on column IT.CO_PER_SCORING_TMP.scoring
  is 'Puntuación del Cliente.';
comment on column IT.CO_PER_SCORING_TMP.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CO_PER_SCORING_TMP.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CO_PER_SCORING_TMP.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CO_PER_SCORING_TMP.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';

