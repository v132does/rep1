create table IT.MD_TABLESPACES
(
  id                NUMBER not null,
  schema_id_fk      NUMBER not null,
  tablespace_name   VARCHAR2(4000),
  native_sql        CLOB,
  native_key        VARCHAR2(4000),
  comments          VARCHAR2(4000),
  security_group_id NUMBER default 0 not null,
  created_on        DATE default sysdate not null,
  created_by        VARCHAR2(255),
  last_updated_on   DATE,
  last_updated_by   VARCHAR2(255)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MD_TABLESPACES
  is 'For storing information about tablespaces.';
comment on column IT.MD_TABLESPACES.id
  is 'Primary Key';
comment on column IT.MD_TABLESPACES.schema_id_fk
  is 'Schema to which this tablespace belongs //PARENTFIELD';
comment on column IT.MD_TABLESPACES.tablespace_name
  is 'Name of the table space //OBJECTNAME';
comment on column IT.MD_TABLESPACES.native_sql
  is 'The SQL used to create this tablespace';
comment on column IT.MD_TABLESPACES.native_key
  is 'A unique identifier for this object at source';
alter table IT.MD_TABLESPACES
  add constraint MD_TABLESPACES_PK primary key (ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.MD_TABLESPACES
  add constraint MD_TABLESPACES_MD_SCHEMAS_FK1 foreign key (SCHEMA_ID_FK)
  references IT.MD_SCHEMAS (ID) on delete cascade;

