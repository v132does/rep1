create table IT.GE_SOL_CODEUDORES
(
  nro_solicitud    NUMBER(7) not null,
  cod_persona      VARCHAR2(10) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SOL_CODEUDORES
  is 'Codeudores de la Solicitud.';
comment on column IT.GE_SOL_CODEUDORES.nro_solicitud
  is 'Numero de solicitud.';
comment on column IT.GE_SOL_CODEUDORES.cod_persona
  is 'Codigo de persona.';
comment on column IT.GE_SOL_CODEUDORES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_SOL_CODEUDORES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_SOL_CODEUDORES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_SOL_CODEUDORES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_GSCOD_COD_PERSONA on IT.GE_SOL_CODEUDORES (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_CODEUDORES
  add constraint PK_GE_SOL_CODEUDORES primary key (NRO_SOLICITUD, COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_CODEUDORES
  add constraint FK_GSCOD_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_SOL_CODEUDORES
  add constraint FK_GSCOD_NRO_SOLICITUD foreign key (NRO_SOLICITUD)
  references IT.GE_SOLICITUDES (NRO_SOLICITUD);

