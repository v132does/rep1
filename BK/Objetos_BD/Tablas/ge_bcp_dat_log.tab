create table IT.GE_BCP_DAT_LOG
(
  cod_error     NUMBER(5),
  error         VARCHAR2(2000),
  lugar         VARCHAR2(2000),
  parametro     VARCHAR2(2000),
  usu_insercion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

