create table IT.BW_NOT_RET_PRO_SUC
(
  cod_mensaje      NUMBER default 0 not null,
  nro_producto     VARCHAR2(20) not null,
  nro_cedula       VARCHAR2(20) not null,
  nro_cuenta       VARCHAR2(20) not null,
  producto         VARCHAR2(40) not null,
  categoria        VARCHAR2(40) not null,
  sucursal         VARCHAR2(40) not null,
  fec_retiro       DATE not null,
  lote             NUMBER,
  encolado         VARCHAR2(1),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_NOT_RET_PRO_SUC
  is 'Datos para Retiro de Productos Retenidos en Sucursal.';
comment on column IT.BW_NOT_RET_PRO_SUC.cod_mensaje
  is 'Identificador de los mensaje';
comment on column IT.BW_NOT_RET_PRO_SUC.nro_producto
  is 'Numero de Producto';
comment on column IT.BW_NOT_RET_PRO_SUC.nro_cedula
  is 'Numero de Cedula de Identidad';
comment on column IT.BW_NOT_RET_PRO_SUC.nro_cuenta
  is 'Numero de Cuenta';
comment on column IT.BW_NOT_RET_PRO_SUC.producto
  is 'Descripcion de Producto';
comment on column IT.BW_NOT_RET_PRO_SUC.categoria
  is 'Descripcion de Categoria de Producto.';
comment on column IT.BW_NOT_RET_PRO_SUC.sucursal
  is 'Descripcion de Sucursal';
comment on column IT.BW_NOT_RET_PRO_SUC.fec_retiro
  is 'Fecha de Retiro';
comment on column IT.BW_NOT_RET_PRO_SUC.lote
  is 'Agrupador de mensajes';
comment on column IT.BW_NOT_RET_PRO_SUC.encolado
  is 'Indica si fue encolado para envio';
comment on column IT.BW_NOT_RET_PRO_SUC.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BW_NOT_RET_PRO_SUC.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BW_NOT_RET_PRO_SUC.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BW_NOT_RET_PRO_SUC.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro. ';

