create table IT.BW_LIMITES_DET
(
  nro_secuencia    NUMBER(20) not null,
  cod_tip_mensaje  VARCHAR2(3) not null,
  mto_mensaje      NUMBER(18,2),
  cod_moneda       VARCHAR2(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_LIMITES_DET
  is 'Detalle de Limites por Canal.';
comment on column IT.BW_LIMITES_DET.nro_secuencia
  is 'Número de Secuencia.';
comment on column IT.BW_LIMITES_DET.cod_tip_mensaje
  is 'Código de Tipo de Mensaje.';
comment on column IT.BW_LIMITES_DET.mto_mensaje
  is 'Monto máximo por Mensaje.';
comment on column IT.BW_LIMITES_DET.cod_moneda
  is 'Código de Moneda.';
comment on column IT.BW_LIMITES_DET.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BW_LIMITES_DET.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BW_LIMITES_DET.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BW_LIMITES_DET.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BW_LIMITES_DET
  add constraint PK_BW_LIMITES_DET primary key (NRO_SECUENCIA, COD_TIP_MENSAJE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BW_LIMITES_DET
  add constraint FK_WLDET_COD_TIP_MENSAJE foreign key (COD_TIP_MENSAJE)
  references IT.BW_TIP_MENSAJES (COD_TIP_MENSAJE);
alter table IT.BW_LIMITES_DET
  add constraint FK_WLDET_NRO_SECUENCIA foreign key (NRO_SECUENCIA)
  references IT.BW_LIMITES (NRO_SECUENCIA);

