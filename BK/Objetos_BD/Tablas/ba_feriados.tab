create table IT.BA_FERIADOS
(
  fecha            DATE not null,
  cod_oficina      NUMBER(3),
  motivo           VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_FERIADOS
  is 'Feriados.';
comment on column IT.BA_FERIADOS.fecha
  is 'Fecha correspondiente al feriado.';
comment on column IT.BA_FERIADOS.cod_oficina
  is 'Codigo de la oficina.';
comment on column IT.BA_FERIADOS.motivo
  is 'Motivo del feriado.';
comment on column IT.BA_FERIADOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_FERIADOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_FERIADOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_FERIADOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BA_FERIADOS
  add constraint UK_BA_FERIADOS unique (FECHA, COD_OFICINA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_FERIADOS
  add constraint FK_EFERI_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.BA_FERIADOS
  add constraint AVCON_1080842839_COD_O_000
  check (COD_OFICINA BETWEEN 1 AND 999);

