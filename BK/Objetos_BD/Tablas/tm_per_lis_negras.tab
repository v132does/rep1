create table IT.TM_PER_LIS_NEGRAS
(
  nro_documento   VARCHAR2(10),
  nom_completo    VARCHAR2(200),
  tip_persona     VARCHAR2(12),
  cod_pais        VARCHAR2(20),
  nom_cargo       VARCHAR2(250),
  dat_adicionales VARCHAR2(300),
  msj_error       VARCHAR2(3000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TM_PER_LIS_NEGRAS
  is 'Archivo temporal de carga de Personas de LISTA NEGRA.';
comment on column IT.TM_PER_LIS_NEGRAS.nro_documento
  is 'Numero de documento.';
comment on column IT.TM_PER_LIS_NEGRAS.nom_completo
  is 'Nombre completo de la persona.';
comment on column IT.TM_PER_LIS_NEGRAS.tip_persona
  is 'Tipo de persona segun la lista negra.';
comment on column IT.TM_PER_LIS_NEGRAS.cod_pais
  is 'Pais de la persona.';
comment on column IT.TM_PER_LIS_NEGRAS.nom_cargo
  is 'Cargo de la persona.';
comment on column IT.TM_PER_LIS_NEGRAS.dat_adicionales
  is 'Datos adicionales.';
comment on column IT.TM_PER_LIS_NEGRAS.msj_error
  is 'Mensaje de Error del Proceso de carga de datos.';

