create table IT.BW_NOT_PAQUETES
(
  cod_evento       NUMBER(4) not null,
  activo           VARCHAR2(1) default 'S' not null,
  paquete          NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_NOT_PAQUETES
  is 'Paquetes de suscripcion';
comment on column IT.BW_NOT_PAQUETES.cod_evento
  is 'Codigo del evento';
comment on column IT.BW_NOT_PAQUETES.activo
  is 'Indica el estado del evento en el paquete (S activo, N no)';
comment on column IT.BW_NOT_PAQUETES.paquete
  is 'Agrupador de paquetes (Para uso futuro)';
alter table IT.BW_NOT_PAQUETES
  add constraint FK_COD_EVENTO foreign key (COD_EVENTO)
  references IT.BW_NOT_EVENTOS (COD_EVENTO);

