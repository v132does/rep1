create table IT.RH_PER_PREAVISO
(
  ano_desde        NUMBER(2) not null,
  ano_hasta        NUMBER(2) not null,
  descripcion      VARCHAR2(40) not null,
  dias_preaviso    NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_PER_PREAVISO
  is 'Periodos de Preaviso.';
comment on column IT.RH_PER_PREAVISO.ano_desde
  is 'Año de antiguedad laboral desde.';
comment on column IT.RH_PER_PREAVISO.ano_hasta
  is 'Año de antiguedad laboral Hasta.';
comment on column IT.RH_PER_PREAVISO.descripcion
  is 'Descripcion.';
comment on column IT.RH_PER_PREAVISO.dias_preaviso
  is 'Dias de Preaviso correspondientes al Periodo.';
comment on column IT.RH_PER_PREAVISO.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_PER_PREAVISO.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_PER_PREAVISO.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_PER_PREAVISO.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.RH_PER_PREAVISO
  add constraint PK_RH_PER_PREAVISO primary key (ANO_DESDE, ANO_HASTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_PER_PREAVISO
  add constraint UK_HPPRE_DESCRIPCION unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_PER_PREAVISO
  add constraint CK_ANO_HASTA_PREAVISO
  check (ANO_HASTA >= ANO_DESDE);

