create table IT.IG_OPERACIONES
(
  nro_cuenta           VARCHAR2(15) not null,
  fecha                DATE not null,
  cod_concepto         NUMBER(3) not null,
  cod_sub_concepto     NUMBER(4) not null,
  cod_periodo          NUMBER(3) not null,
  cod_persona          VARCHAR2(10) not null,
  cod_modulo           NUMBER(3) not null,
  cod_modalidad        NUMBER(3) not null,
  cod_oficina          NUMBER(3) not null,
  estado               VARCHAR2(1) not null,
  fec_apertura         DATE,
  fec_vencimiento      DATE,
  fec_cancelacion      DATE,
  cod_moneda           VARCHAR2(3) not null,
  mto_apertura         NUMBER(18,2) default 0,
  saldo                NUMBER(18,2) default 0,
  interes              NUMBER(18,2) default 0,
  int_devengado        NUMBER(18,2) default 0,
  int_devengar         NUMBER(18,2) default 0,
  int_dev_suspenso     NUMBER(18,2) default 0,
  int_recuperado       NUMBER(18,2) default 0,
  mto_mora             NUMBER(18,2) default 0,
  sal_promedio         NUMBER(18,2) default 0,
  con_mto_apertura     NUMBER(18,2) default 0,
  con_saldo            NUMBER(18,2) default 0,
  con_interes          NUMBER(18,2) default 0,
  con_int_devengado    NUMBER(18,2) default 0,
  con_int_devengar     NUMBER(18,2) default 0,
  con_int_dev_suspenso NUMBER(18,2) default 0,
  con_int_recuperado   NUMBER(18,2) default 0,
  con_mto_mora         NUMBER(18,2) default 0,
  con_sal_promedio     NUMBER(18,2) default 0,
  por_mora             NUMBER(15,2),
  logro                NUMBER(18,2) default 0,
  con_logro            NUMBER(18,2) default 0,
  dia_mora             NUMBER(5),
  pro_mora             NUMBER(5),
  max_mora             NUMBER(5),
  val_tasa             NUMBER(20,4),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cod_usu_oficial      VARCHAR2(10),
  cod_unidad           NUMBER(3),
  dias                 NUMBER(3),
  cod_plazo            NUMBER(3) default 1
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.IG_OPERACIONES
  is 'Detalle de las Operaciones para el SGP.';
comment on column IT.IG_OPERACIONES.nro_cuenta
  is 'Numero de Cuenta.';
comment on column IT.IG_OPERACIONES.fecha
  is 'Fecha de proceso.';
comment on column IT.IG_OPERACIONES.cod_concepto
  is 'Codigo de Concepto.';
comment on column IT.IG_OPERACIONES.cod_sub_concepto
  is 'Codigo de Sub-Concepto.';
comment on column IT.IG_OPERACIONES.cod_periodo
  is 'Codigo del periodo.';
comment on column IT.IG_OPERACIONES.cod_persona
  is 'Codigo de Cliente Principal.';
comment on column IT.IG_OPERACIONES.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.IG_OPERACIONES.cod_modalidad
  is 'Codigo de la modalidad.';
comment on column IT.IG_OPERACIONES.cod_oficina
  is 'Codigo de la Oficina.';
comment on column IT.IG_OPERACIONES.estado
  is 'Estado de la Cuenta.';
comment on column IT.IG_OPERACIONES.fec_apertura
  is 'Fecha de Apertura.';
comment on column IT.IG_OPERACIONES.fec_vencimiento
  is 'Fecha de Vencimiento.';
comment on column IT.IG_OPERACIONES.fec_cancelacion
  is 'Fecha de Cancelacion.';
comment on column IT.IG_OPERACIONES.cod_moneda
  is 'Moneda de la Cuenta.';
comment on column IT.IG_OPERACIONES.mto_apertura
  is 'Monto inicial.';
comment on column IT.IG_OPERACIONES.saldo
  is 'Saldo actual.';
comment on column IT.IG_OPERACIONES.interes
  is 'Interes actual.';
comment on column IT.IG_OPERACIONES.int_devengado
  is 'Interes devengado a la fecha.';
comment on column IT.IG_OPERACIONES.int_devengar
  is 'Interes a devengar a la fecha.';
comment on column IT.IG_OPERACIONES.int_dev_suspenso
  is 'Interes devengado en suspenso a la fecha.';
comment on column IT.IG_OPERACIONES.int_recuperado
  is 'Interes devengado recuperado a la fecha.';
comment on column IT.IG_OPERACIONES.mto_mora
  is 'Monto de mora.';
comment on column IT.IG_OPERACIONES.sal_promedio
  is 'Saldo Promedio Actual.';
comment on column IT.IG_OPERACIONES.con_mto_apertura
  is 'Monto Inicial en moneda de consolidacion.';
comment on column IT.IG_OPERACIONES.con_saldo
  is 'Saldo actual en moneda de consolidacion.';
comment on column IT.IG_OPERACIONES.con_interes
  is 'Interes actual en moneda de consolidacion.';
comment on column IT.IG_OPERACIONES.con_int_devengado
  is 'Interes devengado a la fecha en moneda de consolidacion.';
comment on column IT.IG_OPERACIONES.con_int_devengar
  is 'Interes a devengar a la fecha en moneda de consolidacion.';
comment on column IT.IG_OPERACIONES.con_int_dev_suspenso
  is 'Interes devengado en suspenso a la fecha en moneda de consolidacion.';
comment on column IT.IG_OPERACIONES.con_int_recuperado
  is 'Interes devengado recuperado a la fecha en moneda de consolidacion.';
comment on column IT.IG_OPERACIONES.con_mto_mora
  is 'Monto de mora en moneda de consolidacion.';
comment on column IT.IG_OPERACIONES.con_sal_promedio
  is 'Saldo Promedio Actual en moneda de consolidacion.';
comment on column IT.IG_OPERACIONES.por_mora
  is 'Porcentaje en mora.';
comment on column IT.IG_OPERACIONES.logro
  is 'Monto del logro.';
comment on column IT.IG_OPERACIONES.con_logro
  is 'Monto del logro en moneda de consolidacion.';
comment on column IT.IG_OPERACIONES.dia_mora
  is 'Dias de Atraso.';
comment on column IT.IG_OPERACIONES.pro_mora
  is 'Promedio de dias de Atraso.';
comment on column IT.IG_OPERACIONES.max_mora
  is 'Maximo dias de Atraso.';
comment on column IT.IG_OPERACIONES.val_tasa
  is 'Valor de la tasa.';
comment on column IT.IG_OPERACIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.IG_OPERACIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.IG_OPERACIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.IG_OPERACIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.IG_OPERACIONES.cod_usu_oficial
  is 'Codigo de usuario del oficial.';
comment on column IT.IG_OPERACIONES.cod_unidad
  is 'Codigo de unidad de negocio.';
comment on column IT.IG_OPERACIONES.dias
  is 'Dias de vigencia de estos datos(fecha_proxima_habil - fecha_de_hoy).';
comment on column IT.IG_OPERACIONES.cod_plazo
  is 'Codigo de plazo de la operacion.';
create unique index IT.IN_IOPER_COD_PERSONA on IT.IG_OPERACIONES (COD_PERSONA, NRO_CUENTA, FECHA, COD_CONCEPTO, COD_SUB_CONCEPTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_IOPER_COD_PERSONA_FECHA on IT.IG_OPERACIONES (COD_PERSONA, FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_IOPER_FECHA on IT.IG_OPERACIONES (FECHA, COD_CONCEPTO, COD_SUB_CONCEPTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.IG_OPERACIONES
  add constraint PK_IG_OPERACIONES primary key (NRO_CUENTA, FECHA, COD_CONCEPTO, COD_SUB_CONCEPTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.IG_OPERACIONES
  add constraint FK_IOPER_COD_CONCEPTO foreign key (COD_CONCEPTO)
  references IT.IG_CONCEPTOS (COD_CONCEPTO);
alter table IT.IG_OPERACIONES
  add constraint FK_IOPER_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.IG_OPERACIONES
  add constraint FK_IOPER_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.IG_OPERACIONES
  add constraint FK_IOPER_COD_PERIODO foreign key (COD_PERIODO)
  references IT.IG_PARAMETROS (COD_PERIODO);
alter table IT.IG_OPERACIONES
  add constraint FK_IOPER_COD_PERSONA foreign key (COD_PERSONA)
  references IT.GE_CLIENTES (COD_PERSONA);
alter table IT.IG_OPERACIONES
  add constraint FK_IOPER_COD_PLAZO foreign key (COD_PLAZO)
  references IT.IG_PLAZOS (COD_PLAZO);
alter table IT.IG_OPERACIONES
  add constraint FK_IOPER_COD_SUB_CONCEPTO foreign key (COD_CONCEPTO, COD_SUB_CONCEPTO)
  references IT.IG_SUB_CONCEPTOS (COD_CONCEPTO, COD_SUB_CONCEPTO);
alter table IT.IG_OPERACIONES
  add constraint FK_IOPER_COD_UNIDAD foreign key (COD_UNIDAD)
  references IT.IG_UNI_NEGOCIOS (COD_UNIDAD);
alter table IT.IG_OPERACIONES
  add constraint FK_IOPER_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

