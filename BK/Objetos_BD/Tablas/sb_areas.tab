create table IT.SB_AREAS
(
  cod_are_bcp      NUMBER(4) not null,
  descripcion      VARCHAR2(70) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_AREAS
  is 'Areas-Sectores de BCP.';
comment on column IT.SB_AREAS.cod_are_bcp
  is 'Codigo del Area designado por BCP.';
comment on column IT.SB_AREAS.descripcion
  is 'Nombre del Area designado por BCP.';
comment on column IT.SB_AREAS.usu_insercion
  is 'Usuario que inserta.';
comment on column IT.SB_AREAS.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.SB_AREAS.usu_modificacion
  is 'Usuario que modifica.';
comment on column IT.SB_AREAS.fec_modificacion
  is 'Fecha de modificacion.';
alter table IT.SB_AREAS
  add constraint PK_SB_AREAS primary key (COD_ARE_BCP)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SB_AREAS
  add constraint AVCON_1077111591_COD_A_012
  check (COD_ARE_BCP BETWEEN 1 AND 9999);

