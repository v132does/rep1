create table IT.SB_FDG_DEPOSITOS
(
  fecha               DATE not null,
  nro_cuenta          VARCHAR2(20) not null,
  mod_sup_rubro       VARCHAR2(6) not null,
  certificado         VARCHAR2(15),
  ind_imp_judicial    NUMBER(1) not null,
  can_titulares       NUMBER(2) not null,
  cod_mon_bco_central VARCHAR2(4) not null,
  capital_ext         NUMBER(17) not null,
  int_devengado_ext   NUMBER(17) not null,
  total_ext           NUMBER(17) not null,
  capital             NUMBER(17) not null,
  int_devengado       NUMBER(17) not null,
  total               NUMBER(17) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_FDG_DEPOSITOS
  is 'Datos de los saldos de los depósitos a la fecha límite. Esos depósitos deben corresponder a las cuentas especificadas en la Resolución 10, Articulo 1.';
comment on column IT.SB_FDG_DEPOSITOS.fecha
  is 'Fecha de Proceso.';
comment on column IT.SB_FDG_DEPOSITOS.nro_cuenta
  is 'Código identificador de la operación asignada por la entidad.';
comment on column IT.SB_FDG_DEPOSITOS.mod_sup_rubro
  is 'El segundo módulo de la cuenta según la Resolución 10, Art. 1.';
comment on column IT.SB_FDG_DEPOSITOS.certificado
  is 'Si la operación es para CDA, concatenación de serie, guion "-" y número de CDA.';
comment on column IT.SB_FDG_DEPOSITOS.ind_imp_judicial
  is 'Si el depósito es por una importación o del Poder Judicial. Considera:
- Ley 2334, Art. 1, Inc. g)
- Resolucion 10, Art. 3
Valores:
1= Depósito por Importacion
2= Depósito del Poder Judicial
0= Otros.';
comment on column IT.SB_FDG_DEPOSITOS.can_titulares
  is 'Número de titulares del depósito.';
comment on column IT.SB_FDG_DEPOSITOS.cod_mon_bco_central
  is 'Código de moneda del depósito, el mismo usado en CRC.';
comment on column IT.SB_FDG_DEPOSITOS.capital_ext
  is 'Capital de moneda extranjera arbitrado en US$.';
comment on column IT.SB_FDG_DEPOSITOS.int_devengado_ext
  is 'Interés devengado de moneda extranjera arbitrado en US$.';
comment on column IT.SB_FDG_DEPOSITOS.total_ext
  is 'Suma de Capital-MonExtr e Interes-MonExtr.';
comment on column IT.SB_FDG_DEPOSITOS.capital
  is 'Capital de moneda nacional. Si hubiera Capital-MonExtr, en esta campo se convierte su equivalente a Guaranies.';
comment on column IT.SB_FDG_DEPOSITOS.int_devengado
  is 'Interés devengado de moneda nacional. Si hubiera Interes-MonExtr, en esta campo se convierte su equivalente a Guaranies.';
comment on column IT.SB_FDG_DEPOSITOS.total
  is 'Suma de Capital-MonNac e Interés-MonNac.';
comment on column IT.SB_FDG_DEPOSITOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.SB_FDG_DEPOSITOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.SB_FDG_DEPOSITOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.SB_FDG_DEPOSITOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.SB_FDG_DEPOSITOS
  add constraint PK_SB_FDG_DEPOSITOS primary key (FECHA, NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

