create global temporary table IT.SYB12_SYSCOLUMNS
(
  db_id       NUMBER(10),
  id          NUMBER(10),
  db_number   NUMBER(10),
  colid       NUMBER(10),
  status      NUMBER(10),
  db_type     NUMBER(10),
  length      NUMBER(10),
  offset      NUMBER(10),
  usertype    NUMBER(10),
  cdefault    NUMBER(10),
  domain      NUMBER(10),
  name        VARCHAR2(255),
  printfmt    VARCHAR2(255),
  prec        NUMBER(10),
  scale       NUMBER(10),
  remote_type NUMBER(10),
  remote_name VARCHAR2(255),
  xstatus     NUMBER(10),
  xtype       NUMBER(10),
  xdbid       NUMBER(10),
  acessrule   NUMBER(10),
  status2     NUMBER(10)
)
on commit preserve rows;

