create table IT.GE_SNP_MSJ_MT970_DET
(
  cod_mensaje              VARCHAR2(20),
  fec_extracto             DATE,
  tip_movimiento           VARCHAR2(1),
  monto                    NUMBER(18,2),
  nro_lote                 VARCHAR2(50),
  fec_lote                 DATE,
  nro_identificador        NUMBER(18),
  lin_extracto             VARCHAR2(4000),
  cod_swi_pte_solicitante  VARCHAR2(20),
  cod_swi_pte_beneficiario VARCHAR2(20),
  ind_movimiento           VARCHAR2(1) default 'N',
  usu_insercion            VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion            DATE default SYSDATE not null,
  usu_modificacion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion         DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SNP_MSJ_MT970_DET
  is 'Tabla de movimientos de detalle de extractos MT970';
comment on column IT.GE_SNP_MSJ_MT970_DET.cod_mensaje
  is 'Codigo de Mensaje (Para relacionar con la cabecera)';
comment on column IT.GE_SNP_MSJ_MT970_DET.fec_extracto
  is 'Fecha del Extracto 970';
comment on column IT.GE_SNP_MSJ_MT970_DET.tip_movimiento
  is 'Tipo de Movimiento / C-Credito , D-Debito';
comment on column IT.GE_SNP_MSJ_MT970_DET.monto
  is 'Monto del movimiento';
comment on column IT.GE_SNP_MSJ_MT970_DET.nro_lote
  is 'Nro. de Lote';
comment on column IT.GE_SNP_MSJ_MT970_DET.fec_lote
  is 'Fecha del Lote en el extracto';
comment on column IT.GE_SNP_MSJ_MT970_DET.nro_identificador
  is 'Nro. Identificador BCP';
comment on column IT.GE_SNP_MSJ_MT970_DET.lin_extracto
  is 'Datos adicionales del movimiento (Tipo :61:)';
comment on column IT.GE_SNP_MSJ_MT970_DET.cod_swi_pte_solicitante
  is 'Código SWIFT (BIC) del Participante Solicitante.';
comment on column IT.GE_SNP_MSJ_MT970_DET.cod_swi_pte_beneficiario
  is 'Código SWIFT (BIC) del Participante Beneficiario.';
comment on column IT.GE_SNP_MSJ_MT970_DET.ind_movimiento
  is 'Codigo de Moneda del movimiento';

