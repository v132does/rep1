create table IT.GE_GRU_ECONOMICOS_CRM
(
  cod_gru_economico   NUMBER(5) not null,
  descripcion         VARCHAR2(60),
  cat_subjetiva       VARCHAR2(1),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    TIMESTAMP(6) default current_timestamp not null,
  cat_automatica      NUMBER(3,2),
  tot_deu_real        NUMBER(18,2),
  tot_deu_contingente NUMBER(18,2),
  tot_prevision       NUMBER(18,2),
  tot_gar_computables NUMBER(18,2),
  tip_accion          VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_GRU_ECONOMICOS_CRM
  is 'Grupos Economicos.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.cod_gru_economico
  is 'Codigo de grupo economico.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.descripcion
  is 'Descripcion del Grupo Economico.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.cat_subjetiva
  is 'Tipo de categoria. ( ).';
comment on column IT.GE_GRU_ECONOMICOS_CRM.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.cat_automatica
  is 'Categoria Automatica del Grupo Economico.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.tot_deu_real
  is 'Total de la deuda real.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.tot_deu_contingente
  is 'Total de la deuda contingente.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.tot_prevision
  is 'Monto total de la Prevision.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.tot_gar_computables
  is 'Monto total de la garantias computables.';
comment on column IT.GE_GRU_ECONOMICOS_CRM.tip_accion
  is 'Indica el tipo de accion realizado con el registro en el Core.-';
alter table IT.GE_GRU_ECONOMICOS_CRM
  add constraint PK_GE_GRU_ECONOMICOS_CRM primary key (FEC_MODIFICACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

