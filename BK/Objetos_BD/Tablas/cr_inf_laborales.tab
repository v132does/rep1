create table IT.CR_INF_LABORALES
(
  cod_persona         VARCHAR2(10) not null,
  nro_secuencia       NUMBER(5) not null,
  lug_trabajo         VARCHAR2(70) not null,
  fec_ingreso         DATE,
  fec_salida          DATE,
  mto_ingreso         NUMBER(18,2) default 0 not null,
  cod_moneda          VARCHAR2(3) not null,
  des_puesto          VARCHAR2(80),
  tip_cargo           VARCHAR2(3),
  tip_ingreso         NUMBER(3) not null,
  actual              VARCHAR2(1) not null,
  tip_empleo          VARCHAR2(1),
  cod_ramo            NUMBER(3),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  observacion         VARCHAR2(1000),
  cod_direccion       NUMBER(3),
  cod_telefono        NUMBER(3),
  dir_correo          VARCHAR2(80),
  nom_per_contacto    VARCHAR2(120),
  mto_fijo            VARCHAR2(1) default 'N',
  tip_contrato        VARCHAR2(1),
  por_des_jubilatorio VARCHAR2(6),
  nomina              VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_INF_LABORALES
  is 'Informacion Laboral.';
comment on column IT.CR_INF_LABORALES.cod_persona
  is 'Código de Persona.';
comment on column IT.CR_INF_LABORALES.nro_secuencia
  is 'Secuencia.';
comment on column IT.CR_INF_LABORALES.lug_trabajo
  is 'Lugar de Trabajo.';
comment on column IT.CR_INF_LABORALES.fec_ingreso
  is 'Fecha de Ingreso.';
comment on column IT.CR_INF_LABORALES.fec_salida
  is 'Fecha de Salida.';
comment on column IT.CR_INF_LABORALES.mto_ingreso
  is 'Monto de Ingreso.';
comment on column IT.CR_INF_LABORALES.cod_moneda
  is 'Moneda.';
comment on column IT.CR_INF_LABORALES.des_puesto
  is 'Descripcion del Puesto.';
comment on column IT.CR_INF_LABORALES.tip_cargo
  is 'Código del Cargo (E-Empleado, J-Ejecutivo, M-Empresario, A-Accionista, I-Independiente).';
comment on column IT.CR_INF_LABORALES.tip_ingreso
  is 'Tipo de Ingreso.';
comment on column IT.CR_INF_LABORALES.actual
  is 'Indicador de si es actual o no (S/N).';
comment on column IT.CR_INF_LABORALES.tip_empleo
  is 'Tipo de Empleo (Dependiente T= Temporal o P = Permanente, I = Independiente, R = Rentista).';
comment on column IT.CR_INF_LABORALES.cod_ramo
  is 'Ramo de la Empresa donde trabaja.';
comment on column IT.CR_INF_LABORALES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CR_INF_LABORALES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CR_INF_LABORALES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CR_INF_LABORALES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.CR_INF_LABORALES.observacion
  is 'Observación.';
comment on column IT.CR_INF_LABORALES.cod_direccion
  is 'Código de la dirección laboral.';
comment on column IT.CR_INF_LABORALES.cod_telefono
  is 'Código del telefono de la persona en su trabajo.';
comment on column IT.CR_INF_LABORALES.dir_correo
  is 'Dirección de correo electrónico laboral.';
comment on column IT.CR_INF_LABORALES.nom_per_contacto
  is 'Nombre de la persona con quien se contacta para verificar la información.';
comment on column IT.CR_INF_LABORALES.mto_fijo
  is 'Indica si el Monto de Ingreso es Fijo o No (S/N).';
comment on column IT.CR_INF_LABORALES.tip_contrato
  is 'Indefinido o Temporal (I/T)';
comment on column IT.CR_INF_LABORALES.por_des_jubilatorio
  is 'Porcentaje de Descuento Jubilatorio.';
comment on column IT.CR_INF_LABORALES.nomina
  is 'Indica si el Ingreso Laboral es por Nómina de Empleados.';
create index IT.IN_BBVA_COD_P on IT.CR_INF_LABORALES (COD_PERSONA, COD_TELEFONO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BBVA_COD_PR_DI on IT.CR_INF_LABORALES (COD_PERSONA, COD_DIRECCION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_RILAB_COD_DIRECCION on IT.CR_INF_LABORALES (COD_DIRECCION, COD_MONEDA, COD_RAMO, COD_TELEFONO, TIP_INGRESO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_RILAB_COD_PERSONA on IT.CR_INF_LABORALES (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_INF_LABORALES
  add constraint PK_CR_INF_LABORALES primary key (COD_PERSONA, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_INF_LABORALES
  add constraint FK_RILAB_COD_DIRECCION foreign key (COD_PERSONA, COD_DIRECCION)
  references IT.BA_DIRECCIONES (COD_PERSONA, COD_DIRECCION);
alter table IT.CR_INF_LABORALES
  add constraint FK_RILAB_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CR_INF_LABORALES
  add constraint FK_RILAB_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CR_INF_LABORALES
  add constraint FK_RILAB_COD_RAMO foreign key (COD_RAMO)
  references IT.BA_RAMOS (COD_RAMO);
alter table IT.CR_INF_LABORALES
  add constraint FK_RILAB_COD_TELEFONO foreign key (COD_PERSONA, COD_TELEFONO)
  references IT.BA_TELEFONOS (COD_PERSONA, COD_TELEFONO);
alter table IT.CR_INF_LABORALES
  add constraint FK_RILAB_TIP_INGRESO foreign key (TIP_INGRESO)
  references IT.CR_CON_ING_EGR (COD_CONCEPTO);
alter table IT.CR_INF_LABORALES
  add constraint AVCON_1083270925_COD_D_002
  check (COD_DIRECCION BETWEEN 0 AND 999);
alter table IT.CR_INF_LABORALES
  add constraint AVCON_1083270925_COD_R_001
  check (COD_RAMO BETWEEN 0 AND 999);
alter table IT.CR_INF_LABORALES
  add constraint AVCON_1083270925_COD_T_004
  check (COD_TELEFONO BETWEEN 0 AND 999);
alter table IT.CR_INF_LABORALES
  add constraint AVCON_1085611893_TIP_I_000
  check (TIP_INGRESO BETWEEN 0 AND 999);
alter table IT.CR_INF_LABORALES
  add constraint CK_FEC_SAL_ACTUAL
  check ((fec_salida is not null and actual = 'N') or fec_salida is null);

