create table IT.GE_DNA_RUCS
(
  id     NUMBER(10) not null,
  estado VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_DNA_RUCS.id
  is 'Identificador.';
comment on column IT.GE_DNA_RUCS.estado
  is 'Estado.';
alter table IT.GE_DNA_RUCS
  add constraint PK_GE_DNA_RUCS primary key (ID)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

