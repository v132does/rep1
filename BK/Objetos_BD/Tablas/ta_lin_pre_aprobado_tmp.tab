-- Create table
create table IT.TA_LIN_PRE_APROBADO_TMP
(
  cod_pla_pre_aprobado VARCHAR2(20),
  fec_ini_oferta       DATE,
  fec_fin_oferta       DATE,
  cod_oficina          NUMBER(3),
  mon_pre_aprobado     NUMBER(18,2),
  cod_modalidad        NUMBER(3),
  cod_rub_economico    VARCHAR2(6),
  cod_moneda           VARCHAR2(3),
  mto_estado           VARCHAR2(100),
  cod_tip_documento    NUMBER(3),
  nro_documento        VARCHAR2(20)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.TA_LIN_PRE_APROBADO_TMP
  is 'CartaOferta pre aprobados.';
-- Add comments to the columns 
comment on column IT.TA_LIN_PRE_APROBADO_TMP.cod_pla_pre_aprobado
  is 'Codigo asignado por BI a las Planillas.';
comment on column IT.TA_LIN_PRE_APROBADO_TMP.fec_ini_oferta
  is 'Inicio de Vigencia del pre aprobado.';
comment on column IT.TA_LIN_PRE_APROBADO_TMP.fec_fin_oferta
  is 'Fin de Vigencia del pre aprobado.';
comment on column IT.TA_LIN_PRE_APROBADO_TMP.cod_oficina
  is 'Codigo de Oficina / Sucursal.';
comment on column IT.TA_LIN_PRE_APROBADO_TMP.mon_pre_aprobado
  is 'Monto del pre aprobado';
comment on column IT.TA_LIN_PRE_APROBADO_TMP.cod_modalidad
  is 'Codigo de modalidad';
comment on column IT.TA_LIN_PRE_APROBADO_TMP.cod_rub_economico
  is 'Codigo de rubro economico';
comment on column IT.TA_LIN_PRE_APROBADO_TMP.cod_moneda
  is 'Codigo de moneda';
comment on column IT.TA_LIN_PRE_APROBADO_TMP.mto_estado
  is 'Descripcion Estado pre aprobado';
comment on column IT.TA_LIN_PRE_APROBADO_TMP.cod_tip_documento
  is 'Codigo del tipo de documento';
comment on column IT.TA_LIN_PRE_APROBADO_TMP.nro_documento
  is 'Numero de documento de la persona';
-- Create/Recreate check constraints 
alter table IT.TA_LIN_PRE_APROBADO_TMP
  add constraint CK_RANGO_OFER_FEC_FIN
  check (FEC_FIN_OFERTA > FEC_INI_OFERTA);
