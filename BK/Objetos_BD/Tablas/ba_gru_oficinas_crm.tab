create table IT.BA_GRU_OFICINAS_CRM
(
  cod_gru_oficina   NUMBER(3) not null,
  descripcion       VARCHAR2(35),
  cod_usu_encargado VARCHAR2(10),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  TIMESTAMP(6) default current_timestamp not null,
  tip_accion        VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_GRU_OFICINAS_CRM
  is 'Grupos de oficinas.';
comment on column IT.BA_GRU_OFICINAS_CRM.cod_gru_oficina
  is 'Codigo del grupo.';
comment on column IT.BA_GRU_OFICINAS_CRM.descripcion
  is 'Descripcion del Grupo.';
comment on column IT.BA_GRU_OFICINAS_CRM.cod_usu_encargado
  is 'Usuario encargado.';
comment on column IT.BA_GRU_OFICINAS_CRM.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_GRU_OFICINAS_CRM.fec_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_GRU_OFICINAS_CRM.usu_modificacion
  is 'Usuario que realizo la ultima modificacion.';
comment on column IT.BA_GRU_OFICINAS_CRM.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion.';
comment on column IT.BA_GRU_OFICINAS_CRM.tip_accion
  is 'Indica el tipo de accion realizado con el registro en el Core.-';
alter table IT.BA_GRU_OFICINAS_CRM
  add constraint PK_BA_GRU_OFICINAS_CRM primary key (FEC_MODIFICACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

