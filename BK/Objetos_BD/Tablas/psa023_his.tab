create table IT.PSA023_HIS
(
  psa023_hisid NUMBER(18),
  psa023_hismu NUMBER(9) not null,
  psa023_hista NUMBER(9) not null,
  psa023_hisrl NUMBER(9) not null,
  psa023_hisor NUMBER(3) not null,
  psa023_hisos NUMBER(3) not null,
  psa023_hispa NUMBER(9),
  psa023_histd NUMBER(9),
  psa023_hisdo VARCHAR2(25),
  psa023_histp VARCHAR2(1),
  psa023_hisnc NUMBER(9),
  psa023_hisso NUMBER(5),
  psa023_hisct NUMBER(9),
  psa023_hisrf VARCHAR2(40),
  psa023_hisdh NUMBER(1),
  psa023_hisop NUMBER(9),
  psa023_histt NUMBER(9),
  psa023_hisau VARCHAR2(6),
  psa023_hismd NUMBER(9),
  psa023_hisdl NUMBER(18,2),
  psa023_hisml NUMBER(18,2),
  psa023_hismo NUMBER(18,2),
  psa023_hiscd NUMBER(18,2),
  psa023_hiscl NUMBER(18,2),
  psa023_hiscr NUMBER(9),
  psa023_hisrv VARCHAR2(4),
  psa023_hisft VARCHAR2(8) not null,
  psa023_hisht VARCHAR2(8),
  psa023_hisfi TIMESTAMP(6),
  psa023_hisca NUMBER(9),
  psa023_hismp NUMBER(9),
  psa023_hisci VARCHAR2(25),
  psa023_hissu NUMBER(9) not null,
  psa023_hispd NUMBER(9),
  psa023_hisdt NUMBER(9),
  psa023_hisdd VARCHAR2(25),
  psa023_histr NUMBER(9),
  psa023_hisco VARCHAR2(25),
  psa023_hiscb VARCHAR2(25),
  psa023_hisdr VARCHAR2(25),
  psa023_hisdb VARCHAR2(25),
  psa023_hiseo VARCHAR2(65),
  psa023_hiseb VARCHAR2(65),
  psa023_hisbi VARCHAR2(6),
  psa023_hisaf VARCHAR2(15),
  psa023_hisda VARCHAR2(40),
  psa023_hismc VARCHAR2(50),
  psa023_hisfu VARCHAR2(30),
  psa023_hisfc VARCHAR2(30),
  psa023_hispr NUMBER(18),
  psa023_hisst NUMBER(18,2),
  psa023_hisit VARCHAR2(30)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
