create table IT.GE_COB_SER_PRIVADOS_TMP
(
  cod_usuario      VARCHAR2(10),
  cod_servicio     NUMBER(5),
  fec_proceso      DATE,
  cod_modalidad    NUMBER(3),
  nro_cuenta       VARCHAR2(15),
  cod_moneda       VARCHAR2(3),
  fec_envio        DATE,
  tipo             VARCHAR2(1) default 'C',
  monto            NUMBER(18,2) default 0,
  estado           VARCHAR2(1),
  cod_proceso      NUMBER(3),
  cod_modulo       NUMBER(3),
  nombre           VARCHAR2(40),
  fec_insercion    DATE default SYSDATE not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  error            VARCHAR2(100)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_COB_SER_PRIVADOS_TMP
  is 'Archivo temporal de pago de sueldos.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.cod_servicio
  is 'codigo del servicio.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.fec_proceso
  is 'Fecha de proceso.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.nro_cuenta
  is 'Nro. de cuenta.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.fec_envio
  is 'Fecha de envio.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.tipo
  is 'Tipo.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.monto
  is 'Monto.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.estado
  is 'Estado actual.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.cod_proceso
  is 'Codigo de proceso.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.nombre
  is 'Nombre del Beneficiario.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.usu_insercion
  is 'Usuario de insercion.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.fec_modificacion
  is 'Fecha de modificacion.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.usu_modificacion
  is 'Usuario de modificacion.';
comment on column IT.GE_COB_SER_PRIVADOS_TMP.error
  is 'Descripcion del Error.';
create index IT.IN_GSEPR_COD_SERVICIO on IT.GE_COB_SER_PRIVADOS_TMP (COD_SERVICIO, COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

