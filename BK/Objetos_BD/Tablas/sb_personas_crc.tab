create table IT.SB_PERSONAS_CRC
(
  nom_archivo      VARCHAR2(10) not null,
  fecha            DATE not null,
  cod_entidad      VARCHAR2(4) not null,
  tip_entidad      VARCHAR2(2) not null,
  cla_entidad      VARCHAR2(2) not null,
  top_riesgo       NUMBER(15) not null,
  nro_reg_a        NUMBER(1) not null,
  tot_reg_detalle  NUMBER(6) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_PERSONAS_CRC
  is 'Datos de personas.';
comment on column IT.SB_PERSONAS_CRC.nom_archivo
  is 'Nomrbre del archivo.';
comment on column IT.SB_PERSONAS_CRC.fecha
  is 'Fecha.';
comment on column IT.SB_PERSONAS_CRC.cod_entidad
  is 'Codigo de entidad.';
comment on column IT.SB_PERSONAS_CRC.tip_entidad
  is 'tipo de entidad.';
comment on column IT.SB_PERSONAS_CRC.cla_entidad
  is 'Clase de entidad.';
comment on column IT.SB_PERSONAS_CRC.top_riesgo
  is 'Tope de riesgo.';
comment on column IT.SB_PERSONAS_CRC.nro_reg_a
  is 'Nro. de registros.';
comment on column IT.SB_PERSONAS_CRC.tot_reg_detalle
  is 'Total de registros.';
comment on column IT.SB_PERSONAS_CRC.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.SB_PERSONAS_CRC.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.SB_PERSONAS_CRC.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.SB_PERSONAS_CRC.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.SB_PERSONAS_CRC
  add constraint SPERC_PK primary key (FECHA, NOM_ARCHIVO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

