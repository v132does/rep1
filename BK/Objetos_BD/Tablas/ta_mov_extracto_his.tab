create table IT.TA_MOV_EXTRACTO_HIS
(
  fec_proceso            DATE default sysdate,
  cod_banco              VARCHAR2(2),
  cod_cla_tarjeta        VARCHAR2(2),
  afinidad               VARCHAR2(2),
  nro_cuenta             VARCHAR2(15),
  nom_usuario            VARCHAR2(30),
  direccion              VARCHAR2(35),
  localidad              VARCHAR2(15),
  nro_telefono           VARCHAR2(12),
  lin_credito            NUMBER(18,2),
  sal_financiado         NUMBER(18,2),
  sal_ult_resumen        NUMBER(18,2),
  cod_oficina            NUMBER(3),
  nro_cta_bancaria       VARCHAR2(15),
  cantidad               NUMBER(3),
  nro_tarjeta            VARCHAR2(16),
  vto_tarjeta            VARCHAR2(4),
  des_banco              VARCHAR2(30),
  des_afinidad           VARCHAR2(20),
  fec_cierre             DATE,
  fec_vencimiento        DATE,
  lim_compra             NUMBER(18,2),
  mto_int_corriente      NUMBER(18,2),
  mto_int_moratorio      NUMBER(18,2),
  mto_impuesto           NUMBER(18,2),
  mto_gasto              NUMBER(18,2),
  mto_deuda              NUMBER(18,2),
  mto_com_no_financiable NUMBER(18,2),
  por_com_financiable    NUMBER(18,2),
  mto_pag_minimo         NUMBER(18,2),
  por_pag_minimo         NUMBER(18,2),
  mto_iva                NUMBER(18,2),
  des_exceso             VARCHAR2(8),
  des_mora               VARCHAR2(8),
  des_retencion          VARCHAR2(13),
  nro_control            NUMBER(6),
  nro_hoja               NUMBER(2),
  longitud               NUMBER(2),
  tip_cierre             VARCHAR2(1),
  lin_cuotas             NUMBER(18,2),
  sal_cuo_pendiente      NUMBER(18,2),
  tip_int_cuotas         VARCHAR2(1),
  mto_cuo_interes        NUMBER(18,2),
  mto_cuo_reversion      NUMBER(18,2),
  mto_cuo_impuesto       NUMBER(18,2),
  tas_int_corriente      NUMBER(4,2),
  tas_int_cuota          NUMBER(4,2),
  tas_int_moratorio      NUMBER(4,2),
  tas_int_compra         NUMBER(4,2),
  mto_int_compra         NUMBER(18,2),
  tas_efectiva           NUMBER(4,2),
  nro_factura            VARCHAR2(20),
  timbrado               VARCHAR2(20)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_MOV_EXTRACTO_HIS
  is 'Tabla Historica de movimiento de extracto proveniente de Bancard de tarjetas de crédito. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.fec_proceso
  is 'Fecha de Proceso del archivo. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.cod_banco
  is 'Código de Identificatorio de Entidad en Bancard. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.cod_cla_tarjeta
  is 'Código de Clase de Tarjeta. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.afinidad
  is 'Afinidad de la Tarjeta. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.nro_cuenta
  is 'Nro. de Cuenta de la Tarjeta. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.nom_usuario
  is 'Nombre del Cliente. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.direccion
  is 'Dirección del Cliente. ';
