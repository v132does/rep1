  is 'Fecha de Vencimiento del extracto. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.lim_compra
  is 'Límite Compra. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.mto_int_corriente
  is 'Mto. interés corriente. ';
