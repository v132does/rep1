  is 'Tipo de Interés en Cuotas. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.mto_cuo_interes
  is 'Mto. de Interés en Cuotas. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.mto_cuo_reversion
  is 'Mto. de Reversión en Cuotas. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.mto_cuo_impuesto
  is 'Mto. de Impuesto en Cuotas.';
comment on column IT.TA_MOV_EXTRACTO_HIS.tas_int_corriente
  is 'Valor de tasa de interés corriente. ';
comment on column IT.TA_MOV_EXTRACTO_HIS.tas_int_cuota
  is 'Valor de tasa de interés en cuotas.';
comment on column IT.TA_MOV_EXTRACTO_HIS.tas_int_moratorio
  is 'Valor de tasa de interés moratorio.';
comment on column IT.TA_MOV_EXTRACTO_HIS.tas_int_compra
  is 'Valor de tasa de interés en compra.';
comment on column IT.TA_MOV_EXTRACTO_HIS.mto_int_compra
  is 'Mto. de Interés en compras.';
comment on column IT.TA_MOV_EXTRACTO_HIS.tas_efectiva
  is 'Valor de tasa efectiva.';
comment on column IT.TA_MOV_EXTRACTO_HIS.nro_factura
