create table IT.GE_SEG_PAR_CUENTAS
(
  cod_seg_cliente    NUMBER(3) not null,
  cod_modulo         NUMBER(3) not null,
  cod_modalidad      NUMBER(3) not null,
  cod_moneda         VARCHAR2(3) not null,
  cod_ente           NUMBER(5),
  min_pactado        NUMBER(18,2) default 0,
  tip_capitalizacion NUMBER(2),
  tip_extracto       VARCHAR2(1) default 'M',
  cod_tasa           NUMBER(3),
  plazo              NUMBER(5),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  gen_tar_debito     VARCHAR2(1),
  cod_sub_modalidad  NUMBER(3) default 1 not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SEG_PAR_CUENTAS
  is 'Apertura de cuentas por segmento de clientes.';
comment on column IT.GE_SEG_PAR_CUENTAS.cod_seg_cliente
  is 'Segmento del cliente.';
comment on column IT.GE_SEG_PAR_CUENTAS.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.GE_SEG_PAR_CUENTAS.cod_modalidad
  is 'Codigo de la modalidad.';
comment on column IT.GE_SEG_PAR_CUENTAS.cod_moneda
  is 'Moneda.';
comment on column IT.GE_SEG_PAR_CUENTAS.cod_ente
  is 'Codigo de ente.';
comment on column IT.GE_SEG_PAR_CUENTAS.min_pactado
  is 'Minimo pactado.';
comment on column IT.GE_SEG_PAR_CUENTAS.tip_capitalizacion
  is 'Capitalizacion.';
comment on column IT.GE_SEG_PAR_CUENTAS.tip_extracto
  is 'Tipo de impresion.';
comment on column IT.GE_SEG_PAR_CUENTAS.cod_tasa
  is 'Valor de la tasa.';
comment on column IT.GE_SEG_PAR_CUENTAS.plazo
  is 'Dias.';
comment on column IT.GE_SEG_PAR_CUENTAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_SEG_PAR_CUENTAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_SEG_PAR_CUENTAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_SEG_PAR_CUENTAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_SEG_PAR_CUENTAS.gen_tar_debito
  is 'Genera S/N Tarjeta de debito en forma automatica.';
comment on column IT.GE_SEG_PAR_CUENTAS.cod_sub_modalidad
  is 'Código de Sub Modalidad';
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint PK_GE_SEG_PAR_CUENTAS primary key (COD_SEG_CLIENTE, COD_MODULO, COD_MODALIDAD, COD_MONEDA, COD_SUB_MODALIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint FK_GSPCU_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint FK_GSPCU_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint FK_GSPCU_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint FK_GSPCU_COD_SEG_CLIENTE foreign key (COD_SEG_CLIENTE)
  references IT.GE_SEG_CLIENTES (COD_SEG_CLIENTE);
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint FK_GSPCU_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint AVCON_1097167816_COD_M_012
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint AVCON_1097167816_COD_M_013
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint AVCON_1097167816_COD_S_005
  check (COD_SEG_CLIENTE BETWEEN 0 AND 999);
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint AVCON_1097167816_COD_T_001
  check (COD_TASA BETWEEN 0 AND 999);
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint AVCON_1097167816_TIP_C_000
  check (TIP_CAPITALIZACION IN (1, 2, 3, 4, 6, 12, 99));
alter table IT.GE_SEG_PAR_CUENTAS
  add constraint AVCON_1097167816_TIP_E_000
  check (TIP_EXTRACTO IN ('M', 'S', 'D', 'm', 's', 'd'));

