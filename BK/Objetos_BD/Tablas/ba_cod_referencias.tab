create table IT.BA_COD_REFERENCIAS
(
  dominio          VARCHAR2(240) not null,
  significado      VARCHAR2(240),
  fec_insercion    DATE default SYSDATE not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  val_minimo       VARCHAR2(240) not null,
  val_maximo       VARCHAR2(240),
  abreviatura      VARCHAR2(240),
  activo           VARCHAR2(1) default 'S'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_COD_REFERENCIAS
  is 'Descripcion de Codigos Diversos.';
comment on column IT.BA_COD_REFERENCIAS.dominio
  is 'Nombre del Dominio.';
comment on column IT.BA_COD_REFERENCIAS.significado
  is 'Significado.';
comment on column IT.BA_COD_REFERENCIAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_COD_REFERENCIAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_COD_REFERENCIAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_COD_REFERENCIAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.BA_COD_REFERENCIAS.val_minimo
  is 'Valor minimo.';
comment on column IT.BA_COD_REFERENCIAS.val_maximo
  is 'Valor maximo.';
comment on column IT.BA_COD_REFERENCIAS.abreviatura
  is 'Abreviacion.';
comment on column IT.BA_COD_REFERENCIAS.activo
  is 'Indica si el registro se encuentra Activo o Inactivo.';
alter table IT.BA_COD_REFERENCIAS
  add constraint PK_BA_COD_REFERENCIAS primary key (DOMINIO, VAL_MINIMO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BCR_ABREVIATURA on IT.BA_COD_REFERENCIAS("ABREVIATURA") ONLINE
  tablespace IT_IND
  NOLOGGING
  COMPUTE STATISTICS
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );