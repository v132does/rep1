create table IT.GE_PAG_PRO_FACTURAS
(
  nro_orden        NUMBER(12) not null,
  nro_factura      VARCHAR2(20) not null,
  cod_ente         NUMBER(5) not null,
  fec_carga        DATE,
  mto_total        NUMBER(18,2) default 0,
  concepto         VARCHAR2(35),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAG_PRO_FACTURAS
  is 'Detalle de Facturas a Pagar a Proveedores.';
comment on column IT.GE_PAG_PRO_FACTURAS.nro_orden
  is 'Nro.Orden.';
comment on column IT.GE_PAG_PRO_FACTURAS.nro_factura
  is 'Nro.Factura.';
comment on column IT.GE_PAG_PRO_FACTURAS.cod_ente
  is 'Empresa.';
comment on column IT.GE_PAG_PRO_FACTURAS.fec_carga
  is 'Fecha Carga.';
comment on column IT.GE_PAG_PRO_FACTURAS.mto_total
  is 'Monto Total.';
comment on column IT.GE_PAG_PRO_FACTURAS.concepto
  is 'Concepto.';
comment on column IT.GE_PAG_PRO_FACTURAS.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.GE_PAG_PRO_FACTURAS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_PAG_PRO_FACTURAS.usu_modificacion
  is 'Usuario que modificó por última vez el registro.';
comment on column IT.GE_PAG_PRO_FACTURAS.fec_modificacion
  is 'Fecha en que se modificó por última vez el registro.';
create index IT.IN_GEPPF_NRO_FACTURA on IT.GE_PAG_PRO_FACTURAS (NRO_FACTURA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAG_PRO_FACTURAS
  add constraint PK_GE_PAG_PRO_FACTURAS primary key (NRO_ORDEN, NRO_FACTURA, COD_ENTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAG_PRO_FACTURAS
  add constraint FK_GPPFA_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.GE_PAG_PRO_FACTURAS
  add constraint AVCON_1118263418_NRO_O_000
  check (NRO_ORDEN BETWEEN 0 AND 999999999999);

