create table IT.SB_CRC_ACT_VINCULOS_DET
(
  fecha            DATE not null,
  nom_referencia   VARCHAR2(10) not null,
  nro_formulario   VARCHAR2(3),
  cod_oficina      NUMBER(3),
  tip_operacion    NUMBER(3),
  nro_operacion    VARCHAR2(60),
  cod_mon_iso      VARCHAR2(3),
  tip_documento    VARCHAR2(3),
  nro_documento    VARCHAR2(30),
  evento           VARCHAR2(1),
  nro_registro     NUMBER(9) not null,
  cod_persona      VARCHAR2(10),
  cod_modulo       NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default sysdate not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default sysdate not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_CRC_ACT_VINCULOS_DET
  is 'Datos de Actualización de Vínculos /Relaciones utilizados para la Generación del Archivo de Actualización de Relaciones para envío a CRC.';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.fecha
  is 'Fecha de Periodo de envío del Archivo (Formato: AAAAMMDD)';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.nom_referencia
  is 'Nombre del Archivo a generarse a la CRC (Archivo VINCULOSD).';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.nro_formulario
  is 'Nro. de Formulario correspondiente al Archivo de Actualización de Relaciones. Este nro. es fijo para identificar dicho Archivo.';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.cod_oficina
  is 'Código de Oficina del Cliente (Vínculo: Deudor, Codeudor, Garante).';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.tip_operacion
  is 'Tipo de Operación perteneciente a la Cuenta (posición 6 al 8 del Rubro Contable de Tipo Capital).';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.nro_operacion
  is 'Nro. de Cuenta de la Operación.';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.cod_mon_iso
  is 'Código de Moneda de la Operación.';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.tip_documento
  is 'Tipo de Documento de la Persona (CI=Cedula de Identidad / CRC=Código de Persona no residente / CRP=Carné de Residencia Permanente / RUC=Regsitro Unico Contribuyente).';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.nro_documento
  is 'Nro. de Documento de la Persona Vinculada.';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.evento
  is 'Desvincular a la Operación (S= Desvincula a la operación/ N= Vincula a la operación.).';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.nro_registro
  is 'Nro. de Registro único.';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.cod_persona
  is 'Código de Persona vinculada a la Cuenta Informada(Deudor / Codeudor / Garante / Firmante,  etc.).';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.cod_modulo
  is 'Código del Módulo de la Cuenta.';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.SB_CRC_ACT_VINCULOS_DET.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_SCAVD_COD_PERSONA on IT.SB_CRC_ACT_VINCULOS_DET (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SB_CRC_ACT_VINCULOS_DET
  add constraint PK_SB_CRC_ACT_VINCULOS_DET primary key (FECHA, NOM_REFERENCIA, NRO_REGISTRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

