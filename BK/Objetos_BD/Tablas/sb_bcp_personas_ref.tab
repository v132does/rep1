create table IT.SB_BCP_PERSONAS_REF (
    RF_APELLIDO   VARCHAR2(30),
    RF_NOMBRE     VARCHAR2(30),
    RF_FECHA_NAC  DATE,
    RF_FECHA_BAJA DATE,
    RF_TIPO_IDENT VARCHAR2(15),
    RF_NUMERO     VARCHAR2(15),
    RF_PAIS_SWIFT VARCHAR2(2),
    RF_TIPO_PER   VARCHAR2(3)
) TABLESPACE IT_DATA;

CREATE INDEX IT.IN_SBPR_NRO_DOCUMENTO
  ON IT.SB_BCP_PERSONAS_REF (RF_TIPO_IDENT, RF_NUMERO)
  TABLESPACE IT_IND;

CREATE INDEX IT.IN_SBPR_TIPO_NORM
  ON IT.SB_BCP_PERSONAS_REF (RF_TIPO_IDENT, REPLACE(RF_NUMERO, '-', ''))
  TABLESPACE IT_IND;

CREATE PUBLIC SYNONYM SB_BCP_PERSONAS_REF FOR IT.SB_BCP_PERSONAS_REF;
GRANT SELECT ON IT.SB_BCP_PERSONAS_REF TO IT_CONSULTAS;
GRANT SELECT ON IT.SB_BCP_PERSONAS_REF TO IT_TEMPORAL;
