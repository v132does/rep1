create table IT.SB_CF_ALT_PERSONAS (
  NRO_LINEA         NUMBER        NOT NULL,
  TIPO_IDENT        VARCHAR2(10),
  NRO_DOCUMENTO     VARCHAR2(20),
  TIPO_PER          VARCHAR2(3),
  APELLIDO          VARCHAR2(120),
  NOMBRE            VARCHAR2(120),
  FECHA_NAC         DATE,
  GENERO            VARCHAR2(1),
  PAIS_NACIMIENTO   VARCHAR2(2),
  CIUDAD_NACIMIENTO NUMBER,
  FECHA_VENC_DOC    DATE,
  COD_PERSONA       NUMBER,
  RELACION          VARCHAR2(10),
  NATURALEZA        NUMBER,
  LINEA_CSV         VARCHAR2(300),
  ID_EJECUCION      NUMBER        NOT NULL,
  FEC_GENERADO      TIMESTAMP     DEFAULT SYSTIMESTAMP,
  USU_INSERCION     VARCHAR2(30),
  FEC_INSERCION     DATE          DEFAULT SYSDATE NOT NULL,
  USU_MODIFICACION  VARCHAR2(30),
  FEC_MODIFICACION  DATE,
  CONSTRAINT PK_SB_CF_ALT_PERSONAS  PRIMARY KEY (NRO_LINEA, ID_EJECUCION),
  CONSTRAINT FK_SCFAP_ID_EJECUCION  FOREIGN KEY (ID_EJECUCION)
    REFERENCES IT.SB_CF_PRO_LOG (ID_EJECUCION)
) TABLESPACE IT_DATA;

CREATE INDEX IT.IN_SCFAP_ID_EJECUCION
  ON IT.SB_CF_ALT_PERSONAS (ID_EJECUCION)
  TABLESPACE IT_IND;

CREATE INDEX IT.IN_SCFAP_NRO_DOCUMENTO
  ON IT.SB_CF_ALT_PERSONAS (TIPO_IDENT, NRO_DOCUMENTO)
  TABLESPACE IT_IND;

COMMENT ON TABLE IT.SB_CF_ALT_PERSONAS IS 'Resultado materializado CF Alta Personas - Circ. SB.SG 00586/2010 Form.14';
COMMENT ON COLUMN IT.SB_CF_ALT_PERSONAS.NRO_LINEA    IS 'Numero de linea correlativo en el archivo CSV';
COMMENT ON COLUMN IT.SB_CF_ALT_PERSONAS.TIPO_IDENT   IS 'Tipo de documento Bankiti (CI, CRC, CRP, RUC)';
COMMENT ON COLUMN IT.SB_CF_ALT_PERSONAS.LINEA_CSV    IS 'Linea completa formateada para exportar al archivo CF-1046';
COMMENT ON COLUMN IT.SB_CF_ALT_PERSONAS.NATURALEZA   IS 'Forma juridica Bankiti (BA_PER_JURIDICAS.NATURALEZA): 21=Empresario individual, 23=EAS, 24=EAS Unipersonal. NULL para personas fisicas';
COMMENT ON COLUMN IT.SB_CF_ALT_PERSONAS.ID_EJECUCION IS 'FK a SB_CF_PRO_LOG: identifica la ejecucion que genero este registro';

CREATE PUBLIC SYNONYM SB_CF_ALT_PERSONAS FOR IT.SB_CF_ALT_PERSONAS;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_CF_ALT_PERSONAS TO IT_CONSULTAS;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_CF_ALT_PERSONAS TO IT_TEMPORAL;
