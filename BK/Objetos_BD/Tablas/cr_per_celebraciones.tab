create table IT.CR_PER_CELEBRACIONES
(
  cod_persona      VARCHAR2(10) not null,
  cod_celebracion  NUMBER(3) not null,
  fec_importante   DATE not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  observacion      VARCHAR2(1000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_PER_CELEBRACIONES
  is 'Fechas importantes para la persona.';
comment on column IT.CR_PER_CELEBRACIONES.cod_persona
  is 'Codigo de la persona.';
comment on column IT.CR_PER_CELEBRACIONES.cod_celebracion
  is 'Tipo de celebracion.';
comment on column IT.CR_PER_CELEBRACIONES.fec_importante
  is 'Fecha importante.';
comment on column IT.CR_PER_CELEBRACIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_PER_CELEBRACIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_PER_CELEBRACIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_PER_CELEBRACIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CR_PER_CELEBRACIONES.observacion
  is 'Observacion.';
alter table IT.CR_PER_CELEBRACIONES
  add constraint PK_CR_PER_CELEBRACIONES primary key (COD_PERSONA, COD_CELEBRACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_PER_CELEBRACIONES
  add constraint FK_RPCEL_COD_CELEBRACION foreign key (COD_CELEBRACION)
  references IT.CR_CELEBRACIONES (COD_CELEBRACION);
alter table IT.CR_PER_CELEBRACIONES
  add constraint FK_RPCEL_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CR_PER_CELEBRACIONES
  add constraint AVCON_1080843837_COD_C_008
  check (COD_CELEBRACION BETWEEN 1 AND 999);

