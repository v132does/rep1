create table IT.CO_INF_PERSONAS_HIS
(
  fec_historico     DATE not null,
  cod_persona       VARCHAR2(10) not null,
  cod_modulo        NUMBER(3) not null,
  cod_moneda        VARCHAR2(3) not null,
  relacion          VARCHAR2(1) not null,
  cod_afiliado      NUMBER(6) not null,
  fec_informacion   DATE not null,
  nro_documento     VARCHAR2(30) not null,
  pri_nombre        VARCHAR2(120),
  seg_nombre        VARCHAR2(30),
  pri_apellido      VARCHAR2(30),
  seg_apellido      VARCHAR2(30),
  ape_casada        VARCHAR2(25),
  fec_operacion     DATE,
  ide_operacion     VARCHAR2(25) not null,
  cod_inf_operacion NUMBER(2) not null,
  mto_operacion     NUMBER(20,2),
  cod_inf_moneda    VARCHAR2(1) not null,
  pla_operacion     NUMBER(4),
  fec_ven_pendiente DATE,
  fec_ult_pago      DATE,
  saldo             NUMBER(18,2),
  usu_insercion     VARCHAR2(10) default substr( USER, 1, 10 ) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default substr( USER, 1, 10 ) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_modalidad     NUMBER(3)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

