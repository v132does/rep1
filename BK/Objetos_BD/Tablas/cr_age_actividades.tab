create table IT.CR_AGE_ACTIVIDADES
(
  cod_actividad    NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_AGE_ACTIVIDADES
  is 'Tipos de Actividad.';
comment on column IT.CR_AGE_ACTIVIDADES.cod_actividad
  is 'Codigo de actividad.';
comment on column IT.CR_AGE_ACTIVIDADES.descripcion
  is 'Descripcion de la actividad.';
comment on column IT.CR_AGE_ACTIVIDADES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_AGE_ACTIVIDADES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_AGE_ACTIVIDADES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_AGE_ACTIVIDADES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CR_AGE_ACTIVIDADES
  add constraint PK_CR_AGE_ACTIVIDADES primary key (COD_ACTIVIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_AGE_ACTIVIDADES
  add constraint AVCON_1080843837_COD_A_001
  check (COD_ACTIVIDAD BETWEEN 1 AND 999);

