create table IT.TM_OSC_INHI_PENDIENTES
(
  nro_secuencia     VARCHAR2(6) not null,
  nro_circular      VARCHAR2(8) not null,
  ano_circular      VARCHAR2(4),
  codigo_banco      VARCHAR2(4),
  tipo_document     VARCHAR2(4) not null,
  nro_documento     VARCHAR2(25),
  nombre1           VARCHAR2(70),
  nombre2           VARCHAR2(25),
  nombre3           VARCHAR2(25),
  apellido1         VARCHAR2(25),
  apellido2         VARCHAR2(25),
  apellido_casa     VARCHAR2(25),
  causal            VARCHAR2(5),
  multa             VARCHAR2(17),
  inhab_por         VARCHAR2(3),
  fecha_circula     VARCHAR2(8),
  moneda            VARCHAR2(4),
  msj_error         VARCHAR2(200),
  cod_tip_documento NUMBER(3),
  estado            VARCHAR2(1) default 'P',
  fec_cam_estado    DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TM_OSC_INHI_PENDIENTES
  is 'Tabla temporal de Inhibiciones OSC.';
comment on column IT.TM_OSC_INHI_PENDIENTES.nro_secuencia
  is 'Numero de Secuencia.';
comment on column IT.TM_OSC_INHI_PENDIENTES.nro_circular
  is 'Numero de Circular.';
comment on column IT.TM_OSC_INHI_PENDIENTES.ano_circular
  is 'Año de Circular.';
comment on column IT.TM_OSC_INHI_PENDIENTES.codigo_banco
  is 'Codigo de Banco.';
comment on column IT.TM_OSC_INHI_PENDIENTES.tipo_document
  is 'Tipo de Documento.';
comment on column IT.TM_OSC_INHI_PENDIENTES.nro_documento
  is 'Numero de Documento.';
comment on column IT.TM_OSC_INHI_PENDIENTES.nombre1
  is 'Primer Nombre.';
comment on column IT.TM_OSC_INHI_PENDIENTES.nombre2
  is 'Segundo Nombre.';
comment on column IT.TM_OSC_INHI_PENDIENTES.nombre3
  is 'Tercer Nombre.';
comment on column IT.TM_OSC_INHI_PENDIENTES.apellido1
  is 'Primer Apellido.';
comment on column IT.TM_OSC_INHI_PENDIENTES.apellido2
  is 'Segundo Apellido.';
comment on column IT.TM_OSC_INHI_PENDIENTES.apellido_casa
  is 'Apellido de Casado.';
comment on column IT.TM_OSC_INHI_PENDIENTES.causal
  is 'Codigo de Causa de la Inhibicion.';
comment on column IT.TM_OSC_INHI_PENDIENTES.multa
  is 'Multa.';
comment on column IT.TM_OSC_INHI_PENDIENTES.inhab_por
  is 'Inhabilitado por.';
comment on column IT.TM_OSC_INHI_PENDIENTES.fecha_circula
  is 'Fecha de la Circular.';
comment on column IT.TM_OSC_INHI_PENDIENTES.moneda
  is 'Moneda.';
comment on column IT.TM_OSC_INHI_PENDIENTES.msj_error
  is 'Mensaje de Error.';
comment on column IT.TM_OSC_INHI_PENDIENTES.cod_tip_documento
  is 'Tipo de Documento.';
comment on column IT.TM_OSC_INHI_PENDIENTES.estado
  is 'Estado (''P''=Pendiente, ''R''=Rechazada).';
comment on column IT.TM_OSC_INHI_PENDIENTES.fec_cam_estado
  is 'Fecha de Cambio de Estado.';
alter table IT.TM_OSC_INHI_PENDIENTES
  add constraint UK_TM_OSC_INHI_PENDIENTES unique (NRO_SECUENCIA, NRO_CIRCULAR, TIPO_DOCUMENT, NRO_DOCUMENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

