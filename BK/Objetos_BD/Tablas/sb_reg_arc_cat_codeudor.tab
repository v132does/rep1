create table IT.SB_REG_ARC_CAT_CODEUDOR
(
  cod_entidad          NUMBER(4),
  fecha                VARCHAR2(8),
  tip_documento        VARCHAR2(3),
  nro_documento        VARCHAR2(30),
  sal_capital_ml       NUMBER(18,2),
  sal_int_devengado_ml NUMBER(18,2),
  tot_riesgo_ml        NUMBER(18,2),
  dia_atraso           NUMBER(5),
  cat_operacion        VARCHAR2(2),
  cod_empresa_bt       NUMBER(3),
  cod_sucursal_bt      NUMBER(5),
  cod_moneda_bt        NUMBER(4),
  nro_cuenta_bt        NUMBER(9),
  operacion_bt         NUMBER(9),
  sub_operacion_bt     NUMBER(5),
  cod_modulo_bt        NUMBER(5),
  tip_operacion_bt     NUMBER(3),
  origen               VARCHAR2(20),
  cod_vinculo          NUMBER(3),
  tip_vinculo          VARCHAR2(60),
  cod_persona          VARCHAR2(10),
  cod_sucursal         VARCHAR2(4),
  tip_operacion        NUMBER(3),
  nro_operacion        VARCHAR2(60),
  cod_moneda           VARCHAR2(3),
  auxiliar1            VARCHAR2(30),
  auxiliar2            VARCHAR2(30),
  auxiliar3            NUMBER(18,2),
  auxiliar4            NUMBER(18,2),
  auxiliar5            NUMBER(18,2),
  auxiliar6            DATE,
  auxiliar7            VARCHAR2(30),
  auxiliar8            VARCHAR2(30),
  fec_archivo          DATE,
  dia_atr_cuenta       NUMBER
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_REG_ARC_CAT_CODEUDOR
  is 'Registro de Archivo de categorizacion de codeudores.';
comment on column IT.SB_REG_ARC_CAT_CODEUDOR.cod_entidad
  is 'Código de entidad.';
comment on column IT.SB_REG_ARC_CAT_CODEUDOR.fecha
  is 'Fecha.';
