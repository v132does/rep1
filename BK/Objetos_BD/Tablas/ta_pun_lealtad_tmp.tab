create table IT.TA_PUN_LEALTAD_TMP
(
  datos VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_PUN_LEALTAD_TMP
  is 'Archivo LOYALTY-POINTS-AAAAMMDD';
comment on column IT.TA_PUN_LEALTAD_TMP.datos
  is 'Datos importados del archivo LOYALTY-POINTS-AAAAMMDD';

