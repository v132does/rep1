create table IT.CC_CTA_CAJEROS
(
  cod_oficina        NUMBER(3) not null,
  nro_caja           NUMBER(3) not null,
  nro_cuenta         VARCHAR2(15),
  nro_cta_cheque     VARCHAR2(15),
  cod_moneda         VARCHAR2(3) not null,
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  cod_rubro          VARCHAR2(15),
  nro_caj_externo    NUMBER(6),
  cod_retencion      NUMBER(3) default 1,
  cod_ent_portavalor NUMBER(5)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.CC_CTA_CAJEROS
  is 'Cuentas de Cajeros Automaticos ( ATMs ).';
-- Add comments to the columns 
comment on column IT.CC_CTA_CAJEROS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.CC_CTA_CAJEROS.nro_caja
  is 'Numero de caja.';
comment on column IT.CC_CTA_CAJEROS.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.CC_CTA_CAJEROS.nro_cta_cheque
  is 'Cuenta para Deposito de Cheque c/o.';
comment on column IT.CC_CTA_CAJEROS.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.CC_CTA_CAJEROS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CTA_CAJEROS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CTA_CAJEROS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CTA_CAJEROS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CTA_CAJEROS.cod_rubro
  is 'Codigo de Rubro Contable.';
comment on column IT.CC_CTA_CAJEROS.nro_caj_externo
  is 'Numero de Caja en la procesadora de tarjetas de debito (INFONET).';
comment on column IT.CC_CTA_CAJEROS.cod_retencion
  is 'Código de retención.';
comment on column IT.CC_CTA_CAJEROS.cod_ent_portavalor
  is 'Codigo ente para Porta Valor.';
-- Create/Recreate indexes 
create unique index IT.IN_CCCAJ_NRO_CAJ_EXTERNO on IT.CC_CTA_CAJEROS (NRO_CAJ_EXTERNO, COD_MONEDA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CCCAJ_NRO_CTA_CHEQUE on IT.CC_CTA_CAJEROS (NRO_CTA_CHEQUE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CCCAJ_NRO_CUENTA on IT.CC_CTA_CAJEROS (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.CC_CTA_CAJEROS
  add constraint PK_CC_CTA_CAJEROS primary key (COD_OFICINA, NRO_CAJA, COD_MONEDA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CTA_CAJEROS
  add constraint FK_CCCAJ_NRO_CAJA foreign key (NRO_CAJA)
  references IT.CJ_CAJAS (NRO_CAJA);
alter table IT.CC_CTA_CAJEROS
  add constraint FK_CCCAJ_NRO_CTA_CHEQUE foreign key (NRO_CTA_CHEQUE)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.CC_CTA_CAJEROS
  add constraint FK_CCCAJ_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
-- Create/Recreate check constraints 
alter table IT.CC_CTA_CAJEROS
  add constraint AVCON_COD_O_009
  check (COD_OFICINA BETWEEN 1 AND 999);
alter table IT.CC_CTA_CAJEROS
  add constraint AVCON_NRO_C_000
  check (NRO_CAJA BETWEEN 1 AND 999)
  disable
  novalidate;
