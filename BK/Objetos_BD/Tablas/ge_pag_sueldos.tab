-- Create table
create table IT.GE_PAG_SUELDOS
(
  cod_usuario      VARCHAR2(10),
  cod_ente         NUMBER(5) not null,
  fec_proceso      DATE,
  nro_secuencia    NUMBER(3) not null,
  cod_modalidad    NUMBER(3),
  nro_cuenta       VARCHAR2(15),
  cod_moneda       VARCHAR2(3),
  fec_envio        DATE,
  tipo             VARCHAR2(1),
  monto            NUMBER(18,2) default 0,
  estado           VARCHAR2(1),
  cod_proceso      NUMBER(3),
  cod_modulo       NUMBER(3),
  fec_insercion    DATE default SYSDATE not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  ano              NUMBER(4),
  nivel            NUMBER(2),
  entidad          NUMBER(3),
  observacion      VARCHAR2(15),
  procesado        VARCHAR2(1) default 'N',
  nro_documento    VARCHAR2(20),
  nro_lote         NUMBER(15),
  nro_lot_ips      NUMBER(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.GE_PAG_SUELDOS
  is 'Detalle de pago de sueldos.';
-- Add comments to the columns 
comment on column IT.GE_PAG_SUELDOS.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.GE_PAG_SUELDOS.cod_ente
  is 'codigo de ente.';
comment on column IT.GE_PAG_SUELDOS.fec_proceso
  is 'fecha de proceso.';
comment on column IT.GE_PAG_SUELDOS.nro_secuencia
  is 'nro de secuencia.';
comment on column IT.GE_PAG_SUELDOS.cod_modalidad
  is 'codigo de modalidad.';
comment on column IT.GE_PAG_SUELDOS.nro_cuenta
  is 'nro de cuenta.';
comment on column IT.GE_PAG_SUELDOS.cod_moneda
  is 'cod moneda.';
comment on column IT.GE_PAG_SUELDOS.fec_envio
  is 'fecha de envio.';
comment on column IT.GE_PAG_SUELDOS.tipo
  is 'tipo.';
comment on column IT.GE_PAG_SUELDOS.monto
  is 'monto.';
comment on column IT.GE_PAG_SUELDOS.estado
  is 'estado.';
comment on column IT.GE_PAG_SUELDOS.cod_proceso
  is 'codigo de proceso.';
comment on column IT.GE_PAG_SUELDOS.cod_modulo
  is 'codigo de modulo.';
comment on column IT.GE_PAG_SUELDOS.fec_insercion
  is 'fecha de insercion.';
comment on column IT.GE_PAG_SUELDOS.usu_insercion
  is 'usuario de insercion.';
comment on column IT.GE_PAG_SUELDOS.fec_modificacion
  is 'fecha de modificacion.';
comment on column IT.GE_PAG_SUELDOS.usu_modificacion
  is 'usuario de modificacion.';
comment on column IT.GE_PAG_SUELDOS.ano
  is 'Año del Movimiento.';
comment on column IT.GE_PAG_SUELDOS.nivel
  is 'Nivel.';
comment on column IT.GE_PAG_SUELDOS.entidad
  is 'Codigo de Entidad.';
comment on column IT.GE_PAG_SUELDOS.observacion
  is 'Observacion. (Contine numero de Remito para ciertos Entes)';
comment on column IT.GE_PAG_SUELDOS.procesado
  is 'Procesado (S / N).';
comment on column IT.GE_PAG_SUELDOS.nro_documento
  is 'Nro Documento del Cliente';
comment on column IT.GE_PAG_SUELDOS.nro_lote
  is 'Numero de Lote.';
comment on column IT.GE_PAG_SUELDOS.nro_lot_ips
  is 'Nro de lote ips';
-- Create/Recreate indexes 
create index IT.IN_GPSUE_COD_ENTE on IT.GE_PAG_SUELDOS (COD_ENTE, FEC_PROCESO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GPSUE_COD_MODALIDAD on IT.GE_PAG_SUELDOS (COD_MODALIDAD, COD_MODULO, COD_MONEDA, COD_USUARIO, NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GPSUE_NRO_CUENTA on IT.GE_PAG_SUELDOS (NRO_CUENTA, FEC_PROCESO, COD_ENTE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.GE_PAG_SUELDOS
  add constraint FK_GPSUE_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.GE_PAG_SUELDOS
  add constraint FK_GPSUE_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_PAG_SUELDOS
  add constraint FK_GPSUE_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_PAG_SUELDOS
  add constraint FK_GPSUE_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
-- Create/Recreate check constraints 
alter table IT.GE_PAG_SUELDOS
  add constraint AVCON_1102107887_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_PAG_SUELDOS
  add constraint AVCON_1102107887_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
-- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.GE_PAG_SUELDOS to IT_TEMPORAL;
