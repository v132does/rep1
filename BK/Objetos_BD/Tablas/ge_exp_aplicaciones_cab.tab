create table IT.GE_EXP_APLICACIONES_CAB
(
  cod_mensaje         NUMBER(5) not null,
  fecha               DATE,
  hora                VARCHAR2(8),
  mensaje             CLOB,
  respuesta           VARCHAR2(4000),
  estado              VARCHAR2(1),
  url_crm             VARCHAR2(3000),
  guid_crm            VARCHAR2(3000),
  cod_usu_solicitante VARCHAR2(10),
  cod_usu_sancionador VARCHAR2(10),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  tip_transferencia   VARCHAR2(1),
  det_error           VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_EXP_APLICACIONES_CAB
  is 'Datos comunicaci?n entre aplicaciones.';
comment on column IT.GE_EXP_APLICACIONES_CAB.cod_mensaje
  is 'Identificador Unico del Registro.';
comment on column IT.GE_EXP_APLICACIONES_CAB.fecha
  is 'Fecha de Ejecucion del Proceso';
comment on column IT.GE_EXP_APLICACIONES_CAB.hora
  is 'Hora de Ejecucion del Proceso';
comment on column IT.GE_EXP_APLICACIONES_CAB.mensaje
  is 'Mensaje Recibido';
comment on column IT.GE_EXP_APLICACIONES_CAB.respuesta
  is 'Respuesta Emitida al Mensaje Recibido';
comment on column IT.GE_EXP_APLICACIONES_CAB.estado
  is 'Estado del Proceso. R=Recibido, P=Procesado, E=Error';
comment on column IT.GE_EXP_APLICACIONES_CAB.url_crm
  is 'Url de la solicitud en CRM';
comment on column IT.GE_EXP_APLICACIONES_CAB.guid_crm
  is 'Identificador unico del registro en CRM';
comment on column IT.GE_EXP_APLICACIONES_CAB.cod_usu_solicitante
  is 'Usuario Solicitante en CRM';
comment on column IT.GE_EXP_APLICACIONES_CAB.cod_usu_sancionador
  is 'Usuario Sancionador en CRM';
comment on column IT.GE_EXP_APLICACIONES_CAB.usu_insercion
  is 'Usuario de insercion.';
comment on column IT.GE_EXP_APLICACIONES_CAB.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.GE_EXP_APLICACIONES_CAB.usu_modificacion
  is 'Usuario de modificacion.';
comment on column IT.GE_EXP_APLICACIONES_CAB.fec_modificacion
  is 'Fecha de modificacion.';
comment on column IT.GE_EXP_APLICACIONES_CAB.tip_transferencia
  is 'Tipo de transferencia del mensaje Enviado/Recibido';
comment on column IT.GE_EXP_APLICACIONES_CAB.det_error
  is 'Detalle de Error en caso de detectarse algun error en el procesamiento.';
alter table IT.GE_EXP_APLICACIONES_CAB
  add constraint PK_GE_EXP_APLICACIONES_CAB primary key (COD_MENSAJE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

