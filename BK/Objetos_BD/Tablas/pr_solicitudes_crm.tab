create table IT.PR_SOLICITUDES_CRM
(
  nro_solicitud         NUMBER(7) not null,
  descripcion           VARCHAR2(240),
  monto                 NUMBER(18,2),
  tip_interes           VARCHAR2(1),
  tip_amortizacion      VARCHAR2(1),
  dia_plazo             NUMBER(4),
  fec_vencimiento       DATE,
  aju_ult_cuota         VARCHAR2(1),
  mto_interes           NUMBER(18,2),
  tip_aju_fecha         VARCHAR2(1),
  per_vto_capital       NUMBER(4),
  per_gracia            NUMBER(4),
  cod_persona           VARCHAR2(10),
  fec_inicio            DATE,
  tip_monto             VARCHAR2(1),
  aju_gracia            VARCHAR2(1),
  tot_prestamo          NUMBER(18,2),
  estado                VARCHAR2(1),
  cod_ori_fondo         NUMBER(3),
  cod_modulo            NUMBER(3),
  cod_modalidad         NUMBER(3),
  cod_moneda            VARCHAR2(3),
  mto_cargo             NUMBER(18,2),
  cod_oficina           NUMBER(3),
  fec_pri_vencimiento   DATE,
  cod_ent_seguro        NUMBER(5),
  cod_sec_credito       NUMBER(3),
  cod_departamento      NUMBER(3),
  nro_sol_renovada      NUMBER(7),
  tip_documento         VARCHAR2(1),
  tipo                  VARCHAR2(1),
  exo_impuesto          VARCHAR2(1),
  tot_desembolsar       NUMBER(18,2),
  can_desembolsos       NUMBER(3),
  nro_sol_original      NUMBER(7),
  sal_prestamo          NUMBER(18,2),
  can_des_faltantes     NUMBER(3),
  cod_ent_concesionaria NUMBER(5),
  nro_cta_debito        VARCHAR2(15),
  deb_automatico        VARCHAR2(1),
  fec_aprobacion        DATE,
  cod_usu_aprobacion    VARCHAR2(10),
  cod_usu_promotor      VARCHAR2(10),
  nro_linea             NUMBER(7),
  observaciones         VARCHAR2(1000),
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      TIMESTAMP(6) default current_timestamp not null,
  cod_canal             NUMBER(3),
  cod_campana           NUMBER(3),
  mto_lin_aplicado      NUMBER(18,2),
  tip_renovacion        VARCHAR2(1),
  tip_destino           VARCHAR2(1),
  est_verificacion      VARCHAR2(1),
  aut_pendiente         VARCHAR2(1),
  niv_aprobacion        VARCHAR2(3),
  nro_acta              NUMBER(10),
  cod_banca             NUMBER(5),
  cod_autorizacion      NUMBER(10),
  por_ori_fondo         NUMBER(7,4),
  tot_desembolso        NUMBER(18,2),
  fec_ren_tasa          DATE,
  cod_destino           VARCHAR2(3),
  val_presupuesto       NUMBER(18,2),
  cod_causa             NUMBER(3),
  obs_reconsideracion   VARCHAR2(1000),
  referencia            VARCHAR2(10),
  ind_evaluacion        VARCHAR2(1),
  cod_sub_modalidad     NUMBER(3),
  tas_referencia        VARCHAR2(3),
  spread                NUMBER(20,4),
  tip_cal_renovacion    VARCHAR2(1),
  cod_rub_economico     VARCHAR2(6),
  iva_desglose          VARCHAR2(1),
  en_etapas             VARCHAR2(1),
  tas_piso              NUMBER(20,4),
  tip_accion            VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_SOLICITUDES_CRM
  is 'Contiene los datos de las Propuestas de los Prestamos.';
comment on column IT.PR_SOLICITUDES_CRM.nro_solicitud
  is 'Numero de propuesta.';
comment on column IT.PR_SOLICITUDES_CRM.descripcion
  is 'Descripcion de la propuesta.';
comment on column IT.PR_SOLICITUDES_CRM.monto
  is 'Valor del monto del prestamo.';
comment on column IT.PR_SOLICITUDES_CRM.tip_interes
  is 'Tipo de interes (A=Adelantado / V=Vencido).';
comment on column IT.PR_SOLICITUDES_CRM.tip_amortizacion
  is 'Tipo de sistema de amortizacion.';
comment on column IT.PR_SOLICITUDES_CRM.dia_plazo
  is 'Plazo en dias.';
comment on column IT.PR_SOLICITUDES_CRM.fec_vencimiento
  is 'Fecha de vencimiento.';
comment on column IT.PR_SOLICITUDES_CRM.aju_ult_cuota
  is 'Se ajusta ultima Cuota S/N.';
comment on column IT.PR_SOLICITUDES_CRM.mto_interes
  is 'Valor total del interes.';
comment on column IT.PR_SOLICITUDES_CRM.tip_aju_fecha
  is 'Tipo de ajuste de fecha.';
comment on column IT.PR_SOLICITUDES_CRM.per_vto_capital
  is 'Periodo de vencimiento del capital.';
comment on column IT.PR_SOLICITUDES_CRM.per_gracia
  is 'Periodo de gracia.';
comment on column IT.PR_SOLICITUDES_CRM.cod_persona
  is 'Codigo de cliente.';
comment on column IT.PR_SOLICITUDES_CRM.fec_inicio
  is 'Fecha de inicio del prestamo / solicitud.';
comment on column IT.PR_SOLICITUDES_CRM.tip_monto
  is 'Tipo de monto.';
comment on column IT.PR_SOLICITUDES_CRM.aju_gracia
  is 'Se ajusta el periodo de gracia S/N.';
comment on column IT.PR_SOLICITUDES_CRM.tot_prestamo
  is 'Valor total  del prestamo.';
comment on column IT.PR_SOLICITUDES_CRM.estado
  is 'Estado de la Solicitud. (S = Solicitada / L = Pendiente de Liquidacion / A = Desembolsada / N = Cancelada / R = Rechazada).';
comment on column IT.PR_SOLICITUDES_CRM.cod_ori_fondo
  is 'Codigo de origen de fondos.';
comment on column IT.PR_SOLICITUDES_CRM.cod_modulo
  is 'Codigo del modulo.';
comment on column IT.PR_SOLICITUDES_CRM.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.PR_SOLICITUDES_CRM.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.PR_SOLICITUDES_CRM.mto_cargo
  is 'Valor del cargo.';
comment on column IT.PR_SOLICITUDES_CRM.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.PR_SOLICITUDES_CRM.fec_pri_vencimiento
  is 'Fecha final del periodo de gracia.';
comment on column IT.PR_SOLICITUDES_CRM.cod_ent_seguro
  is 'Codigo de seguro.';
comment on column IT.PR_SOLICITUDES_CRM.cod_sec_credito
  is 'Codigo de sector.';
comment on column IT.PR_SOLICITUDES_CRM.cod_departamento
  is 'Codigo de departamento.';
comment on column IT.PR_SOLICITUDES_CRM.nro_sol_renovada
  is 'Numero de propuesta renovada.';
comment on column IT.PR_SOLICITUDES_CRM.tip_documento
  is 'Tipo de documento. (1=Vista / 2=Vencimiento).';
comment on column IT.PR_SOLICITUDES_CRM.tipo
  is 'Tipo de prestamo.';
comment on column IT.PR_SOLICITUDES_CRM.exo_impuesto
  is 'Tiene Exoneracion Ley 125 ( S=SI, N=NO ).';
comment on column IT.PR_SOLICITUDES_CRM.tot_desembolsar
  is 'Total Neto a Desembolsar.';
comment on column IT.PR_SOLICITUDES_CRM.can_desembolsos
  is 'Cantidad de Desembolsos del Prestamo.';
comment on column IT.PR_SOLICITUDES_CRM.nro_sol_original
  is 'Numero de Propuesta Original.';
comment on column IT.PR_SOLICITUDES_CRM.sal_prestamo
  is 'Saldo del Prestamo a Desembolsar.';
comment on column IT.PR_SOLICITUDES_CRM.can_des_faltantes
  is 'Cantidad de Desembolsos que faltan realizar.';
comment on column IT.PR_SOLICITUDES_CRM.cod_ent_concesionaria
  is 'Codigo de la concesionaria o inmobiliaria.';
comment on column IT.PR_SOLICITUDES_CRM.nro_cta_debito
  is 'Cuenta en donde se deposita el prestamo y contra la cual se realiza el debito automatico por las cuotas del prestamo.';
comment on column IT.PR_SOLICITUDES_CRM.deb_automatico
  is 'Indica si el cliente realiza el pago del prestamo por debito automatico (S=SI / N= NO).';
comment on column IT.PR_SOLICITUDES_CRM.fec_aprobacion
  is 'Fecha Aprobado / Rechazado.';
comment on column IT.PR_SOLICITUDES_CRM.cod_usu_aprobacion
  is 'Usuario que Aprobo / Rechazo un prestamo.';
comment on column IT.PR_SOLICITUDES_CRM.cod_usu_promotor
  is 'Codigo del promotor.';
comment on column IT.PR_SOLICITUDES_CRM.nro_linea
  is 'Numero de Linea.';
comment on column IT.PR_SOLICITUDES_CRM.observaciones
  is 'Observaciones.';
comment on column IT.PR_SOLICITUDES_CRM.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.PR_SOLICITUDES_CRM.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.PR_SOLICITUDES_CRM.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.PR_SOLICITUDES_CRM.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.PR_SOLICITUDES_CRM.cod_canal
  is 'Canal.';
comment on column IT.PR_SOLICITUDES_CRM.cod_campana
  is 'Campaña.';
comment on column IT.PR_SOLICITUDES_CRM.mto_lin_aplicado
  is 'Monto de la linea aplicado en moneda de la linea.';
comment on column IT.PR_SOLICITUDES_CRM.tip_renovacion
  is 'Tipo de renovacion: Refinanciado, rEstructurado, reNovado.';
comment on column IT.PR_SOLICITUDES_CRM.tip_destino
  is 'Tipo de Destino.';
comment on column IT.PR_SOLICITUDES_CRM.est_verificacion
  is 'Estado de Verificacion.';
comment on column IT.PR_SOLICITUDES_CRM.aut_pendiente
  is 'Autorizacion Pendiente.';
comment on column IT.PR_SOLICITUDES_CRM.niv_aprobacion
  is 'Nivel de Aprobacion.';
comment on column IT.PR_SOLICITUDES_CRM.nro_acta
  is 'Nro de Acta.';
comment on column IT.PR_SOLICITUDES_CRM.cod_banca
  is 'Codigo de Banca.';
comment on column IT.PR_SOLICITUDES_CRM.cod_autorizacion
  is 'Codigo de Autorizacion de Tasa.';
comment on column IT.PR_SOLICITUDES_CRM.por_ori_fondo
  is 'Porcentaje correspondiente al Origen de Fondos.';
comment on column IT.PR_SOLICITUDES_CRM.tot_desembolso
  is 'Valor Total del Prestamo a Desembolsar (varios desembolsos).';
comment on column IT.PR_SOLICITUDES_CRM.fec_ren_tasa
  is 'Fecha de Renegociacion de Tasa.';
comment on column IT.PR_SOLICITUDES_CRM.cod_destino
  is 'Codigo del Destino del Prestamo.';
comment on column IT.PR_SOLICITUDES_CRM.val_presupuesto
  is 'Valor del Presupuesto.';
comment on column IT.PR_SOLICITUDES_CRM.cod_causa
  is 'Motivo de rechazo de la propuesta.';
comment on column IT.PR_SOLICITUDES_CRM.obs_reconsideracion
  is 'Observacion de la Reconsideracion.';
comment on column IT.PR_SOLICITUDES_CRM.referencia
  is 'Referencia Externa.';
comment on column IT.PR_SOLICITUDES_CRM.ind_evaluacion
  is 'Indica si una solicitud debe pasar por el Motor de Evaluacion de Riesgos.';
comment on column IT.PR_SOLICITUDES_CRM.cod_sub_modalidad
  is 'Codigo de Sub-Modalidad.';
comment on column IT.PR_SOLICITUDES_CRM.tas_referencia
  is 'Tasa de Referencia.';
comment on column IT.PR_SOLICITUDES_CRM.spread
  is 'Margen que existe entre los tipos de interes activos y pasivos.';
comment on column IT.PR_SOLICITUDES_CRM.tip_cal_renovacion
  is 'Tipo de calendarizacion ingresado por el usuario en la pantalla de Mantenimiento de Refinanciacion, Reestructuracion y Renovacion.';
comment on column IT.PR_SOLICITUDES_CRM.cod_rub_economico
  is 'Codigo de Rubro Economico.';
comment on column IT.PR_SOLICITUDES_CRM.iva_desglose
  is 'Valor que permite cuotizar el monto del IVA';
comment on column IT.PR_SOLICITUDES_CRM.en_etapas
  is 'Idenfica si la Solicitud es en Etapas. S/N';
comment on column IT.PR_SOLICITUDES_CRM.tas_piso
  is 'Tasa Piso Definida.';
comment on column IT.PR_SOLICITUDES_CRM.tip_accion
  is 'Indica el tipo de accion realizado con el registro en el Core.-';

