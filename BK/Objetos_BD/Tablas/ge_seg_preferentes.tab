create table IT.GE_SEG_PREFERENTES
(
  cod_seg_preferente NUMBER(3) not null,
  descripcion        VARCHAR2(60) not null,
  rgb                VARCHAR2(15),
  fin_nom_archivo    VARCHAR2(3),
  nom_cam_color      VARCHAR2(40),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SEG_PREFERENTES
  is 'Segmentos Preferentes de Clientes';
comment on column IT.GE_SEG_PREFERENTES.cod_seg_preferente
  is 'Código del Segmento Preferente.';
comment on column IT.GE_SEG_PREFERENTES.descripcion
  is 'Descripción del Segmento Preferente';
comment on column IT.GE_SEG_PREFERENTES.rgb
  is 'Color de la fuente a utilizar. RGB Indica el Porcentaje  de Red, Green y Blue (r<valor>g<valor>b<valor>). Ejemplo: r100b88g0.';
comment on column IT.GE_SEG_PREFERENTES.fin_nom_archivo
  is 'Código para la generación de archivos que identifica el segmento preferente dentro del archivo generado y como nombre del mismo';
comment on column IT.GE_SEG_PREFERENTES.nom_cam_color
  is 'Nombre del campo donde se encuentra el color seleccionado para el preferente';
comment on column IT.GE_SEG_PREFERENTES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_SEG_PREFERENTES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_SEG_PREFERENTES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_SEG_PREFERENTES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.GE_SEG_PREFERENTES
  add constraint PK_GE_SEG_PREFERENTES primary key (COD_SEG_PREFERENTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SEG_PREFERENTES
  add constraint UK_GSPRE_DESCRIPCION unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

