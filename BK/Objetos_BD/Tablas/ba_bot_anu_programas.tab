create table IT.BA_BOT_ANU_PROGRAMAS
(
  cod_programa     VARCHAR2(30) not null,
  boton            VARCHAR2(60) not null,
  observacion      VARCHAR2(250),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_BOT_ANU_PROGRAMAS
  is 'Botones no visualizados por programa.';
comment on column IT.BA_BOT_ANU_PROGRAMAS.cod_programa
  is 'Codigo de Programa.';
comment on column IT.BA_BOT_ANU_PROGRAMAS.boton
  is 'Nombre del campo del Boton.';
comment on column IT.BA_BOT_ANU_PROGRAMAS.observacion
  is 'Observaciones.';
comment on column IT.BA_BOT_ANU_PROGRAMAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_BOT_ANU_PROGRAMAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_BOT_ANU_PROGRAMAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_BOT_ANU_PROGRAMAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BA_BOT_ANU_PROGRAMAS
  add constraint PK_BA_BOT_ANU_PROGRAMAS primary key (COD_PROGRAMA, BOTON)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

