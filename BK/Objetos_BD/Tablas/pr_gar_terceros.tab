create table IT.PR_GAR_TERCEROS
(
  nro_garantia     NUMBER(7) not null,
  cod_persona      VARCHAR2(10) not null,
  por_utilizacion  NUMBER(20,4) not null,
  tip_tercero      VARCHAR2(1) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion    DATE default sysdate,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.PR_GAR_TERCEROS.nro_garantia
  is 'Número identificador de la garantía.';
comment on column IT.PR_GAR_TERCEROS.cod_persona
  is 'Código de Persona.';
comment on column IT.PR_GAR_TERCEROS.por_utilizacion
  is 'Porcentaje de utilización del monto computable.';
comment on column IT.PR_GAR_TERCEROS.tip_tercero
  is 'Tipo de Tercero. B=Beneficiario, O=Otorgante.';
comment on column IT.PR_GAR_TERCEROS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_GAR_TERCEROS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_GAR_TERCEROS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_GAR_TERCEROS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.PR_GAR_TERCEROS
  add constraint PK_PR_GAR_TERCEROS primary key (NRO_GARANTIA, COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_GAR_TERCEROS
  add constraint FK_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.PR_GAR_TERCEROS
  add constraint FK_NRO_GARANTIA foreign key (NRO_GARANTIA)
  references IT.PR_GARANTIAS (NRO_GARANTIA);

