create index IT.IN_TCUPT_COD_ENT_PROC on IT.TA_CTA_TARJETAS_PRO_TMP (COD_ENT_PROCESADORA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
