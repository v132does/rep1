create table IT.TA_CTA_TARJETAS_PRO_TMP
(
  nro_cuenta             VARCHAR2(15),
  nro_tarjeta            VARCHAR2(16),
  nro_tar_principal      VARCHAR2(16),
  cod_modulo             VARCHAR2(3),
  cod_modalidad          VARCHAR2(3),
  cod_oficina            VARCHAR2(3),
  cod_moneda             VARCHAR2(3),
  nro_socio              NUMBER(10),
  tip_tarjeta            NUMBER(1),
  nom_embozar            VARCHAR2(30),
  dur_meses              NUMBER(3),
  direccion              VARCHAR2(35),
  tip_envio              VARCHAR2(2),
  cod_env_extracto       VARCHAR2(1),
  cic_extracto           NUMBER(2),
  nro_documento          NUMBER(9),
  nro_ruc                VARCHAR2(20),
  telefono               VARCHAR2(15),
  des_ciudad             VARCHAR2(20),
  nacionalidad           NUMBER(4),
  fec_nacimiento         DATE,
  est_civil              NUMBER(1),
  cod_sexo               VARCHAR2(2),
  cod_ocupacion          NUMBER(5),
  cod_ret_corresp        VARCHAR2(1),
  fec_emi_plastico       DATE,
  fec_ven_plastico       DATE,
  for_pago               VARCHAR2(1),
  cod_usu_promotor       NUMBER(2),
  cod_enc_cuenta         VARCHAR2(3),
  lin_credito            NUMBER(13,2) default 0,
  lin_cuotas             NUMBER(13,2) default 0,
  lin_especial           NUMBER(13,2) default 0,
  sal_facturar           NUMBER(13,2) default 0,
  sal_facturado          NUMBER(13,2) default 0,
  sal_financiado         NUMBER(13,2) default 0,
  mto_mora               NUMBER(13,2) default 0,
  dia_mora               NUMBER(6),
  mar_mora               NUMBER(7),
  fec_vct_ult_cierre     DATE,
  mar_recuperado         VARCHAR2(1),
  mar_vencida            VARCHAR2(1),
  mar_excedido           VARCHAR2(1),
  mar_bloqueo            VARCHAR2(1),
  mar_activa             VARCHAR2(1),
  mar_inhabilitada       VARCHAR2(1),
  fec_ult_compra         DATE,
  fec_ult_operacion      DATE,
  fec_ult_pago           DATE,
  mto_pag_mes            VARCHAR2(18) default 0,
  tip_cierre             NUMBER(2),
  sal_cuo_pendientes     NUMBER(13,2) default 0,
  sal_cuo_pen_refin      NUMBER(13,2),
  sal_ade_disponible     NUMBER(13,2),
  sal_com_disponible     NUMBER(13,2),
  mto_pri_cuo_refin      NUMBER(13,2),
  mto_autorizaciones     NUMBER(13,2) default 0,
  mto_aut_cuotas         NUMBER(13,2),
  mto_car_suspendido     NUMBER(13,2),
  mto_car_sus_aplicado   NUMBER(13,2),
  mto_ult_pago           NUMBER(13,2),
  mto_pen_amortizaciones NUMBER(13,2),
  mto_lin_esp_amort      NUMBER(13,2),
  mto_ult_cierre         NUMBER(13,2),
  tas_efectiva           NUMBER(7,2),
  tas_nominal            NUMBER(5,2),
  tas_financiacion       NUMBER(5,2) default 0,
  tas_mora               NUMBER(5,2) default 0,
  tas_cuotas             NUMBER(5,2) default 0,
  tas_compras            NUMBER(5,2),
  tas_normal             NUMBER(5,2),
  por_pag_minimo         NUMBER(3) default 0,
  mto_pag_minimo         NUMBER(13,2) default 0,
  pag_min_facturado      NUMBER(13,2) default 0,
  tip_com_emision        VARCHAR2(1),
  con_costo              VARCHAR2(1) default 'N',
  fec_archivo            VARCHAR2(18),
  nro_reg                VARCHAR2(18),
  cod_usu_ente           VARCHAR2(10),
  usu_insercion          VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion          DATE default SYSDATE not null,
  usu_modificacion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion       DATE default SYSDATE not null,
  estado                 VARCHAR2(30),
  cod_ent_procesadora    VARCHAR2(18),
  cod_afinidad           VARCHAR2(3),
  nro_cta_debito         NUMBER(12),
  sal_pag_minimo         VARCHAR2(18),
  fec_activacion         DATE,
  fec_generacion         DATE,
  fec_ven_extracto       DATE,
  dir_particular         VARCHAR2(50),
  loc_particular         VARCHAR2(15),
  barrio                 VARCHAR2(20),
  dir_laboral            VARCHAR2(50),
  loc_laboral            VARCHAR2(15),
  tel_laboral            VARCHAR2(15),
  tel_celular            VARCHAR2(15),
  renovar                VARCHAR2(2),
  parametro_f            NUMBER(2),
  parametro_g            NUMBER(2),
  parametro_h            NUMBER(2),
  parametro_i            VARCHAR2(2),
  parametro_j            VARCHAR2(2),
  parametro_k            NUMBER(2),
  parametro_l            VARCHAR2(2),
  parametro_m            VARCHAR2(2),
  parametro_n            NUMBER(2),
  parametro_o            NUMBER(2),
  parametro_p            NUMBER(2),
  parametro_q            VARCHAR2(2),
  parametro_r            VARCHAR2(2),
  parametro_t            VARCHAR2(1),
  sucursal               NUMBER(3),
  tip_cta_banco          VARCHAR2(3),
  cta_especial           NUMBER(13,2),
  bar_laboral            VARCHAR2(20)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
