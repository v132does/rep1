create table IT.GE_EXT_INFONET_TMP_1
(
  nro_cta_debito  VARCHAR2(15) not null,
  cod_bco_debito  NUMBER(3) not null,
  nro_cta_credito VARCHAR2(15) not null,
  cod_bco_credito NUMBER(3) not null,
  cod_operacion   VARCHAR2(2) not null,
  cod_extorno     VARCHAR2(2) not null,
  nro_documento   VARCHAR2(15) not null,
  monto           NUMBER(18,2) not null,
  cod_moneda      VARCHAR2(3) not null,
  fecha           DATE not null,
  hora            VARCHAR2(8) not null,
  cod_bco_atm     NUMBER(3),
  negocio         VARCHAR2(40),
  nro_atm         VARCHAR2(3),
  mto_comision    NUMBER(18,2),
  dat_adicional   VARCHAR2(32)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

