create table IT.CR_CAM_PERSONAS
(
  cod_campana         NUMBER(3) not null,
  cod_persona         VARCHAR2(10) not null,
  estado              NUMBER(3),
  cod_usu_responsable VARCHAR2(10),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  fec_ini_asignacion  DATE,
  cod_agenda          NUMBER(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_CAM_PERSONAS
  is 'Personas por Campaña.';
comment on column IT.CR_CAM_PERSONAS.cod_campana
  is 'Codigo de Campaña.';
comment on column IT.CR_CAM_PERSONAS.cod_persona
  is 'Codigo de Persona.';
comment on column IT.CR_CAM_PERSONAS.estado
  is 'Estado de la campaña de la persona.';
comment on column IT.CR_CAM_PERSONAS.cod_usu_responsable
  is 'Responsable.';
comment on column IT.CR_CAM_PERSONAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_CAM_PERSONAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_CAM_PERSONAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_CAM_PERSONAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CR_CAM_PERSONAS.fec_ini_asignacion
  is 'Fecha inicial de asignacion de la actividad.';
comment on column IT.CR_CAM_PERSONAS.cod_agenda
  is 'Codigo de la agenda generada.';
create index IT.IN_RCPER_COD_PERSONA on IT.CR_CAM_PERSONAS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_CAM_PERSONAS
  add constraint PK_CR_CAM_PERSONAS primary key (COD_CAMPANA, COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_CAM_PERSONAS
  add constraint FK_RCPER_COD_CAMPANA foreign key (COD_CAMPANA)
  references IT.CR_CAMPANAS (COD_CAMPANA);
alter table IT.CR_CAM_PERSONAS
  add constraint FK_RCPER_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CR_CAM_PERSONAS
  add constraint FK_RCPER_COD_USU_RESPONSABLE foreign key (COD_USU_RESPONSABLE)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.CR_CAM_PERSONAS
  add constraint AVCON_1080843837_COD_C_000
  check (COD_CAMPANA BETWEEN 1 AND 999);

