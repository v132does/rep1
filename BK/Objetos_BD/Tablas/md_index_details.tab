create table IT.MD_INDEX_DETAILS
(
  id                NUMBER not null,
  index_id_fk       NUMBER not null,
  column_id_fk      NUMBER not null,
  index_portion     NUMBER,
  detail_order      NUMBER not null,
  security_group_id NUMBER default 0 not null,
  created_on        DATE default sysdate not null,
  created_by        VARCHAR2(255),
  last_updated_on   DATE,
  last_updated_by   VARCHAR2(255)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MD_INDEX_DETAILS
  is 'This table stores the details of an index.  It shows what columns are "part" of the index.';
comment on column IT.MD_INDEX_DETAILS.index_id_fk
  is 'The index to which this detail belongs. //PARENTFIELD';
comment on column IT.MD_INDEX_DETAILS.index_portion
  is 'To support indexing on part of a field';
alter table IT.MD_INDEX_DETAILS
  add constraint MD_INDEX_DETAILS_PK primary key (ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.MD_INDEX_DETAILS
  add constraint MD_INDEX_DETAILS_MD_COLUM_FK1 foreign key (COLUMN_ID_FK)
  references IT.MD_COLUMNS (ID) on delete cascade;
alter table IT.MD_INDEX_DETAILS
  add constraint MD_INDEX_DETAILS_MD_INDEX_FK1 foreign key (INDEX_ID_FK)
  references IT.MD_INDEXES (ID) on delete cascade;

