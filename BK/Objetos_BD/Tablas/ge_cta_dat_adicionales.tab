create table IT.GE_CTA_DAT_ADICIONALES
(
  nro_cuenta       VARCHAR2(15) not null,
  parametro        VARCHAR2(30) not null,
  val_parametro    VARCHAR2(500) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CTA_DAT_ADICIONALES
  is 'Datos adicionales por Cuenta.';
comment on column IT.GE_CTA_DAT_ADICIONALES.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.GE_CTA_DAT_ADICIONALES.parametro
  is 'Codigo del campo.';
comment on column IT.GE_CTA_DAT_ADICIONALES.val_parametro
  is 'Valor del campo.';
comment on column IT.GE_CTA_DAT_ADICIONALES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CTA_DAT_ADICIONALES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CTA_DAT_ADICIONALES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CTA_DAT_ADICIONALES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_GCDA_PARAMETRO on IT.GE_CTA_DAT_ADICIONALES (PARAMETRO, NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GCDA_VAL_PARAMETRO on IT.GE_CTA_DAT_ADICIONALES (PARAMETRO, VAL_PARAMETRO, NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CTA_DAT_ADICIONALES
  add constraint PK_GE_CTA_DAT_ADICIONALES primary key (NRO_CUENTA, PARAMETRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CTA_DAT_ADICIONALES
  add constraint FK_GCDAD_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA)
  disable
  novalidate;
alter table IT.GE_CTA_DAT_ADICIONALES
  add constraint FK_GCDAD_PARAMETRO foreign key (PARAMETRO)
  references IT.GE_PARAMETROS (PARAMETRO);

