create table IT.GE_INV_DOCUMENTOS
(
  cod_oficina      NUMBER(3) not null,
  tipo             VARCHAR2(1) not null,
  nro_secuencia    NUMBER(10) not null,
  nro_lote         VARCHAR2(5) not null,
  nro_inicial      NUMBER(10) not null,
  nro_final        NUMBER(10) not null,
  cantidad         NUMBER(4),
  estado           VARCHAR2(1) not null,
  est_documentos   VARCHAR2(4000),
  observacion      VARCHAR2(1000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_INV_DOCUMENTOS.cod_oficina
  is 'Código de Oficina a la que corresponde el rango de números de documentos.';
comment on column IT.GE_INV_DOCUMENTOS.tipo
  is 'Tipo de Documento.';
comment on column IT.GE_INV_DOCUMENTOS.nro_secuencia
  is 'Número de Secuencia.';
comment on column IT.GE_INV_DOCUMENTOS.nro_lote
  is 'Número de Lote. ';
comment on column IT.GE_INV_DOCUMENTOS.nro_inicial
  is 'Número Inicial del grupo de Números de Documentos.';
comment on column IT.GE_INV_DOCUMENTOS.nro_final
  is 'Número Final del grupo de Números de Documentos.';
comment on column IT.GE_INV_DOCUMENTOS.cantidad
  is 'Cantidad de Documentos.';
comment on column IT.GE_INV_DOCUMENTOS.estado
  is 'Estado de Grupo de Números de Documentos.';
comment on column IT.GE_INV_DOCUMENTOS.est_documentos
  is 'Valores concatenados correspondientes al estado de cada número de documento.';
comment on column IT.GE_INV_DOCUMENTOS.observacion
  is 'Observación.';
comment on column IT.GE_INV_DOCUMENTOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_INV_DOCUMENTOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_INV_DOCUMENTOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_INV_DOCUMENTOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.GE_INV_DOCUMENTOS
  add constraint PK_GE_INV_DOCUMENTOS primary key (NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_INV_DOCUMENTOS
  add constraint UK_GIDOC_NRO_LOTE unique (TIPO, NRO_LOTE, NRO_INICIAL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_INV_DOCUMENTOS
  add constraint FK_GIDOC_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);

