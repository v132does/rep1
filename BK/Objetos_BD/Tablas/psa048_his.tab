create table IT.PSA048_HIS
(
  psa048_hispai NUMBER(3) not null,
  psa048_histdo NUMBER(4) not null,
  psa048_hisndo VARCHAR2(25) not null,
  psa048_hismpr NUMBER(5) not null,
  psa048_hisopr NUMBER(3) not null,
  psa048_hisipr NUMBER(18,2),
  psa048_hisdt1 VARCHAR2(8),
  psa048_hisdt2 VARCHAR2(8),
  psa048_hisdt3 VARCHAR2(8),
  psa048_hisno1 NUMBER(18,2),
  psa048_hisno2 NUMBER(18,2),
  psa048_hisno3 NUMBER(18,2),
  psa048_hisch1 VARCHAR2(100),
  psa048_hisch2 VARCHAR2(100),
  psa048_hisch3 VARCHAR2(100)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PSA048_HIS
  is 'Tabla Clientes Scoring masivo';
comment on column IT.PSA048_HIS.psa048_hispai
  is 'CODIGO PAIS DEL DOCUMENTO';
comment on column IT.PSA048_HIS.psa048_histdo
  is 'CODIGO TIPO DE DOCUMENTO';
comment on column IT.PSA048_HIS.psa048_hisndo
  is 'NUMERO DE DOCUMENTO';
comment on column IT.PSA048_HIS.psa048_hismpr
  is 'MODULO PRODUCTO';
comment on column IT.PSA048_HIS.psa048_hisopr
  is 'TIPO OPERACIÓN PRODUCTO';
comment on column IT.PSA048_HIS.psa048_hisipr
  is 'IMPORTE PRODUCTO';
comment on column IT.PSA048_HIS.psa048_hisdt1
  is 'FECHA AUXILIAR 1';
comment on column IT.PSA048_HIS.psa048_hisdt2
  is 'FECHA AUXILIAR 2';
comment on column IT.PSA048_HIS.psa048_hisdt3
  is 'FECHA AUXILIAR 3';
comment on column IT.PSA048_HIS.psa048_hisno1
  is 'NUMERICO AUXILIAR 1';
comment on column IT.PSA048_HIS.psa048_hisno2
  is 'NUMERICO AUXILIAR 2';
comment on column IT.PSA048_HIS.psa048_hisno3
  is 'NUMERICO AUXILIAR 3';
comment on column IT.PSA048_HIS.psa048_hisch1
  is 'CARÁCTER AUXILIAR 1';
comment on column IT.PSA048_HIS.psa048_hisch2
  is 'CARÁCTER AUXILIAR 2';
comment on column IT.PSA048_HIS.psa048_hisch3
  is 'CARÁCTER AUXILIAR 3';
alter table IT.PSA048_HIS
  add constraint PK_PSA048_HIS primary key (PSA048_HISPAI, PSA048_HISTDO, PSA048_HISNDO, PSA048_HISMPR, PSA048_HISOPR)
  using index 
  tablespace IT_HIS
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

