create table IT.PR_SOL_DESTINOS
(
  nro_solicitud      NUMBER(7) not null,
  tip_des_especifico NUMBER(3) not null,
  monto              NUMBER(18,2) default 0 not null,
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_SOL_DESTINOS
  is 'Contiene los datos de los destinos del prestamo.';
comment on column IT.PR_SOL_DESTINOS.nro_solicitud
  is 'Número de propuesta.';
comment on column IT.PR_SOL_DESTINOS.tip_des_especifico
  is 'Tipo de Destino Especifico.';
comment on column IT.PR_SOL_DESTINOS.monto
  is 'Monto Destinado.';
comment on column IT.PR_SOL_DESTINOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_SOL_DESTINOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_SOL_DESTINOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_SOL_DESTINOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_PSDES_NRO_SOLICITUD on IT.PR_SOL_DESTINOS (NRO_SOLICITUD)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_SOL_DESTINOS
  add constraint PK_PR_SOL_DESTINOS primary key (NRO_SOLICITUD, TIP_DES_ESPECIFICO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 384K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_SOL_DESTINOS
  add constraint FK_PSDES_NRO_SOLICITUD foreign key (NRO_SOLICITUD)
  references IT.PR_SOLICITUDES (NRO_SOLICITUD);

