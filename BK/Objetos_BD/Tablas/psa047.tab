create table IT.PSA047
(
  psa047pai NUMBER(3) not null,
  psa047tdo NUMBER(4) not null,
  psa047ndo VARCHAR2(25) not null,
  psa047fec VARCHAR2(8),
  psa047nom VARCHAR2(70),
  psa047tpn VARCHAR2(1),
  psa047bca NUMBER(5),
  psa047prs NUMBER(3),
  psa047vac NUMBER(18,2),
  psa047vin NUMBER(18,2),
  psa047cop NUMBER(5),
  psa047cae NUMBER(7),
  psa047cpe VARCHAR2(1),
  psa047oce VARCHAR2(1),
  psa047suc NUMBER(5),
  psa047cof NUMBER(5),
  psa047rec NUMBER(5),
  psa047ori VARCHAR2(1),
  psa047est VARCHAR2(1),
  psa047dt1 VARCHAR2(8),
  psa047dt2 VARCHAR2(8),
  psa047dt3 VARCHAR2(8),
  psa047no1 NUMBER(18,2),
  psa047no2 NUMBER(18,2),
  psa047no3 NUMBER(18,2),
  psa047ch1 VARCHAR2(100),
  psa047ch2 VARCHAR2(100),
  psa047ch3 VARCHAR2(100)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PSA047
  is 'Tabla Clientes Scoring masivo';
comment on column IT.PSA047.psa047pai
  is 'CODIGO PAIS DEL DOCUMENTO';
comment on column IT.PSA047.psa047tdo
  is 'CODIGO TIPO DE DOCUMENTO';
comment on column IT.PSA047.psa047ndo
  is 'NUMERO DE DOCUMENTO';
comment on column IT.PSA047.psa047fec
  is 'FECHA DE ALTA';
comment on column IT.PSA047.psa047nom
  is 'NOMBRE PERSONA';
comment on column IT.PSA047.psa047tpn
  is 'TIPO DE PERSONA';
comment on column IT.PSA047.psa047bca
  is 'BANCA A LA QUE PERTENECE EL CLIENTE';
comment on column IT.PSA047.psa047prs
  is 'CODIGO PAIS DE RESIDENCIA';
comment on column IT.PSA047.psa047vac
  is 'VALOR ACTIVO';
comment on column IT.PSA047.psa047vin
  is 'VALOR INGRESO';
comment on column IT.PSA047.psa047cop
  is 'CODIGO DE OCUPACION';
comment on column IT.PSA047.psa047cae
  is 'CODIGO DE ACTIVIDAD ECONOMICA';
comment on column IT.PSA047.psa047cpe
  is 'CLIENTE PEP O ES NO RESIDENTE';
comment on column IT.PSA047.psa047oce
  is 'EL CLIENTE REALIZA OPERACIONES DEL COMERCIO EXTERIOR';
comment on column IT.PSA047.psa047suc
  is 'CIUDAD-JURISDICCION-SUCURSAL';
comment on column IT.PSA047.psa047cof
  is 'ORIGEN DE FONDOS';
comment on column IT.PSA047.psa047rec
  is 'RECURSOS PARA CONSTITUCION DEL PRODUCTO';
comment on column IT.PSA047.psa047ori
  is 'ORIGEN DE DATOS';
comment on column IT.PSA047.psa047est
  is 'ESTADO';
comment on column IT.PSA047.psa047dt1
  is 'FECHA AUXILIAR 1';
comment on column IT.PSA047.psa047dt2
  is 'FECHA AUXILIAR 2';
comment on column IT.PSA047.psa047dt3
  is 'FECHA AUXILIAR 3';
comment on column IT.PSA047.psa047no1
  is 'NUMERICO AUXILIAR 1';
comment on column IT.PSA047.psa047no2
  is 'NUMERICO AUXILIAR 2';
comment on column IT.PSA047.psa047no3
  is 'NUMERICO AUXILIAR 3';
comment on column IT.PSA047.psa047ch1
  is 'CARÁCTER AUXILIAR 1';
comment on column IT.PSA047.psa047ch2
  is 'CARÁCTER AUXILIAR 2';
comment on column IT.PSA047.psa047ch3
  is 'CARÁCTER AUXILIAR 3';
alter table IT.PSA047
  add constraint PK_PSA047 primary key (PSA047PAI, PSA047TDO, PSA047NDO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

