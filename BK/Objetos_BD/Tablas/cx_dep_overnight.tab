create table IT.CX_DEP_OVERNIGHT
(
  fecha            DATE not null,
  monto            NUMBER(18,2) default 0 not null,
  val_tasa         NUMBER(20,4) default 0 not null,
  mto_interes      NUMBER(18,2) not null,
  nro_cuenta       VARCHAR2(15) not null,
  cod_moneda       VARCHAR2(3) not null,
  cod_oficina      NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CX_DEP_OVERNIGHT
  is 'Movimientos Diarios. Contiene todos los movimientos generados en el dia de Hoy, en todo el Sistema.';
comment on column IT.CX_DEP_OVERNIGHT.fecha
  is 'Fecha de la transaccion.';
comment on column IT.CX_DEP_OVERNIGHT.monto
  is 'Importe de la transaccion.';
comment on column IT.CX_DEP_OVERNIGHT.val_tasa
  is 'Importe de la tasa.';
comment on column IT.CX_DEP_OVERNIGHT.mto_interes
  is 'Importe del Interés.';
comment on column IT.CX_DEP_OVERNIGHT.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.CX_DEP_OVERNIGHT.cod_moneda
  is 'Código de moneda.';
comment on column IT.CX_DEP_OVERNIGHT.cod_oficina
  is 'Código de oficina.';
comment on column IT.CX_DEP_OVERNIGHT.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CX_DEP_OVERNIGHT.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CX_DEP_OVERNIGHT.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CX_DEP_OVERNIGHT.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_XDEOV_NRO_CUENTA on IT.CX_DEP_OVERNIGHT (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 320K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CX_DEP_OVERNIGHT
  add constraint PK_CX_DEP_OVERNIGHT primary key (FECHA, NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CX_DEP_OVERNIGHT
  add constraint FK_XDEOV_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CX_DEP_OVERNIGHT
  add constraint FK_XDEOV_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CX_DEP_OVERNIGHT
  add constraint FK_XDEOV_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.CC_CTA_BANCARIAS (NRO_CUENTA);

