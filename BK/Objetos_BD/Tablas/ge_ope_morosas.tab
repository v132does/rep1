create table IT.GE_OPE_MOROSAS
(
  nro_cuenta       VARCHAR2(15) not null,
  cod_persona      VARCHAR2(10) not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  cod_moneda       VARCHAR2(3) not null,
  cod_garantia     NUMBER(3),
  tot_deuda        NUMBER(18,2) default 0,
  tot_deu_capital  NUMBER(18,2) default 0,
  tot_deu_interes  NUMBER(18,2) default 0,
  int_mora         NUMBER(18,2) default 0,
  dia_atraso       NUMBER(5),
  estado           VARCHAR2(1),
  fec_ult_pago     DATE,
  mto_cuo_vencidas NUMBER(18,2) default 0,
  int_vencido      NUMBER(18,2) default 0,
  en_juicio        VARCHAR2(1) default 'N',
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_OPE_MOROSAS
  is 'Operaciones morosas.';
comment on column IT.GE_OPE_MOROSAS.nro_cuenta
  is 'Numero de Cuenta de la Operacion.';
comment on column IT.GE_OPE_MOROSAS.cod_persona
  is 'Codigo de Persona.';
comment on column IT.GE_OPE_MOROSAS.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_OPE_MOROSAS.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_OPE_MOROSAS.cod_moneda
  is 'Moneda de la Operacion.';
comment on column IT.GE_OPE_MOROSAS.cod_garantia
  is 'Tipo de Garantia.';
comment on column IT.GE_OPE_MOROSAS.tot_deuda
  is 'Total de la deuda, en prestamos total_capital mas interes de lo que no esta pagado todavia en sobregiros saldo_total - saldo_bloqueado - saldo_retenido, en tarjetas  saldo_a_facturar + saldo_facturado_no_vencido + saldo_financiado.';
comment on column IT.GE_OPE_MOROSAS.tot_deu_capital
  is 'Total del capital que el cliente aun no pago (prestamos),  total de la mora en tarjetas  en sobregiros.';
comment on column IT.GE_OPE_MOROSAS.tot_deu_interes
  is 'Solo para prestamos total interes que falta pagar.';
comment on column IT.GE_OPE_MOROSAS.int_mora
  is 'Monto de interes por mora.';
comment on column IT.GE_OPE_MOROSAS.dia_atraso
  is 'Dias de mora de la operacion.';
comment on column IT.GE_OPE_MOROSAS.estado
  is 'Estado de la cuenta.';
comment on column IT.GE_OPE_MOROSAS.fec_ult_pago
  is 'Fecha del ultimo pago de la operacion.';
comment on column IT.GE_OPE_MOROSAS.mto_cuo_vencidas
  is 'Solo para prestamos, monto de las cuotas vencidas.';
comment on column IT.GE_OPE_MOROSAS.int_vencido
  is 'Solo para prestamos monto del interes vencido.';
comment on column IT.GE_OPE_MOROSAS.en_juicio
  is 'En juicio (s/n).';
comment on column IT.GE_OPE_MOROSAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_OPE_MOROSAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_OPE_MOROSAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_OPE_MOROSAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_OPE_MOROSAS
  add constraint PK_GE_OPE_MOROSAS primary key (NRO_CUENTA, COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_OPE_MOROSAS
  add constraint FK_GOMOR_COD_GARANTIA foreign key (COD_GARANTIA)
  references IT.PR_GAR_TIPOS (COD_GARANTIA);
alter table IT.GE_OPE_MOROSAS
  add constraint FK_GOMOR_COD_MODALIDAD foreign key (COD_MODALIDAD, COD_MODULO)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_OPE_MOROSAS
  add constraint FK_GOMOR_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_OPE_MOROSAS
  add constraint FK_GOMOR_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_OPE_MOROSAS
  add constraint FK_GOMOR_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.GE_OPE_MOROSAS
  add constraint AVCON_1114021603_COD_G_000
  check (COD_GARANTIA BETWEEN 0 AND 999);
alter table IT.GE_OPE_MOROSAS
  add constraint AVCON_1114021603_COD_M_001
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_OPE_MOROSAS
  add constraint AVCON_1114021603_COD_M_002
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_OPE_MOROSAS
  add constraint AVCON_1114021603_EN_JU_000
  check (EN_JUICIO IN ('S', 'N'));

