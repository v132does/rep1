create table IT.IG_ENT_METAS
(
  cod_concepto     NUMBER(3) not null,
  cod_sub_concepto NUMBER(4),
  cod_periodo      NUMBER(3) not null,
  meta             NUMBER(18,2) not null,
  liquidado        VARCHAR2(1) default 'N' not null,
  logro            NUMBER(20,4),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.IG_ENT_METAS
  is 'Metas Generales de la Entidad.';
comment on column IT.IG_ENT_METAS.cod_concepto
  is 'Codigo de concepto.';
comment on column IT.IG_ENT_METAS.cod_sub_concepto
  is 'Codigo del sub-concepto.';
comment on column IT.IG_ENT_METAS.cod_periodo
  is 'Periodo fijado para la meta.';
comment on column IT.IG_ENT_METAS.meta
  is 'Monto o Porcenteje que se debe alcanzar o no superar. Si es monto esta expresado en la moneda de consolidacion.';
comment on column IT.IG_ENT_METAS.liquidado
  is 'Indica si el periodo ya fue liquidado. S/N.';
comment on column IT.IG_ENT_METAS.logro
  is 'Logro alcanzado por la entidad.';
comment on column IT.IG_ENT_METAS.usu_insercion
  is 'Usuario que inserta.';
comment on column IT.IG_ENT_METAS.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.IG_ENT_METAS.usu_modificacion
  is 'Usuario que modifica.';
comment on column IT.IG_ENT_METAS.fec_modificacion
  is 'Fecha de modificacion.';
alter table IT.IG_ENT_METAS
  add constraint UK_IG_ENT_METAS unique (COD_CONCEPTO, COD_SUB_CONCEPTO, COD_PERIODO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.IG_ENT_METAS
  add constraint FK_IEMET_COD_CONCEPTO foreign key (COD_PERIODO, COD_CONCEPTO, COD_SUB_CONCEPTO)
  references IT.IG_PAR_CONCEPTOS (COD_PERIODO, COD_CONCEPTO, COD_SUB_CONCEPTO);
alter table IT.IG_ENT_METAS
  add constraint FK_IEMET_COD_SUB_CONCEPTO foreign key (COD_CONCEPTO, COD_SUB_CONCEPTO)
  references IT.IG_SUB_CONCEPTOS (COD_CONCEPTO, COD_SUB_CONCEPTO);
alter table IT.IG_ENT_METAS
  add constraint AVCON_1180382030_COD_C_005
  check (COD_CONCEPTO BETWEEN 0 AND 999);
alter table IT.IG_ENT_METAS
  add constraint AVCON_1180382030_LIQUI_003
  check (LIQUIDADO IN ('S', 'N'));

