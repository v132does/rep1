create table IT.PSA048
(
  psa048pai NUMBER(3) not null,
  psa048tdo NUMBER(4) not null,
  psa048ndo VARCHAR2(25) not null,
  psa048mpr NUMBER(5) not null,
  psa048opr NUMBER(3) not null,
  psa048ipr NUMBER(18,2),
  psa048dt1 VARCHAR2(8),
  psa048dt2 VARCHAR2(8),
  psa048dt3 VARCHAR2(8),
  psa048no1 NUMBER(18,2),
  psa048no2 NUMBER(18,2),
  psa048no3 NUMBER(18,2),
  psa048ch1 VARCHAR2(100),
  psa048ch2 VARCHAR2(100),
  psa048ch3 VARCHAR2(100)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PSA048
  is 'Tabla Clientes Scoring masivo';
comment on column IT.PSA048.psa048pai
  is 'CODIGO PAIS DEL DOCUMENTO';
comment on column IT.PSA048.psa048tdo
  is 'CODIGO TIPO DE DOCUMENTO';
comment on column IT.PSA048.psa048ndo
  is 'NUMERO DE DOCUMENTO';
comment on column IT.PSA048.psa048mpr
  is 'MODULO PRODUCTO';
comment on column IT.PSA048.psa048opr
  is 'TIPO OPERACIÓN PRODUCTO';
comment on column IT.PSA048.psa048ipr
  is 'IMPORTE PRODUCTO';
comment on column IT.PSA048.psa048dt1
  is 'FECHA AUXILIAR 1';
comment on column IT.PSA048.psa048dt2
  is 'FECHA AUXILIAR 2';
comment on column IT.PSA048.psa048dt3
  is 'FECHA AUXILIAR 3';
comment on column IT.PSA048.psa048no1
  is 'NUMERICO AUXILIAR 1';
comment on column IT.PSA048.psa048no2
  is 'NUMERICO AUXILIAR 2';
comment on column IT.PSA048.psa048no3
  is 'NUMERICO AUXILIAR 3';
comment on column IT.PSA048.psa048ch1
  is 'CARÁCTER AUXILIAR 1';
comment on column IT.PSA048.psa048ch2
  is 'CARÁCTER AUXILIAR 2';
comment on column IT.PSA048.psa048ch3
  is 'CARÁCTER AUXILIAR 3';
alter table IT.PSA048
  add constraint PK_PSA048 primary key (PSA048PAI, PSA048TDO, PSA048NDO, PSA048MPR, PSA048OPR)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

