create table IT.WF_CIR_TAR_DETALLES
(
  cod_circuito     NUMBER(15) not null,
  cod_tarea        NUMBER(15) not null,
  cod_tar_detalle  NUMBER(3) not null,
  descripcion      VARCHAR2(60) not null,
  comentario       VARCHAR2(300),
  estado           VARCHAR2(1) default 'P' not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.WF_CIR_TAR_DETALLES
  is 'Detalles de las tareas';
comment on column IT.WF_CIR_TAR_DETALLES.cod_circuito
  is 'Codigo del tipo de circuito';
comment on column IT.WF_CIR_TAR_DETALLES.cod_tarea
  is 'Codigo de la tarea definida';
comment on column IT.WF_CIR_TAR_DETALLES.cod_tar_detalle
  is 'Codigo de la sub tarea';
comment on column IT.WF_CIR_TAR_DETALLES.descripcion
  is 'Descripcion del tipo de circuito';
comment on column IT.WF_CIR_TAR_DETALLES.comentario
  is 'Detalle de la definicion ';
comment on column IT.WF_CIR_TAR_DETALLES.estado
  is 'Estado de la sub tarea: P-Pendiente, A-Aprobado, R-Rechazado';
comment on column IT.WF_CIR_TAR_DETALLES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.WF_CIR_TAR_DETALLES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.WF_CIR_TAR_DETALLES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.WF_CIR_TAR_DETALLES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.WF_CIR_TAR_DETALLES
  add constraint PK_WF_CIR_TAR_DETALLES primary key (COD_CIRCUITO, COD_TAREA, COD_TAR_DETALLE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

