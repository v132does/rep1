create table IT.BW_PERFILES
(
  cod_perfil       VARCHAR2(20) not null,
  descripcion      VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default USER not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default USER not null,
  fec_modificacion DATE default SYSDATE not null,
  afe_per_fisica   VARCHAR2(1) default 'N' not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_PERFILES
  is 'Perfiles de Acceso a las Transacciones.';
comment on column IT.BW_PERFILES.cod_perfil
  is 'Código de Perfil.';
comment on column IT.BW_PERFILES.descripcion
  is 'Descripción del Perfil.';
comment on column IT.BW_PERFILES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.BW_PERFILES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.BW_PERFILES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.BW_PERFILES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.BW_PERFILES.afe_per_fisica
  is 'Indica si el perfil es aplicable a las personas físicas.';
alter table IT.BW_PERFILES
  add constraint PK_BW_PERFILES primary key (COD_PERFIL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

