create table IT.PARAMETROS
(
  pathroot  VARCHAR2(30),
  anomes    VARCHAR2(30),
  limerror  VARCHAR2(30),
  nminforme VARCHAR2(30),
  cdentid   VARCHAR2(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 8K
    minextents 1
    maxextents unlimited
  );

