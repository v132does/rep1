create index IT.IN_PGARA_ESTADO on IT.PR_GARANTIAS (ESTADO, FEC_CONFIRMACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_PGARA_TIPO on IT.PR_GARANTIAS (TIPO, IND_UTI_TERCERO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.PR_GARANTIAS
  add constraint PK_PR_GARANTIAS primary key (NRO_GARANTIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_GARANTIAS
  add constraint FK_PGARA_COD_CAU_SALIDA foreign key (COD_CAU_SALIDA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.PR_GARANTIAS
  add constraint FK_PGARA_COD_ENT_ESCRIBANIA foreign key (COD_ENT_ESCRIBANIA)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.PR_GARANTIAS
  add constraint FK_PGARA_COD_ENT_SEGURO foreign key (COD_ENT_SEGURO)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.PR_GARANTIAS
  add constraint FK_PGARA_COD_GARANTIA foreign key (COD_GARANTIA)
  references IT.PR_GAR_TIPOS (COD_GARANTIA);
alter table IT.PR_GARANTIAS
  add constraint FK_PGARA_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_GARANTIAS
  add constraint FK_PGARA_COD_MON_TASACION foreign key (COD_MON_TASACION)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_GARANTIAS
  add constraint FK_PGARA_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.PR_GARANTIAS
  add constraint FK_PGARA_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.PR_GARANTIAS
  add constraint FK_PGARA_COD_USU_ENTREGADO foreign key (COD_USU_ENTREGADO)
  references IT.BA_USUARIOS (COD_USUARIO);
-- Create/Recreate check constraints 
alter table IT.PR_GARANTIAS
  add constraint AVCON_1080845005_ESTAD_002
  check (ESTADO IN ('A','C', 'I', 'N', 'T', 'V','R'));
alter table IT.PR_GARANTIAS
  add constraint AVCON_1080845005_TIPO_003
  check (TIPO IN ('A', 'C'));
-- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.PR_GARANTIAS to IT_TEMPORAL;
