create table IT.BA_RAMOS
(
  cod_ramo         NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_RAMOS
  is 'Ramos.';
comment on column IT.BA_RAMOS.cod_ramo
  is 'Codigo de Ramo.';
comment on column IT.BA_RAMOS.descripcion
  is 'Descripcion.';
comment on column IT.BA_RAMOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_RAMOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_RAMOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_RAMOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BA_RAMOS
  add constraint PK_BA_RAMOS primary key (COD_RAMO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_RAMOS
  add constraint AVCON_1080842839_COD_R_000
  check (COD_RAMO BETWEEN 1 AND 999);

