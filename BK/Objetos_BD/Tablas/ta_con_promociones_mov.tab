create table IT.TA_CON_PROMOCIONES_MOV
(
  nro_convenio         NUMBER(6),
  concepto             VARCHAR2(60),
  fec_proceso          DATE,
  afinidad             VARCHAR2(6),
  nro_tarjeta          VARCHAR2(25),
  comercio             VARCHAR2(60),
  fec_operacion        DATE,
  mto_compra           NUMBER(18,2),
  mto_descuento        NUMBER(18,2),
  promocion            VARCHAR2(60),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  procesado            VARCHAR2(1) default 'N',
  cod_usuario          VARCHAR2(10) not null,
  fecha                DATE not null,
  nro_cta_deb_comercio VARCHAR2(15),
  cod_rub_deb_entidad  VARCHAR2(15),
  error                VARCHAR2(4000),
  ind_reproceso        VARCHAR2(1) default 'N'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_CON_PROMOCIONES_MOV.nro_convenio
  is 'Número de Convenio.';
comment on column IT.TA_CON_PROMOCIONES_MOV.concepto
  is 'Descripción del Convenio.';
comment on column IT.TA_CON_PROMOCIONES_MOV.fec_proceso
  is 'Fecha de proceso original.';
comment on column IT.TA_CON_PROMOCIONES_MOV.afinidad
  is 'Afinidad de la Tarjeta.';
comment on column IT.TA_CON_PROMOCIONES_MOV.nro_tarjeta
  is 'Numero de la Tarjeta.';
comment on column IT.TA_CON_PROMOCIONES_MOV.comercio
  is 'Descripción del Comercio.';
comment on column IT.TA_CON_PROMOCIONES_MOV.fec_operacion
  is 'Fecha de Operación.';
comment on column IT.TA_CON_PROMOCIONES_MOV.mto_compra
  is 'Monto de la Compra.';
comment on column IT.TA_CON_PROMOCIONES_MOV.mto_descuento
  is 'Monto del Descuento otorgado.';
comment on column IT.TA_CON_PROMOCIONES_MOV.promocion
  is 'Descripcion de la Promoción.';
comment on column IT.TA_CON_PROMOCIONES_MOV.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.TA_CON_PROMOCIONES_MOV.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.TA_CON_PROMOCIONES_MOV.usu_modificacion
  is 'Usuario que realizó la última modificación.';
comment on column IT.TA_CON_PROMOCIONES_MOV.fec_modificacion
  is 'Ultima fecha en que se modificó el registro.';
comment on column IT.TA_CON_PROMOCIONES_MOV.procesado
  is 'Indicador de movimiento procesado. (S/N)';
comment on column IT.TA_CON_PROMOCIONES_MOV.cod_usuario
  is 'Usuario que procesa el movimiento.';
comment on column IT.TA_CON_PROMOCIONES_MOV.fecha
  is 'Fecha de proceso en la Entidad.';
comment on column IT.TA_CON_PROMOCIONES_MOV.nro_cta_deb_comercio
  is 'Número de Cuenta de Débito al Comercio.';
comment on column IT.TA_CON_PROMOCIONES_MOV.cod_rub_deb_entidad
  is 'Código de Rubro de Débito a la Entidad.';
comment on column IT.TA_CON_PROMOCIONES_MOV.error
  is 'Detalle del error.';
comment on column IT.TA_CON_PROMOCIONES_MOV.ind_reproceso
  is 'Indicador de Reproceso.';
create index IT.IN_TCONP_COD_USU_FEC on IT.TA_CON_PROMOCIONES_MOV (COD_USUARIO, FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCONP_CON_COMERCIO on IT.TA_CON_PROMOCIONES_MOV (CONCEPTO, COMERCIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

