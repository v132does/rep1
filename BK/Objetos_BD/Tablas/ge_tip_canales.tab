create table IT.GE_TIP_CANALES
(
  cod_tip_canal    NUMBER(3) not null,
  descripcion      VARCHAR2(60) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  activo           VARCHAR2(1) default 'N'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_TIP_CANALES
  is 'Tipos de canales de origen.';
comment on column IT.GE_TIP_CANALES.cod_tip_canal
  is 'Codigo del tipo de canal.';
comment on column IT.GE_TIP_CANALES.descripcion
  is 'Descripcion del tipo de canal.';
comment on column IT.GE_TIP_CANALES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_TIP_CANALES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_TIP_CANALES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_TIP_CANALES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_TIP_CANALES.activo
  is 'S=activo;N=inactivo.';
alter table IT.GE_TIP_CANALES
  add constraint PK_GE_TIP_CANALES primary key (COD_TIP_CANAL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_TIP_CANALES
  add constraint AVCON_1088554123_COD_T_000
  check (COD_TIP_CANAL BETWEEN 0 AND 999);

