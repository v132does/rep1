create table IT.SIMGIA_TCC_LIN_SOBREGIROS
(
  cod_usu_autoriza VARCHAR2(10),
  nro_cuenta       VARCHAR2(15),
  fec_vencimiento  DATE not null,
  cod_tasa         NUMBER(3),
  val_tas_interes  NUMBER(20,4),
  dia_tasa         NUMBER(3),
  tas_preferencial NUMBER(8,2),
  dia_sin_costo    NUMBER(3),
  nro_linea        NUMBER(7),
  usu_insercion    VARCHAR2(10) not null,
  fec_insercion    DATE not null,
  usu_modificacion VARCHAR2(10) not null,
  fec_modificacion DATE not null,
  fec_inicio       DATE not null,
  nro_secuencia    NUMBER(7) not null,
  monto            NUMBER(18,2) not null,
  tipo             VARCHAR2(1) not null,
  cod_persona      VARCHAR2(10),
  cod_moneda       VARCHAR2(3),
  estado           VARCHAR2(1),
  nro_sec_padre    NUMBER(7),
  observacion      VARCHAR2(1000),
  niv_aprobacion   VARCHAR2(3),
  cotizacion       NUMBER(14,8),
  observacion_his  VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

