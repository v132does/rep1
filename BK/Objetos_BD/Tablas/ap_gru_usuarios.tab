create table IT.AP_GRU_USUARIOS
(
  cod_usuario      VARCHAR2(10) not null,
  cod_grupo        NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AP_GRU_USUARIOS
  is 'Usuarios por Grupos.';
comment on column IT.AP_GRU_USUARIOS.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.AP_GRU_USUARIOS.cod_grupo
  is 'Codigo del Grupo.';
comment on column IT.AP_GRU_USUARIOS.usu_insercion
  is 'Usuario de insercion.';
comment on column IT.AP_GRU_USUARIOS.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.AP_GRU_USUARIOS.usu_modificacion
  is 'Usuario de modificacion.';
comment on column IT.AP_GRU_USUARIOS.fec_modificacion
  is 'Fecha de modificacion.';
create index IT.IN_YGUSU_COD_USUARIO on IT.AP_GRU_USUARIOS (COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AP_GRU_USUARIOS
  add constraint PK_AP_GRU_USUARIOS primary key (COD_GRUPO, COD_USUARIO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AP_GRU_USUARIOS
  add constraint UK_YGUSU_COD_USUARIO unique (COD_USUARIO);
alter table IT.AP_GRU_USUARIOS
  add constraint FK_YGUSU_COD_GRUPO foreign key (COD_GRUPO)
  references IT.AP_GRUPOS (COD_GRUPO);
alter table IT.AP_GRU_USUARIOS
  add constraint FK_YGUSU_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.AP_GRU_USUARIOS
  add constraint AVCON_1081349332_COD_G_002
  check (COD_GRUPO BETWEEN 1 AND 999);

