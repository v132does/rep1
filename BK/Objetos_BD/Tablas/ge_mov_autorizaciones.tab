create table IT.GE_MOV_AUTORIZACIONES
(
  nro_pedido          NUMBER(10) not null,
  fecha               DATE not null,
  hora                VARCHAR2(8) not null,
  cod_usuario         VARCHAR2(10) not null,
  cod_tra_padre       NUMBER(4) not null,
  cod_mod_padre       NUMBER(3) not null,
  cod_mad_padre       NUMBER(3) not null,
  nro_cuenta          VARCHAR2(15),
  cod_persona         VARCHAR2(10),
  mto_mon_fuerte      NUMBER(18,2) not null,
  tip_operacion       VARCHAR2(10) default 'O' not null,
  nro_documento       NUMBER(15),
  cod_usu_autorizador VARCHAR2(10),
  concepto            VARCHAR2(100),
  estado              VARCHAR2(1) not null,
  est_movimiento      VARCHAR2(1),
  est_cuenta          VARCHAR2(1),
  observacion         VARCHAR2(1000),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  cod_oficina         NUMBER(3),
  monto               NUMBER(18,2),
  cod_moneda          VARCHAR2(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_MOV_AUTORIZACIONES
  is 'Autorizaciones de pedidos del Sistema. Contiene todas las autorizaciones de pedidos ON-LINE o previas realizadas en el Sistema.';
comment on column IT.GE_MOV_AUTORIZACIONES.nro_pedido
  is 'Número de Pedido de Autorización.';
comment on column IT.GE_MOV_AUTORIZACIONES.fecha
  is 'Fecha.';
comment on column IT.GE_MOV_AUTORIZACIONES.hora
  is 'Hora.';
comment on column IT.GE_MOV_AUTORIZACIONES.cod_usuario
  is 'Código de operador.';
comment on column IT.GE_MOV_AUTORIZACIONES.cod_tra_padre
  is 'Código de transaccion padre.';
comment on column IT.GE_MOV_AUTORIZACIONES.cod_mod_padre
  is 'Código de modulo padre.';
comment on column IT.GE_MOV_AUTORIZACIONES.cod_mad_padre
  is 'Código de modalidad padre.';
comment on column IT.GE_MOV_AUTORIZACIONES.nro_cuenta
  is 'Número de Cuenta para la que se solicita la Autorización.';
comment on column IT.GE_MOV_AUTORIZACIONES.cod_persona
  is 'Código del Titular Principal de la Cuenta.';
comment on column IT.GE_MOV_AUTORIZACIONES.mto_mon_fuerte
  is 'Monto en moneda fuerte de la operación.';
comment on column IT.GE_MOV_AUTORIZACIONES.tip_operacion
  is 'O/Operaciones de Riesgo Operativo, R/Pago o Cancelación contra cuentas contables.';
comment on column IT.GE_MOV_AUTORIZACIONES.nro_documento
  is 'Número de Documento.';
comment on column IT.GE_MOV_AUTORIZACIONES.cod_usu_autorizador
  is 'Código de autorizador.';
comment on column IT.GE_MOV_AUTORIZACIONES.concepto
  is 'Comentario para la Reversión.';
comment on column IT.GE_MOV_AUTORIZACIONES.estado
  is 'Estado del pedido (S=Solicitado, A=Aprobado, R=Rechazado, C=Cancelado).';
comment on column IT.GE_MOV_AUTORIZACIONES.est_movimiento
  is 'Estado del Movimiento';
comment on column IT.GE_MOV_AUTORIZACIONES.est_cuenta
  is 'Estado de la Cuenta';
comment on column IT.GE_MOV_AUTORIZACIONES.observacion
  is 'Observación.';
comment on column IT.GE_MOV_AUTORIZACIONES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_MOV_AUTORIZACIONES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_MOV_AUTORIZACIONES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_MOV_AUTORIZACIONES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.GE_MOV_AUTORIZACIONES.cod_oficina
  is 'Oficina del Usuario Solicitante';
comment on column IT.GE_MOV_AUTORIZACIONES.monto
  is 'Monto Original de la Transacción';
comment on column IT.GE_MOV_AUTORIZACIONES.cod_moneda
  is 'Código de Moneda de la Operación';
create index IT.BBVA_MOV_AUTO_COD_AUTO on IT.GE_MOV_AUTORIZACIONES (COD_USU_AUTORIZADOR)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.BBVA_MOV_AUTO_COD_PER on IT.GE_MOV_AUTORIZACIONES (COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_MOV_AUTORIZACIONES
  add constraint PK_GE_MOV_AUTORIZACIONES primary key (NRO_PEDIDO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_MOV_AUTORIZACIONES
  add constraint FK_GMAUT_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_MOV_AUTORIZACIONES
  add constraint FK_GMAUT_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_MOV_AUTORIZACIONES
  add constraint FK_GMAUT_COD_USU_AUTORIZADOR foreign key (COD_USU_AUTORIZADOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_MOV_AUTORIZACIONES
  add constraint AVCON_1097710823_ESTAD_001
  check (ESTADO IN ('S', 'C', 'A','R'));

