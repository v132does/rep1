create table IT.CB_RG_90
(
  tipo_registro        NUMBER(1) not null,
  cod_tip_documento    NUMBER(3),
  nro_identificador    VARCHAR2(20) not null,
  raz_social           VARCHAR2(120),
  cod_tipo_comprobante VARCHAR2(4000),
  fecha_emision        DATE,
  nro_timbrado         VARCHAR2(20) not null,
  nro_comprobante      VARCHAR2(20) not null,
  monto_gravado_10     NUMBER,
  monto_gravado_5      NUMBER,
  monto_exento         NUMBER,
  monto_total          NUMBER,
  condicion            VARCHAR2(1),
  moneda_extranjera    VARCHAR2(1),
  imputa_iva           VARCHAR2(1),
  imputa_ire           VARCHAR2(1),
  imputa_irp_rsp       VARCHAR2(1),
  no_imputa            VARCHAR2(1),
  factura_asociada     VARCHAR2(20),
  timbrado_asociado    VARCHAR2(20),
  fec_proceso          DATE,
  periodo              VARCHAR2(7),
  generado             VARCHAR2(1) default 'N',
  usu_insercion        VARCHAR2(10) default user,
  fec_insercion        DATE default sysdate,
  usu_modificacion     VARCHAR2(10) default user,
  fec_modificacion     DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_RG_90
  add constraint PK_CB_RG_90 primary key (TIPO_REGISTRO, NRO_IDENTIFICADOR, NRO_TIMBRADO, NRO_COMPROBANTE)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

