create table IT.GE_CAN_OPE_ATM_MES
(
  nro_cuenta          VARCHAR2(15) not null,
  cod_gru_transaccion NUMBER(3) not null,
  cantidad            NUMBER(6) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CAN_OPE_ATM_MES
  is 'Cantidad de Operaciones del mes por Cuenta y Grupo de Transacción';
comment on column IT.GE_CAN_OPE_ATM_MES.nro_cuenta
  is 'Numero de Cuenta';
comment on column IT.GE_CAN_OPE_ATM_MES.cod_gru_transaccion
  is 'Codigo de grupo de Transaccion';
comment on column IT.GE_CAN_OPE_ATM_MES.cantidad
  is 'Cantidad de Operaciones';
comment on column IT.GE_CAN_OPE_ATM_MES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CAN_OPE_ATM_MES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CAN_OPE_ATM_MES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CAN_OPE_ATM_MES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_CAN_OPE_ATM_MES
  add constraint PK_GE_CAN_OPE_ATM_MES primary key (NRO_CUENTA, COD_GRU_TRANSACCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CAN_OPE_ATM_MES
  add constraint FK_GCANOPE_COD_GRU_TRA foreign key (COD_GRU_TRANSACCION)
  references IT.GE_GRU_TRANSACCIONES (COD_GRU_TRANSACCION);
alter table IT.GE_CAN_OPE_ATM_MES
  add constraint FK_GCANOPE_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

