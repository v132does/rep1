create table IT.SB_CRC_ACT_PER_VIN_DET
(
  fecha           DATE not null,
  nom_referencia  VARCHAR2(10) not null,
  nro_formulario  VARCHAR2(3),
  cod_oficina     NUMBER(3),
  tip_operacion   NUMBER(3),
  cta_con_capital VARCHAR2(18),
  nro_operacion   VARCHAR2(60),
  tip_documento   VARCHAR2(3),
  nro_documento   VARCHAR2(30),
  fec_nacimiento  DATE,
  nombres         VARCHAR2(255),
  apellidos       VARCHAR2(100),
  tip_vinculo     NUMBER(3),
  per_vinculada   VARCHAR2(1),
  nro_registro    NUMBER(9) not null,
  cod_mon_iso     VARCHAR2(3),
  cod_persona     VARCHAR2(10),
  cod_modulo      NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_CRC_ACT_PER_VIN_DET
  is 'Datos de Vínculos /Relaciones utilizados para la Generación del Archivo de Vínculos para envío a CRC.';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.fecha
  is 'Fecha de Periodo de envío del Archivo (Formato: AAAAMMDD)';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.nom_referencia
  is 'Nombre del Archivo a generarse a la CRC (Archivo VINCULOS).';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.nro_formulario
  is 'Nro. de Formulario correspondiente al Archivo de Vinculos. Este nro. es fijo para identificar dicho Archivo.';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.cod_oficina
  is 'Código de Oficina del Cliente (Vínculo: Deudor, Codeudor, Garante).';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.tip_operacion
  is 'Tipo de Operación perteneciente a la Cuenta (posición 6 al 8 del Rubro Contable de Tipo Capital).';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.cta_con_capital
  is 'Cuenta Contable Capital de la Cuenta. ';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.nro_operacion
  is 'Nro. de Cuenta de la Operación.';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.tip_documento
  is 'Tipo de Documento de la Persona (CI=Cedula de Identidad / CRC=Código de Persona no residente / CRP=Carné de Residencia Permanente / RUC=Regsitro Unico Contribuyente).';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.nro_documento
  is 'Nro. de Documento de la Persona Vinculada.';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.fec_nacimiento
  is 'Fecha de nacimiento de la Persona Vinculada (Formato: AAAAMMDD).';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.nombres
  is 'Primer y Segundo Nombre de la Persona Vinculada.';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.apellidos
  is 'Primer y Segundo Apellido de la Persona Vinculada.';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.tip_vinculo
  is 'Tipo de Vínculo: 1 Deudor, 2 Codeudor, 4 Garante, 5 Cogarante.';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.per_vinculada
  is 'Persona Vinculada al Grupo Económico de la Entidad. (Valores posibles: S/N).';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.nro_registro
  is 'Nro. de Registro único.';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.cod_mon_iso
  is 'Código de Moneda de la Operación.';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.cod_persona
  is 'Código de Persona vinculada a la Cuenta Informada(Deudor / Codeudor / Garante / Firmante,  etc.).';
comment on column IT.SB_CRC_ACT_PER_VIN_DET.cod_modulo
  is 'Código del Módulo de la Cuenta.';
create index IT.IN_SCVDE_COD_PER2 on IT.SB_CRC_ACT_PER_VIN_DET (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SB_CRC_ACT_PER_VIN_DET
  add constraint PK_SB_CRC_ACT_PER_VIN_DET primary key (FECHA, NOM_REFERENCIA, NRO_REGISTRO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

