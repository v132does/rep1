CREATE TABLE IT.GE_CLA_PASOS_SIMULACION (
  ID_PASO           NUMBER PRIMARY KEY,  
  ORDEN             NUMBER NOT NULL,
  CODIGO_INTERNO    VARCHAR2(40) NOT NULL,
  DESCRIPCION       VARCHAR2(100),
  EJECUTAR          CHAR(1) NOT NULL,  
  FECHA_CREACION    DATE,
  USUARIO_CREACION  VARCHAR2(50)
);

-- Constraint separada para valores válidos de EJECUTAR
ALTER TABLE IT.GE_CLA_PASOS_SIMULACION
  ADD CONSTRAINT CK_GECLA_PASOS_EJECUTAR CHECK (EJECUTAR IN ('S','N'));

-- Comentarios descriptivos
COMMENT ON TABLE IT.GE_CLA_PASOS_SIMULACION IS 'Tabla de configuración de pasos ejecutables por el orquestador de simulación.';

COMMENT ON COLUMN IT.GE_CLA_PASOS_SIMULACION.ID_PASO IS 'Identificador único del paso. Clave primaria.';
COMMENT ON COLUMN IT.GE_CLA_PASOS_SIMULACION.ORDEN IS 'Orden de ejecución del paso en el orquestador.';
COMMENT ON COLUMN IT.GE_CLA_PASOS_SIMULACION.CODIGO_INTERNO IS 'Código identificador interno del paso (referenciado desde el procedimiento).';
COMMENT ON COLUMN IT.GE_CLA_PASOS_SIMULACION.DESCRIPCION IS 'Descripción legible del paso.';
COMMENT ON COLUMN IT.GE_CLA_PASOS_SIMULACION.EJECUTAR IS 'Indica si el paso debe ejecutarse: S = Sí, N = No.';
COMMENT ON COLUMN IT.GE_CLA_PASOS_SIMULACION.FECHA_CREACION IS 'Fecha de creación del registro.';
COMMENT ON COLUMN IT.GE_CLA_PASOS_SIMULACION.USUARIO_CREACION IS 'Usuario que creó el registro.';

CREATE PUBLIC SYNONYM GE_CLA_PASOS_SIMULACION FOR IT.GE_CLA_PASOS_SIMULACION;
GRANT ALTER, DELETE, INSERT, UPDATE, SELECT ON IT.GE_CLA_PASOS_SIMULACION TO IT_TEMPORAL;
