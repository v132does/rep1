create table IT.GE_TAS_SOLICITADAS
(
  nro_sol_tasa      NUMBER(7) not null,
  estado            VARCHAR2(1) not null,
  tipo              VARCHAR2(1) not null,
  cod_tasa          NUMBER(3),
  fec_vigencia      DATE,
  cod_oficina       NUMBER(3),
  cod_moneda        VARCHAR2(3),
  cod_modulo        NUMBER(3),
  cod_modalidad     NUMBER(3),
  cod_sub_modalidad NUMBER(3),
  cod_transaccion   NUMBER(4),
  nro_cuenta        VARCHAR2(15),
  cod_persona       VARCHAR2(10),
  val_maximo        NUMBER(18,2),
  val_minimo        NUMBER(18,2),
  val_hasta         NUMBER(18,2) default 0 not null,
  val_tasa          NUMBER(20,4),
  val_base          NUMBER(18,2) default 0,
  val_extension     NUMBER(20,4),
  aplicar           VARCHAR2(2),
  no_actualizable   VARCHAR2(1),
  tip_iva           VARCHAR2(2),
  fec_vencimiento   DATE,
  observaciones     VARCHAR2(100),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_TAS_SOLICITADAS
  is 'Tasas Personalizadas Solicitadas.';
comment on column IT.GE_TAS_SOLICITADAS.nro_sol_tasa
  is 'Numero de Solicitud de la Tasa Personalizada.';
comment on column IT.GE_TAS_SOLICITADAS.estado
  is 'Estado de la solicitud: P/Pendiente, A/Aprobado, R/Rechazado, C/Cancelado';
comment on column IT.GE_TAS_SOLICITADAS.tipo
  is 'Tipo de Tasa: F/Fecha, R/Rango, P/Transaccion Prohibida';
comment on column IT.GE_TAS_SOLICITADAS.cod_tasa
  is 'Codigo de tasa.';
comment on column IT.GE_TAS_SOLICITADAS.fec_vigencia
  is 'Fecha de vigencia de la tasa.';
comment on column IT.GE_TAS_SOLICITADAS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.GE_TAS_SOLICITADAS.cod_moneda
  is 'Moneda.';
comment on column IT.GE_TAS_SOLICITADAS.cod_modulo
  is 'Codigo de Modulo.';
comment on column IT.GE_TAS_SOLICITADAS.cod_modalidad
  is 'Codigo de Modalidad.';
comment on column IT.GE_TAS_SOLICITADAS.cod_sub_modalidad
  is 'Codigo de Sub Modalidad';
comment on column IT.GE_TAS_SOLICITADAS.cod_transaccion
  is 'Codigo de Transaccion Prohibida';
comment on column IT.GE_TAS_SOLICITADAS.nro_cuenta
  is 'Numero de cuenta a ser personalizada.';
comment on column IT.GE_TAS_SOLICITADAS.cod_persona
  is 'Codigo de la persona cuya tasa sera personalizada.';
comment on column IT.GE_TAS_SOLICITADAS.val_maximo
  is 'Valor maximo.';
comment on column IT.GE_TAS_SOLICITADAS.val_minimo
  is 'Valor minimo.';
comment on column IT.GE_TAS_SOLICITADAS.val_hasta
  is 'Valor Hasta.';
comment on column IT.GE_TAS_SOLICITADAS.val_tasa
  is 'Valor de la Tasa.';
comment on column IT.GE_TAS_SOLICITADAS.val_base
  is 'Valor base.';
comment on column IT.GE_TAS_SOLICITADAS.val_extension
  is 'Valor de extension o Spread.';
comment on column IT.GE_TAS_SOLICITADAS.aplicar
  is 'Aplicar.';
comment on column IT.GE_TAS_SOLICITADAS.no_actualizable
  is 'Indicador de Tasa no Actualizable por el proceso que calculo las tasas por moneda diferentes a la base.';
comment on column IT.GE_TAS_SOLICITADAS.tip_iva
  is 'Tipo de IVA o Responsabilidad ante el Fisco.';
comment on column IT.GE_TAS_SOLICITADAS.fec_vencimiento
  is 'Fecha de Vencimiento.';
comment on column IT.GE_TAS_SOLICITADAS.observaciones
  is 'Observaciones.';
comment on column IT.GE_TAS_SOLICITADAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_TAS_SOLICITADAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_TAS_SOLICITADAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_TAS_SOLICITADAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_GTSOL_COD_PERSONA on IT.GE_TAS_SOLICITADAS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 192K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GTSOL_NRO_CUENTA on IT.GE_TAS_SOLICITADAS (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 192K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_TAS_SOLICITADAS
  add constraint PK_NRO_SOL_TASA primary key (NRO_SOL_TASA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_TAS_SOLICITADAS
  add constraint FK_GTSOL_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_TAS_SOLICITADAS
  add constraint FK_GTSOL_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_TAS_SOLICITADAS
  add constraint FK_GTSOL_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_TAS_SOLICITADAS
  add constraint FK_GTSOL_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.GE_TAS_SOLICITADAS
  add constraint FK_GTSOL_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_TAS_SOLICITADAS
  add constraint CK_GTSOL_CTA_PERSONA
  check (nro_cuenta is not null or cod_persona is not null);
alter table IT.GE_TAS_SOLICITADAS
  add constraint CK_GTSOL_DESCUENTO
  check (
         (val_tasa is not null and val_extension is null and val_minimo is null and val_maximo is null)
      or (val_tasa is null and val_extension is not null and val_minimo is null and val_maximo is null)
      or (val_tasa is null and val_extension is null and (val_minimo is not null or val_maximo is not null))
      or (cod_modulo is not null and cod_modalidad is not null and cod_transaccion is not null)
        );
alter table IT.GE_TAS_SOLICITADAS
  add constraint CK_GTSOL_FEC_VENCIMIENTO
  check (fec_vencimiento is not null and (nro_cuenta is not null or cod_persona is not null) or
           (nro_cuenta is null and cod_persona is null));

