CREATE TABLE IT.CB_ASI_DET_TMP (
	FECHA				DATE,
	NRO_ASIENTO			NUMBER,
	REF_MOVIMIENTO		VARCHAR2(20),
	COD_RUBRO			VARCHAR2(100),
	DESCRIPCION			VARCHAR2(500),
	COD_TRA_PADRE		NUMBER,
    TIP_MOVIMIENTO      VARCHAR2(1),
	VAL_COTIZACION		NUMBER,
	DOLARES				NUMBER,
	GUARANIES			NUMBER
) TABLESPACE IT_DATA;