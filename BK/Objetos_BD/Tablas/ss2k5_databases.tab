create global temporary table IT.SS2K5_DATABASES
(
  db_id       NUMBER(10),
  name        VARCHAR2(256) not null,
  database_id NUMBER(10)
)
on commit preserve rows;
create index IT.SS2K5_DATABASES_DATABASE_ID on IT.SS2K5_DATABASES (DATABASE_ID);
create index IT.SS2K5_DATABASES_DB_ID on IT.SS2K5_DATABASES (DB_ID);
create index IT.SS2K5_DATABASES_NAME on IT.SS2K5_DATABASES (NAME);

