create table IT.GE_DEB_PENDIENTES
(
  nro_cuenta       VARCHAR2(15) not null,
  fecha            DATE not null,
  mto_cargo        NUMBER(18,2),
  mto_impuesto     NUMBER(18,2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_DEB_PENDIENTES
  is 'Debitos pendientes...';
comment on column IT.GE_DEB_PENDIENTES.nro_cuenta
  is 'Nro de Cuenta.';
comment on column IT.GE_DEB_PENDIENTES.fecha
  is 'Fecha en que intento.';
comment on column IT.GE_DEB_PENDIENTES.mto_cargo
  is 'Monto del Cargo.';
comment on column IT.GE_DEB_PENDIENTES.mto_impuesto
  is 'Monto del impuesto.';
comment on column IT.GE_DEB_PENDIENTES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_DEB_PENDIENTES.fec_insercion
  is 'Fecha de insercion del registro.';
comment on column IT.GE_DEB_PENDIENTES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion del registro.';
comment on column IT.GE_DEB_PENDIENTES.fec_modificacion
  is 'Fecha de ultima modificacion del registro.';
alter table IT.GE_DEB_PENDIENTES
  add constraint PK_GE_DEB_PENDIENTES primary key (NRO_CUENTA, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

