alter table IT.AH_RETENCIONES
  add constraint PK_AH_RETENCIONES primary key (NRO_CUENTA, NRO_DOCUMENTO, COD_RETENCION, FEC_FINAL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 576K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AH_RETENCIONES
  add constraint FK_ARETEN_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.AH_RETENCIONES
  add constraint FK_ARETEN_COD_OFICINA foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.AH_RETENCIONES
  add constraint FK_ARETEN_COD_RETENCION foreign key (COD_RETENCION)
  references IT.GE_RETENCIONES (COD_RETENCION);
alter table IT.AH_RETENCIONES
  add constraint FK_ARETEN_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.AH_RETENCIONES
  add constraint AVCON_1083334408_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.AH_RETENCIONES
  add constraint AVCON_1083334408_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.AH_RETENCIONES
  add constraint AVCON_1083334408_COD_O_000
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.AH_RETENCIONES
  add constraint AVCON_1083334408_COD_O_001
  check (COD_OFI_ORIGEN BETWEEN 0 AND 999);
alter table IT.AH_RETENCIONES
  add constraint AVCON_1083334408_COD_R_000
  check (COD_RETENCION BETWEEN 0 AND 999);
alter table IT.AH_RETENCIONES
  add constraint AVCON_1083334408_DETAL_000
  check (DETALLADO IN ('S', 'N'));
alter table IT.AH_RETENCIONES
  add constraint AVCON_1083334408_LIBER_000
  check (LIBERADO IN ('S', 'N'));
alter table IT.AH_RETENCIONES
  add constraint AVCON_1083334408_LIB_P_000
  check (LIB_POSTERIOR IN ('S', 'N'));

