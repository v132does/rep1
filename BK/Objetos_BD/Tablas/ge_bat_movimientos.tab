create table IT.GE_BAT_MOVIMIENTOS
(
  fecha            DATE not null,
  hora             VARCHAR2(8) not null,
  cod_usuario      VARCHAR2(10) not null,
  nro_secuencia    NUMBER(3) not null,
  monto            NUMBER(18,2) default 0,
  nro_cuenta       VARCHAR2(15),
  cod_moneda       VARCHAR2(3) not null,
  cod_oficina      NUMBER(3),
  cod_tra_padre    NUMBER(4) not null,
  cod_mod_padre    NUMBER(3) not null,
  cod_mad_padre    NUMBER(3) not null,
  cod_transaccion  NUMBER(4),
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  nro_documento    NUMBER(15),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  est_pro_batch    VARCHAR2(1) default 'N' not null,
  tip_operacion    VARCHAR2(1) default 'C'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_BAT_MOVIMIENTOS
  is 'Contiene los movimientos de creditos a cuentas de proveedores de servicios a ser ejecutadas en batch.';
comment on column IT.GE_BAT_MOVIMIENTOS.fecha
  is 'Fecha de la transaccion.';
comment on column IT.GE_BAT_MOVIMIENTOS.hora
  is 'Hora del movimiento.';
comment on column IT.GE_BAT_MOVIMIENTOS.cod_usuario
  is 'Codigo de operador.';
comment on column IT.GE_BAT_MOVIMIENTOS.nro_secuencia
  is 'Numero de secuencia.';
comment on column IT.GE_BAT_MOVIMIENTOS.monto
  is 'Importe de la transaccion.';
comment on column IT.GE_BAT_MOVIMIENTOS.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.GE_BAT_MOVIMIENTOS.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.GE_BAT_MOVIMIENTOS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.GE_BAT_MOVIMIENTOS.cod_tra_padre
  is 'Codigo de transaccion padre.';
comment on column IT.GE_BAT_MOVIMIENTOS.cod_mod_padre
  is 'Codigo de modulo padre.';
comment on column IT.GE_BAT_MOVIMIENTOS.cod_mad_padre
  is 'Codigo de modalidad padre.';
comment on column IT.GE_BAT_MOVIMIENTOS.cod_transaccion
  is 'Codigo de transaccion hijo.';
comment on column IT.GE_BAT_MOVIMIENTOS.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_BAT_MOVIMIENTOS.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_BAT_MOVIMIENTOS.nro_documento
  is 'Numero de documento.';
comment on column IT.GE_BAT_MOVIMIENTOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_BAT_MOVIMIENTOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_BAT_MOVIMIENTOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_BAT_MOVIMIENTOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_BAT_MOVIMIENTOS.est_pro_batch
  is 'Indica el estado del proceso batch. Nuevo, Error, Procesando,Terminado';
comment on column IT.GE_BAT_MOVIMIENTOS.tip_operacion
  is 'Tipo de operacion Credito o Debito';
create index IT.IN_BMOVBATCH_FECHA_01 on IT.GE_BAT_MOVIMIENTOS (FEC_INSERCION, NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_BAT_MOVIMIENTOS
  add constraint PK_GE_BAT_MOVIMIENTOS primary key (FECHA, HORA, COD_USUARIO, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 320K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_BAT_MOVIMIENTOS
  add constraint FK_BMOVC_COD_TRA_HIJO foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_BAT_MOVIMIENTOS
  add constraint FK_BMOVC_COD_TRA_PADRE foreign key (COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_BAT_MOVIMIENTOS
  add constraint FK_BMOVC_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

