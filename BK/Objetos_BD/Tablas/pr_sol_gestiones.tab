create table IT.PR_SOL_GESTIONES
(
  nro_solicitud    NUMBER(7) not null,
  estado           VARCHAR2(1) default 'S' not null,
  fecha            DATE not null,
  cod_usuario      VARCHAR2(10) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  observacion      VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_SOL_GESTIONES
  is 'Historial de las Gestiones. Esta tabla debe generarse en forma automática cada vez que la solicitud cambia de estado.';
comment on column IT.PR_SOL_GESTIONES.nro_solicitud
  is 'Número de Solicitud.';
comment on column IT.PR_SOL_GESTIONES.estado
  is 'Código de estado.';
comment on column IT.PR_SOL_GESTIONES.fecha
  is 'Fecha en que se realizó la gestión.';
comment on column IT.PR_SOL_GESTIONES.cod_usuario
  is 'Usuario que realizó la gestión.';
comment on column IT.PR_SOL_GESTIONES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_SOL_GESTIONES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_SOL_GESTIONES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_SOL_GESTIONES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_SOL_GESTIONES.observacion
  is 'Observación sobre la gestión.';
create index IT.IN_PSGES_COD_USUARIO on IT.PR_SOL_GESTIONES (COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_PSGES_NRO_SOLICITUD on IT.PR_SOL_GESTIONES (NRO_SOLICITUD)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_SOL_GESTIONES
  add constraint FK_PSGES_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.PR_SOL_GESTIONES
  add constraint FK_PSGES_NRO_SOLICITUD foreign key (NRO_SOLICITUD)
  references IT.PR_SOLICITUDES (NRO_SOLICITUD);

