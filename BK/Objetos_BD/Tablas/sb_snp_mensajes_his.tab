create table IT.SB_SNP_MENSAJES_HIS
(
  cod_mensaje      VARCHAR2(35) not null,
  nro_referencia   VARCHAR2(20),
  nro_lote         VARCHAR2(20),
  orden            NUMBER not null,
  nro_linea        NUMBER not null,
  campo            VARCHAR2(3) not null,
  valor            VARCHAR2(250),
  descripcion      VARCHAR2(200),
  ind_requerido    VARCHAR2(1) not null,
  nro_detalle      NUMBER not null,
  err_formato      VARCHAR2(1000),
  err_validacion   VARCHAR2(1000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_SNP_MENSAJES_HIS
  is 'Contiene el detalle de los mensajes esquematizados';
comment on column IT.SB_SNP_MENSAJES_HIS.cod_mensaje
  is 'Identificador del Mensaje SWIFT.';
comment on column IT.SB_SNP_MENSAJES_HIS.nro_referencia
  is 'Numero de Referencia de la Transferencia. Ej: 213804.';
comment on column IT.SB_SNP_MENSAJES_HIS.nro_lote
  is 'Numero de Lote.';
comment on column IT.SB_SNP_MENSAJES_HIS.orden
  is 'Orden de los datos del MT a procesar.';
comment on column IT.SB_SNP_MENSAJES_HIS.nro_linea
  is 'Nro. de Linea correspondiente al Campo (Tag).';
comment on column IT.SB_SNP_MENSAJES_HIS.campo
  is 'Identificador del Campo (tag) del MT.';
comment on column IT.SB_SNP_MENSAJES_HIS.valor
  is 'Valor desparseado con formato validado.';
comment on column IT.SB_SNP_MENSAJES_HIS.descripcion
  is 'Descripción del Campo.';
comment on column IT.SB_SNP_MENSAJES_HIS.ind_requerido
  is 'Indicador de si es obligatorio o no (S/N).';
comment on column IT.SB_SNP_MENSAJES_HIS.nro_detalle
  is 'Indicador de detalle, si el campo se repite varias veces (batch). Ej. MT102 (S=Si, N=No).';
comment on column IT.SB_SNP_MENSAJES_HIS.err_formato
  is 'Errores de Validación de Formato del Campo.';
comment on column IT.SB_SNP_MENSAJES_HIS.err_validacion
  is 'Errores de validación SQL del  Dato.';
comment on column IT.SB_SNP_MENSAJES_HIS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.SB_SNP_MENSAJES_HIS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.SB_SNP_MENSAJES_HIS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.SB_SNP_MENSAJES_HIS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';

