CREATE TABLE IT.TA_PRODUCTOS (
    COD_PRODUCTO       VARCHAR2(50) NOT NULL,
    COD_SUB_PRODUCTO   VARCHAR(10) NOT NULL,
    COD_MODALIDAD      NUMBER(3,0) NOT NULL,
    AFINIDAD           VARCHAR2(10), 
    NRO_BIN            VARCHAR2(10),
    ID_PRODUCTO        VARCHAR(6) NOT NULL, 
    FEC_INSERCION      DATE DEFAULT SYSDATE NOT NULL ENABLE,
    USU_INSERCION      VARCHAR2(10) DEFAULT SUBSTR(USER,1,10) NOT NULL ENABLE,
    FEC_MODIFICACION   DATE DEFAULT SYSDATE NOT NULL ENABLE,
    USU_MODIFICACION   VARCHAR2(10) DEFAULT SUBSTR(USER,1,10) NOT NULL ENABLE,
    CONSTRAINT UQ_TPROD_PRODUCTO UNIQUE (COD_MODALIDAD, AFINIDAD, NRO_BIN,COD_PRODUCTO, COD_SUB_PRODUCTO, ID_PRODUCTO) ENABLE
)SEGMENT CREATION IMMEDIATE 
  PCTFREE 10 PCTUSED 40 INITRANS 1 MAXTRANS 255 
 NOCOMPRESS LOGGING
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "IT_DATA" ;


CREATE INDEX "IT"."IN_TPROD_CREDITO" ON "IT"."TA_PRODUCTOS" ("COD_MODALIDAD", "AFINIDAD") 
  PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "IT_DATA" ;

CREATE INDEX "IT"."IN_TPROD_DEBITO" ON "IT"."TA_PRODUCTOS" ("NRO_BIN") 
  PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "IT_DATA" ;


CREATE OR REPLACE public synonym TA_PRODUCTOS FOR IT.TA_PRODUCTOS;
GRANT SELECT ON "IT"."TA_PRODUCTOS" TO "IT_CONSULTAS";
GRANT UPDATE ON "IT"."TA_PRODUCTOS" TO "IT_TEMPORAL";
GRANT SELECT ON "IT"."TA_PRODUCTOS" TO "IT_TEMPORAL";
GRANT INSERT ON "IT"."TA_PRODUCTOS" TO "IT_TEMPORAL";
GRANT DELETE ON "IT"."TA_PRODUCTOS" TO "IT_TEMPORAL";


