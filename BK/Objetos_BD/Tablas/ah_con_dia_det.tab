  is 'Indice que indica que esta transaccion fue procesada';
comment on column IT.AH_CON_DIA_DET.error
  is 'Registo de error en el caso que lo hubiera.';
comment on column IT.AH_CON_DIA_DET.fec_proceso
  is 'fecha de procesamiento de archivo(sysdate)';
comment on column IT.AH_CON_DIA_DET.cod_usuario
  is 'usuario';
comment on column IT.AH_CON_DIA_DET.imp_rg4815
  is 'Importe de RG4815';
comment on column IT.AH_CON_DIA_DET.sig_rg4815
  is 'Signo del Importe RG4815. Valores posibles: "-", "+"';
comment on column IT.AH_CON_DIA_DET.extracash
  is '0-NO / 1-SI';
comment on column IT.AH_CON_DIA_DET.imp_extracash
  is 'Importe Extracash';
comment on column IT.AH_CON_DIA_DET.sig_extracash
  is 'Signo del Importe Extracash. Valores posibles: "-", "+"';
comment on column IT.AH_CON_DIA_DET.tra_tokenizada
  is 'Identifica las transacciones que llegarian por una tarjeta Tokenizada opciones 0- No tokenizada, 1- Tokenizada';
comment on column IT.AH_CON_DIA_DET.tas_isa
  is 'Tasa ISA';
comment on column IT.AH_CON_DIA_DET.tra_origen
  is 'Indica el origen de la Transaccion. Local o Internacional';
comment on column IT.AH_CON_DIA_DET.imp_rg5272
  is 'Importe RG 5272';
comment on column IT.AH_CON_DIA_DET.sig_imp_rg5272
  is 'Signo del Importe RG 5272. Valores posibles: "-", "+"';
comment on column IT.AH_CON_DIA_DET.fec_transferencia
  is 'Fecha de transferencia / ID del ciclo de vida
';
comment on column IT.AH_CON_DIA_DET.ref_adquiriente
  is 'Datos de referencia del adquirente';
comment on column IT.AH_CON_DIA_DET.id_adquiriente
  is 'ID de la institución adquirente';
comment on column IT.AH_CON_DIA_DET.nro_ref_recupero
  is 'Número de referencia de recuperacion';
comment on column IT.AH_CON_DIA_DET.id_terminal
  is 'Identificacion del terminal';
comment on column IT.AH_CON_DIA_DET.nom_terminal
  is 'Nombre/localizacion del terminal
';
comment on column IT.AH_CON_DIA_DET.id_transaccion
  is 'ID del ciclo de vida de la transaccion';
comment on column IT.AH_CON_DIA_DET.token
  is 'Token';
comment on column IT.AH_CON_DIA_DET.billetera
  is 'Billetera';
comment on column IT.AH_CON_DIA_DET.per_tra_fondos
  is 'Persona que envia la Transferencia de Fondos';
-- Create/Recreate indexes 
create index IT.IN_ACONDIDET_NRO_CUENTA on IT.AH_CON_DIA_DET (NRO_CUENTA, FEC_OPERACION)
  tablespace IT_IND
  pctfree 10
  initrans 10
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_ACOTA_BIN_TARJETA on IT.AH_CON_DIA_DET (SUBSTR(NRO_TARJETA,1,6))
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_ACOTA_FEC_CLEARING on IT.AH_CON_DIA_DET (FEC_CLEARING)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_ACOTA_FEC_OPERACION on IT.AH_CON_DIA_DET (FEC_OPERACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_ACOTA_NRO_CUENTA on IT.AH_CON_DIA_DET (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_AH_CON_DIA_DET on IT.AH_CON_DIA_DET (NRO_CON_DIA, NRO_COMPROBANTE, NRO_CUENTA, FEC_OPERACION, COD_MOVIMIENTO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_ACOTA_NRO_CON_DIA on IT.AH_CON_DIA_DET (NRO_CON_DIA, FEC_PROCESO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Grant/Revoke object privileges 
grant select, insert, update, delete, alter, debug, read on IT.AH_CON_DIA_DET to IT_TEMPORAL;
