comment on column IT.AH_CON_DIA_DET.filter
  is 'Filtros/Filler';
comment on column IT.AH_CON_DIA_DET.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.AH_CON_DIA_DET.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.AH_CON_DIA_DET.usu_modificacion
  is 'Usuario que realizó la ultima modificación en el registro.';
comment on column IT.AH_CON_DIA_DET.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
