comment on column IT.AH_CON_DIA_DET.imp_iva_cuota
  is 'Importe de iva de la cuota';
comment on column IT.AH_CON_DIA_DET.imp_tot_cuota
  is 'Importe de la cuota + interes + iva';
comment on column IT.AH_CON_DIA_DET.cod_deb_cre
  is '0:Debito / 1:Credito';
comment on column IT.AH_CON_DIA_DET.tip_amortizacion
  is ' 1 : Fances promediado         2 : Americano         3: Frances Diario         4: Frances ';
comment on column IT.AH_CON_DIA_DET.tip_tarjeta
  is '1 - Banda 2 - EMV 3 - EMV + Contactless ';
comment on column IT.AH_CON_DIA_DET.tna
  is 'Tasa Nominal';
comment on column IT.AH_CON_DIA_DET.tae
  is 'Tasa Efectiva';
comment on column IT.AH_CON_DIA_DET.tai
  is 'Tasa de Intercambio';
comment on column IT.AH_CON_DIA_DET.imp_ara_emisor
  is 'Arancel emisor (Viene en el IPM  PDS146 sc 5) ';
comment on column IT.AH_CON_DIA_DET.sig_iva_arancel
  is '+ o -';
comment on column IT.AH_CON_DIA_DET.imp_iva_ara_emisor
  is 'Importe IVA Arancel emisor';
comment on column IT.AH_CON_DIA_DET.sig_iva_arancel2
  is '+ o -';
comment on column IT.AH_CON_DIA_DET.mot_mensaje
  is 'Motivo de la contrapartida. DE 25 Function code > 2000 para chargeback o segunda presentacion';
comment on column IT.AH_CON_DIA_DET.imp_compensacion
  is 'Importe de compensacion';
comment on column IT.AH_CON_DIA_DET.sig_imp_compensacion
  is '+ o -';
comment on column IT.AH_CON_DIA_DET.imp_percep
  is 'Importe de la percecpcion por el RG4240';
comment on column IT.AH_CON_DIA_DET.sig_percep
  is '+ o -';
comment on column IT.AH_CON_DIA_DET.tip_producto
  is 'Tipo de Producto';
comment on column IT.AH_CON_DIA_DET.fec_cie_comercios
  is 'Fecha de cierre de comercios';
comment on column IT.AH_CON_DIA_DET.plan
  is 'Plan';
comment on column IT.AH_CON_DIA_DET.mon_compensacion
  is 'Moneda de la compensacion';
comment on column IT.AH_CON_DIA_DET.imp_autorizacion
  is 'Importe de Autorizacion';
comment on column IT.AH_CON_DIA_DET.sig_imp_autorizacion
  is '+ o -';
comment on column IT.AH_CON_DIA_DET.mon_autorizacion
  is 'Moneda de la autorizacion';
comment on column IT.AH_CON_DIA_DET.imp_aut_convenio
  is 'Importe autorizacion convenio';
comment on column IT.AH_CON_DIA_DET.sig_imp_aut_convenio
  is '+ o -';
comment on column IT.AH_CON_DIA_DET.mon_aut_convenio
  is 'Moneda autorizacion convenio';
comment on column IT.AH_CON_DIA_DET.imp_ipm_de6
  is 'Importe IPM';
comment on column IT.AH_CON_DIA_DET.sig_imp_ipm
  is '+ o -';
comment on column IT.AH_CON_DIA_DET.mon_ipm
  is 'Moneda IPM';
comment on column IT.AH_CON_DIA_DET.id_auto
  is 'Clave de autorizacion';
comment on column IT.AH_CON_DIA_DET.id_cod_auto
  is 'Codigo de autorizacion';
comment on column IT.AH_CON_DIA_DET.cta_externa
  is 'Cuenta Externa';
comment on column IT.AH_CON_DIA_DET.request_id
  is 'Codigo invoca autorizacion';
comment on column IT.AH_CON_DIA_DET.imp_percep_27
  is 'Importe de la percecpcion por la Ley 27.541';
comment on column IT.AH_CON_DIA_DET.sig_percep_27
  is '+ o -';
comment on column IT.AH_CON_DIA_DET.imp_iva_ser_digitales
  is 'Importe IVA servicios digitales';
