create table IT.CO_INF_PERSONAS
(
  cod_persona       VARCHAR2(10) not null,
  cod_modulo        NUMBER(3) not null,
  cod_moneda        VARCHAR2(3) not null,
  relacion          VARCHAR2(1) not null,
  cod_afiliado      NUMBER(6) not null,
  fec_informacion   DATE not null,
  nro_documento     VARCHAR2(30) not null,
  pri_nombre        VARCHAR2(120),
  seg_nombre        VARCHAR2(30),
  pri_apellido      VARCHAR2(30),
  seg_apellido      VARCHAR2(30),
  ape_casada        VARCHAR2(25),
  fec_operacion     DATE,
  ide_operacion     VARCHAR2(25) not null,
  cod_inf_operacion NUMBER(2) not null,
  mto_operacion     NUMBER(20,2),
  cod_inf_moneda    VARCHAR2(1) not null,
  pla_operacion     NUMBER(4),
  fec_ven_pendiente DATE,
  fec_ult_pago      DATE,
  saldo             NUMBER(18,2),
  usu_insercion     VARCHAR2(10) default substr( USER, 1, 10 ) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default substr( USER, 1, 10 ) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_modalidad     NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CO_INF_PERSONAS
  is 'Es el reflejo de la Informacion que debe tener INFORMCONF ** Un proceso borra los registros de acuerdo a un criterio preestablecido **';
comment on column IT.CO_INF_PERSONAS.cod_persona
  is 'Indica el codigo del cliente que es informado.';
comment on column IT.CO_INF_PERSONAS.cod_modulo
  is 'Indica el tipo de operacion (Prestamo, Tarjeta o Sobregiro).';
comment on column IT.CO_INF_PERSONAS.cod_moneda
  is 'Indica cod_moneda de la operacion utilizando la codificacion del sistema.';
comment on column IT.CO_INF_PERSONAS.relacion
  is 'Es la relacion que tiene el cliente con el prestamo ya sea Principal, Codeudor o Garante.';
comment on column IT.CO_INF_PERSONAS.cod_afiliado
  is 'Indica el codigo de suscripcion de la entidad a Informconf.';
comment on column IT.CO_INF_PERSONAS.fec_informacion
  is 'Fecha del dia en el que se le envia la informacion a Informconf.';
comment on column IT.CO_INF_PERSONAS.nro_documento
  is 'Numero de documento del cliente o RUC.';
comment on column IT.CO_INF_PERSONAS.pri_nombre
  is 'Primer nombre o razon social.';
comment on column IT.CO_INF_PERSONAS.seg_nombre
  is 'Segundo nombre del cliente.';
comment on column IT.CO_INF_PERSONAS.pri_apellido
  is 'Primer apellido del cliente.';
comment on column IT.CO_INF_PERSONAS.seg_apellido
  is 'Segundo apellido del cliente.';
comment on column IT.CO_INF_PERSONAS.ape_casada
  is 'Apellido de casada si el cliente es de sexo femenino.';
comment on column IT.CO_INF_PERSONAS.fec_operacion
  is 'Fecha de inicio de la operacion.';
comment on column IT.CO_INF_PERSONAS.ide_operacion
  is 'identificador de la operacion.';
comment on column IT.CO_INF_PERSONAS.cod_inf_operacion
  is 'Codificacion de la operacion utilizada por Informconf, Se encuentra en la tabla CO_INF_OPERACIONES.';
comment on column IT.CO_INF_PERSONAS.mto_operacion
  is 'Total de la operacion. Solo Para prestamos.';
comment on column IT.CO_INF_PERSONAS.cod_inf_moneda
  is 'Codificacion de la moneda, utilizada por Informconf.';
comment on column IT.CO_INF_PERSONAS.pla_operacion
  is 'Plazo en dias de la operacion cuando supera los tres digitos se le envia 999 para informar el maximo plazo que recibe Informconf. Solo para prestamos.';
comment on column IT.CO_INF_PERSONAS.fec_ven_pendiente
  is 'Fecha de vencimiento pendiente.';
comment on column IT.CO_INF_PERSONAS.fec_ult_pago
  is 'Fecha del ultimo pago del cliente.';
comment on column IT.CO_INF_PERSONAS.saldo
  is 'Saldo que el cliente quedo adeudando.';
comment on column IT.CO_INF_PERSONAS.usu_insercion
  is 'Usuario que inserto el registro.';
comment on column IT.CO_INF_PERSONAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CO_INF_PERSONAS.usu_modificacion
  is 'Usuario que modifico el registro.';
comment on column IT.CO_INF_PERSONAS.fec_modificacion
  is 'Fecha en que se modifico el registro.';
comment on column IT.CO_INF_PERSONAS.cod_modalidad
  is 'Indica la modalidad de la operación, especialmente para identificar modalidades de Operaciones Vencidas.';
alter table IT.CO_INF_PERSONAS
  add constraint PK_CO_INF_PERSONAS primary key (COD_PERSONA, IDE_OPERACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CO_INF_PERSONAS
  add constraint FK_OIPER_COD_INF_MONEDA foreign key (COD_INF_MONEDA)
  references IT.CO_INF_MONEDAS (COD_INF_MONEDA);
alter table IT.CO_INF_PERSONAS
  add constraint FK_OIPER_COD_INF_OPERACION foreign key (COD_INF_OPERACION)
  references IT.CO_INF_OPERACIONES (COD_INF_OPERACION);
alter table IT.CO_INF_PERSONAS
  add constraint FK_OIPER_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.CO_INF_PERSONAS
  add constraint FK_OIPER_COD_MODULO foreign key (COD_MODULO)
  references IT.BA_MODULOS (COD_MODULO);
alter table IT.CO_INF_PERSONAS
  add constraint FK_OIPER_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CO_INF_PERSONAS
  add constraint FK_OIPER_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CO_INF_PERSONAS
  add constraint FEC_INFORMACION_INVALIDA232
  check (NVL(to_char(FEC_INFORMACION,'YYYY'),'1901') > '1900');
alter table IT.CO_INF_PERSONAS
  add constraint FEC_OPERACION_INVALIDA233
  check (NVL(to_char(FEC_OPERACION,'YYYY'),'1901') > '1900');
alter table IT.CO_INF_PERSONAS
  add constraint FEC_ULT_PAGO_INVALIDA234
  check (NVL(to_char(FEC_ULT_PAGO,'YYYY'),'1901') > '1900');

