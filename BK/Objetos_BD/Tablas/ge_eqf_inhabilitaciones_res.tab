create table IT.GE_EQF_INHABILITACIONES_RES
(
  nro_solicitud          NUMBER(10) not null,
  cod_persona            VARCHAR2(10) not null,
  nro_secuencia          NUMBER(5) not null,
  fec_consulta           DATE,
  hor_consulta           VARCHAR2(10),
  nom_ser_webservice     VARCHAR2(50),
  tip_persona            VARCHAR2(1),
  can_total              NUMBER(10),
  men_fec_inhabilitacion VARCHAR2(100),
  may_fec_inhabilitacion VARCHAR2(100),
  may_plz_inhabilitacion NUMBER(10),
  msg_error              VARCHAR2(4000),
  usu_insercion          VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion          DATE default SYSDATE not null,
  usu_modificacion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion       DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_EQF_INHABILITACIONES_RES.nro_solicitud
  is 'Nro Solicitud al servicio web';
comment on column IT.GE_EQF_INHABILITACIONES_RES.cod_persona
  is 'Cod de persona que se consulta en los servicios web';
comment on column IT.GE_EQF_INHABILITACIONES_RES.nro_secuencia
  is 'Nro de secuencia por solicitud';
comment on column IT.GE_EQF_INHABILITACIONES_RES.fec_consulta
  is 'Fecha de la consulta al servicio web';
comment on column IT.GE_EQF_INHABILITACIONES_RES.hor_consulta
  is 'Hora de la consulta al servicio web';
comment on column IT.GE_EQF_INHABILITACIONES_RES.nom_ser_webservice
  is 'Nombre del servicio web consultado';
comment on column IT.GE_EQF_INHABILITACIONES_RES.tip_persona
  is 'Tipo de persona F= física, J= jurídica';
comment on column IT.GE_EQF_INHABILITACIONES_RES.can_total
  is 'Cantidad total de inhabilitaciones';
comment on column IT.GE_EQF_INHABILITACIONES_RES.men_fec_inhabilitacion
  is 'Mayor fecha de inhabilitación';
comment on column IT.GE_EQF_INHABILITACIONES_RES.may_fec_inhabilitacion
  is 'Menor fecha de inhabilitación';
comment on column IT.GE_EQF_INHABILITACIONES_RES.may_plz_inhabilitacion
  is 'Mayor plazo de inhabilitación';
comment on column IT.GE_EQF_INHABILITACIONES_RES.msg_error
  is 'Mensaje de error del webservice si lo hubiere';
create index IT.IN_INHAB_PER_SOL_FEC on IT.GE_EQF_INHABILITACIONES_RES (COD_PERSONA, FEC_CONSULTA, NRO_SOLICITUD)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_EQF_INHABILITACIONES_RES
  add constraint PK_GE_EQF_INHABILITACIONES_RES primary key (NRO_SOLICITUD)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_EQF_INHABILITACIONES_RES
  add constraint FK_EQFIN_NRO_SOLICITUD foreign key (NRO_SOLICITUD)
  references IT.GE_EQF_SOLICITUDES (NRO_SOLICITUD) on delete cascade;

