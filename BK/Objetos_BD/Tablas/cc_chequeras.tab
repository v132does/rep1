create table IT.CC_CHEQUERAS
(
  nro_cuenta       VARCHAR2(15) not null,
  serie            VARCHAR2(5),
  nro_che_inicial  NUMBER(15) not null,
  nro_che_final    NUMBER(15) not null,
  can_cheques      NUMBER(5) not null,
  estado           VARCHAR2(1) not null,
  fec_cam_estado   DATE not null,
  ult_che_emitido  NUMBER(15),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  est_cheques      VARCHAR2(1000) default 'I',
  tipo             VARCHAR2(1),
  fec_solicitud    DATE,
  hor_solicitud    VARCHAR2(8),
  cod_usuario      VARCHAR2(10),
  cod_ofi_retiro   NUMBER(3),
  cod_gru_envio    NUMBER(5)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CHEQUERAS
  is 'Chequeras de una Cuenta Corriente.';
comment on column IT.CC_CHEQUERAS.nro_cuenta
  is 'Numero de Cuenta.';
comment on column IT.CC_CHEQUERAS.serie
  is 'Serie de los Cheques.';
comment on column IT.CC_CHEQUERAS.nro_che_inicial
  is 'Numero de Cheque Inicial.';
comment on column IT.CC_CHEQUERAS.nro_che_final
  is 'Numero de Cheque Final.';
comment on column IT.CC_CHEQUERAS.can_cheques
  is 'Cantidad de Cheques.';
comment on column IT.CC_CHEQUERAS.estado
  is 'Estado de la Chequera (S olicitada,I mpresa,E ntregada,N en impresion).';
comment on column IT.CC_CHEQUERAS.fec_cam_estado
  is 'Fecha del Ultimo Cambio de Estado.';
comment on column IT.CC_CHEQUERAS.ult_che_emitido
  is 'Ultimo Cheque Emitido.';
comment on column IT.CC_CHEQUERAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CHEQUERAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CHEQUERAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHEQUERAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHEQUERAS.est_cheques
  is 'Detalle de los Estados de los Cheques que posee la Chequera.';
comment on column IT.CC_CHEQUERAS.tipo
  is 'Tipo de Solicitud de Chequera.';
comment on column IT.CC_CHEQUERAS.fec_solicitud
  is 'Fecha de Solicitud o Entrega de la Chequera.';
comment on column IT.CC_CHEQUERAS.hor_solicitud
  is 'Hora de Solicitud o Entrega de la Chequera.';
comment on column IT.CC_CHEQUERAS.cod_usuario
  is 'Codigo del Usuario que realizo el Pedido.';
comment on column IT.CC_CHEQUERAS.cod_ofi_retiro
  is 'Codigo de la Oficina de retiro de la Chequera.';
comment on column IT.CC_CHEQUERAS.cod_gru_envio
  is 'Codigo del Grupo de envio de la Chequera.';
create index IT.IN_CC_CHEQUERAS_1 on IT.CC_CHEQUERAS (ESTADO)
  tablespace IT_IND
  pctfree 40
  initrans 4
  maxtrans 255
  storage
  (
    initial 7M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHEQUERAS
  add constraint UK_CC_CHEQUERAS unique (NRO_CUENTA, NRO_CHE_INICIAL, SERIE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 8M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHEQUERAS
  add constraint FK_CCCOR_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.CC_CHEQUERAS
  add constraint FK_CCHEQ_COD_GRU_ENVIO foreign key (COD_GRU_ENVIO)
  references IT.CC_GRU_ENVIOS (COD_GRU_ENVIO);
alter table IT.CC_CHEQUERAS
  add constraint FK_CCHEQ_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.CC_CHEQUERAS
  add constraint AVCON_1099575085_COD_O_000
  check (COD_OFI_RETIRO BETWEEN 0 AND 99999);

