create table IT.GE_DNA_ORD_TRA_FIRMANTES
(
  nro_ord_transferencia VARCHAR2(50) not null,
  cod_fir_ord_tra       NUMBER(18) not null,
  nombre                VARCHAR2(2000),
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default sysdate not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default sysdate not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_DNA_ORD_TRA_FIRMANTES
  is 'Contiene los firmantes de las órdenes de Transferencias.';
comment on column IT.GE_DNA_ORD_TRA_FIRMANTES.nro_ord_transferencia
  is 'Numero de Orden Transferencia.';
comment on column IT.GE_DNA_ORD_TRA_FIRMANTES.cod_fir_ord_tra
  is 'Código de firmante.';
comment on column IT.GE_DNA_ORD_TRA_FIRMANTES.nombre
  is 'Nombre del Firmante.';
comment on column IT.GE_DNA_ORD_TRA_FIRMANTES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_DNA_ORD_TRA_FIRMANTES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_DNA_ORD_TRA_FIRMANTES.usu_modificacion
  is 'Usuario que realizó la ultima modificación en el registro.';
comment on column IT.GE_DNA_ORD_TRA_FIRMANTES.fec_modificacion
  is 'Fecha en que se realizó la ultima modificación en el registro.';
alter table IT.GE_DNA_ORD_TRA_FIRMANTES
  add constraint PK_GE_SNP_ORD_TRA_FIRMANTES primary key (NRO_ORD_TRANSFERENCIA, COD_FIR_ORD_TRA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

