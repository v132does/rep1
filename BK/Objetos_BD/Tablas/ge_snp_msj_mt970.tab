create table IT.GE_SNP_MSJ_MT970
(
  fec_proceso      DATE,
  cod_mensaje      NUMBER(15),
  fec_extracto     DATE not null,
  nro_referencia   VARCHAR2(30) not null,
  nro_secuencia    VARCHAR2(10) not null,
  nro_cta_bbva     VARCHAR2(15),
  moneda           VARCHAR2(3),
  tip_mov_inicial  VARCHAR2(1),
  sal_inicial      NUMBER(18,2),
  tip_mov_final    VARCHAR2(1),
  sal_final        NUMBER(18,2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  ind_movimiento   VARCHAR2(1) default 'N',
  des_corte        VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SNP_MSJ_MT970
  is 'Tabla Cabecera del extracto del mensaje MT940';
comment on column IT.GE_SNP_MSJ_MT970.fec_proceso
  is 'Fecha Proceso. Fecha en que se recibio la mensajeria';
comment on column IT.GE_SNP_MSJ_MT970.cod_mensaje
  is 'Codigo secuencial (Para relacionar con la cabecera y el detalle)';
comment on column IT.GE_SNP_MSJ_MT970.fec_extracto
  is 'Fecha del extraco. (:60F)';
comment on column IT.GE_SNP_MSJ_MT970.nro_referencia
  is 'Numero de Referencia o Extracto (:20)';
comment on column IT.GE_SNP_MSJ_MT970.nro_secuencia
  is 'Nro de secuencia o corte del periodo (:28C)';
comment on column IT.GE_SNP_MSJ_MT970.nro_cta_bbva
  is 'Numero de Cuenta afectada en BCP (:25)';
comment on column IT.GE_SNP_MSJ_MT970.moneda
  is 'Moneda (:62F o :62M)';
comment on column IT.GE_SNP_MSJ_MT970.tip_mov_inicial
  is 'Tipo de Movimiento C-Credito, D-Debito (:60F o :60M)';
comment on column IT.GE_SNP_MSJ_MT970.sal_inicial
  is 'Saldo del periodo / corte (:60F o :60M)';
comment on column IT.GE_SNP_MSJ_MT970.tip_mov_final
  is 'Tipo de Movimiento C-Credito, D-Debito (:62F o :62M)';
comment on column IT.GE_SNP_MSJ_MT970.sal_final
  is 'Saldo del periodo / corte (:62F o :62M)';
comment on column IT.GE_SNP_MSJ_MT970.ind_movimiento
  is 'Indica si ya se generaron los movimientos por los Saldos';
comment on column IT.GE_SNP_MSJ_MT970.des_corte
  is 'Descripcion Corte del extracto: FIRST, SECOND, FINAL';
alter table IT.GE_SNP_MSJ_MT970
  add constraint PK_GE_SNP_MSJ_970 primary key (FEC_EXTRACTO, NRO_REFERENCIA, NRO_SECUENCIA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

