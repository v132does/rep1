create table IT.GE_TRA_CAMPOS
(
  cod_transaccion  NUMBER(4) not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  nro_orden        NUMBER(3),
  cod_campo        VARCHAR2(20) not null,
  tip_campo        VARCHAR2(1) default 'X' not null,
  lon_campo        NUMBER(4) not null,
  tip_despliegue   VARCHAR2(1) default 'T' not null,
  lon_despliegue   NUMBER(2) not null,
  nro_linea        NUMBER(2) not null,
  nro_columna      NUMBER(2) not null,
  formato          VARCHAR2(30),
  alineacion       VARCHAR2(1) default 'I' not null,
  etiqueta         VARCHAR2(30),
  nro_lin_etiqueta NUMBER(2),
  nro_col_etiqueta NUMBER(2),
  val_defecto      VARCHAR2(100),
  val_posibles     VARCHAR2(2000),
  val_minimo       VARCHAR2(100),
  val_maximo       VARCHAR2(100),
  tip_dato         VARCHAR2(1) default 'I' not null,
  validado         VARCHAR2(1) default 'N' not null,
  ayuda            VARCHAR2(100),
  usu_insercion    VARCHAR2(10) default substr(user,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default substr(user,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_TRA_CAMPOS
  is 'Contiene los campos a ser definidos por cada transaccion.';
comment on column IT.GE_TRA_CAMPOS.cod_transaccion
  is 'Codigo de transaccion.';
comment on column IT.GE_TRA_CAMPOS.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.GE_TRA_CAMPOS.cod_modalidad
  is 'Codigo de la transaccion.';
comment on column IT.GE_TRA_CAMPOS.nro_orden
  is 'Nro. de orden de aparicion.';
comment on column IT.GE_TRA_CAMPOS.cod_campo
  is 'Codigo del campo.';
comment on column IT.GE_TRA_CAMPOS.tip_campo
  is 'Tipo de Campo N=Numerico, F=Fecha, A=Alfabetico, X=Alfanumerico,.';
comment on column IT.GE_TRA_CAMPOS.lon_campo
  is 'Longitud del Campo total.';
comment on column IT.GE_TRA_CAMPOS.tip_despliegue
  is 'T=Texto, M=Texto Multilineal, R=Radio Group, L=List Item, C=Check.';
comment on column IT.GE_TRA_CAMPOS.lon_despliegue
  is 'Longitud de despliegue.';
comment on column IT.GE_TRA_CAMPOS.nro_linea
  is 'Nro. de Linea en la que se despliega.';
comment on column IT.GE_TRA_CAMPOS.nro_columna
  is 'Columna en la que se desplegara el campo.';
comment on column IT.GE_TRA_CAMPOS.formato
  is 'Formato del campo, si tiene.';
comment on column IT.GE_TRA_CAMPOS.alineacion
  is 'D=Derecha, I=izquierda.';
comment on column IT.GE_TRA_CAMPOS.etiqueta
  is 'Etiqueta que le corresponde.';
comment on column IT.GE_TRA_CAMPOS.nro_lin_etiqueta
  is 'Nro. de linea de la etiqueta.';
comment on column IT.GE_TRA_CAMPOS.nro_col_etiqueta
  is 'Columna de la etiqueta.';
comment on column IT.GE_TRA_CAMPOS.val_defecto
  is 'Valor por defecto.';
comment on column IT.GE_TRA_CAMPOS.val_posibles
  is 'Valores posibles en los casos de listas.';
comment on column IT.GE_TRA_CAMPOS.val_minimo
  is 'Valor minimo permitido.';
comment on column IT.GE_TRA_CAMPOS.val_maximo
  is 'Valor maximo permitido.';
comment on column IT.GE_TRA_CAMPOS.tip_dato
  is 'D=Despliegue, O=Ingresable obligatorio, I=Ingresable no obligatorio.';
comment on column IT.GE_TRA_CAMPOS.validado
  is 'Validar el dato S/N.';
comment on column IT.GE_TRA_CAMPOS.ayuda
  is 'Ayuda en linea.';
comment on column IT.GE_TRA_CAMPOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_TRA_CAMPOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_TRA_CAMPOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_TRA_CAMPOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_TRA_CAMPOS
  add constraint PK_GE_TRA_CAMPOS primary key (COD_TRANSACCION, COD_CAMPO, COD_MODULO, COD_MODALIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_TRA_CAMPOS
  add constraint FK_GTCAM_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_TRA_CAMPOS
  add constraint AVCON_1085010049_ALINE_000
  check (ALINEACION IN ('D', 'I'));
alter table IT.GE_TRA_CAMPOS
  add constraint AVCON_1085010049_COD_M_006
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_TRA_CAMPOS
  add constraint AVCON_1085010049_COD_M_007
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_TRA_CAMPOS
  add constraint AVCON_1085010049_TIP_C_000
  check (TIP_CAMPO IN ('N', 'F', 'A', 'X'));
alter table IT.GE_TRA_CAMPOS
  add constraint AVCON_1085010049_TIP_D_000
  check (TIP_DESPLIEGUE IN ('T', 'M', 'R', 'L', 'C'));
alter table IT.GE_TRA_CAMPOS
  add constraint AVCON_1085010049_TIP_D_001
  check (TIP_DATO IN ('D', 'O', 'I'));
alter table IT.GE_TRA_CAMPOS
  add constraint AVCON_1085010049_VALID_000
  check (VALIDADO IN ('S', 'N'));

