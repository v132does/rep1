
CREATE TABLE IT.GE_PROMOCIONES
(
   COD_PROMOCION     VARCHAR2(20 Byte)    NOT NULL,
   NOM_PROMOCION     VARCHAR2(100 Byte)   NOT NULL,
   COD_NIVEL         VARCHAR2(20 Byte) 
)
TABLESPACE IT_DATA;

CREATE INDEX IN_PROMOCIONES_COD_PROMOCION
   ON GE_PROMOCIONES (COD_PROMOCION ASC)
   TABLESPACE IT_IND;

CREATE INDEX IN_PROMOCIONES_NOM_PROMOCION
   ON GE_PROMOCIONES (NOM_PROMOCION ASC)
   TABLESPACE IT_IND;
   
CREATE INDEX IN_PROMOCIONES_COD_NIVEL
   ON GE_PROMOCIONES (COD_NIVEL ASC, COD_PROMOCION ASC)
   TABLESPACE IT_IND;



GRANT ALTER, INSERT, SELECT, UPDATE, DEBUG, FLASHBACK, DELETE, ON COMMIT REFRESH, QUERY REWRITE, READ ON GE_PROMOCIONES TO IT_TEMPORAL;
