create table IT.GE_OFE_PRE_APROBADOS
(
  cod_persona    VARCHAR2(10) not null,
  oferta         VARCHAR2(15) not null,
  fec_ult_oferta DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_OFE_PRE_APROBADOS.cod_persona
  is 'Código de Persona
';
comment on column IT.GE_OFE_PRE_APROBADOS.oferta
  is 'Referencia General de Oferta en ATM';
comment on column IT.GE_OFE_PRE_APROBADOS.fec_ult_oferta
  is 'Fecha de última oferta';
alter table IT.GE_OFE_PRE_APROBADOS
  add constraint PK_GE_OFE_PRE_APROBADOS primary key (COD_PERSONA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_OFE_PRE_APROBADOS
  add constraint FK_OPA_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);

