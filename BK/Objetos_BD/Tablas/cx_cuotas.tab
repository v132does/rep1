create table IT.CX_CUOTAS
(
  nro_cuenta       VARCHAR2(15) not null,
  nro_cuota        NUMBER(3) not null,
  fec_vencimiento  DATE not null,
  estado           VARCHAR2(1) not null,
  monto            NUMBER(18,2) default 0 not null,
  saldo            NUMBER(18,2) default 0 not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  nro_sol_prestamo NUMBER(7),
  nro_cta_prestamo VARCHAR2(15),
  nro_embarque     NUMBER(3),
  observacion      VARCHAR2(1000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CX_CUOTAS
  is 'Detalle de Cuotas de Cartas de Credito de Importacion.';
comment on column IT.CX_CUOTAS.nro_cuenta
  is 'Nro. de cuenta interno para la operacion.';
comment on column IT.CX_CUOTAS.nro_cuota
  is 'Numero de Cuota.';
comment on column IT.CX_CUOTAS.fec_vencimiento
  is 'Fecha de Vencimiento de la Cuota.';
comment on column IT.CX_CUOTAS.estado
  is 'Estado de la Cuota (N)pendiente, (P)pagada.';
comment on column IT.CX_CUOTAS.monto
  is 'Monto.';
comment on column IT.CX_CUOTAS.saldo
  is 'Saldo.';
comment on column IT.CX_CUOTAS.usu_insercion
  is 'Codigo de Usuario Auditoria.';
comment on column IT.CX_CUOTAS.fec_insercion
  is 'Fecha de Auditoria.';
comment on column IT.CX_CUOTAS.usu_modificacion
  is 'Codigo de Usuario Auditoria.';
comment on column IT.CX_CUOTAS.fec_modificacion
  is 'Fecha de Auditoria.';
comment on column IT.CX_CUOTAS.nro_sol_prestamo
  is 'Nro. de solicitud de prestamos.';
comment on column IT.CX_CUOTAS.nro_cta_prestamo
  is 'Nro. de cuenta de prestamos.';
comment on column IT.CX_CUOTAS.nro_embarque
  is 'Numero de Embarque de la Carta.';
comment on column IT.CX_CUOTAS.observacion
  is 'Observación del cobro de la Cuota.';
create index IT.IN_CXCUO_NRO_CUENTA on IT.CX_CUOTAS (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CX_CUOTAS
  add constraint PK_CX_CUOTAS primary key (NRO_CUENTA, NRO_CUOTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CX_CUOTAS
  add constraint FK_CXCUO_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.CX_CUOTAS
  add constraint AVCON_1173800607_NRO_C_000
  check (NRO_CUOTA BETWEEN 0 AND 999);
alter table IT.CX_CUOTAS
  add constraint AVCON_1175697839_ESTAD_000
  check (ESTADO IN ('N', 'P','C'));
alter table IT.CX_CUOTAS
  add constraint CK_XCCUO_MONTO
  check (NVL(MONTO,0) > 0);
alter table IT.CX_CUOTAS
  add constraint CK_XCCUO_SALDO
  check (NVL(SALDO,0) >= 0);

