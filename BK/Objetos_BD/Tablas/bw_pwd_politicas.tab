create table IT.BW_PWD_POLITICAS
(
  cod_politica     NUMBER(18) not null,
  descripcion      VARCHAR2(4000),
  regla            VARCHAR2(4000),
  activo           VARCHAR2(1),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_PWD_POLITICAS
  is 'Politicas de Password.';
comment on column IT.BW_PWD_POLITICAS.cod_politica
  is 'Código de Politica.';
comment on column IT.BW_PWD_POLITICAS.descripcion
  is 'Descripcion.';
comment on column IT.BW_PWD_POLITICAS.regla
  is 'Regla';
comment on column IT.BW_PWD_POLITICAS.activo
  is 'Activo S/N.';
comment on column IT.BW_PWD_POLITICAS.usu_insercion
  is 'Usuario de Inserción.';
comment on column IT.BW_PWD_POLITICAS.fec_insercion
  is 'Fecha de Inserción.';
comment on column IT.BW_PWD_POLITICAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BW_PWD_POLITICAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BW_PWD_POLITICAS
  add constraint PK_BW_PWD_POLITICAS primary key (COD_POLITICA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

