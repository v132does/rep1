create table IT.RH_TIP_AUSENCIAS
(
  cod_tip_ausencia VARCHAR2(3) not null,
  descripcion      VARCHAR2(40) not null,
  ind_goc_sueldo   VARCHAR2(1) default 'N' not null,
  por_sueldo       NUMBER(5,2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_TIP_AUSENCIAS
  is 'Ausencias del Empleado.';
comment on column IT.RH_TIP_AUSENCIAS.cod_tip_ausencia
  is 'Tipo de Ausencias.';
comment on column IT.RH_TIP_AUSENCIAS.descripcion
  is 'Descripcion.';
comment on column IT.RH_TIP_AUSENCIAS.ind_goc_sueldo
  is 'Con goce de sueldos? Valores posibles: Si o No';
comment on column IT.RH_TIP_AUSENCIAS.por_sueldo
  is 'Porcentaje de sueldo a cobrar por la ausencia.';
comment on column IT.RH_TIP_AUSENCIAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_TIP_AUSENCIAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_TIP_AUSENCIAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_TIP_AUSENCIAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.RH_TIP_AUSENCIAS
  add constraint PK_RH_TIP_AUSENCIAS primary key (COD_TIP_AUSENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_TIP_AUSENCIAS
  add constraint UK_HTAUS_DESCRIPCION unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_TIP_AUSENCIAS
  add constraint AVCON_1191539775_IND_G_000
  check (IND_GOC_SUELDO IN ('S', 'N'));
alter table IT.RH_TIP_AUSENCIAS
  add constraint CK_IND_GOC_SUELDO
  check ((IND_GOC_SUELDO = 'S'
and POR_SUELDO is not null) or (IND_GOC_SUELDO = 'N'
and POR_SUELDO is null));

