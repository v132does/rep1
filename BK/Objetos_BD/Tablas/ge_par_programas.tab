create table IT.GE_PAR_PROGRAMAS
(
  parametro        VARCHAR2(30) not null,
  cod_programa     VARCHAR2(30) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_PAR_PROGRAMAS.parametro
  is 'Parametro';
comment on column IT.GE_PAR_PROGRAMAS.cod_programa
  is 'Coigo de Programa';
comment on column IT.GE_PAR_PROGRAMAS.usu_insercion
  is 'Usuario de Insercion';
comment on column IT.GE_PAR_PROGRAMAS.fec_insercion
  is 'Fecha de Insercion';
comment on column IT.GE_PAR_PROGRAMAS.usu_modificacion
  is 'Usuario de Modificacion';
comment on column IT.GE_PAR_PROGRAMAS.fec_modificacion
  is 'Fecha de Modificacion';
alter table IT.GE_PAR_PROGRAMAS
  add constraint PK_GE_PAR_PROGRAMAS primary key (PARAMETRO, COD_PROGRAMA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAR_PROGRAMAS
  add constraint FK_PARPR_COD_PROGRAMA foreign key (COD_PROGRAMA)
  references IT.BA_PROGRAMAS (COD_PROGRAMA);

