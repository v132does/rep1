create table IT.GE_CLI_INFORMACIONES
(
  cod_persona             VARCHAR2(10) not null,
  informacion             VARCHAR2(10) not null,
  dat_informacion         NUMBER(1) not null,
  fec_mod_informacion     DATE,
  usu_mod_informacion     VARCHAR2(10) default substr(user,1,10),
  dat_informacion_ant     NUMBER(1),
  fec_mod_informacion_ant DATE,
  usu_mod_informacion_ant VARCHAR2(10) default substr(user,1,10),
  observacion             VARCHAR2(2000),
  usu_insercion           VARCHAR2(10) default substr(user,1,10),
  fec_insercion           DATE default trunc(sysdate),
  usu_modificacion        VARCHAR2(10) default substr(user,1,10),
  fec_modificacion        DATE default trunc(sysdate)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CLI_INFORMACIONES
  add constraint PK_GE_CLI_INFORMACIONES primary key (COD_PERSONA, INFORMACION, DAT_INFORMACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CLI_INFORMACIONES
  add constraint FK_GACLIE_COD_PERSONA foreign key (COD_PERSONA)
  references IT.GE_CLIENTES (COD_PERSONA);

