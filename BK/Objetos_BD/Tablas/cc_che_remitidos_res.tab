create table IT.CC_CHE_REMITIDOS_RES
(
  fecha            DATE not null,
  cod_oficina      NUMBER(3) not null,
  nro_caja         NUMBER(3) not null,
  nro_lote         NUMBER(4) not null,
  tip_dato         NUMBER(3),
  nro_referencia   VARCHAR2(15),
  nro_boleta       VARCHAR2(15),
  monto            NUMBER(18,2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_ofi_origen   NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CHE_REMITIDOS_RES
  is 'Resumen de los cheques remitidos.';
comment on column IT.CC_CHE_REMITIDOS_RES.fecha
  is 'Fecha.';
comment on column IT.CC_CHE_REMITIDOS_RES.cod_oficina
  is 'Codigo de Oficina.';
comment on column IT.CC_CHE_REMITIDOS_RES.nro_caja
  is 'Numero de Caja.';
comment on column IT.CC_CHE_REMITIDOS_RES.nro_lote
  is 'Numero de Lote.';
comment on column IT.CC_CHE_REMITIDOS_RES.tip_dato
  is 'Tipo de Dato.';
comment on column IT.CC_CHE_REMITIDOS_RES.nro_referencia
  is 'Numero de Referencia.';
comment on column IT.CC_CHE_REMITIDOS_RES.nro_boleta
  is 'Numero de boleta.';
comment on column IT.CC_CHE_REMITIDOS_RES.monto
  is 'Monto Total.';
comment on column IT.CC_CHE_REMITIDOS_RES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CHE_REMITIDOS_RES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CHE_REMITIDOS_RES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_REMITIDOS_RES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_REMITIDOS_RES.cod_ofi_origen
  is 'Oficina Origen del Cheque';
alter table IT.CC_CHE_REMITIDOS_RES
  add constraint PK_CC_CHE_REMITIDOS_RES primary key (FECHA, COD_OFICINA, NRO_LOTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHE_REMITIDOS_RES
  add constraint FK_CREMR_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);

