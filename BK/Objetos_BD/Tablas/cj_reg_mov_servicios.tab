create table IT.CJ_REG_MOV_SERVICIOS
(
  cod_lote         VARCHAR2(20) not null,
  cod_documento    VARCHAR2(20) not null,
  nro_transaccion  NUMBER(15) not null,
  des_transaccion  VARCHAR2(100),
  atm_id           VARCHAR2(10) not null,
  servicio         VARCHAR2(35) not null,
  nom_completo     VARCHAR2(120),
  nro_documento    VARCHAR2(20),
  nro_telefono     VARCHAR2(15),
  cod_referencia   VARCHAR2(20),
  cod_referencia_2 VARCHAR2(20),
  cod_referencia_3 VARCHAR2(20),
  monto            NUMBER(18,2),
  monto_operacion  NUMBER(18,2),
  estado           VARCHAR2(1) not null,
  fecha            DATE,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CJ_REG_MOV_SERVICIOS
  is 'Registro de datos de transacciones de funciones de Envío, Recepción de dinero WU, Pagos de servicios y transacción de vuelto';
comment on column IT.CJ_REG_MOV_SERVICIOS.cod_lote
  is 'Código de lote.';
comment on column IT.CJ_REG_MOV_SERVICIOS.cod_documento
  is 'Código asociado al Documento.';
comment on column IT.CJ_REG_MOV_SERVICIOS.nro_transaccion
  is 'Número único de Transacción.';
comment on column IT.CJ_REG_MOV_SERVICIOS.des_transaccion
  is 'Descripción de la transacción.';
comment on column IT.CJ_REG_MOV_SERVICIOS.atm_id
  is 'Identificador ATM.';
comment on column IT.CJ_REG_MOV_SERVICIOS.servicio
  is 'Servicio.';
comment on column IT.CJ_REG_MOV_SERVICIOS.nom_completo
  is 'Nombre del Depositante.';
comment on column IT.CJ_REG_MOV_SERVICIOS.nro_documento
  is 'Número de Documento.';
comment on column IT.CJ_REG_MOV_SERVICIOS.nro_telefono
  is 'Número de teléfono';
comment on column IT.CJ_REG_MOV_SERVICIOS.cod_referencia
  is 'Código de referencia de la transacción 1.';
comment on column IT.CJ_REG_MOV_SERVICIOS.cod_referencia_2
  is 'Código de referencia de la transacción 2.';
comment on column IT.CJ_REG_MOV_SERVICIOS.cod_referencia_3
  is 'Código de referencia de la transacción 3.';
comment on column IT.CJ_REG_MOV_SERVICIOS.monto
  is 'Importe físico.';
comment on column IT.CJ_REG_MOV_SERVICIOS.monto_operacion
  is 'Importe de la operación.';
comment on column IT.CJ_REG_MOV_SERVICIOS.estado
  is 'Estado transacción. P/E/T = PROCESADO/ERROR/TIME OUT';
comment on column IT.CJ_REG_MOV_SERVICIOS.fecha
  is 'Fecha de carga.';
comment on column IT.CJ_REG_MOV_SERVICIOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CJ_REG_MOV_SERVICIOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CJ_REG_MOV_SERVICIOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CJ_REG_MOV_SERVICIOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_CJVIS_INDEX on IT.CJ_REG_MOV_SERVICIOS (COD_DOCUMENTO, NRO_TRANSACCION, ATM_ID)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CJ_REG_MOV_SERVICIOS
  add constraint PK_CJ_REG_MOV_SERVICIOS primary key (COD_LOTE, NRO_TRANSACCION, ATM_ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CJ_REG_MOV_SERVICIOS
  add constraint CK_CJVIS_ESTADO
  check (ESTADO IN ('P', 'E','T'));

