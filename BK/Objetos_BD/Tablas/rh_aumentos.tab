create table IT.RH_AUMENTOS
(
  cod_empresa         VARCHAR2(10) not null,
  cod_cen_costo       NUMBER(3),
  cod_per_desde       VARCHAR2(10) not null,
  cod_per_hasta       VARCHAR2(10) not null,
  fecha               DATE not null,
  monto               NUMBER(18,2),
  porcentaje          NUMBER(5,2),
  ind_procesado       VARCHAR2(1) default 'N' not null,
  cod_per_autorizador VARCHAR2(10),
  ind_afectacion      VARCHAR2(1) not null,
  cod_tip_ingreso     NUMBER(3),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_AUMENTOS
  is 'Aumentos del Modulo de Recursos Humanos.';
comment on column IT.RH_AUMENTOS.cod_empresa
  is 'Codigo de la Empresa.';
comment on column IT.RH_AUMENTOS.cod_cen_costo
  is 'Codigo del Centro de Costo.';
comment on column IT.RH_AUMENTOS.cod_per_desde
  is 'Codigo de empleado desde el cual se procesa.';
comment on column IT.RH_AUMENTOS.cod_per_hasta
  is 'Codigo de Empleado hasta el cual se aumenta.';
comment on column IT.RH_AUMENTOS.fecha
  is 'Fecha del aumento de salario.';
comment on column IT.RH_AUMENTOS.monto
  is 'Monto a ser aumentado.';
comment on column IT.RH_AUMENTOS.porcentaje
  is 'Porcentaje a aumentar el sueldo.';
comment on column IT.RH_AUMENTOS.ind_procesado
  is 'Indica si el aumento fue o no procesado.';
comment on column IT.RH_AUMENTOS.cod_per_autorizador
  is 'Codigo del Empleado Autorizador.';
comment on column IT.RH_AUMENTOS.ind_afectacion
  is 'Indica si el aumento afecta al sueldo o es solo gratificacion.';
comment on column IT.RH_AUMENTOS.cod_tip_ingreso
  is 'Tipo de Ingreso.';
comment on column IT.RH_AUMENTOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_AUMENTOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_AUMENTOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_AUMENTOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.RH_AUMENTOS
  add constraint PK_RH_AUMENTOS primary key (COD_PER_HASTA, COD_PER_DESDE, FECHA, COD_EMPRESA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_AUMENTOS
  add constraint FK_HAUME_COD_CEN_COSTO foreign key (COD_CEN_COSTO)
  references IT.CB_CEN_COSTOS (COD_CEN_COSTO);
alter table IT.RH_AUMENTOS
  add constraint FK_HAUME_COD_EMPRESA foreign key (COD_EMPRESA)
  references IT.RH_PAR_EMPRESAS (COD_EMPRESA);
alter table IT.RH_AUMENTOS
  add constraint FK_HAUME_COD_PER_AUTORIZADOR foreign key (COD_PER_AUTORIZADOR)
  references IT.RH_EMPLEADOS (COD_PERSONA);
alter table IT.RH_AUMENTOS
  add constraint FK_HAUME_COD_TIP_INGRESO foreign key (COD_TIP_INGRESO)
  references IT.RH_TIP_INGRESOS (COD_TIP_INGRESO);
alter table IT.RH_AUMENTOS
  add constraint AVCON_1191539330_IND_A_000
  check (IND_AFECTACION IN ('G', 'A'));
alter table IT.RH_AUMENTOS
  add constraint AVCON_1191539330_IND_P_000
  check (IND_PROCESADO IN ('S', 'N'));
alter table IT.RH_AUMENTOS
  add constraint CK_TIP_INGRESO
  check ((
(ind_afectacion = 'G' and cod_tip_ingreso is not null)
or
(ind_afectacion = 'A' and cod_tip_ingreso is null)
));

