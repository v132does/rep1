create table IT.BA_PER_GEN_OFERTAS
(
  cod_registro       NUMBER not null,
  fec_consulta       DATE not null,
  cod_persona        VARCHAR2(10) not null,
  mto_lim_prestable  NUMBER,
  cod_cat_crc        VARCHAR2(1),
  tot_deu_crc        NUMBER,
  mto_cuo_aproximado NUMBER,
  faja               VARCHAR2(1),
  fec_ing_set        DATE,
  ant_infomercio     VARCHAR2(2),
  mto_oferta         NUMBER,
  can_cuotas         NUMBER,
  cod_moneda         VARCHAR2(3),
  rta_servicio       VARCHAR2(10),
  rta_rrnn           VARCHAR2(10),
  est_servicios      VARCHAR2(1) default 'P',
  est_rrnn           VARCHAR2(1) default 'P',
  error              VARCHAR2(100),
  mto_ingreso        NUMBER,
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  mto_max_tc         NUMBER,
  mto_max_pr         NUMBER,
  can_cuo_ml         NUMBER,
  rci_ml             NUMBER,
  nde_prestamo       NUMBER
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.BA_PER_GEN_OFERTAS
  is 'Tabla de Generación de Oferta Crediticia por Persona';
-- Add comments to the columns 
comment on column IT.BA_PER_GEN_OFERTAS.cod_registro
  is 'Nro. Secuencia del registro(Cod. Oferta).';
comment on column IT.BA_PER_GEN_OFERTAS.fec_consulta
  is 'Fecha de Consulta.';
comment on column IT.BA_PER_GEN_OFERTAS.cod_persona
  is 'Cod. Persona';
comment on column IT.BA_PER_GEN_OFERTAS.mto_lim_prestable
  is 'Monto limite prestable';
comment on column IT.BA_PER_GEN_OFERTAS.cod_cat_crc
  is 'Codigo de Categoria CRC';
comment on column IT.BA_PER_GEN_OFERTAS.tot_deu_crc
  is 'Deuda total activa CRC';
comment on column IT.BA_PER_GEN_OFERTAS.mto_cuo_aproximado
  is 'Mto. Aproximado de pago de Cuota.';
comment on column IT.BA_PER_GEN_OFERTAS.faja
  is 'Faja Equifax';
comment on column IT.BA_PER_GEN_OFERTAS.fec_ing_set
  is 'Fecha de Ingreso en la SET.';
comment on column IT.BA_PER_GEN_OFERTAS.ant_infomercio
  is 'Antecedentes en Infomercio (SI/NO)';
comment on column IT.BA_PER_GEN_OFERTAS.mto_oferta
  is 'Monto de la Oferta';
comment on column IT.BA_PER_GEN_OFERTAS.can_cuotas
  is 'Cantidad de Cuotas Mensuales';
comment on column IT.BA_PER_GEN_OFERTAS.cod_moneda
  is 'Codigo de Moneda';
comment on column IT.BA_PER_GEN_OFERTAS.rta_servicio
  is 'Respuesta de Equifax.';
comment on column IT.BA_PER_GEN_OFERTAS.rta_rrnn
  is 'Respuesta de Redes Neuronales.';
comment on column IT.BA_PER_GEN_OFERTAS.est_servicios
  is 'Estado de ejecución de los servicios.(P-endiente, V-erificado, E-rror)';
comment on column IT.BA_PER_GEN_OFERTAS.est_rrnn
  is 'Estado de Ejecución de Redes Neuronales.(P-endiente, V-erificado, E-rror)';
comment on column IT.BA_PER_GEN_OFERTAS.error
  is 'Error en ejecución de los servicios.';
comment on column IT.BA_PER_GEN_OFERTAS.mto_ingreso
  is 'Monto del Ingreso.';
comment on column IT.BA_PER_GEN_OFERTAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_PER_GEN_OFERTAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_PER_GEN_OFERTAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_PER_GEN_OFERTAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.BA_PER_GEN_OFERTAS.mto_max_tc
  is 'Monto máximo para tarjeta de crédito.';
comment on column IT.BA_PER_GEN_OFERTAS.mto_max_pr
  is 'Monto máximo para préstamo.';
comment on column IT.BA_PER_GEN_OFERTAS.can_cuo_ml
  is 'Cantidad de cuotas recibidas ML. Matriz de ofertas.';
comment on column IT.BA_PER_GEN_OFERTAS.rci_ml
  is 'Relacion RCI de ML. Matriz de ofertas.';
comment on column IT.BA_PER_GEN_OFERTAS.nde_prestamo
  is 'Nivel de endeudamiento Préstamo.';
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.BA_PER_GEN_OFERTAS
  add constraint PK_BA_PER_GEN_OFERTAS primary key (COD_REGISTRO, FEC_CONSULTA, COD_PERSONA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
