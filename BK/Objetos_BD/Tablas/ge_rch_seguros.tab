create table IT.GE_RCH_SEGUROS
(
  cod_persona      VARCHAR2(10) not null,
  cod_tip_seguro   NUMBER(5) not null,
  fec_rechazo      DATE not null,
  cod_ente         NUMBER(5) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_RCH_SEGUROS.cod_persona
  is 'Codigo de persona';
comment on column IT.GE_RCH_SEGUROS.cod_tip_seguro
  is 'Codigo de tipo del seguro';
comment on column IT.GE_RCH_SEGUROS.fec_rechazo
  is 'Fecha de rechazo del seguro';
comment on column IT.GE_RCH_SEGUROS.cod_ente
  is 'Codigo de ente del seguro';
comment on column IT.GE_RCH_SEGUROS.usu_insercion
  is 'Usuario que realizó la inserción del registro';
comment on column IT.GE_RCH_SEGUROS.fec_insercion
  is 'Fecha en que se insertó el registro';
comment on column IT.GE_RCH_SEGUROS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro';
comment on column IT.GE_RCH_SEGUROS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro';
alter table IT.GE_RCH_SEGUROS
  add constraint PK_GE_RCH_SEGUROS primary key (COD_PERSONA, COD_TIP_SEGURO, FEC_RECHAZO, COD_ENTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

