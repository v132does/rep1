create table IT.SB_CRC_OPERACIONES_DET
(
  fecha                DATE not null,
  nom_referencia       VARCHAR2(10) not null,
  nro_formulario       VARCHAR2(3),
  cod_oficina          NUMBER(4),
  tip_operacion        NUMBER(3),
  nro_operacion        VARCHAR2(60),
  cod_moneda           VARCHAR2(3),
  fec_operacion        DATE,
  fec_pri_vencimiento  DATE,
  nro_cuota            NUMBER(3),
  cta_con_cap_original VARCHAR2(18),
  mto_ori_capital      NUMBER(20,2) default 0,
  mto_lin_credito      NUMBER(20,2) default 0,
  cta_con_int_original VARCHAR2(18),
  mto_ori_interes      NUMBER(20,2) default 0,
  cod_rub_primario     VARCHAR2(6),
  cod_departamento     VARCHAR2(4),
  cod_rub_economico    VARCHAR2(6),
  dia_plazo            NUMBER(5),
  tas_nominal          NUMBER(5,2) default 0,
  nro_registro         NUMBER(9) not null,
  cod_modulo           NUMBER(3),
  cod_persona          VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_CRC_OPERACIONES_DET
  is 'Datos de Detalle del Archivo Operaciones CRC1.';
comment on column IT.SB_CRC_OPERACIONES_DET.fecha
  is 'Fecha.';
comment on column IT.SB_CRC_OPERACIONES_DET.nom_referencia
  is 'Nombre de Referencia.';
comment on column IT.SB_CRC_OPERACIONES_DET.nro_formulario
  is 'Numero de Formulario.';
comment on column IT.SB_CRC_OPERACIONES_DET.cod_oficina
  is 'Codigo de Oficina.';
comment on column IT.SB_CRC_OPERACIONES_DET.tip_operacion
  is 'Tipo de Operacion.';
comment on column IT.SB_CRC_OPERACIONES_DET.nro_operacion
  is 'Numero de Operacion.';
comment on column IT.SB_CRC_OPERACIONES_DET.cod_moneda
  is 'Codigo de Moneda.';
comment on column IT.SB_CRC_OPERACIONES_DET.fec_operacion
  is 'Fecha de Operación.';
comment on column IT.SB_CRC_OPERACIONES_DET.fec_pri_vencimiento
  is 'Fecha de Primer Vencimiento.';
comment on column IT.SB_CRC_OPERACIONES_DET.nro_cuota
  is 'Numero de Cuota.';
comment on column IT.SB_CRC_OPERACIONES_DET.cta_con_cap_original
  is 'Cuenta Contable del Capital Original.';
comment on column IT.SB_CRC_OPERACIONES_DET.mto_ori_capital
  is 'Monto del Capital Original.';
comment on column IT.SB_CRC_OPERACIONES_DET.mto_lin_credito
  is 'Monto de Linea de Crédito.';
comment on column IT.SB_CRC_OPERACIONES_DET.cta_con_int_original
  is 'Cuenta Contable Interes Original.';
comment on column IT.SB_CRC_OPERACIONES_DET.mto_ori_interes
  is 'Monto Original Intereses.';
comment on column IT.SB_CRC_OPERACIONES_DET.cod_rub_primario
  is 'Codigo de Rubro Primario.';
comment on column IT.SB_CRC_OPERACIONES_DET.cod_departamento
  is 'Codigo de Departamento.';
comment on column IT.SB_CRC_OPERACIONES_DET.cod_rub_economico
  is 'Codigo de Rubro de Credito.';
comment on column IT.SB_CRC_OPERACIONES_DET.dia_plazo
  is 'Deuda de Plazo.';
comment on column IT.SB_CRC_OPERACIONES_DET.tas_nominal
  is 'Tasa Nominal.';
comment on column IT.SB_CRC_OPERACIONES_DET.nro_registro
  is 'Tasa Nominal.';
comment on column IT.SB_CRC_OPERACIONES_DET.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.SB_CRC_OPERACIONES_DET.cod_persona
  is 'Codigo de Persona.';
create index IT.IN_NRO_OPERACION on IT.SB_CRC_OPERACIONES_DET (NVL(SUBSTR(NRO_OPERACION,1,INSTR(NRO_OPERACION,'#')-1),NRO_OPERACION))
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_SB_NRO_CUENTA on IT.SB_CRC_OPERACIONES_DET (NRO_OPERACION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_SCODE_COD_PERSONA on IT.SB_CRC_OPERACIONES_DET (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
CREATE INDEX IT.IN_SB_OP_MOD ON IT.SB_CRC_OPERACIONES_DET (COD_MODULO ASC) 
LOGGING 
TABLESPACE IT_DATA 
PCTFREE 10 
INITRANS 2 
STORAGE 
( 
  INITIAL 65536 
  NEXT 1048576 
  MINEXTENTS 1 
  MAXEXTENTS UNLIMITED 
  BUFFER_POOL DEFAULT 
) ;
alter table IT.SB_CRC_OPERACIONES_DET
  add constraint PK_SB_CRC_OPERACIONES_DET primary key (FECHA, NOM_REFERENCIA, NRO_REGISTRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

