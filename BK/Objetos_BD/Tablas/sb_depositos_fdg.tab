create table IT.SB_DEPOSITOS_FDG
(
  fecha               DATE not null,
  nro_cuenta          VARCHAR2(20) not null,
  mod_sup_rubro       VARCHAR2(6) not null,
  certificado         VARCHAR2(15),
  ind_imp_judicial    NUMBER(1) not null,
  can_titulares       NUMBER(2) not null,
  cod_mon_bco_central VARCHAR2(4) not null,
  capital_ext         NUMBER(17) not null,
  int_devengado_ext   NUMBER(17) not null,
  total_ext           NUMBER(17) not null,
  capital             NUMBER(17) not null,
  int_devengado       NUMBER(17) not null,
  total               NUMBER(17) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_DEPOSITOS_FDG
  is 'Datos de los saldos de los depositos a la fecha limite. Esos depositos deben corresponder a las cuentas especificadas en la Resolucion 10, Articulo 1.';
comment on column IT.SB_DEPOSITOS_FDG.fecha
  is 'Fecha de Proceso.';
comment on column IT.SB_DEPOSITOS_FDG.nro_cuenta
  is 'Codigo identificador de la operacion asignado por la entidad.';
comment on column IT.SB_DEPOSITOS_FDG.mod_sup_rubro
  is 'El segundo modulo de la cuenta segun la Resolucion 10, Art. 1.';
comment on column IT.SB_DEPOSITOS_FDG.certificado
  is 'Si la operacion es para CDA, concatenacion de serie, guion "-" y numero de CDA.';
comment on column IT.SB_DEPOSITOS_FDG.ind_imp_judicial
  is 'Si el deposito es por una importacion o del Poder Judicial. Considera:
- Ley 2334, Art. 1, Inc. g)
- Resolucion 10, Art. 3
Valores:
1= Deposito por Importacion
2= Deposito del Poder Judicial
0= Otros.';
comment on column IT.SB_DEPOSITOS_FDG.can_titulares
  is 'Numero de titulares del deposito.';
comment on column IT.SB_DEPOSITOS_FDG.cod_mon_bco_central
  is 'Codigo de moneda del deposito, el mismo usado en CRC.';
comment on column IT.SB_DEPOSITOS_FDG.capital_ext
  is 'Capital de moneda extranjera arbitrado en US$.';
comment on column IT.SB_DEPOSITOS_FDG.int_devengado_ext
  is 'Interes devengado de moneda extranjera arbitrado en US$.';
comment on column IT.SB_DEPOSITOS_FDG.total_ext
  is 'Suma de Capital-MonExtr e Interes-MonExtr.';
comment on column IT.SB_DEPOSITOS_FDG.capital
  is 'Capital de moneda nacional. Si hubiera Capital-MonExtr, en esta campo se convierte su equivalente a Guaranies.';
comment on column IT.SB_DEPOSITOS_FDG.int_devengado
  is 'Interes devengado de moneda nacional. Si hubiera Interes-MonExtr, en esta campo se convierte su equivalente a Guaranies.';
comment on column IT.SB_DEPOSITOS_FDG.total
  is 'Suma de Capital-MonNac e Interes-MonNac.';
comment on column IT.SB_DEPOSITOS_FDG.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.SB_DEPOSITOS_FDG.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.SB_DEPOSITOS_FDG.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.SB_DEPOSITOS_FDG.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.SB_DEPOSITOS_FDG
  add constraint PK_SB_DEPOSITOS_FDG primary key (FECHA, NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

