create table IT.AH_DEV_BON_SUBORDINADOS
(
  nro_cuenta        VARCHAR2(15) not null,
  cod_modulo        NUMBER(3) not null,
  cod_modalidad     NUMBER(3) not null,
  fecha             DATE not null,
  hora              VARCHAR2(8),
  cod_usuario       VARCHAR2(10),
  nro_secuencia     NUMBER(3),
  monto             NUMBER(18,2) default 0 not null,
  mto_equ_local     NUMBER(18,2) default 0,
  mto_int_acumulado NUMBER(18,2) default 0,
  cod_moneda        VARCHAR2(3) not null,
  cod_transaccion   NUMBER(4),
  cod_tra_alta      NUMBER(4),
  cod_tra_ganancia  NUMBER(4),
  concepto          VARCHAR2(100),
  fec_inicio        DATE not null,
  fec_vencimiento   DATE not null,
  estado            VARCHAR2(1) default 'N' not null,
  mto_dev_anterior  NUMBER(18,2) default 0,
  mto_dev_actual    NUMBER(18,2) default 0 not null,
  mto_dev_acumulado NUMBER(18,2) default 0 not null,
  can_dia_actual    NUMBER(6) default 0 not null,
  can_dia_anterior  NUMBER(6) default 0,
  cod_oficina       NUMBER(3),
  fec_ult_proceso   DATE,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.AH_DEV_BON_SUBORDINADOS.nro_cuenta
  is 'Número de Cuenta afectada.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.cod_modulo
  is 'Módulo de la Comisión Cobrada.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.cod_modalidad
  is 'Modalidad de la Comisión Cobrada.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.fecha
  is 'Fecha del movimiento.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.hora
  is 'Hora del movimiento.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.cod_usuario
  is 'Usuario del movimiento.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.nro_secuencia
  is 'Secuencia del movimiento.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.monto
  is 'Monto del movimiento.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.mto_equ_local
  is 'Importe equivalente en Moneda Local.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.mto_int_acumulado
  is 'Importe de Ganancia por Devengado.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.cod_moneda
  is 'Moneda del movimiento.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.cod_transaccion
  is 'Transacción de la Comisión Cobrada.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.cod_tra_alta
  is 'Transacción al fondear la Cuenta.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.cod_tra_ganancia
  is 'Transacción de Ganancia por Devengado.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.concepto
  is 'Concepto del movimiento.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.fec_inicio
  is 'Fecha de inicio del Devengamiento.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.fec_vencimiento
  is 'Fecha de vencimiento del Devengamiento.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.estado
  is 'Estado del Movimiento(N/Normal, R/Reversado)';
comment on column IT.AH_DEV_BON_SUBORDINADOS.mto_dev_anterior
  is 'Devengado del proceso actual.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.mto_dev_actual
  is 'Devengado del proceso anterior.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.mto_dev_acumulado
  is 'Devengado Acumulado.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.can_dia_actual
  is 'Cantidad actual de días transcurridos.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.can_dia_anterior
  is 'anterior de días transcurridos.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.cod_oficina
  is 'Código de la Oficina de la Cuenta.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.fec_ult_proceso
  is 'Fecha de último Proceso.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.AH_DEV_BON_SUBORDINADOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.AH_DEV_BON_SUBORDINADOS
  add constraint PK_AH_DEV_BON_SUBORDINADOS primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

