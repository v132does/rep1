create table IT.GE_DOC_CATASTROS_HIS
(
  cod_doc_catastro  NUMBER(15) not null,
  cod_persona       VARCHAR2(10) not null,
  nro_cuenta        VARCHAR2(15),
  cod_tip_documento VARCHAR2(1),
  nro_documento     VARCHAR2(20),
  fec_vto_documento DATE,
  observacion       VARCHAR2(400),
  estado            VARCHAR2(1) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  usu_ins_historico VARCHAR2(10),
  fec_ins_historico DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_DOC_CATASTROS_HIS
  is 'Tabla de datos históricos de la tabla GE_DOC_CATASTROS, esta tabla debe ser reflejo de la tabla GE_DOC_CATASTROS, los datos serán insertados desde el proceso PRG_INS_HIS_DOC_CATASTROS.';
comment on column IT.GE_DOC_CATASTROS_HIS.cod_doc_catastro
  is 'Código identificador único de los registros de los documentos de catastro.';
comment on column IT.GE_DOC_CATASTROS_HIS.cod_persona
  is 'Código de la persona cuyo documento se esta catastrando.';
comment on column IT.GE_DOC_CATASTROS_HIS.nro_cuenta
  is 'Número de cuenta cuyo documento se esta catastrando.';
comment on column IT.GE_DOC_CATASTROS_HIS.cod_tip_documento
  is 'Tipo de documento que se esta catastrando (definido en dominio=CAT_TIP_DOCUMENTO)';
comment on column IT.GE_DOC_CATASTROS_HIS.nro_documento
  is 'Número de documento dato no obligatorio.';
comment on column IT.GE_DOC_CATASTROS_HIS.fec_vto_documento
  is 'Fecha de vencimiento del documento.';
comment on column IT.GE_DOC_CATASTROS_HIS.observacion
  is 'Observación sobre el documento catastrado.';
comment on column IT.GE_DOC_CATASTROS_HIS.estado
  is 'Estado de la documentación registrada (definido en BA_COD_REFERENCIAS dominio=CAT_EST_DOCUMENTO).';
comment on column IT.GE_DOC_CATASTROS_HIS.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.GE_DOC_CATASTROS_HIS.fec_insercion
  is 'Fecha de inserción del registro.';
comment on column IT.GE_DOC_CATASTROS_HIS.usu_modificacion
  is 'Último usuario que modificó el registro.';
comment on column IT.GE_DOC_CATASTROS_HIS.fec_modificacion
  is 'Fecha de última actualización del registro.';
comment on column IT.GE_DOC_CATASTROS_HIS.usu_ins_historico
  is 'Usuario que insertó el registro al histórico.';
comment on column IT.GE_DOC_CATASTROS_HIS.fec_ins_historico
  is 'Fecha de inserción del registro al histórico.';
create index IT.IN_GDCAH_COD_PERSONA on IT.GE_DOC_CATASTROS_HIS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

