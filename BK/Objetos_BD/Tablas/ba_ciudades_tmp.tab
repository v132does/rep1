create table IT.BA_CIUDADES_TMP
(
  cod_ciudad       NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  cod_pais         NUMBER(3) not null,
  cod_departamento NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

