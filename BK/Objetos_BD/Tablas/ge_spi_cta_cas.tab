create table IT.GE_SPI_CTA_CAS
(
  nro_referencia      VARCHAR2(33) not null,
  nro_cta_solicitante VARCHAR2(35),
  cli_recordid        VARCHAR2(33),
  cta_recordid        VARCHAR2(33),
  ali_recordid        VARCHAR2(33),
  cod_persona         VARCHAR2(10),
  tip_cuenta          VARCHAR2(3),
  fec_apertura        DATE,
  fec_cancelacion     DATE,
  moneda              VARCHAR2(3),
  cta_por_defecto     VARCHAR2(1),
  error               VARCHAR2(4000),
  est_solicitud       VARCHAR2(1),
  tip_identificador   VARCHAR2(10),
  identificador       VARCHAR2(80),
  usu_insercion       VARCHAR2(10),
  fec_insercion       DATE default sysdate not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default sysdate not null,
  tip_accion          VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SPI_CTA_CAS
  is 'Registro de cuentas en CAS.';
comment on column IT.GE_SPI_CTA_CAS.nro_referencia
  is 'Número de referencia de la solicitud';
comment on column IT.GE_SPI_CTA_CAS.nro_cta_solicitante
  is 'Número de cuenta del solicitante.';
comment on column IT.GE_SPI_CTA_CAS.cli_recordid
  is 'Número identificador del cliente en el módulo CAS.';
comment on column IT.GE_SPI_CTA_CAS.cta_recordid
  is 'Número identificador de la cuenta en el módulo CAS.';
comment on column IT.GE_SPI_CTA_CAS.ali_recordid
  is 'Número identificador del alias en el módulo CAS.';
comment on column IT.GE_SPI_CTA_CAS.cod_persona
  is 'Código de persona solicitante.';
comment on column IT.GE_SPI_CTA_CAS.tip_cuenta
  is 'Tipo de cuenta.
Valores:
CAH- Caja de ahorro
CCO - Cuenta Corriente
CBA - Cuenta básica';
comment on column IT.GE_SPI_CTA_CAS.fec_apertura
  is 'Fecha de apertura de la cuenta.';
comment on column IT.GE_SPI_CTA_CAS.fec_cancelacion
  is 'Fecha de cancelacion de la cuenta. ';
comment on column IT.GE_SPI_CTA_CAS.moneda
  is 'Código de Moneda de la cuenta.';
comment on column IT.GE_SPI_CTA_CAS.cta_por_defecto
  is 'Indicador de cuenta por defecto.
Valores:
''S'' [SI]
''N'' [NO]';
comment on column IT.GE_SPI_CTA_CAS.error
  is 'Detalles de error.';
comment on column IT.GE_SPI_CTA_CAS.est_solicitud
  is 'Estado de la solicitud';
comment on column IT.GE_SPI_CTA_CAS.tip_identificador
  is 'Tipo de identificador.';
comment on column IT.GE_SPI_CTA_CAS.identificador
  is 'Valor del Identificador.';
comment on column IT.GE_SPI_CTA_CAS.tip_accion
  is 'Se identifica si el alta es via web o itgf.
valores
''A'' alta que viene desde la web
''E'' Edicion que viene desde la web
null  via itgf
';
alter table IT.GE_SPI_CTA_CAS
  add constraint PK_NRO_REFERENCIA_CAS primary key (NRO_REFERENCIA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

