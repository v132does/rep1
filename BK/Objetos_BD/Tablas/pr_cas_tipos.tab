create table IT.PR_CAS_TIPOS
(
  cod_cas_tipo     NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_CAS_TIPOS
  is 'Tipos de Cash Colateral.';
comment on column IT.PR_CAS_TIPOS.cod_cas_tipo
  is 'Código del tipo de cash.';
comment on column IT.PR_CAS_TIPOS.descripcion
  is 'Descripción.';
comment on column IT.PR_CAS_TIPOS.cod_modulo
  is 'Código de módulo.';
comment on column IT.PR_CAS_TIPOS.cod_modalidad
  is 'Código de la modalidad.';
comment on column IT.PR_CAS_TIPOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_CAS_TIPOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_CAS_TIPOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_CAS_TIPOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.PR_CAS_TIPOS
  add constraint PK_PR_CAS_TIPOS primary key (COD_CAS_TIPO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_CAS_TIPOS
  add constraint FK_PCTIP_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.PR_CAS_TIPOS
  add constraint AVCON_1099058531_COD_C_000
  check (COD_CAS_TIPO BETWEEN 0 AND 999);
alter table IT.PR_CAS_TIPOS
  add constraint AVCON_1099058531_COD_M_003
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.PR_CAS_TIPOS
  add constraint AVCON_1099058531_COD_M_004
  check (COD_MODALIDAD BETWEEN 0 AND 999);

