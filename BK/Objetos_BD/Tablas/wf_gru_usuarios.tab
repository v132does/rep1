create table IT.WF_GRU_USUARIOS
(
  cod_grupo        VARCHAR2(5) not null,
  cod_usuario      VARCHAR2(10) not null,
  estado           VARCHAR2(1) default 'A' not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  ve_oficinas      VARCHAR2(1) default 'N',
  ver_otr_oficina  VARCHAR2(1),
  exc_usuario      VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.WF_GRU_USUARIOS
  is 'Detalle de usuarios por Grupos.';
comment on column IT.WF_GRU_USUARIOS.cod_grupo
  is 'Codigo de grupo.';
comment on column IT.WF_GRU_USUARIOS.cod_usuario
  is 'Codigo del Usuario.';
comment on column IT.WF_GRU_USUARIOS.estado
  is 'Estado del usuario en el Grupo de usuarios: A-Activo I-Inactivo.';
comment on column IT.WF_GRU_USUARIOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.WF_GRU_USUARIOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.WF_GRU_USUARIOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.WF_GRU_USUARIOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.WF_GRU_USUARIOS.ve_oficinas
  is 'Indica si el usuario puede ver todas las oficinas.';
comment on column IT.WF_GRU_USUARIOS.ver_otr_oficina
  is 'Permiso para poder visualizar tareas pendientes de otras oficinas.';
comment on column IT.WF_GRU_USUARIOS.exc_usuario
  is 'Indica que el usuario ser¿ excluido de la asignaci¿n de tareas.';
create index IT.IN_WF_GRU_USUARIOS_COD on IT.WF_GRU_USUARIOS (COD_USUARIO, COD_GRUPO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.WF_GRU_USUARIOS
  add constraint PK_WF_GRU_USUARIOS primary key (COD_GRUPO, COD_USUARIO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

