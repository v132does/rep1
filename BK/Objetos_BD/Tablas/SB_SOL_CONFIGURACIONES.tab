-- =====================================================================
-- TABLA: IT.SB_SOL_CONFIGURACIONES
-- Descripción: Configuración de rubros y categorías de solvencia
-- =====================================================================

CREATE TABLE IT.SB_SOL_CONFIGURACIONES (
    CLASIFICACION   VARCHAR2(1),
    COD_RUBRO       VARCHAR2(15),
    CATEGORIA       VARCHAR2(10),
    COD_RUBRO_RTP   VARCHAR2(15),
    DESCRIPCION     VARCHAR2(200),
    ORDEN           NUMBER
)
LOGGING
TABLESPACE IT_DATA
PCTFREE 10
INITRANS 1
STORAGE (
    INITIAL    65536
    NEXT       1048576
    MINEXTENTS 1
    MAXEXTENTS UNLIMITED
    BUFFER_POOL DEFAULT
)
NOCOMPRESS
NO INMEMORY
NOPARALLEL;

CREATE INDEX IT.IN_SOL_CFG_COD_RUBRO  ON IT.SB_SOL_CONFIGURACIONES(COD_RUBRO) TABLESPACE IT_IND;
CREATE INDEX IT.IN_SOL_CFG_CATEGORIA  ON IT.SB_SOL_CONFIGURACIONES(CATEGORIA) TABLESPACE IT_IND;

CREATE OR REPLACE SYNONYM SB_SOL_CONFIGURACIONES FOR IT.SB_SOL_CONFIGURACIONES;

COMMENT ON TABLE IT.SB_SOL_CONFIGURACIONES IS 'Configuracion de rubros y categorias de solvencia para el informe regulatorio BCP';
COMMENT ON COLUMN IT.SB_SOL_CONFIGURACIONES.CLASIFICACION IS 'Clasificacion del rubro (a, b, c, d, e, f)';
COMMENT ON COLUMN IT.SB_SOL_CONFIGURACIONES.COD_RUBRO IS 'Codigo del rubro contable';
COMMENT ON COLUMN IT.SB_SOL_CONFIGURACIONES.CATEGORIA IS 'Categoria de solvencia a la que pertenece el rubro';
COMMENT ON COLUMN IT.SB_SOL_CONFIGURACIONES.COD_RUBRO_RTP IS 'Codigo del rubro en el sistema RTP';
COMMENT ON COLUMN IT.SB_SOL_CONFIGURACIONES.DESCRIPCION IS 'Descripcion del rubro o concepto de solvencia';
COMMENT ON COLUMN IT.SB_SOL_CONFIGURACIONES.ORDEN IS 'Orden de presentacion en los informes de solvencia';
