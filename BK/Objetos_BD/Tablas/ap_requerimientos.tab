create index IT.IN_YREQU_COD_USUARIO on IT.AP_REQUERIMIENTOS (COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_YREQU_COD_USU_RESPONSABLE on IT.AP_REQUERIMIENTOS (COD_USU_RESPONSABLE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AP_REQUERIMIENTOS
  add constraint PK_AP_REQUERIMIENTOS primary key (COD_REQUERIMIENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AP_REQUERIMIENTOS
  add constraint FK_YREQU_COD_PROYECTO foreign key (COD_PROYECTO, COD_PLAN)
  references IT.AP_PROYECTOS (COD_PROYECTO, COD_PLAN);
alter table IT.AP_REQUERIMIENTOS
  add constraint FK_YREQU_COD_TIP_REQUERIMIENT foreign key (COD_TIP_REQUERIMIENTO)
  references IT.AP_TIP_REQUERIMIENTOS (COD_TIP_REQUERIMIENTO);
alter table IT.AP_REQUERIMIENTOS
  add constraint FK_YREQU_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.AP_REQUERIMIENTOS
  add constraint FK_YREQU_COD_USU_RESPONSABLE foreign key (COD_USU_RESPONSABLE)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.AP_REQUERIMIENTOS
  add constraint AVCON_1081349332_COD_P_007
  check (COD_PROYECTO BETWEEN 1 AND 999999999);
alter table IT.AP_REQUERIMIENTOS
  add constraint AVCON_1081349332_COD_P_008
  check (COD_PLAN BETWEEN 1 AND 999999999);
alter table IT.AP_REQUERIMIENTOS
  add constraint AVCON_1081349332_COD_R_002
  check (COD_REQUERIMIENTO BETWEEN 1 AND 999999999);
alter table IT.AP_REQUERIMIENTOS
  add constraint AVCON_1081349332_COD_T_002
  check (COD_TIP_REQUERIMIENTO BETWEEN 1 AND 999);
alter table IT.AP_REQUERIMIENTOS
  add constraint AVCON_1081349332_ESTAD_000
  check (ESTADO IN ('P', 'A', 'C'));
alter table IT.AP_REQUERIMIENTOS
  add constraint AVCON_1081349332_PRIOR_000
  check (PRIORIDAD IN (1, 2, 3, 4));
alter table IT.AP_REQUERIMIENTOS
  add constraint AVCON_1081349332_SITUA_000
  check (SITUACION IN ('NI', 'DE', 'AV', 'EV', 'FI', 'PO', 'CA'));

