create table IT.AP_REQUERIMIENTOS
(
  cod_requerimiento     NUMBER(10) not null,
  cod_tip_requerimiento NUMBER(3) not null,
  cod_usuario           VARCHAR2(10) not null,
  descripcion           VARCHAR2(60) not null,
  mto_ejecutado         NUMBER(18,2) default 0 not null,
  des_detallada         VARCHAR2(2000) not null,
  fec_solicitud         DATE not null,
  estado                VARCHAR2(15) default 'P' not null,
  situacion             VARCHAR2(2) default 'NI' not null,
  prioridad             NUMBER(1) default 4 not null,
  orden                 NUMBER(3) default 999 not null,
  cod_usu_responsable   VARCHAR2(10),
  cod_proyecto          NUMBER(10),
  cod_plan              NUMBER(10),
  fec_inicio            DATE,
  fec_fin               DATE,
  duracion              NUMBER(4),
  por_avance            NUMBER(5,2) default 0,
  fec_ini_real          DATE,
  fec_fin_real          DATE,
  dur_real              NUMBER(4),
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default SYSDATE not null,
  not_responsable       VARCHAR2(1000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AP_REQUERIMIENTOS
  is 'Requerimientos.';
comment on column IT.AP_REQUERIMIENTOS.cod_requerimiento
  is 'Codigo del Requerimiento.';
comment on column IT.AP_REQUERIMIENTOS.cod_tip_requerimiento
  is 'Codigo del Tipo de Requerimiento.';
comment on column IT.AP_REQUERIMIENTOS.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.AP_REQUERIMIENTOS.descripcion
  is 'Descripcion Breve.';
comment on column IT.AP_REQUERIMIENTOS.mto_ejecutado
  is 'Monto Ejecutado.';
comment on column IT.AP_REQUERIMIENTOS.des_detallada
  is 'Descripcion Detallada.';
comment on column IT.AP_REQUERIMIENTOS.fec_solicitud
  is 'Fecha de Solicitud.';
comment on column IT.AP_REQUERIMIENTOS.estado
  is 'Estado del Requerimiento.';
comment on column IT.AP_REQUERIMIENTOS.situacion
  is 'Situacion del Requerimiento.';
comment on column IT.AP_REQUERIMIENTOS.prioridad
  is 'Prioridad.';
comment on column IT.AP_REQUERIMIENTOS.orden
  is 'Orden.';
comment on column IT.AP_REQUERIMIENTOS.cod_usu_responsable
  is 'Codigo de usuario.';
comment on column IT.AP_REQUERIMIENTOS.cod_proyecto
  is 'Identificador del Proyecto.';
comment on column IT.AP_REQUERIMIENTOS.cod_plan
  is 'Identificador del Plan.';
comment on column IT.AP_REQUERIMIENTOS.fec_inicio
  is 'Fecha de Inicio.';
comment on column IT.AP_REQUERIMIENTOS.fec_fin
  is 'Fecha de Fin.';
comment on column IT.AP_REQUERIMIENTOS.duracion
  is 'Duracion.';
comment on column IT.AP_REQUERIMIENTOS.por_avance
  is 'Porcentaje de Avance.';
comment on column IT.AP_REQUERIMIENTOS.fec_ini_real
  is 'Fecha de Inicio Real.';
comment on column IT.AP_REQUERIMIENTOS.fec_fin_real
  is 'Fecha de Fin Real.';
comment on column IT.AP_REQUERIMIENTOS.dur_real
  is 'Duracion Real.';
comment on column IT.AP_REQUERIMIENTOS.usu_insercion
  is 'Usuario que inserta.';
comment on column IT.AP_REQUERIMIENTOS.fec_insercion
  is 'Fecha de Insercion.';
comment on column IT.AP_REQUERIMIENTOS.usu_modificacion
  is 'Usuario que modificacion.';
comment on column IT.AP_REQUERIMIENTOS.fec_modificacion
  is 'Fecha de modificacion.';
comment on column IT.AP_REQUERIMIENTOS.not_responsable
  is 'Observacion.';
create index IT.IN_YREQU_COD_PROYECTO on IT.AP_REQUERIMIENTOS (COD_PROYECTO, COD_PLAN)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_YREQU_COD_TIP_REQUERIMIENTO on IT.AP_REQUERIMIENTOS (COD_TIP_REQUERIMIENTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
