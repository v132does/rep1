create table IT.TA_CTA_DEB_AUT_COBRAR
(
  nro_cuenta       VARCHAR2(15) not null,
  nro_tarjeta      VARCHAR2(25) not null,
  nro_cta_debito   VARCHAR2(15),
  fec_proceso      DATE not null,
  monto            NUMBER(18,2) default 0 not null,
  estado           VARCHAR2(1) not null,
  fec_valor        DATE not null,
  observacion      VARCHAR2(50),
  est_envio        VARCHAR2(1) default 'P',
  hora             VARCHAR2(8),
  cod_usuario      VARCHAR2(10),
  dia_mora         NUMBER(5),
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  cod_oficina      NUMBER(3),
  cod_moneda       VARCHAR2(3),
  referencia       VARCHAR2(20),
  mto_cobrado      NUMBER(18,2) default 0 not null,
  mto_pag_minimo   NUMBER(18,2) default 0,
  cod_persona      VARCHAR2(10),
  deb_automatico   VARCHAR2(1),
  mto_mora         NUMBER(18,2) default 0,
  can_pagos        NUMBER(5) default 0,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_CTA_DEB_AUT_COBRAR
  is 'Contiene los datos de los cobros realizados hasta la fecha. Esta tabla se utiliza para enviar a las administradoras los cobros recibidos en el dia. (fba120.fecha del dia).  ** Mantener seis meses **';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.nro_tarjeta
  is 'Numero de Tarjeta.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.nro_cta_debito
  is 'Numero de Cuenta.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.fec_proceso
  is 'Fecha de Proceso.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.monto
  is 'Importe de debito.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.estado
  is 'Estado del Registro: C-Cobrado en Caja P-Procesado por debito en cuenta E-No procesado por error.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.fec_valor
  is 'Fecha Valor del Pago.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.observacion
  is 'Observaciones, en caso de que hubo error descripcion del Error...';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.est_envio
  is 'Estado de Envio a la Procesadora P=Pendiente, E=Enviado, W=Webservice Bancard.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.hora
  is 'Hora.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.dia_mora
  is 'Dias de Mora en el momento del cobro.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.cod_modulo
  is 'Codigo de Modulo';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.cod_modalidad
  is 'Codigo de Modalidad';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.cod_oficina
  is 'Codigo de Oficina';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.cod_moneda
  is 'Codigo de Moneda';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.referencia
  is 'Referencia de ayuda para Identificacion';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.mto_cobrado
  is 'Monto cobrado en el dia';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.mto_pag_minimo
  is 'Monto de Pago Minimo';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.cod_persona
  is 'Codigo de Persona';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.deb_automatico
  is 'Debito Automatico';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.mto_mora
  is 'Monto en Mora';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.can_pagos
  is 'Cantidad de Pagos verificados';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_CTA_DEB_AUT_COBRAR.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_TCOBC_FEC_PROCESO on IT.TA_CTA_DEB_AUT_COBRAR (FEC_PROCESO, NRO_TARJETA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 576K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCOBC_NRO_CTA_DEBITO on IT.TA_CTA_DEB_AUT_COBRAR (NRO_CTA_DEBITO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 192K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCOBC_NRO_CUENTA on IT.TA_CTA_DEB_AUT_COBRAR (NRO_CUENTA, NRO_TARJETA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 640K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_CTA_DEB_AUT_COBRAR
  add constraint PK_TA_CTA_DEB_AUT_COBRAR primary key (NRO_CUENTA);

