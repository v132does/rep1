create global temporary table IT.STAGE_SS2K5_SQL_MODULES
(
  svrid_fk    NUMBER(38),
  dbid_gen_fk NUMBER(38),
  objid_gen   NUMBER(38),
  definition  CLOB,
  object_id   NUMBER(38) not null
)
on commit preserve rows;
create index IT.S_SS2K5_SQL_MS_DBID_GEN_FK on IT.STAGE_SS2K5_SQL_MODULES (DBID_GEN_FK);
create index IT.S_SS2K5_SQL_MS_OBJECT_ID on IT.STAGE_SS2K5_SQL_MODULES (OBJECT_ID);

