create table IT.BA_OFICINAS
(
  cod_oficina       NUMBER(3) not null,
  descripcion       VARCHAR2(35) not null,
  cod_ciudad        NUMBER(3) not null,
  cod_pais          NUMBER(3) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_ofi_cambio    NUMBER(3),
  direccion         VARCHAR2(60) not null,
  telefono          VARCHAR2(60) not null,
  sigla             VARCHAR2(4),
  cod_usu_encargado VARCHAR2(10),
  cod_gru_oficina   NUMBER(3),
  cod_ofi_camara    NUMBER(3),
  estado            VARCHAR2(1) default 'A' not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_OFICINAS
  is 'Oficinas.';
comment on column IT.BA_OFICINAS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.BA_OFICINAS.descripcion
  is 'Nombre de la oficina.';
comment on column IT.BA_OFICINAS.cod_ciudad
  is 'Codigo de Ciudad.';
comment on column IT.BA_OFICINAS.cod_pais
  is 'Codigo del pais.';
comment on column IT.BA_OFICINAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_OFICINAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_OFICINAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_OFICINAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.BA_OFICINAS.cod_ofi_cambio
  is 'Codigo de oficina de cambio.';
comment on column IT.BA_OFICINAS.direccion
  is 'Direccion principal.';
comment on column IT.BA_OFICINAS.telefono
  is 'Numero de telefono principal.';
comment on column IT.BA_OFICINAS.sigla
  is 'Sigla de la Oficina.';
comment on column IT.BA_OFICINAS.cod_usu_encargado
  is 'Usuario encargado de la oficina.';
comment on column IT.BA_OFICINAS.cod_gru_oficina
  is 'Grupo al que pertenece la oficina.';
comment on column IT.BA_OFICINAS.cod_ofi_camara
  is 'Codigo de oficina de camara.';
comment on column IT.BA_OFICINAS.estado
  is 'Estado de la Oficina (Activo/Inactivo).';
create index IT.BA_OFI_CHE on IT.BA_OFICINAS (COD_OFI_CAMARA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_EOFIC_COD_CIUDAD on IT.BA_OFICINAS (COD_CIUDAD, COD_PAIS)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_EOFIC_COD_OFI_CAMBIO on IT.BA_OFICINAS (COD_OFI_CAMBIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_OFICINAS
  add constraint PK_BA_OFICINAS primary key (COD_OFICINA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_OFICINAS
  add constraint FK_EOFIC_COD_CIUDAD foreign key (COD_CIUDAD, COD_PAIS)
  references IT.BA_CIUDADES (COD_CIUDAD, COD_PAIS);
alter table IT.BA_OFICINAS
  add constraint FK_EOFIC_COD_GRU_OFICINA foreign key (COD_GRU_OFICINA)
  references IT.BA_GRU_OFICINAS (COD_GRU_OFICINA);
alter table IT.BA_OFICINAS
  add constraint FK_EOFIC_COD_OFI_CAMARA foreign key (COD_OFI_CAMARA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.BA_OFICINAS
  add constraint FK_EOFIC_COD_OFI_CAMBIO foreign key (COD_OFI_CAMBIO)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.BA_OFICINAS
  add constraint FK_EOFIC_COD_USU_ENCARGADO foreign key (COD_USU_ENCARGADO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.BA_OFICINAS
  add constraint AVCON_1082384226_COD_O_004
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.BA_OFICINAS
  add constraint AVCON_1082384226_COD_O_005
  check (COD_OFI_CAMBIO BETWEEN 0 AND 999);
alter table IT.BA_OFICINAS
  add constraint AVCON_1082384226_COD_P_003
  check (COD_PAIS BETWEEN 0 AND 999);
alter table IT.BA_OFICINAS
  add constraint AVCON_1105113752_COD_O_002
  check (COD_OFI_CAMARA BETWEEN 0 AND 999);

