create table IT.GE_SUB_MODALIDADES
(
  cod_modulo        NUMBER(3) not null,
  cod_modalidad     NUMBER(3) not null,
  cod_sub_modalidad NUMBER(3) not null,
  descripcion       VARCHAR2(60) not null,
  referencia        VARCHAR2(10),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SUB_MODALIDADES
  is 'Sub Modalidades de Cuentas.';
comment on column IT.GE_SUB_MODALIDADES.cod_modulo
  is 'Código de Módulo.';
comment on column IT.GE_SUB_MODALIDADES.cod_modalidad
  is 'Código de Modalidad.';
comment on column IT.GE_SUB_MODALIDADES.cod_sub_modalidad
  is 'Código de Sub Modalidad.';
comment on column IT.GE_SUB_MODALIDADES.descripcion
  is 'Descripción de la Sub Modalidad.';
comment on column IT.GE_SUB_MODALIDADES.referencia
  is 'Código de Referencia Externa.';
comment on column IT.GE_SUB_MODALIDADES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_SUB_MODALIDADES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_SUB_MODALIDADES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_SUB_MODALIDADES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.GE_SUB_MODALIDADES
  add constraint PK_GE_SUB_MODALIDADES primary key (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SUB_MODALIDADES
  add constraint FK_GSUBMOD_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_SUB_MODALIDADES
  add constraint FK_GSUBMOD_COD_MODULO foreign key (COD_MODULO)
  references IT.BA_MODULOS (COD_MODULO);

