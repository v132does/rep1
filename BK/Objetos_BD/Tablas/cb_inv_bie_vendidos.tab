create table IT.CB_INV_BIE_VENDIDOS
(
  cod_persona      VARCHAR2(10),
  nombre           VARCHAR2(120),
  rubro_activo     VARCHAR2(15),
  rubro_ganancia   VARCHAR2(15),
  cod_moneda       VARCHAR2(3),
  fec_alta         DATE,
  fec_vencimiento  DATE,
  mto_cuota        NUMBER(18,2),
  mto_ganancia     NUMBER(18,2),
  cuotas           NUMBER,
  estado           VARCHAR2(15),
  fec_ult_cobro    DATE,
  cuo_pendientes   NUMBER,
  cuo_vencidas     NUMBER,
  fec_proximo_vto  DATE,
  sal_actual       NUMBER(18,2),
  sal_ganancia     NUMBER(18,2),
  observacion      VARCHAR2(400),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.CB_INV_BIE_VENDIDOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_INV_BIE_VENDIDOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_INV_BIE_VENDIDOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_INV_BIE_VENDIDOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

