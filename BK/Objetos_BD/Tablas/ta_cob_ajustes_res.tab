create table IT.TA_COB_AJUSTES_RES
(
  nro_cob_dia      NUMBER(18),
  tip_registro     NUMBER(1),
  cod_ent_emisora  VARCHAR2(5),
  cod_ide_archivo  VARCHAR2(8),
  can_registros    VARCHAR2(9),
  filler           VARCHAR2(245),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_COB_AJUSTES_RES.nro_cob_dia
  is 'Nro. Cobro diario.';
comment on column IT.TA_COB_AJUSTES_RES.tip_registro
  is '3 - Trailer.';
comment on column IT.TA_COB_AJUSTES_RES.cod_ent_emisora
  is 'Código asignado a la Entidad Otorgante.';
comment on column IT.TA_COB_AJUSTES_RES.cod_ide_archivo
  is 'T3022D.';
comment on column IT.TA_COB_AJUSTES_RES.can_registros
  is 'Cantidad de registros de detalle informados.';
comment on column IT.TA_COB_AJUSTES_RES.filler
  is 'Espacios.';
comment on column IT.TA_COB_AJUSTES_RES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_COB_AJUSTES_RES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_COB_AJUSTES_RES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_COB_AJUSTES_RES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

