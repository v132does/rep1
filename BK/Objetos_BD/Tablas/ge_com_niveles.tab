
CREATE TABLE GE_COM_NIVELES
(
   COD_NIVEL         VARCHAR2(20 Byte)    NOT NULL,
   NOM_NIVEL         VARCHAR2(100 Byte)   NOT NULL,
   POR_REINTEGRO     NUMBER(10,2)
)
TABLESPACE IT_DATA;

CREATE INDEX IN_COM_NIVELES_COD_NIVEL
   ON GE_COM_NIVELES (COD_NIVEL ASC)
   TABLESPACE IT_IND;

CREATE INDEX IN_COM_NIVELES_NOM_NIVEL
   ON GE_COM_NIVELES (NOM_NIVEL ASC)
   TABLESPACE IT_IND;


GRANT ALTER, INSERT, SELECT, UPDATE, DEBUG, FLASHBACK, DELETE, ON COMMIT REFRESH, QUERY REWRITE, READ ON GE_COM_NIVELES TO IT_TEMPORAL;
