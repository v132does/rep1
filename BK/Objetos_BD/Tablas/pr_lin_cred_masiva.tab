create table IT.PR_LIN_CRED_MASIVA
(
  cod_persona      VARCHAR2(10),
  nom_persona      VARCHAR2(200),
  cod_moneda       VARCHAR2(3),
  mto_limite       NUMBER(18,2),
  fec_inicio       DATE,
  cod_tip_garantia NUMBER(3),
  mto_garantia     NUMBER(18,2),
  cod_modalidad    NUMBER(3),
  mto_modalidad    NUMBER(18,2),
  descripcion      VARCHAR2(60),
  observacion      VARCHAR2(1000),
  fec_fin          DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

