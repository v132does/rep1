create table IT.CB_COR_PARAMETROS
(
  cod_parametro VARCHAR2(100) not null,
  orden         NUMBER not null,
  descripcion   VARCHAR2(250),
  cod_proceso   VARCHAR2(50) not null,
  tipo          VARCHAR2(10) default 'STRING'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_COR_PARAMETROS
  add constraint PK_COR_PARAMETROS primary key (COD_PARAMETRO, COD_PROCESO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 3M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_COR_PARAMETROS
  add constraint FK_COR_PAR foreign key (COD_PROCESO)
  references IT.CB_COR_PROCESOS (COD_PROCESO);

