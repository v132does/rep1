create table IT.RH_TIP_DESEMPENOS
(
  cod_tip_desempeno NUMBER(3) not null,
  descripcion       VARCHAR2(50) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_TIP_DESEMPENOS
  is 'Tipos de Desempeños.';
comment on column IT.RH_TIP_DESEMPENOS.cod_tip_desempeno
  is 'Codigo del Tipo de Desempeño.';
comment on column IT.RH_TIP_DESEMPENOS.descripcion
  is 'Descripcion del tipo de desempeño.';
comment on column IT.RH_TIP_DESEMPENOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_TIP_DESEMPENOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_TIP_DESEMPENOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_TIP_DESEMPENOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.RH_TIP_DESEMPENOS
  add constraint PK_RH_TIP_DESEMPENOS primary key (COD_TIP_DESEMPENO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_TIP_DESEMPENOS
  add constraint UK_HTDEM_DESCRIPCION unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

