create table IT.MI_SB_CRC_OPE_GARANTIAS_DET_TMP
(
  fecha                 DATE not null,
  nom_referencia        VARCHAR2(10) not null,
  nro_registro          NUMBER(9) not null,
  nro_formulario        VARCHAR2(3),
  cod_ofi_operacion     NUMBER(3),
  tip_operacion         NUMBER(3),
  nro_operacion         VARCHAR2(60),
  cod_mon_iso_operacion VARCHAR2(3),
  cod_ofi_garantia      NUMBER(4),
  cod_mon_iso_garantia  VARCHAR2(3),
  nro_garantia          NUMBER(7),
  cod_ref_bco_central   NUMBER(2),
  rub_con_garantia      VARCHAR2(18),
  mto_utilizado         NUMBER(18,2),
  mto_equ_utilizado     NUMBER(18,2),
  tip_gar_especifica    VARCHAR2(1),
  cod_modulo            NUMBER(3),
  cod_modalidad         NUMBER(3),
  cod_persona           VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

