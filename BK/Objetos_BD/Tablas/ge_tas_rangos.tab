create table IT.GE_TAS_RANGOS
(
  cod_tasa          NUMBER(3) not null,
  fec_vigencia      DATE not null,
  cod_oficina       NUMBER(3),
  cod_moneda        VARCHAR2(3),
  cod_modulo        NUMBER(3),
  cod_modalidad     NUMBER(3),
  nro_cuenta        VARCHAR2(15),
  val_hasta         NUMBER(18,2) default 0 not null,
  val_tasa          NUMBER(20,4),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_sub_modalidad NUMBER(3),
  no_actualizable   VARCHAR2(1),
  val_extension     NUMBER(20,4),
  cod_persona       VARCHAR2(10),
  observaciones     VARCHAR2(100),
  fec_vencimiento   DATE,
  cod_ente          NUMBER(5)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_TAS_RANGOS
  is 'Tasas por Rango.';
comment on column IT.GE_TAS_RANGOS.cod_tasa
  is 'Codigo de tasa.';
comment on column IT.GE_TAS_RANGOS.fec_vigencia
  is 'Fecha de vigencia.';
comment on column IT.GE_TAS_RANGOS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.GE_TAS_RANGOS.cod_moneda
  is 'Moneda.';
comment on column IT.GE_TAS_RANGOS.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.GE_TAS_RANGOS.cod_modalidad
  is 'Codigo de la Modalidad.';
comment on column IT.GE_TAS_RANGOS.nro_cuenta
  is 'Numero de cuenta a ser personalizada.';
comment on column IT.GE_TAS_RANGOS.val_hasta
  is 'Valor hasta.';
comment on column IT.GE_TAS_RANGOS.val_tasa
  is 'Valor de la tasa.';
comment on column IT.GE_TAS_RANGOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_TAS_RANGOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_TAS_RANGOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_TAS_RANGOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_TAS_RANGOS.cod_sub_modalidad
  is 'Código de Sub Modalidad';
comment on column IT.GE_TAS_RANGOS.no_actualizable
  is 'Indicador de Tasa no Actualizable por el proceso que calculo las tasas por moneda diferentes a la base.';
comment on column IT.GE_TAS_RANGOS.val_extension
  is 'Valor de extension o Spread.';
comment on column IT.GE_TAS_RANGOS.cod_persona
  is 'Codigo de la persona cuya tasa sera personalizada.';
comment on column IT.GE_TAS_RANGOS.observaciones
  is 'Observaciones.';
comment on column IT.GE_TAS_RANGOS.fec_vencimiento
  is 'Fecha de Vencimiento.';
comment on column IT.GE_TAS_RANGOS.cod_ente
  is 'Código de Ente.';
create index IT.IN_GTRAN_COD_PERSONA on IT.GE_TAS_RANGOS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GTRNG_NRO_CUENTA on IT.GE_TAS_RANGOS (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_TAS_RANGOS
  add constraint UK_GE_TAS_RANGOS unique (COD_TASA, FEC_VIGENCIA, COD_OFICINA, COD_MONEDA, COD_MODULO, COD_MODALIDAD, NRO_CUENTA, VAL_HASTA, COD_PERSONA, COD_SUB_MODALIDAD, COD_ENTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_TAS_RANGOS
  add constraint FK_GTRNG_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_TAS_RANGOS
  add constraint FK_GTRNG_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_TAS_RANGOS
  add constraint FK_GTRNG_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_TAS_RANGOS
  add constraint FK_GTRNG_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_TAS_RANGOS
  add constraint FK_GTRNG_COD_SUB_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD)
  references IT.GE_SUB_MODALIDADES (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD);
alter table IT.GE_TAS_RANGOS
  add constraint FK_GTRNG_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.GE_TAS_RANGOS
  add constraint FK_GTRNG_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.GE_TAS_RANGOS
  add constraint CK_GTRAN_SPREAD
  check (((nro_cuenta is not null or cod_persona is not null) and
    ((val_tasa is null and val_extension is not null)
   or
     (val_tasa is not null and val_extension is null)))
or
(nro_cuenta is null and cod_persona is null and
    (val_tasa is not null and val_extension is null)));
alter table IT.GE_TAS_RANGOS
  add constraint CK_GTVAR_FEC_VENCIMIENTO
  check (fec_vencimiento is not null and (nro_cuenta is not null or cod_persona is not null) or
           (nro_cuenta is null and cod_persona is null));
alter table IT.GE_TAS_RANGOS
  add constraint CK_MAX_VAL_EXTENSION
  check (val_extension <=100);

