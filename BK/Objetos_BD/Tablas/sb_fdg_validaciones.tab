create table IT.SB_FDG_VALIDACIONES
(
  fecha            DATE,
  nro_cuenta       VARCHAR2(20),
  cod_persona      VARCHAR2(20),
  mensaje          VARCHAR2(300),
  nom_tabla        VARCHAR2(100),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.SB_FDG_VALIDACIONES.fecha
  is 'Fecha de Proceso.';
comment on column IT.SB_FDG_VALIDACIONES.nro_cuenta
  is 'Número de Cuenta.';
comment on column IT.SB_FDG_VALIDACIONES.cod_persona
  is 'Código de Persona.';
comment on column IT.SB_FDG_VALIDACIONES.mensaje
  is 'Mensaje de la Validación.';
comment on column IT.SB_FDG_VALIDACIONES.nom_tabla
  is 'Tabla Asociada al Mensaje de la Validación.';
comment on column IT.SB_FDG_VALIDACIONES.usu_insercion
  is 'Usuario que Realizó la Inserción del Registro.';
comment on column IT.SB_FDG_VALIDACIONES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.SB_FDG_VALIDACIONES.usu_modificacion
  is 'Usuario que realizó la ultima modificación en el registro.';
comment on column IT.SB_FDG_VALIDACIONES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';

