alter table IT.PR_CTA_PRESTAMOS
  add constraint PK_PR_CTA_PRESTAMOS primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 3M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_BANCA foreign key (COD_BANCA)
  references IT.GE_BANCAS (COD_BANCA);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_CANAL foreign key (COD_CANAL)
  references IT.GE_CANALES (COD_CANAL);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_CAUSA foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_ENT_JUICIO foreign key (COD_ENT_JUICIO)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_ORI_FONDO foreign key (COD_ORI_FONDO)
  references IT.PR_FONDOS (COD_ORI_FONDO);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_RUB_ECONOMICO foreign key (COD_RUB_ECONOMICO)
  references IT.PR_RUB_ECONOMICOS (COD_RUB_ECONOMICO);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_SEC_CREDITO foreign key (COD_SEC_CREDITO)
  references IT.PR_SEC_CREDITOS (COD_SEC_CREDITO);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_COD_SUB_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD)
  references IT.GE_SUB_MODALIDADES (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_ESTADO foreign key (COD_MODULO, COD_MODALIDAD, ESTADO)
  references IT.GE_EST_CUENTAS (COD_MODULO, COD_MODALIDAD, ESTADO);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_EST_ANTERIOR foreign key (COD_MODULO, COD_MODALIDAD, EST_ANTERIOR)
  references IT.GE_EST_CUENTAS (COD_MODULO, COD_MODALIDAD, ESTADO);
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_NRO_CTA_DEBITO foreign key (NRO_CTA_DEBITO)
  references IT.GE_CUENTAS (NRO_CUENTA)
  disable
  novalidate;
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_NRO_CTA_RENOVADA foreign key (NRO_CTA_RENOVADA)
  references IT.GE_CUENTAS (NRO_CUENTA)
  disable
  novalidate;
alter table IT.PR_CTA_PRESTAMOS
  add constraint FK_PCPRE_NRO_LINEA foreign key (NRO_LINEA)
  references IT.PR_LINEAS (NRO_LINEA);
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1080845005_COB_A_000
  check (COB_AUTOMATICO IN ('S', 'N'));
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1080845005_EST_B_000
  check (EST_BATCH IN ('C', 'G', 'I', 'M', 'N', 'V'));
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1080845005_EXO_I_001
  check (EXO_IMPUESTOS IN ('S', 'N'));
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1080845005_TIP_D_002
  check (TIP_DOCUMENTO IN ('1', '2'));
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1080845005_TIPO_002
  check (TIPO IN ('A', 'P', 'D'));
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1083790179_COD_C_000
  check (COD_CAUSA BETWEEN 0 AND 999);
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1083790179_COD_C_001
  check (COD_CANAL BETWEEN 0 AND 999);
