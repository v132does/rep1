comment on column IT.PR_CTA_PRESTAMOS.per_vto_interes
  is 'Periodo de Vencimiento del Interés.';
comment on column IT.PR_CTA_PRESTAMOS.dev_suspenso
  is 'Devengado en Suspenso.';
comment on column IT.PR_CTA_PRESTAMOS.tip_interes
  is 'Tipo de Interés (A=Adelantado / V=Vencido).';
comment on column IT.PR_CTA_PRESTAMOS.fec_juicio
  is 'Fecha en la cual pasó a Juicio.';
comment on column IT.PR_CTA_PRESTAMOS.cod_ent_juicio
  is 'Ente al cual se derivó el Juicio.';
comment on column IT.PR_CTA_PRESTAMOS.cat_renovaciones
  is 'Categoría de las Renovaciones, Refinanciaciones o Restructuraciones.';
comment on column IT.PR_CTA_PRESTAMOS.en_juicio
  is 'Indica si el Préstamo se encuentra en estado Judicial.';
comment on column IT.PR_CTA_PRESTAMOS.cod_banca
  is 'Código de Banca.';
comment on column IT.PR_CTA_PRESTAMOS.mto_mora
  is 'Monto en Mora.';
comment on column IT.PR_CTA_PRESTAMOS.por_ori_fondo
  is 'Porcentaje correspondiente al Origen de Fondos.';
comment on column IT.PR_CTA_PRESTAMOS.fec_ren_tas_orig
  is 'Fecha de Renegociación de la Tasa Original.';
comment on column IT.PR_CTA_PRESTAMOS.fec_ren_tas
  is 'Fecha de Renegociación de la Tasa Pactada con el Cliente.';
comment on column IT.PR_CTA_PRESTAMOS.cod_sub_modalidad
  is 'Código de Sub-Modalidad.';
comment on column IT.PR_CTA_PRESTAMOS.cod_rub_economico
  is 'Código de Rubro Económico.';
comment on column IT.PR_CTA_PRESTAMOS.nro_cta_novada
  is 'Registra el número de cuenta renovada correspondiente a operaciones Nuevas.';
comment on column IT.PR_CTA_PRESTAMOS.fec_ult_categorizacion
  is 'Registra la última fecha que mejoró la categoría.';
comment on column IT.PR_CTA_PRESTAMOS.fec_ini_rrr
  is 'Fecha de Inicio del Préstamo para Operaciones RRR por Cuotas';
