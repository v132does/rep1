  add constraint AVCON_1083790179_COD_M_003
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1083790179_COD_O_002
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1083790179_COD_S_001
  check (COD_SEC_CREDITO BETWEEN 0 AND 999);
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1093719058_TIP_I_001
  check (TIP_INTERES IN ('V', 'A'));
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1104184845_COD_O_003
  check (COD_ORI_FONDO BETWEEN 0 AND 999);
alter table IT.PR_CTA_PRESTAMOS
  add constraint AVCON_1112384627_EN_JU_000
