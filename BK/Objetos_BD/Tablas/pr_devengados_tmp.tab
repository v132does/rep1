create table IT.PR_DEVENGADOS_TMP
(
  nro_cuenta        VARCHAR2(15) not null,
  fec_inicio        DATE not null,
  val_tasa          NUMBER(20,4) not null,
  mto_dev_anterior  NUMBER(18,2),
  mto_dev_actual    NUMBER(18,2) not null,
  capital           NUMBER(18,2) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  nro_cuota         NUMBER(3) not null,
  tipo              VARCHAR2(1) not null,
  fecha             DATE not null,
  fec_ult_devengado DATE,
  cod_moneda        VARCHAR2(3) not null,
  estado            VARCHAR2(1) not null,
  categoria         NUMBER(3,2) not null,
  can_dia_interes   NUMBER(6) not null,
  can_dia_anterior  NUMBER(6),
  mto_ajuste        NUMBER(18,2),
  mto_dev_acumulado NUMBER(18,2) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_DEVENGADOS_TMP
  is 'Detalle de Devengados de Préstamos (Temporal).';
comment on column IT.PR_DEVENGADOS_TMP.nro_cuenta
  is 'Número de Préstamo.';
comment on column IT.PR_DEVENGADOS_TMP.fec_inicio
  is 'Fecha de Inicio del Devengamiento.';
comment on column IT.PR_DEVENGADOS_TMP.val_tasa
  is 'Valor de la Tasa con la cual se devenga.';
comment on column IT.PR_DEVENGADOS_TMP.mto_dev_anterior
  is 'Monto del Devengado anterior.';
comment on column IT.PR_DEVENGADOS_TMP.mto_dev_actual
  is 'Monto del Devengado actual.';
comment on column IT.PR_DEVENGADOS_TMP.capital
  is 'Monto de Capital sobre el cual se devenga.';
comment on column IT.PR_DEVENGADOS_TMP.usu_insercion
  is 'Usuario que realizó la inserción del Registro.';
comment on column IT.PR_DEVENGADOS_TMP.fec_insercion
  is 'Fecha de inserción del Registro.';
comment on column IT.PR_DEVENGADOS_TMP.usu_modificacion
  is 'Usuario que realizó la última modificación del Registro.';
comment on column IT.PR_DEVENGADOS_TMP.fec_modificacion
  is 'Fecha de la última modificación del Registro.';
comment on column IT.PR_DEVENGADOS_TMP.nro_cuota
  is 'Número de Cuota devengada.';
comment on column IT.PR_DEVENGADOS_TMP.tipo
  is 'Tipo de Devengado: No (C)obrado o En (S)uspenso. ';
comment on column IT.PR_DEVENGADOS_TMP.fecha
  is 'Fecha del proceso de Devengamiento.';
comment on column IT.PR_DEVENGADOS_TMP.fec_ult_devengado
  is 'Fecha del último Devengado.';
comment on column IT.PR_DEVENGADOS_TMP.cod_moneda
  is 'Código de la Moneda.';
comment on column IT.PR_DEVENGADOS_TMP.estado
  is 'Estado en que se encontraba el Préstamo en el momento del Devengamiento.';
comment on column IT.PR_DEVENGADOS_TMP.categoria
  is 'Categoría en que se encontraba el Préstamo en el momento del Devengamiento.';
comment on column IT.PR_DEVENGADOS_TMP.can_dia_interes
  is 'Cantidad de Días de Devengamiento.';
comment on column IT.PR_DEVENGADOS_TMP.can_dia_anterior
  is 'Cantidad del Días de Devengamiento anterior. ';
comment on column IT.PR_DEVENGADOS_TMP.mto_ajuste
  is 'Monto del ajuste del Devengado, en el momento del Vencimiento de la Cuota. ';
comment on column IT.PR_DEVENGADOS_TMP.mto_dev_acumulado
  is 'Monto Total Devengado de la Cuota. ';
create index IT.IN_PDTMP_NRO_CUENTA on IT.PR_DEVENGADOS_TMP (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 384K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_DEVENGADOS_TMP
  add constraint PK_PR_DEVENGADOS_TMP primary key (NRO_CUENTA, NRO_CUOTA, TIPO, COD_MONEDA, ESTADO, CATEGORIA, CAPITAL, VAL_TASA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );

