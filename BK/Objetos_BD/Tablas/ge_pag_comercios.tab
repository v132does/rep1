create table IT.GE_PAG_COMERCIOS
(
  cod_usuario      VARCHAR2(10),
  cod_ente         NUMBER(7),
  fec_proceso      DATE,
  nro_secuencia    NUMBER(3) not null,
  cod_modalidad    NUMBER(3),
  nro_cuenta       VARCHAR2(15),
  cod_moneda       VARCHAR2(3),
  fec_envio        DATE,
  tipo             VARCHAR2(1),
  monto            NUMBER(18,2),
  estado           VARCHAR2(1),
  cod_proceso      NUMBER(3),
  nro_cta_origen   VARCHAR2(15),
  nro_transaccion  NUMBER(7),
  cod_modulo       NUMBER(3),
  fec_insercion    DATE default SYSDATE not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_proceso_real DATE,
  hor_proceso      VARCHAR2(8),
  cod_rubro        VARCHAR2(15),
  cod_ofi_rubro    NUMBER(3),
  ind_reproceso    VARCHAR2(1) default 'N',
  nro_orden        NUMBER(18)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAG_COMERCIOS
  is 'Datos de Pago a comercios.';
comment on column IT.GE_PAG_COMERCIOS.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.GE_PAG_COMERCIOS.cod_ente
  is 'Codigo de ente.';
comment on column IT.GE_PAG_COMERCIOS.fec_proceso
  is 'Fecha de proceso.';
comment on column IT.GE_PAG_COMERCIOS.nro_secuencia
  is 'Nro. de secuencia.';
comment on column IT.GE_PAG_COMERCIOS.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_PAG_COMERCIOS.nro_cuenta
  is 'Nro. de cuenta.';
comment on column IT.GE_PAG_COMERCIOS.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.GE_PAG_COMERCIOS.fec_envio
  is 'Fecha de envio.';
comment on column IT.GE_PAG_COMERCIOS.tipo
  is 'Tipo.';
comment on column IT.GE_PAG_COMERCIOS.monto
  is 'Monto.';
comment on column IT.GE_PAG_COMERCIOS.estado
  is 'Estado.';
comment on column IT.GE_PAG_COMERCIOS.cod_proceso
  is 'Codigo del proceso.';
comment on column IT.GE_PAG_COMERCIOS.nro_cta_origen
  is 'Nro. de Cta. origen.';
comment on column IT.GE_PAG_COMERCIOS.nro_transaccion
  is 'Nro. de transaccion.';
comment on column IT.GE_PAG_COMERCIOS.cod_modulo
  is 'Codigo del modulo.';
comment on column IT.GE_PAG_COMERCIOS.fec_insercion
  is 'fecha de insercion.';
comment on column IT.GE_PAG_COMERCIOS.usu_insercion
  is 'usuario de insercion.';
comment on column IT.GE_PAG_COMERCIOS.fec_modificacion
  is 'fecha de modificacion.';
comment on column IT.GE_PAG_COMERCIOS.usu_modificacion
  is 'usuario de modificacion.';
comment on column IT.GE_PAG_COMERCIOS.fec_proceso_real
  is 'Fecha tenida en cuenta para generacion de movimientos';
comment on column IT.GE_PAG_COMERCIOS.hor_proceso
  is 'Hora de Proceso';
comment on column IT.GE_PAG_COMERCIOS.cod_rubro
  is 'Código de Cuenta Contable';
comment on column IT.GE_PAG_COMERCIOS.cod_ofi_rubro
  is 'Código de Oficina del Rubro.';
comment on column IT.GE_PAG_COMERCIOS.ind_reproceso
  is 'Indicador de Reproceso.';
comment on column IT.GE_PAG_COMERCIOS.nro_orden
  is 'Número de Orden.';
create index IT.IN_GPCOM_COD_ENTE on IT.GE_PAG_COMERCIOS (COD_ENTE, FEC_PROCESO, COD_PROCESO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GPCOM_ESTADO on IT.GE_PAG_COMERCIOS (COD_ENTE, ESTADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GPCOM_NRO_ORDEN on IT.GE_PAG_COMERCIOS (NRO_ORDEN)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAG_COMERCIOS
  add constraint FK_GPCOM_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.GE_PAG_COMERCIOS
  add constraint FK_GPCOM_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_PAG_COMERCIOS
  add constraint FK_GPCOM_COD_RUBRO foreign key (COD_RUBRO)
  references IT.CB_RUBROS (COD_RUBRO);
alter table IT.GE_PAG_COMERCIOS
  add constraint FK_GPCOM_COD_TRANSACCION foreign key (COD_MODULO, COD_MODALIDAD, NRO_TRANSACCION)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_PAG_COMERCIOS
  add constraint FK_GPCOM_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_PAG_COMERCIOS
  add constraint FK_GPCOM_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

