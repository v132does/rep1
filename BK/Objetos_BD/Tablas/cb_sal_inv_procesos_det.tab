create table IT.CB_SAL_INV_PROCESOS_DET
(
  fecha          DATE not null,
  nro_referencia NUMBER(10) not null,
  nro_cuenta     VARCHAR2(15) not null,
  sal_actual     NUMBER(18,2),
  sal_anterior   NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SAL_INV_PROCESOS_DET
  is 'Historico de Saldos contables detallados de inventarios fisicos.';
comment on column IT.CB_SAL_INV_PROCESOS_DET.fecha
  is 'Fecha.';
comment on column IT.CB_SAL_INV_PROCESOS_DET.nro_referencia
  is 'Nro. de referencia.';
comment on column IT.CB_SAL_INV_PROCESOS_DET.nro_cuenta
  is 'Nro. de cuenta.';
comment on column IT.CB_SAL_INV_PROCESOS_DET.sal_actual
  is 'Saldo actual.';
comment on column IT.CB_SAL_INV_PROCESOS_DET.sal_anterior
  is 'Saldo anterior.';
create index IT.IN_CSIPD_FECHA on IT.CB_SAL_INV_PROCESOS_DET (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CSIPD_NRO_CUENTA on IT.CB_SAL_INV_PROCESOS_DET (NRO_CUENTA, FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CSIPD_NRO_REFERENCIA on IT.CB_SAL_INV_PROCESOS_DET (FECHA, NRO_REFERENCIA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

