create table IT.CC_SOBREGIROS_RES
(
  nro_cuenta        VARCHAR2(15) not null,
  can_dias          NUMBER(6) not null,
  sit_deuda         VARCHAR2(1) not null,
  usu_insercion     VARCHAR2(10) not null,
  fec_insercion     DATE not null,
  usu_modificacion  VARCHAR2(10) not null,
  fec_modificacion  DATE not null,
  can_dia_sobregiro NUMBER(6) default 0 not null,
  max_atraso        NUMBER(6),
  pro_atraso        NUMBER(6),
  mto_sob_suspenso  NUMBER(18,2),
  mto_mora          NUMBER(18,2) default 0
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_SOBREGIROS_RES
  is 'Resumen diario de sobregiros.';
comment on column IT.CC_SOBREGIROS_RES.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.CC_SOBREGIROS_RES.can_dias
  is 'Cantidad de días de Exceso hasta la fecha.';
comment on column IT.CC_SOBREGIROS_RES.sit_deuda
  is 'Situacion de la deuda de sobregiro segun los dias.';
comment on column IT.CC_SOBREGIROS_RES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_SOBREGIROS_RES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_SOBREGIROS_RES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_SOBREGIROS_RES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_SOBREGIROS_RES.can_dia_sobregiro
  is 'Cantidad total de Días de Sobregiro.';
comment on column IT.CC_SOBREGIROS_RES.max_atraso
  is 'Máximo de días de atraso.';
comment on column IT.CC_SOBREGIROS_RES.pro_atraso
  is 'Promedio de Días de atraso.';
comment on column IT.CC_SOBREGIROS_RES.mto_sob_suspenso
  is 'Monto de Sobregiros en suspenso.';
comment on column IT.CC_SOBREGIROS_RES.mto_mora
  is 'Monto en mora de la cuenta.';
alter table IT.CC_SOBREGIROS_RES
  add constraint PK_CC_SOBREGIROS_RES primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

