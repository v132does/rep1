create table IT.WF_TIP_CIR_TAR_SIG
(
  cod_tip_circuito      NUMBER(3) not null,
  cod_tip_tarea         NUMBER(3) not null,
  cod_tip_tar_siguiente NUMBER(3) not null,
  descripcion           VARCHAR2(60),
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default SYSDATE not null,
  tar_excepcion         VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.WF_TIP_CIR_TAR_SIG
  is 'Definicion de las posibles tareas siguientes de esta tarea';
comment on column IT.WF_TIP_CIR_TAR_SIG.cod_tip_circuito
  is 'Codigo del tipo de circuito';
comment on column IT.WF_TIP_CIR_TAR_SIG.cod_tip_tarea
  is 'Codigo de la tarea definida';
comment on column IT.WF_TIP_CIR_TAR_SIG.cod_tip_tar_siguiente
  is 'Tarea siguiente a generar si la actual es aprobada';
comment on column IT.WF_TIP_CIR_TAR_SIG.descripcion
  is 'Descripcion de la tarea siguiente.';
comment on column IT.WF_TIP_CIR_TAR_SIG.usu_insercion
  is 'Usuario que inserto el registro';
comment on column IT.WF_TIP_CIR_TAR_SIG.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.WF_TIP_CIR_TAR_SIG.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.WF_TIP_CIR_TAR_SIG.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.WF_TIP_CIR_TAR_SIG.tar_excepcion
  is 'Indica que la tarea es de excepcion.';
alter table IT.WF_TIP_CIR_TAR_SIG
  add constraint PK_WF_TIP_CIR_TAR_SIG primary key (COD_TIP_CIRCUITO, COD_TIP_TAREA, COD_TIP_TAR_SIGUIENTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

