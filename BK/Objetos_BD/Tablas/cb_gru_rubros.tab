create table IT.CB_GRU_RUBROS
(
  cod_gru_rubro    NUMBER(5) not null,
  descripcion      VARCHAR2(60) not null,
  condicion        VARCHAR2(1) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_GRU_RUBROS
  is 'Cabecera de Grupo de Rubros.';
comment on column IT.CB_GRU_RUBROS.cod_gru_rubro
  is 'Codigo de grupo de Rubro.';
comment on column IT.CB_GRU_RUBROS.descripcion
  is 'Descripcion del grupo.';
comment on column IT.CB_GRU_RUBROS.condicion
  is 'Condicion del Where I= In N= Not in.';
comment on column IT.CB_GRU_RUBROS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_GRU_RUBROS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_GRU_RUBROS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_GRU_RUBROS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CB_GRU_RUBROS
  add constraint PK_CB_GRU_RUBROS primary key (COD_GRU_RUBRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

