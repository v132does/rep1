create index IT.IND_PSA004_FEC on IT.PSA044_HIS (PSA044_HISPAI, PSA044_HISTDO, LTRIM(RTRIM(PSA044_HISNDO)), TO_DATE(PSA044_HISFFI,'YYYYMMDD'))
