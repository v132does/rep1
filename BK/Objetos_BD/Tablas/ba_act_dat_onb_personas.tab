create table IT.BA_ACT_DAT_ONB_PERSONAS
(
  cod_persona      VARCHAR2(10) not null,
  pri_nombre       VARCHAR2(30) not null,
  pri_apellido     VARCHAR2(30) not null,
  seg_nombre       VARCHAR2(30),
  seg_apellido     VARCHAR2(30),
  telefono         VARCHAR2(30),
  principal        VARCHAR2(1),
  dir_correo       VARCHAR2(80),
  est_workflow     VARCHAR2(1),
  cod_circuito     NUMBER(15),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_ACT_DAT_ONB_PERSONAS
  is 'Modificaciones de datos onboarding clientes.';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.cod_persona
  is 'Codigo Persona.';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.pri_nombre
  is 'Primer Nombre.';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.pri_apellido
  is 'Primer Apellido.';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.seg_nombre
  is 'Segundo Nombre.';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.seg_apellido
  is 'Segundo Apellido';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.telefono
  is 'Teléfono';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.principal
  is 'Indica si es telefono es el principal';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.dir_correo
  is 'Dirección de email';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.est_workflow
  is 'Estado del Workflow (I=Iniciado, F=Finalizado, R=Rechazado)';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.cod_circuito
  is 'Codigo circuito del Workflow';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.usu_insercion
  is 'Usuario Insercion';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.fec_insercion
  is 'Fecha Insercion';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.usu_modificacion
  is 'Usuario Modificacion';
comment on column IT.BA_ACT_DAT_ONB_PERSONAS.fec_modificacion
  is 'Fecha Modificacion';

