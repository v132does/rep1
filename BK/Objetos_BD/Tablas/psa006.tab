comment on column IT.PSA006.psa006br
  is 'Banco Remitente';
create index IT.IN_PSA006EJ on IT.PSA006 (PSA006EJ)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PSA006
  add constraint PK_PSA006 primary key (PSA006PA, PSA006TD, PSA006DO, PSA006MO, PSA006CT, PSA006SO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

