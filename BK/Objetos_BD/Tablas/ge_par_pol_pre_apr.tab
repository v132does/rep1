create table IT.GE_PAR_POL_PRE_APR
(
  tip_politica     NUMBER not null,
  description      VARCHAR2(2000),
  mto_aprobado     NUMBER,
  mto_deu_crc_des  NUMBER,
  mto_deu_crc_has  NUMBER,
  ant_infomercio   VARCHAR2(2),
  faja             VARCHAR2(1),
  tip_ingreso      NUMBER,
  cat_crc          VARCHAR2(1),
  condicion        VARCHAR2(2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion    DATE default SYSDATE,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion DATE default SYSDATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAR_POL_PRE_APR
  is 'Tabla parametrica de politica de pre-aprobado s/ ingreso';
comment on column IT.GE_PAR_POL_PRE_APR.tip_politica
  is 'Tipo de Politica.';
comment on column IT.GE_PAR_POL_PRE_APR.description
  is 'Descripción de la Politica.';
comment on column IT.GE_PAR_POL_PRE_APR.mto_aprobado
  is 'Mto. Aprobado segun politica';
comment on column IT.GE_PAR_POL_PRE_APR.mto_deu_crc_des
  is 'Mto. Parametro CRC Desde.';
comment on column IT.GE_PAR_POL_PRE_APR.mto_deu_crc_has
  is 'Mto. Parametro CRC Hasta';
comment on column IT.GE_PAR_POL_PRE_APR.ant_infomercio
  is 'Antecedentes Infomercio';
comment on column IT.GE_PAR_POL_PRE_APR.faja
  is 'Faja Equifax';
comment on column IT.GE_PAR_POL_PRE_APR.tip_ingreso
  is 'Tipo de Ingreso';
comment on column IT.GE_PAR_POL_PRE_APR.cat_crc
  is 'Categoria CRC';
comment on column IT.GE_PAR_POL_PRE_APR.condicion
  is 'Condición p/ Deuda CRC';
comment on column IT.GE_PAR_POL_PRE_APR.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_PAR_POL_PRE_APR.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PAR_POL_PRE_APR.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAR_POL_PRE_APR.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_PAR_POL_PRE_APR
  add constraint PK_GE_PAR_POL_PRE_APR primary key (TIP_POLITICA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

