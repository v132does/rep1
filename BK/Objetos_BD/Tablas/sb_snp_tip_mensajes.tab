create table IT.SB_SNP_TIP_MENSAJES
(
  cod_mensaje      VARCHAR2(35) not null,
  descripcion      VARCHAR2(150) not null,
  tip_msj_campo    VARCHAR2(3),
  obj_proceso      VARCHAR2(150),
  tipo             VARCHAR2(1) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_SNP_TIP_MENSAJES
  is 'Contiene la definición del esquema del mensaje MT.';
comment on column IT.SB_SNP_TIP_MENSAJES.cod_mensaje
  is 'Identificador del Mensaje SWIFT.';
comment on column IT.SB_SNP_TIP_MENSAJES.descripcion
  is 'Descripción del Mensaje SWIFT.';
comment on column IT.SB_SNP_TIP_MENSAJES.tip_msj_campo
  is 'Indentificador del campo (tag) del MT donde se encuentra el tipo de mensaje.';
comment on column IT.SB_SNP_TIP_MENSAJES.obj_proceso
  is 'Objeto que realizará el procesamiento del MT. Debe ser un objeto válido: función, procedimiento, etc.';
comment on column IT.SB_SNP_TIP_MENSAJES.tipo
  is 'Identificador del Tipo de Mensaje. E-Enviado, R-Recibido, A-Ambos';
comment on column IT.SB_SNP_TIP_MENSAJES.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.SB_SNP_TIP_MENSAJES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.SB_SNP_TIP_MENSAJES.usu_modificacion
  is 'Usuario que realizo la última modificación en el registro.';
comment on column IT.SB_SNP_TIP_MENSAJES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.SB_SNP_TIP_MENSAJES
  add constraint PK_SB_SNP_TIP_MENSAJES primary key (COD_MENSAJE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SB_SNP_TIP_MENSAJES
  add constraint CK_TIPO
  check (tipo IN ('A','E','R'));

