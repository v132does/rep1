--------------------------------------------------------------------------------
-- Tabla: IT.BA_USU_CAN_VIGIA
-- Descripción: tabla para relacion usuario de servicios - > canales a ser utilizados en VIGIA.
--------------------------------------------------------------------------------

CREATE TABLE IT.BA_USU_CAN_VIGIA (
    ID NUMERIC(10,0) GENERATED BY DEFAULT AS IDENTITY, 
    USU_ID_INS  VARCHAR2(10), 
    COD_USUARIO VARCHAR2(10), 
    COD_CANAL CHAR(2),                                    
    CANAL_PRESENCIAL CHAR(1),
    USU_INSERCION VARCHAR2(10),
    FEC_INSERCION VARCHAR2(10),
    USU_MODIFICACION VARCHAR2(10),
    FEC_MODIFICACION VARCHAR2(10),
    PRIMARY KEY (ID)
    )
TABLESPACE IT_DATA;


--------------------------------------------------------------------------------
-- Índices
--------------------------------------------------------------------------------

CREATE INDEX IT.IN_EUSUAC_USU_ID_INS ON IT.BA_USU_CAN_VIGIA (USU_ID_INS);
CREATE INDEX IT.IN_EUSUAC_COD_USUARIO ON IT.BA_USU_CAN_VIGIA (COD_USUARIO);
TABLESPACE IT_IND;

--------------------------------------------------------------------------------
-- Sinónimo y permisos
--------------------------------------------------------------------------------

CREATE PUBLIC SYNONYM BA_USU_CAN_VIGIA
FOR IT.BA_USU_CAN_VIGIA;

GRANT ALTER, DELETE, INSERT, UPDATE, SELECT
ON IT.BA_USU_CAN_VIGIA
TO IT_TEMPORAL;