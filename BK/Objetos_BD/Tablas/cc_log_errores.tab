-- Create table
create table IT.CC_LOG_ERRORES
(
  cod_programa     VARCHAR2(50) not null,
  fecha            DATE,
  cod_persona      VARCHAR2(10),
  nro_cuenta       VARCHAR2(15),
  det_error        VARCHAR2(4000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.CC_LOG_ERRORES
  is 'Tabla de Errores generados por procesos del módulo Cuenta Corriente. Se registran los errores en esta tabla para poder finalizar la operativa.';
-- Add comments to the columns 
comment on column IT.CC_LOG_ERRORES.cod_programa
  is 'Codigo del Programa en el cual se genera el error';
comment on column IT.CC_LOG_ERRORES.fecha
  is 'Fecha en el cual se genera el error';
comment on column IT.CC_LOG_ERRORES.cod_persona
  is 'Codigo de la persona que genera el error';
comment on column IT.CC_LOG_ERRORES.nro_cuenta
  is 'Numero de cuenta que genera el error';
comment on column IT.CC_LOG_ERRORES.det_error
  is 'Detalle del error.';
comment on column IT.CC_LOG_ERRORES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_LOG_ERRORES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_LOG_ERRORES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_LOG_ERRORES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
-- Create/Recreate indexes 
create index IT.IN_CCERR_FEC_COD_PROGRAMA on IT.CC_LOG_ERRORES (FECHA, COD_PROGRAMA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
