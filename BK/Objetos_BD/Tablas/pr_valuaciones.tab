create table IT.PR_VALUACIONES
(
  nro_cuenta           VARCHAR2(15) not null,
  fecha                DATE not null,
  estado               VARCHAR2(1) not null,
  tipo                 VARCHAR2(1) not null,
  tip_interes          VARCHAR2(1) not null,
  tip_renovacion       VARCHAR2(1),
  tip_documento        VARCHAR2(1) not null,
  sal_capital          NUMBER(18,2) default 0 not null,
  sal_interes          NUMBER(18,2) default 0 not null,
  sal_int_adelantado   NUMBER(18,2) default 0,
  dev_no_cobrado       NUMBER(18,2) default 0 not null,
  tot_gar_computables  NUMBER(18,2) default 0,
  tot_prevision        NUMBER(18,2) default 0,
  cat_automatica       NUMBER(3,2) not null,
  cotizacion           NUMBER(14,8) default 0 not null,
  tot_val_capital      NUMBER(18,2) default 0 not null,
  tot_val_interes      NUMBER(18,2) default 0 not null,
  tot_val_int_ade      NUMBER(18,2) default 0 not null,
  tot_val_devengado    NUMBER(18,2) default 0 not null,
  tot_val_garantia     NUMBER(18,2) default 0 not null,
  tot_val_prevision    NUMBER(18,2) default 0 not null,
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  dev_suspenso         NUMBER(18,2) default 0,
  tot_val_suspenso     NUMBER(18,2) default 0 not null,
  cot_anterior         NUMBER(14,8) default 0,
  val_int_devengar     NUMBER(18,2) default 0,
  tot_val_int_devengar NUMBER(18,2) default 0,
  tot_valuacion        NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_VALUACIONES
  is 'Datos para el proceso de Ganancias por Valuaciones.';
comment on column IT.PR_VALUACIONES.nro_cuenta
  is 'Número de Préstamo.';
comment on column IT.PR_VALUACIONES.fecha
  is 'Fecha en que se procesó por última vez las diferencias por valuaciones.';
comment on column IT.PR_VALUACIONES.estado
  is 'Estado de Cuenta on line (C=Vigente, V=Vencido, G=En Gestión, M=Moroso, I=Irrecurable, N=Cancelado).';
comment on column IT.PR_VALUACIONES.tipo
  is 'Tipo de Préstamo (Amortizable, Plazo Fijo, Descto. de Documentos).';
comment on column IT.PR_VALUACIONES.tip_interes
  is 'Tipo de interés (A=Adelantado / V=Vencido).';
comment on column IT.PR_VALUACIONES.tip_renovacion
  is 'Tipo de Renovación: Refinanciado, rEstructurado, reNovado.';
comment on column IT.PR_VALUACIONES.tip_documento
  is 'Tipo de Documento de Crédito (1=Vista / 2=Vencimiento).';
comment on column IT.PR_VALUACIONES.sal_capital
  is 'Saldo del Capital.';
comment on column IT.PR_VALUACIONES.sal_interes
  is 'Saldo del Interés.';
comment on column IT.PR_VALUACIONES.sal_int_adelantado
  is 'Saldo Total Interés Documento.';
comment on column IT.PR_VALUACIONES.dev_no_cobrado
  is 'Devengado No Cobrado.';
comment on column IT.PR_VALUACIONES.tot_gar_computables
  is 'Total de Garantías computables.';
comment on column IT.PR_VALUACIONES.tot_prevision
  is 'Monto Total de la Previsión.';
comment on column IT.PR_VALUACIONES.cat_automatica
  is 'Categoría automática del Sistema.';
comment on column IT.PR_VALUACIONES.cotizacion
  is 'Cotización utilizada en el Cálculo de Valuación.';
comment on column IT.PR_VALUACIONES.tot_val_capital
  is 'Monto Total de Valuación por Capital.';
comment on column IT.PR_VALUACIONES.tot_val_interes
  is 'Monto Total de Valuación por Interés.';
comment on column IT.PR_VALUACIONES.tot_val_int_ade
  is 'Monto Total de Valuación por el Interés adelantado.';
comment on column IT.PR_VALUACIONES.tot_val_devengado
  is 'Monto Total de Valuación por el Devengado.';
comment on column IT.PR_VALUACIONES.tot_val_garantia
  is 'Monto Total de Valuación por la Garantía computable.';
comment on column IT.PR_VALUACIONES.tot_val_prevision
  is 'Monto Total de Valuación por la Previsión.';
comment on column IT.PR_VALUACIONES.usu_insercion
  is 'Usuario que realizó la inserción del Registro.';
comment on column IT.PR_VALUACIONES.fec_insercion
  is 'Fecha en que se insertó el Registro.';
comment on column IT.PR_VALUACIONES.usu_modificacion
  is 'Usuario que realizó la última modificación en el Registro.';
comment on column IT.PR_VALUACIONES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el Registro.';
comment on column IT.PR_VALUACIONES.dev_suspenso
  is 'Devengado en Suspenso.';
comment on column IT.PR_VALUACIONES.tot_val_suspenso
  is 'Monto Total de Valuación por el Suspendido.';
comment on column IT.PR_VALUACIONES.cot_anterior
  is 'Cotizacion anterior.';
comment on column IT.PR_VALUACIONES.val_int_devengar
  is 'Interes a devengar.';
comment on column IT.PR_VALUACIONES.tot_val_int_devengar
  is 'Monto Total de Valuación por el Interés a devengar.';
comment on column IT.PR_VALUACIONES.tot_valuacion
  is 'Monto Total de Valuación Consolidado.';
alter table IT.PR_VALUACIONES
  add constraint PK_PR_VALUACIONES primary key (NRO_CUENTA, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 384K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_VALUACIONES
  add constraint FK_PVALU_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.PR_CTA_PRESTAMOS (NRO_CUENTA);

