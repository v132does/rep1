create table IT.RH_TIP_DESCUENTOS
(
  cod_tip_descuento NUMBER(3) not null,
  descripcion       VARCHAR2(50) not null,
  cod_transaccion   NUMBER(4) not null,
  cod_modulo        NUMBER(3) not null,
  cod_modalidad     NUMBER(3) not null,
  prioridad         NUMBER(2) not null,
  tipo              VARCHAR2(1) default 'O' not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_TIP_DESCUENTOS
  is 'Tipos de Descuentos.';
comment on column IT.RH_TIP_DESCUENTOS.cod_tip_descuento
  is 'Codigo del Tipo Descuento.';
comment on column IT.RH_TIP_DESCUENTOS.descripcion
  is 'Descripcion del tipo de Descuento.';
comment on column IT.RH_TIP_DESCUENTOS.cod_transaccion
  is 'Codigo de la transaccion.';
comment on column IT.RH_TIP_DESCUENTOS.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.RH_TIP_DESCUENTOS.cod_modalidad
  is 'Codigo de la Modalidad.';
comment on column IT.RH_TIP_DESCUENTOS.prioridad
  is 'Codigo que identifica el codigo de prioridad.';
comment on column IT.RH_TIP_DESCUENTOS.tipo
  is 'Tipo de Descuento.';
comment on column IT.RH_TIP_DESCUENTOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_TIP_DESCUENTOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_TIP_DESCUENTOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_TIP_DESCUENTOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.RH_TIP_DESCUENTOS
  add constraint PK_RH_TIP_DESCUENTOS primary key (COD_TIP_DESCUENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_TIP_DESCUENTOS
  add constraint UK_HTDES_DESCRIPCION unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_TIP_DESCUENTOS
  add constraint FK_HTDES_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.RH_TIP_DESCUENTOS
  add constraint AVCON_1191539788_TIPO_000
  check (TIPO IN ('J', 'O'));

