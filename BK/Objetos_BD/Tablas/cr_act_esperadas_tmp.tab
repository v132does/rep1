create table IT.CR_ACT_ESPERADAS_TMP
(
  cod_persona      VARCHAR2(20) not null,
  cod_moneda       VARCHAR2(3) not null,
  can_tra_debito   VARCHAR2(20) not null,
  can_tra_credito  VARCHAR2(20) not null,
  mto_pro_debito   NUMBER(18,2) not null,
  mto_pro_credito  NUMBER(18,2) not null,
  fecha            DATE not null,
  usu_insercion    VARCHAR2(20) default user not null,
  fec_insercion    DATE default sysdate not null,
  usu_modificacion VARCHAR2(20) default user not null,
  fec_modificacion DATE default sysdate not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_ACT_ESPERADAS_TMP
  is 'Actividades esperadas de Clientes.';
comment on column IT.CR_ACT_ESPERADAS_TMP.cod_persona
  is 'Codigo de la Persona.';
comment on column IT.CR_ACT_ESPERADAS_TMP.cod_moneda
  is 'Codigo de la Moneda que opera.';
comment on column IT.CR_ACT_ESPERADAS_TMP.can_tra_debito
  is 'Numero de transacciones de Debito esperado.';
comment on column IT.CR_ACT_ESPERADAS_TMP.can_tra_credito
  is 'Numero de transacciones de Credito esperado.';
comment on column IT.CR_ACT_ESPERADAS_TMP.mto_pro_debito
  is 'Monto promedio Debito esperado.';
comment on column IT.CR_ACT_ESPERADAS_TMP.mto_pro_credito
  is 'Monto promedio Credito esperado.';
comment on column IT.CR_ACT_ESPERADAS_TMP.fecha
  is 'Fecha de Ingreso de la Actividad.';
comment on column IT.CR_ACT_ESPERADAS_TMP.usu_insercion
  is 'Usuario que inserto el Registro.';
comment on column IT.CR_ACT_ESPERADAS_TMP.fec_insercion
  is 'Fecha de insercion del Registro.';
comment on column IT.CR_ACT_ESPERADAS_TMP.usu_modificacion
  is 'Usuario que modifico el Registro.';
comment on column IT.CR_ACT_ESPERADAS_TMP.fec_modificacion
  is 'Fecha de modificacion del Registro.';

