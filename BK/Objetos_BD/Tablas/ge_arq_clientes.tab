create table IT.GE_ARQ_CLIENTES
(
  cod_persona      VARCHAR2(10) not null,
  fec_extracto     DATE not null,
  fre_extracto     VARCHAR2(1) default 'M' not null,
  funcionario      VARCHAR2(1),
  nom_cliente      VARCHAR2(120),
  direccion        VARCHAR2(90),
  telefono         VARCHAR2(41),
  cod_usu_oficial  VARCHAR2(10),
  cod_pais         NUMBER(3),
  cod_ciudad       NUMBER(3),
  tel_oficial      VARCHAR2(35),
  nro_interno      NUMBER(5),
  cod_extracto     NUMBER(5) not null,
  det_direccion    VARCHAR2(50),
  observacion      VARCHAR2(50),
  barrio           VARCHAR2(40),
  cod_mensaje      NUMBER(2),
  nro_control      NUMBER(7),
  tip_impresion    VARCHAR2(1) default 'C',
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion    DATE default SYSDATE,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion DATE default SYSDATE,
  cli_confidencial VARCHAR2(1),
  cod_oficina      NUMBER(3),
  cat_riesgo       VARCHAR2(1),
  fec_ult_clasif   DATE,
  cod_per_empresa  VARCHAR2(10),
  tip_direccion    VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_ARQ_CLIENTES
  is 'Cabecera de Extracto Unico ** Mantener seis meses **';
comment on column IT.GE_ARQ_CLIENTES.cod_persona
  is 'Codigo del Cliente.';
comment on column IT.GE_ARQ_CLIENTES.fec_extracto
  is 'Fecha del Extracto.';
comment on column IT.GE_ARQ_CLIENTES.fre_extracto
  is 'Frecuencia del Extracto ( D=diaria, S=semanal, M=mensual ).';
comment on column IT.GE_ARQ_CLIENTES.funcionario
  is 'Cuenta de Funcionario (S=Si / N=No).';
comment on column IT.GE_ARQ_CLIENTES.nom_cliente
  is 'Nombre del Cliente.';
comment on column IT.GE_ARQ_CLIENTES.direccion
  is 'Direccion.';
comment on column IT.GE_ARQ_CLIENTES.telefono
  is 'Numero de Telefono.';
comment on column IT.GE_ARQ_CLIENTES.cod_usu_oficial
  is 'Codigo del Oficial de Cuenta.';
comment on column IT.GE_ARQ_CLIENTES.cod_pais
  is 'Codigo de Pais.';
comment on column IT.GE_ARQ_CLIENTES.cod_ciudad
  is 'Codigo de Ciudad.';
comment on column IT.GE_ARQ_CLIENTES.tel_oficial
  is 'Telefono del Oficial de Cuenta.';
comment on column IT.GE_ARQ_CLIENTES.nro_interno
  is 'Numero de Interno.';
comment on column IT.GE_ARQ_CLIENTES.cod_extracto
  is 'Codigo de Extracto.';
comment on column IT.GE_ARQ_CLIENTES.det_direccion
  is 'Detalle de la Direccion.';
comment on column IT.GE_ARQ_CLIENTES.observacion
  is 'Observacion.';
comment on column IT.GE_ARQ_CLIENTES.barrio
  is 'Nombre del Barrio.';
comment on column IT.GE_ARQ_CLIENTES.cod_mensaje
  is 'Tipo de Mensaje.';
comment on column IT.GE_ARQ_CLIENTES.nro_control
  is 'Numero de Control.';
comment on column IT.GE_ARQ_CLIENTES.tip_impresion
  is 'Tipo de Impresion, Valores Posibles: C-Impreso,  Z-x Mail,  N-No impreso X-Envio x mail e impreso.';
comment on column IT.GE_ARQ_CLIENTES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_ARQ_CLIENTES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_ARQ_CLIENTES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_ARQ_CLIENTES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_ARQ_CLIENTES.cli_confidencial
  is 'Indica si el cliente es confidencial (S/N.';
comment on column IT.GE_ARQ_CLIENTES.cod_oficina
  is 'Oficina del cliente.';
comment on column IT.GE_ARQ_CLIENTES.cat_riesgo
  is 'Categoria de Riesgo.';
comment on column IT.GE_ARQ_CLIENTES.fec_ult_clasif
  is 'Fecha de ultima clasificacion o categorizacion.';
comment on column IT.GE_ARQ_CLIENTES.cod_per_empresa
  is 'Codigo de persona de la empresa pagadora.';
comment on column IT.GE_ARQ_CLIENTES.tip_direccion
  is 'Tipo de direccion(R-Retener, D-direccion)';
create unique index IT.IN_GEDAC_FEC_EXTRACTO on IT.GE_ARQ_CLIENTES (FEC_EXTRACTO, FRE_EXTRACTO, COD_PERSONA, COD_EXTRACTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 80K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_ARQ_CLIENTES
  add constraint PK_GE_ARQ_CLIENTES primary key (COD_PERSONA, FEC_EXTRACTO, FRE_EXTRACTO, COD_EXTRACTO);

