create table IT.GE_PAR_CAUSALES
(
  cod_causa        NUMBER(3) not null,
  parametro        VARCHAR2(30) not null,
  val_parametro    VARCHAR2(100) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAR_CAUSALES
  is 'Parametros de Causas.';
comment on column IT.GE_PAR_CAUSALES.cod_causa
  is 'Codigo de la causa.';
comment on column IT.GE_PAR_CAUSALES.parametro
  is 'Parametro a ser configurado.';
comment on column IT.GE_PAR_CAUSALES.val_parametro
  is 'Valor del parametro.';
comment on column IT.GE_PAR_CAUSALES.usu_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PAR_CAUSALES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PAR_CAUSALES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAR_CAUSALES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_PAR_CAUSALES
  add constraint PK_GE_PAR_CAUSALES primary key (COD_CAUSA, PARAMETRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAR_CAUSALES
  add constraint FK_GPCAU_COD_CAUSA foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.GE_PAR_CAUSALES
  add constraint FK_GPCAU_PARAMETRO foreign key (PARAMETRO)
  references IT.GE_PARAMETROS (PARAMETRO);
alter table IT.GE_PAR_CAUSALES
  add constraint AVCON_1080843414_COD_C_001
  check (COD_CAUSA BETWEEN 1 AND 999);

