CREATE TABLE IT.CB_ASI_MOV_TMP (
	FECHA				DATE,
	HORA				VARCHAR2(8),
	COD_USUARIO			VARCHAR2(20),
	NRO_ASIENTO			NUMBER,
	COD_MOD_PADRE		NUMBER,
	COD_MAD_PADRE		NUMBER,
	COD_TRA_PADRE		NUMBER,
	DES_TRA_PADRE		VARCHAR2(100),
	COD_MODULO			NUMBER,
	COD_MODALIDAD		NUMBER,
	COD_TRANSACCION		NUMBER,
	DES_TRANSACCION		VARCHAR2(100),
    COD_RUBRO           VARCHAR2(20),
	NRO_DOCUMENTO		VARCHAR2(20),
	NRO_DOCUMENTO2		VARCHAR2(20),
	NRO_DOCUMENTO3		VARCHAR2(20),
	REF_MOVIMIENTO		VARCHAR2(20),
	NRO_CUENTA			VARCHAR2(20),
	COD_MONEDA			VARCHAR2(3),
	TIP_MOVIMIENTO		VARCHAR2(1),
	MONTO				NUMBER,
	MTO_EQU_LOCAL		NUMBER, 
	COTIZACION			NUMBER,
	DOLARES				NUMBER,
	GUARANIES			NUMBER,
	HORA_DOC4			VARCHAR2(20),
	CONTROL				VARCHAR2(2)
) TABLESPACE IT_DATA;

CREATE INDEX IT.IDX_CBASIMOV_NRODOC ON IT.CB_ASI_MOV_TMP REFERENCE (NRO_ASIENTO, COD_TRA_PADRE, NRO_DOCUMENTO);
CREATE INDEX IT.IDX_CBASIMOV_NRODOC2 ON IT.CB_ASI_MOV_TMP REFERENCE (NRO_ASIENTO, COD_TRA_PADRE, NRO_DOCUMENTO2);
CREATE INDEX IT.IDX_CBASIMOV_NRODOC3 ON IT.CB_ASI_MOV_TMP REFERENCE (NRO_ASIENTO, COD_TRA_PADRE, NRO_DOCUMENTO3);
CREATE INDEX IT.IDX_CBASIMOV_REFMOV ON IT.CB_ASI_MOV_TMP REFERENCE (REF_MOVIMIENTO);