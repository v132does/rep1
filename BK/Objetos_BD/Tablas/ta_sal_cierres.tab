create table IT.TA_SAL_CIERRES
(
  nro_cuenta         VARCHAR2(15) not null,
  fec_cierre         DATE not null,
  sal_financiado     NUMBER(18,2) default 0 not null,
  sal_facturado      NUMBER(18,2) default 0 not null,
  sal_facturar       NUMBER(18,2) default 0 not null,
  lin_credito        NUMBER(18,2) default 0 not null,
  mto_pag_minimo     NUMBER(18,2) default 0 not null,
  fec_vto_pago       DATE not null,
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  lin_cuotas         NUMBER(18,2) default 0 not null,
  sal_cuo_pendientes NUMBER(18,2) default 0 not null,
  dia_atraso         NUMBER(5) default 0,
  lin_especial       NUMBER(18,2) default 0
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_SAL_CIERRES
  is 'Contiene los saldos de las tarjetas al cierre de facturacion. Se utiliza para la impresion en el extracto unico.';
comment on column IT.TA_SAL_CIERRES.nro_cuenta
  is 'Numero de Cuenta.';
comment on column IT.TA_SAL_CIERRES.fec_cierre
  is 'Fecha de Cierre.';
comment on column IT.TA_SAL_CIERRES.sal_financiado
  is 'Saldo Financiado.';
comment on column IT.TA_SAL_CIERRES.sal_facturado
  is 'Saldo Facturado no Vencido.';
comment on column IT.TA_SAL_CIERRES.sal_facturar
  is 'Saldo a Facturar.';
comment on column IT.TA_SAL_CIERRES.lin_credito
  is 'Linea de Credito.';
comment on column IT.TA_SAL_CIERRES.mto_pag_minimo
  is 'Monto de pago Minimo.';
comment on column IT.TA_SAL_CIERRES.fec_vto_pago
  is 'Fecha de Vencimiento de Pago.';
comment on column IT.TA_SAL_CIERRES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_SAL_CIERRES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_SAL_CIERRES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_SAL_CIERRES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.TA_SAL_CIERRES.lin_cuotas
  is 'Limite de Cuotas.';
comment on column IT.TA_SAL_CIERRES.sal_cuo_pendientes
  is 'Saldo de Cuotas Pendientes.';
comment on column IT.TA_SAL_CIERRES.dia_atraso
  is 'Dias de atraso de la cuenta.';
alter table IT.TA_SAL_CIERRES
  add constraint PK_TA_SAL_CIERRES primary key (NRO_CUENTA, FEC_CIERRE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_SAL_CIERRES
  add constraint FK_TSCIE_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.TA_CTA_TARJETAS (NRO_CUENTA);

