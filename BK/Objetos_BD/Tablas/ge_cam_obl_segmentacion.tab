create table IT.GE_CAM_OBL_SEGMENTACION
(
  cod_rub_primario  VARCHAR2(6) not null,
  cod_tip_actividad NUMBER not null,
  mandatorio        VARCHAR2(1) not null,
  plz_vigencia      NUMBER(4) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CAM_OBL_SEGMENTACION
  is 'Registra la Parametrización de campos obligatorios a completar por Código de Actividad';
comment on column IT.GE_CAM_OBL_SEGMENTACION.cod_rub_primario
  is 'Código de Actividad Primaria.';
comment on column IT.GE_CAM_OBL_SEGMENTACION.cod_tip_actividad
  is 'Tipo de Segmentacion (Dominio:COD_TIP_ACT_SEGMENTACION - Tabla BA_COD_REFERENCIA).';
comment on column IT.GE_CAM_OBL_SEGMENTACION.mandatorio
  is 'Valores posibles: S=Si, N=No.';
comment on column IT.GE_CAM_OBL_SEGMENTACION.plz_vigencia
  is 'Plazo de Vigencia.';
comment on column IT.GE_CAM_OBL_SEGMENTACION.usu_insercion
  is 'Usuario que realizo la inserción del registro.';
comment on column IT.GE_CAM_OBL_SEGMENTACION.fec_insercion
  is 'Fecha de inserción del registro.';
comment on column IT.GE_CAM_OBL_SEGMENTACION.usu_modificacion
  is 'Usuario que realizo la modificación del registro.';
comment on column IT.GE_CAM_OBL_SEGMENTACION.fec_modificacion
  is 'Fecha de modificación del registro.';
alter table IT.GE_CAM_OBL_SEGMENTACION
  add constraint PK_GE_CAM_OBL_SEGMENTACION primary key (COD_RUB_PRIMARIO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CAM_OBL_SEGMENTACION
  add constraint FK_GRUBECON_COD_RUB_ECONMICO foreign key (COD_RUB_PRIMARIO)
  references IT.GE_RUB_ECONOMICOS (COD_RUB_ECONOMICO);
alter table IT.GE_CAM_OBL_SEGMENTACION
  add constraint CHK_SEG_MANDATORIO
  check (mandatorio IN ('S', 'N'));

