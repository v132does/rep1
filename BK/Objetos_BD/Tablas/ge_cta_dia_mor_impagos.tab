comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.usu_insercion
  is 'Usuario de Inserción.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.fec_insercion
  is 'Fecha de Inserción.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.usu_modificacion
  is 'Usuario de Modificación.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.fec_modificacion
  is 'Fecha de Modificación.';
alter table IT.GE_CTA_DIA_MOR_IMPAGOS
  add constraint PK_GE_CTA_DIA_MOR_IMPAGOS primary key (NRO_CUENTA, NRO_LIN_SOBREGIRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
