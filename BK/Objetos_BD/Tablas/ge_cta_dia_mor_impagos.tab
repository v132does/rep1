create table IT.GE_CTA_DIA_MOR_IMPAGOS
(
  cod_modulo        NUMBER(3),
  cod_modalidad     NUMBER(3),
  nro_cuenta        VARCHAR2(15) not null,
  cod_persona       VARCHAR2(10),
  nro_lin_sobregiro NUMBER(7) not null,
  fec_inicio        DATE,
  fec_vencimiento   DATE,
  dia_mor_mes1      NUMBER(5),
  dia_mor_mes2      NUMBER(5),
  dia_mor_mes3      NUMBER(5),
  dia_mor_mes4      NUMBER(5),
  dia_mor_mes5      NUMBER(5),
  dia_mor_mes6      NUMBER(5),
  dia_mor_mes7      NUMBER(5),
  dia_mor_mes8      NUMBER(5),
  dia_mor_mes9      NUMBER(5),
  dia_mor_mes10     NUMBER(5),
  dia_mor_mes11     NUMBER(5),
  dia_mor_mes12     NUMBER(5),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CTA_DIA_MOR_IMPAGOS
  is 'Cantidad de días de Mora para Impagos.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.cod_modulo
  is 'Cod. de Modulo.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.cod_modalidad
  is 'Nro. de Modalidad.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.nro_cuenta
  is 'Nro. de Cuenta.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.cod_persona
  is 'Cod. de Persona.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.nro_lin_sobregiro
  is 'Nro. de Línea de Sobregiro.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.fec_inicio
  is 'Fecha de Inicio de la Línea de Sobregiro.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.fec_vencimiento
  is 'Fecha de Vencimiento de la Línea de Sobregiro.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes1
  is 'Días de Moras del mes 1.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes2
  is 'Días de Moras del mes 2.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes3
  is 'Días de Moras del mes 3.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes4
  is 'Días de Moras del mes 4.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes5
  is 'Días de Moras del mes 5.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes6
  is 'Días de Moras del mes 6.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes7
  is 'Días de Moras del mes 7.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes8
  is 'Días de Moras del mes 8.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes9
  is 'Días de Moras del mes 9.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes10
  is 'Días de Moras del mes 10.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes11
  is 'Días de Moras del mes 11.';
comment on column IT.GE_CTA_DIA_MOR_IMPAGOS.dia_mor_mes12
