create table IT.RH_DES_AUTOMATICOS
(
  cod_persona       VARCHAR2(10) not null,
  cod_tip_descuento NUMBER(3) not null,
  fec_desde         DATE not null,
  fec_hasta         DATE not null,
  monto             NUMBER(14,2),
  cod_moneda        VARCHAR2(3) not null,
  porcentaje        NUMBER(7,2),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_DES_AUTOMATICOS
  is 'Descuentos Automaticos a Empleados.';
comment on column IT.RH_DES_AUTOMATICOS.cod_persona
  is 'Codigo de la Persona.';
comment on column IT.RH_DES_AUTOMATICOS.cod_tip_descuento
  is 'Codigo del Tipo de Descuento.';
comment on column IT.RH_DES_AUTOMATICOS.fec_desde
  is 'Fecha Desde.';
comment on column IT.RH_DES_AUTOMATICOS.fec_hasta
  is 'Fecha Hasta.';
comment on column IT.RH_DES_AUTOMATICOS.monto
  is 'Monto del Descuento Automatico.';
comment on column IT.RH_DES_AUTOMATICOS.cod_moneda
  is 'Codigo de la Moneda.';
comment on column IT.RH_DES_AUTOMATICOS.porcentaje
  is 'Porcentaje del Descuento Automatico.';
comment on column IT.RH_DES_AUTOMATICOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_DES_AUTOMATICOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_DES_AUTOMATICOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.RH_DES_AUTOMATICOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_HDAUT_COD_TIP_DESCUENTO on IT.RH_DES_AUTOMATICOS (COD_TIP_DESCUENTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_DES_AUTOMATICOS
  add constraint PK_RH_DES_AUTOMATICOS primary key (COD_PERSONA, COD_TIP_DESCUENTO, FEC_DESDE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_DES_AUTOMATICOS
  add constraint FK_HDAUT_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.RH_DES_AUTOMATICOS
  add constraint FK_HDAUT_COD_PERSONA foreign key (COD_PERSONA)
  references IT.RH_EMPLEADOS (COD_PERSONA);
alter table IT.RH_DES_AUTOMATICOS
  add constraint FK_HDAUT_COD_TIP_DESCUENTO foreign key (COD_TIP_DESCUENTO)
  references IT.RH_TIP_DESCUENTOS (COD_TIP_DESCUENTO);
alter table IT.RH_DES_AUTOMATICOS
  add constraint CK_MONTO_PORCENTAJE_DES_AUT
  check ((PORCENTAJE is null
and MONTO is not null) or (PORCENTAJE is not null and MONTO is null));
alter table IT.RH_DES_AUTOMATICOS
  add constraint CK_RANGO_FECHAS_DES_AUT
  check (FEC_HASTA > FEC_DESDE);

