create table IT.CB_SAL_OFICINAS_TMP
(
  cod_oficina       NUMBER(3) not null,
  cod_rubro         VARCHAR2(15) not null,
  fecha             DATE not null,
  sal_mon_loc_ant   NUMBER(18,2) default 0,
  sal_mon_rub_ant   NUMBER(18,2) default 0,
  deb_mon_local     NUMBER(18,2) default 0,
  cre_mon_local     NUMBER(18,2) default 0,
  deb_mon_rubro     NUMBER(18,2) default 0,
  cre_mon_rubro     NUMBER(18,2) default 0,
  sal_equ_loc_ant   NUMBER(18,2) default 0,
  deb_equ_local     NUMBER(18,2) default 0,
  cre_equ_local     NUMBER(18,2) default 0,
  mto_aju_cambiario NUMBER(18,2) default 0,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SAL_OFICINAS_TMP
  is 'Contiene los registros de saldos contables on line por oficina.';
comment on column IT.CB_SAL_OFICINAS_TMP.cod_oficina
  is 'Código de oficina.';
comment on column IT.CB_SAL_OFICINAS_TMP.cod_rubro
  is 'Código de la cuenta contable.';
comment on column IT.CB_SAL_OFICINAS_TMP.fecha
  is 'Fecha.';
comment on column IT.CB_SAL_OFICINAS_TMP.sal_mon_loc_ant
  is 'Saldo total de ayer en moneda local(incluye sal_equ_loc_ant).';
comment on column IT.CB_SAL_OFICINAS_TMP.sal_mon_rub_ant
  is 'Saldo de ayer en moneda extranjera.';
comment on column IT.CB_SAL_OFICINAS_TMP.deb_mon_local
  is 'Debitos total de hoy en moneda local(deb_equ_local).';
comment on column IT.CB_SAL_OFICINAS_TMP.cre_mon_local
  is 'Creditos total de hoy en moneda local(cre_equ_local).';
comment on column IT.CB_SAL_OFICINAS_TMP.deb_mon_rubro
  is 'Debitos de hoy en moneda extranjera.';
comment on column IT.CB_SAL_OFICINAS_TMP.cre_mon_rubro
  is 'Creditos de hoy en moneda extranjera.';
comment on column IT.CB_SAL_OFICINAS_TMP.sal_equ_loc_ant
  is 'Saldo anterior del equivalente en gs de la moneda extranjera.';
comment on column IT.CB_SAL_OFICINAS_TMP.deb_equ_local
  is 'Total de debitos del equivalente en gs de la moneda extranjera.';
comment on column IT.CB_SAL_OFICINAS_TMP.cre_equ_local
  is 'Total de creditos del equivalente en gs de la moneda extranjera.';
comment on column IT.CB_SAL_OFICINAS_TMP.mto_aju_cambiario
  is 'Importe del Ajuste Cambiario a la Fecha de Proceso.';
comment on column IT.CB_SAL_OFICINAS_TMP.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CB_SAL_OFICINAS_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_SAL_OFICINAS_TMP.usu_modificacion
  is 'Usuario que realizó la modificación del registro.';
comment on column IT.CB_SAL_OFICINAS_TMP.fec_modificacion
  is 'Fecha en que se modifico el registro.';
alter table IT.CB_SAL_OFICINAS_TMP
  add constraint PK_CB_SAL_OFICINAS_TMP primary key (COD_OFICINA, COD_RUBRO, FECHA, USU_INSERCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

