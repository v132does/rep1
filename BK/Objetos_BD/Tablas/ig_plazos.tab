create table IT.IG_PLAZOS
(
  cod_plazo        NUMBER(3) not null,
  descripcion      VARCHAR2(60) not null,
  dia_hasta        NUMBER(5) not null,
  abreviatura      VARCHAR2(20) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.IG_PLAZOS
  is 'Plazos para las Tasas de Compensacion.';
comment on column IT.IG_PLAZOS.cod_plazo
  is 'Codigo del plazo.';
comment on column IT.IG_PLAZOS.descripcion
  is 'Descripcion del plazo.';
comment on column IT.IG_PLAZOS.dia_hasta
  is 'Cantidad de dias hasta los que se considera dentro del plazo.';
comment on column IT.IG_PLAZOS.abreviatura
  is 'Abreviatura o descripcion corta.';
comment on column IT.IG_PLAZOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.IG_PLAZOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.IG_PLAZOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.IG_PLAZOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.IG_PLAZOS
  add constraint PK_IG_PLAZOS primary key (COD_PLAZO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.IG_PLAZOS
  add constraint UK_IPLAZO_DIA_HASTA unique (DIA_HASTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.IG_PLAZOS
  add constraint AVCON_1180382030_COD_P_005
  check (COD_PLAZO BETWEEN 0 AND 999);

