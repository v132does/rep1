create table IT.LC_PLANTILLAS
(
  nro_plantilla        NUMBER(10) not null,
  nro_referencia       NUMBER(10),
  cod_tip_referencia   VARCHAR2(3),
  cod_moneda           VARCHAR2(3),
  monto                NUMBER(18,2) default 0,
  cod_banco            NUMBER(3),
  nom_banco            VARCHAR2(100),
  cod_pai_banco        NUMBER(3),
  cod_ciu_banco        NUMBER(3),
  cod_aba_banco        VARCHAR2(20),
  cod_swi_banco        VARCHAR2(20),
  cod_uid_banco        VARCHAR2(20),
  cod_bco_corresponsal NUMBER(3),
  cod_per_solicitante  VARCHAR2(10),
  nom_solicitante      VARCHAR2(120),
  dir_solicitante      VARCHAR2(100),
  tel_solicitante      VARCHAR2(20),
  cod_pai_solicitante  NUMBER(3),
  cod_ciu_solicitante  NUMBER(3),
  nom_ciu_solicitante  VARCHAR2(100),
  cod_per_beneficiario VARCHAR2(10),
  nro_doc_beneficiario VARCHAR2(20),
  nom_beneficiario     VARCHAR2(120),
  dir_beneficiario     VARCHAR2(100),
  tel_beneficiario     VARCHAR2(20),
  cod_pai_beneficiario NUMBER(3),
  cod_ciu_beneficiario NUMBER(3),
  nom_ciu_beneficiario VARCHAR2(100),
  nro_cta_referencia   VARCHAR2(30),
  fec_recepcion        DATE,
  cod_rubro            VARCHAR2(15),
  plazo                NUMBER(3),
  tip_mensaje          VARCHAR2(4),
  tip_cargo            VARCHAR2(3),
  cod_msj_swift        NUMBER(4),
  cod_bco_cor_contra   NUMBER(3),
  estado               VARCHAR2(4),
  fec_valor            DATE,
  observacion          VARCHAR2(1000),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  fec_envio            DATE,
  mto_cargo            NUMBER(18,2),
  tip_fondo            VARCHAR2(2),
  tip_motivo           VARCHAR2(2),
  tip_financiacion     VARCHAR2(2),
  nom_ordenante        VARCHAR2(35),
  tip_ref_obs          VARCHAR2(3),
  age_banco            VARCHAR2(35),
  nom_bco_cor_contra   VARCHAR2(100)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.LC_PLANTILLAS
  is 'Contiene los datos de las Plantillas para las Libranzas o Transferencias.';
comment on column IT.LC_PLANTILLAS.nro_plantilla
  is 'Numero de la plantilla.';
comment on column IT.LC_PLANTILLAS.nro_referencia
  is 'Numero de referencia de la transferencia.';
comment on column IT.LC_PLANTILLAS.cod_tip_referencia
  is 'Codigo de referencia de la transferencia.';
comment on column IT.LC_PLANTILLAS.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.LC_PLANTILLAS.monto
  is 'Monto de la transferencia.';
comment on column IT.LC_PLANTILLAS.cod_banco
  is 'Codigo del Banco emisor / pagador.';
comment on column IT.LC_PLANTILLAS.nom_banco
  is 'Nombre del Banco emisor / pagador.';
comment on column IT.LC_PLANTILLAS.cod_pai_banco
  is 'Codigo de pais del Banco emisor / pagador.';
comment on column IT.LC_PLANTILLAS.cod_ciu_banco
  is 'Codigo de ciudad del Banco emisor / pagador.';
comment on column IT.LC_PLANTILLAS.cod_aba_banco
  is 'Codigo de BLZ/ABA del Banco emisor / pagador.';
comment on column IT.LC_PLANTILLAS.cod_swi_banco
  is 'Codigo SWIFT del Banco emisor / pagador.';
comment on column IT.LC_PLANTILLAS.cod_uid_banco
  is 'Codigo UID del Banco emisor / pagador.';
comment on column IT.LC_PLANTILLAS.cod_bco_corresponsal
  is 'Codigo del Banco corresponsal.';
comment on column IT.LC_PLANTILLAS.cod_per_solicitante
  is 'Codigo del cliente solicitante.';
comment on column IT.LC_PLANTILLAS.nom_solicitante
  is 'Nombre y apellido del solicitante.';
comment on column IT.LC_PLANTILLAS.dir_solicitante
  is 'Direccion del solicitante.';
comment on column IT.LC_PLANTILLAS.tel_solicitante
  is 'Nro. de Telefono del solicitante.';
comment on column IT.LC_PLANTILLAS.cod_pai_solicitante
  is 'Codigo de pais del solicitante.';
comment on column IT.LC_PLANTILLAS.cod_ciu_solicitante
  is 'Codigo de ciudad del solicitante.';
comment on column IT.LC_PLANTILLAS.nom_ciu_solicitante
  is 'Nombre de la ciudad del Solicitante.';
comment on column IT.LC_PLANTILLAS.cod_per_beneficiario
  is 'Codigo del cliente beneficiario.';
comment on column IT.LC_PLANTILLAS.nro_doc_beneficiario
  is 'Numero de documento de identidad del beneficiario.';
comment on column IT.LC_PLANTILLAS.nom_beneficiario
  is 'Nombre y apellido del Beneficiario.';
comment on column IT.LC_PLANTILLAS.dir_beneficiario
  is 'Direccion del Beneficiario.';
comment on column IT.LC_PLANTILLAS.tel_beneficiario
  is 'Nro.de telefono del Beneficiario.';
comment on column IT.LC_PLANTILLAS.cod_pai_beneficiario
  is 'Codigo de pais del beneficiario.';
comment on column IT.LC_PLANTILLAS.cod_ciu_beneficiario
  is 'Codigo de ciudad del beneficiario.';
comment on column IT.LC_PLANTILLAS.nom_ciu_beneficiario
  is 'Nombre de la ciudad del Beneficiario.';
comment on column IT.LC_PLANTILLAS.nro_cta_referencia
  is 'Cuenta de referencia de la transferencia.';
comment on column IT.LC_PLANTILLAS.fec_recepcion
  is 'Fecha de recepcion de la transferencia.';
comment on column IT.LC_PLANTILLAS.cod_rubro
  is 'Cuenta contable imputada.';
comment on column IT.LC_PLANTILLAS.plazo
  is 'Plazo en dias.';
comment on column IT.LC_PLANTILLAS.tip_mensaje
  is 'Tipo de mensaje en el swift.';
comment on column IT.LC_PLANTILLAS.tip_cargo
  is 'Tipo de cargo generado en el swift.';
comment on column IT.LC_PLANTILLAS.cod_msj_swift
  is 'Codigo de mensaje para envio al swift.';
comment on column IT.LC_PLANTILLAS.cod_bco_cor_contra
  is 'Codigo del Banco Corresponsal de la Contraparte.';
comment on column IT.LC_PLANTILLAS.estado
  is 'Estado de la transferencia.';
comment on column IT.LC_PLANTILLAS.fec_valor
  is 'Fecha estimada de pago.';
comment on column IT.LC_PLANTILLAS.observacion
  is 'Observacion sobre la transferencia.';
comment on column IT.LC_PLANTILLAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.LC_PLANTILLAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.LC_PLANTILLAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.LC_PLANTILLAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.LC_PLANTILLAS.fec_envio
  is 'Fecha envio de datos al swift para transferencias emitidas.';
comment on column IT.LC_PLANTILLAS.mto_cargo
  is 'Monto del cargo de la transferencia.';
comment on column IT.LC_PLANTILLAS.tip_fondo
  is 'Origen de Fondos';
comment on column IT.LC_PLANTILLAS.tip_motivo
  is 'Motivo de la Transferencia';
comment on column IT.LC_PLANTILLAS.tip_financiacion
  is 'Tipo de financiacion';
comment on column IT.LC_PLANTILLAS.nom_ordenante
  is 'Nombre del Ordenante';
comment on column IT.LC_PLANTILLAS.tip_ref_obs
  is 'Tipo de Referencia de Observacion';
comment on column IT.LC_PLANTILLAS.age_banco
  is 'Agencia de Banco';
comment on column IT.LC_PLANTILLAS.nom_bco_cor_contra
  is 'Nombre del Banco Corresponsal del Pagador';
create index IT.IN_LPLAN_COD_PER_SOLICITANTE on IT.LC_PLANTILLAS (COD_PER_SOLICITANTE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_PLANTILLAS
  add constraint PK_LC_PLANTILLAS primary key (NRO_PLANTILLA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_BCO_CORRESP foreign key (COD_BCO_CORRESPONSAL)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_CIU_BEN foreign key (COD_CIU_BENEFICIARIO, COD_PAI_BENEFICIARIO)
  references IT.BA_CIUDADES (COD_CIUDAD, COD_PAIS);
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_CIUDAD foreign key (COD_CIU_BANCO, COD_PAI_BANCO)
  references IT.BA_CIUDADES (COD_CIUDAD, COD_PAIS);
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_CIU_SOL foreign key (COD_CIU_SOLICITANTE, COD_PAI_SOLICITANTE)
  references IT.BA_CIUDADES (COD_CIUDAD, COD_PAIS);
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_PAI_BEN foreign key (COD_PAI_BENEFICIARIO)
  references IT.BA_PAISES (COD_PAIS);
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_PAIS foreign key (COD_PAI_BANCO)
  references IT.BA_PAISES (COD_PAIS);
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_PAI_SOL foreign key (COD_PAI_SOLICITANTE)
  references IT.BA_PAISES (COD_PAIS);
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_PERSONA foreign key (COD_PER_SOLICITANTE)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_RUBRO foreign key (COD_RUBRO)
  references IT.CB_RUBROS (COD_RUBRO);
alter table IT.LC_PLANTILLAS
  add constraint FK_LPLAN_COD_TIP_REFERENCIA foreign key (COD_TIP_REFERENCIA)
  references IT.LC_TIP_REFERENCIAS (COD_TIP_REFERENCIA);
alter table IT.LC_PLANTILLAS
  add constraint CK_LPLAN_PLAZO
  check (PLAZO BETWEEN 0 AND 30);

