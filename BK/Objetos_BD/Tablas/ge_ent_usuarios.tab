create table IT.GE_ENT_USUARIOS
(
  cod_ente         NUMBER(5) not null,
  cod_usuario      VARCHAR2(10) not null,
  cod_usu_ente     VARCHAR2(12) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  activo           VARCHAR2(1) default 'S'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_ENT_USUARIOS
  is 'Usuarios de la entidad.';
comment on column IT.GE_ENT_USUARIOS.cod_ente
  is 'Codigo de ente.';
comment on column IT.GE_ENT_USUARIOS.cod_usuario
  is 'Codigo de usuario en el sistema.';
comment on column IT.GE_ENT_USUARIOS.cod_usu_ente
  is 'Codigo de usuario en el ente.';
comment on column IT.GE_ENT_USUARIOS.usu_insercion
  is 'Usuario que inserto el registro.';
comment on column IT.GE_ENT_USUARIOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_ENT_USUARIOS.usu_modificacion
  is 'Usuario que modifico el registro.';
comment on column IT.GE_ENT_USUARIOS.fec_modificacion
  is 'Fecha en que se modifico el registro.';
comment on column IT.GE_ENT_USUARIOS.activo
  is 'Indica si el usuario esta activo (S/N)';
create index IT.IN_GEUSU_COD_USU_ENTE on IT.GE_ENT_USUARIOS (COD_ENTE, COD_USU_ENTE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_ENT_USUARIOS
  add constraint PK_GE_ENT_USUARIOS primary key (COD_ENTE, COD_USUARIO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_ENT_USUARIOS
  add constraint FK_GEUSU_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.GE_ENT_USUARIOS
  add constraint FK_GEUSU_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);

