create global temporary table IT.SS2K5_SERVER_PRINCIPALS
(
  db_id NUMBER(10),
  name  VARCHAR2(256) not null,
  sid   RAW(85),
  type  CHAR(2) not null
)
on commit preserve rows;
create index IT.SS2K5_SERVER_PRINCIPALS_DB_ID on IT.SS2K5_SERVER_PRINCIPALS (DB_ID);
create index IT.SS2K5_SERVER_PRINCIPALS_NAME on IT.SS2K5_SERVER_PRINCIPALS (NAME);
create index IT.SS2K5_SERVER_PRINCIPALS_SID on IT.SS2K5_SERVER_PRINCIPALS (SID);

