create table IT.MD_FILE_ARTIFACTS
(
  id                  NUMBER,
  applicationfiles_id NUMBER,
  pattern             VARCHAR2(4000),
  string_found        VARCHAR2(4000),
  string_replaced     VARCHAR2(4000),
  type                VARCHAR2(200),
  status              VARCHAR2(4000),
  line                NUMBER,
  pattern_start       NUMBER,
  pattern_end         NUMBER,
  due_date            DATE,
  db_type             VARCHAR2(100),
  code_type           VARCHAR2(1000),
  description         VARCHAR2(4000),
  priority            INTEGER,
  security_group_id   VARCHAR2(20) default '0' not null,
  created_on          DATE default sysdate not null,
  created_by          VARCHAR2(4000),
  last_updated        DATE,
  last_updated_by     VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MD_FILE_ARTIFACTS
  is 'Holds a tuple for each interesting thing the scanner finds in a file';
comment on column IT.MD_FILE_ARTIFACTS.pattern
  is 'Pattern used to search source file for interesting artifiacts';
comment on column IT.MD_FILE_ARTIFACTS.string_found
  is 'String found in source from the pattern supplied';
comment on column IT.MD_FILE_ARTIFACTS.string_replaced
  is 'This is the string which replace the string found if it was replaced.';
comment on column IT.MD_FILE_ARTIFACTS.type
  is 'This is the type of the replacement.  It could be a straight replace from a replacement pattern, or we could have passed the string to a translator which would change the string depending on the database.';
comment on column IT.MD_FILE_ARTIFACTS.status
  is 'Pattern used to search source file for interesting artifiacts';
comment on column IT.MD_FILE_ARTIFACTS.due_date
  is 'Due date is used by the TODO mechanism to manage the validation and work to complete this change';
comment on column IT.MD_FILE_ARTIFACTS.db_type
  is 'Source database calls type';
comment on column IT.MD_FILE_ARTIFACTS.code_type
  is 'Source code db api, like dblib, jdbc';
comment on column IT.MD_FILE_ARTIFACTS.description
  is 'This is a description of the artifact which will have a default generated by the scanner and then can be modified by the user to be more appropriate for their use';
comment on column IT.MD_FILE_ARTIFACTS.priority
  is 'The priority is set for the TODOs so they can be managed by the user';
alter table IT.MD_FILE_ARTIFACTS
  add constraint MD_FILE_ARTIFACTS_PK primary key (ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.MD_FILE_ARTIFACTS
  add constraint MD_ARTIFACT_FILE_FK foreign key (APPLICATIONFILES_ID)
  references IT.MD_APPLICATIONFILES (ID) on delete cascade;
alter table IT.MD_FILE_ARTIFACTS
  add constraint MD_APP_FILE_ART_NONULL
  check ("ID" IS NOT NULL);
alter table IT.MD_FILE_ARTIFACTS
  add constraint MD_APPL_FILE_FK_NONULL
  check ("APPLICATIONFILES_ID" IS NOT NULL);

