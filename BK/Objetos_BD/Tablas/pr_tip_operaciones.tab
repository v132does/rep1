create table IT.PR_TIP_OPERACIONES
(
  cod_tip_operacion VARCHAR2(3) not null,
  descripcion       VARCHAR2(200),
  cod_modulo        NUMBER(3) not null,
  cod_modalidad     NUMBER(3) not null,
  cod_sub_modalidad NUMBER(3),
  re_calcular       VARCHAR2(1),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_TIP_OPERACIONES
  is 'Contiene los datos de los Tipos de Operaciones de Tasa Variable';
comment on column IT.PR_TIP_OPERACIONES.cod_tip_operacion
  is 'Codigo de Tipo de Operacion';
comment on column IT.PR_TIP_OPERACIONES.descripcion
  is 'Descripcion';
comment on column IT.PR_TIP_OPERACIONES.cod_modulo
  is 'Codigo de Modulo';
comment on column IT.PR_TIP_OPERACIONES.cod_modalidad
  is 'Codigo de Modalidad';
comment on column IT.PR_TIP_OPERACIONES.cod_sub_modalidad
  is 'Codigo de Sub Modalidad';
comment on column IT.PR_TIP_OPERACIONES.re_calcular
  is 'Recalcular en Forma automática(S/N)';
comment on column IT.PR_TIP_OPERACIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.PR_TIP_OPERACIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.PR_TIP_OPERACIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.PR_TIP_OPERACIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.PR_TIP_OPERACIONES
  add constraint PK_PR_TIP_OPERACIONES primary key (COD_TIP_OPERACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

