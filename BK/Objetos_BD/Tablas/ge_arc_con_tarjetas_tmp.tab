create table IT.GE_ARC_CON_TARJETAS_TMP
(
  codigo           NUMBER(18) not null,
  cod_ente         VARCHAR2(20) not null,
  nro_cuenta       VARCHAR2(25) not null,
  fecha            VARCHAR2(20) not null,
  descripcion      VARCHAR2(100),
  nro_documento    VARCHAR2(100),
  debe             NUMBER(18,2),
  haber            NUMBER(18,2),
  cod_moneda       VARCHAR2(3),
  tipo             VARCHAR2(50),
  observacion      VARCHAR2(500),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  referencia       VARCHAR2(500),
  fec_valor        VARCHAR2(20),
  facturador       VARCHAR2(1) default 'N',
  nro_lote         NUMBER(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_ARC_CON_TARJETAS_TMP.codigo
  is 'Codigo de Registro';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.cod_ente
  is 'Codigo de Ente';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.nro_cuenta
  is 'Nro de Cuenta Informada';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.fecha
  is 'Fecha';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.descripcion
  is 'Descripcion';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.nro_documento
  is 'Nro.Documento';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.debe
  is 'Debe';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.haber
  is 'Haber';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.cod_moneda
  is 'Codigo de Moneda';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.tipo
  is 'Tipo';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.observacion
  is 'Observacion';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.referencia
  is 'Referencia para Facturador';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.fec_valor
  is 'Fecha de Valor (Fecha Transaccion)';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.facturador
  is 'Facturador(S/N)';
comment on column IT.GE_ARC_CON_TARJETAS_TMP.nro_lote
  is 'Número de Lote para compensación';
alter table IT.GE_ARC_CON_TARJETAS_TMP
  add constraint PK_GE_ARC_CON_TARJETAS primary key (COD_ENTE, NRO_CUENTA, FECHA, CODIGO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

