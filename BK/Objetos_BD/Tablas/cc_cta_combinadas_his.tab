create table IT.CC_CTA_COMBINADAS_HIS
(
  nro_ref_cta_combinada NUMBER not null,
  nro_cta_ahorro        VARCHAR2(15) not null,
  nro_cta_cte           VARCHAR2(15) not null,
  sal_minimo            NUMBER(16,2),
  fec_apertura          DATE,
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(240) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default SYSDATE not null,
  observaciones         VARCHAR2(100),
  tip_movimiento        VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CTA_COMBINADAS_HIS
  is 'Historico de Maestro de Cuentas Combinadas.';
comment on column IT.CC_CTA_COMBINADAS_HIS.nro_ref_cta_combinada
  is 'Numero de Referencia.';
comment on column IT.CC_CTA_COMBINADAS_HIS.nro_cta_ahorro
  is 'Numero de cuenta de ahorro a la vista.';
comment on column IT.CC_CTA_COMBINADAS_HIS.nro_cta_cte
  is 'Numero de cuenta de cuenta corriente.';
comment on column IT.CC_CTA_COMBINADAS_HIS.sal_minimo
  is 'Saldo minimo pactado.';
comment on column IT.CC_CTA_COMBINADAS_HIS.fec_apertura
  is 'Fecha de apertura.';
comment on column IT.CC_CTA_COMBINADAS_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CTA_COMBINADAS_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CTA_COMBINADAS_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CTA_COMBINADAS_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CTA_COMBINADAS_HIS.observaciones
  is 'Observaciones.';
comment on column IT.CC_CTA_COMBINADAS_HIS.tip_movimiento
  is 'Tipo de Movimiento I(Insercion) E(Eliminacion) A(Actualizacion).';
create index IT.IN_CCCOMH_NRO_CTA_AHORRO on IT.CC_CTA_COMBINADAS_HIS (NRO_CTA_AHORRO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CTA_COMBINADAS_HIS
  add constraint PK_CC_CTA_COMBINADAS_HIS primary key (NRO_REF_CTA_COMBINADA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

