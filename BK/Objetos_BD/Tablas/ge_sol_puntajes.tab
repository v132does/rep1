create table IT.GE_SOL_PUNTAJES
(
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3),
  cod_campana      NUMBER(3),
  cod_canal        NUMBER(3),
  cod_puntaje      NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SOL_PUNTAJES
  is 'Asignacion del Scoring.';
comment on column IT.GE_SOL_PUNTAJES.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.GE_SOL_PUNTAJES.cod_modalidad
  is 'Codigo de la modalidad.';
comment on column IT.GE_SOL_PUNTAJES.cod_campana
  is 'Código de Campaña.';
comment on column IT.GE_SOL_PUNTAJES.cod_canal
  is 'Codigo de canal.';
comment on column IT.GE_SOL_PUNTAJES.cod_puntaje
  is 'Codigo de Puntaje.';
comment on column IT.GE_SOL_PUNTAJES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_SOL_PUNTAJES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_SOL_PUNTAJES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_SOL_PUNTAJES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_SOL_PUNTAJES
  add constraint UK_GE_SOL_PUNTAJES unique (COD_MODULO, COD_MODALIDAD, COD_CAMPANA, COD_CANAL, COD_PUNTAJE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_PUNTAJES
  add constraint FK_GSPUN_COD_CAMPANA foreign key (COD_CAMPANA)
  references IT.CR_CAMPANAS (COD_CAMPANA);
alter table IT.GE_SOL_PUNTAJES
  add constraint FK_GSPUN_COD_CANAL foreign key (COD_CANAL)
  references IT.GE_CANALES (COD_CANAL);
alter table IT.GE_SOL_PUNTAJES
  add constraint FK_GSPUN_COD_MODULO foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_SOL_PUNTAJES
  add constraint FK_GSPUN_COD_PUNTAJE foreign key (COD_PUNTAJE)
  references IT.CR_PUNTAJES (COD_PUNTAJE);
alter table IT.GE_SOL_PUNTAJES
  add constraint AVCON_1086734539_COD_C_000
  check (COD_CAMPANA BETWEEN 0 AND 999);
alter table IT.GE_SOL_PUNTAJES
  add constraint AVCON_1086734539_COD_C_001
  check (COD_CANAL BETWEEN 0 AND 999);
alter table IT.GE_SOL_PUNTAJES
  add constraint AVCON_1086734539_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_SOL_PUNTAJES
  add constraint AVCON_1086734539_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_SOL_PUNTAJES
  add constraint AVCON_1086734539_COD_P_000
  check (COD_PUNTAJE BETWEEN 0 AND 999);

