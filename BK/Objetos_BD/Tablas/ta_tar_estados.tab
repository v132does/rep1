create table IT.TA_TAR_ESTADOS
(
  cod_estado       NUMBER(2) not null,
  descripcion      VARCHAR2(35) not null,
  blo_automatico   VARCHAR2(1) default 'N' not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_TAR_ESTADOS
  is 'Contiene los estados de las tarjetas, con un indicador de si debe bloquear automaticamente al pasar a este estado.';
comment on column IT.TA_TAR_ESTADOS.cod_estado
  is 'Codigo de Estado.';
comment on column IT.TA_TAR_ESTADOS.descripcion
  is 'Descripcion.';
comment on column IT.TA_TAR_ESTADOS.blo_automatico
  is 'Indicador de Bloqueo Automatico.';
comment on column IT.TA_TAR_ESTADOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_TAR_ESTADOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_TAR_ESTADOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_TAR_ESTADOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.TA_TAR_ESTADOS
  add constraint PK_TA_TAR_ESTADOS primary key (COD_ESTADO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_TAR_ESTADOS
  add constraint AVCON_1081353182_BLO_A_000
  check (BLO_AUTOMATICO IN ('S', 'N'));

