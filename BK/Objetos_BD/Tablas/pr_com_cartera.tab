create index IT.IN_PCCAR_COD_RUB_ECONOMICO on IT.PR_COM_CARTERA (COD_RUB_ECONOMICO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_COM_CARTERA
  add constraint PK_PR_COM_CARTERA primary key (NRO_OPERACION, COD_ENTE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

