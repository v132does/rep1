create table IT.PR_COM_CARTERA
(
  fecha                     DATE default trunc(SYSDATE) not null,
  cod_oficina               NUMBER(3) default 1,
  nro_documento             VARCHAR2(20) not null,
  cod_tip_documento         NUMBER(3) not null,
  cod_pais                  NUMBER(3) not null,
  nombre                    VARCHAR2(60) not null,
  apellido                  VARCHAR2(60) not null,
  tipo                      VARCHAR2(1) not null,
  fec_nacimiento            DATE not null,
  dir_particular            VARCHAR2(80) not null,
  nro_dir_particular        VARCHAR2(8) not null,
  cod_pais_dir_particular   NUMBER(3) not null,
  cod_ciu_dir_particular    NUMBER(3),
  cod_bar_dir_particular    NUMBER(3),
  obs_dir_particular        VARCHAR2(100),
  dir_laboral               VARCHAR2(80) not null,
  nro_dir_laboral           VARCHAR2(8) not null,
  cod_pais_dir_laboral      NUMBER(3) not null,
  cod_ciu_dir_laboral       NUMBER(3),
  cod_bar_dir_laboral       NUMBER(3),
  obs_dir_laboral           VARCHAR2(100),
  tip_linea_particular      VARCHAR2(1) default 'B' not null,
  area_tel_particular       VARCHAR2(10) not null,
  tel_particular            VARCHAR2(10) not null,
  tip_linea_laboral         VARCHAR2(1) default 'B' not null,
  area_tel_laboral          VARCHAR2(10) not null,
  tel_laboral               VARCHAR2(10) not null,
  lug_trabajo               VARCHAR2(70) not null,
  mto_ingreso               NUMBER(18,2) not null,
  antiguedad                NUMBER(10),
  des_puesto                VARCHAR2(80) not null,
  cod_banca                 NUMBER(3) not null,
  cod_rub_economico         VARCHAR2(6) not null,
  tip_destino               VARCHAR2(1) not null,
  cod_moneda                VARCHAR2(3) not null,
  sal_prestamo              NUMBER(18,2) not null,
  can_cuotas                NUMBER(5) not null,
  val_tasa                  NUMBER(20,4) not null,
  fec_pri_vencimiento       DATE not null,
  mto_cuota                 NUMBER(18,2) not null,
  mto_gto_administrativo    NUMBER(18,2),
  mto_seguro                NUMBER(18,2),
  descripcion               VARCHAR2(35) not null,
  procesado                 VARCHAR2(1) default 'N',
  observaciones             VARCHAR2(1000),
  nro_operacion             VARCHAR2(15) not null,
  nro_lote                  NUMBER(10),
  cod_ente                  NUMBER(5) not null,
  cod_rub_primario          VARCHAR2(6),
  nro_solicitud             NUMBER(7),
  cod_canal                 NUMBER(3),
  cod_campana               NUMBER(3),
  cod_usu_oficial           VARCHAR2(10),
  usu_insercion             VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_insercion             DATE default SYSDATE not null,
  usu_modificacion          VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_modificacion          DATE default SYSDATE not null,
  cod_sex_cliente           VARCHAR2(1),
  fec_ini_operacion         DATE,
  nom_codeudor              VARCHAR2(60),
  ape_codeudor              VARCHAR2(60),
  nro_doc_codeudor          VARCHAR2(20),
  cod_tip_doc_codeudor      NUMBER(3),
  cod_sex_codeudor          VARCHAR2(1),
  nom_conyuge               VARCHAR2(60),
  ape_conyuge               VARCHAR2(60),
  nro_doc_conyuge           VARCHAR2(20),
  cod_tip_doc_conyuge       NUMBER(3),
  cod_sex_conyuge           VARCHAR2(1),
  nom_cony_codeudor         VARCHAR2(60),
  ape_cony_codeudor         VARCHAR2(60),
  nro_doc_cony_codeudor     VARCHAR2(20),
  cod_tip_doc_cony_codeudor NUMBER(3),
  cod_sex_cony_codeudor     VARCHAR2(1),
  judicializado             VARCHAR2(1),
  fec_juicio                DATE,
  inhibido                  VARCHAR2(1),
  fec_inhibicion            DATE,
  ind_recurso               VARCHAR2(1) default 'N',
  tip_prestamo              VARCHAR2(15) not null,
  sec_publico               VARCHAR2(1) default 'N' not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_COM_CARTERA
  is 'Operaciones Compra de Cartera';
comment on column IT.PR_COM_CARTERA.fecha
  is 'Fecha de importación.';
