alter table IT.GE_ENV_PAG_PROVEEDORES_TMP
  add constraint PK_GE_PAG_PROV_TMP primary key (CODIGO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
