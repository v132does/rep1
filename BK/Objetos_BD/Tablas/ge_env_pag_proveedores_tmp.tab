comment on column IT.GE_ENV_PAG_PROVEEDORES_TMP.nro_tra_sipap
  is 'Nro.Transf.Sipap';
comment on column IT.GE_ENV_PAG_PROVEEDORES_TMP.est_pag_otr_banco
  is 'Estado de Pago Otro Banco';
comment on column IT.GE_ENV_PAG_PROVEEDORES_TMP.mot_rechazo
