create table IT.SB_BCP_CIU_TMP (
    COD_BCP      VARCHAR2(5),
    COD_PAI_ISO  VARCHAR2(2),
    DESCRIPCION  VARCHAR2(60),
    DES_PAIS     VARCHAR2(60),
    DEPARTAMENTO VARCHAR2(30)
) TABLESPACE IT_DATA;

COMMENT ON TABLE IT.SB_BCP_CIU_TMP IS 'Staging: catalogo de ciudades BCP (CIUDADES_BCP.CSV). Transitoria: se purga tras cada carga.';

CREATE PUBLIC SYNONYM SB_BCP_CIU_TMP FOR IT.SB_BCP_CIU_TMP;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_BCP_CIU_TMP TO IT_CONSULTAS;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_BCP_CIU_TMP TO IT_TEMPORAL;
