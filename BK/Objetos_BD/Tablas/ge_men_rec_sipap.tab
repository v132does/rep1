-- Create table
create table IT.GE_MEN_REC_SIPAP
(
  id_mensaje       NUMBER(15) default it.s_nro_men_rec_sipap.nextval not null,
  estado           VARCHAR2(32) not null,
  msj_swift        VARCHAR2(4000) not null,
  sqs_message_id   VARCHAR2(4000) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.GE_MEN_REC_SIPAP
  is 'Contiene los mensajes que se reciben del BCP vía SOCKET SIPAP.';
-- Add comments to the columns 
comment on column IT.GE_MEN_REC_SIPAP.id_mensaje
  is 'Nro de identificador de la tabla ';
comment on column IT.GE_MEN_REC_SIPAP.estado
  is 'PENDING,PROCESSING,ERROR,APPROVED';
comment on column IT.GE_MEN_REC_SIPAP.msj_swift
  is 'mensaje swift recibido';
comment on column IT.GE_MEN_REC_SIPAP.sqs_message_id
  is 'UUID del mensaje';
comment on column IT.GE_MEN_REC_SIPAP.usu_insercion
  is 'Usuario que inserto el registro';
comment on column IT.GE_MEN_REC_SIPAP.fec_insercion
  is 'Fecha de insercion';
comment on column IT.GE_MEN_REC_SIPAP.usu_modificacion
  is 'Usuario que modifico el registro';
comment on column IT.GE_MEN_REC_SIPAP.fec_modificacion
  is 'Fecha de modificacion';
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.GE_MEN_REC_SIPAP
  add constraint PK_MEN_REC_SIPAP primary key (ID_MENSAJE)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_MEN_REC_SIPAP
  add constraint UK_ID_MENSAJE unique (SQS_MESSAGE_ID)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 167
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.GE_MEN_REC_SIPAP to IT_TEMPORAL;
