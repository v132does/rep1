create table IT.GE_ENT_CLIENTES_HIS
(
  cod_ente         NUMBER(5) not null,
  cod_persona      VARCHAR2(10) not null,
  nro_cuenta       VARCHAR2(15),
  fec_desde        DATE not null,
  observacion      VARCHAR2(300),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_ENT_CLIENTES_HIS
  is 'Catalogo de Clientes por Entes';
comment on column IT.GE_ENT_CLIENTES_HIS.cod_ente
  is 'Codigo de Ente';
comment on column IT.GE_ENT_CLIENTES_HIS.cod_persona
  is 'Codigo de Persona';
comment on column IT.GE_ENT_CLIENTES_HIS.nro_cuenta
  is 'Número de Cuenta';
comment on column IT.GE_ENT_CLIENTES_HIS.fec_desde
  is 'Fecha Desde el momento de la modificación del ente.';
comment on column IT.GE_ENT_CLIENTES_HIS.observacion
  is 'Observacion';
comment on column IT.GE_ENT_CLIENTES_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_ENT_CLIENTES_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_ENT_CLIENTES_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_ENT_CLIENTES_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_ENT_CLIENTES_HIS
  add constraint PK_GE_ENT_CLIENTES_HIS primary key (COD_ENTE, COD_PERSONA, FEC_DESDE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_ENT_CLIENTES_HIS
  add constraint FK_GENTE_CHIS_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);

