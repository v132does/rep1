create table IT.TA_SOLICITUDES_TMP
(
  cod_oficina       NUMBER(3) not null,
  cod_tip_documento NUMBER(3) default 1 not null,
  nro_documento     VARCHAR2(20) not null,
  afinidad          VARCHAR2(10) not null,
  cod_modalidad     NUMBER(3),
  fec_solicitud     DATE default SYSDATE,
  fec_aprobacion    DATE default SYSDATE,
  deb_automatico    VARCHAR2(1) default 'N' not null,
  nro_cta_debito    VARCHAR2(15),
  tip_cobro         VARCHAR2(1) default 'M',
  nom_embozado      VARCHAR2(26),
  monto             NUMBER(18,2) default 0 not null,
  tip_envio         VARCHAR2(1) default 'D',
  referencia        VARCHAR2(35),
  pre_embozada      VARCHAR2(1),
  per_tasa          VARCHAR2(1),
  lin_especial      NUMBER(18,3),
  cod_tas_procard   NUMBER(3),
  retener           VARCHAR2(1) default ('N'),
  por_pag_minimo    NUMBER(5,2) default 0,
  cod_persona       VARCHAR2(10),
  sub_afinidad      VARCHAR2(2),
  par_modalidad     VARCHAR2(1),
  observacion       VARCHAR2(240),
  nro_solicitud     NUMBER(15),
  det_error         VARCHAR2(4000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_SOLICITUDES_TMP.cod_oficina
  is 'Código de Oficina.';
comment on column IT.TA_SOLICITUDES_TMP.cod_tip_documento
  is 'Código del Tipo de Documento.';
comment on column IT.TA_SOLICITUDES_TMP.nro_documento
  is 'Nro. de Documento.';
comment on column IT.TA_SOLICITUDES_TMP.afinidad
  is 'Afinidad de la Tarjeta.';
comment on column IT.TA_SOLICITUDES_TMP.cod_modalidad
  is 'Modalidad.';
comment on column IT.TA_SOLICITUDES_TMP.fec_solicitud
  is 'Fecha de la Solicitud.';
comment on column IT.TA_SOLICITUDES_TMP.fec_aprobacion
  is 'Fecha de Aprobación de la Solicitud.';
comment on column IT.TA_SOLICITUDES_TMP.deb_automatico
  is 'Indicador de Forma de Pago. (S=Débito Automático N= En Ventanilla)';
comment on column IT.TA_SOLICITUDES_TMP.nro_cta_debito
  is 'Nro. de la Cuenta de Débito. ';
comment on column IT.TA_SOLICITUDES_TMP.tip_cobro
  is 'Tipo de Cobro. (M=Mínimo, T=Total)';
comment on column IT.TA_SOLICITUDES_TMP.nom_embozado
  is 'Nombre del Embozado.';
comment on column IT.TA_SOLICITUDES_TMP.monto
  is 'Monto Aprobado.';
comment on column IT.TA_SOLICITUDES_TMP.tip_envio
  is 'Tipo de Envío. (D=Dirección, R=Retener).';
comment on column IT.TA_SOLICITUDES_TMP.referencia
  is 'Referencia del Tipo de Envío. ';
comment on column IT.TA_SOLICITUDES_TMP.pre_embozada
  is 'Indicador de Solicitud de Tarjeta Pre Embozada.';
comment on column IT.TA_SOLICITUDES_TMP.per_tasa
  is 'Tasa Personalizada.';
comment on column IT.TA_SOLICITUDES_TMP.lin_especial
  is 'Línea de Crédito Especial (Linea Salud).';
comment on column IT.TA_SOLICITUDES_TMP.cod_tas_procard
  is 'Código de tasa de Procard.';
comment on column IT.TA_SOLICITUDES_TMP.retener
  is 'Retener.';
comment on column IT.TA_SOLICITUDES_TMP.por_pag_minimo
  is 'Porcentaje de Pago Mínimo.';
comment on column IT.TA_SOLICITUDES_TMP.cod_persona
  is 'Código de la Persona.';
comment on column IT.TA_SOLICITUDES_TMP.sub_afinidad
  is 'Sub Afinidad.';
comment on column IT.TA_SOLICITUDES_TMP.par_modalidad
  is 'Indicador de Modalidad Exenta de Impuesto.';
comment on column IT.TA_SOLICITUDES_TMP.observacion
  is 'Observación.';
comment on column IT.TA_SOLICITUDES_TMP.nro_solicitud
  is 'Número de la Solicitud.';
comment on column IT.TA_SOLICITUDES_TMP.det_error
  is 'Detalles del Error.';

