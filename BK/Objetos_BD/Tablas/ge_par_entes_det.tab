create table IT.GE_PAR_ENTES_DET
(
  cod_ente         NUMBER(5) not null,
  parametro        VARCHAR2(30) not null,
  val_parametro    VARCHAR2(200) not null,
  descripcion      VARCHAR2(100) not null,
  referencia       VARCHAR2(200),
  cod_moneda       VARCHAR2(3),
  ref_adicional    VARCHAR2(200),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAR_ENTES_DET
  is 'Contiene datos de Detalles de Parámetros para Entes.';
comment on column IT.GE_PAR_ENTES_DET.cod_ente
  is 'Código del Ente.';
comment on column IT.GE_PAR_ENTES_DET.parametro
  is 'Parámetro del Ente a ser Detallado.';
comment on column IT.GE_PAR_ENTES_DET.val_parametro
  is 'Valor del Parámetro Detallado.';
comment on column IT.GE_PAR_ENTES_DET.descripcion
  is 'Descripción General del Parámetro.';
comment on column IT.GE_PAR_ENTES_DET.referencia
  is 'Referencia para el Detalle de Parámetros, nro. de cuenta, cod. persona u otro dato que sirva de referencia.';
comment on column IT.GE_PAR_ENTES_DET.cod_moneda
  is 'Código de la Moneda.';
comment on column IT.GE_PAR_ENTES_DET.ref_adicional
  is 'Referencia adicional para el Detalle de Parámetros.';
comment on column IT.GE_PAR_ENTES_DET.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_PAR_ENTES_DET.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_PAR_ENTES_DET.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_PAR_ENTES_DET.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_GPEDE_COD_MONEDA on IT.GE_PAR_ENTES_DET (COD_MONEDA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAR_ENTES_DET
  add constraint PK_GE_PAR_ENTES_DET primary key (COD_ENTE, PARAMETRO, VAL_PARAMETRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAR_ENTES_DET
  add constraint FK_GPEDE_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);

