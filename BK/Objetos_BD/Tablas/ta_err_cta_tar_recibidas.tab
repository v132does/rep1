alter table IT.TA_ERR_CTA_TAR_RECIBIDAS
  add constraint PK_TA_ERR_CTA_TAR_RECIBIDAS primary key (NRO_CUENTA, FEC_PROCESO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

