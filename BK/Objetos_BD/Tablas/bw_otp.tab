create table IT.BW_OTP
(
  nro_otp           NUMBER not null,
  cod_persona       VARCHAR2(10) not null,
  cod_per_vinculada VARCHAR2(10),
  otp               VARCHAR2(100) not null,
  estado            VARCHAR2(1) not null,
  can_intentos      NUMBER,
  fec_ult_error     DATE,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_OTP
  is 'Claves de un solo uso';
comment on column IT.BW_OTP.cod_persona
  is 'Código del Cliente.';
comment on column IT.BW_OTP.cod_per_vinculada
  is 'Código de la Persona a la que está vinculada el Cliente.';
comment on column IT.BW_OTP.otp
  is 'Valor del otp encriptado';
comment on column IT.BW_OTP.estado
  is 'Estado del otp. P:PENDIENTE, C:CONFIRMADO, A: ANULADO';
comment on column IT.BW_OTP.can_intentos
  is 'Cantidad de intentos fallidos';
comment on column IT.BW_OTP.fec_ult_error
  is 'Fecha de ultimo intento fallido';
comment on column IT.BW_OTP.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.BW_OTP.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.BW_OTP.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.BW_OTP.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.BW_OTP
  add constraint PK_BW_OTP primary key (NRO_OTP)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BW_OTP
  add constraint FK_BW_OTP_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.BW_OTP
  add constraint FK_BW_OTP_COD_PER_VINCULADA foreign key (COD_PER_VINCULADA)
  references IT.BA_PERSONAS (COD_PERSONA);

