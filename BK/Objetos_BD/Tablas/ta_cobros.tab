create table IT.TA_COBROS
(
  nro_cuenta       VARCHAR2(15) not null,
  nro_tarjeta      VARCHAR2(25) not null,
  nro_cta_debito   VARCHAR2(15),
  fec_proceso      DATE not null,
  monto            NUMBER(18,2) default 0 not null,
  estado           VARCHAR2(1) not null,
  fec_valor        DATE not null,
  observacion      VARCHAR2(50),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  est_envio        VARCHAR2(1) default 'P',
  hora             VARCHAR2(8),
  cod_usuario      VARCHAR2(10),
  dia_mora         NUMBER(5),
  tip_envio        VARCHAR2(1) default 'O',
  tipo             VARCHAR2(1),
  red_pago         VARCHAR2(2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_COBROS
  is 'Contiene los datos de los cobros realizados hasta la fecha. Esta tabla se utiliza para enviar a las administradoras los cobros recibidos en el dia. (fba120.fecha del dia).  ** Mantener seis meses **';
comment on column IT.TA_COBROS.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.TA_COBROS.nro_tarjeta
  is 'Numero de Tarjeta.';
comment on column IT.TA_COBROS.nro_cta_debito
  is 'Numero de Cuenta.';
comment on column IT.TA_COBROS.fec_proceso
  is 'Fecha de Proceso.';
comment on column IT.TA_COBROS.monto
  is 'Importe de debito.';
comment on column IT.TA_COBROS.estado
  is 'Estado del Registro: C-Cobrado en Caja P-Procesado por debito en cuenta E-No procesado por error.';
comment on column IT.TA_COBROS.fec_valor
  is 'Fecha Valor del Pago.';
comment on column IT.TA_COBROS.observacion
  is 'Observaciones, en caso de que hubo error descripcion del Error...';
comment on column IT.TA_COBROS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.TA_COBROS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.TA_COBROS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.TA_COBROS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.TA_COBROS.est_envio
  is 'Estado de Envio a la Procesadora P=Pendiente, E=Enviado, W=Webservice Bancard.';
comment on column IT.TA_COBROS.hora
  is 'Hora.';
comment on column IT.TA_COBROS.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.TA_COBROS.dia_mora
  is 'Dias de Mora en el momento del cobro.';
comment on column IT.TA_COBROS.tip_envio
  is 'Tipo de Envío de cobro "B" - Batch, "O" - Online.';
comment on column IT.TA_COBROS.tipo
  is 'Tipo P-Pago, R-Reversión';
comment on column IT.TA_COBROS.red_pago
  is 'Red de Pago(1-Pronet, 2-Practipago,...)';
create index IT.IN_TCOBR_FEC_PROCESO on IT.TA_COBROS (FEC_PROCESO, NRO_TARJETA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 576K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCOBR_NRO_CTA_DEBITO on IT.TA_COBROS (NRO_CTA_DEBITO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 192K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCOBR_NRO_CUENTA on IT.TA_COBROS (NRO_CUENTA, NRO_TARJETA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 640K
    next 1M
    minextents 1
    maxextents unlimited
  );

