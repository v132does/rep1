create table IT.CB_RUB_GENERICAS
(
  cod_gru_rubro    NUMBER(5) not null,
  cod_rub_generica VARCHAR2(15),
  cod_rub_perdida  VARCHAR2(15),
  cod_rub_ganancia VARCHAR2(15),
  descripcion      VARCHAR2(150),
  cod_moneda       VARCHAR2(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_oficina      NUMBER(5)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_RUB_GENERICAS
  is 'Tabla que registra los rubros correspondientes a las previsiones genéricas.';
comment on column IT.CB_RUB_GENERICAS.cod_gru_rubro
  is 'Código del grupo de rubros.';
comment on column IT.CB_RUB_GENERICAS.cod_rub_generica
  is 'Rubro de previsión genérica.';
comment on column IT.CB_RUB_GENERICAS.cod_rub_perdida
  is 'Rubro de pérdida.';
comment on column IT.CB_RUB_GENERICAS.cod_rub_ganancia
  is 'Rubro de ganancia.';
comment on column IT.CB_RUB_GENERICAS.descripcion
  is 'Descripción del grupo de rubros.';
comment on column IT.CB_RUB_GENERICAS.cod_moneda
  is 'Código de la moneda del rubro de previsión genérica.';
comment on column IT.CB_RUB_GENERICAS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CB_RUB_GENERICAS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CB_RUB_GENERICAS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CB_RUB_GENERICAS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create unique index IT.PK_CB_RUB_GENERICAS on IT.CB_RUB_GENERICAS (COD_GRU_RUBRO, COD_MONEDA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_RUB_GENERICAS
  add constraint FK_BRGEN_COD_RUB_GANANCIA foreign key (COD_RUB_GANANCIA)
  references IT.CB_RUBROS (COD_RUBRO);
alter table IT.CB_RUB_GENERICAS
  add constraint FK_BRGEN_COD_RUB_GENERICA foreign key (COD_RUB_GENERICA)
  references IT.CB_RUBROS (COD_RUBRO);
alter table IT.CB_RUB_GENERICAS
  add constraint FK_BRGEN_COD_RUB_PERDIDA foreign key (COD_RUB_PERDIDA)
  references IT.CB_RUBROS (COD_RUBRO);

