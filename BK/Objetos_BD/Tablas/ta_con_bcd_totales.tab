create table IT.TA_CON_BCD_TOTALES
(
  cod_gru_servicio       NUMBER(3),
  fec_valor              DATE,
  cod_entidad            NUMBER(5),
  can_tot_mon_local      NUMBER(12),
  mto_tot_mon_local      NUMBER(18,2),
  can_tot_mon_extranjera NUMBER(12),
  mto_tot_mon_extranjera NUMBER(18,2),
  usu_insercion          VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion          DATE default SYSDATE not null,
  usu_modificacion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion       DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_CON_BCD_TOTALES.cod_gru_servicio
  is 'Código de Agrupación de Servicio (01 = POS, 02 = ATM, 03 = TIC, 04 = TC).';
comment on column IT.TA_CON_BCD_TOTALES.fec_valor
  is 'Fecha valor de la operación.';
comment on column IT.TA_CON_BCD_TOTALES.cod_entidad
  is 'Código de la Entidad.';
comment on column IT.TA_CON_BCD_TOTALES.can_tot_mon_local
  is 'Cantidad Total de Registros en Moneda Local.';
comment on column IT.TA_CON_BCD_TOTALES.mto_tot_mon_local
  is 'Importe Total en Moneda Local.';
comment on column IT.TA_CON_BCD_TOTALES.can_tot_mon_extranjera
  is 'Cantidad Total de Registros en Moneda Extranjera.';
comment on column IT.TA_CON_BCD_TOTALES.mto_tot_mon_extranjera
  is 'Importe Total en Moneda Extranjera.';
comment on column IT.TA_CON_BCD_TOTALES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.TA_CON_BCD_TOTALES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.TA_CON_BCD_TOTALES.usu_modificacion
  is 'Usuario que realizó la ultima modificación en el registro.';
comment on column IT.TA_CON_BCD_TOTALES.fec_modificacion
  is 'Fecha en que se realizó la ultima modificación en el registro.';
create index IT.IN_TCBTO_FEC_VALOR on IT.TA_CON_BCD_TOTALES (FEC_VALOR, COD_GRU_SERVICIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

