create table IT.GE_ACTIVIDADES
(
  cod_actividad    NUMBER(3) not null,
  descripcion      VARCHAR2(60) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_act_interna  VARCHAR2(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_ACTIVIDADES
  is 'Actividades de la persona.';
comment on column IT.GE_ACTIVIDADES.cod_actividad
  is 'Codigo de Actividad.';
comment on column IT.GE_ACTIVIDADES.descripcion
  is 'Descripcion de la Actividad.';
comment on column IT.GE_ACTIVIDADES.usu_insercion
  is 'Usuario que inserto el registro.';
comment on column IT.GE_ACTIVIDADES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_ACTIVIDADES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion del registro.';
comment on column IT.GE_ACTIVIDADES.fec_modificacion
  is 'Usuario que realizo la ultima modificacion del registro.';
comment on column IT.GE_ACTIVIDADES.cod_act_interna
  is 'Código de la Actividad Interna.';
alter table IT.GE_ACTIVIDADES
  add constraint PK_GE_ACTIVIDADES primary key (COD_ACTIVIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_ACTIVIDADES
  add constraint FK_GACTI_COD_ACT_INTERNA foreign key (COD_ACT_INTERNA)
  references IT.GE_ACT_INTERNAS (COD_ACT_INTERNA);
alter table IT.GE_ACTIVIDADES
  add constraint AVCON_1184946270_COD_A_001
  check (COD_ACTIVIDAD BETWEEN 0 AND 999);

