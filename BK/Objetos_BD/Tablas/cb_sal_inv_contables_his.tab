create table IT.CB_SAL_INV_CONTABLES_HIS
(
  fecha            DATE,
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  cod_oficina      NUMBER(3),
  cod_sec_contable VARCHAR2(1),
  cod_tip_deudor   NUMBER(2),
  residente        VARCHAR2(1),
  cod_moneda       VARCHAR2(3),
  situacion        VARCHAR2(1),
  tip_saldo        VARCHAR2(1),
  cod_plazo        VARCHAR2(1),
  tip_operacion    VARCHAR2(1),
  tip_interes      VARCHAR2(1),
  cod_rubro        VARCHAR2(15),
  sal_total        NUMBER(22,2),
  nro_referencia   NUMBER(10) not null,
  tip_renovacion   VARCHAR2(1),
  cat_automatica   VARCHAR2(1),
  cod_sit_contable VARCHAR2(20)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SAL_INV_CONTABLES_HIS
  is 'Historico de Saldos manuales y ajustes contables de inventarios fisicos.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.cod_sec_contable
  is 'Sector contable.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.cod_tip_deudor
  is 'Tipo de deudor.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.residente
  is 'Residente (s/n).';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.cod_moneda
  is 'Codigo de la moneda.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.situacion
  is 'Situacion contable.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.tip_saldo
  is 'Tipo de saldo.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.cod_plazo
  is 'Codigo del plazo contable.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.tip_operacion
  is 'Tipo de operacion (prestamos).';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.tip_interes
  is 'Tipo de interes(prestamos).';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.cod_rubro
  is 'Rubro contable.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.sal_total
  is 'Saldo segun el inventario fisico.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.nro_referencia
  is 'Nro de secuencia interno para el registro.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.tip_renovacion
  is 'Tipo de renovacion.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.cat_automatica
  is 'Categoria del cliente.';
comment on column IT.CB_SAL_INV_CONTABLES_HIS.cod_sit_contable
  is 'Situacion contable';
create unique index IT.PK_CB_SAL_INV_CONTABLES_HIS on IT.CB_SAL_INV_CONTABLES_HIS (NRO_REFERENCIA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );

