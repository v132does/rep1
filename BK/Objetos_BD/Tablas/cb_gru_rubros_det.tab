create table IT.CB_GRU_RUBROS_DET
(
  cod_gru_rubro    NUMBER(5) not null,
  cod_rubro        VARCHAR2(15) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_moneda       VARCHAR2(3) not null,
  imputable        VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_GRU_RUBROS_DET
  is 'Detalle de Grupo de Rubros.';
comment on column IT.CB_GRU_RUBROS_DET.cod_gru_rubro
  is 'Codigo de grupo de Rubro.';
comment on column IT.CB_GRU_RUBROS_DET.cod_rubro
  is 'Codigo de la cuenta contable.';
comment on column IT.CB_GRU_RUBROS_DET.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_GRU_RUBROS_DET.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_GRU_RUBROS_DET.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_GRU_RUBROS_DET.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_BGRDE_COD_RUBRO on IT.CB_GRU_RUBROS_DET (COD_RUBRO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_GRU_RUBROS_DET
  add constraint PK_CB_GRU_RUBROS_DET primary key (COD_GRU_RUBRO, COD_RUBRO, COD_MONEDA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_GRU_RUBROS_DET
  add constraint FK_BGRDE_COD_GRU_RUBRO foreign key (COD_GRU_RUBRO)
  references IT.CB_GRU_RUBROS (COD_GRU_RUBRO);
alter table IT.CB_GRU_RUBROS_DET
  add constraint FK_BGRDE_COD_RUBRO foreign key (COD_RUBRO)
  references IT.CB_RUBROS (COD_RUBRO)
  disable
  novalidate;

