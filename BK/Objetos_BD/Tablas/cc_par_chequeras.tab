create table IT.CC_PAR_CHEQUERAS
(
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  cod_oficina      NUMBER(3),
  cod_moneda       VARCHAR2(3),
  cod_tip_chequera VARCHAR2(1),
  serie            VARCHAR2(5),
  sig_nro_cheque   NUMBER(15),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_PAR_CHEQUERAS
  is 'Parametros de chequeras.';
comment on column IT.CC_PAR_CHEQUERAS.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.CC_PAR_CHEQUERAS.cod_modalidad
  is 'Codigo de la Modalidad.';
comment on column IT.CC_PAR_CHEQUERAS.cod_oficina
  is 'Codigo de la Oficina.';
comment on column IT.CC_PAR_CHEQUERAS.cod_moneda
  is 'Codigo de la Moneda.';
comment on column IT.CC_PAR_CHEQUERAS.cod_tip_chequera
  is 'Codigo del tipo de chequera.';
comment on column IT.CC_PAR_CHEQUERAS.serie
  is 'Serie para los numero de chequeras.';
comment on column IT.CC_PAR_CHEQUERAS.sig_nro_cheque
  is 'Siguiente numero de cheque.';
comment on column IT.CC_PAR_CHEQUERAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_PAR_CHEQUERAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_PAR_CHEQUERAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_PAR_CHEQUERAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CC_PAR_CHEQUERAS
  add constraint UK_CC_PAR_CHEQUERAS unique (COD_MODULO, COD_MODALIDAD, COD_OFICINA, COD_MONEDA, COD_TIP_CHEQUERA, SIG_NRO_CHEQUE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_PAR_CHEQUERAS
  add constraint AVCON_1099422157_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.CC_PAR_CHEQUERAS
  add constraint AVCON_1099422157_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.CC_PAR_CHEQUERAS
  add constraint AVCON_1099422157_COD_O_000
  check (COD_OFICINA BETWEEN 0 AND 999);

