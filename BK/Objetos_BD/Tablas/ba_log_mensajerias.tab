create table IT.BA_LOG_MENSAJERIAS
(
  mensaje       LONG,
  respuesta     VARCHAR2(4000),
  usu_insercion VARCHAR2(10) default user,
  fec_insercion DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_LOG_MENSAJERIAS
  is 'Log de Envíos y Respuestas de Mensajería.';
create index IT.IN_ELMEN_FEC_INSERCION on IT.BA_LOG_MENSAJERIAS (FEC_INSERCION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

