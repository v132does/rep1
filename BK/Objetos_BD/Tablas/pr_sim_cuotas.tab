create table IT.PR_SIM_CUOTAS
(
  nro_simulacion   NUMBER(7) not null,
  nro_cuota        NUMBER(4) not null,
  fec_vencimiento  DATE not null,
  per_dias         NUMBER(4),
  sal_anterior     NUMBER(18,2),
  mto_capital      NUMBER(18,2) not null,
  mto_interes      NUMBER(18,2) not null,
  mto_refuerzo     NUMBER(18,2),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_banco        NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_SIM_CUOTAS
  is 'Simulación Cuotas.';
comment on column IT.PR_SIM_CUOTAS.nro_simulacion
  is 'Número de simulación.';
comment on column IT.PR_SIM_CUOTAS.nro_cuota
  is 'Número de cuota.';
comment on column IT.PR_SIM_CUOTAS.fec_vencimiento
  is 'Fecha de vencimiento.';
comment on column IT.PR_SIM_CUOTAS.per_dias
  is 'Cantidad de dias del periodo.';
comment on column IT.PR_SIM_CUOTAS.sal_anterior
  is 'Valor del saldo del capital anterior.';
comment on column IT.PR_SIM_CUOTAS.mto_capital
  is 'Valor del saldo del capital.';
comment on column IT.PR_SIM_CUOTAS.mto_interes
  is 'Valor del interes a amortizar.';
comment on column IT.PR_SIM_CUOTAS.mto_refuerzo
  is 'Monto refuerzo.';
comment on column IT.PR_SIM_CUOTAS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_SIM_CUOTAS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_SIM_CUOTAS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_SIM_CUOTAS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_SIM_CUOTAS.cod_banco
  is 'Código de Banco cuando es descuento de cheques.';
alter table IT.PR_SIM_CUOTAS
  add constraint PK_PR_SIM_CUOTAS primary key (NRO_SIMULACION, NRO_CUOTA, FEC_VENCIMIENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_SIM_CUOTAS
  add constraint FK_PSICU_NRO_SIMULACION foreign key (NRO_SIMULACION)
  references IT.PR_SIMULACIONES (NRO_SIMULACION);

