create table IT.SB_CF_REG_LOG (
  ID_EJECUCION     NUMBER         NOT NULL,
  COD_REGLA        VARCHAR2(10)   NOT NULL,
  DESCRIPCION      VARCHAR2(500)  NOT NULL,
  NORMATIVA        VARCHAR2(200),
  TOTAL_AFECTADOS  NUMBER         DEFAULT 0,
  ACCION           VARCHAR2(200),
  FEC_LOG          TIMESTAMP      DEFAULT SYSTIMESTAMP,
  USU_INSERCION    VARCHAR2(30),
  FEC_INSERCION    DATE           DEFAULT SYSDATE NOT NULL,
  USU_MODIFICACION VARCHAR2(30),
  FEC_MODIFICACION DATE,
  CONSTRAINT PK_SB_CF_REG_LOG      PRIMARY KEY (ID_EJECUCION, COD_REGLA),
  CONSTRAINT FK_SCFRL_ID_EJECUCION FOREIGN KEY (ID_EJECUCION)
    REFERENCES IT.SB_CF_PRO_LOG (ID_EJECUCION)
) TABLESPACE IT_DATA;

CREATE INDEX IT.IN_SCFRL_ID_EJECUCION
  ON IT.SB_CF_REG_LOG (ID_EJECUCION)
  TABLESPACE IT_IND;

COMMENT ON TABLE IT.SB_CF_REG_LOG IS 'Log de reglas aplicadas por ejecucion CF Alta Personas';
COMMENT ON COLUMN IT.SB_CF_REG_LOG.COD_REGLA       IS 'Codigo de regla: R01..R13 segun Circ. SB.SG 00586/2010';
COMMENT ON COLUMN IT.SB_CF_REG_LOG.TOTAL_AFECTADOS IS 'Cantidad de personas afectadas por la regla';
COMMENT ON COLUMN IT.SB_CF_REG_LOG.ACCION          IS 'Accion aplicada: EXCLUIR / NORMALIZAR / INCLUIR CON ADVERTENCIA';

CREATE PUBLIC SYNONYM SB_CF_REG_LOG FOR IT.SB_CF_REG_LOG;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_CF_REG_LOG TO IT_CONSULTAS;
GRANT SELECT, INSERT, UPDATE, DELETE ON IT.SB_CF_REG_LOG TO IT_TEMPORAL;
