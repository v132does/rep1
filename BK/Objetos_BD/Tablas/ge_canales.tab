create table IT.GE_CANALES
(
  cod_canal        NUMBER(3) not null,
  cod_tip_canal    NUMBER(3) not null,
  descripcion      VARCHAR2(60) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  activo           VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CANALES
  is 'Canales de origen.';
comment on column IT.GE_CANALES.cod_canal
  is 'Codigo del canal de origen.';
comment on column IT.GE_CANALES.cod_tip_canal
  is 'Codigo del tipo de canal.';
comment on column IT.GE_CANALES.descripcion
  is 'Descripcion del canal.';
comment on column IT.GE_CANALES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CANALES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CANALES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CANALES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_CANALES.activo
  is 'S=activo;N=inactivo.';
alter table IT.GE_CANALES
  add constraint PK_GE_CANALES primary key (COD_CANAL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CANALES
  add constraint FK_GCANA_COD_TIP_CANAL foreign key (COD_TIP_CANAL)
  references IT.GE_TIP_CANALES (COD_TIP_CANAL);
alter table IT.GE_CANALES
  add constraint AVCON_1085580883_COD_C_008
  check (COD_CANAL BETWEEN 0 AND 999);

