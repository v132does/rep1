create table IT.GE_PAG_COM_REGISTROS
(
  linea VARCHAR2(1000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAG_COM_REGISTROS
  is 'Datos temporales leidos de Pago a Comercios';
comment on column IT.GE_PAG_COM_REGISTROS.linea
  is 'Un registro del archivo fisico';

