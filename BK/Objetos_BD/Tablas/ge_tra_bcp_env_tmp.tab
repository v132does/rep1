CREATE GLOBAL TEMPORARY TABLE IT.GE_TRA_BCP_ENV_TMP(    
    NRO_REGISTRO	        NUMBER,
    COD_MONEDA	            VARCHAR2(3),
    DESCRIPCION	            VARCHAR2(35),
    TIPO_MENSAJERIA	        VARCHAR2(240),
    NRO_REFERENCIA	        NUMBER,
    NRO_REF_EXTERNA	        VARCHAR2(33),
    NOM_SOLICITANTE	        VARCHAR2(120),
    NRO_CTA	                VARCHAR2(35),
    CTA_ENT_SOL	            VARCHAR2(35),
    NOM_BENEFICIARIO	    VARCHAR2(120),
    NRO_CTA_BENEF	        VARCHAR2(35),
    CTA_ENT_BENEF	        VARCHAR2(35),
    FEC_INGRESO	            DATE,
    FEC_VALOR	            DATE,
    ORIGEN	                VARCHAR2(1),
    PLATAFORMA	            VARCHAR2(1),
    PARTICIPANTE_DESTINO	VARCHAR2(60),
    ESTADO	                VARCHAR2(4000),
    SITUACION	            VARCHAR2(4000),
    MONTO	                NUMBER,
    COD_TIP_OPERACION	    VARCHAR2(3),
    COD_SUB_TIP_OPERACION	VARCHAR2(3),
    HORA	                VARCHAR2(8)
) ON COMMIT DELETE ROWS;