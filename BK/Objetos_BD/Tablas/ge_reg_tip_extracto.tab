create table IT.GE_REG_TIP_EXTRACTO
(
  fecha            DATE not null,
  canal            VARCHAR2(50),
  tip_novedad      VARCHAR2(1) not null,
  cod_usuario      VARCHAR2(10) not null,
  ret_cuenta       VARCHAR2(1),
  ret_tarjeta      VARCHAR2(1),
  nro_cuenta       VARCHAR2(15),
  cod_persona      VARCHAR2(10),
  motivo           NUMBER(3),
  fec_insercion    DATE default SYSDATE not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_modificacion DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER, 1, 10) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_REG_TIP_EXTRACTO.fecha
  is 'Fecha calendario de la solicitud.';
comment on column IT.GE_REG_TIP_EXTRACTO.canal
  is 'Canal de solicitud: WEB, ITGF, CallCenter.';
comment on column IT.GE_REG_TIP_EXTRACTO.tip_novedad
  is 'Suscripción al Servicio Extracto clic: A: Alta, B: Baja.';
comment on column IT.GE_REG_TIP_EXTRACTO.cod_usuario
  is 'Código de Usuario ITGF';
comment on column IT.GE_REG_TIP_EXTRACTO.ret_cuenta
  is 'Retener extracto de CC y AH. S: Retener impresion, N: No retener impresion.';
comment on column IT.GE_REG_TIP_EXTRACTO.ret_tarjeta
  is 'Retener extracto de Tarjeta. S: Retener impresion, N: No retener impresion.';
comment on column IT.GE_REG_TIP_EXTRACTO.nro_cuenta
  is 'Número de Cuenta solicitada para retencion.';
comment on column IT.GE_REG_TIP_EXTRACTO.cod_persona
  is 'Código de cliente ITGF.';
comment on column IT.GE_REG_TIP_EXTRACTO.motivo
  is 'Motivo de Retención de Extracto.';
create index IT.IN_GRTEX_COD_PERSONA on IT.GE_REG_TIP_EXTRACTO (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GRTEX_FECHA on IT.GE_REG_TIP_EXTRACTO (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

