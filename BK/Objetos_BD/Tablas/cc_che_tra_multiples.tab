create table IT.CC_CHE_TRA_MULTIPLES
(
  nro_cuenta       VARCHAR2(15) not null,
  nro_cheque       NUMBER(15) not null,
  monto            NUMBER(18,2) not null,
  mto_utilizado    NUMBER(18,2) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CHE_TRA_MULTIPLES
  is 'Detalle de cheques de multiples transacciones.';
comment on column IT.CC_CHE_TRA_MULTIPLES.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.CC_CHE_TRA_MULTIPLES.nro_cheque
  is 'Numero de cheque.';
comment on column IT.CC_CHE_TRA_MULTIPLES.monto
  is 'Monto del cheque.';
comment on column IT.CC_CHE_TRA_MULTIPLES.mto_utilizado
  is 'Monto utilizado del cheque.';
comment on column IT.CC_CHE_TRA_MULTIPLES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CHE_TRA_MULTIPLES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CHE_TRA_MULTIPLES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_TRA_MULTIPLES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CC_CHE_TRA_MULTIPLES
  add constraint PK_CC_CHE_TRA_MULTIPLES primary key (NRO_CUENTA, NRO_CHEQUE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHE_TRA_MULTIPLES
  add constraint FK_CCHTM_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

