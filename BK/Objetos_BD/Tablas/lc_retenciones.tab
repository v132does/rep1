create table IT.LC_RETENCIONES
(
  nro_cuenta         VARCHAR2(15) not null,
  cod_modulo         NUMBER(3) not null,
  cod_modalidad      NUMBER(3) not null,
  cod_oficina        NUMBER(3) not null,
  nro_boleta         NUMBER(15) not null,
  cod_retencion      NUMBER(3) not null,
  fec_fin            DATE not null,
  fec_inicio         DATE not null,
  cod_moneda         VARCHAR2(3) not null,
  monto              NUMBER(18,2) default 0 not null,
  cod_usuario        VARCHAR2(10) not null,
  cod_ofi_origen     NUMBER(3) not null,
  liberado           VARCHAR2(1) default 'N' not null,
  detallado          VARCHAR2(1) default 'N' not null,
  cod_tip_referencia VARCHAR2(3) not null,
  nro_referencia     NUMBER(10) not null,
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  lib_anticipada     VARCHAR2(2) default 'N' not null,
  sal_retenido       NUMBER(18,2),
  cotizacion         NUMBER(18,4)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.LC_RETENCIONES
  is 'Contiene los Datos de las Retenciones por Operaciones de Cambios.';
comment on column IT.LC_RETENCIONES.nro_cuenta
  is 'Numero de la cuenta.';
comment on column IT.LC_RETENCIONES.cod_modulo
  is 'Codigo del modulo de la cuenta.';
comment on column IT.LC_RETENCIONES.cod_modalidad
  is 'Codigo de la modalidad de la cuenta.';
comment on column IT.LC_RETENCIONES.cod_oficina
  is 'Codigo de la oficina de la cuenta.';
comment on column IT.LC_RETENCIONES.nro_boleta
  is 'Nro.de documento (boleta de deposito).';
comment on column IT.LC_RETENCIONES.cod_retencion
  is 'Codigo de retencion. Ver tabla de Codigos de retenciones.';
comment on column IT.LC_RETENCIONES.fec_fin
  is 'Fecha valor de la retencion (final de la retencion).';
comment on column IT.LC_RETENCIONES.fec_inicio
  is 'Fecha de inicio de la retencion.';
comment on column IT.LC_RETENCIONES.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.LC_RETENCIONES.monto
  is 'Valor de la retencion.';
comment on column IT.LC_RETENCIONES.cod_usuario
  is 'Codigo del cajero que grabo el deposito.';
comment on column IT.LC_RETENCIONES.cod_ofi_origen
  is 'Codigo de oficina donde se realizo el deposito.';
comment on column IT.LC_RETENCIONES.liberado
  is 'Indicador de si la retencion ya ha sido liberada en el proceso de liberacion de retenciones correspondiente. (N=NO / S=SI).';
comment on column IT.LC_RETENCIONES.detallado
  is 'Esta detallada o no la retencion(S/N).';
comment on column IT.LC_RETENCIONES.cod_tip_referencia
  is 'Codigo de referencia de la operacion.';
comment on column IT.LC_RETENCIONES.nro_referencia
  is 'Numero de referencia de la operacion.';
comment on column IT.LC_RETENCIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.LC_RETENCIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.LC_RETENCIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.LC_RETENCIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.LC_RETENCIONES.lib_anticipada
  is 'Indica si fue liberada anticipadamente.';
comment on column IT.LC_RETENCIONES.sal_retenido
  is 'Saldo pendiente de Liberación';
comment on column IT.LC_RETENCIONES.cotizacion
  is 'Cotizacion con la que se guarda la retencion';
alter table IT.LC_RETENCIONES
  add constraint PK_LC_RETENCIONES primary key (NRO_CUENTA, COD_MODULO, COD_MODALIDAD, COD_OFICINA, NRO_BOLETA, COD_RETENCION, FEC_FIN)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_RETENCIONES
  add constraint FK_LTRET_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.LC_RETENCIONES
  add constraint FK_LTRET_COD_OFICINA foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.LC_RETENCIONES
  add constraint FK_LTRET_COD_RETENCION foreign key (COD_RETENCION)
  references IT.GE_RETENCIONES (COD_RETENCION);
alter table IT.LC_RETENCIONES
  add constraint FK_LTRET_COD_TIP_REFERENCIA foreign key (COD_TIP_REFERENCIA)
  references IT.LC_TIP_REFERENCIAS (COD_TIP_REFERENCIA);
alter table IT.LC_RETENCIONES
  add constraint FK_LTRET_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.LC_RETENCIONES
  add constraint FK_LTRET_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.LC_CTA_CAMBIOS (NRO_CUENTA);
alter table IT.LC_RETENCIONES
  add constraint AVCON_1122300451_DETAL_000
  check (DETALLADO IN ('S', 'N'));
alter table IT.LC_RETENCIONES
  add constraint AVCON_1122300451_LIBER_000
  check (LIBERADO IN ('S', 'N'));

