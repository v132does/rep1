create table IT.TA_IMP_DAT_EMBOZADOS
(
  nro_sob_pro_principal  VARCHAR2(30) not null,
  nro_pan_pro_principal  VARCHAR2(16) not null,
  nro_sob_pro_secundario VARCHAR2(16) not null,
  nro_pan_pro_secundario VARCHAR2(16) not null,
  cod_persona            VARCHAR2(10),
  nro_cuenta             VARCHAR2(15),
  estado                 VARCHAR2(1),
  usu_modificacion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion       DATE default SYSDATE not null,
  usu_insercion          VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion          DATE default SYSDATE not null,
  nro_cta_deb_global     VARCHAR2(16),
  cod_color              NUMBER(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_IMP_DAT_EMBOZADOS
  is 'Maestro de embozados de tarjetas global a nominar';
comment on column IT.TA_IMP_DAT_EMBOZADOS.nro_sob_pro_principal
  is 'Numero de sobre de producto principal';
comment on column IT.TA_IMP_DAT_EMBOZADOS.nro_pan_pro_principal
  is 'Numero de PAN del producto principal';
comment on column IT.TA_IMP_DAT_EMBOZADOS.nro_sob_pro_secundario
  is 'Numero de sobre de producto secundario';
comment on column IT.TA_IMP_DAT_EMBOZADOS.nro_pan_pro_secundario
  is 'Numero de PAN del producto secundario';
comment on column IT.TA_IMP_DAT_EMBOZADOS.cod_persona
  is 'Codigo de cliente.';
comment on column IT.TA_IMP_DAT_EMBOZADOS.nro_cuenta
  is 'Numero de cuenta';
comment on column IT.TA_IMP_DAT_EMBOZADOS.estado
  is 'Estado.';
comment on column IT.TA_IMP_DAT_EMBOZADOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion del registro';
comment on column IT.TA_IMP_DAT_EMBOZADOS.fec_modificacion
  is 'Usuario que realizo la ultima modificacion del registro';
comment on column IT.TA_IMP_DAT_EMBOZADOS.usu_insercion
  is 'Usuario que inserto el registro';
comment on column IT.TA_IMP_DAT_EMBOZADOS.fec_insercion
  is 'Fecha en que se inserto el registro';
comment on column IT.TA_IMP_DAT_EMBOZADOS.cod_color
  is 'Codigo indicador para color';
alter table IT.TA_IMP_DAT_EMBOZADOS
  add constraint PK_TA_IMP_DAT_EMBOZADOS primary key (NRO_SOB_PRO_PRINCIPAL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 768K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_IMP_DAT_EMBOZADOS
  add constraint FK_TIDEM_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.TA_IMP_DAT_EMBOZADOS
  add constraint CHECK_ESTADO
  check (estado IN ('A', 'C', 'E'));

