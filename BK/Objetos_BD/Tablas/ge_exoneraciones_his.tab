create table IT.GE_EXONERACIONES_HIS
(
  fecha               DATE not null,
  cod_transaccion     NUMBER(4) not null,
  cod_modulo          NUMBER(3) not null,
  cod_modalidad       NUMBER(3) not null,
  cod_rubro           VARCHAR2(15),
  des_rubro           VARCHAR2(60),
  des_comision        VARCHAR2(60),
  cod_moneda          VARCHAR2(3) not null,
  cod_persona         VARCHAR2(10),
  nombre              VARCHAR2(120),
  nro_cuenta          VARCHAR2(15),
  est_cuenta          VARCHAR2(1),
  cod_ofi_cuenta      NUMBER(3),
  cod_usu_oficial     VARCHAR2(10),
  cod_seg_cliente     NUMBER(3),
  deb_automatico      VARCHAR2(1) not null,
  fec_inicio          DATE,
  fec_vencimiento     DATE,
  cod_tasa            NUMBER(3),
  val_tasa            NUMBER(20,4),
  por_exoneracion     NUMBER(20,4) default 0,
  mto_exoneracion     NUMBER(18,2) default 0,
  mto_cobrado         NUMBER(18,2) default 0,
  mto_a_cobrar        NUMBER(18,2) default 0,
  mto_no_cobrado      NUMBER(18,2) default 0,
  paquete             VARCHAR2(1) not null,
  cod_paquete         NUMBER(3),
  es_funcionario      VARCHAR2(1) not null,
  es_nomina           VARCHAR2(1) not null,
  cod_ente            NUMBER(5),
  cod_ofi_usuario     NUMBER(3),
  cod_usu_autorizador VARCHAR2(10),
  cod_ofi_exoneracion NUMBER(3),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  cod_autorizacion    NUMBER(10),
  fec_movimiento      DATE,
  hor_movimiento      VARCHAR2(8),
  cod_usu_movimiento  VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_EXONERACIONES_HIS.fecha
  is 'Fecha de la exoneración.';
comment on column IT.GE_EXONERACIONES_HIS.cod_transaccion
  is 'Transacción utilizada para el cobro del cargo.';
comment on column IT.GE_EXONERACIONES_HIS.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_EXONERACIONES_HIS.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_EXONERACIONES_HIS.cod_rubro
  is 'Rubro del Balance.';
comment on column IT.GE_EXONERACIONES_HIS.des_rubro
  is 'Descripción Rubro del Balance.';
comment on column IT.GE_EXONERACIONES_HIS.des_comision
  is 'Nombre de la Comisión.';
comment on column IT.GE_EXONERACIONES_HIS.cod_moneda
  is 'Moneda';
comment on column IT.GE_EXONERACIONES_HIS.cod_persona
  is 'Nro. de Cliente.';
comment on column IT.GE_EXONERACIONES_HIS.nombre
  is 'Nombre del Cliente.';
comment on column IT.GE_EXONERACIONES_HIS.nro_cuenta
  is 'Cuenta del Cliente.';
comment on column IT.GE_EXONERACIONES_HIS.est_cuenta
  is 'Estado de la cuenta del cliente.';
comment on column IT.GE_EXONERACIONES_HIS.cod_ofi_cuenta
  is 'Sucursal.';
comment on column IT.GE_EXONERACIONES_HIS.cod_usu_oficial
  is 'Gestor.';
comment on column IT.GE_EXONERACIONES_HIS.cod_seg_cliente
  is 'Segmento.';
comment on column IT.GE_EXONERACIONES_HIS.deb_automatico
  is 'Cuenta asociada a un Préstamo o CDA o Depósito a Plazo: si el cliente tiene activo uno de estos productos. Devolver el valor SI o NO.';
comment on column IT.GE_EXONERACIONES_HIS.fec_inicio
  is 'Fecha de inicio.';
comment on column IT.GE_EXONERACIONES_HIS.fec_vencimiento
  is 'Fecha de vencimiento.';
comment on column IT.GE_EXONERACIONES_HIS.cod_tasa
  is 'Código de la Tasa.';
comment on column IT.GE_EXONERACIONES_HIS.val_tasa
  is 'Tasa.';
comment on column IT.GE_EXONERACIONES_HIS.por_exoneracion
  is '% de Exoneración.';
comment on column IT.GE_EXONERACIONES_HIS.mto_exoneracion
  is 'Importe de la Exoneración.';
comment on column IT.GE_EXONERACIONES_HIS.mto_cobrado
  is 'Importe Cobrado.';
comment on column IT.GE_EXONERACIONES_HIS.mto_a_cobrar
  is 'Importe a cobrar s/Tarifario.';
comment on column IT.GE_EXONERACIONES_HIS.mto_no_cobrado
  is 'Importe no percibido = importe a cobrar s/Tarifario - importe cobrado.';
comment on column IT.GE_EXONERACIONES_HIS.paquete
  is 'Paquetes: S/N - Si el cliente tiene o no algún paquete asociado a esa cuenta.';
comment on column IT.GE_EXONERACIONES_HIS.cod_paquete
  is 'Código del Paquete.';
comment on column IT.GE_EXONERACIONES_HIS.es_funcionario
  is 'Funcionario: S/N.';
comment on column IT.GE_EXONERACIONES_HIS.es_nomina
  is 'Nómina: S/N - Si el cliente ingreso en un grupo de nómina';
comment on column IT.GE_EXONERACIONES_HIS.cod_ente
  is 'Empresa asociada: La empresa a la cual correspondía la nómina al momento de ingreso';
comment on column IT.GE_EXONERACIONES_HIS.cod_ofi_usuario
  is 'Oficina del usuario que inserta el registro.';
comment on column IT.GE_EXONERACIONES_HIS.cod_usu_autorizador
  is 'Usuario que autoriza la Exoneración. Para el caso de autorizaciones de descuentos de préstamos y operaciones vencidas, primero se autoriza el descuento. En este campo se graba el autorizador.';
comment on column IT.GE_EXONERACIONES_HIS.cod_ofi_exoneracion
  is 'Oficina del usuario que registra la Exoneración.';
comment on column IT.GE_EXONERACIONES_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_EXONERACIONES_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_EXONERACIONES_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_EXONERACIONES_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_EXONERACIONES_HIS.cod_autorizacion
  is 'Codigo de Autorizacion del descuento.';
comment on column IT.GE_EXONERACIONES_HIS.fec_movimiento
  is 'Fecha del movimiento Generado.';
comment on column IT.GE_EXONERACIONES_HIS.hor_movimiento
  is 'Hora del Movimiento Generado.';
comment on column IT.GE_EXONERACIONES_HIS.cod_usu_movimiento
  is 'Codigo de usuario del Movimiento Generado.';
create index IT.IN_GEXOHIS_FECHA on IT.GE_EXONERACIONES_HIS (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_OFI_CUENTA foreign key (COD_OFI_CUENTA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_OFI_EXONERACION foreign key (COD_OFI_EXONERACION)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_OFI_USUARIO foreign key (COD_OFI_USUARIO)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_PAQUETE foreign key (COD_PAQUETE)
  references IT.GE_PAQUETES (COD_PAQUETE);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_RUBRO foreign key (COD_RUBRO)
  references IT.CB_RUBROS (COD_RUBRO);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_COD_USU_AUTORIZADOR foreign key (COD_USU_AUTORIZADOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_EXONERACIONES_HIS
  add constraint FK_GEXOH_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

