create table IT.GE_SEG_PAR_CTA_TAS
(
  cod_seg_cliente   NUMBER(3) not null,
  cod_moneda        VARCHAR2(3) not null,
  cod_modulo        NUMBER(3) not null,
  cod_modalidad     NUMBER(3) not null,
  cod_tasa          NUMBER(3) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  valor             NUMBER(18,2) default 0 not null,
  cod_sub_modalidad NUMBER(3) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SEG_PAR_CTA_TAS
  is 'Tasas y tarifas.';
comment on column IT.GE_SEG_PAR_CTA_TAS.cod_seg_cliente
  is 'Numero de Cuenta.';
comment on column IT.GE_SEG_PAR_CTA_TAS.cod_moneda
  is 'Codigo de Moneda.';
comment on column IT.GE_SEG_PAR_CTA_TAS.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.GE_SEG_PAR_CTA_TAS.cod_modalidad
  is 'Codigo de la modalidad.';
comment on column IT.GE_SEG_PAR_CTA_TAS.cod_tasa
  is 'Codigo de tasa.';
comment on column IT.GE_SEG_PAR_CTA_TAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_SEG_PAR_CTA_TAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_SEG_PAR_CTA_TAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_SEG_PAR_CTA_TAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_SEG_PAR_CTA_TAS.valor
  is 'Valor de la tasa.';
comment on column IT.GE_SEG_PAR_CTA_TAS.cod_sub_modalidad
  is 'Código de Sub Modalidad';
alter table IT.GE_SEG_PAR_CTA_TAS
  add constraint PK_GE_SEG_PAR_CTA_TAS primary key (COD_TASA, COD_SEG_CLIENTE, COD_MODULO, COD_MODALIDAD, COD_MONEDA, COD_SUB_MODALIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SEG_PAR_CTA_TAS
  add constraint FK_GSPTA_COD_SUB_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD)
  references IT.GE_SUB_MODALIDADES (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD);
alter table IT.GE_SEG_PAR_CTA_TAS
  add constraint FK_GSPTA_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.GE_SEG_PAR_CTA_TAS
  add constraint AVCON_1097167816_COD_M_008
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_SEG_PAR_CTA_TAS
  add constraint AVCON_1097167816_COD_M_009
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_SEG_PAR_CTA_TAS
  add constraint AVCON_1097167816_COD_S_002
  check (COD_SEG_CLIENTE BETWEEN 0 AND 999);
alter table IT.GE_SEG_PAR_CTA_TAS
  add constraint AVCON_1097167816_COD_T_000
  check (COD_TASA BETWEEN 0 AND 999);

