create table IT.CS_CAJ_SEGURIDAD
(
  cod_caj_seguridad VARCHAR2(5) not null,
  cod_oficina       NUMBER(3) not null,
  tipo              VARCHAR2(1),
  valor             NUMBER(18,2),
  estado            VARCHAR2(1),
  observaciones     VARCHAR2(100),
  descripcion       VARCHAR2(50),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CS_CAJ_SEGURIDAD
  is 'Catalogo de las Cajas de Seguridad.';
comment on column IT.CS_CAJ_SEGURIDAD.cod_caj_seguridad
  is 'Codigo de la Caja de Seguridad.';
comment on column IT.CS_CAJ_SEGURIDAD.cod_oficina
  is 'Codigo de la Oficina.';
comment on column IT.CS_CAJ_SEGURIDAD.tipo
  is 'Tipo de Caja (G= Grande y C=Chica).';
comment on column IT.CS_CAJ_SEGURIDAD.valor
  is 'Monto de la Caja.';
comment on column IT.CS_CAJ_SEGURIDAD.estado
  is 'Estado de la Caja: (L)ibre, (D)esactivado, (R)eservado, (O)cupado.';
comment on column IT.CS_CAJ_SEGURIDAD.observaciones
  is 'Comentario de la Caja.';
comment on column IT.CS_CAJ_SEGURIDAD.descripcion
  is 'Descripcion de la Caja.';
comment on column IT.CS_CAJ_SEGURIDAD.usu_insercion
  is 'Usuario que inserto el registro.';
comment on column IT.CS_CAJ_SEGURIDAD.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CS_CAJ_SEGURIDAD.usu_modificacion
  is 'Usuario que realizo la ultima modificacion del registro.';
comment on column IT.CS_CAJ_SEGURIDAD.fec_modificacion
  is 'Usuario que realizo la ultima modificacion del registro.';
alter table IT.CS_CAJ_SEGURIDAD
  add constraint PK_CS_CAJ_SEGURIDAD primary key (COD_CAJ_SEGURIDAD, COD_OFICINA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CS_CAJ_SEGURIDAD
  add constraint FK_CCSEG_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);

