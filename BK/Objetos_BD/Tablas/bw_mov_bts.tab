create table IT.BW_MOV_BTS
(
  nro_documento     NUMBER(15) not null,
  fec_valor         DATE not null,
  nro_cta_debito    VARCHAR2(15),
  fec_hora          DATE default sysdate not null,
  nro_cta_credito   VARCHAR2(16) not null,
  cod_mon_credito   VARCHAR2(3) not null,
  mto_credito       NUMBER(18,2) not null,
  estado            VARCHAR2(1) default 'P' not null,
  nro_doc_pendiente NUMBER(15),
  can_reintentos    NUMBER default 0 not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 50
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_MOV_BTS
  is 'Movimientos BTS de Homebanking.';
comment on column IT.BW_MOV_BTS.nro_documento
  is 'Número de operacion del movimiento.';
comment on column IT.BW_MOV_BTS.fec_valor
  is 'Fecha calendario del movimiento.';
comment on column IT.BW_MOV_BTS.nro_cta_debito
  is 'Numero de cuenta del principal.';
comment on column IT.BW_MOV_BTS.fec_hora
  is 'Fecha y Hora de la Operación.';
comment on column IT.BW_MOV_BTS.nro_cta_credito
  is 'Número de cuenta en BT.';
comment on column IT.BW_MOV_BTS.cod_mon_credito
  is 'Moneda de la Cuenta en BT.';
comment on column IT.BW_MOV_BTS.mto_credito
  is 'Monto enviado a BT.';
comment on column IT.BW_MOV_BTS.estado
  is 'Estado de la Operacion. (R-REVERSADA, V-EN VERIFICACION, C-CONFIRMADA, P-PENDIENTE, E-ERROR, N-REVERSA NOCTURNA)';
comment on column IT.BW_MOV_BTS.can_reintentos
  is 'Cantidad de reintentos de verificacion/envio.';
comment on column IT.BW_MOV_BTS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.BW_MOV_BTS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.BW_MOV_BTS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.BW_MOV_BTS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_BWBTS_ESTADO on IT.BW_MOV_BTS (ESTADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BW_MOV_BTS
  add constraint PK_BW_MOV_BTS primary key (NRO_DOCUMENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

