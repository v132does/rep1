create table IT.AP_TIP_REQUERIMIENTOS
(
  cod_tip_requerimiento NUMBER(3) not null,
  descripcion           VARCHAR2(35) not null,
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AP_TIP_REQUERIMIENTOS
  is 'Tipos de Requerimientos.';
comment on column IT.AP_TIP_REQUERIMIENTOS.cod_tip_requerimiento
  is 'Codigo del Tipo de Requerimiento.';
comment on column IT.AP_TIP_REQUERIMIENTOS.descripcion
  is 'Descripcion del Tipo de Requerimiento.';
comment on column IT.AP_TIP_REQUERIMIENTOS.usu_insercion
  is 'Usuario que inserta.';
comment on column IT.AP_TIP_REQUERIMIENTOS.fec_insercion
  is 'Fecha de Insercion.';
comment on column IT.AP_TIP_REQUERIMIENTOS.usu_modificacion
  is 'Usuario que modifica.';
comment on column IT.AP_TIP_REQUERIMIENTOS.fec_modificacion
  is 'Fecha de modificacion.';
alter table IT.AP_TIP_REQUERIMIENTOS
  add constraint PK_AP_TIP_REQUERIMIENTOS primary key (COD_TIP_REQUERIMIENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AP_TIP_REQUERIMIENTOS
  add constraint AVCON_1081349332_COD_T_001
  check (COD_TIP_REQUERIMIENTO BETWEEN 1 AND 999);

