create table IT.GE_CAUSALES
(
  cod_causa        NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  tipo             VARCHAR2(1) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CAUSALES
  is 'Causales del sistema (Cancelacion, Bloqueos, etc.).';
comment on column IT.GE_CAUSALES.cod_causa
  is 'Codigo de causa.';
comment on column IT.GE_CAUSALES.descripcion
  is 'Descripcion de la causa.';
comment on column IT.GE_CAUSALES.tipo
  is 'Tipos de Causales (Bloqueos, Cancelaciones, Etc).';
comment on column IT.GE_CAUSALES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CAUSALES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CAUSALES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CAUSALES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_CAUSALES
  add constraint PK_GE_CAUSALES primary key (COD_CAUSA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CAUSALES
  add constraint AVCON_1082496750_COD_C_000
  check (COD_CAUSA BETWEEN 0 AND 999);
alter table IT.GE_CAUSALES
  add constraint CK_TIPO_CAUSALES
  check (TIPO IN ('A', 'B', 'C', 'D','F', 'G', 'H','I', 'J','L', 'O', 'R', 'T', 'X', 'S', 'V', 'N', 'E', 'M', 'P', 'K','W','Q'));

