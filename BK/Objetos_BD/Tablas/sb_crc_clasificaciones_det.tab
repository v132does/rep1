create table IT.SB_CRC_CLASIFICACIONES_DET
(
  fecha                 DATE not null,
  nom_referencia        VARCHAR2(10) not null,
  nro_formulario        VARCHAR2(3),
  nro_registro          NUMBER(9) not null,
  tip_documento         VARCHAR2(3),
  nro_documento         VARCHAR2(20),
  fec_nacimiento        DATE,
  nombres               VARCHAR2(120),
  apellidos             VARCHAR2(60),
  cat_riesgo            VARCHAR2(2),
  cat_subjetiva         VARCHAR2(2),
  cat_rie_fideicomiso   VARCHAR2(1),
  por_prevision         NUMBER(5,2),
  mto_rie_contingente   NUMBER(18,2),
  mto_riesgo            NUMBER(18,2),
  sal_cap_vencido       NUMBER(18,2),
  sal_int_vencido       NUMBER(18,2),
  tot_garantia          NUMBER(18,2),
  tot_cap_pri_prevision NUMBER(18,2),
  tot_cap_seg_prevision NUMBER(18,2),
  tot_int_pri_prevision NUMBER(18,2),
  tot_int_seg_prevision NUMBER(18,2),
  tot_tc                NUMBER(18,2),
  tot_dc                NUMBER(18,2),
  tot_tr                NUMBER(18,2),
  tot_dr                NUMBER(18,2),
  tot_er                NUMBER(18,2),
  tot_sr                NUMBER(18,2),
  cod_persona           VARCHAR2(10),
  tot_er_ant            NUMBER(18,2),
  mto_vta_cartera       NUMBER(18,2),
  mto_deu_incobrable    NUMBER(18,2),
  por_ing_mon_extranjera NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  )
nologging;
comment on table IT.SB_CRC_CLASIFICACIONES_DET
  is 'Detalle de Datos de Personas según su Clasificación de Riesgo para la generación del Archivo Clasificación para envío a CRC.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.fecha
  is 'Fecha de Periodo de envío del Archivo (Formato: AAAAMMDD).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.nom_referencia
  is 'Nombre del Archivo a Generarse a la CRC (Archivo Clasifica).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.nro_formulario
  is 'Nro. de Formulario correspondiente al Archivo de Vínculos. Este nro. es fijo para identificar Archivo.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.nro_registro
  is 'Nro. de Registro. Este nro. es único. ';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tip_documento
  is 'Tipo de Documento de la Persona (CI=Cedula de Identidad / CRC=Código de Persona no residente / CRP=Carné de residencia Permanente / RUC=Registro Único de Contribuyente).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.nro_documento
  is 'Nro. de Documento de la Persona.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.fec_nacimiento
  is 'Fecha de Nacimiento de la Persona.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.nombres
  is 'Primer y Segundo Nombre de la Persona.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.apellidos
  is 'Primer y Segundo Apellido de la Persona.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.cat_riesgo
  is 'Clasificación de Riesgo de la Persona (1, 1a, 1b, 2, 3, 4, 5, 6).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.cat_subjetiva
  is 'Clasificación subjetiva de la Persona (1, 1a, 1b, 2, 3, 4, 5, 6).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.cat_rie_fideicomiso
  is 'Clasificación del cliente por cartera de fideicomiso';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.por_prevision
  is 'Porcentaje de Previsión de acuerdo a la Categorización de la Persona.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.mto_rie_contingente
  is 'Total de Deuda Vendible del Cliente(Venta de Cartera).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.mto_riesgo
  is 'Total de Deuda Incobrable del Cliente.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.sal_cap_vencido
  is 'Saldo Capital Vencido. (Fec_Vto. menor a la Fecha de Proceso).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.sal_int_vencido
  is 'Saldo Interés Vencido. (Fec_Vto. menor a la Fecha de Proceso).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_garantia
  is 'Monto / Saldo de Garantías para Previsiones.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_cap_pri_prevision
  is 'Primera Previsión del Saldo Capital de la Operación.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_cap_seg_prevision
  is 'Segunda Previsión del Saldo Capital de la Operación.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_int_pri_prevision
  is 'Primera Previsión de Interés de la Operación.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_int_seg_prevision
  is 'Segunda Previsión de Interés de la Operación.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_tc
  is 'Total Cartera fideicomiso';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_dc
  is 'Total Crédito de Descuento de Documentos (Cero para Codeudorías).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_tr
  is 'Total de Riesgo Asumido por Préstamo concedido (Saldo Riesgo).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_dr
  is 'Total de Riesgo Asumido por Descuento de Documentos.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_er
  is 'Total de Riesgo Derivado por el Descuento (Si la Persona es el Emisor del Desc. de Documentos/Contingencia).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_sr
  is 'Total del Riesgo Asumido menos Ope. de Descuentos de Documentos (Garantes y Cogarantes).';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.cod_persona
  is 'Código de la Persona.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.tot_er_ant
  is 'Valor Anterior del Total de Riesgo Derivado por el Descuento.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.mto_vta_cartera
  is 'Mto. de saldo capital más interes de las cuentas vendidas.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.mto_deu_incobrable
  is 'Mto. de la deuda incobrable.';
comment on column IT.SB_CRC_CLASIFICACIONES_DET.por_ing_mon_extranjera
  is 'Porcentaje de ingreso en moneda extranjera.';  
create index IT.IN_SCLAS_COD_PERSONA on IT.SB_CRC_CLASIFICACIONES_DET (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_SCLAS_FECHA on IT.SB_CRC_CLASIFICACIONES_DET (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_SCLAS_NRO_DOCUMENTO on IT.SB_CRC_CLASIFICACIONES_DET (NRO_DOCUMENTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.SB_CRC_CLASIFICACIONES_DET
  add constraint PK_SB_CRC_CLASIFICACIONES_DET primary key (FECHA, NOM_REFERENCIA, NRO_REGISTRO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

