-- Create table
create table it.ta_con_tra_dia_det_gp
(
  nro_car_dia          NUMBER(18) not null,
  tip_registro         NUMBER,
  nro_cuenta           VARCHAR2(15),
  adicional            NUMBER,
  nro_tarjeta          VARCHAR2(25),
  fec_hora             VARCHAR2(20),
  fec_operacion        DATE,
  hor_operacion        VARCHAR2(10),
  importe              NUMBER(20,4),
  tip_moneda           VARCHAR2(3),
  aut_moneda           VARCHAR2(3),
  plan                 VARCHAR2(20),
  cuotas               VARCHAR2(3),
  cod_autorizacion     VARCHAR2(10),
  aut_forzada          NUMBER,
  aut_rev_flag         NUMBER,
  aut_aut_debi         NUMBER,
  nro_comercio         VARCHAR2(15),
  nom_comercio         VARCHAR2(40),
  estado               VARCHAR2(9),
  relacionada          VARCHAR2(2),
  origen               NUMBER,
  rechazo              VARCHAR2(80),
  ica                  NUMBER,
  mcc                  NUMBER,
  tcc                  VARCHAR2(1),
  cod_reg_fraude       NUMBER,
  des_reg_fraude       VARCHAR2(50),
  mod_entrada          VARCHAR2(2),
  terminal             VARCHAR2(16),
  usuario              VARCHAR2(20),
  standin              VARCHAR2(2),
  aut_mon_ori_so       VARCHAR2(3),
  imp_ori_autorizacion NUMBER(20,4),
  imp_aut_convertido   NUMBER(20,4),
  sig_imp_aut_con      VARCHAR2(1),
  tot_imp_cargos       NUMBER(20,4),
  sig_imp_cargos       VARCHAR2(1),
  tot_imp_iva          NUMBER(20,4),
  sig_imp_iva          VARCHAR2(1),
  tot_imp_car_con      NUMBER(20,4),
  sig_car_convertido   VARCHAR2(1),
  tot_imp_iva_con      NUMBER(20,4),
  sig_iva_car_con      VARCHAR2(1),
  con_cargo            VARCHAR2(5),
  imp_car_1            NUMBER(20,4),
  sig_imp_car_1        VARCHAR2(1),
  imp_car_iva_1        NUMBER(20,4),
  con_car_2            VARCHAR2(5),
  imp_car_2            NUMBER(20,4),
  sig_imp_2            VARCHAR2(1),
  imp_iva_car_2        NUMBER(20,4),
  con_car_3            VARCHAR2(5),
  imp_car_3            NUMBER(20,4),
  sig_imp_3            VARCHAR2(1),
  imp_iva_car_3        NUMBER(20,4),
  imp_rg4240           NUMBER(20,4),
  sig_imp_rg4240       VARCHAR2(1),
  imp_iibb_rg4240      NUMBER(20,4),
  sig_imp_iibb_rg4240  VARCHAR2(1),
  pro_iibb_rg4240      VARCHAR2(2),
  mto_imp_ley_pais     NUMBER(20,4),
  sig_imp_ley_pais     VARCHAR2(1),
  filtro               VARCHAR2(295),
  cta_externa          VARCHAR2(300),
  request_id           VARCHAR2(300),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  procesado            VARCHAR2(1),
  error                VARCHAR2(500),
  fec_proceso          DATE,
  cod_estado           VARCHAR2(1),
  fec_estado           VARCHAR2(20),
  imp_rg4815           NUMBER(20,4),
  sig_imp_rg4815       VARCHAR2(1),
  tra_tokenizada       VARCHAR2(1),
  ori_transaccion      NUMBER,
  aut_id               NUMBER,
  ext_cash             VARCHAR2(1),
  imp_ext_cash         NUMBER(20,4),
  sig_ext_cash         VARCHAR2(1),
  imp_rg_5272          NUMBER(20,4),
  sig_imp_rg_5272      VARCHAR2(1),
  fec_transferencia    VARCHAR2(20),
  cod_ins_adquieriente NUMBER,
  nro_ref_recuperacion VARCHAR2(12),
  id_terminal          VARCHAR2(8),
  nom_terminal         VARCHAR2(50),
  dat_token            NUMBER,
  dat_red              VARCHAR2(12),
  dat_billetera        VARCHAR2(3),
  per_env_fondos       VARCHAR2(320),
  cod_tip_producto     NUMBER(5)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.TA_CON_TRA_DIA_DET_GP
  is 'Conciliacion detalle de archivo historico';
-- Add comments to the columns 
comment on column IT.TA_CON_TRA_DIA_DET_GP.nro_cuenta
  is 'Nro. de cuenta del socio';
comment on column IT.TA_CON_TRA_DIA_DET_GP.adicional
  is 'Nro. de adicional del titular';
comment on column IT.TA_CON_TRA_DIA_DET_GP.nro_tarjeta
  is 'Nro. de Tarjeta del titular o adicional';
comment on column IT.TA_CON_TRA_DIA_DET_GP.fec_hora
  is '
Fecha y Hora  de la transacc.  (dd/mm/aaaa hh:mm:ss)';
comment on column IT.TA_CON_TRA_DIA_DET_GP.importe
  is 'Importe de la solicitud de autorizacion';
comment on column IT.TA_CON_TRA_DIA_DET_GP.tip_moneda
  is 'Tipo de Moneda';
comment on column IT.TA_CON_TRA_DIA_DET_GP.aut_moneda
  is 'Codigo de moneda ISO de la Autorizacion';
comment on column IT.TA_CON_TRA_DIA_DET_GP.plan
  is 'Consumo/adelantos Pesos-Consumos Adelantos Dolar';
comment on column IT.TA_CON_TRA_DIA_DET_GP.cuotas
  is 'Cantidad de cuotas del plan';
comment on column IT.TA_CON_TRA_DIA_DET_GP.cod_autorizacion
  is 'Nro de autorizacion';
comment on column IT.TA_CON_TRA_DIA_DET_GP.aut_forzada
