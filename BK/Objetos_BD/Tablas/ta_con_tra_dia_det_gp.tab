comment on column IT.TA_CON_TRA_DIA_DET_GP.aut_rev_flag
  is '1=Indica si se trata de una reversa';
comment on column IT.TA_CON_TRA_DIA_DET_GP.aut_aut_debi
  is '1=Indica si se trata de un debito automatico';
comment on column IT.TA_CON_TRA_DIA_DET_GP.nro_comercio
  is 'Nro de Comercio sin DV';
comment on column IT.TA_CON_TRA_DIA_DET_GP.nom_comercio
  is 'Nombre del comercio y localidad';
comment on column IT.TA_CON_TRA_DIA_DET_GP.estado
  is 'Solicitud de autorizacion Anulada-Depurada-Aprobada-Rechazada';
comment on column IT.TA_CON_TRA_DIA_DET_GP.relacionada
  is 'Autorizacion relacionada con consumo - se infroma NO';
comment on column IT.TA_CON_TRA_DIA_DET_GP.origen
  is '0=Online / 1=Manual / 2=Forzada IPM / 3=Refinanciacion';
comment on column IT.TA_CON_TRA_DIA_DET_GP.rechazo
  is 'Codigo de rechazo para las solicitud autorizacion rechazadas descripcion';
