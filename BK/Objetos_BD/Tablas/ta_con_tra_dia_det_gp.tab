  is 'Usuario de modificacion';
comment on column IT.TA_CON_TRA_DIA_DET_GP.fec_modificacion
  is 'Fecha de modificacion';
comment on column IT.TA_CON_TRA_DIA_DET_GP.fec_proceso
  is 'Fecha de proceso';
comment on column IT.TA_CON_TRA_DIA_DET_GP.cod_estado
  is 'Cod. Ultimo estado de la autorizacion';
