  is 'Origen de la transaccion. Local=0, Internacional=1';
comment on column IT.TA_CON_TRA_DIA_DET_GP.aut_id
  is 'ID de la Autorizacion';
comment on column IT.TA_CON_TRA_DIA_DET_GP.ext_cash
  is '0 - No / 1 - Si';
