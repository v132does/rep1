  is 'Codigo de regla de Fraude';
comment on column IT.TA_CON_TRA_DIA_DET_GP.des_reg_fraude
  is 'Descripcion de Regla de Fraude';
comment on column IT.TA_CON_TRA_DIA_DET_GP.mod_entrada
  is 'Valores posibles 1/2/81/90 y blancos';
comment on column IT.TA_CON_TRA_DIA_DET_GP.terminal
  is 'nro de terminal';
comment on column IT.TA_CON_TRA_DIA_DET_GP.usuario
  is 'Usuario que realizo la autorizacion';
comment on column IT.TA_CON_TRA_DIA_DET_GP.standin
  is 'Si MCW informo la autorizacion   tendra el valor "SI" caso contrario "NO"';
comment on column IT.TA_CON_TRA_DIA_DET_GP.aut_mon_ori_so
  is 'Codigo de moneda ISO original';
comment on column IT.TA_CON_TRA_DIA_DET_GP.imp_ori_autorizacion
  is 'Importe original de autorizacion';
comment on column IT.TA_CON_TRA_DIA_DET_GP.imp_aut_convertido
  is 'Importe de la autorizacion convertido';
comment on column IT.TA_CON_TRA_DIA_DET_GP.sig_imp_aut_con
  is 'Signo del campo anterior Valores posibles + o -';
comment on column IT.TA_CON_TRA_DIA_DET_GP.tot_imp_cargos
  is 'Total de importe de cargos';
comment on column IT.TA_CON_TRA_DIA_DET_GP.sig_imp_cargos
  is 'Signo del campo anterior Valores posibles + o -';
comment on column IT.TA_CON_TRA_DIA_DET_GP.tot_imp_iva
  is 'Total importe iva cargos';
comment on column IT.TA_CON_TRA_DIA_DET_GP.sig_imp_iva
  is 'Signo del campo anterior Valores posibles + o -';
