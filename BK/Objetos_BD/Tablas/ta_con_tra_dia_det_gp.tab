comment on column IT.TA_CON_TRA_DIA_DET_GP.dat_red
  is 'Datos de Red';
comment on column IT.TA_CON_TRA_DIA_DET_GP.dat_billetera
  is 'Identificador de la Billetera';
comment on column IT.TA_CON_TRA_DIA_DET_GP.per_env_fondos
  is 'Persona que envia la Transferencia de Fondos';
comment on column IT.TA_CON_TRA_DIA_DET_GP.cod_tip_producto
  is 'Codigo de Producto GP - id_producto';
-- Create/Recreate indexes 
create index IT.IN_CTA_AUT_APR_RCH on IT.TA_CON_TRA_DIA_DET_GP (NRO_CUENTA, NRO_TARJETA, IMPORTE, COD_AUTORIZACION, NRO_COMERCIO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TADIA_NRO_CAR_DIA on IT.TA_CON_TRA_DIA_DET_GP (NRO_CAR_DIA)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Grant/Revoke object privileges 
grant select, insert, update, delete, alter, debug, read on IT.TA_CON_TRA_DIA_DET_GP to IT_TEMPORAL;
