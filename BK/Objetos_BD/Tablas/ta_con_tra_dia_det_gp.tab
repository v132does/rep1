  is 'Signo Importe RG4240';
comment on column IT.TA_CON_TRA_DIA_DET_GP.imp_iibb_rg4240
  is 'Importe IIBB RG4240';
comment on column IT.TA_CON_TRA_DIA_DET_GP.sig_imp_iibb_rg4240
  is 'Signo Importe IIBB RG4240 ';
comment on column IT.TA_CON_TRA_DIA_DET_GP.pro_iibb_rg4240
  is 'Provincia IIBB RG4240';
