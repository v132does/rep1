create table IT.TA_EXT_CABECERA_TMP
(
  fec_cierre              DATE,
  id_cuenta               NUMBER(15),
  cod_moneda              NUMBER(5),
  nom_cuenta              VARCHAR2(60),
  cod_entidad             NUMBER(5),
  id_afinidad             NUMBER(10),
  cod_marca               VARCHAR2(5),
  cod_pro_marca           VARCHAR2(10),
  tip_cuenta              VARCHAR2(20),
  cod_emp_adherida        NUMBER(8),
  nom_emp_adherida        VARCHAR2(40),
  id_persona              NUMBER(9),
  tip_persona             VARCHAR2(20),
  nom_per_fisica          VARCHAR2(40),
  ape_per_fisica          VARCHAR2(40),
  tip_doc_persona         VARCHAR2(3),
  nro_doc_persona         VARCHAR2(20),
  tip_cli_persona         VARCHAR2(20),
  ruc_extracto            VARCHAR2(20),
  raz_social              VARCHAR2(30),
  ruc_per_juridica        VARCHAR2(20),
  pri_direccion           VARCHAR2(100),
  seg_direccion           VARCHAR2(100),
  ter_direccion           VARCHAR2(100),
  cod_pais                NUMBER(5),
  cod_departamento        NUMBER(5),
  cod_ciudad              NUMBER(8),
  nom_ciudad              VARCHAR2(50),
  cod_zon_entidad         VARCHAR2(15),
  nom_zona_entidad        VARCHAR2(60),
  nro_telefono            VARCHAR2(20),
  nro_celular             VARCHAR2(20),
  email                   VARCHAR2(70),
  cod_suc_entidad         NUMBER(5),
  nom_suc_entidad         VARCHAR2(60),
  id_ofi_cuenta           NUMBER(10),
  nom_ofi_cuenta          VARCHAR2(60),
  vip                     VARCHAR2(2),
  ret_extracto            VARCHAR2(2),
  id_mot_no_extracto      NUMBER(5),
  sec_sep_extracto        NUMBER(8),
  id_tip_cierre           VARCHAR2(4),
  cla_bcp                 VARCHAR2(4),
  cod_cli_entidad         VARCHAR2(20),
  sit_cuenta              VARCHAR2(20),
  dia_mora                NUMBER(8),
  con_car_suspendido      VARCHAR2(2),
  id_tip_doc_cuenta       VARCHAR2(5),
  nro_doc_cuenta          VARCHAR2(20),
  ruc                     VARCHAR2(20),
  mod_pago                VARCHAR2(1),
  des_modo_pago           VARCHAR2(50),
  tip_cta_bancaria        VARCHAR2(1),
  des_tip_cta_bancaria    VARCHAR2(40),
  cta_bancaria            NUMBER(20),
  tip_pago                VARCHAR2(1),
  cgf_aplicar             VARCHAR2(1),
  des_cgf_aplicar         VARCHAR2(50),
  cgf_apl_dia_mora        VARCHAR2(1),
  desc_cgf_apl_dia_mora   VARCHAR2(40),
  ttf_aplicar             VARCHAR2(1),
  per_tti                 VARCHAR2(2),
  per_pag_minimo          VARCHAR2(2),
  por_pag_minimo          NUMBER(8,2),
  imp_min_pag_min         NUMBER(18,2),
  imp_fij_pag_min         NUMBER(18,2),
  fac_mul_vip             NUMBER(8,2),
  sal_ult_resumen         NUMBER(18,2),
  num_com_per_anterior    NUMBER(20),
  can_extractos           NUMBER(8),
  dia_mor_inicial         NUMBER(8),
  num_com_per_actual      NUMBER(20),
  tas_alt_cierre          VARCHAR2(2),
  fec_ult_actualizacion   DATE,
  des_tip_tas_interes     VARCHAR2(20),
  cta_excedida            VARCHAR2(2),
  imp_mora                NUMBER(18,2),
  imp_exceso              NUMBER(18,2),
  imp_com_no_financiable  NUMBER(18,2),
  imp_gas_financiero      NUMBER(18,2),
  imp_por_com_financiable NUMBER(18,2),
  imp_aju_com_financiable NUMBER(18,2),
  imp_pag_minimo          NUMBER(18,2),
  tas_aplicada            NUMBER(8,2),
  tas_anu_aplicada        NUMBER(10,3),
  con_extracto            VARCHAR2(20),
  nom_formulario          VARCHAR2(15),
  num_control             NUMBER(9),
  num_factura             NUMBER(13),
  timbrado                NUMBER(11),
  vto_pag_minimo          DATE,
  deu_total               NUMBER(18,2),
  res_est_meses           NUMBER(8),
  res_est_total           NUMBER(18,2),
  pun_anteriores          NUMBER(18,2),
  pun_generados           NUMBER(18,2),
  pun_canjeados           NUMBER(18,2),
  pun_vencidos            NUMBER(18,2),
  pun_baja                NUMBER(18,2),
  sal_puntos              NUMBER(18,2),
  id_pro_lealtad          NUMBER(15),
  nom_puntos              VARCHAR2(60),
  des_tip_pago            VARCHAR2(25),
  car_sus_acumulado       NUMBER(18,2),
  pro_int_anteriores      NUMBER(18,2),
  pro_int_periodo         NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_EXT_CABECERA_TMP
  is 'Tabla para consumir el archivo PBEXTCAB (Cabecera de extractos mensuales) de Bancard.';
comment on column IT.TA_EXT_CABECERA_TMP.fec_cierre
  is 'Fecha de cierre';
