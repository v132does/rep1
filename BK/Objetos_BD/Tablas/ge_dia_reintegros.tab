create table IT.GE_DIA_REINTEGROS
(
  cod_promocion    NUMBER not null,
  dia              NUMBER(1) not null,
  por_reintegro    NUMBER(5,2) not null,
  fecha            DATE,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion    DATE default sysdate,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_DIA_REINTEGROS
  is 'Tabla de porcentajes por días para Reintegros.';
comment on column IT.GE_DIA_REINTEGROS.cod_promocion
  is 'Código de promoción.';
comment on column IT.GE_DIA_REINTEGROS.dia
  is 'Valor del día (1= domingo al 7= sabado).';
comment on column IT.GE_DIA_REINTEGROS.por_reintegro
  is 'Porcentaje de reintegro por cada día.';
comment on column IT.GE_DIA_REINTEGROS.fecha
  is 'Fecha exclusiva del reintegro.';
comment on column IT.GE_DIA_REINTEGROS.usu_insercion
  is 'Usuario que realizó la inserción del registro.''';
comment on column IT.GE_DIA_REINTEGROS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_DIA_REINTEGROS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_DIA_REINTEGROS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.GE_DIA_REINTEGROS
  add constraint PK_GE_DIA_REINTEGROS primary key (COD_PROMOCION, DIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_DIA_REINTEGROS
  add constraint CK_GDREIN_DIAS
  check (DIA IN (1,2,3,4,5,6,7));

