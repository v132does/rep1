create table IT.CB_SIM_SAL_OFICINAS
(
  cod_oficina            NUMBER(3) not null,
  cod_rubro              VARCHAR2(15) not null,
  ano                    NUMBER(4) not null,
  mes                    NUMBER(2) not null,
  sal_mon_loc_ant        NUMBER(18,2) default 0,
  deb_mon_local          NUMBER(18,2) default 0,
  cre_mon_local          NUMBER(18,2) default 0,
  sal_ini_mes_mon_local  NUMBER(18,2) default 0,
  sal_mon_rub_ant        NUMBER(18,2) default 0,
  deb_mon_rubro          NUMBER(18,2) default 0,
  cre_mon_rubro          NUMBER(18,2) default 0,
  sal_ini_mes_mon_rubro  NUMBER(18,2) default 0,
  sal_ini_mes_mon_fuerte NUMBER(18,2) default 0,
  protegido              VARCHAR2(1) default 'N' not null,
  sal_equ_loc_ant        NUMBER(18,2) default 0,
  deb_equ_local          NUMBER(18,2) default 0,
  cre_equ_local          NUMBER(18,2) default 0,
  sal_ini_mes_equ_local  NUMBER(18,2) default 0,
  usu_insercion          VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion          DATE default SYSDATE not null,
  usu_modificacion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion       DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SIM_SAL_OFICINAS
  is 'Contiene los registros de saldos contables por oficina ** Contiene los datos del mes actual **';
comment on column IT.CB_SIM_SAL_OFICINAS.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.CB_SIM_SAL_OFICINAS.cod_rubro
  is 'Codigo de la cuenta contable.';
comment on column IT.CB_SIM_SAL_OFICINAS.ano
  is 'Año del saldo.';
comment on column IT.CB_SIM_SAL_OFICINAS.mes
  is 'Mes del saldo.';
comment on column IT.CB_SIM_SAL_OFICINAS.sal_mon_loc_ant
  is 'Saldo de ayer en moneda local.';
comment on column IT.CB_SIM_SAL_OFICINAS.deb_mon_local
  is 'Debitos de hoy en moneda local.';
comment on column IT.CB_SIM_SAL_OFICINAS.cre_mon_local
  is 'Creditos de hoy en moneda local.';
comment on column IT.CB_SIM_SAL_OFICINAS.sal_ini_mes_mon_local
  is 'Saldo de inicio del mes en moneda local.';
comment on column IT.CB_SIM_SAL_OFICINAS.sal_mon_rub_ant
  is 'Saldo de ayer en moneda extranjera.';
comment on column IT.CB_SIM_SAL_OFICINAS.deb_mon_rubro
  is 'Debitos de hoy en moneda extranjera.';
comment on column IT.CB_SIM_SAL_OFICINAS.cre_mon_rubro
  is 'Creditos de hoy en moneda extranjera.';
comment on column IT.CB_SIM_SAL_OFICINAS.sal_ini_mes_mon_rubro
  is 'Saldo de inicio del mes en moneda extranjera.';
comment on column IT.CB_SIM_SAL_OFICINAS.sal_ini_mes_mon_fuerte
  is 'Saldo inicial en moneda fuerte.';
comment on column IT.CB_SIM_SAL_OFICINAS.protegido
  is 'Registro protegido ? ( S=Registro protegido, no puede ser borrado, N=Registro no protegido, puede ser borrado ).';
comment on column IT.CB_SIM_SAL_OFICINAS.sal_equ_loc_ant
  is 'Saldo anterior del equivalente en moneda local de la moneda extranjera.';
comment on column IT.CB_SIM_SAL_OFICINAS.deb_equ_local
  is 'Total de debitos del equivalente en moneda local de la moneda extranjera.';
comment on column IT.CB_SIM_SAL_OFICINAS.cre_equ_local
  is 'Total de creditos del equivalente en moneda local de la moneda extranjera.';
comment on column IT.CB_SIM_SAL_OFICINAS.sal_ini_mes_equ_local
  is 'Saldo inicial del mes equivalente en moneda local de la moneda extranjera.';
comment on column IT.CB_SIM_SAL_OFICINAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_SIM_SAL_OFICINAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_SIM_SAL_OFICINAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_SIM_SAL_OFICINAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_BSSOF_COD_RUBRO on IT.CB_SIM_SAL_OFICINAS (COD_RUBRO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_SIM_SAL_OFICINAS
  add constraint PK_CB_SIM_SAL_OFICINAS primary key (COD_OFICINA, COD_RUBRO, ANO, MES)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

