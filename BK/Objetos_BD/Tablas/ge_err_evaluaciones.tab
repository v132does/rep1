create table IT.GE_ERR_EVALUACIONES
(
  cod_error        VARCHAR2(3) not null,
  descripcion      VARCHAR2(250) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.GE_ERR_EVALUACIONES.cod_error
  is 'Código del Error.';
comment on column IT.GE_ERR_EVALUACIONES.descripcion
  is 'Descripción del Error.';
comment on column IT.GE_ERR_EVALUACIONES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_ERR_EVALUACIONES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_ERR_EVALUACIONES.usu_modificacion
  is 'Usuario que realizó la modificación del registro.';
comment on column IT.GE_ERR_EVALUACIONES.fec_modificacion
  is 'Fecha en que se modificó el registro.';
alter table IT.GE_ERR_EVALUACIONES
  add constraint PK_GE_ERR_EVALUACIONES primary key (COD_ERROR)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

