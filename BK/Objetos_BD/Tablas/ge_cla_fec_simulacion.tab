-- Crear tabla
CREATE TABLE IT.GE_CLA_FEC_SIMULACION (
  ID_PARAM         NUMBER         NOT NULL,
  FECHA_PROGRAMADA DATE,
  FECHA_NEGOCIO    DATE,
  FECHA_INICIO     DATE,
  FECHA_FIN        DATE,
  BASE_OBJETIVO    VARCHAR2(50 BYTE),
  FLAG_ACTIVO      CHAR(1 BYTE),
  OBSERVACIONES    VARCHAR2(500 BYTE),
  FECHA_CREACION   DATE DEFAULT SYSDATE,
  USUARIO_CREACION VARCHAR2(50 BYTE) DEFAULT USER
)
LOGGING
TABLESPACE IT_DATA
PCTFREE 10
INITRANS 1
STORAGE (
  INITIAL 65536
  NEXT 1048576
  MINEXTENTS 1
  MAXEXTENTS UNLIMITED
  BUFFER_POOL DEFAULT
)
NOCOMPRESS
NO INMEMORY
NOPARALLEL;

-- Crear índice para la PK
CREATE UNIQUE INDEX IT.IDX_GE_CLA_FEC_SIMULACION_PK ON IT.GE_CLA_FEC_SIMULACION (ID_PARAM)
LOGGING
TABLESPACE IT_IND
PCTFREE 10
INITRANS 2
STORAGE (
  INITIAL 65536
  NEXT 1048576
  MINEXTENTS 1
  MAXEXTENTS UNLIMITED
  BUFFER_POOL DEFAULT
)
NOPARALLEL;

-- Agregar constraint de clave primaria
ALTER TABLE IT.GE_CLA_FEC_SIMULACION
  ADD CONSTRAINT PK_GE_CLA_FEC_SIMULACION PRIMARY KEY (ID_PARAM)
  USING INDEX IT.IDX_GE_CLA_FEC_SIMULACION_PK
  ENABLE;

-- Comentarios de columnas
COMMENT ON COLUMN IT.GE_CLA_FEC_SIMULACION.ID_PARAM IS 'Identificador único del set de parámetros';
COMMENT ON COLUMN IT.GE_CLA_FEC_SIMULACION.FECHA_PROGRAMADA IS 'Fecha prevista para levantar en el paso LECTURA_PARAMETROS_EJECUCION';
COMMENT ON COLUMN IT.GE_CLA_FEC_SIMULACION.FECHA_NEGOCIO IS 'Fecha de negocio a utilizar como filtro en pasos posteriores del proceso';
COMMENT ON COLUMN IT.GE_CLA_FEC_SIMULACION.FECHA_INICIO IS 'Inicio de la última ejecución del orquestador con este parámetro';
COMMENT ON COLUMN IT.GE_CLA_FEC_SIMULACION.FECHA_FIN IS 'Fin de la última ejecución exitosa del orquestador con este parámetro';
COMMENT ON COLUMN IT.GE_CLA_FEC_SIMULACION.BASE_OBJETIVO IS 'Nombre base o alias destino donde se simulan los datos';
COMMENT ON COLUMN IT.GE_CLA_FEC_SIMULACION.FLAG_ACTIVO IS 'Indicador de parámetro habilitado (S/N)';
COMMENT ON COLUMN IT.GE_CLA_FEC_SIMULACION.OBSERVACIONES IS 'Observaciones internas o comentarios funcionales';
COMMENT ON COLUMN IT.GE_CLA_FEC_SIMULACION.FECHA_CREACION IS 'Fecha de alta del registro';
COMMENT ON COLUMN IT.GE_CLA_FEC_SIMULACION.USUARIO_CREACION IS 'Usuario que dio de alta el registro';


CREATE PUBLIC SYNONYM GE_CLA_FEC_SIMULACION FOR IT.GE_CLA_FEC_SIMULACION;
GRANT ALTER, DELETE, INSERT, UPDATE, SELECT ON IT.GE_CLA_FEC_SIMULACION TO IT_TEMPORAL;

