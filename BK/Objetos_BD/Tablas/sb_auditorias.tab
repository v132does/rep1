create table IT.SB_AUDITORIAS
(
  tabla          VARCHAR2(40) not null,
  clave          VARCHAR2(100) not null,
  usuario        VARCHAR2(30) default USER not null,
  fec_sistema    DATE not null,
  fec_calendario DATE not null,
  tip_novedad    VARCHAR2(1) not null,
  terminal       VARCHAR2(40),
  detalle        VARCHAR2(2000) not null,
  origen         VARCHAR2(40),
  fec_insercion  TIMESTAMP(6) default systimestamp
)
tablespace IT_AUD
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_AUDITORIAS
  is 'Registra la Auditoría de Operaciones o Novedades sobre los Registros.';
comment on column IT.SB_AUDITORIAS.tabla
  is 'Nombre de la tabla auditada.';
comment on column IT.SB_AUDITORIAS.clave
  is 'Clave primaria correspondiente al registro auditado a ser identificado.';
comment on column IT.SB_AUDITORIAS.usuario
  is 'Usuario responsable por la novedad ocurrida sobre los datos.';
comment on column IT.SB_AUDITORIAS.fec_sistema
  is 'Fecha del sistema en que se realizó la operación.';
comment on column IT.SB_AUDITORIAS.fec_calendario
  is 'Fecha calendario del módulo en el momento de realizarse la operación.';
comment on column IT.SB_AUDITORIAS.tip_novedad
  is 'Tipo de novedad u operación realizada con el dato.';
comment on column IT.SB_AUDITORIAS.terminal
  is 'Nombre de la terminal en la que se ejecutó la operación.';
comment on column IT.SB_AUDITORIAS.detalle
  is 'Detalle de modificaciones realizadas.';
comment on column IT.SB_AUDITORIAS.origen
  is 'Nombre del programa o aplicación desde el cual se ejecuto la operación.';
comment on column IT.SB_AUDITORIAS.fec_insercion
  is 'Fecha de inserción del registro.';
create index IT.IN_SAUDI_TABLA on IT.SB_AUDITORIAS (TABLA, CLAVE, USUARIO, FEC_SISTEMA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

