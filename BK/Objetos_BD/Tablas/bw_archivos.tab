create table IT.BW_ARCHIVOS
(
  cod_persona       VARCHAR2(10) not null,
  nombre            VARCHAR2(100) not null,
  nro_documento     NUMBER(15) not null,
  cod_tip_operacion VARCHAR2(3) not null,
  contenido         BLOB not null,
  mim_type          VARCHAR2(100),
  extension         VARCHAR2(10),
  longitud          NUMBER,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER, 1, 10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_ARCHIVOS
  is 'tabla para archivos adjuntos ';
comment on column IT.BW_ARCHIVOS.cod_persona
  is 'Código Cliente al que pertenece el adjunto.';
comment on column IT.BW_ARCHIVOS.nombre
  is 'Nombre del archivo adjunto.';
comment on column IT.BW_ARCHIVOS.nro_documento
  is 'Número de documento de movimiento asociado.';
comment on column IT.BW_ARCHIVOS.cod_tip_operacion
  is 'Tipo de Operacion Homebanking.';
comment on column IT.BW_ARCHIVOS.contenido
  is 'Contenido del archivo';
comment on column IT.BW_ARCHIVOS.mim_type
  is 'Mime type del archivo';
comment on column IT.BW_ARCHIVOS.extension
  is 'Extension del archivo';
comment on column IT.BW_ARCHIVOS.longitud
  is 'Tamaño del archivo';
comment on column IT.BW_ARCHIVOS.usu_insercion
  is 'Usuario de inserción';
comment on column IT.BW_ARCHIVOS.fec_insercion
  is 'Fecha de insercion';
comment on column IT.BW_ARCHIVOS.usu_modificacion
  is 'Usuario de modificación';
comment on column IT.BW_ARCHIVOS.fec_modificacion
  is 'Fecha de modificacion';
alter table IT.BW_ARCHIVOS
  add constraint PK_BW_ARCHIVO primary key (COD_PERSONA, NRO_DOCUMENTO, COD_TIP_OPERACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

