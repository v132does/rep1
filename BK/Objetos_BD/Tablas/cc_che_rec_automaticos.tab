-- Create table
create table IT.CC_CHE_REC_AUTOMATICOS
(
  nro_cheque         NUMBER(15) not null,
  fec_proceso        DATE not null,
  nro_cuenta         VARCHAR2(15) not null,
  monto              NUMBER(18,2) not null,
  cod_bco_receptor   NUMBER(3) not null,
  cod_ofi_camara     NUMBER(3), 
  cod_oficina        NUMBER(3),
  cod_cau_devolucion NUMBER(3),
  des_cau_devolucion VARCHAR2(100),
  cod_usuario        VARCHAR2(10) not null,
  tip_importe        NUMBER(1),
  cod_moneda         VARCHAR2(3),
  procesado          VARCHAR2(1) default 'N',
  des_error          VARCHAR2(3000),
  nro_lote           NUMBER(10),
  origen             VARCHAR2(1),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not NULL
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.CC_CHE_REC_AUTOMATICOS
  is 'Cheques Cargo Otros Bancos rechazados automaticamente.';
-- Add comments to the columns 
comment on column IT.CC_CHE_REC_AUTOMATICOS.nro_cheque
  is 'Número de cheque.';
comment on column IT.CC_CHE_REC_AUTOMATICOS.fec_proceso
  is 'Fecha de Proceso.';
comment on column IT.CC_CHE_REC_AUTOMATICOS.nro_cuenta
  is 'Número de cuenta';
comment on column IT.CC_CHE_REC_AUTOMATICOS.monto
  is 'Importe del Cheque';
comment on column IT.CC_CHE_REC_AUTOMATICOS.cod_bco_receptor
  is 'Banco receptor.';
comment on column IT.CC_CHE_REC_AUTOMATICOS.cod_ofi_camara
  is 'Oficina de Camara.';
comment on column IT.CC_CHE_REC_AUTOMATICOS.cod_oficina
  is 'Código de Oficina';  
comment on column IT.CC_CHE_REC_AUTOMATICOS.cod_cau_devolucion
  is 'Código de Devolución de Cheque.';  
comment on column IT.CC_CHE_REC_AUTOMATICOS.des_cau_devolucion
  is 'Descripción de Causa de Rechazo.';   
comment on column IT.CC_CHE_REC_AUTOMATICOS.cod_usuario
  is 'Código de usuario que realiza la operación.';
comment on column IT.CC_CHE_REC_AUTOMATICOS.tip_importe
  is 'Tipo de Importe (0=Bajo Valor; 1=Alto Valor).';
comment on column IT.CC_CHE_REC_AUTOMATICOS.cod_moneda
  is 'Código de Moneda';
comment on column IT.CC_CHE_REC_AUTOMATICOS.procesado
  is 'Procesado (S/N).';
comment on column IT.CC_CHE_REC_AUTOMATICOS.des_error
  is 'Descripción del Error';  
comment on column IT.CC_CHE_REC_AUTOMATICOS.nro_lote
  is 'Número de Lote.';   
comment on column IT.CC_CHE_REC_AUTOMATICOS.origen
  is 'Origen del rechazo (C=Caja; L=Pantalla de Recepción de Cheques(Clearing)).';          
comment on column IT.CC_CHE_REC_AUTOMATICOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CC_CHE_REC_AUTOMATICOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CC_CHE_REC_AUTOMATICOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CC_CHE_REC_AUTOMATICOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';

-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.CC_CHE_REC_AUTOMATICOS
  add constraint PK_CC_CHE_REC_AUTOMATICOS unique (NRO_CHEQUE, FEC_PROCESO, NRO_CUENTA, MONTO, COD_BCO_RECEPTOR)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHE_REC_AUTOMATICOS
  add constraint FK_CCRCHA_COD_BCO_REC foreign key (COD_BCO_RECEPTOR)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.CC_CHE_REC_AUTOMATICOS
  add constraint FK_CCRCHA_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CC_CHE_REC_AUTOMATICOS
  add constraint FK_CCRCHA_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CC_CHE_REC_AUTOMATICOS
  add constraint FK_CCRCHA_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.CC_CHE_REC_AUTOMATICOS
  add constraint FK_CCRCHA_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
