create table IT.GE_MOV_SIN_COSTO
(
  cod_gru_transaccion NUMBER(5) not null,
  cod_tas_limite      NUMBER(3) not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_MOV_SIN_COSTO
  is 'Cantidad de movimientos de un grupo de transaccion que pueden realizarse sin costo.';
comment on column IT.GE_MOV_SIN_COSTO.cod_gru_transaccion
  is 'Codigo de grupo de transaccion.';
comment on column IT.GE_MOV_SIN_COSTO.cod_tas_limite
  is 'Codigo de Tasa para Limite de Transaccion sin Costo.';
comment on column IT.GE_MOV_SIN_COSTO.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_MOV_SIN_COSTO.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_MOV_SIN_COSTO.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_MOV_SIN_COSTO.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_MOV_SIN_COSTO
  add constraint PK_GE_MOV_SIN_COSTO primary key (COD_GRU_TRANSACCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_MOV_SIN_COSTO
  add constraint FK_GMSCO_COD_GRU_TRANSACCION foreign key (COD_GRU_TRANSACCION)
  references IT.GE_GRU_TRANSACCIONES (COD_GRU_TRANSACCION);
alter table IT.GE_MOV_SIN_COSTO
  add constraint FK_GMSCO_COD_TAS_LIMITE foreign key (COD_TAS_LIMITE)
  references IT.GE_TASAS (COD_TASA);

