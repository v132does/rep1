create table IT.GE_TASAS
(
  cod_tasa         NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  tip_valor        VARCHAR2(1) not null,
  tipo             VARCHAR2(1) not null,
  aplicar          VARCHAR2(2) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_mon_base     VARCHAR2(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_TASAS
  is 'Tipos de Tasas.';
comment on column IT.GE_TASAS.cod_tasa
  is 'Codigo de tasa.';
comment on column IT.GE_TASAS.descripcion
  is 'Nombre de la tasa.';
comment on column IT.GE_TASAS.tip_valor
  is 'Tipo de valor. (P=porcentaje, V=Valor ).';
comment on column IT.GE_TASAS.tipo
  is 'Tipo de tasa. (F=Fija, V=Variable ).';
comment on column IT.GE_TASAS.aplicar
  is 'Aplicar. (ST=saldo total, IM=impuesto).';
comment on column IT.GE_TASAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_TASAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_TASAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_TASAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_TASAS.cod_mon_base
  is 'Codigo de la Moneda Base de la tasa.';
alter table IT.GE_TASAS
  add constraint PK_GE_TASAS primary key (COD_TASA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_TASAS
  add constraint AVCON_1084457524_COD_T_001
  check (COD_TASA BETWEEN 0 AND 999);
alter table IT.GE_TASAS
  add constraint AVCON_1096295099_TIPO_002
  check (TIPO IN ('F', 'V'));
alter table IT.GE_TASAS
  add constraint AVCON_1096295099_TIP_V_000
  check (TIP_VALOR IN ('I', 'V', 'P', 'C', 'T'));

