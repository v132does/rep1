create table IT.GE_SOL_COM_PAGOS
(
  cod_referencia   NUMBER(1) not null,
  tip_referencia   VARCHAR2(1) not null,
  tipo             VARCHAR2(1) not null,
  val_desde        NUMBER(7) not null,
  val_hasta        NUMBER(7) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SOL_COM_PAGOS
  is 'Comportamiento de Pagos.';
comment on column IT.GE_SOL_COM_PAGOS.cod_referencia
  is 'Codigo de referencia.';
comment on column IT.GE_SOL_COM_PAGOS.tip_referencia
  is 'Tipo de Referencia.';
comment on column IT.GE_SOL_COM_PAGOS.tipo
  is 'Tipo de Comportamiento (P:Promedio de Atraso, M:Maximo Atraso).';
comment on column IT.GE_SOL_COM_PAGOS.val_desde
  is 'Puntaje que inicia desde...Ej. 0.';
comment on column IT.GE_SOL_COM_PAGOS.val_hasta
  is 'Puntaje hasta.';
comment on column IT.GE_SOL_COM_PAGOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_SOL_COM_PAGOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_SOL_COM_PAGOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_SOL_COM_PAGOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_SOL_COM_PAGOS
  add constraint PK_GE_SOL_COM_PAGOS primary key (COD_REFERENCIA, TIP_REFERENCIA, TIPO, VAL_DESDE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SOL_COM_PAGOS
  add constraint FK_GSCPA_COD_REFERENCIA foreign key (COD_REFERENCIA, TIP_REFERENCIA)
  references IT.CR_REFERENCIAS (COD_REFERENCIA, TIP_REFERENCIA);

