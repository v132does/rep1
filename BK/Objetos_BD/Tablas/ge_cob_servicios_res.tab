create table IT.GE_COB_SERVICIOS_RES
(
  cod_servicio      NUMBER(3) not null,
  fec_remision      DATE not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  tot_debito        NUMBER(18,2),
  tot_efectivo      NUMBER(18,2),
  tot_che_nue_banco NUMBER(18,2),
  tot_che_otr_banco NUMBER(18,2),
  tot_comision      NUMBER(18,2),
  tot_impuesto      NUMBER(18,2),
  val_tas_comision  NUMBER(20,4),
  val_tas_impuesto  NUMBER(20,4),
  nro_remision      NUMBER(7) not null,
  cantidad          NUMBER(10) not null,
  cod_moneda        VARCHAR2(3) not null,
  tot_monto         NUMBER(18,2) not null,
  cod_ofi_origen    NUMBER(3) not null,
  referencia        VARCHAR2(40)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_COB_SERVICIOS_RES
  is 'Resumen de Cobros de Servicios (Caja y Debito Automatico).';
comment on column IT.GE_COB_SERVICIOS_RES.cod_servicio
  is 'Codigo de Servicio.';
comment on column IT.GE_COB_SERVICIOS_RES.fec_remision
  is 'Fecha de Remision.';
comment on column IT.GE_COB_SERVICIOS_RES.usu_insercion
  is 'Uusuario que inserto.';
comment on column IT.GE_COB_SERVICIOS_RES.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.GE_COB_SERVICIOS_RES.usu_modificacion
  is 'Usuario de modificacion.';
comment on column IT.GE_COB_SERVICIOS_RES.fec_modificacion
  is 'Fecha de modificacion.';
comment on column IT.GE_COB_SERVICIOS_RES.tot_debito
  is 'Monto Total Debito.';
comment on column IT.GE_COB_SERVICIOS_RES.tot_efectivo
  is 'Monto Total Efectivo.';
comment on column IT.GE_COB_SERVICIOS_RES.tot_che_nue_banco
  is 'Monto Total Cheques nuestro Banco.';
comment on column IT.GE_COB_SERVICIOS_RES.tot_che_otr_banco
  is 'Monto Total Cheques otros Bancos.';
comment on column IT.GE_COB_SERVICIOS_RES.tot_comision
  is 'Monto Total Comision.';
comment on column IT.GE_COB_SERVICIOS_RES.tot_impuesto
  is 'Monto Total Impuesto.';
comment on column IT.GE_COB_SERVICIOS_RES.val_tas_comision
  is 'Porcentaje de la tasa de Comision.';
comment on column IT.GE_COB_SERVICIOS_RES.val_tas_impuesto
  is 'Porcentaje de la tasa del Impuesto.';
comment on column IT.GE_COB_SERVICIOS_RES.nro_remision
  is 'Numero de Remision.';
comment on column IT.GE_COB_SERVICIOS_RES.cantidad
  is 'Cantidad de cobros remitidos.';
comment on column IT.GE_COB_SERVICIOS_RES.cod_moneda
  is 'Moneda.';
comment on column IT.GE_COB_SERVICIOS_RES.tot_monto
  is 'Monto Total de las remisiones.';
comment on column IT.GE_COB_SERVICIOS_RES.cod_ofi_origen
  is 'Oficina en que se realizo la Remision.';
comment on column IT.GE_COB_SERVICIOS_RES.referencia
  is 'Referencia.';
alter table IT.GE_COB_SERVICIOS_RES
  add constraint PK_GE_COB_SERVICIOS_RES primary key (COD_SERVICIO, FEC_REMISION, NRO_REMISION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_COB_SERVICIOS_RES
  add constraint FK_GCSRE_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_COB_SERVICIOS_RES
  add constraint FK_GCSRE_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);

