create table IT.LC_TIP_OPE_BCP
(
  cod_tip_ope_bcp  VARCHAR2(6) not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  descripcion      VARCHAR2(60) not null,
  nivel            NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.LC_TIP_OPE_BCP
  is 'Contiene los Codigos de BCP asignados a los Tipos de Operaciones de Cambios.';
comment on column IT.LC_TIP_OPE_BCP.cod_tip_ope_bcp
  is 'Codigo del tipo de operacion para el BCP.';
comment on column IT.LC_TIP_OPE_BCP.cod_modulo
  is 'Codigo del modulo.';
comment on column IT.LC_TIP_OPE_BCP.cod_modalidad
  is 'Codigo de la modalidad.';
comment on column IT.LC_TIP_OPE_BCP.descripcion
  is 'Descripcion del tipo de operacion.';
comment on column IT.LC_TIP_OPE_BCP.nivel
  is 'Nivel del tipo de operacion.';
comment on column IT.LC_TIP_OPE_BCP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.LC_TIP_OPE_BCP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.LC_TIP_OPE_BCP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.LC_TIP_OPE_BCP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.LC_TIP_OPE_BCP
  add constraint PK_LC_TIP_OPE_BCP primary key (COD_TIP_OPE_BCP)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_TIP_OPE_BCP
  add constraint FK_LTOPB_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);

