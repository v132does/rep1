create table IT.SB_TRANSFERENCIAS
(
  nom_referencia VARCHAR2(10) not null,
  fec_periodo    DATE not null,
  cod_entidad    NUMBER(4),
  tot_registro   NUMBER(9)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.SB_TRANSFERENCIAS.nom_referencia
  is 'Nombre del Archivo de Generación de Operaciones.';
comment on column IT.SB_TRANSFERENCIAS.fec_periodo
  is 'Fecha de Periodo de envío del Archivo. (Formato: AAAAMMDD)';
comment on column IT.SB_TRANSFERENCIAS.cod_entidad
  is 'Código de Identificación de la Entidad Financiera / Bancaria. ';
comment on column IT.SB_TRANSFERENCIAS.tot_registro
  is 'Total de registros contados del Archivo de Transferencias.';
alter table IT.SB_TRANSFERENCIAS
  add constraint PK_SB_TRANSFERENCIAS primary key (NOM_REFERENCIA, FEC_PERIODO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

