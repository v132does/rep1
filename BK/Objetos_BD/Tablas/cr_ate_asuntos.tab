create table IT.CR_ATE_ASUNTOS
(
  cod_asunto       VARCHAR2(5) not null,
  descripcion      VARCHAR2(60) not null,
  max_espera       NUMBER(6) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_ATE_ASUNTOS
  is 'Tipos de Asuntos a Tratar o Atender.';
comment on column IT.CR_ATE_ASUNTOS.cod_asunto
  is 'Codigo del Asunto.';
comment on column IT.CR_ATE_ASUNTOS.descripcion
  is 'Descripcion del Asunto.';
comment on column IT.CR_ATE_ASUNTOS.max_espera
  is 'Tiempo maximo de espera en minutos.';
comment on column IT.CR_ATE_ASUNTOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_ATE_ASUNTOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_ATE_ASUNTOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_ATE_ASUNTOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CR_ATE_ASUNTOS
  add constraint PK_CR_ASUNTOS primary key (COD_ASUNTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

