create table IT.GE_TIP_CONTROLES
(
  cod_tip_control  NUMBER(5) not null,
  descripcion      VARCHAR2(60) not null,
  fec_insercion    DATE,
  usu_insercion    VARCHAR2(10),
  fec_modificacion DATE,
  usu_modificacion VARCHAR2(10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_TIP_CONTROLES
  is 'Tipo de controles.';
comment on column IT.GE_TIP_CONTROLES.cod_tip_control
  is 'Codigo Tipo de Control.';
comment on column IT.GE_TIP_CONTROLES.descripcion
  is 'Descripcion del control realizado.';
comment on column IT.GE_TIP_CONTROLES.fec_insercion
  is 'Fecha de insercion del registro.';
comment on column IT.GE_TIP_CONTROLES.usu_insercion
  is 'Usuario que inserto el registro.';
comment on column IT.GE_TIP_CONTROLES.fec_modificacion
  is 'Fecha de modificacion del registro.';
comment on column IT.GE_TIP_CONTROLES.usu_modificacion
  is 'Usuario que modifico el registro.';
alter table IT.GE_TIP_CONTROLES
  add constraint PK_GE_TIP_CONTROLES primary key (COD_TIP_CONTROL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_TIP_CONTROLES
  add constraint AVCON_COD_TIP_CONTROL
  check (COD_TIP_CONTROL BETWEEN 1 AND 999);

