  CREATE GLOBAL TEMPORARY TABLE IT.CC_MOVIMIENTOS_HIS_TMP 
   (FECHA               DATE NOT NULL ENABLE, 
    HORA                VARCHAR2(8 BYTE) NOT NULL ENABLE, 
    COD_USUARIO         VARCHAR2(10 BYTE) NOT NULL ENABLE, 
    NRO_SECUENCIA       NUMBER(3,0) NOT NULL ENABLE, 
    FEC_VALOR           DATE, 
    MONTO               NUMBER(18,2), 
    NRO_CUENTA          VARCHAR2(15 BYTE), 
    COD_MONEDA          VARCHAR2(3 BYTE) NOT NULL ENABLE, 
    COD_OFICINA         NUMBER(3,0), 
    COD_ERROR           VARCHAR2(10 BYTE), 
    COD_RETENCION       NUMBER(3,0), 
    FEC_FIN_RETENCION   DATE, 
    EST_CUENTA          VARCHAR2(1 BYTE), 
    ESTADO              VARCHAR2(1 BYTE) NOT NULL ENABLE, 
    COD_CAUSA           NUMBER(3,0), 
    COD_BANCO           NUMBER(3,0), 
    COD_OFI_ORIGEN      NUMBER(3,0) NOT NULL ENABLE, 
    CONCEPTO            VARCHAR2(100 BYTE), 
    COD_TASA            NUMBER(3,0), 
    VAL_TASA            NUMBER(20,4), 
    COD_RUBRO           VARCHAR2(15 BYTE), 
    COD_REF_CAMBIO      VARCHAR2(3 BYTE), 
    REVERSADO           VARCHAR2(1 BYTE) NOT NULL ENABLE, 
    COD_USU_REVERSION   VARCHAR2(10 BYTE), 
    HOR_REVERSION       VARCHAR2(8 BYTE), 
    EMI_AVISO           VARCHAR2(1 BYTE), 
    COD_TRA_PADRE       NUMBER(4,0) NOT NULL ENABLE, 
    COD_MOD_PADRE       NUMBER(3,0) NOT NULL ENABLE, 
    COD_MAD_PADRE       NUMBER(3,0) NOT NULL ENABLE, 
    COD_TRANSACCION     NUMBER(4,0), 
    COD_MODULO          NUMBER(3,0), 
    COD_MODALIDAD       NUMBER(3,0), 
    MTO_EQU_LOCAL       NUMBER(18,2), 
    NRO_CAJA            NUMBER(3,0), 
    COTIZACION          NUMBER(14,8), 
    COD_BCO_CENTRAL     VARCHAR2(6 BYTE), 
    NRO_DOCUMENTO       NUMBER(15,0), 
    NRO_DOCUMENTO2      NUMBER(15,0), 
    NRO_DOCUMENTO3      NUMBER(15,0), 
    NRO_DOCUMENTO4      NUMBER(15,0), 
    PROTEGIDO           VARCHAR2(1 BYTE), 
    COD_AUTORIZACION    NUMBER(10,0), 
    COD_USU_AUTORIZADOR VARCHAR2(10 BYTE), 
    USU_INSERCION       VARCHAR2(10 BYTE) NOT NULL ENABLE, 
    FEC_INSERCION       DATE NOT NULL ENABLE, 
    USU_MODIFICACION    VARCHAR2(10 BYTE) NOT NULL ENABLE, 
    FEC_MODIFICACION    DATE NOT NULL ENABLE, 
    TIP_MOV_RUBRO       VARCHAR2(1 BYTE), 
    COD_TIP_OPE_CAMBIO  VARCHAR2(3 BYTE), 
    NRO_FOLIO           NUMBER(7,0), 
    REFERENCIA          VARCHAR2(20 BYTE), 
    COD_PERSONA         VARCHAR2(10 BYTE), 
    COD_SIT_CONTABLE    NUMBER(20,0), 
    NRO_CONCILIACION    NUMBER(20,0)
   )ON COMMIT DELETE ROWS;