create table IT.MI_CC_CHE_ENVIADOS
(
  cod_banco            NUMBER(3) not null,
  nro_cheque           VARCHAR2(100),
  cod_usuario          VARCHAR2(10) not null,
  fecha                DATE not null,
  hora                 VARCHAR2(8) not null,
  cod_ofi_origen       NUMBER(3) not null,
  nro_boleta           NUMBER(15) not null,
  cod_retencion        NUMBER(3) not null,
  fec_final            DATE not null,
  monto                NUMBER(18,2) not null,
  cod_moneda           VARCHAR2(3) not null,
  mto_equ_local        NUMBER(18,2) default 0 not null,
  cod_referencia       VARCHAR2(3),
  nro_referencia       NUMBER(18),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cta_libradora        VARCHAR2(20),
  estado               VARCHAR2(1) not null,
  nro_cuenta           VARCHAR2(15),
  cod_cau_devolucion   NUMBER(3),
  cod_ofi_compensacion NUMBER(3),
  nro_caja             NUMBER(3),
  com_directa          VARCHAR2(1) default 'N' not null,
  manual               VARCHAR2(1) default 'N',
  nro_bol_deposito     NUMBER(15),
  fec_vencimiento      DATE,
  lib_posterior        VARCHAR2(1) default 'N' not null,
  liberado             VARCHAR2(1) default 'N' not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 8M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MI_CC_CHE_ENVIADOS
  is 'Cheques Enviados.';
comment on column IT.MI_CC_CHE_ENVIADOS.cod_banco
  is 'Codigo de Banco al que pertenece el Deposito.';
comment on column IT.MI_CC_CHE_ENVIADOS.nro_cheque
  is 'Numero de Cheque.';
comment on column IT.MI_CC_CHE_ENVIADOS.cod_usuario
  is 'Codigo de Operador que realizo la Grabacion del Registro.';
comment on column IT.MI_CC_CHE_ENVIADOS.fecha
  is 'Fecha de la Grabacion del Registro .';
comment on column IT.MI_CC_CHE_ENVIADOS.hora
  is 'Hora en que se Ingreso el Registro.';
comment on column IT.MI_CC_CHE_ENVIADOS.cod_ofi_origen
  is 'Codigo de Oficina donde se Realizo el Deposito.';
comment on column IT.MI_CC_CHE_ENVIADOS.nro_boleta
  is 'Numero de Boleta.';
comment on column IT.MI_CC_CHE_ENVIADOS.cod_retencion
  is 'Codigo del Tipo de Retencion.';
comment on column IT.MI_CC_CHE_ENVIADOS.fec_final
  is 'Fecha de Fin de la Retencion .';
comment on column IT.MI_CC_CHE_ENVIADOS.monto
  is 'Valor del Cheque.';
comment on column IT.MI_CC_CHE_ENVIADOS.cod_moneda
  is 'Codigo de Moneda.';
comment on column IT.MI_CC_CHE_ENVIADOS.mto_equ_local
  is 'Valor Equivalente.';
comment on column IT.MI_CC_CHE_ENVIADOS.cod_referencia
  is 'Codigo de Referencia.';
comment on column IT.MI_CC_CHE_ENVIADOS.nro_referencia
  is 'Numero de Referencia.';
comment on column IT.MI_CC_CHE_ENVIADOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.MI_CC_CHE_ENVIADOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.MI_CC_CHE_ENVIADOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.MI_CC_CHE_ENVIADOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.MI_CC_CHE_ENVIADOS.cta_libradora
  is 'Cuenta Libradora del Cheque.';
comment on column IT.MI_CC_CHE_ENVIADOS.estado
  is 'Estado. ''I''ngresado, ''E''nviado, ''C''onfirmado, ''L''iberado, ''D''evuelto.';
comment on column IT.MI_CC_CHE_ENVIADOS.nro_cuenta
  is 'Numero de Cuenta.';
comment on column IT.MI_CC_CHE_ENVIADOS.cod_cau_devolucion
  is 'Codigo de Causa de Devolucion.';
comment on column IT.MI_CC_CHE_ENVIADOS.cod_ofi_compensacion
  is 'Oficina donde se hara la Compensacion de estos Cheques.';
comment on column IT.MI_CC_CHE_ENVIADOS.nro_caja
  is 'Numero de Caja.';
comment on column IT.MI_CC_CHE_ENVIADOS.com_directa
  is 'Indica si la Compensacion es Directa.';
comment on column IT.MI_CC_CHE_ENVIADOS.manual
  is 'Indica si el Cheque fue Ingresado en forma Manual al sistema.';
comment on column IT.MI_CC_CHE_ENVIADOS.nro_bol_deposito
  is 'Numero de Boleta de deposito.';
comment on column IT.MI_CC_CHE_ENVIADOS.fec_vencimiento
  is 'Fecha de Vencimiento del Cheque para Cheques en Custodia que vienen de prestamos.';

