create table IT.CC_CHE_RECIBIDOS
(
  nro_cheque         NUMBER(15) not null,
  fec_proceso        DATE not null,
  nro_cuenta         VARCHAR2(15) not null,
  monto              NUMBER(18,2) not null,
  cod_bco_emisor     NUMBER(3) not null,
  cod_bco_receptor   NUMBER(3),
  cod_cau_devolucion NUMBER(3),
  cod_ofi_camara     NUMBER(3),
  est_cheque         VARCHAR2(1),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  cod_usuario        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  com_directa        VARCHAR2(1) default 'N',
  alerta_uv          VARCHAR2(1),
  datamatrix         VARCHAR2(1),
  tip_importe        NUMBER(1) default 0,
  banda_cmc7         VARCHAR2(25),
  cod_moneda         VARCHAR2(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CHE_RECIBIDOS
  is 'Cheques recibidos.';
comment on column IT.CC_CHE_RECIBIDOS.nro_cheque
  is 'Numero de cheque.';
comment on column IT.CC_CHE_RECIBIDOS.fec_proceso
  is 'Fecha de Proceso.';
comment on column IT.CC_CHE_RECIBIDOS.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.CC_CHE_RECIBIDOS.monto
  is 'Importe.';
comment on column IT.CC_CHE_RECIBIDOS.cod_bco_emisor
  is 'Banco emisor.';
comment on column IT.CC_CHE_RECIBIDOS.cod_bco_receptor
  is 'Banco receptor.';
comment on column IT.CC_CHE_RECIBIDOS.cod_cau_devolucion
  is 'Codigo de Devolucion de Cheque.';
comment on column IT.CC_CHE_RECIBIDOS.cod_ofi_camara
  is 'Oficina de Camara.';
comment on column IT.CC_CHE_RECIBIDOS.est_cheque
  is 'Estado del Cheque(R=Rechazado, P=Procesado).';
comment on column IT.CC_CHE_RECIBIDOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_CHE_RECIBIDOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_CHE_RECIBIDOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_RECIBIDOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_CHE_RECIBIDOS.cod_usuario
  is 'Codigo de usuario que realiza la operacion.';
comment on column IT.CC_CHE_RECIBIDOS.com_directa
  is 'Compensacion directa s/n.';
comment on column IT.CC_CHE_RECIBIDOS.alerta_uv
  is 'Alerta UV(0=Sin Alerta; 1=Con Alerta; 2=Sin Alerta UV con Alerta Receptor; 3=Con Alerta UV y Alerta Receptor; " "=Control UV no ejecutado).';
comment on column IT.CC_CHE_RECIBIDOS.datamatrix
  is 'DataMatrix(0=Ok ; 1=Alerta ; " "=Control no ejecutado).';
comment on column IT.CC_CHE_RECIBIDOS.tip_importe
  is 'Tipo Importe(0=Bajo Valor,1=Alto Valor).';
comment on column IT.CC_CHE_RECIBIDOS.banda_cmc7
  is 'Banda CMC7.';
comment on column IT.CC_CHE_RECIBIDOS.cod_moneda
  is 'Codigo de Moneda';
create index IT.BBVA_CHE_RECI on IT.CC_CHE_RECIBIDOS (FEC_PROCESO, EST_CHEQUE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.CHE_RECIBI_SOB on IT.CC_CHE_RECIBIDOS (FEC_PROCESO, EST_CHEQUE, COD_OFI_CAMARA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CCREC_COD_BCO_EMISOR on IT.CC_CHE_RECIBIDOS (COD_BCO_EMISOR, COD_BCO_RECEPTOR, COD_CAU_DEVOLUCION, COD_OFI_CAMARA, NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_FEC_PROCESO on IT.CC_CHE_RECIBIDOS (FEC_PROCESO, COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 4M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHE_RECIBIDOS
  add constraint PK_CC_CHE_RECIBIDOS primary key (NRO_CHEQUE, NRO_CUENTA, FEC_PROCESO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 5M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHE_RECIBIDOS
  add constraint FK_CCREC_COD_BCO_EMISOR foreign key (COD_BCO_EMISOR)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.CC_CHE_RECIBIDOS
  add constraint FK_CCREC_COD_BCO_RECEPTOR foreign key (COD_BCO_RECEPTOR)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.CC_CHE_RECIBIDOS
  add constraint FK_CCREC_COD_CAU_DEVOLUCION foreign key (COD_CAU_DEVOLUCION)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.CC_CHE_RECIBIDOS
  add constraint FK_CCREC_COD_OFI_CAMARA foreign key (COD_OFI_CAMARA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CC_CHE_RECIBIDOS
  add constraint FK_CCREC_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

