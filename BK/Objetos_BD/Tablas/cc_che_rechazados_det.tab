create table IT.CC_CHE_RECHAZADOS_DET
(
  fec_proceso        DATE not null,
  nro_cheque         NUMBER(15) not null,
  cta_libradora      VARCHAR2(20),
  cod_bco_emisor     NUMBER(3) not null,
  cod_cau_devolucion NUMBER(3) not null,
  cod_cau_dev_bcp    NUMBER(3),
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_CHE_RECHAZADOS_DET
  is 'Detalle de Motivos de Rechazos Secundarios de Cheques Cargo Otros.';
comment on column IT.CC_CHE_RECHAZADOS_DET.fec_proceso
  is 'Fecha de Proceso.';
comment on column IT.CC_CHE_RECHAZADOS_DET.nro_cheque
  is 'Número de cheque.';
comment on column IT.CC_CHE_RECHAZADOS_DET.cta_libradora
  is 'Cuenta Libradora del cheque';
comment on column IT.CC_CHE_RECHAZADOS_DET.cod_bco_emisor
  is 'Banco emisor.';
comment on column IT.CC_CHE_RECHAZADOS_DET.cod_cau_devolucion
  is 'Código de Devolución de Cheque.';
comment on column IT.CC_CHE_RECHAZADOS_DET.cod_cau_dev_bcp
  is 'Código de Devolución BCP';
comment on column IT.CC_CHE_RECHAZADOS_DET.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CC_CHE_RECHAZADOS_DET.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CC_CHE_RECHAZADOS_DET.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CC_CHE_RECHAZADOS_DET.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.CC_CHE_RECHAZADOS_DET
  add constraint UK_CC_CHE_RECHAZADOS_DET unique (FEC_PROCESO, NRO_CHEQUE, CTA_LIBRADORA, COD_BCO_EMISOR, COD_CAU_DEVOLUCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_CHE_RECHAZADOS_DET
  add constraint FK_CCRCH_COD_BCO_EMI_DET foreign key (COD_BCO_EMISOR)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.CC_CHE_RECHAZADOS_DET
  add constraint FK_CCRCH_COD_CAU_DEV_DET foreign key (COD_CAU_DEVOLUCION)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.CC_CHE_RECHAZADOS_DET
  add constraint CK_RCH_COD_CAU_DEV_DET
  check (COD_CAU_DEVOLUCION BETWEEN 0 AND 999);

