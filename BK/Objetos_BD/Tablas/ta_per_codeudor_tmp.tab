create table IT.TA_PER_CODEUDOR_TMP
(
  nro_cuenta        NUMBER(11),
  usu_actualizacion VARCHAR2(10),
  cod_persona       NUMBER(7),
  fec_actualizacion DATE,
  cod_entidad       NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_PER_CODEUDOR_TMP
  is 'Tabla de Personas Codeudoras';
comment on column IT.TA_PER_CODEUDOR_TMP.nro_cuenta
  is 'Número de la Cuenta.';
comment on column IT.TA_PER_CODEUDOR_TMP.usu_actualizacion
  is 'Usuario que realizó la última actualización.';
comment on column IT.TA_PER_CODEUDOR_TMP.cod_persona
  is 'Código de persona.';
comment on column IT.TA_PER_CODEUDOR_TMP.fec_actualizacion
  is 'Fecha en que se realizó la última actualización.';
comment on column IT.TA_PER_CODEUDOR_TMP.cod_entidad
  is 'Código de la Entidad.';

