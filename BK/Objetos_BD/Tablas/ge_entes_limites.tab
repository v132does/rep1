create table IT.GE_ENTES_LIMITES
(
  cod_ente         NUMBER(5) not null,
  mto_dep_max      NUMBER(18,2),
  mto_ext_max      NUMBER(18,2),
  cod_moneda       VARCHAR2(5),
  estado           VARCHAR2(1),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_ENTES_LIMITES
  is 'Tabla de registros de limites de deposito y extracto de los entes';
comment on column IT.GE_ENTES_LIMITES.cod_ente
  is 'Codigo de Ente.';
comment on column IT.GE_ENTES_LIMITES.mto_dep_max
  is 'Monto maximo de deposito del ente';
comment on column IT.GE_ENTES_LIMITES.mto_ext_max
  is 'Monto maximo de extraccion del ente';
comment on column IT.GE_ENTES_LIMITES.cod_moneda
  is 'El codigo de moneda que corresponde los limites';
comment on column IT.GE_ENTES_LIMITES.estado
  is 'Estado del registro . A: Activo , I: Inactivo';
comment on column IT.GE_ENTES_LIMITES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_ENTES_LIMITES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_ENTES_LIMITES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_ENTES_LIMITES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

