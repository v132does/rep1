create table IT.CV_SECCIONES
(
  cod_seccion      NUMBER(3) not null,
  descripcion      VARCHAR2(50),
  cod_hilera       NUMBER(3),
  estado           VARCHAR2(1),
  val_incluidos    VARCHAR2(100),
  abreviatura      VARCHAR2(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CV_SECCIONES
  is 'Secciones de la Hilera (días del mes) del Mueble del Archivo Físico.';
comment on column IT.CV_SECCIONES.cod_seccion
  is 'Código de Sección.';
comment on column IT.CV_SECCIONES.descripcion
  is 'Descripción de la Sección.';
comment on column IT.CV_SECCIONES.cod_hilera
  is 'Codigo de la Hilera de la Sección.';
comment on column IT.CV_SECCIONES.estado
  is 'A=Activo, I= Inactivo.';
comment on column IT.CV_SECCIONES.val_incluidos
  is 'Lista de valores que corresponden a la Sección (dias del mes).';
comment on column IT.CV_SECCIONES.abreviatura
  is 'Abreviatura para Código de Barras.';
comment on column IT.CV_SECCIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CV_SECCIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CV_SECCIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CV_SECCIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CV_SECCIONES
  add constraint PK_CV_SECCIONES primary key (COD_SECCION)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CV_SECCIONES
  add constraint FK_CSECC_COD_HILERA foreign key (COD_HILERA)
  references IT.CV_HILERAS (COD_HILERA);

