-- Create table
create table IT.GE_CON_TRA_PROCESOS
(
  fecha            DATE,
  hora             VARCHAR2(8),
  cod_usuario      VARCHAR2(10),
  nro_secuencia    NUMBER(3),
  procesado        VARCHAR2(1),
  mensaje          VARCHAR2(3000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate indexes 
create index IT.IN_CONTRAFECPRO on IT.GE_CON_TRA_PROCESOS (FECHA, PROCESADO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CONTRAPFEC on IT.GE_CON_TRA_PROCESOS (FECHA)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CONTRAPROCESOS on IT.GE_CON_TRA_PROCESOS (FECHA, HORA, COD_USUARIO, NRO_SECUENCIA, PROCESADO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CONTRAPROREV on IT.GE_CON_TRA_PROCESOS (FECHA, HORA, COD_USUARIO, NRO_SECUENCIA, PROCESADO, REVERSADO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GCONTP_MOVIMIENTO on IT.GE_CON_TRA_PROCESOS (FECHA, HORA, COD_USUARIO, NRO_SECUENCIA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
-- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.GE_CON_TRA_PROCESOS to IT_TEMPORAL;
