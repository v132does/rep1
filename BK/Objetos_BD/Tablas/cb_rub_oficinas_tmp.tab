create table IT.CB_RUB_OFICINAS_TMP
(
  cod_oficina      NUMBER(3) not null,
  cod_rubro        VARCHAR2(15) not null,
  ult_nro_extracto NUMBER(5),
  usu_insercion    VARCHAR2(10),
  fec_insercion    DATE,
  usu_modificacion VARCHAR2(10),
  fec_modificacion DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.CB_RUB_OFICINAS_TMP.usu_insercion
  is 'Usuario que realizo la Insercion del Registro.';
comment on column IT.CB_RUB_OFICINAS_TMP.fec_insercion
  is 'Fecha en que se Inserto el Registro.';
comment on column IT.CB_RUB_OFICINAS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_RUB_OFICINAS_TMP.fec_modificacion
  is 'Fecha en que se realizo la Ultima Modificacion en el Registro.';

