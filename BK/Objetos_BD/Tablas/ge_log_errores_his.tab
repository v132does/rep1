-- Create table
create table IT.GE_LOG_ERRORES_HIS
(
  cod_programa     VARCHAR2(50) not null,
  campo1           VARCHAR2(50),
  dato1            VARCHAR2(80),
  campo2           VARCHAR2(50),
  dato2            VARCHAR2(80),
  campo3           VARCHAR2(50),
  dato3            VARCHAR2(80),
  det_error        VARCHAR2(4000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_persona      VARCHAR2(10),
  nro_cuenta       VARCHAR2(15),
  fecha            DATE,
  fec_historico    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.GE_LOG_ERRORES_HIS
  is 'Tabla historica de Errores generados por procesos en linea.';
-- Add comments to the columns 
comment on column IT.GE_LOG_ERRORES_HIS.cod_programa
  is 'Codigo del Programa en el cual se genera el error';
comment on column IT.GE_LOG_ERRORES_HIS.campo1
  is 'Nombre del Campo del cual se indicara el dato ';
comment on column IT.GE_LOG_ERRORES_HIS.dato1
  is 'Dato del campo indicado';
comment on column IT.GE_LOG_ERRORES_HIS.campo2
  is 'Nombre del Campo del cual se indicara el dato ';
comment on column IT.GE_LOG_ERRORES_HIS.dato2
  is 'Dato del campo indicado';
comment on column IT.GE_LOG_ERRORES_HIS.campo3
  is 'Nombre del Campo del cual se indicara el dato ';
comment on column IT.GE_LOG_ERRORES_HIS.dato3
  is 'Dato del campo indicado';
comment on column IT.GE_LOG_ERRORES_HIS.det_error
  is 'Detalle del error.';
comment on column IT.GE_LOG_ERRORES_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_LOG_ERRORES_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_LOG_ERRORES_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_LOG_ERRORES_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_LOG_ERRORES.fec_historico
  is 'Fecha en que se realizo el proceso de pase a historico.';
-- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.GE_LOG_ERRORES_HIS to IT_TEMPORAL;
