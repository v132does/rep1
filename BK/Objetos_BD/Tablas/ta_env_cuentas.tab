create index IT.IN_TENCU_FEC_ENVIO on IT.TA_ENV_CUENTAS (FEC_ENVIO, SEC_ENV_DATOS)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TENCU_NRO_SOLICITUD on IT.TA_ENV_CUENTAS (NRO_SOLICITUD)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_ENV_CUENTAS
  add constraint FK_TENCU_COD_TIP_CIERRE foreign key (COD_TIP_CIERRE)
  references IT.TA_TIP_CIERRES (COD_TIP_CIERRE);

