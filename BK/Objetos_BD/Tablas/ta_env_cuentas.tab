create table IT.TA_ENV_CUENTAS
(
  cod_procesadora         VARCHAR2(10),
  cod_banco               NUMBER(2),
  nro_doc_cod_procesadora VARCHAR2(20),
  nro_doc_procesadora     VARCHAR2(20),
  nro_documento           VARCHAR2(20),
  tip_per_titular         VARCHAR2(1),
  cod_tip_doc_titular     VARCHAR2(3),
  pri_nom_titular         VARCHAR2(20),
  seg_nom_titular         VARCHAR2(20),
  pri_ape_titular         VARCHAR2(20),
  seg_ape_titular         VARCHAR2(20),
  raz_social              VARCHAR2(30),
  nom_comercial           VARCHAR2(40),
  cod_pai_titular         NUMBER(3),
  cod_sex_titular         VARCHAR2(1),
  fec_nac_titular         DATE,
  lug_nac_titular         VARCHAR2(15),
  ruc_titular             VARCHAR2(11),
  est_civ_titular         VARCHAR2(1),
  act_titular             VARCHAR2(4),
  dir_cor_titular         VARCHAR2(60),
  cod_tip_doc_nvo_titular VARCHAR2(3),
  nro_doc_nvo_titular     VARCHAR2(16),
  sec_env_datos           NUMBER(12),
  nro_cuenta              VARCHAR2(15),
  cod_afinidad            VARCHAR2(10),
  tip_cuenta              VARCHAR2(1),
  dir_recibo              VARCHAR2(35),
  direccion               VARCHAR2(90),
  localidad               VARCHAR2(35),
  dir_ext_2               VARCHAR2(50),
  dir_ext_3               VARCHAR2(50),
  cod_departamento        NUMBER(3),
  cod_ciudad              NUMBER(6),
  cod_zona                VARCHAR2(2),
  telefono                VARCHAR2(25),
  nro_tel_movil           VARCHAR2(15),
  cod_sucursal            NUMBER(4),
  cta_vip                 VARCHAR2(1),
  franqueo                VARCHAR2(1),
  seg_vida                VARCHAR2(1),
  cob_cargo               VARCHAR2(1),
  tip_costo               VARCHAR2(1),
  ret_extracto            VARCHAR2(1),
  cod_retencion           VARCHAR2(1),
  cau_retencion           NUMBER(3),
  cod_tip_cierre          NUMBER(2),
  emp_adherida            NUMBER(5),
  bcp_calificacion        NUMBER(1),
  situacion               VARCHAR2(1),
  cod_cli_entidad         VARCHAR2(15),
  nro_socio               VARCHAR2(15),
  bonos                   NUMBER(6),
  tip_lin_normal          NUMBER(3),
  lin_cre_normal          NUMBER(16),
  tip_lin_cuota           NUMBER(3),
  lin_cre_cuota           NUMBER(16),
  tas_personalizada       VARCHAR2(1),
  cod_tasa                NUMBER(3),
  val_tasa                NUMBER(6,2),
  cod_tas_moratorio       NUMBER(3),
  val_tas_moratorio       NUMBER(6,2),
  cod_tas_compra          NUMBER(3),
  val_tas_compra          NUMBER(6,2),
  pag_min_personalizado   VARCHAR2(1),
  por_pag_minimo          NUMBER(4,2),
  pag_minimo              NUMBER(18,2),
  imp_pag_min_fijo        NUMBER(16),
  cod_for_pago            VARCHAR2(1),
  tip_cta_bancaria        NUMBER(1),
  cta_bancaria            VARCHAR2(15),
  tip_pago                VARCHAR2(1),
  val_cgf                 VARCHAR2(1),
  tip_tasa                VARCHAR2(1),
  vip_fac_multiplicador   NUMBER(6),
  fac_vip                 NUMBER(4),
  cobranding              NUMBER(6),
  nro_doc_codeudor        VARCHAR2(20),
  tip_per_codeudor        VARCHAR2(1),
  cod_tip_doc_codeudor    VARCHAR2(3),
  pri_nom_codeudor        VARCHAR2(20),
  seg_nom_codeudor        VARCHAR2(20),
  pri_ape_codeudor        VARCHAR2(20),
  seg_ape_codeudor        VARCHAR2(20),
  cod_sex_codeudor        VARCHAR2(1),
  fec_nac_codeudor        DATE,
  lug_nac_codeudor        VARCHAR2(15),
  est_civ_codeudor        VARCHAR2(1),
  act_codeudor            VARCHAR2(4),
  dir_cor_codeudor        VARCHAR2(60),
  nro_doc_oficial         VARCHAR2(16),
  tip_per_oficial         VARCHAR2(1),
  cod_tip_doc_oficial     VARCHAR2(3),
  pri_nom_oficial         VARCHAR2(20),
  seg_nom_oficial         VARCHAR2(20),
  pri_ape_oficial         VARCHAR2(20),
  seg_ape_oficial         VARCHAR2(20),
  cod_sex_oficial         VARCHAR2(1),
  fec_nac_oficial         DATE,
  lug_nac_oficial         VARCHAR2(15),
  est_civ_oficial         VARCHAR2(1),
  act_oficial             VARCHAR2(4),
  dir_cor_oficial         VARCHAR2(60),
  gas_no_aplicar          VARCHAR2(30),
  apl_impuesto            VARCHAR2(10),
  usu_actualizacion       VARCHAR2(10),
  mot_nov_cuenta          NUMBER(3),
  cod_gas_financiero      VARCHAR2(1),
  cod_encargado           VARCHAR2(10),
  cod_mod_pago            VARCHAR2(2),
  tip_comision            VARCHAR2(1),
  fec_novedad             DATE,
  tip_tarjeta             VARCHAR2(2),
  sec_alta                NUMBER(4),
  cod_movimiento          VARCHAR2(1),
  es_personalizado        VARCHAR2(1),
  fec_envio               DATE,
  hor_envio               VARCHAR2(8),
  estado                  VARCHAR2(1),
  cod_modalidad           NUMBER(3),
  cod_moneda              VARCHAR2(3),
  nom_usuario             VARCHAR2(30),
  cod_persona             VARCHAR2(10),
  nro_solicitud           NUMBER(7),
  usu_insercion           VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion           DATE default SYSDATE not null,
  usu_modificacion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion        DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_ENV_CUENTAS
