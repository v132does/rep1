-- Create table
create table IT.GE_CAUSALES_DET
(
  cod_causa        NUMBER(3) not null,
  cod_sub_causa    NUMBER(3) not null,
  cod_cau_bcp      NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.GE_CAUSALES_DET
  is 'Detalle de causales del sistema.';
-- Add comments to the columns 
comment on column IT.GE_CAUSALES_DET.cod_causa
  is 'Codigo de causa.';
comment on column IT.GE_CAUSALES_DET.cod_sub_causa
  is 'Codigo de causa detalle.';
comment on column IT.GE_CAUSALES_DET.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CAUSALES_DET.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CAUSALES_DET.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CAUSALES_DET.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_CAUSALES_DET.cod_cau_bcp
  is 'Codigo de Causa BCP';
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.GE_CAUSALES_DET
  add constraint PK_GE_CAUSALES_DET primary key (COD_CAUSA, COD_SUB_CAUSA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
