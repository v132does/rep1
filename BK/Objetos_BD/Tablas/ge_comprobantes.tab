create table IT.GE_COMPROBANTES
(
  nro_comprobante   NUMBER(18) not null,
  tip_comprobante   VARCHAR2(2),
  fecha             DATE not null,
  hora              VARCHAR2(8) not null,
  nro_secuencia     NUMBER(3) not null,
  cod_usuario       VARCHAR2(10) not null,
  concepto          VARCHAR2(100),
  nro_transaccion   NUMBER(15),
  cod_moneda        VARCHAR2(3) not null,
  monto             NUMBER(18,2) not null,
  estado            VARCHAR2(1),
  reversado         VARCHAR2(1),
  nro_cta_debito    VARCHAR2(15),
  cod_per_debito    VARCHAR2(10),
  cod_ent_deb_swift VARCHAR2(30),
  nro_cta_destino   VARCHAR2(50),
  cod_ent_cre_swift VARCHAR2(30),
  tit_destino       VARCHAR2(50),
  nro_doc_destino   VARCHAR2(20),
  fec_transferencia DATE,
  hor_transferencia VARCHAR2(8),
  categoria         VARCHAR2(15),
  subcategoria      VARCHAR2(15),
  servicio          VARCHAR2(15),
  nro_cuenta        VARCHAR2(15),
  nro_cuota         NUMBER(3),
  nro_tarjeta       VARCHAR2(25),
  tip_transaccion   VARCHAR2(1),
  comercio          VARCHAR2(50),
  depositante       VARCHAR2(50),
  detalles          VARCHAR2(255),
  referencia1       VARCHAR2(15),
  referencia2       VARCHAR2(15),
  referencia3       VARCHAR2(15),
  referencia4       VARCHAR2(15),
  referencia5       VARCHAR2(15),
  fec_insercion     DATE default SYSDATE not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_COMPROBANTES
  is 'Tabla para registrar las transacciones realizadas';
comment on column IT.GE_COMPROBANTES.nro_comprobante
  is 'Numero sencuencial identificador ';
comment on column IT.GE_COMPROBANTES.tip_comprobante
  is 'Tipo Comprobante. Dominio = TIP_COM_CONCEPTO';
comment on column IT.GE_COMPROBANTES.fecha
  is 'Fecha del movimiento';
comment on column IT.GE_COMPROBANTES.hora
  is 'Hora del movimiento';
comment on column IT.GE_COMPROBANTES.nro_secuencia
  is 'Numero de Secuencia del movimiento';
comment on column IT.GE_COMPROBANTES.cod_usuario
  is 'Codigo usuario del movimiento';
comment on column IT.GE_COMPROBANTES.concepto
  is 'Concepto del Comprobante. ';
comment on column IT.GE_COMPROBANTES.nro_transaccion
  is 'Nro. de Documento del movimiento o el comprobante relacionado al movimiento';
comment on column IT.GE_COMPROBANTES.cod_moneda
  is 'Codigo de moneda';
comment on column IT.GE_COMPROBANTES.monto
  is 'Monto de la operacion';
comment on column IT.GE_COMPROBANTES.estado
  is 'Estado del Movimiento';
comment on column IT.GE_COMPROBANTES.reversado
  is 'Reversado S(si) N(no)';
comment on column IT.GE_COMPROBANTES.nro_cta_debito
  is 'Nro. de cuenta debito';
comment on column IT.GE_COMPROBANTES.cod_per_debito
  is 'Codigo de persona debito';
comment on column IT.GE_COMPROBANTES.cod_ent_deb_swift
  is 'Codigo Entidad Debito';
comment on column IT.GE_COMPROBANTES.nro_cta_destino
  is 'Nro. de cuenta destino';
comment on column IT.GE_COMPROBANTES.cod_ent_cre_swift
  is 'Codigo Entidad Credito';
comment on column IT.GE_COMPROBANTES.tit_destino
  is 'Nombre del Beneficiario';
comment on column IT.GE_COMPROBANTES.nro_doc_destino
  is 'Nro. Documento Beneficiario';
comment on column IT.GE_COMPROBANTES.fec_transferencia
  is 'Fecha de transferencia';
comment on column IT.GE_COMPROBANTES.hor_transferencia
  is 'Hora de Transferencia';
comment on column IT.GE_COMPROBANTES.categoria
  is 'Categoria';
comment on column IT.GE_COMPROBANTES.subcategoria
  is 'Subcategoria';
comment on column IT.GE_COMPROBANTES.servicio
  is 'Servicio';
comment on column IT.GE_COMPROBANTES.nro_cuenta
  is 'Nro. de cuenta Prestamo o TC ';
comment on column IT.GE_COMPROBANTES.nro_cuota
  is 'Nro. de cuota abonado';
comment on column IT.GE_COMPROBANTES.nro_tarjeta
  is 'Nro. de Tarjeta';
comment on column IT.GE_COMPROBANTES.tip_transaccion
  is 'Tipo Transaccion (Extraccion, Deposito, etc.)';
comment on column IT.GE_COMPROBANTES.comercio
  is 'Comercio';
comment on column IT.GE_COMPROBANTES.depositante
  is 'Depositante (Nombre, CI)';
comment on column IT.GE_COMPROBANTES.detalles
  is 'Detalles del movimiento';
comment on column IT.GE_COMPROBANTES.referencia1
  is 'Campo Adicional';
comment on column IT.GE_COMPROBANTES.referencia2
  is 'Campo Adicional';
comment on column IT.GE_COMPROBANTES.referencia3
  is 'Campo Adicional';
comment on column IT.GE_COMPROBANTES.referencia4
  is 'Campo Adicional';
comment on column IT.GE_COMPROBANTES.referencia5
  is 'Campo Adicional';
comment on column IT.GE_COMPROBANTES.fec_insercion
  is 'Fecha y hora de insercion';
comment on column IT.GE_COMPROBANTES.usu_insercion
  is 'Usuario de insercion';
comment on column IT.GE_COMPROBANTES.usu_modificacion
  is 'Usuario de modificacion';
comment on column IT.GE_COMPROBANTES.fec_modificacion
  is 'Fecha y hora de modificacion';
create index IT.IN_GECOM_COD_PERSONA on IT.GE_COMPROBANTES (COD_PER_DEBITO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GECOM_CTA_CUOTA on IT.GE_COMPROBANTES (NRO_CUENTA, NRO_CUOTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GECOM_FECHA on IT.GE_COMPROBANTES (FECHA)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GECOM_FEC_HORA on IT.GE_COMPROBANTES (FECHA, HORA, COD_USUARIO, NRO_SECUENCIA)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_COMPROBANTES
  add constraint PK_GE_COMPROBANTES primary key (NRO_COMPROBANTE, FECHA, HORA, COD_USUARIO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

