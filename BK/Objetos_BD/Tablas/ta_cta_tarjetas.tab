create index IT.IN_TCTAR_COD_CAMPANA on IT.TA_CTA_TARJETAS (COD_CAMPANA, COD_CANAL, COD_CAUSA, COD_MODALIDAD, COD_MODULO, COD_MONEDA, COD_OFICINA, COD_RUB_ECONOMICO, COD_USU_PROMOTOR)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCTAR_DEB_AUTOMATICO on IT.TA_CTA_TARJETAS (DEB_AUTOMATICO, NRO_CTA_DEBITO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCTAR_NRO_SOLICITUD on IT.TA_CTA_TARJETAS (NRO_SOLICITUD)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCUEN_ESTADO on IT.TA_CTA_TARJETAS (ESTADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 192K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCUEN_NRO_CTA_DEBITO on IT.TA_CTA_TARJETAS (NRO_CTA_DEBITO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCUEN_NRO_LINEA on IT.TA_CTA_TARJETAS (NRO_LINEA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_CTA_TARJETAS
  add constraint PK_TA_CTA_TARJETAS primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_CTA_TARJETAS
  add constraint FK_TCUEN_COD_CAMPANA foreign key (COD_CAMPANA)
  references IT.CR_CAMPANAS (COD_CAMPANA);
alter table IT.TA_CTA_TARJETAS
  add constraint FK_TCUEN_COD_CANAL foreign key (COD_CANAL)
  references IT.GE_CANALES (COD_CANAL);
alter table IT.TA_CTA_TARJETAS
  add constraint FK_TCUEN_COD_CAUSA foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.TA_CTA_TARJETAS
  add constraint FK_TCUEN_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.TA_CTA_TARJETAS
  add constraint FK_TCUEN_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.TA_CTA_TARJETAS
  add constraint FK_TCUEN_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.TA_CTA_TARJETAS
  add constraint FK_TCUEN_COD_TIP_CIERRE foreign key (COD_TIP_CIERRE)
  references IT.TA_TIP_CIERRES (COD_TIP_CIERRE);
alter table IT.TA_CTA_TARJETAS
  add constraint FK_TCUEN_COD_USU_PROMOTOR foreign key (COD_USU_PROMOTOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.TA_CTA_TARJETAS
  add constraint FK_TCUEN_NRO_SOLICITUD foreign key (NRO_SOLICITUD)
  references IT.TA_SOLICITUDES (NRO_SOLICITUD)
  disable
  novalidate;
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353181_COB_G_000
  check (COB_GAS_FINANCIERO IN ('S', 'N'));
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353181_COD_C_003
  check (COD_CAUSA BETWEEN 0 AND 999);
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353181_COD_M_003
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353181_COD_M_004
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353181_COD_O_003
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353181_CON_C_000
  check (CON_COSTO IN ('S', 'N'));
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353181_DEB_A_000
  check (DEB_AUTOMATICO IN ('S', 'N'));
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353181_MAR_B_000
  check (MAR_BLOQUEO IN ('A', 'U'));
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353181_TIP_C_000
  check (TIP_COBRO IN ('M', 'T'));
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353182_COD_C_000
  check (COD_CANAL BETWEEN 0 AND 999);
alter table IT.TA_CTA_TARJETAS
  add constraint AVCON_1081353182_COD_C_001
  check (COD_CAMPANA BETWEEN 0 AND 999);

