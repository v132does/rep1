create table IT.TA_CTA_TARJETAS
(
  nro_cuenta           VARCHAR2(15) not null,
  denominacion         VARCHAR2(65) not null,
  cod_modulo           NUMBER(3) not null,
  cod_modalidad        NUMBER(3) not null,
  cod_oficina          NUMBER(3) not null,
  cod_moneda           VARCHAR2(3) not null,
  lin_credito          NUMBER(18,2) default 0 not null,
  lin_cuotas           NUMBER(18,2) default 0 not null,
  sal_facturar         NUMBER(18,2) default 0 not null,
  sal_facturado        NUMBER(18,2) default 0 not null,
  sal_financiado       NUMBER(18,2) default 0 not null,
  sal_ult_extracto     NUMBER(18,2) default 0 not null,
  sal_cuo_pendientes   NUMBER(18,2) default 0 not null,
  mto_pag_minimo       NUMBER(18,2) default 0,
  sal_pag_minimo       NUMBER(18,2) default 0,
  mto_mora             NUMBER(18,2) default 0,
  dia_mora             NUMBER(14,2),
  mto_autorizaciones   NUMBER(18,2) default 0,
  mto_int_compras      NUMBER(18,2) default 0,
  mto_pag_mes          NUMBER(18,2) default 0,
  mto_gas_mora         NUMBER(18,2) default 0,
  estado               VARCHAR2(1) not null,
  est_administradora   VARCHAR2(1),
  fec_solicitud        DATE,
  fec_apertura         DATE,
  fec_ult_pago         DATE,
  fec_ult_compra       DATE,
  fec_ult_operacion    DATE,
  fec_ult_extracto     DATE,
  fec_ult_cierre       DATE,
  fec_vct_ult_cierre   DATE,
  cod_tip_cierre       NUMBER(2) default 1,
  cob_gas_financiero   VARCHAR2(1) default 'N',
  tip_tas_financiacion VARCHAR2(1),
  tip_com_emision      VARCHAR2(1),
  tas_financiacion     NUMBER(20,4) default 0,
  tas_adelanto         NUMBER(20,4) default 0,
  tas_mora             NUMBER(20,4) default 0,
  tas_cuotas           NUMBER(20,4) default 0,
  deb_automatico       VARCHAR2(1) default 'N' not null,
  tip_cobro            VARCHAR2(1) default 'M' not null,
  nro_cta_debito       VARCHAR2(15),
  mto_min_pago         NUMBER(18,2) default 0,
  por_pag_minimo       NUMBER(5,2) default 0,
  cod_usu_promotor     VARCHAR2(10),
  mar_mora             VARCHAR2(1),
  mar_excedido         VARCHAR2(1),
  mar_recuperado       VARCHAR2(1),
  mar_bloqueo          VARCHAR2(1) default 'A',
  con_costo            VARCHAR2(1) default 'N',
  nro_solicitud        NUMBER(15),
  cod_causa            NUMBER(3),
  cod_canal            NUMBER(3),
  cod_campana          NUMBER(3),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cat_automatica       NUMBER(2),
  fec_juicio           DATE,
  cod_ent_juicio       NUMBER(5),
  max_atraso           NUMBER(5),
  pro_atraso           NUMBER(5),
  nro_linea            NUMBER(7),
  en_juicio            VARCHAR2(1) default 'N',
  cat_aut_anterior     NUMBER(2),
  fec_activacion       DATE,
  fec_cancelacion      DATE,
  tas_efectiva         NUMBER(20,4) default 0,
  mto_aut_cuotas       NUMBER(18,2) default 0,
  afinidad             VARCHAR2(10),
  sub_afinidad         VARCHAR2(3),
  sal_procesadora      NUMBER(18,2) default 0,
  cod_rub_economico    VARCHAR2(6),
  tip_plastico         VARCHAR2(1),
  mto_fij_pag_minimo   NUMBER(18,2),
  mto_min_pag_minimo   NUMBER(18,2),
  tas_int_corriente    NUMBER(18,2),
  tas_int_compra       NUMBER(18,2),
  tas_int_mora         NUMBER(18,2),
  car_no_aplicar       VARCHAR2(30),
  mto_car_sus_aplicado NUMBER(13,2),
  mto_car_suspendido   NUMBER(13,2),
  tas_especial         NUMBER(20,4),
  lin_especial         NUMBER(18,2),
  franqueo             VARCHAR2(1),
  ind_seg_vida         VARCHAR2(1),
  cod_exc_cargo        VARCHAR2(30),
  tip_cierre           VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
