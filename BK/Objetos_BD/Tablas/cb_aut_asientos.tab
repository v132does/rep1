-- Create table
create table IT.CB_AUT_ASIENTOS
(
  fecha            DATE not null,
  cod_oficina      NUMBER(3) not null,
  nro_asiento      NUMBER(6) not null,
  cod_usuario      VARCHAR2(10) not null,
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  cod_usu_autoriza VARCHAR2(10) not null,
  usu_insercion    VARCHAR2(10) default substr(user,1,10) not null,
  fec_insercion    DATE default sysdate not null,
  usu_modificacion VARCHAR2(10) default substr(user,1,10) not null,
  fec_modificacion DATE default sysdate not null,
  confirmado       VARCHAR2(1) default 'N',
  fec_autorizac    DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.CB_AUT_ASIENTOS
  is 'Contiene los datos correspondientes a la Cabecera de los Asientos Contables Automaticos.';
-- Add comments to the columns 
comment on column IT.CB_AUT_ASIENTOS.fecha
  is 'Fecha de los movimientos que genera el asiento.';
comment on column IT.CB_AUT_ASIENTOS.cod_oficina
  is 'Codigo de la oficina origen del asiento.';
comment on column IT.CB_AUT_ASIENTOS.nro_asiento
  is 'Numero del asiento automatico.';
comment on column IT.CB_AUT_ASIENTOS.cod_usuario
  is 'Codigo del usuario que genero el asiento.';
comment on column IT.CB_AUT_ASIENTOS.cod_modulo
  is 'Codigo de modulo del asiento.';
comment on column IT.CB_AUT_ASIENTOS.cod_modalidad
  is 'Codigo de modalidad del asiento.';
comment on column IT.CB_AUT_ASIENTOS.cod_usu_autoriza
  is 'Codigo del usuario autorizador.';
comment on column IT.CB_AUT_ASIENTOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_AUT_ASIENTOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_AUT_ASIENTOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_AUT_ASIENTOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CB_AUT_ASIENTOS.confirmado
  is 'Asiento confirmado Ok? ( S= Asiento confirmado, puede actualizar saldo de cuenta, N= Asiento no confirmado, no puede actualizar saldo de cuenta ).';
comment on column IT.CB_AUT_ASIENTOS.fec_autorizac
  is 'Fecha de autorizacion';
-- Create/Recreate indexes 
create index IT.IN_AUT_NRO_ASIENTO on IT.CB_AUT_ASIENTOS (NRO_ASIENTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BAAUT_ASIENTO on IT.CB_AUT_ASIENTOS (COD_MODALIDAD, COD_MODULO, COD_OFICINA, COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.CB_AUT_ASIENTOS
  add constraint PK_CB_AUT_ASIENTOS primary key (FECHA, COD_OFICINA, NRO_ASIENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_AUT_ASIENTOS
  add constraint FK_CBAUT_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.CB_AUT_ASIENTOS
  add constraint FK_CBAUT_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CB_AUT_ASIENTOS
  add constraint FK_CBAUT_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);

