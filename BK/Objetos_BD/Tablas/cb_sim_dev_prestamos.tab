create table IT.CB_SIM_DEV_PRESTAMOS
(
  nro_cuenta        VARCHAR2(15) not null,
  fec_inicio        DATE not null,
  val_tasa          NUMBER(20,4) default 0 not null,
  mto_dev_anterior  NUMBER(18,2) default 0,
  mto_dev_actual    NUMBER(18,2) default 0 not null,
  capital           NUMBER(18,2) default 0 not null,
  nro_cuota         NUMBER(3) not null,
  tipo              VARCHAR2(1) default 'C' not null,
  fecha             DATE not null,
  fec_ult_devengado DATE,
  cod_moneda        VARCHAR2(3) not null,
  estado            VARCHAR2(1) not null,
  categoria         NUMBER(3,2) not null,
  can_dia_interes   NUMBER(6) default 0 not null,
  can_dia_anterior  NUMBER(6) default 0,
  mto_ajuste        NUMBER(18,2) default 0,
  mto_dev_acumulado NUMBER(18,2) default 0 not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SIM_DEV_PRESTAMOS
  is ' Detalle de Devengados de Préstamos.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.nro_cuenta
  is 'Número de Préstamo.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.fec_inicio
  is 'Fecha de inicio del devengamiento.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.val_tasa
  is 'Valor de la tasa con la cual se devenga.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.mto_dev_anterior
  is 'Monto del devengado anterior.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.mto_dev_actual
  is 'Monto del devengado actual.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.capital
  is 'Monto de Capital sobre el cual se devenga.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.nro_cuota
  is 'Numero de Cuota devengada.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.tipo
  is 'Tipo de Devengado: No (C)obrado o En (S)uspenso.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.fecha
  is 'Fecha del proceso del devengamiento.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.fec_ult_devengado
  is 'Fecha de ultimo devengado.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.cod_moneda
  is 'Código de la moneda.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.estado
  is 'Estado en que se encontraba el préstamo en el momento del devengado.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.categoria
  is 'Categoria en que se encontraba el préstamo en el momento del devengado.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.can_dia_interes
  is 'Días de devengamiento.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.can_dia_anterior
  is 'Cantidad de dias devengados anteriormente.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.mto_ajuste
  is 'Monto del ajuste del devengado, en el momento del vencimiento de la cuota.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.mto_dev_acumulado
  is 'Monto total devengado de la cuota.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.usu_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.CB_SIM_DEV_PRESTAMOS.fec_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
create index IT.IN_PSEVE_NRO_CUENTA on IT.CB_SIM_DEV_PRESTAMOS (FECHA, NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_SIM_DEV_PRESTAMOS
  add constraint PK_CB_SIM_DEV_PRESTAMOS primary key (NRO_CUENTA, NRO_CUOTA, TIPO, COD_MONEDA, ESTADO, CATEGORIA, CAPITAL, VAL_TASA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

