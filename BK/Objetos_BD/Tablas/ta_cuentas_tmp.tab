create table IT.TA_CUENTAS_TMP
(
  nro_cuenta          NUMBER(11),
  denominacion        VARCHAR2(42 CHAR),
  cod_entidad         NUMBER(3),
  cod_afinidad        NUMBER(6),
  cod_marca           VARCHAR2(3),
  cod_pro_marca       VARCHAR2(3),
  tip_cuenta          VARCHAR2(1),
  cod_persona         NUMBER(7),
  cod_pais            NUMBER(3),
  cod_departamento    NUMBER(3),
  cod_ciudad          NUMBER(6),
  telefono            VARCHAR2(15),
  cod_oficina         NUMBER(4),
  oficial             NUMBER(7),
  tip_costo           VARCHAR2(1),
  vip                 VARCHAR2(1),
  franqueo            VARCHAR2(1),
  ret_extracto        VARCHAR2(1),
  tip_cierre          VARCHAR2(2),
  sit_cuenta          VARCHAR2(1),
  dia_mora            NUMBER(5),
  fec_ult_vencimiento DATE,
  fec_ult_cierre      DATE,
  tip_documento       VARCHAR2(3),
  nro_documento       VARCHAR2(16),
  ruc                 VARCHAR2(11),
  cob_costo           VARCHAR2(1),
  mot_ret_extracto    NUMBER(3),
  usu_insercion       VARCHAR2(10),
  fec_ingreso         DATE,
  usu_actualizacion   VARCHAR2(10),
  fec_actualizacion   DATE,
  ind_seg_vida        VARCHAR2(1),
  calificacion_bcp    NUMBER(1) default 0,
  reservado           NUMBER(10),
  fec_sit_cuenta      DATE,
  observacion         VARCHAR2(40 CHAR),
  dir_correo          VARCHAR2(60),
  mot_novedad         NUMBER(3),
  mot_entidad         NUMBER(3),
  emp_adherida        NUMBER(5),
  cod_zona            VARCHAR2(10),
  reserva             VARCHAR2(1),
  celular             VARCHAR2(15),
  dir_recibo          VARCHAR2(35 CHAR),
  ciu_recibo          VARCHAR2(15 CHAR),
  pri_dir_extracto    VARCHAR2(50 CHAR),
  seg_dir_extracto    VARCHAR2(50 CHAR),
  ter_dir_extracto    VARCHAR2(50 CHAR),
  cod_per_entidad     VARCHAR2(15),
  fec_ult_transaccion DATE,
  fec_pri_compra      DATE,
  fec_ult_pago        DATE,
  fec_reservado1      DATE,
  fec_reservado2      DATE,
  cod_exc_cargo       VARCHAR2(30)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 16M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_CUENTAS_TMP
  is 'Tabla de Cuentas Generales.';
comment on column IT.TA_CUENTAS_TMP.nro_cuenta
  is 'Número de Cuenta.';
comment on column IT.TA_CUENTAS_TMP.denominacion
  is 'Denominación.';
comment on column IT.TA_CUENTAS_TMP.cod_entidad
  is 'Código de Entidad.';
