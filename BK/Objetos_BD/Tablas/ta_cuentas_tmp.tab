comment on column IT.TA_CUENTAS_TMP.pri_dir_extracto
  is 'Primera Dirección del Extracto.';
comment on column IT.TA_CUENTAS_TMP.seg_dir_extracto
  is 'Segunda Dirección del Extracto.';
comment on column IT.TA_CUENTAS_TMP.ter_dir_extracto
  is 'tercera Dirección del Extracto.';
comment on column IT.TA_CUENTAS_TMP.cod_per_entidad
  is 'ódigo de Cliente Entidad.';
comment on column IT.TA_CUENTAS_TMP.fec_ult_transaccion
  is 'Fecha de Última Transacción.';
comment on column IT.TA_CUENTAS_TMP.fec_pri_compra
  is 'Fecha de Primera Compra.';
comment on column IT.TA_CUENTAS_TMP.fec_ult_pago
  is 'Fecha Último Pago.';
comment on column IT.TA_CUENTAS_TMP.fec_reservado1
  is 'Fecha: campo fecha reservado 1.';
comment on column IT.TA_CUENTAS_TMP.fec_reservado2
  is 'Fecha: campo fecha reservado 2.';
comment on column IT.TA_CUENTAS_TMP.cod_exc_cargo
  is 'Codigos de Excepciones de Cargos del Cierre.';
create index IT.IN_TC_COD_ADIFINIDAD on IT.TA_CUENTAS_TMP (COD_AFINIDAD)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
