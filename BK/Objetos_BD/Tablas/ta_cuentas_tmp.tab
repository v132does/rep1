  is 'Tipo de Costo.';
comment on column IT.TA_CUENTAS_TMP.vip
  is 'VIP.';
comment on column IT.TA_CUENTAS_TMP.franqueo
  is 'Franqueo.';
comment on column IT.TA_CUENTAS_TMP.ret_extracto
  is 'Retención de Extracto.';
comment on column IT.TA_CUENTAS_TMP.tip_cierre
  is 'Tipo de Cierre.';
comment on column IT.TA_CUENTAS_TMP.sit_cuenta
  is 'Situación de Cuenta.';
comment on column IT.TA_CUENTAS_TMP.dia_mora
  is 'Días de Mora.';
comment on column IT.TA_CUENTAS_TMP.fec_ult_vencimiento
  is 'Fecha de último vencimiento.';
comment on column IT.TA_CUENTAS_TMP.fec_ult_cierre
  is 'Fecha de último cierre.';
comment on column IT.TA_CUENTAS_TMP.tip_documento
  is 'Tipo de Documento.';
