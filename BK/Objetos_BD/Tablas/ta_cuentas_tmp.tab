  is 'Número de Documento.';
comment on column IT.TA_CUENTAS_TMP.ruc
  is 'RUC.';
comment on column IT.TA_CUENTAS_TMP.cob_costo
  is 'Cobertura de Costo.';
comment on column IT.TA_CUENTAS_TMP.mot_ret_extracto
  is 'Motivo de Retención de Extracto.';
comment on column IT.TA_CUENTAS_TMP.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.TA_CUENTAS_TMP.fec_ingreso
  is 'Fecha de Ingreso.';
comment on column IT.TA_CUENTAS_TMP.usu_actualizacion
  is 'Usuario que realizó la última actualización del registro.';
comment on column IT.TA_CUENTAS_TMP.fec_actualizacion
  is 'Fecha en que se actualizó por última vez el registro.';
comment on column IT.TA_CUENTAS_TMP.ind_seg_vida
  is 'Seguro de Vida.';
