create table IT.BA_PER_DOCUMENTOS
(
  cod_persona       VARCHAR2(10) not null,
  cod_tip_documento NUMBER(3) not null,
  nro_documento     VARCHAR2(20) not null,
  fec_vto_documento DATE,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  cod_pai_documento NUMBER(3),
  dna               VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_PER_DOCUMENTOS
  is 'Documentos Anexos de las Personas.';
comment on column IT.BA_PER_DOCUMENTOS.cod_persona
  is 'Código de Persona.';
comment on column IT.BA_PER_DOCUMENTOS.cod_tip_documento
  is 'Tipo de Documento de la Persona';
comment on column IT.BA_PER_DOCUMENTOS.nro_documento
  is 'Número de documento.';
comment on column IT.BA_PER_DOCUMENTOS.fec_vto_documento
  is 'Vencimiento del Documento.';
comment on column IT.BA_PER_DOCUMENTOS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.BA_PER_DOCUMENTOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.BA_PER_DOCUMENTOS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.BA_PER_DOCUMENTOS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.BA_PER_DOCUMENTOS.cod_pai_documento
  is 'Código de País del Documento.';
comment on column IT.BA_PER_DOCUMENTOS.dna
  is 'Utilizar para DNA S/N';
alter table IT.BA_PER_DOCUMENTOS
  add constraint PK_BA_PER_DOCUMENTOS primary key (COD_PERSONA, COD_TIP_DOCUMENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_PER_DOCUMENTOS
  add constraint UK_EPDOC_NRO_DOCUMENTO unique (NRO_DOCUMENTO, COD_TIP_DOCUMENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_PER_DOCUMENTOS
  add constraint FK_EPDOC_COD_PAI_DOCUMENTO foreign key (COD_PAI_DOCUMENTO)
  references IT.BA_PAISES (COD_PAIS);
alter table IT.BA_PER_DOCUMENTOS
  add constraint FK_EPDOC_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.BA_PER_DOCUMENTOS
  add constraint FK_EPDOC_COD_TIP_DOCUMENTO foreign key (COD_TIP_DOCUMENTO)
  references IT.BA_TIP_DOCUMENTOS (COD_TIP_DOCUMENTO);

