create index IT.IN_GMOHI_COD_MOD_PADRE on IT.GE_MOVIMIENTOS_HIS (COD_MOD_PADRE, FECHA)
  tablespace IT_IND
  pctfree 40
  initrans 4
  maxtrans 255
  storage
  (
    initial 89336K
    next 1M
    minextents 1
    maxextents unlimited
  );
