alter table IT.GE_MOVIMIENTOS_HIS
  add constraint PK_GMOHI_GE_MOVIMIENTOS_HIS primary key (FECHA, HORA, COD_USUARIO, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_BANCO foreign key (COD_BANCO)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_CAUSAL foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_RETENCION foreign key (COD_RETENCION)
  references IT.GE_RETENCIONES (COD_RETENCION);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_TRA_HIJO foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_TRA_PADRE foreign key (COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_USU_AUTORIZADOR foreign key (COD_USU_AUTORIZADOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_COD_USU_REVERSION foreign key (COD_USU_REVERSION)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_NRO_CAJA foreign key (NRO_CAJA)
  references IT.CJ_CAJAS (NRO_CAJA);
alter table IT.GE_MOVIMIENTOS_HIS
  add constraint FK_GMOHI_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

