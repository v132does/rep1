create table IT.CR_PER_PUN_ELEMENTOS_HIS
(
  cod_persona      VARCHAR2(10) not null,
  cod_puntaje      NUMBER(3) not null,
  cod_elemento     VARCHAR2(3) not null,
  pun_elemento     NUMBER(10,3),
  usu_insercion    VARCHAR2(10),
  fec_insercion    DATE,
  usu_modificacion VARCHAR2(10),
  fec_modificacion DATE,
  rie_elemento     NUMBER(10),
  fecha            DATE not null
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_PER_PUN_ELEMENTOS_HIS
  is 'Historico de Puntajes por Persona y Elementos.';
comment on column IT.CR_PER_PUN_ELEMENTOS_HIS.cod_persona
  is 'Codigo de Persona.';
comment on column IT.CR_PER_PUN_ELEMENTOS_HIS.cod_puntaje
  is 'Codigo de Scoring.';
comment on column IT.CR_PER_PUN_ELEMENTOS_HIS.cod_elemento
  is 'Codigo del elemento.';
comment on column IT.CR_PER_PUN_ELEMENTOS_HIS.pun_elemento
  is 'Puntaje.';
comment on column IT.CR_PER_PUN_ELEMENTOS_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_PER_PUN_ELEMENTOS_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_PER_PUN_ELEMENTOS_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_PER_PUN_ELEMENTOS_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CR_PER_PUN_ELEMENTOS_HIS.rie_elemento
  is 'Riesgo.';
comment on column IT.CR_PER_PUN_ELEMENTOS_HIS.fecha
  is 'Fecha en que se realizo el calculo.';
alter table IT.CR_PER_PUN_ELEMENTOS_HIS
  add constraint PK_CR_PER_PUN_ELEMENTOS_HIS primary key (COD_PERSONA, COD_PUNTAJE, COD_ELEMENTO, FECHA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

