create table IT.GE_CUENTAS_TMP
(
  nro_cuenta  VARCHAR2(15) not null,
  actualizado VARCHAR2(1) default 'N'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CUENTAS_TMP
  is 'Tabla temporar de cuentas a cancelar';
comment on column IT.GE_CUENTAS_TMP.actualizado
  is 'Cancelado (Si/No)';

