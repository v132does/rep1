create table IT.GE_OFE_PAR_CUOTERO
(
  mto_prestamo     NUMBER,
  mto_cuota        NUMBER,
  can_cuota        NUMBER,
  cod_moneda       VARCHAR2(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_OFE_PAR_CUOTERO
  is 'Tabla parametrica de cuotero para ofertas de pre-aprobado.';
comment on column IT.GE_OFE_PAR_CUOTERO.mto_prestamo
  is 'Monto del Prestamo.';
comment on column IT.GE_OFE_PAR_CUOTERO.mto_cuota
  is 'Monto Cuota.';
comment on column IT.GE_OFE_PAR_CUOTERO.can_cuota
  is 'Cantidad de Cuota';
comment on column IT.GE_OFE_PAR_CUOTERO.cod_moneda
  is 'Codigo de Moneda.';
comment on column IT.GE_OFE_PAR_CUOTERO.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_OFE_PAR_CUOTERO.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_OFE_PAR_CUOTERO.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_OFE_PAR_CUOTERO.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

