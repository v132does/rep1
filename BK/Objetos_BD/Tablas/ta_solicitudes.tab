  is 'Fecha en que se realizó la ultima modificación en el registro.';
comment on column IT.TA_SOLICITUDES.nro_linea
  is 'Numero de Linea de Credito.';
comment on column IT.TA_SOLICITUDES.observacion
  is 'Observaciones.';
comment on column IT.TA_SOLICITUDES.cod_moneda
  is 'Moneda.';
comment on column IT.TA_SOLICITUDES.cod_campana
  is 'Campaña Asociada.';
comment on column IT.TA_SOLICITUDES.cod_canal
  is 'Canal Asociado.';
comment on column IT.TA_SOLICITUDES.mto_aprobado
  is 'Monto Aprobado.';
comment on column IT.TA_SOLICITUDES.niv_aprobacion
  is 'Niveles de Aprobación.';
comment on column IT.TA_SOLICITUDES.nro_acta
  is 'Nro. de Acta.';
comment on column IT.TA_SOLICITUDES.nro_cuenta
  is 'Nro. de Cuenta Generada.';
comment on column IT.TA_SOLICITUDES.afinidad
  is 'Codigo de Afinidad de la Tarjeta.';
comment on column IT.TA_SOLICITUDES.sub_afinidad
  is 'Codigo de Sub Afinidad de Tarjeta.';
comment on column IT.TA_SOLICITUDES.pre_embozada
  is 'Indicador de Solicitud de Tarjeta Pre Embozada.';
comment on column IT.TA_SOLICITUDES.ind_evaluacion
  is 'Indicador de Evaluación del Motor de Riesgos.';
comment on column IT.TA_SOLICITUDES.cod_tip_cierre
  is 'Código del Tipo de Cierre.';
comment on column IT.TA_SOLICITUDES.cod_rub_economico
  is 'Código de Rubro Económico.';
comment on column IT.TA_SOLICITUDES.tip_plastico
  is 'Indica si el plastico de la tarjeta posee o no Chip. N/Nulo=Normal, C=Chip.';
comment on column IT.TA_SOLICITUDES.tas_int_corriente
  is 'Tasa de Interés Corriente.';
comment on column IT.TA_SOLICITUDES.tas_int_compra
  is 'Tasa de Interés por Compras.';
comment on column IT.TA_SOLICITUDES.por_vip
  is 'Porcentaje Vip.';
comment on column IT.TA_SOLICITUDES.mto_fij_pag_minimo
  is 'Monto Fijo del Pago Mínimo.';
comment on column IT.TA_SOLICITUDES.mto_min_pag_minimo
  is 'Monto Mínimo del Pago Mínimo.';
comment on column IT.TA_SOLICITUDES.tas_int_mora
  is 'Tasa de Interés Moratorio.';
comment on column IT.TA_SOLICITUDES.cod_sub_modalidad
  is 'Codigo de Sub-Modalidad';
comment on column IT.TA_SOLICITUDES.tip_embozado
  is 'Tipo de embozado.
S/N/D/MV/MF Si, No, Virtual(Digital).';
create index IT.IN_TSOLI_COD_CAUSA on IT.TA_SOLICITUDES (COD_CAUSA, COD_MODALIDAD, COD_MODULO, COD_OFICINA, COD_RUB_ECONOMICO, COD_USU_OFICIAL, COD_USU_PROMOTOR, NRO_LINEA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TSOLI_COD_PERSONA on IT.TA_SOLICITUDES (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TSOLI_NRO_CTA_DEBITO on IT.TA_SOLICITUDES (NRO_CTA_DEBITO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_SOLICITUDES
  add constraint PK_TA_SOLICITUDES primary key (NRO_SOLICITUD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_SOLICITUDES
  add constraint FK_TSOLI_COD_CAUSA foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.TA_SOLICITUDES
  add constraint FK_TSOLI_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.TA_SOLICITUDES
  add constraint FK_TSOLI_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.TA_SOLICITUDES
  add constraint FK_TSOLI_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.TA_SOLICITUDES
  add constraint FK_TSOLI_COD_RUB_ECONOMICO foreign key (COD_RUB_ECONOMICO)
  references IT.PR_RUB_ECONOMICOS (COD_RUB_ECONOMICO);
alter table IT.TA_SOLICITUDES
  add constraint FK_TSOLI_COD_SUB_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD)
  references IT.GE_SUB_MODALIDADES (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD);
alter table IT.TA_SOLICITUDES
  add constraint FK_TSOLI_COD_TIP_CIERRE foreign key (COD_TIP_CIERRE)
  references IT.TA_TIP_CIERRES (COD_TIP_CIERRE);
alter table IT.TA_SOLICITUDES
  add constraint FK_TSOLI_COD_USU_AUTORIZA foreign key (COD_USU_OFICIAL)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.TA_SOLICITUDES
  add constraint FK_TSOLI_COD_USU_PROMOTOR foreign key (COD_USU_PROMOTOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.TA_SOLICITUDES
  add constraint FK_TSOLI_NRO_LINEA foreign key (NRO_LINEA)
  references IT.PR_LINEAS (NRO_LINEA);
alter table IT.TA_SOLICITUDES
  add constraint AVCON_1081353182_COD_C_004
  check (COD_CAUSA BETWEEN 0 AND 999);
alter table IT.TA_SOLICITUDES
  add constraint AVCON_1081353182_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.TA_SOLICITUDES
  add constraint AVCON_1081353182_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.TA_SOLICITUDES
  add constraint AVCON_1081353182_COD_O_001
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.TA_SOLICITUDES
  add constraint AVCON_1081353182_TIP_E_000
  check (TIP_ENVIO IN ('D', 'R', 'C', 'K'));
alter table IT.TA_SOLICITUDES
  add constraint CHECK_SOL_TAR_TIP_EMB
  check (tip_embozado IN ('S', 'N', 'D','MF','MV'));

