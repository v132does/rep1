create table IT.TA_SOLICITUDES
(
  nro_solicitud       NUMBER(15) not null,
  cod_persona         VARCHAR2(10) not null,
  cod_oficina         NUMBER(3) not null,
  cod_modulo          NUMBER(3) not null,
  cod_modalidad       NUMBER(3) not null,
  cod_usu_promotor    VARCHAR2(10),
  fec_solicitud       DATE not null,
  cod_usu_oficial     VARCHAR2(10),
  fec_aprobacion      DATE,
  cod_causa           NUMBER(3),
  deb_automatico      VARCHAR2(1) default 'N' not null,
  nro_cta_debito      VARCHAR2(15),
  tip_cobro           VARCHAR2(1) default 'M',
  nom_embozado        VARCHAR2(26),
  lin_sugerida        NUMBER(18,2),
  monto               NUMBER(18,2) default 0,
  puntaje             NUMBER(6),
  cod_estado          VARCHAR2(3),
  cod_est_sugerido    VARCHAR2(3),
  tas_int_adelanto    NUMBER(20,4) default 0,
  tas_financiacion    NUMBER(20,4) default 0,
  tas_mora            NUMBER(20,4) default 0,
  mto_min_pago        NUMBER(18,2) default 0,
  por_pag_minimo      NUMBER(5,2) default 0,
  tip_envio           VARCHAR2(1) default 'D',
  referencia          VARCHAR2(35),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  nro_linea           NUMBER(7),
  observacion         VARCHAR2(4000),
  cod_moneda          VARCHAR2(3) not null,
  cod_campana         NUMBER(3),
  cod_canal           NUMBER(3),
  mto_aprobado        NUMBER(18,2),
  niv_aprobacion      VARCHAR2(3),
  nro_acta            NUMBER(10),
  nro_cuenta          VARCHAR2(15),
  afinidad            VARCHAR2(10),
  sub_afinidad        VARCHAR2(3),
  pre_embozada        VARCHAR2(1),
  ind_evaluacion      VARCHAR2(1) default 'S',
  cod_tip_cierre      NUMBER(2) default 1 not null,
  cod_rub_economico   VARCHAR2(6),
  tip_plastico        VARCHAR2(1),
  tas_int_corriente   NUMBER(18,2),
  tas_int_compra      NUMBER(18,2),
  por_vip             NUMBER(4),
  mto_fij_pag_minimo  NUMBER(18,2),
  mto_min_pag_minimo  NUMBER(18,2),
  tas_int_mora        NUMBER(18,2),
  cod_sub_modalidad   NUMBER(3),
  nro_bin             NUMBER(10),
  est_verificacion    VARCHAR2(1),
  cod_tas_procard     NUMBER(3),
  lin_especial        NUMBER(18,6),
  env_email           VARCHAR2(1),
  cod_ent_procesadora NUMBER(5) default 7,
  tip_embozado        VARCHAR2(2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_SOLICITUDES
  is 'Contiene los datos de  la solicitud del titular ** No se borran los datos, es como el de propuesta de prestamo **';
comment on column IT.TA_SOLICITUDES.nro_solicitud
  is 'Numero de Solicitud.';
comment on column IT.TA_SOLICITUDES.cod_persona
  is 'Codigo de Cliente.';
comment on column IT.TA_SOLICITUDES.cod_oficina
  is 'Oficina.';
