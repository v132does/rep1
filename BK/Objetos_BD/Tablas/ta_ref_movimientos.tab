create table IT.TA_REF_MOVIMIENTOS
(
  cod_referencia      NUMBER(4) not null,
  descripcion         VARCHAR2(60) not null,
  cod_modulo          NUMBER(3),
  cod_modalidad       NUMBER(3),
  cod_transaccion     NUMBER(4),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  ref_archivo         VARCHAR2(30),
  cod_otr_modulo      NUMBER(3),
  cod_otr_modalidad   NUMBER(3),
  cod_otr_transaccion NUMBER(4),
  procesa             VARCHAR2(1),
  cod_modulo2         NUMBER(3),
  cod_modalidad2      NUMBER(3),
  cod_transaccion2    NUMBER(4),
  cod_modulo3         NUMBER(3),
  cod_modalidad3      NUMBER(3),
  cod_transaccion3    NUMBER(4),
  cod_modulo4         NUMBER(3),
  cod_modalidad4      NUMBER(3),
  cod_transaccion4    NUMBER(4)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_REF_MOVIMIENTOS.cod_referencia
  is 'Código de Referencia del Movimiento recibido de la Procesadora.';
comment on column IT.TA_REF_MOVIMIENTOS.descripcion
  is 'Descripción de la Referencia.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_modulo
  is 'Código de Modulo.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_modalidad
  is 'Código de Modalidad.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_transaccion
  is 'Código de Transacción asociada.';
comment on column IT.TA_REF_MOVIMIENTOS.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.TA_REF_MOVIMIENTOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.TA_REF_MOVIMIENTOS.usu_modificacion
  is 'Usuario que realizó la última modificación.';
comment on column IT.TA_REF_MOVIMIENTOS.fec_modificacion
  is 'Ultima fecha en que se modificó el registro.';
comment on column IT.TA_REF_MOVIMIENTOS.ref_archivo
  is 'Referencia del Archivo de importacion.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_otr_modulo
  is 'Código de Modulo de la segunda Transacción.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_otr_modalidad
  is 'Código de Modalidad de la segunda Transacción.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_otr_transaccion
  is 'Segundo Código de Transacción.';
comment on column IT.TA_REF_MOVIMIENTOS.procesa
  is 'Indica si el Movimiento se procesa o no (S/N).';
comment on column IT.TA_REF_MOVIMIENTOS.cod_modulo2
  is 'Código de Módulo 2 alternativo.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_modalidad2
  is 'Código de Modalidad 2 alternativa.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_transaccion2
  is 'Código de Transacción 2 alternativo.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_modulo3
  is 'Código de Módulo 3 alternativo.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_modalidad3
  is 'Código de Modalidad 3 alternativa.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_transaccion3
  is 'Código de Transacción 3 alternativo.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_modulo4
  is 'Código de Módulo 4 alternativo.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_modalidad4
  is 'Código de Modalidad 4 alternativa.';
comment on column IT.TA_REF_MOVIMIENTOS.cod_transaccion4
  is 'Código de Transacción 4 alternativo.';
alter table IT.TA_REF_MOVIMIENTOS
  add constraint PK_TA_REF_MOVIMIENTOS primary key (COD_REFERENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_REF_MOVIMIENTOS
  add constraint FK_REFMOV_COD_OTR_TRANSACCION foreign key (COD_OTR_TRANSACCION, COD_OTR_MODULO, COD_OTR_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.TA_REF_MOVIMIENTOS
  add constraint FK_REFMOV_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);

