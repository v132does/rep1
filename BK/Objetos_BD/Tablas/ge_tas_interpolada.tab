create table IT.GE_TAS_INTERPOLADA
(
  cod_tasa          NUMBER(3) not null,
  fec_vigencia      DATE not null,
  cod_oficina       NUMBER(3),
  cod_moneda        VARCHAR2(3),
  cod_modulo        NUMBER(3),
  cod_modalidad     NUMBER(3),
  nro_cuenta        VARCHAR2(15),
  val_hasta         NUMBER(18,2) not null,
  val_tasa          NUMBER(20,4),
  cod_sub_modalidad NUMBER(3),
  no_actualizable   VARCHAR2(1),
  val_extension     NUMBER(20,4),
  cod_persona       VARCHAR2(10),
  observaciones     VARCHAR2(100),
  fec_vencimiento   DATE,
  cod_ente          NUMBER(5),
  val_has_siguiente NUMBER(18,2),
  val_tas_siguiente NUMBER(20,4),
  val_tas_anterior  NUMBER(20,4),
  tip_moneda        VARCHAR2(2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_TAS_INTERPOLADA
  is 'Copia de Tasas por Rango tasas 777 y 778 para uso exclusivo de depositos internos (PAB_DEP).';
comment on column IT.GE_TAS_INTERPOLADA.cod_tasa
  is 'Codigo de tasa.';
comment on column IT.GE_TAS_INTERPOLADA.fec_vigencia
  is 'Fecha de vigencia.';
comment on column IT.GE_TAS_INTERPOLADA.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.GE_TAS_INTERPOLADA.cod_moneda
  is 'Moneda.';
comment on column IT.GE_TAS_INTERPOLADA.cod_modulo
  is 'Codigo del Modulo.';
comment on column IT.GE_TAS_INTERPOLADA.cod_modalidad
  is 'Codigo de la Modalidad.';
comment on column IT.GE_TAS_INTERPOLADA.nro_cuenta
  is 'Numero de cuenta a ser personalizada.';
comment on column IT.GE_TAS_INTERPOLADA.val_hasta
  is 'Valor hasta.';
comment on column IT.GE_TAS_INTERPOLADA.val_tasa
  is 'Valor de la tasa.';
comment on column IT.GE_TAS_INTERPOLADA.cod_sub_modalidad
  is 'Código de Sub Modalidad';
comment on column IT.GE_TAS_INTERPOLADA.no_actualizable
  is 'Indicador de Tasa no Actualizable por el proceso que calculo las tasas por moneda diferentes a la base.';
comment on column IT.GE_TAS_INTERPOLADA.val_extension
  is 'Valor de extension o Spread.';
comment on column IT.GE_TAS_INTERPOLADA.cod_persona
  is 'Codigo de la persona cuya tasa sera personalizada.';
comment on column IT.GE_TAS_INTERPOLADA.observaciones
  is 'Observaciones.';
comment on column IT.GE_TAS_INTERPOLADA.fec_vencimiento
  is 'Fecha de Vencimiento.';
comment on column IT.GE_TAS_INTERPOLADA.cod_ente
  is 'Código de Ente.';
comment on column IT.GE_TAS_INTERPOLADA.val_has_siguiente
  is 'Rango siguiente - valor hasta siguiente';
comment on column IT.GE_TAS_INTERPOLADA.val_tas_siguiente
  is 'Valor Tasa del rago siguiente';
comment on column IT.GE_TAS_INTERPOLADA.val_tas_anterior
  is 'Valor Anterior de la tasa.';
comment on column IT.GE_TAS_INTERPOLADA.tip_moneda
  is 'Tipo de Moneda - ML Moneda Local - ME Moneda Extranjera';
alter table IT.GE_TAS_INTERPOLADA
  add constraint UK_GE_TAS_RAN_INTERPOLACION unique (COD_TASA, FEC_VIGENCIA, COD_OFICINA, COD_MONEDA, COD_MODULO, COD_MODALIDAD, NRO_CUENTA, VAL_HASTA, COD_PERSONA, COD_SUB_MODALIDAD, COD_ENTE)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

