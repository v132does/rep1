-- Crear tabla para archivos de Entes Publicos
CREATE TABLE IT.SB_ENTES_PUBLICOS_ARCHIVOS (
    ID               NUMBER(10)      NOT NULL,
    NOMBRE_ARCHIVO   VARCHAR2(255)   NOT NULL,
    CONTENIDO_BLOB   BLOB            NOT NULL,
    -- Columnas de Auditoria
    USU_INSERCION    VARCHAR2(30)    NOT NULL,
    FEC_INSERCION    DATE            NOT NULL,
    USU_MODIFICACION VARCHAR2(30),
    FEC_MODIFICACION DATE,
    CONSTRAINT PK_SB_ENTES_PUBLICOS_ARCHIVOS PRIMARY KEY (ID)
)
LOGGING
TABLESPACE IT_DATA
PCTFREE 10
INITRANS 1
STORAGE (
    INITIAL    65536
    NEXT       1048576
    MINEXTENTS 1
    MAXEXTENTS UNLIMITED
    BUFFER_POOL DEFAULT
)
NOCOMPRESS
NO INMEMORY
NOPARALLEL;

COMMENT ON TABLE IT.SB_ENTES_PUBLICOS_ARCHIVOS
    IS 'Tabla que almacena archivos generados del proceso de Entes Publicos.';
COMMENT ON COLUMN IT.SB_ENTES_PUBLICOS_ARCHIVOS.ID
    IS 'Identificador unico del registro.';
COMMENT ON COLUMN IT.SB_ENTES_PUBLICOS_ARCHIVOS.NOMBRE_ARCHIVO
    IS 'Nombre del archivo generado.';
COMMENT ON COLUMN IT.SB_ENTES_PUBLICOS_ARCHIVOS.CONTENIDO_BLOB
    IS 'Contenido binario del archivo generado.';
COMMENT ON COLUMN IT.SB_ENTES_PUBLICOS_ARCHIVOS.USU_INSERCION
    IS 'Usuario que realizo la insercion del registro.';
COMMENT ON COLUMN IT.SB_ENTES_PUBLICOS_ARCHIVOS.FEC_INSERCION
    IS 'Fecha y hora de insercion del registro.';
COMMENT ON COLUMN IT.SB_ENTES_PUBLICOS_ARCHIVOS.USU_MODIFICACION
    IS 'Usuario que realizo la ultima modificacion del registro.';
COMMENT ON COLUMN IT.SB_ENTES_PUBLICOS_ARCHIVOS.FEC_MODIFICACION
    IS 'Fecha de la ultima modificacion del registro.';
	
-- =====================================================================
-- SINONIMOS PUBLICOS
-- =====================================================================

CREATE OR REPLACE PUBLIC SYNONYM SB_ENTES_PUBLICOS_ARCHIVOS
    FOR IT.SB_ENTES_PUBLICOS_ARCHIVOS;

CREATE OR REPLACE PUBLIC SYNONYM S_ID_ENTES_PUBLICOS_ARCHIVOS
    FOR IT.S_ID_ENTES_PUBLICOS_ARCHIVOS;

-- =====================================================================
-- GRANTS (Permisos segun estandares de la empresa)
-- =====================================================================

GRANT ALL ON IT.SB_ENTES_PUBLICOS_ARCHIVOS TO IT_TEMPORAL;
GRANT ALL ON IT.SB_ENTES_PUBLICOS_ARCHIVOS TO IT_CONSULTAS;
