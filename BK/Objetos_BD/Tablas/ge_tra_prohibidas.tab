create table IT.GE_TRA_PROHIBIDAS
(
  cod_transaccion  NUMBER(4) not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  nro_cuenta       VARCHAR2(15) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  observaciones    VARCHAR2(100),
  fec_vencimiento  DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_TRA_PROHIBIDAS
  is 'Contiene datos sobre las Transacciones Prohibidas de cuentas.';
comment on column IT.GE_TRA_PROHIBIDAS.cod_transaccion
  is 'Codigo de transaccion prohibida para la cuenta.';
comment on column IT.GE_TRA_PROHIBIDAS.cod_modulo
  is 'Codigo de modulo de la cuenta.';
comment on column IT.GE_TRA_PROHIBIDAS.cod_modalidad
  is 'Codigo de modalidad de la cuenta.';
comment on column IT.GE_TRA_PROHIBIDAS.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.GE_TRA_PROHIBIDAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_TRA_PROHIBIDAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_TRA_PROHIBIDAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_TRA_PROHIBIDAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_TRA_PROHIBIDAS.observaciones
  is 'Observaciones.';
comment on column IT.GE_TRA_PROHIBIDAS.fec_vencimiento
  is 'Fecha de Vencimiento.';
alter table IT.GE_TRA_PROHIBIDAS
  add constraint PK_GE_TRA_PROHIBIDAS primary key (NRO_CUENTA, COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 896K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_TRA_PROHIBIDAS
  add constraint FK_GTPRO_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_TRA_PROHIBIDAS
  add constraint FK_GTPRO_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_TRA_PROHIBIDAS
  add constraint FK_GTPRO_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

