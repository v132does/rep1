-- Create table
create table IT.GE_AUTORIZACIONES
(
  cod_autorizacion    NUMBER(10) not null,
  cod_usuario         VARCHAR2(10),
  fecha               DATE,
  hora                VARCHAR2(8),
  nro_secuencia       NUMBER(3),
  nro_cuenta          VARCHAR2(15),
  cod_tra_padre       NUMBER(4) not null,
  cod_mod_padre       NUMBER(3) not null,
  cod_mad_padre       NUMBER(3) not null,
  cod_transaccion     NUMBER(4),
  cod_modulo          NUMBER(3),
  cod_modalidad       NUMBER(3),
  valor               NUMBER(18,2) default 0,
  fec_vencimiento     DATE,
  cod_usu_utilizador  VARCHAR2(10),
  fec_utilizacion     DATE,
  hor_utilizacion     VARCHAR2(8),
  eximido             VARCHAR2(1) default 'N' not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  observacion         VARCHAR2(1000),
  cod_usu_autorizador VARCHAR2(10) not null,
  cod_moneda          VARCHAR2(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.GE_AUTORIZACIONES
  is 'Autorizaciones del Sistema. Contiene todas las autorizaciones ON-LINE o previas realizadas en el Sistema.';
-- Add comments to the columns 
comment on column IT.GE_AUTORIZACIONES.cod_autorizacion
  is 'Numero de autorizacion.';
comment on column IT.GE_AUTORIZACIONES.cod_usuario
  is 'Codigo de operador del movimiento.';
comment on column IT.GE_AUTORIZACIONES.fecha
  is 'Fecha del movimiento.';
comment on column IT.GE_AUTORIZACIONES.hora
  is 'Hora del movimiento.';
comment on column IT.GE_AUTORIZACIONES.nro_secuencia
  is 'Numero de secuencia.';
comment on column IT.GE_AUTORIZACIONES.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.GE_AUTORIZACIONES.cod_tra_padre
  is 'Codigo de transaccion padre.';
comment on column IT.GE_AUTORIZACIONES.cod_mod_padre
  is 'Codigo del modulo padre.';
comment on column IT.GE_AUTORIZACIONES.cod_mad_padre
  is 'Codigo de la modalidad padre.';
comment on column IT.GE_AUTORIZACIONES.cod_transaccion
  is 'Codigo de transaccion.';
comment on column IT.GE_AUTORIZACIONES.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_AUTORIZACIONES.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_AUTORIZACIONES.valor
  is 'Valor de autorizacion.';
comment on column IT.GE_AUTORIZACIONES.fec_vencimiento
  is 'Fecha de vencimiento.';
comment on column IT.GE_AUTORIZACIONES.cod_usu_utilizador
  is 'Codigo del usuario que utilizo la autorizacion.';
comment on column IT.GE_AUTORIZACIONES.fec_utilizacion
  is 'Fecha de utilizacion.';
comment on column IT.GE_AUTORIZACIONES.hor_utilizacion
  is 'Hora de utilizacion.';
comment on column IT.GE_AUTORIZACIONES.eximido
  is 'Eximido.';
comment on column IT.GE_AUTORIZACIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_AUTORIZACIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_AUTORIZACIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_AUTORIZACIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_AUTORIZACIONES.observacion
  is 'Observacion.';
comment on column IT.GE_AUTORIZACIONES.cod_usu_autorizador
  is 'Usuario autorizador.';
comment on column IT.GE_AUTORIZACIONES.cod_moneda
  is 'Codigo de la moneda.';
-- Create/Recreate indexes 
create index IT.IN_GAUTO_COD_MAD_PADRE on IT.GE_AUTORIZACIONES (COD_MAD_PADRE, COD_MODALIDAD, COD_MOD_PADRE, COD_MODULO, COD_MONEDA, COD_TRANSACCION, COD_USU_AUTORIZADOR)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GAUTO_COD_TRANSACCION on IT.GE_AUTORIZACIONES (NRO_CUENTA, COD_TRANSACCION, COD_MODULO, COD_MODALIDAD, COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE, COD_USU_UTILIZADOR, FEC_VENCIMIENTO)
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GAUTO_COD_USUARIO on IT.GE_AUTORIZACIONES (COD_USUARIO, FECHA, COD_USU_UTILIZADOR, COD_TRA_PADRE, VALOR)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GAUTO_NRO_CUENTA on IT.GE_AUTORIZACIONES (NRO_CUENTA, FECHA, COD_USU_UTILIZADOR, COD_TRA_PADRE, VALOR)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 256K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.GE_AUTORIZACIONES
  add constraint PK_GE_AUTORIZACIONES primary key (COD_AUTORIZACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_AUTORIZACIONES
  add constraint FK_GAUTO_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_AUTORIZACIONES
  add constraint FK_GAUTO_COD_TRANSACCION foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_AUTORIZACIONES
  add constraint FK_GAUTO_COD_TRA_PADRE foreign key (COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.GE_AUTORIZACIONES
  add constraint FK_GAUTO_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_AUTORIZACIONES
  add constraint FK_GAUTO_COD_USU_AUTORIZADOR foreign key (COD_USU_AUTORIZADOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_AUTORIZACIONES
  add constraint FK_GAUTO_COD_USU_UTILIZADOR foreign key (COD_USU_UTILIZADOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_AUTORIZACIONES
  add constraint FK_GAUTO_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA)
  disable
  novalidate;
-- Create/Recreate check constraints 
alter table IT.GE_AUTORIZACIONES
  add constraint AVCON_1097596878_COD_M_002
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_AUTORIZACIONES
  add constraint AVCON_1097596878_COD_M_003
  check (COD_MODALIDAD BETWEEN 0 AND 999);
