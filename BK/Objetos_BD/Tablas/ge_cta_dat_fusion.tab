-- create table
create table it.ge_cta_dat_fusion
(
  nro_cuenta       varchar2(30) not null,
  nro_documento    varchar2(30) ,
  nom_cliente      varchar2(120),
  cod_moneda       varchar2(3),
  cod_modulo       number(3) not null,
  cod_modalidad    number(3) ,
  cod_mad_destino  number(3) not null,
  sal_capital      number(18,2) ,
  sal_interes      number(18,2) ,
  val_int_devengar number(18,2) ,
  dev_suspenso     number(18,2) ,
  dev_no_cobrado   number(18,2) ,
  tot_deu_real     number(18,2) ,
  tot_prevision    number(18,2) ,
  mto_pre_total    number(18,2) ,
  dia_atraso       number(5),
  fec_inicio       date, 
  fec_vencimiento  date,
  cartera          varchar2(100) ,
  procesado        varchar2(1) default 'N'

)
tablespace it_data
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64k
    next 1m
    minextents 1
    maxextents unlimited
  );

-- create/recreate indexes 
create index it.in_gcda_parametro_fusion on it.ge_cta_dat_fusion (nro_cuenta ,cod_modulo)
  tablespace it_ind
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64k
    next 1m
    minextents 1
    maxextents unlimited
  );

-- create/recreate primary, unique and foreign key constraints 
alter table it.ge_cta_dat_fusion
  add constraint pk_ge_cta_dat_fusion primary key (nro_cuenta)
  using index 
  tablespace it_ind
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2m
    next 1m
    minextents 1
    maxextents unlimited
  );

-- grant/revoke object privileges 
grant select, insert, update, delete on it.ge_cta_dat_fusion to it_temporal;
