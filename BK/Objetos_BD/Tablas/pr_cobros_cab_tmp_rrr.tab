-- Create table
create table IT.PR_COBROS_CAB_TMP_RRR
(
  cod_clave        NUMBER(8) not null,
  cod_persona      VARCHAR2(10) not null,
  fec_valor        DATE not null,
  nro_solicitud    NUMBER(8),
  mto_descuento    NUMBER(18,2) default 0,
  mto_cargo        NUMBER(18,2) default 0,
  mto_entrega      NUMBER(18,2) default 0,
  tip_renovacion   VARCHAR2(1),
  tip_amortizacion VARCHAR2(1),
  fec_negociacion  DATE,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not NULL
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.PR_COBROS_CAB_TMP_RRR
  is 'Se utiliza para simulación de los cobros para cálculos temporales de préstamos a Renovar(RRR)';
-- Add comments to the columns 
comment on column IT.PR_COBROS_CAB_TMP_RRR.cod_persona
  is 'Código de Persona.';
comment on column IT.PR_COBROS_CAB_TMP_RRR.fec_valor
  is 'Fecha valor del cobro.';
comment on column IT.PR_COBROS_CAB_TMP_RRR.nro_solicitud
  is 'Número de Solicitud del nuevo préstamo.';  
comment on column IT.PR_COBROS_CAB_TMP_RRR.mto_entrega
  is 'Monto de entrega';
comment on column IT.PR_COBROS_CAB_TMP_RRR.mto_descuento
  is 'Monto descuento.';
comment on column IT.PR_COBROS_CAB_TMP_RRR.mto_cargo
  is 'Monto de cargos a pagar.';
comment on column IT.PR_COBROS_CAB_TMP_RRR.tip_renovacion
  is 'Tipo Renovación.';
comment on column IT.PR_COBROS_CAB_TMP_RRR.tip_amortizacion
  is 'Tipo amortización.';
comment on column IT.PR_COBROS_CAB_TMP_RRR.fec_negociacion
  is 'Fecha Negociación';
comment on column IT.PR_COBROS_CAB_TMP_RRR.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_COBROS_CAB_TMP_RRR.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_COBROS_CAB_TMP_RRR.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_COBROS_CAB_TMP_RRR.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';

-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.PR_COBROS_CAB_TMP_RRR
  add constraint PK_PR_COBROS_CAB_TMP_RRR primary key (COD_CLAVE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
