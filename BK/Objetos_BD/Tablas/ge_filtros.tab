create table IT.GE_FILTROS
(
  cod_campo         VARCHAR2(10) not null,
  descripcion       VARCHAR2(50) not null,
  tip_campo         VARCHAR2(1) not null,
  lon_campo         NUMBER(3) not null,
  tip_dato          VARCHAR2(1) not null,
  val_max_permitido VARCHAR2(15),
  val_min_permitido VARCHAR2(15),
  nom_tab_asociada  VARCHAR2(20),
  nom_referencia    VARCHAR2(100),
  nro_orden         NUMBER(3),
  det_sql           VARCHAR2(2000),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  observacion       VARCHAR2(100),
  tipo              VARCHAR2(1) default 'G' not null,
  afe_segmentacion  VARCHAR2(1) default 'N',
  afe_puntuacion    VARCHAR2(1) default 'N',
  afe_reportes      VARCHAR2(1) default 'N',
  afe_consultas     VARCHAR2(1) default 'N',
  afe_reclamos      VARCHAR2(1) default 'N',
  tip_sol_igual     VARCHAR2(1) default 'N',
  permiso           VARCHAR2(2000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_FILTROS
  is 'Campos de parametros para listas de valores.';
comment on column IT.GE_FILTROS.cod_campo
  is 'Codigo del campo.';
comment on column IT.GE_FILTROS.descripcion
  is 'Descripcion del campo.';
comment on column IT.GE_FILTROS.tip_campo
  is 'Tipo de campo:N=Numerico,F=Fecha,S=String.';
comment on column IT.GE_FILTROS.lon_campo
  is 'Longitud del campo.';
comment on column IT.GE_FILTROS.tip_dato
  is 'Tipo de dato: V=Valor, R=Rango, M=Multiple.';
comment on column IT.GE_FILTROS.val_max_permitido
  is 'Valor maximo permitido.';
comment on column IT.GE_FILTROS.val_min_permitido
  is 'Valor minimo permitido.';
comment on column IT.GE_FILTROS.nom_tab_asociada
  is 'Nombre de Tabla asociada.';
comment on column IT.GE_FILTROS.nom_referencia
  is 'Nombre de funcion o campo de tabla.';
comment on column IT.GE_FILTROS.nro_orden
  is 'Nro de orden.';
comment on column IT.GE_FILTROS.det_sql
  is 'Detalle del sql o lista fija.';
comment on column IT.GE_FILTROS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_FILTROS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_FILTROS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_FILTROS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_FILTROS.observacion
  is 'Observacion sobre el filtro.';
comment on column IT.GE_FILTROS.tipo
  is 'Tipo de Filtro: G=General, C=Segmentacion, S=Scoring, R=Reportes, D=Consultas Dinamicas.';
comment on column IT.GE_FILTROS.afe_segmentacion
  is 'Indica si el filtro puede ser utilizado en Segmentacion de clientes.';
comment on column IT.GE_FILTROS.afe_puntuacion
  is 'Indica si el filtro puede ser utilizado en el scoring(puntuacion).';
comment on column IT.GE_FILTROS.afe_reportes
  is 'Indica si el filtro puede ser utilizado en parametros de reportes.';
comment on column IT.GE_FILTROS.afe_consultas
  is 'Indica el el filtro puede ser utilizado en consultas dinamicas.';
comment on column IT.GE_FILTROS.afe_reclamos
  is 'Indica el el filtro puede ser utilizado en Reclamos.';
comment on column IT.GE_FILTROS.tip_sol_igual
  is 'Tipo de Solicitud Igual.';
comment on column IT.GE_FILTROS.permiso
  is 'Roles a quienes se da permiso.';
alter table IT.GE_FILTROS
  add constraint PK_GE_PAR_FILTROS primary key (COD_CAMPO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_FILTROS
  add constraint AVCON_1181079427_AFE_R_000
  check (AFE_RECLAMOS IN ('S', 'N'));
alter table IT.GE_FILTROS
  add constraint AVCON_1181079427_TIP_S_000
  check (TIP_SOL_IGUAL IN ('S', 'N'));

