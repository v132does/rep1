CREATE TABLE IT.GE_EXT_UPD_TBL_MAESTRAS (
   PRIORIDAD NUMBER,
   COD_PERSONA VARCHAR2(10 BYTE),
   NRO_CUENTA VARCHAR2(15 BYTE),
   COD_MODULO NUMBER(3, 0),
   COD_MODALIDAD NUMBER(3, 0),
   NOM_TABLA VARCHAR2(25 BYTE),
   FEC_ULT_EXTRACTO DATE,
   SAL_ULT_EXTRACTO NUMBER(18, 2),
   NRO_FOLIO NUMBER(7, 0),
   ESTADO VARCHAR2(1 BYTE),
   TRAZA VARCHAR2(500 BYTE),
   FEC_INSERCION DATE,
   USU_INSERCION VARCHAR2(20 BYTE),
   FEC_MODIFICACION DATE,
   USU_MODIFICACION VARCHAR2(20 BYTE)
)
tablespace IT_DATA
pctfree 10
initrans 1
maxtrans 255
storage
(
  initial 64K
  next 1M
  minextents 1
  maxextents unlimited
);

CREATE INDEX IN_GMAES_NOM_TABLA ON IT.GE_EXT_UPD_TBL_MAESTRAS (NOM_TABLA ASC);

CREATE PUBLIC SYNONYM GE_EXT_UPD_TBL_MAESTRAS FOR IT.GE_EXT_UPD_TBL_MAESTRAS;
      
COMMENT ON TABLE GE_EXT_UPD_TBL_MAESTRAS IS 'Tabla de actualización de Tablas Maestras';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.PRIORIDAD IS 'Prioridad asignada al Cliente';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.COD_PERSONA IS 'Código de la Persona';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.NRO_CUENTA IS 'Número de Cuenta';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.COD_MODULO IS 'Código de modulo de la Cuenta';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.COD_MODALIDAD IS 'Código de modalidad de la Cuenta';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.NOM_TABLA IS 'Nombre de Tabla Maestra a actualizar';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.FEC_ULT_EXTRACTO IS 'Fecha de último extracto';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.SAL_ULT_EXTRACTO IS 'Saldo de último extracto';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.NRO_FOLIO IS 'Número de folio';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.ESTADO IS 'Estado del Registro a actualizar';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.TRAZA IS 'Comentario';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.FEC_INSERCION IS 'Fecha en que se inserto el registro';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.USU_INSERCION IS 'Usuario que realizo la insercion del registro';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.FEC_MODIFICACION IS 'Fecha en que se realizo la ultima modificacion en el registro';

COMMENT ON COLUMN GE_EXT_UPD_TBL_MAESTRAS.USU_MODIFICACION IS 'Usuario que realizo la ultima modificacion en el registro';

GRANT SELECT, INSERT, UPDATE, DELETE ON GE_EXT_UPD_TBL_MAESTRAS TO IT_TEMPORAL;