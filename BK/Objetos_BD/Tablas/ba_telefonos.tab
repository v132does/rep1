create table IT.BA_TELEFONOS
(
  cod_persona      VARCHAR2(10) not null,
  tipo             VARCHAR2(1) not null,
  tip_linea        VARCHAR2(1) default 'B' not null,
  telefono         VARCHAR2(16) not null,
  principal        VARCHAR2(1) default 'N' not null,
  area             VARCHAR2(10),
  interno          VARCHAR2(5),
  observacion      VARCHAR2(1000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cod_telefono     NUMBER(3) not null,
  sms_habilitado   VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 50
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_TELEFONOS
  is 'Telefonos.';
comment on column IT.BA_TELEFONOS.cod_persona
  is 'Codigo de la Persona.';
comment on column IT.BA_TELEFONOS.tipo
  is 'Tipo de telefono (L=Laboral / P= Particular).';
comment on column IT.BA_TELEFONOS.tip_linea
  is 'Tipo de Linea telefonica.';
comment on column IT.BA_TELEFONOS.telefono
  is 'Numero de Telefono.';
comment on column IT.BA_TELEFONOS.principal
  is 'Indica si el telefono es default (S=SI / N=NO).';
comment on column IT.BA_TELEFONOS.area
  is 'Codigo de Area del Numero de Telefono.';
comment on column IT.BA_TELEFONOS.interno
  is 'Numero de Interno.';
comment on column IT.BA_TELEFONOS.observacion
  is 'Observacion.';
comment on column IT.BA_TELEFONOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_TELEFONOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_TELEFONOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_TELEFONOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.BA_TELEFONOS.cod_telefono
  is 'Codigo de telefono.';
comment on column IT.BA_TELEFONOS.sms_habilitado
  is 'Si el número esta habilitado para envio de SMS.';
create index IT.IN_BA_PER_NRO_TELEFONO on IT.BA_TELEFONOS (AREA, TELEFONO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 8K
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BA_PERSONA on IT.BA_TELEFONOS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BA_TELEFONOS on IT.BA_TELEFONOS (TO_NUMBER(COD_PERSONA))
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_TELEFONOS
  add constraint PK_BA_TELEFONOS primary key (COD_PERSONA, COD_TELEFONO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 5M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_TELEFONOS
  add constraint UK_ETELE_TELEFONO unique (COD_PERSONA, TIPO, TIP_LINEA, AREA, TELEFONO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 7M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_TELEFONOS
  add constraint FK_ETELE_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.BA_TELEFONOS
  add constraint AVCON_1080842839_PRINC_000
  check (PRINCIPAL IN ('S', 'N'));
alter table IT.BA_TELEFONOS
  add constraint AVCON_1083071473_COD_T_000
  check (COD_TELEFONO BETWEEN 0 AND 999);

