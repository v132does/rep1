create table IT.RH_TIP_IDIOMAS
(
  cod_tip_idioma   NUMBER(3) not null,
  descripcion      VARCHAR2(40) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.RH_TIP_IDIOMAS
  is 'ABM de mantenimiento de tipos de idiomas.';
comment on column IT.RH_TIP_IDIOMAS.cod_tip_idioma
  is 'Codigo del tipo de idioma.';
comment on column IT.RH_TIP_IDIOMAS.descripcion
  is 'Descripcion del idioma.';
comment on column IT.RH_TIP_IDIOMAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.RH_TIP_IDIOMAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.RH_TIP_IDIOMAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion del registro.';
comment on column IT.RH_TIP_IDIOMAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.RH_TIP_IDIOMAS
  add constraint PK_RH_TIP_IDIOMAS primary key (COD_TIP_IDIOMA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.RH_TIP_IDIOMAS
  add constraint UK_HTIDI_DESCRIPCION unique (DESCRIPCION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

