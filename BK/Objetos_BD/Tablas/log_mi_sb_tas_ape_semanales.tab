create table IT.LOG_MI_SB_TAS_APE_SEMANALES
(
  fecha_proceso DATE not null,
  error         VARCHAR2(1000),
  mensaje       VARCHAR2(50)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.LOG_MI_SB_TAS_APE_SEMANALES
  is 'Log de la generación del informe Tasas Activas y Pasivas.';

