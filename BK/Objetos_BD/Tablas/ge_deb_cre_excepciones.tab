create table IT.GE_DEB_CRE_EXCEPCIONES
(
  fecha             DATE not null,
  hora              VARCHAR2(8) not null,
  cod_usuario       VARCHAR2(10) not null,
  nro_secuencia     NUMBER(8) not null,
  cod_deb_cre_batch NUMBER(3) not null,
  nro_cuenta        VARCHAR2(15),
  cod_moneda        VARCHAR2(4),
  sal_disponible    NUMBER(18,2),
  mto_operacion     NUMBER(18,2),
  cod_tra_padre     NUMBER(4),
  mensaje           VARCHAR2(4000) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_DEB_CRE_EXCEPCIONES
  is 'Excepciones de Procesos de Debitos y Creditos en Batch';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.fecha
  is 'Fecha de proceso del Debito o Credito Batch.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.hora
  is 'Hora de proceso.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.cod_usuario
  is 'Usuario que realizo el proceso.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.nro_secuencia
  is 'Numero de secuencia.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.cod_deb_cre_batch
  is 'Codigo del Debito o Credito en Batch.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.nro_cuenta
  is 'Numero de Cuenta.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.cod_moneda
  is 'Codigo de Moneda de la cuenta.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.sal_disponible
  is 'Saldo Disponible de la cuenta al momento del proceso.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.mto_operacion
  is 'Monto del Debito / Credito.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.cod_tra_padre
  is 'Codigo de la Transaccion Padre del movimiento.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.mensaje
  is 'Mensaje.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_DEB_CRE_EXCEPCIONES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.FK_GDCEX_COD_DEB_CRE_BATCH on IT.GE_DEB_CRE_EXCEPCIONES (COD_DEB_CRE_BATCH)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_DEB_CRE_EXCEPCIONES
  add constraint FK_GDCEX_COD_DEB_CRE_BATCH foreign key (COD_DEB_CRE_BATCH)
  references IT.GE_DEB_CRE_BATCH (COD_DEB_CRE_BATCH);

