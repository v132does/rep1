create table IT.BA_DAT_ATM
(
  cod_persona      VARCHAR2(10) not null,
  tipo             VARCHAR2(1) not null,
  valor            VARCHAR2(100) not null,
  actualizado      VARCHAR2(1),
  fecha            DATE,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion    DATE default sysdate,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion DATE default sysdate
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BA_DAT_ATM
  add constraint PK_BA_DAT_ATM primary key (COD_PERSONA, VALOR, TIPO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

