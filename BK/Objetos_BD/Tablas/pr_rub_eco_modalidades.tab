create table IT.PR_RUB_ECO_MODALIDADES
(
  cod_modulo        NUMBER(3) not null,
  cod_modalidad     NUMBER(3) not null,
  cod_rub_economico VARCHAR2(6) not null,
  referencia        NUMBER(3) not null,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.PR_RUB_ECO_MODALIDADES.cod_modulo
  is 'Código de Módulo.';
comment on column IT.PR_RUB_ECO_MODALIDADES.cod_modalidad
  is 'Código de Modalidad.';
comment on column IT.PR_RUB_ECO_MODALIDADES.cod_rub_economico
  is 'Código de Rubro Económico.';
comment on column IT.PR_RUB_ECO_MODALIDADES.referencia
  is 'Código de Referencia.';
comment on column IT.PR_RUB_ECO_MODALIDADES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_RUB_ECO_MODALIDADES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_RUB_ECO_MODALIDADES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_RUB_ECO_MODALIDADES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_PREMO_REFERENCIA on IT.PR_RUB_ECO_MODALIDADES (REFERENCIA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 1M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_RUB_ECO_MODALIDADES
  add constraint PK_PR_RUB_ECO_MODALIDADES primary key (COD_MODULO, COD_MODALIDAD, COD_RUB_ECONOMICO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_RUB_ECO_MODALIDADES
  add constraint FK_PREMO_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.PR_RUB_ECO_MODALIDADES
  add constraint FK_PREMO_COD_RUB_ECONOMICO foreign key (COD_RUB_ECONOMICO)
  references IT.PR_RUB_ECONOMICOS (COD_RUB_ECONOMICO);
alter table IT.PR_RUB_ECO_MODALIDADES
  add constraint FK_PREMO_REFERENCIA foreign key (REFERENCIA)
  references IT.PR_SEC_CREDITOS (COD_SEC_CREDITO);

