create table IT.GE_BLOQUEOS
(
  nro_cuenta       VARCHAR2(15) not null,
  fec_inicio       DATE not null,
  nro_documento    NUMBER(15) not null,
  cod_causa        NUMBER(3) not null,
  monto            NUMBER(18,2) default 0,
  hor_inicio       VARCHAR2(8) not null,
  fec_fin          DATE,
  tipo             VARCHAR2(1) not null,
  observacion      VARCHAR2(250),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  cotizacion       NUMBER(14,8),
  mto_equivalente  NUMBER(18,2) default 0,
  tip_bloqueo      VARCHAR2(1) default 'M'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_BLOQUEOS
  is 'Contiene datos de Bloqueos de Cuenta.';
comment on column IT.GE_BLOQUEOS.nro_cuenta
  is 'Numero de cuenta.';
comment on column IT.GE_BLOQUEOS.fec_inicio
  is 'Fecha de inicio del bloqueo.';
comment on column IT.GE_BLOQUEOS.nro_documento
  is 'Numero de documento.';
comment on column IT.GE_BLOQUEOS.cod_causa
  is 'Codigo de causa de bloqueo.';
comment on column IT.GE_BLOQUEOS.monto
  is 'Valor bloqueado.';
comment on column IT.GE_BLOQUEOS.hor_inicio
  is 'Hora del bloqueo.';
comment on column IT.GE_BLOQUEOS.fec_fin
  is 'Fecha final del bloqueo.';
comment on column IT.GE_BLOQUEOS.tipo
  is 'Tipo de Bloqueo (S=Saldo, D=Debito, T=Total).';
comment on column IT.GE_BLOQUEOS.observacion
  is 'Observacion.';
comment on column IT.GE_BLOQUEOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_BLOQUEOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_BLOQUEOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_BLOQUEOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_BLOQUEOS.cotizacion
  is 'Cotizacion.';
comment on column IT.GE_BLOQUEOS.mto_equivalente
  is 'Monto Equivalente.';
comment on column IT.GE_BLOQUEOS.tip_bloqueo
  is 'Tipo de Bloqueo (M)anual (A)utomatico.';
create index IT.IN_GBLOQ_COD_CAUSA on IT.GE_BLOQUEOS (COD_CAUSA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_BLOQUEOS
  add constraint PK_GE_BLOQUEOS primary key (NRO_CUENTA, FEC_INICIO, NRO_DOCUMENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_BLOQUEOS
  add constraint FK_GBLOQ_COD_CAUSA foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.GE_BLOQUEOS
  add constraint FK_GBLOQ_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.GE_BLOQUEOS
  add constraint AVCON_1092687882_COD_C_000
  check (COD_CAUSA BETWEEN 0 AND 999);
alter table IT.GE_BLOQUEOS
  add constraint AVCON_1121295395_TIP_B_000
  check (TIP_BLOQUEO IN ('M', 'A'));

