create table IT.GE_CTA_INF_COMPLEMENTARIA
(
  fecha            DATE default SYSDATE not null,
  cod_usuario      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  nro_cuenta       VARCHAR2(15) not null,
  informacion      VARCHAR2(3000) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CTA_INF_COMPLEMENTARIA
  is 'Información Complementaria de Cuentas.';
comment on column IT.GE_CTA_INF_COMPLEMENTARIA.fecha
  is 'Fecha en que se agregó la información.';
comment on column IT.GE_CTA_INF_COMPLEMENTARIA.cod_usuario
  is 'Usuario que agregó la información.';
comment on column IT.GE_CTA_INF_COMPLEMENTARIA.nro_cuenta
  is 'Cuenta a la cual se agregó la información.';
comment on column IT.GE_CTA_INF_COMPLEMENTARIA.informacion
  is 'Información Agregada a la cuenta.';
comment on column IT.GE_CTA_INF_COMPLEMENTARIA.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CTA_INF_COMPLEMENTARIA.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CTA_INF_COMPLEMENTARIA.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CTA_INF_COMPLEMENTARIA.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.GE_CTA_INF_COMPLEMENTARIA
  add constraint FK_GCINFC_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

