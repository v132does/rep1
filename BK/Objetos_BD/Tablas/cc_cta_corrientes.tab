alter table IT.CC_CTA_CORRIENTES
  add constraint PK_CC_CTA_CORRIENTES primary key (NRO_CUENTA);
alter table IT.CC_CTA_CORRIENTES
  add constraint FD_CCCOR_COD_CAU_CANCELACION foreign key (COD_CAU_CANCELACION)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.CC_CTA_CORRIENTES
  add constraint FK_CCCOR_COD_BANCO foreign key (COD_BANCO)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.CC_CTA_CORRIENTES
  add constraint FK_CCCOR_COD_CAMPANA foreign key (COD_CAMPANA)
  references IT.CR_CAMPANAS (COD_CAMPANA);
alter table IT.CC_CTA_CORRIENTES
  add constraint FK_CCCOR_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.CC_CTA_CORRIENTES
  add constraint FK_CCCOR_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.CC_CTA_CORRIENTES
  add constraint FK_CCCOR_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CC_CTA_CORRIENTES
  add constraint FK_CCCOR_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CC_CTA_CORRIENTES
  add constraint FK_CCCOR_COD_SUB_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD)
  references IT.GE_SUB_MODALIDADES (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD);
alter table IT.CC_CTA_CORRIENTES
  add constraint FK_CCCOR_COD_USU_PROMOTOR foreign key (COD_USU_PROMOTOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.CC_CTA_CORRIENTES
  add constraint FK_CCCOR_ESTADO foreign key (COD_MODULO, COD_MODALIDAD, ESTADO)
  references IT.GE_EST_CUENTAS (COD_MODULO, COD_MODALIDAD, ESTADO);
alter table IT.CC_CTA_CORRIENTES
  add constraint FK_CCCOR_EST_BATCH foreign key (COD_MODULO, COD_MODALIDAD, EST_BATCH)
  references IT.GE_EST_CUENTAS (COD_MODULO, COD_MODALIDAD, ESTADO);
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1081868033_AUT_P_000
  check (AUT_PENDIENTE IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1092358390_COD_C_001
  check (COD_CANAL BETWEEN 0 AND 999);
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1092358390_COD_C_002
  check (COD_CAMPANA BETWEEN 0 AND 999);
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1092358390_COD_M_011
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1092358390_COD_M_012
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1092358390_COD_O_001
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1092358390_CTA_C_000
  check (CTA_COMBINADA IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1092358390_RET_P_000
  check (RET_PERSONALIZADA IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1092358390_TAS_P_000
  check (TAS_PERSONALIZADA IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1092358390_TRA_P_000
  check (TRA_PROHIBIDA IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1101745716_ACU_S_000
  check (ACU_SOBREGIRO IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1101745716_FRE_E_000
  check (FRE_EXTRACTO IN ('M', 'S', 'Q', 'D', 'm', 'q', 's', 'd'));
alter table IT.CC_CTA_CORRIENTES
  add constraint AVCON_1122068496_EN_JU_000
  check (EN_JUICIO IN ('S', 'N'));
alter table IT.CC_CTA_CORRIENTES
  add constraint CK_CCCOR_SAL_BLOQUEADO
  check (NVL(SAL_BLOQUEADO,0) >= 0);
alter table IT.CC_CTA_CORRIENTES
  add constraint CK_CCCOR_SAL_RETENIDO
  check (NVL(SAL_RETENIDO,0) >= 0);

