create table IT.AH_CTA_BANCOS
(
  cod_banco        NUMBER(3) not null,
  nro_cuenta       VARCHAR2(15) not null,
  cod_moneda       VARCHAR2(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AH_CTA_BANCOS
  is 'Cuentas de Bancos del Pais (Numero de Cuenta para transacciones de Infonet).';
comment on column IT.AH_CTA_BANCOS.cod_banco
  is 'Codigo del Banco.';
comment on column IT.AH_CTA_BANCOS.nro_cuenta
  is 'Numero de Cuenta para conciliacion.';
comment on column IT.AH_CTA_BANCOS.cod_moneda
  is 'Moneda.';
comment on column IT.AH_CTA_BANCOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.AH_CTA_BANCOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.AH_CTA_BANCOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.AH_CTA_BANCOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_ACTBA_NRO_CUENTA on IT.AH_CTA_BANCOS (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AH_CTA_BANCOS
  add constraint PK_AH_CTA_BANCOS primary key (COD_BANCO, NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AH_CTA_BANCOS
  add constraint FK_ACTBA_COD_BANCO foreign key (COD_BANCO)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.AH_CTA_BANCOS
  add constraint FK_ACTBA_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.AH_CTA_BANCOS
  add constraint AVCON_1080844426_COD_B_001
  check (COD_BANCO BETWEEN 1 AND 999);

