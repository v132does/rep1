create table IT.LC_DEVENGADOS_ANT
(
  nro_cuenta          VARCHAR2(15) not null,
  fecha               DATE not null,
  cod_modulo          NUMBER(3) not null,
  cod_modalidad       NUMBER(3) not null,
  cod_moneda          VARCHAR2(3) not null,
  cod_oficina         NUMBER(3) not null,
  nro_operacion       NUMBER(7) not null,
  estado              VARCHAR2(1) not null,
  val_tasa            NUMBER(20,4) not null,
  can_dia_interes     NUMBER(6) not null,
  mto_interes         NUMBER(18,2) default 0 not null,
  sal_acumulado       NUMBER(18,2) default 0 not null,
  mto_dev_anterior    NUMBER(18,2),
  mto_dev_acumulado   NUMBER(18,2) not null,
  cod_mad_transaccion NUMBER(3) not null,
  cod_mad_padre       NUMBER(3) not null,
  cod_ofi_origen      NUMBER(3) not null,
  descuento           VARCHAR2(1) default 'N' not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.LC_DEVENGADOS_ANT
  is 'Contiene los datos sobre los Intereses Devengados por Operaciones de Cambios a futuro al cierre del dia anterior';
comment on column IT.LC_DEVENGADOS_ANT.nro_cuenta
  is 'Numero de cuenta de Cambios.';
comment on column IT.LC_DEVENGADOS_ANT.fecha
  is 'Fecha de devengamiento.';
comment on column IT.LC_DEVENGADOS_ANT.cod_modulo
  is 'Codigo del modulo de la cuenta de cambios.';
comment on column IT.LC_DEVENGADOS_ANT.cod_modalidad
  is 'Codigo de modalidad de la cuenta de cambios.';
comment on column IT.LC_DEVENGADOS_ANT.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.LC_DEVENGADOS_ANT.cod_oficina
  is 'Codigo de la oficina de la cuenta de cambios.';
comment on column IT.LC_DEVENGADOS_ANT.nro_operacion
  is 'Nimero de operacion relacionada.';
comment on column IT.LC_DEVENGADOS_ANT.estado
  is 'Estado de la operacion (M/C).';
comment on column IT.LC_DEVENGADOS_ANT.val_tasa
  is 'Valor de la tasa aplicado.';
comment on column IT.LC_DEVENGADOS_ANT.can_dia_interes
  is 'Cantidad de dias del interes.';
comment on column IT.LC_DEVENGADOS_ANT.mto_interes
  is 'Interes devengado calculado.';
comment on column IT.LC_DEVENGADOS_ANT.sal_acumulado
  is 'Acumulado del saldo.';
comment on column IT.LC_DEVENGADOS_ANT.mto_dev_anterior
  is 'Interes devengado anterior.';
comment on column IT.LC_DEVENGADOS_ANT.mto_dev_acumulado
  is 'Devengamiento Acumulado.';
comment on column IT.LC_DEVENGADOS_ANT.cod_mad_transaccion
  is 'Codigo de la modalidad hija(compra o venta).';
comment on column IT.LC_DEVENGADOS_ANT.cod_mad_padre
  is 'Codigo de la modalidad padre(Op.futura o Swap).';
comment on column IT.LC_DEVENGADOS_ANT.cod_ofi_origen
  is 'Codigo de la oficina origen de la operacion.';
comment on column IT.LC_DEVENGADOS_ANT.descuento
  is 'Es un descuento (S/N).Indica si la op. tiene ganancia o perdida. (S=SI / N= NO).';
comment on column IT.LC_DEVENGADOS_ANT.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.LC_DEVENGADOS_ANT.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.LC_DEVENGADOS_ANT.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.LC_DEVENGADOS_ANT.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.LC_DEVENGADOS_ANT
  add constraint PK_LC_DEVENGADOS_ANT primary key (NRO_CUENTA, FECHA, NRO_OPERACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_DEVENGADOS_ANT
  add constraint FK_LDEVA_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.LC_DEVENGADOS_ANT
  add constraint FK_LDEVA_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.LC_DEVENGADOS_ANT
  add constraint FK_LDEVA_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.LC_DEVENGADOS_ANT
  add constraint FK_LDEVA_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.LC_CTA_CAMBIOS (NRO_CUENTA);

