create table IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS
(
  nro_transaccion               VARCHAR2(4000) not null,
  fec_sistema                   DATE not null,
  confirmacion_reintegro        NUMBER(1) null,
  fecha_proceso                 DATE,  
  usu_insercion                 VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion                 DATE default SYSDATE not null,
  usu_modificacion              VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion              DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

alter table IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS
add primary key (nro_transaccion)
using index
tablespace IT_DATA
pctfree 10
initrans 2
maxtrans 255
storage
(
  initial 64K
  next 1M
  minextents 1
  maxextents unlimited
);

comment on table IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS
  is 'BENEFICIOS - CJ_LOG_GLO_PRO procesados';
comment on column IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS.nro_transaccion
  is 'Identificadfor de la operacion';
comment on column IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS.fec_sistema
  is 'Fecha de la transaccion';
comment on column IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS.confirmacion_reintegro
  is 'Confirmacion reintegro';
comment on column IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS.fecha_proceso
  is 'Fecha de proceso';
comment on column IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

  -- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.CJ_LOG_GLO_PRO_BENEFICIOS_HIS to IT_TEMPORAL;