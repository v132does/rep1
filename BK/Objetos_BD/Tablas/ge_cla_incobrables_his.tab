create table IT.GE_CLA_INCOBRABLES_HIS
(
  fecha                 DATE not null,
  cod_persona           VARCHAR2(10) not null,
  nro_cuenta            VARCHAR2(15) not null,
  cod_modulo            NUMBER(3) not null,
  cod_modalidad         NUMBER(3) not null,
  cod_estado            VARCHAR2(1) not null,
  tot_deu_real          NUMBER(18,2) default 0,
  tot_deu_contingente   NUMBER(18,2) default 0,
  dev_no_cobrado        NUMBER(18,2) default 0,
  cat_automatica        NUMBER(3,2),
  dia_atraso            NUMBER(5) not null,
  cod_moneda            VARCHAR2(3) not null,
  tot_gar_computables   NUMBER(18,2) default 0,
  cod_oficina           NUMBER(3),
  tipo                  VARCHAR2(1) not null,
  tot_prevision         NUMBER(18,2) default 0,
  mto_original          NUMBER(18,2) default 0,
  tip_destino           NUMBER(2),
  cod_sec_credito       NUMBER(3),
  usu_insercion         VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion         DATE default SYSDATE not null,
  usu_modificacion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion      DATE default SYSDATE not null,
  cat_renovaciones      NUMBER(3,2),
  cat_ren_anterior      NUMBER(3,2),
  lib_prevision         VARCHAR2(1),
  tot_pri_prevision     NUMBER(18,2),
  cod_rub_economico     VARCHAR2(6),
  tot_cap_pri_prevision NUMBER(18,2),
  tot_cap_seg_prevision NUMBER(18,2),
  tot_int_pri_prevision NUMBER(18,2),
  tot_int_seg_prevision NUMBER(18,2)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CLA_INCOBRABLES_HIS
  is 'Operaciones clasificadas Incobrables según Resolución 37.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.fecha
  is 'Fecha de la categorizaci¿n.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cod_persona
  is 'Codigo del cliente.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.nro_cuenta
  is 'N¿mero de cuenta.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cod_modulo
  is 'Tipo de producto.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cod_modalidad
  is 'Sub tipo de Producto.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cod_estado
  is 'Estado de la cuenta.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tot_deu_real
  is 'Total de la deuda real.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tot_deu_contingente
  is 'Total de la deuda contingente.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.dev_no_cobrado
  is 'Devengado no cobrado.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cat_automatica
  is 'Categoria automatica del Sistema.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.dia_atraso
  is 'dias de atraso.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cod_moneda
  is 'moneda de la cuenta.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tot_gar_computables
  is 'Monto total de la garantias computables.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cod_oficina
  is 'Codigo de la sucursal.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tipo
  is 'Tipo A-nuevo, B-Renovado, C-Refinanciado, D-Restructurado.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tot_prevision
  is 'Monto total de la Previsi¿n.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.mto_original
  is 'Monto original de la operacion.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tip_destino
  is 'Destino del Cr¿dito (1=Grandes Deudores-2=Peque¿os Deudores-3=Vivienda-4=Consumo-5=Microcreditos.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cod_sec_credito
  is 'C¿digo de Sector de Cr¿dito.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.usu_insercion
  is 'Usuario que realiz¿ la inserci¿n del registro.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.fec_insercion
  is 'Fecha en que se insert¿ el registro.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.usu_modificacion
  is 'Usuario que realiz¿ la ¿ltima modificaci¿n en el registro.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.fec_modificacion
  is 'Fecha en que se realiz¿ la ¿ltima modificaci¿n en el registro.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cat_renovaciones
  is 'categoria de las renovaciones, refinanciaciones o restructuraciones.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cat_ren_anterior
  is 'Categoria de Renovaci¿n anterior, si es que mejora por pago.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.lib_prevision
  is 'Indica si va a liberar o no la previsi¿n (S/N).';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tot_pri_prevision
  is 'Monto calculado para la primera prevision.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.cod_rub_economico
  is 'Código de Rubro Económico.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tot_cap_pri_prevision
  is 'Primera Previsión del Saldo Capital de la Operación.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tot_cap_seg_prevision
  is 'Segunda Previsión del Saldo Capital de la Operación.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tot_int_pri_prevision
  is 'Primera Previsión de Interés de la Operación.';
comment on column IT.GE_CLA_INCOBRABLES_HIS.tot_int_seg_prevision
  is 'Segunda Previsión de Interés de la Operación.';
alter table IT.GE_CLA_INCOBRABLES_HIS
  add constraint PK_GE_CLA_INCOBRABLES_HIS primary key (FECHA, NRO_CUENTA, COD_PERSONA, COD_ESTADO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CLA_INCOBRABLES_HIS
  add constraint FK_GCIHI_COD_ESTADO foreign key (COD_MODULO, COD_MODALIDAD, COD_ESTADO)
  references IT.GE_EST_CUENTAS (COD_MODULO, COD_MODALIDAD, ESTADO);
alter table IT.GE_CLA_INCOBRABLES_HIS
  add constraint FK_GCIHI_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CLA_INCOBRABLES_HIS
  add constraint FK_GCIHI_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

