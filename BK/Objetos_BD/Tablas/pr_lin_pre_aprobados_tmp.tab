create table IT.PR_LIN_PRE_APROBADOS_TMP
(
  cod_persona       VARCHAR2(10) not null,
  cod_moneda        VARCHAR2(3),
  mto_limite        NUMBER(18,2),
  fec_vencimiento   DATE,
  fec_otorgamiento  DATE,
  descripcion       VARCHAR2(240),
  tip_garantia      VARCHAR2(3),
  cod_modulo        NUMBER(3),
  cod_modalidad     NUMBER(3),
  mto_lim_modalidad NUMBER(18,2),
  cod_campana       NUMBER(3),
  fec_fin_campana   DATE,
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_LIN_PRE_APROBADOS_TMP
  is 'Datos de Líneas de Pre-Aprobados.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.cod_persona
  is 'Código de Persona.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.cod_moneda
  is 'Código de Moneda.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.mto_limite
  is 'Monto Límite.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.fec_vencimiento
  is 'Fecha de Vencimiento.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.fec_otorgamiento
  is 'Fecha de Otorgamiento.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.descripcion
  is 'Descripción.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.tip_garantia
  is 'Tipo de Garantía.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.cod_modulo
  is 'Código de Módulo.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.cod_modalidad
  is 'Código de Modalidad.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.mto_lim_modalidad
  is 'Monto límite por Modalidad.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.cod_campana
  is 'Código de Campaña.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.fec_fin_campana
  is 'Fecha de Fin de Campaña.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.usu_insercion
  is 'Usuario de inserción.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.fec_insercion
  is 'fecha de inserción.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.usu_modificacion
  is 'Usuario de modificación.';
comment on column IT.PR_LIN_PRE_APROBADOS_TMP.fec_modificacion
  is 'Fecha de modificación.';

