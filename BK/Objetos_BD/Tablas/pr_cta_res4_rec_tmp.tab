create table IT.PR_CTA_RES4_REC_TMP
(
  nro_cuenta              VARCHAR2(15) not null,
  cod_persona             VARCHAR2(15) not null,
  nro_cta_nueva           VARCHAR2(15),
  cat_aut_cta_origen      NUMBER(3,2),
  cat_ren_cta_origen      NUMBER(3,2),
  cat_ren_cta_nueva       NUMBER(3,2),
  fec_ini_cta_nueva       DATE,
  cat_rie_cliente         NUMBER(3,2),
  fec_dat_rie_cliente     DATE,
  sub_cat_individual      NUMBER(3,2),
  actualizar              VARCHAR2(1),
  usu_insercion           VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion           DATE default SYSDATE not null,
  usu_modificacion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion        DATE default SYSDATE not null,
  rec_cat_aut_cta_origen  NUMBER(3,2),
  rec_cat_ren_cta_origen  NUMBER(3,2),
  rec_cat_ren_cta_nueva   NUMBER(3,2),
  rec_cat_rie_cliente     NUMBER(3,2),
  rec_fec_dat_rie_cliente DATE,
  rec_sub_cat_individual  NUMBER(3,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

