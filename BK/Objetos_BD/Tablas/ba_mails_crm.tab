create table IT.BA_MAILS_CRM
(
  cod_persona      VARCHAR2(10) not null,
  tipo             VARCHAR2(1),
  dir_correo       VARCHAR2(319) not null,
  dir_correo_old   VARCHAR2(319),
  principal        VARCHAR2(1),
  observacion      VARCHAR2(1000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion TIMESTAMP(6) default current_timestamp not null,
  tip_accion       VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BA_MAILS_CRM
  is 'EMails.';
comment on column IT.BA_MAILS_CRM.cod_persona
  is 'Codigo de la Persona.';
comment on column IT.BA_MAILS_CRM.tipo
  is 'Tipo de Mail (L=Laboral / P= Particular / C= Canales).';
comment on column IT.BA_MAILS_CRM.dir_correo
  is 'Direccion de Correo Electronico.';
comment on column IT.BA_MAILS_CRM.principal
  is 'Indica si el telefono es default (S=SI / N=NO).';
comment on column IT.BA_MAILS_CRM.observacion
  is 'Observacion.';
comment on column IT.BA_MAILS_CRM.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BA_MAILS_CRM.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BA_MAILS_CRM.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BA_MAILS_CRM.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.BA_MAILS_CRM.tip_accion
  is 'Indica el tipo de accion realizado con el registro en el Core.-';
create index IT.IN_CRM_BA_MAILS_CRM on IT.BA_MAILS_CRM (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

