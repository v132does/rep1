create table IT.TA_ENV_COBROS_HIS
(
  cod_ent_procesadora NUMBER(5),
  cod_banco           NUMBER(2),
  cod_sucursal        NUMBER(2),
  nro_cuenta          VARCHAR2(15),
  nro_tarjeta         VARCHAR2(16),
  monto               NUMBER(18,2),
  fec_valor           DATE,
  fec_envio           DATE,
  hor_envio           VARCHAR2(8),
  tip_pago            VARCHAR2(1),
  estado              VARCHAR2(1),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  reg_cobro           VARCHAR2(20),
  cod_moneda          VARCHAR2(3),
  descripcion         VARCHAR2(35)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_ENV_COBROS_HIS
  is 'Envios historicos de tarjetas.';
comment on column IT.TA_ENV_COBROS_HIS.cod_ent_procesadora
  is 'Codigo de la procesadora.';
comment on column IT.TA_ENV_COBROS_HIS.cod_banco
  is 'Codigo de banco de la procesadora.';
comment on column IT.TA_ENV_COBROS_HIS.cod_sucursal
  is 'Codigo de sucursal de la procesadora.';
comment on column IT.TA_ENV_COBROS_HIS.nro_cuenta
  is 'Numero de Cuenta de la Tarjeta.';
comment on column IT.TA_ENV_COBROS_HIS.nro_tarjeta
  is 'Nro de tarjeta de la procesadora.';
comment on column IT.TA_ENV_COBROS_HIS.monto
  is 'Monto del pago.';
comment on column IT.TA_ENV_COBROS_HIS.fec_valor
  is 'fecha del pago.';
comment on column IT.TA_ENV_COBROS_HIS.fec_envio
  is 'fecha de envio del pago.';
comment on column IT.TA_ENV_COBROS_HIS.hor_envio
  is 'hora de envio del pago.';
comment on column IT.TA_ENV_COBROS_HIS.tip_pago
  is 'tipo de pago (V=Valor, N=Normal).';
comment on column IT.TA_ENV_COBROS_HIS.estado
  is 'Estado del Pago (G=Generado,E=Enviado,A=Anulado).';
comment on column IT.TA_ENV_COBROS_HIS.usu_insercion
  is 'Usuario de insercion.';
comment on column IT.TA_ENV_COBROS_HIS.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.TA_ENV_COBROS_HIS.usu_modificacion
  is 'Fecha de modificacion.';
comment on column IT.TA_ENV_COBROS_HIS.fec_modificacion
  is 'Usuario de modificacion.';
comment on column IT.TA_ENV_COBROS_HIS.reg_cobro
  is 'Identificador del registro de ta_cobros.';
comment on column IT.TA_ENV_COBROS_HIS.cod_moneda
  is 'Código de Moneda de Pago.';
comment on column IT.TA_ENV_COBROS_HIS.descripcion
  is 'Descripción del Pago.';
create index IT.IN_TECHI_COD_ENT_PROCESADORA on IT.TA_ENV_COBROS_HIS (COD_ENT_PROCESADORA, FEC_ENVIO, HOR_ENVIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 768K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TECHI_CTA_FECHA on IT.TA_ENV_COBROS_HIS (NRO_TARJETA, NRO_CUENTA, FEC_VALOR)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_ENV_COBROS_HIS
  add constraint FK_TENCH_COD_PROCESADORA foreign key (COD_ENT_PROCESADORA)
  references IT.GE_ENTES (COD_ENTE);

