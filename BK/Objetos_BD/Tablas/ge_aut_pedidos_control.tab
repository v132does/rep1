create table IT.GE_AUT_PEDIDOS_CONTROL
(
  cod_usuario         VARCHAR2(10) not null,
  fecha               DATE not null,
  hora                VARCHAR2(8) not null,
  cod_usu_autorizador VARCHAR2(10),
  mensaje             VARCHAR2(1000),
  estado              VARCHAR2(1),
  respuesta           VARCHAR2(1),
  observacion         VARCHAR2(1000),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  mto_mon_fuerte      NUMBER(18,2),
  tip_autorizacion    VARCHAR2(1) default 'T'
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_AUT_PEDIDOS_CONTROL
  is 'Tabla temporal para control de operaciones Autorizacion Tasa';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.cod_usuario
  is 'Codigo de operador.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.fecha
  is 'Fecha.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.hora
  is 'Hora.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.cod_usu_autorizador
  is 'Codigo de autorizador.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.mensaje
  is 'Mensaje.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.estado
  is 'Estado del pedido (S=Solicitado, C=Confirmado, A=Anulado).';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.respuesta
  is 'Respuesta.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.observacion
  is 'Observacion.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_AUT_PEDIDOS_CONTROL.mto_mon_fuerte
  is 'Monto en moneda fuerte de la operacion.';

