create table IT.GE_EXT_CLI_MOV_PENDIENTES_TMP
(
  fec_extracto     DATE not null,
  fre_extracto     VARCHAR2(1) not null,
  cod_extracto     NUMBER(3) not null,
  tip_comision     NUMBER(4) not null,
  descripcion      VARCHAR2(100) not null,
  monto            NUMBER(18,2) not null,
  cod_persona      VARCHAR2(10) not null,
  fec_movimiento   DATE,
  nro_cuenta       VARCHAR2(15) not null,
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  usu_insercion    VARCHAR2(10),
  fec_insercion    DATE,
  usu_modificacion VARCHAR2(10),
  fec_modificacion DATE,
  hor_movimiento   VARCHAR2(8),
  nro_linea        NUMBER(5)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_EXT_CLI_MOV_PENDIENTES_TMP
  is 'Detalle de comisiones pendientes de pago.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.fec_extracto
  is 'Fecha del Extracto.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.fre_extracto
  is 'Frecuencia del Extracto.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.cod_extracto
  is 'Codigo del Extracto. ';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.tip_comision
  is 'Tipo de Comision.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.descripcion
  is 'Descripcion de la comision.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.monto
  is 'Monto.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.cod_persona
  is 'Codigo de la Persona.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.fec_movimiento
  is 'Fecha del Movimiento.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.nro_cuenta
  is 'Numero de Cuenta.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.cod_modulo
  is 'Codigo del Modulo de la Cuenta.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.cod_modalidad
  is 'Codigo de la Modalidad de la Cuenta.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.usu_insercion
  is 'Usuario que inserto el Registro.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.fec_insercion
  is 'Fecha de Insercion.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.usu_modificacion
  is 'Usuario que modifico el Registro.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.fec_modificacion
  is 'Fecha de Modificacion.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.hor_movimiento
  is 'Hora del Movimiento.';
comment on column IT.GE_EXT_CLI_MOV_PENDIENTES_TMP.nro_linea
  is 'Numero de Linea.';

