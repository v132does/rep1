create table IT.GE_PAG_SUELDOS_TMP
(
  cod_usuario      VARCHAR2(10),
  cod_ente         NUMBER(5),
  fec_proceso      DATE,
  nro_secuencia    NUMBER(3),
  cod_modalidad    NUMBER(3),
  nro_cuenta       VARCHAR2(15),
  cod_moneda       VARCHAR2(3),
  fec_envio        DATE,
  tipo             VARCHAR2(1) default 'C',
  monto            NUMBER(18,2) default 0,
  estado           VARCHAR2(1),
  cod_proceso      NUMBER(3),
  cod_modulo       NUMBER(3),
  fec_insercion    DATE default SYSDATE not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  tip_remuneracion VARCHAR2(1) default 'S',
  nombre           VARCHAR2(40),
  ano              NUMBER(4),
  nivel            NUMBER(2),
  entidad          NUMBER(3),
  observacion      VARCHAR2(15),
  nro_archivo      NUMBER(10),
  nro_documento    VARCHAR2(20),
  nro_lote         NUMBER(15)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAG_SUELDOS_TMP
  is 'Archivo temporal de pago de sueldos.';
comment on column IT.GE_PAG_SUELDOS_TMP.cod_usuario
  is 'Codigo de usuario.';
comment on column IT.GE_PAG_SUELDOS_TMP.cod_ente
  is 'codigo de ente.';
comment on column IT.GE_PAG_SUELDOS_TMP.fec_proceso
  is 'Fecha de proceso.';
comment on column IT.GE_PAG_SUELDOS_TMP.nro_secuencia
  is 'Nro. de secuencia.';
comment on column IT.GE_PAG_SUELDOS_TMP.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.GE_PAG_SUELDOS_TMP.nro_cuenta
  is 'Nro. de cuenta.';
comment on column IT.GE_PAG_SUELDOS_TMP.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.GE_PAG_SUELDOS_TMP.fec_envio
  is 'Fecha de envio.';
comment on column IT.GE_PAG_SUELDOS_TMP.tipo
  is 'Tipo.';
comment on column IT.GE_PAG_SUELDOS_TMP.monto
  is 'Monto.';
comment on column IT.GE_PAG_SUELDOS_TMP.estado
  is 'Estado actual.';
comment on column IT.GE_PAG_SUELDOS_TMP.cod_proceso
  is 'Codigo de proceso.';
comment on column IT.GE_PAG_SUELDOS_TMP.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.GE_PAG_SUELDOS_TMP.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.GE_PAG_SUELDOS_TMP.usu_insercion
  is 'Usuario de insercion.';
comment on column IT.GE_PAG_SUELDOS_TMP.fec_modificacion
  is 'Fecha de modificacion.';
comment on column IT.GE_PAG_SUELDOS_TMP.usu_modificacion
  is 'Usuario de modificacion.';
comment on column IT.GE_PAG_SUELDOS_TMP.tip_remuneracion
  is 'Tipo de Remuneracion (S=Sueldo, A=Aguinaldo, C=Comision, T=Credito).';
comment on column IT.GE_PAG_SUELDOS_TMP.nombre
  is 'Nombre del Beneficiario.';
comment on column IT.GE_PAG_SUELDOS_TMP.ano
  is 'Año del Movimiento.';
comment on column IT.GE_PAG_SUELDOS_TMP.nivel
  is 'Nivel.';
comment on column IT.GE_PAG_SUELDOS_TMP.entidad
  is 'Codigo de Entidad.';
comment on column IT.GE_PAG_SUELDOS_TMP.observacion
  is 'Observacion. (Contine numero de Remito para ciertos Entes)';
comment on column IT.GE_PAG_SUELDOS_TMP.nro_archivo
  is 'Nro de Agrupacion de archivo para la web';
comment on column IT.GE_PAG_SUELDOS_TMP.nro_documento
  is 'Nro Documento del Cliente';
comment on column IT.GE_PAG_SUELDOS_TMP.nro_lote
  is 'Numero de Lote.';
create index IT.IN_GPSUT_USU_FEC_INSERCION on IT.GE_PAG_SUELDOS_TMP (COD_ENTE, USU_INSERCION, TRUNC(FEC_INSERCION))
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAG_SUELDOS_TMP
  add constraint AVCON_1102108048_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_PAG_SUELDOS_TMP
  add constraint AVCON_1102108048_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);

