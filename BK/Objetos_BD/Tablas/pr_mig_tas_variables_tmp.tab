create table IT.PR_MIG_TAS_VARIABLES_TMP
(
  nro_cuenta       VARCHAR2(20) not null,
  cod_periodo      VARCHAR2(50),
  fec_ren_inicial  DATE,
  tas_piso         NUMBER(20,4),
  spread           NUMBER(20,4),
  mar_cuo_1        NUMBER(3),
  mar_cuo_2        NUMBER(3),
  mar_cuo_3        NUMBER(3),
  mar_cuo_4        NUMBER(3),
  mar_cuo_5        NUMBER(3),
  mar_cuo_6        NUMBER(3),
  mar_cuo_7        NUMBER(3),
  mar_cuo_8        NUMBER(3),
  mar_cuo_9        NUMBER(3),
  mar_cuo_10       NUMBER(3),
  mar_cuo_11       NUMBER(3),
  mar_cuo_12       NUMBER(3),
  mar_cuo_13       NUMBER(3),
  mar_cuo_14       NUMBER(3),
  mar_cuo_15       NUMBER(3),
  mar_cuo_16       NUMBER(3),
  mar_cuo_17       NUMBER(3),
  mar_cuo_18       NUMBER(3),
  mar_cuo_19       NUMBER(3),
  mar_cuo_20       NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_insercion    DATE default SYSDATE,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10),
  fec_modificacion DATE default SYSDATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_MIG_TAS_VARIABLES_TMP
  is 'Tabla temporal para Migracion';
comment on column IT.PR_MIG_TAS_VARIABLES_TMP.nro_cuenta
  is 'Nro de Cuenta de Prestamos';
