alter table IT.GE_CUENTAS
  add constraint PK_GE_CUENTAS primary key (NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 4M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CUENTAS
  add constraint FK_GCUEN_COD_CAU_CANCELACION foreign key (COD_CAU_CANCELACION)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.GE_CUENTAS
  add constraint FK_GCUEN_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_CUENTAS
  add constraint FK_GCUEN_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_CUENTAS
  add constraint FK_GCUEN_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CUENTAS
  add constraint FK_GCUEN_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.GE_CUENTAS
  add constraint AVCON_1080843414_RET_P_000
  check (RET_PERSONALIZADA IN ('S', 'N'));
alter table IT.GE_CUENTAS
  add constraint AVCON_1080843414_TAS_P_000
  check (TAS_PERSONALIZADA IN ('S', 'N'));
alter table IT.GE_CUENTAS
  add constraint AVCON_1080843414_TRA_P_000
  check (TRA_PROHIBIDA IN ('S', 'N'));
alter table IT.GE_CUENTAS
  add constraint AVCON_1082384226_COD_C_002
  check (COD_CAU_CANCELACION BETWEEN 0 AND 999);
alter table IT.GE_CUENTAS
  add constraint AVCON_1082384226_COD_M_008
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.GE_CUENTAS
  add constraint AVCON_1082384226_COD_M_009
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.GE_CUENTAS
  add constraint AVCON_1082384226_COD_O_010
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.GE_CUENTAS
  add constraint AVCON_1082384226_COD_T_004
  check (COD_TASA BETWEEN 0 AND 999);
alter table IT.GE_CUENTAS
  add constraint AVCON_1093528760_FRE_E_000
  check (FRE_EXTRACTO IN ('M', 'Q','S', 'D', 'm','q','s', 'd'));
alter table IT.GE_CUENTAS
  add constraint AVCON_1118254713_EN_JU_000
  check (EN_JUICIO IN ('S', 'N'));
alter table IT.GE_CUENTAS
  add constraint AVCON_1118254713_EST_V_000
  check (EST_VERIFICACION IN ('N', 'V', 'J'));

