create table IT.BW_LIMITES
(
  nro_secuencia    NUMBER(20) not null,
  cod_canal        VARCHAR2(3),
  nro_cuenta       VARCHAR2(15),
  fec_inicio       DATE,
  dias             NUMBER(4),
  fec_vencimiento  DATE,
  mto_maximo       NUMBER(18,2),
  cod_moneda       VARCHAR2(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.BW_LIMITES
  is 'Límites por Canal, Servicio y Cliente.';
comment on column IT.BW_LIMITES.nro_secuencia
  is 'Número de Secuencia.';
comment on column IT.BW_LIMITES.cod_canal
  is 'Código de Canal.';
comment on column IT.BW_LIMITES.nro_cuenta
  is 'Permite la personalización del control. Si está en NULL es para todas las cuentas.';
comment on column IT.BW_LIMITES.fec_inicio
  is 'Fecha de Inicio.';
comment on column IT.BW_LIMITES.dias
  is 'Cantidad de días de control.';
comment on column IT.BW_LIMITES.fec_vencimiento
  is 'Fecha de Vencimiento.';
comment on column IT.BW_LIMITES.mto_maximo
  is 'Monto Máximo por Canal.';
comment on column IT.BW_LIMITES.cod_moneda
  is 'Código de Moneda.';
comment on column IT.BW_LIMITES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.BW_LIMITES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.BW_LIMITES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.BW_LIMITES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.BW_LIMITES
  add constraint PK_BW_LIMITES primary key (NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.BW_LIMITES
  add constraint UK_WLIMI_COD_CANAL unique (COD_CANAL, NRO_CUENTA, FEC_INICIO, DIAS)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

