create table IT.CB_SIM_ASIENTOS_DET
(
  fecha            DATE not null,
  cod_oficina      NUMBER(3) not null,
  nro_asiento      NUMBER(6) not null,
  nro_linea        NUMBER(9) not null,
  cod_rubro        VARCHAR2(15) not null,
  tip_movimiento   VARCHAR2(1) not null,
  mto_mon_rubro    NUMBER(18,2) default 0,
  mto_mon_local    NUMBER(18,2) default 0,
  descripcion      VARCHAR2(60),
  referencia       VARCHAR2(11),
  protegido        VARCHAR2(1) default 'N',
  actualizado      VARCHAR2(1) default 'N',
  val_cotizacion   NUMBER(14,8) default 0,
  distribuido      VARCHAR2(1) default 'N',
  ref_movimiento   NUMBER(7),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  fec_valor        DATE
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SIM_ASIENTOS_DET
  is 'Contiene los datos correspondientes a las lineas de detalle de los asientos contables.';
comment on column IT.CB_SIM_ASIENTOS_DET.fecha
  is 'Fecha del asiento.';
comment on column IT.CB_SIM_ASIENTOS_DET.cod_oficina
  is 'Codigo de la oficina del asiento.';
comment on column IT.CB_SIM_ASIENTOS_DET.nro_asiento
  is 'Numero de asiento.';
comment on column IT.CB_SIM_ASIENTOS_DET.nro_linea
  is 'Numero de linea del asiento.';
comment on column IT.CB_SIM_ASIENTOS_DET.cod_rubro
  is 'Codigo de la cuenta contable imputada.';
comment on column IT.CB_SIM_ASIENTOS_DET.tip_movimiento
  is 'Tipo de movimiento ( D=Debito, C=Credito ).';
comment on column IT.CB_SIM_ASIENTOS_DET.mto_mon_rubro
  is 'Importe del movimiento en la moneda del rubro.';
comment on column IT.CB_SIM_ASIENTOS_DET.mto_mon_local
  is 'Importe del movimiento en moneda local.';
comment on column IT.CB_SIM_ASIENTOS_DET.descripcion
  is 'Descripcion de la linea de asiento.';
comment on column IT.CB_SIM_ASIENTOS_DET.referencia
  is 'Referencia de la linea.';
comment on column IT.CB_SIM_ASIENTOS_DET.protegido
  is 'Registro IND_PROTEGIDO ? ( S=IND_PROTEGIDO, no puede ser eliminado, N=No IND_PROTEGIDO, se puede eliminar ).';
comment on column IT.CB_SIM_ASIENTOS_DET.actualizado
  is 'Registro actualizado ? ( S=El asiento ya actualizo el saldo de la cuenta, N=El asiento no actualizo el saldo de la cuenta ).';
comment on column IT.CB_SIM_ASIENTOS_DET.val_cotizacion
  is 'Valor de la tasa de cambio usada para generacion de asientos de cuentas de moneda extranjera.';
comment on column IT.CB_SIM_ASIENTOS_DET.distribuido
  is 'Tiene cuenta de distribucion ? ( S=La cuenta debe ser distribuida, N=La cuenta no debe ser distribuida ).';
comment on column IT.CB_SIM_ASIENTOS_DET.ref_movimiento
  is 'Numero de referencia para desglosar el asiento.';
comment on column IT.CB_SIM_ASIENTOS_DET.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_SIM_ASIENTOS_DET.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_SIM_ASIENTOS_DET.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_SIM_ASIENTOS_DET.fec_modificacion
  is 'Fecha de ultima modificacion en el registro.';
comment on column IT.CB_SIM_ASIENTOS_DET.fec_valor
  is 'Fecha valor del asiento.';
create index IT.IN_ASDET_COD_RUBRO on IT.CB_SIM_ASIENTOS_DET (COD_RUBRO, COD_OFICINA, TIP_MOVIMIENTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_SIM_ASIENTOS_DET
  add constraint PK_CB_SIM_ASIENTOS_DET primary key (FECHA, COD_OFICINA, NRO_ASIENTO, NRO_LINEA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

