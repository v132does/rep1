create table IT.TA_ENV_TARJETAS_ERR
(
  nro_documento            VARCHAR2(240),
  tip_per_titular          VARCHAR2(240),
  cod_tip_doc_titular      VARCHAR2(240),
  pri_nom_titular          VARCHAR2(240),
  seg_nom_titular          VARCHAR2(240),
  pri_ape_titular          VARCHAR2(240),
  seg_ape_titular          VARCHAR2(240),
  cod_pai_titular          VARCHAR2(240),
  cod_sex_titular          VARCHAR2(240),
  fec_nac_titular          VARCHAR2(240),
  lug_nac_titular          VARCHAR2(240),
  est_civ_titular          VARCHAR2(240),
  act_titular              VARCHAR2(240),
  dir_cor_titular          VARCHAR2(240),
  tip_doc_nvo_titular      VARCHAR2(240),
  nro_doc_nvo_titular      VARCHAR2(240),
  sec_env_datos            VARCHAR2(240),
  nro_cuenta               VARCHAR2(240),
  cod_afinidad             VARCHAR2(240),
