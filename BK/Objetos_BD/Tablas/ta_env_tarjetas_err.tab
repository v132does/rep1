  tip_tarjeta              VARCHAR2(240),
  tip_plastico             VARCHAR2(240),
  dur_tarjeta              VARCHAR2(240),
  nom_plastico             VARCHAR2(240),
  adi_personalizado        VARCHAR2(240),
  nro_doc_promotor         VARCHAR2(240),
  cod_tip_doc_promotor     VARCHAR2(240),
  situacion                VARCHAR2(240),
  ren_automatica           VARCHAR2(240),
  orden_1                  VARCHAR2(240),
  orden_2                  VARCHAR2(240),
  emboza                   VARCHAR2(240),
  nro_doc_procesadora      VARCHAR2(240),
  tip_per_promotor         VARCHAR2(240),
  cod_tip_doc_procesadora  VARCHAR2(240),
  pri_nom_promotor         VARCHAR2(240),
  seg_nom_promotor         VARCHAR2(240),
  pri_ape_promotor         VARCHAR2(240),
  seg_ape_promotor         VARCHAR2(240),
  cod_sex_promotor         VARCHAR2(240),
  fec_nac_promotor         VARCHAR2(240),
  lug_nac_promotor         VARCHAR2(240),
  est_civ_promotor         VARCHAR2(240),
  act_promotor             VARCHAR2(240),
  dir_cor_promotor         VARCHAR2(240),
  pla_contado              VARCHAR2(240),
  ope_pla_contado          VARCHAR2(240),
  imp_per_pla_contado      VARCHAR2(240),
  por_per_pla_contado      VARCHAR2(240),
  pla_ade_efectivo         VARCHAR2(240),
  ope_pla_ade_efectivo     VARCHAR2(240),
  imp_per_pla_ade_efectivo VARCHAR2(240),
  por_per_ade_efectivo     VARCHAR2(240),
  pue_financiar            VARCHAR2(240),
  usu_actualizacion        VARCHAR2(240),
  nro_socio                VARCHAR2(240),
  mot_novedad              VARCHAR2(240)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_ENV_TARJETAS_ERR
  is 'Envio de alta de tarjetas';
comment on column IT.TA_ENV_TARJETAS_ERR.nro_documento
  is 'Nro. de Documento. ';
comment on column IT.TA_ENV_TARJETAS_ERR.tip_per_titular
  is 'Tipo de Persona (''F'' o ''J'') -Titular de la Tarjeta.';
