create table IT.SB_BCP_SUM
(
  cod_rubro  VARCHAR2(15) not null,
  cla_moneda VARCHAR2(4) default 0 not null,
  importe    NUMBER(18,2) default 0 not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_BCP_SUM
  is 'Tabla auxiliar utilizada en el proceso de planinfo.';
comment on column IT.SB_BCP_SUM.cod_rubro
  is 'Codigo de la cuenta contable.';
comment on column IT.SB_BCP_SUM.cla_moneda
  is 'Codigo numerico del importe.';
comment on column IT.SB_BCP_SUM.importe
  is 'Importe.';

