create table IT.TA_TIP_EXO_COSTOS
(
  cod_modalidad    NUMBER(3) not null,
  cod_modulo       NUMBER(3) not null,
  afinidad         VARCHAR2(10) not null,
  sub_afinidad     VARCHAR2(3) not null,
  cod_costo        NUMBER(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_TIP_EXO_COSTOS
  is 'Tabla de Exoneración de Costos.';
comment on column IT.TA_TIP_EXO_COSTOS.cod_modalidad
  is 'Código de Modalidad.';
comment on column IT.TA_TIP_EXO_COSTOS.cod_modulo
  is 'Código del Modulo.';
comment on column IT.TA_TIP_EXO_COSTOS.afinidad
  is 'Afinidad de la tarjeta.';
comment on column IT.TA_TIP_EXO_COSTOS.sub_afinidad
  is 'Sub Afinidad de la Tarjeta. ';
comment on column IT.TA_TIP_EXO_COSTOS.cod_costo
  is 'Código del Costo a Exonerar.';
comment on column IT.TA_TIP_EXO_COSTOS.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.TA_TIP_EXO_COSTOS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.TA_TIP_EXO_COSTOS.usu_modificacion
  is 'Usuario que modificó el registro.';
comment on column IT.TA_TIP_EXO_COSTOS.fec_modificacion
  is 'Última fecha en que se modificó el registro.';
alter table IT.TA_TIP_EXO_COSTOS
  add constraint PK_TA_TIP_EXO_COSTOS primary key (COD_MODALIDAD, COD_MODULO, AFINIDAD, SUB_AFINIDAD, COD_COSTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

