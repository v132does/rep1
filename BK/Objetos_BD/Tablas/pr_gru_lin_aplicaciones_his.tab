create table IT.PR_GRU_LIN_APLICACIONES_HIS
(
  nro_linea          NUMBER(7),
  cod_gru_economico  NUMBER(5),
  cod_persona        VARCHAR2(50),
  cod_moneda         VARCHAR2(3),
  mto_aplicado       NUMBER(18,2),
  usu_insercion      VARCHAR2(10),
  fec_insercion      DATE,
  usu_modificacion   VARCHAR2(10),
  fec_modificacion   DATE,
  nro_secuencia      NUMBER(18),
  nro_lin_individual NUMBER(7),
  estado             VARCHAR2(1)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_GRU_LIN_APLICACIONES_HIS
  is 'Tabla de aplicación de Límites Globales.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.nro_linea
  is 'Número de Línea.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.cod_gru_economico
  is 'Grupo Económico.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.cod_persona
  is 'Código de Persona al cual corresponde la línea de crédito individual.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.cod_moneda
  is 'Moneda de la Propuesta aplicada.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.mto_aplicado
  is 'Monto aplicado.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.nro_secuencia
  is 'Secuencia de inserción en el histórico de Límites Globales.';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.nro_lin_individual
  is 'Número de línea individual';
comment on column IT.PR_GRU_LIN_APLICACIONES_HIS.estado
  is 'Estado de la aplicación.';

