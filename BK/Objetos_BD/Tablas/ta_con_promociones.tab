create table IT.TA_CON_PROMOCIONES
(
  nro_convenio         NUMBER(6) not null,
  descripcion          VARCHAR2(60) not null,
  nro_cta_deb_comercio VARCHAR2(15),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cod_rub_deb_entidad  VARCHAR2(15) not null,
  comercio             VARCHAR2(60) not null,
  por_descuento        NUMBER(7,2) not null,
  por_entidad          NUMBER(7,2) not null,
  por_comercio         NUMBER(7,2) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_CON_PROMOCIONES.nro_convenio
  is 'Numero de Convenio de Promoción.';
comment on column IT.TA_CON_PROMOCIONES.descripcion
  is 'Descripción del Convenio de Promoción.';
comment on column IT.TA_CON_PROMOCIONES.nro_cta_deb_comercio
  is 'Número de Cuenta de Débito al Comercio. ';
comment on column IT.TA_CON_PROMOCIONES.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.TA_CON_PROMOCIONES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.TA_CON_PROMOCIONES.usu_modificacion
  is 'Usuario que realizó la última modificación.';
comment on column IT.TA_CON_PROMOCIONES.fec_modificacion
  is 'Ultima fecha en que se modificó el registro.';
comment on column IT.TA_CON_PROMOCIONES.cod_rub_deb_entidad
  is 'Codigo de Rubro Contable para el debito a la Entidad.';
comment on column IT.TA_CON_PROMOCIONES.comercio
  is 'Nombre del Comercio.';
comment on column IT.TA_CON_PROMOCIONES.por_descuento
  is 'Porcentaje de descuento normal promoción.';
comment on column IT.TA_CON_PROMOCIONES.por_entidad
  is 'Porcentaje que le corresponde a la Entidad.';
comment on column IT.TA_CON_PROMOCIONES.por_comercio
  is 'Porcentaje que le corresponde a la Comercio.';
create index IT.IN_TCPRO_COD_RUB_DEB_ENTIDAD on IT.TA_CON_PROMOCIONES (COD_RUB_DEB_ENTIDAD, NRO_CTA_DEB_COMERCIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_CON_PROMOCIONES
  add constraint PK_TA_CON_PROMOCIONES primary key (NRO_CONVENIO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.TA_CON_PROMOCIONES
  add constraint FK_CONPR_COD_RUB_DEB_ENTIDAD foreign key (COD_RUB_DEB_ENTIDAD)
  references IT.CB_RUBROS (COD_RUBRO);
alter table IT.TA_CON_PROMOCIONES
  add constraint FK_CONPR_NRO_CTA_DEB_COMERCIO foreign key (NRO_CTA_DEB_COMERCIO)
  references IT.GE_CUENTAS (NRO_CUENTA);

