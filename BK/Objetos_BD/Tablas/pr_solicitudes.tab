alter table IT.PR_SOLICITUDES
  add constraint PK_PR_SOLICITUDES primary key (NRO_SOLICITUD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 320K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_BANCA foreign key (COD_BANCA)
  references IT.GE_BANCAS (COD_BANCA);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_CAMPANA foreign key (COD_CAMPANA)
  references IT.CR_CAMPANAS (COD_CAMPANA);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_CANAL foreign key (COD_CANAL)
  references IT.GE_CANALES (COD_CANAL);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_DEPARTAMENTO foreign key (COD_DEPARTAMENTO)
  references IT.BA_DEPARTAMENTOS (COD_DEPARTAMENTO);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_ENT_CONSECIONARIA foreign key (COD_ENT_CONCESIONARIA)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_ENT_SEGURO foreign key (COD_ENT_SEGURO)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_ORI_FONDO foreign key (COD_ORI_FONDO)
  references IT.PR_FONDOS (COD_ORI_FONDO);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_RUB_ECO_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD, COD_RUB_ECONOMICO)
  references IT.PR_RUB_ECO_MODALIDADES (COD_MODULO, COD_MODALIDAD, COD_RUB_ECONOMICO);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_RUB_ECONOMICO foreign key (COD_RUB_ECONOMICO)
  references IT.PR_RUB_ECONOMICOS (COD_RUB_ECONOMICO);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_SUB_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD)
  references IT.GE_SUB_MODALIDADES (COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_USU_APROBACION foreign key (COD_USU_APROBACION)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.PR_SOLICITUDES
  add constraint FK_PSOLI_COD_USU_PROMOTOR foreign key (COD_USU_PROMOTOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1080845005_AJU_G_000
  check (AJU_GRACIA IN ('S', 'N'));
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1080845005_AJU_U_000
  check (AJU_ULT_CUOTA IN ('S', 'N'));
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1080845005_DEB_A_000
  check (DEB_AUTOMATICO IN ('S', 'N'));
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1080845005_EXO_I_000
  check (EXO_IMPUESTO IN ('S', 'N'));
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1080845005_TIP_D_000
  check (TIP_DOCUMENTO IN ('1', '2'));
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1080845005_TIP_M_000
  check (TIP_MONTO IN ('B', 'N'));
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1080845005_TIPO_000
  check (TIPO IN ('A', 'P', 'D'));
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1085007172_COD_D_000
  check (COD_DEPARTAMENTO BETWEEN 0 AND 999);
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1085007172_COD_M_000
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1085007172_COD_M_001
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1085007172_COD_O_000
  check (COD_ORI_FONDO BETWEEN 0 AND 999);
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1085007172_COD_O_001
  check (COD_OFICINA BETWEEN 0 AND 999);
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1085007172_COD_S_000
  check (COD_SEC_CREDITO BETWEEN 0 AND 999);
alter table IT.PR_SOLICITUDES
  add constraint AVCON_1100130481_EST_000
  check (ESTADO IN ('S','A','R', 'P', 'N','L', 'C', 'E', 'D', 'Z'));
alter table IT.PR_SOLICITUDES
  add constraint CK_POR_ORI_FONDO1
  check (por_ori_fondo between 0 and 100);

