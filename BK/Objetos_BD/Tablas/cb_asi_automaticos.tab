create table IT.CB_ASI_AUTOMATICOS
(
  fecha            DATE not null,
  cod_oficina      NUMBER(3) not null,
  nro_asiento      NUMBER(6) not null,
  cod_usuario      VARCHAR2(10) not null,
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  tot_control      NUMBER(18,2) default 0,
  actualizado      VARCHAR2(1) default 'N',
  reversado        VARCHAR2(1) default 'N',
  ofi_integrada    VARCHAR2(1) default 'N',
  confirmado       VARCHAR2(1) default 'N',
  cod_ofi_origen   NUMBER(3),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  nro_asi_real     NUMBER(6),
  cod_gru_asiento  NUMBER(3),
  fec_valor        DATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_ASI_AUTOMATICOS
  is 'Contiene los datos correspondientes a la Cabecera de los Asientos Contables Automaticos.';
comment on column IT.CB_ASI_AUTOMATICOS.fecha
  is 'Fecha de los movimientos que genera el asiento.';
comment on column IT.CB_ASI_AUTOMATICOS.cod_oficina
  is 'Codigo de la oficina origen del asiento.';
comment on column IT.CB_ASI_AUTOMATICOS.nro_asiento
  is 'Numero del asiento automatico.';
comment on column IT.CB_ASI_AUTOMATICOS.cod_usuario
  is 'Codigo del usuario que genero el asiento.';
comment on column IT.CB_ASI_AUTOMATICOS.cod_modulo
  is 'Codigo de modulo del asiento.';
comment on column IT.CB_ASI_AUTOMATICOS.cod_modalidad
  is 'Codigo de modalidad del asiento.';
comment on column IT.CB_ASI_AUTOMATICOS.tot_control
  is 'Suma de debitos y creditos para control.';
comment on column IT.CB_ASI_AUTOMATICOS.actualizado
  is 'Asiento actualizado ? ( S=El asiento ya actualizo el saldo de la cuenta, N=El asiento no actualizo el saldo de la cuenta ).';
comment on column IT.CB_ASI_AUTOMATICOS.reversado
  is 'Asiento reversado? ( S=Asiento reversado, N=Asiento no reversado ).';
comment on column IT.CB_ASI_AUTOMATICOS.ofi_integrada
  is 'Oficina integrada? ( S=Oficina integrada, N=Oficina no integrada ).';
comment on column IT.CB_ASI_AUTOMATICOS.confirmado
  is 'Asiento confirmado Ok? ( S= Asiento confirmado, puede actualizar saldo de cuenta, N= Asiento no confirmado, no puede actualizar saldo de cuenta ).';
comment on column IT.CB_ASI_AUTOMATICOS.cod_ofi_origen
  is 'Codigo de oficina destino.';
comment on column IT.CB_ASI_AUTOMATICOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_ASI_AUTOMATICOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_ASI_AUTOMATICOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_ASI_AUTOMATICOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CB_ASI_AUTOMATICOS.nro_asi_real
  is 'Numero de asiento real en el sistema contable.';
comment on column IT.CB_ASI_AUTOMATICOS.cod_gru_asiento
  is 'Codigo de grupo de asiento parametrizado.';
comment on column IT.CB_ASI_AUTOMATICOS.fec_valor
  is 'Fecha valor de los movimientos que genera el asiento.';
create index IT.IN_BAAUT_COD_MODALIDAD on IT.CB_ASI_AUTOMATICOS (COD_MODALIDAD, COD_MODULO, COD_OFI_ORIGEN, COD_USUARIO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_FEC_NRO_ASI_REAL on IT.CB_ASI_AUTOMATICOS (FECHA, NRO_ASI_REAL)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_NRO_ASIENTO on IT.CB_ASI_AUTOMATICOS (NRO_ASIENTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_ASI_AUTOMATICOS
  add constraint PK_CB_ASI_AUTOMATICOS primary key (FECHA, COD_OFICINA, NRO_ASIENTO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_ASI_AUTOMATICOS
  add constraint FK_BAAUT_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.CB_ASI_AUTOMATICOS
  add constraint FK_BAAUT_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CB_ASI_AUTOMATICOS
  add constraint FK_BAAUT_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CB_ASI_AUTOMATICOS
  add constraint FK_BAAUT_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.CB_ASI_AUTOMATICOS
  add constraint AVCON_1082384743_ACTUA_005
  check (ACTUALIZADO IN ('S', 'N'));
