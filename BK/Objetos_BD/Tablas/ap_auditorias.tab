create table IT.AP_AUDITORIAS
(
  tabla          VARCHAR2(240) not null,
  clave          VARCHAR2(40) not null,
  usuario        VARCHAR2(30) default SUBSTR(USER,1,10) not null,
  fec_sistema    DATE not null,
  fec_calendario DATE not null,
  tip_novedad    VARCHAR2(1) not null,
  terminal       VARCHAR2(40) not null,
  detalle        VARCHAR2(2000) not null,
  origen         VARCHAR2(40)
)
tablespace IT_AUD
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.AP_AUDITORIAS
  is 'Registro de Auditoria de Adm. de Proyectos.';
comment on column IT.AP_AUDITORIAS.tabla
  is 'Nombre de la tabla auditada.';
comment on column IT.AP_AUDITORIAS.clave
  is 'Clave primaria correspondiente al registro auditado a ser identificado.';
comment on column IT.AP_AUDITORIAS.usuario
  is 'Usuario responsable por la novedad ocurrida sobre los datos.';
comment on column IT.AP_AUDITORIAS.fec_sistema
  is 'Fecha del sistema en que se realizo la operacion.';
comment on column IT.AP_AUDITORIAS.fec_calendario
  is 'Fecha calendario del modulo en el momento de realizarse la operacion.';
comment on column IT.AP_AUDITORIAS.tip_novedad
  is 'Tipo de novedad u operacion realizada con el dato.';
comment on column IT.AP_AUDITORIAS.terminal
  is 'Nombre de la terminal en la que se ejecuto la operacion.';
comment on column IT.AP_AUDITORIAS.detalle
  is 'Detalle de modificaciones realizadas.';
comment on column IT.AP_AUDITORIAS.origen
  is 'Nombre del programa o aplicacion desde el cual se ejecuto la operacion.';
alter table IT.AP_AUDITORIAS
  add constraint PK_AP_AUDITORIAS primary key (TABLA, CLAVE, USUARIO, FEC_SISTEMA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.AP_AUDITORIAS
  add constraint AVCON_1081349332_TIP_N_000
  check (TIP_NOVEDAD IN ('I', 'M', 'E'));

