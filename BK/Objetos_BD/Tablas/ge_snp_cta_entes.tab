create table IT.GE_SNP_CTA_ENTES
(
  cod_ente         NUMBER(5) not null,
  nro_cta_bancaria VARCHAR2(34) not null,
  cod_moneda       VARCHAR2(3) not null,
  ind_activo       VARCHAR2(1) default 'S' not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  principal        VARCHAR2(1),
  ind_spi          VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_SNP_CTA_ENTES
  is 'Datos de Cuentas Bancarias de los Participantes definidos como Entes.';
comment on column IT.GE_SNP_CTA_ENTES.cod_ente
  is 'Código del Ente.';
comment on column IT.GE_SNP_CTA_ENTES.nro_cta_bancaria
  is 'Número de la Cuenta Bancaria del Ente.';
comment on column IT.GE_SNP_CTA_ENTES.cod_moneda
  is 'Código de la Moneda de la Cuenta Bancaria.';
comment on column IT.GE_SNP_CTA_ENTES.ind_activo
  is 'Indicador que Activa o Desactiva la Cuenta Bancaria del Participante.';
comment on column IT.GE_SNP_CTA_ENTES.usu_insercion
  is 'Usuario que insertó el registro.';
comment on column IT.GE_SNP_CTA_ENTES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_SNP_CTA_ENTES.usu_modificacion
  is 'Usuario que realizo la última modificación en el registro.';
comment on column IT.GE_SNP_CTA_ENTES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.GE_SNP_CTA_ENTES.principal
  is 'Cuenta Principal.';
comment on column IT.GE_SNP_CTA_ENTES.ind_spi
  is 'Indicador correspondiente a cuenta SPI';
alter table IT.GE_SNP_CTA_ENTES
  add constraint PK_GE_SNP_CTA_ENTES primary key (COD_ENTE, NRO_CTA_BANCARIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_SNP_CTA_ENTES
  add constraint FK_GSCEN_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.GE_SNP_CTA_ENTES
  add constraint FK_GSCEN_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);

