create table IT.PR_SOL_CARGOS_TMP
(
  cod_transaccion  NUMBER(4),
  cod_usuario      VARCHAR2(19),
  fecha            DATE,
  hora             VARCHAR2(8),
  mto_mon_prestamo NUMBER(18,2) default 0,
  cod_ent_seguro   NUMBER(5),
  cod_tasa         NUMBER(3),
  monto            NUMBER(18,2) default 0,
  val_tasa         NUMBER(20,4) default 0,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  nro_solicitud    NUMBER(7) not null,
  cod_moneda       VARCHAR2(3) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.PR_SOL_CARGOS_TMP.cod_transaccion
  is 'Codigo de Transaccion.';
comment on column IT.PR_SOL_CARGOS_TMP.cod_usuario
  is 'Codigo de Usuario.';
comment on column IT.PR_SOL_CARGOS_TMP.fecha
  is 'Fecha.';
comment on column IT.PR_SOL_CARGOS_TMP.hora
  is 'Hora.';
comment on column IT.PR_SOL_CARGOS_TMP.mto_mon_prestamo
  is 'Monto del cargo en USD.';
comment on column IT.PR_SOL_CARGOS_TMP.cod_ent_seguro
  is 'Codigo del ente del seguro.';
comment on column IT.PR_SOL_CARGOS_TMP.cod_tasa
  is 'Codigo de tasa aplicada.';
comment on column IT.PR_SOL_CARGOS_TMP.monto
  is 'Monto del cargo.';
comment on column IT.PR_SOL_CARGOS_TMP.val_tasa
  is 'Valor de la tasa.';
comment on column IT.PR_SOL_CARGOS_TMP.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.PR_SOL_CARGOS_TMP.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.PR_SOL_CARGOS_TMP.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.PR_SOL_CARGOS_TMP.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.PR_SOL_CARGOS_TMP.nro_solicitud
  is 'Numero de solicitud.';
comment on column IT.PR_SOL_CARGOS_TMP.cod_moneda
  is 'Codigo de moneda.';

