comment on column IT.PSA047_HIS.psa047_hisdt2
  is 'FECHA AUXILIAR 2';
comment on column IT.PSA047_HIS.psa047_hisdt3
  is 'FECHA AUXILIAR 3';
comment on column IT.PSA047_HIS.psa047_hisno1
  is 'NUMERICO AUXILIAR 1';
comment on column IT.PSA047_HIS.psa047_hisno2
  is 'NUMERICO AUXILIAR 2';
comment on column IT.PSA047_HIS.psa047_hisno3
  is 'NUMERICO AUXILIAR 3';
comment on column IT.PSA047_HIS.psa047_hisch1
  is 'CARÁCTER AUXILIAR 1';
comment on column IT.PSA047_HIS.psa047_hisch2
  is 'CARÁCTER AUXILIAR 2';
comment on column IT.PSA047_HIS.psa047_hisch3
  is 'CARÁCTER AUXILIAR 3';
alter table IT.PSA047_HIS
  add constraint PK_PSA047_HIS primary key (PSA047_HISPAI, PSA047_HISTDO, PSA047_HISNDO)
  using index 
  tablespace IT_HIS
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

