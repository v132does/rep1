comment on column IT.PSA047_HIS.psa047_hissuc
  is 'CIUDAD-JURISDICCION-SUCURSAL';
comment on column IT.PSA047_HIS.psa047_hiscof
  is 'ORIGEN DE FONDOS';
comment on column IT.PSA047_HIS.psa047_hisrec
  is 'RECURSOS PARA CONSTITUCION DEL PRODUCTO';
comment on column IT.PSA047_HIS.psa047_hisori
  is 'ORIGEN DE DATOS';
comment on column IT.PSA047_HIS.psa047_hisest
  is 'ESTADO';
comment on column IT.PSA047_HIS.psa047_hisdt1
