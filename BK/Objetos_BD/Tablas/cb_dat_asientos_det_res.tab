create table IT.CB_DAT_ASIENTOS_DET_RES
(
  fecha               DATE not null,
  cod_oficina         NUMBER(3) not null,
  nro_asiento         NUMBER(6) not null,
  nro_linea           NUMBER(9) not null,
  cod_rubro           VARCHAR2(15) not null,
  tip_movimiento      VARCHAR2(1) not null,
  nro_cuenta          VARCHAR2(15),
  cod_persona         VARCHAR2(10),
  cod_area            NUMBER(3),
  cod_ori_movimientos NUMBER(3),
  cod_cnc_movimientos NUMBER(3),
  cod_are_solicitante NUMBER(3),
  fec_insercion       DATE default SYSDATE,
  usu_insercion       VARCHAR2(10) default substr(user,1,10),
  fec_modificacion    DATE default SYSDATE,
  usu_modificacion    VARCHAR2(10) default substr(user,1,10)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_DAT_ASIENTOS_DET_RES
  is 'Registra datos adicionales vinculados a un asiento ingresado de forma manual.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.fecha
  is 'Fecha de proceso.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.cod_oficina
  is 'Código de Oficina.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.nro_asiento
  is 'Número de Asiento.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.nro_linea
  is 'Número de Línea.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.cod_rubro
  is 'Código de Rubro.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.tip_movimiento
  is 'Tipo de Movimiento D-Debito C-Crédito.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.nro_cuenta
  is 'Número de Cuenta.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.cod_persona
  is 'Código de Persona.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.cod_area
  is 'Código de Area.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.cod_ori_movimientos
  is 'Código de Origen de los Movimientos.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.cod_cnc_movimientos
  is 'Código del Concepto de los Movimientos.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.cod_are_solicitante
  is 'Código del Area Solicitante.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.fec_insercion
  is 'Fecha de inserción del registro.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.usu_insercion
  is 'Usuario que realizo la inserción del registro.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.fec_modificacion
  is 'Fecha de modificación del registro.';
comment on column IT.CB_DAT_ASIENTOS_DET_RES.usu_modificacion
  is 'Usuario que realizo la modificación del registro.';
alter table IT.CB_DAT_ASIENTOS_DET_RES
  add constraint PK_CB_DAT_ASIENTOS_DET_RES primary key (FECHA, COD_OFICINA, NRO_ASIENTO, NRO_LINEA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

