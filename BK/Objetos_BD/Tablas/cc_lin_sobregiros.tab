create table IT.CC_LIN_SOBREGIROS
(
  cod_usu_autoriza  VARCHAR2(10),
  nro_cuenta        VARCHAR2(15),
  fec_vencimiento   DATE not null,
  cod_tasa          NUMBER(3),
  val_tas_interes   NUMBER(20,4),
  dia_tasa          NUMBER(3),
  tas_preferencial  NUMBER(8,2),
  dia_sin_costo     NUMBER(3),
  nro_linea         NUMBER(7),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  fec_inicio        DATE not null,
  nro_secuencia     NUMBER(7) not null,
  monto             NUMBER(18,2) default 0 not null,
  tipo              VARCHAR2(1) not null,
  cod_persona       VARCHAR2(10),
  cod_moneda        VARCHAR2(3),
  estado            VARCHAR2(1),
  nro_sec_padre     NUMBER(7),
  observacion       VARCHAR2(1000),
  niv_aprobacion    VARCHAR2(3),
  cotizacion        NUMBER(14,8),
  observacion_his   VARCHAR2(4000),
  fec_cam_estado    DATE,
  cod_rub_economico VARCHAR2(6),
  cod_canal         NUMBER(3),
  cod_campana       NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CC_LIN_SOBREGIROS
  is 'Lineas de Sobregiro por Cuenta.';
comment on column IT.CC_LIN_SOBREGIROS.cod_usu_autoriza
  is 'Codigo del autorizador de sobregiro.';
comment on column IT.CC_LIN_SOBREGIROS.nro_cuenta
  is 'Numero de la cuenta a la que le corresponde el acuerdo de sobregiro.';
comment on column IT.CC_LIN_SOBREGIROS.fec_vencimiento
  is 'Fecha de vencimiento del acuerdo de sobregiro.';
comment on column IT.CC_LIN_SOBREGIROS.cod_tasa
  is 'Codigo de la tasa de interes que se aplicara en la liquidacion del sobregiro.';
comment on column IT.CC_LIN_SOBREGIROS.val_tas_interes
  is 'Valor de la tasa de interes que se aplicara en la liquidacion del sobregiro acordado..';
comment on column IT.CC_LIN_SOBREGIROS.dia_tasa
  is 'Dias de tasa preferencial.';
comment on column IT.CC_LIN_SOBREGIROS.tas_preferencial
  is 'Tasa de tasa preferencial.';
comment on column IT.CC_LIN_SOBREGIROS.dia_sin_costo
  is 'Dias sin costo por utilizacion de linea.';
comment on column IT.CC_LIN_SOBREGIROS.nro_linea
  is 'Linea de credito asociada.';
comment on column IT.CC_LIN_SOBREGIROS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CC_LIN_SOBREGIROS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CC_LIN_SOBREGIROS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CC_LIN_SOBREGIROS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CC_LIN_SOBREGIROS.fec_inicio
  is 'Fecha en que se realiza el acuerdo de sobregiro.';
comment on column IT.CC_LIN_SOBREGIROS.nro_secuencia
  is 'Nuero del acuerdo de sobregiro.';
comment on column IT.CC_LIN_SOBREGIROS.monto
  is 'Valor del acuerdo de sobregiro.';
comment on column IT.CC_LIN_SOBREGIROS.tipo
  is 'Tipo de acuerdo, T= Temporal, P= Permanente.';
comment on column IT.CC_LIN_SOBREGIROS.cod_persona
  is 'Codigo del cliente asociado a la linea.';
comment on column IT.CC_LIN_SOBREGIROS.cod_moneda
  is 'Moneda de la Linea.';
comment on column IT.CC_LIN_SOBREGIROS.estado
  is 'Estado.';
comment on column IT.CC_LIN_SOBREGIROS.nro_sec_padre
  is 'Nro. de la secuencia padre (donde el cliente esta cargado).';
comment on column IT.CC_LIN_SOBREGIROS.observacion
  is 'Observaciones.';
comment on column IT.CC_LIN_SOBREGIROS.niv_aprobacion
  is 'Niveles de aprobacion.';
comment on column IT.CC_LIN_SOBREGIROS.cotizacion
  is 'Cotizacion.';
comment on column IT.CC_LIN_SOBREGIROS.observacion_his
  is 'Guarda las observaciones que superaron los 1000 caracteres.';
comment on column IT.CC_LIN_SOBREGIROS.fec_cam_estado
  is 'Fecha de cambio de estado.';
comment on column IT.CC_LIN_SOBREGIROS.cod_rub_economico
  is 'Código de Rubro Económico.';
comment on column IT.CC_LIN_SOBREGIROS.cod_canal
  is 'Código Canal';
comment on column IT.CC_LIN_SOBREGIROS.cod_campana
  is 'Códgio Campaña';
create index IT.IN_BBVA_CC_LIN_SOBREGIROS on IT.CC_LIN_SOBREGIROS (COD_PERSONA, NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CLSOB_ESTADO on IT.CC_LIN_SOBREGIROS (ESTADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CLSOB_NRO_CUENTA on IT.CC_LIN_SOBREGIROS (NRO_CUENTA, FEC_VENCIMIENTO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_CLSOB_NRO_LINEA on IT.CC_LIN_SOBREGIROS (NRO_LINEA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_LIN_SOBREGIROS
  add constraint PK_CC_LIN_SOBREGIROS primary key (NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 128K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_LIN_SOBREGIROS
  add constraint UK_CLSOB_NRO_CUENTA unique (NRO_SEC_PADRE, NRO_CUENTA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CC_LIN_SOBREGIROS
  add constraint FK_CLSOB_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CC_LIN_SOBREGIROS
  add constraint FK_CLSOB_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.CC_LIN_SOBREGIROS
  add constraint FK_CLSOB_COD_RUB_ECONOMICO foreign key (COD_RUB_ECONOMICO)
  references IT.PR_RUB_ECONOMICOS (COD_RUB_ECONOMICO);
alter table IT.CC_LIN_SOBREGIROS
  add constraint AVCON_1092358390_COD_T_003
  check (COD_TASA BETWEEN 0 AND 999);
alter table IT.CC_LIN_SOBREGIROS
  add constraint AVCON_1118330795_ESTAD_000
  check (ESTADO IN ('I', 'A', 'R', 'V','C','B','X'));

