create table IT.PR_GASTOS_COB
(
  cod_persona     VARCHAR2(10),
  cod_oficina     NUMBER(3),
  nro_cuenta      VARCHAR2(15),
  nro_cuota       NUMBER(3),
  cod_tra_cargo   NUMBER(4),
  fec_vencimiento DATE,
  monto           NUMBER(18,2),
  cod_empr_cob    NUMBER
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_GASTOS_COB
  is 'Se cargan aqui los gastos de cobranzas que se generan por la gestión de cobranzas en otras empresas tercerizadas.';
comment on column IT.PR_GASTOS_COB.cod_persona
  is 'Codigo de Persona';
comment on column IT.PR_GASTOS_COB.cod_oficina
  is 'Codigo de Oficina';
comment on column IT.PR_GASTOS_COB.nro_cuenta
  is 'Nro_cuenta del prestamo';
comment on column IT.PR_GASTOS_COB.nro_cuota
  is 'Nro_cuota del prestamo';
comment on column IT.PR_GASTOS_COB.cod_tra_cargo
  is 'Código de transacción del cargo. ';
comment on column IT.PR_GASTOS_COB.fec_vencimiento
  is 'Fecha de vencimiento';
comment on column IT.PR_GASTOS_COB.monto
  is 'Monto del cargo';
comment on column IT.PR_GASTOS_COB.cod_empr_cob
  is 'Código de empresa de cobranza';

