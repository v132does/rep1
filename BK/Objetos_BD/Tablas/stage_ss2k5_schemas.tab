create global temporary table IT.STAGE_SS2K5_SCHEMAS
(
  svrid_fk    NUMBER(38),
  dbid_gen_fk NUMBER(38),
  suid_gen    NUMBER(38),
  schema_id   NUMBER(38) not null,
  name        VARCHAR2(256 CHAR) not null
)
on commit preserve rows;
create index IT.S_SS2K5_SCHEMAS_DBID_GEN_FK on IT.STAGE_SS2K5_SCHEMAS (DBID_GEN_FK);
create index IT.S_SS2K5_SCHEMAS_NAME on IT.STAGE_SS2K5_SCHEMAS (NAME);

