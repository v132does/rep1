create table IT.GE_CON_CLIENTES
(
  cod_persona      VARCHAR2(10) not null,
  nro_contacto     NUMBER not null,
  nro_cta_contacto VARCHAR2(35),
  alias            VARCHAR2(80),
  nombre           VARCHAR2(100) not null,
  apellido         VARCHAR2(120) not null,
  tip_documento    VARCHAR2(3),
  nro_documento    VARCHAR2(20),
  nro_celular      VARCHAR2(20),
  dir_correo       VARCHAR2(80),
  cod_ente         VARCHAR2(40) not null,
  cod_moneda       VARCHAR2(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  url              VARCHAR2(256)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CON_CLIENTES
  is 'Contactos de clientes para Transferencias';
comment on column IT.GE_CON_CLIENTES.cod_persona
  is 'Codigo Persona existente en ITGF';
comment on column IT.GE_CON_CLIENTES.nro_contacto
  is 'Nro. de Contacto';
comment on column IT.GE_CON_CLIENTES.nro_cta_contacto
  is 'Nro. de Cuenta del Contacto';
comment on column IT.GE_CON_CLIENTES.alias
  is 'Alias del Contacto';
comment on column IT.GE_CON_CLIENTES.nombre
  is 'Nombre del Contacto';
comment on column IT.GE_CON_CLIENTES.apellido
  is 'Apellido de Contacto';
comment on column IT.GE_CON_CLIENTES.tip_documento
  is 'Tipo de Documento del Contacto.';
comment on column IT.GE_CON_CLIENTES.nro_documento
  is 'Nro de Documento del Contacto.';
comment on column IT.GE_CON_CLIENTES.nro_celular
  is 'Nro. de celular del contacto';
comment on column IT.GE_CON_CLIENTES.dir_correo
  is 'Direccion de correo del contacto';
comment on column IT.GE_CON_CLIENTES.cod_ente
  is 'Entidad a la cual se transfiere';
comment on column IT.GE_CON_CLIENTES.cod_moneda
  is 'Moneda de la cuenta del contacto';
comment on column IT.GE_CON_CLIENTES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_CON_CLIENTES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_CON_CLIENTES.usu_modificacion
  is 'Usuario que realizó la ultima modificación en el registro.';
comment on column IT.GE_CON_CLIENTES.fec_modificacion
  is 'Fecha en que se realizó la ultima modificación en el registro.';
comment on column IT.GE_CON_CLIENTES.url
  is 'Foto del Contacto asociada al cliente';
alter table IT.GE_CON_CLIENTES
  add constraint PK_GE_CON_CLIENTES primary key (COD_PERSONA, NRO_CONTACTO)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

