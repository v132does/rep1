create table IT.SB_DEP_OFICINAS_DET
(
  fecha            DATE,
  cod_moneda       VARCHAR2(3),
  cod_oficina      NUMBER(3),
  cod_modalidad    NUMBER(3),
  nro_cuenta       VARCHAR2(15),
  val_cotizacion   NUMBER(14,8),
  saldo            NUMBER(18,2) default 0,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.SB_DEP_OFICINAS_DET
  is 'Depositos detallado por oficina.';
comment on column IT.SB_DEP_OFICINAS_DET.fecha
  is 'Fecha del informe.';
comment on column IT.SB_DEP_OFICINAS_DET.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.SB_DEP_OFICINAS_DET.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.SB_DEP_OFICINAS_DET.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.SB_DEP_OFICINAS_DET.nro_cuenta
  is 'Nro. de cuenta.';
comment on column IT.SB_DEP_OFICINAS_DET.val_cotizacion
  is 'Valor de cotizacion.';
comment on column IT.SB_DEP_OFICINAS_DET.saldo
  is 'Saldo de la Cuenta.';
comment on column IT.SB_DEP_OFICINAS_DET.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.SB_DEP_OFICINAS_DET.fec_insercion
  is 'Fecha de insercion.';
comment on column IT.SB_DEP_OFICINAS_DET.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.SB_DEP_OFICINAS_DET.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

