create table IT.GE_MENSAJES
(
  cod_mensaje      NUMBER(3) not null,
  descripcion      VARCHAR2(35) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  det_sql          LONG not null,
  mensaje          VARCHAR2(2000)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_MENSAJES
  is 'Tipos de Mensajes.';
comment on column IT.GE_MENSAJES.cod_mensaje
  is 'Tipo de Mensaje.';
comment on column IT.GE_MENSAJES.descripcion
  is 'Descripcion del Tipo de Mensaje.';
comment on column IT.GE_MENSAJES.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_MENSAJES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_MENSAJES.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_MENSAJES.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_MENSAJES.det_sql
  is 'Detalle de Sql a utilizar en el mensaje.';
comment on column IT.GE_MENSAJES.mensaje
  is 'Mensaje a desplegar.';
alter table IT.GE_MENSAJES
  add constraint PK_GE_MENSAJES primary key (COD_MENSAJE)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_MENSAJES
  add constraint AVCON_1080843414_COD_M_028
  check (COD_MENSAJE BETWEEN 1 AND 999);

