create table IT.CV_VAL_CUSTODIAS
(
  cod_val_custodia NUMBER(15) not null,
  tip_valor        VARCHAR2(2) not null,
  cod_moneda       VARCHAR2(3) not null,
  estado           VARCHAR2(1) not null,
  fec_ingreso      DATE,
  fec_vencimiento  DATE,
  observacion      VARCHAR2(1000),
  monto            NUMBER(18,2),
  cod_persona      VARCHAR2(10),
  nom_persona      VARCHAR2(200),
  nro_operacion    VARCHAR2(15),
  nro_cuota        NUMBER(3),
  fec_cam_estado   DATE,
  cod_banco        NUMBER(3),
  nro_valor        NUMBER(15),
  cta_libradora    VARCHAR2(20),
  cod_ofi_origen   NUMBER(3),
  cod_usu_origen   VARCHAR2(10),
  ubicacion        VARCHAR2(25),
  est_etiqueta     VARCHAR2(2),
  fec_est_etiqueta DATE,
  librador         VARCHAR2(35),
  cod_area         NUMBER(3),
  cod_sector       NUMBER(5),
  cod_nivel        NUMBER(5),
  cod_hilera       NUMBER(5),
  cod_seccion      NUMBER(5),
  cod_orden        NUMBER(3),
  fec_salida       DATE,
  usu_insercion    VARCHAR2(10) default substr(USER,1,10) not null,
  fec_insercion    DATE default sysdate not null,
  usu_modificacion VARCHAR2(10) default substr(USER,1,10) not null,
  fec_modificacion DATE default sysdate not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CV_VAL_CUSTODIAS
  is 'Tabla que almacena valores en custodia.';
comment on column IT.CV_VAL_CUSTODIAS.cod_val_custodia
  is 'Código del Valor en Custodia. Secuencia S_COD_VAL_CUSTODIA';
comment on column IT.CV_VAL_CUSTODIAS.tip_valor
  is 'Tipo de Valor en Custodia. Dominio TIP_DOC_CUSTODIA.';
comment on column IT.CV_VAL_CUSTODIAS.cod_moneda
  is 'Código de Moneda.';
comment on column IT.CV_VAL_CUSTODIAS.estado
  is 'Estado del Valor en Custodia. Dominio EST_VALORES.';
comment on column IT.CV_VAL_CUSTODIAS.fec_ingreso
  is 'Fecha de Ingreso del Valor en Custodia.';
comment on column IT.CV_VAL_CUSTODIAS.fec_vencimiento
  is 'Fecha de Vencimiento del documento.';
comment on column IT.CV_VAL_CUSTODIAS.observacion
  is 'Observación.';
comment on column IT.CV_VAL_CUSTODIAS.monto
  is 'Monto del Valor en Custodia.';
comment on column IT.CV_VAL_CUSTODIAS.cod_persona
  is 'Código de Persona.';
comment on column IT.CV_VAL_CUSTODIAS.nom_persona
  is 'Nombre de la Persona o Tenedor.';
comment on column IT.CV_VAL_CUSTODIAS.nro_operacion
  is 'Nro. de Cuenta de Desembolso o Nro de Cheque.';
comment on column IT.CV_VAL_CUSTODIAS.nro_cuota
  is 'Número de Cuota.';
comment on column IT.CV_VAL_CUSTODIAS.fec_cam_estado
  is 'Fecha de Cambio de Estado de la Custodia.';
comment on column IT.CV_VAL_CUSTODIAS.cod_banco
  is 'Código de Banco.';
comment on column IT.CV_VAL_CUSTODIAS.nro_valor
  is 'Nro. de Cheque de Descuento/Nro de Documento.';
comment on column IT.CV_VAL_CUSTODIAS.cta_libradora
  is 'Cuenta Libradora.';
comment on column IT.CV_VAL_CUSTODIAS.cod_ofi_origen
  is 'Código Oficina Origen.';
comment on column IT.CV_VAL_CUSTODIAS.cod_usu_origen
  is 'Código Usuario Origen.';
comment on column IT.CV_VAL_CUSTODIAS.ubicacion
  is 'Ubicación del Documento.';
comment on column IT.CV_VAL_CUSTODIAS.est_etiqueta
  is 'Estado de la Etiqueta.Dominio EST_ETI_CUSTODIAS.';
comment on column IT.CV_VAL_CUSTODIAS.fec_est_etiqueta
  is 'Fecha del Estado de la Etiqueta. ';
comment on column IT.CV_VAL_CUSTODIAS.librador
  is 'Librador.';
comment on column IT.CV_VAL_CUSTODIAS.cod_area
  is 'Código de Area.';
comment on column IT.CV_VAL_CUSTODIAS.cod_sector
  is 'Código de Sector.';
comment on column IT.CV_VAL_CUSTODIAS.cod_nivel
  is 'Código de Nivel.';
comment on column IT.CV_VAL_CUSTODIAS.cod_hilera
  is 'Código de Hilera.';
comment on column IT.CV_VAL_CUSTODIAS.cod_seccion
  is 'Código de Sección.';
comment on column IT.CV_VAL_CUSTODIAS.cod_orden
  is 'Código de Orden.';
comment on column IT.CV_VAL_CUSTODIAS.fec_salida
  is 'Fecha de Salida.';
comment on column IT.CV_VAL_CUSTODIAS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CV_VAL_CUSTODIAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CV_VAL_CUSTODIAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CV_VAL_CUSTODIAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CV_VAL_CUSTODIAS
  add constraint PK_CV_VAL_CUSTODIAS primary key (COD_VAL_CUSTODIA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CV_VAL_CUSTODIAS
  add constraint UK_CV_VAL_CUSTODIAS unique (NRO_OPERACION, NRO_CUOTA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CV_VAL_CUSTODIAS
  add constraint FK_CVCUS_COD_BANCO foreign key (COD_BANCO)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.CV_VAL_CUSTODIAS
  add constraint FK_CVCUS_COD_HILERA foreign key (COD_HILERA)
  references IT.CV_HILERAS (COD_HILERA);
alter table IT.CV_VAL_CUSTODIAS
  add constraint FK_CVCUS_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CV_VAL_CUSTODIAS
  add constraint FK_CVCUS_COD_NIVEL foreign key (COD_NIVEL)
  references IT.CV_NIVELES (COD_NIVEL);
alter table IT.CV_VAL_CUSTODIAS
  add constraint FK_CVCUS_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.CV_VAL_CUSTODIAS
  add constraint FK_CVCUS_COD_ORDEN foreign key (COD_ORDEN)
  references IT.CV_ORDEN (COD_ORDEN);
alter table IT.CV_VAL_CUSTODIAS
  add constraint FK_CVCUS_COD_SECCION foreign key (COD_SECCION)
  references IT.CV_SECCIONES (COD_SECCION);
alter table IT.CV_VAL_CUSTODIAS
  add constraint FK_CVCUS_COD_SECTOR foreign key (COD_SECTOR)
  references IT.CV_SECTORES (COD_SECTOR);
alter table IT.CV_VAL_CUSTODIAS
  add constraint FK_CVCUS_COD_USU_ORIGEN foreign key (COD_USU_ORIGEN)
  references IT.BA_USUARIOS (COD_USUARIO);

