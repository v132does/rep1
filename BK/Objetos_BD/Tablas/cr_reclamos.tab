create table IT.CR_RECLAMOS
(
  nro_reclamo      NUMBER(10) not null,
  cod_persona      VARCHAR2(10) not null,
  tip_reclamo      VARCHAR2(5) not null,
  fecha            DATE not null,
  detalle          VARCHAR2(2000),
  fec_solucion     DATE,
  estado           VARCHAR2(1) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_RECLAMOS
  is 'Tabla de Reclamos ';
comment on column IT.CR_RECLAMOS.nro_reclamo
  is 'Numero de secuencia unico.';
comment on column IT.CR_RECLAMOS.cod_persona
  is 'Codigo de persona.';
comment on column IT.CR_RECLAMOS.tip_reclamo
  is 'Tipo de Reclamo. Ver ba_cod_referencias. TIP_RECLAMO';
comment on column IT.CR_RECLAMOS.fecha
  is 'Fecha de reclamo.';
comment on column IT.CR_RECLAMOS.detalle
  is 'Detalle del Reclamo';
comment on column IT.CR_RECLAMOS.fec_solucion
  is 'Fecha de solucion.';
comment on column IT.CR_RECLAMOS.estado
  is 'Estado actual del Reclamo.';
comment on column IT.CR_RECLAMOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_RECLAMOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_RECLAMOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_RECLAMOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
create index IT.IN_RRECL_COD_PERSONA on IT.CR_RECLAMOS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_RECLAMOS
  add constraint PK_CR_RECLAMOS primary key (NRO_RECLAMO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_RECLAMOS
  add constraint FK_RRECL_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);

