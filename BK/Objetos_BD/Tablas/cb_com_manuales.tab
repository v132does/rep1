create table IT.CB_COM_MANUALES
(
  nro_comprobante    NUMBER(20) not null,
  nro_factura        VARCHAR2(20),
  nro_timbrado       VARCHAR2(20),
  fec_vig_timbrado   DATE,
  fecha              DATE not null,
  cod_oficina        NUMBER(3) not null,
  tip_comprobante    VARCHAR2(1) not null,
  tip_venta          VARCHAR2(2),
  cod_persona        VARCHAR2(10),
  nro_documento      VARCHAR2(20) not null,
  nom_completo       VARCHAR2(120) not null,
  direccion          VARCHAR2(200),
  dir_transaccion    VARCHAR2(200),
  nro_fac_referencia VARCHAR2(20),
  cod_moneda         VARCHAR2(3),
  mto_exento         NUMBER(18,2) default 0,
  mto_gravado_5      NUMBER(18,2) default 0,
  mto_gravado_10     NUMBER(18,2) default 0,
  impuesto_5         NUMBER(18,2) default 0,
  impuesto_10        NUMBER(18,2) default 0,
  usu_insercion      VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion      DATE default SYSDATE not null,
  usu_modificacion   VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion   DATE default SYSDATE not null,
  cotizacion         NUMBER(14,4),
  impreso            VARCHAR2(1) default 'N',
  procesado          VARCHAR2(1) default 'N',
  anulado            VARCHAR2(1) default 'N',
  fec_aut_timbrado   DATE,
  serie              VARCHAR2(2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_COM_MANUALES
  is 'Comprobante Manual. Puede contener: Autofacturas, Notas de Debito/Credito, Facturas de Cred/Cont. o Recibos manuales';
comment on column IT.CB_COM_MANUALES.nro_comprobante
  is 'Nro secuencial de comprobante';
comment on column IT.CB_COM_MANUALES.nro_factura
  is 'Número de Factura.';
comment on column IT.CB_COM_MANUALES.nro_timbrado
  is 'Número de Timbrado.';
comment on column IT.CB_COM_MANUALES.fec_vig_timbrado
  is 'Fecha de validez del Timbrado.';
comment on column IT.CB_COM_MANUALES.fecha
  is 'Fecha del comprobante';
comment on column IT.CB_COM_MANUALES.cod_oficina
  is 'Oficina del Cliente.';
comment on column IT.CB_COM_MANUALES.tip_comprobante
  is 'Tipo de Comprobante.: Ver ba_cod_referencia con dominio: TIP_COM_VENTA';
comment on column IT.CB_COM_MANUALES.tip_venta
  is 'Condición de Venta(COntado, Credito).';
comment on column IT.CB_COM_MANUALES.cod_persona
  is 'Código Persona del Cliente.';
comment on column IT.CB_COM_MANUALES.nro_documento
  is 'Número de Documento del Cliente. Contiene el Dig. Verificador si corresponde al RUC.';
comment on column IT.CB_COM_MANUALES.nom_completo
  is 'Razón Social del Cliente.';
comment on column IT.CB_COM_MANUALES.direccion
  is 'Direccion del cliente';
comment on column IT.CB_COM_MANUALES.dir_transaccion
  is 'Direccion del lugar de la transaccion. Solo se usa en Autofacturas.';
comment on column IT.CB_COM_MANUALES.nro_fac_referencia
  is 'Número de Factura Referencia.';
comment on column IT.CB_COM_MANUALES.cod_moneda
  is 'Moneda de Facturacion.';
comment on column IT.CB_COM_MANUALES.mto_exento
  is 'Monto total Exento.';
comment on column IT.CB_COM_MANUALES.mto_gravado_5
  is 'Monto total Gravado 5%.';
comment on column IT.CB_COM_MANUALES.mto_gravado_10
  is 'Monto total Gravado 10%.';
comment on column IT.CB_COM_MANUALES.impuesto_5
  is 'Monto total Impuesto 5%.';
comment on column IT.CB_COM_MANUALES.impuesto_10
  is 'Monto total Impuesto 10%';
comment on column IT.CB_COM_MANUALES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CB_COM_MANUALES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CB_COM_MANUALES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CB_COM_MANUALES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.CB_COM_MANUALES.cotizacion
  is 'Cotización';
comment on column IT.CB_COM_MANUALES.impreso
  is 'Indica si ya fue impresa o no la factura.';
comment on column IT.CB_COM_MANUALES.procesado
  is 'Indica si ya fue procesado para Hechauka';
comment on column IT.CB_COM_MANUALES.anulado
  is 'Indica si está anulado o no la factura';
comment on column IT.CB_COM_MANUALES.fec_aut_timbrado
  is 'de autorización del Timbrado en la SET.';
comment on column IT.CB_COM_MANUALES.serie
  is 'Número de Serie de comprobante';
create index IT.IN_BCMAN_COD_OFICINA on IT.CB_COM_MANUALES (COD_OFICINA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BCMAN_COD_PERSONA on IT.CB_COM_MANUALES (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BCMAN_FECHA on IT.CB_COM_MANUALES (FECHA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_BCMAN_NRO_FACTURA on IT.CB_COM_MANUALES (NRO_FACTURA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_COM_MANUALES
  add constraint PK_CB_COM_MANUALES primary key (NRO_COMPROBANTE)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CB_COM_MANUALES
  add constraint FK_BCMAN_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);

