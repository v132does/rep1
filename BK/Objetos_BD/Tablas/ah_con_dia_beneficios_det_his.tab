create table IT.AH_CON_DIA_BENEFICIOS_DET_HIS
(
  nro_comprobante               VARCHAR2(23) null,
  fec_operacion                 DATE not null,
  confirmacion_reintegro        NUMBER(1) null,
  fecha_proceso                 DATE,
  usu_insercion                 VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion                 DATE default SYSDATE not null,
  usu_modificacion              VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion              DATE default SYSDATE not null,
  id                            VARCHAR2(10) null,
  auto_id                       VARCHAR2(30) null,
  origen_transaccion            VARCHAR2(20) null,
  estado                        VARCHAR2(10) null
  )
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

alter table IT.AH_CON_DIA_BENEFICIOS_DET_HIS
add primary key (id)
using index
tablespace IT_DATA
pctfree 10
initrans 2
maxtrans 255
storage
(
  initial 64K
  next 1M
  minextents 1
  maxextents unlimited
);

create index IT.IN_AHCBH_AUTO_ID on IT.AH_CON_DIA_BENEFICIOS_DET_HIS (AUTO_ID)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255;

create index IT.IN_AHCBH_ESTADO on IT.AH_CON_DIA_BENEFICIOS_DET_HIS (ESTADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255;
  
create index IT.IN_AHCBH_ORI_TRANSACCION on IT.AH_CON_DIA_BENEFICIOS_DET_HIS (ORIGEN_TRANSACCION)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255;

comment on table IT.AH_CON_DIA_BENEFICIOS_DET_HIS
  is 'Beneficios - AH_CON_DIA_DET procesados';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET_HIS.nro_comprobante
  is 'Identificador de la operacion';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET_HIS.fec_operacion
  is 'Fecha de transaccion';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET_HIS.confirmacion_reintegro
  is 'Confirmacion reintegro';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET_HIS.fecha_proceso
  is 'Fecha de proceso';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET_HIS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET_HIS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET_HIS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET_HIS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET.id
  is 'Id de registro';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET.auto_id
  is 'Identificador por el cual se relaciona las notificaciones, autorizaciones y confirmaciones';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET.origen_transaccion
  is 'Origen de la transaccion';
comment on column IT.AH_CON_DIA_BENEFICIOS_DET.estado
  is 'Estado de la transaccion';

-- Grant/Revoke object privileges
grant select, insert, update, delete on IT.AH_CON_DIA_BENEFICIOS_DET_HIS to IT_TEMPORAL;