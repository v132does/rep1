create table IT.TA_CAN_AUT_TARJETAS
(
  fecha               DATE not null,
  nro_cuenta          VARCHAR2(15) not null,
  estado              VARCHAR2(1) default 'P' not null,
  det_error           VARCHAR2(4000),
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null,
  hora                VARCHAR2(8),
  cod_tra_padre       NUMBER(4),
  cod_mod_padre       NUMBER(3),
  cod_mad_padre       NUMBER(3),
  usu_anulacion       VARCHAR2(10),
  fec_anulacion       DATE,
  ind_mov_especiales  VARCHAR2(1),
  ind_nov_exoneracion VARCHAR2(1),
  est_anterior        VARCHAR2(1)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
