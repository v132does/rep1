-- Create table
create table IT.CB_SAL_INVENTARIOS_TMP
(
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  cod_oficina      NUMBER(3),
  cod_sec_contable VARCHAR2(1),
  cod_tip_deudor   NUMBER(2),
  residente        VARCHAR2(1),
  cod_moneda       VARCHAR2(3),
  situacion        VARCHAR2(1),
  tip_saldo        VARCHAR2(1) not null,
  cod_plazo        VARCHAR2(1),
  tip_operacion    VARCHAR2(1),
  tip_interes      VARCHAR2(1),
  cod_rubro        VARCHAR2(15),
  sal_total        NUMBER(22,2),
  nro_referencia   NUMBER(10),
  tip_renovacion   VARCHAR2(1),
  cat_automatica   VARCHAR2(1),
  cod_sit_contable VARCHAR2(20),
  nro_cuenta       VARCHAR2(20) not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.CB_SAL_INVENTARIOS_TMP
  is 'Saldos contables de inventarios fisicos temporal.';
-- Add comments to the columns 
comment on column IT.CB_SAL_INVENTARIOS_TMP.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.cod_modalidad
  is 'Codigo de modalidad.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.cod_oficina
  is 'Codigo de oficina.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.cod_sec_contable
  is 'Sector contable.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.cod_tip_deudor
  is 'Tipo de deudor.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.residente
  is 'Residente (s/n).';
comment on column IT.CB_SAL_INVENTARIOS_TMP.cod_moneda
  is 'Codigo de la moneda.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.situacion
  is 'Situacion contable.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.tip_saldo
  is 'Tipo de saldo.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.cod_plazo
  is 'Codigo del plazo contable.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.tip_operacion
  is 'Tipo de operacion (prestamos).';
comment on column IT.CB_SAL_INVENTARIOS_TMP.tip_interes
  is 'Tipo de interes(prestamos).';
comment on column IT.CB_SAL_INVENTARIOS_TMP.cod_rubro
  is 'Rubro contable.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.sal_total
  is 'Saldo segun el inventario fisico.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.nro_referencia
  is 'Nro de secuencia interno para el registro.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.tip_renovacion
  is 'Tipo de renovacion.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.cat_automatica
  is 'Categoria del cliente.';
comment on column IT.CB_SAL_INVENTARIOS_TMP.cod_sit_contable
  is 'Situacion contable';
-- Create/Recreate indexes 
create index IT.IN_CB_SAL_INVENTARIOS_TMP on IT.CB_SAL_INVENTARIOS_TMP (COD_MODULO, COD_MODALIDAD, COD_OFICINA, COD_SEC_CONTABLE, COD_TIP_DEUDOR, RESIDENTE, COD_MONEDA, SITUACION, TIP_SALDO, COD_PLAZO, TIP_OPERACION, TIP_INTERES, COD_RUBRO, TIP_RENOVACION, CAT_AUTOMATICA, COD_SIT_CONTABLE)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.CB_SAL_INVENTARIOS_TMP
  add constraint PK_CB_SAL_INVENTARIOS_TMP primary key (NRO_CUENTA, TIP_SALDO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
