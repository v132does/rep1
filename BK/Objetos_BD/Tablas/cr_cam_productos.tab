create table IT.CR_CAM_PRODUCTOS
(
  cod_campana      NUMBER(3) not null,
  cod_modulo       NUMBER(3) not null,
  cod_modalidad    NUMBER(3) not null,
  cod_moneda       VARCHAR2(3) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_CAM_PRODUCTOS
  is 'Productos por campaña.';
comment on column IT.CR_CAM_PRODUCTOS.cod_campana
  is 'Codigo de campaña.';
comment on column IT.CR_CAM_PRODUCTOS.cod_modulo
  is 'Codigo de modulo.';
comment on column IT.CR_CAM_PRODUCTOS.cod_modalidad
  is 'Codigo de Modalidad.';
comment on column IT.CR_CAM_PRODUCTOS.cod_moneda
  is 'Codigo de Moneda.';
comment on column IT.CR_CAM_PRODUCTOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_CAM_PRODUCTOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_CAM_PRODUCTOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_CAM_PRODUCTOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CR_CAM_PRODUCTOS
  add constraint UK_CR_CAM_PRODUCTOS unique (COD_CAMPANA, COD_MODULO, COD_MODALIDAD, COD_MONEDA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_CAM_PRODUCTOS
  add constraint FK_RCPRO_COD_CAMPANA foreign key (COD_CAMPANA)
  references IT.CR_CAMPANAS (COD_CAMPANA);
alter table IT.CR_CAM_PRODUCTOS
  add constraint FK_RCPRO_COD_MODALIDAD foreign key (COD_MODULO, COD_MODALIDAD)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.CR_CAM_PRODUCTOS
  add constraint FK_RCPRO_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.CR_CAM_PRODUCTOS
  add constraint AVCON_1080843837_COD_C_005
  check (COD_CAMPANA BETWEEN 1 AND 999);
alter table IT.CR_CAM_PRODUCTOS
  add constraint AVCON_1080843837_COD_M_007
  check (COD_MODULO BETWEEN 1 AND 999);
alter table IT.CR_CAM_PRODUCTOS
  add constraint AVCON_1080843837_COD_M_008
  check (COD_MODALIDAD BETWEEN 1 AND 999);

