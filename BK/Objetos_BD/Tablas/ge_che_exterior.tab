create table IT.GE_CHE_EXTERIOR
(
  cod_banco            NUMBER(3) not null,
  des_banco            VARCHAR2(50),
  cta_libradora        VARCHAR2(20),
  nro_cheque           VARCHAR2(15),
  cod_usuario          VARCHAR2(10) not null,
  fecha                DATE not null,
  hora                 VARCHAR2(8) not null,
  nro_cuenta           VARCHAR2(15),
  nro_boleta           NUMBER(15) not null,
  cod_moneda           VARCHAR2(3) not null,
  monto                NUMBER(18,2) not null,
  cod_ofi_origen       NUMBER(3) not null,
  cod_retencion        NUMBER(3) not null,
  fec_final            DATE not null,
  mto_equ_local        NUMBER(18,2) default 0 not null,
  cod_referencia       VARCHAR2(3),
  nro_referencia       NUMBER(18),
  cod_bco_corresponsal NUMBER(3),
  fec_env_corresponsal DATE,
  estado               VARCHAR2(1) not null,
  fec_cam_estado       DATE,
  cod_cau_devolucion   NUMBER(3),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cod_ofi_compensacion NUMBER(3),
  nro_cta_corresponsal VARCHAR2(15),
  lib_posterior        VARCHAR2(1) default 'N' not null,
  liberado             VARCHAR2(1) default 'N' not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CHE_EXTERIOR
  is 'Detalle de los cheques del Exterior.';
comment on column IT.GE_CHE_EXTERIOR.cod_banco
  is 'Codigo de banco al que pertenece el cheque.';
comment on column IT.GE_CHE_EXTERIOR.des_banco
  is 'Descripcion del Banco emisor del cheque.';
comment on column IT.GE_CHE_EXTERIOR.cta_libradora
  is 'Cuenta libradora del cheque.';
comment on column IT.GE_CHE_EXTERIOR.nro_cheque
  is 'Numero de cheque.';
comment on column IT.GE_CHE_EXTERIOR.cod_usuario
  is 'Codigo de operador que realizo la grabacion del registro.';
comment on column IT.GE_CHE_EXTERIOR.fecha
  is 'Fecha de la grabacion del registro .';
comment on column IT.GE_CHE_EXTERIOR.hora
  is 'Hora en que se ingreso el registro.';
comment on column IT.GE_CHE_EXTERIOR.nro_cuenta
  is 'Numero de cuenta en el que se deposita el cheque.';
comment on column IT.GE_CHE_EXTERIOR.nro_boleta
  is 'Numero de boleta.';
comment on column IT.GE_CHE_EXTERIOR.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.GE_CHE_EXTERIOR.monto
  is 'Valor del cheque.';
comment on column IT.GE_CHE_EXTERIOR.cod_ofi_origen
  is 'Codigo de oficina donde se realizo el deposito.';
comment on column IT.GE_CHE_EXTERIOR.cod_retencion
  is 'Codigo del tipo de retencion.';
comment on column IT.GE_CHE_EXTERIOR.fec_final
  is 'Fecha de fin de la retencion .';
comment on column IT.GE_CHE_EXTERIOR.mto_equ_local
  is 'Valor equivalente.';
comment on column IT.GE_CHE_EXTERIOR.cod_referencia
  is 'Codigo de referencia.';
comment on column IT.GE_CHE_EXTERIOR.nro_referencia
  is 'Numero de referencia.';
comment on column IT.GE_CHE_EXTERIOR.cod_bco_corresponsal
  is 'Codigo del Banco en la que se deposita(corresponsal).';
comment on column IT.GE_CHE_EXTERIOR.fec_env_corresponsal
  is 'Fecha del envio al corresponsal.';
comment on column IT.GE_CHE_EXTERIOR.estado
  is 'Estado del cheque (I-Ingresado E-Enviado al cobro C-Confirmado L-Liberado D-Devuelto.';
comment on column IT.GE_CHE_EXTERIOR.fec_cam_estado
  is 'Fecha del cambio de estado actual.';
comment on column IT.GE_CHE_EXTERIOR.cod_cau_devolucion
  is 'Codigo de Causa de Devolucion.';
comment on column IT.GE_CHE_EXTERIOR.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CHE_EXTERIOR.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CHE_EXTERIOR.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CHE_EXTERIOR.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_CHE_EXTERIOR.cod_ofi_compensacion
  is 'Oficina donde se realiza la compensacion del cheque.';
comment on column IT.GE_CHE_EXTERIOR.nro_cta_corresponsal
  is 'Numero de cuenta en el corresponsal.';
comment on column IT.GE_CHE_EXTERIOR.lib_posterior
  is 'Marca de Liberación Posterior.';
comment on column IT.GE_CHE_EXTERIOR.liberado
  is 'Liberado. SI/NO';
create index IT.IN_GCEXT_NRO_CUENTA on IT.GE_CHE_EXTERIOR (NRO_CUENTA, NRO_BOLETA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CHE_EXTERIOR
  add constraint UK_GE_CHE_EXTERIOR unique (NRO_CHEQUE, COD_BANCO, DES_BANCO, CTA_LIBRADORA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CHE_EXTERIOR
  add constraint FK_GCEXT_COD_BANCO foreign key (COD_BANCO)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.GE_CHE_EXTERIOR
  add constraint FK_GCEXT_COD_BCO_CORRESPONSAL foreign key (COD_BCO_CORRESPONSAL)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.GE_CHE_EXTERIOR
  add constraint FK_GCEXT_COD_CAU_DEVOLUCION foreign key (COD_CAU_DEVOLUCION)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.GE_CHE_EXTERIOR
  add constraint FK_GCEXT_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_CHE_EXTERIOR
  add constraint FK_GCEXT_COD_OFI_COMPENSACION foreign key (COD_OFI_COMPENSACION)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CHE_EXTERIOR
  add constraint FK_GCEXT_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CHE_EXTERIOR
  add constraint FK_GCEXT_COD_RETENCION foreign key (COD_RETENCION)
  references IT.GE_RETENCIONES (COD_RETENCION);
alter table IT.GE_CHE_EXTERIOR
  add constraint FK_GCEXT_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.GE_CHE_EXTERIOR
  add constraint FK_GCEXT_NRO_CTA_CORRESPONSAL foreign key (NRO_CTA_CORRESPONSAL)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.GE_CHE_EXTERIOR
  add constraint FK_GCEXT_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

