create table IT.CO_TRM_ASIGNACIONES
(
  cod_tramo        NUMBER(3) not null,
  descripcion      VARCHAR2(20) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CO_TRM_ASIGNACIONES
  is 'Asignaciones por Tramos.';
comment on column IT.CO_TRM_ASIGNACIONES.cod_tramo
  is 'Código de Tramo para Gestión de Cobranzas.';
comment on column IT.CO_TRM_ASIGNACIONES.descripcion
  is 'Descripción del Tramo.';
comment on column IT.CO_TRM_ASIGNACIONES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CO_TRM_ASIGNACIONES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CO_TRM_ASIGNACIONES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CO_TRM_ASIGNACIONES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
alter table IT.CO_TRM_ASIGNACIONES
  add constraint PK_CO_TRM_ASIGNACIONES primary key (COD_TRAMO)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

