create table IT.TA_PAG_SUE_EMP_TMP
(
  cod_empresa       NUMBER(5),
  nro_cedula        VARCHAR2(20) not null,
  pri_nombre        VARCHAR2(30),
  seg_nombre        VARCHAR2(30),
  pri_apellido      VARCHAR2(30),
  seg_apellido      VARCHAR2(30),
  fec_nacimiento    DATE not null,
  sexo              VARCHAR2(1) default 'M' not null,
  est_civil         VARCHAR2(20) not null,
  direccion         VARCHAR2(100),
  ciudad            VARCHAR2(100),
  telefono          VARCHAR2(20) not null,
  sueldo            NUMBER(18,2),
  mto_ant_sueldo    NUMBER(18,2),
  mto_ant_aguinaldo NUMBER(18,2),
  generar           VARCHAR2(1) default 'N',
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null,
  nro_cta_ahorro    VARCHAR2(15),
  fec_ingreso       DATE,
  tip_documento     VARCHAR2(3),
  tip_tarjeta       VARCHAR2(1),
  fec_vto_documento DATE,
  nro_direccion     NUMBER(6),
  cod_pai_fatca     NUMBER(3),
  dir_fiscal        VARCHAR2(80),
  cod_pai_fiscal    NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on column IT.TA_PAG_SUE_EMP_TMP.cod_empresa
  is 'Código de la Empresa';
comment on column IT.TA_PAG_SUE_EMP_TMP.nro_cedula
  is 'Número de Cédula';
comment on column IT.TA_PAG_SUE_EMP_TMP.pri_nombre
  is 'Primer Nombre';
comment on column IT.TA_PAG_SUE_EMP_TMP.seg_nombre
  is 'Segundo Nombre';
comment on column IT.TA_PAG_SUE_EMP_TMP.pri_apellido
  is 'Primer apellido';
comment on column IT.TA_PAG_SUE_EMP_TMP.seg_apellido
  is 'Segundo Apellido';
comment on column IT.TA_PAG_SUE_EMP_TMP.fec_nacimiento
  is 'Fecha de Nacimiento';
comment on column IT.TA_PAG_SUE_EMP_TMP.sexo
  is 'Sexo';
comment on column IT.TA_PAG_SUE_EMP_TMP.est_civil
  is 'Estado Civil';
comment on column IT.TA_PAG_SUE_EMP_TMP.direccion
  is 'Dirección';
comment on column IT.TA_PAG_SUE_EMP_TMP.ciudad
  is 'Ciudad';
comment on column IT.TA_PAG_SUE_EMP_TMP.telefono
  is 'Teléfono';
comment on column IT.TA_PAG_SUE_EMP_TMP.sueldo
  is 'Sueldo';
comment on column IT.TA_PAG_SUE_EMP_TMP.mto_ant_sueldo
  is 'Monto Anticipo de Sueldo';
comment on column IT.TA_PAG_SUE_EMP_TMP.mto_ant_aguinaldo
  is 'Monto Anticipo de Aguinaldo';
comment on column IT.TA_PAG_SUE_EMP_TMP.generar
  is 'Generar como cliente';
comment on column IT.TA_PAG_SUE_EMP_TMP.usu_insercion
  is 'Usuario que realizó la inserción';
comment on column IT.TA_PAG_SUE_EMP_TMP.fec_insercion
  is 'Fecha de la inserción';
comment on column IT.TA_PAG_SUE_EMP_TMP.usu_modificacion
  is 'Usuario que realizó la modificación';
comment on column IT.TA_PAG_SUE_EMP_TMP.fec_modificacion
  is 'Fecha de la modificación';
comment on column IT.TA_PAG_SUE_EMP_TMP.nro_cta_ahorro
  is 'Nro de cuenta de ahorro para combinar con la nueva cuenta';
comment on column IT.TA_PAG_SUE_EMP_TMP.fec_ingreso
  is 'Fecha de ingreso ';
comment on column IT.TA_PAG_SUE_EMP_TMP.tip_documento
  is 'Tipo de Documento';
comment on column IT.TA_PAG_SUE_EMP_TMP.tip_tarjeta
  is 'Tipo de Tarjeta de Debito';
comment on column IT.TA_PAG_SUE_EMP_TMP.fec_vto_documento
  is 'Fecha de Vencimiento del Documento';
comment on column IT.TA_PAG_SUE_EMP_TMP.nro_direccion
  is 'Nro. de Dirección';
comment on column IT.TA_PAG_SUE_EMP_TMP.cod_pai_fatca
  is 'Indica el País de quién solicita.';
comment on column IT.TA_PAG_SUE_EMP_TMP.dir_fiscal
  is 'Indica el nombre de la calle o dirección fiscal del cliente.';
comment on column IT.TA_PAG_SUE_EMP_TMP.cod_pai_fiscal
  is 'Indica el País asociado a la dirección fiscal del cliente.';
create index IT.IN_TASET_COD_EMPRESA on IT.TA_PAG_SUE_EMP_TMP (COD_EMPRESA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

