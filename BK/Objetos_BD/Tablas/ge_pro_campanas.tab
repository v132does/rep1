create table IT.GE_PRO_CAMPANAS
(
  nro_solicitud     NUMBER(7) not null,
  cod_persona       VARCHAR2(10) not null,
  cod_campana       NUMBER(3),
  denominacion      VARCHAR2(100),
  fec_vto_campana   DATE,
  cod_modulo        NUMBER(3),
  cod_modalidad     NUMBER(3),
  cod_sub_modalidad NUMBER(3),
  usu_insercion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion     DATE default SYSDATE not null,
  usu_modificacion  VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion  DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PRO_CAMPANAS
  is 'Productos Preaprobados Campana';
comment on column IT.GE_PRO_CAMPANAS.nro_solicitud
  is 'Numero de la Solicitud de la Propuesta de Credito/Tarjeta.';
comment on column IT.GE_PRO_CAMPANAS.cod_persona
  is 'Codigo de Persona';
comment on column IT.GE_PRO_CAMPANAS.cod_campana
  is 'Codigo de Campana';
comment on column IT.GE_PRO_CAMPANAS.denominacion
  is 'Denominacion de CP';
comment on column IT.GE_PRO_CAMPANAS.fec_vto_campana
  is 'Fecha de Vto. de Campana';
comment on column IT.GE_PRO_CAMPANAS.cod_modulo
  is 'Codigo de Modulo';
comment on column IT.GE_PRO_CAMPANAS.cod_modalidad
  is 'Codigo de Modalidad';
comment on column IT.GE_PRO_CAMPANAS.cod_sub_modalidad
  is 'Codigo de Sub-Modalidad';
comment on column IT.GE_PRO_CAMPANAS.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.GE_PRO_CAMPANAS.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.GE_PRO_CAMPANAS.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.GE_PRO_CAMPANAS.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
create index IT.IN_GPPCA_COD_PERSONA on IT.GE_PRO_CAMPANAS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PRO_CAMPANAS
  add constraint UK_GE_PRO_CAMPANAS unique (COD_PERSONA, COD_MODULO, COD_MODALIDAD, NRO_SOLICITUD)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

