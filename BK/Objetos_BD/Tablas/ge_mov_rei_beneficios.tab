create table IT.GE_MOV_REI_BENEFICIOS
(
    nro_documento3                NUMBER(15),
    hora                          VARCHAR2(8) not null,
    mto_reintegro                 NUMBER(18,2),
    usu_insercion                 VARCHAR2(10) default SUBSTR(USER,1,10) not null,
    fec_insercion                 DATE default SYSDATE not null,
    usu_modificacion              VARCHAR2(10) default SUBSTR(USER,1,10) not null,
    fec_modificacion              DATE default SYSDATE not null
)

tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

comment on table IT.GE_MOV_REI_BENEFICIOS
  is 'Tabla de Beneficios - Migracion';
comment on column IT.GE_MOV_REI_BENEFICIOS.nro_documento3
  is 'Identificador de la operacion';
comment on column IT.GE_MOV_REI_BENEFICIOS.hora
  is 'Hora de la transaccion';
comment on column IT.GE_MOV_REI_BENEFICIOS.mto_reintegro
  is 'Monto Reintegro';
comment on column IT.GE_MOV_REI_BENEFICIOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_MOV_REI_BENEFICIOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_MOV_REI_BENEFICIOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_MOV_REI_BENEFICIOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';

  -- Grant/Revoke object privileges 
grant select, insert, update, delete on IT.GE_MOV_REI_BENEFICIOS to IT_TEMPORAL;