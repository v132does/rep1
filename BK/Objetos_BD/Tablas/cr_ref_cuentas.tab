create table IT.CR_REF_CUENTAS
(
  cod_tip_cuenta   NUMBER(3) not null,
  tip_referencia   VARCHAR2(1) not null,
  descripcion      VARCHAR2(60) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CR_REF_CUENTAS
  is 'Tipos de Cuentas para Referencias.';
comment on column IT.CR_REF_CUENTAS.cod_tip_cuenta
  is 'Tipo de Cuenta.';
comment on column IT.CR_REF_CUENTAS.tip_referencia
  is 'Tipo de Referencia (B-Bancaria, T-Tarjetas).';
comment on column IT.CR_REF_CUENTAS.descripcion
  is 'Descripcion.';
comment on column IT.CR_REF_CUENTAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CR_REF_CUENTAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CR_REF_CUENTAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CR_REF_CUENTAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CR_REF_CUENTAS
  add constraint PK_CR_REF_CUENTAS primary key (COD_TIP_CUENTA, TIP_REFERENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CR_REF_CUENTAS
  add constraint AVCON_1080843837_TIP_R_003
  check (TIP_REFERENCIA IN ('C', 'B', 'T'));
alter table IT.CR_REF_CUENTAS
  add constraint AVCON_1081182415_COD_T_002
  check (COD_TIP_CUENTA BETWEEN 0 AND 999);

