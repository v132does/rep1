-- Create table
create table IT.GE_CIE_CALENDARIOS
(
  fecha            DATE not null,
  observacion      VARCHAR2(100),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
-- Add comments to the table 
comment on table IT.GE_CIE_CALENDARIOS
  is 'Contiene información de los cierres operativos diarios.';
-- Add comments to the columns 
comment on column IT.GE_CIE_CALENDARIOS.fecha
  is 'Fecha de cierre operativo.';
comment on column IT.GE_CIE_CALENDARIOS.observacion
  is 'Observacion.';
comment on column IT.GE_CIE_CALENDARIOS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_CIE_CALENDARIOS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CIE_CALENDARIOS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_CIE_CALENDARIOS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
-- Create/Recreate primary, unique and foreign key constraints 
alter table IT.GE_CIE_CALENDARIOS
  add constraint PK_GE_CIE_CALENDARIOS primary key (FECHA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
