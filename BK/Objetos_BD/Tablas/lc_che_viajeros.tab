create table IT.LC_CHE_VIAJEROS
(
  nro_operacion    NUMBER(7) not null,
  nro_cta_bancaria VARCHAR2(15) not null,
  cod_moneda       VARCHAR2(3) not null,
  serie            VARCHAR2(5) not null,
  nro_inicial      NUMBER(15) not null,
  valor            VARCHAR2(60) not null,
  fec_recepcion    DATE not null,
  cantidad         NUMBER(10) default 0 not null,
  cod_oficina      NUMBER(3) not null,
  cod_usu_emisor   VARCHAR2(10) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.LC_CHE_VIAJEROS
  is 'Datos de los Cheques de Viajeros.';
comment on column IT.LC_CHE_VIAJEROS.nro_operacion
  is 'Numero de comprobante que corresponde a la operacion. Tendria un valor para aquellos cheques que son vendidos.';
comment on column IT.LC_CHE_VIAJEROS.nro_cta_bancaria
  is 'Numero de la cuenta bancaria a que pertenece el cheque.';
comment on column IT.LC_CHE_VIAJEROS.cod_moneda
  is 'Codigo de la moneda.';
comment on column IT.LC_CHE_VIAJEROS.serie
  is 'Numero de serie del cheque.';
comment on column IT.LC_CHE_VIAJEROS.nro_inicial
  is 'Numero de cheque inicial.';
comment on column IT.LC_CHE_VIAJEROS.valor
  is 'Denominacion o valor del cheque.';
comment on column IT.LC_CHE_VIAJEROS.fec_recepcion
  is 'Fecha de recepcion del cheque.';
comment on column IT.LC_CHE_VIAJEROS.cantidad
  is 'Cantidad de cheques.';
comment on column IT.LC_CHE_VIAJEROS.cod_oficina
  is 'Codigo de la oficina.';
comment on column IT.LC_CHE_VIAJEROS.cod_usu_emisor
  is 'Usuario que emitio el cheque.';
comment on column IT.LC_CHE_VIAJEROS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.LC_CHE_VIAJEROS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.LC_CHE_VIAJEROS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.LC_CHE_VIAJEROS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.LC_CHE_VIAJEROS
  add constraint PK_LC_CHE_VIAJEROS primary key (NRO_OPERACION, NRO_CTA_BANCARIA, COD_MONEDA, SERIE, NRO_INICIAL)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.LC_CHE_VIAJEROS
  add constraint FK_LCHEV_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.LC_CHE_VIAJEROS
  add constraint FK_LCHEV_COD_USU_EMISOR foreign key (COD_USU_EMISOR, COD_MONEDA)
  references IT.LC_CHE_VIA_EMISORES (COD_USU_EMISOR, COD_MONEDA);
alter table IT.LC_CHE_VIAJEROS
  add constraint FK_LCHEV_NRO_INICIAL foreign key (NRO_CTA_BANCARIA, COD_MONEDA, SERIE, NRO_INICIAL)
  references IT.LC_CHE_VIAJEROS_DET (NRO_CTA_BANCARIA, COD_MONEDA, SERIE, NRO_INICIAL);

