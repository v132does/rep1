alter table IT.PR_MOVIMIENTOS_HIS
  add constraint PK_PR_MOVIMIENTOS_HIS primary key (FECHA, HORA, COD_USUARIO, NRO_SECUENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 80M
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_BANCO foreign key (COD_BANCO)
  references IT.GE_BANCOS (COD_BANCO);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_CAUSA foreign key (COD_CAUSA)
  references IT.GE_CAUSALES (COD_CAUSA);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_PERSONA foreign key (COD_PERSONA)
  references IT.BA_PERSONAS (COD_PERSONA);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_RETENCION foreign key (COD_RETENCION)
  references IT.GE_RETENCIONES (COD_RETENCION);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_TASA foreign key (COD_TASA)
  references IT.GE_TASAS (COD_TASA);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_TRA_HIJO foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_TRA_PADRE foreign key (COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_USUARIO foreign key (COD_USUARIO)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_USU_AUTORIZADOR foreign key (COD_USU_AUTORIZADOR)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_COD_USU_REVERSION foreign key (COD_USU_REVERSION)
  references IT.BA_USUARIOS (COD_USUARIO);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_NRO_CAJA foreign key (NRO_CAJA)
  references IT.CJ_CAJAS (NRO_CAJA);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint FK_PMHIS_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_COD_B_003
  check (COD_BANCO BETWEEN 0 AND 999);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_COD_C_001
  check (COD_CAUSA BETWEEN 0 AND 999);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_COD_M_011
  check (COD_MAD_PADRE BETWEEN 0 AND 999);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_COD_M_012
  check (COD_MODULO BETWEEN 0 AND 999);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_COD_M_013
  check (COD_MODALIDAD BETWEEN 0 AND 999);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_COD_O_004
  check (COD_OFI_ORIGEN BETWEEN 0 AND 999);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_COD_R_001
  check (COD_RETENCION BETWEEN 0 AND 999);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_COD_T_002
  check (COD_TASA BETWEEN 0 AND 999);
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_EMI_A_000
  check (EMI_AVISO IN ('S', 'N'));
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_PROTE_001
  check (PROTEGIDO IN ('S', 'N'));
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_REVER_000
  check (REVERSADO IN ('S', 'N'));
alter table IT.PR_MOVIMIENTOS_HIS
  add constraint AVCON_1083072595_TIP_M_000
  check (TIP_MOV_RUBRO IN ('D', 'C'));

