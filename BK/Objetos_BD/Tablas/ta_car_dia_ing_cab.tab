create table IT.TA_CAR_DIA_ING_CAB
(
  nro_car_dia     NUMBER(18),
  tip_registro    NUMBER(1),
  cod_ent_emisora VARCHAR2(5),
  cod_marca       VARCHAR2(3),
  cod_ide_archivo VARCHAR2(8),
  des_archivo     VARCHAR2(30),
  fec_proceso     DATE,
  hor_proceso     VARCHAR2(8),
  filler          VARCHAR2(237)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 8M
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_CAR_DIA_ING_CAB
  is 'Maestro-Cabecera importacion archivo T3052 GP';
comment on column IT.TA_CAR_DIA_ING_CAB.nro_car_dia
  is 'Nro. carga diaria';
comment on column IT.TA_CAR_DIA_ING_CAB.tip_registro
  is '1 - Header
';
comment on column IT.TA_CAR_DIA_ING_CAB.cod_ent_emisora
  is 'Código asignado a la Entidad Otorgante.
';
comment on column IT.TA_CAR_DIA_ING_CAB.cod_marca
  is 'Codigo de Marca
';
comment on column IT.TA_CAR_DIA_ING_CAB.cod_ide_archivo
  is 'T3052D
';
comment on column IT.TA_CAR_DIA_ING_CAB.des_archivo
  is 'Cargos ingresados
';
comment on column IT.TA_CAR_DIA_ING_CAB.fec_proceso
  is 'Fecha de generación del archivo
';
comment on column IT.TA_CAR_DIA_ING_CAB.hor_proceso
  is 'Hora de generación del archivo, formato HH:MM:SS
';
comment on column IT.TA_CAR_DIA_ING_CAB.filler
  is 'Espacios';

