create table IT.GE_PAG_COM_CUENTAS
(
  cod_ente         NUMBER(5) not null,
  nro_cuenta       VARCHAR2(15),
  nro_referencia   VARCHAR2(20) not null,
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  tipo             VARCHAR2(1) default 'C' not null,
  cod_rubro        VARCHAR2(15),
  cod_ofi_rubro    NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_PAG_COM_CUENTAS
  is 'Cuentas para Pago Comercios';
comment on column IT.GE_PAG_COM_CUENTAS.cod_ente
  is 'Código de Ente (Procesadora).';
comment on column IT.GE_PAG_COM_CUENTAS.nro_cuenta
  is 'Número de Cuenta.';
comment on column IT.GE_PAG_COM_CUENTAS.nro_referencia
  is 'Número de Cuenta Equivalente en la Procesadora.';
comment on column IT.GE_PAG_COM_CUENTAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.GE_PAG_COM_CUENTAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_PAG_COM_CUENTAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAG_COM_CUENTAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.GE_PAG_COM_CUENTAS.tipo
  is 'Tipo de Cuenta (C=Cuenta Cliente, B=Rubro Contable)';
comment on column IT.GE_PAG_COM_CUENTAS.cod_rubro
  is 'Código de Cuenta Contable';
comment on column IT.GE_PAG_COM_CUENTAS.cod_ofi_rubro
  is 'Código de Oficina para los rubros contables (Bancard).';
alter table IT.GE_PAG_COM_CUENTAS
  add constraint PK_GE_PAG_COM_CUENTAS primary key (COD_ENTE, NRO_REFERENCIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_PAG_COM_CUENTAS
  add constraint FK_GPCUE_COD_ENTE foreign key (COD_ENTE)
  references IT.GE_ENTES (COD_ENTE);
alter table IT.GE_PAG_COM_CUENTAS
  add constraint FK_GPCUE_COD_RUBRO foreign key (COD_RUBRO)
  references IT.CB_RUBROS (COD_RUBRO);
alter table IT.GE_PAG_COM_CUENTAS
  add constraint FK_GPCUE_NRO_CUENTA foreign key (NRO_CUENTA)
  references IT.GE_CUENTAS (NRO_CUENTA);

