create table IT.MD_REPOVERSIONS
(
  revision NUMBER not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.MD_REPOVERSIONS
  is 'This table is used to version this schema for future requirements.';

