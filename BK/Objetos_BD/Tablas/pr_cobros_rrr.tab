create table IT.PR_COBROS_RRR
(
  cod_persona            VARCHAR2(10) not null,
  nro_cuenta             VARCHAR2(15) not null,
  fec_valor              DATE not null,
  sal_capital            NUMBER(18,2) default 0,
  sal_interes            NUMBER(18,2) default 0,
  mto_capital            NUMBER(18,2) default 0,
  mto_interes            NUMBER(18,2) default 0,
  mto_int_documentado    NUMBER(18,2) default 0,
  mto_int_moratorio      NUMBER(18,2) default 0,
  mto_int_mor_interes    NUMBER(18,2) default 0,
  mto_int_mor_adelantado NUMBER(18,2) default 0,
  mto_int_punitorio      NUMBER(18,2) default 0,
  mto_cargo              NUMBER(18,2) default 0,
  mto_impuesto           NUMBER(18,2) default 0,
  cod_moneda             VARCHAR2(3),
  dia_atraso             NUMBER(5),
  usu_insercion          VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion          DATE default SYSDATE not null,
  usu_modificacion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion       DATE default SYSDATE not null,
  nro_cuo_desde          NUMBER(3),
  nro_cuo_hasta          NUMBER(3),
  mto_pagado             NUMBER(18,2),
  nro_cta_renovada       VARCHAR2(15),
  mto_iva_devuelto       NUMBER(18,2),
  nro_sol_renovada       NUMBER(7)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.PR_COBROS_RRR
  is 'Se utiliza para simulación de los cobros para cálculos temporales de préstamos a Renovar(RRR)';
comment on column IT.PR_COBROS_RRR.cod_persona
  is 'Código de Persona.';
comment on column IT.PR_COBROS_RRR.nro_cuenta
  is 'Número de cuenta.';
comment on column IT.PR_COBROS_RRR.fec_valor
  is 'Fecha valor del cobro.';
comment on column IT.PR_COBROS_RRR.sal_capital
  is 'Saldo capital del préstamo en el momento del cobro.';
comment on column IT.PR_COBROS_RRR.sal_interes
  is 'Saldo interés del préstamo en el momento del cobro.';
comment on column IT.PR_COBROS_RRR.mto_capital
  is 'Monto capital cobrado.';
comment on column IT.PR_COBROS_RRR.mto_interes
  is 'Monto interés cobrado.';
comment on column IT.PR_COBROS_RRR.mto_int_documentado
  is 'Monto interés documentado cobrado.';
comment on column IT.PR_COBROS_RRR.mto_int_moratorio
  is 'Monto interés moratorio cobrado.';
comment on column IT.PR_COBROS_RRR.mto_int_mor_interes
  is 'Monto interes moratorio sobre interes vencido cobrado.';
comment on column IT.PR_COBROS_RRR.mto_int_mor_adelantado
  is 'Monto interés moratorio sobre interes adelantado vencido cobrado.';
comment on column IT.PR_COBROS_RRR.mto_int_punitorio
  is 'Monto interés punitorio cobrado.';
comment on column IT.PR_COBROS_RRR.mto_cargo
  is 'Monto del cargo cobrado.';
comment on column IT.PR_COBROS_RRR.mto_impuesto
  is 'Monto de impuestos cobrados.';
comment on column IT.PR_COBROS_RRR.cod_moneda
  is 'Código de moneda de la operación.';
comment on column IT.PR_COBROS_RRR.dia_atraso
  is 'Dias de atraso al momento del cálculo del pago a realizar para la operación RRR.';
comment on column IT.PR_COBROS_RRR.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.PR_COBROS_RRR.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.PR_COBROS_RRR.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.PR_COBROS_RRR.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';
comment on column IT.PR_COBROS_RRR.nro_cuo_desde
  is 'Número de Cuota desde para RRR Parcial';
comment on column IT.PR_COBROS_RRR.nro_cuo_hasta
  is 'Número de Cuota hasta para RRR Parcial';
comment on column IT.PR_COBROS_RRR.mto_pagado
  is 'Monto Pagado para RRR Parcial';
comment on column IT.PR_COBROS_RRR.nro_cta_renovada
  is 'Numero de Prestamo que fue renovado.';
comment on column IT.PR_COBROS_RRR.nro_sol_renovada
  is 'Numero de Solicitud Renovada';
alter table IT.PR_COBROS_RRR
  add constraint UK_PR_COBROS_RRR unique (COD_PERSONA, NRO_CUENTA, NRO_CTA_RENOVADA)
  using index 
  tablespace IT_DATA
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

