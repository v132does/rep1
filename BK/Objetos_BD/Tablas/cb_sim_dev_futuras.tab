create table IT.CB_SIM_DEV_FUTURAS
(
  nro_cuenta          VARCHAR2(15) not null,
  fecha               DATE not null,
  cod_modulo          NUMBER(3) not null,
  cod_modalidad       NUMBER(3) not null,
  cod_moneda          VARCHAR2(3) not null,
  cod_oficina         NUMBER(3) not null,
  nro_operacion       NUMBER(7) not null,
  estado              VARCHAR2(1) not null,
  val_tasa            NUMBER(20,4) not null,
  can_dia_interes     NUMBER(6) not null,
  mto_interes         NUMBER(18,2) default 0 not null,
  sal_acumulado       NUMBER(18,2) default 0 not null,
  mto_dev_anterior    NUMBER(18,2),
  mto_dev_acumulado   NUMBER(18,2) not null,
  cod_mad_transaccion NUMBER(3) not null,
  cod_mad_padre       NUMBER(3) not null,
  cod_ofi_origen      NUMBER(3) not null,
  descuento           VARCHAR2(1) default 'N' not null,
  usu_insercion       VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion       DATE default SYSDATE not null,
  usu_modificacion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion    DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CB_SIM_DEV_FUTURAS
  is 'Contiene los datos sobre los Intereses Devengados por Operaciones de Cambios a futuro.';
comment on column IT.CB_SIM_DEV_FUTURAS.nro_cuenta
  is 'Numero de cuenta de Cambios.';
comment on column IT.CB_SIM_DEV_FUTURAS.fecha
  is 'Fecha de devengamiento.';
comment on column IT.CB_SIM_DEV_FUTURAS.cod_modulo
  is 'Codigo del modulo de la cuenta de cambios.';
comment on column IT.CB_SIM_DEV_FUTURAS.cod_modalidad
  is 'Codigo de modalidad de la cuenta de cambios.';
comment on column IT.CB_SIM_DEV_FUTURAS.cod_moneda
  is 'Codigo de moneda.';
comment on column IT.CB_SIM_DEV_FUTURAS.cod_oficina
  is 'Codigo de la oficina de la cuenta de cambios.';
comment on column IT.CB_SIM_DEV_FUTURAS.nro_operacion
  is 'Nimero de operacion relacionada.';
comment on column IT.CB_SIM_DEV_FUTURAS.estado
  is 'Estado de la operacion (M/C).';
comment on column IT.CB_SIM_DEV_FUTURAS.val_tasa
  is 'Valor de la tasa aplicado.';
comment on column IT.CB_SIM_DEV_FUTURAS.can_dia_interes
  is 'Cantidad de dias del interes.';
comment on column IT.CB_SIM_DEV_FUTURAS.mto_interes
  is 'Interes devengado calculado.';
comment on column IT.CB_SIM_DEV_FUTURAS.sal_acumulado
  is 'Acumulado del saldo.';
comment on column IT.CB_SIM_DEV_FUTURAS.mto_dev_anterior
  is 'Interes devengado anterior.';
comment on column IT.CB_SIM_DEV_FUTURAS.mto_dev_acumulado
  is 'Devengamiento Acumulado.';
comment on column IT.CB_SIM_DEV_FUTURAS.cod_mad_transaccion
  is 'Codigo de la modalidad hija(compra o venta).';
comment on column IT.CB_SIM_DEV_FUTURAS.cod_mad_padre
  is 'Codigo de la modalidad padre(Op.futura o Swap).';
comment on column IT.CB_SIM_DEV_FUTURAS.cod_ofi_origen
  is 'Codigo de la oficina origen de la operacion.';
comment on column IT.CB_SIM_DEV_FUTURAS.descuento
  is 'Es un descuento (S/N).Indica si la op. tiene ganancia o perdida. (S=SI / N= NO).';
comment on column IT.CB_SIM_DEV_FUTURAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CB_SIM_DEV_FUTURAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CB_SIM_DEV_FUTURAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CB_SIM_DEV_FUTURAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
alter table IT.CB_SIM_DEV_FUTURAS
  add constraint PK_CB_SIM_DEV_FUTURAS primary key (NRO_CUENTA, FECHA, NRO_OPERACION)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

