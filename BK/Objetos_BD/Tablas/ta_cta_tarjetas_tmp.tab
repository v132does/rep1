create index IT.IN_TCTTM_NRO_CUENTA on IT.TA_CTA_TARJETAS_TMP (NRO_CUENTA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_TCTTM_NRO_CUENTA_01 on IT.TA_CTA_TARJETAS_TMP (TO_NUMBER(NRO_CUENTA))
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );

