create table IT.TA_CTA_TARJETAS_TMP
(
  nro_cuenta           VARCHAR2(15) not null,
  denominacion         VARCHAR2(65),
  cod_modulo           NUMBER(3),
  cod_modalidad        NUMBER(3),
  cod_oficina          NUMBER(4),
  cod_moneda           VARCHAR2(3),
  lin_credito          NUMBER(18,2) default 0,
  lin_cuotas           NUMBER(18,2) default 0,
  sal_facturar         NUMBER(18,2) default 0,
  sal_facturado        NUMBER(18,2) default 0,
  sal_financiado       NUMBER(18,2) default 0,
  sal_ult_extracto     NUMBER(18,2) default 0,
  sal_cuo_pendientes   NUMBER(18,2) default 0,
  mto_pag_minimo       NUMBER(18,2) default 0,
  sal_pag_minimo       NUMBER(18,2) default 0,
  mto_mora             NUMBER(18,2) default 0,
  dia_mora             NUMBER(14,2),
  mto_autorizaciones   NUMBER(18,2) default 0,
  mto_int_compras      NUMBER(18,2) default 0,
  mto_pag_mes          NUMBER(18,2) default 0,
  mto_gas_mora         NUMBER(18,2) default 0,
  estado               VARCHAR2(1),
  est_administradora   VARCHAR2(1),
  fec_solicitud        DATE,
  fec_apertura         DATE,
  fec_ult_pago         DATE,
  fec_ult_compra       DATE,
  fec_ult_operacion    DATE,
  fec_ult_extracto     DATE,
  fec_ult_cierre       DATE,
  fec_vct_ult_cierre   DATE,
  tip_cierre           VARCHAR2(2),
  cob_gas_financiero   VARCHAR2(1) default 'N',
  tip_tas_financiacion VARCHAR2(1),
  tip_com_emision      VARCHAR2(1),
  tas_financiacion     NUMBER(20,4) default 0,
  tas_adelanto         NUMBER(20,4) default 0,
  tas_mora             NUMBER(20,4) default 0,
  tas_cuotas           NUMBER(20,4) default 0,
  deb_automatico       VARCHAR2(1) default 'N',
  tip_cobro            VARCHAR2(1) default 'M',
  nro_cta_debito       VARCHAR2(15),
  mto_min_pago         NUMBER(18,2) default 0,
  por_pag_minimo       NUMBER(5,2) default 0,
  cod_usu_promotor     VARCHAR2(10),
  mar_mora             VARCHAR2(1),
  mar_excedido         VARCHAR2(1),
  mar_recuperado       VARCHAR2(1),
  mar_bloqueo          VARCHAR2(1),
  con_costo            VARCHAR2(1) default 'N',
  nro_solicitud        NUMBER(15),
  cod_causa            NUMBER(3),
  cat_automatica       NUMBER(2),
  cod_canal            NUMBER(3),
  cod_campana          NUMBER(3),
  en_juicio            VARCHAR2(1) default 'N',
  fec_juicio           DATE,
  cod_ent_juicio       NUMBER(5),
  max_atraso           NUMBER(5),
  pro_atraso           NUMBER(5),
  nro_linea            NUMBER(7),
  sit_cuenta           NUMBER(1),
  cod_sucursal         NUMBER(4),
  nro_reg              NUMBER(10),
  cod_usu_ente         VARCHAR2(10),
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  cod_ent_procesadora  NUMBER(5),
  cod_afinidad         VARCHAR2(6),
  det_error            VARCHAR2(4000),
  mto_fij_pag_minimo   NUMBER(18,2),
  mto_min_pag_minimo   NUMBER(18,2),
  tas_int_corriente    NUMBER(18,2),
  tas_int_compra       NUMBER(18,2),
  tas_int_mora         NUMBER(18,2),
  tip_doc_bancard      VARCHAR2(3),
  nro_documento        VARCHAR2(20),
  car_no_aplicar       VARCHAR2(30),
  ret_extracto         VARCHAR2(1),
  mot_ret_extracto     NUMBER(3)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.TA_CTA_TARJETAS_TMP
  is 'Es la tabla temporal de Cuentas de Tarjetas, aqui se reciben los datos desde las procesadoras.';
comment on column IT.TA_CTA_TARJETAS_TMP.nro_cuenta
  is 'Numero de la Cuenta de Tarjeta.';
