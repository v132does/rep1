create table IT.CO_LOG_ASIGNACIONES
(
  nom_proceso      VARCHAR2(50),
  hor_inicio       DATE,
  hor_fin          DATE,
  nro_registro     NUMBER(10),
  nro_error        NUMBER(5),
  msg_error        VARCHAR2(500),
  comentario       VARCHAR2(4000),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CO_LOG_ASIGNACIONES
  is 'Logs de Asignaciones de Cobranzas.';
comment on column IT.CO_LOG_ASIGNACIONES.nom_proceso
  is 'Nombre del Proceso que provocó el Suceso.';
comment on column IT.CO_LOG_ASIGNACIONES.hor_inicio
  is 'Hora de inicio del Proceso.';
comment on column IT.CO_LOG_ASIGNACIONES.hor_fin
  is 'Hora de finalización del Proceso.';
comment on column IT.CO_LOG_ASIGNACIONES.nro_registro
  is 'Número de Registro dentro del Proceso.';
comment on column IT.CO_LOG_ASIGNACIONES.nro_error
  is 'Código del Error Oracle.';
comment on column IT.CO_LOG_ASIGNACIONES.msg_error
  is 'Mensaje de Error Oracle.';
comment on column IT.CO_LOG_ASIGNACIONES.comentario
  is 'Comentarios del Proceso acerca del Suceso.';
comment on column IT.CO_LOG_ASIGNACIONES.usu_insercion
  is 'Usuario que realizó la inserción del registro.';
comment on column IT.CO_LOG_ASIGNACIONES.fec_insercion
  is 'Fecha en que se insertó el registro.';
comment on column IT.CO_LOG_ASIGNACIONES.usu_modificacion
  is 'Usuario que realizó la última modificación en el registro.';
comment on column IT.CO_LOG_ASIGNACIONES.fec_modificacion
  is 'Fecha en que se realizó la última modificación en el registro.';

