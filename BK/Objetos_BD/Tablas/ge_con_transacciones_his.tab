create table IT.GE_CON_TRANSACCIONES_HIS
(
  fecha            DATE,
  cod_mod_padre    NUMBER(3),
  cod_mad_padre    NUMBER(3),
  cod_ofi_origen   NUMBER(3),
  cod_oficina      NUMBER(3),
  cod_moneda       VARCHAR2(3),
  cod_modulo       NUMBER(3),
  cod_modalidad    NUMBER(3),
  cod_transaccion  NUMBER(4),
  cod_sector       VARCHAR2(1),
  cod_tip_deudor   NUMBER(2),
  residente        VARCHAR2(1),
  cod_plazo        NUMBER(1),
  cantidad         NUMBER(8),
  total            NUMBER(18,2),
  tot_mon_local    NUMBER(22,2),
  nro_referencia   NUMBER(10),
  usu_insercion    VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion    DATE default SYSDATE not null,
  usu_modificacion VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion DATE default SYSDATE not null,
  est_cuenta       VARCHAR2(1),
  tip_cuenta       VARCHAR2(1),
  tip_interes      VARCHAR2(1),
  tip_renovacion   VARCHAR2(1),
  cat_automatica   NUMBER(3,2),
  fec_valor        DATE,
  cod_tra_padre    NUMBER(4),
  cod_sit_contable NUMBER(20),
  nro_cuenta       VARCHAR2(20),
  concepto         VARCHAR2(100),
  cod_sec_rubro    VARCHAR2(3),
  reversado        VARCHAR2(1)
)
tablespace IT_HIS
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.GE_CON_TRANSACCIONES_HIS
  is 'Consolidado de Transacciones ** GE_CON_TRANSACCIONES_HIS **';
comment on column IT.GE_CON_TRANSACCIONES_HIS.fecha
  is 'Fecha de Transaccion.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_mod_padre
  is 'Codigo de Modulo Padre.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_mad_padre
  is 'Codigo de Modalidad Padre.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_ofi_origen
  is 'Codigo de Oficina de Origen.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_oficina
  is 'Codigo de Oficina.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_moneda
  is 'Moneda de la Transaccion.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_modulo
  is 'Codigo de Modulo.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_modalidad
  is 'Codigo de Modalidad.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_transaccion
  is 'Codigo de Transaccion.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_sector
  is 'Codigo de Sector.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_tip_deudor
  is 'Tipo de deudor. ( ).';
comment on column IT.GE_CON_TRANSACCIONES_HIS.residente
  is 'IND_RESIDENTE. (N=NO / S=SI).';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_plazo
  is 'Codigo de Plazo.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cantidad
  is 'Cantidad de transacciones.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.total
  is 'Total de la transaccion.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.tot_mon_local
  is 'Total moneda local.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.nro_referencia
  is 'Nro de Referencia.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.usu_insercion
  is 'Usuario que realiza la insercion del registro.';
comment on column IT.GE_CON_TRANSACCIONES.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.usu_modificacion
  is 'Usuario que realiza la ultima modificacion en el registro.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.fec_modificacion
  is 'Fecha en que se realiza la ultima modificacion en el registro.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.est_cuenta
  is 'Estado de la cuenta.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.tip_cuenta
  is 'Tipo de cuenta.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.tip_interes
  is 'Tipo de interes.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.tip_renovacion
  is 'Tipo de renovacion.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cat_automatica
  is 'Categoria automatica.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.fec_valor
  is 'Fecha Valor de Transaccion.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_tra_padre
  is 'Codigo de Transaccion Padre.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_sit_contable
  is 'Situacion contable de la operacion';
comment on column IT.GE_CON_TRANSACCIONES_HIS.nro_cuenta
  is 'Nro de Cuenta si la operacion es detallada';
comment on column IT.GE_CON_TRANSACCIONES_HIS.concepto
  is 'Concepto de la operacion detallada';
comment on column IT.GE_CON_TRANSACCIONES_HIS.cod_sec_rubro
  is 'Codigo de Sector para Rubro.';
comment on column IT.GE_CON_TRANSACCIONES_HIS.reversado
  is 'Movimiento Reversado S/N ';
  
create index IT.IN_GCTRAH_COD_MOD_PADRE on IT.GE_CON_TRANSACCIONES_HIS (COD_MOD_PADRE, COD_MODULO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 320K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GCTRAH_FECHA on IT.GE_CON_TRANSACCIONES_HIS (FECHA, NRO_REFERENCIA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 2M
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.IN_GCTRAH_FECHA1 on IT.GE_CON_TRANSACCIONES_HIS (FECHA, COD_TRANSACCION, COD_MONEDA, COD_OFI_ORIGEN, COD_OFICINA, COD_MOD_PADRE, COD_MODALIDAD, COD_SECTOR, COD_TIP_DEUDOR, RESIDENTE, COD_PLAZO, REVERSADO)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.GE_CON_TRANSACCIONES_HIS
  add constraint FK_GCTRAH_COD_MOD_PADRE foreign key (COD_MOD_PADRE, COD_MAD_PADRE)
  references IT.GE_MODALIDADES (COD_MODULO, COD_MODALIDAD);
alter table IT.GE_CON_TRANSACCIONES_HIS
  add constraint FK_GCTRAH_COD_MONEDA foreign key (COD_MONEDA)
  references IT.BA_MONEDAS (COD_MONEDA);
alter table IT.GE_CON_TRANSACCIONES_HIS
  add constraint FK_GCTRAH_COD_OFICINA foreign key (COD_OFICINA)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CON_TRANSACCIONES_HIS
  add constraint FK_GCTRAH_COD_OFI_ORIGEN foreign key (COD_OFI_ORIGEN)
  references IT.BA_OFICINAS (COD_OFICINA);
alter table IT.GE_CON_TRANSACCIONES_HIS
  add constraint FK_GCTRAH_COD_TRANSACCIONES foreign key (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD)
  references IT.GE_TRANSACCIONES (COD_TRANSACCION, COD_MODULO, COD_MODALIDAD);
