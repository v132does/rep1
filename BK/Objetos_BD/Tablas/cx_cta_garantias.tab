create table IT.CX_CTA_GARANTIAS
(
  nro_cuenta           VARCHAR2(15) not null,
  cod_garantia         NUMBER(3) not null,
  nro_garantia         NUMBER(7),
  mto_aplicado         NUMBER(18,2) default 0 not null,
  usu_insercion        VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_insercion        DATE default SYSDATE not null,
  usu_modificacion     VARCHAR2(10) default SUBSTR(USER,1,10) not null,
  fec_modificacion     DATE default SYSDATE not null,
  mto_apl_computable   NUMBER(18,2),
  cod_persona          VARCHAR2(10),
  mto_riesgo           NUMBER(18,2),
  mto_con_computable   NUMBER(18,2),
  mto_con_nocomputable NUMBER(18,2)
)
tablespace IT_DATA
  pctfree 10
  initrans 1
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
comment on table IT.CX_CTA_GARANTIAS
  is 'Contiene los datos de las garantias por Ctas de Comercio Exterior';
comment on column IT.CX_CTA_GARANTIAS.nro_cuenta
  is 'Numero de Cuenta';
comment on column IT.CX_CTA_GARANTIAS.cod_garantia
  is 'Tipo de Garantia';
comment on column IT.CX_CTA_GARANTIAS.nro_garantia
  is 'Numero de la garantia asociada o codigo de cliente (codeudor)';
comment on column IT.CX_CTA_GARANTIAS.mto_aplicado
  is 'Monto de garantia que cubre a la operacion';
comment on column IT.CX_CTA_GARANTIAS.usu_insercion
  is 'Usuario que realizo la insercion del registro.';
comment on column IT.CX_CTA_GARANTIAS.fec_insercion
  is 'Fecha en que se inserto el registro.';
comment on column IT.CX_CTA_GARANTIAS.usu_modificacion
  is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CX_CTA_GARANTIAS.fec_modificacion
  is 'Fecha en que se realizo la ultima modificacion en el registro.';
comment on column IT.CX_CTA_GARANTIAS.mto_apl_computable
  is 'Monto de aplicado de la garantia.';
comment on column IT.CX_CTA_GARANTIAS.cod_persona
  is 'Código del cliente.';
comment on column IT.CX_CTA_GARANTIAS.mto_riesgo
  is 'Monto de riesgo del cliente.';
comment on column IT.CX_CTA_GARANTIAS.mto_con_computable
  is 'Monto contable computable.';
comment on column IT.CX_CTA_GARANTIAS.mto_con_nocomputable
  is 'Monto contable no computable.';
create index IT.BBVA_INX_CX_CTA_GARA on IT.CX_CTA_GARANTIAS (NRO_GARANTIA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
create index IT.BBVA_INX_CX_PER_GARA on IT.CX_CTA_GARANTIAS (COD_PERSONA)
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CX_CTA_GARANTIAS
  add constraint UK_CX_CTA_GARANTIAS unique (NRO_CUENTA, NRO_GARANTIA, COD_GARANTIA)
  using index 
  tablespace IT_IND
  pctfree 10
  initrans 2
  maxtrans 255
  storage
  (
    initial 64K
    next 1M
    minextents 1
    maxextents unlimited
  );
alter table IT.CX_CTA_GARANTIAS
  add constraint FK_CCGAR_COD_GARANTIA foreign key (COD_GARANTIA)
  references IT.PR_GAR_TIPOS (COD_GARANTIA);
alter table IT.CX_CTA_GARANTIAS
  add constraint AVCON_1173794793_COD_G_000
  check (COD_GARANTIA BETWEEN 0 AND 999);
alter table IT.CX_CTA_GARANTIAS
  add constraint AVCON_1176406332_COD_G_000
  check (COD_GARANTIA BETWEEN 0 AND 999);

