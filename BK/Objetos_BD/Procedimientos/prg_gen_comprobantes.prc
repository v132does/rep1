create or replace procedure it.prg_gen_comprobantes(p_tip_comprobante   in ge_comprobantes.tip_comprobante%TYPE,
                                                    p_fecha             in ge_comprobantes.fecha%TYPE,
                                                    p_hora              in ge_comprobantes.hora%TYPE,
                                                    p_nro_secuencia     in ge_comprobantes.nro_secuencia%TYPE,
                                                    p_cod_usuario       in ge_comprobantes.cod_usuario%TYPE,
                                                    p_concepto          in ge_comprobantes.concepto%TYPE,
                                                    p_nro_transaccion   in ge_comprobantes.nro_transaccion%TYPE,
                                                    p_cod_moneda        in ge_comprobantes.cod_moneda%TYPE,
                                                    p_monto             in ge_comprobantes.monto%TYPE,
                                                    p_cod_per_debito    in ge_comprobantes.cod_per_debito%TYPE,
                                                    p_nro_cta_debito    in ge_comprobantes.nro_cta_debito%TYPE,
                                                    p_cod_ent_deb_swift in ge_comprobantes.cod_ent_deb_swift%TYPE,
                                                    p_nro_cta_destino   in ge_comprobantes.nro_cta_destino%TYPE,
                                                    p_tit_destino       in ge_comprobantes.tit_destino%TYPE,
                                                    p_nro_doc_destino   in ge_comprobantes.nro_doc_destino%TYPE,
                                                    p_cod_ent_cre_swift in ge_comprobantes.cod_ent_cre_swift%TYPE,
                                                    p_fec_transferencia in ge_comprobantes.fec_transferencia%TYPE,
                                                    p_hor_transferencia in ge_comprobantes.hor_transferencia%TYPE,
                                                    p_categoria         in ge_comprobantes.categoria%TYPE,
                                                    p_subcategoria      in ge_comprobantes.subcategoria%TYPE,
                                                    p_servicio          in ge_comprobantes.servicio%TYPE,
                                                    p_nro_cuenta        in ge_comprobantes.nro_cuenta%TYPE,
                                                    p_nro_cuota         in ge_comprobantes.nro_cuota%TYPE,
                                                    p_nro_tarjeta       in ge_comprobantes.nro_tarjeta%TYPE,
                                                    p_tip_transaccion   in ge_comprobantes.tip_transaccion%TYPE,
                                                    p_comercio          in ge_comprobantes.comercio%TYPE default null,
                                                    p_depositante       in ge_comprobantes.depositante%TYPE default null,
                                                    p_detalles          in ge_comprobantes.detalles%TYPE default null,
                                                    p_referencia1       in ge_comprobantes.referencia1%TYPE default null,
                                                    p_referencia2       in ge_comprobantes.referencia2%TYPE default null,
                                                    p_referencia3       in ge_comprobantes.referencia3%TYPE default null,
                                                    p_referencia4       in ge_comprobantes.referencia4%TYPE default null,
                                                    p_referencia5       in ge_comprobantes.referencia5%TYPE default null,
                                                    p_estado            in ge_comprobantes.estado%type default 'S',
                                                    p_reversado         in ge_comprobantes.reversado%type default 'N') is
  v_nro_comprobante ge_comprobantes.nro_comprobante%TYPE;
begin
  --nro de secuencia para el comprobante
  select nvl(max(s.nro_comprobante), 0) + 1
    into v_nro_comprobante
    from ge_comprobantes s;

  insert into ge_comprobantes
    (nro_comprobante,
     tip_comprobante,
     fecha,
     hora,
     nro_secuencia,
     cod_usuario,
     concepto,
     nro_transaccion,
     cod_moneda,
     monto,
     nro_cta_debito,
     cod_per_debito,
     cod_ent_deb_swift,
     nro_cta_destino,
     tit_destino,
     nro_doc_destino,
     cod_ent_cre_swift,
     fec_transferencia,
     hor_transferencia,
     categoria,
     subcategoria,
     servicio,
     nro_cuenta,
     nro_cuota,
     nro_tarjeta,
     tip_transaccion,
     comercio,
     depositante,
     detalles,
     referencia1,
     referencia2,
     referencia3,
     referencia4,
     referencia5,
     estado,
     reversado)
  values
    (v_nro_comprobante,
     p_tip_comprobante,
     p_fecha,
     p_hora,
     p_nro_secuencia,
     p_cod_usuario,
     p_concepto,
     p_nro_transaccion,
     p_cod_moneda,
     p_monto,
     p_nro_cta_debito,
     p_cod_per_debito,
     p_cod_ent_deb_swift,
     p_nro_cta_destino,
     p_tit_destino,
     p_nro_doc_destino,
     p_cod_ent_cre_swift,
     p_fec_transferencia,
     p_hor_transferencia,
     p_categoria,
     p_subcategoria,
     p_servicio,
     p_nro_cuenta,
     p_nro_cuota,
     p_nro_tarjeta,
     p_tip_transaccion,
     p_comercio,
     p_depositante,
     p_detalles,
     p_referencia1,
     p_referencia2,
     p_referencia3,
     p_referencia4,
     p_referencia5,
     p_estado,
     p_reversado);

exception
  when others then
    prg_ins_log_programas('PRG_GEN_COMPROBANTES',
                          substr('Error al cargar el comprobante ' ||
                                 p_nro_transaccion || ' ' ||
                                 p_tip_comprobante || ' ' || p_fecha || '-' ||
                                 p_hora || '-' || p_nro_secuencia || '-' ||
                                 p_cod_usuario || ' ' || SQLERRM,
                                 1,
                                 4000),
                          p_cod_per_debito,
                          p_nro_cta_debito);
end prg_gen_comprobantes;
/

