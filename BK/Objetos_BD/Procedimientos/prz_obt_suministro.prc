CREATE OR REPLACE PROCEDURE IT.PRZ_OBT_SUMINISTRO
 (P_COD_SUMINISTRO IN IN_SUMINISTROS.COD_SUMINISTRO%TYPE
 ,RP_PV_SUMINISTRO IN OUT IN_SUMINISTROS%ROWTYPE
 )
 IS
BEGIN
   SELECT *
   INTO   RP_PV_SUMINISTRO
   FROM   IN_SUMINISTROS
   WHERE  COD_SUMINISTRO = P_COD_SUMINISTRO;
EXCEPTION
   WHEN NO_DATA_FOUND THEN
      raise_application_error(-20000,
      'No existe Suministro '||to_char(P_COD_SUMINISTRO));
   WHEN OTHERS THEN
      raise_application_error(-20000,
      'Rec.Suministro '||to_char(P_COD_SUMINISTRO)||' '||sqlerrm);
END;
/

