CREATE OR REPLACE PROCEDURE IT.PRL_INS_REG_MOV_SEPRELAD
 (P_FECHA  IN GE_MOVIMIENTOS.FECHA%TYPE,
 P_HORA IN GE_MOVIMIENTOS.HORA%TYPE,
 P_COD_USUARIO IN GE_MOVIMIENTOS.COD_USUARIO%TYPE,
 P_SECUENCIA IN GE_MOVIMIENTOS.NRO_SECUENCIA%TYPE,
 P_MONTO IN GE_MOVIMIENTOS.MONTO%TYPE,
 P_COD_MONEDA IN GE_MOVIMIENTOS.COD_MONEDA%TYPE,
 P_COD_OFICINA IN GE_MOVIMIENTOS.COD_OFICINA%TYPE,
 P_COD_TRA_PADRE IN GE_MOVIMIENTOS.COD_TRA_PADRE%TYPE,
 P_COD_MOD_PADRE IN GE_MOVIMIENTOS.COD_MOD_PADRE%TYPE,
 P_COD_MAD_PADRE IN GE_MOVIMIENTOS.COD_MAD_PADRE%TYPE,
 P_COD_TRANSACCION IN GE_MOVIMIENTOS.COD_TRANSACCION%TYPE,
 P_COD_MODULO IN GE_MOVIMIENTOS.COD_MODULO%TYPE,
 P_COD_MODALIDAD IN GE_MOVIMIENTOS.COD_MODALIDAD%TYPE,
 P_MTO_EQU_LOCAL IN GE_MOVIMIENTOS.MTO_EQU_LOCAL%TYPE,
 P_NRO_CAJA IN GE_MOVIMIENTOS.NRO_CAJA%TYPE,
 P_COTIZACION IN GE_MOVIMIENTOS.COTIZACION%TYPE,
 P_NRO_DOCUMENTO IN GE_MOVIMIENTOS.NRO_DOCUMENTO%TYPE,
 P_NRO_OPE_CAJA IN GE_MOVIMIENTOS.NRO_DOCUMENTO4%TYPE,
 P_COD_PERSONA  IN BA_PERSONAS.COD_PERSONA%TYPE)

IS
PRAGMA AUTONOMOUS_TRANSACTION;
  /*VARIABLES*/ 
BEGIN
          INSERT INTO GE_REG_MOV_SEPRELAD
         (FECHA, HORA, COD_USUARIO, SECUENCIA, MONTO, COD_MONEDA, COD_OFICINA, COD_TRA_PADRE, 
          COD_MOD_PADRE, COD_MAD_PADRE, COD_TRANSACCION, COD_MODULO, COD_MODALIDAD, MTO_EQU_LOCAL, 
          NRO_CAJA, COTIZACION, NRO_DOCUMENTO, NRO_OPE_CAJA, COD_PERSONA)
      VALUES
         (P_FECHA, P_HORA, P_COD_USUARIO, P_SECUENCIA, P_MONTO, P_COD_MONEDA, P_COD_OFICINA, P_COD_TRA_PADRE, 
          P_COD_MOD_PADRE, P_COD_MAD_PADRE, P_COD_TRANSACCION, P_COD_MODULO, P_COD_MODALIDAD, P_MTO_EQU_LOCAL, 
          P_NRO_CAJA, P_COTIZACION, P_NRO_DOCUMENTO, P_NRO_OPE_CAJA, P_COD_PERSONA);
          COMMIT;
EXCEPTION
  WHEN OTHERS THEN
    IF SQLCODE <= -20000 THEN
      RAISE;
    ELSE
      RAISE_APPLICATION_ERROR(-20000,'INSERT EN PRL_INS_REG_MOV_SEPRELAD '||SQLERRM);
    END IF;
END;
/

