CREATE OR REPLACE PROCEDURE IT.PRL_OBT_POS_ANTERIOR
 (P_TIP_POSICION IN VARCHAR2
 ,P_COD_OFI_CAMBIO IN BA_OFICINAS.COD_OFICINA%TYPE
 ,P_COD_MONEDA IN BA_MONEDAS.COD_MONEDA%TYPE
 ,P_MONTO OUT GE_MOVIMIENTOS.MONTO%TYPE
 ,P_MTO_EQUIVALENTE OUT GE_MOVIMIENTOS.MTO_EQU_LOCAL%TYPE
 )
 IS
 v_cotizacion ge_cotizaciones.val_conversion%type;
begin
 SELECT DECODE(LC_SAL_POSICIONES.TIP_POSICION,'E',
              (NVL(LC_SAL_POSICIONES.MTO_EFE_COMPRA,0) - NVL(LC_SAL_POSICIONES.MTO_EFE_VENTA,0)),
              (NVL(LC_SAL_POSICIONES.MTO_NEF_COMPRA,0) - NVL(LC_SAL_POSICIONES.MTO_NEF_VENTA,0))),
        DECODE(LC_SAL_POSICIONES.TIP_POSICION,'E',NVL(LC_SAL_POSICIONES.COT_EFECTIVO,0),
               NVL(LC_SAL_POSICIONES.COT_NO_EFECTIVO,0)) COTIZACION
    INTO p_monto, v_cotizacion
    FROM LC_SAL_POSICIONES
   WHERE COD_MONEDA = P_COD_MONEDA
     AND TIP_POSICION = P_TIP_POSICION
     AND COD_OFI_CAMBIO = P_COD_OFI_CAMBIO;
  p_mto_equivalente := round(p_monto * v_cotizacion,fug_obt_pardinamico('VAL_RED_MON_EXTRANJERA',7,71,pag_gen.fu_obt_mon_local));
EXCEPTION
  WHEN OTHERS THEN
    p_monto := 0;
    P_MTO_EQUIVALENTE := 0;
end;
/

