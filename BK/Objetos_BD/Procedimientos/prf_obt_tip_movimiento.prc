CREATE OR REPLACE PROCEDURE IT.PRF_OBT_TIP_MOVIMIENTO
 (P_COD_TIP_MOVIMIENTO  IN AF_TIP_MOVIMIENTOS.COD_TIP_MOVIMIENTO%TYPE
 ,P_COD_MOVIMIENTO      IN AF_TIP_MOVIMIENTOS.COD_MOVIMIENTO%TYPE
 ,RP_AF_TIP_MOVIMIENTO  IN OUT AF_TIP_MOVIMIENTOS%ROWTYPE
 )
 IS
BEGIN
   SELECT *
   INTO   RP_AF_TIP_MOVIMIENTO
   FROM   Af_Tip_Movimientos
   WHERE  COD_TIP_MOVIMIENTO = P_COD_TIP_MOVIMIENTO
   AND    COD_MOVIMIENTO     = P_COD_MOVIMIENTO;
EXCEPTION
   WHEN NO_DATA_FOUND THEN
      raise_application_error(-20000,
      'No existe Tipo de Movimiento '||to_char(P_COD_TIP_MOVIMIENTO));
   WHEN OTHERS THEN
      raise_application_error(-20000,
      'Rec.Tipo de Movimiento '||to_char(P_COD_TIP_MOVIMIENTO)||' '||sqlerrm);
END;
/

