CREATE OR REPLACE PROCEDURE IT.PRA_INS_AH_RETENCION
 (P_RETENCION IN OUT AH_RETENCIONES%ROWTYPE
 )
 IS
BEGIN
   INSERT INTO AH_RETENCIONES(COD_MODULO,COD_MODALIDAD,COD_OFICINA,NRO_CUENTA,
                             COD_OFI_ORIGEN,NRO_DOCUMENTO,COD_RETENCION,
                             COD_MONEDA,MONTO,FEC_INICIO,FEC_FINAL,                         COD_USUARIO,
                             LIBERADO,DETALLADO,LIB_POSTERIOR,SAL_RETENIDO)
                     VALUES (P_RETENCION.COD_MODULO,P_RETENCION.COD_MODALIDAD,
                             P_RETENCION.COD_OFICINA,P_RETENCION.NRO_CUENTA,
                             P_RETENCION.COD_OFI_ORIGEN,P_RETENCION.NRO_DOCUMENTO,
                             P_RETENCION.COD_RETENCION,P_RETENCION.COD_MONEDA,
                             P_RETENCION.MONTO,P_RETENCION.FEC_INICIO,
                             P_RETENCION.FEC_FINAL,P_RETENCION.COD_USUARIO,
                             P_RETENCION.LIBERADO,P_RETENCION.DETALLADO,
                             P_RETENCION.LIB_POSTERIOR,P_RETENCION.SAL_RETENIDO);

END;
/

