CREATE OR REPLACE PROCEDURE IT.PRA_ACT_EST_BATCH
 (P_FECHA IN GE_MOVIMIENTOS.FECHA%TYPE
 ,P_COD_OFICINA IN GE_MOVIMIENTOS.COD_OFICINA%TYPE
 ,P_NRO_CUENTA IN GE_MOVIMIENTOS.NRO_CUENTA%TYPE
 ,P_COD_MODALIDAD IN GE_MOVIMIENTOS.COD_MODALIDAD%TYPE
 ,P_MONTO IN GE_MOVIMIENTOS.MONTO%TYPE
 ,P_EST_CUENTA IN GE_MOVIMIENTOS.EST_CUENTA%TYPE
 ,P_REVERSADO IN GE_MOVIMIENTOS.REVERSADO%TYPE
 ,P_TIP_MOV_RUBRO IN GE_MOVIMIENTOS.TIP_MOV_RUBRO%TYPE
 ,P_AFECTA IN GE_TRANSACCIONES.AFECTA%TYPE
 )
 IS
BEGIN
   IF P_COD_MODALIDAD in (31,334) THEN
      UPDATE AH_CTA_VISTAS SET EST_BATCH = DECODE(P_REVERSADO,'N',P_EST_CUENTA,ESTADO)
       WHERE NRO_CUENTA = P_NRO_CUENTA;
      IF sql%notfound THEN
         RAISE_APPLICATION_ERROR(-20000,'No existe dato en Ahorro a la Vista, # '||P_NRO_CUENTA);
      END IF;
   END IF;
   IF P_COD_MODALIDAD in (32,37,38) THEN
      UPDATE AH_CTA_PLAZOS SET EST_BATCH = DECODE(P_REVERSADO,'N',P_EST_CUENTA,ESTADO)
       WHERE NRO_CUENTA = P_NRO_CUENTA;
      IF sql%notfound THEN
         RAISE_APPLICATION_ERROR(-20000,'No existe dato en Ahorro a Plazo Fijo, # '||P_NRO_CUENTA);
      END IF;
   END IF;
   IF P_COD_MODALIDAD IN (33,34,35,36) THEN
      UPDATE AH_CTA_CERTIFICADOS SET EST_BATCH = DECODE(P_REVERSADO,'N',P_EST_CUENTA,ESTADO)
       WHERE NRO_CUENTA = P_NRO_CUENTA;
      IF sql%notfound THEN
         RAISE_APPLICATION_ERROR(-20000,'No existe dato en Certificados, # '||P_NRO_CUENTA);
      END IF;
   END IF;
   IF P_COD_MODALIDAD = 41 THEN
      UPDATE CC_CTA_CORRIENTES SET EST_BATCH = DECODE(P_REVERSADO,'N',P_EST_CUENTA,ESTADO)
       WHERE NRO_CUENTA = P_NRO_CUENTA ;
      IF sql%notfound THEN
         RAISE_APPLICATION_ERROR(-20000,'No existe dato en Cuenta Corriente, # '||P_NRO_CUENTA);
      END IF;
   END IF;
   IF P_COD_MODALIDAD IN (42,43,44,45,46,47,48,49,442,455)  THEN --WA:26/02/2014(455) para SIPAP
      UPDATE CC_CTA_BANCARIAS SET EST_BATCH = DECODE(P_REVERSADO,'N',P_EST_CUENTA,ESTADO)
       WHERE NRO_CUENTA = P_NRO_CUENTA ;
      IF sql%notfound THEN
         RAISE_APPLICATION_ERROR(-20000,'No existe dato en Cuenta Bancaria, # '||P_NRO_CUENTA);
      END IF;
   END IF;
EXCEPTION
   WHEN OTHERS THEN
      RAISE_APPLICATION_ERROR(-20000,'ERROR.PRA_ACT_EST_BATCH'||sqlerrm
                                   ||'-'||P_COD_MODALIDAD
                                   ||'-'||P_COD_OFICINA||'-'||P_NRO_CUENTA
                                   ||' ESTADO: '||P_EST_CUENTA);
END;
/

