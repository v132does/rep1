CREATE OR REPLACE PROCEDURE IT.prg_imp_dat_informconf is
BEGIN
  --1)PROCESO DIARIO DE ENVIO DE DATOS
    PAO_MOR.PR_PRO_INF_DIARIO;
  --2)VERIFICAR POSIBLES ERRORES
    PAO_MOR.PR_CTL_INF_PROCESO;
  --3)CONFIRMAR ENVIO DE DATOS DEL DIA
    PAO_MOR.PR_PRO_INF_CONFIRMAR;
  --4)VERIFICAR POSIBLES ERRORES
    PAO_MOR.PR_CTL_INF_PROCESO;
EXCEPTION
    WHEN OTHERS THEN
         NULL;
END prg_imp_dat_informconf;
/

