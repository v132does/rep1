-- Estándar D.E.01 §1.10.1: TB_<tabla> (Before)
CREATE OR REPLACE TRIGGER IT.TB_SB_SOL_AUDITORIA
BEFORE INSERT ON IT.SB_SOL_AUDITORIA
FOR EACH ROW
BEGIN
    IF :NEW.id_auditoria IS NULL THEN
        SELECT IT.S_ID_AUDITORIA.NEXTVAL
          INTO :NEW.id_auditoria
          FROM DUAL;
    END IF;
END TB_SB_SOL_AUDITORIA;
/
