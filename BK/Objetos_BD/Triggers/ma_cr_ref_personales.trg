CREATE OR REPLACE TRIGGER IT.MA_CR_REF_PERSONALES
 AFTER DELETE OR INSERT OR UPDATE
 ON CR_REF_PERSONALES
 FOR EACH ROW
declare
  v_cod_tip_documento MI_IT_BA_PERSONAS_01.COD_TIP_DOCUMENTO%TYPE;
  v_nro_documento     MI_IT_BA_PERSONAS_01.NRO_DOCUMENTO%TYPE; 
begin
   -- Registrar campos de migracion
   if inserting then
      PRA_ACT_MI_IT_BA_PERSONAS_01(:new.COD_PERSONA,
                                    v_cod_tip_documento,
                                    v_nro_documento);


      insert
      into MI_IT_CR_REF_PERSONALES
            (
                COD_PERSONA,
                COD_TIP_DOCUMENTO,
                NRO_DOCUMENTO,
                COD_REFERENCIA, 
                TIP_REFERENCIA, 
                NRO_SECUENCIA, 
                NOM_PERSONA, 
                TELEFONOS, 
                LUG_TRABAJO, 
                PUESTO, 
                REL_PERSONA, 
                OBSERVACION, 
                EST_VERIFICACION, 
                CONOCE, 
                REC_MENSAJE, 
                CNF_DAT_PARTICULARES, 
                CNF_DAT_LABORALES, 
                COD_USU_VERIFICADOR, 
                OBS_VERIFICACION, 
                FEC_VERIFICACION, 
                COD_INF_LABORAL, 
                NOM_PER_INFORMO, 
                CAR_PER_INFORMO, 
                NOM_PER_CERTIFICO, 
                CAR_PER_CERTIFICO, 
                COD_PAIS, 
                COD_CIUDAD, 
                DIRECCION,
                USU_INSERCION,
                FEC_INSERCION,
                USU_MODIFICACION,
                FEC_MODIFICACION,
                EST_MIGRACION
             )
       values
           (
                :new.COD_PERSONA,
                v_cod_tip_documento,
                v_nro_documento,
                :new.COD_REFERENCIA, 
                :new.TIP_REFERENCIA, 
                :new.NRO_SECUENCIA, 
                :new.NOM_PERSONA, 
                :new.TELEFONOS, 
                :new.LUG_TRABAJO, 
                :new.PUESTO, 
                :new.REL_PERSONA, 
                :new.OBSERVACION, 
                :new.EST_VERIFICACION, 
                :new.CONOCE, 
                :new.REC_MENSAJE, 
                :new.CNF_DAT_PARTICULARES, 
                :new.CNF_DAT_LABORALES, 
                :new.COD_USU_VERIFICADOR, 
                :new.OBS_VERIFICACION, 
                :new.FEC_VERIFICACION, 
                :new.COD_INF_LABORAL, 
                :new.NOM_PER_INFORMO, 
                :new.CAR_PER_INFORMO, 
                :new.NOM_PER_CERTIFICO, 
                :new.CAR_PER_CERTIFICO, 
                :new.COD_PAIS, 
                :new.COD_CIUDAD, 
                :new.DIRECCION,
                :new.USU_INSERCION,
                :new.FEC_INSERCION,
                :new.USU_MODIFICACION,
                :new.FEC_MODIFICACION,
                'I');
   elsif updating then
      PRA_ACT_MI_IT_BA_PERSONAS_01(:new.COD_PERSONA,
                                    v_cod_tip_documento,
                                    v_nro_documento);

      insert
      into MI_IT_CR_REF_PERSONALES
            (
                COD_PERSONA,
                COD_TIP_DOCUMENTO,
                NRO_DOCUMENTO,
                COD_REFERENCIA, 
                TIP_REFERENCIA, 
                NRO_SECUENCIA, 
                NOM_PERSONA, 
                TELEFONOS, 
                LUG_TRABAJO, 
                PUESTO, 
                REL_PERSONA, 
                OBSERVACION, 
                EST_VERIFICACION, 
                CONOCE, 
                REC_MENSAJE, 
                CNF_DAT_PARTICULARES, 
                CNF_DAT_LABORALES, 
                COD_USU_VERIFICADOR, 
                OBS_VERIFICACION, 
                FEC_VERIFICACION, 
                COD_INF_LABORAL, 
                NOM_PER_INFORMO, 
                CAR_PER_INFORMO, 
                NOM_PER_CERTIFICO, 
                CAR_PER_CERTIFICO, 
                COD_PAIS, 
                COD_CIUDAD, 
                DIRECCION,
                USU_INSERCION,
                FEC_INSERCION,
                USU_MODIFICACION,
                FEC_MODIFICACION,
                EST_MIGRACION
             )
       values
           (
                :new.COD_PERSONA,
                v_cod_tip_documento,
                v_nro_documento,                
                :new.COD_REFERENCIA, 
                :new.TIP_REFERENCIA, 
                :new.NRO_SECUENCIA, 
                :new.NOM_PERSONA, 
                :new.TELEFONOS, 
                :new.LUG_TRABAJO, 
                :new.PUESTO, 
                :new.REL_PERSONA, 
                :new.OBSERVACION, 
                :new.EST_VERIFICACION, 
                :new.CONOCE, 
                :new.REC_MENSAJE, 
                :new.CNF_DAT_PARTICULARES, 
                :new.CNF_DAT_LABORALES, 
                :new.COD_USU_VERIFICADOR, 
                :new.OBS_VERIFICACION, 
                :new.FEC_VERIFICACION, 
                :new.COD_INF_LABORAL, 
                :new.NOM_PER_INFORMO, 
                :new.CAR_PER_INFORMO, 
                :new.NOM_PER_CERTIFICO, 
                :new.CAR_PER_CERTIFICO, 
                :new.COD_PAIS, 
                :new.COD_CIUDAD, 
                :new.DIRECCION,
                :new.USU_INSERCION,
                :new.FEC_INSERCION,
                :new.USU_MODIFICACION,
                :new.FEC_MODIFICACION,
                'U');
   elsif deleting then
      PRA_ACT_MI_IT_BA_PERSONAS_01(:old.COD_PERSONA,
                                    v_cod_tip_documento,
                                    v_nro_documento);

      insert
      into MI_IT_CR_REF_PERSONALES
            (
                COD_PERSONA,
                COD_TIP_DOCUMENTO,
                NRO_DOCUMENTO,
                COD_REFERENCIA, 
                TIP_REFERENCIA, 
                NRO_SECUENCIA, 
                NOM_PERSONA, 
                TELEFONOS, 
                LUG_TRABAJO, 
                PUESTO, 
                REL_PERSONA, 
                OBSERVACION, 
                EST_VERIFICACION, 
                CONOCE, 
                REC_MENSAJE, 
                CNF_DAT_PARTICULARES, 
                CNF_DAT_LABORALES, 
                COD_USU_VERIFICADOR, 
                OBS_VERIFICACION, 
                FEC_VERIFICACION, 
                COD_INF_LABORAL, 
                NOM_PER_INFORMO, 
                CAR_PER_INFORMO, 
                NOM_PER_CERTIFICO, 
                CAR_PER_CERTIFICO, 
                COD_PAIS, 
                COD_CIUDAD, 
                DIRECCION,
                USU_INSERCION,
                FEC_INSERCION,
                USU_MODIFICACION,
                FEC_MODIFICACION,
                EST_MIGRACION
             )
       values
           (
                :old.COD_PERSONA,
                v_cod_tip_documento,
                v_nro_documento,
                :old.COD_REFERENCIA, 
                :old.TIP_REFERENCIA, 
                :old.NRO_SECUENCIA, 
                :old.NOM_PERSONA, 
                :old.TELEFONOS, 
                :old.LUG_TRABAJO, 
                :old.PUESTO, 
                :old.REL_PERSONA, 
                :old.OBSERVACION, 
                :old.EST_VERIFICACION, 
                :old.CONOCE, 
                :old.REC_MENSAJE, 
                :old.CNF_DAT_PARTICULARES, 
                :old.CNF_DAT_LABORALES, 
                :old.COD_USU_VERIFICADOR, 
                :old.OBS_VERIFICACION, 
                :old.FEC_VERIFICACION, 
                :old.COD_INF_LABORAL, 
                :old.NOM_PER_INFORMO, 
                :old.CAR_PER_INFORMO, 
                :old.NOM_PER_CERTIFICO, 
                :old.CAR_PER_CERTIFICO, 
                :old.COD_PAIS, 
                :old.COD_CIUDAD, 
                :old.DIRECCION,
                :old.USU_INSERCION,
                :old.FEC_INSERCION,
                :old.USU_MODIFICACION,
                :old.FEC_MODIFICACION,
                'D');
   end if;
END;
/

