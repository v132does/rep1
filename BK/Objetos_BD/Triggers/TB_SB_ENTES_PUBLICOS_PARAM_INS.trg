CREATE OR REPLACE TRIGGER IT.TB_SB_ENTES_PUBLICOS_PARAM_INS
BEFORE INSERT OR UPDATE  
	ON IT.SB_ENTES_PUBLICOS_PARAM
FOR EACH ROW
BEGIN
	IF INSERTING THEN
		IF :NEW.ID IS NULL THEN
			:NEW.ID := S_ID_ENTES_PUBLICOS_PARAM.NEXTVAL;
		END IF;
		:NEW.USU_CREACION := NVL(:NEW.USU_CREACION, USER);
		:NEW.FEC_CREACION := NVL(:NEW.FEC_CREACION, SYSDATE);
		:NEW.USU_MODIFICACION := NULL;
		:NEW.FEC_MODIFICACION := NULL;
	ELSIF UPDATING THEN 
		:NEW.USU_MODIFICACION := USER;
		:NEW.FEC_MODIFICACION := SYSDATE;
	END IF;
END;
/