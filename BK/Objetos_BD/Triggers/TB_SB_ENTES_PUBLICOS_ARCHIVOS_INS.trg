-- Trigger de insercion: autonumerico y auditoria
CREATE OR REPLACE TRIGGER IT.TB_SB_ENTES_PUBLICOS_ARCHIVOS_INS
BEFORE INSERT OR UPDATE 
 ON IT.SB_ENTES_PUBLICOS_ARCHIVOS
FOR EACH ROW
BEGIN
   
	IF INSERTING THEN 
		IF :NEW.ID IS NULL THEN
			:NEW.ID := IT.S_ID_ENTES_PUBLICOS_ARCHIVOS.NEXTVAL;
		END IF;

		:NEW.USU_INSERCION := NVL(:NEW.USU_INSERCION, USER);
		:NEW.FEC_INSERCION := NVL(:NEW.FEC_INSERCION, SYSDATE);
		:NEW.USU_MODIFICACION := NULL;
		:NEW.FEC_MODIFICACION := NULL;
	ELSIF UPDATING THEN 
		:NEW.USU_MODIFICACION := USER;
		:NEW.FEC_MODIFICACION := SYSDATE;
	END IF;
END;
/
