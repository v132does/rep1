-- Estándar D.E.01 §1.10.1: TB_<tabla> (Before)
CREATE OR REPLACE TRIGGER IT.TB_SB_SOL_ARCHIVOS
BEFORE INSERT ON IT.SB_SOL_ARCHIVOS
FOR EACH ROW
BEGIN
    IF :NEW.id IS NULL THEN
        SELECT IT.S_ID_ARCHIVO.NEXTVAL
          INTO :NEW.id
          FROM DUAL;
    END IF;
END TB_SB_SOL_ARCHIVOS;
/
