CREATE OR REPLACE TRIGGER IT.MA_CR_REF_COMERCIALES
 AFTER DELETE OR INSERT OR UPDATE
 ON CR_REF_COMERCIALES
 FOR EACH ROW
declare
  v_cod_tip_documento MI_IT_BA_PERSONAS_01.COD_TIP_DOCUMENTO%TYPE;
  v_nro_documento     MI_IT_BA_PERSONAS_01.NRO_DOCUMENTO%TYPE; 
begin
   -- Registrar campos de migracion
   if inserting then
      PRA_ACT_MI_IT_BA_PERSONAS_01(:new.COD_PERSONA,
                                    v_cod_tip_documento,
                                    v_nro_documento);


      insert
      into MI_IT_CR_REF_COMERCIALES
            (
                COD_PERSONA,
                COD_TIP_DOCUMENTO,
                NRO_DOCUMENTO,
                COD_REFERENCIA, 
                TIP_REFERENCIA, 
                NRO_SECUENCIA, 
                DES_ENTIDAD, 
                COD_TIP_CUENTA, 
                NRO_CUENTA, 
                COD_MONEDA, 
                VAL_CREDITO, 
                SAL_CREDITO, 
                VAL_CUOTA, 
                FEC_APERTURA, 
                FEC_VENCIMIENTO, 
                DES_GARANTIA, 
                OBSERVACION, 
                COD_ENTE, 
                TELEFONO, 
                EST_VERIFICACION, 
                COD_USU_VERIFICADOR, 
                OBS_VERIFICACION, 
                FEC_VERIFICACION, 
                CAN_CUOTAS, 
                CAN_PAGADAS, 
                MTO_LINEA, 
                MTO_MENSUAL, 
                MAX_ATRASO, 
                PRO_ATRASO, 
                ADM_TARJETA, 
                SAL_ADMINISTRADORA, 
                DIA_ATRASO,
                USU_INSERCION,
                FEC_INSERCION,
                USU_MODIFICACION,
                FEC_MODIFICACION,
                EST_MIGRACION
             )
       values
           (
                :new.COD_PERSONA,
                v_cod_tip_documento,
                v_nro_documento,
                :new.COD_REFERENCIA, 
                :new.TIP_REFERENCIA, 
                :new.NRO_SECUENCIA, 
                :new.DES_ENTIDAD, 
                :new.COD_TIP_CUENTA, 
                :new.NRO_CUENTA, 
                :new.COD_MONEDA, 
                :new.VAL_CREDITO, 
                :new.SAL_CREDITO, 
                :new.VAL_CUOTA, 
                :new.FEC_APERTURA, 
                :new.FEC_VENCIMIENTO, 
                :new.DES_GARANTIA, 
                :new.OBSERVACION, 
                :new.COD_ENTE, 
                :new.TELEFONO, 
                :new.EST_VERIFICACION, 
                :new.COD_USU_VERIFICADOR, 
                :new.OBS_VERIFICACION, 
                :new.FEC_VERIFICACION, 
                :new.CAN_CUOTAS, 
                :new.CAN_PAGADAS, 
                :new.MTO_LINEA, 
                :new.MTO_MENSUAL, 
                :new.MAX_ATRASO, 
                :new.PRO_ATRASO, 
                :new.ADM_TARJETA, 
                :new.SAL_ADMINISTRADORA, 
                :new.DIA_ATRASO,
                :new.USU_INSERCION,
                :new.FEC_INSERCION,
                :new.USU_MODIFICACION,
                :new.FEC_MODIFICACION,
                'I');
   elsif updating then
      PRA_ACT_MI_IT_BA_PERSONAS_01(:new.COD_PERSONA,
                                    v_cod_tip_documento,
                                    v_nro_documento);

      insert
      into MI_IT_CR_REF_COMERCIALES
            (
                COD_PERSONA,
                COD_TIP_DOCUMENTO,
                NRO_DOCUMENTO,
                COD_REFERENCIA, 
                TIP_REFERENCIA, 
                NRO_SECUENCIA, 
                DES_ENTIDAD, 
                COD_TIP_CUENTA, 
                NRO_CUENTA, 
                COD_MONEDA, 
                VAL_CREDITO, 
                SAL_CREDITO, 
                VAL_CUOTA, 
                FEC_APERTURA, 
                FEC_VENCIMIENTO, 
                DES_GARANTIA, 
                OBSERVACION, 
                COD_ENTE, 
                TELEFONO, 
                EST_VERIFICACION, 
                COD_USU_VERIFICADOR, 
                OBS_VERIFICACION, 
                FEC_VERIFICACION, 
                CAN_CUOTAS, 
                CAN_PAGADAS, 
                MTO_LINEA, 
                MTO_MENSUAL, 
                MAX_ATRASO, 
                PRO_ATRASO, 
                ADM_TARJETA, 
                SAL_ADMINISTRADORA, 
                DIA_ATRASO,
                USU_INSERCION,
                FEC_INSERCION,
                USU_MODIFICACION,
                FEC_MODIFICACION,
                EST_MIGRACION
             )
       values
           (
                :new.COD_PERSONA,
                v_cod_tip_documento,
                v_nro_documento,                
                :new.COD_REFERENCIA, 
                :new.TIP_REFERENCIA, 
                :new.NRO_SECUENCIA, 
                :new.DES_ENTIDAD, 
                :new.COD_TIP_CUENTA, 
                :new.NRO_CUENTA, 
                :new.COD_MONEDA, 
                :new.VAL_CREDITO, 
                :new.SAL_CREDITO, 
                :new.VAL_CUOTA, 
                :new.FEC_APERTURA, 
                :new.FEC_VENCIMIENTO, 
                :new.DES_GARANTIA, 
                :new.OBSERVACION, 
                :new.COD_ENTE, 
                :new.TELEFONO, 
                :new.EST_VERIFICACION, 
                :new.COD_USU_VERIFICADOR, 
                :new.OBS_VERIFICACION, 
                :new.FEC_VERIFICACION, 
                :new.CAN_CUOTAS, 
                :new.CAN_PAGADAS, 
                :new.MTO_LINEA, 
                :new.MTO_MENSUAL, 
                :new.MAX_ATRASO, 
                :new.PRO_ATRASO, 
                :new.ADM_TARJETA, 
                :new.SAL_ADMINISTRADORA, 
                :new.DIA_ATRASO,
                :new.USU_INSERCION,
                :new.FEC_INSERCION,
                :new.USU_MODIFICACION,
                :new.FEC_MODIFICACION,
                'U');
   elsif deleting then
      PRA_ACT_MI_IT_BA_PERSONAS_01(:old.COD_PERSONA,
                                    v_cod_tip_documento,
                                    v_nro_documento);

      insert
      into MI_IT_CR_REF_COMERCIALES
            (
                COD_PERSONA,
                COD_TIP_DOCUMENTO,
                NRO_DOCUMENTO,
                COD_REFERENCIA, 
                TIP_REFERENCIA, 
                NRO_SECUENCIA, 
                DES_ENTIDAD, 
                COD_TIP_CUENTA, 
                NRO_CUENTA, 
                COD_MONEDA, 
                VAL_CREDITO, 
                SAL_CREDITO, 
                VAL_CUOTA, 
                FEC_APERTURA, 
                FEC_VENCIMIENTO, 
                DES_GARANTIA, 
                OBSERVACION, 
                COD_ENTE, 
                TELEFONO, 
                EST_VERIFICACION, 
                COD_USU_VERIFICADOR, 
                OBS_VERIFICACION, 
                FEC_VERIFICACION, 
                CAN_CUOTAS, 
                CAN_PAGADAS, 
                MTO_LINEA, 
                MTO_MENSUAL, 
                MAX_ATRASO, 
                PRO_ATRASO, 
                ADM_TARJETA, 
                SAL_ADMINISTRADORA, 
                DIA_ATRASO,
                USU_INSERCION,
                FEC_INSERCION,
                USU_MODIFICACION,
                FEC_MODIFICACION,
                EST_MIGRACION
             )
       values
           (
                :old.COD_PERSONA,
                v_cod_tip_documento,
                v_nro_documento,
                :old.COD_REFERENCIA, 
                :old.TIP_REFERENCIA, 
                :old.NRO_SECUENCIA, 
                :old.DES_ENTIDAD, 
                :old.COD_TIP_CUENTA, 
                :old.NRO_CUENTA, 
                :old.COD_MONEDA, 
                :old.VAL_CREDITO, 
                :old.SAL_CREDITO, 
                :old.VAL_CUOTA, 
                :old.FEC_APERTURA, 
                :old.FEC_VENCIMIENTO, 
                :old.DES_GARANTIA, 
                :old.OBSERVACION, 
                :old.COD_ENTE, 
                :old.TELEFONO, 
                :old.EST_VERIFICACION, 
                :old.COD_USU_VERIFICADOR, 
                :old.OBS_VERIFICACION, 
                :old.FEC_VERIFICACION, 
                :old.CAN_CUOTAS, 
                :old.CAN_PAGADAS, 
                :old.MTO_LINEA, 
                :old.MTO_MENSUAL, 
                :old.MAX_ATRASO, 
                :old.PRO_ATRASO, 
                :old.ADM_TARJETA, 
                :old.SAL_ADMINISTRADORA, 
                :old.DIA_ATRASO,
                :old.USU_INSERCION,
                :old.FEC_INSERCION,
                :old.USU_MODIFICACION,
                :old.FEC_MODIFICACION,
                'D');
   end if;
END;
/

