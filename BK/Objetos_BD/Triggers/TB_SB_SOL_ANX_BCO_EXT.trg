-- Estándar D.E.01 §1.10.1: TB_<tabla> (Before)
CREATE OR REPLACE TRIGGER IT.TB_SB_SOL_ANX_BCO_EXT
BEFORE INSERT ON IT.SB_SOL_ANX_BCO_EXT
FOR EACH ROW
BEGIN
    IF :NEW.id IS NULL THEN
        SELECT IT.S_ID_ANX_BCO_EXT.NEXTVAL
          INTO :NEW.id
          FROM DUAL;
    END IF;
END TB_SB_SOL_ANX_BCO_EXT;
/
