CREATE OR REPLACE FORCE VIEW IT.GV_MOV_TAS_BCE_RES AS
SELECT M.COD_OFI_ORIGEN OFICINA, B.DESCRIPCION, COUNT(1) CANTIDAD
  FROM GE_MOVIMIENTOS M, BA_OFICINAS B, CJ_CAJAS C
 WHERE M.COD_OFI_ORIGEN = B.COD_OFICINA
   AND M.NRO_CAJA = C.NRO_CAJA
   AND C.TIPO = 'S' --Solo TAS y Homebanking
   AND M.ESTADO = 'N'
   AND M.REVERSADO = 'N'
   AND M.MONTO IS NOT NULL
   AND M.NRO_CUENTA IS NOT NULL
 GROUP BY M.COD_OFI_ORIGEN, B.DESCRIPCION
 ORDER BY COUNT(1)
;

