CREATE OR REPLACE FORCE VIEW IT.PV_VALUACIONES AS
SELECT "NRO_CUENTA","FECHA","ESTADO","TIPO","TIP_INTERES","TIP_RENOVACION","TIP_DOCUMENTO","SAL_CAPITAL","SAL_INTERES","SAL_INT_ADELANTADO","DEV_NO_COBRADO","TOT_GAR_COMPUTABLES","TOT_PREVISION","CAT_AUTOMATICA","COTIZACION","TOT_VAL_CAPITAL","TOT_VAL_INTERES","TOT_VAL_INT_ADE","TOT_VAL_DEVENGADO","TOT_VAL_GARANTIA","TOT_VAL_PREVISION","USU_INSERCION","FEC_INSERCION","USU_MODIFICACION","FEC_MODIFICACION","DEV_SUSPENSO","TOT_VAL_SUSPENSO","COT_ANTERIOR","VAL_INT_DEVENGAR","TOT_VAL_INT_DEVENGAR"
  FROM PR_VALUACIONES
 UNION
SELECT "NRO_CUENTA","FECHA","ESTADO","TIPO","TIP_INTERES","TIP_RENOVACION","TIP_DOCUMENTO","SAL_CAPITAL","SAL_INTERES","SAL_INT_ADELANTADO","DEV_NO_COBRADO","TOT_GAR_COMPUTABLES","TOT_PREVISION","CAT_AUTOMATICA","COTIZACION","TOT_VAL_CAPITAL","TOT_VAL_INTERES","TOT_VAL_INT_ADE","TOT_VAL_DEVENGADO","TOT_VAL_GARANTIA","TOT_VAL_PREVISION","USU_INSERCION","FEC_INSERCION","USU_MODIFICACION","FEC_MODIFICACION","DEV_SUSPENSO","TOT_VAL_SUSPENSO","COT_ANTERIOR","VAL_INT_DEVENGAR","TOT_VAL_INT_DEVENGAR"
  FROM PR_VALUACIONES_HIS;
comment on column IT.PV_VALUACIONES.USU_INSERCION is 'Usuario que realizo la Insercion del Registro.';
comment on column IT.PV_VALUACIONES.FEC_INSERCION is 'Fecha en que se Inserto el Registro.';
comment on column IT.PV_VALUACIONES.USU_MODIFICACION is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.PV_VALUACIONES.FEC_MODIFICACION is 'Fecha en que se realizo la Ultima Modificacion en el Registro.';

