CREATE OR REPLACE FORCE VIEW IT.GV_DAT_EVA_PERSONAS AS
SELECT a.nro_solicitud,
       a.nro_intento,
       decode(to_number(TRIM(substr(a.dat_entrada, 235, 3))), 0, NULL,
              to_number(TRIM(substr(a.dat_entrada, 235, 3)))) cod_actividad,
       TRIM(substr(a.dat_entrada, 238, 1)) actual,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 239, 20))) alq_cob_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 259, 20))) alq_cob_conyuge,
       to_number(TRIM(substr(a.dat_entrada, 279, 3))) cod_titulo,
       TRIM(substr(a.dat_entrada, 282, 1)) cat_riesgo,
       TRIM(substr(a.dat_entrada, 283, 10)) cod_persona,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 293, 20))) cuo_con_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 313, 20))) cuo_con_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 333, 20))) cuo_hip_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 353, 20))) cuo_hip_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 373, 20))) otr_cuo_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 393, 20))) otr_cuo_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 413, 20))) cuo_tar_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 433, 20))) cuo_tar_conyuge,
       to_number(TRIM(substr(a.dat_entrada, 453, 5))) dias_atraso,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 458, 20))) dispuesto,
       TRIM(substr(a.dat_entrada, 478, 1)) cli_especial,
       TRIM(substr(a.dat_entrada, 479, 1)) mto_fijo,
       TRIM(substr(a.dat_entrada, 480, 1)) est_civil,
       TRIM(substr(a.dat_entrada, 481, 1)) faj_buro,
       to_date(TRIM(substr(a.dat_entrada, 482, 8)), 'YYYYMMDD') fec_ingreso,
       to_date(TRIM(substr(a.dat_entrada, 490, 8)), 'YYYYMMDD') fec_lab_ingreso,
       to_date(TRIM(substr(a.dat_entrada, 498, 8)), 'YYYYMMDD') fec_nacimiento,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 506, 20))) gto_alquiler,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 526, 20))) gto_familiar,
       TRIM(substr(a.dat_entrada, 546, 60)) gestor,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 606, 20))) mto_nomina,
       TRIM(substr(a.dat_entrada, 626, 1)) sit_infocheck,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 627, 20))) ing_vta_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 647, 20))) ing_vta_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 667, 20))) ing_ind_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 687, 20))) ing_ind_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 707, 20))) int_aho_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 727, 20))) int_aho_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 747, 20))) jub_pen_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 767, 20))) jub_pen_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 787, 20))) contingencia,
       TRIM(substr(a.dat_entrada, 807, 1)) ind_inhibido,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 808, 5))) max_dias_incum_12_meses,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 813, 5))) max_dias_incum_6_meses,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 818, 18))) med_dispuesto,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 836, 20))) mto_atraso_fec_solic,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 856, 20))) mto_max_incum_12_meses,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 876, 20))) mto_max_incum_6_meses,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 896, 20))) mto_sal_neto,
       to_number(TRIM(substr(a.dat_entrada, 916, 3))) cod_niv_estudio,
       TRIM(substr(a.dat_entrada, 919, 10)) cod_per_vinculo,
       to_number(TRIM(substr(a.dat_entrada, 929, 4))) can_personas,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 933, 20))) pag_minimo,
       to_number(TRIM(substr(a.dat_entrada, 953, 3))) cod_pais,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 956, 20))) patrimonio,
       TRIM(substr(a.dat_entrada, 976, 1)) pro_categoria,
       to_number(TRIM(substr(a.dat_entrada, 977, 3))) cod_profesion,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 980, 20))) ren_acc_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 1000, 20))) ren_acc_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 1020, 20))) sal_med_pasivo_vista,
       TRIM(substr(a.dat_entrada, 1040, 1)) cod_sexo,
       TRIM(substr(a.dat_entrada, 1041, 1)) tip_empleo,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 1042, 20))) sue_fij_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 1062, 20))) sue_fij_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 1082, 20))) sue_var_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 1102, 20))) sue_var_conyuge,
       TRIM(substr(a.dat_entrada, 1122, 1)) tar_bloqueada,
       TRIM(substr(a.dat_entrada, 1123, 1)) tip_rel_persona,
       TRIM(substr(a.dat_entrada, 1124, 1)) tip_propiedad,
       to_number(TRIM(substr(a.dat_entrada, 1125, 3))) cod_tip_vivienda,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 1128, 20))) val_comercial
  FROM ge_dat_rie_evaluaciones_det a
 WHERE tip_rel_persona = 'P'

UNION ALL

SELECT a.nro_solicitud,
       a.nro_intento,
       decode(to_number(TRIM(substr(a.dat_entrada, 1, 3))), 0, NULL) cod_actividad,
       TRIM(substr(a.dat_entrada, 4, 1)) actual,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 5, 20))) alq_cob_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 25, 20))) alq_cob_conyuge,
       to_number(TRIM(substr(a.dat_entrada, 45, 3))) cod_titulo,
       TRIM(substr(a.dat_entrada, 48, 1)) cat_riesgo,
       TRIM(substr(a.dat_entrada, 49, 10)) cod_persona,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 59, 20))) cuo_con_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 79, 20))) cuo_con_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 99, 20))) cuo_hip_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 119, 20))) cuo_hip_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 139, 20))) otr_cuo_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 159, 20))) otr_cuo_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 179, 20))) cuo_tar_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 199, 20))) cuo_tar_conyuge,
       to_number(TRIM(substr(a.dat_entrada, 219, 5))) dias_atraso,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 224, 20))) dispuesto,
       TRIM(substr(a.dat_entrada, 244, 1)) cli_especial,
       TRIM(substr(a.dat_entrada, 245, 1)) mto_fijo,
       TRIM(substr(a.dat_entrada, 246, 1)) est_civil,
       TRIM(substr(a.dat_entrada, 247, 1)) faj_buro,
       to_date(TRIM(substr(a.dat_entrada, 248, 8)), 'YYYYMMDD') fec_ingreso,
       to_date(TRIM(substr(a.dat_entrada, 256, 8)), 'YYYYMMDD') fec_lab_ingreso,
       to_date(TRIM(substr(a.dat_entrada, 264, 8)), 'YYYYMMDD') fec_nacimiento,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 272, 20))) gto_alquiler,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 292, 20))) gto_familiar,
       TRIM(substr(a.dat_entrada, 312, 60)) gestor,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 372, 20))) mto_nomina,
       TRIM(substr(a.dat_entrada, 392, 1)) sit_infocheck,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 393, 20))) ing_vta_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 413, 20))) ing_vta_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 433, 20))) ing_ind_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 453, 20))) ing_ind_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 473, 20))) int_aho_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 493, 20))) int_aho_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 513, 20))) jub_pen_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 533, 20))) jub_pen_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 553, 20))) contingencia,
       TRIM(substr(a.dat_entrada, 573, 1)) ind_inhibido,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 573, 5))) max_dias_incum_12_meses,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 579, 5))) max_dias_incum_6_meses,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 584, 18))) med_dispuesto,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 602, 20))) mto_atraso_fec_solic,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 622, 20))) mto_max_incum_12_meses,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 642, 20))) mto_max_incum_6_meses,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 662, 20))) mto_sal_neto,
       to_number(TRIM(substr(a.dat_entrada, 682, 3))) cod_niv_estudio,
       TRIM(substr(a.dat_entrada, 685, 10)) cod_per_vinculo,
       to_number(TRIM(substr(a.dat_entrada, 695, 4))) can_personas,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 699, 20))) pag_minimo,
       to_number(TRIM(substr(a.dat_entrada, 719, 3))) cod_pais,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 722, 20))) patrimonio,
       TRIM(substr(a.dat_entrada, 742, 1)) pro_categoria,
       to_number(TRIM(substr(a.dat_entrada, 743, 3))) cod_profesion,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 746, 20))) ren_acc_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 766, 20))) ren_acc_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 786, 20))) sal_med_pasivo_vista,
       TRIM(substr(a.dat_entrada, 806, 1)) cod_sexo,
       TRIM(substr(a.dat_entrada, 807, 1)) tip_empleo,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 808, 20))) sue_fij_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 828, 20))) sue_fij_conyuge,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 848, 20))) sue_var_solicitante,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 868, 20))) sue_var_conyuge,
       TRIM(substr(a.dat_entrada, 888, 1)) tar_bloqueada,
       TRIM(substr(a.dat_entrada, 889, 1)) tip_rel_persona,
       TRIM(substr(a.dat_entrada, 890, 1)) tip_propiedad,
       to_number(TRIM(substr(a.dat_entrada, 891, 3))) cod_tip_vivienda,
       fug_obt_val_numerico(TRIM(substr(a.dat_entrada, 894, 20))) val_comercial
  FROM ge_dat_rie_evaluaciones_det a
 WHERE tip_rel_persona <> 'P';

