CREATE OR REPLACE FORCE VIEW IT.AV_CER_CARTONES
(nro_cuenta, nro_certificado, serie, tip_capitalizacion, denominacion, beneficiario, cod_modulo, cod_modalidad, cod_moneda, est_cer_batch, est_batch, fec_apertura, fec_hor_emision, fec_vencimiento, plazo, cod_tasa, capital, cod_oficina, tas_personalizada, fec_ult_capitalizacion, est_certificado, des_oficina, modalidad, des_moneda, fecha, observacion, usuario, estado)
AS
SELECT A.NRO_CUENTA,
       A.NRO_CERTIFICADO,
       A.SERIE,
       AH.TIP_CAPITALIZACION,
       DECODE(A.NRO_CUENTA,NULL,NULL,AH.DENOMINACION) DENOMINACION,
       DECODE(A.NRO_CUENTA,NULL,NULL,NVL(AH.BENEFICIARIO,AH.DENOMINACION)) BENEFICIARIO,
       A.COD_MODULO,
       A.COD_MODALIDAD,
       A.COD_MONEDA,
       AH.EST_CER_BATCH,
       AH.EST_BATCH,
       AH.FEC_APERTURA,
       AH.FEC_HOR_EMISION,
       AH.FEC_VENCIMIENTO,
       AH.FEC_VENCIMIENTO - AH.FEC_APERTURA PLAZO,
       AH.COD_TASA,
       NVL(AH.CAPITAL,0) CAPITAL,
       A.COD_OFICINA,
       AH.TAS_PERSONALIZADA,
       AH.FEC_ULT_CAPITALIZACION,
       'A' EST_CERTIFICADO,
       O.DESCRIPCION DES_OFICINA,
       MO.DESCRIPCION MODALIDAD,
       M.DESCRIPCION MONEDA,
       A.FECHA FECHA,
       A.OBSERVACION OBSERVACION,
       A.USU_INSERCION USUARIO,
       'A' ESTADO
FROM GE_MODALIDADES MO,
     BA_OFICINAS O,
     AH_CTA_CERTIFICADOS AH,
     AH_CER_ANULADOS A,
     BA_MONEDAS M
WHERE A.COD_OFICINA = O.COD_OFICINA(+)
  AND A.COD_MODALIDAD = MO.COD_MODALIDAD
  AND AH.NRO_CUENTA(+) = A.NRO_CUENTA
  AND A.COD_MONEDA = M.COD_MONEDA(+)
UNION
SELECT
       AH.NRO_CUENTA,
       AH.NRO_CERTIFICADO,
       AH.SERIE,
       AH.TIP_CAPITALIZACION,
       AH.DENOMINACION,
       NVL(AH.BENEFICIARIO,AH.DENOMINACION) BENEFICIARIO,
       AH.COD_MODULO,
       AH.COD_MODALIDAD,
       AH.COD_MONEDA,
       AH.EST_CER_BATCH,
       AH.EST_BATCH,
       AH.FEC_APERTURA,
       AH.FEC_HOR_EMISION,
       AH.FEC_VENCIMIENTO,
       AH.FEC_VENCIMIENTO - AH.FEC_APERTURA PLAZO,
       AH.COD_TASA,
       NVL(AH.CAPITAL,0) CAPITAL,
       AH.COD_OFICINA,
       AH.TAS_PERSONALIZADA,
       AH.FEC_ULT_CAPITALIZACION,
       AH.EST_CERTIFICADO EST_CERTIFICADO,
       O.DESCRIPCION DES_OFICINA,
       MO.DESCRIPCION MODALIDAD,
       M.DESCRIPCION MONEDA,
       TRUNC(NVL(AH.FEC_HOR_EMISION,AH.FEC_APERTURA)) FECHA,
       NULL OBSERVACION,
       nvl(AH.COD_USU_EMISION,AH.USU_MODIFICACION) USUARIO,
       'E' EMITIDO
FROM GE_MODALIDADES MO,
     BA_MONEDAS M,
     BA_OFICINAS O,
     AH_CTA_CERTIFICADOS AH
WHERE AH.COD_OFICINA = O.COD_OFICINA
     AND AH.COD_MODALIDAD = MO.COD_MODALIDAD
     AND AH.COD_MODULO = MO.COD_MODULO
     AND AH.COD_MONEDA = M.COD_MONEDA
     AND AH.NRO_CERTIFICADO IS NOT NULL
     AND AH.SERIE IS NOT NULL
order by des_oficina, moneda, serie, nro_certificado, est_certificado;

