create or replace force view it.gv_qry_comex as
Select CTA.NRO_CUENTA, CLI.COD_PERSONA, CTA.DENOMINACION, CTA.COD_MONEDA, det.fec_aprobacion fec_inicio, CLI.RELACION, --CCI
       CTA.COD_MODULO, CTA.COD_MODALIDAD, CTA.ESTADO, EST.DESCRIPCION, EST.ACTIVO,
       MAD.DESCRIPCION SC_NMMODAL
  from GE_MODALIDADES MAD,GE_EST_CUENTAS EST, cx_cta_importaciones det, GE_CUENTAS CTA, GE_CTA_CLIENTES CLI
 where EST.COD_MODULO = CTA.COD_MODULO
   AND EST.COD_MODALIDAD = CTA.COD_MODALIDAD
   AND EST.ESTADO = CTA.ESTADO
   AND CTA.NRO_CUENTA = CLI.NRO_CUENTA
   AND MAD.COD_MODULO = CTA.COD_MODULO
   AND MAD.COD_MODALIDAD = CTA.COD_MODALIDAD
   and cta.nro_cuenta = det.nro_cuenta
union all
--ANTICIPO DE IMPORTADORES

Select CTA.NRO_CUENTA, CLI.COD_PERSONA, CTA.DENOMINACION, CTA.COD_MONEDA, det.fec_inicio,CLI.RELACION,
       CTA.COD_MODULO, CTA.COD_MODALIDAD, CTA.ESTADO, EST.DESCRIPCION, EST.ACTIVO,
       MAD.DESCRIPCION SC_NMMODAL
from GE_MODALIDADES MAD,GE_EST_CUENTAS EST, MD_CTA_DOCUMENTOS DET, GE_CUENTAS CTA, GE_CTA_CLIENTES CLI
where EST.COD_MODULO = CTA.COD_MODULO
  AND EST.COD_MODALIDAD = CTA.COD_MODALIDAD
  AND EST.ESTADO = CTA.ESTADO
  AND CTA.NRO_CUENTA = CLI.NRO_CUENTA
  AND MAD.COD_MODULO = CTA.COD_MODULO
  AND MAD.COD_MODALIDAD = CTA.COD_MODALIDAD
  AND MAD.COD_MODALIDAD = 145
  AND fug_obt_cod_banco = 7
  and cta.nro_cuenta = det.nro_cuenta

union all
--CCE
Select CTA.NRO_CUENTA, CLI.COD_PERSONA, CTA.DENOMINACION, CTA.COD_MONEDA, CCE.fec_aprobacion fec_inicio, CLI.RELACION,
       CTA.COD_MODULO, CTA.COD_MODALIDAD, CTA.ESTADO, EST.DESCRIPCION, EST.ACTIVO,
       MAD.DESCRIPCION SC_NMMODAL
  from GE_MODALIDADES MAD,GE_EST_CUENTAS EST, cx_cta_exportaciones CCE, GE_CUENTAS CTA, GE_CTA_CLIENTES CLI
 where EST.COD_MODULO = CTA.COD_MODULO
   AND EST.COD_MODALIDAD = CTA.COD_MODALIDAD
   AND EST.ESTADO = CTA.ESTADO
   AND CTA.NRO_CUENTA = CLI.NRO_CUENTA
   AND MAD.COD_MODULO = CTA.COD_MODULO
   AND MAD.COD_MODALIDAD = CTA.COD_MODALIDAD
   and cta.nro_cuenta = CCE.nro_cuenta
union all
--Cobranzas
Select CTA.NRO_CUENTA, CLI.COD_PERSONA, CTA.DENOMINACION, CTA.COD_MONEDA, COB.fec_aprobacion fec_inicio, CLI.RELACION,
       CTA.COD_MODULO, CTA.COD_MODALIDAD, CTA.ESTADO, EST.DESCRIPCION, EST.ACTIVO,
       MAD.DESCRIPCION SC_NMMODAL
  from GE_MODALIDADES MAD,GE_EST_CUENTAS EST, cx_cta_cobranzas COB, GE_CUENTAS CTA, GE_CTA_CLIENTES CLI
 where EST.COD_MODULO = CTA.COD_MODULO
   AND EST.COD_MODALIDAD = CTA.COD_MODALIDAD
   AND EST.ESTADO = CTA.ESTADO
   AND CTA.NRO_CUENTA = CLI.NRO_CUENTA
   AND MAD.COD_MODULO = CTA.COD_MODULO
   AND MAD.COD_MODALIDAD = CTA.COD_MODALIDAD
   and cta.nro_cuenta = COB.nro_cuenta
union all
--Fianzas
Select CTA.NRO_CUENTA, CLI.COD_PERSONA, CTA.DENOMINACION, CTA.COD_MONEDA, FIA.fec_concesion fec_inicio, CLI.RELACION,
       CTA.COD_MODULO, CTA.COD_MODALIDAD, CTA.ESTADO, EST.DESCRIPCION, EST.ACTIVO,
       MAD.DESCRIPCION SC_NMMODAL
  from GE_MODALIDADES MAD,GE_EST_CUENTAS EST, cx_fianzas FIA, GE_CUENTAS CTA, GE_CTA_CLIENTES CLI
 where EST.COD_MODULO = CTA.COD_MODULO
   AND EST.COD_MODALIDAD = CTA.COD_MODALIDAD
   AND EST.ESTADO = CTA.ESTADO
   AND CTA.NRO_CUENTA = CLI.NRO_CUENTA
   AND MAD.COD_MODULO = CTA.COD_MODULO
   AND MAD.COD_MODALIDAD = CTA.COD_MODALIDAD
   and cta.nro_cuenta = FIA.nro_cuenta
;

