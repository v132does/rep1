CREATE OR REPLACE FORCE VIEW IT.RV_CR_VTA_CRUZADAS AS
SELECT ano                     año,
       mes                     mes,
       dia                     dia,
       cod_persona             "cliente",
       nom_completo            "nombre cliente",
       tipo                    "tipo cliente",
       cod_tip_documento       "tipo documento",
       nro_documento           "numero documento",
       nom_comercial           "nombre gestor",
       des_oficina             "oficina cliente",
       cat_automatica          "categoria riesgo bbva",
       cat_sistema             "categoria sistema",
       des_seg_cliente         "segmento valor",
       fec_ape_cc_gs           "fecha apertura cta cte GS",
       des_est_cc_gs           "estado cta cte GS",
       sal_tot_cc_gs           "SALDO CTA CTE GS",
       fec_ape_cc_usd          "fecha apertura cta cte USD",
       des_est_cc_usd          "estado cta cte USD",
       sal_tot_cc_usd          "SALDO CTA CTE USD",
       fec_ape_cc_eur          "fecha apertura cta cte EUR",
       des_est_cc_eur          "estado cta cte EUR",
       sal_tot_cc_eur          "SALDO CTA CTE EUR",
       mto_lin_sob_gs          "MONTO SOBREGIRO GS",
       mto_lin_sob_usd         "MONTO SOBREGIRO USD",
       mto_lin_sob_eur         "MONTO SOBREGIRO EUR",
       fec_ape_av_gs           "fecha apertura cta ahorro GS",
       des_est_av_gs           "estado cta ahorro GS",
       sal_tot_av_gs           "SALDO CTA AHORRO GS",
       fec_ape_av_usd          "fecha apertura cta ahorro USD",
       des_est_av_usd          "estado cta ahorro USD",
       sal_tot_av_usd          "SALDO CTA AHORRO USD",
       fec_ape_av_eur          "fecha apertura cta ahorro EUR",
       des_est_av_eur          "estado cta ahorro EUR",
       sal_tot_av_eur          "SALDO CTA AHORRO EUR",
       fec_ape_cda_gs          "fecha apertura cta cda GS",
       des_est_cda_gs          "estado cta cda GS",
       sal_tot_cda_gs          "SALDO CTA CDA GS",
       fec_ape_cda_usd         "fecha apertura cta cda USD",
       des_est_cda_usd         "estado cta cda USD",
       sal_tot_cda_usd         "SALDO CTA CDA USD",
       fec_ape_cda_eur         "fecha apertura cta cda EUR",
       des_est_cda_eur         "estado cta cda EUR",
       sal_tot_cda_eur         "SALDO CTA CDA EUR",
       fec_ini_pre_gs          "fecha inicio prestamo GS",
       des_mad_pre_gs          "desc modalidad prestamo GS",
       sal_tot_pre_gs          "SALDO PRESTAMO GS",
       fec_ini_pre_usd         "fecha inicio prestamo USD",
       des_mad_pre_usd         "desc modalidad prestamo USD",
       sal_tot_pre_usd         "SALDO PRESTAMO USD",
       fec_ini_pre_eur         "fecha inicio prestamo EUR",
       des_mad_pre_eur         "desc modalidad prestamo EUR",
       sal_tot_pre_eur         "SALDO PRESTAMO EUR",
       fec_ape_tar_credito     "fecha apertura tarjeta",
       des_mad_tar_credito     "descripcion modalidad tarjeta",
       sal_tot_tar_credito     "SALDO TOTAL TARJETA",
       des_est_tar_credito     "descripcion estado tarjeta",
       lin_credito             "LINEA DE CREDITO TARJETA",
       fec_ape_adi_tar_credito "fecha apertura adicional tc",
       des_mad_adi_tar_credito "descripcion modalidad adic. tc",
       sal_tot_adi_tar_credito "SALDO TOTAL ADICIONAL TARJETA",
       fec_ape_tar_debito      "fecha apertura tarjeta debito",
       deb_automatico          "posee debito automatico",
       fec_ape_paquete         "fecha apertura paquete",
       des_paquete             "descripcion paquete",
       cli_nomina              "percibe pago de salario",
       mto_ult_sueldo          "ultimo salario percibido",
       fec_ult_sueldo          "fecha salario percibido",
       des_ente                "descripcion ente",
       fec_ape_hom_banking     "fecha apertura homebank.",
       cli_hom_banking         "posee servicio homebank.",
       fec_ape_pag_salario     "fecha inicio pago salario"
  FROM cr_vta_cruzadas;

