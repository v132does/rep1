CREATE OR REPLACE FORCE VIEW IT.GV_VIGIA_PERSONAS_NOV AS
select DISTINCT(PP.NRO_CLIENTE) as cod_persona,PP."NRO_CLIENTE",PP."TIPO_PERSONA",PP."APELLIDO",PP."SEGUNDO_APELLIDO",PP."PRIMER_NOMBRE",PP."SEGUNDO_NOMBRE",PP."RAZON_SOCIAL",PP."COD_ALTERNATIVO_CLIENTE",PP."SEXO",PP."TIPO_DOCUMENTO_1",PP."NRO_DOCUMENTO_1",PP."DOC_EXPEDIDO_POR_1",PP."FECHA_EXPEDICION_1",PP."TIPO_DOCUMENTO_2",PP."NRO_DOCUMENTO_2",PP."DOC_EXPEDIDO_POR_2",PP."FECHA_EXPEDICION_2",PP."TIPO_DOCUMENTO_3",PP."NRO_DOCUMENTO_3",PP."DOC_EXPEDIDO_POR_3",PP."FECHA_EXPEDICION_3",PP."TIPO_DOCUMENTO_4",PP."NRO_DOCUMENTO_4",PP."DOC_EXPEDIDO_POR_4",PP."FECHA_EXPEDICION_4",PP."FECHA_CONSTITUCION",PP."FECHA_NACIMIENTO",PP."LUGAR_NACIMIENTO",PP."COD_PAIS",PP."NACIONALIDAD",PP."ESTADO_CIVIL",PP."COD_ACTIVIDAD",PP."COD_PROFESION",PP."COD_FORMA_JURIDICA",PP."TIPO_CLIENTE",PP."COMUNICADO",PP."CONOCIMIENTO_CLIENTE",PP."INGRESO_ANUAL_DECLARADO",PP."DP_ACTIVO",PP."DP_INGRESOS",PP."DP_PASIVO",PP."DP_PATRIMONIO_NETO",PP."COD_SUCURSAL",PP."ES_EMPLEADO",PP."EMPLEADO_DEPARTAMENTO",PP."EMPLEADO_STATUS",PP."ES_INST_FINANCIERA",PP."ES_INST_PUBLICA",PP."FECHA_ALTA",PP."FECHA_BAJA",PP."FECHA_CAMBIODATO_A",PP."FECHA_CAMBIODATO_B",PP."FECHA_CAMBIODATO_C",PP."FECHA_CAMBIODATO_D",PP."FECHA_ACTUALIZ_DATOS",PP."FECHA_ACTUALIZACION",PP."FECHA_RIESGO",PP."ID_METODO_VERIF_IDENTIDAD",PP."NOMBRE_CONTACTO",PP."OFICIAL_ATENCION",PP."ES_PEP",PP."RESIDENCIA",PP."TIPO_RESIDENCIA",PP."NRO_PERMISORES",PP."COD_PAIS_RESIDENCIA",PP."TIPO_SITUACION_FISCAL",PP."OBSERVACIONES",PP."MAXATRANSAR",PP."MINATRANSAR",PP."TIPO_TRATAMIENTO",PP."SEGMENTO",PP."NOMBRE_FANTASIA",PP."PT_MONTO_CALCULADO",PP."PT_MONTO_INFORMADO",PP."PT_MANUAL_AUTOMATICO",PP."ES_SUJETO_OBLIGADO",PP."SO_CUMPLE_OBLIGACION",PP."CODSECTORCLIENTE",PP."SC51",PP."SC52",PP."SC53",PP."LINEA_DE_NEGOCIO",PP."CODACTIVIDADAFIP",PP."CODACTIVIDADSEC",PP."CIERREBALANCE",PP."CODTIPOORIGENALTA",PP."FECHAINICIOACTIVIDAD",PP."FECHAVENCESTATUTO",PP."FECHADECESO",PP."INSCRIPCION_CODORG",PP."INSCRIPCION_FECHA",PP."INSCRIPCION_FOLIO",PP."INSCRIPCION_NRO",PP."INSCRIPCION_TOMO",PP."ADMINISTRA_FONDOS_3RO",PP."NOMBRE_CONYUGE",PP."TIPO_DIRECCION",PP."CALLE",PP."NUMERO",PP."OFICINA",PP."PISO",PP."NOMBRE_EDIFICIO",PP."BARRIO",PP."CIUDAD",PP."COD_CIUDAD",PP."DEPARTAMENTO",PP."COD_DE_DEPARTAMENTO",PP."COD_DISTRITO",PP."COD_PAIS_DOMICILIO",PP."COD_POSTAL",PP."CORREO_ELECTRONICO",PP."DIR_WEB",PP."FAX",PP."TELEFONO",PP."TELEFONO_1",PP."TELEFONO_2",PP."TEL_MOVIL",PP."INFOADICIONAL1",PP."GE_CLIENTE",PP."FEC_PROCESO" --count(*) as cantidad,PP.NRO_CLIENTE/*,PP.MARCA*/
FROM (
SELECT
to_number(PE.COD_PERSONA) AS NRO_CLIENTE,
PE.TIPO AS TIPO_PERSONA,
CASE WHEN PE.TIPO = 'F' THEN FI.PRI_APELLIDO ELSE NULL END AS APELLIDO,
CASE WHEN PE.TIPO = 'F' THEN FI.SEG_APELLIDO ELSE NULL END AS SEGUNDO_APELLIDO,
CASE WHEN PE.TIPO = 'F' THEN FI.PRI_NOMBRE ELSE NULL END AS PRIMER_NOMBRE,
CASE WHEN PE.TIPO = 'F' THEN FI.SEG_NOMBRE ELSE NULL END AS SEGUNDO_NOMBRE,
CASE WHEN PE.TIPO = 'J' THEN
CASE WHEN LENGTH (JU.RAZ_SOCIAL) > 100 THEN SUBSTR(JU.RAZ_SOCIAL ,0,100) ELSE JU.RAZ_SOCIAL END
ELSE NULL END AS RAZON_SOCIAL,
NULL AS COD_ALTERNATIVO_CLIENTE,
FI.COD_SEXO AS SEXO,
to_char(PE.COD_TIP_DOCUMENTO) AS TIPO_DOCUMENTO_1,
PE.NRO_DOCUMENTO AS NRO_DOCUMENTO_1,
NULL AS DOC_EXPEDIDO_POR_1,
NULL AS FECHA_EXPEDICION_1,
NULL AS TIPO_DOCUMENTO_2,
NULL AS NRO_DOCUMENTO_2,
NULL AS DOC_EXPEDIDO_POR_2,
NULL AS FECHA_EXPEDICION_2,
NULL AS TIPO_DOCUMENTO_3,
NULL AS NRO_DOCUMENTO_3,
NULL AS DOC_EXPEDIDO_POR_3,
NULL AS FECHA_EXPEDICION_3,
NULL AS TIPO_DOCUMENTO_4,
NULL AS NRO_DOCUMENTO_4,
NULL AS DOC_EXPEDIDO_POR_4,
NULL AS FECHA_EXPEDICION_4,
CASE WHEN JU.FEC_APERTURA < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE  TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') END AS FECHA_CONSTITUCION,
CASE WHEN FI.FEC_NACIMIENTO < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE TO_CHAR(FI.FEC_NACIMIENTO,'yyyy-mm-dd') END AS FECHA_NACIMIENTO,
NULL AS LUGAR_NACIMIENTO,
to_char(PE.COD_PAIS) AS COD_PAIS,
to_char(FI.COD_PAI_NACIONALIDAD) AS NACIONALIDAD,
FI.EST_CIVIL AS ESTADO_CIVIL,
to_char(PE.COD_RUB_PRIMARIO) AS COD_ACTIVIDAD, --se ajusta a RI-2
to_char(FI.COD_PROFESION) AS COD_PROFESION,
CASE WHEN PE.TIPO = 'F' THEN '0' ELSE TO_CHAR(NVL(JU.NATURALEZA,0)) END AS COD_FORMA_JURIDICA,
to_char(GE.COD_SEG_CLIENTE) AS TIPO_CLIENTE,
NULL AS COMUNICADO,
CASE WHEN GE.COD_GRU_ECONOMICO = 1 THEN 0 ELSE 1 END AS CONOCIMIENTO_CLIENTE,
--CASE WHEN nvl(LA.MTO_INGRESO,0) IS NULL THEN nvl((PE.TOT_INGRESOS*12),0)ELSE nvl((LA.MTO_INGRESO*12),0) END AS INGRESO_ANUAL_DECLARADO,
CASE WHEN nvl(LA.MTO_INGRESO,0) IS NULL THEN ROUND(nvl((PE.TOT_INGRESOS*12),0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6)))
ELSE ROUND(nvl((LA.MTO_INGRESO*12),0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))) END AS INGRESO_ANUAL_DECLARADO,
NULL AS DP_ACTIVO,
NULL AS DP_INGRESOS,
NULL AS DP_PASIVO,
NULL AS DP_PATRIMONIO_NETO,
to_char(GE.COD_OFICINA) AS COD_SUCURSAL, ---OFICINA DEL CLIENTE
CASE WHEN GE.COD_SEG_CLIENTE = 1 THEN '1' ELSE '0' END AS ES_EMPLEADO,
NULL AS EMPLEADO_DEPARTAMENTO,
NULL AS EMPLEADO_STATUS,
CASE WHEN GE.COD_SEC_CONTABLE IN ('F','I') THEN '1' ELSE '0' END AS ES_INST_FINANCIERA,
CASE WHEN GE.COD_SEC_CONTABLE IN ('P') THEN '1' ELSE '0' END AS ES_INST_PUBLICA,
TO_CHAR(PE.FEC_INSERCION,'yyyy-mm-dd') AS FECHA_ALTA, --DATO APLICA PARA REGISTROS NATIVOS EN ITGF
NULL AS FECHA_BAJA,
NULL AS FECHA_CAMBIODATO_A,
NULL AS FECHA_CAMBIODATO_B,
NULL AS FECHA_CAMBIODATO_C,
NULL AS FECHA_CAMBIODATO_D,
TO_CHAR(PE.FEC_MODIFICACION,'yyyy-mm-dd') AS FECHA_ACTUALIZ_DATOS,
NULL AS FECHA_ACTUALIZACION,
NULL AS FECHA_RIESGO,
NULL AS ID_METODO_VERIF_IDENTIDAD,
NULL AS NOMBRE_CONTACTO,
GE.COD_USU_OFICIAL||' - '||US.NOMBRE AS OFICIAL_ATENCION , --OFICIAL DEL CLIENTE
CASE WHEN FO.PEP = 'S' THEN '1' ELSE '0' END AS ES_PEP,
CASE WHEN GE.RESIDENTE = 'S' THEN '1' ELSE '0' END AS RESIDENCIA,
FI.COD_TIP_VIVIENDA AS TIPO_RESIDENCIA, --DATO APLICA PARA REGISTROS NATIVOS EN ITGF
NULL AS NRO_PERMISORES,
to_char(DI.COD_PAIS) AS COD_PAIS_RESIDENCIA,-- / TIPO = 'P'/ MAX (COD_DIRECCION)
to_char(PE.TIP_IVA) AS TIPO_SITUACION_FISCAL,
NULL AS OBSERVACIONES,
--ROUND(LOA.MTO_LIMITE,0) AS MAXATRANSAR, --LIMITE MENSUAL
CASE WHEN LOA.COD_MONEDA = 'GS' THEN
ROUND(ROUND(LOA.MTO_LIMITE,0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))) ELSE NVL(LOA.MTO_LIMITE,0) END AS MAXATRANSAR,
NULL AS MINATRANSAR,
CASE WHEN POC.COD_PERSONA IS NULL THEN 'NOCLIENTE' ELSE 'CLIENTE' END AS TIPO_TRATAMIENTO, --marca tiene producto activo
NULL AS SEGMENTO,
JU.NOM_COMERCIAL AS NOMBRE_FANTASIA,
NULL AS PT_MONTO_CALCULADO,
NULL AS PT_MONTO_INFORMADO,
NULL AS PT_MANUAL_AUTOMATICO,
--NULL AS ES_SUJETO_OBLIGADO,
CASE WHEN (SELECT NVL(DA.VAL_PARAMETRO,'N') FROM BA_PER_DAT_ADICIONALES DA WHERE DA.PARAMETRO = 'PER_IND_SUJ_OBLIGADO' AND DA.COD_PERSONA = PE.COD_PERSONA) = 'S' THEN '1'
ELSE '0' END AS ES_SUJETO_OBLIGADO,
NULL AS SO_CUMPLE_OBLIGACION,
CASE WHEN LA.COD_RAMO = 0 THEN NULL ELSE TO_CHAR(LA.COD_RAMO) END AS CODSECTORCLIENTE, -- se ajusta a RI-2
NULL AS SC51,
NULL AS SC52,
--NULL AS SC53,
CASE WHEN (SELECT NVL(DA.VAL_PARAMETRO,'N') FROM BA_PER_DAT_ADICIONALES DA WHERE DA.PARAMETRO = 'PER_IND_DEB_DIL_AMPLIADA' AND DA.COD_PERSONA = PE.COD_PERSONA) = 'S' THEN '1'
ELSE '0' END AS SC53,
NULL AS LINEA_DE_NEGOCIO,
to_char(PE.COD_RUB_PRIMARIO) AS CODACTIVIDADAFIP,
to_char(PE.COD_RUB_SECUNDARIO) AS CODACTIVIDADSEC,
NULL AS CIERREBALANCE,
NULL AS CODTIPOORIGENALTA,
CASE WHEN JU.FEC_APERTURA < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE  TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') END AS FECHAINICIOACTIVIDAD,
--TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') AS FECHAINICIOACTIVIDAD,
NULL AS FECHAVENCESTATUTO,
NULL AS FECHADECESO,
NULL AS INSCRIPCION_CODORG,
NULL AS INSCRIPCION_FECHA,
NULL AS INSCRIPCION_FOLIO,
NULL AS INSCRIPCION_NRO,
NULL AS INSCRIPCION_TOMO,
NULL AS ADMINISTRA_FONDOS_3RO,
FUE_OBT_NOM_PERSONA (VI.COD_PER_VINCULO)  AS NOMBRE_CONYUGE,
--to_char(DI.COD_DIRECCION) AS TIPO_DIRECCION, -- /  PRINCIPAL ='S'
DI.TIPO AS TIPO_DIRECCION, -- /  PRINCIPAL ='S'
DI.DIRECCION AS CALLE,
DI.NUMERO AS NUMERO,
CASE WHEN LENGTH (DI.DEPARTAMENTO) > 5 THEN SUBSTR(DI.DEPARTAMENTO,0,5)ELSE DI.DEPARTAMENTO  END AS OFICINA,
CASE WHEN LENGTH (DI.PISO) > 3 THEN SUBSTR(DI.PISO,0,3)ELSE DI.PISO END AS PISO,
DI.EDIFICIO AS NOMBRE_EDIFICIO,
to_char(DI.COD_BARRIO) AS BARRIO,
NULL AS CIUDAD,
to_char(DI.COD_CIUDAD) AS COD_CIUDAD,
NULL AS DEPARTAMENTO,
/*CASE WHEN GE.COD_DEPARTAMENTO IS NULL THEN  to_char(CI.COD_DEPARTAMENTO)
 ELSE to_char(GE.COD_DEPARTAMENTO) END AS COD_DE_DEPARTAMENTO,*/
to_char(CI.COD_DEPARTAMENTO) AS COD_DE_DEPARTAMENTO,
TO_CHAR(DI.COD_CIUDAD) AS COD_DISTRITO,
/*CASE WHEN DP.COD_PAIS IS NULL THEN to_char(CI.COD_PAIS)
 ELSE to_char(DP.COD_PAIS) END AS COD_PAIS_DOMICILIO,*/ -- / TIPO = 'P'
to_char(DI.COD_PAIS)  AS COD_PAIS_DOMICILIO,
to_char(DI.COD_POSTAL) AS COD_POSTAL,
PE.DIR_CORREO AS CORREO_ELECTRONICO,
NULL AS DIR_WEB,
NULL AS FAX,
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TE WHERE PRINCIPAL = 'S' AND TE.COD_PERSONA = PE.COD_PERSONA) AS TELEFONO, -- / PRINCIPAL= 'S'
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEP WHERE TEP.COD_PERSONA = PE.COD_PERSONA AND TEP.TIPO= 'P'
    AND TEP.COD_TELEFONO = (SELECT MAX(TEP2.COD_TELEFONO) FROM BA_TELEFONOS TEP2 WHERE TEP2.COD_PERSONA = PE.COD_PERSONA AND TEP.TIPO = TEP2.TIPO)) AS TELEFONO_1, -- / TIPO = 'P' / MAX (COD_TELEFONO)
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEL WHERE TEL.COD_PERSONA = PE.COD_PERSONA AND TEL.TIPO= 'L'
    AND TEL.COD_TELEFONO = (SELECT MAX(TEL2.COD_TELEFONO) FROM BA_TELEFONOS TEL2 WHERE TEL2.COD_PERSONA = PE.COD_PERSONA AND TEL.TIPO = TEL2.TIPO)) AS TELEFONO_2, -- / TIPO = 'L' / MAX (COD_TELEFONO)
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEC WHERE TEC.COD_PERSONA = PE.COD_PERSONA AND TIP_LINEA = 'C'
    AND TEC.COD_TELEFONO = (SELECT MAX(TEC2.COD_TELEFONO) FROM BA_TELEFONOS TEC2 WHERE TEC2.COD_PERSONA = PE.COD_PERSONA AND TEC.TIP_LINEA  = TEC2.TIP_LINEA)) AS TEL_MOVIL, -- / TIP_LINEA = 'C' / MAX (COD_TELEFONO)
LA.TIP_CARGO AS INFOADICIONAL1,
-------------------------------------------------------hasta aqui estructura Vigia
CASE WHEN GE.COD_PERSONA IS NULL THEN 0 ELSE 1 END AS GE_CLIENTE ,
--'ALTA' AS MARCA,
trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/  AS FEC_PROCESO
-------------------------------------------------------PERSONAS
FROM BA_PERSONAS PE
LEFT JOIN GE_CLIENTES GE
  ON GE.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_FISICAS FI
  ON FI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_JURIDICAS JU
  ON JU.COD_PERSONA = PE.COD_PERSONA
/*LEFT JOIN BA_VINCULOS VI
  ON VI.COD_PERSONA = PE.COD_PERSONA AND VI.TIPO = 'E' AND VI.ACTIVO= 'S'
  AND VI.FEC_INSERCION = (SELECT MAX(FEC_INSERCION) FROM BA_VINCULOS VI2 WHERE VI2.COD_PERSONA = VI.COD_PERSONA)
  AND VI.COD_PER_VINCULO = (SELECT MAX(COD_PER_VINCULO) FROM BA_VINCULOS VI3 WHERE VI.COD_PERSONA = VI.COD_PERSONA)*/
LEFT JOIN (SELECT VI1.COD_PER_VINCULO, VI1.COD_PERSONA
FROM BA_VINCULOS VI1
WHERE VI1.TIPO = 'E' AND VI1.ACTIVO = 'S'
AND VI1.FEC_INSERCION = (SELECT MAX(FEC_INSERCION) FROM BA_VINCULOS VI2 WHERE VI2.COD_PERSONA = VI1.COD_PERSONA)
AND VI1.COD_PER_VINCULO = (SELECT MAX(COD_PER_VINCULO) FROM BA_VINCULOS VI3 WHERE VI3.COD_PERSONA = VI1.COD_PERSONA)) VI ON VI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_DIRECCIONES DI
  ON DI.COD_PERSONA = PE.COD_PERSONA AND DI.PRINCIPAL = 'S'
LEFT JOIN BA_USUARIOS US
  ON US.COD_USUARIO = GE.COD_USU_OFICIAL
LEFT JOIN CR_INF_FONDOS FO
  ON FO.COD_PERSONA = PE.COD_PERSONA
/*LEFT JOIN CR_INF_LABORALES LA
  ON LA.COD_PERSONA = PE.COD_PERSONA AND LA.ACTUAL = 'S'
  AND LA.NRO_SECUENCIA = (SELECT MAX(NRO_SECUENCIA) FROM CR_INF_LABORALES LAP WHERE LAP.COD_PERSONA = LA.COD_PERSONA AND LAP.ACTUAL = LA.ACTUAL )*/
LEFT JOIN (SELECT LA1.COD_PERSONA, LA1.TIP_CARGO, LA1.COD_RAMO, LA1.MTO_INGRESO
FROM CR_INF_LABORALES LA1
WHERE LA1.ACTUAL = 'S' AND LA1.NRO_SECUENCIA = (SELECT MAX(NRO_SECUENCIA) FROM CR_INF_LABORALES LAP WHERE LAP.COD_PERSONA = LA1.COD_PERSONA AND LAP.ACTUAL = LA1.ACTUAL )) LA
ON LA.COD_PERSONA = PE.COD_PERSONA
/*LEFT JOIN CR_PER_TIP_OPERACIONES LOA
  ON LOA.COD_PERSONA = PE.COD_PERSONA AND LOA.COD_MONEDA = 'GS'
  AND LOA.rowid=(select max(q.rowid) from CR_PER_TIP_OPERACIONES q where q.cod_persona= loa.cod_persona)*/
LEFT JOIN (SELECT LOA1.MTO_LIMITE, LOA1.COD_PERSONA, LOA1.COD_MONEDA FROM CR_PER_TIP_OPERACIONES LOA1
WHERE /*LOA1.COD_MONEDA = 'GS'
AND*/ LOA1.rowid=(select max(q.rowid) from CR_PER_TIP_OPERACIONES q where q.cod_persona= LOA1.cod_persona)) LOA ON LOA.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_CIUDADES CI ON CI.COD_CIUDAD = DI.COD_CIUDAD AND CI.COD_PAIS = DI.COD_PAIS
LEFT JOIN (SELECT SUM(F.CANTIDAD) AS PROD_ACT,F.COD_PERSONA,P.NRO_DOCUMENTO,P.TIPO,P.NOM_COMPLETO,(G.COD_SEG_CLIENTE || '-' ||S.DESCRIPCION) AS SEGMENTO
FROM (
  /*PRESTAMOS  QUE NO ESTEN EN ESTADO CANCELADO*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'PR' AS MARCA  FROM GE_CTA_CLIENTES G
  INNER JOIN PR_CTA_PRESTAMOS PR ON PR.NRO_CUENTA = G.NRO_CUENTA
  WHERE /* G.RELACION = 'P' AND*/ PR.ESTADO NOT IN ('N') GROUP BY G.COD_PERSONA
UNION
  /*TARJETAS QUE NO ESTEN EN ESTADO CANCELADO*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'TA' AS MARCA  FROM GE_CTA_CLIENTES G
  INNER JOIN TA_CTA_TARJETAS TA ON TA.NRO_CUENTA = G.NRO_CUENTA
  WHERE /*G.RELACION = 'P' AND*/ TA.ESTADO <> 'C' GROUP BY G.COD_PERSONA
UNION
  /*CDAS QUE NO ESTEN EN ESTADO CANCELADO,TOTALMENTE PAGADA Y EN VERIFICACION*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'CDA' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN AH_CTA_CERTIFICADOS CDA ON CDA.NRO_CUENTA = G.NRO_CUENTA
  WHERE  /*G.RELACION = 'P'AND*/ CDA.ESTADO NOT IN ('T','X','C')  GROUP BY G.COD_PERSONA
UNION
  /*CAH QUE NO ESTEN EN ESTADO CANCELADOS, VERIFICACION, INACTIVOS*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'CAH' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN AH_CTA_VISTAS CAH ON CAH.NRO_CUENTA = G.NRO_CUENTA
  WHERE /*G.RELACION = 'P' AND*/ CAH.ESTADO NOT IN (/*'I',*/'C','X')  GROUP BY G.COD_PERSONA
UNION
  /*OPERACIONES MODULO 15 PASES A VENCIDO QUE NO ESTEN CANCELADAS*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'OV' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN OV_CTA_VENCIDAS OV ON OV.NRO_CUENTA = G.NRO_CUENTA
  WHERE  /*G.RELACION = 'P' AND*/ OV.ESTADO NOT IN ('C')  GROUP BY G.COD_PERSONA
UNION
  /*OPERACIONES MODULO 4 LIMITE DE CAMNBIOS QUE NO ESTEN CANCELADAS O INACTIVA*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'LC' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN LC_CTA_CAMBIOS LC ON LC.NRO_CUENTA = G.NRO_CUENTA
  WHERE  /*G.RELACION = 'P' AND*/ LC.ESTADO NOT IN ('C','I')  GROUP BY G.COD_PERSONA
UNION
  /*OPERACIONES MODULO 10 MESA DE DIENRO QUE NO ESTEN EN ESTADO CANCELADO*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'MD' AS MARCA  FROM GE_CTA_CLIENTES G
  INNER JOIN MD_CTA_DOCUMENTOS MD ON MD.NRO_CUENTA = G.NRO_CUENTA
  WHERE /* G.RELACION = 'P' AND*/ MD.ESTADO NOT IN ('N') GROUP BY G.COD_PERSONA
UNION
  /*LIBRADORES DE CHEQUES DE CUENTAS QUE NO ESTEN CANCELADAS*/
  SELECT COUNT(*) CANTIDAD,BA.COD_PERSONA,'LIB' AS MARCA FROM PR_REL_CHQ_LIB RELI
  INNER JOIN BA_PERSONAS BA ON BA.NRO_DOCUMENTO = RELI.NRO_DOCUMENTO
  INNER JOIN GE_CHE_CUSTODIAS CHE ON CHE.NRO_CHEQUE = RELI.NRO_CHEQUE AND CHE.CTA_LIBRADORA = RELI.CTA_LIBRADORA
  INNER JOIN PR_CTA_PRESTAMOS PR ON PR.NRO_CUENTA = CHE.NRO_REFERENCIA
  WHERE PR.ESTADO <> 'N'  GROUP BY BA.COD_PERSONA
) F
LEFT JOIN GE_CLIENTES G ON F.COD_PERSONA = G.COD_PERSONA
LEFT JOIN BA_PERSONAS P ON P.COD_PERSONA = G.COD_PERSONA
LEFT JOIN GE_SEG_CLIENTES S ON S.COD_SEG_CLIENTE = G.COD_SEG_CLIENTE
GROUP BY F.COD_PERSONA,P.NRO_DOCUMENTO,P.TIPO,P.NOM_COMPLETO,G.COD_SEG_CLIENTE,S.DESCRIPCION --) >= 1
HAVING COUNT(*) >0
ORDER BY COD_PERSONA ) POC ON POC.COD_PERSONA = PE.COD_PERSONA
-----------------------------------------------------------------------------------------------------------------------------------
WHERE  trunc(PE.FEC_INSERCION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
AND PE.COD_TIP_DOCUMENTO NOT IN (9,10)
--) PP GROUP BY PP.NRO_CLIENTE HAVING (COUNT(*)) > 1
UNION-----------------------------------------------------------------------------------**************************--------------------
--select count(*) as cantidad,PP.NRO_CLIENTE FROM (
SELECT
to_number(PE.COD_PERSONA) AS NRO_CLIENTE,
PE.TIPO AS TIPO_PERSONA,
CASE WHEN PE.TIPO = 'F' THEN FI.PRI_APELLIDO ELSE NULL END AS APELLIDO,
CASE WHEN PE.TIPO = 'F' THEN FI.SEG_APELLIDO ELSE NULL END AS SEGUNDO_APELLIDO,
CASE WHEN PE.TIPO = 'F' THEN FI.PRI_NOMBRE ELSE NULL END AS PRIMER_NOMBRE,
CASE WHEN PE.TIPO = 'F' THEN FI.SEG_NOMBRE ELSE NULL END AS SEGUNDO_NOMBRE,
CASE WHEN PE.TIPO = 'J' THEN
CASE WHEN LENGTH (JU.RAZ_SOCIAL) > 100 THEN SUBSTR(JU.RAZ_SOCIAL ,0,100) ELSE JU.RAZ_SOCIAL END
ELSE NULL END AS RAZON_SOCIAL,
NULL AS COD_ALTERNATIVO_CLIENTE,
FI.COD_SEXO AS SEXO,
to_char(PE.COD_TIP_DOCUMENTO) AS TIPO_DOCUMENTO_1,
PE.NRO_DOCUMENTO AS NRO_DOCUMENTO_1,
NULL AS DOC_EXPEDIDO_POR_1,
NULL AS FECHA_EXPEDICION_1,
NULL AS TIPO_DOCUMENTO_2,
NULL AS NRO_DOCUMENTO_2,
NULL AS DOC_EXPEDIDO_POR_2,
NULL AS FECHA_EXPEDICION_2,
NULL AS TIPO_DOCUMENTO_3,
NULL AS NRO_DOCUMENTO_3,
NULL AS DOC_EXPEDIDO_POR_3,
NULL AS FECHA_EXPEDICION_3,
NULL AS TIPO_DOCUMENTO_4,
NULL AS NRO_DOCUMENTO_4,
NULL AS DOC_EXPEDIDO_POR_4,
NULL AS FECHA_EXPEDICION_4,
CASE WHEN JU.FEC_APERTURA < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE  TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') END AS FECHA_CONSTITUCION,
CASE WHEN FI.FEC_NACIMIENTO < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE TO_CHAR(FI.FEC_NACIMIENTO,'yyyy-mm-dd') END AS FECHA_NACIMIENTO,
NULL AS LUGAR_NACIMIENTO,
to_char(PE.COD_PAIS) AS COD_PAIS,
to_char(FI.COD_PAI_NACIONALIDAD) AS NACIONALIDAD,
FI.EST_CIVIL AS ESTADO_CIVIL,
to_char(PE.COD_RUB_PRIMARIO) AS COD_ACTIVIDAD, --se ajusta a RI-2
to_char(FI.COD_PROFESION) AS COD_PROFESION,
CASE WHEN PE.TIPO = 'F' THEN '0' ELSE TO_CHAR(NVL(JU.NATURALEZA,0)) END AS COD_FORMA_JURIDICA,
to_char(GE.COD_SEG_CLIENTE) AS TIPO_CLIENTE,
NULL AS COMUNICADO,
CASE WHEN GE.COD_GRU_ECONOMICO = 1 THEN 0 ELSE 1 END AS CONOCIMIENTO_CLIENTE,
--CASE WHEN nvl(LA.MTO_INGRESO,0) IS NULL THEN nvl((PE.TOT_INGRESOS*12),0)ELSE nvl((LA.MTO_INGRESO*12),0) END AS INGRESO_ANUAL_DECLARADO,
CASE WHEN nvl(LA.MTO_INGRESO,0) IS NULL THEN ROUND(nvl((PE.TOT_INGRESOS*12),0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6)))
ELSE ROUND(nvl((LA.MTO_INGRESO*12),0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))) END AS INGRESO_ANUAL_DECLARADO,
NULL AS DP_ACTIVO,
NULL AS DP_INGRESOS,
NULL AS DP_PASIVO,
NULL AS DP_PATRIMONIO_NETO,
to_char(GE.COD_OFICINA) AS COD_SUCURSAL, ---OFICINA DEL CLIENTE
CASE WHEN GE.COD_SEG_CLIENTE = 1 THEN '1' ELSE '0' END AS ES_EMPLEADO,
NULL AS EMPLEADO_DEPARTAMENTO,
NULL AS EMPLEADO_STATUS,
CASE WHEN GE.COD_SEC_CONTABLE IN ('F','I') THEN '1' ELSE '0' END AS ES_INST_FINANCIERA,
CASE WHEN GE.COD_SEC_CONTABLE IN ('P') THEN '1' ELSE '0' END AS ES_INST_PUBLICA,
TO_CHAR(PE.FEC_INSERCION,'yyyy-mm-dd') AS FECHA_ALTA,
NULL AS FECHA_BAJA,
NULL AS FECHA_CAMBIODATO_A,
NULL AS FECHA_CAMBIODATO_B,
NULL AS FECHA_CAMBIODATO_C,
NULL AS FECHA_CAMBIODATO_D,
TO_CHAR(pag_cal.fu_obt_fec_actual(6),'yyyy-mm-dd') AS FECHA_ACTUALIZ_DATOS,
NULL AS FECHA_ACTUALIZACION,
NULL AS FECHA_RIESGO,
NULL AS ID_METODO_VERIF_IDENTIDAD,
NULL AS NOMBRE_CONTACTO,
GE.COD_USU_OFICIAL||' - '||US.NOMBRE AS OFICIAL_ATENCION , --OFICIAL DEL CLIENTE
CASE WHEN FO.PEP = 'S' THEN '1' ELSE '0' END AS ES_PEP,
CASE WHEN GE.RESIDENTE = 'S' THEN '1' ELSE '0' END AS RESIDENCIA,
FI.COD_TIP_VIVIENDA AS TIPO_RESIDENCIA, --DATO APLICA PARA REGISTROS NATIVOS EN ITGF
NULL AS NRO_PERMISORES,
to_char(DI.COD_PAIS) AS COD_PAIS_RESIDENCIA,-- / TIPO = 'P'/ MAX (COD_DIRECCION)
to_char(PE.TIP_IVA) AS TIPO_SITUACION_FISCAL,
NULL AS OBSERVACIONES,
--ROUND(LOA.MTO_LIMITE,0) AS MAXATRANSAR, --LIMITE MENSUAL
CASE WHEN LOA.COD_MONEDA = 'GS' THEN
ROUND(ROUND(LOA.MTO_LIMITE,0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))) ELSE NVL(LOA.MTO_LIMITE,0) END AS MAXATRANSAR,
--ROUND(ROUND(LOA.MTO_LIMITE,0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))) AS MAXATRANSAR,
NULL AS MINATRANSAR,
CASE WHEN POC.COD_PERSONA IS NULL THEN 'NOCLIENTE' ELSE 'CLIENTE' END AS TIPO_TRATAMIENTO, --marca tiene producto activo
NULL AS SEGMENTO,
JU.NOM_COMERCIAL AS NOMBRE_FANTASIA,
NULL AS PT_MONTO_CALCULADO,
NULL AS PT_MONTO_INFORMADO,
NULL AS PT_MANUAL_AUTOMATICO,
--NULL AS ES_SUJETO_OBLIGADO,
CASE WHEN (SELECT NVL(DA.VAL_PARAMETRO,'N') FROM BA_PER_DAT_ADICIONALES DA WHERE DA.PARAMETRO = 'PER_IND_SUJ_OBLIGADO' AND DA.COD_PERSONA = PE.COD_PERSONA) = 'S' THEN '1'
ELSE '0' END AS ES_SUJETO_OBLIGADO,
NULL AS SO_CUMPLE_OBLIGACION,
CASE WHEN LA.COD_RAMO = 0 THEN NULL ELSE TO_CHAR(LA.COD_RAMO) END AS CODSECTORCLIENTE, -- se ajusta a RI-2
NULL AS SC51,
NULL AS SC52,
--NULL AS SC53,
CASE WHEN (SELECT NVL(DA.VAL_PARAMETRO,'N') FROM BA_PER_DAT_ADICIONALES DA WHERE DA.PARAMETRO = 'PER_IND_DEB_DIL_AMPLIADA' AND DA.COD_PERSONA = PE.COD_PERSONA) = 'S' THEN '1'
ELSE '0' END AS SC53,
NULL AS LINEA_DE_NEGOCIO,
to_char(PE.COD_RUB_PRIMARIO) AS CODACTIVIDADAFIP,
to_char(PE.COD_RUB_SECUNDARIO) AS CODACTIVIDADSEC,
NULL AS CIERREBALANCE,
NULL AS CODTIPOORIGENALTA,
CASE WHEN JU.FEC_APERTURA < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE  TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') END AS FECHAINICIOACTIVIDAD,
--TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') AS FECHAINICIOACTIVIDAD,
NULL AS FECHAVENCESTATUTO,
NULL AS FECHADECESO,
NULL AS INSCRIPCION_CODORG,
NULL AS INSCRIPCION_FECHA,
NULL AS INSCRIPCION_FOLIO,
NULL AS INSCRIPCION_NRO,
NULL AS INSCRIPCION_TOMO,
NULL AS ADMINISTRA_FONDOS_3RO,
FUE_OBT_NOM_PERSONA (VI.COD_PER_VINCULO)  AS NOMBRE_CONYUGE,
--to_char(DI.COD_DIRECCION) AS TIPO_DIRECCION, -- /  PRINCIPAL ='S'
DI.TIPO AS TIPO_DIRECCION, -- /  PRINCIPAL ='S'
DI.DIRECCION AS CALLE,
DI.NUMERO AS NUMERO,
CASE WHEN LENGTH (DI.DEPARTAMENTO) > 5 THEN SUBSTR(DI.DEPARTAMENTO,0,5)ELSE DI.DEPARTAMENTO END  AS OFICINA,
CASE WHEN LENGTH (DI.PISO) > 3 THEN SUBSTR(DI.PISO,0,3)ELSE DI.PISO END AS PISO,
DI.EDIFICIO AS NOMBRE_EDIFICIO,
to_char(DI.COD_BARRIO) AS BARRIO,
NULL AS CIUDAD,
to_char(DI.COD_CIUDAD) AS COD_CIUDAD,
NULL AS DEPARTAMENTO,
to_char(CI.COD_DEPARTAMENTO) AS COD_DE_DEPARTAMENTO,
TO_CHAR(DI.COD_CIUDAD) AS COD_DISTRITO,
to_char(DI.COD_PAIS)  AS COD_PAIS_DOMICILIO,
to_char(DI.COD_POSTAL) AS COD_POSTAL,
PE.DIR_CORREO AS CORREO_ELECTRONICO,
NULL AS DIR_WEB,
NULL AS FAX,
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TE WHERE PRINCIPAL = 'S' AND TE.COD_PERSONA = PE.COD_PERSONA) AS TELEFONO, -- / PRINCIPAL= 'S'
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEP WHERE TEP.COD_PERSONA = PE.COD_PERSONA AND TEP.TIPO= 'P'
    AND TEP.COD_TELEFONO = (SELECT MAX(TEP2.COD_TELEFONO) FROM BA_TELEFONOS TEP2 WHERE TEP2.COD_PERSONA = PE.COD_PERSONA AND TEP.TIPO = TEP2.TIPO)) AS TELEFONO_1, -- / TIPO = 'P' / MAX (COD_TELEFONO)
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEL WHERE TEL.COD_PERSONA = PE.COD_PERSONA AND TEL.TIPO= 'L'
    AND TEL.COD_TELEFONO = (SELECT MAX(TEL2.COD_TELEFONO) FROM BA_TELEFONOS TEL2 WHERE TEL2.COD_PERSONA = PE.COD_PERSONA AND TEL.TIPO = TEL2.TIPO)) AS TELEFONO_2, -- / TIPO = 'L' / MAX (COD_TELEFONO)
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEC WHERE TEC.COD_PERSONA = PE.COD_PERSONA AND TIP_LINEA = 'C'
    AND TEC.COD_TELEFONO = (SELECT MAX(TEC2.COD_TELEFONO) FROM BA_TELEFONOS TEC2 WHERE TEC2.COD_PERSONA = PE.COD_PERSONA AND TEC.TIP_LINEA  = TEC2.TIP_LINEA)) AS TEL_MOVIL, -- / TIP_LINEA = 'C' / MAX (COD_TELEFONO)
LA.TIP_CARGO AS INFOADICIONAL1,
-------------------------------------------------------hasta aqui estructura Vigia
CASE WHEN GE.COD_PERSONA IS NULL THEN 0 ELSE 1 END AS GE_CLIENTE ,
--'MODIFICACION' AS MARCA,
trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AS FEC_PROCESO --TO_DATE('23/09/2022','dd/mm/yyyy')
-------------------------------------------------------PERSONAS
FROM BA_PERSONAS PE
LEFT JOIN GE_CLIENTES GE
  ON GE.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_FISICAS FI
  ON FI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_JURIDICAS JU
  ON JU.COD_PERSONA = PE.COD_PERSONA
/*LEFT JOIN BA_VINCULOS VI
  ON VI.COD_PERSONA = PE.COD_PERSONA AND VI.TIPO = 'E' AND VI.ACTIVO= 'S'
  AND VI.FEC_INSERCION = (SELECT MAX(FEC_INSERCION) FROM BA_VINCULOS VI2 WHERE VI2.COD_PERSONA = VI.COD_PERSONA)
  AND VI.COD_PER_VINCULO = (SELECT MAX(COD_PER_VINCULO) FROM BA_VINCULOS VI3 WHERE VI.COD_PERSONA = VI.COD_PERSONA)*/
LEFT JOIN (SELECT VI1.COD_PER_VINCULO, VI1.COD_PERSONA
FROM BA_VINCULOS VI1
WHERE VI1.TIPO = 'E' AND VI1.ACTIVO = 'S'
AND VI1.FEC_INSERCION = (SELECT MAX(FEC_INSERCION) FROM BA_VINCULOS VI2 WHERE VI2.COD_PERSONA = VI1.COD_PERSONA)
AND VI1.COD_PER_VINCULO = (SELECT MAX(COD_PER_VINCULO) FROM BA_VINCULOS VI3 WHERE VI3.COD_PERSONA = VI1.COD_PERSONA)) VI ON VI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_DIRECCIONES DI
  ON DI.COD_PERSONA = PE.COD_PERSONA AND DI.PRINCIPAL = 'S'
LEFT JOIN BA_USUARIOS US
  ON US.COD_USUARIO = GE.COD_USU_OFICIAL
LEFT JOIN CR_INF_FONDOS FO
  ON FO.COD_PERSONA = PE.COD_PERSONA
/*LEFT JOIN CR_INF_LABORALES LA
  ON LA.COD_PERSONA = PE.COD_PERSONA AND LA.ACTUAL = 'S'
  AND LA.NRO_SECUENCIA = (SELECT MAX(NRO_SECUENCIA) FROM CR_INF_LABORALES LAP WHERE LAP.COD_PERSONA = LA.COD_PERSONA AND LAP.ACTUAL = LA.ACTUAL )*/
  LEFT JOIN (SELECT LA1.COD_PERSONA, LA1.TIP_CARGO, LA1.COD_RAMO, LA1.MTO_INGRESO,LA1.FEC_MODIFICACION
FROM CR_INF_LABORALES LA1
WHERE LA1.ACTUAL = 'S' AND LA1.NRO_SECUENCIA = (SELECT MAX(NRO_SECUENCIA) FROM CR_INF_LABORALES LAP WHERE LAP.COD_PERSONA = LA1.COD_PERSONA AND LAP.ACTUAL = LA1.ACTUAL )) LA
ON LA.COD_PERSONA = PE.COD_PERSONA
/*LEFT JOIN CR_PER_TIP_OPERACIONES LOA
  ON LOA.COD_PERSONA = PE.COD_PERSONA AND LOA.COD_MONEDA = 'GS'
  AND LOA.rowid=(select max(q.rowid) from CR_PER_TIP_OPERACIONES q where q.cod_persona= loa.cod_persona)*/
LEFT JOIN (SELECT LOA1.MTO_LIMITE, LOA1.COD_PERSONA,LOA1.COD_MONEDA FROM CR_PER_TIP_OPERACIONES LOA1
WHERE /*LOA1.COD_MONEDA = 'GS'
AND*/ LOA1.rowid=(select max(q.rowid) from CR_PER_TIP_OPERACIONES q where q.cod_persona= LOA1.cod_persona)) LOA ON LOA.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_CIUDADES CI ON CI.COD_CIUDAD = DI.COD_CIUDAD AND CI.COD_PAIS = DI.COD_PAIS
LEFT JOIN (SELECT SUM(F.CANTIDAD) AS PROD_ACT,F.COD_PERSONA,P.NRO_DOCUMENTO,P.TIPO,P.NOM_COMPLETO,(G.COD_SEG_CLIENTE || '-' ||S.DESCRIPCION) AS SEGMENTO
FROM (
  /*PRESTAMOS  QUE NO ESTEN EN ESTADO CANCELADO*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'PR' AS MARCA  FROM GE_CTA_CLIENTES G
  INNER JOIN PR_CTA_PRESTAMOS PR ON PR.NRO_CUENTA = G.NRO_CUENTA
  WHERE /* G.RELACION = 'P' AND*/ PR.ESTADO NOT IN ('N') GROUP BY G.COD_PERSONA
UNION
  /*TARJETAS QUE NO ESTEN EN ESTADO CANCELADO*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'TA' AS MARCA  FROM GE_CTA_CLIENTES G
  INNER JOIN TA_CTA_TARJETAS TA ON TA.NRO_CUENTA = G.NRO_CUENTA
  WHERE /*G.RELACION = 'P' AND*/ TA.ESTADO <> 'C' GROUP BY G.COD_PERSONA
UNION
  /*CDAS QUE NO ESTEN EN ESTADO CANCELADO,TOTALMENTE PAGADA Y EN VERIFICACION*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'CDA' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN AH_CTA_CERTIFICADOS CDA ON CDA.NRO_CUENTA = G.NRO_CUENTA
  WHERE  /*G.RELACION = 'P'AND*/ CDA.ESTADO NOT IN ('T','X','C')  GROUP BY G.COD_PERSONA
UNION
  /*CAH QUE NO ESTEN EN ESTADO CANCELADOS, VERIFICACION, INACTIVOS*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'CAH' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN AH_CTA_VISTAS CAH ON CAH.NRO_CUENTA = G.NRO_CUENTA
  WHERE /*G.RELACION = 'P' AND*/ CAH.ESTADO NOT IN ('C','X')  GROUP BY G.COD_PERSONA
UNION
  /*OPERACIONES MODULO 15 PASES A VENCIDO QUE NO ESTEN CANCELADAS*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'OV' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN OV_CTA_VENCIDAS OV ON OV.NRO_CUENTA = G.NRO_CUENTA
  WHERE  /*G.RELACION = 'P' AND*/ OV.ESTADO NOT IN ('C')  GROUP BY G.COD_PERSONA
UNION
  /*OPERACIONES MODULO 4 LIMITE DE CAMNBIOS QUE NO ESTEN CANCELADAS O INACTIVA*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'LC' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN LC_CTA_CAMBIOS LC ON LC.NRO_CUENTA = G.NRO_CUENTA
  WHERE  /*G.RELACION = 'P' AND*/ LC.ESTADO NOT IN ('C','I')  GROUP BY G.COD_PERSONA
UNION
  /*OPERACIONES MODULO 10 MESA DE DIENRO QUE NO ESTEN EN ESTADO CANCELADO*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'MD' AS MARCA  FROM GE_CTA_CLIENTES G
  INNER JOIN MD_CTA_DOCUMENTOS MD ON MD.NRO_CUENTA = G.NRO_CUENTA
  WHERE /* G.RELACION = 'P' AND*/ MD.ESTADO NOT IN ('N') GROUP BY G.COD_PERSONA
UNION
  /*LIBRADORES DE CHEQUES DE CUENTAS QUE NO ESTEN CANCELADAS*/
  SELECT COUNT(*) CANTIDAD,BA.COD_PERSONA,'LIB' AS MARCA FROM PR_REL_CHQ_LIB RELI
  INNER JOIN BA_PERSONAS BA ON BA.NRO_DOCUMENTO = RELI.NRO_DOCUMENTO
  INNER JOIN GE_CHE_CUSTODIAS CHE ON CHE.NRO_CHEQUE = RELI.NRO_CHEQUE AND CHE.CTA_LIBRADORA = RELI.CTA_LIBRADORA
  INNER JOIN PR_CTA_PRESTAMOS PR ON PR.NRO_CUENTA = CHE.NRO_REFERENCIA
  WHERE PR.ESTADO <> 'N'  GROUP BY BA.COD_PERSONA
) F
LEFT JOIN GE_CLIENTES G ON F.COD_PERSONA = G.COD_PERSONA
LEFT JOIN BA_PERSONAS P ON P.COD_PERSONA = G.COD_PERSONA
LEFT JOIN GE_SEG_CLIENTES S ON S.COD_SEG_CLIENTE = G.COD_SEG_CLIENTE
GROUP BY F.COD_PERSONA,P.NRO_DOCUMENTO,P.TIPO,P.NOM_COMPLETO,G.COD_SEG_CLIENTE,S.DESCRIPCION --) >= 1
HAVING COUNT(*) >0
ORDER BY COD_PERSONA ) POC ON POC.COD_PERSONA = PE.COD_PERSONA
  -----------------------------------------------------------------------------------------------------------------------------------------------
WHERE  PE.COD_PERSONA IN (SELECT COD_PERSONA FROM (SELECT MAX(FEC_MODIFICACION),COD_PERSONA FROM (
SELECT PE.COD_PERSONA ,  trunc(PE.FEC_MODIFICACION) PEM,  trunc(FI.FEC_MODIFICACION) FIM,  trunc(JU.FEC_MODIFICACION) JUM ,trunc(GE.FEC_MODIFICACION) GEM,
trunc(VI.FEC_MODIFICACION) VIM, trunc(FO.FEC_MODIFICACION) FOM , trunc(LA.FEC_MODIFICACION) LAM,  trunc(LOA.FEC_MODIFICACION) LOAM,
trunc(DI.FEC_MODIFICACION) DIM,  trunc(TE.FEC_MODIFICACION) TEM , TRUNC(DAT.FEC_MODIFICACION) DATM
FROM BA_PERSONAS PE
LEFT JOIN BA_PER_FISICAS FI   ON FI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_JURIDICAS JU ON JU.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN GE_CLIENTES GE    ON GE.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN (SELECT VI1.COD_PER_VINCULO, VI1.COD_PERSONA,VI1.FEC_MODIFICACION
FROM BA_VINCULOS VI1
WHERE VI1.TIPO = 'E' AND VI1.ACTIVO = 'S'
AND VI1.FEC_INSERCION = (SELECT MAX(FEC_INSERCION) FROM BA_VINCULOS VI2 WHERE VI2.COD_PERSONA = VI1.COD_PERSONA)
AND VI1.COD_PER_VINCULO = (SELECT MAX(COD_PER_VINCULO) FROM BA_VINCULOS VI3 WHERE VI3.COD_PERSONA = VI1.COD_PERSONA)) VI ON VI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN CR_INF_FONDOS FO    ON FO.COD_PERSONA = PE.COD_PERSONA
  LEFT JOIN (SELECT LA1.COD_PERSONA, LA1.TIP_CARGO, LA1.COD_RAMO, LA1.MTO_INGRESO,LA1.FEC_MODIFICACION
FROM CR_INF_LABORALES LA1
WHERE LA1.ACTUAL = 'S' AND LA1.NRO_SECUENCIA = (SELECT MAX(NRO_SECUENCIA) FROM CR_INF_LABORALES LAP WHERE LAP.COD_PERSONA = LA1.COD_PERSONA AND LAP.ACTUAL = LA1.ACTUAL )) LA
ON LA.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN (SELECT LOA1.MTO_LIMITE, LOA1.COD_PERSONA,LOA1.FEC_MODIFICACION FROM CR_PER_TIP_OPERACIONES LOA1
WHERE LOA1.COD_MONEDA = 'GS'
AND LOA1.rowid=(select max(q.rowid) from CR_PER_TIP_OPERACIONES q where q.cod_persona= LOA1.cod_persona)) LOA ON LOA.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_DIRECCIONES DI   ON DI.COD_PERSONA = PE.COD_PERSONA AND DI.PRINCIPAL = 'S'
LEFT JOIN BA_TELEFONOS TE   ON TE.COD_PERSONA = PE.COD_PERSONA AND TE.PRINCIPAL = 'S'
LEFT JOIN BA_CIUDADES CI ON CI.COD_CIUDAD = DI.COD_CIUDAD AND CI.COD_PAIS = DI.COD_PAIS
LEFT JOIN (SELECT DAT1.COD_PERSONA, MAX(DAT1.FEC_MODIFICACION) AS FEC_MODIFICACION FROM BA_PER_DAT_ADICIONALES DAT1
WHERE PARAMETRO IN ('PER_IND_DEB_DIL_AMPLIADA','PER_IND_SUJ_OBLIGADO')
GROUP BY COD_PERSONA ) DAT ON DAT.COD_PERSONA = PE.COD_PERSONA
  WHERE TRUNC(PE.FEC_INSERCION) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
  AND PE.COD_TIP_DOCUMENTO NOT IN (9,10)
  --AND PE.COD_PERSONA IN (450233,450279,462170,457126,184986,463641,464914,464410,8758503,465108,309279)
) PP UNPIVOT EXCLUDE NULLS (
    FEC_MODIFICACION
    FOR MARCA
    IN (
        PEM AS 'PEM',
        FIM AS 'FIM',
        JUM AS 'JUM',
        GEM AS 'GEM',
        VIM AS 'VIM',
        FOM AS 'FOM',
        LAM AS 'LAM',
        LOAM AS 'LOAM',
        DIM AS 'DIM',
        TEM AS 'TEM',
    DATM AS 'DATM'
    )
)
WHERE FEC_MODIFICACION >= trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
GROUP BY COD_PERSONA)PO)
UNION-----------------------------------------------------------------------------------**************************--------------------
SELECT --count(*)
to_number(PE.COD_PERSONA) AS NRO_CLIENTE,
PE.TIPO AS TIPO_PERSONA,
CASE WHEN PE.TIPO = 'F' THEN FI.PRI_APELLIDO ELSE NULL END AS APELLIDO,
CASE WHEN PE.TIPO = 'F' THEN FI.SEG_APELLIDO ELSE NULL END AS SEGUNDO_APELLIDO,
CASE WHEN PE.TIPO = 'F' THEN FI.PRI_NOMBRE ELSE NULL END AS PRIMER_NOMBRE,
CASE WHEN PE.TIPO = 'F' THEN FI.SEG_NOMBRE ELSE NULL END AS SEGUNDO_NOMBRE,
CASE WHEN PE.TIPO = 'J' THEN
CASE WHEN LENGTH (JU.RAZ_SOCIAL) > 100 THEN SUBSTR(JU.RAZ_SOCIAL ,0,100) ELSE JU.RAZ_SOCIAL END
  ELSE NULL END AS RAZON_SOCIAL,
NULL AS COD_ALTERNATIVO_CLIENTE,
FI.COD_SEXO AS SEXO,
to_char(PE.COD_TIP_DOCUMENTO) AS TIPO_DOCUMENTO_1,
PE.NRO_DOCUMENTO AS NRO_DOCUMENTO_1,
NULL AS DOC_EXPEDIDO_POR_1,
NULL AS FECHA_EXPEDICION_1,
NULL AS TIPO_DOCUMENTO_2,
NULL AS NRO_DOCUMENTO_2,
NULL AS DOC_EXPEDIDO_POR_2,
NULL AS FECHA_EXPEDICION_2,
NULL AS TIPO_DOCUMENTO_3,
NULL AS NRO_DOCUMENTO_3,
NULL AS DOC_EXPEDIDO_POR_3,
NULL AS FECHA_EXPEDICION_3,
NULL AS TIPO_DOCUMENTO_4,
NULL AS NRO_DOCUMENTO_4,
NULL AS DOC_EXPEDIDO_POR_4,
NULL AS FECHA_EXPEDICION_4,
CASE WHEN JU.FEC_APERTURA < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE  TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') END AS FECHA_CONSTITUCION,
CASE WHEN FI.FEC_NACIMIENTO < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE TO_CHAR(FI.FEC_NACIMIENTO,'yyyy-mm-dd') END AS FECHA_NACIMIENTO,
NULL AS LUGAR_NACIMIENTO,
to_char(PE.COD_PAIS) AS COD_PAIS,
to_char(FI.COD_PAI_NACIONALIDAD) AS NACIONALIDAD,
FI.EST_CIVIL AS ESTADO_CIVIL,
to_char(PE.COD_RUB_PRIMARIO) AS COD_ACTIVIDAD, --se ajusta a RI-2
to_char(FI.COD_PROFESION) AS COD_PROFESION,
CASE WHEN PE.TIPO = 'F' THEN '0' ELSE TO_CHAR(NVL(JU.NATURALEZA,0)) END AS COD_FORMA_JURIDICA,
to_char(GE.COD_SEG_CLIENTE) AS TIPO_CLIENTE,
NULL AS COMUNICADO,
CASE WHEN GE.COD_GRU_ECONOMICO = 1 THEN 0 ELSE 1 END AS CONOCIMIENTO_CLIENTE,
--CASE WHEN nvl(LA.MTO_INGRESO,0) IS NULL THEN nvl((PE.TOT_INGRESOS*12),0)ELSE nvl((LA.MTO_INGRESO*12),0) END AS INGRESO_ANUAL_DECLARADO,
CASE WHEN nvl(LA.MTO_INGRESO,0) IS NULL THEN ROUND(nvl((PE.TOT_INGRESOS*12),0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6)))
ELSE ROUND(nvl((LA.MTO_INGRESO*12),0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))) END AS INGRESO_ANUAL_DECLARADO,
NULL AS DP_ACTIVO,
NULL AS DP_INGRESOS,
NULL AS DP_PASIVO,
NULL AS DP_PATRIMONIO_NETO,
to_char(GE.COD_OFICINA) AS COD_SUCURSAL, ---OFICINA DEL CLIENTE
CASE WHEN GE.COD_SEG_CLIENTE = 1 THEN '1' ELSE '0' END AS ES_EMPLEADO,
NULL AS EMPLEADO_DEPARTAMENTO,
NULL AS EMPLEADO_STATUS,
CASE WHEN GE.COD_SEC_CONTABLE IN ('F','I') THEN '1' ELSE '0' END AS ES_INST_FINANCIERA,
CASE WHEN GE.COD_SEC_CONTABLE IN ('P') THEN '1' ELSE '0' END AS ES_INST_PUBLICA,
TO_CHAR(PE.FEC_VERIFICACION,'yyyy-mm-dd') AS FECHA_ALTA, --DATO APLICA PARA REGISTROS NATIVOS EN ITGF
NULL AS FECHA_BAJA,
NULL AS FECHA_CAMBIODATO_A,
NULL AS FECHA_CAMBIODATO_B,
NULL AS FECHA_CAMBIODATO_C,
NULL AS FECHA_CAMBIODATO_D,
TO_CHAR(PE.FEC_VERIFICACION,'yyyy-mm-dd') AS FECHA_ACTUALIZ_DATOS,
NULL AS FECHA_ACTUALIZACION,
NULL AS FECHA_RIESGO,
NULL AS ID_METODO_VERIF_IDENTIDAD,
NULL AS NOMBRE_CONTACTO,
GE.COD_USU_OFICIAL||' - '||US.NOMBRE AS OFICIAL_ATENCION , --OFICIAL DEL CLIENTE
CASE WHEN FO.PEP = 'S' THEN '1' ELSE '0' END AS ES_PEP,
CASE WHEN GE.RESIDENTE = 'S' THEN '1' ELSE '0' END AS RESIDENCIA,
FI.COD_TIP_VIVIENDA AS TIPO_RESIDENCIA, --DATO APLICA PARA REGISTROS NATIVOS EN ITGF
NULL AS NRO_PERMISORES,
to_char(DI.COD_PAIS) AS COD_PAIS_RESIDENCIA,-- / TIPO = 'P'/ MAX (COD_DIRECCION)
to_char(PE.TIP_IVA) AS TIPO_SITUACION_FISCAL,
NULL AS OBSERVACIONES,
--ROUND(LOA.MTO_LIMITE,0) AS MAXATRANSAR, --LIMITE MENSUAL
CASE WHEN LOA.COD_MONEDA = 'GS' THEN
ROUND(ROUND(LOA.MTO_LIMITE,0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))) ELSE NVL(LOA.MTO_LIMITE,0) END AS MAXATRANSAR,
NULL AS MINATRANSAR,
CASE WHEN POC.COD_PERSONA IS NULL THEN 'NOCLIENTE' ELSE 'CLIENTE' END AS TIPO_TRATAMIENTO, --marca tiene producto activo
NULL AS SEGMENTO,
JU.NOM_COMERCIAL AS NOMBRE_FANTASIA,
NULL AS PT_MONTO_CALCULADO,
NULL AS PT_MONTO_INFORMADO,
NULL AS PT_MANUAL_AUTOMATICO,
--NULL AS ES_SUJETO_OBLIGADO,
CASE WHEN (SELECT NVL(DA.VAL_PARAMETRO,'N') FROM BA_PER_DAT_ADICIONALES DA WHERE DA.PARAMETRO = 'PER_IND_SUJ_OBLIGADO' AND DA.COD_PERSONA = PE.COD_PERSONA) = 'S' THEN '1'
ELSE '0' END AS ES_SUJETO_OBLIGADO,
NULL AS SO_CUMPLE_OBLIGACION,
CASE WHEN LA.COD_RAMO = 0 THEN NULL ELSE TO_CHAR(LA.COD_RAMO) END AS CODSECTORCLIENTE, -- se ajusta a RI-2
NULL AS SC51,
NULL AS SC52,
--NULL AS SC53,
CASE WHEN (SELECT NVL(DA.VAL_PARAMETRO,'N') FROM BA_PER_DAT_ADICIONALES DA WHERE DA.PARAMETRO = 'PER_IND_DEB_DIL_AMPLIADA' AND DA.COD_PERSONA = PE.COD_PERSONA) = 'S' THEN '1'
ELSE '0' END AS SC53,
NULL AS LINEA_DE_NEGOCIO,
to_char(PE.COD_RUB_PRIMARIO) AS CODACTIVIDADAFIP,
to_char(PE.COD_RUB_SECUNDARIO) AS CODACTIVIDADSEC,
NULL AS CIERREBALANCE,
NULL AS CODTIPOORIGENALTA,
CASE WHEN JU.FEC_APERTURA < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE  TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') END AS FECHAINICIOACTIVIDAD,
NULL AS FECHAVENCESTATUTO,
NULL AS FECHADECESO,
NULL AS INSCRIPCION_CODORG,
NULL AS INSCRIPCION_FECHA,
NULL AS INSCRIPCION_FOLIO,
NULL AS INSCRIPCION_NRO,
NULL AS INSCRIPCION_TOMO,
NULL AS ADMINISTRA_FONDOS_3RO,
FUE_OBT_NOM_PERSONA (VI.COD_PER_VINCULO)  AS NOMBRE_CONYUGE,
DI.TIPO AS TIPO_DIRECCION, -- /  PRINCIPAL ='S'
DI.DIRECCION AS CALLE,
DI.NUMERO AS NUMERO,
CASE WHEN LENGTH (DI.DEPARTAMENTO) > 5 THEN SUBSTR(DI.DEPARTAMENTO,0,5)ELSE DI.DEPARTAMENTO  END AS OFICINA,
CASE WHEN LENGTH (DI.PISO) > 3 THEN SUBSTR(DI.PISO,0,3)ELSE DI.PISO END AS PISO,
DI.EDIFICIO AS NOMBRE_EDIFICIO,
to_char(DI.COD_BARRIO) AS BARRIO,
NULL AS CIUDAD,
to_char(DI.COD_CIUDAD) AS COD_CIUDAD,
NULL AS DEPARTAMENTO,
to_char(CI.COD_DEPARTAMENTO) AS COD_DE_DEPARTAMENTO,
TO_CHAR(DI.COD_CIUDAD) AS COD_DISTRITO,
to_char(DI.COD_PAIS)  AS COD_PAIS_DOMICILIO,
to_char(DI.COD_POSTAL) AS COD_POSTAL,
PE.DIR_CORREO AS CORREO_ELECTRONICO,
NULL AS DIR_WEB,
NULL AS FAX,
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TE WHERE PRINCIPAL = 'S' AND TE.COD_PERSONA = PE.COD_PERSONA) AS TELEFONO, -- / PRINCIPAL= 'S'
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEP WHERE TEP.COD_PERSONA = PE.COD_PERSONA AND TEP.TIPO= 'P'
    AND TEP.COD_TELEFONO = (SELECT MAX(TEP2.COD_TELEFONO) FROM BA_TELEFONOS TEP2 WHERE TEP2.COD_PERSONA = PE.COD_PERSONA AND TEP.TIPO = TEP2.TIPO)) AS TELEFONO_1, -- / TIPO = 'P' / MAX (COD_TELEFONO)
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEL WHERE TEL.COD_PERSONA = PE.COD_PERSONA AND TEL.TIPO= 'L'
    AND TEL.COD_TELEFONO = (SELECT MAX(TEL2.COD_TELEFONO) FROM BA_TELEFONOS TEL2 WHERE TEL2.COD_PERSONA = PE.COD_PERSONA AND TEL.TIPO = TEL2.TIPO)) AS TELEFONO_2, -- / TIPO = 'L' / MAX (COD_TELEFONO)
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEC WHERE TEC.COD_PERSONA = PE.COD_PERSONA AND TIP_LINEA = 'C'
    AND TEC.COD_TELEFONO = (SELECT MAX(TEC2.COD_TELEFONO) FROM BA_TELEFONOS TEC2 WHERE TEC2.COD_PERSONA = PE.COD_PERSONA AND TEC.TIP_LINEA  = TEC2.TIP_LINEA)) AS TEL_MOVIL, -- / TIP_LINEA = 'C' / MAX (COD_TELEFONO)
LA.TIP_CARGO AS INFOADICIONAL1,
-------------------------------------------------------hasta aqui estructura Vigia
CASE WHEN GE.COD_PERSONA IS NULL THEN 0 ELSE 1 END AS GE_CLIENTE ,
--'VERIFICACION' AS MARCA,
trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/  AS FEC_PROCESO --TO_DATE('23/09/2022','dd/mm/yyyy')
-------------------------------------------------------PERSONAS
FROM BA_PERSONAS PE
LEFT JOIN GE_CLIENTES GE
  ON GE.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_FISICAS FI
  ON FI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_JURIDICAS JU
  ON JU.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN (SELECT VI1.COD_PER_VINCULO, VI1.COD_PERSONA,VI1.FEC_MODIFICACION
FROM BA_VINCULOS VI1
WHERE VI1.TIPO = 'E' AND VI1.ACTIVO = 'S'
AND VI1.FEC_INSERCION = (SELECT MAX(FEC_INSERCION) FROM BA_VINCULOS VI2 WHERE VI2.COD_PERSONA = VI1.COD_PERSONA)
AND VI1.COD_PER_VINCULO = (SELECT MAX(COD_PER_VINCULO) FROM BA_VINCULOS VI3 WHERE VI3.COD_PERSONA = VI1.COD_PERSONA)) VI ON VI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_DIRECCIONES DI
  ON DI.COD_PERSONA = PE.COD_PERSONA AND DI.PRINCIPAL = 'S'
LEFT JOIN BA_USUARIOS US
  ON US.COD_USUARIO = GE.COD_USU_OFICIAL
LEFT JOIN CR_INF_FONDOS FO
  ON FO.COD_PERSONA = PE.COD_PERSONA
  LEFT JOIN (SELECT LA1.COD_PERSONA, LA1.TIP_CARGO, LA1.COD_RAMO, LA1.MTO_INGRESO,LA1.FEC_MODIFICACION
FROM CR_INF_LABORALES LA1
WHERE LA1.ACTUAL = 'S' AND LA1.NRO_SECUENCIA = (SELECT MAX(NRO_SECUENCIA) FROM CR_INF_LABORALES LAP WHERE LAP.COD_PERSONA = LA1.COD_PERSONA AND LAP.ACTUAL = LA1.ACTUAL )) LA
ON LA.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN (SELECT LOA1.MTO_LIMITE, LOA1.COD_PERSONA,LOA1.COD_MONEDA FROM CR_PER_TIP_OPERACIONES LOA1
WHERE /*LOA1.COD_MONEDA = 'GS'
AND*/ LOA1.rowid=(select max(q.rowid) from CR_PER_TIP_OPERACIONES q where q.cod_persona= LOA1.cod_persona)) LOA ON LOA.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_CIUDADES CI ON CI.COD_CIUDAD = DI.COD_CIUDAD AND CI.COD_PAIS = DI.COD_PAIS
LEFT JOIN (SELECT SUM(F.CANTIDAD) AS PROD_ACT,F.COD_PERSONA,P.NRO_DOCUMENTO,P.TIPO,P.NOM_COMPLETO,(G.COD_SEG_CLIENTE || '-' ||S.DESCRIPCION) AS SEGMENTO
FROM (
  /*PRESTAMOS  QUE NO ESTEN EN ESTADO CANCELADO*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'PR' AS MARCA  FROM GE_CTA_CLIENTES G
  INNER JOIN PR_CTA_PRESTAMOS PR ON PR.NRO_CUENTA = G.NRO_CUENTA
  WHERE /* G.RELACION = 'P' AND*/ PR.ESTADO NOT IN ('N') GROUP BY G.COD_PERSONA
UNION
  /*TARJETAS QUE NO ESTEN EN ESTADO CANCELADO*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'TA' AS MARCA  FROM GE_CTA_CLIENTES G
  INNER JOIN TA_CTA_TARJETAS TA ON TA.NRO_CUENTA = G.NRO_CUENTA
  WHERE /*G.RELACION = 'P' AND*/ TA.ESTADO <> 'C' GROUP BY G.COD_PERSONA
UNION
  /*CDAS QUE NO ESTEN EN ESTADO CANCELADO,TOTALMENTE PAGADA Y EN VERIFICACION*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'CDA' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN AH_CTA_CERTIFICADOS CDA ON CDA.NRO_CUENTA = G.NRO_CUENTA
  WHERE  /*G.RELACION = 'P'AND*/ CDA.ESTADO NOT IN ('T','X','C')  GROUP BY G.COD_PERSONA
UNION
  /*CAH QUE NO ESTEN EN ESTADO CANCELADOS, VERIFICACION, INACTIVOS*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'CAH' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN AH_CTA_VISTAS CAH ON CAH.NRO_CUENTA = G.NRO_CUENTA
  WHERE /*G.RELACION = 'P' AND*/ CAH.ESTADO NOT IN ('C','X')  GROUP BY G.COD_PERSONA
UNION
  /*OPERACIONES MODULO 15 PASES A VENCIDO QUE NO ESTEN CANCELADAS*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'OV' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN OV_CTA_VENCIDAS OV ON OV.NRO_CUENTA = G.NRO_CUENTA
  WHERE  /*G.RELACION = 'P' AND*/ OV.ESTADO NOT IN ('C')  GROUP BY G.COD_PERSONA
UNION
  /*OPERACIONES MODULO 4 LIMITE DE CAMNBIOS QUE NO ESTEN CANCELADAS O INACTIVA*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'LC' AS MARCA FROM GE_CTA_CLIENTES G
  INNER JOIN LC_CTA_CAMBIOS LC ON LC.NRO_CUENTA = G.NRO_CUENTA
  WHERE  /*G.RELACION = 'P' AND*/ LC.ESTADO NOT IN ('C','I')  GROUP BY G.COD_PERSONA
UNION
  /*OPERACIONES MODULO 10 MESA DE DIENRO QUE NO ESTEN EN ESTADO CANCELADO*/
  SELECT COUNT(*) CANTIDAD,G.COD_PERSONA,'MD' AS MARCA  FROM GE_CTA_CLIENTES G
  INNER JOIN MD_CTA_DOCUMENTOS MD ON MD.NRO_CUENTA = G.NRO_CUENTA
  WHERE /* G.RELACION = 'P' AND*/ MD.ESTADO NOT IN ('N') GROUP BY G.COD_PERSONA
UNION
  /*LIBRADORES DE CHEQUES DE CUENTAS QUE NO ESTEN CANCELADAS*/
  SELECT COUNT(*) CANTIDAD,BA.COD_PERSONA,'LIB' AS MARCA FROM PR_REL_CHQ_LIB RELI
  INNER JOIN BA_PERSONAS BA ON BA.NRO_DOCUMENTO = RELI.NRO_DOCUMENTO
  INNER JOIN GE_CHE_CUSTODIAS CHE ON CHE.NRO_CHEQUE = RELI.NRO_CHEQUE AND CHE.CTA_LIBRADORA = RELI.CTA_LIBRADORA
  INNER JOIN PR_CTA_PRESTAMOS PR ON PR.NRO_CUENTA = CHE.NRO_REFERENCIA
  WHERE PR.ESTADO <> 'N'  GROUP BY BA.COD_PERSONA
) F
LEFT JOIN GE_CLIENTES G ON F.COD_PERSONA = G.COD_PERSONA
LEFT JOIN BA_PERSONAS P ON P.COD_PERSONA = G.COD_PERSONA
LEFT JOIN GE_SEG_CLIENTES S ON S.COD_SEG_CLIENTE = G.COD_SEG_CLIENTE
GROUP BY F.COD_PERSONA,P.NRO_DOCUMENTO,P.TIPO,P.NOM_COMPLETO,G.COD_SEG_CLIENTE,S.DESCRIPCION --) >= 1
HAVING COUNT(*) >0
ORDER BY COD_PERSONA ) POC ON POC.COD_PERSONA = PE.COD_PERSONA
-----------------------------------------------------------------------------------------------------------------------------------
WHERE trunc(PE.FEC_VERIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND trunc(PE.FEC_INSERCION) > trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
AND PE.COD_TIP_DOCUMENTO NOT IN (9,10)
UNION --------------------------------------------/* BLOQUE LIBRADORES */-----------------**************************--------------------
SELECT /*PR.NRO_CUENTA, PR.COD_MODALIDAD , PE.COD_PERSONA,'LIB' AS MARCA , PR.ESTADO ,  RELI.NRO_DOCUMENTO */
DISTINCT (to_number(PE.COD_PERSONA)) AS NRO_CLIENTE,
PE.TIPO AS TIPO_PERSONA,
CASE WHEN PE.TIPO = 'F' THEN FI.PRI_APELLIDO ELSE NULL END AS APELLIDO,
CASE WHEN PE.TIPO = 'F' THEN FI.SEG_APELLIDO ELSE NULL END AS SEGUNDO_APELLIDO,
CASE WHEN PE.TIPO = 'F' THEN FI.PRI_NOMBRE ELSE NULL END AS PRIMER_NOMBRE,
CASE WHEN PE.TIPO = 'F' THEN FI.SEG_NOMBRE ELSE NULL END AS SEGUNDO_NOMBRE,
CASE WHEN PE.TIPO = 'J' THEN
CASE WHEN LENGTH (JU.RAZ_SOCIAL) > 100 THEN SUBSTR(JU.RAZ_SOCIAL ,0,100) ELSE JU.RAZ_SOCIAL END
  ELSE NULL END AS RAZON_SOCIAL,
NULL AS COD_ALTERNATIVO_CLIENTE,
FI.COD_SEXO AS SEXO,
to_char(PE.COD_TIP_DOCUMENTO) AS TIPO_DOCUMENTO_1,
PE.NRO_DOCUMENTO AS NRO_DOCUMENTO_1,
NULL AS DOC_EXPEDIDO_POR_1,
NULL AS FECHA_EXPEDICION_1,
NULL AS TIPO_DOCUMENTO_2,
NULL AS NRO_DOCUMENTO_2,
NULL AS DOC_EXPEDIDO_POR_2,
NULL AS FECHA_EXPEDICION_2,
NULL AS TIPO_DOCUMENTO_3,
NULL AS NRO_DOCUMENTO_3,
NULL AS DOC_EXPEDIDO_POR_3,
NULL AS FECHA_EXPEDICION_3,
NULL AS TIPO_DOCUMENTO_4,
NULL AS NRO_DOCUMENTO_4,
NULL AS DOC_EXPEDIDO_POR_4,
NULL AS FECHA_EXPEDICION_4,
CASE WHEN JU.FEC_APERTURA < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE  TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') END AS FECHA_CONSTITUCION,
CASE WHEN FI.FEC_NACIMIENTO < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE TO_CHAR(FI.FEC_NACIMIENTO,'yyyy-mm-dd') END AS FECHA_NACIMIENTO,
NULL AS LUGAR_NACIMIENTO,
to_char(PE.COD_PAIS) AS COD_PAIS,
to_char(FI.COD_PAI_NACIONALIDAD) AS NACIONALIDAD,
FI.EST_CIVIL AS ESTADO_CIVIL,
to_char(PE.COD_RUB_PRIMARIO) AS COD_ACTIVIDAD, --se ajusta a RI-2
to_char(FI.COD_PROFESION) AS COD_PROFESION,
CASE WHEN PE.TIPO = 'F' THEN '0' ELSE TO_CHAR(NVL(JU.NATURALEZA,0)) END AS COD_FORMA_JURIDICA,
to_char(GE.COD_SEG_CLIENTE) AS TIPO_CLIENTE,
NULL AS COMUNICADO,
CASE WHEN GE.COD_GRU_ECONOMICO = 1 THEN 0 ELSE 1 END AS CONOCIMIENTO_CLIENTE,
--CASE WHEN nvl(LA.MTO_INGRESO,0) IS NULL THEN nvl((PE.TOT_INGRESOS*12),0)ELSE nvl((LA.MTO_INGRESO*12),0) END AS INGRESO_ANUAL_DECLARADO,
CASE WHEN nvl(LA.MTO_INGRESO,0) IS NULL THEN ROUND(nvl((PE.TOT_INGRESOS*12),0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6)))
ELSE ROUND(nvl((LA.MTO_INGRESO*12),0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))) END AS INGRESO_ANUAL_DECLARADO,
NULL AS DP_ACTIVO,
NULL AS DP_INGRESOS,
NULL AS DP_PASIVO,
NULL AS DP_PATRIMONIO_NETO,
to_char(GE.COD_OFICINA) AS COD_SUCURSAL, ---OFICINA DEL CLIENTE
CASE WHEN GE.COD_SEG_CLIENTE = 1 THEN '1' ELSE '0' END AS ES_EMPLEADO,
NULL AS EMPLEADO_DEPARTAMENTO,
NULL AS EMPLEADO_STATUS,
CASE WHEN GE.COD_SEC_CONTABLE IN ('F','I') THEN '1' ELSE '0' END AS ES_INST_FINANCIERA,
CASE WHEN GE.COD_SEC_CONTABLE IN ('P') THEN '1' ELSE '0' END AS ES_INST_PUBLICA,
TO_CHAR(PE.FEC_INSERCION,'yyyy-mm-dd') AS FECHA_ALTA, --DATO APLICA PARA REGISTROS NATIVOS EN ITGF
NULL AS FECHA_BAJA,
NULL AS FECHA_CAMBIODATO_A,
NULL AS FECHA_CAMBIODATO_B,
NULL AS FECHA_CAMBIODATO_C,
NULL AS FECHA_CAMBIODATO_D,
TO_CHAR(pag_cal.fu_obt_fec_actual(6),'yyyy-mm-dd') AS FECHA_ACTUALIZ_DATOS,
NULL AS FECHA_ACTUALIZACION,
NULL AS FECHA_RIESGO,
NULL AS ID_METODO_VERIF_IDENTIDAD,
NULL AS NOMBRE_CONTACTO,
GE.COD_USU_OFICIAL||' - '||US.NOMBRE AS OFICIAL_ATENCION , --OFICIAL DEL CLIENTE
CASE WHEN FO.PEP = 'S' THEN '1' ELSE '0' END AS ES_PEP,
CASE WHEN GE.RESIDENTE = 'S' THEN '1' ELSE '0' END AS RESIDENCIA,
FI.COD_TIP_VIVIENDA AS TIPO_RESIDENCIA, --DATO APLICA PARA REGISTROS NATIVOS EN ITGF
NULL AS NRO_PERMISORES,
to_char(DI.COD_PAIS) AS COD_PAIS_RESIDENCIA,-- / TIPO = 'P'/ MAX (COD_DIRECCION)
to_char(PE.TIP_IVA) AS TIPO_SITUACION_FISCAL,
NULL AS OBSERVACIONES,
--ROUND(LOA.MTO_LIMITE,0) AS MAXATRANSAR, --LIMITE MENSUAL
CASE WHEN LOA.COD_MONEDA = 'GS' THEN
ROUND(ROUND(LOA.MTO_LIMITE,0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))) ELSE NVL(LOA.MTO_LIMITE,0) END AS MAXATRANSAR,
NULL AS MINATRANSAR,
'CLIENTE' AS TIPO_TRATAMIENTO, --marca tiene producto activo
NULL AS SEGMENTO,
JU.NOM_COMERCIAL AS NOMBRE_FANTASIA,
NULL AS PT_MONTO_CALCULADO,
NULL AS PT_MONTO_INFORMADO,
NULL AS PT_MANUAL_AUTOMATICO,
--NULL AS ES_SUJETO_OBLIGADO,
CASE WHEN (SELECT NVL(DA.VAL_PARAMETRO,'N') FROM BA_PER_DAT_ADICIONALES DA WHERE DA.PARAMETRO = 'PER_IND_SUJ_OBLIGADO' AND DA.COD_PERSONA = PE.COD_PERSONA) = 'S' THEN '1'
ELSE '0' END AS ES_SUJETO_OBLIGADO,
NULL AS SO_CUMPLE_OBLIGACION,
CASE WHEN LA.COD_RAMO = 0 THEN NULL ELSE TO_CHAR(LA.COD_RAMO) END AS CODSECTORCLIENTE, -- se ajusta a RI-2
NULL AS SC51,
NULL AS SC52,
--NULL AS SC53,
CASE WHEN (SELECT NVL(DA.VAL_PARAMETRO,'N') FROM BA_PER_DAT_ADICIONALES DA WHERE DA.PARAMETRO = 'PER_IND_DEB_DIL_AMPLIADA' AND DA.COD_PERSONA = PE.COD_PERSONA) = 'S' THEN '1'
ELSE '0' END AS SC53,
NULL AS LINEA_DE_NEGOCIO,
to_char(PE.COD_RUB_PRIMARIO) AS CODACTIVIDADAFIP,
to_char(PE.COD_RUB_SECUNDARIO) AS CODACTIVIDADSEC,
NULL AS CIERREBALANCE,
NULL AS CODTIPOORIGENALTA,
CASE WHEN JU.FEC_APERTURA < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE  TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') END AS FECHAINICIOACTIVIDAD,
NULL AS FECHAVENCESTATUTO,
NULL AS FECHADECESO,
NULL AS INSCRIPCION_CODORG,
NULL AS INSCRIPCION_FECHA,
NULL AS INSCRIPCION_FOLIO,
NULL AS INSCRIPCION_NRO,
NULL AS INSCRIPCION_TOMO,
NULL AS ADMINISTRA_FONDOS_3RO,
FUE_OBT_NOM_PERSONA (VI.COD_PER_VINCULO)  AS NOMBRE_CONYUGE,
DI.TIPO AS TIPO_DIRECCION, -- /  PRINCIPAL ='S'
DI.DIRECCION AS CALLE,
DI.NUMERO AS NUMERO,
CASE WHEN LENGTH (DI.DEPARTAMENTO) > 5 THEN SUBSTR(DI.DEPARTAMENTO,0,5)ELSE DI.DEPARTAMENTO  END AS OFICINA,
CASE WHEN LENGTH (DI.PISO) > 3 THEN SUBSTR(DI.PISO,0,3)ELSE DI.PISO END AS PISO,
DI.EDIFICIO AS NOMBRE_EDIFICIO,
to_char(DI.COD_BARRIO) AS BARRIO,
NULL AS CIUDAD,
to_char(DI.COD_CIUDAD) AS COD_CIUDAD,
NULL AS DEPARTAMENTO,
to_char(CI.COD_DEPARTAMENTO) AS COD_DE_DEPARTAMENTO,
TO_CHAR(DI.COD_CIUDAD) AS COD_DISTRITO,
to_char(DI.COD_PAIS)  AS COD_PAIS_DOMICILIO,
to_char(DI.COD_POSTAL) AS COD_POSTAL,
PE.DIR_CORREO AS CORREO_ELECTRONICO,
NULL AS DIR_WEB,
NULL AS FAX,
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TE WHERE PRINCIPAL = 'S' AND TE.COD_PERSONA = PE.COD_PERSONA) AS TELEFONO, -- / PRINCIPAL= 'S'
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEP WHERE TEP.COD_PERSONA = PE.COD_PERSONA AND TEP.TIPO= 'P'
    AND TEP.COD_TELEFONO = (SELECT MAX(TEP2.COD_TELEFONO) FROM BA_TELEFONOS TEP2 WHERE TEP2.COD_PERSONA = PE.COD_PERSONA AND TEP.TIPO = TEP2.TIPO)) AS TELEFONO_1, -- / TIPO = 'P' / MAX (COD_TELEFONO)
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEL WHERE TEL.COD_PERSONA = PE.COD_PERSONA AND TEL.TIPO= 'L'
    AND TEL.COD_TELEFONO = (SELECT MAX(TEL2.COD_TELEFONO) FROM BA_TELEFONOS TEL2 WHERE TEL2.COD_PERSONA = PE.COD_PERSONA AND TEL.TIPO = TEL2.TIPO)) AS TELEFONO_2, -- / TIPO = 'L' / MAX (COD_TELEFONO)
(SELECT AREA || TELEFONO FROM BA_TELEFONOS TEC WHERE TEC.COD_PERSONA = PE.COD_PERSONA AND TIP_LINEA = 'C'
    AND TEC.COD_TELEFONO = (SELECT MAX(TEC2.COD_TELEFONO) FROM BA_TELEFONOS TEC2 WHERE TEC2.COD_PERSONA = PE.COD_PERSONA AND TEC.TIP_LINEA  = TEC2.TIP_LINEA)) AS TEL_MOVIL, -- / TIP_LINEA = 'C' / MAX (COD_TELEFONO)
LA.TIP_CARGO AS INFOADICIONAL1,
-------------------------------------------------------hasta aqui estructura Vigia
CASE WHEN GE.COD_PERSONA IS NULL THEN 0 ELSE 1 END AS GE_CLIENTE ,
--'LIBRADOR' AS MARCA,
trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AS FEC_PROCESO
-------------------------------------------------------PERSONAS
FROM
PR_CTA_PRESTAMOS PR
INNER JOIN GE_CHE_CUSTODIAS CHE
  ON CHE.NRO_REFERENCIA = PR.NRO_CUENTA
INNER JOIN PR_REL_CHQ_LIB RELI
  ON RELI.NRO_CHEQUE = CHE.NRO_CHEQUE  AND  RELI.CTA_LIBRADORA = CHE.CTA_LIBRADORA
INNER JOIN BA_PERSONAS PE
  ON PE.NRO_DOCUMENTO = RELI.NRO_DOCUMENTO
LEFT JOIN GE_CLIENTES GE
  ON GE.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_FISICAS FI
  ON FI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_JURIDICAS JU
  ON JU.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN (SELECT VI1.COD_PER_VINCULO, VI1.COD_PERSONA,VI1.FEC_MODIFICACION
FROM BA_VINCULOS VI1
WHERE VI1.TIPO = 'E' AND VI1.ACTIVO = 'S'
AND VI1.FEC_INSERCION = (SELECT MAX(FEC_INSERCION) FROM BA_VINCULOS VI2 WHERE VI2.COD_PERSONA = VI1.COD_PERSONA)
AND VI1.COD_PER_VINCULO = (SELECT MAX(COD_PER_VINCULO) FROM BA_VINCULOS VI3 WHERE VI3.COD_PERSONA = VI1.COD_PERSONA)) VI ON VI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_DIRECCIONES DI
  ON DI.COD_PERSONA = PE.COD_PERSONA AND DI.PRINCIPAL = 'S'
LEFT JOIN BA_USUARIOS US
  ON US.COD_USUARIO = GE.COD_USU_OFICIAL
LEFT JOIN CR_INF_FONDOS FO
  ON FO.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN (SELECT LA1.COD_PERSONA, LA1.TIP_CARGO, LA1.COD_RAMO, LA1.MTO_INGRESO,LA1.FEC_MODIFICACION
FROM CR_INF_LABORALES LA1
WHERE LA1.ACTUAL = 'S' AND LA1.NRO_SECUENCIA = (SELECT MAX(NRO_SECUENCIA) FROM CR_INF_LABORALES LAP WHERE LAP.COD_PERSONA = LA1.COD_PERSONA AND LAP.ACTUAL = LA1.ACTUAL )) LA
ON LA.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN (SELECT LOA1.MTO_LIMITE, LOA1.COD_PERSONA,LOA1.COD_MONEDA FROM CR_PER_TIP_OPERACIONES LOA1
/*WHERE LOA1.COD_MONEDA = 'GS'
AND*/ WHERE LOA1.rowid=(select max(q.rowid) from CR_PER_TIP_OPERACIONES q where q.cod_persona= LOA1.cod_persona)) LOA ON LOA.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_CIUDADES CI ON CI.COD_CIUDAD = DI.COD_CIUDAD AND CI.COD_PAIS = DI.COD_PAIS
 WHERE PR.COD_MODALIDAD = 608 AND TRUNC(PR.FEC_INICIO) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND PR.ESTADO <> 'N'
 AND PE.COD_TIP_DOCUMENTO NOT IN (9,10) AND TRUNC(PE.FEC_INSERCION) < trunc(SYSDATE-1) /* pag_cal.fu_obt_fec_actual(6)*/
) PP --WHERE PP.NRO_CLIENTE IN (501414,501405,8288269)
--GROUP BY PP.NRO_CLIENTE/*, PP.MARCA*/ HAVING (COUNT(*)) > 1
;

