CREATE OR REPLACE FORCE VIEW IT.GV_VIGIA_CLIENTE_PERSONA_NOV AS
SELECT
VI.TIPO AS COD_TIPO_RELACION,
VI.FEC_INSERCION AS FECHA_DESDE,
VI.FEC_VENCIMIENTO AS FECHA_HASTA,
PE.COD_PERSONA AS NRO_CLIENTE,
VI.COD_PER_VINCULO AS NRO_PERSO_RELACIONADA,
-------------------------------------------------------- hasta aqui estructura vigia
trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AS FEC_PROCESO, 'ALTA' AS MARCA
FROM BA_PERSONAS PE
/*JOIN BA_VINCULOS VI ON VI.COD_PERSONA = PE.COD_PERSONA
AND VI.FEC_INSERCION = (SELECT MAX(FEC_INSERCION) FROM BA_VINCULOS VI2 WHERE VI2.COD_PERSONA = VI.COD_PERSONA)*/
INNER JOIN (SELECT VI1.COD_PERSONA,VI1.TIPO,VI1.COD_PER_VINCULO,VI1.FEC_INSERCION,VI1.FEC_MODIFICACION,VI1.FEC_VENCIMIENTO
FROM BA_VINCULOS VI1
WHERE VI1.TIPO = 'E' AND VI1.ACTIVO = 'S'
AND VI1.FEC_INSERCION = (SELECT MAX(FEC_INSERCION) FROM BA_VINCULOS VI2 WHERE VI2.COD_PERSONA = VI1.COD_PERSONA)) VI ON VI.COD_PERSONA = PE.COD_PERSONA
WHERE  PE.COD_TIP_DOCUMENTO NOT IN (9,10)
AND TRUNC(VI.FEC_INSERCION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
--ORDER BY PE.COD_PERSONA ;
UNION
SELECT --count(*)
VI.TIPO AS COD_TIPO_RELACION,
VI.FEC_INSERCION AS FECHA_DESDE,
VI.FEC_VENCIMIENTO AS FECHA_HASTA,
PE.COD_PERSONA AS NRO_CLIENTE,
VI.COD_PER_VINCULO AS NRO_PERSO_RELACIONADA,
-------------------------------------------------------- hasta aqui estructura vigia
trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AS FEC_PROCESO, 'MODIFICACION' AS MARCA
FROM BA_PERSONAS PE
INNER JOIN (SELECT VI1.COD_PERSONA,VI1.TIPO,VI1.COD_PER_VINCULO,VI1.FEC_INSERCION,VI1.FEC_MODIFICACION,VI1.FEC_VENCIMIENTO
FROM BA_VINCULOS VI1
WHERE VI1.TIPO = 'E' AND VI1.ACTIVO = 'S'
AND VI1.FEC_INSERCION = (SELECT MAX(FEC_INSERCION) FROM BA_VINCULOS VI2 WHERE VI2.COD_PERSONA = VI1.COD_PERSONA)) VI ON VI.COD_PERSONA = PE.COD_PERSONA
WHERE  PE.COD_TIP_DOCUMENTO NOT IN (9,10)
AND TRUNC(VI.FEC_INSERCION) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
AND TRUNC(VI.FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
/*) PP
GROUP BY PP.NRO_CLIENTE||'-'||PP.NRO_PERSO_RELACIONADA
HAVING (COUNT(*)) > 1*/
;

