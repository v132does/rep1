CREATE OR REPLACE FORCE VIEW IT.GV_SOL_VERIFICACION AS
SELECT COD_PERSONA,
              'PARTICULAR' TIPO, NULL DESCRIPCION,
              EST_VERIFICACION,  FEC_VERIFICACION, COD_USU_VERIFICADOR,
              NOM_PER_INFORMO,  NULL CAR_PER_INFORMO,
              NULL NOM_PER_CERTIFICO, NULL CAR_PER_CERTIFICO,
              OBS_VERIFICACION,
             USU_INSERCION,
             USU_MODIFICACION,
             FEC_INSERCION,
             FEC_MODIFICACION
FROM BA_PERSONAS
UNION ALL
SELECT COD_PERSONA, decode(TIP_REFERENCIA,'P','REF. PERSONAL','LABORAL') TIPO,
              NOM_PERSONA DESCRIPCION,
              EST_VERIFICACION,  FEC_VERIFICACION, COD_USU_VERIFICADOR,
              NOM_PER_INFORMO,  CAR_PER_INFORMO,
              NOM_PER_CERTIFICO, CAR_PER_CERTIFICO,
              OBS_VERIFICACION,
             USU_INSERCION,
             USU_MODIFICACION,
             FEC_INSERCION,
             FEC_MODIFICACION
FROM CR_REF_PERSONALES
UNION ALL
SELECT COD_PERSONA, 'REF. COMERCIAL' TIPO, DES_ENTIDAD DESCRIPCION,
              EST_VERIFICACION,  FEC_VERIFICACION, COD_USU_VERIFICADOR,
              NULL NOM_PER_INFORMO,  NULL CAR_PER_INFORMO,
              NULL NOM_PER_CERTIFICO, NULL CAR_PER_CERTIFICO,
              OBS_VERIFICACION,
             USU_INSERCION,
             USU_MODIFICACION,
             FEC_INSERCION,
             FEC_MODIFICACION
FROM CR_REF_COMERCIALES;
comment on column IT.GV_SOL_VERIFICACION.USU_INSERCION is 'Usuario que realizo la Insercion del Registro.';
comment on column IT.GV_SOL_VERIFICACION.USU_MODIFICACION is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GV_SOL_VERIFICACION.FEC_INSERCION is 'Fecha en que se Inserto el Registro.';
comment on column IT.GV_SOL_VERIFICACION.FEC_MODIFICACION is 'Fecha en que se realizo la Ultima Modificacion en el Registro.';

