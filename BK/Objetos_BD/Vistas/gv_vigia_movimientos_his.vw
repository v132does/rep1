CREATE OR REPLACE FORCE EDITIONABLE VIEW "IT"."GV_VIGIA_MOVIMIENTOS_HIS" ("BENEFICIARIO_DENOMINACION", "BENEFICIARIO_ID_CASO", "BENEFICIARIO_NRO_DOC", "BENEFICIARIO_TIPO_DOC", "BENEFICIARIO_TIPO_PERSONA", "CAJERO", "COD_PAIS_OTRA_CUENTA", "COD_PAIS_CTA_CLIENTE", "COD_TRX_INTERNO", "COD_TRX", "COD_MONEDA", "COD_OTRA_SUCURSAL_INVOLUCRADA", "COD_SUCURSAL_CLIENTE", "OTRA_CUENTA", "CUENTA_CLIENTE", "CUOTAS_CANCELADAS", "DEDUCCIONES", "FECHA_DE_OPERACION", "FECHA_DE_PROCESO", "FORMA_DE_PAGO", "GESTOR_DENOMINACION", "GESTOR_NRO_DOC", "GESTOR_TIPO_DOC", "HORA_OPERACION", "NRO_CLIENTE", "MARCA_PRODUCTO", "MONTO_DE_TRX", "OTRO_MONTO_INFORMADO", "NRO_OPERACION_O_COMPROBANTE", "NRO_TRANSACCION", "NROTARJETA", "ORDENANTE_DENOMINACION", "ORDENANTE_ID_CASO", "ORDENANTE_NRO_DOC", "ORDENANTE_TIPO_PERSONA", "ORDENANTE_TIPO_DOC", "ORIGEN_FONDOS", "TIPO_AUTORIZADOR", "TIPO_MODALIDAD_AUTORIZADOR", "TIPO_DE_CAMBIO", "CODCANAL", "ESCANALPRESENCIAL", "MARCA", "CLAVE", "TR_PADRE", "TR_HIJO", "SECUENCIA", "COD_PERSONA", "MOV_TP", "MOV_TH", "ESTADO") AS 

WITH Parametros AS (
    -- Centralizamos la lectura de parametros en un CTE para mejor performance
    SELECT 
		TO_DATE(fug_obt_pardinamico('AVIGIA_FECHA_ACTUAL'), 'dd/mm/yyyy') as AVIGIA_FECHA_ACTUAL,
      fug_obt_pardinamico('AVIGIA_MOVHIS_COD_SWIFT') as AVIGIA_MOVHIS_COD_SWIFT,

		fug_obt_pardinamico('AVIGIA_MOVHIS_MLC_CTAS_EXC') as par_MOVHIS_MLC_CTAS_EXC,
		fug_obt_pardinamico('AVIGIA_MOVHIS_MCD_TRAPP_CDAEX') as par_MOVHIS_MCD_TRAPP_CDAEX,
		fug_obt_pardinamico('AVIGIA_MOVHIS_MLC_TRAPP_CAMEXC') as par_MOVHIS_MLC_TRAPP_CAMEXC,
		fug_obt_pardinamico('AVIGIA_MOVHIS_MAH_TRAPP_AHOEXC') as par_MOVHIS_MAH_TRAPP_AHOEXC,
		fug_obt_pardinamico('AVIGIA_MOVHIS_MAH_TRAPP_AHRINC') as par_MOVHIS_MAH_TRAPP_AHRINC,
		fug_obt_pardinamico('AVIGIA_MOVHIS_MAH_TRAPP_CCTEXC') as par_MOVHIS_MAH_TRAPP_CCTEXC,
		fug_obt_pardinamico('AVIGIA_MOVHIS_MAH_TRAPP_CCRINC') as par_MOVHIS_MAH_TRAPP_CCRINC,
		fug_obt_pardinamico('AVIGIA_COD_PERSONA_EXC') as par_COD_PERSONA_EXC
    FROM DUAL
),
MOVHIS_MLC_CTAS_EXC AS (
    -- Convertimos el String a Filas una sola vez al inicio
    SELECT /*+ MATERIALIZE */ 
        TO_NUMBER(REGEXP_SUBSTR(p.par_MOVHIS_MLC_CTAS_EXC, '[^,]+', 1, LEVEL)) AS AVIGIA_MOVHIS_MLC_CTAS_EXC
    FROM Parametros p
    CONNECT BY REGEXP_SUBSTR(p.par_MOVHIS_MLC_CTAS_EXC, '[^,]+', 1, LEVEL) IS NOT NULL
),
MOVHIS_MCD_TRAPP_CDAEX AS (
    -- Convertimos el String a Filas una sola vez al inicio
    SELECT /*+ MATERIALIZE */ 
        TO_NUMBER(REGEXP_SUBSTR(p.par_MOVHIS_MCD_TRAPP_CDAEX, '[^,]+', 1, LEVEL)) AS AVIGIA_MOVHIS_MCD_TRAPP_CDAEX
    FROM Parametros p
    CONNECT BY REGEXP_SUBSTR(p.par_MOVHIS_MCD_TRAPP_CDAEX, '[^,]+', 1, LEVEL) IS NOT NULL
),
MOVHIS_MLC_TRAPP_CAMEXC AS (
    -- Convertimos el String a Filas una sola vez al inicio
    SELECT /*+ MATERIALIZE */ 
        TO_NUMBER(REGEXP_SUBSTR(p.par_MOVHIS_MLC_TRAPP_CAMEXC, '[^,]+', 1, LEVEL)) AS AVIGIA_MOVHIS_MLC_TRAPP_CAMEXC
    FROM Parametros p
    CONNECT BY REGEXP_SUBSTR(p.par_MOVHIS_MLC_TRAPP_CAMEXC, '[^,]+', 1, LEVEL) IS NOT NULL
),
MOVHIS_MAH_TRAPP_AHOEXC AS (
    -- Convertimos el String a Filas una sola vez al inicio
    SELECT /*+ MATERIALIZE */ 
        TO_NUMBER(REGEXP_SUBSTR(p.par_MOVHIS_MAH_TRAPP_AHOEXC, '[^,]+', 1, LEVEL)) AS AVIGIA_MOVHIS_MAH_TRAPP_AHOEXC
    FROM Parametros p
    CONNECT BY REGEXP_SUBSTR(p.par_MOVHIS_MAH_TRAPP_AHOEXC, '[^,]+', 1, LEVEL) IS NOT NULL
),
MOVHIS_MAH_TRAPP_AHRINC AS (
    -- Convertimos el String a Filas una sola vez al inicio
    SELECT /*+ MATERIALIZE */ 
        TO_NUMBER(REGEXP_SUBSTR(p.par_MOVHIS_MAH_TRAPP_AHRINC, '[^,]+', 1, LEVEL)) AS AVIGIA_MOVHIS_MAH_TRAPP_AHRINC
    FROM Parametros p
    CONNECT BY REGEXP_SUBSTR(p.par_MOVHIS_MAH_TRAPP_AHRINC, '[^,]+', 1, LEVEL) IS NOT NULL
),
MOVHIS_MAH_TRAPP_CCTEXC AS (
    -- Convertimos el String a Filas una sola vez al inicio
    SELECT /*+ MATERIALIZE */ 
        TO_NUMBER(REGEXP_SUBSTR(p.par_MOVHIS_MAH_TRAPP_CCTEXC, '[^,]+', 1, LEVEL)) AS AVIGIA_MOVHIS_MAH_TRAPP_CCTEXC
    FROM Parametros p
    CONNECT BY REGEXP_SUBSTR(p.par_MOVHIS_MAH_TRAPP_CCTEXC, '[^,]+', 1, LEVEL) IS NOT NULL
),
MOVHIS_MAH_TRAPP_CCRINC AS (
    -- Convertimos el String a Filas una sola vez al inicio
    SELECT /*+ MATERIALIZE */ 
        TO_NUMBER(REGEXP_SUBSTR(p.par_MOVHIS_MAH_TRAPP_CCRINC, '[^,]+', 1, LEVEL)) AS AVIGIA_MOVHIS_MAH_TRAPP_CCRINC
    FROM Parametros p
    CONNECT BY REGEXP_SUBSTR(p.par_MOVHIS_MAH_TRAPP_CCRINC, '[^,]+', 1, LEVEL) IS NOT NULL
),
COD_PERSONA_EXC AS (
    -- Convertimos el String a Filas una sola vez al inicio
    SELECT /*+ MATERIALIZE */ 
        TO_NUMBER(REGEXP_SUBSTR(p.par_COD_PERSONA_EXC, '[^,]+', 1, LEVEL)) AS AVIGIA_COD_PERSONA_EXC
    FROM Parametros p
    CONNECT BY REGEXP_SUBSTR(p.par_COD_PERSONA_EXC, '[^,]+', 1, LEVEL) IS NOT NULL
)



SELECT
NULL AS BENEFICIARIO_DENOMINACION,
NULL AS BENEFICIARIO_ID_CASO,
NULL AS BENEFICIARIO_NRO_DOC,
NULL AS BENEFICIARIO_TIPO_DOC,
NULL AS BENEFICIARIO_TIPO_PERSONA,
CASE WHEN MOP.NRO_CAJA IS NULL THEN MOP.COD_USUARIO ELSE MOP.NRO_CAJA||'-'||MOP.COD_USUARIO END AS CAJERO,
NULL AS COD_PAIS_OTRA_CUENTA,
to_char(PE.COD_PAIS) AS COD_PAIS_CTA_CLIENTE,
MOP.COD_MOD_PADRE||MOP.COD_TRA_PADRE||MOP.COD_MODULO||MOP.COD_TRANSACCION AS COD_TRX_INTERNO,
MOP.COD_MOD_PADRE||MOP.COD_TRA_PADRE||MOP.COD_MODULO||MOP.COD_TRANSACCION AS COD_TRX,
MOP.COD_MONEDA AS COD_MONEDA,
NULL AS COD_OTRA_SUCURSAL_INVOLUCRADA,
TO_CHAR(GE.COD_OFICINA) AS COD_SUCURSAL_CLIENTE,
NULL AS OTRA_CUENTA,
--TO_CHAR(MOP.NRO_CUENTA) AS CUENTA_CLIENTE,
CASE WHEN MOP.NRO_CUENTA IS NULL THEN
      CASE WHEN (SELECT MAX(NRO_CUENTA) FROM PR_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MOP.NRO_DOCUMENTO
            AND FECHA = MOP.FECHA AND HORA = MOP.HORA AND COD_USUARIO= MOP.COD_USUARIO AND COD_TRA_PADRE = MOP.COD_TRA_PADRE
            ) IS NULL
         THEN (SELECT MAX(NRO_CUENTA) FROM PR_MOVIMIENTOS_HIS WHERE  FECHA = MOP.FECHA
            AND HORA = MOP.HORA AND COD_USUARIO= MOP.COD_USUARIO AND COD_TRA_PADRE = MOP.COD_TRA_PADRE
            ) ELSE (SELECT MAX(NRO_CUENTA) FROM PR_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MOP.NRO_DOCUMENTO
                  AND FECHA = MOP.FECHA AND HORA = MOP.HORA AND COD_USUARIO= MOP.COD_USUARIO AND COD_TRA_PADRE = MOP.COD_TRA_PADRE
                  ) END
  ELSE MOP.NRO_CUENTA END AS CUENTA_CLIENTE,
PR.CAN_CUO_PAGADAS AS CUOTAS_CANCELADAS,
NULL AS DEDUCCIONES,
TO_CHAR(MOP.FEC_VALOR,'yyyy-mm-dd') AS FECHA_DE_OPERACION,
TO_CHAR(MOP.FECHA,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
CASE WHEN TP.DESCRIPCION LIKE '%EFEC%' THEN '1'
  ELSE (CASE WHEN (SELECT count(*) FROM PR_MOVIMIENTOS_HIS gm
    JOIN GE_TRANSACCIONES TH1 ON TH1.COD_TRANSACCION = gm.COD_TRANSACCION AND TH1.COD_MODULO = gm.COD_MODULO AND TH1.COD_MODALIDAD = gm.COD_MODALIDAD AND TH1.TIPO <> 'E'
    WHERE gm.FECHA = MOP.FECHA AND gm.HORA = MOP.HORA AND gm.COD_USUARIO = MOP.COD_USUARIO AND gm.COD_TRA_PADRE = MOP.COD_TRA_PADRE
    AND TH1.DESCRIPCION LIKE '%EFEC%') > 0 THEN '1' ELSE '0' END) END AS FORMA_DE_PAGO,
NULL AS GESTOR_DENOMINACION,
NULL AS GESTOR_NRO_DOC,
NULL AS GESTOR_TIPO_DOC,
MOP.HORA AS HORA_OPERACION,
'' AS NRO_CLIENTE,
CL.COD_MODULO||CL.COD_MODALIDAD AS MARCA_PRODUCTO,
CASE WHEN MOP.COD_MONEDA = 'GS' THEN NVL(ROUND((NVL(MOP.MONTO,0)/(fug_obt_cotizacion('USD',MOP.FECHA))),2),0)
             ELSE nvl(MOP.MONTO, 0) END AS MONTO_DE_TRX, -- usd moneda en la que trabaja Vigia
MOP.MONTO AS OTRO_MONTO_INFORMADO,
MOP.NRO_DOCUMENTO AS NRO_OPERACION_o_COMPROBANTE,
TO_CHAR(MOP.FECHA,'yyyymmdd')||'-'||MOP.HORA||'-'||MOP.COD_USUARIO||'-'||MOP.NRO_SECUENCIA||'-'||MOP.COD_TRA_PADRE||'-'||MOP.COD_TRANSACCION AS NRO_TRANSACCION, --- CLAVE UNICA NO SE DEBE REPETIR
NULL AS NROTARJETA,
NULL AS ORDENANTE_DENOMINACION,
NULL AS ORDENANTE_ID_CASO,
NULL ORDENANTE_NRO_DOC,
NULL AS ORDENANTE_TIPO_PERSONA,
NULL AS ORDENANTE_TIPO_DOC,
NULL AS ORIGEN_FONDOS,
NULL AS TIPO_AUTORIZADOR,
NULL AS TIPO_MODALIDAD_AUTORIZADOR,
CASE WHEN MOP.COD_MONEDA = 'GS' THEN (fug_obt_cotizacion('USD',MOP.FECHA)) ELSE NULL END AS TIPO_DE_CAMBIO,
--inicio case agregado 20250428
CASE WHEN MOP.NRO_CAJA > 0 THEN '3' -- 'SUCURSAL'
WHEN NVL(UC1.COD_CANAL, 0) > 0 AND NVL(UC2.COD_CANAL, 0) = 0 THEN UC1.COD_CANAL
WHEN NVL(UC1.COD_CANAL, 0) = 0 AND NVL(UC2.COD_CANAL, 0) > 0 THEN UC2.COD_CANAL





   ELSE '3' --'SUCURSAL'
     END AS CODCANAL,
CASE WHEN MOP.NRO_CAJA > 0 THEN 'S'
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') <> ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') = ' ' THEN UC1.CANAL_PRESENCIAL
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') = ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') <> ' ' THEN UC2.CANAL_PRESENCIAL





   ELSE 'S' END AS ESCANALPRESENCIAL,
--fin case agregado 20250428
-------------------------------------------------------- hasta aqui estructura vigia
   'PRESTAMO' AS MARCA,    NULL AS CLAVE,
   MOP.COD_TRA_PADRE AS TR_PADRE,
   MOP.COD_TRANSACCION AS TR_HIJO,
   MOP.NRO_SECUENCIA AS SECUENCIA,   NULL AS COD_PERSONA,  NULL AS MOV_TP,   NULL AS MOV_TH,   NULL AS ESTADO
-------------------------------------------------------- PRESTAMOS
FROM pr_movimientos_his MOP
LEFT JOIN GE_CTA_CLIENTES CL ON MOP.NRO_CUENTA = CL.NRO_CUENTA AND CL.RELACION = 'P'
LEFT JOIN BA_PERSONAS PE ON PE.COD_PERSONA = CL.COD_PERSONA
JOIN PR_CTA_PRESTAMOS PR ON PR.NRO_CUENTA = CL.NRO_CUENTA
JOIN BA_USUARIOS US ON US.COD_USUARIO = MOP.COD_USUARIO
JOIN BA_MODULOS MP ON MP.COD_MODULO = MOP.COD_MODULO
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA
JOIN GE_TRANSACCIONES TP ON TP.COD_TRANSACCION = MOP.COD_TRA_PADRE AND TP.COD_MODULO = MOP.COD_MOD_PADRE AND TP.COD_MODALIDAD = MOP.COD_MAD_PADRE AND TP.TIPO <> 'E'
JOIN GE_TRANSACCIONES TH ON TH.COD_TRANSACCION = MOP.COD_TRANSACCION AND TH.COD_MODULO = MOP.COD_MODULO AND TH.COD_MODALIDAD = MOP.COD_MODALIDAD AND TH.TIPO <> 'E'
--inicio join agregado 20250428
LEFT JOIN BA_USU_CAN_VIGIA UC1 ON UC1.COD_USUARIO = MOP.COD_USUARIO
LEFT JOIN BA_USU_CAN_VIGIA UC2 ON UC2.USU_ID_INS = MOP.USU_INSERCION
--fin join agregado 20250428
WHERE MOP.REVERSADO = 'N'
AND MOP.FECHA = (SELECT  AVIGIA_FECHA_ACTUAL FROM Parametros)
AND NVL(CL.COD_PERSONA,0) NOT IN (SELECT AVIGIA_COD_PERSONA_EXC FROM COD_PERSONA_EXC)
AND MOP.MONTO > 0
AND PR.ESTADO <> ('N')

UNION ALL ------------------------- MESA DE DINERO
SELECT
NULL AS BENEFICIARIO_DENOMINACION,
NULL AS BENEFICIARIO_ID_CASO,
NULL AS BENEFICIARIO_NRO_DOC,
NULL AS BENEFICIARIO_TIPO_DOC,
NULL AS BENEFICIARIO_TIPO_PERSONA,
CASE WHEN MMD.NRO_CAJA IS NULL THEN MMD.COD_USUARIO ELSE MMD.NRO_CAJA||'-'||MMD.COD_USUARIO END AS CAJERO,
NULL AS COD_PAIS_OTRA_CUENTA,
TO_CHAR(PE.COD_PAIS) AS COD_PAIS_CTA_CLIENTE,
MMD.COD_MOD_PADRE||MMD.COD_TRA_PADRE||MMD.COD_MODULO||MMD.COD_TRANSACCION AS COD_TRX_INTERNO,
MMD.COD_MOD_PADRE||MMD.COD_TRA_PADRE||MMD.COD_MODULO||MMD.COD_TRANSACCION AS COD_TRX,
MMD.COD_MONEDA AS COD_MONEDA,
NULL AS COD_OTRA_SUCURSAL_INVOLUCRADA,
TO_CHAR(GE.COD_OFICINA) AS COD_SUCURSAL_CLIENTE,
NULL AS OTRA_CUENTA,
--TO_CHAR(MMD.NRO_CUENTA) AS CUENTA_CLIENTE,
CASE WHEN MMD.NRO_CUENTA IS NULL THEN
      CASE WHEN (SELECT MAX(NRO_CUENTA) FROM MD_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MMD.NRO_DOCUMENTO
            AND FECHA = MMD.FECHA AND HORA = MMD.HORA AND COD_USUARIO= MMD.COD_USUARIO AND COD_TRA_PADRE = MMD.COD_TRA_PADRE
            ) IS NULL
         THEN (SELECT MAX(NRO_CUENTA) FROM MD_MOVIMIENTOS_HIS WHERE FECHA = MMD.FECHA
            AND HORA = MMD.HORA AND COD_USUARIO= MMD.COD_USUARIO AND COD_TRA_PADRE = MMD.COD_TRA_PADRE
            ) ELSE (SELECT MAX(NRO_CUENTA) FROM  MD_MOVIMIENTOS_HIS  WHERE NRO_DOCUMENTO = MMD.NRO_DOCUMENTO
                  AND FECHA = MMD.FECHA AND HORA = MMD.HORA AND COD_USUARIO= MMD.COD_USUARIO AND COD_TRA_PADRE = MMD.COD_TRA_PADRE
                  ) END
  ELSE MMD.NRO_CUENTA END AS CUENTA_CLIENTE,
NULL AS CUOTAS_CANCELADAS,
NULL AS DEDUCCIONES,
TO_CHAR(MMD.FEC_VALOR,'yyyy-mm-dd') AS FECHA_DE_OPERACION,
TO_CHAR(MMD.FECHA,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
CASE WHEN TP.DESCRIPCION LIKE '%EFEC%' THEN '1'
  ELSE (CASE WHEN (SELECT count(*) FROM MD_MOVIMIENTOS_HIS gm
    JOIN GE_TRANSACCIONES TH1 ON TH1.COD_TRANSACCION = gm.COD_TRANSACCION AND TH1.COD_MODULO = gm.COD_MODULO
    AND TH1.COD_MODALIDAD = gm.COD_MODALIDAD AND TH1.TIPO <> 'E'
    WHERE gm.FECHA = MMD.FECHA AND gm.HORA = MMD.HORA AND gm.COD_USUARIO = MMD.COD_USUARIO AND gm.COD_TRA_PADRE = MMD.COD_TRA_PADRE
    AND TH1.DESCRIPCION LIKE '%EFEC%') > 0 THEN '1'
    ELSE '0' END) END AS FORMA_DE_PAGO,
NULL AS GESTOR_DENOMINACION,
NULL AS GESTOR_NRO_DOC,
NULL AS GESTOR_TIPO_DOC,
MMD.HORA AS HORA_OPERACION,
'' AS NRO_CLIENTE,
CL.COD_MODULO||CL.COD_MODALIDAD AS MARCA_PRODUCTO,
CASE WHEN MMD.COD_MONEDA = 'GS' THEN NVL(ROUND((NVL(MMD.MONTO,0)/(fug_obt_cotizacion('USD',MMD.FECHA))),2),0)
             ELSE nvl(MMD.MONTO, 0) END AS MONTO_DE_TRX, -- usd moneda en la que trabaja Vigia
MMD.MONTO AS OTRO_MONTO_INFORMADO,
MMD.NRO_DOCUMENTO AS NRO_OPERACION_o_COMPROBANTE,
TO_CHAR(MMD.FECHA,'yyyymmdd')||'-'||MMD.HORA||'-'||MMD.COD_USUARIO||'-'||MMD.NRO_SECUENCIA||'-'||MMD.COD_TRA_PADRE||'-'||MMD.COD_TRANSACCION AS NRO_TRANSACCION, --- CLAVE UNICA NO SE DEBE REPETIR
NULL AS NROTARJETA,
NULL AS ORDENANTE_DENOMINACION,
NULL AS ORDENANTE_ID_CASO,
NULL ORDENANTE_NRO_DOC,
NULL AS ORDENANTE_TIPO_PERSONA,
NULL AS ORDENANTE_TIPO_DOC,
NULL AS ORIGEN_FONDOS,
NULL AS TIPO_AUTORIZADOR,
NULL AS TIPO_MODALIDAD_AUTORIZADOR,
CASE WHEN MMD.COD_MONEDA = 'GS' THEN (fug_obt_cotizacion('USD',MMD.FECHA)) ELSE NULL END AS TIPO_DE_CAMBIO,

--inicio case agregado 20250428
CASE WHEN MMD.NRO_CAJA > 0 THEN '3' -- 'SUCURSAL'
WHEN NVL(UC1.COD_CANAL, 0) > 0 AND NVL(UC2.COD_CANAL, 0) = 0 THEN UC1.COD_CANAL
WHEN NVL(UC1.COD_CANAL, 0) = 0 AND NVL(UC2.COD_CANAL, 0) > 0 THEN UC2.COD_CANAL





ELSE '3' --'SUCURSAL'
END AS CODCANAL ,
CASE WHEN MMD.NRO_CAJA > 0 THEN 'S' -- 'S'
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') <> ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') = ' ' THEN UC1.CANAL_PRESENCIAL
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') = ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') <> ' ' THEN UC2.CANAL_PRESENCIAL





   ELSE 'S' END AS ESCANALPRESENCIAL,
--fin case agregado 20250428
-------------------------------------------------------- hasta aqui estructura vigia
   'MESA DE DINERO' AS CANAL,  NULL AS CLAVE,
   MMD.COD_TRA_PADRE AS TR_PADRE,
   MMD.COD_TRANSACCION AS TR_HIJO,
   MMD.NRO_SECUENCIA AS SECUENCIA,   NULL AS COD_PERSONA,  NULL AS MOV_TP,   NULL AS MOV_TH,   NULL AS ESTADO
-------------------------------------------------------- MESA DE DINERO
FROM MD_MOVIMIENTOS_HIS  MMD
LEFT JOIN GE_CTA_CLIENTES CL ON MMD.NRO_CUENTA = CL.NRO_CUENTA AND CL.RELACION = 'P'
LEFT JOIN BA_PERSONAS PE ON PE.COD_PERSONA = CL.COD_PERSONA
JOIN MD_CTA_DOCUMENTOS MD ON MD.NRO_CUENTA = CL.NRO_CUENTA
JOIN BA_USUARIOS US ON US.COD_USUARIO = MMD.COD_USUARIO
JOIN BA_MODULOS MP ON MP.COD_MODULO = MMD.COD_MODULO
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA
JOIN GE_TRANSACCIONES TP ON TP.COD_TRANSACCION = MMD.COD_TRA_PADRE AND TP.COD_MODULO = MMD.COD_MOD_PADRE AND TP.COD_MODALIDAD = MMD.COD_MAD_PADRE AND TP.TIPO <> 'E'
JOIN GE_TRANSACCIONES TH ON TH.COD_TRANSACCION = MMD.COD_TRANSACCION AND TH.COD_MODULO = MMD.COD_MODULO AND TH.COD_MODALIDAD = MMD.COD_MODALIDAD AND TH.TIPO <> 'E'
--inicio join agregado
LEFT JOIN BA_USU_CAN_VIGIA UC1 ON UC1.COD_USUARIO = MMD.COD_USUARIO
LEFT JOIN BA_USU_CAN_VIGIA UC2 ON UC2.USU_ID_INS = MMD.USU_INSERCION
--fin join agregado
WHERE MMD.REVERSADO = 'N'
AND MMD.FECHA = (SELECT  AVIGIA_FECHA_ACTUAL FROM Parametros)
AND NVL(CL.COD_PERSONA,0) NOT IN (SELECT AVIGIA_COD_PERSONA_EXC FROM COD_PERSONA_EXC)
AND MD.ESTADO <> ('N')
AND MMD.MONTO > 0

UNION ALL --------------------------------OP VENCIDAS
SELECT
NULL AS BENEFICIARIO_DENOMINACION,
NULL AS BENEFICIARIO_ID_CASO,
NULL AS BENEFICIARIO_NRO_DOC,
NULL AS BENEFICIARIO_TIPO_DOC,
NULL AS BENEFICIARIO_TIPO_PERSONA,
CASE WHEN MOV.NRO_CAJA IS NULL THEN MOV.COD_USUARIO ELSE MOV.NRO_CAJA||'-'||MOV.COD_USUARIO END AS CAJERO,
NULL AS COD_PAIS_OTRA_CUENTA,
TO_CHAR(PE.COD_PAIS) AS COD_PAIS_CTA_CLIENTE,
MOV.COD_MOD_PADRE||MOV.COD_TRA_PADRE||MOV.COD_MODULO||MOV.COD_TRANSACCION AS COD_TRX_INTERNO,
MOV.COD_MOD_PADRE||MOV.COD_TRA_PADRE||MOV.COD_MODULO||MOV.COD_TRANSACCION AS COD_TRX,
MOV.COD_MONEDA AS COD_MONEDA,
NULL AS COD_OTRA_SUCURSAL_INVOLUCRADA,
TO_CHAR(GE.COD_OFICINA) AS COD_SUCURSAL_CLIENTE,
NULL AS OTRA_CUENTA,
--TO_CHAR(MOV.NRO_CUENTA) AS CUENTA_CLIENTE,
CASE WHEN MOV.NRO_CUENTA IS NULL THEN
      CASE WHEN (SELECT MAX(NRO_CUENTA) FROM OV_MOVIMIENTOS_HIS  WHERE NRO_DOCUMENTO = MOV.NRO_DOCUMENTO
            AND FECHA = MOV.FECHA AND HORA = MOV.HORA AND COD_USUARIO= MOV.COD_USUARIO AND COD_TRA_PADRE = MOV.COD_TRA_PADRE
            ) IS NULL
         THEN (SELECT MAX(NRO_CUENTA) FROM OV_MOVIMIENTOS_HIS  WHERE FECHA = MOV.FECHA
            AND HORA = MOV.HORA AND COD_USUARIO= MOV.COD_USUARIO AND COD_TRA_PADRE = MOV.COD_TRA_PADRE
            ) ELSE (SELECT MAX(NRO_CUENTA) FROM  OV_MOVIMIENTOS_HIS   WHERE NRO_DOCUMENTO = MOV.NRO_DOCUMENTO
                  AND FECHA = MOV.FECHA AND HORA = MOV.HORA AND COD_USUARIO= MOV.COD_USUARIO AND COD_TRA_PADRE = MOV.COD_TRA_PADRE
                  ) END
  ELSE MOV.NRO_CUENTA END AS CUENTA_CLIENTE,
NULL AS CUOTAS_CANCELADAS,
NULL AS DEDUCCIONES,
TO_CHAR(MOV.FEC_VALOR,'yyyy-mm-dd') AS FECHA_DE_OPERACION,
TO_CHAR(MOV.FECHA,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
CASE WHEN TP.DESCRIPCION LIKE '%EFEC%' THEN '1'
  ELSE (CASE WHEN (SELECT count(*) FROM PR_MOVIMIENTOS_HIS gm
    JOIN GE_TRANSACCIONES TH1 ON TH1.COD_TRANSACCION = gm.COD_TRANSACCION AND TH1.COD_MODULO = gm.COD_MODULO AND TH1.COD_MODALIDAD = gm.COD_MODALIDAD AND TH1.TIPO <> 'E'
    WHERE gm.FECHA = MOV.FECHA AND gm.HORA = MOV.HORA AND gm.COD_USUARIO = MOV.COD_USUARIO AND gm.COD_TRA_PADRE = MOV.COD_TRA_PADRE
    AND TH1.DESCRIPCION LIKE '%EFEC%') > 0 THEN '1' ELSE '0' END) END AS FORMA_DE_PAGO,
NULL AS GESTOR_DENOMINACION,
NULL AS GESTOR_NRO_DOC,
NULL AS GESTOR_TIPO_DOC,
MOV.HORA AS HORA_OPERACION,
'' AS NRO_CLIENTE,
CL.COD_MODULO||CL.COD_MODALIDAD AS MARCA_PRODUCTO,
CASE WHEN MOV.COD_MONEDA = 'GS' THEN NVL(ROUND((NVL(MOV.MONTO,0)/(fug_obt_cotizacion('USD',MOV.FECHA))),2),0)
             ELSE nvl(MOV.MONTO, 0) END AS MONTO_DE_TRX, -- usd moneda en la que trabaja Vigia
MOV.MONTO AS OTRO_MONTO_INFORMADO,
MOV.NRO_DOCUMENTO AS NRO_OPERACION_o_COMPROBANTE,
TO_CHAR(MOV.FECHA,'yyyymmdd')||'-'||MOV.HORA||'-'||MOV.COD_USUARIO||'-'||MOV.NRO_SECUENCIA||'-'||MOV.COD_TRA_PADRE||'-'||MOV.COD_TRANSACCION AS NRO_TRANSACCION, --- CLAVE UNICA NO SE DEBE REPETIR
NULL AS NROTARJETA,
NULL AS ORDENANTE_DENOMINACION,
NULL AS ORDENANTE_ID_CASO,
NULL ORDENANTE_NRO_DOC,
NULL AS ORDENANTE_TIPO_PERSONA,
NULL AS ORDENANTE_TIPO_DOC,
NULL AS ORIGEN_FONDOS,
NULL AS TIPO_AUTORIZADOR,
NULL AS TIPO_MODALIDAD_AUTORIZADOR,
CASE WHEN MOV.COD_MONEDA = 'GS' THEN (fug_obt_cotizacion('USD',MOV.FECHA)) ELSE NULL END AS TIPO_DE_CAMBIO,

--inicio case agregado 20250428
CASE WHEN MOV.NRO_CAJA > 0 THEN '3' -- 'SUCURSAL'
WHEN NVL(UC1.COD_CANAL, 0) > 0 AND NVL(UC2.COD_CANAL, 0) = 0 THEN UC1.COD_CANAL
WHEN NVL(UC1.COD_CANAL, 0) = 0 AND NVL(UC2.COD_CANAL, 0) > 0 THEN UC2.COD_CANAL





   ELSE '3' --'SUCURSAL'
     END AS CODCANAL,
CASE WHEN MOV.NRO_CAJA > 0 THEN 'S'
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') <> ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') = ' ' THEN UC1.CANAL_PRESENCIAL
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') = ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') <> ' ' THEN UC2.CANAL_PRESENCIAL





   ELSE 'S' END AS ESCANALPRESENCIAL,





--fin case agregado 20250428

-------------------------------------------------------- hasta aqui estructura vigia
   'OP VENCIDAS' AS MARCA,   NULL AS CLAVE,
   MOV.COD_TRA_PADRE AS TR_PADRE,
   MOV.COD_TRANSACCION AS TR_HIJO,
   MOV.NRO_SECUENCIA AS SECUENCIA,   NULL AS COD_PERSONA,  NULL AS MOV_TP,   NULL AS MOV_TH,   NULL AS ESTADO
-------------------------------------------------------- OPERACION VENCIDA
FROM OV_MOVIMIENTOS_HIS MOV
LEFT JOIN GE_CTA_CLIENTES CL ON MOV.NRO_CUENTA = CL.NRO_CUENTA AND CL.RELACION = 'P'
LEFT JOIN BA_PERSONAS PE ON PE.COD_PERSONA = CL.COD_PERSONA
JOIN OV_CTA_VENCIDAS OV ON OV.NRO_CUENTA = CL.NRO_CUENTA
JOIN BA_USUARIOS US ON US.COD_USUARIO = MOV.COD_USUARIO
JOIN BA_MODULOS MP ON MP.COD_MODULO = MOV.COD_MODULO
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA
JOIN GE_TRANSACCIONES TP ON TP.COD_TRANSACCION = MOV.COD_TRA_PADRE AND TP.COD_MODULO = MOV.COD_MOD_PADRE AND TP.COD_MODALIDAD = MOV.COD_MAD_PADRE AND TP.TIPO <> 'E'
JOIN GE_TRANSACCIONES TH ON TH.COD_TRANSACCION = MOV.COD_TRANSACCION AND TH.COD_MODULO = MOV.COD_MODULO AND TH.COD_MODALIDAD = MOV.COD_MODALIDAD AND TH.TIPO <> 'E'
--inicio join agregado
LEFT JOIN BA_USU_CAN_VIGIA UC1 ON UC1.COD_USUARIO = MOV.COD_USUARIO
LEFT JOIN BA_USU_CAN_VIGIA UC2 ON UC2.USU_ID_INS = MOV.USU_INSERCION
--fin join agregado
WHERE MOV.REVERSADO = 'N' AND MOV.COD_MODULO = 15
AND MOV.FECHA = (SELECT  AVIGIA_FECHA_ACTUAL FROM Parametros)
AND NVL(CL.COD_PERSONA,0) NOT IN (SELECT AVIGIA_COD_PERSONA_EXC FROM COD_PERSONA_EXC)
AND OV.ESTADO <> ('C')
AND MOV.MONTO > 0

UNION ALL--------------------------------------------------  CDA
SELECT
NULL AS BENEFICIARIO_DENOMINACION,
NULL AS BENEFICIARIO_ID_CASO,
NULL AS BENEFICIARIO_NRO_DOC,
NULL AS BENEFICIARIO_TIPO_DOC,
NULL AS BENEFICIARIO_TIPO_PERSONA,
CASE WHEN MCD.NRO_CAJA IS NULL THEN MCD.COD_USUARIO ELSE MCD.NRO_CAJA||'-'||MCD.COD_USUARIO END AS CAJERO,
NULL AS COD_PAIS_OTRA_CUENTA,
CASE WHEN MCD.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(P.COD_PAIS) FROM BA_PERSONAS P
      JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = P.COD_PERSONA AND C.RELACION = 'P'
      AND C.NRO_CUENTA = (SELECT MAX (NRO_CUENTA) FROM AH_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MCD.NRO_DOCUMENTO
                  AND FECHA = MCD.FECHA AND HORA = MCD.HORA AND COD_USUARIO= MCD.COD_USUARIO)
  ) ELSE TO_CHAR(PE.COD_PAIS) END AS COD_PAIS_CTA_CLIENTE,

CASE WHEN MCD.COD_TRA_PADRE IN (388, 309) THEN 						--TRANSFERENCIA ENTRE CUENTAS | TRANSFERENCIA ENTRE CUENTAS - HB
        CASE WHEN MCD.COD_TRANSACCION = 602 THEN 					-- 602 credito en cuenta
                CASE WHEN CL.COD_PERSONA = (
                        SELECT max(CTA.COD_PERSONA) 					--- DISTINCT IN
                        FROM AH_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA 
                                ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
                             	AND CTA.RELACION = 'P'						
                        WHERE GV.FECHA           = MCD.FECHA  
                          AND GV.HORA            = MCD.HORA 
                          AND GV.COD_USUARIO     = MCD.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MCD.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 503
                    )
                    THEN '99' || MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD
                    ELSE 
		                    CASE WHEN CL.COD_PERSONA = (
		                        SELECT max(CTA.COD_PERSONA)     			
		                        FROM CC_MOVIMIENTOS_HIS GV
		                        INNER JOIN GE_CTA_CLIENTES CTA 
		                                ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
		                        	    AND CTA.RELACION = 'P'				
		                        WHERE GV.FECHA           = MCD.FECHA  
		                          AND GV.HORA            = MCD.HORA 
		                          AND GV.COD_USUARIO     = MCD.COD_USUARIO
		                          AND GV.COD_TRA_PADRE   = MCD.COD_TRA_PADRE 
		                          AND GV.COD_TRANSACCION = 503
		                    )
		                    THEN '99' || MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD
		                    ELSE MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD 
		                    END
                END
            WHEN MCD.COD_TRANSACCION = 503 THEN 							-- 503 es debito en cuenta
                CASE WHEN CL.COD_PERSONA = (
                        SELECT max(CTA.COD_PERSONA) 						
                        FROM CC_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA 
                                ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
                         	    AND CTA.RELACION = 'P'						
                        WHERE GV.FECHA           = MCD.FECHA  
                          AND GV.HORA            = MCD.HORA 
                          AND GV.COD_USUARIO     = MCD.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MCD.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 602
                    )
                    THEN '99' || MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD
                    ELSE  
	                    CASE WHEN CL.COD_PERSONA = (
	                        SELECT max(CTA.COD_PERSONA) 				
	                        FROM AH_MOVIMIENTOS_HIS GV
	                        INNER JOIN GE_CTA_CLIENTES CTA 
	                                ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
	                               AND CTA.RELACION = 'P'
	                        WHERE GV.FECHA           = MCD.FECHA  
	                          AND GV.HORA            = MCD.HORA 
	                          AND GV.COD_USUARIO     = MCD.COD_USUARIO
	                          AND GV.COD_TRA_PADRE   = MCD.COD_TRA_PADRE 
	                          AND GV.COD_TRANSACCION = 602
	                    )
	                    THEN '99' || MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD
	                    ELSE  MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD  
	                    END
                END
            ELSE MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION 
        END
    ELSE MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION
END AS COD_TRX_INTERNO,
--MCD.COD_MOD_PADRE||MCD.COD_TRA_PADRE||MCD.COD_MODULO||MCD.COD_TRANSACCION AS COD_TRX,
CASE WHEN MCD.COD_TRA_PADRE IN (388, 309) THEN 						--TRANSFERENCIA ENTRE CUENTAS | TRANSFERENCIA ENTRE CUENTAS - HB
        CASE WHEN MCD.COD_TRANSACCION = 602 THEN 					-- 602 credito en cuenta
                CASE WHEN CL.COD_PERSONA = (
                        SELECT max(CTA.COD_PERSONA) 					--- DISTINCT IN
                        FROM AH_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA 
                                ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
                             	AND CTA.RELACION = 'P'						
                        WHERE GV.FECHA           = MCD.FECHA  
                          AND GV.HORA            = MCD.HORA 
                          AND GV.COD_USUARIO     = MCD.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MCD.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 503
                    )
                    THEN '99' || MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD
                    ELSE 
		                    CASE WHEN CL.COD_PERSONA = (
		                        SELECT max(CTA.COD_PERSONA)     			
		                        FROM CC_MOVIMIENTOS_HIS GV
		                        INNER JOIN GE_CTA_CLIENTES CTA 
		                                ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
		                        	    AND CTA.RELACION = 'P'				
		                        WHERE GV.FECHA           = MCD.FECHA  
		                          AND GV.HORA            = MCD.HORA 
		                          AND GV.COD_USUARIO     = MCD.COD_USUARIO
		                          AND GV.COD_TRA_PADRE   = MCD.COD_TRA_PADRE 
		                          AND GV.COD_TRANSACCION = 503
		                    )
		                    THEN '99' || MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD
		                    ELSE MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD 
		                    END
                END
            WHEN MCD.COD_TRANSACCION = 503 THEN 							-- 503 es debito en cuenta
                CASE WHEN CL.COD_PERSONA = (
                        SELECT max(CTA.COD_PERSONA) 						
                        FROM CC_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA 
                                ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
                         	    AND CTA.RELACION = 'P'						
                        WHERE GV.FECHA           = MCD.FECHA  
                          AND GV.HORA            = MCD.HORA 
                          AND GV.COD_USUARIO     = MCD.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MCD.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 602
                    )
                    THEN '99' || MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD
                    ELSE  
	                    CASE WHEN CL.COD_PERSONA = (
	                        SELECT max(CTA.COD_PERSONA) 				
	                        FROM AH_MOVIMIENTOS_HIS GV
	                        INNER JOIN GE_CTA_CLIENTES CTA 
	                                ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
	                               AND CTA.RELACION = 'P'
	                        WHERE GV.FECHA           = MCD.FECHA  
	                          AND GV.HORA            = MCD.HORA 
	                          AND GV.COD_USUARIO     = MCD.COD_USUARIO
	                          AND GV.COD_TRA_PADRE   = MCD.COD_TRA_PADRE 
	                          AND GV.COD_TRANSACCION = 602
	                    )
	                    THEN '99' || MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD
	                    ELSE  MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION || MCD.COD_MODALIDAD  
	                    END
                END
            ELSE MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION 
        END
    ELSE MCD.COD_MOD_PADRE || MCD.COD_TRA_PADRE || MCD.COD_MODULO || MCD.COD_TRANSACCION
END AS COD_TRX,
MCD.COD_MONEDA AS COD_MONEDA,
NULL AS COD_OTRA_SUCURSAL_INVOLUCRADA,
CASE WHEN MCD.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(G.COD_OFICINA)
  FROM GE_CLIENTES G
  JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = G.COD_PERSONA AND C.RELACION = 'P'
  AND C.NRO_CUENTA =  (SELECT MAX (NRO_CUENTA)
              FROM AH_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MCD.NRO_DOCUMENTO
              AND FECHA = MCD.FECHA AND HORA = MCD.HORA AND COD_USUARIO= MCD.COD_USUARIO)
  ) ELSE TO_CHAR(GE.COD_OFICINA) END AS COD_SUCURSAL_CLIENTE,
NULL AS OTRA_CUENTA,
CASE WHEN MCD.NRO_CUENTA IS NULL THEN
      CASE WHEN (SELECT MAX(NRO_CUENTA) FROM AH_MOVIMIENTOS_HIS  WHERE NRO_DOCUMENTO = MCD.NRO_DOCUMENTO
            AND FECHA = MCD.FECHA AND HORA = MCD.HORA AND COD_USUARIO= MCD.COD_USUARIO AND COD_TRA_PADRE = MCD.COD_TRA_PADRE
            ) IS NULL
         THEN (SELECT MAX(NRO_CUENTA) FROM AH_MOVIMIENTOS_HIS  WHERE FECHA = MCD.FECHA
            AND HORA = MCD.HORA AND COD_USUARIO= MCD.COD_USUARIO AND COD_TRA_PADRE = MCD.COD_TRA_PADRE
            ) ELSE (SELECT MAX(NRO_CUENTA) FROM  AH_MOVIMIENTOS_HIS   WHERE NRO_DOCUMENTO = MCD.NRO_DOCUMENTO
                  AND FECHA = MCD.FECHA AND HORA = MCD.HORA AND COD_USUARIO= MCD.COD_USUARIO AND COD_TRA_PADRE = MCD.COD_TRA_PADRE
                  ) END
  ELSE MCD.NRO_CUENTA END AS CUENTA_CLIENTE,
NULL AS CUOTAS_CANCELADAS,
NULL AS DEDUCCIONES,
TO_CHAR(MCD.FEC_VALOR,'yyyy-mm-dd') AS FECHA_DE_OPERACION,
TO_CHAR(MCD.FECHA,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
CASE WHEN TP.DESCRIPCION LIKE '%EFEC%' THEN '1'
  ELSE (CASE WHEN (SELECT count(*) FROM AH_MOVIMIENTOS_HIS gm
    JOIN GE_TRANSACCIONES TH1 ON TH1.COD_TRANSACCION = gm.COD_TRANSACCION AND TH1.COD_MODULO = gm.COD_MODULO
    AND TH1.COD_MODALIDAD = gm.COD_MODALIDAD AND TH1.TIPO <> 'E'
    WHERE gm.FECHA = MCD.FECHA AND gm.HORA = MCD.HORA AND gm.COD_USUARIO = MCD.COD_USUARIO AND gm.COD_TRA_PADRE = MCD.COD_TRA_PADRE
    AND TH1.DESCRIPCION LIKE '%EFEC%') > 0 THEN '1'
    ELSE '0' END) END AS FORMA_DE_PAGO,
NULL AS GESTOR_DENOMINACION,
NULL AS GESTOR_NRO_DOC,
NULL AS GESTOR_TIPO_DOC,
MCD.HORA AS HORA_OPERACION,
NULL AS NRO_CLIENTE,
CASE WHEN MCD.NRO_CUENTA IS NULL THEN (SELECT MAX (MCD.COD_MODULO||MCD.COD_MODALIDAD)
              FROM AH_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MCD.NRO_DOCUMENTO
              AND FECHA = MCD.FECHA AND HORA = MCD.HORA AND COD_USUARIO= MCD.COD_USUARIO
  ) ELSE CL.COD_MODULO||CL.COD_MODALIDAD END AS MARCA_PRODUCTO,
CASE WHEN MCD.COD_MONEDA = 'GS' THEN NVL(ROUND((NVL(MCD.MONTO,0)/(fug_obt_cotizacion('USD',MCD.FECHA))),2),0)
             ELSE nvl(MCD.MONTO, 0) END AS MONTO_DE_TRX, -- usd moneda en la que trabaja Vigia
MCD.MONTO AS OTRO_MONTO_INFORMADO,
MCD.NRO_DOCUMENTO AS NRO_OPERACION_o_COMPROBANTE,
TO_CHAR(MCD.FECHA,'yyyymmdd')||'-'||MCD.HORA||'-'||MCD.COD_USUARIO||'-'||MCD.NRO_SECUENCIA||'-'||MCD.COD_TRA_PADRE||'-'||MCD.COD_TRANSACCION AS NRO_TRANSACCION, --- CLAVE UNICA NO SE DEBE REPETIR
NULL AS NROTARJETA,
NULL AS ORDENANTE_DENOMINACION,
NULL AS ORDENANTE_ID_CASO,
NULL ORDENANTE_NRO_DOC,
NULL AS ORDENANTE_TIPO_PERSONA,
NULL AS ORDENANTE_TIPO_DOC,
NULL AS ORIGEN_FONDOS,
NULL AS TIPO_AUTORIZADOR,
NULL AS TIPO_MODALIDAD_AUTORIZADOR,
CASE WHEN MCD.COD_MONEDA = 'GS' THEN (fug_obt_cotizacion('USD',MCD.FECHA)) ELSE NULL END AS TIPO_DE_CAMBIO,

--inicio case agregado 20250428
CASE WHEN MCD.NRO_CAJA > 0 THEN '3' -- 'SUCURSAL'
WHEN NVL(UC1.COD_CANAL, 0) > 0 AND NVL(UC2.COD_CANAL, 0) = 0 THEN UC1.COD_CANAL
WHEN NVL(UC1.COD_CANAL, 0) = 0 AND NVL(UC2.COD_CANAL, 0) > 0 THEN UC2.COD_CANAL





   ELSE '3' --'SUCURSAL'
     END AS CODCANAL ,
CASE WHEN MCD.NRO_CAJA > 0 THEN 'S' -- 'S'
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') <> ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') = ' ' THEN UC1.CANAL_PRESENCIAL
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') = ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') <> ' ' THEN UC2.CANAL_PRESENCIAL





   ELSE 'S' END AS ESCANALPRESENCIAL,
--fin case agregado 20250428
-------------------------------------------------------- hasta aqui estructura vigia
   'CDA' AS MARCA,   NULL AS CLAVE,
   MCD.COD_TRA_PADRE AS TR_PADRE,
   MCD.COD_TRANSACCION AS TR_HIJO,
   MCD.NRO_SECUENCIA AS SECUENCIA,   NULL AS COD_PERSONA,  NULL AS MOV_TP,   NULL AS MOV_TH, NULL AS ESTADO
-------------------------------------------------------- CDA
FROM AH_MOVIMIENTOS_HIS  MCD
LEFT JOIN GE_CTA_CLIENTES CL ON MCD.NRO_CUENTA = CL.NRO_CUENTA AND CL.RELACION = 'P'
LEFT JOIN BA_PERSONAS PE ON PE.COD_PERSONA = CL.COD_PERSONA
JOIN AH_CTA_CERTIFICADOS CD ON CD.NRO_CUENTA = CL.NRO_CUENTA
JOIN BA_USUARIOS US ON US.COD_USUARIO = MCD.COD_USUARIO
JOIN BA_MODULOS MP ON MP.COD_MODULO = MCD.COD_MODULO
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA
JOIN GE_TRANSACCIONES TP ON TP.COD_TRANSACCION = MCD.COD_TRA_PADRE AND TP.COD_MODULO = MCD.COD_MOD_PADRE AND TP.COD_MODALIDAD = MCD.COD_MAD_PADRE AND TP.TIPO <> 'E'
JOIN GE_TRANSACCIONES TH ON TH.COD_TRANSACCION = MCD.COD_TRANSACCION AND TH.COD_MODULO = MCD.COD_MODULO AND TH.COD_MODALIDAD = MCD.COD_MODALIDAD AND TH.TIPO <> 'E'
--inicio join agregado
LEFT JOIN BA_USU_CAN_VIGIA UC1 ON UC1.COD_USUARIO = MCD.COD_USUARIO
LEFT JOIN BA_USU_CAN_VIGIA UC2 ON UC2.USU_ID_INS = MCD.USU_INSERCION
--fin join agregado
WHERE MCD.REVERSADO = 'N' AND MCD.COD_MODULO = 3 AND MCD.COD_MODALIDAD = 33
AND MCD.FECHA = (SELECT AVIGIA_FECHA_ACTUAL FROM Parametros)
AND NVL(CL.COD_PERSONA,0) NOT IN (SELECT AVIGIA_COD_PERSONA_EXC FROM COD_PERSONA_EXC)
--AND MCD.COD_TRA_PADRE NOT IN (301,357,100)
AND MCD.COD_TRA_PADRE NOT IN (SELECT AVIGIA_MOVHIS_MCD_TRAPP_CDAEX FROM MOVHIS_MCD_TRAPP_CDAEX)
--AND CD.ESTADO NOT IN ('C','T','X') -- Cesar Candia

UNION ALL ---------------------------------------- CAMBIOS
SELECT
NULL AS BENEFICIARIO_DENOMINACION,
NULL AS BENEFICIARIO_ID_CASO,
NULL AS BENEFICIARIO_NRO_DOC,
NULL AS BENEFICIARIO_TIPO_DOC,
NULL AS BENEFICIARIO_TIPO_PERSONA,
CASE WHEN MLC.NRO_CAJA IS NULL THEN MLC.COD_USUARIO ELSE MLC.NRO_CAJA||'-'||MLC.COD_USUARIO END AS CAJERO,
NULL AS COD_PAIS_OTRA_CUENTA,
CASE WHEN MLC.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(P.COD_PAIS) FROM BA_PERSONAS P
      JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = P.COD_PERSONA AND C.RELACION = 'P'
      AND C.NRO_CUENTA = (SELECT MAX (NRO_CUENTA) FROM LC_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MLC.NRO_DOCUMENTO
                  AND FECHA = MLC.FECHA AND HORA = MLC.HORA AND COD_USUARIO= MLC.COD_USUARIO)
  ) ELSE TO_CHAR(PE.COD_PAIS) END AS COD_PAIS_CTA_CLIENTE,
MLC.COD_MOD_PADRE||MLC.COD_TRA_PADRE||MLC.COD_MODULO||MLC.COD_TRANSACCION AS COD_TRX_INTERNO,
MLC.COD_MOD_PADRE||MLC.COD_TRA_PADRE||MLC.COD_MODULO||MLC.COD_TRANSACCION AS COD_TRX,
MLC.COD_MONEDA AS COD_MONEDA,
NULL AS COD_OTRA_SUCURSAL_INVOLUCRADA,
CASE WHEN MLC.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(G.COD_OFICINA)
FROM GE_CLIENTES G
  JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = G.COD_PERSONA AND C.RELACION = 'P'
  AND C.NRO_CUENTA =  (SELECT MAX (NRO_CUENTA)
              FROM LC_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MLC.NRO_DOCUMENTO
              AND FECHA = MLC.FECHA AND HORA = MLC.HORA AND COD_USUARIO= MLC.COD_USUARIO)
  ) ELSE TO_CHAR(GE.COD_OFICINA) END AS COD_SUCURSAL_CLIENTE,
NULL AS OTRA_CUENTA,
CASE WHEN MLC.NRO_CUENTA IS NULL THEN
      CASE WHEN (SELECT MAX(NRO_CUENTA) FROM LC_MOVIMIENTOS_HIS   WHERE NRO_DOCUMENTO = MLC.NRO_DOCUMENTO
            AND FECHA = MLC.FECHA AND HORA = MLC.HORA AND COD_USUARIO= MLC.COD_USUARIO AND COD_TRA_PADRE = MLC.COD_TRA_PADRE
            ) IS NULL
         THEN (SELECT MAX(NRO_CUENTA) FROM LC_MOVIMIENTOS_HIS   WHERE FECHA = MLC.FECHA
            AND HORA = MLC.HORA AND COD_USUARIO= MLC.COD_USUARIO AND COD_TRA_PADRE = MLC.COD_TRA_PADRE
            ) ELSE (SELECT MAX(NRO_CUENTA) FROM  LC_MOVIMIENTOS_HIS  WHERE NRO_DOCUMENTO = MLC.NRO_DOCUMENTO
                  AND FECHA = MLC.FECHA AND HORA = MLC.HORA AND COD_USUARIO= MLC.COD_USUARIO AND COD_TRA_PADRE = MLC.COD_TRA_PADRE
                  ) END
  ELSE MLC.NRO_CUENTA END AS CUENTA_CLIENTE,
NULL AS CUOTAS_CANCELADAS,
NULL AS DEDUCCIONES,
TO_CHAR(MLC.FEC_VALOR,'yyyy-mm-dd') AS FECHA_DE_OPERACION,
TO_CHAR(MLC.FECHA,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
CASE WHEN TP.DESCRIPCION LIKE '%EFEC%' THEN '1'
  ELSE (CASE WHEN (SELECT count(*) FROM LC_MOVIMIENTOS_HIS gm
    JOIN GE_TRANSACCIONES TH1 ON TH1.COD_TRANSACCION = gm.COD_TRANSACCION AND TH1.COD_MODULO = gm.COD_MODULO
    AND TH1.COD_MODALIDAD = gm.COD_MODALIDAD AND TH1.TIPO <> 'E'
    WHERE gm.FECHA = MLC.FECHA AND gm.HORA = MLC.HORA AND gm.COD_USUARIO = MLC.COD_USUARIO AND gm.COD_TRA_PADRE = MLC.COD_TRA_PADRE
    AND TH1.DESCRIPCION LIKE '%EFEC%') > 0 THEN '1'
    ELSE '0' END) END AS FORMA_DE_PAGO,
NULL AS GESTOR_DENOMINACION,
NULL AS GESTOR_NRO_DOC,
NULL AS GESTOR_TIPO_DOC,
MLC.HORA AS HORA_OPERACION,
NULL AS NRO_CLIENTE,
CASE WHEN MLC.NRO_CUENTA IS NULL THEN (SELECT MAX (MLC.COD_MODULO||MLC.COD_MODALIDAD)
              FROM LC_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MLC.NRO_DOCUMENTO
              AND FECHA = MLC.FECHA AND HORA = MLC.HORA AND COD_USUARIO= MLC.COD_USUARIO
  ) ELSE CL.COD_MODULO||CL.COD_MODALIDAD END AS MARCA_PRODUCTO,
CASE WHEN MLC.COD_MONEDA = 'GS' THEN NVL(ROUND((NVL(MLC.MONTO,0)/(fug_obt_cotizacion('USD',MLC.FECHA))),2),0)
             ELSE nvl(MLC.MONTO, 0) END AS MONTO_DE_TRX, -- usd moneda en la que trabaja Vigia
MLC.MONTO AS OTRO_MONTO_INFORMADO,
MLC.NRO_DOCUMENTO AS NRO_OPERACION_o_COMPROBANTE,
TO_CHAR(MLC.FECHA,'yyyymmdd')||'-'||MLC.HORA||'-'||MLC.COD_USUARIO||'-'||MLC.NRO_SECUENCIA||'-'||MLC.COD_TRA_PADRE||'-'||MLC.COD_TRANSACCION AS NRO_TRANSACCION, --- CLAVE UNICA NO SE DEBE REPETIR
NULL AS NROTARJETA,
NULL AS ORDENANTE_DENOMINACION,
NULL AS ORDENANTE_ID_CASO,
NULL ORDENANTE_NRO_DOC,
NULL AS ORDENANTE_TIPO_PERSONA,
NULL AS ORDENANTE_TIPO_DOC,
NULL AS ORIGEN_FONDOS,
NULL AS TIPO_AUTORIZADOR,
NULL AS TIPO_MODALIDAD_AUTORIZADOR,
CASE WHEN MLC.COD_MONEDA = 'GS' THEN (fug_obt_cotizacion('USD',MLC.FECHA)) ELSE NULL END AS TIPO_DE_CAMBIO,
--inicio case agregado 20250428
CASE WHEN MLC.NRO_CAJA > 0 THEN '3' -- 'SUCURSAL'
WHEN NVL(UC1.COD_CANAL, 0) > 0 AND NVL(UC2.COD_CANAL, 0) = 0 THEN UC1.COD_CANAL
WHEN NVL(UC1.COD_CANAL, 0) = 0 AND NVL(UC2.COD_CANAL, 0) > 0 THEN UC2.COD_CANAL





   ELSE '3' --'SUCURSAL'
     END AS CODCANAL,
CASE WHEN MLC.NRO_CAJA > 0 THEN 'S'
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') <> ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') = ' ' THEN UC1.CANAL_PRESENCIAL
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') = ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') <> ' ' THEN UC2.CANAL_PRESENCIAL





   ELSE 'S' END AS ESCANALPRESENCIAL,
--fin case agregado 20250428
-------------------------------------------------------- hasta aqui estructura vigia
'CAMBIOS' AS CANAL, NULL AS CLAVE,
MLC.COD_TRA_PADRE AS TR_PADRE,
MLC.COD_TRANSACCION AS TR_HIJO,
MLC.NRO_SECUENCIA AS SECUENCIA, NULL AS COD_PERSONA, NULL AS MOV_TP, NULL AS MOV_TH, NULL AS ESTADO
-------------------------------------------------------- CAMBIOS
FROM LC_MOVIMIENTOS_HIS  MLC
LEFT JOIN LC_CTA_CAMBIOS CA ON CA.NRO_CUENTA = NVL(MLC.NRO_CUENTA,0)
LEFT JOIN GE_CTA_CLIENTES CL ON CL.NRO_CUENTA = NVL(MLC.NRO_CUENTA,0) AND CL.RELACION = 'P'
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = NVL(CL.COD_PERSONA,0)
LEFT JOIN BA_PERSONAS PE ON PE.COD_PERSONA = GE.COD_PERSONA
LEFT JOIN BA_USUARIOS US ON US.COD_USUARIO = MLC.COD_USUARIO
LEFT JOIN BA_MODULOS MP ON MP.COD_MODULO = MLC.COD_MODULO
LEFT JOIN BA_USU_CAN_VIGIA UC1 ON UC1.COD_USUARIO = MLC.COD_USUARIO
LEFT JOIN BA_USU_CAN_VIGIA UC2 ON UC2.USU_ID_INS = MLC.USU_INSERCION
JOIN GE_TRANSACCIONES TP ON TP.COD_TRANSACCION = MLC.COD_TRA_PADRE AND TP.COD_MODULO = MLC.COD_MOD_PADRE AND TP.COD_MODALIDAD = MLC.COD_MAD_PADRE --AND TP.TIPO <> 'E'
JOIN GE_TRANSACCIONES TH ON TH.COD_TRANSACCION = MLC.COD_TRANSACCION AND TH.COD_MODULO = MLC.COD_MODULO AND TH.COD_MODALIDAD = MLC.COD_MODALIDAD AND TH.TIPO <> 'E'
WHERE MLC.REVERSADO = 'N'
AND MLC.FECHA = (SELECT AVIGIA_FECHA_ACTUAL FROM Parametros)
AND NVL(GE.COD_PERSONA,0) NOT IN (SELECT AVIGIA_COD_PERSONA_EXC FROM COD_PERSONA_EXC)
AND MLC.MONTO > 0
--AND MLC.COD_TRA_PADRE NOT IN (110,901,942)
AND MLC.COD_TRA_PADRE NOT IN (SELECT AVIGIA_MOVHIS_MLC_TRAPP_CAMEXC FROM MOVHIS_MLC_TRAPP_CAMEXC)
AND MLC.COD_MONEDA IN ('GS','USD')
--AND MLC.NRO_CUENTA NOT IN (6170000071,6170000129,61170000016,6170000028)
AND MLC.NRO_CUENTA NOT IN (SELECT AVIGIA_MOVHIS_MLC_CTAS_EXC  FROM MOVHIS_MLC_CTAS_EXC)

UNION ALL -------------------------------------------------------- AHORROS I
SELECT
CASE WHEN (TR.cod_swi_pte_solicitante <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) OR TR.NRO_DOC_BENEFICIARIO IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)) THEN NULL
    ELSE substr(TR.NOM_BENEFICIARIO,1,100) END AS BENEFICIARIO_DENOMINACION,
CASE WHEN TR.cod_swi_pte_solicitante <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
     WHEN (TR.cod_swi_pte_solicitante = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_BENEFICIARIO IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)) THEN PE.COD_PERSONA
    ELSE NULL END AS BENEFICIARIO_ID_CASO,
CASE WHEN TR.cod_swi_pte_solicitante <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_solicitante = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_BENEFICIARIO IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)) THEN NULL
    ELSE TR.NRO_DOC_BENEFICIARIO END AS BENEFICIARIO_NRO_DOC,
CASE WHEN TR.cod_swi_pte_solicitante <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_solicitante = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_BENEFICIARIO IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)) THEN NULL
    ELSE TO_CHAR(TR.COD_TIP_DOC_BENEFICIARIO) END AS BENEFICIARIO_TIPO_DOC,
DECODE (NVL(TR.NRO_REFERENCIA,0),0,NULL,CASE WHEN TR.cod_swi_pte_solicitante <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_solicitante = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_BENEFICIARIO IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)) THEN NULL
   WHEN TR.NRO_DOC_BENEFICIARIO NOT IN (SELECT BB.NRO_DOCUMENTO FROM BA_PERSONAS BB WHERE BB.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BB.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)
    AND TR.COD_TIP_DOC_BENEFICIARIO = 6 THEN 'J' ELSE 'F' END) AS BENEFICIARIO_TIPO_PERSONA,
CASE WHEN MAH.NRO_CAJA IS NULL THEN MAH.COD_USUARIO ELSE MAH.NRO_CAJA||'-'||MAH.COD_USUARIO END AS CAJERO,
NULL AS COD_PAIS_OTRA_CUENTA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(P.COD_PAIS) FROM BA_PERSONAS P
      JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = P.COD_PERSONA AND C.RELACION = 'P'
      AND C.NRO_CUENTA = (SELECT MAX (NRO_CUENTA) FROM AH_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
                  AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO)
  ) ELSE TO_CHAR(PE.COD_PAIS) END AS COD_PAIS_CTA_CLIENTE,

CASE 
    WHEN MAH.COD_TRA_PADRE IN (388, 309, 255, 265) THEN
        CASE WHEN MAH.COD_TRANSACCION = 503 THEN 
                CASE WHEN CL.COD_PERSONA = (
                        SELECT max(CTA.COD_PERSONA) 
                        FROM AH_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA ON CTA.NRO_CUENTA = GV.NRO_CUENTA  AND RELACION = 'P'
                        WHERE GV.FECHA           = MAH.FECHA  
                          AND GV.HORA            = MAH.HORA 
                          AND GV.COD_USUARIO     = MAH.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 602 
                    )
                    THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
                    WHEN CL.COD_PERSONA = (
                        SELECT max(CTA.COD_PERSONA) 
                        FROM CC_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA ON CTA.NRO_CUENTA = GV.NRO_CUENTA  AND RELACION = 'P'
                        WHERE GV.FECHA           = MAH.FECHA  
                          AND GV.HORA            = MAH.HORA 
                          AND GV.COD_USUARIO     = MAH.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 602 
                    )
                    THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
                    ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION 
                END
                WHEN MAH.COD_TRANSACCION = 602 THEN 
                CASE WHEN CL.COD_PERSONA = (
                        SELECT max(CTA.COD_PERSONA) 
                        FROM AH_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA ON CTA.NRO_CUENTA = GV.NRO_CUENTA  AND CTA.RELACION = 'P'
                        WHERE GV.FECHA           = MAH.FECHA  
                          AND GV.HORA            = MAH.HORA 
                          AND GV.COD_USUARIO     = MAH.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 503
                    )
                    THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
                    WHEN CL.COD_PERSONA = (
                        SELECT max (CTA.COD_PERSONA) 
                        FROM CC_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA ON CTA.NRO_CUENTA = GV.NRO_CUENTA  AND CTA.RELACION = 'P'
                        WHERE GV.FECHA           = MAH.FECHA  
                          AND GV.HORA            = MAH.HORA 
                          AND GV.COD_USUARIO     = MAH.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 503
                    )
                    THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
                     ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION 
                END
            ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION 
        END
    ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
END AS COD_TRX_INTERNO,

CASE 
    WHEN MAH.COD_TRA_PADRE IN (388, 309, 255, 265) THEN
        CASE WHEN MAH.COD_TRANSACCION = 503 THEN 
                CASE WHEN CL.COD_PERSONA = (
                        SELECT max(CTA.COD_PERSONA) 
                        FROM AH_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA ON CTA.NRO_CUENTA = GV.NRO_CUENTA  AND RELACION = 'P'
                        WHERE GV.FECHA           = MAH.FECHA  
                          AND GV.HORA            = MAH.HORA 
                          AND GV.COD_USUARIO     = MAH.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 602 
                    )
                    THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
                    WHEN CL.COD_PERSONA = (
                        SELECT max(CTA.COD_PERSONA) 
                        FROM CC_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA ON CTA.NRO_CUENTA = GV.NRO_CUENTA  AND RELACION = 'P'
                        WHERE GV.FECHA           = MAH.FECHA  
                          AND GV.HORA            = MAH.HORA 
                          AND GV.COD_USUARIO     = MAH.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 602 
                    )
                    THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
                    ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION 
                END
            WHEN MAH.COD_TRANSACCION = 602 THEN 
                CASE WHEN CL.COD_PERSONA = (
                        SELECT max(CTA.COD_PERSONA) 
                        FROM AH_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA ON CTA.NRO_CUENTA = GV.NRO_CUENTA  AND CTA.RELACION = 'P'
                        WHERE GV.FECHA           = MAH.FECHA  
                          AND GV.HORA            = MAH.HORA 
                          AND GV.COD_USUARIO     = MAH.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 503
                    )
                    THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
                    WHEN CL.COD_PERSONA = (
                        SELECT max (CTA.COD_PERSONA) 
                        FROM CC_MOVIMIENTOS_HIS GV
                        INNER JOIN GE_CTA_CLIENTES CTA ON CTA.NRO_CUENTA = GV.NRO_CUENTA  AND CTA.RELACION = 'P'
                        WHERE GV.FECHA           = MAH.FECHA  
                          AND GV.HORA            = MAH.HORA 
                          AND GV.COD_USUARIO     = MAH.COD_USUARIO
                          AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
                          AND GV.COD_TRANSACCION = 503
                    )
                    THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
                     ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION 
                END
            ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION 
        END
    ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
END AS COD_TRX,

MAH.COD_MONEDA AS COD_MONEDA,
NULL AS COD_OTRA_SUCURSAL_INVOLUCRADA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(G.COD_OFICINA)
  FROM GE_CLIENTES G
  JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = G.COD_PERSONA AND C.RELACION = 'P'
  AND C.NRO_CUENTA =  (SELECT MAX (NRO_CUENTA)
              FROM AH_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
              AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO)
  ) ELSE TO_CHAR(GE.COD_OFICINA) END AS COD_SUCURSAL_CLIENTE,
NULL AS OTRA_CUENTA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN
      CASE WHEN (SELECT MAX(NRO_CUENTA) FROM AH_MOVIMIENTOS_HIS   WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
            AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
            ) IS NULL
         THEN (SELECT MAX(NRO_CUENTA) FROM AH_MOVIMIENTOS_HIS   WHERE FECHA = MAH.FECHA
            AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
            ) ELSE (SELECT MAX(NRO_CUENTA) FROM  AH_MOVIMIENTOS_HIS  WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
                  AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
                  ) END
  ELSE MAH.NRO_CUENTA END AS CUENTA_CLIENTE,
NULL AS CUOTAS_CANCELADAS,
NULL AS DEDUCCIONES,
TO_CHAR(MAH.FEC_VALOR,'yyyy-mm-dd') AS FECHA_DE_OPERACION,
TO_CHAR(MAH.FECHA,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
CASE WHEN TP.DESCRIPCION LIKE '%EFEC%' THEN '1'
  ELSE (CASE WHEN (SELECT count(*) FROM AH_MOVIMIENTOS_HIS gm
    JOIN GE_TRANSACCIONES TH1 ON TH1.COD_TRANSACCION = gm.COD_TRANSACCION AND TH1.COD_MODULO = gm.COD_MODULO
    AND TH1.COD_MODALIDAD = gm.COD_MODALIDAD AND TH1.TIPO <> 'E'
    WHERE gm.FECHA = MAH.FECHA AND gm.HORA = MAH.HORA AND gm.COD_USUARIO = MAH.COD_USUARIO AND gm.COD_TRA_PADRE = MAH.COD_TRA_PADRE
    AND TH1.DESCRIPCION LIKE '%EFEC%') > 0 THEN '1'
    ELSE '0' END) END AS FORMA_DE_PAGO,
NULL AS GESTOR_DENOMINACION,
NULL AS GESTOR_NRO_DOC,
NULL AS GESTOR_TIPO_DOC,
MAH.HORA AS HORA_OPERACION,
NULL AS NRO_CLIENTE,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT MAX (MAH.COD_MODULO||MAH.COD_MODALIDAD)
              FROM AH_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
              AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO
  ) ELSE CL.COD_MODULO||CL.COD_MODALIDAD END AS MARCA_PRODUCTO,
CASE WHEN MAH.COD_MONEDA = 'GS' THEN NVL(ROUND((NVL(MAH.MONTO,0)/(fug_obt_cotizacion('USD',MAH.FECHA))),2),0)
             ELSE nvl(MAH.MONTO, 0) END AS MONTO_DE_TRX, -- usd moneda en la que trabaja Vigia
MAH.MONTO AS OTRO_MONTO_INFORMADO,
MAH.NRO_DOCUMENTO AS NRO_OPERACION_o_COMPROBANTE,
TO_CHAR(MAH.FECHA,'yyyymmdd')||'-'||MAH.HORA||'-'||MAH.COD_USUARIO||'-'||MAH.NRO_SECUENCIA||'-'||MAH.COD_TRA_PADRE||'-'||MAH.COD_TRANSACCION AS NRO_TRANSACCION, --- CLAVE UNICA NO SE DEBE REPETIR
NULL AS NROTARJETA,
CASE WHEN TR.cod_swi_pte_beneficiario <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_SOLICITANTE IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE)) THEN NULL
   ELSE substr(TR.NOM_SOLICITANTE,1,100) END AS ORDENANTE_DENOMINACION,
CASE WHEN TR.cod_swi_pte_beneficiario <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) OR TR.NRO_DOC_SOLICITANTE IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE))
   THEN (SELECT BO.COD_PERSONA FROM BA_PERSONAS BO WHERE BO.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BO.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE)
   ELSE NULL END AS ORDENANTE_ID_CASO,
CASE WHEN TR.cod_swi_pte_beneficiario <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_SOLICITANTE IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE)) THEN NULL
   ELSE TR.NRO_DOC_SOLICITANTE END AS ORDENANTE_NRO_DOC,
DECODE (NVL(TR.NRO_REFERENCIA,0),0,NULL,CASE WHEN TR.cod_swi_pte_beneficiario <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_SOLICITANTE IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE)) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_SOLICITANTE NOT IN (SELECT BS.NRO_DOCUMENTO FROM BA_PERSONAS BS WHERE BS.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BS.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE))
    AND TR.COD_TIP_DOC_SOLICITANTE = 6 THEN 'J' ELSE 'F' END) AS ORDENANTE_TIPO_PERSONA,
CASE WHEN TR.cod_swi_pte_beneficiario <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_SOLICITANTE IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE)) THEN NULL
ELSE TO_CHAR(TR.COD_TIP_DOC_SOLICITANTE) END AS ORDENANTE_TIPO_DOC,
NULL AS ORIGEN_FONDOS,
NULL AS TIPO_AUTORIZADOR,
NULL AS TIPO_MODALIDAD_AUTORIZADOR,
CASE WHEN MAH.COD_MONEDA = 'GS' THEN (fug_obt_cotizacion('USD',MAH.FECHA)) ELSE NULL END AS TIPO_DE_CAMBIO,

--inicio case agregado 20250428
CASE WHEN MAH.NRO_CAJA > 0 THEN '3' -- 'SUCURSAL'
WHEN NVL(UC1.COD_CANAL, 0) > 0 AND NVL(UC2.COD_CANAL, 0) = 0 THEN UC1.COD_CANAL
WHEN NVL(UC1.COD_CANAL, 0) = 0 AND NVL(UC2.COD_CANAL, 0) > 0 THEN UC2.COD_CANAL





   ELSE '3' --'SUCURSAL'
     END AS CODCANAL,
CASE WHEN MAH.NRO_CAJA > 0 THEN 'S'
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') <> ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') = ' ' THEN UC1.CANAL_PRESENCIAL
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') = ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') <> ' ' THEN UC2.CANAL_PRESENCIAL





   ELSE 'S' END AS ESCANALPRESENCIAL,
--fin case agregado 20250428

-------------------------------------------------------- hasta aqui estructura vigia
'AHORROS SIN REVERSOS' AS MARCA, NULL AS CLAVE,
MAH.COD_TRA_PADRE AS TR_PADRE,
MAH.COD_TRANSACCION AS TR_HIJO,
MAH.NRO_SECUENCIA AS SECUENCIA, NULL AS COD_PERSONA, NULL AS MOV_TP, NULL AS MOV_TH, NULL AS ESTADO
-------------------------------------------------------- AHORROS I
FROM AH_MOVIMIENTOS_HIS MAH
LEFT JOIN GE_CTA_CLIENTES CL ON MAH.NRO_CUENTA = CL.NRO_CUENTA AND CL.RELACION = 'P'
LEFT JOIN BA_PERSONAS PE ON PE.COD_PERSONA = CL.COD_PERSONA
JOIN AH_CTA_VISTAS CD ON CD.NRO_CUENTA = MAH.NRO_CUENTA

LEFT JOIN GE_SNP_TRANSFERENCIAS TR ON TR.NRO_REFERENCIA = MAH.NRO_DOCUMENTO
JOIN BA_USUARIOS US ON US.COD_USUARIO = MAH.COD_USUARIO
JOIN BA_MODULOS MP ON MP.COD_MODULO = MAH.COD_MODULO
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA
JOIN GE_TRANSACCIONES TP ON TP.COD_TRANSACCION = MAH.COD_TRA_PADRE AND TP.COD_MODULO = MAH.COD_MOD_PADRE AND TP.COD_MODALIDAD = MAH.COD_MAD_PADRE AND TP.TIPO <> 'E'
JOIN GE_TRANSACCIONES TH ON TH.COD_TRANSACCION = MAH.COD_TRANSACCION AND TH.COD_MODULO = MAH.COD_MODULO AND TH.COD_MODALIDAD = MAH.COD_MODALIDAD AND TH.TIPO <> 'E'
--inicio join agregado
LEFT JOIN BA_USU_CAN_VIGIA UC1 ON UC1.COD_USUARIO = MAH.COD_USUARIO
LEFT JOIN BA_USU_CAN_VIGIA UC2 ON UC2.USU_ID_INS = MAH.USU_INSERCION
--fin join agregado
WHERE MAH.REVERSADO = 'N' AND MAH.COD_MODULO = 3 AND MAH.COD_MODALIDAD <> 33
--AND CD.ESTADO NOT IN ('C','X')
AND MAH.FECHA = (SELECT AVIGIA_FECHA_ACTUAL FROM Parametros)
AND NVL(CL.COD_PERSONA,0) NOT IN (SELECT AVIGIA_COD_PERSONA_EXC FROM COD_PERSONA_EXC)
AND MAH.COD_TRA_PADRE NOT IN (SELECT AVIGIA_MOVHIS_MAH_TRAPP_AHOEXC FROM MOVHIS_MAH_TRAPP_AHOEXC) 
--AND MAH.COD_TRA_PADRE NOT IN (380,382,385,389,390,482,393,597,517)  /*380 COMPRA EN NEGOCIOS (POS) ; 382  EXTRACCION EFECTIVO (ATM) ; 385 TRANSFERENCIA ATM
--                                  389 CONSULTA DE SALDOS (ATM) ; 390  CONSULTA DE EXTRACTOS (ATM) ; 393 DEPOSITO EFECTIVO EN AUTOSERVICIOS
--                                  482 EXTRACCION EFECTIVO - RECICLADOR ; 517  IVA S/COMISIONES COBRADAS ; 597 CARGO S/ DEPOSITOS EN M/E*/
AND MAH.MONTO > 0

UNION ALL -----  AHORROS CON REVERSOS IMPORTE NEGATIVO
select
BENEFICIARIO_DENOMINACION,
BENEFICIARIO_ID_CASO,
BENEFICIARIO_NRO_DOC,
BENEFICIARIO_TIPO_DOC,
BENEFICIARIO_TIPO_PERSONA,
CAJERO,
COD_PAIS_OTRA_CUENTA,
COD_PAIS_CTA_CLIENTE,
COD_TRX_INTERNO,
COD_TRX,
COD_MONEDA,
COD_OTRA_SUCURSAL_INVOLUCRADA,
COD_SUCURSAL_CLIENTE,
OTRA_CUENTA,
CUENTA_CLIENTE,
CUOTAS_CANCELADAS,
DEDUCCIONES,
FECHA_DE_OPERACION,
FECHA_DE_PROCESO,
FORMA_DE_PAGO,
GESTOR_DENOMINACION,
GESTOR_NRO_DOC,
GESTOR_TIPO_DOC,
HORA_OPERACION,
NRO_CLIENTE,
MARCA_PRODUCTO,
MONTO_DE_TRX,
OTRO_MONTO_INFORMADO,
NRO_OPERACION_O_COMPROBANTE,
NRO_TRANSACCION,
NROTARJETA,
ORDENANTE_DENOMINACION,
ORDENANTE_ID_CASO,
ORDENANTE_NRO_DOC,
ORDENANTE_TIPO_PERSONA,
ORDENANTE_TIPO_DOC,
ORIGEN_FONDOS,
TIPO_AUTORIZADOR,
TIPO_MODALIDAD_AUTORIZADOR,
TIPO_DE_CAMBIO,
CODCANAL,
ESCANALPRESENCIAL,
-------------------------------------------------------- hasta aqui estructura vigia
'AHORROS CON REVERSOS' AS MARCA,NULL AS CLAVE,
TR_PADRE,
TR_HIJO,
SECUENCIA,NULL AS COD_PERSONA, NULL AS MOV_TP,NULL AS MOV_TH,NULL AS ESTADO
 FROM (
SELECT
NULL AS BENEFICIARIO_DENOMINACION,
NULL AS BENEFICIARIO_ID_CASO,
NULL AS BENEFICIARIO_NRO_DOC,
NULL AS BENEFICIARIO_TIPO_DOC,
NULL AS BENEFICIARIO_TIPO_PERSONA,
CASE WHEN MAH.NRO_CAJA IS NULL THEN MAH.COD_USUARIO ELSE MAH.NRO_CAJA||'-'||MAH.COD_USUARIO END AS CAJERO,
NULL AS COD_PAIS_OTRA_CUENTA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(P.COD_PAIS) FROM BA_PERSONAS P
      JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = P.COD_PERSONA AND C.RELACION = 'P'
      AND C.NRO_CUENTA = (SELECT MAX (NRO_CUENTA) FROM AH_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
                  AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO)
  ) ELSE TO_CHAR(PE.COD_PAIS) END AS COD_PAIS_CTA_CLIENTE,
MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION AS COD_TRX_INTERNO,
MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION AS COD_TRX,
MAH.COD_MONEDA AS COD_MONEDA,
NULL AS COD_OTRA_SUCURSAL_INVOLUCRADA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(G.COD_OFICINA)
  FROM GE_CLIENTES G
  JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = G.COD_PERSONA AND C.RELACION = 'P'
  AND C.NRO_CUENTA =  (SELECT MAX (NRO_CUENTA)
              FROM AH_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
              AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO)
  ) ELSE TO_CHAR(GE.COD_OFICINA) END AS COD_SUCURSAL_CLIENTE,
NULL AS OTRA_CUENTA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN
      CASE WHEN (SELECT MAX(NRO_CUENTA) FROM AH_MOVIMIENTOS_HIS   WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
            AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
            ) IS NULL
         THEN (SELECT MAX(NRO_CUENTA) FROM AH_MOVIMIENTOS_HIS   WHERE FECHA = MAH.FECHA
            AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
            ) ELSE (SELECT MAX(NRO_CUENTA) FROM  AH_MOVIMIENTOS_HIS  WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
                  AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
                  ) END
  ELSE MAH.NRO_CUENTA END AS CUENTA_CLIENTE,
NULL AS CUOTAS_CANCELADAS,
NULL AS DEDUCCIONES,
TO_CHAR(MAH.FEC_VALOR,'yyyy-mm-dd') AS FECHA_DE_OPERACION,
TO_CHAR(MAH.FECHA,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
CASE WHEN TP.DESCRIPCION LIKE '%EFEC%' THEN '1'
  ELSE (CASE WHEN (SELECT count(*) FROM AH_MOVIMIENTOS_HIS gm
    JOIN GE_TRANSACCIONES TH1 ON TH1.COD_TRANSACCION = gm.COD_TRANSACCION AND TH1.COD_MODULO = gm.COD_MODULO
    AND TH1.COD_MODALIDAD = gm.COD_MODALIDAD AND TH1.TIPO <> 'E'
    WHERE gm.FECHA = MAH.FECHA AND gm.HORA = MAH.HORA AND gm.COD_USUARIO = MAH.COD_USUARIO AND gm.COD_TRA_PADRE = MAH.COD_TRA_PADRE
    AND TH1.DESCRIPCION LIKE '%EFEC%') > 0 THEN '1'
    ELSE '0' END) END AS FORMA_DE_PAGO,
NULL AS GESTOR_DENOMINACION,
NULL AS GESTOR_NRO_DOC,
NULL AS GESTOR_TIPO_DOC,
MAH.HORA AS HORA_OPERACION,
NULL AS NRO_CLIENTE,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT MAX (MAH.COD_MODULO||MAH.COD_MODALIDAD)
              FROM AH_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
              AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO
  ) ELSE CL.COD_MODULO||CL.COD_MODALIDAD END AS MARCA_PRODUCTO,
CASE WHEN MAH.COD_MONEDA = 'GS' THEN NVL(ROUND((NVL(MAH.MONTO,0)/(fug_obt_cotizacion('USD',MAH.FECHA))),2),0)
             ELSE nvl(MAH.MONTO, 0) END AS MONTO_DE_TRX, -- usd moneda en la que trabaja Vigia
MAH.MONTO AS OTRO_MONTO_INFORMADO,
MAH.NRO_DOCUMENTO AS NRO_OPERACION_o_COMPROBANTE,
TO_CHAR(MAH.FECHA,'yyyymmdd')||'-'||MAH.HORA||'-'||MAH.COD_USUARIO||'-'||MAH.NRO_SECUENCIA||'-'||MAH.COD_TRA_PADRE||'-'||MAH.COD_TRANSACCION AS NRO_TRANSACCION, --- CLAVE UNICA NO SE DEBE REPETIR
NULL AS NROTARJETA,
NULL AS ORDENANTE_DENOMINACION,
NULL AS ORDENANTE_ID_CASO,
NULL ORDENANTE_NRO_DOC,
NULL AS ORDENANTE_TIPO_PERSONA,
NULL AS ORDENANTE_TIPO_DOC,
NULL AS ORIGEN_FONDOS,
NULL AS TIPO_AUTORIZADOR,
NULL AS TIPO_MODALIDAD_AUTORIZADOR,
CASE WHEN MAH.COD_MONEDA = 'GS' THEN (fug_obt_cotizacion('USD',MAH.FECHA)) ELSE NULL END AS TIPO_DE_CAMBIO,

--inicio case agregado 20250428
CASE WHEN MAH.NRO_CAJA > 0 THEN '3' -- 'SUCURSAL'
WHEN NVL(UC1.COD_CANAL, 0) > 0 AND NVL(UC2.COD_CANAL, 0) = 0 THEN UC1.COD_CANAL
WHEN NVL(UC1.COD_CANAL, 0) = 0 AND NVL(UC2.COD_CANAL, 0) > 0 THEN UC2.COD_CANAL





ELSE '3' --'SUCURSAL'
END AS CODCANAL,
CASE WHEN MAH.NRO_CAJA > 0 THEN 'S'
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') <> ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') = ' ' THEN UC1.CANAL_PRESENCIAL
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') = ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') <> ' ' THEN UC2.CANAL_PRESENCIAL





   ELSE 'S' END AS ESCANALPRESENCIAL,
--fin case agregado 20250428


-------------------------------------------------------- hasta aqui estructura vigia
MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION||MAH.NRO_CUENTA||MAH.NRO_DOCUMENTO AS CLAVE,
MAH.COD_TRA_PADRE AS TR_PADRE,
MAH.COD_TRANSACCION AS TR_HIJO,
MAH.NRO_SECUENCIA AS SECUENCIA, NULL AS COD_PERSONA, NULL AS MOV_TP, NULL AS MOV_TH , NULL AS ESTADO
-------------------------------------------------------- AHORROS II
FROM AH_MOVIMIENTOS_HIS  MAH
LEFT JOIN GE_CTA_CLIENTES CL ON MAH.NRO_CUENTA = CL.NRO_CUENTA AND CL.RELACION = 'P'
LEFT JOIN BA_PERSONAS PE ON PE.COD_PERSONA = CL.COD_PERSONA
JOIN AH_CTA_VISTAS CD ON CD.NRO_CUENTA = mah.NRO_CUENTA
JOIN BA_USUARIOS US ON US.COD_USUARIO = MAH.COD_USUARIO
JOIN BA_MODULOS MP ON MP.COD_MODULO = MAH.COD_MODULO
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA
JOIN GE_TRANSACCIONES TP ON TP.COD_TRANSACCION = MAH.COD_TRA_PADRE AND TP.COD_MODULO = MAH.COD_MOD_PADRE AND TP.COD_MODALIDAD = MAH.COD_MAD_PADRE AND TP.TIPO <> 'E'
JOIN GE_TRANSACCIONES TH ON TH.COD_TRANSACCION = MAH.COD_TRANSACCION AND TH.COD_MODULO = MAH.COD_MODULO AND TH.COD_MODALIDAD = MAH.COD_MODALIDAD AND TH.TIPO <> 'E'
--inicio join agregado
LEFT JOIN BA_USU_CAN_VIGIA UC1 ON UC1.COD_USUARIO = MAH.COD_USUARIO
LEFT JOIN BA_USU_CAN_VIGIA UC2 ON UC2.USU_ID_INS = MAH.USU_INSERCION
--fin join agregado
WHERE MAH.REVERSADO = 'N' AND MAH.COD_MODULO = 3 AND MAH.COD_MODALIDAD <> 33
--AND CD.ESTADO NOT IN ('C','X')
AND MAH.FECHA = (SELECT AVIGIA_FECHA_ACTUAL FROM Parametros)
AND NVL(CL.COD_PERSONA,0) NOT IN (SELECT AVIGIA_COD_PERSONA_EXC FROM COD_PERSONA_EXC) 
AND MAH.COD_TRA_PADRE IN (SELECT  AVIGIA_MOVHIS_MAH_TRAPP_AHRINC FROM MOVHIS_MAH_TRAPP_AHRINC)
AND MAH.MONTO > 0
--ORDER BY MAH.FECHA, MAH.HORA, MAH.COD_USUARIO, MAH.NRO_SECUENCIA
) PP WHERE PP.CLAVE IN (SELECT (AH.COD_MOD_PADRE||AH.COD_TRA_PADRE||AH.COD_MODULO||AH.COD_TRANSACCION
||AH.NRO_CUENTA||AH.NRO_DOCUMENTO) FROM AH_MOVIMIENTOS_HIS AH  
WHERE AH.REVERSADO = 'N' AND AH.COD_MODULO = 3 AND AH.COD_MODALIDAD <> 33 AND AH.COD_TRA_PADRE IN (SELECT  AVIGIA_MOVHIS_MAH_TRAPP_AHRINC FROM MOVHIS_MAH_TRAPP_AHRINC)
/*380 COMPRA EN NEGOCIOS (POS); 382 EXTRACCION EFECTIVO (ATM); 385 TRANSFERENCIA ATM; 393 DEPOSITO EFECTIVO EN AUTOSERVICIOS
482 EXTRACCION EFECTIVO - RECICLADOR; 517 IVA S/COMISIONES COBRADAS; 597 CARGO S/ DEPOSITOS EN M/E*/
AND AH.FECHA = (SELECT AVIGIA_FECHA_ACTUAL FROM Parametros)
GROUP BY AH.COD_MOD_PADRE||AH.COD_TRA_PADRE||AH.COD_MODULO||AH.COD_TRANSACCION
||AH.NRO_CUENTA||AH.NRO_DOCUMENTO HAVING (COUNT(*)) = 1)


UNION ALL -------------------------------------------------------- cc I
SELECT
CASE WHEN (TR.cod_swi_pte_solicitante <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) OR TR.NRO_DOC_BENEFICIARIO IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)) THEN NULL
    ELSE substr(TR.NOM_BENEFICIARIO,1,100) END AS BENEFICIARIO_DENOMINACION,
CASE WHEN TR.cod_swi_pte_solicitante <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
     WHEN (TR.cod_swi_pte_solicitante = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_BENEFICIARIO IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)) THEN PE.COD_PERSONA
    ELSE NULL END AS BENEFICIARIO_ID_CASO,
CASE WHEN TR.cod_swi_pte_solicitante <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_solicitante = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_BENEFICIARIO IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)) THEN NULL
    ELSE TR.NRO_DOC_BENEFICIARIO END AS BENEFICIARIO_NRO_DOC,
CASE WHEN TR.cod_swi_pte_solicitante <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_solicitante = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_BENEFICIARIO IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)) THEN NULL
    ELSE TO_CHAR(TR.COD_TIP_DOC_BENEFICIARIO) END AS BENEFICIARIO_TIPO_DOC,
DECODE (NVL(TR.NRO_REFERENCIA,0),0,NULL,CASE WHEN TR.cod_swi_pte_solicitante <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_solicitante = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_BENEFICIARIO IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)) THEN NULL
   WHEN TR.NRO_DOC_BENEFICIARIO NOT IN (SELECT BB.NRO_DOCUMENTO FROM BA_PERSONAS BB WHERE BB.NRO_DOCUMENTO = TR.NRO_DOC_BENEFICIARIO AND BB.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_BENEFICIARIO)
    AND TR.COD_TIP_DOC_BENEFICIARIO = 6 THEN 'J' ELSE 'F' END) AS BENEFICIARIO_TIPO_PERSONA,
CASE WHEN MAH.NRO_CAJA IS NULL THEN MAH.COD_USUARIO ELSE MAH.NRO_CAJA||'-'||MAH.COD_USUARIO END AS CAJERO,
NULL AS COD_PAIS_OTRA_CUENTA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(P.COD_PAIS) FROM BA_PERSONAS P
      JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = P.COD_PERSONA AND C.RELACION = 'P'
      AND C.NRO_CUENTA = (SELECT MAX (NRO_CUENTA) FROM cc_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
                  AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO)
  ) ELSE TO_CHAR(PE.COD_PAIS) END AS COD_PAIS_CTA_CLIENTE,
CASE WHEN MAH.COD_TRA_PADRE IN (388,309,255,265) THEN
    CASE WHEN MAH.COD_TRANSACCION = 503 THEN 
    	CASE WHEN CL.COD_PERSONA = (
            SELECT max(CTA.COD_PERSONA) 
            FROM CC_MOVIMIENTOS_HIS GV
            INNER JOIN GE_CTA_CLIENTES CTA 
                   ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
                  AND CTA.RELACION = 'P'
            WHERE GV.FECHA           = MAH.FECHA  
              AND GV.HORA            = MAH.HORA 
              AND GV.COD_USUARIO     = MAH.COD_USUARIO
              AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
              AND GV.COD_TRANSACCION = 602 
        )
        THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
        ELSE 
            CASE WHEN CL.COD_PERSONA = (
              SELECT max(CTA.COD_PERSONA) 
              FROM AH_MOVIMIENTOS_HIS GV
              INNER JOIN GE_CTA_CLIENTES CTA 
                    ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
                    AND CTA.RELACION = 'P'
             WHERE GV.FECHA           = MAH.FECHA  
             AND GV.HORA            = MAH.HORA 
             AND GV.COD_USUARIO     = MAH.COD_USUARIO
             AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
             AND GV.COD_TRANSACCION = 602 
            )
            THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
            ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION 
            END
        END
    WHEN MAH.COD_TRANSACCION = 602 THEN 
    CASE WHEN CL.COD_PERSONA = (
            SELECT max(CTA.COD_PERSONA) 
            FROM CC_MOVIMIENTOS_HIS GV
            INNER JOIN GE_CTA_CLIENTES CTA 
                    ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
                    AND CTA.RELACION = 'P'
            WHERE GV.FECHA           = MAH.FECHA  
              AND GV.HORA            = MAH.HORA 
              AND GV.COD_USUARIO     = MAH.COD_USUARIO
              AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
              AND GV.COD_TRANSACCION = 503
        )
        THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
        ELSE 
        CASE WHEN CL.COD_PERSONA = (
            SELECT max(CTA.COD_PERSONA) 
            FROM AH_MOVIMIENTOS_HIS GV
            INNER JOIN GE_CTA_CLIENTES CTA 
                    ON CTA.NRO_CUENTA = GV.NRO_CUENTA 
                    AND CTA.RELACION = 'P'
            WHERE GV.FECHA           = MAH.FECHA  
              AND GV.HORA            = MAH.HORA 
              AND GV.COD_USUARIO     = MAH.COD_USUARIO
              AND GV.COD_TRA_PADRE   = MAH.COD_TRA_PADRE 
              AND GV.COD_TRANSACCION = 503
             )
         THEN '99' || MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION
         ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION 
         END
    END
  ELSE MAH.COD_MOD_PADRE || MAH.COD_TRA_PADRE || MAH.COD_MODULO || MAH.COD_TRANSACCION 
  END
ELSE MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION
END AS COD_TRX_INTERNO,

CASE WHEN MAH.COD_TRA_PADRE IN (388,309,255,265) THEN
    CASE WHEN MAH.COD_TRANSACCION = 503 THEN CASE WHEN CL.COD_PERSONA = (SELECT max(CTA.COD_PERSONA) FROM cc_MOVIMIENTOS_HIS GV
        INNER JOIN GE_CTA_CLIENTES CTA ON CTA.NRO_CUENTA = GV.NRO_CUENTA  AND RELACION = 'P'
    WHERE GV.FECHA = MAH.FECHA  AND GV.HORA = MAH.HORA AND GV.COD_USUARIO = MAH.COD_USUARIO
    AND GV.COD_TRA_PADRE = MAH.COD_TRA_PADRE AND GV.COD_TRANSACCION = 602 /*AND GV.COD_MODALIDAD <> 33*/) THEN
        '99' || MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION
        ELSE MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION END
    WHEN MAH.COD_TRANSACCION = 602 /*AND MAH.COD_MODALIDAD <> 33*/ THEN CASE WHEN CL.COD_PERSONA = (SELECT max(CTA.COD_PERSONA) FROM cc_MOVIMIENTOS_HIS GV
    INNER JOIN GE_CTA_CLIENTES CTA ON CTA.NRO_CUENTA = GV.NRO_CUENTA  AND RELACION = 'P'
    WHERE GV.FECHA = MAH.FECHA  AND GV.HORA = MAH.HORA AND GV.COD_USUARIO = MAH.COD_USUARIO
    AND GV.COD_TRA_PADRE = MAH.COD_TRA_PADRE AND GV.COD_TRANSACCION = 503) THEN
        '99' || MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION
        ELSE MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION END
        ELSE MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION END
ELSE MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION
END AS COD_TRX,
MAH.COD_MONEDA AS COD_MONEDA,
NULL AS COD_OTRA_SUCURSAL_INVOLUCRADA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(G.COD_OFICINA)
  FROM GE_CLIENTES G
  JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = G.COD_PERSONA AND C.RELACION = 'P'
  AND C.NRO_CUENTA =  (SELECT MAX (NRO_CUENTA)
              FROM cc_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
              AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO)
  ) ELSE TO_CHAR(GE.COD_OFICINA) END AS COD_SUCURSAL_CLIENTE,
NULL AS OTRA_CUENTA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN
      CASE WHEN (SELECT MAX(NRO_CUENTA) FROM cc_MOVIMIENTOS_HIS   WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
            AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
            ) IS NULL
         THEN (SELECT MAX(NRO_CUENTA) FROM cc_MOVIMIENTOS_HIS   WHERE FECHA = MAH.FECHA
            AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
            ) ELSE (SELECT MAX(NRO_CUENTA) FROM  cc_MOVIMIENTOS_HIS  WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
                  AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
                  ) END
  ELSE MAH.NRO_CUENTA END AS CUENTA_CLIENTE,
NULL AS CUOTAS_CANCELADAS,
NULL AS DEDUCCIONES,
TO_CHAR(MAH.FEC_VALOR,'yyyy-mm-dd') AS FECHA_DE_OPERACION,
TO_CHAR(MAH.FECHA,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
--TO_CHAR(pag_cal.fu_obt_fec_actual(1)-5,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
CASE WHEN TP.DESCRIPCION LIKE '%EFEC%' THEN '1'
  ELSE (CASE WHEN (SELECT count(*) FROM cc_MOVIMIENTOS_HIS gm
    JOIN GE_TRANSACCIONES TH1 ON TH1.COD_TRANSACCION = gm.COD_TRANSACCION AND TH1.COD_MODULO = gm.COD_MODULO
    AND TH1.COD_MODALIDAD = gm.COD_MODALIDAD AND TH1.TIPO <> 'E'
    WHERE gm.FECHA = MAH.FECHA AND gm.HORA = MAH.HORA AND gm.COD_USUARIO = MAH.COD_USUARIO AND gm.COD_TRA_PADRE = MAH.COD_TRA_PADRE
    AND TH1.DESCRIPCION LIKE '%EFEC%') > 0 THEN '1'
    ELSE '0' END) END AS FORMA_DE_PAGO,
NULL AS GESTOR_DENOMINACION,
NULL AS GESTOR_NRO_DOC,
NULL AS GESTOR_TIPO_DOC,
MAH.HORA AS HORA_OPERACION,
NULL AS NRO_CLIENTE,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT MAX (MAH.COD_MODULO||MAH.COD_MODALIDAD)
              FROM cc_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
              AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO
  ) ELSE CL.COD_MODULO||CL.COD_MODALIDAD END AS MARCA_PRODUCTO,
CASE WHEN MAH.COD_MONEDA = 'GS' THEN NVL(ROUND((NVL(MAH.MONTO,0)/(fug_obt_cotizacion('USD',MAH.FECHA))),2),0)
             ELSE nvl(MAH.MONTO, 0) END AS MONTO_DE_TRX, -- usd moneda en la que trabaja Vigia
MAH.MONTO AS OTRO_MONTO_INFORMADO,
MAH.NRO_DOCUMENTO AS NRO_OPERACION_o_COMPROBANTE,
TO_CHAR(MAH.FECHA,'yyyymmdd')||'-'||MAH.HORA||'-'||MAH.COD_USUARIO||'-'||MAH.NRO_SECUENCIA||'-'||MAH.COD_TRA_PADRE||'-'||MAH.COD_TRANSACCION AS NRO_TRANSACCION, --- CLAVE UNICA NO SE DEBE REPETIR
NULL AS NROTARJETA,
CASE WHEN TR.cod_swi_pte_beneficiario <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_SOLICITANTE IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE)) THEN NULL
   ELSE substr(TR.NOM_SOLICITANTE,1,100) END AS ORDENANTE_DENOMINACION,
CASE WHEN TR.cod_swi_pte_beneficiario <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) OR TR.NRO_DOC_SOLICITANTE IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE))
   THEN (SELECT BO.COD_PERSONA FROM BA_PERSONAS BO WHERE BO.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BO.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE)
   ELSE NULL END AS ORDENANTE_ID_CASO,
CASE WHEN TR.cod_swi_pte_beneficiario <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_SOLICITANTE IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE)) THEN NULL
   ELSE TR.NRO_DOC_SOLICITANTE END AS ORDENANTE_NRO_DOC,
DECODE (NVL(TR.NRO_REFERENCIA,0),0,NULL,CASE WHEN TR.cod_swi_pte_beneficiario <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_SOLICITANTE IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE)) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_SOLICITANTE NOT IN (SELECT BS.NRO_DOCUMENTO FROM BA_PERSONAS BS WHERE BS.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BS.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE))
    AND TR.COD_TIP_DOC_SOLICITANTE = 6 THEN 'J' ELSE 'F' END) AS ORDENANTE_TIPO_PERSONA,
CASE WHEN TR.cod_swi_pte_beneficiario <> (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) THEN NULL
   WHEN (TR.cod_swi_pte_beneficiario = (SELECT AVIGIA_MOVHIS_COD_SWIFT FROM Parametros) AND TR.NRO_DOC_SOLICITANTE IN (SELECT BA.NRO_DOCUMENTO FROM BA_PERSONAS BA WHERE BA.NRO_DOCUMENTO = TR.NRO_DOC_SOLICITANTE AND BA.COD_TIP_DOCUMENTO = TR.COD_TIP_DOC_SOLICITANTE)) THEN NULL
ELSE TO_CHAR(TR.COD_TIP_DOC_SOLICITANTE) END AS ORDENANTE_TIPO_DOC,
NULL AS ORIGEN_FONDOS,
NULL AS TIPO_AUTORIZADOR,
NULL AS TIPO_MODALIDAD_AUTORIZADOR,
CASE WHEN MAH.COD_MONEDA = 'GS' THEN (fug_obt_cotizacion('USD',MAH.FECHA)) ELSE NULL END AS TIPO_DE_CAMBIO,

CASE WHEN MAH.NRO_CAJA > 0 THEN '3' -- 'SUCURSAL'
WHEN NVL(UC1.COD_CANAL, 0) > 0 AND NVL(UC2.COD_CANAL, 0) = 0 THEN UC1.COD_CANAL
WHEN NVL(UC1.COD_CANAL, 0) = 0 AND NVL(UC2.COD_CANAL, 0) > 0 THEN UC2.COD_CANAL





   ELSE '3' --'SUCURSAL'
     END AS CODCANAL,
CASE WHEN MAH.NRO_CAJA > 0 THEN 'S'
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') <> ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') = ' ' THEN UC1.CANAL_PRESENCIAL
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') = ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') <> ' ' THEN UC2.CANAL_PRESENCIAL





   ELSE 'S' END AS ESCANALPRESENCIAL,

-------------------------------------------------------- hasta aqui estructura vigia
   'cc SIN REVERSOS' AS MARCA, NULL AS CLAVE,
    MAH.COD_TRA_PADRE AS TR_PADRE,
    MAH.COD_TRANSACCION AS TR_HIJO,
    MAH.NRO_SECUENCIA AS SECUENCIA, NULL AS COD_PERSONA, NULL AS MOV_TP, NULL AS MOV_TH, NULL AS ESTADO
-------------------------------------------------------- AHORROS I
FROM cc_MOVIMIENTOS_HIS  MAH
LEFT JOIN GE_CTA_CLIENTES CL ON MAH.NRO_CUENTA = CL.NRO_CUENTA AND CL.RELACION = 'P'
LEFT JOIN BA_PERSONAS PE ON PE.COD_PERSONA = CL.COD_PERSONA
JOIN cc_cta_corrientes CD ON CD.NRO_CUENTA = MAH.NRO_CUENTA
LEFT JOIN GE_SNP_TRANSFERENCIAS TR ON TR.NRO_REFERENCIA = MAH.NRO_DOCUMENTO
JOIN BA_USUARIOS US ON US.COD_USUARIO = MAH.COD_USUARIO
JOIN BA_MODULOS MP ON MP.COD_MODULO = MAH.COD_MODULO
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA
JOIN GE_TRANSACCIONES TP ON TP.COD_TRANSACCION = MAH.COD_TRA_PADRE AND TP.COD_MODULO = MAH.COD_MOD_PADRE AND TP.COD_MODALIDAD = MAH.COD_MAD_PADRE AND TP.TIPO <> 'E'
JOIN GE_TRANSACCIONES TH ON TH.COD_TRANSACCION = MAH.COD_TRANSACCION AND TH.COD_MODULO = MAH.COD_MODULO AND TH.COD_MODALIDAD = MAH.COD_MODALIDAD AND TH.TIPO <> 'E'
--inicio join agregado
LEFT JOIN BA_USU_CAN_VIGIA UC1 ON UC1.COD_USUARIO = MAH.COD_USUARIO
LEFT JOIN BA_USU_CAN_VIGIA UC2 ON UC2.USU_ID_INS = MAH.USU_INSERCION
--fin join agregado
WHERE MAH.REVERSADO = 'N' AND MAH.COD_MODULO = 4 AND MAH.COD_MODALIDAD = 41
--AND CD.ESTADO NOT IN ('C','X')
--AND MAH.FECHA between TO_DATE('01/07/2024','dd/mm/yyyy') and pag_cal.fu_obt_fec_actual(1)-5
--AND MAH.FECHA < pag_cal.fu_obt_fec_actual(6)
AND MAH.FECHA = (SELECT AVIGIA_FECHA_ACTUAL FROM Parametros)
AND NVL(CL.COD_PERSONA,0) NOT IN (SELECT AVIGIA_COD_PERSONA_EXC FROM COD_PERSONA_EXC)
AND MAH.COD_TRA_PADRE NOT IN (SELECT AVIGIA_MOVHIS_MAH_TRAPP_CCTEXC FROM MOVHIS_MAH_TRAPP_CCTEXC)
--AND MAH.COD_TRA_PADRE NOT IN (380,382,385,389,390,482,597,517) /*380 COMPRA EN NEGOCIOS (POS) ; 382 EXTRACCION EFECTIVO (ATM) ; 385 TRANSFERENCIA ATM
--                                  389 CONSULTA DE SALDOS (ATM) ; 390 CONSULTA DE EXTRACTOS (ATM) ; 393 DEPOSITO EFECTIVO EN AUTOSERVICIOS
--                                  482 EXTRACCION EFECTIVO - RECICLADOR ; 517 IVA S/COMISIONES COBRADAS ; 597 CARGO S/ DEPOSITOS EN M/E*/
AND MAH.MONTO > 0
UNION ALL -----  cc CON REVERSOS IMPORTE NEGATIVO
select
BENEFICIARIO_DENOMINACION,
BENEFICIARIO_ID_CASO,
BENEFICIARIO_NRO_DOC,
BENEFICIARIO_TIPO_DOC,
BENEFICIARIO_TIPO_PERSONA,
CAJERO,
COD_PAIS_OTRA_CUENTA,
COD_PAIS_CTA_CLIENTE,
COD_TRX_INTERNO,
COD_TRX,
COD_MONEDA,
COD_OTRA_SUCURSAL_INVOLUCRADA,
COD_SUCURSAL_CLIENTE,
OTRA_CUENTA,
CUENTA_CLIENTE,
CUOTAS_CANCELADAS,
DEDUCCIONES,
FECHA_DE_OPERACION,
FECHA_DE_PROCESO,
FORMA_DE_PAGO,
GESTOR_DENOMINACION,
GESTOR_NRO_DOC,
GESTOR_TIPO_DOC,
HORA_OPERACION,
NRO_CLIENTE,
MARCA_PRODUCTO,
MONTO_DE_TRX,
OTRO_MONTO_INFORMADO,
NRO_OPERACION_O_COMPROBANTE,
NRO_TRANSACCION,
NROTARJETA,
ORDENANTE_DENOMINACION,
ORDENANTE_ID_CASO,
ORDENANTE_NRO_DOC,
ORDENANTE_TIPO_PERSONA,
ORDENANTE_TIPO_DOC,
ORIGEN_FONDOS,
TIPO_AUTORIZADOR,
TIPO_MODALIDAD_AUTORIZADOR,
TIPO_DE_CAMBIO,
CODCANAL,
ESCANALPRESENCIAL,
-------------------------------------------------------- hasta aqui estructura vigia
'cc CON REVERSOS' AS MARCA,NULL AS CLAVE,
TR_PADRE,
TR_HIJO,
SECUENCIA,NULL AS COD_PERSONA, NULL AS MOV_TP,NULL AS MOV_TH,NULL AS ESTADO
 FROM (
SELECT
NULL AS BENEFICIARIO_DENOMINACION,
NULL AS BENEFICIARIO_ID_CASO,
NULL AS BENEFICIARIO_NRO_DOC,
NULL AS BENEFICIARIO_TIPO_DOC,
NULL AS BENEFICIARIO_TIPO_PERSONA,
CASE WHEN MAH.NRO_CAJA IS NULL THEN MAH.COD_USUARIO ELSE MAH.NRO_CAJA||'-'||MAH.COD_USUARIO END AS CAJERO,
NULL AS COD_PAIS_OTRA_CUENTA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(P.COD_PAIS) FROM BA_PERSONAS P
      JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = P.COD_PERSONA AND C.RELACION = 'P'
      AND C.NRO_CUENTA = (SELECT MAX (NRO_CUENTA) FROM cc_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
                  AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO)
  ) ELSE TO_CHAR(PE.COD_PAIS) END AS COD_PAIS_CTA_CLIENTE,
MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION AS COD_TRX_INTERNO,
MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION AS COD_TRX,
MAH.COD_MONEDA AS COD_MONEDA,
NULL AS COD_OTRA_SUCURSAL_INVOLUCRADA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(G.COD_OFICINA)
  FROM GE_CLIENTES G
  JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = G.COD_PERSONA AND C.RELACION = 'P'
  AND C.NRO_CUENTA =  (SELECT MAX (NRO_CUENTA)
              FROM cc_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
              AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO)
  ) ELSE TO_CHAR(GE.COD_OFICINA) END AS COD_SUCURSAL_CLIENTE,
NULL AS OTRA_CUENTA,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN
      CASE WHEN (SELECT MAX(NRO_CUENTA) FROM cc_MOVIMIENTOS_HIS   WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
            AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
            ) IS NULL
         THEN (SELECT MAX(NRO_CUENTA) FROM cc_MOVIMIENTOS_HIS   WHERE FECHA = MAH.FECHA
            AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
            ) ELSE (SELECT MAX(NRO_CUENTA) FROM  cc_MOVIMIENTOS_HIS  WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
                  AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO AND COD_TRA_PADRE = MAH.COD_TRA_PADRE
                  ) END
  ELSE MAH.NRO_CUENTA END AS CUENTA_CLIENTE,
NULL AS CUOTAS_CANCELADAS,
NULL AS DEDUCCIONES,
TO_CHAR(MAH.FEC_VALOR,'yyyy-mm-dd') AS FECHA_DE_OPERACION,
TO_CHAR(MAH.FECHA,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
--TO_CHAR(pag_cal.fu_obt_fec_actual(1)-5,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
CASE WHEN TP.DESCRIPCION LIKE '%EFEC%' THEN '1'
  ELSE (CASE WHEN (SELECT count(*) FROM cc_MOVIMIENTOS_HIS gm
    JOIN GE_TRANSACCIONES TH1 ON TH1.COD_TRANSACCION = gm.COD_TRANSACCION AND TH1.COD_MODULO = gm.COD_MODULO
    AND TH1.COD_MODALIDAD = gm.COD_MODALIDAD AND TH1.TIPO <> 'E'
    WHERE gm.FECHA = MAH.FECHA AND gm.HORA = MAH.HORA AND gm.COD_USUARIO = MAH.COD_USUARIO AND gm.COD_TRA_PADRE = MAH.COD_TRA_PADRE
    AND TH1.DESCRIPCION LIKE '%EFEC%') > 0 THEN '1'
    ELSE '0' END) END AS FORMA_DE_PAGO,
NULL AS GESTOR_DENOMINACION,
NULL AS GESTOR_NRO_DOC,
NULL AS GESTOR_TIPO_DOC,
MAH.HORA AS HORA_OPERACION,
NULL AS NRO_CLIENTE,
CASE WHEN MAH.NRO_CUENTA IS NULL THEN (SELECT MAX (MAH.COD_MODULO||MAH.COD_MODALIDAD)
              FROM cc_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MAH.NRO_DOCUMENTO
              AND FECHA = MAH.FECHA AND HORA = MAH.HORA AND COD_USUARIO= MAH.COD_USUARIO
  ) ELSE CL.COD_MODULO||CL.COD_MODALIDAD END AS MARCA_PRODUCTO,
CASE WHEN MAH.COD_MONEDA = 'GS' THEN NVL(ROUND((NVL(MAH.MONTO,0)/(fug_obt_cotizacion('USD',MAH.FECHA))),2),0)
             ELSE nvl(MAH.MONTO, 0) END AS MONTO_DE_TRX, -- usd moneda en la que trabaja Vigia
MAH.MONTO AS OTRO_MONTO_INFORMADO,
MAH.NRO_DOCUMENTO AS NRO_OPERACION_o_COMPROBANTE,
TO_CHAR(MAH.FECHA,'yyyymmdd')||'-'||MAH.HORA||'-'||MAH.COD_USUARIO||'-'||MAH.NRO_SECUENCIA||'-'||MAH.COD_TRA_PADRE||'-'||MAH.COD_TRANSACCION AS NRO_TRANSACCION, --- CLAVE UNICA NO SE DEBE REPETIR
NULL AS NROTARJETA,
NULL AS ORDENANTE_DENOMINACION,
NULL AS ORDENANTE_ID_CASO,
NULL ORDENANTE_NRO_DOC,
NULL AS ORDENANTE_TIPO_PERSONA,
NULL AS ORDENANTE_TIPO_DOC,
NULL AS ORIGEN_FONDOS,
NULL AS TIPO_AUTORIZADOR,
NULL AS TIPO_MODALIDAD_AUTORIZADOR,
CASE WHEN MAH.COD_MONEDA = 'GS' THEN (fug_obt_cotizacion('USD',MAH.FECHA)) ELSE NULL END AS TIPO_DE_CAMBIO,

--inicio case agregado 20250428 ......
CASE WHEN MAH.NRO_CAJA > 0 THEN '3' -- 'SUCURSAL'
WHEN NVL(UC1.COD_CANAL, 0) > 0 AND NVL(UC2.COD_CANAL, 0) = 0 THEN UC1.COD_CANAL
WHEN NVL(UC1.COD_CANAL, 0) = 0 AND NVL(UC2.COD_CANAL, 0) > 0 THEN UC2.COD_CANAL





   ELSE '3' --'SUCURSAL'
     END AS CODCANAL,
CASE WHEN MAH.NRO_CAJA > 0 THEN 'S'
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') <> ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') = ' ' THEN UC1.CANAL_PRESENCIAL
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') = ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') <> ' ' THEN UC2.CANAL_PRESENCIAL





   ELSE 'S' END AS ESCANALPRESENCIAL,

--fin case agregado 20250428
-------------------------------------------------------- hasta aqui estructura vigia
MAH.COD_MOD_PADRE||MAH.COD_TRA_PADRE||MAH.COD_MODULO||MAH.COD_TRANSACCION||MAH.NRO_CUENTA||MAH.NRO_DOCUMENTO AS CLAVE,
MAH.COD_TRA_PADRE AS TR_PADRE,
MAH.COD_TRANSACCION AS TR_HIJO,
MAH.NRO_SECUENCIA AS SECUENCIA, NULL AS COD_PERSONA, NULL AS MOV_TP, NULL AS MOV_TH , NULL AS ESTADO
-------------------------------------------------------- AHORROS II
FROM cc_MOVIMIENTOS_HIS MAH
LEFT JOIN GE_CTA_CLIENTES CL ON MAH.NRO_CUENTA = CL.NRO_CUENTA AND CL.RELACION = 'P'
LEFT JOIN BA_PERSONAS PE ON PE.COD_PERSONA = CL.COD_PERSONA
JOIN cc_cta_corrientes CD ON CD.NRO_CUENTA = mah.NRO_CUENTA
JOIN BA_USUARIOS US ON US.COD_USUARIO = MAH.COD_USUARIO
JOIN BA_MODULOS MP ON MP.COD_MODULO = MAH.COD_MODULO
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA
JOIN GE_TRANSACCIONES TP ON TP.COD_TRANSACCION = MAH.COD_TRA_PADRE AND TP.COD_MODULO = MAH.COD_MOD_PADRE AND TP.COD_MODALIDAD = MAH.COD_MAD_PADRE AND TP.TIPO <> 'E'
JOIN GE_TRANSACCIONES TH ON TH.COD_TRANSACCION = MAH.COD_TRANSACCION AND TH.COD_MODULO = MAH.COD_MODULO AND TH.COD_MODALIDAD = MAH.COD_MODALIDAD AND TH.TIPO <> 'E'
--inicio join agregado
LEFT JOIN BA_USU_CAN_VIGIA UC1 ON UC1.COD_USUARIO = MAH.COD_USUARIO
LEFT JOIN BA_USU_CAN_VIGIA UC2 ON UC2.USU_ID_INS = MAH.USU_INSERCION
--fin join agregado
WHERE MAH.REVERSADO = 'N' AND MAH.COD_MODULO = 4 AND MAH.COD_MODALIDAD = 41
--AND CD.ESTADO NOT IN ('C','X')
--AND MAH.FECHA between TO_DATE('01/07/2024','dd/mm/yyyy') and pag_cal.fu_obt_fec_actual(1)-5
AND MAH.FECHA = (SELECT AVIGIA_FECHA_ACTUAL FROM Parametros)
AND NVL(CL.COD_PERSONA,0) NOT IN (SELECT AVIGIA_COD_PERSONA_EXC FROM COD_PERSONA_EXC)
--AND MAH.COD_TRA_PADRE IN (380,382,385,482,393,597,517)
AND MAH.COD_TRA_PADRE IN (SELECT AVIGIA_MOVHIS_MAH_TRAPP_CCRINC FROM MOVHIS_MAH_TRAPP_CCRINC)
AND MAH.MONTO > 0
--ORDER BY MAH.FECHA, MAH.HORA, MAH.COD_USUARIO, MAH.NRO_SECUENCIA
) PP WHERE PP.CLAVE IN (SELECT (AH.COD_MOD_PADRE||AH.COD_TRA_PADRE||AH.COD_MODULO||AH.COD_TRANSACCION
||AH.NRO_CUENTA||AH.NRO_DOCUMENTO) FROM AH_MOVIMIENTOS_HIS AH 
WHERE AH.REVERSADO = 'N' AND AH.COD_MODULO = 4 AND AH.COD_MODALIDAD = 41 AND AH.COD_TRA_PADRE IN (SELECT AVIGIA_MOVHIS_MAH_TRAPP_CCRINC FROM MOVHIS_MAH_TRAPP_CCRINC)
/*380 COMPRA EN NEGOCIOS (POS); 382 EXTRACCION EFECTIVO (ATM); 385 TRANSFERENCIA ATM; 393 DEPOSITO EFECTIVO EN AUTOSERVICIOS
482 EXTRACCION EFECTIVO - RECICLADOR; 517 IVA S/COMISIONES COBRADAS; 597 CARGO S/ DEPOSITOS EN M/E*/
--AND AH.FECHA between TO_DATE('01/07/2024','dd/mm/yyyy') and pag_cal.fu_obt_fec_actual(1)-5
AND AH.FECHA = (SELECT AVIGIA_FECHA_ACTUAL FROM Parametros)
GROUP BY AH.COD_MOD_PADRE||AH.COD_TRA_PADRE||AH.COD_MODULO||AH.COD_TRANSACCION
||AH.NRO_CUENTA||AH.NRO_DOCUMENTO HAVING (COUNT(*)) = 1)

--2025-05-22 *******************************************************************************

UNION ALL ----------------------------------------------------------TARJETAS
SELECT
NULL AS BENEFICIARIO_DENOMINACION,
NULL AS BENEFICIARIO_ID_CASO,
NULL AS BENEFICIARIO_NRO_DOC,
NULL AS BENEFICIARIO_TIPO_DOC,
NULL AS BENEFICIARIO_TIPO_PERSONA,
CASE WHEN MTC.NRO_CAJA IS NULL THEN MTC.COD_USUARIO ELSE MTC.NRO_CAJA||'-'||MTC.COD_USUARIO END AS CAJERO,
NULL AS COD_PAIS_OTRA_CUENTA,
CASE WHEN MTC.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(P.COD_PAIS) FROM BA_PERSONAS P
      JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = P.COD_PERSONA AND C.RELACION = 'P'
      AND C.NRO_CUENTA = (SELECT MAX (NRO_CUENTA) FROM TA_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MTC.NRO_DOCUMENTO
                  AND FECHA = MTC.FECHA AND HORA = MTC.HORA AND COD_USUARIO= MTC.COD_USUARIO)
  ) ELSE TO_CHAR(PE.COD_PAIS) END AS COD_PAIS_CTA_CLIENTE,
MTC.COD_MOD_PADRE||MTC.COD_TRA_PADRE||MTC.COD_MODULO||MTC.COD_TRANSACCION AS COD_TRX_INTERNO,
MTC.COD_MOD_PADRE||MTC.COD_TRA_PADRE||MTC.COD_MODULO||MTC.COD_TRANSACCION AS COD_TRX,
MTC.COD_MONEDA AS COD_MONEDA,
NULL AS COD_OTRA_SUCURSAL_INVOLUCRADA,
CASE WHEN MTC.NRO_CUENTA IS NULL THEN (SELECT TO_CHAR(G.COD_OFICINA)
  FROM GE_CLIENTES G
  JOIN GE_CTA_CLIENTES C ON C.COD_PERSONA = G.COD_PERSONA AND C.RELACION = 'P'
  AND C.NRO_CUENTA =  (SELECT MAX (NRO_CUENTA)
              FROM TA_MOVIMIENTOS_HIS WHERE NRO_DOCUMENTO = MTC.NRO_DOCUMENTO
              AND FECHA = MTC.FECHA AND HORA = MTC.HORA AND COD_USUARIO= MTC.COD_USUARIO)
  ) ELSE TO_CHAR(GE.COD_OFICINA) END AS COD_SUCURSAL_CLIENTE,
NULL AS OTRA_CUENTA,
--TO_CHAR(MTC.NRO_CUENTA) AS CUENTA_CLIENTE,
CASE WHEN MTC.NRO_CUENTA IS NULL THEN
      CASE WHEN (SELECT MAX(NRO_CUENTA) FROM TA_MOVIMIENTOS_HIS   WHERE NRO_DOCUMENTO = MTC.NRO_DOCUMENTO
            AND FECHA = MTC.FECHA AND HORA = MTC.HORA AND COD_USUARIO= MTC.COD_USUARIO AND COD_TRA_PADRE = MTC.COD_TRA_PADRE
            ) IS NULL
         THEN (SELECT MAX(NRO_CUENTA) FROM TA_MOVIMIENTOS_HIS   WHERE FECHA = MTC.FECHA
            AND HORA = MTC.HORA AND COD_USUARIO= MTC.COD_USUARIO AND COD_TRA_PADRE = MTC.COD_TRA_PADRE
            ) ELSE (SELECT MAX(NRO_CUENTA) FROM  TA_MOVIMIENTOS_HIS  WHERE NRO_DOCUMENTO = MTC.NRO_DOCUMENTO
                  AND FECHA = MTC.FECHA AND HORA = MTC.HORA AND COD_USUARIO= MTC.COD_USUARIO AND COD_TRA_PADRE = MTC.COD_TRA_PADRE
                  ) END
  ELSE MTC.NRO_CUENTA END AS CUENTA_CLIENTE,
NULL AS CUOTAS_CANCELADAS,
NULL AS DEDUCCIONES,
TO_CHAR(MTC.FEC_VALOR,'yyyy-mm-dd') AS FECHA_DE_OPERACION,
TO_CHAR(MTC.FECHA,'yyyy-mm-dd') AS FECHA_DE_PROCESO,
CASE WHEN TP.DESCRIPCION LIKE '%EFEC%' THEN '1'
WHEN MTC.CONCEPTO LIKE '%Pago Efe%' THEN '1'
  ELSE (CASE WHEN (SELECT count(*) FROM TA_MOVIMIENTOS_HIS gm
    JOIN GE_TRANSACCIONES TH1 ON TH1.COD_TRANSACCION = gm.COD_TRANSACCION AND TH1.COD_MODULO = gm.COD_MODULO
    AND TH1.COD_MODALIDAD = gm.COD_MODALIDAD AND TH1.TIPO <> 'E'
    WHERE gm.FECHA = MTC.FECHA AND gm.HORA = MTC.HORA AND gm.COD_USUARIO = MTC.COD_USUARIO AND gm.COD_TRA_PADRE = MTC.COD_TRA_PADRE
    AND TH1.DESCRIPCION LIKE '%EFEC%') > 0 THEN '1'
    ELSE '0' END) END AS FORMA_DE_PAGO,
NULL AS GESTOR_DENOMINACION,
NULL AS GESTOR_NRO_DOC,
NULL AS GESTOR_TIPO_DOC,
MTC.HORA AS HORA_OPERACION,
NULL AS NRO_CLIENTE,
CL.COD_MODULO||CL.COD_MODALIDAD AS MARCA_PRODUCTO,
CASE WHEN MTC.COD_MONEDA = 'GS' THEN NVL(ROUND((NVL(MTC.MONTO,0)/(fug_obt_cotizacion('USD',MTC.FECHA))),2),0)
             ELSE nvl(MTC.MONTO, 0) END AS MONTO_DE_TRX, -- usd moneda en la que trabaja Vigia
MTC.MONTO AS OTRO_MONTO_INFORMADO,
MTC.NRO_DOCUMENTO AS NRO_OPERACION_o_COMPROBANTE,
TO_CHAR(MTC.FECHA,'yyyymmdd')||'-'||MTC.HORA||'-'||MTC.COD_USUARIO||'-'||MTC.NRO_SECUENCIA||'-'||MTC.COD_TRA_PADRE||'-'||MTC.COD_TRANSACCION AS NRO_TRANSACCION, --- CLAVE UNICA NO SE DEBE REPETIR
NULL AS NROTARJETA,
NULL AS ORDENANTE_DENOMINACION,
NULL AS ORDENANTE_ID_CASO,
NULL ORDENANTE_NRO_DOC,
NULL AS ORDENANTE_TIPO_PERSONA,
NULL AS ORDENANTE_TIPO_DOC,
NULL AS ORIGEN_FONDOS,
NULL AS TIPO_AUTORIZADOR,
NULL AS TIPO_MODALIDAD_AUTORIZADOR,
CASE WHEN MTC.COD_MONEDA = 'GS' THEN (fug_obt_cotizacion('USD',MTC.FECHA)) ELSE NULL END AS TIPO_DE_CAMBIO,

--inicio case agregado 20250428
CASE WHEN MTC.NRO_CAJA > 0 THEN '3' -- 'SUCURSAL'
WHEN NVL(UC1.COD_CANAL, 0) > 0 AND NVL(UC2.COD_CANAL, 0) = 0 THEN UC1.COD_CANAL
WHEN NVL(UC1.COD_CANAL, 0) = 0 AND NVL(UC2.COD_CANAL, 0) > 0 THEN UC2.COD_CANAL





ELSE '3' --'SUCURSAL'
END AS CODCANAL ,
CASE WHEN MTC.NRO_CAJA > 0 THEN 'S' -- 'S'
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') <> ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') = ' ' THEN UC1.CANAL_PRESENCIAL
WHEN NVL(UC1.CANAL_PRESENCIAL, ' ') = ' ' AND NVL(UC2.CANAL_PRESENCIAL, ' ') <> ' ' THEN UC2.CANAL_PRESENCIAL
ELSE 'S' --'S'




END AS ESCANALPRESENCIAL ,
--fin case agregado 20250428

-------------------------------------------------------- hasta aqui estructura vigia
   'TARJETA' AS MARCA,   NULL AS CLAVE,
     MTC.COD_TRA_PADRE AS TR_PADRE,
   MTC.COD_TRANSACCION AS TR_HIJO,
   MTC.NRO_SECUENCIA AS SECUENCIA,   NULL AS COD_PERSONA,  NULL AS MOV_TP,   NULL AS MOV_TH,   NULL AS ESTADO
----------------------------------******************-----------------------------------
FROM TA_MOVIMIENTOS_HIS  MTC
LEFT JOIN GE_CTA_CLIENTES CL ON MTC.NRO_CUENTA = CL.NRO_CUENTA AND CL.RELACION = 'P'
LEFT JOIN BA_PERSONAS PE ON PE.COD_PERSONA = CL.COD_PERSONA
JOIN TA_CTA_TARJETAS TA ON TA.NRO_CUENTA = mtc.NRO_CUENTA
JOIN BA_USUARIOS US ON US.COD_USUARIO = MTC.COD_USUARIO
JOIN BA_MODULOS MP ON MP.COD_MODULO = MTC.COD_MODULO
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA
JOIN GE_TRANSACCIONES TP ON TP.COD_TRANSACCION = MTC.COD_TRA_PADRE AND TP.COD_MODULO = MTC.COD_MOD_PADRE AND TP.COD_MODALIDAD = MTC.COD_MAD_PADRE AND TP.TIPO <> 'E'
JOIN GE_TRANSACCIONES TH ON TH.COD_TRANSACCION = MTC.COD_TRANSACCION AND TH.COD_MODULO = MTC.COD_MODULO AND TH.COD_MODALIDAD = MTC.COD_MODALIDAD AND TH.TIPO <> 'E'
--inicio join agregado
LEFT JOIN BA_USU_CAN_VIGIA UC1 ON UC1.COD_USUARIO = MTC.COD_USUARIO
LEFT JOIN BA_USU_CAN_VIGIA UC2 ON UC2.USU_ID_INS = MTC.USU_INSERCION
--fin join agregado
WHERE MTC.REVERSADO = 'N'
AND MTC.FECHA = (SELECT AVIGIA_FECHA_ACTUAL FROM Parametros)
AND NVL(CL.COD_PERSONA,0) NOT IN (SELECT AVIGIA_COD_PERSONA_EXC FROM COD_PERSONA_EXC)
AND MTC.NRO_DOCUMENTO NOT IN (SELECT GT.NRO_DOCUMENTO
                  FROM TA_MOVIMIENTOS_HIS GT
                    WHERE GT.NRO_DOCUMENTO = MTC.NRO_DOCUMENTO
                    AND GT.COD_MODULO = MTC.COD_MODULO AND GT.MONTO = (MTC.MONTO*-1))
AND MTC.MONTO > 0 
;