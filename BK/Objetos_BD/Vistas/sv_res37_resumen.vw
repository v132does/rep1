  from ge_clientes_his        sb_clientes,
       ge_cla_operaciones_his sb_cla_operaciones
 where sb_cla_operaciones.cod_persona = sb_clientes.cod_persona
   and sb_cla_operaciones.fecha = sb_clientes.fecha
   AND (nvl(sb_cla_operaciones.tot_deu_real, 0) +
       nvl(sb_cla_operaciones.tot_deu_contingente, 0) > 0)
 group by case
            when nvl(sb_clientes.COD_GRU_ECONOMICO, -1) = -1 then
             'B'
            ELSE
             'A'
          end,
          CASE
            WHEN sb_cla_operaciones.cod_sec_credito IN (702, 703) THEN
             'V'
            ELSE
             CASE
               WHEN sb_clientes.tipo = 'T' AND
                    sb_cla_operaciones.tip_destino = 4 THEN
                'P'
               ELSE
                sb_clientes.tipo
             END
          END,
          sb_clientes.cod_persona,
          sb_cla_operaciones.fecha,
          sb_cla_operaciones.tip_destino,
