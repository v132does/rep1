union all
select case
         when nvl(sb_clientes.COD_GRU_ECONOMICO, -1) = -1 then
          'B'
         else
          'A'
       end tip_corte,
       CASE
         WHEN sb_cla_operaciones.cod_sec_credito IN (702, 703) THEN
          'V'
         ELSE
          CASE
            WHEN sb_clientes.tipo = 'T' AND sb_cla_operaciones.tip_destino = 4 THEN
             'P'
            ELSE
             sb_clientes.tipo
          END
       END tipo,
       sb_cla_operaciones.tip_destino,
       sb_cla_operaciones.fecha,
       decode(nvl(sb_clientes.cod_gru_economico, -1),
              fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                  NULL,
                                  NULL,
                                  NULL,
                                  NULL),
              nvl(sb_clientes.cat_gru_economico, sb_clientes.cat_riesgo),
              -1,
              decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                     1,
                     case
                       when fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                  sb_cla_operaciones.fecha) > 1.1 then
                        1.2
                       else
                        fus_obt_cat_prevision(sb_clientes.cod_persona,
                                              sb_cla_operaciones.fecha)
                     end,
                     nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica)),
              nvl(sb_clientes.cat_gru_economico, sb_clientes.cat_riesgo)) categoria,
       decode(nvl(sb_clientes.cod_gru_economico, -1),
              '1',
              '1- Vinculados a la Entidad (*)',
              '-1',
              '3- Deudores no Vinculados',
              '2- Vinculados a otros grupos (*)') GRUPO,
       /*CASE
         WHEN nvl(sb_clientes.cod_gru_economico, -1) =
              to_number(fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                            NULL,
                                            NULL,
                                            NULL,
                                            NULL)) THEN
          'Vinculados a la Entidad de Cr?dito (*)'
         ELSE
          CASE
            WHEN (nvl(sb_clientes.cod_gru_economico, -1) <>
                 to_number(fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                                NULL,
                                                NULL,
                                                NULL,
                                                NULL)) AND
                 fus_ver_gru_mas_clie(sb_clientes.cod_gru_economico) >= 1) THEN
             ' Vinculados a otros grupos (*)'
            ELSE
             '  Deudores no Vinculados'
          END
       END GRUPO,*/
       0 PRA1,
       nvl(decode(decode(nvl(sb_clientes.cod_gru_economico, -1),
                         fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                             NULL,
                                             NULL,
                                             NULL,
                                             NULL),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo),
                         -1,
                         decode(nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica),
                                1,
                                case
                                  when fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                             sb_cla_operaciones.fecha) > 1.1 then
                                   1.2
                                  else
                                   fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                         sb_cla_operaciones.fecha)
                                end,
                                nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica)),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo)),
                  1.1,
                  sum(nvl(sb_cla_operaciones.tot_pri_prevision, 0) / 1000)),
           0) PRA1_A,
       nvl(decode(decode(nvl(sb_clientes.cod_gru_economico, -1),
                         fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                             NULL,
                                             NULL,
                                             NULL,
                                             NULL),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo),
                         -1,
                         decode(nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica),
                                1,
                                case
                                  when fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                             sb_cla_operaciones.fecha) > 1.1 then
                                   1.2
                                  else
                                   fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                         sb_cla_operaciones.fecha)
                                end,
                                nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica)),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo)),
                  1.2,
                  sum(nvl(sb_cla_operaciones.tot_pri_prevision, 0) / 1000)),
           0) PRA1_B,
       nvl(decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                  2,
                  sum(nvl(sb_cla_operaciones.tot_pri_prevision, 0) / 1000)),
           0) PRA2,
       nvl(decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                  3,
                  sum(nvl(sb_cla_operaciones.tot_pri_prevision, 0) / 1000)),
           0) PRA3,
       nvl(decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                  4,
                  sum(nvl(sb_cla_operaciones.tot_pri_prevision, 0) / 1000)),
           0) PRA4,
       nvl(decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                  5,
                  sum(nvl(sb_cla_operaciones.tot_pri_prevision, 0) / 1000)),
           0) PRA5,
       nvl(decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                  6,
                  sum(nvl(sb_cla_operaciones.tot_pri_prevision, 0) / 1000)),
           0) PRA6,

       nvl(decode(decode(nvl(sb_clientes.cod_gru_economico, -1),
                         fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                             NULL,
                                             NULL,
                                             NULL,
                                             NULL),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo),
                         -1,
                         decode(nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica),
                                1,
                                case
                                  when fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                             sb_cla_operaciones.fecha) > 1.1 then
                                   1.2
                                  else
                                   fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                         sb_cla_operaciones.fecha)
                                end,
                                nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica)),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo)),
                  1,
                  sum(((nvl(sb_cla_operaciones.tot_deu_real, 0) +
                      nvl(sb_cla_operaciones.tot_deu_contingente, 0) -
                      nvl(sb_cla_operaciones.dev_no_cobrado, 0)) / 1000))),
           0) T1,
       nvl(decode(decode(nvl(sb_clientes.cod_gru_economico, -1),
                         fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                             NULL,
                                             NULL,
                                             NULL,
                                             NULL),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo),
                         -1,
                         decode(nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica),
                                1,
                                case
                                  when fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                             sb_cla_operaciones.fecha) > 1.1 then
                                   1.2
                                  else
                                   fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                         sb_cla_operaciones.fecha)
                                end,
                                nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica)),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo)),
                  1.1,
                  sum(((nvl(sb_cla_operaciones.tot_deu_real, 0) +
                      nvl(sb_cla_operaciones.tot_deu_contingente, 0) -
                      nvl(sb_cla_operaciones.dev_no_cobrado, 0)) / 1000))),
           0) T1_A,
       nvl(decode(decode(nvl(sb_clientes.cod_gru_economico, -1),
                         fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                             NULL,
                                             NULL,
                                             NULL,
                                             NULL),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo),
                         -1,
                         decode(nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica),
                                1,
                                case
                                  when fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                             sb_cla_operaciones.fecha) > 1.1 then
                                   1.2
                                  else
                                   fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                         sb_cla_operaciones.fecha)
                                end,
                                nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica)),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo)),
                  1.2,
                  sum(((nvl(sb_cla_operaciones.tot_deu_real, 0) +
                      nvl(sb_cla_operaciones.tot_deu_contingente, 0) -
                      nvl(sb_cla_operaciones.dev_no_cobrado, 0)) / 1000))),
           0) T1_B,
       nvl(decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                  2,
                  sum(((nvl(sb_cla_operaciones.tot_deu_real, 0) +
                      nvl(sb_cla_operaciones.tot_deu_contingente, 0) -
                      nvl(sb_cla_operaciones.dev_no_cobrado, 0)) / 1000))),
           0) T2,
       nvl(decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                  3,
                  sum(((nvl(sb_cla_operaciones.tot_deu_real, 0) +
                      nvl(sb_cla_operaciones.tot_deu_contingente, 0) -
                      nvl(sb_cla_operaciones.dev_no_cobrado, 0)) / 1000))),
           0) T3,
       nvl(decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                  4,
                  sum(((nvl(sb_cla_operaciones.tot_deu_real, 0) +
                      nvl(sb_cla_operaciones.tot_deu_contingente, 0) -
                      nvl(sb_cla_operaciones.dev_no_cobrado, 0)) / 1000))),
           0) T4,
       nvl(decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                  5,
                  sum(((nvl(sb_cla_operaciones.tot_deu_real, 0) +
                      nvl(sb_cla_operaciones.tot_deu_contingente, 0) -
                      nvl(sb_cla_operaciones.dev_no_cobrado, 0)) / 1000))),
           0) T5,
       nvl(decode(nvl(sb_clientes.cat_riesgo, sb_clientes.cat_automatica),
                  6,
                  sum(((nvl(sb_cla_operaciones.tot_deu_real, 0) +
                      nvl(sb_cla_operaciones.tot_deu_contingente, 0) -
                      nvl(sb_cla_operaciones.dev_no_cobrado, 0)) / 1000))),
           0) T6,

       nvl(decode(decode(nvl(sb_clientes.cod_gru_economico, -1),
                         fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                             NULL,
                                             NULL,
                                             NULL,
                                             NULL),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo),
                         -1,
                         decode(nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica),
                                1,
                                case
                                  when fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                             sb_cla_operaciones.fecha) > 1.1 then
                                   1.2
                                  else
                                   fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                         sb_cla_operaciones.fecha)
                                end,
                                nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica)),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo)),
                  1,
                  sum(((nvl(sb_cla_operaciones.tot_deu_real, 0) +
                      nvl(sb_cla_operaciones.tot_deu_contingente, 0) -
                      nvl(sb_cla_operaciones.dev_no_cobrado, 0)) / 1000))),
           0) D1,
       nvl(decode(decode(nvl(sb_clientes.cod_gru_economico, -1),
                         fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                             NULL,
                                             NULL,
                                             NULL,
                                             NULL),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo),
                         -1,
                         decode(nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica),
                                1,
                                case
                                  when fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                             sb_cla_operaciones.fecha) > 1.1 then
                                   1.2
                                  else
                                   fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                         sb_cla_operaciones.fecha)
                                end,
                                nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica)),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo)),
                  1.1,
                  sum(((nvl(sb_cla_operaciones.tot_deu_real, 0) +
                      nvl(sb_cla_operaciones.tot_deu_contingente, 0) -
                      nvl(sb_cla_operaciones.dev_no_cobrado, 0)) / 1000))),
           0) D1_A,
       nvl(decode(decode(nvl(sb_clientes.cod_gru_economico, -1),
                         fug_obt_pardinamico('COD_GRU_ECO_ENTIDAD',
                                             NULL,
                                             NULL,
                                             NULL,
                                             NULL),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo),
                         -1,
                         decode(nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica),
                                1,
                                case
                                  when fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                             sb_cla_operaciones.fecha) > 1.1 then
                                   1.2
                                  else
                                   fus_obt_cat_prevision(sb_clientes.cod_persona,
                                                         sb_cla_operaciones.fecha)
                                end,
                                nvl(sb_clientes.cat_riesgo,
                                    sb_clientes.cat_automatica)),
                         nvl(sb_clientes.cat_gru_economico,
                             sb_clientes.cat_riesgo)),
