select 'A' tip_corte,
       'M' tipo,
       1 tip_destino,
       null fecha,
       1 categoria,
       '1- Vinculados a la Entidad (*)' grupo,
       0 PRA1,
       0 PRA1_A,
       0 PRA1_B,
       0 PRA2,
       0 PRA3,
