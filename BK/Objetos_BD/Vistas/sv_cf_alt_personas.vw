create or replace view IT.SV_CF_ALT_PERSONAS AS
SELECT
    a.NRO_LINEA,
    a.TIPO_IDENT,
    a.NRO_DOCUMENTO,
    a.TIPO_PER,
    a.APELLIDO,
    a.NOMBRE,
    a.FECHA_NAC,
    a.GENERO,
    a.PAIS_NACIMIENTO,
    a.CIUDAD_NACIMIENTO,
    a.FECHA_VENC_DOC,
    a.COD_PERSONA,
    a.RELACION,
    a.NATURALEZA,
    a.LINEA_CSV,
    p.FEC_CIERRE AS FECHA
  FROM IT.SB_CF_ALT_PERSONAS a
  JOIN IT.SB_CF_PRO_LOG p ON p.ID_EJECUCION = a.ID_EJECUCION
 WHERE p.ESTADO       = 'OK'
   AND p.TIPO_PROCESO = 'CF_ALTA'
 ORDER BY a.NRO_LINEA;

CREATE PUBLIC SYNONYM SV_CF_ALT_PERSONAS FOR IT.SV_CF_ALT_PERSONAS;
GRANT SELECT ON IT.SV_CF_ALT_PERSONAS TO IT_CONSULTAS;
GRANT SELECT ON IT.SV_CF_ALT_PERSONAS TO IT_TEMPORAL;
