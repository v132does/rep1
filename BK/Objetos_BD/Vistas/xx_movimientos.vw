create or replace force view it.xx_movimientos as
select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
       MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
       MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
       MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
       MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
       MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
       MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
       MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
       MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
       MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
       MO.NRO_FOLIO, MO.REFERENCIA,
       TP.DESCRIPCION DES_TRA_PADRE, TP.ABREVIATURA ABR_TRA_PADRE,
       TH.DESCRIPCION DES_TRANSACCION,
       DECODE(MO.COD_TRANSACCION,515,'C',615,'C',TH.TIPO) COD_TIP_MOVIMIENTO,
       DECODE(DECODE(MO.COD_TRANSACCION,515,'C',615,'C',TH.TIPO), 'C', 'Credito', 'D', 'Debito', 'E', 'Cambio Estado') TIP_MOVIMIENTO,
       UA.NOMBRE NOM_USU_AUTORIZADOR,
       UR.NOMBRE NOM_USU_REVERSION,
       UM.NOMBRE NOM_USUARIO,
       EC.DESCRIPCION DES_EST_CUENTA,
       BA.DESCRIPCION DES_BANCO,
       CA.DESCRIPCION DES_CAUSA,
       RU.DESCRIPCION DES_RUBRO,
       BO.DESCRIPCION DES_OFI_ORIGEN,
       'H' TIPO, -- HISTORICO
       'HISTORICO' DES_TIPO,
        CU.DENOMINACION DENOMINACION
FROM CB_RUBROS RU, GE_CAUSALES CA, GE_BANCOS BA, BA_OFICINAS BO, GE_EST_CUENTAS EC, BA_USUARIOS UA,
     BA_USUARIOS UR, BA_USUARIOS UM,
     GE_TRANSACCIONES TP, GE_TRANSACCIONES TH,
     GE_CUENTAS CU, cc_MOVIMIENTOS_HIS MO
WHERE RU.COD_RUBRO(+) = MO.COD_RUBRO
AND CA.COD_CAUSA(+) = MO.COD_CAUSA
AND BA.COD_BANCO(+) = MO.COD_BANCO
AND EC.COD_MODULO(+) = MO.COD_MODULO
AND EC.COD_MODALIDAD(+) = MO.COD_MODALIDAD
AND EC.ESTADO(+) = MO.EST_CUENTA
AND UR.COD_USUARIO(+) = MO.COD_USU_REVERSION
AND UA.COD_USUARIO(+) = MO.COD_USU_AUTORIZADOR
AND BO.COD_OFICINA = MO.COD_OFI_ORIGEN
AND UM.COD_USUARIO = MO.COD_USUARIO
AND TP.COD_MODULO = MO.COD_MOD_PADRE
AND TP.COD_MODALIDAD = MO.COD_MAD_PADRE
AND TP.COD_TRANSACCION = MO.COD_TRA_PADRE
AND TH.COD_MODULO(+) = MO.COD_MODULO
AND TH.COD_MODALIDAD(+) = MO.COD_MODALIDAD
AND TH.COD_TRANSACCION(+) = MO.COD_TRANSACCION
AND CU.NRO_CUENTA(+) = MO.NRO_CUENTA
AND TH.VE_CLIENTE = 'S'
UNION
select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
       MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
       MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
       MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
       MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
       MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
       MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
       MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
       MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
       MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
       TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
       TP.DESCRIPCION DES_TRA_PADRE, TP.ABREVIATURA ABR_TRA_PADRE,
       TH.DESCRIPCION DES_TRANSACCION,
       DECODE(MO.COD_TRANSACCION,515,'C',615,'C',TH.TIPO) COD_TIP_MOVIMIENTO,
       DECODE(DECODE(MO.COD_TRANSACCION,515,'C',615,'C',TH.TIPO), 'C', 'Credito', 'D', 'Debito', 'E', 'Cambio Estado') TIP_MOVIMIENTO,
       UA.NOMBRE NOM_USU_AUTORIZADOR,
       UR.NOMBRE NOM_USU_REVERSION,
       UM.NOMBRE NOM_USUARIO,
       EC.DESCRIPCION DES_EST_CUENTA,
       BA.DESCRIPCION DES_BANCO,
       CA.DESCRIPCION DES_CAUSA,
       RU.DESCRIPCION DES_RUBRO,
       BO.DESCRIPCION DES_OFI_ORIGEN,
       'D' TIPO, -- MOVIMIENTO DIARIO
       'DEL DIA' DES_TIPO,
        CU.DENOMINACION DENOMINACION
FROM CB_RUBROS RU, GE_CAUSALES CA, GE_BANCOS BA, BA_OFICINAS BO, GE_EST_CUENTAS EC, BA_USUARIOS UA,
     BA_USUARIOS UR, BA_USUARIOS UM,
     GE_TRANSACCIONES TP, GE_TRANSACCIONES TH, BA_MODULOS MD, GE_CUENTAS CU, GE_MOVIMIENTOS MO
WHERE RU.COD_RUBRO(+) = MO.COD_RUBRO
AND CA.COD_CAUSA(+) = MO.COD_CAUSA
AND BA.COD_BANCO(+) = MO.COD_BANCO
AND EC.COD_MODULO(+) = MO.COD_MODULO
AND EC.COD_MODALIDAD(+) = MO.COD_MODALIDAD
AND EC.ESTADO(+) = MO.EST_CUENTA
AND UR.COD_USUARIO(+) = MO.COD_USU_REVERSION
AND UA.COD_USUARIO(+) = MO.COD_USU_AUTORIZADOR
AND BO.COD_OFICINA = MO.COD_OFI_ORIGEN
AND UM.COD_USUARIO = MO.COD_USUARIO
AND TP.COD_MODULO = MO.COD_MOD_PADRE
AND TP.COD_MODALIDAD = MO.COD_MAD_PADRE
AND TP.COD_TRANSACCION = MO.COD_TRA_PADRE
AND TH.COD_MODULO(+) = MO.COD_MODULO
AND TH.COD_MODALIDAD(+) = MO.COD_MODALIDAD
AND TH.COD_TRANSACCION(+) = MO.COD_TRANSACCION
AND CU.NRO_CUENTA(+) = MO.NRO_CUENTA
AND MD.COD_MODULO = 3 -- Ahorros
AND MD.ESTADO != 4
AND TH.VE_CLIENTE = 'S'
UNION
select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
       MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
       MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
       MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
       MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
       MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
       MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
       MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
       MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
       MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
       TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
       TP.DESCRIPCION DES_TRA_PADRE, TP.ABREVIATURA ABR_TRA_PADRE,
       TH.DESCRIPCION DES_TRANSACCION,
       DECODE(MO.COD_TRANSACCION,515,'C',615,'C',TH.TIPO) COD_TIP_MOVIMIENTO,
       DECODE(DECODE(MO.COD_TRANSACCION,515,'C',615,'C',TH.TIPO), 'C', 'Credito', 'D', 'Debito', 'E', 'Cambio Estado') TIP_MOVIMIENTO,
       UA.NOMBRE NOM_USU_AUTORIZADOR,
       UR.NOMBRE NOM_USU_REVERSION,
       UM.NOMBRE NOM_USUARIO,
       EC.DESCRIPCION DES_EST_CUENTA,
       BA.DESCRIPCION DES_BANCO,
       CA.DESCRIPCION DES_CAUSA,
       RU.DESCRIPCION DES_RUBRO,
       BO.DESCRIPCION DES_OFI_ORIGEN,
       'N' TIPO, -- NOCTURNO O FUERA DE HORA
       'FUERA DE HORA' DES_TIPO,
       CU.DENOMINACION
FROM CB_RUBROS RU, GE_CAUSALES CA, GE_BANCOS BA, BA_OFICINAS BO, GE_EST_CUENTAS EC, BA_USUARIOS UA,
     BA_USUARIOS UR, BA_USUARIOS UM,
     GE_TRANSACCIONES TP, GE_TRANSACCIONES TH, GE_CUENTAS CU,
     GE_MOVIMIENTOS_NOC MO
WHERE RU.COD_RUBRO(+) = MO.COD_RUBRO
AND CA.COD_CAUSA(+) = MO.COD_CAUSA
AND BA.COD_BANCO(+) = MO.COD_BANCO
AND EC.COD_MODULO(+) = MO.COD_MODULO
AND EC.COD_MODALIDAD(+) = MO.COD_MODALIDAD
AND EC.ESTADO(+) = MO.EST_CUENTA
AND UR.COD_USUARIO(+) = MO.COD_USU_REVERSION
AND UA.COD_USUARIO(+) = MO.COD_USU_AUTORIZADOR
AND BO.COD_OFICINA = MO.COD_OFI_ORIGEN
AND UM.COD_USUARIO = MO.COD_USUARIO
AND TP.COD_MODULO = MO.COD_MOD_PADRE
AND TP.COD_MODALIDAD = MO.COD_MAD_PADRE
AND TP.COD_TRANSACCION = MO.COD_TRA_PADRE
AND TH.COD_MODULO(+) = MO.COD_MODULO
AND TH.COD_MODALIDAD(+) = MO.COD_MODALIDAD
AND TH.COD_TRANSACCION(+) = MO.COD_TRANSACCION
AND CU.NRO_CUENTA(+)= MO.NRO_CUENTA
AND TH.VE_CLIENTE = 'S'
;
comment on column IT.XX_MOVIMIENTOS.USU_INSERCION is 'Usuario que realizo la Insercion del Registro.';
comment on column IT.XX_MOVIMIENTOS.FEC_INSERCION is 'Fecha en que se Inserto el Registro.';
comment on column IT.XX_MOVIMIENTOS.USU_MODIFICACION is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.XX_MOVIMIENTOS.FEC_MODIFICACION is 'Fecha en que se realizo la Ultima Modificacion en el Registro.';

