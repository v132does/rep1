CREATE OR REPLACE FORCE VIEW IT.GV_TRA_SUC_RES AS
SELECT T.COD_TRANSACCION,
       MAX(T.DESCRIPCION) DESCRIPCION,
       COUNT(1) CANTIDAD
  FROM GE_MOVIMIENTOS M, GE_TRANSACCIONES T
 WHERE M.COD_MODULO = T.COD_MODULO
   AND M.COD_MODALIDAD = T.COD_MODALIDAD
   AND M.COD_TRANSACCION = T.COD_TRANSACCION
   AND M.ESTADO = 'N'
   AND M.REVERSADO = 'N'
   AND M.MONTO IS NOT NULL
   AND M.NRO_CUENTA IS NOT NULL
 GROUP BY T.COD_TRANSACCION
 ORDER BY t.cod_transaccion, COUNT(1);

