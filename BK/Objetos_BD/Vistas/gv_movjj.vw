create or replace force view it.gv_movjj as
select
--Realizado por Nati Bendlin (Cleito) -- Simgia--2011
MOV.FECHA, MOV.HORA, MOV.COD_USUARIO, MOV.NRO_SECUENCIA, MOV.FEC_VALOR,
       MOV.MONTO, MOV.NRO_CUENTA, MOV.COD_MONEDA, MOV.COD_OFICINA, MOV.COD_ERROR,
       MOV.COD_RETENCION, MOV.FEC_FIN_RETENCION, MOV.EST_CUENTA, MOV.ESTADO,
       MOV.COD_CAUSA, MOV.COD_BANCO, MOV.COD_OFI_ORIGEN, MOV.CONCEPTO, MOV.COD_TASA,
       MOV.VAL_TASA, MOV.COD_RUBRO, MOV.COD_REF_CAMBIO, MOV.REVERSADO, MOV.COD_USU_REVERSION,
       MOV.HOR_REVERSION, MOV.EMI_AVISO, MOV.COD_TRA_PADRE, MOV.COD_MOD_PADRE, MOV.COD_MAD_PADRE,
       MOV.COD_TRANSACCION, MOV.COD_MODULO, MOV.COD_MODALIDAD, MOV.MTO_EQU_LOCAL, MOV.NRO_CAJA,
       MOV.COTIZACION, MOV.COD_BCO_CENTRAL, MOV.NRO_DOCUMENTO, MOV.NRO_DOCUMENTO2, MOV.NRO_DOCUMENTO3,
       MOV.NRO_DOCUMENTO4, MOV.PROTEGIDO, MOV.TIP_MOV_RUBRO, MOV.COD_AUTORIZACION, MOV.COD_USU_AUTORIZADOR,
       MOV.USU_INSERCION, MOV.FEC_INSERCION, MOV.USU_MODIFICACION, MOV.FEC_MODIFICACION, MOV.COD_TIP_OPE_CAMBIO,
       MOV.NRO_FOLIO, MOV.REFERENCIA,
/*       TP.DESCRIPCION DES_TRA_PADRE, TP.ABREVIATURA ABR_TRA_PADRE,
       TH.DESCRIPCION DES_TRANSACCION,
*/     --  DECODE(MOV.COD_TRANSACCION,515,'C',560,'C',TH.TIPO) COD_TIP_MOVIMIENTO,
       --DECODE(DECODE(MOV.COD_TRANSACCION,515,'C',560,'C',TH.TIPO), 'C', 'Credito', 'D', 'Debito', 'E', 'Cambio Estado') TIP_MOVIMIENTO,
  /*     UA.NOMBRE NOM_USU_AUTORIZADOR,
       UR.NOMBRE NOM_USU_REVERSION,
       UM.NOMBRE NOM_USUARIO,
       EC.DESCRIPCION DES_EST_CUENTA,
       BA.DESCRIPCION DES_BANCO,
       CA.DESCRIPCION DES_CAUSA,
       RU.DESCRIPCION DES_RUBRO,
       BO.DESCRIPCION DES_OFI_ORIGEN,
*/       MOV.TIPO,
       MOV.DES_TIPO,
 /*      CU.DENOMINACION DENOMINACION,
*/       MOV.COD_PERSONA COD_PERSONA,
       MOV.COD_SIT_CONTABLE COD_SIT_CONTABLE,
       MOV.NRO_CONCILIACION NRO_CONCILIACION
from (
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            MO.NRO_FOLIO, MO.REFERENCIA,
            'H' TIPO, -- HISTORICO
            'HISTORICO' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            MO.NRO_CONCILIACION NRO_CONCILIACION
     FROM AH_MOVIMIENTOS_HIS MO
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            MO.NRO_FOLIO, MO.REFERENCIA,
            'H' TIPO, -- HISTORICO
            'HISTORICO' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            MO.NRO_CONCILIACION NRO_CONCILIACION
     FROM CC_MOVIMIENTOS_HIS MO
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
            'H' TIPO, -- HISTORICO
            'HISTORICO' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            NULL NRO_CONCILIACION
     FROM PR_MOVIMIENTOS_HIS MO
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
            'H' TIPO, -- HISTORICO
            'HISTORICO' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            NULL NRO_CONCILIACION
     FROM TA_MOVIMIENTOS_HIS MO
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
            'H' TIPO, -- HISTORICO
            'HISTORICO' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            NULL NRO_CONCILIACION
     FROM LC_MOVIMIENTOS_HIS MO
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
            'H' TIPO, -- HISTORICO
            'HISTORICO' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            NULL NRO_CONCILIACION
     FROM CX_MOVIMIENTOS_HIS MO
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
            'D' TIPO, -- MOVIMIENTO DIARIO
            'DEL DIA' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            MO.NRO_CONCILIACION NRO_CONCILIACION
     FROM GE_MOVIMIENTOS MO, BA_MODULOS MD
     WHERE MD.COD_MODULO = 3 -- Ahorros
     AND MD.ESTADO != 4 --Este no va traer nunca nada
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
            'N' TIPO, -- NOCTURNO O FUERA DE HORA
            'FUERA DE HORA' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            NULL NRO_CONCILIACION
     FROM GE_MOVIMIENTOS_NOC MO
     -- Mesa de Dinero
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
            'H' TIPO, -- HISTORICO
            'HISTORICO' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            NULL NRO_CONCILIACION
     FROM MD_MOVIMIENTOS_HIS MO
     -- Operación Vencida
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
            'H' TIPO, -- HISTORICO
            'HISTORICO' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            NULL NRO_CONCILIACION
     FROM OV_MOVIMIENTOS_HIS MO
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
            'H' TIPO, -- HISTORICO
            'HISTORICO' DES_TIPO,
            MO.COD_PERSONA COD_PERSONA,
            MO.COD_SIT_CONTABLE COD_SIT_CONTABLE,
            NULL NRO_CONCILIACION
     FROM AF_MOVIMIENTOS_HIS MO
     UNION ALL
     select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
            MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
            MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
            MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
            MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
            MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
            MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
            MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
            MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
            MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
            TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
            'H' TIPO, -- HISTORICO
            'HISTORICO' DES_TIPO,
            null COD_PERSONA,
            null COD_SIT_CONTABLE,
            NULL NRO_CONCILIACION
     FROM GE_MOVIMIENTOS_HIS MO
) MOV,
GE_CUENTAS CU
WHERE
 MOV.NRO_CUENTA = CU.NRO_CUENTA(+)
;

