create or replace force view it.simgia_arma700_p1 as
select "M700SUC","M700CTA","M700SUB","NRO_CUENTA","M700NOMBRE","M700DIRECC","M700TELEFO","M700RIESGO","M700SMEANT","M700SACT","M700CTAHMN","M700TRASPA","M700ENTVEN","M700LIMISO","M700VTOLIM","M700NUMERO","M700IMPUE","M700APAXMA","M700CNTDEB","M700ANOPRO","M700SDMDSE","M700ACUDIA","M700SDOMDM","M700FECULT","M700SDONOD","M700BANLQ","M700FEINEX","FILLER","M700MAYSDO","M700AUMESO","M700FEINSO","M700SDMDAN","M700SERINS","M700CTAHME","M700TOTEM","M700TOTBLQ","M700IND1","M700IND2","M700IND3","M700IND4","M700APUNEM","M700APANL","M700APCHQ","M700APCONF","M700APBLQ","M700TOTDCN","M700TOTDCO","M700TOTCRP","M700APCR","M700MTRASP","M700TOTCFO","M700GRUPO","M700PLZADL","M700INCHQR","M700FINCHQ","FILLER2","M700CNTCRE","M700NRPROP","RNUM" from
/* p1 1 - 30 mil */
(select a.*, rownum rnum
from ( select * from simgia_arma700 ) a
where rownum <= 30000 )
where rnum >= 1;

