CREATE OR REPLACE FORCE VIEW IT.GV_SOL_PERSONAS
(cod_persona, nom_completo, tipo, tip_persona, nro_documento, nro_solicitud, cod_tip_documento, cod_per_deudor, cod_modulo, cod_modalidad, monto, cod_moneda, observacion, cod_cau_rechazo, fec_solicitud, cod_estado, usu_insercion, usu_modificacion, fec_insercion, fec_modificacion)
AS
SELECT EPERS.COD_PERSONA EPERS_COD_PERSONA
          ,EPERS.NOM_COMPLETO EPERS_NOM_COMPLETO
          , 'DEUDOR' TIPO
          ,EPERS.TIPO EPERS_TIPO
          ,EPERS.NRO_DOCUMENTO EPERS_NRO_DOCUMENTO
          ,GSOLI.NRO_SOLICITUD GSOLI_NRO_SOLICITUD
          ,EPERS.COD_TIP_DOCUMENTO EPERS_COD_TIP_DOCUMENTO
          ,GSOLI.COD_PERSONA GSOLI_COD_PERSONA
          ,GSOLI.COD_MODULO GSOLI_COD_MODULO
          ,GSOLI.COD_MODALIDAD GSOLI_COD_MODALIDAD
          ,GSOLI.MONTO GSOLI_MONTO
          ,GSOLI.COD_MONEDA GSOLI_COD_MONEDA
          ,GSOLI.OBSERVACION GSOLI_OBSERVACION
          ,GSOLI.COD_CAU_RECHAZO GSOLI_COD_CAU_RECHAZO
          ,GSOLI.FEC_SOLICITUD
          ,GSOLI.COD_ESTADO
           ,GSOLI.USU_INSERCION USU_INSERCION
          ,GSOLI.USU_MODIFICACION USU_MODIFICACION
          ,GSOLI.FEC_INSERCION FEC_INSERCION
          ,GSOLI.FEC_MODIFICACION FEC_MODIFICACION
FROM BA_PERSONAS EPERS
    ,GE_SOLICITUDES GSOLI
  WHERE epers.cod_persona = gsoli.cod_persona
UNION
SELECT EPERS.COD_PERSONA EPERS_COD_PERSONA
          ,EPERS.NOM_COMPLETO EPERS_NOM_COMPLETO
          ,'CODEUDOR' TIPO
          ,EPERS.TIPO EPERS_TIPO
          ,EPERS.NRO_DOCUMENTO EPERS_NRO_DOCUMENTO
          ,GSOLI.NRO_SOLICITUD GSOLI_NRO_SOLICITUD
          ,EPERS.COD_TIP_DOCUMENTO EPERS_COD_TIP_DOCUMENTO
          ,GSOLI.COD_PERSONA GSOLI_COD_PERSONA
          ,GSOLI.COD_MODULO GSOLI_COD_MODULO
          ,GSOLI.COD_MODALIDAD GSOLI_COD_MODALIDAD
          ,GSOLI.MONTO GSOLI_MONTO
          ,GSOLI.COD_MONEDA GSOLI_COD_MONEDA
          ,GSOLI.OBSERVACION GSOLI_OBSERVACION
          ,GSOLI.COD_CAU_RECHAZO GSOLI_COD_CAU_RECHAZO
          ,GSOLI.FEC_SOLICITUD
          ,GSOLI.COD_ESTADO
          ,GSCOD.USU_INSERCION USU_INSERCION
          ,GSCOD.USU_MODIFICACION USU_MODIFICACION
          ,GSCOD.FEC_INSERCION FEC_INSERCION
          ,GSCOD.FEC_MODIFICACION FEC_MODIFICACION
FROM BA_PERSONAS EPERS
    ,GE_SOLICITUDES GSOLI, GE_SOL_CODEUDORES GSCOD
  WHERE epers.cod_persona = gscod.cod_persona
    AND gscod.nro_solicitud = gsoli.nro_solicitud
    AND NOT EXISTS (SELECT '1'
                      FROM BA_VINCULOS V
                     WHERE V.COD_PERSONA = GSOLI.COD_PERSONA
                       AND V.COD_PER_VINCULO = GSCOD.COD_PERSONA)
UNION ALL
SELECT EPERS.COD_PERSONA EPERS_COD_PERSONA
          ,EPERS.NOM_COMPLETO EPERS_NOM_COMPLETO
          , 'CONYUGE' TIPO
          ,EPERS.TIPO EPERS_TIPO
          ,EPERS.NRO_DOCUMENTO EPERS_NRO_DOCUMENTO
          ,GSOLI.NRO_SOLICITUD GSOLI_NRO_SOLICITUD
          ,EPERS.COD_TIP_DOCUMENTO EPERS_COD_TIP_DOCUMENTO
          ,GSOLI.COD_PERSONA GSOLI_COD_PERSONA
          ,GSOLI.COD_MODULO GSOLI_COD_MODULO
          ,GSOLI.COD_MODALIDAD GSOLI_COD_MODALIDAD
          ,GSOLI.MONTO GSOLI_MONTO
          ,GSOLI.COD_MONEDA GSOLI_COD_MONEDA
          ,GSOLI.OBSERVACION GSOLI_OBSERVACION
          ,GSOLI.COD_CAU_RECHAZO GSOLI_COD_CAU_RECHAZO
          ,GSOLI.FEC_SOLICITUD
          ,GSOLI.COD_ESTADO
           ,GSOLI.USU_INSERCION USU_INSERCION
          ,GSOLI.USU_MODIFICACION USU_MODIFICACION
          ,GSOLI.FEC_INSERCION FEC_INSERCION
          ,GSOLI.FEC_MODIFICACION FEC_MODIFICACION
FROM BA_PERSONAS EPERS, GE_SOLICITUDES GSOLI, BA_VINCULOS V
WHERE EPERS.COD_PERSONA = V.COD_PER_VINCULO
AND GSOLI.COD_PERSONA = V.COD_PERSONA
AND V.TIPO = 'E'
AND V.COD_PER_VINCULO NOT IN (SELECT C.COD_PERSONA
                                FROM GE_SOL_CODEUDORES C
                               WHERE C.NRO_SOLICITUD = GSOLI.NRO_SOLICITUD)
UNION ALL
SELECT EPERS.COD_PERSONA EPERS_COD_PERSONA
          ,EPERS.NOM_COMPLETO EPERS_NOM_COMPLETO
          , 'COD.CONY.' TIPO
          ,EPERS.TIPO EPERS_TIPO
          ,EPERS.NRO_DOCUMENTO EPERS_NRO_DOCUMENTO
          ,GSOLI.NRO_SOLICITUD GSOLI_NRO_SOLICITUD
          ,EPERS.COD_TIP_DOCUMENTO EPERS_COD_TIP_DOCUMENTO
          ,GSOLI.COD_PERSONA GSOLI_COD_PERSONA
          ,GSOLI.COD_MODULO GSOLI_COD_MODULO
          ,GSOLI.COD_MODALIDAD GSOLI_COD_MODALIDAD
          ,GSOLI.MONTO GSOLI_MONTO
          ,GSOLI.COD_MONEDA GSOLI_COD_MONEDA
          ,GSOLI.OBSERVACION GSOLI_OBSERVACION
          ,GSOLI.COD_CAU_RECHAZO GSOLI_COD_CAU_RECHAZO
          ,GSOLI.FEC_SOLICITUD
          ,GSOLI.COD_ESTADO
           ,GSOLI.USU_INSERCION USU_INSERCION
          ,GSOLI.USU_MODIFICACION USU_MODIFICACION
          ,GSOLI.FEC_INSERCION FEC_INSERCION
          ,GSOLI.FEC_MODIFICACION FEC_MODIFICACION
FROM BA_PERSONAS EPERS, GE_SOLICITUDES GSOLI, BA_VINCULOS V
WHERE EPERS.COD_PERSONA = V.COD_PER_VINCULO
AND GSOLI.COD_PERSONA = V.COD_PERSONA
AND V.TIPO = 'E'
AND EXISTS (SELECT '1'
              FROM GE_SOL_CODEUDORES C
             WHERE C.NRO_SOLICITUD = GSOLI.NRO_SOLICITUD
               AND C.COD_PERSONA = V.COD_PER_VINCULO)
UNION
SELECT EPERS.COD_PERSONA EPERS_COD_PERSONA
          ,EPERS.NOM_COMPLETO EPERS_NOM_COMPLETO
          , 'CONY.CODE.' TIPO
          ,EPERS.TIPO EPERS_TIPO
          ,EPERS.NRO_DOCUMENTO EPERS_NRO_DOCUMENTO
          ,GSOLI.NRO_SOLICITUD GSOLI_NRO_SOLICITUD
          ,EPERS.COD_TIP_DOCUMENTO EPERS_COD_TIP_DOCUMENTO
          ,GSOLI.COD_PERSONA GSOLI_COD_PERSONA
          ,GSOLI.COD_MODULO GSOLI_COD_MODULO
          ,GSOLI.COD_MODALIDAD GSOLI_COD_MODALIDAD
          ,GSOLI.MONTO GSOLI_MONTO
          ,GSOLI.COD_MONEDA GSOLI_COD_MONEDA
          ,GSOLI.OBSERVACION GSOLI_OBSERVACION
          ,GSOLI.COD_CAU_RECHAZO GSOLI_COD_CAU_RECHAZO
          ,GSOLI.FEC_SOLICITUD
          ,GSOLI.COD_ESTADO
           ,GSOLI.USU_INSERCION USU_INSERCION
          ,GSOLI.USU_MODIFICACION USU_MODIFICACION
          ,GSOLI.FEC_INSERCION FEC_INSERCION
          ,GSOLI.FEC_MODIFICACION FEC_MODIFICACION
FROM BA_PERSONAS EPERS, GE_SOLICITUDES GSOLI, BA_VINCULOS V, GE_SOL_CODEUDORES GSCOD
WHERE GSOLI.NRO_SOLICITUD = GSCOD.NRO_SOLICITUD
AND EPERS.COD_PERSONA != GSOLI.COD_PERSONA
AND EPERS.COD_PERSONA = V.COD_PER_VINCULO
AND GSCOD.COD_PERSONA = V.COD_PERSONA
AND V.TIPO = 'E'
AND V.COD_PER_VINCULO NOT IN (SELECT C.COD_PERSONA
                                FROM GE_SOL_CODEUDORES C
                               WHERE C.NRO_SOLICITUD = GSOLI.NRO_SOLICITUD)
UNION
SELECT EPERS.COD_PERSONA EPERS_COD_PERSONA
          ,EPERS.NOM_COMPLETO EPERS_NOM_COMPLETO
          , 'ADICIONAL' TIPO
          ,EPERS.TIPO EPERS_TIPO
          ,EPERS.NRO_DOCUMENTO EPERS_NRO_DOCUMENTO
          ,GSOLI.NRO_SOLICITUD GSOLI_NRO_SOLICITUD
          ,EPERS.COD_TIP_DOCUMENTO EPERS_COD_TIP_DOCUMENTO
          ,GSOLI.COD_PERSONA GSOLI_COD_PERSONA
          ,GSOLI.COD_MODULO GSOLI_COD_MODULO
          ,GSOLI.COD_MODALIDAD GSOLI_COD_MODALIDAD
          ,GSOLI.MONTO GSOLI_MONTO
          ,GSOLI.COD_MONEDA GSOLI_COD_MONEDA
          ,GSOLI.OBSERVACION GSOLI_OBSERVACION
          ,GSOLI.COD_CAU_RECHAZO GSOLI_COD_CAU_RECHAZO
          ,GSOLI.FEC_SOLICITUD
          ,GSOLI.COD_ESTADO
           ,GSOLI.USU_INSERCION USU_INSERCION
          ,GSOLI.USU_MODIFICACION USU_MODIFICACION
          ,GSOLI.FEC_INSERCION FEC_INSERCION
          ,GSOLI.FEC_MODIFICACION FEC_MODIFICACION
FROM BA_PERSONAS EPERS, GE_SOLICITUDES GSOLI, GE_SOL_ADICIONALES GSCOD
WHERE GSOLI.NRO_SOLICITUD = GSCOD.NRO_SOLICITUD
AND EPERS.COD_PERSONA = GSCOD.COD_PERSONA
ORDER BY 3 desc, 2;
comment on column IT.GV_SOL_PERSONAS.USU_INSERCION is 'Usuario que realizo la Insercion del Registro.';
comment on column IT.GV_SOL_PERSONAS.USU_MODIFICACION is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.GV_SOL_PERSONAS.FEC_INSERCION is 'Fecha en que se Inserto el Registro.';
comment on column IT.GV_SOL_PERSONAS.FEC_MODIFICACION is 'Fecha en que se realizo la Ultima Modificacion en el Registro.';

