create or replace force view it.gv_pos_clientes as
select FECHA,
to_number(cod_reporte) cod_reporte, fue_obt_des_refcodes('COD_REP_POS_CLIENTE',COD_REPORTE) reporte,
COD_USU_OFICIAL,
NOM_OFICIAL,
COD_PERSONA,
NOM_COMPLETO,
NRO_CUENTA,
COD_MONEDA,
'Can_Dias: '||TO_CHAR(CAN_DIAS) A,
CAN_DIAS_SOBREGIRO,
'MTO_LIN_PERMANENTE: '||TO_CHAR(MTO_LIN_PERMANENTE) B,
'FEC_VTO_LIN_PERMANENTE: '||TO_CHAR(FEC_VTO_LIN_PERMANENTE) C,
'Mto_lin_temporal: '||MTO_LIN_TEMPORAL D,
'FEC_VTO_LIN_TEMPORAL: '||FEC_VTO_LIN_TEMPORAL E,
'SALDO: '||TO_CHAR(SALDO) F ,
null TELEFONO,
null TIPO,
null G,
null H,
null I,
null Cod_tra_padre,
null desc_Tra_padre,
null cod_transaccion,
null desc_transaccion,
null J,
null cod_oficina,
null cod_modalidad,
null des_modalidad
from ge_pos_clientes_det a
where a.cod_reporte = 1

union
select FECHA,
to_number(cod_reporte) cod_reporte,
fue_obt_des_refcodes('COD_REP_POS_CLIENTE',COD_REPORTE) reporte,
