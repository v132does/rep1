'Dia_mora: '||to_char(DIA_MORA),
0,
'Sal_cap_cuota: '||to_char(SAL_CAP_CUOTA),
'Fec_ven_cuota :'||to_char(FEC_VEN_CUOTA),
'SAL_CAP_OPERACION: '||TO_CHAR(SAL_CAP_OPERACION),
'FEC_VENCIMIENTO '||TO_CHAR(FEC_VENCIMIENTO),
'0',
TELEFONO,
TIPO,
'ESTADO: '||ESTADO,
'CUOTA: '||CUOTA,
null,
null,
null,
null,
null,
null,
null,
null,
null
from ge_pos_clientes_det
where cod_reporte = 2


