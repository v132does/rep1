CREATE OR REPLACE FORCE VIEW IT.GV_TIP_ASI_TRANSACCIONES AS
SELECT GTASI.COD_TIP_ASIENTO COD_TIP_ASIENTO
          ,GTASI.NRO_LINEA NRO_LINEA
          ,GTASI.COD_RUBRO COD_RUBRO
          ,GTASI.DESCRIPCION DES_TIP_ASIENTO
          ,GTASI.TIP_MOVIMIENTO TIP_MOVIMIENTO
          ,GTASI.COD_MONEDA COD_MONEDA
          ,GTASI.COD_SEC_CONTABLE COD_SEC_CONTABLE
          ,GTASI.IND_RESIDENTE IND_RESIDENTE
          ,GTASI.IND_DEUDOR IND_DEUDOR
          ,GTASI.IND_PLAZO IND_PLAZO
          ,GTASI.IND_PRODUCTO IND_PRODUCTO
          ,GTRAN.COD_TRANSACCION COD_TRANSACCION
          ,GTRAN.COD_MODULO COD_MODULO
          ,GTRAN.COD_MODALIDAD COD_MODALIDAD
          ,GTRAN.DESCRIPCION DES_TRANSACCION
          ,GTRAN.TIPO AFECTA
          ,GTRAN.AFECTA TIPO
          ,GTRAN.ABREVIATURA ABREVIATURA
          ,GTASI.USU_INSERCION USU_INSERCION
          ,GTASI.FEC_INSERCION FEC_INSERCION
          ,GTASI.USU_MODIFICACION USU_MODIFICACION
          ,GTASI.FEC_MODIFICACION FEC_MODIFICACION
          ,X.DESCRIPCION DES_SIT_CONTABLE
FROM GE_TRANSACCIONES GTRAN
    ,GE_TIP_ASIENTOS GTASI,
    (SELECT codigo, descripcion FROM TABLE(IT.PAB_ASI.FU_LIS_SIT_CONTABLE())) X
    WHERE GTASI.COD_TIP_ASIENTO = GTRAN.COD_TIP_ASIENTO
      AND X.CODIGO(+) = GTASI.COD_SIT_CONTABLE;

