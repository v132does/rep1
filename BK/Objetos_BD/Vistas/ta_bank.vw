create or replace force view it.ta_bank as
select "ID_TRANSACCION","INSERT_DATETIME","TICKET_NUMBER","TRANSACTION_DATE","COMMERCE_NAME","AUTHORIZATION_NUMBER","ENTITY_CODE","CARD_NUMBER","CURRENCY_CODE","COUNTRY_CODE","TRANSACTION_AMOUNT","RESPONSE_CODE","ORIGIN_CODE","DEVICE_TYPE","SERVICE_CODE","PROVIDE_SERVICE_CODE","MCC_CODE","TRANSACTION_TYPE","PAYMENT_SOURCE","USU_INSERCION","FEC_INSERCION","USU_MODIFICACION","FEC_MODIFICACION" from IT.ta_ban_transaciones_his t where  t.insert_datetime >= '01/07/2019';

