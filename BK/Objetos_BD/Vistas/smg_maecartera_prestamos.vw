CREATE OR REPLACE FORCE VIEW IT.SMG_MAECARTERA_PRESTAMOS AS
SELECT m.nro_cuenta "NRO_CUENTA",
       NULL "PASA_A_IT",
       null "CONT",
       null "NURIES",
       null "CONGRU",
       null "VENCIM",
       null "NUDOC",
       null "TIPOD",
       null "FECHAEMISI",
       null "SUCURSALFU",
       null "SUCURSALCU",
       null "PROPUESTA",
       null "GUARANIES",
       null "CODTASA",
       null "CONTRAVALO",
       null "NROLIBRADO",
       null "GASTOSGC",
       null "VCTOINT",
       null "IADMONTODC",
       null "IADSALDOCP",
       null "IADMETODO",
       null "IADFEINI",
       null "IADDIAS",
       null "IADINTERES",
       null "IADADEV",
       null "IADDIVISA",
       null "IADNROCUO",
       null "IADCODTASA",
       null "CTADOCACT",
       null "CTADOCPAS",
       null "CTANDOCACT",
       null "CTANDOCORD",
       null "CTANDOCORH",
       null "FILLER" --,p.plantitulo
  FROM pr_cta_prestamos m
;

