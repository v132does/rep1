        NULL as FEC_CANCELACION,
        NULL  ESTADO,
        0 as MTO_CAPITAL,
        0 as SAL_CAPITAL,
        0 as SAL_INTERES,
        0 as VAL_INT_DEVENGAR,
         null as NRO_SOLICITUD,
        NULL EST_BATCH,
        0 as SAL_CAP_BATCH,
        0 as SAL_INT_BATCH,
         NULL as NRO_DOCUMENTO,
         NULL as EST_ANTERIOR,
         0 as DEV_ACUMULADO,
         NULL as NRO_SOL_RENOVADA,
         NULL COB_AUTOMATICO,
         0 as SAL_INT_ADELANTADO,
         null as FEC_ULT_DEVENGADO,
         0 as DEV_NO_COBRADO,
         li.nro_linea as NRO_LINEA,
         NULL as COD_MONEDA,
         0 as MONTO,
         NULL as FEC_INICIO,
         NULL as FEC_VENCIMIENTO,
         NULL as TIPO,
         NULL as VAL_TASA,
         NULL as CAN_CUOTAS,
         1 as CAN_CUO_PAGADAS,
         null as DIA_ATRASO,--Campo calculado
         null as MAX_ATRASO,--Campo calculado
         null as PRO_ATRASO,--Campo calculado
         NULL as EXO_IMPUESTOS,
         null as COD_CAUSA,
         null as COD_CANAL,
         null as COD_CAMPANA,
         NULL as COD_SEC_CREDITO,
         NULL as DESCRIPCION,
         NULL as TIP_DESTINO,
         NULL as TIP_INTERES,
         NULL as MTO_LIN_APLICADO,
         NULL as  TIP_RENOVACION,
         NULL as SAL_INT_ADE_BATCH,
        NULL as COD_ORI_FONDO,
        0 as PER_VTO_CAPITAL,
        0 as PER_VTO_INTERES,
        null as DEV_SUSPENSO,
        NULL  as EN_JUICIO,
        null as FEC_JUICIO,
        null as COD_ENT_JUICIO,
        null as CAT_RENOVACIONES,
