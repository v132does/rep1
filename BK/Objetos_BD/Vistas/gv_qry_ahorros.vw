create or replace force view it.gv_qry_ahorros as
Select CTA.NRO_CUENTA, CLI.COD_PERSONA, CTA.DENOMINACION, CTA.COD_MONEDA, det.fec_apertura fec_inicio, CLI.RELACION, --ahorros vista
       CTA.COD_MODULO, CTA.COD_MODALIDAD, CTA.ESTADO, EST.DESCRIPCION, EST.ACTIVO,
       CASE
              WHEN DET.COD_SUB_MODALIDAD = 29 THEN 
               'CUENTA INTERNA BOLSA METAS'          
               WHEN EXISTS (SELECT 1 FROM GE_CTA_DAT_ADICIONALES A WHERE A.PARAMETRO='CTA_BILLETERA' AND A.VAL_PARAMETRO='S' AND A.NRO_CUENTA=DET.NRO_CUENTA AND DET.COD_MODULO =3 AND DET.COD_MODALIDAD=31 AND DET.COD_SUB_MODALIDAD=26) THEN
                   MAD.DESCRIPCION ||' (BILLETERA TIGO)'
               ELSE
                  MAD.DESCRIPCION
           END SC_NMMODAL,
       --MAD.DESCRIPCION SC_NMMODAL,
        DET.CTA_COMBINADA cta_combinada, NULL serie, NULL nro_certificado
  from GE_MODALIDADES MAD,GE_EST_CUENTAS EST, ah_cta_vistas det, GE_CUENTAS CTA, GE_CTA_CLIENTES CLI
 where EST.COD_MODULO = CTA.COD_MODULO
   AND EST.COD_MODALIDAD = CTA.COD_MODALIDAD
   AND EST.ESTADO = CTA.ESTADO
   AND CTA.NRO_CUENTA = CLI.NRO_CUENTA
   AND MAD.COD_MODULO = CTA.COD_MODULO
   AND MAD.COD_MODALIDAD = CTA.COD_MODALIDAD
   and cta.nro_cuenta = det.nro_cuenta
union all
--cda
Select CTA.NRO_CUENTA,CLI.COD_PERSONA,
       CTA.DENOMINACION, CTA.COD_MONEDA, cda.fec_apertura fec_inicio, CLI.RELACION,
       CTA.COD_MODULO, CTA.COD_MODALIDAD, CTA.ESTADO, EST.DESCRIPCION, EST.ACTIVO,
       MAD.DESCRIPCION SC_NMMODAL, null cta_combinada, cda.serie serie, cda.nro_certificado nro_certificado
  from GE_MODALIDADES MAD,GE_EST_CUENTAS EST, ah_cta_certificados cda, GE_CUENTAS CTA, GE_CTA_CLIENTES CLI
 where EST.COD_MODULO = CTA.COD_MODULO
   AND EST.COD_MODALIDAD = CTA.COD_MODALIDAD
   AND EST.ESTADO = CTA.ESTADO
   AND CTA.NRO_CUENTA = CLI.NRO_CUENTA
   AND MAD.COD_MODULO = CTA.COD_MODULO
   AND MAD.COD_MODALIDAD = CTA.COD_MODALIDAD
   and cta.nro_cuenta = cda.nro_cuenta
union all
--ahorro Plazo
Select CTA.NRO_CUENTA,CLI.COD_PERSONA,
       CTA.DENOMINACION, CTA.COD_MONEDA, plz.fec_apertura fec_inicio, CLI.RELACION,
       CTA.COD_MODULO, CTA.COD_MODALIDAD, CTA.ESTADO, EST.DESCRIPCION, EST.ACTIVO,
       MAD.DESCRIPCION SC_NMMODAL, null cta_combinada, null serie, null nro_certificado
  from GE_MODALIDADES MAD,GE_EST_CUENTAS EST, ah_cta_plazos plz, GE_CUENTAS CTA, GE_CTA_CLIENTES CLI
 where EST.COD_MODULO = CTA.COD_MODULO
   AND EST.COD_MODALIDAD = CTA.COD_MODALIDAD
   AND EST.ESTADO = CTA.ESTADO
   AND CTA.NRO_CUENTA = CLI.NRO_CUENTA
   AND MAD.COD_MODULO = CTA.COD_MODULO
   AND MAD.COD_MODALIDAD = CTA.COD_MODALIDAD
   and cta.nro_cuenta = plz.nro_cuenta
;
/
