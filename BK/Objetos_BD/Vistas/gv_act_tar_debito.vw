CREATE OR REPLACE VIEW IT.GV_ACT_TAR_DEBITO
(FECHA, HORA, COD_USUARIO, NRO_SECUENCIA, FEC_VALOR,
 MONTO, NRO_CUENTA, COD_MONEDA, COD_OFICINA, COD_ERROR,
 COD_RETENCION, FEC_FIN_RETENCION, EST_CUENTA, ESTADO, COD_CAUSA,
 COD_BANCO, COD_OFI_ORIGEN, CONCEPTO, COD_TASA, VAL_TASA,
 COD_RUBRO, COD_REF_CAMBIO, REVERSADO, COD_USU_REVERSION, HOR_REVERSION,
 EMI_AVISO, COD_TRA_PADRE, COD_MOD_PADRE, COD_MAD_PADRE, COD_TRANSACCION,
 COD_MODULO, COD_MODALIDAD, MTO_EQU_LOCAL, NRO_CAJA, COTIZACION,
 COD_BCO_CENTRAL, NRO_DOCUMENTO, NRO_DOCUMENTO2, NRO_DOCUMENTO3, NRO_DOCUMENTO4,
 PROTEGIDO, TIP_MOV_RUBRO, COD_AUTORIZACION, COD_USU_AUTORIZADOR, USU_INSERCION,
 FEC_INSERCION, USU_MODIFICACION, FEC_MODIFICACION, COD_TIP_OPE_CAMBIO, NRO_FOLIO,
 REFERENCIA, TIPO, DES_TIPO, COD_PERSONA, COD_SIT_CONTABLE)
AS
select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
        MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
        MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
        MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
        MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
        MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
        MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
        MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
        MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
        MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
        MO.NRO_FOLIO, MO.REFERENCIA,
        'H' TIPO, -- HISTORICO
        'HISTORICO' DES_TIPO,
        MO.COD_PERSONA COD_PERSONA,
        MO.COD_SIT_CONTABLE COD_SIT_CONTABLE
   FROM AH_MOVIMIENTOS_HIS MO
  WHERE MO.COD_MODULO = 3
    AND MO.COD_MODALIDAD IN( 31, 334 )
    AND MO.COD_TRA_PADRE = 380
 UNION ALL
 select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
        MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
        MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
        MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
        MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
        MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
        MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
        MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
        MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
        MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
        TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
        'D' TIPO, -- MOVIMIENTO DIARIO
        'DEL DIA' DES_TIPO,
        MO.COD_PERSONA COD_PERSONA,
        MO.COD_SIT_CONTABLE COD_SIT_CONTABLE
   FROM GE_MOVIMIENTOS MO
  WHERE MO.COD_MODULO = 3
    AND MO.COD_MODALIDAD IN( 31, 334 )
    AND MO.COD_TRA_PADRE = 380
 UNION ALL
 select MO.FECHA, MO.HORA, MO.COD_USUARIO, MO.NRO_SECUENCIA, MO.FEC_VALOR,
        MO.MONTO, MO.NRO_CUENTA, MO.COD_MONEDA, MO.COD_OFICINA, MO.COD_ERROR,
        MO.COD_RETENCION, MO.FEC_FIN_RETENCION, MO.EST_CUENTA, MO.ESTADO,
        MO.COD_CAUSA, MO.COD_BANCO, MO.COD_OFI_ORIGEN, MO.CONCEPTO, MO.COD_TASA,
        MO.VAL_TASA, MO.COD_RUBRO, MO.COD_REF_CAMBIO, MO.REVERSADO, MO.COD_USU_REVERSION,
        MO.HOR_REVERSION, MO.EMI_AVISO, MO.COD_TRA_PADRE, MO.COD_MOD_PADRE, MO.COD_MAD_PADRE,
        MO.COD_TRANSACCION, MO.COD_MODULO, MO.COD_MODALIDAD, MO.MTO_EQU_LOCAL, MO.NRO_CAJA,
        MO.COTIZACION, MO.COD_BCO_CENTRAL, MO.NRO_DOCUMENTO, MO.NRO_DOCUMENTO2, MO.NRO_DOCUMENTO3,
        MO.NRO_DOCUMENTO4, MO.PROTEGIDO, MO.TIP_MOV_RUBRO, MO.COD_AUTORIZACION, MO.COD_USU_AUTORIZADOR,
        MO.USU_INSERCION, MO.FEC_INSERCION, MO.USU_MODIFICACION, MO.FEC_MODIFICACION, MO.COD_TIP_OPE_CAMBIO,
        TO_NUMBER(NULL) NRO_FOLIO, MO.REFERENCIA,
        'N' TIPO, -- NOCTURNO O FUERA DE HORA
        'FUERA DE HORA' DES_TIPO,
        MO.COD_PERSONA COD_PERSONA,
        MO.COD_SIT_CONTABLE COD_SIT_CONTABLE
   FROM GE_MOVIMIENTOS_NOC MO
  WHERE MO.COD_MODULO = 3
    AND MO.COD_MODALIDAD IN( 31, 334 )
    AND MO.COD_TRA_PADRE = 380;
