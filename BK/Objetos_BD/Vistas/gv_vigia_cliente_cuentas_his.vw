
CREATE OR REPLACE FORCE EDITIONABLE VIEW "IT"."GV_VIGIA_CLIENTE_CUENTAS_HIS" (
    "COD_TIPO_RELACION", 
    "NRO_CLIENTE", 
    "NRO_CUENTA", 
    "VIGENCIA_DESDE", 
    "VIGENCIA_HASTA", 
    "NROTARJETA", 
    "TITULARIDAD", 
    "FEC_PROCESO"
) AS 
SELECT 
    COD_TIPO_RELACION, 
    NRO_CLIENTE, 
    NRO_CUENTA, 
    VIGENCIA_DESDE, 
    VIGENCIA_HASTA, 
    NROTARJETA, 
    TITULARIDAD, 
    FEC_PROCESO
FROM (
    SELECT
        CL.RELACION AS COD_TIPO_RELACION,
        CL.COD_PERSONA AS NRO_CLIENTE,
        CL.NRO_CUENTA AS NRO_CUENTA,
        -- Uso de NVL para simplificar la lógica de fecha
        NVL(TO_CHAR(CU.FEC_APERTURA, 'YYYY-MM-DD'), TO_CHAR(PAG_CAL.FU_OBT_FEC_ACTUAL(6), 'YYYY-MM-DD')) AS VIGENCIA_DESDE,
        NULL AS VIGENCIA_HASTA, 
        NULL AS NROTARJETA,
        NULL AS TITULARIDAD,
        -- Lógica de exclusión optimizada
        CASE 
            WHEN CU.COD_MODULO = 3 AND CU.COD_MODALIDAD NOT IN (33, 36) AND CU.ESTADO IN ('CX','X','TX') THEN 'EX'
            WHEN CU.COD_MODULO = 4 AND CU.ESTADO IN ('CX', 'I') THEN 'EX'
            WHEN CU.COD_MODULO = 5 AND CU.ESTADO = 'CX' THEN 'EX'
            WHEN CU.COD_MODULO IN (6, 10) AND CU.ESTADO = 'N' THEN 'EX'
            WHEN CU.COD_MODULO = 15 AND CU.ESTADO = 'C' THEN 'EX' 
            ELSE 'SI' 
        END AS DAT, 
        PAG_CAL.FU_OBT_FEC_ACTUAL(6) AS FEC_PROCESO
    FROM GE_CTA_CLIENTES CL
    JOIN GE_CUENTAS CU 
        ON CU.NRO_CUENTA = CL.NRO_CUENTA 
       AND CU.COD_MODULO = CL.COD_MODULO 
       AND CU.COD_MODALIDAD = CL.COD_MODALIDAD
    WHERE CL.COD_MODULO IN (3, 4, 5, 6, 7, 10, 15, 35) 
      AND NVL(CL.EST_RELACION, '0') <> 'I'
      -- Reemplazo de NOT EXISTS por filtro directo si la persona 1 
      AND CL.COD_PERSONA <> 1 
)
WHERE DAT = 'SI';