create or replace force view it.cv_agendas as
select
COD_AGENDA	,
COD_PERSONA	,
COD_USU_ENCARGADO	,
COD_ACTIVIDAD	,
COD_ESTADO	,
COD_MOT_ACTIVIDAD	,
FEC_ACTIVIDAD	,
CAN_REPROGRAMACIONES	,
DET_ACTIVIDAD	,
FEC_REALIZACION	,
FEC_VENCIMIENTO	,
REVISADO	,
DET_RESPUESTA	,
AUTOMATICO	,
COD_CAMPANA	,
COD_AGE_ANTERIOR	,
NRO_REFERENCIA	,
USU_INSERCION	,
FEC_INSERCION	,
USU_MODIFICACION	,
FEC_MODIFICACION	,
COD_CANAL	,
NRO_ORDEN	,
COD_RESPUESTA	,
DIA_ATRASO	,
MTO_MORA	,
FEC_INI_ASIGNACION
FROM CR_AGENDAS
UNION
select
COD_AGENDA	,
COD_PERSONA	,
COD_USU_ENCARGADO	,
COD_ACTIVIDAD	,
COD_ESTADO	,
COD_MOT_ACTIVIDAD	,
FEC_ACTIVIDAD	,
CAN_REPROGRAMACIONES	,
DET_ACTIVIDAD	,
FEC_REALIZACION	,
FEC_VENCIMIENTO	,
REVISADO	,
DET_RESPUESTA	,
AUTOMATICO	,
COD_CAMPANA	,
COD_AGE_ANTERIOR	,
NRO_REFERENCIA	,
USU_INSERCION	,
FEC_INSERCION	,
USU_MODIFICACION	,
FEC_MODIFICACION	,
COD_CANAL	,
NRO_ORDEN	,
COD_RESPUESTA	,
DIA_ATRASO	,
MTO_MORA	,
FEC_INI_ASIGNACION
FROM CR_AGENDAS_HIS;
comment on column IT.CV_AGENDAS.USU_INSERCION is 'Usuario que realizo la Insercion del Registro.';
comment on column IT.CV_AGENDAS.FEC_INSERCION is 'Fecha en que se Inserto el Registro.';
comment on column IT.CV_AGENDAS.USU_MODIFICACION is 'Usuario que realizo la ultima modificacion en el registro.';
comment on column IT.CV_AGENDAS.FEC_MODIFICACION is 'Fecha en que se realizo la Ultima Modificacion en el Registro.';

