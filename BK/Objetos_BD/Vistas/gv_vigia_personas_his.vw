
CREATE OR REPLACE FORCE EDITIONABLE VIEW "IT"."GV_VIGIA_PERSONAS_HIS"  (
"NRO_CLIENTE", "TIPO_PERSONA", "APELLIDO", "SEGUNDO_APELLIDO", "PRIMER_NOMBRE", "SEGUNDO_NOMBRE", "RAZON_SOCIAL", "COD_ALTERNATIVO_CLIENTE", "SEXO", "TIPO_DOCUMENTO_1", "NRO_DOCUMENTO_1", "DOC_EXPEDIDO_POR_1",
 "FECHA_EXPEDICION_1", "TIPO_DOCUMENTO_2", "NRO_DOCUMENTO_2", "DOC_EXPEDIDO_POR_2", "FECHA_EXPEDICION_2", "TIPO_DOCUMENTO_3",  "NRO_DOCUMENTO_3", "DOC_EXPEDIDO_POR_3", "FECHA_EXPEDICION_3", "TIPO_DOCUMENTO_4", "NRO_DOCUMENTO_4", "DOC_EXPEDIDO_POR_4",
 "FECHA_EXPEDICION_4", "FECHA_CONSTITUCION", "FECHA_NACIMIENTO", "LUGAR_NACIMIENTO", "COD_PAIS", "NACIONALIDAD", "ESTADO_CIVIL", "COD_ACTIVIDAD", "COD_PROFESION", "COD_FORMA_JURIDICA", 
 "TIPO_CLIENTE", "COMUNICADO", "CONOCIMIENTO_CLIENTE",  "INGRESO_ANUAL_DECLARADO", "DP_ACTIVO", "DP_INGRESOS", "DP_PASIVO", "DP_PATRIMONIO_NETO", "COD_SUCURSAL",  "ES_EMPLEADO", "EMPLEADO_DEPARTAMENTO", "EMPLEADO_STATUS",
 "ES_INST_FINANCIERA", "ES_INST_PUBLICA", "FECHA_ALTA", "FECHA_BAJA", "FECHA_CAMBIODATO_A", "FECHA_CAMBIODATO_B", "FECHA_CAMBIODATO_C", "FECHA_CAMBIODATO_D", "FECHA_ACTUALIZ_DATOS", "FECHA_ACTUALIZACION", "FECHA_RIESGO",
 "ID_METODO_VERIF_IDENTIDAD", "NOMBRE_CONTACTO", "OFICIAL_ATENCION", "ES_PEP", "RESIDENCIA", "TIPO_RESIDENCIA", "NRO_PERMISORES", "COD_PAIS_RESIDENCIA", "TIPO_SITUACION_FISCAL", "OBSERVACIONES", "MAXATRANSAR", "MINATRANSAR",
 "TIPO_TRATAMIENTO", "SEGMENTO", "NOMBRE_FANTASIA", "PT_MONTO_CALCULADO", "PT_MONTO_INFORMADO", "PT_MANUAL_AUTOMATICO", "ES_SUJETO_OBLIGADO", "SO_CUMPLE_OBLIGACION", "CODSECTORCLIENTE", "SC51", "SC52", "SC53", "LINEA_DE_NEGOCIO",
 "CODACTIVIDADAFIP", "CODACTIVIDADSEC", "CIERREBALANCE", "CODTIPOORIGENALTA", "FECHAINICIOACTIVIDAD", "FECHAVENCESTATUTO", "FECHADECESO", "INSCRIPCION_CODORG", "INSCRIPCION_FECHA", "INSCRIPCION_FOLIO", "INSCRIPCION_NRO", "INSCRIPCION_TOMO",
 "ADMINISTRA_FONDOS_3RO", "NOMBRE_CONYUGE", "TIPO_DIRECCION", "CALLE", "NUMERO", "OFICINA", "PISO", "NOMBRE_EDIFICIO", "BARRIO", "CIUDAD", "COD_CIUDAD", "DEPARTAMENTO", "COD_DE_DEPARTAMENTO", "COD_DISTRITO", "COD_PAIS_DOMICILIO", "COD_POSTAL", 
 "CORREO_ELECTRONICO", "DIR_WEB", "FAX", "TELEFONO", "TELEFONO_1", "TELEFONO_2", "TEL_MOVIL", "INFOADICIONAL1", "GE_CLIENTE", "FEC_PROCESO") AS 
  
WITH 
-- 1. Optimización de Vínculos (Último registro)
UltimoVinculo AS (
    SELECT COD_PERSONA, COD_PER_VINCULO,
           ROW_NUMBER() OVER (PARTITION BY COD_PERSONA ORDER BY FEC_INSERCION DESC, COD_PER_VINCULO DESC) as rnk
    FROM BA_VINCULOS 
    WHERE TIPO = 'E' AND ACTIVO = 'S'
),
-- 2. Optimización de Info Laboral (Actual)
LaboralActual AS (
    SELECT COD_PERSONA, TIP_CARGO, COD_RAMO, MTO_INGRESO,
           ROW_NUMBER() OVER (PARTITION BY COD_PERSONA ORDER BY NRO_SECUENCIA DESC) as rnk
    FROM CR_INF_LABORALES 
    WHERE ACTUAL = 'S'
),
-- 3. Optimización de Límites (Último registro por Persona)
UltimoLimite AS (
    SELECT COD_PERSONA, MTO_LIMITE, COD_MONEDA,
           ROW_NUMBER() OVER (PARTITION BY COD_PERSONA ORDER BY ROWID DESC) as rnk
    FROM CR_PER_TIP_OPERACIONES
),
-- 4. Consolidación de Teléfonos (Evita subconsultas en el SELECT)
TelefonosConsolidados AS (
    SELECT COD_PERSONA,
           MAX(CASE WHEN PRINCIPAL = 'S' THEN AREA || TELEFONO END) as TEL_PRINCIPAL,
           MAX(CASE WHEN TIPO = 'P' THEN AREA || TELEFONO END) as TEL_P,
           MAX(CASE WHEN TIPO = 'L' THEN AREA || TELEFONO END) as TEL_L,
           MAX(CASE WHEN TIP_LINEA = 'C' THEN AREA || TELEFONO END) as TEL_MOVIL
    FROM (
        SELECT T.*, ROW_NUMBER() OVER (PARTITION BY COD_PERSONA, TIPO, TIP_LINEA ORDER BY COD_TELEFONO DESC) as rnk_t
        FROM BA_TELEFONOS T
    ) WHERE rnk_t = 1
    GROUP BY COD_PERSONA
),
-- 5. Parámetros Adicionales (Sujeto Obligado y Diligencia)
DatosAdicionales AS (
    SELECT COD_PERSONA,
           MAX(CASE WHEN PARAMETRO = 'PER_IND_SUJ_OBLIGADO' THEN NVL(VAL_PARAMETRO,'N') END) as ES_SO,
           MAX(CASE WHEN PARAMETRO = 'PER_IND_DEB_DIL_AMPLIADA' THEN NVL(VAL_PARAMETRO,'N') END) as SC53
    FROM BA_PER_DAT_ADICIONALES
    WHERE PARAMETRO IN ('PER_IND_SUJ_OBLIGADO', 'PER_IND_DEB_DIL_AMPLIADA')
    GROUP BY COD_PERSONA
),

-- 6. Conteo de Productos (Simplificado para evitar duplicidad de JOINs)
POC_CTE AS (
    SELECT F.COD_PERSONA, P.NRO_DOCUMENTO, P.TIPO, P.NOM_COMPLETO, 
           (G.COD_SEG_CLIENTE || '-' || S.DESCRIPCION) AS SEGMENTO,
           SUM(F.CANTIDAD) AS PROD_ACT
    FROM (
        SELECT COUNT(*) CANTIDAD, G.COD_PERSONA FROM GE_CTA_CLIENTES G INNER JOIN PR_CTA_PRESTAMOS PR ON PR.NRO_CUENTA = G.NRO_CUENTA WHERE PR.ESTADO <> 'N' GROUP BY G.COD_PERSONA
        UNION ALL
        SELECT COUNT(*) CANTIDAD, G.COD_PERSONA FROM GE_CTA_CLIENTES G INNER JOIN TA_CTA_TARJETAS TA ON TA.NRO_CUENTA = G.NRO_CUENTA WHERE TA.ESTADO <> 'C' GROUP BY G.COD_PERSONA
        UNION ALL
        SELECT COUNT(*) CANTIDAD, G.COD_PERSONA FROM GE_CTA_CLIENTES G INNER JOIN AH_CTA_CERTIFICADOS CDA ON CDA.NRO_CUENTA = G.NRO_CUENTA WHERE CDA.ESTADO NOT IN ('T','X','C') GROUP BY G.COD_PERSONA
        UNION ALL
        SELECT COUNT(*) CANTIDAD, G.COD_PERSONA FROM GE_CTA_CLIENTES G INNER JOIN AH_CTA_VISTAS CAH ON CAH.NRO_CUENTA = G.NRO_CUENTA WHERE CAH.ESTADO NOT IN ('X') OR (CAH.ESTADO = 'C' AND TRUNC(CAH.FEC_CAM_ESTADO,'MM') = TRUNC(SYSDATE,'MM')) GROUP BY G.COD_PERSONA
        UNION ALL
        SELECT COUNT(*) CANTIDAD, G.COD_PERSONA FROM GE_CTA_CLIENTES G INNER JOIN CC_CTA_CORRIENTES CC ON CC.NRO_CUENTA = G.NRO_CUENTA WHERE CC.ESTADO NOT IN ('X') OR (CC.ESTADO = 'C' AND TRUNC(CC.FEC_CAM_ESTADO,'MM') = TRUNC(SYSDATE,'MM')) GROUP BY G.COD_PERSONA
        UNION ALL
		SELECT COUNT(*) CANTIDAD, G.COD_PERSONA FROM GE_CTA_CLIENTES G INNER JOIN OV_CTA_VENCIDAS OV ON OV.NRO_CUENTA = G.NRO_CUENTA WHERE  OV.ESTADO NOT IN ('C')  GROUP BY G.COD_PERSONA
		UNION all
		SELECT COUNT(*) CANTIDAD, G.COD_PERSONA FROM GE_CTA_CLIENTES G INNER JOIN LC_CTA_CAMBIOS LC ON LC.NRO_CUENTA = G.NRO_CUENTA  WHERE  LC.ESTADO NOT IN ('C','I')  GROUP BY G.COD_PERSONA
		UNION All
		SELECT COUNT(*) CANTIDAD, G.COD_PERSONA FROM GE_CTA_CLIENTES G INNER JOIN MD_CTA_DOCUMENTOS MD ON MD.NRO_CUENTA = G.NRO_CUENTA WHERE MD.ESTADO NOT IN ('N') GROUP BY G.COD_PERSONA
	) F
    LEFT JOIN GE_CLIENTES G ON F.COD_PERSONA = G.COD_PERSONA
    LEFT JOIN BA_PERSONAS P ON P.COD_PERSONA = G.COD_PERSONA
    LEFT JOIN GE_SEG_CLIENTES S ON S.COD_SEG_CLIENTE = G.COD_SEG_CLIENTE
    GROUP BY F.COD_PERSONA, P.NRO_DOCUMENTO, P.TIPO, P.NOM_COMPLETO, G.COD_SEG_CLIENTE, S.DESCRIPCION
)

SELECT 
    TO_NUMBER(PE.COD_PERSONA) AS NRO_CLIENTE,
    PE.TIPO AS TIPO_PERSONA,
    DECODE(PE.TIPO, 'F', FI.PRI_APELLIDO, NULL) AS APELLIDO,
    DECODE(PE.TIPO, 'F', FI.SEG_APELLIDO, NULL) AS SEGUNDO_APELLIDO,
    DECODE(PE.TIPO, 'F', FI.PRI_NOMBRE, NULL) AS PRIMER_NOMBRE,
    DECODE(PE.TIPO, 'F', FI.SEG_NOMBRE, NULL) AS SEGUNDO_NOMBRE,
    CASE WHEN PE.TIPO = 'J' THEN SUBSTR(JU.RAZ_SOCIAL, 1, 100) ELSE NULL END AS RAZON_SOCIAL,
    NULL AS COD_ALTERNATIVO_CLIENTE,
    FI.COD_SEXO AS SEXO,
    TO_CHAR(PE.COD_TIP_DOCUMENTO) AS TIPO_DOCUMENTO_1,
    PE.NRO_DOCUMENTO AS NRO_DOCUMENTO_1,
    NULL AS DOC_EXPEDIDO_POR_1,
	NULL AS FECHA_EXPEDICION_1,
	NULL AS TIPO_DOCUMENTO_2,
	NULL AS NRO_DOCUMENTO_2,
	NULL AS DOC_EXPEDIDO_POR_2,
	NULL AS FECHA_EXPEDICION_2,
	NULL AS TIPO_DOCUMENTO_3,
	NULL AS NRO_DOCUMENTO_3,
	NULL AS DOC_EXPEDIDO_POR_3,
	NULL AS FECHA_EXPEDICION_3,
	NULL AS TIPO_DOCUMENTO_4,
	NULL AS NRO_DOCUMENTO_4,
	NULL AS DOC_EXPEDIDO_POR_4,
	NULL AS FECHA_EXPEDICION_4,
    TO_CHAR(GREATEST(JU.FEC_APERTURA, TO_DATE('01/01/1900','DD/MM/YYYY')), 'YYYY-MM-DD') AS FECHA_CONSTITUCION,
    TO_CHAR(GREATEST(FI.FEC_NACIMIENTO, TO_DATE('01/01/1900','DD/MM/YYYY')), 'YYYY-MM-DD') AS FECHA_NACIMIENTO,
    NULL AS LUGAR_NACIMIENTO,
	TO_CHAR(PE.COD_PAIS) AS COD_PAIS,
    TO_CHAR(FI.COD_PAI_NACIONALIDAD) AS NACIONALIDAD,
	FI.EST_CIVIL AS ESTADO_CIVIL,
	to_char(PE.COD_RUB_PRIMARIO) AS COD_ACTIVIDAD, --se ajusta a RI-2
	to_char(FI.COD_PROFESION) AS COD_PROFESION,
	CASE WHEN PE.TIPO = 'F' THEN '0' ELSE TO_CHAR(NVL(JU.NATURALEZA,0)) END AS COD_FORMA_JURIDICA,
	to_char(GE.COD_SEG_CLIENTE) AS TIPO_CLIENTE,
	NULL AS COMUNICADO,
	CASE WHEN GE.COD_GRU_ECONOMICO = 1 THEN 0 ELSE 1 END AS CONOCIMIENTO_CLIENTE,
    -- Cálculo de Ingresos
    ROUND(NVL(LA.MTO_INGRESO, PE.TOT_INGRESOS) * 12 / 
          NULLIF(fug_obt_cotizacion('USD', pag_cal.fu_obt_fec_actual(6)), 0), 2) AS INGRESO_ANUAL_DECLARADO,
	NULL AS DP_ACTIVO,
	NULL AS DP_INGRESOS,	
	NULL AS DP_PASIVO,
	NULL AS DP_PATRIMONIO_NETO,
	to_char(GE.COD_OFICINA) AS COD_SUCURSAL, ---OFICINA DEL CLIENTE
	CASE WHEN GE.COD_SEG_CLIENTE = 1 THEN '1' ELSE '0' END AS ES_EMPLEADO,
	NULL AS EMPLEADO_DEPARTAMENTO,
	NULL AS EMPLEADO_STATUS,
	CASE WHEN GE.COD_SEC_CONTABLE IN ('F','I') THEN '1' ELSE '0' END AS ES_INST_FINANCIERA,
	CASE WHEN GE.COD_SEC_CONTABLE IN ('P') THEN '1' ELSE '0' END AS ES_INST_PUBLICA,
	TO_CHAR(PE.FEC_INSERCION,'yyyy-mm-dd') AS FECHA_ALTA, --DATO APLICA PARA REGISTROS NATIVOS EN ITGF
	NULL AS FECHA_BAJA,
	NULL AS FECHA_CAMBIODATO_A,
	NULL AS FECHA_CAMBIODATO_B,
	NULL AS FECHA_CAMBIODATO_C,
	NULL AS FECHA_CAMBIODATO_D,
	TO_CHAR(PE.FEC_MODIFICACION,'yyyy-mm-dd') AS FECHA_ACTUALIZ_DATOS,
	NULL AS FECHA_ACTUALIZACION,
	NULL AS FECHA_RIESGO,
	NULL AS ID_METODO_VERIF_IDENTIDAD,
	NULL AS NOMBRE_CONTACTO,
    GE.COD_USU_OFICIAL || ' - ' || US.NOMBRE AS OFICIAL_ATENCION,
    DECODE(FO.PEP, 'S', '1', '0') AS ES_PEP,
	CASE WHEN GE.RESIDENTE = 'S' THEN '1' ELSE '0' END AS RESIDENCIA,
	FI.COD_TIP_VIVIENDA AS TIPO_RESIDENCIA, --DATO APLICA PARA REGISTROS NATIVOS EN ITGF
	NULL AS NRO_PERMISORES,
	to_char(DI.COD_PAIS) AS COD_PAIS_RESIDENCIA,-- / TIPO = 'P'/ MAX (COD_DIRECCION)
	to_char(PE.TIP_IVA) AS TIPO_SITUACION_FISCAL,
	NULL AS OBSERVACIONES,
	CASE WHEN LOA.COD_MONEDA = 'GS' THEN
	ROUND(ROUND(LOA.MTO_LIMITE,0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))) ELSE NVL(LOA.MTO_LIMITE,0) END AS MAXATRANSAR,
	NULL AS MINATRANSAR,
	 CASE WHEN POC.PROD_ACT > 0 THEN 'CLIENTE' ELSE 'NOCLIENTE' END AS TIPO_TRATAMIENTO,
	NULL AS SEGMENTO,
	JU.NOM_COMERCIAL AS NOMBRE_FANTASIA,
	NULL AS PT_MONTO_CALCULADO,
	NULL AS PT_MONTO_INFORMADO,
	NULL AS PT_MANUAL_AUTOMATICO,
	DECODE(DA.ES_SO, 'S', '1', '0') AS ES_SUJETO_OBLIGADO,
	NULL AS SO_CUMPLE_OBLIGACION,
	CASE WHEN LA.COD_RAMO = 0 THEN NULL ELSE TO_CHAR(LA.COD_RAMO) END AS CODSECTORCLIENTE, -- se ajusta a RI-2
	NULL AS SC51,
	NULL AS SC52,
	DECODE(DA.SC53, 'S', '1', '0') AS SC53,
	NULL AS LINEA_DE_NEGOCIO,
	to_char(PE.COD_RUB_PRIMARIO) AS CODACTIVIDADAFIP,
	to_char(PE.COD_RUB_SECUNDARIO) AS CODACTIVIDADSEC,
	NULL AS CIERREBALANCE,
	NULL AS CODTIPOORIGENALTA,
	CASE WHEN JU.FEC_APERTURA < TO_DATE('01/01/1900','DD/MM/YYYY') THEN '1900-01-01' ELSE  TO_CHAR(JU.FEC_APERTURA,'yyyy-mm-dd') END AS FECHAINICIOACTIVIDAD,
	NULL AS FECHAVENCESTATUTO,
	NULL AS FECHADECESO,
	NULL AS INSCRIPCION_CODORG,
	NULL AS INSCRIPCION_FECHA,
	NULL AS INSCRIPCION_FOLIO,
	NULL AS INSCRIPCION_NRO,
	NULL AS INSCRIPCION_TOMO,
	NULL AS ADMINISTRA_FONDOS_3RO,
	FUE_OBT_NOM_PERSONA (VI.COD_PER_VINCULO)  AS NOMBRE_CONYUGE,
	DI.TIPO AS TIPO_DIRECCION, -- /  PRINCIPAL ='S'
	DI.DIRECCION AS CALLE,
	DI.NUMERO AS NUMERO,
	CASE WHEN LENGTH (DI.DEPARTAMENTO) > 5 THEN SUBSTR(DI.DEPARTAMENTO,0,5)ELSE DI.DEPARTAMENTO  END AS OFICINA,
	CASE WHEN LENGTH (DI.PISO) > 3 THEN SUBSTR(DI.PISO,0,3)ELSE DI.PISO END AS PISO,
	DI.EDIFICIO AS NOMBRE_EDIFICIO,
	to_char(DI.COD_BARRIO) AS BARRIO,
	NULL AS CIUDAD,
	to_char(DI.COD_CIUDAD) AS COD_CIUDAD,
	NULL AS DEPARTAMENTO,
	to_char(CI.COD_DEPARTAMENTO) AS COD_DE_DEPARTAMENTO,
	to_char(DI.COD_CIUDAD) AS COD_DISTRITO,
	to_char(DI.COD_PAIS) AS COD_PAIS_DOMICILIO,
	to_char(DI.COD_POSTAL) AS COD_POSTAL,
	PE.DIR_CORREO AS CORREO_ELECTRONICO,
	NULL AS DIR_WEB,
	NULL AS FAX,
	-- Teléfonos desde CTE
    TC.TEL_PRINCIPAL AS TELEFONO,
    TC.TEL_P AS TELEFONO_1,
    TC.TEL_L AS TELEFONO_2,
    TC.TEL_MOVIL AS TEL_MOVIL,
    -- Datos Adicionales desde CTE
	LA.TIP_CARGO AS INFOADICIONAL1,
   CASE WHEN GE.COD_PERSONA IS NULL THEN 0 ELSE 1 END AS GE_CLIENTE ,
   PAG_CAL.FU_OBT_FEC_ACTUAL(6) AS FEC_PROCESO
   
FROM BA_PERSONAS PE
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_FISICAS FI ON FI.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_PER_JURIDICAS JU ON JU.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN BA_USUARIOS US ON US.COD_USUARIO = GE.COD_USU_OFICIAL
LEFT JOIN BA_DIRECCIONES DI ON DI.COD_PERSONA = PE.COD_PERSONA AND DI.PRINCIPAL = 'S'
LEFT JOIN BA_CIUDADES CI ON CI.COD_CIUDAD = DI.COD_CIUDAD AND CI.COD_PAIS = DI.COD_PAIS
LEFT JOIN CR_INF_FONDOS FO ON FO.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN UltimoVinculo VI ON VI.COD_PERSONA = PE.COD_PERSONA AND VI.rnk = 1
LEFT JOIN LaboralActual LA ON LA.COD_PERSONA = PE.COD_PERSONA AND LA.rnk = 1
LEFT JOIN UltimoLimite LOA ON LOA.COD_PERSONA = PE.COD_PERSONA AND LOA.rnk = 1
LEFT JOIN TelefonosConsolidados TC ON TC.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN DatosAdicionales DA ON DA.COD_PERSONA = PE.COD_PERSONA
LEFT JOIN POC_CTE POC ON POC.COD_PERSONA = PE.COD_PERSONA

WHERE PE.COD_TIP_DOCUMENTO NOT IN (9,10);
