create or replace force view it.gv_mt941 as
select replace(regexp_substr(m.msj_swift, ':' || 25 || ':(.*)'),
               ':' || 25 || ':') cuenta,
       M.FEC_VALOR FECHA,
       decode(instr(replace(regexp_substr(m.msj_swift, ':' || 25 || ':(.*)'),
                            ':' || 25 || ':'),
                    'PYG'),
              0,
              'USD',
              'PYG') COD_MONEDA,
       to_char(m.fec_insercion, 'HH24:MM') HORA_SALDO,

       DECODE(decode(instr(replace(regexp_substr(m.msj_swift,
                                                 ':' || 25 || ':(.*)'),
                                   ':' || 25 || ':'),
                           'PYG'),
                     0,
                     'USD',
                     'PYG'),
              'PYG',
              replace(replace(replace(regexp_substr(m.msj_swift,
                                                    ':' || '60F' || ':(.*)'),
                                      ':' || '60F' || ':'),
                              replace(regexp_substr(m.msj_swift,
                                                    ':' || '60F' || ':(.*)PYG'),
                                      ':' || '60F' || ':'),
                              ''),
                      ',',
                      ''),
              replace(replace(regexp_substr(m.msj_swift,
                                            ':' || '60F' || ':(.*)'),
                              ':' || '60F' || ':'),
                      replace(regexp_substr(m.msj_swift,
                                            ':' || '60F' || ':(.*)USD'),
                              ':' || '60F' || ':'),
                      '')) SAL_INI_DIA,

       SUBSTR(replace(regexp_substr(m.msj_swift, ':' || '90D' || ':(.*)'),
                      ':' || '90D' || ':'),
              1,
              INSTR(replace(regexp_substr(m.msj_swift,
                                          ':' || '90D' || ':(.*)'),
                            ':' || '90D' || ':'),
                    decode(instr(replace(regexp_substr(m.msj_swift,
                                                       ':' || 25 || ':(.*)'),
                                         ':' || 25 || ':'),
                                 'PYG'),
                           0,
                           'USD',
                           'PYG')) - 1) CANT_DEBITOS,

       REPLACE(SUBSTR(replace(regexp_substr(m.msj_swift,
                                            ':' || '90D' || ':(.*)'),
                              ':' || '90D' || ':'),
                      instr(replace(regexp_substr(m.msj_swift,
                                                  ':' || '90D' || ':(.*)'),
                                    ':' || '90D' || ':'),
                            decode(instr(replace(regexp_substr(m.msj_swift,
                                                               ':' || 25 ||
                                                               ':(.*)'),
                                                 ':' || 25 || ':'),
                                         'PYG'),
                                   0,
                                   'USD',
                                   'PYG')) + 3),
               ',',
               '') TOT_DEBITOS,

       SUBSTR(replace(regexp_substr(m.msj_swift, ':' || '90C' || ':(.*)'),
                      ':' || '90C' || ':'),
              1,
              INSTR(replace(regexp_substr(m.msj_swift,
                                          ':' || '90C' || ':(.*)'),
                            ':' || '90C' || ':'),
                    decode(instr(replace(regexp_substr(m.msj_swift,
                                                       ':' || 25 || ':(.*)'),
                                         ':' || 25 || ':'),
                                 'PYG'),
                           0,
                           'USD',
                           'PYG')) - 1) CANT_CREDITOS,

       REPLACE(SUBSTR(replace(regexp_substr(m.msj_swift,
                                            ':' || '90C' || ':(.*)'),
                              ':' || '90C' || ':'),
                      instr(replace(regexp_substr(m.msj_swift,
                                                  ':' || '90C' || ':(.*)'),
                                    ':' || '90C' || ':'),
                            decode(instr(replace(regexp_substr(m.msj_swift,
                                                               ':' || 25 ||
                                                               ':(.*)'),
                                                 ':' || 25 || ':'),
                                         'PYG'),
                                   0,
                                   'USD',
                                   'PYG')) + 3),
               ',',
               '') TOT_CREDITOS,

       decode(decode(instr(replace(regexp_substr(m.msj_swift,
                                                 ':' || 25 || ':(.*)'),
                                   ':' || 25 || ':'),
                           'PYG'),
                     0,
                     'USD',
                     'PYG'),
              'USD',
              SUBSTR(replace(regexp_substr(m.msj_swift,
                                           ':' || '62F' || ':(.*)'),
                             ':' || '62F' || ':'),
                     instr(replace(regexp_substr(m.msj_swift,
                                                 ':' || '62F' || ':(.*)'),
                                   ':' || '62F' || ':'),
                           decode(instr(replace(regexp_substr(m.msj_swift,
                                                              ':' || 25 ||
                                                              ':(.*)'),
                                                ':' || 25 || ':'),
                                        'PYG'),
                                  0,
                                  'USD',
                                  'PYG')) + 3),
              REPLACE(SUBSTR(replace(regexp_substr(m.msj_swift,
                                                   ':' || '62F' || ':(.*)'),
                                     ':' || '62F' || ':'),
                             instr(replace(regexp_substr(m.msj_swift,
                                                         ':' || '62F' ||
                                                         ':(.*)'),
                                           ':' || '62F' || ':'),
                                   decode(instr(replace(regexp_substr(m.msj_swift,
                                                                      ':' || 25 ||
                                                                      ':(.*)'),
                                                        ':' || 25 || ':'),
                                                'PYG'),
                                          0,
                                          'USD',
                                          'PYG')) + 3),
                      ',',
                      '')) SAL_TOTAL,
       decode(decode(instr(replace(regexp_substr(m.msj_swift,
                                                 ':' || 25 || ':(.*)'),
                                   ':' || 25 || ':'),
                           'PYG'),
                     0,
                     'USD',
                     'PYG'),
              'USD',
              SUBSTR(replace(regexp_substr(m.msj_swift,
                                           ':' || '64' || ':(.*)'),
                             ':' || '64' || ':'),
                     instr(replace(regexp_substr(m.msj_swift,
                                                 ':' || '64' || ':(.*)'),
                                   ':' || '64' || ':'),
                           decode(instr(replace(regexp_substr(m.msj_swift,
                                                              ':' || 25 ||
                                                              ':(.*)'),
                                                ':' || 25 || ':'),
                                        'PYG'),
                                  0,
                                  'USD',
                                  'PYG')) + 3),
              REPLACE(SUBSTR(replace(regexp_substr(m.msj_swift,
                                                   ':' || '64' || ':(.*)'),
                                     ':' || '64' || ':'),
                             instr(replace(regexp_substr(m.msj_swift,
                                                         ':' || '64' ||
                                                         ':(.*)'),
                                           ':' || '64' || ':'),
                                   decode(instr(replace(regexp_substr(m.msj_swift,
                                                                      ':' || 25 ||
                                                                      ':(.*)'),
                                                        ':' || 25 || ':'),
                                                'PYG'),
                                          0,
                                          'USD',
                                          'PYG')) + 3),
                      ',',
                      '')) sal_disponible

  from ge_snp_mensajes m
 where m.cod_msj_swift = 941;

