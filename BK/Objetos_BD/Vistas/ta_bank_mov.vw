create or replace force view it.ta_bank_mov as
select "FECHA","HORA","COD_USUARIO","NRO_SECUENCIA","FEC_VALOR","MONTO","NRO_CUENTA","COD_MONEDA","COD_OFICINA","COD_ERROR","COD_RETENCION","FEC_FIN_RETENCION","EST_CUENTA","ESTADO","COD_CAUSA","COD_BANCO","COD_OFI_ORIGEN","CONCEPTO","COD_TASA","VAL_TASA","COD_RUBRO","COD_REF_CAMBIO","REVERSADO","COD_USU_REVERSION","HOR_REVERSION","EMI_AVISO","COD_TRA_PADRE","COD_MOD_PADRE","COD_MAD_PADRE","COD_TRANSACCION","COD_MODULO","COD_MODALIDAD","MTO_EQU_LOCAL","NRO_CAJA","COTIZACION","COD_BCO_CENTRAL","NRO_DOCUMENTO","NRO_DOCUMENTO2","NRO_DOCUMENTO3","NRO_DOCUMENTO4","PROTEGIDO","TIP_MOV_RUBRO","COD_AUTORIZACION","COD_USU_AUTORIZADOR","COD_TIP_OPE_CAMBIO","USU_INSERCION","FEC_INSERCION","USU_MODIFICACION","FEC_MODIFICACION","REFERENCIA","COD_PERSONA","COD_SIT_CONTABLE" from ta_movimientos_his m where m.fecha >= '01/07/2019';

