create or replace force view it.simgia_cc_cta_cc_conta as
select distinct(ccco.nro_cuenta) nro_cuenta,
     pai_int.FU_OBT_CTA_CONTABLE(fub_obt_rub_transaccion(ccco.cod_modulo,
                            ccco.cod_modalidad,
                            902,
                            ccco.cod_moneda,
                            gcc.cod_persona,
                            '1',
                            'D'))rub_as_transitorio,
     pai_int.FU_OBT_CTA_CONTABLE(fub_obt_rub_transaccion(ccco.cod_modulo,
                            ccco.cod_modalidad,
                            942,
                            ccco.cod_moneda,
                            gcc.cod_persona,
                            '1',
                            'D'))rub_as_autorizado,
     pai_int.FU_OBT_CTA_CONTABLE(nvl(fub_obt_rub_transaccion(ccco.cod_modulo,
                            ccco.cod_modalidad,
                            949,
                            ccco.cod_moneda,
                            gcc.cod_persona,
                            '1',
                            'D'),fub_obt_rub_transaccion(ccco.cod_modulo,
                            ccco.cod_modalidad,
                            909,
                            ccco.cod_moneda,
                            gcc.cod_persona,
                            '1',
                            'D')))rub_as_vencido,
     pai_int.FU_OBT_CTA_CONTABLE(nvl(fub_obt_rub_transaccion(ccco.cod_modulo,
                            ccco.cod_modalidad,
                            940,
                            ccco.cod_moneda,
                            gcc.cod_persona,
                            '1',
                            'D'), fub_obt_rub_transaccion(ccco.cod_modulo,
                            ccco.cod_modalidad,
                            900,
                            ccco.cod_moneda,
                            gcc.cod_persona,
                            '1',
                            'D' )))rub_as_gestion,
     pai_int.FU_OBT_CTA_CONTABLE(nvl(fub_obt_rub_transaccion(ccco.cod_modulo,
                            ccco.cod_modalidad,
                            912,
                            ccco.cod_moneda,
                            gcc.cod_persona,
                            '1',
                            'D'),fub_obt_rub_transaccion(ccco.cod_modulo,
                            ccco.cod_modalidad,
                            952,
                            ccco.cod_moneda,
                            gcc.cod_persona,
                            '1',
                            'D')))rub_as_moroso
from cc_cta_corrientes ccco,  ge_cta_clientes gcc
where   ccco.nro_cuenta = gcc.nro_cuenta(+)
and     gcc.relacion like 'P';

