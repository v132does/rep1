select t.de_id,
       t.dcodint,
       t.ddesproser,
       t.cunimed,
       t.ddesunimed,
       t.dcantproser,
       t.cpaisorig,
       t.ddespaisorig,
       t.dinfitem,
       t.crelmerc,
       t.ddesrelmerc,
       t.dcanquimer,
       t.dporquimer,
       t.dcdcanticipo,
       t.dpararanc,
       t.dncm,
       t.ddncpg,
       t.ddncpe,
       t.dgtin,
       t.dgtinpq,
       t.dpuniproser,
       t.dticamit,
       t.dtotbruopeitem,
       t.ddescitem,
       t.dporcdesit,
       t.ddescgloitem,
       t.dantpreuniit,
       t.dantglopreuniit,
       t.dtotopeitem,
       t.dtotopegs,
       t.iafeciva,
       t.ddesafeciva,
       t.dpropiva,
       t.dtasaiva,
       t.dbasgraviva,
       t.dliqivaitem
