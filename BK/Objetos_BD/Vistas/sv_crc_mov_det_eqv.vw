CREATE OR REPLACE VIEW IT.SV_CRC_MOV_DET_EQV AS
WITH
MIG AS (
  SELECT
         m.NRO_CTA_ITGF,
         m.TIP_OPERACION,
         m.COD_OFICINA,
         m.NRO_OPE_SALDOS,
         ROW_NUMBER() OVER (
           PARTITION BY m.NRO_CTA_ITGF, m.TIP_OPERACION, m.COD_OFICINA
           ORDER BY m.NRO_OPE_SALDOS DESC
         ) rn
    FROM IT.SB_CRC_CTA_MIGRADA m
),
OFI AS (
  SELECT
         o.NRO_OPERACION,
         o.TIP_OPERACION,
         o.COD_OFICINA,
         o.COD_MONEDA,
         o.COD_OFI_CRC,
         o.NRO_REGISTRO,
         ROW_NUMBER() OVER (
           PARTITION BY o.NRO_OPERACION, o.TIP_OPERACION, o.COD_OFICINA, o.COD_MONEDA
           ORDER BY NVL(o.NRO_REGISTRO, 0) DESC
         ) rn
    FROM IT.SB_CRC_CAM_OFICINA o
)
SELECT
  d.NRO_REGISTRO,
  d.FECHA,
  d.NRO_FORMULARIO,
  NVL(o.COD_OFI_CRC, d.COD_OFICINA)      AS COD_OFICINA,
  d.TIP_OPERACION,
  NVL(m.NRO_OPE_SALDOS, d.NRO_OPERACION) AS NRO_OPERACION,
  d.COD_MON_ISO,
  d.FEC_OPERACION,
  d.CTA_CON_CAPITAL,
  d.MTO_CAPITAL,
  d.MTO_LIN_CREDITO,
  d.CTA_CON_INTERES,
  d.MTO_INTERES,
  d.TAS_NOMINAL,
  d.DIA_PLAZO,
  d.TIP_MOVIMIENTO
FROM IT.SB_CRC_MOVIMIENTOS_DET d
LEFT JOIN MIG m
       ON m.NRO_CTA_ITGF  = d.NRO_OPERACION
      AND m.TIP_OPERACION = d.TIP_OPERACION
      AND m.COD_OFICINA   = d.COD_OFICINA
      AND m.rn            = 1
LEFT JOIN OFI o
       ON o.NRO_OPERACION = d.NRO_OPERACION
      AND o.TIP_OPERACION = d.TIP_OPERACION
      AND o.COD_OFICINA   = d.COD_OFICINA
      AND o.COD_MONEDA    = d.COD_MON_ISO
      AND o.rn            = 1;
