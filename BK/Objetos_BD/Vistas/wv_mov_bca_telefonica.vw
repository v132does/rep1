create or replace force view it.wv_mov_bca_telefonica as
select c.cod_per_ingreso Cliente,
       a.nom_completo NOMBRE_CLIENTE,
       fug_obt_datos_clientes(c.cod_per_ingreso, 'D') DESCRIPCION_TIP_DOCUMENTO,
       a.nro_documento NRO_DOCUMENTO,
       fug_obt_gestor(c.cod_per_ingreso) NOMBRE_GESTOR,
       cli.cod_oficina COD_OFICINA,
       fue_obt_des_oficina( cli.cod_oficina)DES_OFI_PERSONA,
       trim(t.descripcion) DESCRIPCION_TIP_MENSAJE,
  decode(c.cod_respuesta,'000','Aprobado',
                         '-01','Cuenta Inexistente',
                         '-02','Cuenta Duplicada',
                         '-03', 'Pin/Clave Inválida',
                         '-04', 'Pin/Clave Inexistente',
                         '-05', 'Saldo Insuficiente',
                         '-06', 'Sistema en Cierre',
                         '-07', 'Sin Movimientos',
                         '-08', 'Sin Autorizacion',
                         '-09', 'Transaccion Ivalida',
                         '-10', 'Transaccion Prohibida',
                         '-11', 'Cantidad Invalida',
                         '-12', 'Cuenta Cancelada',
                         '-13', 'Cuenta Bloqueada',
                         '-14', 'Cuenta Invalida',
                         '-18', 'PIN BLOQUEADO',
                         '-19', 'PIN ANULADO',
                         '-20', 'TAS INHABILITADO',
                         '-21', 'MOV. INVALIDO',
                         '-22', 'TOTAL INVALIDO',
                         '-23', 'PEDIDO DUPLICADO',
                         '-24', 'PAGO PENDIENTE',
                         '-25', 'SERV INEXISTENTE',
                         '-27', 'DATO INVALIDO',
                         '-30', 'CODIGO SIN FACTURA',
                         '-31', 'CODIGO CON FACTURA',
                         '-32', 'VINCULO INEXISTENTE',
                         '-33', 'VINCULO VENCIDO',
                         '-34', 'MOV. YA INGRESADO',
                         '-36', 'LIMITE EXCEDIDO',
                         '-55', 'COD_REC_POR_DNA',
                         '-56', 'COD_VAL_TICKET_DNA',
                         '-57', 'ERROR RANGO FECHA',
                         '-58', 'ERROR RANGIO INICIAL',
                         '-59', 'AVISO INEXISTENTE',
                         '-60', 'CANT. CHEQUES EXCEDE',
                         '-61', 'MONEDA DIF.',
                         '-62', 'CONT. CAMBIO INVALIDO',
                         '-63', 'ERROR COTIZ.CONTRATO CAMBIO',
                         '-64', 'MONEDA DIF. A PLAZA LOCAL',
                         '-65', 'SERVICIO INVALIDO',
                         '-66', 'PRESTAMO EN JUICIO',
                         '-67', 'PERSONA INVALIDA',
                         '-68', 'ERROR TRANSF, AL EXTERIOR',
                         'OTRO ERROR') Respuesta,
  c.nro_cuenta Cuenta,
  c.fec_hora,
  c.monto Monto,
  c.nro_cta_contra Contrapartida,
  c.dir_ip Telefono
  from bw_movimientos  c, ba_personas a, bw_tip_mensajes t, ge_clientes cli
     where c.cod_per_ingreso = a.cod_persona
        and c.cod_tip_mensaje = t.cod_tip_mensaje
        and c.nro_caja = '888'
        and cli.cod_persona(+) = a.cod_persona
        order by c.fec_hora desc;

