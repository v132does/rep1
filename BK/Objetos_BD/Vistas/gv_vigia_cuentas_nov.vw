CREATE OR REPLACE FORCE VIEW IT.GV_VIGIA_CUENTAS_NOV AS
SELECT --count(*)
CL.NRO_CUENTA AS NRO_CUENTA,CL.NRO_CUENTA AS CUENTA,CU.COD_MODULO||CU.COD_MODALIDAD||CU.COD_SUB_MODALIDAD AS COD_TIPO_CUENTA,
CU.COD_MODALIDAD||CU.ESTADO AS COD_ESTADO,CU.COD_MONEDA AS COD_MONEDA,GE.COD_OFICINA AS COD_SUCURSAL,
NULL AS COMENTARIOS,NULL AS FECHA_PROCESO,NULL AS FECHA_ALTA,
/*CASE WHEN TO_CHAR(CU.FEC_APERTURA,'yyyy-mm-dd') IS NULL THEN to_char (pag_cal.fu_obt_fec_actual(6),'yyyy-mm-dd')
  ELSE  TO_CHAR(CU.FEC_APERTURA,'yyyy-mm-dd') END AS FECHA_DE_APERTURA,*/
TO_CHAR(CU.FEC_APERTURA,'yyyy-mm-dd') AS FECHA_DE_APERTURA,
CASE WHEN (CU.COD_MODULO = 3 AND CU.COD_MODALIDAD not in (33,36) AND CU.ESTADO IN ('C')) THEN  TO_CHAR(VI.FEC_CAM_ESTADO,'yyyy-mm-dd')
   WHEN (CU.COD_MODULO = 3 AND CU.COD_MODALIDAD in (33,36) AND CU.ESTADO IN ('C','T')) THEN TO_CHAR(CE.FEC_PAGO,'yyyy-mm-dd')
   WHEN (CU.COD_MODULO = 5 AND CU.ESTADO IN ('C')) THEN TO_CHAR(TA.FEC_MODIFICACION,'yyyy-mm-dd')
   WHEN (CU.COD_MODULO = 6 AND CU.ESTADO IN ('N')) THEN TO_CHAR(PR.FEC_CANCELACION,'yyyy-mm-dd')
   WHEN (CU.COD_MODULO = 15 AND CU.ESTADO IN ('C')) THEN TO_CHAR(OV.FEC_CAM_ESTADO,'yyyy-mm-dd')
   WHEN (CU.COD_MODULO = 7 AND CU.ESTADO IN ('C')) THEN TO_CHAR(LC.FEC_CAM_ESTADO,'yyyy-mm-dd')
   WHEN (CU.COD_MODULO = 10 AND CU.ESTADO IN ('N')) THEN to_char(TO_DATE(MD.FEC_CANCELACION,'DD/MM/YYYY HH24:MI:SS'),'yyyy-mm-dd')
   END AS FECHA_DE_CANCELACION,
TO_CHAR(CU.FEC_VENCIMIENTO,'yyyy-mm-dd') AS FECHA_DE_VENCIMIENTO,
NULL AS NROTARJETA,GE.COD_USU_OFICIAL AS COD_OFICIAL,US.NOMBRE AS NOMBRE_OFICIAL,
CASE WHEN (CU.FEC_VENCIMIENTO - CU.FEC_APERTURA) <= 0 THEN 1 ELSE (CU.FEC_VENCIMIENTO - CU.FEC_APERTURA) END AS PLAZO,
GE.COD_SEG_CLIENTE AS TIPO_CATEGORIA,NULL AS SALDO_ACTUAL,NULL AS SALDO_INICIAL,
NULL AS SALDO1,NULL AS SALDO2,NULL AS SALDO3,NULL AS SALDO4,
CASE WHEN CU.COD_MODULO IN (3) THEN CT.VAL_TASA
   WHEN CU.COD_MODULO IN (15) THEN OV.VAL_TASA ELSE CU.VAL_TASA END AS TASA,
ROUND((nvl(TA.LIN_CREDITO,0)/fug_obt_cotizacion('USD',pag_cal.fu_obt_fec_actual(6))),2) AS LIMITE1,
NULL AS LIMITE2,NULL AS LIMITE3,NULL AS LIMITE4,
---------------------**********************************hasta aqui estructura Vigia *******---------------------
CASE WHEN TRUNC(CU.FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ THEN 'ALTA' ELSE 'MODIFICACION' END AS MARCA,
CU.ESTADO AS ESTADO, trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AS FEC_PROCESO
---------------------*****************************************************************---------------------
FROM GE_CTA_CLIENTES CL
JOIN GE_CUENTAS CU ON CU.NRO_CUENTA= CL.NRO_CUENTA AND CU.COD_MODULO = CL.COD_MODULO AND CU.COD_MODALIDAD = CL.COD_MODALIDAD  --inventario de cuentas gral
JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA --inventario de clientes
LEFT JOIN AH_CTA_VISTAS VI ON VI.NRO_CUENTA = CU.NRO_CUENTA AND VI.COD_MODULO = CU.COD_MODULO AND VI.COD_MODALIDAD = CU.COD_MODALIDAD
AND VI.COD_SUB_MODALIDAD = CU.COD_SUB_MODALIDAD--inventario de cajas de ahorros
LEFT JOIN AH_CTA_CERTIFICADOS CE ON CE.NRO_CUENTA = CU.NRO_CUENTA AND CE.COD_MODULO = CU.COD_MODULO AND CE.COD_MODALIDAD = CU.COD_MODALIDAD --inventario de certificados
LEFT JOIN PR_CTA_PRESTAMOS PR ON PR.NRO_CUENTA = CU.NRO_CUENTA AND PR.COD_MODULO = CU.COD_MODULO AND PR.COD_MODALIDAD = CU.COD_MODALIDAD AND PR.COD_SUB_MODALIDAD = CU.COD_SUB_MODALIDAD --inventario de prestamos
LEFT JOIN TA_CTA_TARJETAS TA ON TA.NRO_CUENTA = CU.NRO_CUENTA AND TA.COD_MODULO = CU.COD_MODULO AND TA.COD_MODALIDAD = CU.COD_MODALIDAD --inventario de tarjetas
LEFT JOIN MD_CTA_DOCUMENTOS MD ON MD.NRO_CUENTA = CU.NRO_CUENTA AND MD.COD_MODULO = CU.COD_MODULO AND MD.COD_MODALIDAD = CU.COD_MODALIDAD --inventario de mesa de dinero
LEFT JOIN OV_CTA_VENCIDAS OV ON OV.NRO_CUENTA = CU.NRO_CUENTA AND OV.COD_MODULO = CU.COD_MODULO AND OV.COD_MODALIDAD = CU.COD_MODALIDAD -- inventario de operaciones vencidas
LEFT JOIN LC_CTA_CAMBIOS LC ON LC.NRO_CUENTA = CU.NRO_CUENTA AND LC.COD_MODULO = CU.COD_MODULO AND LC.COD_MODALIDAD = CU.COD_MODALIDAD --inventario de cambios
JOIN BA_USUARIOS US ON US.COD_USUARIO = GE.COD_USU_OFICIAL -- inventario de usuarios
LEFT JOIN (SELECT CT1.COD_TASA,CT1.VAL_TASA, CT1.COD_MONEDA,CT1.COD_MODULO,CT1.COD_MODALIDAD,CT1.COD_SUB_MODALIDAD, CT1.FEC_VIGENCIA
FROM GE_TAS_FECHAS CT1
WHERE CT1.FEC_VIGENCIA = (SELECT MAX(FEC_VIGENCIA) FROM GE_TAS_FECHAS WHERE COD_TASA = CT1.COD_TASA AND COD_MONEDA = CT1.COD_MONEDA AND COD_MODULO = CT1.COD_MODULO AND COD_MODALIDAD = CT1.COD_MODALIDAD AND COD_SUB_MODALIDAD = CT1.COD_SUB_MODALIDAD)) CT ON  CU.COD_TASA = CT.COD_TASA --Inventario de tasas
AND CU.COD_MONEDA = CT.COD_MONEDA AND CU.COD_MODULO = CT.COD_MODULO AND CU.COD_MODALIDAD = CT.COD_MODALIDAD AND CU.COD_SUB_MODALIDAD = CT.COD_SUB_MODALIDAD

---------------------*****************************************************************---------------------
WHERE CL.NRO_CUENTA IN (SELECT DISTINCT NRO_CUENTA FROM (
-----------**********ALTAS (PAL)***************************------------------------
SELECT PAL.COD_MODULO AS MODULO, PAL.NRO_CUENTA AS NRO_CUENTA,PAL.FEC_ACTUALIZ AS FEC_ACTUALIZACION,PAL.ESTADO AS ESTADO, 'ALTA' AS MARCA, COUNT(*)
 FROM (
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_INICIO)AS FEC_ACTUALIZ, ESTADO FROM PR_CTA_PRESTAMOS WHERE TRUNC(FEC_INICIO) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_APERTURA)AS FEC_ACTUALIZ, ESTADO FROM AH_CTA_VISTAS WHERE TRUNC(FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO NOT IN ('X')
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_APERTURA)AS FEC_ACTUALIZ, ESTADO FROM AH_CTA_CERTIFICADOS WHERE TRUNC(FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO NOT IN ('X')
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_APERTURA)AS FEC_ACTUALIZ, ESTADO FROM TA_CTA_TARJETAS WHERE TRUNC(FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_INICIO)AS FEC_ACTUALIZ, ESTADO FROM MD_CTA_DOCUMENTOS WHERE TRUNC(FEC_INICIO) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_APERTURA)AS FEC_ACTUALIZ, ESTADO FROM OV_CTA_VENCIDAS WHERE TRUNC(FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_APERTURA)AS FEC_ACTUALIZ, ESTADO FROM LC_CTA_CAMBIOS WHERE TRUNC(FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
 )PAL GROUP BY PAL.COD_MODULO, PAL.NRO_CUENTA, PAL.FEC_ACTUALIZ, PAL.ESTADO
UNION -----------**********CANCELACIONES-BAJAS (PBA)***************************------------------------
SELECT PBA.COD_MODULO AS MODULO, PBA.NRO_CUENTA AS NRO_CUENTA, PBA.FEC_ACTUALIZ AS FEC_ACTUALIZACION,PBA.ESTADO AS ESTADO, 'BAJA' AS MARCA, COUNT(*)
 FROM (
SELECT COD_MODULO, NRO_CUENTA , TRUNC(FEC_CANCELACION) AS FEC_ACTUALIZ, ESTADO FROM PR_CTA_PRESTAMOS WHERE TRUNC (FEC_CANCELACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO IN ('N')
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_CAM_ESTADO) AS FEC_ACTUALIZ, ESTADO FROM AH_CTA_VISTAS WHERE TRUNC (FEC_CAM_ESTADO) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO IN ('C')
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_PAGO) AS FEC_ACTUALIZ, ESTADO FROM AH_CTA_CERTIFICADOS WHERE TRUNC (FEC_PAGO) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO IN ('C','T')
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_MODIFICACION) AS FEC_ACTUALIZ, ESTADO FROM TA_CTA_TARJETAS WHERE TRUNC (FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO  IN ('C')
UNION
SELECT COD_MODULO, NRO_CUENTA ,to_date(SUBSTR(FEC_CANCELACION,0,10),'dd/mm/yyyy') AS FEC_ACTUALIZ, ESTADO FROM MD_CTA_DOCUMENTOS WHERE to_date(SUBSTR(FEC_CANCELACION,0,10),'dd/mm/yyyy') = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/  AND ESTADO IN ('N')
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_CAM_ESTADO) AS FEC_ACTUALIZ, ESTADO FROM OV_CTA_VENCIDAS WHERE TRUNC (FEC_CAM_ESTADO) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO IN ('C')
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_CAM_ESTADO) AS FEC_ACTUALIZ, ESTADO FROM LC_CTA_CAMBIOS WHERE TRUNC (FEC_CAM_ESTADO) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO  IN ('C')
 ) PBA GROUP BY PBA.COD_MODULO, PBA.NRO_CUENTA, PBA.FEC_ACTUALIZ, PBA.ESTADO
UNION  -----------**********MODIFICACIONES (MAESTROS)***************************------------------------
SELECT PMO.COD_MODULO AS MODULO, PMO.NRO_CUENTA AS NRO_CUENTA, PMO.FEC_ACTUALIZ AS FEC_ACTUALIZACION,PMO.ESTADO AS ESTADO, 'MODIFICACION' AS MARCA, COUNT(*)
 FROM (
SELECT COD_MODULO, NRO_CUENTA , TRUNC(FEC_MODIFICACION) AS FEC_ACTUALIZ, ESTADO FROM PR_CTA_PRESTAMOS
  WHERE TRUNC(FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO NOT IN ('N') AND TRUNC(FEC_INSERCION) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/  --38 //18
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_MODIFICACION) AS FEC_ACTUALIZ, ESTADO FROM AH_CTA_VISTAS
  WHERE TRUNC(FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO NOT IN ('C',/*'I',*/'X') AND TRUNC(FEC_INSERCION) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ --0 --0
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_MODIFICACION) AS FEC_ACTUALIZ, ESTADO FROM AH_CTA_CERTIFICADOS
  WHERE TRUNC(FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO NOT IN ('C','T','X') AND TRUNC(FEC_INSERCION) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ --4 --4
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_MODIFICACION) AS FEC_ACTUALIZ, ESTADO FROM TA_CTA_TARJETAS
  WHERE TRUNC(FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO  NOT IN ('C') AND TRUNC(FEC_INSERCION) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ --0
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_MODIFICACION) AS FEC_ACTUALIZ, ESTADO FROM MD_CTA_DOCUMENTOS
  WHERE TRUNC(FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/  AND ESTADO NOT IN ('N') AND TRUNC(FEC_INSERCION) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ --0
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_MODIFICACION) AS FEC_ACTUALIZ, ESTADO FROM OV_CTA_VENCIDAS
  WHERE TRUNC(FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO NOT IN ('C') AND TRUNC(FEC_INSERCION) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ --0
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_MODIFICACION) AS FEC_ACTUALIZ, ESTADO FROM LC_CTA_CAMBIOS
  WHERE TRUNC(FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO  NOT IN ('C') AND TRUNC(FEC_INSERCION) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ --0
 ) PMO GROUP BY PMO.COD_MODULO, PMO.NRO_CUENTA,PMO.FEC_ACTUALIZ, PMO.ESTADO
UNION --------------------MODIFICACION DE RELACION EN GE_CTA_CLIENTES
SELECT PRE.COD_MODULO AS MODULO, PRE.NRO_CUENTA AS NRO_CUENTA,PRE.FEC_ACTUALIZ AS FEC_ACTUALIZACION,PRE.ESTADO AS ESTADO,PRE.MARCA,  COUNT(*)
 FROM (
SELECT CL.COD_MODULO , CL.NRO_CUENTA,TRUNC(CL.FEC_MODIFICACION) AS FEC_ACTUALIZ,CU.ESTADO ,'RELACION' AS MARCA,
CASE WHEN (CU.COD_MODULO = 3 AND CU.COD_MODALIDAD not in (33,36)) AND CU.ESTADO IN ('C','X') THEN 'EX'
   WHEN (CU.COD_MODULO = 3 AND CU.COD_MODALIDAD in (33,36))  AND CU.ESTADO IN ('C','T','X') THEN 'EX'
   WHEN CU.COD_MODULO IN(4) AND CU.ESTADO  IN ('C','I','X') THEN 'EX'
   WHEN CU.COD_MODULO IN(5) AND CU.ESTADO  IN ('C') THEN 'EX'
   WHEN CU.COD_MODULO IN (6,10) AND CU.ESTADO  IN ('N') THEN 'EX'
   WHEN CU.COD_MODULO IN (7, 15) AND CU.ESTADO  IN ('C') THEN 'EX' ELSE 'SI' END AS DAT, COUNT(*)
FROM GE_CTA_CLIENTES CL
JOIN GE_CUENTAS CU ON CU.NRO_CUENTA= CL.NRO_CUENTA AND CU.COD_MODULO = CL.COD_MODULO AND CU.COD_MODALIDAD = CL.COD_MODALIDAD
WHERE CL.COD_MODULO IN (3,4,5,6,7,10,15,35) AND CL.COD_PERSONA NOT IN (1)
AND TRUNC(CL.FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ -- cuentas con fecha de modificacion igual a fecha proceso
--AND TRUNC(CL.FEC_MODIFICACION) > TO_DATE('16/07/2022','dd/mm/yyyy')   --- maxima fecha en historico
AND TRUNC(CU.FEC_APERTURA) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ -- cuentas existentes, desde antes de la fecha proceso para NO solapar con Altas
--AND TRUNC(CU.FEC_APERTURA) < TO_DATE('16/07/2022','dd/mm/yyyy') --- maxima fecha en historico
GROUP BY CL.COD_MODULO,CL.NRO_CUENTA,TRUNC(CL.FEC_MODIFICACION),CU.ESTADO,CU.COD_MODULO , CU.COD_MODALIDAD
      ) PRE WHERE PRE.DAT= 'SI' GROUP BY PRE.COD_MODULO,PRE.NRO_CUENTA,PRE.FEC_ACTUALIZ,PRE.ESTADO,PRE.MARCA
UNION ----------------MODIFICACION DE RELACION EN GE_CTA_CLIENTES para actualizar COD_SUCURSAL COD_USU_OFICIAL COD_SEG_CLIENTE
SELECT PRE.MODULO, PRE.NRO_CUENTA ,PRE.FEC_ACTUALIZACION,PRE.ESTADO,PRE.MARCA,COUNT(*)
FROM (
SELECT NULL AS MODULO, CL.NRO_CUENTA AS NRO_CUENTA ,TRUNC(GE.FEC_MODIFICACION) AS FEC_ACTUALIZACION,NULL AS ESTADO,'CLIENTE' AS MARCA,
CASE WHEN (CU.COD_MODULO = 3 AND CU.COD_MODALIDAD not in (33,36)) AND CU.ESTADO IN ('C','X') THEN 'EX'
   WHEN (CU.COD_MODULO = 3 AND CU.COD_MODALIDAD in (33,36))  AND CU.ESTADO IN ('C','T','X') THEN 'EX'
   WHEN CU.COD_MODULO IN(4) AND CU.ESTADO  IN ('C','I','X') THEN 'EX'
   WHEN CU.COD_MODULO IN(5) AND CU.ESTADO  IN ('C') THEN 'EX'
   WHEN CU.COD_MODULO IN (6,10) AND CU.ESTADO  IN ('N') THEN 'EX'
   WHEN CU.COD_MODULO IN (7, 15) AND CU.ESTADO  IN ('C') THEN 'EX' ELSE 'SI' END AS DAT, COUNT(*)
FROM GE_CLIENTES GE
JOIN GE_CTA_CLIENTES CL ON CL.COD_PERSONA = GE.COD_PERSONA AND CL.RELACION = 'P'
JOIN GE_CUENTAS CU ON CU.NRO_CUENTA= CL.NRO_CUENTA AND CU.COD_MODULO = CL.COD_MODULO AND CU.COD_MODALIDAD = CL.COD_MODALIDAD
WHERE  TRUNC(GE.FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
AND TRUNC(CU.FEC_APERTURA) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
GROUP BY CL.NRO_CUENTA ,TRUNC(GE.FEC_MODIFICACION),CU.COD_MODULO,CU.COD_MODALIDAD,CU.ESTADO
     ) PRE WHERE PRE.DAT= 'SI' GROUP BY PRE.MODULO, PRE.NRO_CUENTA ,PRE.FEC_ACTUALIZACION,PRE.ESTADO,PRE.MARCA
     ))
AND CL.RELACION = 'P'
AND CL.COD_PERSONA NOT IN (1)
;

