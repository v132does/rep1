CREATE OR REPLACE FORCE VIEW IT.GV_MOV_DAT_ADICIONALES AS
SELECT M.FECHA, M.HORA,M.FEC_VALOR, M.HOR_REFERENCIA, M.COD_USUARIO, M.NRO_SECUENCIA,
       M.COD_MODULO, M.COD_MODALIDAD, M.NRO_CUENTA,
       M.TIP_OPERACION, M.COD_TRA_PADRE, M.COD_MONEDA, M.MONTO, M.MTO_COMISION,
       M.COD_EXTORNO, M.NRO_DOCUMENTO, M.NRO_TRANSACCION, M.DAT_ADICIONAL, M.NRO_CTA_DEB_BATCH,
       M.LIBERADO, M.FEC_ACREDITACION, M.USU_INSERCION, M.FEC_INSERCION, M.USU_MODIFICACION,
       M.FEC_MODIFICACION
  FROM GE_MOV_DAT_ADICIONALES M
UNION ALL
SELECT M.FECHA, M.HORA,M.FEC_VALOR, M.HOR_REFERENCIA, M.COD_USUARIO, M.NRO_SECUENCIA,
       M.COD_MODULO, M.COD_MODALIDAD, M.NRO_CUENTA,
       M.TIP_OPERACION, M.COD_TRA_PADRE, M.COD_MONEDA, M.MONTO, M.MTO_COMISION,
       M.COD_EXTORNO, M.NRO_DOCUMENTO, M.NRO_TRANSACCION, M.DAT_ADICIONAL, M.NRO_CTA_DEB_BATCH,
       M.LIBERADO, M.FEC_ACREDITACION, M.USU_INSERCION, M.FEC_INSERCION, M.USU_MODIFICACION,
       M.FEC_MODIFICACION
  FROM GE_MOV_DAT_ADICIONALES_ERR M
UNION ALL
SELECT M.FECHA, M.HORA,M.FEC_VALOR, M.HOR_REFERENCIA, M.COD_USUARIO, M.NRO_SECUENCIA,
       M.COD_MODULO, M.COD_MODALIDAD, M.NRO_CUENTA,
       M.TIP_OPERACION, M.COD_TRA_PADRE, M.COD_MONEDA, M.MONTO, M.MTO_COMISION,
       M.COD_EXTORNO, M.NRO_DOCUMENTO, M.NRO_TRANSACCION, M.DAT_ADICIONAL, M.NRO_CTA_DEB_BATCH,
       M.LIBERADO, M.FEC_ACREDITACION, M.USU_INSERCION, M.FEC_INSERCION, M.USU_MODIFICACION,
       M.FEC_MODIFICACION
  FROM GE_MOV_DAT_ADICIONALES_HIS M;

