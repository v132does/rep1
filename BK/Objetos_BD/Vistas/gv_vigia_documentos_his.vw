CREATE OR REPLACE FORCE EDITIONABLE VIEW "IT"."GV_VIGIA_DOCUMENTOS_HIS" (
    "ID_CASO", 
    "ID_FORMULARIO", 
    "TIPO_FORMULARIO", 
    "OBSERVACIONES", 
    "VIGENCIA_DESDE", 
    "VIGENCIA_HASTA", 
    "FEC_PROCESO"
) AS 
WITH UltimaOperacion AS (
    SELECT 
        COD_PERSONA, 
        FEC_INICIO,
        ROW_NUMBER() OVER (PARTITION BY COD_PERSONA ORDER BY FEC_INICIO DESC, ROWID DESC) as rnk
    FROM CR_PER_TIP_OPERACIONES
)
SELECT 
    PE.COD_PERSONA        AS ID_CASO,
    'VENCIMIENTO DE PERFIL' AS ID_FORMULARIO,
    'RMINFADI'            AS TIPO_FORMULARIO,
    NULL                  AS OBSERVACIONES,
    LOA.FEC_INICIO        AS VIGENCIA_DESDE,
    NULL                  AS VIGENCIA_HASTA,
    pag_cal.fu_obt_fec_actual(6) AS FEC_PROCESO
FROM BA_PERSONAS PE
INNER JOIN UltimaOperacion LOA ON PE.COD_PERSONA = LOA.COD_PERSONA AND LOA.rnk = 1 -- Solo el registro más reciente
LEFT JOIN GE_CLIENTES GE ON GE.COD_PERSONA = PE.COD_PERSONA WHERE PE.COD_TIP_DOCUMENTO NOT IN (9, 10);