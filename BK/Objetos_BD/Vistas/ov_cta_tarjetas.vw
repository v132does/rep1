create or replace force view it.ov_cta_tarjetas as
select a.nro_cuenta NRO_OPERACION,
       case
         when e.tipo = 'F' then
          trim(pf.pri_nombre) || ' ' || trim(pf.seg_nombre)
         else
          trim(E.NOM_COMPLETO)
       end as NOM_CLIENTE,
       trim(pf.pri_apellido) || ' ' || trim(pf.seg_apellido) as APE_CLIENTE,
       e.TIPO,
       e.cod_tip_documento,
       trim(replace(e.nro_documento, chr(10), '')) NRO_DOC_CLIENTE,
       e.cod_tip_documento COD_TIPO_DOC_CLIENTE,
       pf.cod_sexo SEXO,
       c.cli_confidencial,
       c.cli_especial,
       fug_es_empleado(pf.cod_persona) es_funcionario,
       b.relacion,
       vin.NOM_CONYUGE,
       vin.APE_CONYUGE,
       vin.nro_documento NRO_DOC_CONYUGE,
       vin.cod_tip_documento COD_TIP_DOC_CONYUGE,
       vin.cod_sexo SEXO_CONYUGE,
       a.denominacion,
       a.cod_modulo,
       a.cod_modalidad,
       a.cod_oficina,
       a.cod_moneda,
       nvl(a.lin_credito,0) lin_credito,
       nvl(a.lin_cuotas,0) lin_cuotas,
       nvl(a.sal_facturar,0) sal_facturar,
       nvl(a.sal_facturado,0) sal_facturado,
       nvl(a.sal_financiado,0) sal_financiado,
       nvl(a.sal_ult_extracto,0) sal_ult_extracto,
       nvl(a.sal_cuo_pendientes,0) sal_cuo_pendientes,
       nvl(a.mto_pag_minimo,0) mto_pag_minimo,
       nvl(a.sal_pag_minimo,0) sal_pag_minimo,
       nvl(a.mto_mora,0) mto_mora,
       nvl(a.dia_mora,0) dia_mora,
       nvl(a.mto_autorizaciones,0) mto_autorizaciones,
       nvl(a.mto_int_compras,0) mto_int_compras,
       nvl(a.mto_pag_mes,0) mto_pag_mes,
       nvl(a.mto_gas_mora,0) mto_gas_mora,
       a.estado,
       a.est_administradora,
       to_char(a.fec_solicitud,'dd/mm/yyyy') fec_solicitud,
       to_char(a.fec_apertura,'dd/mm/yyyy') fec_apertura,
       to_char(a.fec_ult_pago,'dd/mm/yyyy') fec_ult_pago,
       to_char(a.fec_ult_compra,'dd/mm/yyyy') fec_ult_compra,
       to_char(a.fec_ult_operacion,'dd/mm/yyyy') fec_ult_operacion,
       to_char(a.fec_ult_extracto,'dd/mm/yyyy') fec_ult_extracto,
       to_char(a.fec_ult_cierre,'dd/mm/yyyy') fec_ult_cierre,
       to_char(a.fec_vct_ult_cierre,'dd/mm/yyyy') fec_vct_ult_cierre,
       a.tip_cierre,
       a.cob_gas_financiero,
       a.tip_tas_financiacion,
       a.tip_com_emision,
       nvl(a.tas_financiacion,0) tas_financiacion,
       nvl(a.tas_adelanto,0) tas_adelanto,
       nvl(a.tas_mora,0) tas_mora,
       nvl(a.tas_cuotas,0) tas_cuotas,
       a.deb_automatico,
       a.tip_cobro,
       a.nro_cta_debito,
       nvl(a.mto_min_pago,0) mto_min_pago,
       nvl(a.por_pag_minimo,0) por_pag_minimo,
       a.cod_usu_promotor,
       a.mar_mora,
       a.mar_excedido,
       a.mar_recuperado,
       a.mar_bloqueo,
       a.con_costo,
       a.nro_solicitud,
       a.cod_causa,
       a.cod_canal,
       a.cod_campana,
       a.cat_automatica,
       to_char(a.fec_juicio,'dd/mm/yyyy') fec_juicio,
       a.cod_ent_juicio,
       nvl(a.max_atraso,0) max_atraso,
       nvl(a.pro_atraso,0) pro_atraso,
       a.nro_linea,
       a.en_juicio,
       a.cat_aut_anterior,
       to_char(a.fec_activacion,'dd/mm/yyyy') fec_activacion,
       to_char(a.fec_cancelacion,'dd/mm/yyyy') fec_cancelacion,
       nvl(a.tas_efectiva,0) tas_efectiva,
       nvl(a.mto_aut_cuotas,0) mto_aut_cuotas,
       a.afinidad,
       a.sub_afinidad,
       nvl(a.sal_procesadora,0) sal_procesadora,
       a.cod_rub_economico,
       a.cod_tip_cierre,
       a.franqueo,
       a.ind_seg_vida,
       a.cod_exc_cargo,
       nvl(a.lin_especial,0) lin_especial,
       nvl(a.tas_especial,0) tas_especial,
       nvl(a.mto_car_suspendido,0) mto_car_suspendido,
       nvl(a.mto_car_sus_aplicado,0) mto_car_sus_aplicado,
       a.fec_modificacion,
       c.cod_oficina cod_ofi_cliente,
       a.cod_oficina cod_ofi_operacion,
       c.cod_seg_cliente,
       c.cod_usu_oficial
  from ta_cta_tarjetas a,
       ge_cta_clientes b,
       ge_clientes c,
       ge_modalidades d,
       ba_personas e,
       ba_tip_documentos t,
       ge_est_cuentas w,
       ba_per_fisicas pf,
       ba_per_juridicas pj,
       (select trim(b.pri_nombre) || ' ' || trim(b.seg_nombre) NOM_CONYUGE,
               trim(b.pri_apellido) || ' ' || trim(b.seg_apellido) as APE_CONYUGE,
               c.nro_documento,
               c.cod_tip_documento,
               b.cod_sexo,
               a.cod_per_vinculo
          from ba_vinculos a, ba_per_fisicas b, ba_personas c
         where a.cod_persona = b.cod_persona
           and a.tipo = 'E'
           and c.cod_persona = b.cod_persona) vin
 where a.COD_MODALIDAD = D.COD_MODALIDAD
   and a.nro_cuenta = b.nro_cuenta
   and b.cod_persona = c.cod_persona
   and b.cod_persona = vin.cod_per_vinculo(+)
   and c.cod_persona = e.cod_persona
   and e.cod_tip_documento = t.cod_tip_documento
   and a.estado = w.estado
   and a.cod_modalidad = w.cod_modalidad
   and a.cod_modulo = w.cod_modulo
   and e.cod_persona = b.cod_persona
   and e.cod_persona = pf.cod_persona(+)
   and e.cod_persona = pj.cod_persona(+);

