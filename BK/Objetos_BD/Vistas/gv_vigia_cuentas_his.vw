CREATE OR REPLACE FORCE EDITIONABLE VIEW "IT"."GV_VIGIA_CUENTAS_HIS" (
    "NRO_CUENTA", "CUENTA", "COD_TIPO_CUENTA", "COD_ESTADO", "COD_MONEDA", "COD_SUCURSAL",
    "COMENTARIOS", "FECHA_PROCESO", "FECHA_ALTA", "FECHA_DE_APERTURA", "FECHA_DE_CANCELACION",
    "FECHA_DE_VENCIMIENTO", "NROTARJETA", "COD_OFICIAL", "NOMBRE_OFICIAL", "PLAZO",
    "TIPO_CATEGORIA", "SALDO_ACTUAL", "SALDO_INICIAL", "SALDO1", "SALDO2", "SALDO3", "SALDO4",
    "TASA", "LIMITE1", "LIMITE2", "LIMITE3", "LIMITE4", "FEC_PROCESO"
) AS 
WITH TasaVigente AS (
    SELECT COD_TASA, VAL_TASA, COD_MONEDA, COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD,
           ROW_NUMBER() OVER (
               PARTITION BY COD_TASA, COD_MONEDA, COD_MODULO, COD_MODALIDAD, COD_SUB_MODALIDAD 
               ORDER BY FEC_VIGENCIA DESC
           ) as rnk
    FROM GE_TAS_FECHAS
)
SELECT 
    NRO_CUENTA, CUENTA, COD_TIPO_CUENTA, COD_ESTADO, COD_MONEDA, COD_SUCURSAL,
    COMENTARIOS, FECHA_PROCESO, FECHA_ALTA, FECHA_DE_APERTURA, FECHA_DE_CANCELACION,
    FECHA_DE_VENCIMIENTO, NROTARJETA, COD_OFICIAL, NOMBRE_OFICIAL, PLAZO,
    TIPO_CATEGORIA, SALDO_ACTUAL, SALDO_INICIAL, SALDO1, SALDO2, SALDO3, SALDO4,
    TASA, LIMITE1, LIMITE2, LIMITE3, LIMITE4, FEC_PROCESO 
FROM (
    SELECT 
        CL.NRO_CUENTA,
        CL.NRO_CUENTA AS CUENTA,
        CU.COD_MODULO || CU.COD_MODALIDAD AS COD_TIPO_CUENTA,
        CU.COD_MODALIDAD || CU.ESTADO AS COD_ESTADO,
        CU.COD_MONEDA,
        GE.COD_OFICINA AS COD_SUCURSAL,
        CAST(NULL AS VARCHAR2(100)) AS COMENTARIOS,
        CAST(NULL AS DATE) AS FECHA_PROCESO,
        CAST(NULL AS DATE) AS FECHA_ALTA,
        -- Mejoramos el NVL para que trabaje con fechas antes de convertir a String
        TO_CHAR(NVL(CU.FEC_APERTURA, PAG_CAL.FU_OBT_FEC_ACTUAL(6)), 'YYYY-MM-DD') AS FECHA_DE_APERTURA,
        CAST(NULL AS VARCHAR2(10)) AS FECHA_DE_CANCELACION,
        TO_CHAR(CU.FEC_VENCIMIENTO, 'YYYY-MM-DD') AS FECHA_DE_VENCIMIENTO,
        CAST(NULL AS VARCHAR2(20)) AS NROTARJETA,
        GE.COD_USU_OFICIAL AS COD_OFICIAL,
        US.NOMBRE AS NOMBRE_OFICIAL,
        CASE WHEN (CU.FEC_VENCIMIENTO - CU.FEC_APERTURA) <= 0 THEN 1 
             ELSE (CU.FEC_VENCIMIENTO - CU.FEC_APERTURA) END AS PLAZO,
        GE.COD_SEG_CLIENTE AS TIPO_CATEGORIA,
        CAST(NULL AS NUMBER) AS SALDO_ACTUAL, 
        CAST(NULL AS NUMBER) AS SALDO_INICIAL,
        CAST(NULL AS NUMBER) AS SALDO1, 
        CAST(NULL AS NUMBER) AS SALDO2, 
        CAST(NULL AS NUMBER) AS SALDO3, 
        CAST(NULL AS NUMBER) AS SALDO4,
        CASE 
            WHEN CU.COD_MODULO = 3 THEN CT.VAL_TASA
            WHEN CU.COD_MODULO = 15 THEN OV.VAL_TASA 
            ELSE CU.VAL_TASA 
        END AS TASA,
        ROUND(NVL(TA.LIN_CREDITO, 0) / NULLIF(FUG_OBT_COTIZACION('USD', PAG_CAL.FU_OBT_FEC_ACTUAL(6)), 0), 2) AS LIMITE1,
        CAST(NULL AS NUMBER) AS LIMITE2, 
        CAST(NULL AS NUMBER) AS LIMITE3, 
        CAST(NULL AS NUMBER) AS LIMITE4,
        CASE 
            WHEN CU.COD_MODULO = 3 AND CU.COD_MODALIDAD NOT IN (33, 36) AND CU.ESTADO IN ('CX','X','TX') THEN 'EX'
            WHEN CU.COD_MODULO = 4 AND CU.ESTADO IN ('CX','I') THEN 'EX'
            WHEN CU.COD_MODULO = 5 AND CU.ESTADO = 'CX' THEN 'EX'
            WHEN CU.COD_MODULO IN (6, 10) AND CU.ESTADO = 'N' THEN 'EX'
            WHEN CU.COD_MODULO = 15 AND CU.ESTADO = 'C' THEN 'EX' 
            ELSE 'SI' 
        END AS DAT,
        PAG_CAL.FU_OBT_FEC_ACTUAL(6) AS FEC_PROCESO
    FROM GE_CTA_CLIENTES CL
    JOIN GE_CUENTAS CU ON CU.NRO_CUENTA = CL.NRO_CUENTA AND CU.COD_MODULO = CL.COD_MODULO AND CU.COD_MODALIDAD = CL.COD_MODALIDAD
    JOIN GE_CLIENTES GE ON GE.COD_PERSONA = CL.COD_PERSONA
    JOIN BA_USUARIOS US ON US.COD_USUARIO = GE.COD_USU_OFICIAL
    LEFT JOIN TA_CTA_TARJETAS TA ON TA.NRO_CUENTA = CU.NRO_CUENTA AND TA.COD_MODULO = CU.COD_MODULO AND TA.COD_MODALIDAD = CU.COD_MODALIDAD
    LEFT JOIN OV_CTA_VENCIDAS OV ON OV.NRO_CUENTA = CU.NRO_CUENTA AND OV.COD_MODULO = CU.COD_MODULO AND OV.COD_MODALIDAD = CU.COD_MODALIDAD
    LEFT JOIN TasaVigente CT ON CU.COD_TASA = CT.COD_TASA 
        AND CU.COD_MONEDA = CT.COD_MONEDA 
        AND CU.COD_MODULO = CT.COD_MODULO 
        AND CU.COD_MODALIDAD = CT.COD_MODALIDAD 
        AND CU.COD_SUB_MODALIDAD = CT.COD_SUB_MODALIDAD
        AND CT.rnk = 1
    WHERE CL.RELACION = 'P' 
      AND CL.COD_MODULO IN (3,4,5,6,7,10,15,35) 
      AND CL.COD_PERSONA <> 1
)
WHERE DAT = 'SI';

