create or replace view IT.SV_CF_EXCL_DETALLE AS
SELECT
    e.COD_REGLA,
    e.ACCION,
    e.TIPO_IDENT,
    e.NRO_DOCUMENTO,
    e.TIPO_PER,
    e.APELLIDO,
    e.NOMBRE,
    TO_CHAR(e.FECHA_NAC,    'DD/MM/YYYY') FECHA_NAC,
    TO_CHAR(e.FECHA_VENC_DOC,'DD/MM/YYYY') FECHA_VENC_DOC,
    e.GENERO,
    e.PAIS_NACIMIENTO,
    e.COD_PERSONA,
    e.MOTIVO,
    e.VALOR_ORIGINAL,
    e.VALOR_CORREGIDO,
    TO_CHAR(e.FEC_LOG,'DD/MM/YYYY HH24:MI:SS') FEC_LOG,
    p.FEC_CIERRE FECHA
  FROM IT.SB_CF_EXCL_DETALLE e
  JOIN IT.SB_CF_PRO_LOG p ON p.ID_EJECUCION = e.ID_EJECUCION
 WHERE p.ESTADO       = 'OK'
   AND p.TIPO_PROCESO = 'CF_ALTA'
 ORDER BY e.COD_REGLA, e.TIPO_IDENT, e.NRO_DOCUMENTO;

CREATE PUBLIC SYNONYM SV_CF_EXCL_DETALLE FOR IT.SV_CF_EXCL_DETALLE;
GRANT SELECT ON IT.SV_CF_EXCL_DETALLE TO IT_CONSULTAS;
GRANT SELECT ON IT.SV_CF_EXCL_DETALLE TO IT_TEMPORAL;
