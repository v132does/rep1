CREATE OR REPLACE VIEW IT.SV_LCR_DEF_ARBOL AS
SELECT
    D.NRO_ITEM,
    D.ID_PADRE,
    D.NRO_AGRUPADOR,
    D.NRO_ORDEN,
    D.DESCRIPCION,
    D.DESC_INFORME,
    D.PORC_PONDERACION,
    D.SQL,
    D.USU_INSERCION,
    D.FEC_INSERCION,
    D.USU_MODIFICACION,
    D.FEC_MODIFICACION,
    LEVEL AS NIVEL,
    LTRIM(SYS_CONNECT_BY_PATH(D.NRO_ORDEN, '.'), '.') AS orden_visual,
    LPAD(' ', (LEVEL - 1) * 3) || D.DESC_INFORME AS DESCRIPCION_ARBOL,
    SYS_CONNECT_BY_PATH(D.DESC_INFORME, ' / ') AS RUTA
FROM IT.SB_LCR_DEFINICIONES D
START WITH D.ID_PADRE IS NULL
CONNECT BY PRIOR D.NRO_ITEM = D.ID_PADRE
ORDER SIBLINGS BY D.NRO_ORDEN;
