CREATE OR REPLACE FORCE VIEW IT.GV_VIGIA_CLIENTE_CUENTAS_NOV AS
SELECT  --CL.COD_MODULO, COUNT (*) AS Cant
CL.RELACION AS COD_TIPO_RELACION,CL.COD_PERSONA AS NRO_CLIENTE,CL.NRO_CUENTA AS NRO_CUENTA,
/*CASE WHEN TO_CHAR(CU.FEC_APERTURA,'yyyy-mm-dd') IS NULL THEN to_char (pag_cal.fu_obt_fec_actual(6),'yyyy-mm-dd') --to_char (TO_DATE('23/09/2022','dd/mm/yyyy'),'yyyy-mm-dd')
  ELSE  TO_CHAR(CU.FEC_APERTURA,'yyyy-mm-dd') END AS VIGENCIA_DESDE,*/
TO_CHAR(CU.FEC_APERTURA,'yyyy-mm-dd')  AS VIGENCIA_DESDE,
NULL AS VIGENCIA_HASTA, NULL AS NROTARJETA,
-------------------------------------------------------- hasta aqui estructura vigia
NULL AS TITULARIDAD, trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AS FEC_PROCESO,
   CL.EST_RELACION AS EST_REL, CL.FEC_MODIFICACION, CL.FEC_INSERCION,
   'ALTAS' AS Marca
FROM GE_CTA_CLIENTES CL
JOIN GE_CUENTAS CU ON CU.NRO_CUENTA= CL.NRO_CUENTA AND CU.COD_MODULO = CL.COD_MODULO AND CU.COD_MODALIDAD = CL.COD_MODALIDAD
LEFT JOIN AH_CTA_VISTAS VI
  ON VI.NRO_CUENTA = CU.NRO_CUENTA AND VI.COD_MODULO = CU.COD_MODULO AND VI.COD_MODALIDAD = CU.COD_MODALIDAD AND VI.COD_SUB_MODALIDAD = CU.COD_SUB_MODALIDAD
LEFT JOIN AH_CTA_CERTIFICADOS CE
  ON CE.NRO_CUENTA = CU.NRO_CUENTA AND CE.COD_MODULO = CU.COD_MODULO AND CE.COD_MODALIDAD = CU.COD_MODALIDAD
LEFT JOIN PR_CTA_PRESTAMOS PR
  ON PR.NRO_CUENTA = CU.NRO_CUENTA AND PR.COD_MODULO = CU.COD_MODULO AND PR.COD_MODALIDAD = CU.COD_MODALIDAD AND PR.COD_SUB_MODALIDAD = CU.COD_SUB_MODALIDAD
LEFT JOIN TA_CTA_TARJETAS TA
  ON TA.NRO_CUENTA = CU.NRO_CUENTA AND TA.COD_MODULO = CU.COD_MODULO AND TA.COD_MODALIDAD = CU.COD_MODALIDAD
LEFT JOIN OV_CTA_VENCIDAS OV
  ON OV.NRO_CUENTA = CU.NRO_CUENTA AND OV.COD_MODULO = CU.COD_MODULO AND OV.COD_MODALIDAD = CU.COD_MODALIDAD
LEFT JOIN MD_CTA_DOCUMENTOS MD
  ON MD.NRO_CUENTA = CU.NRO_CUENTA AND MD.COD_MODULO = CU.COD_MODULO AND MD.COD_MODALIDAD = CU.COD_MODALIDAD
WHERE CL.NRO_CUENTA IN (SELECT NRO_CUENTA FROM (
SELECT PAL.COD_MODULO AS MODULO, PAL.NRO_CUENTA AS NRO_CUENTA,PAL.FEC_ACTUALIZ AS FEC_ACTUALIZACION,PAL.ESTADO AS ESTADO, 'ALTA' AS MARCA, COUNT(*)
 FROM (
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_INICIO)AS FEC_ACTUALIZ, ESTADO FROM PR_CTA_PRESTAMOS WHERE TRUNC(FEC_INICIO) =trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_APERTURA)AS FEC_ACTUALIZ, ESTADO FROM AH_CTA_VISTAS WHERE TRUNC(FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO NOT IN ('X')
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_APERTURA)AS FEC_ACTUALIZ, ESTADO FROM AH_CTA_CERTIFICADOS WHERE TRUNC(FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AND ESTADO NOT IN ('X')
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_APERTURA)AS FEC_ACTUALIZ, ESTADO FROM TA_CTA_TARJETAS WHERE TRUNC(FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_INICIO)AS FEC_ACTUALIZ, ESTADO FROM MD_CTA_DOCUMENTOS WHERE TRUNC(FEC_INICIO) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_APERTURA)AS FEC_ACTUALIZ, ESTADO FROM OV_CTA_VENCIDAS WHERE TRUNC(FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
UNION
SELECT COD_MODULO, NRO_CUENTA ,TRUNC(FEC_APERTURA)AS FEC_ACTUALIZ, ESTADO FROM LC_CTA_CAMBIOS WHERE TRUNC(FEC_APERTURA) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/
 )PAL GROUP BY PAL.COD_MODULO, PAL.NRO_CUENTA, PAL.FEC_ACTUALIZ, PAL.ESTADO
 ) )
 --AND CL.RELACION = 'P'  --- no se envia solo registros del principal sino todos los participantes de la cuenta
 AND nvl(CL.EST_RELACION,0) <> 'I'
 AND NOT EXISTS (SELECT 1 FROM GE_CTA_CLIENTES WHERE COD_PERSONA = 1 AND NRO_CUENTA = CL.NRO_CUENTA)
 GROUP BY CL.RELACION,CL.COD_PERSONA,CL.NRO_CUENTA,TO_CHAR(CU.FEC_APERTURA,'yyyy-mm-dd'),CL.EST_RELACION,CL.FEC_MODIFICACION,CL.FEC_INSERCION
  --CL.COD_MODULO
UNION -------------------*******************----------------******************----------------------
------------ CLIENTE - CUENTAS /// BLOQUE 2
SELECT -- CL.COD_MODULO, COUNT (*) AS Cant
CL.RELACION AS COD_TIPO_RELACION,CL.COD_PERSONA AS NRO_CLIENTE,CL.NRO_CUENTA AS NRO_CUENTA,
CASE WHEN TO_CHAR(CU.FEC_APERTURA,'yyyy-mm-dd') IS NULL THEN to_char (pag_cal.fu_obt_fec_actual(6),'yyyy-mm-dd')
  ELSE  TO_CHAR(CU.FEC_APERTURA,'yyyy-mm-dd') END AS VIGENCIA_DESDE,
NULL AS VIGENCIA_HASTA, NULL AS NROTARJETA,
-------------------------------------------------------- hasta aqui estructura vigia
NULL AS TITULARIDAD, trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ AS FEC_PROCESO,
   CL.EST_RELACION AS EST_REL, CL.FEC_MODIFICACION, CL.FEC_INSERCION,
   'MODIFICACION' AS Marca
FROM GE_CTA_CLIENTES CL
JOIN GE_CUENTAS CU ON CU.NRO_CUENTA= CL.NRO_CUENTA AND CU.COD_MODULO = CL.COD_MODULO AND CU.COD_MODALIDAD = CL.COD_MODALIDAD
LEFT JOIN AH_CTA_VISTAS VI
  ON VI.NRO_CUENTA = CU.NRO_CUENTA AND VI.COD_MODULO = CU.COD_MODULO AND VI.COD_MODALIDAD = CU.COD_MODALIDAD AND VI.COD_SUB_MODALIDAD = CU.COD_SUB_MODALIDAD
LEFT JOIN AH_CTA_CERTIFICADOS CE
  ON CE.NRO_CUENTA = CU.NRO_CUENTA AND CE.COD_MODULO = CU.COD_MODULO AND CE.COD_MODALIDAD = CU.COD_MODALIDAD
LEFT JOIN PR_CTA_PRESTAMOS PR
  ON PR.NRO_CUENTA = CU.NRO_CUENTA AND PR.COD_MODULO = CU.COD_MODULO AND PR.COD_MODALIDAD = CU.COD_MODALIDAD AND PR.COD_SUB_MODALIDAD = CU.COD_SUB_MODALIDAD
LEFT JOIN TA_CTA_TARJETAS TA
  ON TA.NRO_CUENTA = CU.NRO_CUENTA AND TA.COD_MODULO = CU.COD_MODULO AND TA.COD_MODALIDAD = CU.COD_MODALIDAD
LEFT JOIN OV_CTA_VENCIDAS OV
  ON OV.NRO_CUENTA = CU.NRO_CUENTA AND OV.COD_MODULO = CU.COD_MODULO AND OV.COD_MODALIDAD = CU.COD_MODALIDAD
LEFT JOIN MD_CTA_DOCUMENTOS MD
  ON MD.NRO_CUENTA = CU.NRO_CUENTA AND MD.COD_MODULO = CU.COD_MODULO AND MD.COD_MODALIDAD = CU.COD_MODALIDAD
WHERE CL.NRO_CUENTA IN (SELECT NRO_CUENTA FROM (
SELECT PRE.COD_MODULO AS MODULO, PRE.NRO_CUENTA AS NRO_CUENTA,PRE.FEC_ACTUALIZ AS FEC_ACTUALIZACION,PRE.ESTADO AS ESTADO,PRE.MARCA,  COUNT(*)
 FROM (
SELECT CL.COD_MODULO , CL.NRO_CUENTA,TRUNC(CL.FEC_MODIFICACION) AS FEC_ACTUALIZ,CU.ESTADO ,'RELACION' AS MARCA,
CASE WHEN (CU.COD_MODULO = 3 AND CU.COD_MODALIDAD not in (33,36)) AND CU.ESTADO IN ('C','X') THEN 'EX'
   WHEN (CU.COD_MODULO = 3 AND CU.COD_MODALIDAD IN (33,36))
   AND CU.ESTADO IN ('C','T','X') THEN 'EX'
   WHEN CU.COD_MODULO IN(4,5) AND CU.ESTADO  IN ('C','I','X') THEN 'EX'
   WHEN CU.COD_MODULO IN (6,10) AND CU.ESTADO  IN ('N') THEN 'EX'
   WHEN CU.COD_MODULO IN (7, 15) AND CU.ESTADO  IN ('C') THEN 'EX' ELSE 'SI' END AS DAT, COUNT(*)
FROM GE_CTA_CLIENTES CL
JOIN GE_CUENTAS CU ON CU.NRO_CUENTA= CL.NRO_CUENTA AND CU.COD_MODULO = CL.COD_MODULO AND CU.COD_MODALIDAD = CL.COD_MODALIDAD
WHERE CL.COD_MODULO IN (3,4,5,6,7,10,15,35) AND CL.COD_PERSONA NOT IN (1)
AND TRUNC(CL.FEC_MODIFICACION) = trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/-- cuentas con fecha de modificacion igual a fecha proceso
--AND TRUNC(CL.FEC_MODIFICACION) > TO_DATE('16/07/2022','dd/mm/yyyy')   --- maxima fecha en historico
AND TRUNC(CU.FEC_APERTURA) < trunc(SYSDATE-1) /*pag_cal.fu_obt_fec_actual(6)*/ -- cuentas existentes, desde antes de la fecha proceso para NO solapar con Altas
--AND TRUNC(CU.FEC_APERTURA) < TO_DATE('16/07/2022','dd/mm/yyyy') --- maxima fecha en historico
GROUP BY CL.COD_MODULO,CL.NRO_CUENTA,TRUNC(CL.FEC_MODIFICACION),CU.ESTADO,CU.COD_MODULO , CU.COD_MODALIDAD
      ) PRE WHERE PRE.DAT= 'SI' GROUP BY PRE.COD_MODULO,PRE.NRO_CUENTA,PRE.FEC_ACTUALIZ,PRE.ESTADO,PRE.MARCA
    ))
 -- AND CL.RELACION = 'P'  --- no se envia solo registros del principal sino todos los participantes de la cuenta
 AND nvl(CL.EST_RELACION,0) <> 'I'
 AND NOT EXISTS (SELECT 1 FROM GE_CTA_CLIENTES WHERE COD_PERSONA = 1 AND NRO_CUENTA = CL.NRO_CUENTA)
 GROUP BY CL.RELACION,CL.COD_PERSONA,CL.NRO_CUENTA,TO_CHAR(CU.FEC_APERTURA,'yyyy-mm-dd'),CL.EST_RELACION,CL.FEC_MODIFICACION,CL.FEC_INSERCION
;

