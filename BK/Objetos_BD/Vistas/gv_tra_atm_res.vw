CREATE OR REPLACE FORCE VIEW IT.GV_TRA_ATM_RES AS
SELECT M.COD_OFICINA,
       B.DESCRIPCION,
       COUNT(1) CANTIDAD
  FROM GE_MOVIMIENTOS M, BA_OFICINAS B, GE_TRANSACCIONES T
 WHERE M.COD_MOD_PADRE = T.COD_MODULO
   AND M.COD_MAD_PADRE = T.COD_MODALIDAD
   AND M.COD_TRA_PADRE = T.COD_TRANSACCION
   AND M.COD_OFICINA = B.COD_OFICINA
   AND M.COD_MOD_PADRE = 9
   AND M.COD_MAD_PADRE = 91
   AND M.COD_TRA_PADRE IN  (380,382,228,375,381,214,227)
   AND M.ESTADO = 'N'
   AND M.REVERSADO = 'N'
   AND M.MONTO IS NOT NULL
   AND M.NRO_CUENTA IS NOT NULL
 GROUP BY M.COD_OFICINA, B.DESCRIPCION
 ORDER BY M.COD_OFICINA, COUNT(1);

