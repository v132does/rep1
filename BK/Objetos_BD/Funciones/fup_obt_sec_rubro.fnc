CREATE OR REPLACE FUNCTION IT.FUP_OBT_SEC_RUBRO(p_cod_sec_credito in number)
RETURN VARCHAR2 IS
V_COD_SEC_RUBRO VARCHAR2(3);
BEGIN
   SELECT  COD_SEC_RUBRO
     INTO V_COD_SEC_RUBRO
     FROM PR_SEC_CREDITOS
    WHERE COD_SEC_CREDITO = p_cod_sec_credito;
   RETURN v_cod_sec_rubro;
EXCEPTION
   WHEN OTHERS THEN
       return 'N';
END;
/

