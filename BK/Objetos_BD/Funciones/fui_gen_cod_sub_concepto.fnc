CREATE OR REPLACE FUNCTION IT.FUI_GEN_COD_SUB_CONCEPTO
 (P_COD_CONCEPTO IN NUMBER)
 RETURN VARCHAR
 IS
 V_COD_SUB_CONCEPTO IG_SUB_CONCEPTOS.COD_SUB_CONCEPTO%TYPE;
BEGIN
  BEGIN
    SELECT NVL(MAX(COD_SUB_CONCEPTO),0)
      INTO V_COD_SUB_CONCEPTO
      FROM IG_SUB_CONCEPTOS
     WHERE COD_CONCEPTO = P_COD_CONCEPTO;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      V_COD_SUB_CONCEPTO := 0;
  END;
  IF V_COD_SUB_CONCEPTO = 0 THEN
    V_COD_SUB_CONCEPTO := P_COD_CONCEPTO * 100;
  END IF;
    V_COD_SUB_CONCEPTO := V_COD_SUB_CONCEPTO + 1;

  RETURN V_COD_SUB_CONCEPTO;
END;
/

