create or replace function it.fua_obt_sal_promedio
( P_COD_MODULO IN BA_MODULOS.COD_MODULO%TYPE
 ,P_COD_MODALIDAD IN GE_MODALIDADES.COD_MODALIDAD%TYPE
 ,P_COD_OFICINA IN BA_OFICINAS.COD_OFICINA%TYPE
 ,P_NRO_CUENTA IN GE_CUENTAS.NRO_CUENTA%TYPE
 ,P_FEC_INI IN DATE
 ,P_FEC_FIN IN DATE
 )
 return number is
 v_SAL_ACUMULADO     NUMBER;
 v_SAL_PROMEDIO      NUMBER;
 v_CAN_DIA_ACUMULADO AH_SAL_MENSUALES.CAN_DIA_ACUMULADO%TYPE;
begin
  pag_cta.PR_OBT_SAL_PROMEDIO(P_COD_MODULO ,P_COD_MODALIDAD ,P_COD_OFICINA ,P_NRO_CUENTA 
                             ,P_FEC_INI ,P_FEC_FIN ,v_SAL_ACUMULADO  ,v_SAL_PROMEDIO  ,v_CAN_DIA_ACUMULADO);
  return v_sal_promedio;
end;
/

