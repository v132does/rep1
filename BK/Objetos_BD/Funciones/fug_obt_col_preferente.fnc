CREATE OR REPLACE FUNCTION IT.fug_obt_col_preferente (V_COD_PERSONA IN  ge_clientes.COD_PERSONA%TYPE)
RETURN VARCHAR2
IS

V_RGB  ge_seg_preferentes.RGB%TYPE;
BEGIN
     SELECT GSPRE.RGB
       INTO V_RGB
       FROM GE_CLIENTES GCLIE, GE_SEG_PREFERENTES GSPRE
      WHERE GCLIE.COD_SEG_PREFERENTE = GSPRE.COD_SEG_PREFERENTE
        AND GCLIE.COD_PERSONA = V_COD_PERSONA
        AND GCLIE.CLI_ESPECIAL = 'S';
     RETURN V_RGB;
EXCEPTION
    When NO_DATA_FOUND Then
     Return 'N';
    When TOO_MANY_ROWS Then
     Return 'N';
    WHEN OTHERS THEN
     RETURN 'N';
END;
/

