CREATE OR REPLACE FUNCTION IT.FUE_OBT_DET_CAMPOS(P_TAB_RELACION IN VARCHAR2,
                                              P_REFERENCIA   IN VARCHAR2,
                                              P_VER_TITULO   IN VARCHAR2 DEFAULT 'S') RETURN VARCHAR2 IS
   V_RETORNO VARCHAR2(4000);
   CURSOR V_DATOS IS
      SELECT DECODE(P_VER_TITULO, 'S', FUE_OBT_TITULO(B.ETIQUETA) || ':' || CHR(9), '') || A.VAL_PARAMETRO DATO, A.REFERENCIA
        FROM BA_TAB_DEF_ADICIONALES B, BA_TAB_DAT_ADICIONALES A
       WHERE A.TAB_RELACION = P_TAB_RELACION
         AND A.REFERENCIA = P_REFERENCIA
         AND A.TAB_RELACION = B.TAB_RELACION
         AND A.PARAMETRO = B.PARAMETRO
       ORDER BY B.NRO_ORDEN;
BEGIN
   FOR DT IN V_DATOS
   LOOP
      V_RETORNO := V_RETORNO || DT.DATO || CHR(10);
   
   END LOOP;
   RETURN V_RETORNO;
END;
/

