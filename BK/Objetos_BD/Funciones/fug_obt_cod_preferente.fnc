CREATE OR REPLACE FUNCTION IT.fug_obt_cod_preferente (V_COD_PERSONA IN  ge_clientes.COD_PERSONA%TYPE)
RETURN VARCHAR2
IS

V_COD_SEG_PREFERENTE  ge_seg_preferentes.COD_SEG_PREFERENTE%TYPE;
BEGIN
     SELECT GCLIE.COD_SEG_PREFERENTE
       INTO V_COD_SEG_PREFERENTE
       FROM GE_CLIENTES GCLIE, GE_SEG_PREFERENTES GSPRE
      WHERE GCLIE.COD_SEG_PREFERENTE = GSPRE.COD_SEG_PREFERENTE
        AND GCLIE.COD_PERSONA = V_COD_PERSONA
        AND GCLIE.CLI_ESPECIAL = 'S';
     RETURN V_COD_SEG_PREFERENTE;
EXCEPTION
    When NO_DATA_FOUND Then
     Return 0;
    When TOO_MANY_ROWS Then
     Return 0;
    WHEN OTHERS THEN
     RETURN 0;
END;
/

