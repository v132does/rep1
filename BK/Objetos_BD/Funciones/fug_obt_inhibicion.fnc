CREATE OR REPLACE FUNCTION IT.FUG_OBT_INHIBICION(P_COD_CAUSA   IN GE_CAUSALES.COD_CAUSA%TYPE,
                                              P_COD_PERSONA IN BA_PERSONAS.COD_PERSONA%TYPE DEFAULT NULL,
                                              P_NRO_CUENTA  IN GE_CUENTAS.NRO_CUENTA%TYPE DEFAULT NULL)
  RETURN BOOLEAN IS
  V_EXISTE       VARCHAR2(1) := 'N';
  V_INH_FIRMANTE VARCHAR2(1) := 'N';
BEGIN
  IF P_COD_PERSONA IS NOT NULL THEN
    BEGIN
      SELECT DISTINCT ('S')
        INTO V_EXISTE
        FROM GE_PER_INHIBIDAS A, GE_CAUSALES B
       WHERE A.COD_CAUSA = B.COD_CAUSA
         AND A.ESTADO = 'I'
         AND A.COD_CAUSA = P_COD_CAUSA
         AND A.COD_PERSONA = P_COD_PERSONA;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        V_EXISTE := 'N';
    END;
  END IF;
  IF P_NRO_CUENTA IS NOT NULL AND V_EXISTE = 'N' THEN
    BEGIN
      SELECT 'S'
        INTO V_INH_FIRMANTE
        FROM GE_CUENTAS A, GE_CTA_CLIENTES B
       WHERE A.NRO_CUENTA = B.NRO_CUENTA
         AND A.NRO_CUENTA = P_NRO_CUENTA
         AND EXISTS (SELECT 1
                FROM GE_PER_INHIBIDAS X
               WHERE X.COD_PERSONA = B.COD_PERSONA
                 AND X.ESTADO = 'I'
                 AND X.COD_CAUSA = P_COD_CAUSA)
         AND ROWNUM = 1;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        V_INH_FIRMANTE := 'N';
    END;
  END IF;

  IF V_EXISTE = 'S' OR V_INH_FIRMANTE = 'S' THEN
    RETURN TRUE;
  ELSE
    RETURN FALSE;
  END IF;

EXCEPTION
  WHEN NO_DATA_FOUND THEN
    RETURN FALSE;
  WHEN OTHERS THEN
    RAISE_APPLICATION_ERROR(-20000,
                            'ERROR AL BUSCAR INHIBICIÓN POR TIPO DE CAUSAL ' ||
                            SQLERRM);
END;
/

