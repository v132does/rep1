CREATE OR REPLACE FUNCTION IT.FUA_OBT_FOR_DIS_GRUPAL(P_NRO_CUENTA IN VARCHAR2) RETURN VARCHAR2 IS
  --Proyecto Dev. Grupal Cta Tran. Bancard - CORECTRB-19--
  --Para obtener la forma de capitalizacion de interes grupal--
  V_FOR_DIS_INTERES AH_DEV_GRU_CUENTAS.FOR_DIS_INTERES%TYPE;
BEGIN
  SELECT X.FOR_DIS_INTERES
    INTO V_FOR_DIS_INTERES
    FROM AH_DEV_GRU_CUENTAS X
   WHERE X.NRO_CUENTA = P_NRO_CUENTA;
  RETURN V_FOR_DIS_INTERES;
  
EXCEPTION
  WHEN OTHERS THEN
       raise_application_error(-20000,'Error en FUA_OBT_FOR_INT_GRUPAL :'||sqlerrm);
END;
/

