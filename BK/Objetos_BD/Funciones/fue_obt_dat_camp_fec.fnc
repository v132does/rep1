CREATE OR REPLACE FUNCTION it.FUE_OBT_DAT_CAMP_FEC (P_TAB_RELACION IN VARCHAR2, P_REFERENCIA IN VARCHAR2, P_FECHA IN DATE)
RETURN VARCHAR2 IS
  V_RETORNO VARCHAR2(4000);
  CURSOR V_DATOS
      IS SELECT A.VAL_PARAMETRO DATO
           FROM BA_TAB_DEF_ADICIONALES B, BA_TAB_DAT_ADICIONALES A
          WHERE A.TAB_RELACION = P_TAB_RELACION
            AND A.REFERENCIA = P_REFERENCIA
            AND A.TAB_RELACION = B.TAB_RELACION
            AND A.PARAMETRO = B.PARAMETRO
            AND TRUNC(A.FEC_INSERCION)=P_FECHA
           ORDER BY B.NRO_ORDEN;
BEGIN
   FOR DT IN V_DATOS LOOP
       V_RETORNO := V_RETORNO||DT.DATO;

   END LOOP;
   RETURN V_RETORNO;
END;
/
