CREATE OR REPLACE FUNCTION IT.FUG_VER_COT_AUTORIZADOR
 (P_COTI_INSERT  IN GE_MOVIMIENTOS.COTIZACION%TYPE
 ,P_PUNTOS       IN GE_USU_LIMITES.PUN_COTIZACION%TYPE
 ,P_COTI_FECHA   IN GE_MOVIMIENTOS.COTIZACION%TYPE
 )
 RETURN varchar2 IS

BEGIN

  IF NVL(P_COTI_INSERT,0) > NVL(P_COTI_FECHA,0) THEN
    IF (NVL(P_COTI_INSERT,0) - NVL(P_COTI_FECHA,0)) > P_PUNTOS THEN
       return 'N';
    ELSE
        return 'S';
    END IF;
  ELSE
    IF (NVL(P_COTI_FECHA,0) - NVL(P_COTI_INSERT,0)) > P_PUNTOS THEN
       return 'N';
    ELSE
        return 'S';
    END IF;    
  END IF;

EXCEPTION
   when others then
      return 'N';
END;
/

