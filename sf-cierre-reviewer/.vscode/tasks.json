{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CB Review: Fetch PR",
      "type": "shell",
      "command": "node",
      "args": [".github/scripts/pr-fetch.mjs", "${input:prNumber}"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "CB Review: Fetch PR + Jira",
      "type": "shell",
      "command": "node",
      "args": [".github/scripts/pr-fetch.mjs", "${input:prNumber}", "jira"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "prNumber",
      "type": "promptString",
      "description": "Numero de PR a revisar (ej: 42)",
      "default": ""
    }
  ]
}
